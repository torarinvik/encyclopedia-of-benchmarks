const MAX_ROWS: i64 = 20
const MAX_COLUMNS: i64 = 20

# Count right/down paths through a packed obstacle grid.
def unique_paths_with_obstacles_impl(input: i64&, length: usize) -> i64:
    if length < 2:
        return -1
    rows_value: i64 = input[0]
    columns_value: i64 = input[1]
    if rows_value < 1 or rows_value > MAX_ROWS or columns_value < 1 or columns_value > MAX_COLUMNS:
        return -1
    rows: usize = rows_value.usize()
    columns: usize = columns_value.usize()
    if length != 2 + rows * columns:
        return -1
    paths: mutable u64[20] = zeroed
    paths[0] <- 1
    cells_seen: mutable u64 = 0
    left: mutable u64 = 0
    index: mutable usize = 2
    while index < length:
        left <- 0
        column: mutable usize = 0
        while column < columns:
            obstacle: u64 = input[index].u64()
            cells_seen <- cells_seen | obstacle
            # With at most 20 rows and columns, even an open grid has under 2^36 paths.
            from_above: u64 = paths[column]
            left <- (left + from_above) if obstacle == 0 else 0
            paths[column] <- left
            column <- column + 1
            index <- index + 1
    if cells_seen > 1:
        return -1
    left.i64()

export fn unique_paths_with_obstacles(input: i64&, length: usize) -> i64 = unique_paths_with_obstacles_impl
