def union_of_two_arrays_store_i32(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: u32 = value.u32()
    output[position] <- (bits & 255).u8()
    output[position + 1] <- ((bits >> 8) & 255).u8()
    output[position + 2] <- ((bits >> 16) & 255).u8()
    output[position + 3] <- ((bits >> 24) & 255).u8()

def union_of_two_arrays_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > 130:
        return -1
    first_length_value: i64 = input[0]
    if first_length_value < 0 or first_length_value > 64:
        return -1
    first_length: usize = first_length_value.usize()
    second_length_position: usize = 1 + first_length
    if second_length_position >= length:
        return -1
    second_length_value: i64 = input[second_length_position]
    if second_length_value < 0 or second_length_value > 64:
        return -1
    second_length: usize = second_length_value.usize()
    second_start: usize = second_length_position + 1
    if second_start + second_length != length:
        return -1

    index: mutable usize = 0
    while index < first_length:
        value: i64 = input[1 + index]
        if value < -2147483648 or value > 2147483647:
            return -1
        if index > 0 and input[index] > value:
            return -1
        index <- index + 1
    index <- 0
    while index < second_length:
        value: i64 = input[second_start + index]
        if value < -2147483648 or value > 2147483647:
            return -1
        if index > 0 and input[second_start + index - 1] > value:
            return -1
        index <- index + 1

    maximum_result: usize = first_length + second_length
    if output_capacity < maximum_result * 4 or (maximum_result > 0 and output == null):
        return -2
    first_index: mutable usize = 0
    second_index: mutable usize = 0
    result_count: mutable usize = 0
    previous_value: mutable i64 = 0
    while first_index < first_length or second_index < second_length:
        value: mutable i64 = 0
        if first_index == first_length:
            value <- input[second_start + second_index]
            second_index <- second_index + 1
        elif second_index == second_length:
            value <- input[1 + first_index]
            first_index <- first_index + 1
        else:
            first: i64 = input[1 + first_index]
            second: i64 = input[second_start + second_index]
            if first < second:
                value <- first
                first_index <- first_index + 1
            elif first > second:
                value <- second
                second_index <- second_index + 1
            else:
                value <- first
                first_index <- first_index + 1
                second_index <- second_index + 1
        if result_count == 0 or value != previous_value:
            union_of_two_arrays_store_i32(value, output[0:output_capacity], result_count * 4)
            previous_value <- value
            result_count <- result_count + 1
    result_count.i64()

export fn union_of_two_arrays(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = union_of_two_arrays_impl
