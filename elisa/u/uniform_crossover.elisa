def uniform_crossover_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 4 or length > 193: return -1
    n: i64=input[0]
    if n<1 or n>64 or length!=(1+3*n).usize():return -1
    index: mutable usize=0
    while index<n.usize():
        if input[1+index]!=0 and input[1+index]!=1:return -1
        index <- index+1
    index <- 0
    while index<(2*n).usize():
        gene: i64=input[1+n.usize()+index]
        if gene < -2147483648 or gene > 2147483647:return -1
        index <- index+1
    count: usize=n.usize();bytes: usize=count*16
    if capacity<bytes:return -2
    index <- 0
    while index<count:
        alpha: i64=input[1+index];p: i64=input[1+count+index];q: i64=input[1+2*count+index]
        child1: i64=p
        child2: i64=q
        if alpha==0: child1 <- q; child2 <- p
        bits1: u64=child1.u64();bits2: u64=child2.u64();byte: mutable usize=0
        while byte<8:
            output[index*8+byte] <- ((bits1>>(8*byte))&255).u8()
            output[(count+index)*8+byte] <- ((bits2>>(8*byte))&255).u8()
            byte <- byte+1
        index <- index+1
    bytes.i64()
export fn uniform_crossover(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = uniform_crossover_impl
