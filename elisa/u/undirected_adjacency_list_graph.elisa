def undirected_adjacency_list_graph_push_word(words: mutable view[i64], count: mutable usize&, value: i64) -> void:
    words[count] <- value
    count <- count + 1

def undirected_adjacency_list_graph_push_record(words: mutable view[i64], count: mutable usize&,
        opcode: i64, payload: view[i64], payload_count: usize) -> void:
    undirected_adjacency_list_graph_push_word(words, count, opcode)
    undirected_adjacency_list_graph_push_word(words, count, payload_count.i64())
    index: mutable usize = 0
    while index < payload_count:
        undirected_adjacency_list_graph_push_word(words, count, payload[index])
        index <- index + 1

def undirected_adjacency_list_graph_store_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def undirected_adjacency_list_graph_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 98:
        return -1
    operation_count_value: i64 = input[0]
    if operation_count_value < 0 or operation_count_value > 24:
        return -1
    operation_count: usize = operation_count_value.usize()
    if length != 1 + 4 * operation_count:
        return -1

    words: mutable i64[144] = zeroed
    word_count: mutable usize = 0
    edge_weights: mutable i64[64] = zeroed
    has_edge: mutable bool[64] = zeroed
    node_count: mutable usize = 0

    operation_index: usize = 0
    while operation_index < operation_count:
        base: usize = 1 + 4 * operation_index
        opcode: i64 = input[base]
        first: i64 = input[base + 1]
        second: i64 = input[base + 2]
        third: i64 = input[base + 3]
        if opcode < 0 or opcode > 4:
            return -1

        if opcode == 0 or opcode == 4:
            if first != 0 or second != 0 or third != 0:
                return -1
        elif opcode == 1:
            if first < -2147483648 or first > 2147483647 or second < -2147483648 or second > 2147483647 or third < -2147483648 or third > 2147483647:
                return -1
        elif opcode == 2:
            if first < -2147483648 or first > 2147483647 or second != 0 or third != 0:
                return -1
        else:
            if first < -2147483648 or first > 2147483647 or second < -2147483648 or second > 2147483647 or third != 0:
                return -1

        if opcode == 0:
            if node_count >= 8:
                return -1
            payload: mutable i64[9] = zeroed
            payload[0] <- node_count.i64()
            undirected_adjacency_list_graph_push_record(words[0:144], word_count, opcode, payload[0:9], 1)
            node_count <- node_count + 1
        elif opcode == 1:
            added: mutable bool = false
            if first >= 0 and first < node_count.i64() and second >= 0 and second < node_count.i64():
                origin: usize = first.usize()
                destination: usize = second.usize()
                forward_index: usize = origin * 8 + destination
                reverse_index: usize = destination * 8 + origin
                if not has_edge[forward_index]:
                    has_edge[forward_index] <- true
                    has_edge[reverse_index] <- true
                    edge_weights[forward_index] <- third
                    edge_weights[reverse_index] <- third
                    added <- true
            payload: mutable i64[9] = zeroed
            payload[0] <- if added: 1 else: 0
            undirected_adjacency_list_graph_push_record(words[0:144], word_count, opcode, payload[0:9], 1)
        elif opcode == 2:
            if first < 0 or first >= node_count.i64():
                return -1
            origin: usize = first.usize()
            payload: mutable i64[9] = zeroed
            neighbor_count: mutable usize = 0
            neighbor: mutable usize = 0
            while neighbor < node_count:
                if has_edge[origin * 8 + neighbor]:
                    payload[neighbor_count + 1] <- neighbor.i64()
                    neighbor_count <- neighbor_count + 1
                neighbor <- neighbor + 1
            payload[0] <- neighbor_count.i64()
            undirected_adjacency_list_graph_push_record(words[0:144], word_count, opcode, payload[0:9], neighbor_count + 1)
        elif opcode == 3:
            if first < 0 or first >= node_count.i64():
                return -1
            origin: usize = first.usize()
            present: mutable bool = false
            weight: mutable i64 = 0
            if second >= 0 and second < node_count.i64():
                destination: usize = second.usize()
                if has_edge[origin * 8 + destination]:
                    present <- true
                    weight <- edge_weights[origin * 8 + destination]
            payload: mutable i64[9] = zeroed
            payload[0] <- if present: 1 else: 0
            payload[1] <- weight
            undirected_adjacency_list_graph_push_record(words[0:144], word_count, opcode, payload[0:9], 2)
        else:
            payload: mutable i64[9] = zeroed
            payload[0] <- node_count.i64()
            undirected_adjacency_list_graph_push_record(words[0:144], word_count, opcode, payload[0:9], 1)
        operation_index <- operation_index + 1

    output_bytes: usize = word_count * 8
    if output.is_null() or output_capacity < output_bytes:
        return -2
    index: usize = 0
    while index < word_count:
        undirected_adjacency_list_graph_store_i64_le(output[0:output_bytes], index * 8, words[index])
        index <- index + 1
    output_bytes.i64()

export fn undirected_adjacency_list_graph(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = undirected_adjacency_list_graph_impl
