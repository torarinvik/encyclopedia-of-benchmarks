# Solve unbounded knapsack with the source's take-again or skip-previous recurrence.
def unbounded_knapsack_solve(item: usize, capacity: usize, values: i64&, weights: i64&, memo: i64&[16][101]) -> i64:
    if item == 0: return (capacity.i64() / weights[0]) * values[0]
    if memo[item][capacity] >= 0: return memo[item][capacity]
    skip: i64 = unbounded_knapsack_solve(item - 1, capacity, values, weights, memo)
    take: mutable i64 = 0
    if capacity.i64() >= weights[item]: take <- values[item] + unbounded_knapsack_solve(item, capacity - weights[item].usize(), values, weights, memo)
    if take > skip: memo[item][capacity] <- take
    else: memo[item][capacity] <- skip
    memo[item][capacity]

def unbounded_knapsack_impl(input: i64&, length: usize) -> i64:
    if length < 2: return -1
    nv: i64 = input[0]
    cv: i64 = input[1]
    if nv < 0 or nv > 16 or cv < 0 or cv > 100: return -1
    n: usize = nv.usize()
    capacity: usize = cv.usize()
    if length != 2 + 2 * n: return -1
    if n == 0: return 0
    values: i64& = input[2]
    weights: i64& = input[2 + n]
    for i in 0..<n:
        if values[i] < 1 or values[i] > 100 or weights[i] < 1 or weights[i] > 100: return -1
    memo: mutable i64[16][101] = zeroed
    for i in 0..<16:
        for c in 0..<=100: memo[i][c] <- -1
    unbounded_knapsack_solve(n - 1, capacity, values, weights, memo)

export fn unbounded_knapsack(input: i64&, length: usize) -> i64 = unbounded_knapsack_impl
