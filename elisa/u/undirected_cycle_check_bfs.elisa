def undirected_cycle_check_bfs_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > 514:
        return -1
    values: i64& = input
    if values[0] < 0 or values[0] > 32 or values[1] < 0 or values[1] > 256:
        return -1
    n: usize = values[0].usize()
    m: usize = values[1].usize()
    if length != 2 + 2 * m:
        return -1
    adjacent: mutable bool[1024] = zeroed
    i: mutable usize = 0
    while i < m:
        a: i64 = values[2 + 2 * i]
        b: i64 = values[3 + 2 * i]
        if a < 0 or b < 0 or a >= n.i64() or b >= n.i64():
            return -1
        u: usize = a.usize()
        v: usize = b.usize()
        if adjacent[32 * u + v]:
            return -1
        adjacent[32 * u + v] <- true
        adjacent[32 * v + u] <- true
        i <- i + 1
    visited: mutable bool[32] = zeroed
    parent: mutable usize[32] = zeroed
    queue: mutable usize[32] = zeroed
    root: mutable usize = 0
    while root < n:
        if not visited[root]:
            head: mutable usize = 0
            tail_value: mutable usize = 1
            queue[0] <- root
            parent[root] <- n
            visited[root] <- true
            while head < tail_value:
                u: usize = queue[head]
                head <- head + 1
                v: mutable usize = 0
                while v < n:
                    if adjacent[32 * u + v]:
                        if not visited[v]:
                            visited[v] <- true
                            parent[v] <- u
                            queue[tail_value] <- v
                            tail_value <- tail_value + 1
                        else:
                            if v != parent[u]:
                                return 1
                    v <- v + 1
        root <- root + 1
    0

export fn undirected_cycle_check_bfs(input: i64&, length: usize) -> i64 = undirected_cycle_check_bfs_impl
