const UKK_MAX_TEXT: usize = 64
const UKK_MAX_SYMBOLS: usize = UKK_MAX_TEXT + 1
const UKK_MAX_NODES: usize = 2 * UKK_MAX_SYMBOLS
const UKK_MAX_INPUT_LENGTH: usize = UKK_MAX_TEXT + 2

struct UkkonenNode:
    start: usize
    end: usize
    suffix_link: usize
    suffix_start: i64
    open_end: bool
    children: i64[5]

def ukk_new_node(nodes: mutable view[UkkonenNode], used: mutable usize&,
                 start: usize, end: usize, open_end: bool,
                 suffix_start: i64) -> i64:
    if used >= UKK_MAX_NODES:
        return -1
    node_id: usize = used
    used <- used + 1
    nodes[node_id] <- zeroed
    nodes[node_id].start <- start
    nodes[node_id].end <- end
    nodes[node_id].suffix_link <- 0
    nodes[node_id].suffix_start <- suffix_start
    nodes[node_id].open_end <- open_end
    for symbol in 0..<5:
        nodes[node_id].children[symbol] <- -1
    node_id.i64()

def ukk_edge_end(nodes: view[UkkonenNode], node_id: usize,
                 current_end: usize) -> usize:
    if nodes[node_id].open_end:
        return current_end
    nodes[node_id].end

def ukk_append_token(token: i64, position: mutable i64&,
                     hash: mutable i64&) -> void:
    hash <- hash + position * token
    position <- position + 1

def ukk_emit(nodes: view[UkkonenNode], text: view[i64], node_id: usize,
             current_end: usize, distinct: mutable i64&,
             position: mutable i64&, hash: mutable i64&) -> bool:
    for symbol in 0..<5:
        child_value: i64 = nodes[node_id].children[symbol]
        if child_value < 0:
            continue
        child_id: usize = child_value.usize()
        end: usize = ukk_edge_end(nodes, child_id, current_end)
        edge_length: usize = end - nodes[child_id].start + 1
        if edge_length == 0:
            return false

        ukk_append_token(1, &position, &hash)
        ukk_append_token(edge_length.i64(), &position, &hash)
        for offset in 0..<edge_length:
            edge_symbol: i64 = text[nodes[child_id].start + offset]
            ukk_append_token(edge_symbol + 1, &position, &hash)
            if edge_symbol != 4:
                distinct <- distinct + 1

        has_children: mutable bool = false
        for next_symbol in 0..<5:
            if nodes[child_id].children[next_symbol] >= 0:
                has_children <- true
                break
        if has_children:
            ukk_append_token(3, &position, &hash)
            if not ukk_emit(nodes, text, child_id, current_end, distinct,
                            &position, &hash):
                return false
            ukk_append_token(4, &position, &hash)
        else:
            if nodes[child_id].suffix_start < 0:
                return false
            ukk_append_token(2, &position, &hash)
            ukk_append_token(nodes[child_id].suffix_start + 1, &position, &hash)
    true

def ukkonen_suffix_tree_impl(input: view[i64], length: usize) -> i64:
    if length < 1 or length > UKK_MAX_INPUT_LENGTH:
        return -1
    if input[0] < 0 or input[0] > UKK_MAX_TEXT.i64():
        return -1
    text_length: usize = input[0].usize()
    if length != text_length + 1:
        return -1

    text: mutable i64[UKK_MAX_SYMBOLS] = zeroed
    for index in 0..<text_length:
        symbol: i64 = input[index + 1]
        if symbol < 0 or symbol > 3:
            return -1
        text[index] <- symbol
    total_length: usize = text_length + 1
    text[text_length] <- 4

    nodes: mutable UkkonenNode[UKK_MAX_NODES] = zeroed
    used: mutable usize = 0
    root_value: i64 = ukk_new_node(nodes[0:UKK_MAX_NODES], &used, 0, 0, false, -1)
    if root_value != 0:
        return -1
    root: usize = root_value.usize()

    active_node: mutable usize = root
    active_edge: mutable usize = 0
    active_length: mutable usize = 0
    remaining: mutable usize = 0
    leaf_end: mutable usize = 0
    for phase in 0..<total_length:
        leaf_end <- phase
        remaining <- remaining + 1
        last_new_internal: mutable i64 = -1
        while remaining > 0:
            if active_length == 0:
                active_edge <- phase
            edge_symbol: usize = text[active_edge].usize()
            next_value: i64 = nodes[active_node].children[edge_symbol]
            if next_value < 0:
                suffix_start: usize = phase - remaining + 1
                leaf: i64 = ukk_new_node(nodes[0:UKK_MAX_NODES], &used,
                    phase, 0, true, suffix_start.i64())
                if leaf < 0:
                    return -1
                nodes[active_node].children[edge_symbol] <- leaf
                if last_new_internal >= 0:
                    nodes[last_new_internal.usize()].suffix_link <- active_node
                    last_new_internal <- -1
            else:
                next_id: usize = next_value.usize()
                next_end: usize = ukk_edge_end(nodes[0:UKK_MAX_NODES], next_id, leaf_end)
                edge_length: usize = next_end - nodes[next_id].start + 1
                if active_length >= edge_length:
                    active_edge <- active_edge + edge_length
                    active_length <- active_length - edge_length
                    active_node <- next_id
                    continue
                if text[nodes[next_id].start + active_length] == text[phase]:
                    if last_new_internal >= 0:
                        nodes[last_new_internal.usize()].suffix_link <- active_node
                        last_new_internal <- -1
                    active_length <- active_length + 1
                    break

                split_start: usize = nodes[next_id].start
                split_end: usize = split_start + active_length - 1
                split: i64 = ukk_new_node(nodes[0:UKK_MAX_NODES], &used,
                    split_start, split_end, false, -1)
                if split < 0:
                    return -1
                nodes[active_node].children[edge_symbol] <- split
                suffix_start: usize = phase - remaining + 1
                leaf: i64 = ukk_new_node(nodes[0:UKK_MAX_NODES], &used,
                    phase, 0, true, suffix_start.i64())
                if leaf < 0:
                    return -1
                nodes[split.usize()].children[text[phase].usize()] <- leaf
                nodes[next_id].start <- nodes[next_id].start + active_length
                old_symbol: usize = text[nodes[next_id].start].usize()
                nodes[split.usize()].children[old_symbol] <- next_value
                if last_new_internal >= 0:
                    nodes[last_new_internal.usize()].suffix_link <- split.usize()
                last_new_internal <- split

            remaining <- remaining - 1
            if active_node == root and active_length > 0:
                active_length <- active_length - 1
                active_edge <- phase - remaining + 1
            else if active_node != root:
                active_node <- nodes[active_node].suffix_link

    distinct: mutable i64 = 0
    token_position: mutable i64 = 1
    hash: mutable i64 = 0
    ukk_append_token(0, &token_position, &hash)
    if not ukk_emit(nodes[0:UKK_MAX_NODES], text[0:total_length], root,
                    leaf_end, &distinct, &token_position, &hash):
        return -1
    ukk_append_token(4, &token_position, &hash)
    if used > UKK_MAX_NODES or distinct > 2080 or hash > 2576350140:
        return -1
    (used.i64() << 44) | (distinct << 32) | hash

export fn ukkonen_suffix_tree(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > UKK_MAX_INPUT_LENGTH:
        return -1
    input_view: view[i64] = input[0:length]
    ukkonen_suffix_tree_impl(input_view, length)
