# Iterative bitwise XOR for two nonnegative uint53 operands.
def uint53_xor_impl(left_input: i64, right_input: i64) -> i64:
    if left_input < 0 or left_input > 9007199254740991 or right_input < 0 or right_input > 9007199254740991:
        return -1
    left: mutable i64 = left_input
    right: mutable i64 = right_input
    result: mutable i64 = 0
    bit: mutable i64 = 1
    while left != 0 and right != 0:
        left_bit: i64 = left % 2
        right_bit: i64 = right % 2
        result <- result + ((left_bit + right_bit) % 2) * bit
        left <- (left - left_bit) / 2
        right <- (right - right_bit) / 2
        bit <- bit * 2
    result + (left + right) * bit

export fn uint53_xor(left: i64, right: i64) -> i64 = uint53_xor_impl
