const MAX_N: usize = 64
const MAX_Q: usize = 256
const MODULUS: i64 = 998244353

def normalize(value_input: i64) -> i64:
    value: mutable i64 = value_input % MODULUS
    if value < 0: value <- value + MODULUS
    value

def find_root(parent: mutable view[usize], difference: mutable view[i64], item: usize) -> usize:
    if parent[item] != item:
        old_parent: usize = parent[item]
        root: usize = find_root(parent, difference, old_parent)
        difference[item] <- normalize(difference[item] + difference[old_parent])
        parent[item] <- root
    parent[item]

def put_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def unionfind_with_potential_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 6 or length > 2 + 4 * MAX_Q: return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    if n_value < 1 or n_value > MAX_N.i64() or q_value < 1 or q_value > MAX_Q.i64(): return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if length != 2 + 4 * q: return -1

    operation: mutable usize = 0
    while operation < q:
        position: usize = 2 + 4 * operation
        kind: i64 = input[position]
        u: i64 = input[position + 1]
        v: i64 = input[position + 2]
        x: i64 = input[position + 3]
        if u < 0 or u >= n_value or v < 0 or v >= n_value: return -1
        if kind == 0:
            if x < 0 or x >= MODULUS: return -1
        elif kind == 1:
            if x != 0: return -1
        else:
            return -1
        operation <- operation + 1
    required: usize = 8 * q
    if output.is_null() or capacity < required: return -2

    parent: mutable usize[MAX_N] = zeroed
    set_size: mutable usize[MAX_N] = zeroed
    difference: mutable i64[MAX_N] = zeroed
    for item in 0..n:
        parent[item] <- item
        set_size[item] <- 1
    operation <- 0
    while operation < q:
        position: usize = 2 + 4 * operation
        kind: i64 = input[position]
        u: usize = input[position + 1].usize()
        v: usize = input[position + 2].usize()
        x: i64 = input[position + 3]
        root_u: usize = find_root(parent[0:MAX_N], difference[0:MAX_N], u)
        root_v: usize = find_root(parent[0:MAX_N], difference[0:MAX_N], v)
        answer: mutable i64 = 0
        if kind == 1:
            if root_u == root_v: answer <- normalize(difference[u] - difference[v])
            else: answer <- -1
        elif root_u == root_v:
            answer <- if normalize(difference[u] - difference[v]) == x: 1 else: 0
        elif set_size[root_u] < set_size[root_v]:
            parent[root_u] <- root_v
            difference[root_u] <- normalize(x - difference[u] + difference[v])
            set_size[root_v] <- set_size[root_v] + set_size[root_u]
            answer <- 1
        else:
            parent[root_v] <- root_u
            difference[root_v] <- normalize(difference[u] - difference[v] - x)
            set_size[root_u] <- set_size[root_u] + set_size[root_v]
            answer <- 1
        put_i64_le(output[0:capacity], 8 * operation, answer)
        operation <- operation + 1
    required.i64()

export fn unionfind_with_potential(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = unionfind_with_potential_impl
