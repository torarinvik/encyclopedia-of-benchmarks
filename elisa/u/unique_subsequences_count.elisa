# Count distinct nonempty subsequences using the source suffix recurrence.
def unique_subsequences_count_impl(input: i64&, length: usize) -> i64:
    if length < 1 or length > 31:
        return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > 30 or length != n_value.usize() + 1:
        return -1
    n: usize = n_value.usize()
    index: usize = 0
    while index < n:
        if input[index + 1] < 0 or input[index + 1] > 127:
            return -1
        index <- index + 1
    dp: mutable i64[31] = zeroed
    end: mutable usize = n
    while end > 0:
        i: usize = end - 1
        seen: mutable bool[128] = zeroed
        j: mutable usize = i
        while j < n:
            ch: usize = input[j + 1].usize()
            if not seen[ch]:
                seen[ch] <- true
                dp[i] <- dp[i] + 1 + dp[j + 1]
            j <- j + 1
        end <- end - 1
    dp[0]

export fn unique_subsequences_count(input: i64&, length: usize) -> i64 = unique_subsequences_count_impl
