const MAX_N: i64 = 14
const MAX_CANDIDATE: i64 = 64
const MAX_SUM: usize = 74
const MAX_PARSEABLE_LENGTH: usize = 2

def ulam_sequence_1_2_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 1 or input_length > MAX_PARSEABLE_LENGTH: return -1
    requested:  i64 = input[0]
    if input_length != 1 or requested < 1 or requested > MAX_N: return -1

    terms: mutable i64[14] = zeroed
    representations: mutable i64[75] = zeroed
    terms_view: mutable view[i64] = terms[0:14]
    reps_view: mutable view[i64] = representations[0:75]
    terms_view[0] <- 1
    terms_view[1] <- 2
    reps_view[3] <- 1
    term_count: mutable usize = 2

    while term_count < requested.usize():
        candidate: mutable i64 = terms_view[term_count - 1] + 1
        while candidate <= MAX_CANDIDATE and reps_view[candidate.usize()] != 1:
            candidate <- candidate + 1
        if candidate > MAX_CANDIDATE: return -1
        old: mutable usize = 0
        while old < term_count:
            sum: usize = (candidate + terms_view[old]).usize()
            if reps_view[sum] < 2: reps_view[sum] <- reps_view[sum] + 1
            old <- old + 1
        terms_view[term_count] <- candidate
        term_count <- term_count + 1
    terms_view[requested.usize() - 1]

def ulam_sequence_1_2_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_PARSEABLE_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    ulam_sequence_1_2_impl(input_view, input_view_length)

export fn ulam_sequence_1_2(input: i64&, length: usize) -> i64 = ulam_sequence_1_2_entry
