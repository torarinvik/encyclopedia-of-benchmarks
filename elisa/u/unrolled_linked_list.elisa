def unrolled_linked_list_impl(values: i64&, length: usize) -> i64:
    if length > 1024: return -1
    chunks: mutable i64[2560] = zeroed
    counts: mutable i64[512] = zeroed
    next: mutable usize[512] = zeroed
    blocks: mutable usize = 0
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < -1000000 or value > 1000000: return -1
        if blocks == 0:
            blocks <- 1
            counts[0] <- 1
            chunks[0] <- value
        elif counts[blocks - 1] < 4:
            slot: usize = blocks - 1
            chunks[slot * 5 + counts[slot]] <- value
            counts[slot] <- counts[slot] + 1
        else:
            tail_index: usize = blocks - 1
            keep: usize = counts[tail_index] / 2 + 1
            moved: usize = counts[tail_index] - keep
            j: mutable usize = 0
            while j < moved:
                chunks[blocks * 5 + j] <- chunks[tail_index * 5 + keep + j]
                j <- j + 1
            counts[tail_index] <- keep
            chunks[blocks * 5 + moved] <- value
            counts[blocks] <- moved + 1
            next[tail_index] <- blocks
            blocks <- blocks + 1
        index <- index + 1
    checksum: mutable i64 = 0
    logical_index: mutable usize = 0
    block: mutable usize = 0
    while block < 512:
        slot: mutable usize = 0
        while slot < counts[block]:
            checksum <- checksum + (logical_index.i64() + 1) * (chunks[block * 5 + slot] + 1000000)
            logical_index <- logical_index + 1
            slot <- slot + 1
        if next[block] == 0: break
        block <- next[block]
    checksum

export fn unrolled_linked_list_benchmark(values: i64&, length: usize) -> i64 = unrolled_linked_list_impl
