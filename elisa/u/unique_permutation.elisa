const MAX_LENGTH: usize = 6

def unique_permutation_generate(values: view[i64], n: usize, depth: usize,
        current: mutable view[i64], used: mutable view[bool], output: mutable view[u8],
        result_count: mutable usize&) -> void:
    if depth == n:
        row: usize = result_count * n
        index: usize = 0
        while index < n:
            output[row + index] <- current[index].u8()
            index <- index + 1
        result_count <- result_count + 1
    else:
        index: mutable usize = 0
        while index < n:
            skip_duplicate: bool = index > 0 and values[index] == values[index - 1] and not used[index - 1]
            if not used[index] and not skip_duplicate:
                current[depth] <- values[index]
                used[index] <- true
                unique_permutation_generate(values, n, depth + 1, current, used, output, result_count)
                used[index] <- false
            index <- index + 1

def unique_permutation_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or length > MAX_LENGTH + 1:
        return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > i64(MAX_LENGTH) or length != usize(n_value) + 1:
        return -1
    n: usize = n_value.usize()
    values: mutable i64[MAX_LENGTH] = zeroed
    index: mutable usize = 0
    while index < n:
        value: i64 = input[index + 1]
        if value < 0 or value > 127:
            return -1
        values[index] <- value
        index <- index + 1
    index <- 1
    while index < n:
        value: i64 = values[index]
        position: mutable usize = index
        while position > 0 and values[position - 1] > value:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- value
        index <- index + 1
    max_count: mutable usize = 1
    factor: mutable usize = 2
    while factor <= n:
        max_count <- max_count * factor
        factor <- factor + 1
    required: usize = max_count * n
    if output_capacity < required:
        return -2
    current: mutable i64[MAX_LENGTH] = zeroed
    used: mutable bool[MAX_LENGTH] = zeroed
    result_count: mutable usize = 0
    unique_permutation_generate(values[0:n], n, 0, current[0:n], used[0:n],
            output[0:output_capacity], result_count)
    result_count.i64()

export fn unique_permutation(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = unique_permutation_impl
