def upper_bound_range(values: i64&, target: i64, left: i64, right: i64) -> i64:
    if right <= left:
        left
    else:
        middle: i64 = (left + right) / 2
        if target < values[(middle + 1).usize()]:
            upper_bound_range(values, target, left, middle)
        else:
            upper_bound_range(values, target, middle + 1, right)

def upper_bound_impl(values: i64&, length: usize) -> i64:
    if values == null or length == 0 or length > 513:
        -1
    else:
        target: i64 = values[0]
        if target < -2147483648 or target > 2147483647:
            -1
        else:
            array_length: usize = length - 1
            invalid: mutable bool = false
            for i in 0..<array_length:
                value: i64 = values[i + 1]
                if value < -2147483648 or value > 2147483647 or (i > 0 and values[i] > value):
                    invalid <- true
            if invalid:
                -1
            else:
                upper_bound_range(values, target, 0, array_length.i64() - 1)

export fn upper_bound(values: i64&, length: usize) -> i64 = upper_bound_impl
