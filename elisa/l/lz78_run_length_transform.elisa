const LZ78RT_MAX_TEXT: usize = 32
const LZ78RT_MAX_INPUT: usize = 34
const LZ78RT_MAX_TRIE_NODES: usize = 33
const LZ78RT_MAX_TOKENS: usize = 32
const LZ78RT_MAX_OUTPUT: usize = 776

def lz78rt_store(staged: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        staged[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def lz78rt_impl(input: view[i64], staged: mutable view[u8]) -> i64:
    length: usize = input.len()
    if length < 1 or length > LZ78RT_MAX_INPUT: return -1
    if input[0] < 0 or input[0] > LZ78RT_MAX_TEXT.i64(): return -1
    n: usize = input[0].usize()
    if length != n + 1: return -1
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < 1 or input[i + 1] > 3: return -1
        i <- i + 1

    transformed: mutable i64[LZ78RT_MAX_TEXT] = zeroed
    transformed_length: mutable usize = 0
    position: mutable usize = 0
    while position < n:
        symbol: i64 = input[position + 1]
        end: mutable usize = position + 1
        while end < n and input[end + 1] == symbol: end <- end + 1
        run_length: usize = end - position
        highest_bit: mutable usize = 0
        value: mutable usize = run_length
        while value > 1:
            value <- value >> 1
            highest_bit <- highest_bit + 1
        bit: mutable usize = highest_bit + 1
        while bit > 0:
            bit <- bit - 1
            transformed[transformed_length] <- if ((run_length >> bit) & 1) == 1: symbol else: 0
            transformed_length <- transformed_length + 1
        position <- end

    children: mutable usize[LZ78RT_MAX_TRIE_NODES][4] = zeroed
    tokens: mutable i64[LZ78RT_MAX_TOKENS][3] = zeroed
    token_count: mutable usize = 0
    text_position: mutable usize = 0
    next_phrase_id: mutable usize = 1
    while text_position < transformed_length:
        node: mutable usize = 0
        end: mutable usize = text_position
        while end < transformed_length:
            child: usize = children[node][transformed[end].usize()]
            if child == 0: break
            node <- child
            end <- end + 1
        if end == transformed_length:
            if node != 0:
                tokens[token_count][0] <- node.i64()
                tokens[token_count][1] <- 0
                tokens[token_count][2] <- 1
                token_count <- token_count + 1
            break
        symbol: usize = transformed[end].usize()
        tokens[token_count][0] <- node.i64()
        tokens[token_count][1] <- symbol.i64()
        tokens[token_count][2] <- 0
        token_count <- token_count + 1
        children[node][symbol] <- next_phrase_id
        next_phrase_id <- next_phrase_id + 1
        text_position <- end + 1

    lz78rt_store(staged, 0, token_count.i64())
    token: mutable usize = 0
    while token < token_count:
        field: mutable usize = 0
        while field < 3:
            lz78rt_store(staged, 8 + token * 24 + field * 8, tokens[token][field])
            field <- field + 1
        token <- token + 1
    (8 + 24 * token_count).i64()

export fn lz78_run_length_transform(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > LZ78RT_MAX_INPUT: return -1
    staged: mutable u8[LZ78RT_MAX_OUTPUT] = zeroed
    bytes: i64 = lz78rt_impl(input[0:length], staged[0:LZ78RT_MAX_OUTPUT])
    if bytes < 0: return bytes
    if output.is_null() or capacity < bytes.usize(): return -2
    i: mutable usize = 0
    while i < bytes.usize():
        output[i] <- staged[i]
        i <- i + 1
    bytes
