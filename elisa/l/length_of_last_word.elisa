def length_of_last_word_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > 129: return -1
    if input[0] < 0 or input[0] > 128 or length != input[0].usize() + 1: return -1
    index: mutable usize = input[0].usize()
    while index > 0 and input[index] == 32: index <- index - 1
    word_length: mutable i64 = 0
    while index > 0 and input[index] != 32:
        if input[index] < 0 or input[index] > 255: return -1
        word_length <- word_length + 1
        index <- index - 1
    i: mutable usize = 1
    while i < length:
        if input[i] < 0 or input[i] > 255: return -1
        i <- i + 1
    word_length

export fn length_of_last_word(input: i64&, length: usize) -> i64 = length_of_last_word_impl
