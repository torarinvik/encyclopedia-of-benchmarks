const INVALID_RESULT: i64 = -1
const MAX_DOMAIN_VALUE: i64 = 2147483647
const MAX_INPUT_LENGTH: usize = 259

def longest_subarray_with_sum_less_or_equal_to_k_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_LENGTH:
        return INVALID_RESULT
    target: i64 = input[0]
    raw_count: i64 = input[1]
    if target < 0 or target > MAX_DOMAIN_VALUE or raw_count < 0 or raw_count > 256:
        return INVALID_RESULT
    count: usize = raw_count.usize()
    if length != count + 2:
        return INVALID_RESULT

    total_sum: mutable i64 = 0
    index: mutable usize = 0
    while index < count:
        value: i64 = input[index + 2]
        if value < 0 or value > MAX_DOMAIN_VALUE:
            return INVALID_RESULT
        total_sum <- total_sum + value
        index <- index + 1
    if total_sum > MAX_DOMAIN_VALUE:
        return INVALID_RESULT

    left: mutable usize = 0
    best_length: mutable usize = 0
    window_sum: mutable i64 = 0
    right: mutable usize = 0
    while right < count:
        window_sum <- window_sum + input[right + 2]
        while window_sum > target and left <= right:
            window_sum <- window_sum - input[left + 2]
            left <- left + 1
        current_length: usize = 0
        if left <= right:
            current_length = right - left + 1
        if current_length > best_length:
            best_length <- current_length
        right <- right + 1
    best_length.i64()

export fn longest_subarray_with_sum_less_or_equal_to_k(
    input: i64&, length: usize
) -> i64 = longest_subarray_with_sum_less_or_equal_to_k_impl
