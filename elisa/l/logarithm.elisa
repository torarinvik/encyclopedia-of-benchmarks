# Return floor(log2(input)) using the pinned Go source's mask-and-shift steps.
def logarithm_impl(input: i64) -> i64:
    if input < 1 or input > 4294967295:
        return -1
    value: mutable i64 = input
    result: mutable i64 = 0
    if (value & 0xFFFF0000) != 0:
        value <- value >> 16
        result <- result + 16
    if (value & 0x0000FF00) != 0:
        value <- value >> 8
        result <- result + 8
    if (value & 0x000000F0) != 0:
        value <- value >> 4
        result <- result + 4
    if (value & 0x0000000C) != 0:
        value <- value >> 2
        result <- result + 2
    if (value & 0x00000002) != 0:
        result <- result + 1
    result

export fn logarithm(input: i64) -> i64 = logarithm_impl
