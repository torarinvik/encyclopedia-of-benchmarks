const LWE_ENCRYPTION_INVALID_RESULT: i64 = -1
const LWE_ENCRYPTION_DIMENSION: usize = 32
const LWE_ENCRYPTION_MODULUS: i64 = 3329
const LWE_ENCRYPTION_SAMPLES: usize = 128
const LWE_ENCRYPTION_MAX_MESSAGE_BYTES: usize = 4
const LWE_ENCRYPTION_MAX_PARSEABLE_LENGTH: usize = 8358
const LWE_ENCRYPTION_FNV_OFFSET: u64 = 14695981039346656037.u64()
const LWE_ENCRYPTION_FNV_PRIME: u64 = 1099511628211.u64()

def lwe_encryption_hash_byte(hash_input: u64, byte: u64) -> u64:
    (hash_input ^ byte) * LWE_ENCRYPTION_FNV_PRIME

def lwe_encryption_hash_word(hash_input: u64, value: i64) -> u64:
    hash: mutable u64 = hash_input
    bits: u64 = value.u64()
    hash <- lwe_encryption_hash_byte(hash, bits & 255.u64())
    hash <- lwe_encryption_hash_byte(hash, (bits >> 8) & 255.u64())
    hash

def lwe_encryption_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 1 or length > LWE_ENCRYPTION_MAX_PARSEABLE_LENGTH: return -1
    message_length_value: i64 = values[0]
    if message_length_value < 1 or message_length_value > LWE_ENCRYPTION_MAX_MESSAGE_BYTES.i64(): return -1
    message_length: usize = message_length_value.usize()
    message_start: usize = 1
    message_end: usize = message_start + message_length
    secret_start: usize = message_end
    matrix_start: usize = secret_start + LWE_ENCRYPTION_DIMENSION
    error_start: usize = matrix_start + LWE_ENCRYPTION_SAMPLES * LWE_ENCRYPTION_DIMENSION
    subset_start: usize = error_start + LWE_ENCRYPTION_SAMPLES
    subset_count: usize = message_length * 8 * LWE_ENCRYPTION_SAMPLES
    if length != subset_start + subset_count: return -1

    index: mutable usize = 0
    while index < message_length:
        value: i64 = values[message_start + index]
        if value < 0 or value > 255: return -1
        index <- index + 1
    index <- 0
    while index < LWE_ENCRYPTION_DIMENSION:
        value: i64 = values[secret_start + index]
        if value < 0 or value >= LWE_ENCRYPTION_MODULUS: return -1
        index <- index + 1
    index <- 0
    while index < LWE_ENCRYPTION_SAMPLES * LWE_ENCRYPTION_DIMENSION:
        value: i64 = values[matrix_start + index]
        if value < 0 or value >= LWE_ENCRYPTION_MODULUS: return -1
        index <- index + 1
    index <- 0
    while index < LWE_ENCRYPTION_SAMPLES:
        value: i64 = values[error_start + index]
        if value < 0 or value > 6: return -1
        index <- index + 1
    index <- 0
    while index < subset_count:
        value: i64 = values[subset_start + index]
        if value != 0 and value != 1: return -1
        index <- index + 1

    public_b: mutable i64[128] = zeroed
    row: mutable usize = 0
    while row < LWE_ENCRYPTION_SAMPLES:
        sum: mutable i64 = 0
        column: mutable usize = 0
        while column < LWE_ENCRYPTION_DIMENSION:
            sum <- sum + values[matrix_start + row * LWE_ENCRYPTION_DIMENSION + column] * values[secret_start + column]
            column <- column + 1
        error: i64 = values[error_start + row] - 3
        reduced: mutable i64 = (sum + error) % LWE_ENCRYPTION_MODULUS
        if reduced < 0: reduced <- reduced + LWE_ENCRYPTION_MODULUS
        public_b[row] <- reduced
        row <- row + 1

    hash: mutable u64 = LWE_ENCRYPTION_FNV_OFFSET
    decoded_message: mutable u8[4] = zeroed
    subset_cursor: mutable usize = 0
    byte_index: mutable usize = 0
    while byte_index < message_length:
        message_byte: i64 = values[message_start + byte_index]
        decoded_byte: mutable u8 = 0
        bit_index: mutable usize = 0
        while bit_index < 8:
            message_bit: i64 = (message_byte >> (7 - bit_index)) & 1
            u_accumulator: mutable i64[32] = zeroed
            v_accumulator: mutable i64 = message_bit * (LWE_ENCRYPTION_MODULUS / 2)
            row <- 0
            while row < LWE_ENCRYPTION_SAMPLES:
                selected: i64 = values[subset_start + subset_cursor]
                subset_cursor <- subset_cursor + 1
                if selected != 0:
                    column <- 0
                    while column < LWE_ENCRYPTION_DIMENSION:
                        u_accumulator[column] <- u_accumulator[column] + values[matrix_start + row * LWE_ENCRYPTION_DIMENSION + column]
                        column <- column + 1
                    v_accumulator <- v_accumulator + public_b[row]
                row <- row + 1
            u: mutable i64[32] = zeroed
            column <- 0
            while column < LWE_ENCRYPTION_DIMENSION:
                u[column] <- u_accumulator[column] % LWE_ENCRYPTION_MODULUS
                hash <- lwe_encryption_hash_word(hash, u[column])
                column <- column + 1
            v: i64 = v_accumulator % LWE_ENCRYPTION_MODULUS
            hash <- lwe_encryption_hash_word(hash, v)

            dot: mutable i64 = 0
            column <- 0
            while column < LWE_ENCRYPTION_DIMENSION:
                dot <- dot + u[column] * values[secret_start + column]
                column <- column + 1
            difference: mutable i64 = (v - dot) % LWE_ENCRYPTION_MODULUS
            if difference < 0: difference <- difference + LWE_ENCRYPTION_MODULUS
            decrypted_bit: i64 = if difference >= 832 and difference < 2496: 1 else: 0
            decoded_byte <- (decoded_byte << 1) | decrypted_bit.u8()
            bit_index <- bit_index + 1
        decoded_message[byte_index] <- decoded_byte
        byte_index <- byte_index + 1
    byte_index <- 0
    while byte_index < message_length:
        hash <- lwe_encryption_hash_byte(hash, decoded_message[byte_index].u64())
        byte_index <- byte_index + 1
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn lwe_encryption(values: i64&, length: usize) -> i64 = lwe_encryption_impl
