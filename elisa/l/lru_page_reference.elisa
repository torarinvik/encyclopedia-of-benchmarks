def lru_page_reference_put_i64(output: mutable u8&, index: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[index * 8 + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def lru_page_reference_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2 or input[0] < 1 or input[0] > 64 or input[1] < 0 or input[1] > 256: return -1
    limit: i64 = input[0]
    if limit & (limit - 1) != 0: return -1
    n: usize = input[1].usize()
    if length != n + 2: return -1
    index: mutable usize = 0
    while index < n:
        if input[2 + index] < 0 or input[2 + index] > 1000000: return -1
        index <- index + 1
    cache: mutable i64[64] = zeroed
    events: mutable i64[512] = zeroed
    used: mutable usize = 0
    index <- 0
    while index < n:
        page: i64 = input[2 + index]
        position: mutable usize = 0
        while position < used and cache[position] != page: position <- position + 1
        evicted: mutable i64 = -1
        if position < used:
            cursor: mutable usize = position
            while cursor > 0: cache[cursor] <- cache[cursor - 1]; cursor <- cursor - 1
            cache[0] <- page
            events[index * 2] <- 1
        else:
            if used == limit.usize(): used <- used - 1; evicted <- cache[used]
            cursor: mutable usize = used
            while cursor > 0: cache[cursor] <- cache[cursor - 1]; cursor <- cursor - 1
            cache[0] <- page
            used <- used + 1
            events[index * 2] <- 0
        events[index * 2 + 1] <- evicted
        index <- index + 1
    words: usize = n * 2 + 2 + used
    if output.is_null() or capacity < words * 8: return -2
    lru_page_reference_put_i64(output, 0, n.i64())
    index <- 0
    while index < n * 2:
        lru_page_reference_put_i64(output, index + 1, events[index])
        index <- index + 1
    lru_page_reference_put_i64(output, n * 2 + 1, used.i64())
    index <- 0
    while index < used:
        lru_page_reference_put_i64(output, n * 2 + 2 + index, cache[index])
        index <- index + 1
    (words * 8).i64()
