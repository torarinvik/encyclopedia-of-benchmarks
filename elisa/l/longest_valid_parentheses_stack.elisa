const MAX_LENGTH: usize = 4096

# Track unmatched opening positions and the boundary before each valid segment.
def longest_valid_parentheses_stack_impl(input: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    index: mutable usize = 0
    while index < length:
        if input[index] != 40 and input[index] != 41:
            return -1
        index <- index + 1

    unmatched: mutable i64[MAX_LENGTH + 1] = zeroed
    top: mutable usize = 0
    unmatched[0] <- -1
    best: mutable usize = 0
    index <- 0
    while index < length:
        if input[index] == 40:
            top <- top + 1
            unmatched[top] <- index.i64()
        elif top == 0:
            unmatched[0] <- index.i64()
        else:
            top <- top - 1
            start: i64 = unmatched[top]
            current: usize = (index.i64() - start).usize()
            if current > best:
                best <- current
        index <- index + 1
    best.i64()

export fn longest_valid_parentheses_stack(input: i64&, length: usize) -> i64 = longest_valid_parentheses_stack_impl
