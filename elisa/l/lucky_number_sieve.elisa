const MAX_CANDIDATES: usize = 2048
const MAX_BOUND: i64 = 4096

def write_i64_le(output: mutable u8&, offset: usize, value: u64) -> void:
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((value >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def lucky_number_sieve_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length != 2:
        return -1
    mode: i64 = input[0]
    bound: i64 = input[1]
    if (mode != 0 and mode != 1) or bound < 0 or bound > MAX_BOUND:
        return -1

    candidates: mutable i64[MAX_CANDIDATES] = zeroed
    count: mutable usize = 0
    first: mutable i64 = 1
    if mode == 1:
        first <- 2
    value: mutable i64 = first
    while value <= bound:
        candidates[count] <- value
        count <- count + 1
        value <- value + 2

    selected: mutable usize = 1
    while selected < count:
        step: usize = candidates[selected].usize()
        if step > count:
            break
        write: mutable usize = 0
        rank: mutable usize = 0
        read: mutable usize = 0
        while read < count:
            rank <- rank + 1
            if rank % step != 0:
                candidates[write] <- candidates[read]
                write <- write + 1
            read <- read + 1
        count <- write
        selected <- selected + 1

    output_bytes: usize = count * 8
    if output == null or output_capacity < output_bytes:
        return -2
    bytes: mutable u8& = output
    index: mutable usize = 0
    while index < count:
        write_i64_le(bytes, index * 8, candidates[index].u64())
        index <- index + 1
    output_bytes.i64()

export fn lucky_number_sieve(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) -> i64 = lucky_number_sieve_impl
