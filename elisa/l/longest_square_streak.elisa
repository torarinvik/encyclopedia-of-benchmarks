const MAX_INPUT_LENGTH: usize = 100000
const MAX_VALUE: usize = 100000
const REQUIRED_WORKSPACE: usize = 4 * (MAX_VALUE + 1)

def longest_square_streak_read_state(workspace: u8&, value: usize) -> i64:
    position: usize = 4 * value
    state: mutable i64 = workspace[position].i64()
    state <- state + workspace[position + 1].i64() * 256
    state <- state + workspace[position + 2].i64() * 65536
    state <- state + workspace[position + 3].i64() * 16777216
    state

def longest_square_streak_write_state(workspace: mutable u8&, value: usize, state: i64) -> void:
    encoded: mutable i64 = state
    if encoded < 0:
        encoded <- encoded + 4294967296
    position: usize = 4 * value
    workspace[position] <- (encoded & 255).u8()
    workspace[position + 1] <- ((encoded / 256) & 255).u8()
    workspace[position + 2] <- ((encoded / 65536) & 255).u8()
    workspace[position + 3] <- ((encoded / 16777216) & 255).u8()

def longest_square_streak_from(workspace: mutable u8&, value: usize) -> i64:
    state: i64 = longest_square_streak_read_state(workspace, value)
    if state > 1:
        return state - 1
    length: mutable i64 = 1
    square: u64 = u64(value) * u64(value)
    if square <= u64(MAX_VALUE) and longest_square_streak_read_state(workspace, usize(square)) != 0:
        length <- length + longest_square_streak_from(workspace, usize(square))
    longest_square_streak_write_state(workspace, value, length + 1)
    length

def longest_square_streak_impl(values: i64&, length: usize,
        workspace: mutable u8&, workspace_capacity: usize) -> i64:
    if (length < 3 or length > MAX_INPUT_LENGTH + 1 or
            values[0] < 2 or values[0] > i64(MAX_INPUT_LENGTH)):
        return -1
    count: usize = usize(values[0])
    if length != count + 1:
        return -1
    for index in 0..<count |values|:
        if values[index + 1] < 2 or values[index + 1] > i64(MAX_VALUE):
            return -1
    if workspace_capacity < REQUIRED_WORKSPACE:
        return -2
    for byte_index in 0..<REQUIRED_WORKSPACE |workspace|:
        workspace[byte_index] <- 0
    for index in 0..<count |values, workspace|:
        longest_square_streak_write_state(workspace, usize(values[index + 1]), 1)
    longest: mutable i64 = 1
    for index in 0..<count |values, workspace, longest|:
        found: i64 = longest_square_streak_from(workspace, usize(values[index + 1]))
        if found > longest:
            longest <- found
    if longest >= 2:
        return longest
    -1

export fn longest_square_streak(values: i64&, length: usize,
        workspace: mutable u8&, workspace_capacity: usize) -> i64 = longest_square_streak_impl
