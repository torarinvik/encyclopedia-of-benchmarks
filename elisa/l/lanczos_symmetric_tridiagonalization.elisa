extern sqrt(value: f64) -> f64

const MAX_PARSEABLE_INPUT_LENGTH: usize = 19
const MAX_ORDER: i64 = 4

def lanczos_finite(value: f64) -> bool:
    value == value and value >= -1.7976931348623157e308 and value <= 1.7976931348623157e308

def lanczos_integer(value: f64, low: i64, high: i64) -> bool:
    if not lanczos_finite(value) or value < low.f64() or value > high.f64(): return false
    value.i64().f64() == value

def lanczos_valid(input: f64&, input_length: usize) -> bool:
    if input_length < 3 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return false
    for index in 0..<input_length:
        if not lanczos_finite(input[index]): return false
    if not lanczos_integer(input[0], 1, MAX_ORDER) or not lanczos_integer(input[1], 1, MAX_ORDER): return false
    n: i64 = input[0].i64()
    k: i64 = input[1].i64()
    if k > n or input_length != (2 + n * n).usize(): return false
    for row in 0..<n.usize():
        for col in 0..<n.usize():
            value: f64 = input[2 + row * n.usize() + col]
            if not lanczos_integer(value, -4, 4): return false
            if value != input[2 + col * n.usize() + row]: return false
    true

def lanczos_compute(input: f64&, output: mutable f64&) -> i64:
    n: i64 = input[0].i64()
    k: i64 = input[1].i64()
    previous: mutable f64[4] = zeroed
    current: mutable f64[4] = zeroed
    product: mutable f64[4] = zeroed
    residual: mutable f64[4] = zeroed
    next: mutable f64[4] = zeroed
    diagonal: mutable f64[4] = zeroed
    off_diagonal: mutable f64[3] = zeroed
    current[0] <- 1.0
    previous_beta: mutable f64 = 0.0
    for step in 0..<k:
        for row in 0..<n.usize():
            product[row] <- 0.0
            for col in 0..<n.usize():
                product[row] <- product[row] + input[2 + row * n.usize() + col] * current[col]
        alpha: mutable f64 = 0.0
        for index in 0..<n.usize():
            alpha <- alpha + current[index] * product[index]
        if not lanczos_finite(alpha): return -3
        diagonal[step.usize()] <- alpha
        if step + 1 == k: break
        norm_squared: mutable f64 = 0.0
        for index in 0..<n.usize():
            residual[index] <- product[index] - alpha * current[index] - previous_beta * previous[index]
            norm_squared <- norm_squared + residual[index] * residual[index]
        if not lanczos_finite(norm_squared) or norm_squared < 0.0: return -3
        beta: f64 = sqrt(norm_squared)
        if not lanczos_finite(beta) or beta <= 9.094947017729282e-13: return -3
        off_diagonal[step.usize()] <- beta
        for index in 0..<n.usize():
            next[index] <- residual[index] / beta
        for index in 0..<n.usize():
            previous[index] <- current[index]
        for index in 0..<n.usize():
            current[index] <- next[index]
        previous_beta <- beta
    output[0] <- k.f64()
    for index in 0..<k:
        output[index.usize() + 1] <- diagonal[index.usize()]
    for index in 0..<(k - 1):
        output[(k + index + 1).usize()] <- off_diagonal[index.usize()]
    (2 * k).i64()

def lanczos_symmetric_tridiagonalization_impl(input: f64&, input_length: usize,
        output: mutable f64&, output_capacity: usize) -> i64:
    if input == null or input_length < 3 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    input_view: f64& = input
    if not lanczos_valid(input_view, input_length): return -1
    k: i64 = input_view[1].i64()
    required: usize = (2 * k).usize()
    if output == null or output_capacity < required: return -2
    output_view: mutable f64& = output
    lanczos_compute(input_view, output_view)

export fn lanczos_symmetric_tridiagonalization(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64 = lanczos_symmetric_tridiagonalization_impl
