# Portable LCM with overflow checked after dividing by the GCD.
def lcm_impl(left: u64, right: u64) -> i64:
    if left == 0 or right == 0:
        return 0
    a: mutable u64 = left
    b: mutable u64 = right
    while b != 0:
        remainder: u64 = a % b
        a <- b
        b <- remainder
    reduced: u64 = left / a
    max_result: u64 = 9223372036854775807.u64()
    if reduced > max_result / right:
        return -1
    (reduced * right).i64()

export fn lcm(left: u64, right: u64) -> i64 = lcm_impl
