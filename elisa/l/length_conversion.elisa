def length_conversion_meters_per_unit(unit: i32) -> f64:
    if unit == 0:
        return 0.001
    if unit == 1:
        return 0.01
    if unit == 2:
        return 1.0
    1000.0

def length_conversion_impl(value: f64, from_unit_input: f64, to_unit_input: f64) -> f64:
    if value != value or value < -1000000.0 or value > 1000000.0:
        return -1e300
    if (from_unit_input != 0.0 and from_unit_input != 1.0 and from_unit_input != 2.0 and from_unit_input != 3.0) or
        (to_unit_input != 0.0 and to_unit_input != 1.0 and to_unit_input != 2.0 and to_unit_input != 3.0):
        return -1e300
    from_unit: i32 = from_unit_input.i32()
    to_unit: i32 = to_unit_input.i32()
    (value * length_conversion_meters_per_unit(from_unit)) / length_conversion_meters_per_unit(to_unit)

export fn length_conversion(value: f64, from_unit_input: f64, to_unit_input: f64) -> f64 = length_conversion_impl
