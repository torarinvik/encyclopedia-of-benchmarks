# Floyd cycle-entry search over a portable successor-index representation.
def valid_successors(next: i64&, length: usize) -> bool:
    if length > 100000:
        return false
    index: mutable usize = 0
    while index < length:
        value: i64 = next[index]
        if value < -1 or value >= length.i64():
            return false
        index <- index + 1
    true

def successor(next: i64&, node: i64) -> i64:
    if node < 0:
        return -1
    next[node.usize()]

def linked_list_cycle_entry_impl(next: i64&, length: usize) -> i64:
    if not valid_successors(next, length):
        return -2
    if length == 0:
        return -1
    slow: mutable i64 = 0
    fast: mutable i64 = 0
    meeting: mutable bool = false
    while fast >= 0:
        first: i64 = successor(next, fast)
        if first < 0:
            break
        slow <- successor(next, slow)
        fast <- successor(next, first)
        if slow == fast:
            meeting <- true
            break
    if not meeting:
        return -1
    entry: mutable i64 = 0
    while entry != slow:
        entry <- successor(next, entry)
        slow <- successor(next, slow)
    entry

# Returns the cycle-entry node index, -1 when acyclic, and -2 for malformed input.
export fn linked_list_cycle_entry(next: i64&, length: usize) -> i64 = linked_list_cycle_entry_impl
