# Dynamic lower-envelope queries for bounded integer lines.
const LI_CHAO_MAX_OPERATIONS: usize = 512
const LI_CHAO_MAX_NODES: usize = LI_CHAO_MAX_OPERATIONS * 24 + 1
const LI_CHAO_DOMAIN_LOW: i64 = -1000000
const LI_CHAO_DOMAIN_HIGH: i64 = 1000000
const LI_CHAO_COEFFICIENT_LIMIT: i64 = 1000
const LI_CHAO_CHECKSUM_OFFSET: i64 = 1000001001

struct LiChaoNode:
    slope: i64
    intercept: i64
    left: i64
    right: i64
    occupied: bool

def li_chao_evaluate(slope: i64, intercept: i64, x: i64) -> i64:
    slope * x + intercept

def li_chao_allocate(nodes: mutable view[LiChaoNode], used: mutable usize&) -> i64:
    if used >= LI_CHAO_MAX_NODES: return -1
    id: usize = used
    used <- used + 1
    nodes[id].slope <- 0
    nodes[id].intercept <- 0
    nodes[id].left <- -1
    nodes[id].right <- -1
    nodes[id].occupied <- false
    id.i64()

def li_chao_insert_at(nodes: mutable view[LiChaoNode], used: mutable usize&,
                      id_value: i64, low: i64, high: i64,
                      new_slope: i64, new_intercept: i64) -> bool:
    id: usize = id_value.usize()
    if not nodes[id].occupied:
        nodes[id].slope <- new_slope
        nodes[id].intercept <- new_intercept
        nodes[id].occupied <- true
        return true

    middle: i64 = low + (high - low) / 2
    slope: mutable i64 = new_slope
    intercept: mutable i64 = new_intercept
    if li_chao_evaluate(slope, intercept, middle) < li_chao_evaluate(nodes[id].slope, nodes[id].intercept, middle):
        old_slope: i64 = nodes[id].slope
        old_intercept: i64 = nodes[id].intercept
        nodes[id].slope <- slope
        nodes[id].intercept <- intercept
        slope <- old_slope
        intercept <- old_intercept
    if low == high: return true

    go_left: mutable bool = false
    next_low: mutable i64 = middle + 1
    next_high: mutable i64 = high
    if li_chao_evaluate(slope, intercept, low) < li_chao_evaluate(nodes[id].slope, nodes[id].intercept, low):
        go_left <- true
        next_low <- low
        next_high <- middle
    else if li_chao_evaluate(slope, intercept, high) >= li_chao_evaluate(nodes[id].slope, nodes[id].intercept, high):
        return true

    child: mutable i64 = if go_left: nodes[id].left else: nodes[id].right
    if child < 0:
        child <- li_chao_allocate(nodes, used)
        if child < 0: return false
        if go_left: nodes[id].left <- child
        else: nodes[id].right <- child
    li_chao_insert_at(nodes, used, child, next_low, next_high, slope, intercept)

def li_chao_add_line(nodes: mutable view[LiChaoNode], used: mutable usize&,
                     root: mutable i64&, slope: i64, intercept: i64) -> bool:
    if root < 0:
        root <- li_chao_allocate(nodes, used)
        if root < 0: return false
    li_chao_insert_at(nodes, used, root, LI_CHAO_DOMAIN_LOW, LI_CHAO_DOMAIN_HIGH,
                      slope, intercept)

def li_chao_minimum_at(nodes: view[LiChaoNode], id_value: i64,
                       low: i64, high: i64, x: i64) -> i64:
    id: usize = id_value.usize()
    node: LiChaoNode = nodes[id]
    best: mutable i64 = li_chao_evaluate(node.slope, node.intercept, x)
    if low == high: return best
    middle: i64 = low + (high - low) / 2
    go_left: bool = x <= middle
    child: i64 = if go_left: node.left else: node.right
    if child >= 0:
        nested: i64 = li_chao_minimum_at(nodes, child,
                                         if go_left: low else: middle + 1,
                                         if go_left: middle else: high, x)
        if nested < best: best <- nested
    best

def li_chao_tree_impl(input_values: i64&, length: usize) -> i64:
    if input_values.is_null() or length < 1 or length > 1 + 3 * LI_CHAO_MAX_OPERATIONS: return -1
    if input_values[0] < 0 or input_values[0] > LI_CHAO_MAX_OPERATIONS.i64(): return -1
    operation_count: usize = input_values[0].usize()
    if length != 1 + 3 * operation_count: return -1

    nodes: mutable LiChaoNode[LI_CHAO_MAX_NODES] = zeroed
    used: mutable usize = 0
    root: mutable i64 = -1
    inserted: mutable usize = 0
    query_number: mutable i64 = 0
    checksum: mutable i64 = 0
    operation: mutable usize = 0
    while operation < operation_count:
        offset: usize = 1 + 3 * operation
        opcode: i64 = input_values[offset]
        first: i64 = input_values[offset + 1]
        second: i64 = input_values[offset + 2]
        if opcode == 0:
            if first < -LI_CHAO_COEFFICIENT_LIMIT or first > LI_CHAO_COEFFICIENT_LIMIT or second < -LI_CHAO_COEFFICIENT_LIMIT or second > LI_CHAO_COEFFICIENT_LIMIT: return -1
            if not li_chao_add_line(nodes[0:LI_CHAO_MAX_NODES], used, root, first, second): return -1
            inserted <- inserted + 1
        else if opcode == 1:
            if first < LI_CHAO_DOMAIN_LOW or first > LI_CHAO_DOMAIN_HIGH or second != 0 or inserted == 0: return -1
            answer: i64 = li_chao_minimum_at(nodes[0:LI_CHAO_MAX_NODES], root,
                                             LI_CHAO_DOMAIN_LOW, LI_CHAO_DOMAIN_HIGH, first)
            query_number <- query_number + 1
            checksum <- checksum + query_number * (answer + LI_CHAO_CHECKSUM_OFFSET)
        else:
            return -1
        operation <- operation + 1
    checksum

export fn li_chao_tree(input_values: i64&, length: usize) -> i64 = li_chao_tree_impl
