const MAX_VALUE: i64 = 1000000000000

def largest_of_very_large_numbers_decimal_exponent(base: i64) -> i64:
    if base < 1:
        return -1
    remaining: i64 = base
    exponent: i64 = 0
    while remaining > 1 and remaining % 10 == 0:
        remaining <- remaining / 10
        exponent <- exponent + 1
    if remaining == 1:
        exponent
    else:
        -1

def largest_of_very_large_numbers_valid_base(base: i64) -> bool:
    base == 0 or largest_of_very_large_numbers_decimal_exponent(base) >= 0

def largest_of_very_large_numbers_score(base: i64, exponent: i64) -> i64:
    if base == 0:
        return 0
    if exponent == 0:
        return 1
    largest_of_very_large_numbers_decimal_exponent(base) * exponent

def largest_of_very_large_numbers_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length != 4:
        return -2
    index: usize = 0
    while index < 4:
        if values[index] < 0 or values[index] > MAX_VALUE:
            return -2
        index <- index + 1
    if not largest_of_very_large_numbers_valid_base(values[0]) or not largest_of_very_large_numbers_valid_base(values[2]):
        return -2
    score_a: i64 = largest_of_very_large_numbers_score(values[0], values[1])
    score_b: i64 = largest_of_very_large_numbers_score(values[2], values[3])
    if score_a > score_b: return 1
    if score_a < score_b: return -1
    0

export fn largest_of_very_large_numbers(values: i64&, length: usize) -> i64 = largest_of_very_large_numbers_impl
