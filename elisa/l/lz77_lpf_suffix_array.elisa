const LPF_MAX_TEXT: usize = 32
const LPF_MAX_INPUT: usize = 34
const LPF_MAX_OUTPUT: usize = 512

def lpf_suffix_less(text: i64&, n: usize, a0: usize, b0: usize) -> bool:
    a: mutable usize = a0
    b: mutable usize = b0
    while a < n and b < n:
        if text[a] != text[b]: return text[a] < text[b]
        a <- a + 1
        b <- b + 1
    a == n and b != n

def lpf_match_length(text: i64&, n: usize, source: i64, target: usize) -> usize:
    if source < 0: return 0
    source_index: usize = source.usize()
    length: mutable usize = 0
    while target + length < n and text[source_index + length] == text[target + length]:
        length <- length + 1
    length

def lpf_store(staged: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        staged[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def lpf_impl(input: i64&, length: usize, staged: mutable view[u8]) -> i64:
    if length < 1 or length > LPF_MAX_INPUT: return -1
    n64: i64 = input[0]
    if n64 < 0 or n64 > LPF_MAX_TEXT.i64(): return -1
    n: usize = n64.usize()
    if length != n + 1: return -1
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < 0 or input[i + 1] > 255: return -1
        i <- i + 1

    sa: mutable usize[LPF_MAX_TEXT] = zeroed
    inverse: mutable usize[LPF_MAX_TEXT] = zeroed
    stack_value: mutable usize[LPF_MAX_TEXT] = zeroed
    previous: mutable i64[LPF_MAX_TEXT] = zeroed
    following: mutable i64[LPF_MAX_TEXT] = zeroed
    i <- 0
    while i < n:
        sa[i] <- i
        previous[i] <- -1
        following[i] <- -1
        i <- i + 1
    i <- 1
    while i < n:
        value: usize = sa[i]
        j: mutable usize = i
        while j > 0 and lpf_suffix_less(&input[1], n, value, sa[j - 1]):
            sa[j] <- sa[j - 1]
            j <- j - 1
        sa[j] <- value
        i <- i + 1
    i <- 0
    while i < n:
        inverse[sa[i]] <- i
        i <- i + 1

    top: mutable usize = 0
    i <- 0
    while i < n:
        while top > 0 and sa[stack_value[top - 1]] > sa[i]:
            top <- top - 1
        if top > 0: previous[i] <- stack_value[top - 1].i64()
        stack_value[top] <- i
        top <- top + 1
        i <- i + 1
    top <- 0
    rank_cursor: mutable usize = n
    while rank_cursor > 0:
        rank_cursor <- rank_cursor - 1
        while top > 0 and sa[stack_value[top - 1]] > sa[rank_cursor]:
            top <- top - 1
        if top > 0: following[rank_cursor] <- stack_value[top - 1].i64()
        stack_value[top] <- rank_cursor
        top <- top + 1

    pairs: mutable usize = 0
    pos: mutable usize = 0
    while pos < n:
        rank: usize = inverse[pos]
        psv: i64 = sa[previous[rank].usize()].i64() if previous[rank] >= 0 else -1
        nsv: i64 = sa[following[rank].usize()].i64() if following[rank] >= 0 else -1
        lp: usize = lpf_match_length(&input[1], n, psv, pos)
        ln: usize = lpf_match_length(&input[1], n, nsv, pos)
        source: mutable i64 = nsv if ln > lp else psv
        matched: usize = ln if ln > lp else lp
        if matched == 0: source <- -1
        lpf_store(staged, pairs * 16, source)
        lpf_store(staged, pairs * 16 + 8, matched.i64())
        pairs <- pairs + 1
        pos <- pos + ((matched if matched > 0 else 1))
    (pairs * 16).i64()

def lz77_lpf_suffix_array_impl(input: i64&, length: usize,
                                output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > LPF_MAX_INPUT: return -1
    staged: mutable u8[LPF_MAX_OUTPUT] = zeroed
    bytes: i64 = lpf_impl(input, length, staged[0:LPF_MAX_OUTPUT])
    if bytes < 0: return bytes
    if output == null or capacity < bytes.usize(): return -2
    i: mutable usize = 0
    while i < bytes.usize():
        output[i] <- staged[i]
        i <- i + 1
    bytes

export fn lz77_lpf_suffix_array(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = lz77_lpf_suffix_array_impl
