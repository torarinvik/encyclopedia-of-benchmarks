const MIN_BASE: i64 = 3
const MAX_BASE: i64 = 16
const MAX_DIGITS: i64 = 10
const MAX_LIMIT: i64 = 100000
const MAX_PARSEABLE_LENGTH: usize = 3
const MAX_QUEUE: usize = 70000

def left_truncatable_is_prime(value: i64) -> bool:
    if value < 2: return false
    if value % 2 == 0: return value == 2
    divisor: mutable i64 = 3
    while divisor * divisor <= value:
        if value % divisor == 0: return false
        divisor <- divisor + 2
    true

def left_truncatable_search(input: i64&, input_length: usize) -> i64:
    if input_length < 2 or input_length > MAX_PARSEABLE_LENGTH: return -1
    base: i64 = input[0]
    digits: i64 = input[1]
    if input_length != 2 or base < MIN_BASE or base > MAX_BASE or digits < 1 or digits > MAX_DIGITS: return -1
    limit: mutable i64 = 1
    index: mutable i64 = 0
    while index < digits:
        limit <- limit * base
        index <- index + 1
    if limit > MAX_LIMIT: return -1

    queue: mutable i64[MAX_QUEUE] = zeroed
    end: mutable usize = 0
    value: mutable i64 = 2
    while value < base:
        if left_truncatable_is_prime(value):
            queue[end] <- value
            end <- end + 1
        value <- value + 1
    best: mutable i64 = queue[end - 1]
    level_start: mutable usize = 0
    level_end: mutable usize = end
    place: mutable i64 = base
    width: mutable i64 = 1
    while width < digits and level_start < level_end:
        index_usize: mutable usize = level_start
        while index_usize < level_end:
            suffix: i64 = queue[index_usize]
            leading: mutable i64 = 1
            while leading < base:
                candidate: i64 = leading * place + suffix
                if left_truncatable_is_prime(candidate):
                    if end >= MAX_QUEUE: return -1
                    queue[end] <- candidate
                    end <- end + 1
                    if candidate > best: best <- candidate
                leading <- leading + 1
            index_usize <- index_usize + 1
        level_start <- level_end
        level_end <- end
        place <- place * base
        width <- width + 1
    best

def left_truncatable_prime_search_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_PARSEABLE_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    left_truncatable_search(input_view, input_view_length)

export fn left_truncatable_prime_search(input: i64&, length: usize) -> i64 = left_truncatable_prime_search_impl
