const FPS_MODULUS: i64 = 998_244_353
const FPS_MAX_N: usize = 64
const FPS_MAX_INPUT: usize = 66

def fps_store_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def log_of_formal_power_series_impl(input: view[i64], length: usize,
    output: mutable view[u8], capacity: usize, output_is_null: bool) -> i64:
    if length < 2 or length > FPS_MAX_INPUT: return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > FPS_MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != n + 1: return -1
    for i in 0..<n:
        coefficient: i64 = input[i + 1]
        if coefficient < 0 or coefficient >= FPS_MODULUS: return -1
    if input[1] != 1: return -1
    bytes: usize = 8 * n
    if output_is_null or capacity < bytes: return -2

    integer_inverse: mutable [FPS_MAX_N]i64 = [0; FPS_MAX_N]
    logarithm: mutable [FPS_MAX_N]i64 = [0; FPS_MAX_N]
    if n > 1: integer_inverse[1] <- 1
    for k in 2..<n:
        remainder: usize = (FPS_MODULUS % k.i64()).usize()
        integer_inverse[k] <- FPS_MODULUS - (FPS_MODULUS / k.i64()) * integer_inverse[remainder] % FPS_MODULUS
    for degree in 1..<n:
        numerator: mutable i64 = (degree.i64() * input[degree + 1]) % FPS_MODULUS
        for i in 1..<degree:
            term: i64 = (i.i64() * logarithm[i]) % FPS_MODULUS
            term <- term * input[degree - i + 1] % FPS_MODULUS
            numerator <- (numerator - term) % FPS_MODULUS
            if numerator < 0: numerator <- numerator + FPS_MODULUS
        logarithm[degree] <- numerator * integer_inverse[degree] % FPS_MODULUS
    for i in 0..<n: fps_store_le(logarithm[i], output, 8 * i)
    bytes.i64()

export fn log_of_formal_power_series(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > FPS_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return log_of_formal_power_series_impl(input_view, length, scratch[0:1], 0, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > 8 * FPS_MAX_N: safe_capacity <- 8 * FPS_MAX_N
    output_view: mutable view[u8] = output[0:safe_capacity]
    log_of_formal_power_series_impl(input_view, length, output_view, capacity, false)
