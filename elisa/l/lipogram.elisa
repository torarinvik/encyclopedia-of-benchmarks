def lipogram_impl(input: i64&, length: usize) -> i64:
    if input == null: return -1
    if length < 2 or length > 1026 or input[0] < 0 or input[0] > 1024 or length != input[0].usize() + 2:
        return -1
    n: usize = input[0].usize()
    expected: i64 = input[length - 1]
    if expected < 0 or expected > 67108863: return -1
    seen: mutable bool[26] = zeroed
    i: mutable usize = 0
    while i < n:
        ch: mutable i64 = input[i + 1]
        if ch >= 65 and ch <= 90: ch <- ch + 32
        if ch >= 97 and ch <= 122:
            seen[(ch - 97).usize()] <- true
        elif ch != 9 and ch != 10 and ch != 11 and ch != 12 and ch != 13 and ch != 32:
            return -1
        i <- i + 1
    missing: mutable i64 = 0
    bit: mutable i64 = 1
    i <- 0
    while i < 26:
        if not seen[i]: missing <- missing + bit
        bit <- bit * 2
        i <- i + 1
    if missing == expected: 1 else: 0

export fn lipogram(input: i64&, length: usize) -> i64 = lipogram_impl
