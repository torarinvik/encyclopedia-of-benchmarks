# Go's distinct-factor Liouville variant: (-1) raised to omega(n).
def liouville_impl(input: i64) -> i64:
    if input < 1 or input > 2147483647:
        return -2
    remaining: mutable u64 = input.u64()
    sign: mutable i64 = 1
    factor: mutable u64 = 2
    while factor <= remaining / factor:
        if remaining % factor == 0:
            sign <- -sign
            while remaining % factor == 0:
                remaining <- remaining / factor
        if factor == 2:
            factor <- 3
        else:
            factor <- factor + 2
    if remaining > 1:
        sign <- -sign
    sign

export fn liouville(input: i64) -> i64 = liouville_impl
