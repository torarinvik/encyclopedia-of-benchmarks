def long_division_impl(v: i64&, length: usize) -> i64:
    if length != 2: return -1
    a: mutable i64 = v[0]
    b: mutable i64 = v[1]
    if a < -1000000 or a > 1000000 or b < -10000 or b > 10000: return -1
    if b == 0: return 0
    neg: bool = (a < 0) != (b < 0)
    if a < 0: a <- -a
    if b < 0: b <- -b
    digits: mutable [i64; 16] = [0;16]
    n: mutable usize = 0
    if a == 0: n <- 1
    while a > 0:
        digits[n] <- a % 10
        a <- a / 10
        n <- n + 1
    rem: mutable i64 = 0
    q: mutable i64 = 0
    while n > 0:
        n <- n - 1
        rem <- rem * 10 + digits[n]
        d: mutable i64 = 0
        while rem >= b: rem <- rem - b; d <- d + 1
        q <- q * 10 + d
    if neg: return -q
    q
export fn long_division(v: i64&, length: usize) -> i64 = long_division_impl
