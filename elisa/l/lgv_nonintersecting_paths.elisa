const LGV_MAX_HEIGHT: usize = 5
const LGV_MAX_WIDTH: usize = 5
const LGV_MAX_PATHS: usize = 3
const LGV_MAX_PARSEABLE_LENGTH: usize = 11

def lgv_single_source_paths(height: usize, width: usize, blocked: i64,
                            source_row: usize, sink_row: usize) -> i64:
    ways: mutable i64[LGV_MAX_HEIGHT * LGV_MAX_WIDTH] = zeroed
    row: mutable usize = 0
    while row < height:
        column: mutable usize = 0
        while column < width:
            bit: i64 = (row * width + column).i64()
            index: usize = row * LGV_MAX_WIDTH + column
            if ((blocked >> bit) & 1) != 0:
                ways[index] <- 0
            elif row == source_row and column == 0:
                ways[index] <- 1
            else:
                from_above: mutable i64 = 0
                from_left: mutable i64 = 0
                if row > 0:
                    from_above <- ways[(row - 1) * LGV_MAX_WIDTH + column]
                if column > 0:
                    from_left <- ways[row * LGV_MAX_WIDTH + column - 1]
                ways[index] <- from_above + from_left
            column <- column + 1
        row <- row + 1
    ways[sink_row * LGV_MAX_WIDTH + width - 1]

def lgv_determinant(matrix: view[i64], order: usize) -> i64:
    permutations: usize[18] = [0, 1, 2, 1, 0, 2, 0, 2, 1,
                               1, 2, 0, 2, 0, 1, 2, 1, 0]
    permutation_count: mutable usize = 6
    if order == 1:
        permutation_count <- 1
    elif order == 2:
        permutation_count <- 2
    determinant: mutable i64 = 0
    p: mutable usize = 0
    while p < permutation_count:
        term: mutable i64 = 1
        inversions: mutable usize = 0
        row: mutable usize = 0
        while row < order:
            column: usize = permutations[3 * p + row]
            term <- term * matrix[3 * row + column]
            next_row: mutable usize = row + 1
            while next_row < order:
                if permutations[3 * p + row] > permutations[3 * p + next_row]:
                    inversions <- inversions + 1
                next_row <- next_row + 1
            row <- row + 1
        if inversions % 2 == 0:
            determinant <- determinant + term
        else:
            determinant <- determinant - term
        p <- p + 1
    determinant

def lgv_nonintersecting_paths_impl(input: i64&, length: usize) -> i64:
    if length < 4 or length > LGV_MAX_PARSEABLE_LENGTH:
        return -1
    raw_height: i64 = input[0]
    raw_width: i64 = input[1]
    raw_path_count: i64 = input[2]
    blocked: i64 = input[3]
    if raw_height < 1 or raw_height > LGV_MAX_HEIGHT.i64() or raw_width < 2 or raw_width > LGV_MAX_WIDTH.i64() or raw_path_count < 1 or raw_path_count > LGV_MAX_PATHS.i64() or blocked < 0:
        return -1
    height: usize = raw_height.usize()
    width: usize = raw_width.usize()
    path_count: usize = raw_path_count.usize()
    if length != 4 + 2 * path_count:
        return -1
    cell_count: usize = height * width
    mask_limit: i64 = 1 << cell_count.i64()
    if blocked >= mask_limit:
        return -1

    source_rows: mutable usize[LGV_MAX_PATHS] = zeroed
    sink_rows: mutable usize[LGV_MAX_PATHS] = zeroed
    i: mutable usize = 0
    while i < path_count:
        source: i64 = input[4 + i]
        sink: i64 = input[4 + path_count + i]
        if source < 0 or source >= raw_height or sink < 0 or sink >= raw_height or source > sink:
            return -1
        source_row: usize = source.usize()
        sink_row: usize = sink.usize()
        if i > 0 and (source_row <= source_rows[i - 1] or sink_row <= sink_rows[i - 1]):
            return -1
        source_rows[i] <- source_row
        sink_rows[i] <- sink_row
        source_bit: i64 = (source_row * width).i64()
        sink_bit: i64 = (sink_row * width + width - 1).i64()
        if ((blocked >> source_bit) & 1) != 0 or ((blocked >> sink_bit) & 1) != 0:
            return -1
        i <- i + 1

    path_matrix: mutable i64[LGV_MAX_PATHS * LGV_MAX_PATHS] = zeroed
    source_index: mutable usize = 0
    while source_index < path_count:
        sink_index: mutable usize = 0
        while sink_index < path_count:
            path_matrix[source_index * 3 + sink_index] <- lgv_single_source_paths(
                height, width, blocked, source_rows[source_index], sink_rows[sink_index])
            sink_index <- sink_index + 1
        source_index <- source_index + 1
    lgv_determinant(path_matrix[0:9], path_count)

def lgv_nonintersecting_paths_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 4 or length > LGV_MAX_PARSEABLE_LENGTH:
        return -1
    input_view: i64& = input
    lgv_nonintersecting_paths_impl(input_view, length)

export fn lgv_nonintersecting_paths(input: i64&, length: usize) -> i64 = lgv_nonintersecting_paths_entry
