const MAX_INPUT_LENGTH: usize = 64
const MAX_PADDED_LENGTH: usize = 128

def sha256_add32(left: u32, right: u32) -> u32:
    ((left.u64() + right.u64()) & 0xFFFF_FFFF.u64()).u32()

def sha256_rotr(value: u32, amount: usize) -> u32:
    (value >> amount) | (value << (32 - amount))

def sha256_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length > MAX_INPUT_LENGTH or (length > 0 and input == null):
        return -1
    for index in 0..<length:
        if input[index] < 0 or input[index] > 255:
            return -1
    constants: u32[64] = [
        0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
        0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
        0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
        0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
        0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
        0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
        0x19A4C116,0x1E376C08,0x2748774C,0x34B0BCB5,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
        0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2]
    padded: mutable u8[MAX_PADDED_LENGTH] = zeroed
    for index in 0..<length:
        padded[index] <- input[index].u8()
    padded[length] <- 128
    blocks: usize = (length + 9 + 63) / 64
    padded_length: usize = blocks * 64
    bit_length: u64 = length.u64() * 8
    for index in 0..<8:
        padded[padded_length - 1 - index] <- ((bit_length >> (8 * index)) & 255).u8()
    state: mutable u32[8] = [0x6A09E667,0xBB67AE85,0x3C6EF372,0xA54FF53A,0x510E527F,0x9B05688C,0x1F83D9AB,0x5BE0CD19]
    for block in 0..<blocks:
        words: mutable u32[64] = zeroed
        for index in 0..<16:
            position: usize = block * 64 + index * 4
            words[index] <- (padded[position].u32() << 24) | (padded[position + 1].u32() << 16) | (padded[position + 2].u32() << 8) | padded[position + 3].u32()
        for index in 16..<64:
            x: u32 = words[index - 15]
            y: u32 = words[index - 2]
            s0: u32 = sha256_rotr(x, 7) ^ sha256_rotr(x, 18) ^ (x >> 3)
            s1: u32 = sha256_rotr(y, 17) ^ sha256_rotr(y, 19) ^ (y >> 10)
            words[index] <- sha256_add32(sha256_add32(sha256_add32(s1, words[index - 7]), s0), words[index - 16])
        a: mutable u32 = state[0]
        b: mutable u32 = state[1]
        c: mutable u32 = state[2]
        d: mutable u32 = state[3]
        e: mutable u32 = state[4]
        f: mutable u32 = state[5]
        g: mutable u32 = state[6]
        h: mutable u32 = state[7]
        for index in 0..<64:
            s1: u32 = sha256_rotr(e, 6) ^ sha256_rotr(e, 11) ^ sha256_rotr(e, 25)
            choose: u32 = (e & f) ^ ((~e) & g)
            t1: u32 = sha256_add32(sha256_add32(sha256_add32(sha256_add32(h, s1), choose), constants[index]), words[index])
            s0: u32 = sha256_rotr(a, 2) ^ sha256_rotr(a, 13) ^ sha256_rotr(a, 22)
            majority: u32 = (a & b) ^ (a & c) ^ (b & c)
            t2: u32 = sha256_add32(s0, majority)
            h <- g
            g <- f
            f <- e
            e <- sha256_add32(d, t1)
            d <- c
            c <- b
            b <- a
            a <- sha256_add32(t1, t2)
        state[0] <- sha256_add32(state[0], a)
        state[1] <- sha256_add32(state[1], b)
        state[2] <- sha256_add32(state[2], c)
        state[3] <- sha256_add32(state[3], d)
        state[4] <- sha256_add32(state[4], e)
        state[5] <- sha256_add32(state[5], f)
        state[6] <- sha256_add32(state[6], g)
        state[7] <- sha256_add32(state[7], h)
    if output == null or capacity < 32:
        return -2
    for word in 0..<8:
        for byte in 0..<4:
            output[word * 4 + byte] <- ((state[word] >> (24 - 8 * byte)) & 255).u8()
    32


const LAMPORT_MAX_MESSAGE: usize = 64
const LAMPORT_DIGEST_BITS: usize = 256
const LAMPORT_SECRET_BYTES: usize = 32
const LAMPORT_ENTROPY_BYTES: usize = LAMPORT_DIGEST_BITS * 2 * LAMPORT_SECRET_BYTES
const LAMPORT_SIGNATURE_BYTES: usize = LAMPORT_DIGEST_BITS * LAMPORT_SECRET_BYTES
const LAMPORT_MAX_PARSEABLE: usize = 4 + 2 * LAMPORT_MAX_MESSAGE + LAMPORT_ENTROPY_BYTES + 1

def lamport_signature_impl(input: i64&, length: usize) -> i64:
    if length < 4 + LAMPORT_ENTROPY_BYTES or length > LAMPORT_MAX_PARSEABLE:
        return -1
    if input == null:
        return -1
    if input[0] < 0 or input[0] > 64:
        return -1
    message_length: usize = input[0].usize()
    verify_length_index: usize = 1 + message_length
    if verify_length_index >= length or input[verify_length_index] < 0 or input[verify_length_index] > 64:
        return -1
    verify_length: usize = input[verify_length_index].usize()
    verify_start: usize = verify_length_index + 1
    verify_end: usize = verify_start + verify_length
    if verify_end + 2 > length:
        return -1
    tamper_index: i64 = input[verify_end]
    sign_twice: i64 = input[verify_end + 1]
    entropy_start: usize = verify_end + 2
    if length != entropy_start + LAMPORT_ENTROPY_BYTES:
        return -1
    if tamper_index < -1 or tamper_index >= LAMPORT_SIGNATURE_BYTES.i64() or sign_twice < 0 or sign_twice > 1:
        return -1
    for i in 0..<message_length:
        if input[1 + i] < 0 or input[1 + i] > 255:
            return -1
    for i in 0..<verify_length:
        if input[verify_start + i] < 0 or input[verify_start + i] > 255:
            return -1
    for i in 0..<LAMPORT_ENTROPY_BYTES:
        if input[entropy_start + i] < 0 or input[entropy_start + i] > 255:
            return -1

    public_key: mutable u8[LAMPORT_DIGEST_BITS * 2 * LAMPORT_SECRET_BYTES] = zeroed
    signature: mutable i64[LAMPORT_SIGNATURE_BYTES] = zeroed
    message_digest: mutable u8[32] = zeroed
    for bit in 0..<LAMPORT_DIGEST_BITS:
        for value in 0..<2:
            secret_offset: usize = entropy_start + (bit * 2 + value) * LAMPORT_SECRET_BYTES
            public_offset: usize = (bit * 2 + value) * 32
            if sha256_impl(input + secret_offset, LAMPORT_SECRET_BYTES, &public_key[public_offset], 32) != 32:
                return -1
    if sha256_impl(input + 1, message_length, &message_digest[0], 32) != 32:
        return -1
    for bit in 0..<LAMPORT_DIGEST_BITS:
        value: usize = ((message_digest[bit / 8] >> (7 - (bit % 8))) & 1).usize()
        secret_offset: usize = entropy_start + (bit * 2 + value) * LAMPORT_SECRET_BYTES
        for byte in 0..<LAMPORT_SECRET_BYTES:
            signature[bit * LAMPORT_SECRET_BYTES + byte] <- input[secret_offset + byte]
    if sign_twice == 1:
        return -1

    if tamper_index >= 0:
        signature[tamper_index.usize()] <- signature[tamper_index.usize()] ^ 1
    verify_digest: mutable u8[32] = zeroed
    if sha256_impl(input + verify_start, verify_length, &verify_digest[0], 32) != 32:
        return -1
    verified: mutable u8 = 1
    for bit in 0..<LAMPORT_DIGEST_BITS:
        value: usize = ((verify_digest[bit / 8] >> (7 - (bit % 8))) & 1).usize()
        actual_hash: mutable u8[32] = zeroed
        if sha256_impl(&signature[bit * LAMPORT_SECRET_BYTES], LAMPORT_SECRET_BYTES, &actual_hash[0], 32) != 32:
            return -1
        for byte in 0..<32:
            if actual_hash[byte] != public_key[(bit * 2 + value) * 32 + byte]:
                verified <- 0
                break
        if verified == 0:
            break
    if tamper_index >= 0:
        signature[tamper_index.usize()] <- signature[tamper_index.usize()] ^ 1

    fingerprint: mutable u64 = 0xcbf29ce484222325
    for index in 0..<(LAMPORT_DIGEST_BITS * 2 * 32):
        fingerprint <- (fingerprint ^ public_key[index].u64()) * 0x100000001b3
    for index in 0..<LAMPORT_SIGNATURE_BYTES:
        fingerprint <- (fingerprint ^ signature[index].u8().u64()) * 0x100000001b3
    fingerprint <- (fingerprint ^ verified.u64()) * 0x100000001b3
    (fingerprint & 0x7fffffffffffffff).i64()

export fn lamport_signature(input: i64&, length: usize) -> i64 = lamport_signature_impl
