const LCIS_MAX_INPUT_LENGTH = 67
const LCIS_MAX_SIDE = 32

def longest_common_increasing_subsequence_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 2 or input_length > LCIS_MAX_INPUT_LENGTH: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 0 or n_value > LCIS_MAX_SIDE or m_value < 0 or m_value > LCIS_MAX_SIDE: return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if input_length != 2 + n + m: return -1
    index: mutable usize = 0
    while index < n + m:
        value: i64 = input[2 + index]
        if value < -16 or value > 16: return -1
        index <- index + 1

    ending_at: mutable i64[32] = zeroed
    i: mutable usize = 0
    while i < n:
        value: i64 = input[2 + i]
        best_smaller: mutable i64 = 0
        j: mutable usize = 0
        while j < m:
            other: i64 = input[2 + n + j]
            if value > other:
                if ending_at[j] > best_smaller: best_smaller <- ending_at[j]
            elif value == other and best_smaller + 1 > ending_at[j]:
                ending_at[j] <- best_smaller + 1
            j <- j + 1
        i <- i + 1

    answer: mutable i64 = 0
    j: mutable usize = 0
    while j < m:
        if ending_at[j] > answer: answer <- ending_at[j]
        j <- j + 1
    answer

def longest_common_increasing_subsequence_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > LCIS_MAX_INPUT_LENGTH: return -1
    longest_common_increasing_subsequence_impl(input, length)

export fn longest_common_increasing_subsequence(input: i64&, length: usize) -> i64 = longest_common_increasing_subsequence_entry
