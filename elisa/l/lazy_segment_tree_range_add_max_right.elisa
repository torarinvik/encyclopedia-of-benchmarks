# Lazy range addition and sum-monoid max_right boundary searches.
def lazy_max_right_apply(tree: mutable i64[64], pending: mutable i64[64],
                         node: usize, segment_length: usize, delta: i64) -> void:
    tree[node] <- tree[node] + delta * segment_length.i64()
    pending[node] <- pending[node] + delta

def lazy_max_right_push(tree: mutable i64[64], pending: mutable i64[64],
                         node: usize, segment_length: usize) -> void:
    if segment_length > 1 and pending[node] != 0:
        half: usize = segment_length / 2
        lazy_max_right_apply(tree, pending, 2 * node, half, pending[node])
        lazy_max_right_apply(tree, pending, 2 * node + 1, half, pending[node])
        pending[node] <- 0

def lazy_max_right_add(tree: mutable i64[64], pending: mutable i64[64],
                       node: usize, low: usize, high: usize,
                       query_low: usize, query_high: usize, delta: i64) -> void:
    if query_low >= query_high: return
    if query_high <= low or high <= query_low: return
    if query_low <= low and high <= query_high:
        lazy_max_right_apply(tree, pending, node, high - low, delta)
        return
    lazy_max_right_push(tree, pending, node, high - low)
    middle: usize = (low + high) / 2
    if query_low < middle:
        lazy_max_right_add(tree, pending, 2 * node, low, middle, query_low, query_high, delta)
    if query_high > middle:
        lazy_max_right_add(tree, pending, 2 * node + 1, middle, high, query_low, query_high, delta)
    tree[node] <- tree[2 * node] + tree[2 * node + 1]

def lazy_max_right_search(tree: mutable i64[64], pending: mutable i64[64],
                          node: usize, low: usize, high: usize, n: usize,
                          left: usize, limit: i64, accumulated: mutable i64) -> usize:
    if high <= left: return high
    if low >= n: return n
    if left <= low and high <= n and accumulated + tree[node] <= limit:
        accumulated <- accumulated + tree[node]
        return high
    if high - low == 1: return low
    lazy_max_right_push(tree, pending, node, high - low)
    middle: usize = (low + high) / 2
    first: usize = lazy_max_right_search(tree, pending, 2 * node, low, middle, n, left, limit, accumulated)
    if first < middle and first >= left: return first
    lazy_max_right_search(tree, pending, 2 * node + 1, middle, high, n, left, limit, accumulated)

def lazy_segment_tree_range_add_max_right_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 3 or length > 67: return -1
    if input[0] < 1 or input[0] > 16 or input[1] < 0 or input[1] > 12: return -1
    n: usize = input[0].usize()
    operations: usize = input[1].usize()
    if length != 2 + n + 4 * operations or length > 66: return -1
    for i in 0..<n:
        if input[2 + i] < 0 or input[2 + i] > 31: return -1
    for op in 0..<operations:
        p: usize = 2 + n + 4 * op
        opcode: i64 = input[p]
        left: i64 = input[p + 1]
        right: i64 = input[p + 2]
        extra: i64 = input[p + 3]
        if opcode == 0:
            if left < 0 or left > n.i64() or right < left or right > n.i64() or extra < 0 or extra > 31: return -1
        elif opcode == 1:
            if left < 0 or left > n.i64() or right < 0 or right > 8192 or extra != 0: return -1
        else: return -1

    base: mutable usize = 1
    while base < n: base <- base * 2
    tree: mutable i64[64] = zeroed
    pending: mutable i64[64] = zeroed
    for i in 0..<n: tree[base + i] <- input[2 + i]
    node: mutable usize = base
    while node > 1:
        node <- node - 1
        tree[node] <- tree[2 * node] + tree[2 * node + 1]

    query_index: mutable usize = 0
    result: mutable i64 = 0
    for op in 0..<operations:
        p: usize = 2 + n + 4 * op
        left: usize = input[p + 1].usize()
        right: usize = input[p + 2].usize()
        if input[p] == 0:
            lazy_max_right_add(tree, pending, 1, 0, base, left, right, input[p + 3])
        else:
            accumulated: mutable i64 = 0
            boundary: usize = lazy_max_right_search(tree, pending, 1, 0, base, n, left, right.i64(), accumulated)
            result <- result | (boundary.i64() << (5 * query_index).usize())
            query_index <- query_index + 1
    result

export fn lazy_segment_tree_range_add_max_right(input: i64&, length: usize) -> i64 = lazy_segment_tree_range_add_max_right_impl
