const MAX_PAYLOAD_BYTES: usize = 256
const MAX_INPUT_LENGTH: usize = 259
const OUTPUT_BYTES: usize = 16

def length_utf8_scalar_count(bytes: view[u8], payload_length: usize) -> i64:
    index: mutable usize = 0
    count: mutable i64 = 0
    while index < payload_length:
        lead: u8 = bytes[index]
        if lead >= 1 and lead <= 127:
            index <- index + 1
        elif lead >= 194 and lead <= 223:
            if index + 1 >= payload_length:
                return -1
            second: u8 = bytes[index + 1]
            if second < 128 or second > 191:
                return -1
            index <- index + 2
        elif lead >= 224 and lead <= 239:
            if index + 2 >= payload_length:
                return -1
            second: u8 = bytes[index + 1]
            third: u8 = bytes[index + 2]
            if second < 128 or second > 191 or third < 128 or third > 191 or
                (lead == 224 and second < 160) or (lead == 237 and second > 159):
                return -1
            index <- index + 3
        else:
            return -1
        count <- count + 1
    count

def length_put_i64_le(output: mutable view[u8], position: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- (bits & 255.u64()).u8()
        bits <- bits >> 8
        byte <- byte + 1

def length_impl(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 2 or input_length > MAX_INPUT_LENGTH:
        return -1
    payload_length_arg: i64 = input[0]
    if payload_length_arg < 0 or payload_length_arg > MAX_PAYLOAD_BYTES.i64():
        return -1
    payload_length: usize = payload_length_arg.usize()
    if input_length != payload_length + 2:
        return -1

    payload: mutable u8[MAX_PAYLOAD_BYTES] = zeroed
    index: mutable usize = 0
    while index <= payload_length:
        value: i64 = input[index + 1]
        if value < 0 or value > 255:
            return -1
        if index == payload_length:
            if value != 0:
                return -1
        else:
            if value == 0:
                return -1
            payload[index] <- value.u8()
        index <- index + 1

    scalar_count: i64 = length_utf8_scalar_count(payload[0:payload_length], payload_length)
    if scalar_count < 0:
        return -1
    if output.is_null() or output_capacity < OUTPUT_BYTES:
        return -2
    length_put_i64_le(output[0:output_capacity], 0, payload_length.i64())
    length_put_i64_le(output[0:output_capacity], 8, scalar_count)
    OUTPUT_BYTES.i64()

export fn length(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64 =
    length_impl(input, input_length, output, output_capacity)
