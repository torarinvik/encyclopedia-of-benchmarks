const MAX_VERTICES: usize = 16
const MAX_INPUT_LENGTH: usize = 246

def lovasz_toggle_popcount(bits_input: u64) -> usize:
    bits: mutable u64 = bits_input
    count: mutable usize = 0
    while bits != 0:
        bits <- bits & (bits - u64(1))
        count <- count + 1
    count

def lovasz_toggle_defective_coloring_trace_impl(input: view[i64], length: usize) -> i64:
    if length < 5 or length > MAX_INPUT_LENGTH: return -1
    n_value: i64 = input[0]
    red_limit_value: i64 = input[1]
    blue_limit_value: i64 = input[2]
    initial_mask_value: i64 = input[3]
    edge_count_value: i64 = input[4]
    if n_value < 0 or n_value > i64(MAX_VERTICES): return -1
    if red_limit_value < 1 or red_limit_value > 8 or blue_limit_value < 1 or blue_limit_value > 8: return -1
    n: usize = n_value.usize()
    maximum_edges: usize = 0
    if n > 1: maximum_edges <- n * (n - 1) / 2
    if edge_count_value < 0 or edge_count_value > i64(maximum_edges): return -1
    edge_count: usize = edge_count_value.usize()
    if length != 5 + 2 * edge_count: return -1
    vertex_mask: u64 = (u64(1) << n) - u64(1)
    if initial_mask_value < 0 or (initial_mask_value.u64() & ~vertex_mask) != 0: return -1
    var adjacency: mutable u64[MAX_VERTICES] = zeroed
    for edge in 0..<edge_count |input, adjacency|:
        u_value: i64 = input[5 + 2 * edge]
        v_value: i64 = input[6 + 2 * edge]
        if u_value < 0 or v_value <= u_value or v_value >= n_value: return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        u_bit: u64 = u64(1) << u
        v_bit: u64 = u64(1) << v
        if (adjacency[u] & v_bit) != 0: return -1
        adjacency[u] <- adjacency[u] | v_bit
        adjacency[v] <- adjacency[v] | u_bit
    maximum_degree: usize = red_limit_value.usize() + blue_limit_value.usize() + 1
    for vertex in 0..<n |adjacency|:
        if lovasz_toggle_popcount(adjacency[vertex]) > maximum_degree: return -1

    red_mask: mutable u64 = initial_mask_value.u64()
    toggle_count: mutable i64 = 0
    while true:
        bad_vertex: mutable usize = n
        for vertex in 0..<n |adjacency|:
            bit: u64 = u64(1) << vertex
            if (red_mask & bit) != 0:
                if lovasz_toggle_popcount(adjacency[vertex] & red_mask) > red_limit_value.usize():
                    bad_vertex <- vertex
                    break
            else:
                blue_mask: u64 = vertex_mask & ~red_mask
                if lovasz_toggle_popcount(adjacency[vertex] & blue_mask) > blue_limit_value.usize():
                    bad_vertex <- vertex
                    break
        if bad_vertex == n: break
        red_mask <- red_mask ^ (u64(1) << bad_vertex)
        toggle_count <- toggle_count + 1
    (toggle_count << n) | red_mask.i64()

export fn lovasz_toggle_defective_coloring_trace(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 5 or length > MAX_INPUT_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    lovasz_toggle_defective_coloring_trace_impl(input_view, length)
