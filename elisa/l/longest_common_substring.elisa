# Length of the longest contiguous common substring over printable ASCII.
def longest_common_substring_impl(input: i64&, length: usize) -> i64:
    if length < 2 or input[0] < 0 or input[0] > 256:
        return -1
    first_length: usize = input[0].usize()
    if first_length + 2 > length or input[first_length + 1] < 0 or input[first_length + 1] > 256:
        return -1
    second_length: usize = input[first_length + 1].usize()
    if length != first_length + second_length + 2:
        return -1
    first: usize = 1
    second: usize = first_length + 2
    index: mutable usize = 0
    while index < first_length:
        if input[first + index] < 32 or input[first + index] > 126:
            return -1
        index <- index + 1
    index <- 0
    while index < second_length:
        if input[second + index] < 32 or input[second + index] > 126:
            return -1
        index <- index + 1
    dp: mutable i64[257] = zeroed
    best: mutable i64 = 0
    i: mutable usize = 1
    while i <= first_length:
        j: mutable usize = second_length
        while j > 0:
            if input[first + i - 1] == input[second + j - 1]:
                dp[j] <- dp[j - 1] + 1
                if dp[j] > best:
                    best <- dp[j]
            else:
                dp[j] <- 0
            j <- j - 1
        i <- i + 1
    best

export fn longest_common_substring(input: i64&, length: usize) -> i64 = longest_common_substring_impl
