extern exp(value: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def put_f64(output: mutable u8&, offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def logistic_regression_rust_binary_gd_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4: return -1
    m_value: i64 = input[0]
    d_value: i64 = input[1]
    epochs_value: i64 = input[2]
    alpha_q: i64 = input[3]
    if m_value < 1 or m_value > 32 or d_value < 1 or d_value > 8 or epochs_value < 0 or epochs_value > 128 or alpha_q < 1 or alpha_q > 100000: return -1
    m: usize = m_value.usize()
    d: usize = d_value.usize()
    epochs: usize = epochs_value.usize()
    if length != 4 + m * d + m: return -1
    labels_offset: usize = 4 + m * d
    for index in 0..<(m * d):
        if input[4 + index] < -1000000 or input[4 + index] > 1000000: return -1
    for sample in 0..<m:
        label: i64 = input[labels_offset + sample]
        if label < 0 or label > 1000000: return -1
    required: usize = (d + 1) * 8
    if output.is_null() or capacity < required: return -2

    theta: mutable f64[9] = zeroed
    gradient: mutable f64[9] = zeroed
    next_theta: mutable f64[9] = zeroed
    alpha: f64 = alpha_q.f64() / 1000000.0
    for epoch in 0..<epochs:
        for parameter in 0..<(d + 1): gradient[parameter] <- 0.0
        for sample in 0..<m:
            score: mutable f64 = theta[0]
            for feature in 0..<d:
                x: f64 = input[4 + sample * d + feature].f64() / 1000000.0
                score <- score + x * theta[feature + 1]
            prediction: f64 = 1.0 / (1.0 + exp(-score))
            error: f64 = prediction - input[labels_offset + sample].f64() / 1000000.0
            gradient[0] <- gradient[0] + error
            for feature in 0..<d:
                x: f64 = input[4 + sample * d + feature].f64() / 1000000.0
                gradient[feature + 1] <- gradient[feature + 1] + error * x
        for parameter in 0..<(d + 1): next_theta[parameter] <- theta[parameter] - alpha * gradient[parameter]
        for parameter in 0..<(d + 1): theta[parameter] <- next_theta[parameter]
    for parameter in 0..<(d + 1): put_f64(output, parameter * 8, theta[parameter])
    required.i64()

export fn logistic_regression_rust_binary_gd(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = logistic_regression_rust_binary_gd_impl
