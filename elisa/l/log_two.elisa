def log_two_impl(v: i64&, length: usize) -> i64:
    if length != 1: return -1
    x: mutable i64 = v[0]
    if x < 0 or x > 2147483647: return -1
    r: mutable i64 = 0
    while x >> 1 != 0:
        x <- x >> 1
        r <- r + 1
    r
export fn log_two(v: i64&, length: usize) -> i64 = log_two_impl
