def long_utils_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length != 3: return -1
    if input[0] < 0 or input[0] > 3 or input[2] < 0 or input[2] > 63: return -1
    if output == null or capacity < 8: return -2
    bits: u64 = input[1].u64()
    distance: usize = input[2].usize()
    rotated: u64 = bits
    if distance != 0:
        if input[0] < 2: rotated <- (bits << distance) | (bits >> (64 - distance))
        else: rotated <- (bits >> distance) | (bits << (64 - distance))
    index: usize = 0
    while index < 8:
        output[index] <- ((rotated >> (8 * index)) & 255).u8()
        index <- index + 1
    8

export fn long_utils(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = long_utils_impl
