# Smallest base in which a nonnegative integer is palindromic.
def is_palindromic_in_base(number: i64, base: i64) -> bool:
    if number <= 1:
        return true
    if number % base == 0:
        return false
    reversed: i64 = while remaining > 0 |remaining: mutable i64 = number, reversed: mutable i64 = 0| -> reversed:
        reversed <- reversed * base + remaining % base
        remaining <- remaining / base
    reversed == number

def lowest_base_palindrome_impl(number: i64) -> i64:
    if number < 0 or number > 64:
        return -1
    while not is_palindromic_in_base(number, base) |base: mutable i64 = 2| -> base:
        base <- base + 1

export fn lowest_base_palindrome(number: i64) -> i64 = lowest_base_palindrome_impl
