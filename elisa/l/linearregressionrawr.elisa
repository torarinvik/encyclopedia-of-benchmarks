const LINEARREGRESSIONRAWR_MIN_N: usize = 2
const LINEARREGRESSIONRAWR_MAX_N: usize = 32
const LINEARREGRESSIONRAWR_MAX_INPUT: usize = 66

extern floor(value: f64) -> f64

def linearregressionrawr_impl(input: f64&, input_length: usize,
        output: mutable f64&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > LINEARREGRESSIONRAWR_MAX_INPUT:
        return -1
    n_value: f64 = input[0]
    if n_value != n_value or n_value < 2.0 or n_value > 32.0 or floor(n_value) != n_value:
        return -1
    n: usize = n_value.usize()
    if input_length != 1 + 2 * n:
        return -1

    predictors: mutable i64[LINEARREGRESSIONRAWR_MAX_N] = zeroed
    responses: mutable i64[LINEARREGRESSIONRAWR_MAX_N] = zeroed
    predictor_sum: mutable i64 = 0
    response_sum: mutable i64 = 0
    cross_sum: mutable i64 = 0
    square_sum: mutable i64 = 0
    index: mutable usize = 0
    while index < n:
        value: f64 = input[1 + index]
        if value != value or value < -4.0 or value > 4.0 or floor(value) != value:
            return -1
        predictor: i64 = value.i64()
        predictors[index] <- predictor
        predictor_sum <- predictor_sum + predictor
        index <- index + 1
    index <- 0
    while index < n:
        value: f64 = input[1 + n + index]
        if value != value or value < -16.0 or value > 16.0 or floor(value) != value:
            return -1
        response: i64 = value.i64()
        responses[index] <- response
        response_sum <- response_sum + response
        cross_sum <- cross_sum + predictors[index] * response
        square_sum <- square_sum + predictors[index] * predictors[index]
        index <- index + 1
    if predictor_sum != 0:
        return -1
    all_equal: mutable bool = true
    index <- 1
    while index < n:
        if predictors[index] != predictors[0]: all_equal <- false
        index <- index + 1
    if all_equal:
        return -1

    if output.is_null() or output_capacity < 2:
        return -2
    output[0] <- response_sum.f64() / n.f64()
    output[1] <- cross_sum.f64() / square_sum.f64()
    2

export fn linearregressionrawr(input: f64&, input_length: usize,
        output: mutable f64&, output_capacity: usize) -> i64 = linearregressionrawr_impl
