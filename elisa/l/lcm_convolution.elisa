# Divisor zeta transforms, pointwise products, and reverse Möbius inversion.
const MAX_N: usize = 128
const MAX_INPUT_LENGTH: usize = 1 + 2 * MAX_N + 1
const MODULUS: i64 = 998244353

def lcm_convolution_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    output[offset + 0] <- (value.u64() >> 0).u8()
    output[offset + 1] <- (value.u64() >> 8).u8()
    output[offset + 2] <- (value.u64() >> 16).u8()
    output[offset + 3] <- (value.u64() >> 24).u8()
    output[offset + 4] <- (value.u64() >> 32).u8()
    output[offset + 5] <- (value.u64() >> 40).u8()
    output[offset + 6] <- (value.u64() >> 48).u8()
    output[offset + 7] <- (value.u64() >> 56).u8()

def lcm_convolution_impl(input: i64&, input_length: usize,
                    output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or input_length < 1 or input_length > MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > MAX_N.i64():
        return -1
    n: usize = n_value.usize()
    if input_length != 1 + 2 * n:
        return -1
    for index in 0..<(2 * n):
        value: i64 = input[1 + index]
        if value.u64() >= MODULUS.u64():
            return -1
    output_bytes: usize = 8 * n
    if output == null or output_capacity < output_bytes:
        return -2

    left: mutable u64[MAX_N + 1] = zeroed
    right: mutable u64[MAX_N + 1] = zeroed
    coefficients: mutable u64[MAX_N + 1] = zeroed
    # All accessed indices are between 1 and the validated n.
    left_sums: mutable u64& = &left[0]
    right_sums: mutable u64& = &right[0]
    results: mutable u64& = &coefficients[0]
    for divisor in 1..<(n + 1):
        left_value: u64 = input[divisor].u64()
        right_value: u64 = input[n + divisor].u64()
        multiple: mutable u32 = divisor.u32()
        while multiple <= n.u32():
            left_sums[multiple] <- left_sums[multiple] + left_value
            right_sums[multiple] <- right_sums[multiple] + right_value
            multiple <- multiple + divisor.u32()
    for index in 1..<(n + 1):
        # Add a multiple of the modulus to cover every later subtraction.
        results[index] <- ((left_sums[index] % MODULUS.u64()) * (right_sums[index] % MODULUS.u64())) % MODULUS.u64() + MAX_N.u64() * MODULUS.u64()
    for divisor in 1..<(n + 1):
        coefficient: u64 = results[divisor] % MODULUS.u64()
        results[divisor] <- coefficient
        multiple: mutable u32 = 2 * divisor.u32()
        while multiple <= n.u32():
            results[multiple] <- results[multiple] - coefficient
            multiple <- multiple + divisor.u32()

    for index in 1..<(n + 1):
        lcm_convolution_store_i64(output, 8 * (index - 1), coefficients[index].i64())
    output_bytes.i64()

export fn lcm_convolution(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64 = lcm_convolution_impl
