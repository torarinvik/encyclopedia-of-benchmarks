# Largest product of four adjacent values in a bounded grid.
const MAX_INPUT_LENGTH: usize = 3971
const MAX_DIMENSION: i64 = 63
const MAX_CELL_VALUE: i64 = 1000

def largest_product_in_a_grid_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 2 or length > MAX_INPUT_LENGTH:
        return -1

    rows: i64 = values[0]
    cols: i64 = values[1]
    if rows < 0 or rows > MAX_DIMENSION or cols < 0 or cols > MAX_DIMENSION:
        return -1

    expected_length: usize = 2 + rows.usize() * cols.usize()
    if length != expected_length:
        return -1
    index: mutable usize = 2
    while index < length:
        if values[index] < 0 or values[index] > MAX_CELL_VALUE:
            return -1
        index <- index + 1

    best: mutable i64 = 0
    row: mutable usize = 0
    while row < rows.usize():
        col: mutable usize = 0
        while col < cols.usize():
            direction: mutable usize = 0
            while direction < 4:
                row_step: mutable i64 = 0
                col_step: mutable i64 = 1
                if direction == 1:
                    row_step <- 1
                    col_step <- 0
                else if direction == 2:
                    row_step <- 1
                    col_step <- 1
                else if direction == 3:
                    row_step <- 1
                    col_step <- -1

                product: mutable i64 = 1
                offset: mutable usize = 0
                while offset < 4:
                    next_row: i64 = row.i64() + offset.i64() * row_step
                    next_col: i64 = col.i64() + offset.i64() * col_step
                    if next_row < 0 or next_row >= rows or next_col < 0 or next_col >= cols:
                        product <- 0
                    else:
                        cell_index: usize = 2 + next_row.usize() * cols.usize() + next_col.usize()
                        product <- product * values[cell_index]
                    offset <- offset + 1
                if product > best:
                    best <- product
                direction <- direction + 1
            col <- col + 1
        row <- row + 1
    best

export fn largest_product_in_a_grid(values: i64&, length: usize) -> i64 = largest_product_in_a_grid_impl
