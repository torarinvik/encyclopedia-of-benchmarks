# Largest rectangle area in a bounded histogram.
const MAX_INPUT_LENGTH: usize = 64
const INVALID_RESULT: i64 = -9223372036854775807 - 1

def largest_rectangle_histogram_impl(heights: i64&, length: usize) -> i64:
    if length == 0:
        return 0
    if heights == null or length > MAX_INPUT_LENGTH:
        return INVALID_RESULT
    index: mutable usize = 0
    while index < length:
        if heights[index] < 0 or heights[index] > 1000000:
            return INVALID_RESULT
        index <- index + 1

    indices: mutable usize[64] = zeroed
    top: mutable usize = 0
    # Valid heights and widths bound every area to 64 million.
    best: mutable u64 = 0
    index <- 0
    while index < length:
        while top > 0 and heights[indices[top - 1]] > heights[index]:
            top <- top - 1
            bar: usize = indices[top]
            left: usize = 0 if top == 0 else indices[top - 1] + 1
            area: u64 = heights[bar].u64() * (index - left).u64()
            if area > best:
                best <- area
        indices[top] <- index
        top <- top + 1
        index <- index + 1

    while top > 0:
        top <- top - 1
        bar: usize = indices[top]
        left: usize = 0 if top == 0 else indices[top - 1] + 1
        area: u64 = heights[bar].u64() * (length - left).u64()
        if area > best:
            best <- area
    best.i64()

export fn largest_rectangle_histogram(heights: i64&, length: usize) -> i64 = largest_rectangle_histogram_impl
