def list_array_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 130: return -1
    capacity_value: i64 = input[0]
    operation_count_value: i64 = input[1]
    if capacity_value < 1 or capacity_value > 16 or operation_count_value < 1 or operation_count_value > 64: return -1
    capacity: usize = capacity_value.usize()
    operations: usize = operation_count_value.usize()
    if length != 2 + 2 * operations: return -1

    opcodes: mutable i64[64] = zeroed
    arguments: mutable i64[64] = zeroed
    sorted: mutable bool = false
    i: usize = 0
    while i < operations:
        opcode: i64 = input[2 + 2 * i]
        argument: i64 = input[3 + 2 * i]
        if opcode == 0:
            if sorted or argument < 0: return -1
        elif opcode == 1:
            if sorted or argument != 0: return -1
            sorted <- true
        elif opcode == 2 or opcode == 3:
            if not sorted or argument < 0: return -1
        else: return -1
        opcodes[i] <- opcode
        arguments[i] <- argument
        i <- i + 1
    if not sorted: return -1

    items: mutable u64[16] = zeroed
    results: mutable i64[64] = zeroed
    output_words: mutable i64[65] = zeroed
    count: mutable usize = 0
    result_count: mutable usize = 0
    i <- 0
    while i < operations:
        opcode: i64 = opcodes[i]
        argument: i64 = arguments[i]
        if opcode == 0:
            if count == capacity: return -1
            items[count] <- argument.u64()
            count <- count + 1
        elif opcode == 1:
            a: usize = 0
            while a < count:
                minimum: mutable usize = a
                b: usize = a + 1
                while b < count:
                    if items[b] < items[minimum]: minimum <- b
                    b <- b + 1
                value: u64 = items[minimum]
                items[minimum] <- items[a]
                items[a] <- value
                a <- a + 1
        else:
            if count == 0 or argument.u64() < items[0]: return -1
            if opcode == 3 and count >= capacity: return -1
            first: mutable i64 = 0
            last: mutable i64 = count.i64() - 1
            position: mutable i64 = -1
            while first <= last:
                middle: i64 = (first + last) / 2
                value: u64 = items[middle.usize()]
                if value == argument.u64():
                    position <- middle
                    break
                elif argument.u64() < value: last <- middle - 1
                else: first <- middle + 1
            results[result_count] <- position
            result_count <- result_count + 1
            if opcode == 3 and position >= 0:
                j: mutable usize = position.usize()
                while j < count:
                    items[j] <- items[j + 1]
                    j <- j + 1
                count <- count - 1
        i <- i + 1

    word_count: mutable usize = 0
    output_words[word_count] <- result_count.i64()
    word_count <- word_count + 1
    i <- 0
    while i < result_count:
        output_words[word_count] <- results[i]
        word_count <- word_count + 1
        i <- i + 1
    output_words[word_count] <- count.i64()
    word_count <- word_count + 1
    i <- 0
    while i < count:
        output_words[word_count] <- items[i].i64()
        word_count <- word_count + 1
        i <- i + 1
    required: usize = word_count * 8
    if output.is_null() or output_capacity < required: return -2
    i <- 0
    while i < word_count:
        bits: mutable u64 = output_words[i].u64()
        byte: usize = 0
        while byte < 8:
            output[i * 8 + byte] <- (bits & 255).u8()
            bits <- bits >> 8
            byte <- byte + 1
        i <- i + 1
    return required.i64()

export fn list_array(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = list_array_impl
