def write_i32_le(output: mutable u8&, index: usize, value: i32) -> void:
    bits: mutable u32 = value.u32()
    offset: usize = index * 4
    byte: mutable usize = 0
    while byte < 4:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def linkedlist_implentation_usingarray_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 202: return -1
    operation_count: i64 = input[0]
    if operation_count < 0 or operation_count > 100 or length != (1 + 2 * operation_count).usize(): return -1
    items: mutable i32[100] = zeroed
    item_count: mutable usize = 0
    cursor: mutable usize = 1
    step: mutable i64 = 0
    while step < operation_count:
        opcode: i64 = input[cursor]
        raw_value: i64 = input[cursor + 1]
        cursor <- cursor + 2
        if raw_value < -2147483648 or raw_value > 2147483647 or item_count >= 100: return -1
        value: i32 = raw_value.i32()
        if opcode == 0:
            index: mutable usize = item_count
            while index > 0:
                items[index] <- items[index - 1]
                index <- index - 1
            items[0] <- value
            item_count <- item_count + 1
        elif opcode == 1:
            if item_count == 0: return -1
            items[item_count] <- value
            item_count <- item_count + 1
        else:
            return -1
        step <- step + 1
    output_bytes: usize = (item_count + 1) * 4
    if output.is_null() or capacity < output_bytes: return -2
    write_i32_le(output, 0, item_count.i32())
    index: mutable usize = 0
    while index < item_count:
        write_i32_le(output, index + 1, items[index])
        index <- index + 1
    return output_bytes.i64()

export fn linkedlist_implentation_usingarray(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = linkedlist_implentation_usingarray_impl
