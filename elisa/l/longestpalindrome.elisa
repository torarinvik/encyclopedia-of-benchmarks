def longestpalindrome_impl(v: i64&, length: usize) -> i64:
    if length < 1 or length > 65: return -1
    count: i64 = v[0]
    if count < 0 or count > 64 or length != count.usize() + 1: return -1
    a: mutable i64[64] = zeroed
    m: mutable usize = 0
    i: mutable usize = 0
    while i < count.usize():
        x: i64 = v[i + 1]
        if x < 32 or x > 126 or x == 35: return -1
        if x != 32: a[m] <- x; m <- m + 1
        i <- i + 1
    t: mutable i64[129] = zeroed
    z: usize = 2 * m + 1
    i <- 0
    while i < z:
        if i % 2 == 0: t[i] <- -1
        else: t[i] <- a[i / 2]
        i <- i + 1
    p: mutable usize[129] = zeroed
    center: mutable usize = 0
    right: mutable usize = 0
    best: mutable usize = 0
    i <- 0
    while i < z:
        if i < right:
            mirror: usize = 2 * center - i
            p[i] <- if p[mirror] < right - i: p[mirror] else: right - i
        while i >= p[i] + 1 and i + p[i] + 1 < z and t[i - p[i] - 1] == t[i + p[i] + 1]: p[i] <- p[i] + 1
        if p[i] > best: best <- p[i]
        if i + p[i] > right: center <- i; right <- i + p[i]
        i <- i + 1
    best.i64()
export fn longestpalindrome(v: i64&, length: usize) -> i64 = longestpalindrome_impl
