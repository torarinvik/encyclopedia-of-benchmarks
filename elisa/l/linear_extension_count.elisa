const LEC_MAX_N: usize = 12
const LEC_MAX_LENGTH: usize = 14
const LEC_MAX_STATES: usize = 4096

def linear_extension_count_impl(input: i64&, input_length: usize) -> i64:
    length: usize = input_length
    if length < 1 or length > LEC_MAX_LENGTH: return -1
    if input[0] < 0: return -1
    if input[0] > LEC_MAX_N.i64(): return -1
    n: usize = input[0].usize()
    if length != n+1: return -1
    full: usize = (1 << n)-1
    predecessor: mutable usize[LEC_MAX_N] = zeroed
    vertex: mutable usize = 0
    while vertex < n:
        if input[1+vertex] < 0: return -1
        mask: usize = input[1+vertex].usize()
        if mask > full: return -1
        predecessor[vertex] <- mask
        vertex <- vertex+1

    ways: mutable i64[LEC_MAX_STATES] = zeroed
    ways[0] <- 1
    states: usize = full+1
    prefix: mutable usize = 0
    while prefix < states:
        count: i64 = ways[prefix]
        if count != 0:
            vertex <- 0
            while vertex < n:
                bit: usize = 1 << vertex
                if (prefix & bit) == 0 and (predecessor[vertex] & prefix) == predecessor[vertex]:
                    ways[prefix | bit] <- ways[prefix | bit]+count
                vertex <- vertex+1
        prefix <- prefix+1
    ways[full]

def linear_extension_count_entry(input: i64&, length: usize) -> i64:
    if input == null or length > LEC_MAX_LENGTH: return -1
    linear_extension_count_impl(input, length)

export fn linear_extension_count(input: i64&, length: usize) -> i64 = linear_extension_count_entry
