def solve(a: i64[], n: i64, out: i64[]) -> i64:
    if n <= 1:
        if n == 1: out[0] = a[0]
        return n
    pivot=a[0]; best=[0;10]; sub=[0;10]; cand=[0;10]; bl=0
    i=1
    while i<n:
        if a[i] < pivot:
            m=0
            for j in i+1..n:
                if a[j] >= a[i]: sub[m]=a[j];m+=1
            sl=solve(sub,m,cand[1:]);cand[0]=a[i]
            if sl+1>bl:
                bl=sl+1;best[0]=cand[0];i=1
                while i<bl:best[i]=cand[i];i+=1
        i+=1
    m=0
    for i in 1..n:
        if a[i]>=pivot:sub[m]=a[i];m+=1
    sl=solve(sub,m,cand[1:]);cand[0]=pivot
    if sl+1>bl:
        bl=sl+1
        for q in 0..bl:best[q]=cand[q]
    for q in 0..bl:out[q]=best[q]
    bl
def longest_subsequence_impl(v: i64&, n: usize) -> i64:
    if n<2 or n>11:return -1
    k=v[0]
    if k<1 or k>10 or n!=k+1:return -1
    a=[0;10];out=[0;10]
    for i in 0..k:
        a[i]=v[i+1]
        if a[i]<-10 or a[i]>10:return -1
    length=solve(a,k,out);r=length
    for i in 0..length:r=r*21+out[i]+10
    r
export fn longest_subsequence(v: i64&, n: usize) -> i64 = longest_subsequence_impl
