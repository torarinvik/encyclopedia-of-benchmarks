def round_scaled(a: i64, b: i64) -> i64:
    q = (abs(a) * 100000 + b // 2) // b
    if a < 0: return -q
    return q
def least_square_approx_impl(v: i64&, n: usize) -> i64:
    if n < 5 or n > 13: return -1
    k = v[0]
    if k < 2 or k > 6 or n != 1 + 2*k: return -1
    sx = 0; sy = 0; sxx = 0; sxy = 0
    for i in 0..k:
        x = v[1+2*i]; y = v[2+2*i]
        if x < -20 or x > 20 or y < -20 or y > 20: return -1
        sx += x; sy += y; sxx += x*x; sxy += x*y
    den = k*sxx-sx*sx
    if den <= 0: return -1
    num = k*sxy-sx*sy
    slope = round_scaled(num,den); intercept = round_scaled(sy*den-num*sx,k*den)
    if slope <= -100000001 or slope >= 100000001 or intercept <= -100000001 or intercept >= 100000001: return -1
    (slope+100000001)*200000003+(intercept+100000001)
export fn least_square_approx(v: i64&, n: usize) -> i64 = least_square_approx_impl
