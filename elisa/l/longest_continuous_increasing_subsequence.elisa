const MAX_LENGTH: usize = 10000

def longest_continuous_increasing_subsequence_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    for index in 0..<length |values|:
        value: i64 = values[index]
        if value < -1000000 or value > 1000000:
            return -1
    if length == 0:
        return 0

    while index < length |index: mutable usize = 1, current: mutable usize = 1, best: mutable usize = 1| -> best.i64():
        if values[index] > values[index - 1]:
            current <- current + 1
        else:
            current <- 1
        if current > best:
            best <- current
        index <- index + 1

export fn longest_continuous_increasing_subsequence(values: i64&, length: usize) -> i64 = longest_continuous_increasing_subsequence_impl
