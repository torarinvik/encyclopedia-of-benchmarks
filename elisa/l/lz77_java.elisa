const MAX_TEXT_LENGTH: usize = 64
const MAX_INPUT_LENGTH: usize = 66
const MAX_OUTPUT_BYTES: usize = 1536

def lz77_java_compress_impl(input: i64&, input_length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > MAX_INPUT_LENGTH: return -1
    if input[0] < 0 or input[0] > 64: return -1
    text_length: usize = input[0].usize()
    if input_length != 1 + text_length: return -1
    index: mutable usize = 0
    while index < text_length:
        if input[index + 1] < 32 or input[index + 1] > 126: return -1
        index <- index + 1

    staged: mutable u8[1536] = zeroed
    token_count: mutable usize = 0
    current: mutable usize = 0
    while current < text_length:
        best_distance: mutable usize = 0
        best_length: mutable usize = 0
        search_start: usize = if current > 4096: current - 4096 else: 0
        lookahead_end: usize = if current + 16 < text_length: current + 16 else: text_length
        candidate: mutable usize = search_start
        while candidate < current:
            match_length: mutable usize = 0
            while current + match_length < lookahead_end:
                source: mutable usize = candidate + match_length
                if source >= current:
                    distance: usize = current - candidate
                    source <- candidate + (match_length % distance)
                if input[source + 1] != input[current + match_length + 1]: break
                match_length <- match_length + 1
            if match_length > best_length:
                best_distance <- current - candidate
                best_length <- match_length
            candidate <- candidate + 1

        next_character: i64 = 0
        if current + best_length < text_length: next_character <- input[current + best_length + 1]
        byte_offset: usize = token_count * 24
        fields: i64[3] = [best_distance.i64(), best_length.i64(), next_character]
        field_index: mutable usize = 0
        while field_index < 3:
            bits: u64 = fields[field_index].u64()
            byte_index: mutable usize = 0
            while byte_index < 8:
                staged[byte_offset + field_index * 8 + byte_index] <- ((bits >> (byte_index * 8)) & 255).u8()
                byte_index <- byte_index + 1
            field_index <- field_index + 1
        token_count <- token_count + 1
        if next_character == 0: current <- current + best_length
        else: current <- current + best_length + 1

    output_bytes: usize = token_count * 24
    if output_bytes > MAX_OUTPUT_BYTES: return -1
    if output.is_null() or capacity < output_bytes: return -2
    index <- 0
    while index < output_bytes:
        output[index] <- staged[index]
        index <- index + 1
    return output_bytes.i64()

export fn lz77_java_compress(input: i64&, input_length: usize,
        output: mutable u8&, capacity: usize) -> i64 = lz77_java_compress_impl
