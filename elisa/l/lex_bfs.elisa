const MAX_N: usize = 16
const MAX_M: usize = 120
const MAX_INPUT: usize = 243

def lex_bfs_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def lex_bfs(input: i64&, length: usize,
             output: mutable u8&, capacity: usize) -> i64 @export("lex_bfs"):
    if input.is_null() or length < 3 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    start64: i64 = input[2]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 120 or start64 < 0 or
            start64 >= n64 or length != 3 + 2 * m64.usize(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    start: usize = start64.usize()
    adjacency: mutable bool[16][16] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u64: i64 = input[3 + 2 * edge]
        v64: i64 = input[4 + 2 * edge]
        if u64 < 0 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacency[u][v]: return -1
        adjacency[u][v] <- true
        adjacency[v][u] <- true
        edge <- edge + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes: return -2
    labels: mutable i64[16][16] = zeroed
    label_len: mutable usize[16] = zeroed
    order: mutable i64[16] = zeroed
    selected: mutable bool[16] = zeroed
    current: mutable usize = start
    step: mutable usize = 0
    while step < n:
        if step > 0:
            have_best: mutable bool = false
            vertex: mutable usize = 0
            while vertex < n:
                if not selected[vertex]:
                    if not have_best:
                        current <- vertex
                        have_best <- true
                    else:
                        shared: usize = label_len[vertex]
                        if label_len[current] < shared: shared <- label_len[current]
                        position: mutable usize = 0
                        decided: mutable bool = false
                        while position < shared:
                            if labels[vertex][position] != labels[current][position]:
                                if labels[vertex][position] > labels[current][position]: current <- vertex
                                decided <- true
                                break
                            position <- position + 1
                        if not decided and (label_len[vertex] > label_len[current] or
                                (label_len[vertex] == label_len[current] and vertex < current)):
                            current <- vertex
                vertex <- vertex + 1
        selected[current] <- true
        order[step] <- current.i64()
        neighbor: mutable usize = 0
        while neighbor < n:
            if adjacency[current][neighbor] and not selected[neighbor]:
                position: mutable usize = label_len[neighbor]
                while position > 0:
                    labels[neighbor][position] <- labels[neighbor][position - 1]
                    position <- position - 1
                labels[neighbor][0] <- step.i64()
                label_len[neighbor] <- label_len[neighbor] + 1
            neighbor <- neighbor + 1
        step <- step + 1
    index: mutable usize = 0
    while index < n:
        lex_bfs_store_i64_le(order[index], output, 8 * index)
        index <- index + 1
    output_bytes.i64()
