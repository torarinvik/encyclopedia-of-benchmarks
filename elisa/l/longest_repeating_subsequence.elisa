def longest_repeating_subsequence_impl(input_values: i64&, length: usize) -> i64:
    if length < 1 or length > 256:
        return -1
    size_value: i64 = input_values[0]
    if size_value < 0 or size_value > 255:
        return -1
    size: usize = size_value.usize()
    if length != size + 1:
        return -1
    k: mutable usize = 0
    while k < size:
        if input_values[k + 1] < 0 or input_values[k + 1] > 127:
            return -1
        k <- k + 1
    result: i64 =
        while i <= size |i: usize = 1, dp: mutable i64[256] = zeroed| -> dp[size]:
            diag: mutable i64 = 0
            j: mutable usize = 1
            while j <= size:
                above: i64 = dp[j]
                if input_values[i] == input_values[j] and i != j:
                    dp[j] <- diag + 1
                elif dp[j - 1] > dp[j]:
                    dp[j] <- dp[j - 1]
                diag <- above
                j <- j + 1
            i <- i + 1
    result
export fn longest_repeating_subsequence(input_values: i64&, length: usize) -> i64 = longest_repeating_subsequence_impl
