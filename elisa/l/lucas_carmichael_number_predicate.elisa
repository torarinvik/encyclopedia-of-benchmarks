const LCN_MAX_VALUE: i64 = 1_000_000

def lcn_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 1: return -1
    value: i64 = input[0]
    if value < 1 or value > LCN_MAX_VALUE: return -1

    remaining: mutable i64 = value
    divisor: mutable i64 = 2
    composite: mutable bool = false
    while divisor <= remaining / divisor:
        if remaining % divisor == 0:
            composite <- true
            exponent: mutable i64 = 0
            while remaining % divisor == 0:
                remaining <- remaining / divisor
                exponent <- exponent + 1
            if exponent != 1 or (value + 1) % (divisor + 1) != 0: return 0
        divisor <- divisor + 1
    if remaining > 1:
        if not composite or (value + 1) % (remaining + 1) != 0: return 0
    if composite: return 1
    0

export fn lucas_carmichael_number_predicate(input: i64&, length: usize) -> i64 = lcn_impl
