const MAX_N: usize = 16
const MAX_INPUT_VALUES: usize = 1 + MAX_N * MAX_N
const STATES: usize = 1 << MAX_N
const MOD: i64 = 998244353

def hafnian_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def hafnian_of_matrix_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_INPUT_VALUES: return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > MAX_N.i64() or n_value % 2 != 0: return -1
    n: usize = n_value.usize()
    if length != 1 + n * n: return -1

    matrix: mutable i64[MAX_N * MAX_N] = zeroed
    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            value: i64 = input[1 + row * n + column]
            if value < 0 or value >= MOD or (row == column and value != 0): return -1
            matrix[row * MAX_N + column] <- value
            column <- column + 1
        row <- row + 1
    row <- 0
    while row < n:
        column <- 0
        while column < row:
            if matrix[row * MAX_N + column] != matrix[column * MAX_N + row]: return -1
            column <- column + 1
        row <- row + 1

    dp: mutable i64[STATES] = zeroed
    dp[0] <- 1
    full: usize = (1 << n) - 1
    mask: mutable usize = 1
    while mask <= full:
        bits: mutable usize = mask
        odd: mutable bool = false
        while bits > 0:
            odd <- not odd
            bits <- bits & (bits - 1)
        if not odd:
            first: mutable usize = 0
            while (mask & (1 << first)) == 0: first <- first + 1
            without_first: usize = mask ^ (1 << first)
            second: mutable usize = first + 1
            while second < n:
                bit: usize = 1 << second
                if (without_first & bit) != 0:
                    rest: usize = without_first ^ bit
                    dp[mask] <- (dp[mask] + matrix[first * MAX_N + second] * dp[rest]) % MOD
                second <- second + 1
        mask <- mask + 1

    if output.is_null() or capacity < 8: return -2
    hafnian_store_i64_le(dp[full], output[0:8], 0)
    8

export fn hafnian_of_matrix(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = hafnian_of_matrix_impl
