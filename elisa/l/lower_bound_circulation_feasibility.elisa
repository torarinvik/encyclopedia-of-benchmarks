const LBCF_MAX_N: usize = 6
const LBCF_MAX_M: usize = 8
const LBCF_MAX_INPUT: usize = 35
const LBCF_NODE_CAP: usize = 8
const LBCF_MATRIX_CAP: usize = 64

export fn lower_bound_circulation_feasibility(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > LBCF_MAX_INPUT:
        return -1
    input_view: view[i64] = input[0:length]
    n_value: i64 = input_view[0]
    m_value: i64 = input_view[1]
    if n_value < 1 or n_value > 6 or m_value < 0 or m_value > 8:
        return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + 4 * m:
        return -1

    residual: mutable i64[LBCF_MATRIX_CAP] = zeroed
    balance: mutable i64[LBCF_MAX_N] = zeroed
    for index in 0..<m:
        offset: usize = 2 + 4 * index
        u_value: i64 = input_view[offset]
        v_value: i64 = input_view[offset + 1]
        lower: i64 = input_view[offset + 2]
        upper: i64 = input_view[offset + 3]
        if u_value < 0 or u_value >= n_value or v_value < 0 or v_value >= n_value or
                lower < 0 or upper < lower or upper > 2:
            return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        residual[u * LBCF_NODE_CAP + v] <- residual[u * LBCF_NODE_CAP + v] + upper - lower
        balance[u] <- balance[u] - lower
        balance[v] <- balance[v] + lower

    source: usize = n
    sink: usize = n + 1
    node_count: usize = n + 2
    demand: mutable i64 = 0
    for vertex in 0..<n:
        if balance[vertex] > 0:
            residual[source * LBCF_NODE_CAP + vertex] <- residual[source * LBCF_NODE_CAP + vertex] + balance[vertex]
            demand <- demand + balance[vertex]
        else if balance[vertex] < 0:
            residual[vertex * LBCF_NODE_CAP + sink] <- residual[vertex * LBCF_NODE_CAP + sink] - balance[vertex]

    flow: mutable i64 = 0
    while flow < demand:
        parent: mutable i64[LBCF_NODE_CAP] = zeroed
        for vertex in 0..<node_count:
            parent[vertex] <- -1
        queue: mutable usize[LBCF_NODE_CAP] = zeroed
        head: mutable usize = 0
        tail: mutable usize = 0
        parent[source] <- source.i64()
        queue[tail] <- source
        tail <- tail + 1
        while head < tail and parent[sink] < 0:
            u: usize = queue[head]
            head <- head + 1
            for v in 0..<node_count:
                if residual[u * LBCF_NODE_CAP + v] > 0 and parent[v] < 0:
                    parent[v] <- u.i64()
                    queue[tail] <- v
                    tail <- tail + 1
                    if v == sink:
                        break
        if parent[sink] < 0:
            break
        amount: mutable i64 = demand - flow
        vertex: mutable usize = sink
        while vertex != source:
            u: usize = parent[vertex].usize()
            if residual[u * LBCF_NODE_CAP + vertex] < amount:
                amount <- residual[u * LBCF_NODE_CAP + vertex]
            vertex <- u
        vertex <- sink
        while vertex != source:
            u: usize = parent[vertex].usize()
            residual[u * LBCF_NODE_CAP + vertex] <- residual[u * LBCF_NODE_CAP + vertex] - amount
            residual[vertex * LBCF_NODE_CAP + u] <- residual[vertex * LBCF_NODE_CAP + u] + amount
            vertex <- u
        flow <- flow + amount
    if flow == demand:
        return 1
    return 0
