def merge_nodes(keys:i64[],left:i64[],right:i64[],npl:i64[],x:i64,y:i64)->i64:
    if x<0:return y
    if y<0:return x
    if keys[x]>keys[y]:tmp=x;x=y;y=tmp
    right[x]=merge_nodes(keys,left,right,npl,right[x],y)
    if left[x]<0:left[x]=right[x];right[x]= -1
    else:
        if npl[left[x]]<npl[right[x]]:tmp=left[x];left[x]=right[x];right[x]=tmp
        npl[x]=npl[right[x]]+1
    return x

def leftist_heap(v:i64[],n:u64)->f64:
    if n<1 or n>43:return -1e300
    m=v[0]
    if m<0 or m>14 or n!=1+3*m:return -1e300
    keys=[0;14];left=[-1;14];right=[-1;14];npl=[0;14]
    roots=[-1;2];used=0;ex=0;result=0
    for i in 0..<m:
        k=v[1+3*i];h=v[2+3*i];z=v[3+3*i]
        if k<0 or k>3:return -1e300
        if k==0:
            if h<0 or h>1 or z<0 or z>9:return -1e300
            keys[used]=z;left[used]= -1;right[used]= -1;npl[used]=0
            roots[h]=merge_nodes(keys,left,right,npl,used,roots[h]);used+=1
        elif k==1:
            if h<0 or h>1 or z!=0:return -1e300
            ex+=1
            if ex>10:return -1e300
            r=roots[h];got= -1
            if r>=0:got=keys[r];roots[h]=merge_nodes(keys,left,right,npl,left[r],right[r])
            result=result*13+got+2
        elif k==2:
            if h!=0 or z!=0:return -1e300
            roots[0]=merge_nodes(keys,left,right,npl,roots[0],roots[1]);roots[1]= -1
        else:
            if h<0 or h>1 or z!=0:return -1e300
            roots[h]= -1
    return result as f64
