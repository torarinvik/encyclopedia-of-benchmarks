const LPM_MAX_PARSEABLE_INPUT_LENGTH: usize = 35
const LPM_MAX_N: usize = 32

def lpm_feasible(input: i64&, n: usize, groups: usize, limit: i64) -> bool:
    used_groups: mutable usize = 1
    current_sum: mutable i64 = 0
    index: mutable usize = 0
    while index < n:
        value: i64 = input[index + 2]
        if current_sum + value > limit:
            used_groups <- used_groups + 1
            current_sum <- value
            if used_groups > groups: return false
        else:
            current_sum <- current_sum + value
        index <- index + 1
    true

def linear_partition_minimax_impl(input: i64&, input_length: usize) -> i64:
    length: usize = input_length
    if length < 3 or length > LPM_MAX_PARSEABLE_INPUT_LENGTH: return -1
    if input[0] < 1 or input[0] > LPM_MAX_N.i64() or input[1] < 1 or input[1] > input[0]: return -1
    n: usize = input[0].usize()
    groups: usize = input[1].usize()
    if length != n + 2: return -1

    low: mutable i64 = 0
    upper: mutable i64 = 0
    index: mutable usize = 0
    while index < n:
        value: i64 = input[index + 2]
        if value < 0 or value > 1000: return -1
        if value > low: low <- value
        upper <- upper + value
        index <- index + 1
    while low < upper:
        middle: i64 = low + (upper - low) / 2
        if lpm_feasible(input, n, groups, middle): upper <- middle
        else: low <- middle + 1
    low

def linear_partition_minimax_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 3 or length > LPM_MAX_PARSEABLE_INPUT_LENGTH: return -1
    linear_partition_minimax_impl(input, length)

export fn linear_partition_minimax(input: i64&, length: usize) -> i64 = linear_partition_minimax_entry
