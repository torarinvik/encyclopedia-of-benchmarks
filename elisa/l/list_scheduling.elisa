const MAX_M: usize = 8
const MAX_N: usize = 32
const MAX_INPUT: usize = 34

def put64(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- ((bits >> (8 * byte)) & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def list_scheduling(input: i64&, length: usize, output: mutable u8&,
                    capacity: usize) -> i64 @export("list_scheduling"):
    if input.is_null() or length < 3 or length > MAX_INPUT: return -1
    machine_count: i64 = input[0]
    job_count: i64 = input[1]
    if machine_count < 1 or machine_count > MAX_M or job_count < 1 or job_count > MAX_N or length != 2 + job_count.usize(): return -1
    machines: usize = machine_count.usize()
    jobs: usize = job_count.usize()
    index: mutable usize = 0
    while index < jobs:
        if input[2 + index] < 1 or input[2 + index] > 10000: return -1
        index <- index + 1
    output_bytes: usize = 8 * (1 + jobs + machines)
    if output.is_null() or capacity < output_bytes: return -2

    loads: mutable i64[8] = zeroed
    assignment: mutable i64[32] = zeroed
    index <- 0
    while index < jobs:
        best: mutable usize = 0
        machine: mutable usize = 1
        while machine < machines:
            if loads[machine] < loads[best]: best <- machine
            machine <- machine + 1
        assignment[index] <- best.i64()
        loads[best] <- loads[best] + input[2 + index]
        index <- index + 1
    makespan: mutable i64 = loads[0]
    machine: mutable usize = 1
    while machine < machines:
        if loads[machine] > makespan: makespan <- loads[machine]
        machine <- machine + 1
    put64(makespan, output, 0)
    index <- 0
    while index < jobs:
        put64(assignment[index], output, 8 * (1 + index))
        index <- index + 1
    machine <- 0
    while machine < machines:
        put64(loads[machine], output, 8 * (1 + jobs + machine))
        machine <- machine + 1
    output_bytes.i64()
