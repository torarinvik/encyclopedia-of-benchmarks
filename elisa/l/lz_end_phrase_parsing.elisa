const MAX_TEXT: usize = 64
const MAX_INPUT: usize = 66
const PHRASE_MULTIPLIER: i64 = 133121

def lz_end_phrase_parsing_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT: return -1
    if input[0] < 0 or input[0] > 64.i64(): return -1
    n: usize = input[0].usize()
    if length != n + 1: return -1
    for i in 0..<n:
        if input[i + 1] < 0 or input[i + 1] > 255: return -1

    boundaries: mutable usize[64] = zeroed
    phrase_lengths: mutable usize[64] = zeroed
    phrases: mutable usize = 0
    position: mutable usize = 0
    while position < n:
        remaining: usize = n - position
        best_copy: mutable usize = 0
        copy_length: mutable usize = remaining - 1
        while copy_length > 0 and best_copy == 0:
            prior: mutable usize = phrases
            while prior > 0 and best_copy == 0:
                prior <- prior - 1
                boundary: usize = boundaries[prior]
                if boundary < copy_length: continue
                matches: mutable bool = true
                offset: mutable usize = 0
                while offset < copy_length:
                    if input[1 + position + offset] != input[1 + boundary - copy_length + offset]:
                        matches <- false
                        break
                    offset <- offset + 1
                if matches: best_copy <- copy_length
            copy_length <- copy_length - 1
        phrase_lengths[phrases] <- best_copy + 1
        position <- position + phrase_lengths[phrases]
        boundaries[phrases] <- position
        phrases <- phrases + 1

    checksum: mutable i64 = 0
    for i in 0..<phrases:
        checksum <- checksum + (i + 1).i64() * phrase_lengths[i].i64()
    PHRASE_MULTIPLIER * phrases.i64() + checksum

export fn lz_end_phrase_parsing(input: i64&, length: usize) -> i64 = lz_end_phrase_parsing_impl
