const MAX_LENGTH: usize = 4096

# Remove every occurrence of target while preserving the surviving order.
def remove_element_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length == 0 or length > MAX_LENGTH:
        return -1
    target: i64 = input[0]
    if target < -2147483648 or target > 2147483647:
        return -1
    valid_input: bool =
        while index < length |index: mutable usize = 1, valid: mutable bool = true| -> valid:
            value: i64 = input[index]
            if value < -2147483648 or value > 2147483647:
                break false
            index <- index + 1
            valid
    if not valid_input:
        return -1
    survivor_count: usize =
        for index in 1..<length |count: mutable usize = 0| -> count:
            if input[index] != target:
                count <- count + 1
    output_bytes: usize = survivor_count * 4
    if output_capacity < output_bytes:
        return -2
    while index < length |index: mutable usize = 1, written: mutable usize = 0, selected_value: mutable i64 = 0, should_write: mutable bool = false, output|:
        selected_value <- input[index]
        should_write <- selected_value != target
        if should_write:
            bits: u32 = selected_value.u32()
            output[written * 4] <- (bits & 255).u8()
            output[written * 4 + 1] <- ((bits >> 8) & 255).u8()
            output[written * 4 + 2] <- ((bits >> 16) & 255).u8()
            output[written * 4 + 3] <- ((bits >> 24) & 255).u8()
            written <- written + 1
        index <- index + 1
        output
    survivor_count.i64()

export fn remove_element(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = remove_element_impl
