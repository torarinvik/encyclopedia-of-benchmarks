const MAX_INPUT_LENGTH: usize = 4096

def remove_duplicate_characters_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 1 or input[0] < 0 or input[0] > MAX_INPUT_LENGTH.i64():
        return -1
    text_length: usize = input[0].usize()
    if length != text_length + 1:
        return -1
    index: usize = 0
    while index < text_length:
        value: i64 = input[index + 1]
        if value < 0 or value > 127:
            return -1
        index <- index + 1

    seen: mutable bool[128] = zeroed
    output_length: mutable usize = 0
    index <- 0
    while index < text_length:
        byte: usize = input[index + 1].usize()
        if not seen[byte]:
            seen[byte] <- true
            output_length <- output_length + 1
        index <- index + 1
    if output_length > output_capacity or (output_length > 0 and output.is_null()):
        return -2

    index <- 0
    while index < 128:
        seen[index] <- false
        index <- index + 1
    written: mutable usize = 0
    index <- 0
    while index < text_length:
        byte: usize = input[index + 1].usize()
        if not seen[byte]:
            seen[byte] <- true
            output[written] <- byte.u8()
            written <- written + 1
        index <- index + 1
    written.i64()

export fn remove_duplicate_characters(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = remove_duplicate_characters_impl
