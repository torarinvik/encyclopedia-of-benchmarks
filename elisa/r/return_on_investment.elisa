# Cross-platform scalar implementation of return_on_investment.
const INVALID_RESULT: f64 = -1.0e300

export fn return_on_investment(input: i64&, length: usize) -> f64:
    if input.is_null() or length != 2:
        return INVALID_RESULT
    gain: i64 = input[0]
    cost: i64 = input[1]
    if gain < -1000000 or gain > 1000000 or cost < 1 or cost > 1000000:
        return INVALID_RESULT
    return (gain.f64() - cost.f64()) / cost.f64()
