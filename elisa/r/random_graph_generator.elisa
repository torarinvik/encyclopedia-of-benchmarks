const MAX_PARSEABLE_INPUT_LENGTH: usize = 2020
const MAX_OUTPUT_BYTES: usize = 4096
const DRAW_SCALE: i64 = 9007199254740992
const MIN_PROBABILITY_UNITS: i64 = -9007199254740992
const MAX_PROBABILITY_UNITS: i64 = 18014398509481984

def random_graph_generator_impl(input: i64&, input_length: usize,
                                output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or input_length < 3 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    vertex_count_raw: i64 = input[0]
    directed: i64 = input[1]
    probability_units: i64 = input[2]
    if vertex_count_raw < 0 or vertex_count_raw > 64 or (directed != 0 and directed != 1): return -1
    if probability_units < MIN_PROBABILITY_UNITS or probability_units > MAX_PROBABILITY_UNITS: return -1
    vertex_count: usize = vertex_count_raw.usize()
    pair_count: usize = 0
    if vertex_count >= 2: pair_count <- vertex_count * (vertex_count - 1) / 2
    draw_count: usize = 0
    if probability_units > 0 and probability_units < DRAW_SCALE: draw_count <- pair_count
    if input_length != 3 + draw_count: return -1
    index: mutable usize = 0
    while index < draw_count:
        draw: i64 = input[3 + index]
        if draw < 0 or draw >= DRAW_SCALE: return -1
        index <- index + 1

    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    if probability_units >= DRAW_SCALE:
        source: mutable usize = 0
        while source < vertex_count:
            target: mutable usize = 0
            while target < vertex_count:
                if source != target: staged[source * vertex_count + target] <- 1
                target <- target + 1
            source <- source + 1
    else if probability_units > 0:
        source: mutable usize = 0
        draw_index: mutable usize = 0
        while source < vertex_count:
            target: mutable usize = source + 1
            while target < vertex_count:
                if input[3 + draw_index] < probability_units:
                    staged[source * vertex_count + target] <- 1
                    if directed == 0: staged[target * vertex_count + source] <- 1
                draw_index <- draw_index + 1
                target <- target + 1
            source <- source + 1

    output_bytes: usize = vertex_count * vertex_count
    if output.is_null() or capacity < output_bytes: return -2
    index <- 0
    while index < output_bytes:
        output[index] <- staged[index]
        index <- index + 1
    output_bytes.i64()

export fn random_graph_generator(input: i64&, input_length: usize,
                                 output: mutable u8&, capacity: usize) -> i64 = random_graph_generator_impl
