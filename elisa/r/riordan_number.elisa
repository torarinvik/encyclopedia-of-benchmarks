const RN_MAX_N: i64 = 30
const RN_MAX_PARSEABLE_LENGTH: usize = 2

def riordan_number_impl(input: view[i64]) -> i64:
    if input.length < 1 or input.length > RN_MAX_PARSEABLE_LENGTH: return -1
    if input.length != 1: return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > RN_MAX_N: return -1
    n: usize = n_value.usize()
    values: mutable i64[31] = zeroed
    values[0] <- 1
    size: mutable usize = 2
    while size <= n:
        previous: i64 = values[size - 1]
        before_previous: i64 = values[size - 2]
        numerator: i64 = (size - 1).i64() * (2 * previous + 3 * before_previous)
        values[size] <- numerator / (size + 1).i64()
        size <- size + 1
    values[n]

export fn riordan_number(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > RN_MAX_PARSEABLE_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    riordan_number_impl(input_view)
