def reverse_words_in_string_is_trim_byte(value: i64) -> bool = value >= 0 and value <= 32
def reverse_words_in_string_is_split_space(value: i64) -> bool = value == 32 or (value >= 9 and value <= 13)

def reverse_words_in_string_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length == 0 or length > 258:
        return -1
    text_length_value: i64 = input[0]
    if text_length_value < 0 or text_length_value > 256:
        return -1
    text_length: usize = text_length_value.usize()
    if length != text_length + 1:
        return -1
    index: mutable usize = 0
    while index < text_length:
        if input[index + 1] < 0 or input[index + 1] > 127:
            return -1
        index <- index + 1

    start: mutable usize = 0
    end: mutable usize = text_length
    while start < end and reverse_words_in_string_is_trim_byte(input[start + 1]):
        start <- start + 1
    while end > start and reverse_words_in_string_is_trim_byte(input[end]):
        end <- end - 1

    output_length: mutable usize = 0
    word_count: mutable usize = 0
    position: mutable usize = start
    while position < end:
        while position < end and reverse_words_in_string_is_split_space(input[position + 1]):
            position <- position + 1
        if position < end:
            token_start: usize = position
            while position < end and not reverse_words_in_string_is_split_space(input[position + 1]):
                position <- position + 1
            output_length <- output_length + position - token_start
            if word_count > 0:
                output_length <- output_length + 1
            word_count <- word_count + 1

    if capacity < output_length or (output_length > 0 and output.is_null()):
        return -2

    written: mutable usize = 0
    emitted: mutable usize = 0
    position <- end
    while position > start:
        while position > start and reverse_words_in_string_is_split_space(input[position]):
            position <- position - 1
        if position > start:
            token_end: usize = position
            while position > start and not reverse_words_in_string_is_split_space(input[position]):
                position <- position - 1
            token_start: usize = position
            if emitted > 0:
                output[written] <- 32
                written <- written + 1
            index <- token_start
            while index < token_end:
                output[written] <- input[index + 1].u8()
                written <- written + 1
                index <- index + 1
            emitted <- emitted + 1
    written.i64()

export fn reverse_words_in_string(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = reverse_words_in_string_impl
