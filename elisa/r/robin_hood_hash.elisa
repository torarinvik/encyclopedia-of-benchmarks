const TABLE_CAPACITY: usize = 16
const MAX_ACTIVE_ENTRIES: usize = 14
const MAX_OPERATIONS: usize = 64
const MAX_INPUT_LENGTH: usize = 1 + 3 * MAX_OPERATIONS
const MAX_OUTPUT_BYTES: usize = 8 * MAX_OPERATIONS
const MAX_PROBE_DISTANCE: usize = 64
const GOLDEN_RATIO: u64 = 0x9E3779B97F4A7C15.u64()

def robin_hood_hash_index(key: u64) -> usize:
    product: u64 = key *% GOLDEN_RATIO
    return ((product >> 32) & (TABLE_CAPACITY - 1).u64()).usize()

def robin_hood_hash_put(keys: mutable u64&, values: mutable u64&,
                        psls: mutable usize&, occupied: mutable u8&,
                        count: mutable usize&, key: u64, value: u64) -> bool:
    if (count * 100) / TABLE_CAPACITY >= 90: return false
    entry_key: mutable u64 = key
    entry_value: mutable u64 = value
    entry_psl: mutable usize = 0
    index: mutable usize = robin_hood_hash_index(key)
    probes: mutable usize = 0
    while probes < MAX_PROBE_DISTANCE:
        if occupied[index] == 0.u8():
            keys[index] <- entry_key
            values[index] <- entry_value
            psls[index] <- entry_psl
            occupied[index] <- 1.u8()
            count <- count + 1
            return true
        if keys[index] == key:
            values[index] <- value
            return true
        if entry_psl > psls[index]:
            old_key: u64 = keys[index]
            old_value: u64 = values[index]
            old_psl: usize = psls[index]
            keys[index] <- entry_key
            values[index] <- entry_value
            psls[index] <- entry_psl
            entry_key <- old_key
            entry_value <- old_value
            entry_psl <- old_psl
        entry_psl <- entry_psl + 1
        index <- (index + 1) & (TABLE_CAPACITY - 1)
        probes <- probes + 1
    false

def robin_hood_hash_get(keys: u64&, values: u64&, psls: usize&,
                        occupied: u8&, key: u64) -> i64:
    index: mutable usize = robin_hood_hash_index(key)
    psl: mutable usize = 0
    while psl < MAX_PROBE_DISTANCE:
        if occupied[index] == 0.u8(): return -1
        if keys[index] == key: return values[index].i64()
        if psl > psls[index]: return -1
        index <- (index + 1) & (TABLE_CAPACITY - 1)
        psl <- psl + 1
    -1

def robin_hood_hash_backshift(keys: mutable u64&, values: mutable u64&,
                              psls: mutable usize&, occupied: mutable u8&,
                              start: usize) -> void:
    index: mutable usize = start
    iteration: mutable usize = 0
    while iteration < TABLE_CAPACITY:
        next: usize = (index + 1) & (TABLE_CAPACITY - 1)
        if occupied[next] == 0.u8() or psls[next] == 0:
            occupied[index] <- 0.u8()
            psls[index] <- 0
            return
        keys[index] <- keys[next]
        values[index] <- values[next]
        psls[index] <- psls[next] - 1
        index <- next
        iteration <- iteration + 1

def robin_hood_hash_remove(keys: mutable u64&, values: mutable u64&,
                           psls: mutable usize&, occupied: mutable u8&,
                           count: mutable usize&, key: u64) -> bool:
    index: mutable usize = robin_hood_hash_index(key)
    psl: mutable usize = 0
    while psl < MAX_PROBE_DISTANCE:
        if occupied[index] == 0.u8(): return false
        if keys[index] == key:
            robin_hood_hash_backshift(keys, values, psls, occupied, index)
            count <- count - 1
            return true
        if psl > psls[index]: return false
        index <- (index + 1) & (TABLE_CAPACITY - 1)
        psl <- psl + 1
    false

def robin_hood_hash_clear(occupied: mutable u8&, psls: mutable usize&,
                          count: mutable usize&) -> void:
    index: mutable usize = 0
    while index < TABLE_CAPACITY:
        occupied[index] <- 0.u8()
        psls[index] <- 0
        index <- index + 1
    count <- 0

def robin_hood_hash_max_psl(psls: usize&, occupied: u8&) -> usize:
    maximum: mutable usize = 0
    index: mutable usize = 0
    while index < TABLE_CAPACITY:
        if occupied[index] != 0.u8() and psls[index] > maximum: maximum <- psls[index]
        index <- index + 1
    maximum

def robin_hood_hash_write_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def robin_hood_hash_impl(input: i64&, input_length: usize,
                         output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > MAX_INPUT_LENGTH: return -1
    if input[0] < 0 or input[0] > MAX_OPERATIONS.i64(): return -1
    operation_count: usize = input[0].usize()
    if input_length != 1 + 3 * operation_count: return -1

    keys: mutable u64[TABLE_CAPACITY] = zeroed
    values: mutable u64[TABLE_CAPACITY] = zeroed
    psls: mutable usize[TABLE_CAPACITY] = zeroed
    occupied: mutable u8[TABLE_CAPACITY] = zeroed
    results: mutable i64[MAX_OPERATIONS] = zeroed
    count: mutable usize = 0
    operation: mutable usize = 0
    while operation < operation_count:
        offset: usize = 1 + 3 * operation
        opcode: i64 = input[offset]
        raw_key: i64 = input[offset + 1]
        raw_value: i64 = input[offset + 2]
        if opcode == 0:
            if raw_key < 0 or raw_key > 4294967295 or raw_value < 100 or raw_value > 1000000: return -1
            if not robin_hood_hash_put(keys[0]&, values[0]&, psls[0]&, occupied[0]&, count&,
                                       raw_key.u64(), raw_value.u64()): return -1
            if count > MAX_ACTIVE_ENTRIES: return -1
            results[operation] <- -2
        elif opcode == 1 or opcode == 2:
            if raw_key < 0 or raw_key > 4294967295 or raw_value != 0: return -1
            key: u64 = raw_key.u64()
            if opcode == 1:
                results[operation] <- robin_hood_hash_get(keys[0]&, values[0]&, psls[0]&, occupied[0]&, key)
            elif robin_hood_hash_remove(keys[0]&, values[0]&, psls[0]&, occupied[0]&, count&, key):
                results[operation] <- 1
            else:
                results[operation] <- 0
        elif opcode >= 3 and opcode <= 7:
            if raw_key != 0 or raw_value != 0: return -1
            if opcode == 3: results[operation] <- count.i64()
            elif opcode == 4: results[operation] <- ((count * 100) / TABLE_CAPACITY).i64()
            elif opcode == 5: results[operation] <- robin_hood_hash_max_psl(psls[0]&, occupied[0]&).i64()
            elif opcode == 6:
                robin_hood_hash_clear(occupied[0]&, psls[0]&, count&)
                results[operation] <- -3
            elif count == 0: results[operation] <- 1
            else: results[operation] <- 0
        else:
            return -1
        operation <- operation + 1

    output_bytes: usize = operation_count * 8
    if output.is_null() or output_capacity < output_bytes: return -2
    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    operation <- 0
    while operation < operation_count:
        robin_hood_hash_write_i64_le(staged[0]&, operation * 8, results[operation])
        operation <- operation + 1
    byte: mutable usize = 0
    while byte < output_bytes:
        output[byte] <- staged[byte]
        byte <- byte + 1
    output_bytes.i64()

export fn robin_hood_hash(input: i64&, input_length: usize,
                          output: mutable u8&, output_capacity: usize) -> i64 = robin_hood_hash_impl
