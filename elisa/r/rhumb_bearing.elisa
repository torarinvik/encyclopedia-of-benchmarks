extern tan(value: f64) -> f64
extern log(value: f64) -> f64
extern atan2(y: f64, x: f64) -> f64
extern floor(value: f64) -> f64

const PI: f64 = 3.14159265358979323846264338327950288

def rhumb_bearing_finite(value: f64) -> bool:
    value == value and value >= -1e308 and value <= 1e308

def rhumb_bearing_impl(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if input == null or input_length != 4:
        return -1
    lat1: f64 = input[0]; long1: f64 = input[1]; lat2: f64 = input[2]; long2: f64 = input[3]
    if not rhumb_bearing_finite(lat1) or not rhumb_bearing_finite(long1) or not rhumb_bearing_finite(lat2) or not rhumb_bearing_finite(long2) or lat1 < -85.0 or lat1 > 85.0 or lat2 < -85.0 or lat2 > 85.0 or long1 < -180.0 or long1 > 180.0 or long2 < -180.0 or long2 > 180.0:
        return -1
    phi1: f64 = lat1 * PI / 180.0
    phi2: f64 = lat2 * PI / 180.0
    del_lambda: mutable f64 = (long2 - long1) * PI / 180.0
    if del_lambda > PI:
        del_lambda <- del_lambda - 2.0 * PI
    else if del_lambda < -PI:
        del_lambda <- del_lambda + 2.0 * PI
    del_psi: f64 = log(tan(phi2 / 2.0 + PI / 4.0) / tan(phi1 / 2.0 + PI / 4.0))
    bearing: f64 = atan2(del_lambda, del_psi) * 180.0 / PI
    bearing_plus_360: f64 = bearing + 360.0
    normalized: f64 = bearing_plus_360 - floor(bearing_plus_360 / 360.0) * 360.0
    if output == null or output_capacity < 1:
        return -2
    output[0] <- normalized
    return 1

export fn rhumb_bearing(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64 = rhumb_bearing_impl
