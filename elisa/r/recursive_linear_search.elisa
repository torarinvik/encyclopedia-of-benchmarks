const MAX_N: usize = 64
const MAX_INPUT_LENGTH: usize = 66

def search_recursive(items: view[i64], left: i64, right: i64, target: i64) -> i64:
    if left > right: return -1
    if items[left.usize()] == target: return left
    if items[right.usize()] == target: return right
    search_recursive(items, left + 1, right - 1, target)

def recursive_linear_search_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 4 or length > MAX_INPUT_LENGTH: return -1
    if input[0] < 2 or input[0] > MAX_N.i64() or length != input[0].usize() + 2: return -1
    target: i64 = input[1]
    if target < -2147483648 or target > 2147483647: return -1
    n: usize = input[0].usize()
    items: mutable i64[MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        if input[i + 2] < -2147483648 or input[i + 2] > 2147483647: return -1
        items[i] <- input[i + 2]
        j: usize = 0
        while j < i:
            if items[j] == items[i]: return -1
            j <- j + 1
        i <- i + 1
    search_recursive(items[0:n], 0, n.i64() - 1, target)

export fn recursive_linear_search(input: i64&, length: usize) -> i64 = recursive_linear_search_impl
