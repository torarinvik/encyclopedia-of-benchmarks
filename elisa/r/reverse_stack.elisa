const MAX_ELEMENTS: usize = 16
const MAX_OUTPUT_BYTES: usize = 136

def reverse_stack_insert(items: mutable i64[16], size: usize, value: i64) -> void:
    if size == 0:
        items[0] <- value
        return
    top: i64 = items[size - 1]
    reverse_stack_insert(items, size - 1, value)
    items[size] <- top

def reverse_stack_recursive(items: mutable i64[16], size: usize) -> void:
    if size == 0: return
    top: i64 = items[size - 1]
    reverse_stack_recursive(items, size - 1)
    reverse_stack_insert(items, size - 1, top)

def reverse_stack_put_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def reverse_stack_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null || length < 1: return -1
    raw_count: i64 = input[0]
    if raw_count < 0 || raw_count > 16 || length != (raw_count + 1).usize(): return -1
    count: usize = raw_count.usize()
    items: mutable i64[16] = zeroed
    for i in 0..<count:
        if input[i + 1] < -1000000 || input[i + 1] > 1000000: return -1
        items[i] <- input[i + 1]
    bytes: usize = (count + 1) * 8
    if output == null || capacity < bytes: return -2
    reverse_stack_recursive(items, count)
    reverse_stack_put_i64(output, 0, raw_count)
    for i in 0..<count: reverse_stack_put_i64(output, 8 * (i + 1), items[i])
    bytes.i64()

export fn reverse_stack(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = reverse_stack_impl
