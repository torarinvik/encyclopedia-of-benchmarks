const MAX_COUNT: usize = 256
const MAX_INPUT_LENGTH: usize = 5
const MAX_OUTPUT_BYTES: usize = 1024

def pcg32_put_u32_le(output: mutable u8&, index: usize, value: u32) -> void:
    bits: mutable u32 = value
    offset: usize = index * 4
    byte: mutable usize = 0
    while byte < 4:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def pcg32_rotate_right(value: u32, rotation: u32) -> u32:
    left_shift: u32 = (32 - rotation) & 31
    return (value >> rotation) | (value << left_shift)

def pcg32_random_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > MAX_INPUT_LENGTH:
        return -1
    if length != 4:
        return -1

    seed: u64 = input[0].u64()
    multiplier: u64 = input[1].u64()
    stream_value: i64 = input[2]
    count_value: i64 = input[3]
    if stream_value < 0 or count_value < 0 or count_value > 256:
        return -1

    stream: u64 = stream_value.u64()
    increment: u64 = (stream << 1) | 1
    state: mutable u64 = seed +% increment
    state <- state *% multiplier +% increment
    count: usize = count_value.usize()
    required_bytes: usize = count * 4
    if required_bytes > MAX_OUTPUT_BYTES:
        return -1
    if output.is_null() or output_capacity < required_bytes:
        return -2

    index: mutable usize = 0
    while index < count:
        value: mutable u64 = state
        rotation: u32 = (value >> 59).u32()
        state <- state *% multiplier +% increment
        value <- value ^ (value >> 18)
        xorshifted: u32 = (value >> 27).u32()
        pcg32_put_u32_le(output, index, pcg32_rotate_right(xorshifted, rotation))
        index <- index + 1
    required_bytes.i64()

export fn pcg32_random(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = pcg32_random_impl
