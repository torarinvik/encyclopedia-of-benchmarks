const RA_MAX_N: i64 = 100000
const RA_MAX_PARSEABLE_LENGTH: usize = 2

def ra_factor_sum_counted(value_arg: i64) -> i64:
    value: mutable i64 = value_arg
    total: mutable i64 = 0
    divisor: mutable i64 = 2
    while divisor <= value / divisor:
        while value % divisor == 0:
            total <- total + divisor
            value <- value / divisor
        divisor <- divisor + 1
    if value > 1: total <- total + value
    total

def ra_impl(input: view[i64]) -> i64:
    if input.length != 1: return -1
    n: i64 = input[0]
    if n < 1 or n > RA_MAX_N: return -1
    if ra_factor_sum_counted(n) == ra_factor_sum_counted(n + 1): return 1
    0

export fn ruth_aaron_number_predicate(input: i64&, input_length: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > RA_MAX_PARSEABLE_LENGTH: return -1
    input_view: view[i64] = input[0:input_length]
    ra_impl(input_view)
