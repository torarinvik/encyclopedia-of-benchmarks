const MAX_DIMENSION: usize = 8
const MAX_CELLS: usize = 64
const MAX_PARSEABLE_INPUT_LENGTH: usize = 71

def rat_in_maze_direction(variant: i64, move: usize) -> (i64, i64):
    if variant == 0:
        if move == 0: return (1, 0)
        if move == 1: return (0, 1)
        if move == 2: return (-1, 0)
        return (0, -1)
    if move == 0: return (0, 1)
    if move == 1: return (1, 0)
    if move == 2: return (0, -1)
    ( -1, 0 )

def rat_in_maze_search(variant: i64, rows: usize, cols: usize,
                       destination_row: usize, destination_col: usize,
                       cells: i64&, path: mutable u8&, row: i64, col: i64) -> bool:
    if variant == 1 and row == destination_row.i64() and col == destination_col.i64():
        path[row.usize() * cols + col.usize()] <- 1.u8()
        return true
    if row < 0 or col < 0 or row >= rows.i64() or col >= cols.i64(): return false
    index: usize = row.usize() * cols + col.usize()
    open_value: i64 = if variant == 0: 0 else: 1
    if cells[index] != open_value or path[index] != 0.u8(): return false
    path[index] <- 1.u8()
    if variant == 0 and row == destination_row.i64() and col == destination_col.i64(): return true
    move: mutable usize = 0
    while move < 4:
        (delta_row, delta_col): (i64, i64) = rat_in_maze_direction(variant, move)
        if rat_in_maze_search(variant, rows, cols, destination_row, destination_col,
                              cells, path, row + delta_row, col + delta_col): return true
        move <- move + 1
    path[index] <- 0.u8()
    false

def rat_in_maze_write_i64_le(output: mutable u8&, offset: mutable usize&, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset] <- (bits & 255).u8()
        bits <- bits >> 8
        offset <- offset + 1
        byte <- byte + 1

def rat_in_maze_impl(input: i64&, input_length: usize,
                     output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1

    variant: i64 = input[0]
    rows: mutable usize = 0
    cols: mutable usize = 0
    start_row: mutable usize = 0
    start_col: mutable usize = 0
    destination_row: mutable usize = 0
    destination_col: mutable usize = 0
    cell_offset: mutable usize = 0
    cells: mutable i64[MAX_CELLS] = zeroed

    if variant == 0:
        if input_length < 7 or input[1] < 1 or input[1] > MAX_DIMENSION.i64(): return -1
        size: usize = input[1].usize()
        if input_length != 6 + size * size: return -1
        if input[2] < 0 or input[2] >= size.i64() or input[3] < 0 or input[3] >= size.i64() or
           input[4] < 0 or input[4] >= size.i64() or input[5] < 0 or input[5] >= size.i64(): return -1
        rows <- size
        cols <- size
        start_row <- input[2].usize()
        start_col <- input[3].usize()
        destination_row <- input[4].usize()
        destination_col <- input[5].usize()
        cell_offset <- 6
    else if variant == 1:
        if input_length < 6 or input[1] < 1 or input[1] > MAX_DIMENSION.i64() or
           input[2] < 1 or input[2] > MAX_DIMENSION.i64(): return -1
        rows <- input[1].usize()
        cols <- input[2].usize()
        if input_length != 5 + rows * cols or input[3] < 0 or input[3] >= rows.i64() or
           input[4] < 0 or input[4] >= cols.i64(): return -1
        start_row <- input[3].usize()
        start_col <- input[4].usize()
        destination_row <- rows - 1
        destination_col <- cols - 1
        cell_offset <- 5
    else:
        return -1

    index: mutable usize = 0
    cells_count: usize = rows * cols
    while index < cells_count:
        value: i64 = input[cell_offset + index]
        if value != 0 and value != 1: return -1
        cells[index] <- value
        index <- index + 1

    path: mutable u8[MAX_CELLS] = zeroed
    cells_ref: i64& = cells[0]
    path_ref: mutable u8& = path[0]
    if not rat_in_maze_search(variant, rows, cols, destination_row, destination_col,
                              cells_ref, path_ref, start_row.i64(), start_col.i64()): return -3

    output_bytes: usize = cells_count * 8
    if output == null or output_capacity < output_bytes: return -2
    position: mutable usize = 0
    index <- 0
    while index < cells_count:
        value: i64 = 0
        if variant == 0:
            if path[index] == 0.u8(): value <- 1
        else if path[index] != 0.u8():
            value <- 1
        rat_in_maze_write_i64_le(output, position&, value)
        index <- index + 1
    position.i64()

export fn rat_in_maze(input: i64&, input_length: usize,
                      output: mutable u8&, output_capacity: usize) -> i64 = rat_in_maze_impl
