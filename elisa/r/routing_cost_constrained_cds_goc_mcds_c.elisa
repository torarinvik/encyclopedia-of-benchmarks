// Clean-room bounded GOC-MCDS-C construction trace.
const MAX_N: usize = 8
const MAX_INPUT: usize = 17

def put64(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def routing_cost_constrained_cds_goc_mcds_c(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 @export("routing_cost_constrained_cds_goc_mcds_c"):
    if input.is_null() or length < 3 or length > MAX_INPUT or input[0] < 1 or input[0] > 8: return -1
    n: usize = input[0].usize()
    if length != 1 + 2 * n: return -1
    full: u64 = (1.u64() << n) - 1
    adjacency: mutable u64[MAX_N] = zeroed
    ids: mutable i64[MAX_N] = zeroed
    v: mutable usize = 0
    while v < n:
        mask: i64 = input[1 + v]
        ids[v] <- input[1 + n + v]
        if mask < 0 or mask.u64() > full or (mask.u64() & (1.u64() << v)) != 0 or ids[v] < 1 or ids[v] > 1000: return -1
        adjacency[v] <- mask.u64()
        u: mutable usize = 0
        while u < v:
            if ids[u] == ids[v]: return -1
            u <- u + 1
        v <- v + 1
    u <- 0
    while u < n:
        v <- 0
        while v < n:
            if ((adjacency[u] >> v) & 1) != ((adjacency[v] >> u) & 1): return -1
            v <- v + 1
        u <- u + 1
    reached: mutable u64 = 1
    while true:
        expanded: mutable u64 = reached
        v <- 0
        while v < n:
            if ((reached >> v) & 1) != 0: expanded <- expanded | adjacency[v]
            v <- v + 1
        if expanded == reached: break
        reached <- expanded
    if reached != full: return -1

    white: mutable u64 = full
    independent: mutable u64 = 0
    while white != 0:
        black: mutable u64 = 0
        v <- 0
        while v < n:
            if ((white >> v) & 1) != 0:
                lower: mutable bool = false
                u <- 0
                while u < n:
                    if ((white >> u) & 1) != 0 and ((adjacency[v] >> u) & 1) != 0 and ids[u] < ids[v]: lower <- true
                    u <- u + 1
                if not lower: black <- black | (1.u64() << v)
            v <- v + 1
        if black == 0: return -1
        independent <- independent | black
        removed: mutable u64 = black
        v <- 0
        while v < n:
            if ((black >> v) & 1) != 0: removed <- removed | adjacency[v]
            v <- v + 1
        white <- white & ~removed

    order: mutable usize[MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        order[i] <- i
        j: mutable usize = i
        while j > 0 and ids[order[j - 1]] > ids[order[j]]:
            temp: usize = order[j - 1]
            order[j - 1] <- order[j]
            order[j] <- temp
            j <- j - 1
        i <- i + 1
    connectors: mutable u64 = 0
    a: mutable usize = 0
    while a < n:
        source: usize = order[a]
        if ((independent >> source) & 1) != 0:
            b: mutable usize = a + 1
            while b < n:
                target: usize = order[b]
                if ((independent >> target) & 1) != 0:
                    parent: mutable i64[MAX_N] = zeroed
                    v <- 0
                    while v < n: parent[v] <- -2; v <- v + 1
                    queue: mutable usize[MAX_N] = zeroed
                    head: mutable usize = 0
                    tail: mutable usize = 1
                    parent[source] <- -1
                    queue[0] <- source
                    while head < tail and parent[target] == -2:
                        current: usize = queue[head]
                        head <- head + 1
                        j <- 0
                        while j < n:
                            next: usize = order[j]
                            if ((adjacency[current] >> next) & 1) != 0 and parent[next] == -2:
                                parent[next] <- current.i64()
                                queue[tail] <- next
                                tail <- tail + 1
                            j <- j + 1
                    if parent[target] == -2: return -1
                    path: mutable usize[MAX_N] = zeroed
                    path_length: mutable usize = 0
                    current: mutable usize = target
                    while current != source:
                        path[path_length] <- current
                        path_length <- path_length + 1
                        current <- parent[current].usize()
                    path[path_length] <- source
                    path_length <- path_length + 1
                    if path_length <= 4:
                        j <- 1
                        while j + 1 < path_length:
                            connectors <- connectors | (1.u64() << path[j])
                            j <- j + 1
                b <- b + 1
        a <- a + 1
    if output.is_null() or capacity < 16: return -2
    put64(independent.i64(), output&, 0)
    put64((independent | connectors).i64(), output&, 8)
    16
