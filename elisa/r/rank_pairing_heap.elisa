const MAX_OPERATIONS: usize = 64
const MAX_ITEMS: usize = 32
const MAX_NODES: usize = 64
const MAX_INPUT_LENGTH: usize = 194
const MAX_KEY: i64 = 1000000

def rank_pairing_node_rank(ranks: view[i64], node: i64) -> i64:
    if node < 0:
        return -1
    ranks[node.usize()]

def rank_pairing_minimum_root(keys: view[i64], items: view[i64],
        parents: view[i64], alive: view[bool], node_count: usize) -> i64:
    best: mutable i64 = -1
    node: mutable usize = 0
    while node < node_count:
        if alive[node] and parents[node] == -1:
            if best < 0:
                best <- node.i64()
            else:
                best_index: usize = best.usize()
                if keys[node] < keys[best_index] or (keys[node] == keys[best_index] and (items[node] < items[best_index] or (items[node] == items[best_index] and node < best_index))):
                    best <- node.i64()
        node <- node + 1
    best

def rank_pairing_consolidate(keys: mutable view[i64], items: mutable view[i64],
        ranks: mutable view[i64], left: mutable view[i64], right: mutable view[i64],
        parents: mutable view[i64], alive: mutable view[bool], node_count: usize) -> void:
    node: mutable usize = 0
    while true:
        duplicate_rank: mutable i64 = -1
        rank_value: mutable i64 = 0
        while rank_value < node_count.i64():
            roots_at_rank: mutable usize = 0
            node <- 0
            while node < node_count:
                if alive[node] and parents[node] == -1 and ranks[node] == rank_value:
                    roots_at_rank <- roots_at_rank + 1
                node <- node + 1
            if roots_at_rank >= 2:
                duplicate_rank <- rank_value
                break
            rank_value <- rank_value + 1
        if duplicate_rank < 0:
            return

        first: mutable usize = MAX_NODES
        second: mutable usize = MAX_NODES
        node <- 0
        while node < node_count:
            if alive[node] and parents[node] == -1 and ranks[node] == duplicate_rank:
                if first == MAX_NODES:
                    first <- node
                elif second == MAX_NODES:
                    second <- node
                    break
            node <- node + 1

        winner: mutable usize = first
        loser: mutable usize = second
        if keys[second] < keys[first] or (keys[second] == keys[first] and (items[second] < items[first] or (items[second] == items[first] and second < first))):
            winner <- second
            loser <- first
        old_left: i64 = left[winner]
        left[winner] <- loser.i64()
        parents[loser] <- winner.i64()
        right[loser] <- old_left
        if old_left >= 0:
            parents[old_left.usize()] <- loser.i64()
        ranks[winner] <- ranks[winner] + 1

def rank_pairing_heap_impl(values: i64&, values_length: usize) -> i64:
    if values_length < 1 or values_length > MAX_INPUT_LENGTH:
        return -1
    operation_value: i64 = values[0]
    if operation_value < 0 or operation_value > MAX_OPERATIONS.i64():
        return -1
    operation_count: usize = operation_value.usize()
    if values_length != 1 + 3 * operation_count or values_length > 193:
        return -1

    keys: mutable i64[MAX_NODES] = zeroed
    items: mutable i64[MAX_NODES] = zeroed
    ranks: mutable i64[MAX_NODES] = zeroed
    left: mutable i64[MAX_NODES] = zeroed
    right: mutable i64[MAX_NODES] = zeroed
    parents: mutable i64[MAX_NODES] = zeroed
    alive: mutable bool[MAX_NODES] = zeroed
    item_nodes: mutable i64[MAX_ITEMS] = zeroed
    active: mutable bool[MAX_ITEMS] = zeroed
    item_id: mutable usize = 0
    while item_id < MAX_ITEMS:
        item_nodes[item_id] <- -1
        item_id <- item_id + 1

    node_count: mutable usize = 0
    result: mutable i64 = 0
    operation_index: mutable usize = 0
    node: mutable usize = 0
    root_value: mutable i64 = -1
    root: mutable usize = 0
    while operation_index < operation_count:
        offset: usize = 1 + 3 * operation_index
        opcode: i64 = values[offset]
        item_value: i64 = values[offset + 1]
        value: i64 = values[offset + 2]

        if opcode == 1:
            if item_value < 0 or item_value >= MAX_ITEMS.i64() or value < 0 or value > MAX_KEY:
                return -1
            item_id <- item_value.usize()
            if active[item_id] or node_count >= MAX_NODES:
                return -1
            node <- node_count
            node_count <- node_count + 1
            keys[node] <- value
            items[node] <- item_value
            ranks[node] <- 0
            left[node] <- -1
            right[node] <- -1
            parents[node] <- -1
            alive[node] <- true
            item_nodes[item_id] <- node.i64()
            active[item_id] <- true
        elif opcode == 2:
            if item_value < 0 or item_value >= MAX_ITEMS.i64() or value < 0 or value > MAX_KEY:
                return -1
            item_id <- item_value.usize()
            if not active[item_id] or node_count >= MAX_NODES:
                return -1
            node <- item_nodes[item_id].usize()
            if value >= keys[node]:
                return -1
            keys[node] <- value
            if parents[node] >= 0:
                old_parent: usize = parents[node].usize()
                next_sibling: i64 = right[node]
                if left[old_parent] == node.i64():
                    left[old_parent] <- next_sibling
                else:
                    right[old_parent] <- next_sibling
                if next_sibling >= 0:
                    parents[next_sibling.usize()] <- old_parent.i64()
                parents[node] <- -1
                right[node] <- -1
                ranks[node] <- rank_pairing_node_rank(ranks[0:MAX_NODES], left[node]) + 1

                ancestor: mutable i64 = old_parent.i64()
                while ancestor >= 0:
                    ancestor_index: usize = ancestor.usize()
                    if parents[ancestor_index] < 0:
                        ranks[ancestor_index] <- rank_pairing_node_rank(ranks[0:MAX_NODES], left[ancestor_index]) + 1
                        break
                    left_rank: i64 = rank_pairing_node_rank(ranks[0:MAX_NODES], left[ancestor_index])
                    right_rank: i64 = rank_pairing_node_rank(ranks[0:MAX_NODES], right[ancestor_index])
                    new_rank:mutable  mutable i64 = 0
                    if left_rank != right_rank:
                        new_rank <- left_rank if left_rank > right_rank else right_rank
                    else:
                        new_rank <- left_rank + 1
                    if new_rank >= ranks[ancestor_index]:
                        break
                    ranks[ancestor_index] <- new_rank
                    ancestor <- parents[ancestor_index]
        elif opcode == 3:
            if item_value != 0 or value != 0:
                return -1
            root_value <- rank_pairing_minimum_root(keys[0:MAX_NODES], items[0:MAX_NODES], parents[0:MAX_NODES], alive[0:MAX_NODES], node_count)
            if root_value < 0:
                return -1
            root <- root_value.usize()
            item_id <- items[root].usize()
            result <- result + (operation_index + 1).i64() * (keys[root] + 1) + item_id.i64()
            active[item_id] <- false
            item_nodes[item_id] <- -1

            child: mutable i64 = left[root]
            while child >= 0:
                child_index: usize = child.usize()
                next_sibling: i64 = right[child_index]
                right[child_index] <- -1
                parents[child_index] <- -1
                ranks[child_index] <- rank_pairing_node_rank(ranks[0:MAX_NODES], left[child_index]) + 1
                child <- next_sibling
            alive[root] <- false
            parents[root] <- -2
            left[root] <- -1
            right[root] <- -1
            items[root] <- -1
            rank_pairing_consolidate(keys[0:MAX_NODES], items[0:MAX_NODES], ranks[0:MAX_NODES], left[0:MAX_NODES], right[0:MAX_NODES], parents[0:MAX_NODES], alive[0:MAX_NODES], node_count)
        elif opcode == 4:
            if item_value != 0 or value != 0:
                return -1
            root_value <- rank_pairing_minimum_root(keys[0:MAX_NODES], items[0:MAX_NODES], parents[0:MAX_NODES], alive[0:MAX_NODES], node_count)
            if root_value < 0:
                return -1
            root <- root_value.usize()
            result <- result + (operation_index + 1).i64() * (keys[root] + 1) + items[root]
        else:
            return -1
        operation_index <- operation_index + 1
    result

def rank_pairing_heap_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    rank_pairing_heap_impl(input, length)

export fn rank_pairing_heap(input: i64&, length: usize) -> i64 = rank_pairing_heap_entry
