def reversort_impl(values: mutable i64&, length: usize) -> void:
    index: mutable usize = 0
    while index + 1 < length:
        minimum: mutable usize = index
        probe: mutable usize = index + 1
        while probe < length:
            if values[probe] < values[minimum]:
                minimum <- probe
            probe <- probe + 1
        left: mutable usize = index
        right: mutable usize = minimum
        while left < right:
            temporary: i64 = values[left]
            values[left] <- values[right]
            values[right] <- temporary
            left <- left + 1
            right <- right - 1
        index <- index + 1

export fn reversort(values: mutable i64&, length: usize) -> void = reversort_impl
