def find_bound(values: view[i64], offset: usize, n: usize, key: i64, find_left: bool) -> i64:
    left: mutable i64 = 0
    right: mutable i64 = n.i64() - 1
    while left <= right:
        mid: i64 = left + (right - left) / 2
        index: usize = offset + mid.usize()
        if values[index] > key:
            right <- mid - 1
        elif values[index] < key:
            left <- mid + 1
        elif find_left:
            if mid == 0 or values[offset + (mid - 1).usize()] != key:
                return mid
            right <- mid - 1
        else:
            if mid.usize() == n - 1 or values[offset + (mid + 1).usize()] != key:
                return mid
            left <- mid + 1
    -1

def put_i32_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u32 = value.u32()
    for byte in 0..<4:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def range_in_sorted_array_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 2 or input[0] < 0 or input[0] > 512 or length != input[0].usize() + 2:
        return -1
    n: usize = input[0].usize()
    key: i64 = input[n + 1]
    if key < -2147483648 or key > 2147483647:
        return -1
    for i in 0..<n:
        if input[i + 1] < -2147483648 or input[i + 1] > 2147483647:
            return -1
        if i > 0 and input[i] > input[i + 1]:
            return -1
    input_view: view[i64] = input[0:length]
    first: i64 = find_bound(input_view, 1, n, key, true)
    last: i64 = find_bound(input_view, 1, n, key, false)
    if output == null or output_capacity < 8:
        return -2
    output_view: mutable view[u8] = output[0:output_capacity]
    put_i32_le(output_view, 0, first)
    put_i32_le(output_view, 4, last)
    8

export fn range_in_sorted_array(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = range_in_sorted_array_impl
