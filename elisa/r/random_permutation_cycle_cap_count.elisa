# Count label permutations whose disjoint cycles do not exceed the given cap.
def random_permutation_cycle_cap_count_impl(input: i64&, input_length: usize) -> i64:
    if input.is_null() or input_length != 2:
        return -1
    let n_value: i64 = input[0]
    let cap_value: i64 = input[1]
    if n_value < 1 or n_value > 20 or cap_value < 1 or cap_value > n_value:
        return -1
    let n = n_value.usize()
    let cap = cap_value.usize()

    var counts: mutable i64[21] = zeroed
    counts[0] <- 1
    for size in range(1, n + 1):
        var total: mutable i64 = 0
        var cycle_choices: mutable i64 = 1
        var limit: mutable usize = size
        if cap < limit:
            limit <- cap
        for cycle_length in range(1, limit + 1):
            if cycle_length > 1:
                cycle_choices <- cycle_choices * (size - cycle_length + 1).i64()
            remaining: usize = size - cycle_length
            total <- total + cycle_choices * counts[remaining]
        counts[size] <- total
    counts[n]

export fn random_permutation_cycle_cap_count(input: i64&, input_length: usize) -> i64 = random_permutation_cycle_cap_count_impl
