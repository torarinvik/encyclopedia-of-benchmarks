const MAX_OPS: usize = 128

def rb_left_rotate(x: usize, root: mutable usize&, left: mutable view[usize], right: mutable view[usize],
                   parent: mutable view[usize], red: mutable view[bool]) -> void:
    y: usize = right[x]
    right[x] <- left[y]
    if left[y] != 0: parent[left[y]] <- x
    parent[y] <- parent[x]
    if parent[x] == 0: root <- y
    elif x == left[parent[x]]: left[parent[x]] <- y
    else: right[parent[x]] <- y
    left[y] <- x
    parent[x] <- y

def rb_right_rotate(y: usize, root: mutable usize&, left: mutable view[usize], right: mutable view[usize],
                    parent: mutable view[usize], red: mutable view[bool]) -> void:
    x: usize = left[y]
    left[y] <- right[x]
    if right[x] != 0: parent[right[x]] <- y
    parent[x] <- parent[y]
    if parent[y] == 0: root <- x
    elif y == right[parent[y]]: right[parent[y]] <- x
    else: left[parent[y]] <- x
    right[x] <- y
    parent[y] <- x

def rb_find(root_value: usize, key: i64, keys: view[i64], left: view[usize], right: view[usize]) -> usize:
    cursor: mutable usize = root_value
    while cursor != 0 and keys[cursor] != key:
        if key < keys[cursor]: cursor <- left[cursor]
        else: cursor <- right[cursor]
    cursor

def rb_insert(z_value: usize, root: mutable usize&, keys: view[i64], left: mutable view[usize], right: mutable view[usize],
              parent: mutable view[usize], red: mutable view[bool]) -> void:
    z: mutable usize = z_value
    y: mutable usize = 0
    x: mutable usize = root
    while x != 0:
        y <- x
        if keys[z] < keys[x]: x <- left[x]
        else: x <- right[x]
    parent[z] <- y
    if y == 0: root <- z
    elif keys[z] < keys[y]: left[y] <- z
    else: right[y] <- z
    left[z] <- 0
    right[z] <- 0
    red[z] <- true
    while red[parent[z]]:
        p: usize = parent[z]
        g: usize = parent[p]
        if p == left[g]:
            y <- right[g]
            if red[y]:
                red[p] <- false
                red[y] <- false
                red[g] <- true
                z <- g
            else:
                if z == right[p]:
                    z <- p
                    rb_left_rotate(z, root, left, right, parent, red)
                p <- parent[z]
                g <- parent[p]
                red[p] <- false
                red[g] <- true
                rb_right_rotate(g, root, left, right, parent, red)
        else:
            y <- left[g]
            if red[y]:
                red[p] <- false
                red[y] <- false
                red[g] <- true
                z <- g
            else:
                if z == left[p]:
                    z <- p
                    rb_right_rotate(z, root, left, right, parent, red)
                p <- parent[z]
                g <- parent[p]
                red[p] <- false
                red[g] <- true
                rb_left_rotate(g, root, left, right, parent, red)
    red[root] <- false

def rb_minimum(start: usize, left: view[usize]) -> usize:
    cursor: mutable usize = start
    while left[cursor] != 0: cursor <- left[cursor]
    cursor

def rb_transplant(u: usize, v: usize, root: mutable usize&, left: mutable view[usize],
                  right: mutable view[usize], parent: mutable view[usize]) -> void:
    if parent[u] == 0: root <- v
    elif u == left[parent[u]]: left[parent[u]] <- v
    else: right[parent[u]] <- v
    parent[v] <- parent[u]

def rb_delete_fix(start: usize, root: mutable usize&, left: mutable view[usize], right: mutable view[usize],
                  parent: mutable view[usize], red: mutable view[bool]) -> void:
    x: mutable usize = start
    while x != root and not red[x]:
        p: usize = parent[x]
        if x == left[p]:
            w: mutable usize = right[p]
            if red[w]:
                red[w] <- false
                red[p] <- true
                rb_left_rotate(p, root, left, right, parent, red)
                w <- right[parent[x]]
            if not red[left[w]] and not red[right[w]]:
                red[w] <- true
                x <- parent[x]
            else:
                if not red[right[w]]:
                    red[left[w]] <- false
                    red[w] <- true
                    rb_right_rotate(w, root, left, right, parent, red)
                    w <- right[parent[x]]
                p <- parent[x]
                red[w] <- red[p]
                red[p] <- false
                red[right[w]] <- false
                rb_left_rotate(p, root, left, right, parent, red)
                x <- root
        else:
            w <- left[p]
            if red[w]:
                red[w] <- false
                red[p] <- true
                rb_right_rotate(p, root, left, right, parent, red)
                w <- left[parent[x]]
            if not red[right[w]] and not red[left[w]]:
                red[w] <- true
                x <- parent[x]
            else:
                if not red[left[w]]:
                    red[right[w]] <- false
                    red[w] <- true
                    rb_left_rotate(w, root, left, right, parent, red)
                    w <- left[parent[x]]
                p <- parent[x]
                red[w] <- red[p]
                red[p] <- false
                red[left[w]] <- false
                rb_right_rotate(p, root, left, right, parent, red)
                x <- root
    red[x] <- false

def rb_delete(z: usize, root: mutable usize&, left: mutable view[usize], right: mutable view[usize],
              parent: mutable view[usize], red: mutable view[bool]) -> void:
    y: mutable usize = z
    x: mutable usize = 0
    was_red: mutable bool = red[y]
    if left[z] == 0:
        x <- right[z]
        rb_transplant(z, right[z], root, left, right, parent)
    elif right[z] == 0:
        x <- left[z]
        rb_transplant(z, left[z], root, left, right, parent)
    else:
        y <- rb_minimum(right[z], left)
        was_red <- red[y]
        x <- right[y]
        if parent[y] == z: parent[x] <- y
        else:
            rb_transplant(y, right[y], root, left, right, parent)
            right[y] <- right[z]
            parent[right[y]] <- y
        rb_transplant(z, y, root, left, right, parent)
        left[y] <- left[z]
        parent[left[y]] <- y
        red[y] <- red[z]
    if not was_red: rb_delete_fix(x, root, left, right, parent, red)

def rb_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def red_black_tree_unique_key_ops_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1: return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > 128 or length != (1 + 2 * count_value).usize(): return -1
    count: usize = count_value.usize()
    active: mutable i64[MAX_OPS] = zeroed
    active_count: mutable usize = 0
    search_count: mutable usize = 0
    for i in 0..<count:
        op: i64 = input[1 + 2 * i]
        key: i64 = input[2 + 2 * i]
        if op < 0 or op > 2 or key < -2147483648 or key > 2147483647: return -1
        found: mutable usize = active_count
        for j in 0..<active_count:
            if active[j] == key: found <- j; break
        if op == 0:
            if found != active_count or active_count >= MAX_OPS: return -1
            active[active_count] <- key
            active_count <- active_count + 1
        elif op == 1: search_count <- search_count + 1
        else:
            if found == active_count: return -1
            for j in found + 1..<active_count: active[j - 1] <- active[j]
            active_count <- active_count - 1
    keys: mutable i64[MAX_OPS + 1] = zeroed
    left: mutable usize[MAX_OPS + 1] = zeroed
    right: mutable usize[MAX_OPS + 1] = zeroed
    parent: mutable usize[MAX_OPS + 1] = zeroed
    red: mutable bool[MAX_OPS + 1] = zeroed
    keys_view: mutable view[i64] = keys[0:MAX_OPS + 1]
    left_view: mutable view[usize] = left[0:MAX_OPS + 1]
    right_view: mutable view[usize] = right[0:MAX_OPS + 1]
    parent_view: mutable view[usize] = parent[0:MAX_OPS + 1]
    red_view: mutable view[bool] = red[0:MAX_OPS + 1]
    root: mutable usize = 0
    next: mutable usize = 1
    results: mutable i64[MAX_OPS] = zeroed
    result_count: mutable usize = 0
    for i in 0..<count:
        op: i64 = input[1 + 2 * i]
        key: i64 = input[2 + 2 * i]
        if op == 0:
            keys[next] <- key
            rb_insert(next, root, keys_view, left_view, right_view, parent_view, red_view)
            next <- next + 1
        elif op == 1:
            if rb_find(root, key, keys_view, left_view, right_view) != 0: results[result_count] <- 1
            else: results[result_count] <- 0
            result_count <- result_count + 1
        else: rb_delete(rb_find(root, key, keys_view, left_view, right_view), root, left_view, right_view, parent_view, red_view)
    required: usize = (2 + active_count + search_count) * 8
    if output.is_null() or capacity < required: return -2
    output_view: mutable view[u8] = output[0:required]
    rb_put_i64(output_view, 0, active_count.i64())
    stack: mutable usize[MAX_OPS] = zeroed
    top: mutable usize = 0
    current: mutable usize = root
    out: mutable usize = 1
    while current != 0 or top > 0:
        while current != 0:
            stack[top] <- current
            top <- top + 1
            current <- left[current]
        top <- top - 1
        current <- stack[top]
        rb_put_i64(output_view, out * 8, keys[current])
        out <- out + 1
        current <- right[current]
    rb_put_i64(output_view, out * 8, search_count.i64())
    out <- out + 1
    for i in 0..<search_count:
        rb_put_i64(output_view, out * 8, results[i])
        out <- out + 1
    required.i64()

export fn red_black_tree_unique_key_ops(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = red_black_tree_unique_key_ops_impl
