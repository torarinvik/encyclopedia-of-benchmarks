def reverse_letters_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or input[0] < 0 or input[0] > 256:
        return -1
    byte_length: usize = input[0].usize()
    if length != byte_length + 1:
        return -1
    index: usize = 0
    while index < byte_length:
        value: i64 = input[index + 1]
        if value == 32:
            if index == 0 or index + 1 == byte_length or input[index] == 32:
                return -1
        elif value < 33 or value > 126:
            return -1
        index <- index + 1
    if output_capacity < byte_length + 1:
        return -2
    start: usize = 0
    while start < byte_length:
        end: usize = start
        while end < byte_length and input[end + 1] != 32:
            end <- end + 1
        index <- 0
        while index < end - start + 1:
            output[start + index] <- input[end - index + 1].u8()
            index <- index + 1
        if end < byte_length:
            output[end] <- 32
        start <- end + 1
    output[byte_length] <- 0
    byte_length.i64()

export fn reverse_letters(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = reverse_letters_impl
