const MAX_KEY_LENGTH: usize = 256
const MAX_PLAINTEXT_LENGTH: usize = 256
const MAX_INPUT_VALUES: usize = 515

def rc4_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_VALUES: return -1
    key_length_value: i64 = input[0]
    plaintext_length_value: i64 = input[1]
    if key_length_value < 1 or key_length_value > 256: return -1
    if plaintext_length_value < 0 or plaintext_length_value > 256: return -1
    key_length: usize = key_length_value.usize()
    plaintext_length: usize = plaintext_length_value.usize()
    if length != 2 + key_length + plaintext_length: return -1
    index: mutable usize = 0
    while index < key_length + plaintext_length:
        byte: i64 = input[2 + index]
        if byte < 0 or byte > 255: return -1
        index <- index + 1
    if plaintext_length == 0: return 0
    if output.is_null() or capacity < plaintext_length: return -2

    state: mutable i64[256] = zeroed
    index <- 0
    while index < 256:
        state[index] <- index.i64()
        index <- index + 1
    j: mutable usize = 0
    index <- 0
    while index < 256:
        j <- (j + state[index].usize() + input[2 + (index % key_length)].usize()) % 256
        temporary: i64 = state[index]
        state[index] <- state[j]
        state[j] <- temporary
        index <- index + 1

    i: mutable usize = 0
    j <- 0
    offset: mutable usize = 0
    while offset < plaintext_length:
        i <- (i + 1) % 256
        j <- (j + state[i].usize()) % 256
        temporary: i64 = state[i]
        state[i] <- state[j]
        state[j] <- temporary
        stream_index: usize = (state[i].usize() + state[j].usize()) % 256
        cipher_byte: u8 = (input[2 + key_length + offset] ^ state[stream_index]).u8()
        output[offset] <- cipher_byte
        offset <- offset + 1
    plaintext_length.i64()

export fn rc4(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = rc4_impl
