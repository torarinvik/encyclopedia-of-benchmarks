def rgb_hsl_conversion_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length != 3:
        return -1
    index: usize = 0
    while index < 3:
        if input[index] < 0 or input[index] > 255:
            return -1
        index <- index + 1
    if output.is_null() or capacity < 4:
        return -2

    red: f64 = input[0].f64() / 255.0
    green: f64 = input[1].f64() / 255.0
    blue: f64 = input[2].f64() / 255.0
    minimum: mutable f64 = red
    maximum: mutable f64 = red
    if green < minimum:
        minimum <- green
    if blue < minimum:
        minimum <- blue
    if green > maximum:
        maximum <- green
    if blue > maximum:
        maximum <- blue
    channel: mutable i64 = 0
    if maximum == green:
        channel <- 1
    else if maximum == blue:
        channel <- 2
    luminance: f64 = (minimum + maximum) / 2.0
    saturation: mutable f64 = 0.0
    if minimum != maximum:
        if luminance <= 0.5:
            saturation <- (maximum - minimum) / (maximum + minimum)
        else:
            saturation <- (maximum - minimum) / (2.0 - maximum - minimum)
    hue: mutable f64 = 0.0
    if saturation != 0.0:
        if channel == 0:
            hue <- (green - blue) / (maximum - minimum)
        else if channel == 1:
            hue <- 2.0 + (blue - red) / (maximum - minimum)
        else:
            hue <- 4.0 + (red - green) / (maximum - minimum)
    hue <- hue * 60.0
    if hue < 0.0:
        hue <- hue + 360.0
    h: i64 = (hue + 0.5).i64()
    s: i64 = (saturation * 100.0 + 0.5).i64()
    l: i64 = (luminance * 100.0 + 0.5).i64()
    output[0] <- (h & 255).u8()
    output[1] <- (h >> 8).u8()
    output[2] <- s.u8()
    output[3] <- l.u8()
    4

export fn rgb_hsl_conversion(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = rgb_hsl_conversion_impl
