const MAX_N: usize = 128
const MAX_INPUT_LENGTH: usize = 129

def reverse_a_linked_list_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null || length < 1 || length > MAX_INPUT_LENGTH: return -1
    n_value: i64 = input[0]
    if n_value < 0 || n_value > MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != n + 1: return -1
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < -2147483648 || input[i + 1] > 2147483647: return -1
        i <- i + 1
    output_bytes: usize = 4 * n
    if output == null || capacity < output_bytes: return -2

    nodes: mutable i64[128] = zeroed
    next: mutable i64[128] = zeroed
    head: mutable i64 = -1
    i <- 0
    while i < n:
        nodes[i] <- input[i + 1]
        next[i] <- -1
        if head < 0: head <- i.i64()
        else:
            tail: mutable i64 = head
            while next[tail.usize()] >= 0: tail <- next[tail.usize()]
            next[tail.usize()] <- i.i64()
        i <- i + 1

    previous: mutable i64 = -1
    current: mutable i64 = head
    while current >= 0:
        next_node: i64 = next[current.usize()]
        next[current.usize()] <- previous
        previous <- current
        current <- next_node
    head <- previous
    index: mutable usize = 0
    while index < n:
        node: mutable i64 = head
        step: mutable usize = 0
        while step < index:
            node <- next[node.usize()]
            step <- step + 1
        bits: mutable u32 = nodes[node.usize()].u32()
        byte: mutable usize = 0
        while byte < 4:
            output[index * 4 + byte] <- (bits & 255).u8()
            bits <- bits >> 8
            byte <- byte + 1
        index <- index + 1
    output_bytes.i64()

export fn reverse_a_linked_list(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = reverse_a_linked_list_impl
