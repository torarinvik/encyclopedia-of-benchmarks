const MAX_N: usize = 32
const MAX_Q: usize = 32
const MAX_RECTANGLES: usize = MAX_N + MAX_Q
const MAX_COORDS: usize = 2 * MAX_RECTANGLES
const MAX_CORNERS: usize = 4 * MAX_RECTANGLES
const MAX_PARSEABLE_INPUT: usize = 2 + 5 * MAX_N + 6 * MAX_Q + 1
const MAX_COORD: i64 = 1000000
const MAX_WEIGHT: i64 = 1000000

def rectangle_add_point_get_lowbit(value: usize) -> usize:
    value & (!value + 1)

def rectangle_add_point_get_lower_i64(values: view[i64], count: usize, target: i64) -> usize:
    left: mutable usize = 0
    right: mutable usize = count
    while left < right:
        middle: usize = left + (right - left) / 2
        if values[middle] < target:
            left <- middle + 1
        else:
            right <- middle
    left

def rectangle_add_point_get_upper_i64(values: view[i64], count: usize, target: i64) -> usize:
    left: mutable usize = 0
    right: mutable usize = count
    while left < right:
        middle: usize = left + (right - left) / 2
        if values[middle] <= target:
            left <- middle + 1
        else:
            right <- middle
    left

def rectangle_add_point_get_lower_usize(values: view[usize], count: usize, target: usize) -> usize:
    left: mutable usize = 0
    right: mutable usize = count
    while left < right:
        middle: usize = left + (right - left) / 2
        if values[middle] < target:
            left <- middle + 1
        else:
            right <- middle
    left

def rectangle_add_point_get_sort_unique(values: mutable view[i64], count: usize) -> usize:
    for index in 1..<count:
        value: i64 = values[index]
        position: mutable usize = index
        while position > 0 and values[position - 1] > value:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- value
    unique_count: mutable usize = 0
    for index in 0..<count:
        if unique_count == 0 or values[index] != values[unique_count - 1]:
            values[unique_count] <- values[index]
            unique_count <- unique_count + 1
    unique_count

def rectangle_add_point_get_register_event(xs: view[i64], x_count: usize,
    ys: view[i64], y_count: usize, present: mutable view[bool], x: i64, y: i64) -> void:
    outer: mutable usize = rectangle_add_point_get_lower_i64(xs, x_count, x) + 1
    rank: usize = rectangle_add_point_get_lower_i64(ys, y_count, y)
    while outer <= x_count:
        present[outer * MAX_COORDS + rank] <- True
        outer <- outer + rectangle_add_point_get_lowbit(outer)

def rectangle_add_point_get_register_rectangle(xs: view[i64], x_count: usize,
    ys: view[i64], y_count: usize, present: mutable view[bool],
    left: i64, down: i64, right: i64, up: i64) -> void:
    rectangle_add_point_get_register_event(xs, x_count, ys, y_count, present, left, down)
    rectangle_add_point_get_register_event(xs, x_count, ys, y_count, present, right, down)
    rectangle_add_point_get_register_event(xs, x_count, ys, y_count, present, left, up)
    rectangle_add_point_get_register_event(xs, x_count, ys, y_count, present, right, up)

def rectangle_add_point_get_fenwick_add(tree: mutable view[i64], y_values: view[usize],
    y_counts: view[usize], xs: view[i64], x_count: usize, ys: view[i64], y_count: usize,
    x: i64, y: i64, weight: i64) -> void:
    outer: mutable usize = rectangle_add_point_get_lower_i64(xs, x_count, x) + 1
    y_rank: usize = rectangle_add_point_get_lower_i64(ys, y_count, y)
    while outer <= x_count:
        row: usize = outer * MAX_COORDS
        inner: mutable usize = rectangle_add_point_get_lower_usize(
            y_values[row:row + y_counts[outer]], y_counts[outer], y_rank) + 1
        while inner <= y_counts[outer]:
            tree[outer * (MAX_COORDS + 1) + inner] <-
                tree[outer * (MAX_COORDS + 1) + inner] + weight
            inner <- inner + rectangle_add_point_get_lowbit(inner)
        outer <- outer + rectangle_add_point_get_lowbit(outer)

def rectangle_add_point_get_apply_rectangle(tree: mutable view[i64], y_values: view[usize],
    y_counts: view[usize], xs: view[i64], x_count: usize, ys: view[i64], y_count: usize,
    left: i64, down: i64, right: i64, up: i64, weight: i64) -> void:
    rectangle_add_point_get_fenwick_add(tree, y_values, y_counts, xs, x_count, ys, y_count,
        left, down, weight)
    rectangle_add_point_get_fenwick_add(tree, y_values, y_counts, xs, x_count, ys, y_count,
        right, down, -weight)
    rectangle_add_point_get_fenwick_add(tree, y_values, y_counts, xs, x_count, ys, y_count,
        left, up, -weight)
    rectangle_add_point_get_fenwick_add(tree, y_values, y_counts, xs, x_count, ys, y_count,
        right, up, weight)

def rectangle_add_point_get_prefix(tree: view[i64], y_values: view[usize],
    y_counts: view[usize], xs: view[i64], x_count: usize, ys: view[i64], y_count: usize,
    x_limit: i64, y_limit: i64) -> i64:
    outer: mutable usize = rectangle_add_point_get_upper_i64(xs, x_count, x_limit)
    y_limit_rank: usize = rectangle_add_point_get_upper_i64(ys, y_count, y_limit)
    total: mutable i64 = 0
    while outer > 0:
        row: usize = outer * MAX_COORDS
        inner: mutable usize = rectangle_add_point_get_lower_usize(
            y_values[row:row + y_counts[outer]], y_counts[outer], y_limit_rank)
        while inner > 0:
            total <- total + tree[outer * (MAX_COORDS + 1) + inner]
            inner <- inner - rectangle_add_point_get_lowbit(inner)
        outer <- outer - rectangle_add_point_get_lowbit(outer)
    total

def rectangle_add_point_get_put(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def rectangle_add_point_get_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_PARSEABLE_INPUT:
        return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    if n_value < 1 or n_value > MAX_N or q_value < 1 or q_value > MAX_Q:
        return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    initial: mutable i64[5 * MAX_N] = zeroed
    operations: mutable i64[6 * MAX_Q] = zeroed
    all_x: mutable i64[MAX_CORNERS] = zeroed
    all_y: mutable i64[MAX_CORNERS] = zeroed
    rectangle_count: mutable usize = 0
    cursor: mutable usize = 2
    for index in 0..<n:
        if cursor + 5 > length:
            return -1
        left: i64 = input[cursor]
        down: i64 = input[cursor + 1]
        right: i64 = input[cursor + 2]
        up: i64 = input[cursor + 3]
        weight: i64 = input[cursor + 4]
        cursor <- cursor + 5
        if left < 0 or left >= right or right > MAX_COORD or down < 0 or down >= up or up > MAX_COORD or weight < 0 or weight > MAX_WEIGHT:
            return -1
        initial[5 * index] <- left
        initial[5 * index + 1] <- down
        initial[5 * index + 2] <- right
        initial[5 * index + 3] <- up
        initial[5 * index + 4] <- weight
        all_x[4 * rectangle_count] <- left
        all_y[4 * rectangle_count] <- down
        all_x[4 * rectangle_count + 1] <- right
        all_y[4 * rectangle_count + 1] <- down
        all_x[4 * rectangle_count + 2] <- left
        all_y[4 * rectangle_count + 2] <- up
        all_x[4 * rectangle_count + 3] <- right
        all_y[4 * rectangle_count + 3] <- up
        rectangle_count <- rectangle_count + 1

    for index in 0..<q:
        if cursor >= length:
            return -1
        kind: i64 = input[cursor]
        cursor <- cursor + 1
        operation_offset: usize = 6 * index
        operations[operation_offset] <- kind
        if kind == 0:
            if cursor + 5 > length:
                return -1
            left: i64 = input[cursor]
            down: i64 = input[cursor + 1]
            right: i64 = input[cursor + 2]
            up: i64 = input[cursor + 3]
            weight: i64 = input[cursor + 4]
            cursor <- cursor + 5
            if left < 0 or left >= right or right > MAX_COORD or down < 0 or down >= up or up > MAX_COORD or weight < 0 or weight > MAX_WEIGHT:
                return -1
            operations[operation_offset + 1] <- left
            operations[operation_offset + 2] <- down
            operations[operation_offset + 3] <- right
            operations[operation_offset + 4] <- up
            operations[operation_offset + 5] <- weight
            all_x[4 * rectangle_count] <- left
            all_y[4 * rectangle_count] <- down
            all_x[4 * rectangle_count + 1] <- right
            all_y[4 * rectangle_count + 1] <- down
            all_x[4 * rectangle_count + 2] <- left
            all_y[4 * rectangle_count + 2] <- up
            all_x[4 * rectangle_count + 3] <- right
            all_y[4 * rectangle_count + 3] <- up
            rectangle_count <- rectangle_count + 1
        else if kind == 1:
            if cursor + 2 > length:
                return -1
            x: i64 = input[cursor]
            y: i64 = input[cursor + 1]
            cursor <- cursor + 2
            if x < 0 or x > MAX_COORD or y < 0 or y > MAX_COORD:
                return -1
            operations[operation_offset + 1] <- x
            operations[operation_offset + 2] <- y
        else:
            return -1
    if cursor != length:
        return -1

    xs: mutable view[i64] = all_x[0:MAX_CORNERS]
    ys: mutable view[i64] = all_y[0:MAX_CORNERS]
    corner_count: usize = rectangle_count * 4
    x_count: usize = rectangle_add_point_get_sort_unique(xs, corner_count)
    y_count: usize = rectangle_add_point_get_sort_unique(ys, corner_count)
    present: mutable bool[(MAX_COORDS + 1) * MAX_COORDS] = zeroed
    for index in 0..<n:
        offset: usize = 5 * index
        rectangle_add_point_get_register_rectangle(all_x[0:MAX_CORNERS], x_count,
            all_y[0:MAX_CORNERS], y_count, present[0:(MAX_COORDS + 1) * MAX_COORDS],
            initial[offset], initial[offset + 1], initial[offset + 2], initial[offset + 3])
    for index in 0..<q:
        offset: usize = 6 * index
        if operations[offset] == 0:
            rectangle_add_point_get_register_rectangle(all_x[0:MAX_CORNERS], x_count,
                all_y[0:MAX_CORNERS], y_count, present[0:(MAX_COORDS + 1) * MAX_COORDS],
                operations[offset + 1], operations[offset + 2], operations[offset + 3], operations[offset + 4])

    y_values: mutable usize[(MAX_COORDS + 1) * MAX_COORDS] = zeroed
    y_counts: mutable usize[MAX_COORDS + 1] = zeroed
    for outer in 1..<(x_count + 1):
        for rank in 0..<y_count:
            if present[outer * MAX_COORDS + rank]:
                y_values[outer * MAX_COORDS + y_counts[outer]] <- rank
                y_counts[outer] <- y_counts[outer] + 1
    tree: mutable i64[(MAX_COORDS + 1) * (MAX_COORDS + 1)] = zeroed
    tree_view: mutable view[i64] = tree[0:(MAX_COORDS + 1) * (MAX_COORDS + 1)]
    y_values_view: view[usize] = y_values[0:(MAX_COORDS + 1) * MAX_COORDS]
    y_counts_view: view[usize] = y_counts[0:MAX_COORDS + 1]
    for index in 0..<n:
        offset: usize = 5 * index
        rectangle_add_point_get_apply_rectangle(tree_view, y_values_view, y_counts_view,
            all_x[0:MAX_CORNERS], x_count, all_y[0:MAX_CORNERS], y_count,
            initial[offset], initial[offset + 1], initial[offset + 2], initial[offset + 3], initial[offset + 4])

    answers: mutable i64[MAX_Q] = zeroed
    answer_count: mutable usize = 0
    for index in 0..<q:
        offset: usize = 6 * index
        if operations[offset] == 0:
            rectangle_add_point_get_apply_rectangle(tree_view, y_values_view, y_counts_view,
                all_x[0:MAX_CORNERS], x_count, all_y[0:MAX_CORNERS], y_count,
                operations[offset + 1], operations[offset + 2], operations[offset + 3],
                operations[offset + 4], operations[offset + 5])
        else:
            answers[answer_count] <- rectangle_add_point_get_prefix(tree_view,
                y_values_view, y_counts_view, all_x[0:MAX_CORNERS], x_count,
                all_y[0:MAX_CORNERS], y_count, operations[offset + 1], operations[offset + 2])
            answer_count <- answer_count + 1

    output_bytes: usize = 8 * answer_count
    if output_bytes > 0 and (output.is_null() or capacity < output_bytes):
        return -2
    for index in 0..<answer_count:
        rectangle_add_point_get_put(output[0:capacity], index * 8, answers[index])
    output_bytes.i64()

export fn rectangle_add_point_get(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = rectangle_add_point_get_impl
