def cdc_reduce(value: u32) -> u16:
    remainder: mutable u32 = value
    step: mutable usize = 0
    while step < 16:
        bit: usize = 31 - step
        if (remainder & (1.u32() << bit)) != 0:
            remainder <- remainder ^ (0x1100b.u32() << (bit - 16))
        step <- step + 1
    remainder.u16()

def rabin_content_defined_chunking_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 65: return -1
    values: view[i64] = input[0:length]
    if values[0] < 0 or values[0] > 64: return -1
    n: usize = values[0].usize()
    if length != n + 1: return -1
    for i in 0..<n:
        if values[i + 1] < 0 or values[i + 1] > 255: return -1
    outgoing: mutable u16[256] = zeroed
    for i in 0..<256: outgoing[i] <- cdc_reduce(i.u32() << 24)
    fingerprint: mutable u16 = 0
    boundaries: mutable u8[64] = zeroed
    count: mutable usize = 0
    for i in 0..<n:
        fingerprint <- cdc_reduce((fingerprint.u32() << 8) | values[i + 1].u32())
        if i >= 4: fingerprint <- fingerprint ^ outgoing[values[i - 3].usize()]
        if (fingerprint & 7) == 0:
            boundaries[count] <- (i + 1).u8()
            count <- count + 1
    if n > 0:
        append_final: mutable bool = count == 0
        if count > 0: append_final <- boundaries[count - 1].usize() != n
        if append_final:
            boundaries[count] <- n.u8()
            count <- count + 1
    if output.is_null() or capacity < count: return -2
    out: mutable view[u8] = output[0:count]
    for i in 0..<count: out[i] <- boundaries[i]
    count.i64()

export fn rabin_content_defined_chunking(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = rabin_content_defined_chunking_impl
