const MAX_BITS: usize = 63
const MAX_BLOCKS: usize = 8
const MAX_QUERIES: usize = 16
const MAX_INPUT: usize = 35
const MAX_OUTPUT_BYTES: usize = 128

def store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def rank_select_bitstring_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_INPUT: return -1
    n_value: i64 = input[0]
    packed_value: i64 = input[1]
    query_value: i64 = input[2]
    if n_value < 1 or n_value > MAX_BITS or packed_value < 0 or query_value < 0 or query_value > MAX_QUERIES: return -1
    n: usize = n_value.usize()
    queries: usize = query_value.usize()
    bits: u64 = packed_value.u64()
    if (bits >> n) != 0 or length != 3 + 2 * queries: return -1
    block_count: usize = (n + 7) / 8
    prefix: mutable i64[MAX_BLOCKS + 1] = zeroed
    block: mutable usize = 0
    while block < block_count:
        prefix[block + 1] <- prefix[block]
        end: usize = if 8 * block + 8 < n then 8 * block + 8 else n
        pos: mutable usize = 8 * block
        while pos < end:
            prefix[block + 1] <- prefix[block + 1] + ((bits >> pos) & 1).i64()
            pos <- pos + 1
        block <- block + 1
    answers: mutable i64[MAX_QUERIES] = zeroed
    query: mutable usize = 0
    while query < queries:
        op: i64 = input[3 + 2 * query]
        index_value: i64 = input[4 + 2 * query]
        if (op != 0 and op != 1) or index_value < 1 or (op == 0 and index_value > n_value) or (op == 1 and index_value > MAX_BITS + 1): return -1
        index: usize = index_value.usize()
        if op == 0:
            full_blocks: usize = index / 8
            remainder: usize = index % 8
            answer: mutable i64 = prefix[full_blocks]
            pos <- 8 * full_blocks
            while pos < 8 * full_blocks + remainder:
                answer <- answer + ((bits >> pos) & 1).i64()
                pos <- pos + 1
            answers[query] <- answer
        else:
            block <- 0
            while block < block_count and prefix[block + 1] < index.i64(): block <- block + 1
            answers[query] <- -1
            if block < block_count:
                remaining: mutable usize = index - prefix[block].usize()
                end: usize = if 8 * block + 8 < n then 8 * block + 8 else n
                pos <- 8 * block
                while pos < end:
                    if ((bits >> pos) & 1) != 0:
                        remaining <- remaining - 1
                        if remaining == 0:
                            answers[query] <- (pos + 1).i64()
                            break
                    pos <- pos + 1
        query <- query + 1
    output_bytes: usize = 8 * queries
    if output.is_null() or capacity < output_bytes: return -2
    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    staged_view: mutable view[u8] = staged[0:MAX_OUTPUT_BYTES]
    query <- 0
    while query < queries:
        store_i64_le(answers[query], staged_view, 8 * query)
        query <- query + 1
    byte: mutable usize = 0
    while byte < output_bytes:
        output[byte] <- staged[byte]
        byte <- byte + 1
    output_bytes.i64()

export fn rank_select_bitstring(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = rank_select_bitstring_impl
