const MAX_DEGREE: i64 = 4
const MAX_PARSEABLE_INPUT_LENGTH: usize = 7

def routh_hurwitz_stability_predicate_impl(input: view[i64]) -> i64:
    if input.len() < 1 or input.len() > MAX_PARSEABLE_INPUT_LENGTH: return -1
    let degree: i64 = input[0]
    if degree < 1 or degree > MAX_DEGREE or input.len() != degree.usize() + 2: return -1

    let coefficients: mutable i64[5] = zeroed
    let mut index: usize = 0
    while index <= degree.usize():
        let value: i64 = input[index + 1]
        if value < -3 or value > 3 or (index == 0 and value <= 0): return -1
        coefficients[index] <- value
        index <- index + 1

    let width: usize = (degree.usize() + 2) / 2
    let table: mutable i64[15] = zeroed
    let mut column: usize = 0
    while column < width:
        let even_index: usize = 2 * column
        let odd_index: usize = even_index + 1
        if even_index <= degree.usize(): table[column] <- coefficients[even_index]
        if odd_index <= degree.usize(): table[3 + column] <- coefficients[odd_index]
        column <- column + 1

    let row_one_zero: mutable bool = true
    column <- 0
    while column < width:
        if table[3 + column] != 0: row_one_zero <- false
        column <- column + 1
    if row_one_zero or table[3] <= 0: return 0

    let mut row: usize = 2
    while row <= degree.usize():
        if table[3 * (row - 1)] <= 0: return 0
        let all_zero: mutable bool = true
        column <- 0
        while column < width:
            let upper_next: i64 = if column + 1 < width then table[3 * (row - 2) + column + 1] else 0
            let lower_next: i64 = if column + 1 < width then table[3 * (row - 1) + column + 1] else 0
            table[3 * row + column] <- table[3 * (row - 1)] * upper_next - table[3 * (row - 2)] * lower_next
            if table[3 * row + column] != 0: all_zero <- false
            column <- column + 1
        if all_zero or table[3 * row] <= 0: return 0
        row <- row + 1
    1

export fn routh_hurwitz_stability_predicate(input: i64&, input_length: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    routh_hurwitz_stability_predicate_impl(input[0:input_length])
