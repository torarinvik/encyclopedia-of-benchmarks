# Direct recursive full-string matching for the . and * regular-expression subset.
def regex_match_recursive(values: i64&, text_length: usize, pattern_start: usize, pattern_length: usize, text_index: usize, pattern_index: usize) -> bool:
    if pattern_index == pattern_length:
        return text_index == text_length
    atom: i64 = values[pattern_start + pattern_index]
    if pattern_index + 1 < pattern_length and values[pattern_start + pattern_index + 1] == 42:
        if regex_match_recursive(values, text_length, pattern_start, pattern_length, text_index, pattern_index + 2):
            return true
        if text_index < text_length and (atom == 46 or atom == values[2 + text_index]):
            return regex_match_recursive(values, text_length, pattern_start, pattern_length, text_index + 1, pattern_index)
        return false
    if text_index < text_length and (atom == 46 or atom == values[2 + text_index]):
        return regex_match_recursive(values, text_length, pattern_start, pattern_length, text_index + 1, pattern_index + 1)
    return false

def regex_match_impl(values: i64&, length: usize) -> i64:
    if length < 2:
        return -1
    text_length_value: i64 = values[0]
    pattern_length_value: i64 = values[1]
    if text_length_value < 0 or text_length_value > 12 or pattern_length_value < 0 or pattern_length_value > 20:
        return -1
    text_length: usize = text_length_value.usize()
    pattern_length: usize = pattern_length_value.usize()
    if length != 2 + text_length + pattern_length:
        return -1
    pattern_start: usize = 2 + text_length
    valid_text: bool =
        for index in 0..<text_length |valid: mutable bool = true| -> valid:
            if values[2 + index] < 97 or values[2 + index] > 122:
                break false
    if not valid_text:
        return -1
    valid_pattern: bool =
        for index in 0..<pattern_length |valid: mutable bool = true| -> valid:
            symbol: i64 = values[pattern_start + index]
            if not ((symbol >= 97 and symbol <= 122) or symbol == 46 or symbol == 42):
                break false
            if symbol == 42 and (index == 0 or values[pattern_start + index - 1] == 42):
                break false
    if not valid_pattern:
        return -1
    if regex_match_recursive(values, text_length, pattern_start, pattern_length, 0, 0):
        return 1
    return 0

export fn regex_match(values: i64&, length: usize) -> i64 = regex_match_impl(values, length)
