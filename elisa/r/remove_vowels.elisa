const MAX_INPUT_LENGTH: usize = 4096

def lower_ascii(c: usize) -> usize:
    if c >= 65 and c <= 90 |c + 32| else |c|

def vowel(c: usize) -> bool:
    c == 97 or c == 101 or c == 105 or c == 111 or c == 117

def remove_vowels_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or input[0] < 0 or input[0] > MAX_INPUT_LENGTH.i64(): return -1
    n: usize = input[0].usize()
    if length != n + 1: return -1
    result: mutable usize = 0
    i: usize = 0
    while i < n:
        if input[i + 1] < 0 or input[i + 1] > 127: return -1
        if not vowel(lower_ascii(input[i + 1].usize())): result <- result + 1
        i <- i + 1
    if result > capacity or (result > 0 and output.is_null()): return -2
    i <- 0
    written: mutable usize = 0
    while i < n:
        c: usize = lower_ascii(input[i + 1].usize())
        if not vowel(c):
            output[written] <- c.u8()
            written <- written + 1
        i <- i + 1
    written.i64()

export fn remove_vowels(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = remove_vowels_impl
