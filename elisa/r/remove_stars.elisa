const MAX_INPUT_LENGTH: usize = 4096

def remove_stars_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_INPUT_LENGTH + 1 or input[0] < 0 or input[0] > MAX_INPUT_LENGTH.i64(): return -1
    n: usize = input[0].usize()
    if length != n + 1: return -1
    result: mutable usize = 0
    i: usize = 0
    while i < n:
        if input[i + 1] < 0 or input[i + 1] > 127: return -1
        if input[i + 1] == 42:
            if result > 0: result <- result - 1
        else:
            result <- result + 1
        i <- i + 1
    if result > capacity or (result > 0 and output.is_null()): return -2
    i <- 0
    written: mutable usize = 0
    while i < n:
        if input[i + 1] == 42:
            if written > 0: written <- written - 1
        else:
            output[written] <- input[i + 1].u8()
            written <- written + 1
        i <- i + 1
    written.i64()

export fn remove_stars(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = remove_stars_impl
