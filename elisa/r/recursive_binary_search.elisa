# Recursive binary search in an ascending sequence for the shared contract.
def recursive_binary_search_range(values: view[i64], low: usize, high: usize, target: i64) -> i64:
    if low >= high:
        return -1

    middle: usize = low + (high - low) / 2
    if values[middle] == target:
        return middle.i64()
    if target < values[middle]:
        return recursive_binary_search_range(values, low, middle, target)
    recursive_binary_search_range(values, middle + 1, high, target)

def recursive_binary_search_impl(values: i64&, length: usize, target: i64) -> i64:
    recursive_binary_search_range(values[0:length], 0, length, target)

export fn recursive_binary_search(values: i64&, length: usize, target: i64) -> i64 = recursive_binary_search_impl
