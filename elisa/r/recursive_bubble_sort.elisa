# Recursive bubble sort for the shared signed 64-bit benchmark contract.
def recursive_bubble_sort_range(values: mutable i64&, length: usize) -> void:
    if length < 2:
        return
    index: mutable usize = 0
    while index + 1 < length:
        if values[index] > values[index + 1]:
            temporary: i64 = values[index]
            values[index] <- values[index + 1]
            values[index + 1] <- temporary
        index <- index + 1
    recursive_bubble_sort_range(values, length - 1)

def recursive_bubble_sort_impl(values: mutable i64&, length: usize) -> void:
    recursive_bubble_sort_range(values, length)

export fn recursive_bubble_sort(values: mutable i64&, length: usize) -> void = recursive_bubble_sort_impl
