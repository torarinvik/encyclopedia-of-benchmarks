def reversort_cost_impl(values: i64&, length: usize) -> i64:
    if length > 256:
        return -1
    working: mutable i64[256] = zeroed
    for index in 0..<length:
        if values[index] < -2147483648 or values[index] > 2147483647:
            return -1
        working[index] <- values[index]
    cost: mutable i64 = 0
    index: mutable usize = 0
    while index + 1 < length:
        minimum: mutable usize = index
        probe: mutable usize = index + 1
        while probe < length:
            if working[probe] < working[minimum]:
                minimum <- probe
            probe <- probe + 1
        left: mutable usize = index
        right: mutable usize = minimum
        while left < right:
            temporary: i64 = working[left]
            working[left] <- working[right]
            working[right] <- temporary
            left <- left + 1
            right <- right - 1
        cost <- cost + (minimum - index + 1).i64()
        index <- index + 1
    cost

export fn reversort_cost(values: i64&, length: usize) -> i64 = reversort_cost_impl
