const MAX_OPERATIONS: usize = 128
const INVALID_RESULT: i64 = -1
const CAPACITY_RESULT: i64 = -2

def rb_insert_search_is_red(red: bool&, node: usize) -> bool:
    node != 0 and red[node]

def rb_insert_search_flip(node: usize, left: usize&, right: usize&, red: mutable bool&) -> void:
    red[node] <- not red[node]
    red[left[node]] <- not red[left[node]]
    red[right[node]] <- not red[right[node]]

def rb_insert_search_rotate_left(node: usize, left: mutable usize&, right: mutable usize&, red: mutable bool&) -> usize:
    pivot: usize = right[node]
    right[node] <- left[pivot]
    left[pivot] <- node
    red[pivot] <- red[node]
    red[node] <- true
    pivot

def rb_insert_search_rotate_right(node: usize, left: mutable usize&, right: mutable usize&, red: mutable bool&) -> usize:
    pivot: usize = left[node]
    left[node] <- right[pivot]
    right[pivot] <- node
    red[pivot] <- red[node]
    red[node] <- true
    pivot

def rb_insert_search_find(start: usize, key: i64, keys: i64&, left: usize&, right: usize&) -> usize:
    node: mutable usize = start
    while node != 0:
        if key < keys[node]: node <- left[node]
        else if key > keys[node]: node <- right[node]
        else: return node
    0

def rb_insert_search_insert(node_value: usize, key: i64, next: mutable usize&, keys: mutable i64&, left: mutable usize&, right: mutable usize&, red: mutable bool&) -> usize:
    node: mutable usize = node_value
    if node == 0:
        node <- next
        next <- next + 1
        keys[node] <- key
        red[node] <- true
        return node
    if rb_insert_search_is_red(red, left[node]) and rb_insert_search_is_red(red, right[node]):
        rb_insert_search_flip(node, left, right, red)
    if key == keys[node]: keys[node] <- key
    else if key < keys[node]:
        child: usize = rb_insert_search_insert(left[node], key, next, keys, left, right, red)
        left[node] <- child
    else:
        child: usize = rb_insert_search_insert(right[node], key, next, keys, left, right, red)
        right[node] <- child
    if rb_insert_search_is_red(red, right[node]) and not rb_insert_search_is_red(red, left[node]):
        node <- rb_insert_search_rotate_left(node, left, right, red)
    if rb_insert_search_is_red(red, left[node]) and rb_insert_search_is_red(red, left[left[node]]):
        node <- rb_insert_search_rotate_right(node, left, right, red)
    node

def rb_insert_search_sort(values: mutable i64&, count: usize) -> void:
    index: mutable usize = 1
    while index < count:
        value: i64 = values[index]
        position: mutable usize = index
        while position > 0 and values[position - 1] > value:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- value
        index <- index + 1

def rb_insert_search_put(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def red_black_tree_insert_search_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1: return INVALID_RESULT
    count_value: i64 = input[0]
    if count_value < 0 or count_value > 128 or length != (1 + 2 * count_value).usize(): return INVALID_RESULT
    operation_count: usize = count_value.usize()
    for op in 0..<operation_count:
        opcode: i64 = input[1 + 2 * op]
        key: i64 = input[2 + 2 * op]
        if (opcode != 0 and opcode != 1) or key < -2147483648 or key > 2147483647: return INVALID_RESULT
    keys: mutable i64[MAX_OPERATIONS + 1] = zeroed
    left: mutable usize[MAX_OPERATIONS + 1] = zeroed
    right: mutable usize[MAX_OPERATIONS + 1] = zeroed
    red: mutable bool[MAX_OPERATIONS + 1] = zeroed
    active: mutable i64[MAX_OPERATIONS] = zeroed
    results: mutable i64[MAX_OPERATIONS] = zeroed
    root: mutable usize = 0
    next: mutable usize = 1
    key_count: mutable usize = 0
    search_count: mutable usize = 0
    for op in 0..<operation_count:
        opcode: i64 = input[1 + 2 * op]
        key: i64 = input[2 + 2 * op]
        if opcode == 0:
            if rb_insert_search_find(root, key, keys[0], left[0], right[0]) != 0: return INVALID_RESULT
            root <- rb_insert_search_insert(root, key, next, keys[0], left[0], right[0], red[0])
            red[root] <- false
            active[key_count] <- key
            key_count <- key_count + 1
        else:
            results[search_count] <- if rb_insert_search_find(root, key, keys[0], left[0], right[0]) != 0: 1 else: 0
            search_count <- search_count + 1
    rb_insert_search_sort(active[0], key_count)
    required: usize = (2 + key_count + search_count) * 8
    if output.is_null() or capacity < required: return CAPACITY_RESULT
    offset: mutable usize = 0
    rb_insert_search_put(output, offset, key_count.i64())
    offset <- offset + 8
    for index in 0..<key_count:
        rb_insert_search_put(output, offset, active[index])
        offset <- offset + 8
    rb_insert_search_put(output, offset, search_count.i64())
    offset <- offset + 8
    for index in 0..<search_count:
        rb_insert_search_put(output, offset, results[index])
        offset <- offset + 8
    required.i64()

export fn red_black_tree_insert_search(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = red_black_tree_insert_search_impl
