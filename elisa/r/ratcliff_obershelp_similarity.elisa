const RO_MAX_TEXT = 32
const RO_MAX_INPUT_LENGTH = 67

def ro_longest_match(input: i64&, first_base: usize, second_base: usize,
                     a0: usize, a1: usize, b0: usize, b1: usize) -> i64:
    dp: mutable i64[33] = zeroed
    best_length: mutable usize = 0
    best_a: mutable usize = 0
    best_b: mutable usize = 0
    width: usize = b1 - b0
    i: mutable usize = a0
    while i < a1:
        diagonal: mutable i64 = 0
        column: mutable usize = 1
        while column <= width:
            old: i64 = dp[column]
            j: usize = b0 + column - 1
            if input[first_base + i] == input[second_base + j]:
                current: usize = diagonal.usize() + 1
                dp[column] <- current.i64()
                if current > best_length:
                    best_length <- current
                    best_a <- i + 1 - current
                    best_b <- j + 1 - current
            else:
                dp[column] <- 0
            diagonal <- old
            column <- column + 1
        i <- i + 1
    (best_length.i64() * 4096 + best_a.i64() * 64 + best_b.i64())

def ro_matched_characters(input: i64&, first_base: usize,
                          second_base: usize, a0: usize, a1: usize,
                          b0: usize, b1: usize) -> i64:
    if a0 >= a1 or b0 >= b1: return 0
    packed_value: i64 = ro_longest_match(input, first_base, second_base, a0, a1, b0, b1)
    block: usize = (packed_value / 4096).usize()
    if block == 0: return 0
    rest: usize = (packed_value % 4096).usize()
    a: usize = rest / 64
    b: usize = rest % 64
    return (block.i64() + ro_matched_characters(input, first_base, second_base, a0, a, b0, b)
        + ro_matched_characters(input, first_base, second_base, a + block, a1, b + block, b1))

def ro_compute(input: i64&, input_length: usize) -> i64:
    length: usize = input_length
    if length < 2 or length > RO_MAX_INPUT_LENGTH: return -1
    first_raw: i64 = input[0]
    second_raw: i64 = input[1]
    if first_raw < 0 or first_raw > RO_MAX_TEXT.i64() or second_raw < 0 or second_raw > RO_MAX_TEXT.i64(): return -1
    first_length: usize = first_raw.usize()
    second_length: usize = second_raw.usize()
    if length != 2 + first_length + second_length: return -1
    for i in 0..<(first_length + second_length):
        if input[2 + i] < 1 or input[2 + i] > 127: return -1
    if first_length == 0 or second_length == 0: return 0
    common: i64 = ro_matched_characters(input, 2, 2 + first_length,
                                        0, first_length, 0, second_length)
    (200 * common) / (first_length + second_length).i64()

def ratcliff_obershelp_similarity_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > RO_MAX_INPUT_LENGTH: return -1
    ro_compute(input, length)

export fn ratcliff_obershelp_similarity(input: i64&, length: usize) -> i64 = ratcliff_obershelp_similarity_impl
