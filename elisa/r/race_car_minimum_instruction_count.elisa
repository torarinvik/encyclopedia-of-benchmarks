const MAX_TARGET: usize = 127
const MAX_INPUT_LENGTH: usize = 2

def race_car_minimum_instruction_count_impl(input: i64&, input_length: usize) -> i64:
    if input_length != 1:
        return -1
    target_value: i64 = input[0]
    if target_value < 0 or target_value > MAX_TARGET.i64():
        return -1
    target: usize = target_value.usize()
    distance: mutable i32[128] = zeroed
    position: mutable usize = 1
    while position <= target:
        run: mutable usize = 0
        upper_power: mutable usize = 1
        while upper_power <= position:
            upper_power <- upper_power * 2
            run <- run + 1
        upper: usize = upper_power - 1
        if position == upper:
            distance[position] <- run.i32()
        else:
            best: mutable i32 = (run + 1).i32() + distance[upper - position]
            lower: usize = upper_power / 2 - 1
            backward_run: mutable usize = 0
            backward_power: mutable usize = 1
            while backward_run + 1 < run:
                backward_distance: usize = backward_power - 1
                remaining: usize = position - (lower - backward_distance)
                candidate: i32 = (run + backward_run + 1).i32() + distance[remaining]
                if candidate < best:
                    best <- candidate
                backward_power <- backward_power * 2
                backward_run <- backward_run + 1
            distance[position] <- best
        position <- position + 1
    distance[target].i64()

def race_car_minimum_instruction_count_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    race_car_minimum_instruction_count_impl(input, length)

export fn race_car_minimum_instruction_count(input: i64&, length: usize) -> i64 = race_car_minimum_instruction_count_entry
