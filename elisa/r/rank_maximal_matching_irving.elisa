// Clean-room bounded Irving rank-phase reduction; the FFI boundary is followed by bounded views.
const MAX_A: usize = 4
const MAX_P: usize = 4
const MAX_V: usize = 8
const MAX_RANK: usize = 4
const MAX_INPUT: usize = 52
const MAX_OUTPUT: usize = 40

def rmi_lex_less(left: view[usize], right: view[usize], count: usize) -> bool:
    i: mutable usize = 0
    while i < count:
        if left[i] != right[i]: return left[i] < right[i]
        i <- i+1
    false

def rmi_put(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    b: mutable usize = 0
    while b < 8:
        output[offset+b] <- ((bits>>(8*b))&255).u8()
        b <- b+1

def rmi_maximum_matching(applicants: usize, posts: usize, phase: usize,
                         rank: view[i64], blocked: view[bool],
                         mate_a: mutable view[i64], mate_p: mutable view[i64]) -> void:
    limit: mutable usize = 1
    a: mutable usize = 0
    while a < applicants: limit <- limit*(posts+1); a <- a+1
    best: mutable usize[MAX_A] = zeroed
    best_size: mutable i64 = -1
    code: mutable usize = 0
    while code < limit:
        value: mutable usize = code
        candidate: mutable usize[MAX_A] = zeroed
        used: mutable u64 = 0
        size: mutable i64 = 0
        valid: mutable bool = true
        a <- 0
        while a < applicants:
            p: usize = value%(posts+1)
            value <- value/(posts+1)
            candidate[a] <- p
            if p != posts:
                index: usize = a*MAX_P+p
                bit: u64 = 1.u64()<<p
                if rank[index] == 0 or rank[index] > phase.i64() or blocked[index] or (used&bit) != 0:
                    valid <- false
                    break
                used <- used|bit
                size <- size+1
            a <- a+1
        if valid and (size > best_size or (size == best_size and rmi_lex_less(candidate[0:applicants],best[0:applicants],applicants))):
            best_size <- size
            best <- candidate
        code <- code+1
    a <- 0
    while a < MAX_A: mate_a[a] <- -1; a <- a+1
    p: mutable usize = 0
    while p < MAX_P: mate_p[p] <- -1; p <- p+1
    a <- 0
    while a < applicants:
        if best[a] < posts: mate_a[a] <- best[a].i64(); mate_p[best[a]] <- a.i64()
        a <- a+1

def rmi_classify(applicants: usize, posts: usize, phase: usize,
                 rank: view[i64], blocked: view[bool],
                 mate_a: view[i64], mate_p: view[i64], classes: mutable view[i64]) -> void:
    queue: mutable usize[MAX_V] = zeroed
    head: mutable usize = 0
    tail: mutable usize = 0
    v: mutable usize = 0
    while v < applicants+posts: classes[v] <- 2; v <- v+1
    a: mutable usize = 0
    while a < applicants:
        if mate_a[a] < 0: classes[a] <- 0; queue[tail] <- a; tail <- tail+1
        a <- a+1
    p: mutable usize = 0
    while p < posts:
        if mate_p[p] < 0: v <- applicants+p; classes[v] <- 0; queue[tail] <- v; tail <- tail+1
        p <- p+1
    while head < tail:
        v <- queue[head]
        head <- head+1
        if v < applicants:
            a <- v
            if classes[v] == 0:
                p <- 0
                while p < posts:
                    index: usize = a*MAX_P+p
                    w: usize = applicants+p
                    if rank[index] > 0 and rank[index] <= phase.i64() and not blocked[index] and mate_a[a] != p.i64() and classes[w] == 2:
                        classes[w] <- 1; queue[tail] <- w; tail <- tail+1
                    p <- p+1
            else if mate_a[a] >= 0:
                w <- applicants+mate_a[a].usize()
                if classes[w] == 2: classes[w] <- 0; queue[tail] <- w; tail <- tail+1
        else:
            p <- v-applicants
            if classes[v] == 0:
                a <- 0
                while a < applicants:
                    index: usize = a*MAX_P+p
                    if rank[index] > 0 and rank[index] <= phase.i64() and not blocked[index] and mate_a[a] != p.i64() and classes[a] == 2:
                        classes[a] <- 1; queue[tail] <- a; tail <- tail+1
                    a <- a+1
            else if mate_p[p] >= 0:
                a <- mate_p[p].usize()
                if classes[a] == 2: classes[a] <- 0; queue[tail] <- a; tail <- tail+1

def rank_maximal_matching_irving(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("rank_maximal_matching_irving"):
    if input.is_null() or length < 3 or length > MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    a64: i64 = input_view[0]
    p64: i64 = input_view[1]
    e64: i64 = input_view[2]
    if a64 < 1 or a64 > MAX_A.i64() or p64 < 1 or p64 > MAX_P.i64(): return -1
    applicants: usize = a64.usize()
    posts: usize = p64.usize()
    if e64 < a64 or e64 > (applicants*posts).i64(): return -1
    edges: usize = e64.usize()
    if edges > 16 or length != 3+3*edges: return -1
    rank: mutable i64[MAX_A*MAX_P] = zeroed
    degree: mutable usize[MAX_A] = zeroed
    max_rank: mutable usize = 0
    edge: mutable usize = 0
    while edge < edges:
        at: usize = 3+3*edge
        av: i64 = input_view[at]
        pv: i64 = input_view[at+1]
        rv: i64 = input_view[at+2]
        if av < 0 or av >= a64 or pv < 0 or pv >= p64 or rv < 1 or rv > MAX_RANK.i64(): return -1
        a: usize = av.usize()
        p: usize = pv.usize()
        index: usize = a*MAX_P+p
        if rank[index] != 0: return -1
        rank[index] <- rv
        degree[a] <- degree[a]+1
        if rv.usize() > max_rank: max_rank <- rv.usize()
        edge <- edge+1
    a: mutable usize = 0
    while a < applicants:
        if degree[a] == 0: return -1
        a <- a+1
    blocked: mutable bool[MAX_A*MAX_P] = zeroed
    mate_a: mutable i64[MAX_A] = zeroed
    mate_p: mutable i64[MAX_P] = zeroed
    a <- 0
    while a < MAX_A: mate_a[a] <- -1; a <- a+1
    p: mutable usize = 0
    while p < MAX_P: mate_p[p] <- -1; p <- p+1
    phase: mutable usize = 1
    while phase <= max_rank:
        rmi_maximum_matching(applicants,posts,phase,rank[0:MAX_A*MAX_P],blocked[0:MAX_A*MAX_P],mate_a[0:MAX_A],mate_p[0:MAX_P])
        classes: mutable i64[MAX_V] = zeroed
        rmi_classify(applicants,posts,phase,rank[0:MAX_A*MAX_P],blocked[0:MAX_A*MAX_P],mate_a[0:MAX_A],mate_p[0:MAX_P],classes[0:MAX_V])
        a <- 0
        while a < applicants:
            p <- 0
            while p < posts:
                index: usize = a*MAX_P+p
                if rank[index] != 0 and not blocked[index]:
                    ca: i64 = classes[a]
                    cp: i64 = classes[applicants+p]
                    if rank[index] <= phase.i64():
                        if (ca == 1 and cp != 0) or (cp == 1 and ca != 0): blocked[index] <- true
                    else if ca != 0 or cp != 0: blocked[index] <- true
                p <- p+1
            a <- a+1
        phase <- phase+1
    signature: mutable i64[MAX_RANK] = zeroed
    a <- 0
    while a < applicants:
        if mate_a[a] >= 0:
            rank_value: usize = rank[a*MAX_P+mate_a[a].usize()].usize()
            signature[rank_value-1] <- signature[rank_value-1]+1
        a <- a+1
    output_bytes: usize = 8*(max_rank+1)
    if output.is_null() or capacity < output_bytes: return -2
    staged: mutable u8[MAX_OUTPUT] = zeroed
    staged_view: mutable view[u8] = staged[0:MAX_OUTPUT]
    rmi_put(max_rank.i64(),staged_view,0)
    r: mutable usize = 0
    while r < max_rank: rmi_put(signature[r],staged_view,8*(r+1)); r <- r+1
    output_view: mutable view[u8] = output[0:output_bytes]
    i: mutable usize = 0
    while i < output_bytes: output_view[i] <- staged[i]; i <- i+1
    output_bytes.i64()
