def rarm_build(minimum: mutable view[i64], values: view[i64], node: usize, left: usize, right: usize) -> void:
    if right - left == 1:
        minimum[node] <- values[2 + left]
        return
    let middle: usize = (left + right) / 2
    rarm_build(minimum, values, 2 * node, left, middle)
    rarm_build(minimum, values, 2 * node + 1, middle, right)
    let a: i64 = minimum[2 * node]
    let b: i64 = minimum[2 * node + 1]
    minimum[node] <- if a < b: a else: b

def rarm_push(minimum: mutable view[i64], lazy: mutable view[i64], node: usize) -> void:
    for child in (2 * node)..<(2 * node + 2):
        minimum[child] <- minimum[child] + lazy[node]
        lazy[child] <- lazy[child] + lazy[node]
    lazy[node] <- 0

def rarm_add(minimum: mutable view[i64], lazy: mutable view[i64], node: usize,
             left: usize, right: usize, first: usize, last: usize, delta: i64) -> void:
    if last <= left or right <= first: return
    if first <= left and right <= last:
        minimum[node] <- minimum[node] + delta
        lazy[node] <- lazy[node] + delta
        return
    rarm_push(minimum, lazy, node)
    let middle: usize = (left + right) / 2
    rarm_add(minimum, lazy, 2 * node, left, middle, first, last, delta)
    rarm_add(minimum, lazy, 2 * node + 1, middle, right, first, last, delta)
    let a: i64 = minimum[2 * node]
    let b: i64 = minimum[2 * node + 1]
    minimum[node] <- if a < b: a else: b

def rarm_query(minimum: mutable view[i64], lazy: mutable view[i64], node: usize,
               left: usize, right: usize, first: usize, last: usize) -> i64:
    if last <= left or right <= first: return 9223372036854775807.i64()
    if first <= left and right <= last: return minimum[node]
    rarm_push(minimum, lazy, node)
    let middle: usize = (left + right) / 2
    let a: i64 = rarm_query(minimum, lazy, 2 * node, left, middle, first, last)
    let b: i64 = rarm_query(minimum, lazy, 2 * node + 1, middle, right, first, last)
    if a < b: a else: b

def range_add_range_min_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 322: return -1
    values: view[i64] = input[0:length]
    if values[0] < 1 or values[0] > 64 or values[1] < 1 or values[1] > 64: return -1
    let n: usize = values[0].usize()
    let q: usize = values[1].usize()
    if length != 2 + n + 4 * q: return -1
    for i in 0..<n:
        if values[2+i] < -1000000 or values[2+i] > 1000000: return -1
    queries: mutable usize = 0
    for i in 0..<q:
        let base: usize = 2 + n + 4 * i
        let op: i64 = values[base]
        let left: i64 = values[base+1]
        let right: i64 = values[base+2]
        let delta: i64 = values[base+3]
        if left < 0 or left >= right or right > n.i64(): return -1
        if op == 0:
            if delta < -100000 or delta > 100000: return -1
        else if op == 1:
            if delta != 0: return -1
            queries <- queries + 1
        else: return -1
    if queries == 0: return -1
    if output == null or capacity < 8 * queries: return -2
    bytes: mutable view[u8] = output[0:8 * queries]
    minimum: mutable i64[256] = zeroed
    lazy: mutable i64[256] = zeroed
    rarm_build(minimum[0:256], values, 1, 0, n)
    written: mutable usize = 0
    for i in 0..<q:
        let base: usize = 2 + n + 4 * i
        let left: usize = values[base+1].usize()
        let right: usize = values[base+2].usize()
        if values[base] == 0:
            rarm_add(minimum[0:256], lazy[0:256], 1, 0, n, left, right, values[base+3])
        else:
            let answer: i64 = rarm_query(minimum[0:256], lazy[0:256], 1, 0, n, left, right)
            let bits: u64 = answer.u64()
            for byte in 0..<8:
                bytes[8 * written + byte] <- ((bits >> (8 * byte)) & 255.u64()).u8()
            written <- written + 1
    (8 * written).i64()

export fn range_add_range_min(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = range_add_range_min_impl
