extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&
def rgb_hsv_conversion_put_f64(output: mutable view[u8], offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def rgb_hsv_conversion_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length != 3:
        return -1
    index: mutable usize = 0
    while index < 3:
        if input[index] < 0 or input[index] > 255: return -1
        index <- index + 1
    if output.is_null() or capacity < 24: return -2
    output_view: mutable view[u8] = output[0:24]
    red: f64 = input[0].f64() / 255.0
    green: f64 = input[1].f64() / 255.0
    blue: f64 = input[2].f64() / 255.0
    value: f64 = red
    if green > value: value <- green
    if blue > value: value <- blue
    minimum: f64 = red
    if green < minimum: minimum <- green
    if blue < minimum: minimum <- blue
    chroma: f64 = value - minimum
    saturation: f64 = 0.0
    if value != 0.0: saturation <- chroma / value
    hue: mutable f64 = 0.0
    if chroma != 0.0:
        if value == red: hue <- 60.0 * (0.0 + (green - blue) / chroma)
        else if value == green: hue <- 60.0 * (2.0 + (blue - red) / chroma)
        else: hue <- 60.0 * (4.0 + (red - green) / chroma)
    hue <- hue + 360.0
    if hue >= 360.0: hue <- hue - 360.0
    rgb_hsv_conversion_put_f64(output_view, 0, hue)
    rgb_hsv_conversion_put_f64(output_view, 8, saturation)
    rgb_hsv_conversion_put_f64(output_view, 16, value)
    24

export fn rgb_hsv_conversion(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = rgb_hsv_conversion_impl
