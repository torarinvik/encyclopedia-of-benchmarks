const RSA_RUBY_INVALID_RESULT: i64 = -1
const RSA_RUBY_MAX_INPUT_LENGTH: usize = 69
const RSA_RUBY_FNV_OFFSET: u64 = 14695981039346656037.u64()
const RSA_RUBY_FNV_PRIME: u64 = 1099511628211.u64()

def rsa_ruby_bounded_power(base: i64, exponent: i64) -> i64:
    result: mutable i64 = 1
    index: mutable i64 = 0
    while index < exponent:
        result <- result * base
        index <- index + 1
    result

def rsa_ruby_hash_byte(hash_input: u64, value: i64) -> u64:
    (hash_input ^ value.u64()) * RSA_RUBY_FNV_PRIME

def rsa_ruby_byte_chunk_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 5 or length > RSA_RUBY_MAX_INPUT_LENGTH: return RSA_RUBY_INVALID_RESULT
    modulus: i64 = input[0]
    public_exponent: i64 = input[1]
    private_exponent: i64 = input[2]
    message_length: i64 = input[3]
    if modulus != 33 or public_exponent < 1 or public_exponent > 7 or private_exponent < 1 or private_exponent > 7 or
       message_length < 1 or message_length > 64 or length != (4 + message_length).usize(): return RSA_RUBY_INVALID_RESULT
    index: mutable usize = 0
    while index < message_length.usize():
        value: i64 = input[4 + index]
        if value < 0 or value >= modulus: return RSA_RUBY_INVALID_RESULT
        index <- index + 1
    ciphertexts: mutable [64]i64 = [64]i64{0}
    index <- 0
    while index < message_length.usize():
        ciphertexts[index] <- rsa_ruby_bounded_power(input[4 + index], public_exponent) % modulus
        index <- index + 1
    hash: mutable u64 = RSA_RUBY_FNV_OFFSET
    index <- 0
    while index < message_length.usize():
        value: i64 = ciphertexts[index]
        hash <- rsa_ruby_hash_byte(hash, 48 + value / 10)
        hash <- rsa_ruby_hash_byte(hash, 48 + value % 10)
        index <- index + 1
    index <- 0
    while index < message_length.usize():
        recovered: i64 = rsa_ruby_bounded_power(ciphertexts[index], private_exponent) % modulus
        hash <- rsa_ruby_hash_byte(hash, recovered)
        index <- index + 1
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn rsa_ruby_byte_chunk(input: i64&, length: usize) -> i64 = rsa_ruby_byte_chunk_impl
