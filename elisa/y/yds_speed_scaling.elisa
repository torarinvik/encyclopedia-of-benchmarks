// Clean-room bounded YDS critical-interval decomposition, with exact energy.
const MAX_JOBS: usize = 4
const MAX_TIME: usize = 8
const MAX_INPUT: usize = 13
const MAX_OUTPUT: usize = 152

def yds_gcd(a0: i64, b0: i64) -> i64:
    a: mutable i64 = a0
    b: mutable i64 = b0
    while b != 0:
        r: i64 = a%b
        a <- b
        b <- r
    a

def yds_put(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset+byte] <- ((bits>>(8*byte))&255).u8()
        byte <- byte+1

def yds_speed_scaling(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("yds_speed_scaling"):
    if input.is_null() or length < 4 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    if n64 < 1 or n64 > MAX_JOBS.i64(): return -1
    n: usize = n64.usize()
    if length != 1+3*n: return -1
    release: mutable usize[MAX_JOBS] = zeroed
    deadline: mutable usize[MAX_JOBS] = zeroed
    work: mutable i64[MAX_JOBS] = zeroed
    active: mutable bool[MAX_JOBS] = zeroed
    j: mutable usize = 0
    while j < n:
        r: i64 = input[1+3*j]
        d: i64 = input[2+3*j]
        w: i64 = input[3+3*j]
        if r < 0 or r >= d or d > MAX_TIME.i64() or w < 1 or w > 8: return -1
        release[j] <- r.usize()
        deadline[j] <- d.usize()
        work[j] <- w
        active[j] <- true
        j <- j+1
    staged: mutable i64[MAX_OUTPUT/8] = zeroed
    output_values: mutable usize = 3
    stages: mutable usize = 0
    energy_num: mutable i64 = 0
    energy_den: mutable i64 = 1
    remaining: mutable usize = n
    while remaining > 0:
        release_seen: mutable bool[MAX_TIME+1] = zeroed
        deadline_seen: mutable bool[MAX_TIME+1] = zeroed
        j <- 0
        while j < n:
            if active[j]: release_seen[release[j]] <- true; deadline_seen[deadline[j]] <- true
            j <- j+1
        have_best: mutable bool = false
        best_a: mutable usize = 0
        best_b: mutable usize = 1
        best_work: mutable i64 = 0
        best_duration: mutable i64 = 1
        a: mutable usize = 0
        while a <= MAX_TIME:
            if release_seen[a]:
                b: mutable usize = a+1
                while b <= MAX_TIME:
                    if deadline_seen[b]:
                        total: mutable i64 = 0
                        j <- 0
                        while j < n:
                            if active[j] and release[j] >= a and deadline[j] <= b: total <- total+work[j]
                            j <- j+1
                        if total > 0:
                            duration: i64 = (b-a).i64()
                            if not have_best or total*best_duration > best_work*duration or
                                    (total*best_duration == best_work*duration and (a < best_a or (a == best_a and b < best_b))):
                                have_best <- true
                                best_a <- a
                                best_b <- b
                                best_work <- total
                                best_duration <- duration
                    b <- b+1
            a <- a+1
        if not have_best: return -1
        job_mask: mutable u64 = 0
        j <- 0
        while j < n:
            if active[j] and release[j] >= best_a and deadline[j] <= best_b:
                job_mask <- job_mask | (1.u64()<<j)
            j <- j+1
        staged[output_values] <- best_a.i64(); output_values <- output_values+1
        staged[output_values] <- best_b.i64(); output_values <- output_values+1
        staged[output_values] <- best_work; output_values <- output_values+1
        staged[output_values] <- job_mask.i64(); output_values <- output_values+1
        term_num: i64 = best_work*best_work*best_work
        term_den: i64 = best_duration*best_duration
        common: i64 = yds_gcd(energy_den,term_den)
        energy_num <- energy_num*(term_den/common)+term_num*(energy_den/common)
        energy_den <- energy_den*(term_den/common)
        energy_gcd: i64 = yds_gcd(energy_num,energy_den)
        energy_num <- energy_num/energy_gcd
        energy_den <- energy_den/energy_gcd
        j <- 0
        while j < n:
            if active[j]:
                if release[j] >= best_a and deadline[j] <= best_b:
                    active[j] <- false
                    remaining <- remaining-1
                else:
                    if release[j] > best_a and release[j] < best_b: release[j] <- best_a
                    else if release[j] >= best_b: release[j] <- release[j]-best_duration.usize()
                    if deadline[j] > best_a and deadline[j] < best_b: deadline[j] <- best_a
                    else if deadline[j] >= best_b: deadline[j] <- deadline[j]-best_duration.usize()
            j <- j+1
        stages <- stages+1
    staged[0] <- stages.i64()
    staged[1] <- energy_num
    staged[2] <- energy_den
    output_bytes: usize = 8*output_values
    if output.is_null() or capacity < output_bytes: return -2
    bytes: mutable u8[MAX_OUTPUT] = zeroed
    i: mutable usize = 0
    while i < output_values: yds_put(staged[i],bytes&,8*i); i <- i+1
    i <- 0
    while i < output_bytes: output[i] <- bytes[i]; i <- i+1
    output_bytes.i64()
