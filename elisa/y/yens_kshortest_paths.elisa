const NMAX: usize = 8
const KMAX: usize = 8

def yen_put(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for index in 0..<8:
        output[offset + index] <- ((bits >> (index * 8)) & 255).u8()

def yen_lex_less(a: i64&, astart: usize, alen: usize, acost: i64, b: i64&, bstart: usize, blen: usize, bcost: i64) -> bool:
    if acost != bcost:
        return acost < bcost
    limit: mutable usize = alen
    if blen < limit:
        limit <- blen
    for i in 0..<limit:
        if a[astart + i] != b[bstart + i]:
            return a[astart + i] < b[bstart + i]
    alen < blen

def yen_same(a: i64&, astart: usize, alen: usize, b: i64&, bstart: usize, blen: usize) -> bool:
    if alen != blen:
        return false
    for i in 0..<alen:
        if a[astart + i] != b[bstart + i]:
            return false
    true

def yen_shortest(graph: i64&, n: usize, src: usize, dst: usize, blocked_nodes: u64, blocked_edges: u64) -> i64:
    current: mutable i64[8] = zeroed
    next_vertex: mutable usize[8] = zeroed
    path_cost: mutable i64[8] = zeroed
    best: mutable i64[8] = zeroed
    depth: mutable usize = 1
    current[0] <- src.i64()
    found: mutable bool = false
    best_length: mutable usize = 0
    best_cost: mutable i64 = 0
    while depth > 0:
        u: usize = current[depth - 1].usize()
        if u == dst:
            better: mutable bool = not found
            if found:
                if path_cost[depth - 1] < best_cost:
                    better <- true
                elif path_cost[depth - 1] == best_cost:
                    shared: mutable usize = depth
                    if best_length < shared:
                        shared <- best_length
                    tie_broken: mutable bool = false
                    for j in 0..<shared:
                        if current[j] != best[j]:
                            better <- current[j] < best[j]
                            tie_broken <- true
                            break
                    if not tie_broken and depth < best_length:
                        better <- true
            if better:
                for j in 0..<depth:
                    best[j] <- current[j]
                best_length <- depth
                best_cost <- path_cost[depth - 1]
                found <- true
            depth <- depth - 1
            continue
        if next_vertex[depth - 1] >= n:
            next_vertex[depth - 1] <- 0
            depth <- depth - 1
            continue
        v: usize = next_vertex[depth - 1]
        next_vertex[depth - 1] <- next_vertex[depth - 1] + 1
        weight: i64 = graph[u * n + v]
        if weight < 0 or ((blocked_nodes >> v) & 1) != 0 or ((blocked_edges >> (u * NMAX + v)) & 1) != 0:
            continue
        repeated: mutable bool = false
        for j in 0..<depth:
            if current[j].usize() == v:
                repeated <- true
        if repeated:
            continue
        current[depth] <- v.i64()
        path_cost[depth] <- path_cost[depth - 1] + weight
        next_vertex[depth] <- 0
        depth <- depth + 1
    if not found:
        return -1
    path_code: mutable u64 = best_cost.u64() << 28
    path_code <- path_code | (best_length.u64() << 24)
    for j in 0..<best_length:
        path_code <- path_code | (best[j].u64() << (j * 3))
    path_code.i64()

def yens_kshortest_paths_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 4:
        return -1
    nv: i64 = input[0]
    kv: i64 = input[1]
    srcv: i64 = input[2]
    dstv: i64 = input[3]
    if nv < 1 or nv > 8 or kv < 1 or kv > 8 or srcv < 0 or srcv >= nv or dstv < 0 or dstv >= nv:
        return -1
    n: usize = nv.usize()
    k: usize = kv.usize()
    src: usize = srcv.usize()
    dst: usize = dstv.usize()
    if length != 4 + n * n:
        return -1
    for i in 0..<n * n:
        weight: i64 = input[4 + i]
        if weight < -1 or weight > 1000:
            return -1
    accepted: mutable i64[64] = zeroed
    accepted_lengths: mutable usize[8] = zeroed
    accepted_costs: mutable i64[8] = zeroed
    candidate_paths: mutable i64[512] = zeroed
    candidate_lengths: mutable usize[64] = zeroed
    candidate_costs: mutable i64[64] = zeroed
    accepted_count: mutable usize = 0
    candidate_count: mutable usize = 0
    first_code: i64 = yen_shortest(input[4], n, src, dst, 0, 0)
    first_length: usize = ((first_code.u64() >> 24) & 15).usize()
    if first_code >= 0:
        for j in 0..<first_length:
            accepted[j] <- ((first_code.u64() >> (j * 3)) & 7).i64()
        accepted_lengths[0] <- first_length
        accepted_costs[0] <- (first_code.u64() >> 28).i64()
        accepted_count <- 1
    while accepted_count < k and accepted_count > 0:
        last_index: usize = accepted_count - 1
        last_length: usize = accepted_lengths[last_index]
        for spur_index in 0..<last_length - 1:
            root: mutable i64[8] = zeroed
            root_length: usize = spur_index + 1
            root_cost: mutable i64 = 0
            for j in 0..<root_length:
                root[j] <- accepted[last_index * NMAX + j]
            for j in 0..<spur_index:
                root_cost <- root_cost + input[4 + root[j].usize() * n + root[j + 1].usize()]
            blocked_nodes: mutable u64 = 0
            blocked_edges: mutable u64 = 0
            for j in 0..<spur_index:
                blocked_nodes <- blocked_nodes | (1.u64() << root[j].usize())
            for p in 0..<accepted_count:
                matched: mutable bool = true
                if accepted_lengths[p] < root_length + 1:
                    matched <- false
                for j in 0..<root_length:
                    if accepted[p * NMAX + j] != root[j]:
                        matched <- false
                if matched:
                    u: usize = accepted[p * NMAX + spur_index].usize()
                    v: usize = accepted[p * NMAX + spur_index + 1].usize()
                    blocked_edges <- blocked_edges | (1.u64() << (u * NMAX + v))
            spur_code: i64 = yen_shortest(input[4], n, root[spur_index].usize(), dst, blocked_nodes, blocked_edges)
            spur_length: usize = ((spur_code.u64() >> 24) & 15).usize()
            if spur_code >= 0:
                total: mutable i64[8] = zeroed
                total_length: mutable usize = root_length
                for j in 0..<root_length:
                    total[j] <- root[j]
                for j in 1..<spur_length:
                    total[total_length] <- ((spur_code.u64() >> (j * 3)) & 7).i64()
                    total_length <- total_length + 1
                total_cost: i64 = root_cost + (spur_code.u64() >> 28).i64()
                duplicate: mutable bool = false
                for p in 0..<accepted_count:
                    if total_length == accepted_lengths[p]:
                        equal: mutable bool = true
                        for j in 0..<total_length:
                            if total[j] != accepted[p * NMAX + j]:
                                equal <- false
                        if equal:
                            duplicate <- true
                for p in 0..<candidate_count:
                    if total_length == candidate_lengths[p]:
                        equal: mutable bool = true
                        for j in 0..<total_length:
                            if total[j] != candidate_paths[p * NMAX + j]:
                                equal <- false
                        if equal:
                            duplicate <- true
                if not duplicate and candidate_count < 64:
                    for j in 0..<total_length:
                        candidate_paths[candidate_count * NMAX + j] <- total[j]
                    candidate_lengths[candidate_count] <- total_length
                    candidate_costs[candidate_count] <- total_cost
                    candidate_count <- candidate_count + 1
        if candidate_count == 0:
            break
        best_index: mutable usize = 0
        for p in 1..<candidate_count:
            better: mutable bool = false
            if candidate_costs[p] < candidate_costs[best_index]:
                better <- true
            elif candidate_costs[p] == candidate_costs[best_index]:
                shared: mutable usize = candidate_lengths[p]
                if candidate_lengths[best_index] < shared:
                    shared <- candidate_lengths[best_index]
                tie_broken: mutable bool = false
                for j in 0..<shared:
                    if candidate_paths[p * NMAX + j] != candidate_paths[best_index * NMAX + j]:
                        better <- candidate_paths[p * NMAX + j] < candidate_paths[best_index * NMAX + j]
                        tie_broken <- true
                        break
                if not tie_broken and candidate_lengths[p] < candidate_lengths[best_index]:
                    better <- true
            if better:
                best_index <- p
        for j in 0..<candidate_lengths[best_index]:
            accepted[accepted_count * NMAX + j] <- candidate_paths[best_index * NMAX + j]
        accepted_lengths[accepted_count] <- candidate_lengths[best_index]
        accepted_costs[accepted_count] <- candidate_costs[best_index]
        accepted_count <- accepted_count + 1
        candidate_count <- candidate_count - 1
        for j in 0..<candidate_lengths[candidate_count]:
            candidate_paths[best_index * NMAX + j] <- candidate_paths[candidate_count * NMAX + j]
        candidate_lengths[best_index] <- candidate_lengths[candidate_count]
        candidate_costs[best_index] <- candidate_costs[candidate_count]
    required: mutable usize = 8
    for i in 0..<accepted_count:
        required <- required + (accepted_lengths[i] + 2) * 8
    if output_capacity < required:
        return -2
    yen_put(output, 0, accepted_count.i64())
    position: mutable usize = 8
    for i in 0..<accepted_count:
        yen_put(output, position, accepted_lengths[i].i64())
        position <- position + 8
        for j in 0..<accepted_lengths[i]:
            yen_put(output, position, accepted[i * NMAX + j])
            position <- position + 8
        yen_put(output, position, accepted_costs[i])
        position <- position + 8
    required.i64()

export fn yens_kshortest_paths(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = yens_kshortest_paths_impl
