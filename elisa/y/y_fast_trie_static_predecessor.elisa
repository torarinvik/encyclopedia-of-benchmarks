const YFAST_MAX_KEYS: usize = 256
const YFAST_MAX_QUERIES: usize = 256
const YFAST_BUCKET_SIZE: usize = 16
const YFAST_MAX_BUCKETS: usize = 16
const YFAST_MAX_TRIE_NODES: usize = 257
const YFAST_MAX_INPUT: usize = 515
const YFAST_UNIVERSE_BITS: usize = 16

def yfast_successor_bucket(children: view[i64], min_rank: view[i64], leaf_rank: view[i64],
        query: i64, bucket_count: usize) -> i64:
    if bucket_count == 0: return -1
    node: mutable i64 = 0
    candidate: mutable i64 = -1
    bit_position: mutable usize = 0
    while bit_position < YFAST_UNIVERSE_BITS:
        shift: usize = YFAST_UNIVERSE_BITS - 1 - bit_position
        branch: usize = ((query.u64() >> shift) & 1.u64()).usize()
        if branch == 0:
            right_child: i64 = children[node.usize() * 2 + 1]
            if right_child >= 0: candidate <- min_rank[right_child.usize()]
        next_node: i64 = children[node.usize() * 2 + branch]
        if next_node < 0:
            node <- -1
            break
        node <- next_node
        bit_position <- bit_position + 1
    if node >= 0 and leaf_rank[node.usize()] >= 0:
        return leaf_rank[node.usize()]
    if candidate >= 0: return candidate
    (bucket_count - 1).i64()

def yfast_lower_bound(keys: view[i64], start: usize, end: usize, query: i64) -> usize:
    low: mutable usize = start
    high: mutable usize = end
    while low < high:
        middle: usize = low + (high - low) / 2
        if keys[middle] < query: low <- middle + 1
        else: high <- middle
    low

def yfast_upper_bound(keys: view[i64], start: usize, end: usize, query: i64) -> usize:
    low: mutable usize = start
    high: mutable usize = end
    while low < high:
        middle: usize = low + (high - low) / 2
        if keys[middle] <= query: low <- middle + 1
        else: high <- middle
    low

def y_fast_trie_static_predecessor_impl(values: view[i64]) -> i64:
    length: usize = values.len()
    if length < 2 or length > YFAST_MAX_INPUT: return -1
    n_value: i64 = values[0]
    q_value: i64 = values[1]
    if n_value < 0 or n_value > YFAST_MAX_KEYS.i64() or q_value < 0 or q_value > YFAST_MAX_QUERIES.i64(): return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if length != 2 + n + q or length > 514: return -1

    keys: mutable i64[YFAST_MAX_KEYS] = zeroed
    queries: mutable i64[YFAST_MAX_QUERIES] = zeroed
    index: mutable usize = 0
    while index < n:
        keys[index] <- values[2 + index]
        if keys[index] < 0 or keys[index] > 65535: return -1
        index <- index + 1
    index <- 1
    while index < n:
        key: i64 = keys[index]
        position: mutable usize = index
        while position > 0 and key < keys[position - 1]:
            keys[position] <- keys[position - 1]
            position <- position - 1
        keys[position] <- key
        index <- index + 1
    index <- 1
    while index < n:
        if keys[index] == keys[index - 1]: return -1
        index <- index + 1
    index <- 0
    while index < q:
        queries[index] <- values[2 + n + index]
        if queries[index] < 0 or queries[index] > 65535: return -1
        index <- index + 1
    if n == 0 or q == 0: return 0

    bucket_count: usize = (n + YFAST_BUCKET_SIZE - 1) / YFAST_BUCKET_SIZE
    children: mutable i64[2 * YFAST_MAX_TRIE_NODES] = zeroed
    min_rank: mutable i64[YFAST_MAX_TRIE_NODES] = zeroed
    leaf_rank: mutable i64[YFAST_MAX_TRIE_NODES] = zeroed
    node: mutable usize = 0
    while node < YFAST_MAX_TRIE_NODES:
        children[2 * node] <- -1
        children[2 * node + 1] <- -1
        min_rank[node] <- -1
        leaf_rank[node] <- -1
        node <- node + 1
    min_rank[0] <- 0
    node_count: mutable usize = 1
    bucket: mutable usize = 0
    while bucket < bucket_count:
        end: usize = (bucket + 1) * YFAST_BUCKET_SIZE
        if end > n: end <- n
        separator: i64 = keys[end - 1]
        trie_node: mutable usize = 0
        bit_position: mutable usize = 0
        while bit_position < YFAST_UNIVERSE_BITS:
            shift: usize = YFAST_UNIVERSE_BITS - 1 - bit_position
            branch: usize = ((separator.u64() >> shift) & 1.u64()).usize()
            slot: usize = trie_node * 2 + branch
            child: i64 = children[slot]
            if child < 0:
                child <- node_count.i64()
                children[slot] <- child
                children[2 * node_count] <- -1
                children[2 * node_count + 1] <- -1
                min_rank[node_count] <- bucket.i64()
                leaf_rank[node_count] <- -1
                node_count <- node_count + 1
            else if min_rank[child.usize()] < 0 or bucket.i64() < min_rank[child.usize()]:
                min_rank[child.usize()] <- bucket.i64()
            trie_node <- child.usize()
            bit_position <- bit_position + 1
        leaf_rank[trie_node] <- bucket.i64()
        bucket <- bucket + 1

    checksum: mutable i64 = 0
    index <- 0
    while index < q:
        query: i64 = queries[index]
        bucket_value: i64 = yfast_successor_bucket(children[0:2 * YFAST_MAX_TRIE_NODES],
            min_rank[0:YFAST_MAX_TRIE_NODES], leaf_rank[0:YFAST_MAX_TRIE_NODES], query, bucket_count)
        selected_bucket: usize = bucket_value.usize()
        start: usize = selected_bucket * YFAST_BUCKET_SIZE
        end: mutable usize = start + YFAST_BUCKET_SIZE
        if end > n: end <- n
        lower: usize = yfast_lower_bound(keys[0:YFAST_MAX_KEYS], start, end, query)
        upper: usize = yfast_upper_bound(keys[0:YFAST_MAX_KEYS], start, end, query)
        predecessor: mutable i64 = -1
        successor: mutable i64 = -1
        if lower > start: predecessor <- keys[lower - 1]
        else if selected_bucket > 0: predecessor <- keys[start - 1]
        if upper < end: successor <- keys[upper]
        else if selected_bucket + 1 < bucket_count: successor <- keys[end]
        term: i64 = (predecessor + 1) + 65537 * (successor + 1)
        checksum <- checksum + (index.i64() + 1) * term
        index <- index + 1
    checksum

export fn y_fast_trie_static_predecessor(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > YFAST_MAX_INPUT: return -1
    y_fast_trie_static_predecessor_impl(input[0:length])
