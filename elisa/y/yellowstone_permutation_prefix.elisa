const YPP_MAX_N: i64 = 64
const YPP_MIN_CAP: i64 = 3
const YPP_MAX_CAP: i64 = 256
const YPP_MAX_PARSEABLE_LENGTH: usize = 3

def ypp_gcd(left_value: i64, right_value: i64) -> i64:
    left: mutable i64 = left_value
    right: mutable i64 = right_value
    while right != 0:
        remainder: i64 = left % right
        left <- right
        right <- remainder
    left

def yellowstone_permutation_prefix_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 1 or input_length > YPP_MAX_PARSEABLE_LENGTH: return -1
    if input_length != 2: return -1
    requested: i64 = input[0]
    candidate_cap: i64 = input[1]
    if requested < 1 or requested > YPP_MAX_N
            or candidate_cap < YPP_MIN_CAP or candidate_cap > YPP_MAX_CAP: return -1

    terms: mutable i64[64] = zeroed
    used: mutable bool[257] = zeroed
    terms[0] <- 1
    terms[1] <- 2
    terms[2] <- 3
    if requested <= 3: return terms[requested.usize() - 1]
    used[1] <- true
    used[2] <- true
    used[3] <- true

    term_count: mutable usize = 3
    while term_count < requested.usize():
        two_back: i64 = terms[term_count - 2]
        previous: i64 = terms[term_count - 1]
        candidate: mutable i64 = 1
        while candidate <= candidate_cap:
            if not used[candidate.usize()] and ypp_gcd(candidate, two_back) > 1
                    and ypp_gcd(candidate, previous) == 1: break
            candidate <- candidate + 1
        if candidate > candidate_cap: return -1
        terms[term_count] <- candidate
        term_count <- term_count + 1
        used[candidate.usize()] <- true
    terms[requested.usize() - 1]

def yellowstone_permutation_prefix_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > YPP_MAX_PARSEABLE_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    yellowstone_permutation_prefix_impl(input_view, input_view_length)

export fn yellowstone_permutation_prefix(input: i64&, length: usize) -> i64 = yellowstone_permutation_prefix_entry
