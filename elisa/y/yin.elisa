def yin_impl(input: i64&, length: usize) -> f64:
    if length < 7 or length > 261: return -1.0e300
    count: i64 = input[0]
    rate: i64 = input[1]
    min_hz: i64 = input[2]
    max_hz: i64 = input[3]
    threshold: i64 = input[4]
    if count < 2 or count > 256 or length != (5 + count).usize() or rate < 1 or rate > 192000 or min_hz < 1 or max_hz <= min_hz or max_hz > rate / 2 or threshold < 1 or threshold > 999999:
        return -1.0e300
    n: usize = count.usize()
    i: mutable usize = 0
    while i < n:
        if input[5 + i] < -32768 or input[5 + i] > 32767: return -1.0e300
        i <- i + 1
    min_lag_i: i64 = rate / max_hz
    max_lag_i: i64 = rate / min_hz
    allowed: mutable i64 = 64
    if count - 1 < allowed: allowed <- count - 1
    if min_lag_i < 1 or min_lag_i > max_lag_i or max_lag_i > allowed: return -1.0e300
    min_lag: usize = min_lag_i.usize()
    max_lag: usize = max_lag_i.usize()
    cmndf: mutable f64[65] = zeroed
    i <- 0
    while i < 65:
        cmndf[i] <- 1.0
        i <- i + 1
    running: mutable f64 = 0.0
    lag: mutable usize = 1
    while lag <= max_lag:
        sum: mutable f64 = 0.0
        i <- 0
        while i < n - lag:
            delta: f64 = input[5 + i].f64() - input[5 + i + lag].f64()
            sum <- sum + delta * delta
            i <- i + 1
        running <- running + sum
        if running == 0.0: cmndf[lag] <- sum * lag.f64() / 1.0e-10
        else: cmndf[lag] <- sum * lag.f64() / running
        lag <- lag + 1
    threshold_float: f64 = threshold.f64() / 1000000.0
    lag <- min_lag
    while lag <= max_lag and not (cmndf[lag] < threshold_float): lag <- lag + 1
    if lag > max_lag: return -1.0e300
    while lag < max_lag and cmndf[lag + 1] < cmndf[lag]: lag <- lag + 1
    left: mutable usize = lag
    if lag > 1: left <- lag - 1
    right: mutable usize = lag
    if lag < max_lag: right <- lag + 1
    denominator: f64 = cmndf[left] - 2.0 * cmndf[lag] + cmndf[right]
    offset: mutable f64 = 0.0
    if denominator != 0.0: offset <- (cmndf[left] - cmndf[right]) / (2.0 * denominator)
    refined: f64 = lag.f64() + offset
    if not (refined > 0.0): return -1.0e300
    rate.f64() / refined

export fn yin(input: i64&, length: usize) -> f64 = yin_impl
