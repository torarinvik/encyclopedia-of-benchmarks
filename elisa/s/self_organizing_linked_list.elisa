def append_i64(records: mutable i64&, count: mutable usize&, value: i64) -> void:
    records[count] <- value
    count <- count + 1

def write_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def self_organizing_linked_list_impl(input: i64&, length: usize,
                                     output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 130: return -1
    operation_count: i64 = input[0]
    if operation_count < 0 or operation_count > 64 or
       length != (1 + 2 * operation_count).usize(): return -1

    items: mutable i64[64] = zeroed
    records: mutable i64[194] = zeroed
    item_count: mutable usize = 0
    record_count: mutable usize = 0
    cursor: mutable usize = 1
    step: mutable i64 = 0
    while step < operation_count:
        opcode: i64 = input[cursor]
        value: i64 = input[cursor + 1]
        cursor <- cursor + 2
        if value < -2147483648 or value > 2147483647: return -1
        if opcode == 0:
            if item_count == 64: return -1
            items[item_count] <- value
            item_count <- item_count + 1
            append_i64(records[0], record_count, 0)
            append_i64(records[0], record_count, 0)
        elif opcode == 1:
            found_at: mutable usize = 0
            while found_at < item_count and items[found_at] != value:
                found_at <- found_at + 1
            found: i64 = if found_at < item_count: 1 else: 0
            append_i64(records[0], record_count, 1)
            append_i64(records[0], record_count, 1)
            append_i64(records[0], record_count, found)
            if found != 0 and found_at != 0:
                index: mutable usize = found_at
                while index > 0:
                    items[index] <- items[index - 1]
                    index <- index - 1
                items[0] <- value
        else:
            return -1
        step <- step + 1

    append_i64(records[0], record_count, 2)
    append_i64(records[0], record_count, item_count.i64())
    index: mutable usize = 0
    while index < item_count:
        append_i64(records[0], record_count, items[index])
        index <- index + 1
    output_bytes: usize = record_count * 8
    if output.is_null() or capacity < output_bytes: return -2
    index <- 0
    while index < record_count:
        write_i64_le(output, index * 8, records[index])
        index <- index + 1
    return output_bytes.i64()

export fn self_organizing_linked_list(input: i64&, length: usize,
                                      output: mutable u8&, capacity: usize) -> i64 =
    self_organizing_linked_list_impl
