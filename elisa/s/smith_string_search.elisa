# Smith's combined Horspool and Quick Search shift using bounded views.
def smith_compute(values: view[i64], positions: mutable view[i64]) -> i64:
    length: usize = values.len()
    if length < 2 or length > 322 or values[0] < 0.i64() or values[0] > 255.i64() or values[1] < 1.i64() or values[1] > 64.i64():
        return -1.i64()
    n: usize = values[0].usize()
    m: usize = values[1].usize()
    if length != 2 + n + m: return -1.i64()
    for i in 0..<(n + m):
        if values[2 + i] < 0.i64() or values[2 + i] > 127.i64(): return -1.i64()

    match_count: mutable usize = 0
    if m <= n:
        horspool: mutable usize[128] = zeroed
        quick_search: mutable usize[128] = zeroed
        pattern_start: usize = 2 + n
        for byte in 0..<128:
            horspool[byte] <- m
            quick_search[byte] <- m + 1
        for i in 0..<(m - 1): horspool[values[pattern_start + i].usize()] <- m - i - 1
        for i in 0..<m: quick_search[values[pattern_start + i].usize()] <- m - i

        alignment: mutable usize = 0
        last_alignment: usize = n - m
        while alignment <= last_alignment:
            matches: mutable bool = true
            index: mutable usize = 0
            while index < m and matches:
                if values[pattern_start + index] != values[2 + alignment + index]: matches <- false
                index <- index + 1
            if matches:
                positions[match_count] <- alignment.i64()
                match_count <- match_count + 1
            end_byte: usize = values[2 + alignment + m - 1].usize()
            lookahead: usize = alignment + m
            quick_shift: usize = m + 1
            if lookahead < n: quick_shift <- quick_search[values[2 + lookahead].usize()]
            end_shift: usize = horspool[end_byte]
            if end_shift > quick_shift:
                alignment <- alignment + end_shift
            else:
                alignment <- alignment + quick_shift
    match_count.i64()

export fn smith_string_search(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 322: return -1.i64()
    positions: mutable i64[255] = zeroed
    match_count: i64 = smith_compute(input[0:length], positions[0:255])
    if match_count < 0.i64(): return -1.i64()
    output_bytes: usize = match_count.usize() * 8
    if output.is_null() or output_capacity < output_bytes: return -2.i64()
    bytes: mutable view[u8] = output[0:output_bytes]
    for i in 0..<match_count.usize():
        bits: mutable u64 = positions[i].u64()
        for byte in 0..<8:
            bytes[i * 8 + byte] <- (bits % 256.u64()).u8()
            bits <- bits / 256.u64()
    output_bytes.i64()
