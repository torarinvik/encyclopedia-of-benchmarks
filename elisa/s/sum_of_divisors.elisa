# Return the sum of all positive divisors of n by prime factorization.
def sum_of_divisors_impl(n: i64) -> i64:
    if n < 1 or n > 1000000:
        return -1
    # Every partial divisor sum is at most n times the nth harmonic number, below 15 million.
    number: u32 = n.u32()
    # The lowest set bit is the largest power of two dividing n.
    power_of_two: u32 = number & (0.u32() - number)
    if power_of_two == number:
        return 2 * n - 1
    remaining: mutable u32 = number / power_of_two
    sigma: mutable u32 = 2 * power_of_two - 1
    factor: mutable u32 = 3
    while factor * factor <= remaining:
        quotient: u32 = remaining / factor
        if quotient * factor == remaining:
            remaining <- quotient
            geometric_sum: mutable u32 = 1 + factor
            while remaining % factor == 0:
                remaining <- remaining / factor
                geometric_sum <- geometric_sum * factor + 1
            sigma <- sigma * geometric_sum
            return sigma.i64() if remaining == 1
        factor <- factor + 2
    return sigma.i64() if remaining == 1
    (sigma * remaining + sigma).i64()

export fn sum_of_divisors(n: i64) -> i64 = sum_of_divisors_impl
