const SWR_MAX_SEQUENCE_LENGTH: usize = 16
const SWR_MAX_PARSEABLE_INPUT_LENGTH: usize = 38
const SWR_MAX_OUTPUT_BYTES: usize = 1233
const SWR_MATRIX_STRIDE: usize = 17
const SWR_MATRIX_CELLS: usize = 289
const SWR_MAX_TRACE_STEPS: usize = 32

def smith_waterman_rust_write_u32(output: mutable view[u8], position: usize, value: i64) -> void:
    bits: u32 = value.u32()
    for byte in 0..<4:
        output[position + byte] <- ((bits >> (byte * 8)) & 255).u8()

def smith_waterman_rust_write_i32(output: mutable view[u8], position: usize, value: i64) -> void:
    bits: u32 = value.i32().u32()
    for byte in 0..<4:
        output[position + byte] <- ((bits >> (byte * 8)) & 255).u8()

def smith_waterman_rust_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > SWR_MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    query_length_value: i64 = input[0]
    subject_length_value: i64 = input[1]
    match_score: i64 = input[2]
    mismatch_score: i64 = input[3]
    gap_score: i64 = input[4]
    if query_length_value < 0 or query_length_value > 16 or
       subject_length_value < 0 or subject_length_value > 16 or
       match_score < 1 or match_score > 5 or
       mismatch_score < -5 or mismatch_score > -1 or
       gap_score < -5 or gap_score > -1:
        return -1
    query_length: usize = query_length_value.usize()
    subject_length: usize = subject_length_value.usize()
    if length != 5 + query_length + subject_length: return -1

    query: mutable u8[16] = zeroed
    subject: mutable u8[16] = zeroed
    for index in 0..<(query_length + subject_length):
        value: i64 = input[index + 5]
        if not ((value >= 65 and value <= 90) or (value >= 97 and value <= 122) or value == 45):
            return -1
        upper: mutable i64 = value
        if value >= 97: upper <- value - 32
        if index < query_length:
            query[index] <- upper.u8()
        else:
            subject[index - query_length] <- upper.u8()

    scores: mutable i64[SWR_MATRIX_CELLS] = zeroed
    for row in 1..<(query_length + 1):
        for column in 1..<(subject_length + 1):
            query_char: i64 = query[row - 1].i64()
            subject_char: i64 = subject[column - 1].i64()
            pair_score: mutable i64 = mismatch_score
            if query_char == 45 or subject_char == 45:
                pair_score <- gap_score
            else if query_char == subject_char:
                pair_score <- match_score
            diagonal: i64 = scores[(row - 1) * SWR_MATRIX_STRIDE + column - 1] + pair_score
            above: i64 = scores[(row - 1) * SWR_MATRIX_STRIDE + column] + gap_score
            left: i64 = scores[row * SWR_MATRIX_STRIDE + column - 1] + gap_score
            value: i64 = 0
            if diagonal > value: value <- diagonal
            if above > value: value <- above
            if left > value: value <- left
            scores[row * SWR_MATRIX_STRIDE + column] <- value

    maximum: mutable i64 = 0
    maximum_row: mutable usize = 0
    maximum_column: mutable usize = 0
    for row in 0..<(query_length + 1):
        for column in 0..<(subject_length + 1):
            value: i64 = scores[row * SWR_MATRIX_STRIDE + column]
            if value > maximum:
                maximum <- value
                maximum_row <- row
                maximum_column <- column

    align_query: mutable u8[SWR_MAX_TRACE_STEPS] = zeroed
    align_subject: mutable u8[SWR_MAX_TRACE_STEPS] = zeroed
    trace_count: mutable usize = 0
    row: mutable usize = maximum_row
    column: mutable usize = maximum_column
    while row > 0 and column > 0 and scores[row * SWR_MATRIX_STRIDE + column] > 0:
        current: i64 = scores[row * SWR_MATRIX_STRIDE + column]
        query_char: i64 = query[row - 1].i64()
        subject_char: i64 = subject[column - 1].i64()
        pair_score: mutable i64 = mismatch_score
        if query_char == 45 or subject_char == 45:
            pair_score <- gap_score
        else if query_char == subject_char:
            pair_score <- match_score

        diagonal: i64 = scores[(row - 1) * SWR_MATRIX_STRIDE + column - 1] + pair_score
        if current == diagonal:
            align_query[trace_count] <- query[row - 1]
            align_subject[trace_count] <- subject[column - 1]
            row <- row - 1
            column <- column - 1
        else if current == scores[(row - 1) * SWR_MATRIX_STRIDE + column] + gap_score:
            align_query[trace_count] <- query[row - 1]
            align_subject[trace_count] <- 45.u8()
            row <- row - 1
        else:
            align_query[trace_count] <- 45.u8()
            align_subject[trace_count] <- subject[column - 1]
            column <- column - 1
        trace_count <- trace_count + 1

    rows: usize = query_length + 1
    columns: usize = subject_length + 1
    alignment_length: usize = 0
    if trace_count > 0: alignment_length <- trace_count * 2 + 1
    payload_length: usize = 8 + rows * columns * 4 + 4 + alignment_length
    if payload_length > SWR_MAX_OUTPUT_BYTES: return -1
    if output.is_null() or output_capacity < payload_length: return -2

    payload: mutable u8[SWR_MAX_OUTPUT_BYTES] = zeroed
    position: mutable usize = 0
    smith_waterman_rust_write_u32(payload[0:SWR_MAX_OUTPUT_BYTES], position, rows.i64())
    position <- position + 4
    smith_waterman_rust_write_u32(payload[0:SWR_MAX_OUTPUT_BYTES], position, columns.i64())
    position <- position + 4
    for matrix_row in 0..<rows:
        for matrix_column in 0..<columns:
            smith_waterman_rust_write_i32(payload[0:SWR_MAX_OUTPUT_BYTES], position,
                scores[matrix_row * SWR_MATRIX_STRIDE + matrix_column])
            position <- position + 4
    smith_waterman_rust_write_u32(payload[0:SWR_MAX_OUTPUT_BYTES], position, alignment_length.i64())
    position <- position + 4
    if trace_count > 0:
        for index in 0..<trace_count:
            payload[position + index] <- align_query[trace_count - index - 1]
        payload[position + trace_count] <- 10.u8()
        for index in 0..<trace_count:
            payload[position + trace_count + 1 + index] <- align_subject[trace_count - index - 1]

    for index in 0..<payload_length:
        output[index] <- payload[index]
    payload_length.i64()

export fn smith_waterman_rust(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = smith_waterman_rust_impl
