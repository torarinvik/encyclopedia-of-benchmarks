const MAX_N: usize = 64
const MAX_OPERATIONS: usize = 64
const MAX_INPUT_LENGTH: usize = 258

def block_size_for(n: usize) -> usize:
    block_size: mutable usize = 1
    while (block_size + 1) * (block_size + 1) <= n:
        block_size <- block_size + 1
    block_size

def query_sum(elements: view[i64], blocks: view[i64], block_size: usize, start: usize, end: usize) -> i64:
    first_index_next_block: usize = ((start / block_size) + 1) * block_size
    sum: mutable i64 = elements[start]
    if first_index_next_block > end:
        index: mutable usize = start + 1
        while index < end:
            sum <- sum + elements[index]
            index <- index + 1
    else:
        index: mutable usize = start + 1
        while index < first_index_next_block:
            sum <- sum + elements[index]
            index <- index + 1
        end_block: usize = end / block_size
        block: mutable usize = first_index_next_block / block_size
        while block < end_block:
            sum <- sum + blocks[block]
            block <- block + 1
        index <- end_block * block_size
        while index < end:
            sum <- sum + elements[index]
            index <- index + 1
    sum

def put_i64_le(output: mutable view[u8], position: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def sqrt_decomposition_range_sum_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_INPUT_LENGTH: return -1
    n_arg: i64 = input[0]
    if n_arg < 1 or n_arg > MAX_N.i64(): return -1
    n: usize = n_arg.usize()
    if length < n + 2: return -1
    operation_count_arg: i64 = input[n + 1]
    if operation_count_arg < 0 or operation_count_arg > MAX_OPERATIONS.i64(): return -1
    operation_count: usize = operation_count_arg.usize()
    if length != 2 + n + 3 * operation_count: return -1

    elements: mutable i64[MAX_N] = zeroed
    index: mutable usize = 0
    while index < n:
        value: i64 = input[index + 1]
        if value < -1000 or value > 1000: return -1
        elements[index] <- value
        index <- index + 1
    query_count: mutable usize = 0
    operations_start: usize = n + 2
    operation: mutable usize = 0
    while operation < operation_count:
        offset: usize = operations_start + 3 * operation
        kind: i64 = input[offset]
        first: i64 = input[offset + 1]
        second: i64 = input[offset + 2]
        if kind == 0:
            if first < 0 or first >= second or second > n_arg: return -1
            query_count <- query_count + 1
        elif kind == 1:
            if first < 0 or first >= n_arg or second < -1000 or second > 1000: return -1
        else:
            return -1
        operation <- operation + 1

    output_bytes: usize = query_count * 8
    if output == null or capacity < output_bytes: return -2
    block_size: usize = block_size_for(n)
    blocks: mutable i64[MAX_N] = zeroed
    index <- 0
    while index < n:
        block: usize = index / block_size
        if index % block_size == 0: blocks[block] <- elements[index]
        else: blocks[block] <- blocks[block] + elements[index]
        index <- index + 1

    output_offset: mutable usize = 0
    operation <- 0
    while operation < operation_count:
        offset: usize = operations_start + 3 * operation
        kind: i64 = input[offset]
        first: i64 = input[offset + 1]
        second: i64 = input[offset + 2]
        if kind == 0:
            sum: i64 = query_sum(elements[0:n], blocks[0:n], block_size, first.usize(), second.usize())
            put_i64_le(output[0:capacity], output_offset, sum)
            output_offset <- output_offset + 8
        else:
            element_index: usize = first.usize()
            block: usize = element_index / block_size
            blocks[block] <- blocks[block] - elements[element_index] + second
            elements[element_index] <- second
        operation <- operation + 1
    output_bytes.i64()

export fn sqrt_decomposition_range_sum(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = sqrt_decomposition_range_sum_impl
