# Adapted from cp-algorithms Sqrt Tree; CC BY-SA 4.0, see package LICENSE.txt.
const MAX_ITEMS: usize = 256
const MAX_QUERIES: usize = 256
const MAX_LEVELS: usize = 16
const MAX_NODES: usize = 512
const MAX_BETWEEN: usize = 512
const MAX_INPUT_VALUES: usize = 770
const VALUE_LIMIT: i64 = 1000000000

struct SqrtTreeState:
    prefix: i64[4096]
    suffix: i64[4096]
    between: i64[8192]
    used_values: usize[16]
    used_between: usize[16]
    node_left: usize[512]
    node_right: usize[512]
    node_depth: usize[512]
    value_offset: usize[512]
    between_offset: usize[512]
    block_size: usize[512]
    block_count: usize[512]
    child_start: usize[512]
    children: usize[512]
    node_count: usize
    child_count: usize

def sqrt_tree_min(left: i64, right: i64) -> i64:
    if left < right:
        return left
    return right

def sqrt_tree_create_node(state: mutable SqrtTreeState&, left: usize, right: usize, depth: usize) -> usize:
    node: usize = state.node_count
    state.node_count <- state.node_count + 1
    state.node_left[node] <- left
    state.node_right[node] <- right
    state.node_depth[node] <- depth
    node

def sqrt_tree_build_node(state: mutable SqrtTreeState&, input: i64&, node: usize) -> void:
    left: usize = state.node_left[node]
    right: usize = state.node_right[node]
    node_length: usize = right - left
    depth: usize = state.node_depth[node]
    if node_length <= 2: return

    block_size: mutable usize = 1
    while block_size * block_size < node_length:
        block_size <- block_size + 1
    block_count: usize = (node_length + block_size - 1) / block_size
    value_offset: usize = state.used_values[depth]
    between_offset: usize = state.used_between[depth]
    state.value_offset[node] <- value_offset
    state.between_offset[node] <- between_offset
    state.block_size[node] <- block_size
    state.block_count[node] <- block_count
    state.used_values[depth] <- value_offset + node_length
    state.used_between[depth] <- between_offset + block_count * block_count

    block_min: mutable i64[256] = zeroed
    block: mutable usize = 0
    while block < block_count:
        start: usize = left + block * block_size
        end: mutable usize = start + block_size
        if end > right: end <- right
        first: usize = value_offset + start - left
        state.prefix[depth * MAX_ITEMS + first] <- input[2 + start]
        index: mutable usize = start + 1
        while index < end:
            slot: usize = value_offset + index - left
            state.prefix[depth * MAX_ITEMS + slot] <- sqrt_tree_min(
                state.prefix[depth * MAX_ITEMS + slot - 1], input[2 + index])
            index <- index + 1
        last: usize = value_offset + end - 1 - left
        state.suffix[depth * MAX_ITEMS + last] <- input[2 + end - 1]
        index <- end - 1
        while index > start:
            slot: usize = value_offset + index - 1 - left
            state.suffix[depth * MAX_ITEMS + slot] <- sqrt_tree_min(
                input[2 + index - 1], state.suffix[depth * MAX_ITEMS + slot + 1])
            index <- index - 1
        block_min[block] <- state.prefix[depth * MAX_ITEMS + last]
        block <- block + 1

    first_block: mutable usize = 0
    while first_block < block_count:
        aggregate: mutable i64 = block_min[first_block]
        last_block: mutable usize = first_block
        while last_block < block_count:
            if last_block != first_block:
                aggregate <- sqrt_tree_min(aggregate, block_min[last_block])
            state.between[depth * MAX_BETWEEN + between_offset + first_block * block_count + last_block] <- aggregate
            last_block <- last_block + 1
        first_block <- first_block + 1

    child_start: usize = state.child_count
    state.child_start[node] <- child_start
    block <- 0
    while block < block_count:
        start <- left + block * block_size
        end <- start + block_size
        if end > right: end <- right
        child: usize = sqrt_tree_create_node(state, start, end, depth + 1)
        state.children[state.child_count] <- child
        state.child_count <- state.child_count + 1
        block <- block + 1
    block <- 0
    while block < block_count:
        sqrt_tree_build_node(state, input, state.children[child_start + block])
        block <- block + 1

def sqrt_tree_query_node(state: mutable SqrtTreeState&, input: i64&, node: usize,
        left: usize, right: usize) -> i64:
    node_left: usize = state.node_left[node]
    node_right: usize = state.node_right[node]
    if node_right - node_left <= 2:
        answer: mutable i64 = input[2 + left]
        index: mutable usize = left + 1
        while index <= right:
            answer <- sqrt_tree_min(answer, input[2 + index])
            index <- index + 1
        return answer
    block_size: usize = state.block_size[node]
    left_block: usize = (left - node_left) / block_size
    right_block: usize = (right - node_left) / block_size
    if left_block == right_block:
        return sqrt_tree_query_node(state, input, state.children[state.child_start[node] + left_block], left, right)
    depth: usize = state.node_depth[node]
    offset: usize = state.value_offset[node]
    answer: mutable i64 = state.suffix[depth * MAX_ITEMS + offset + left - node_left]
    if left_block + 1 < right_block:
        count: usize = state.block_count[node]
        middle: usize = state.between_offset[node] + (left_block + 1) * count + right_block - 1
        answer <- sqrt_tree_min(answer, state.between[depth * MAX_BETWEEN + middle])
    answer <- sqrt_tree_min(answer, state.prefix[depth * MAX_ITEMS + offset + right - node_left])
    answer

def sqrt_tree_store_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255.u64()).u8()
        bits <- bits >> 8
        byte <- byte + 1

def sqrt_tree_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null || length < 2 || length > MAX_INPUT_VALUES: return -1
    item_count_value: i64 = input[0]
    query_count_value: i64 = input[1]
    if item_count_value < 1 || item_count_value > 256 || query_count_value < 0 || query_count_value > 256:
        return -1
    item_count: usize = item_count_value.usize()
    query_count: usize = query_count_value.usize()
    if length != 2 + item_count + 2 * query_count: return -1
    index: mutable usize = 0
    while index < item_count:
        if input[2 + index] < -VALUE_LIMIT || input[2 + index] > VALUE_LIMIT: return -1
        index <- index + 1
    query_offset: usize = 2 + item_count
    query: mutable usize = 0
    while query < query_count:
        left: i64 = input[query_offset + 2 * query]
        right: i64 = input[query_offset + 2 * query + 1]
        if left < 0 || right < left || right >= item_count_value: return -1
        query <- query + 1
    required: usize = 8 * query_count
    if output_capacity < required || (required > 0 && output.is_null()): return -2

    state: mutable SqrtTreeState = zeroed
    root: usize = sqrt_tree_create_node(state, 0, item_count, 0)
    sqrt_tree_build_node(state, input, root)
    query <- 0
    while query < query_count:
        left: usize = input[query_offset + 2 * query].usize()
        right: usize = input[query_offset + 2 * query + 1].usize()
        sqrt_tree_store_i64_le(output[0:required], 8 * query, sqrt_tree_query_node(state, input, root, left, right))
        query <- query + 1
    required.i64()

export fn sqrt_tree(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = sqrt_tree_impl
