const MAX_N: usize = 10
const MAX_SOLUTIONS: usize = 1024

def visit(nums: i64&, n: usize, target: i64, start: usize, current: i64, remaining: i64, path: mutable [10]i64, depth: usize, solutions: mutable [10240]i64, lens: mutable [1024]usize, count: mutable usize&): bool = {
    if current > target || remaining + current < target: return false
    if current == target:
        k: usize = count
        lens[k] <- depth
        for j in 0..<depth: solutions[k*MAX_N+j] <- path[j]
        count <- count + 1
        return false
    for i in start..<n:
        path[depth] <- nums[i]
        visit(nums,n,target,i+1,current+nums[i],remaining-nums[i],path,depth+1,solutions,lens,count)
    false
}
def put64(output: mutable u8&, pos: mutable usize&, value: i64):
    bits: u64 = value.u64()
    for j in 0..<8:
        output[pos] <- ((bits >> (8*j)) & 255).u8()
        pos <- pos + 1

def sum_of_subsets_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null || length < 2: return -1
    n0: i64 = input[0]; target: i64 = input[1]
    if n0 < 0 || n0 > 10 || length != (n0+2).usize() || target < 0 || target > 250: return -1
    n: usize = n0.usize(); nums: mutable [10]i64 = [0;10]; remaining: mutable i64 = 0
    for i in 0..<n:
        x: i64 = input[2+i]
        if x < 0 || x > 50: return -1
        nums[i] <- x; remaining <- remaining+x
    path: mutable [10]i64 = [0;10]; solutions: mutable [10240]i64 = [0;10240]; lens: mutable [1024]usize = [0;1024]; count: mutable usize = 0
    visit(&nums[0],n,target,0,0,remaining,path,0,solutions,lens,count)
    need: mutable usize = 8
    for i in 0..<count: need <- need+8+8*lens[i]
    if output == null || capacity < need: return -2
    pos: mutable usize = 0; put64(output,pos,count.i64())
    for i in 0..<count:
        put64(output,pos,lens[i].i64())
        for j in 0..<lens[i]: put64(output,pos,solutions[i*MAX_N+j])
    pos.i64()
}
export fn sum_of_subsets(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = sum_of_subsets_impl
