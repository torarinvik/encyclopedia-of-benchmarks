const MAX_N: usize = 64
const MAX_INPUT_LENGTH: usize = 66

def store_i32_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u32 = value.u32()
    output[offset] <- (bits & 255).u8()
    output[offset + 1] <- ((bits >> 8) & 255).u8()
    output[offset + 2] <- ((bits >> 16) & 255).u8()
    output[offset + 3] <- ((bits >> 24) & 255).u8()

def singly_link_list_deletion_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH: return -1
    if input[0] < 1 or input[0] > MAX_N.i64(): return -1
    n: usize = input[0].usize()
    if length != n + 2 or input[1] < 1 or input[1] > n.i64(): return -1
    index: usize = 0
    while index < n:
        if input[index + 2] < -2147483648 or input[index + 2] > 2147483647: return -1
        index <- index + 1
    bytes: usize = 4 * (n - 1)
    if output == null or capacity < bytes: return -2

    nodes: mutable i64[MAX_N] = zeroed
    next: mutable i64[MAX_N] = zeroed
    index <- 0
    while index < n:
        nodes[index] <- input[index + 2]
        if index + 1 < n: next[index] <- (index + 1).i64()
        else: next[index] <- -1
        index <- index + 1
    head: i64 = 0
    position: usize = input[1].usize()
    if position == 1: head <- next[head.usize()]
    else:
        previous: i64 = head
        index <- 2
        while index < position:
            previous <- next[previous.usize()]
            index <- index + 1
        removed: i64 = next[previous.usize()]
        next[previous.usize()] <- next[removed.usize()]
    node: i64 = head
    index <- 0
    while index < n - 1:
        store_i32_le(nodes[node.usize()], output, index * 4)
        if index + 1 < n - 1: node <- next[node.usize()]
        index <- index + 1
    bytes.i64()

export fn singly_link_list_deletion(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = singly_link_list_deletion_impl
