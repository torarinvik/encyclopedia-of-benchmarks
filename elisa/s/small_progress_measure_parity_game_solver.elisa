def spm_compare(left:view[i64],left_top:bool,right:view[i64],right_top:bool)->i64:
    if left_top!=right_top:return if left_top:1 else:-1
    if left_top:return 0
    for index in 0..<3:
        if left[index]<right[index]:return -1
        if left[index]>right[index]:return 1
    return 0

def small_progress_measure_parity_game_solver_impl(input:view[i64])->i64:
    if input.len()<6 or input.len()>59:return -1
    n_raw:i64=input[0];m_raw:i64=input[1]
    if n_raw<1 or n_raw>8 or m_raw<n_raw or m_raw>20:return -1
    n:usize=n_raw.usize();m:usize=m_raw.usize()
    if input.len()!=2+2*n+2*m:return -1

    owners:mutable i64[8]=zeroed
    priorities:mutable i64[8]=zeroed
    adjacency:mutable i64[8]=zeroed
    outdegree:mutable i64[8]=zeroed
    bounds:mutable i64[3]=zeroed
    measures:mutable i64[24]=zeroed
    tops:mutable bool[8]=zeroed
    cursor:mutable usize=2
    for vertex in 0..<n:
        owner:i64=input[cursor];priority:i64=input[cursor+1];cursor <- cursor+2
        if owner<0 or owner>1 or priority<0 or priority>5:return -1
        owners[vertex]=owner;priorities[vertex]=priority
        if priority==1:bounds[0] <- bounds[0]+1
        if priority==3:bounds[1] <- bounds[1]+1
        if priority==5:bounds[2] <- bounds[2]+1
    for _ in 0..<m:
        source_raw:i64=input[cursor];destination_raw:i64=input[cursor+1];cursor <- cursor+2
        if source_raw<0 or source_raw>=n_raw or destination_raw<0 or destination_raw>=n_raw:return -1
        source:usize=source_raw.usize();destination:usize=destination_raw.usize();bit:i64=i64(1)<<destination
        if adjacency[source]&bit!=0:return -1
        adjacency[source] <- adjacency[source]|bit;outdegree[source] <- outdegree[source]+1
    for vertex in 0..<n:if outdegree[vertex]==0:return -1

    changed:mutable bool=true
    while changed:
        changed <- false
        for vertex in 0..<n:
            best:mutable i64[3]=zeroed
            best_top:mutable bool=owners[vertex]==1
            has_best:mutable bool=false
            for destination in 0..<n:
                if adjacency[vertex]&(i64(1)<<destination)==0:continue
                candidate:mutable i64[3]=zeroed
                candidate_top:mutable bool=tops[destination]
                for index in 0..<3:candidate[index]=measures[destination*3+index]
                included:usize=if priorities[vertex]<1:0 else if priorities[vertex]<3:1 else if priorities[vertex]<5:2 else:3
                if not candidate_top:
                    for index in included..<3:candidate[index]=0
                    if priorities[vertex]%2==1:
                        rank:mutable i64=(included.i64()-1)
                        raised:mutable bool=false
                        while rank>=0 and not raised:
                            index:usize=rank.usize()
                            if candidate[index]<bounds[index]:
                                candidate[index] <- candidate[index]+1
                                suffix:mutable usize=index+1
                                while suffix<included:
                                    candidate[suffix] <- 0
                                    suffix <- suffix+1
                                raised <- true
                            else:
                                candidate[index] <- 0
                                rank <- rank-1
                        if not raised:candidate_top <- true
                order:i64=spm_compare(candidate[0:3],candidate_top,best[0:3],best_top)
                if not has_best or (owners[vertex]==0 and order<0) or (owners[vertex]==1 and order>0):
                    for index in 0..<3:best[index]=candidate[index]
                    best_top <- candidate_top
                    has_best <- true
            current_order:i64=spm_compare(measures[vertex*3:vertex*3+3],tops[vertex],best[0:3],best_top)
            if current_order<0:
                for index in 0..<3:measures[vertex*3+index]=best[index]
                tops[vertex] <- best_top
                changed <- true
    winners:mutable i64=0
    for vertex in 0..<n:if not tops[vertex]:winners <- winners|(i64(1)<<vertex)
    winners

export fn small_progress_measure_parity_game_solver(input:i64&,length:usize)->i64:
    if input.is_null() or length<6 or length>59:return -1
    small_progress_measure_parity_game_solver_impl(input[0:length])
