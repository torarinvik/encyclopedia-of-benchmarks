# Trailing moving average over a window, recomputing each window's sum.
@intrinsic("elisa.f64_to_bits")
extern streaming_moving_average_f64_bits(value: f64) -> u64

def streaming_moving_average_put_f64(output: mutable u8&, offset: usize, value: f64) -> void:
    bits: u64 = streaming_moving_average_f64_bits(value)
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte).u64()) & 255).u8()
        byte <- byte + 1

def streaming_moving_average_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 3:
        return -1
    window_value: i64 = input[0]
    count_value: i64 = input[1]
    if window_value < 1 or window_value > 256 or count_value < 1 or count_value > 256:
        return -1
    window: usize = window_value.usize()
    count: usize = count_value.usize()
    if length != count + 2:
        return -1
    i: mutable usize = 0
    while i < count:
        if input[2 + i] < -2147483648 or input[2 + i] > 2147483647:
            return -1
        i <- i + 1
    if capacity < count * 8 or output == null:
        return -2
    i <- 0
    while i < count:
        start: usize = i + 1 - window if i + 1 > window else 0
        sum: mutable i64 = 0
        j: mutable usize = start
        while j <= i:
            sum <- sum + input[2 + j]
            j <- j + 1
        streaming_moving_average_put_f64(output, i * 8, sum.f64() / (i + 1 - start).f64())
        i <- i + 1
    (count * 8).i64()

export fn streaming_moving_average(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = streaming_moving_average_impl
