const MAX_N: usize = 128
const MAX_Q: usize = 32

def srin_bit_sum(bit: i64&, count: usize) -> i64:
    i: mutable usize = count
    total: mutable i64 = 0
    while i > 0:
        total <- total + bit[i - 1]
        i <- i & (i - 1)
    total

def srin_bit_add(bit: mutable i64&, rank: usize, distinct: usize, delta: i64) -> void:
    i: mutable usize = rank
    while i < distinct:
        bit[i] <- bit[i] + delta
        i <- i | (i + 1)

# Each byte holds the number of values at or below that rank.
# Adding a rank increments every prefix at or above it, with no carry
# between bytes because even a full window contains at most 128 values.
def srin_packed_sum(prefixes: u64, bits: usize) -> i64:
    if bits == 0: return 0
    ((prefixes << (64 - bits)) >> 56).i64()

@inline(always)
def srin_sweep(queries: u32&, ranks: u16&, output: mutable u8&,
               q: usize, distinct: usize, use_packed: bool) -> void:
    bit: mutable i64[MAX_N] = zeroed
    prefixes: mutable u64 = 0
    # Start with an empty window at the first query, skipping its unused prefix.
    first_left: usize = (queries[0] & 255).usize()
    current_left: mutable usize = first_left
    current_right: mutable usize = first_left
    inversions: mutable i64 = 0
    qi: mutable usize = 0
    while qi < q:
        query: u32 = queries[qi]
        id: usize = ((query >> 8) & 31).usize()
        target_left: usize = (query & 255).usize()
        sweep: u32 = (query >> 13) & 255
        target_right: usize = (MAX_N.u32() - sweep if ((query >> 21) & 1) != 0 else sweep).usize()
        while current_left > target_left:
            current_left <- current_left - 1
            rank: usize = ranks[current_left].usize()
            inversions <- inversions + (current_right-current_left-1).i64() - (srin_packed_sum(prefixes, rank + 8) if use_packed else srin_bit_sum(&bit[0], (rank >> 3) + 1))
            if use_packed:
                prefixes <- prefixes + (0x0101010101010101.u64() << rank)
            else:
                srin_bit_add(&bit[0], rank >> 3, distinct, 1)
        while current_right < target_right:
            rank: usize = ranks[current_right].usize()
            inversions <- inversions + (srin_packed_sum(prefixes, rank) if use_packed else srin_bit_sum(&bit[0], rank >> 3))
            if use_packed:
                prefixes <- prefixes + (0x0101010101010101.u64() << rank)
            else:
                srin_bit_add(&bit[0], rank >> 3, distinct, 1)
            current_right <- current_right + 1
        while current_left < target_left:
            rank: usize = ranks[current_left].usize()
            inversions <- inversions - (current_right-current_left).i64() + (srin_packed_sum(prefixes, rank + 8) if use_packed else srin_bit_sum(&bit[0], (rank >> 3) + 1))
            if use_packed:
                prefixes <- prefixes - (0x0101010101010101.u64() << rank)
            else:
                srin_bit_add(&bit[0], rank >> 3, distinct, -1)
            current_left <- current_left + 1
        while current_right > target_right:
            current_right <- current_right - 1
            rank: usize = ranks[current_right].usize()
            inversions <- inversions - (srin_packed_sum(prefixes, rank) if use_packed else srin_bit_sum(&bit[0], rank >> 3))
            if use_packed:
                prefixes <- prefixes - (0x0101010101010101.u64() << rank)
            else:
                srin_bit_add(&bit[0], rank >> 3, distinct, -1)
        bits: u64 = inversions.u64()
        byte: mutable usize = 0
        while byte < 8:
            output[8 * id + byte] <- ((bits >> (8 * byte)) & 255).u8()
            byte <- byte + 1
        qi <- qi + 1

def srin_assign_ranks(ranked_items: u64&, ranks: mutable u16&, n: usize) -> usize:
    distinct: mutable usize = 0
    previous: mutable i64 = -1
    i: mutable usize = n
    while i > 0:
        i <- i - 1
        item: u64 = ranked_items[i]
        value: i64 = (item >> 7).i64()
        if value != previous:
            distinct <- distinct + 1
            previous <- value
        ranks[(item & 127).usize()] <- ((distinct - 1) << 3).u16()
    distinct

@inline(never)
def srin_dense_ranks(sorted: u64&, ranks: mutable u16&, n: usize) -> usize:
    high_bits: u64 = sorted[0] >> 15
    for index in 1..<n:
        if (sorted[index] >> 15) != high_bits: return 0
    # Equal high bits make the low byte sufficient to order the values.
    by_value: mutable u16[256] = zeroed
    low: mutable usize = 255
    high: mutable usize = 0
    for index in 0..<n:
        value: usize = ((sorted[index] >> 7) & 255).usize()
        by_value[value] <- 1
        low <- value if value < low
        high <- value if value > high
    distinct: mutable usize = 0
    remaining: mutable usize = high + 1
    while remaining > low:
        remaining <- remaining - 1
        if by_value[remaining] != 0:
            by_value[remaining] <- (distinct << 3).u16()
            distinct <- distinct + 1
    for index in 0..<n:
        item: u64 = sorted[index]
        ranks[(item & 127).usize()] <- by_value[((item >> 7) & 255).usize()]
    distinct

def static_range_inversions_query_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 195: return -1
    n64: i64 = input[0]
    q64: i64 = input[1]
    if (n64.u64() - 1) >= 128 or (q64.u64() - 1) >= 32: return -1
    n: usize = n64.usize()
    q: usize = q64.usize()
    if length != 2 + n + 2 * q: return -1
    sorted: mutable u64[MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        value: i64 = input[2 + i]
        if value.u64() > 1000000000: return -1
        sorted[i] <- (value.u64() << 7) | i.u64()
        i <- i + 1
    block_size: mutable usize = 1
    while (block_size + 1) * (block_size + 1) <= n:
        block_size <- block_size + 1
    queries: mutable u32[MAX_Q] = zeroed
    off: mutable usize = 2 + n
    k: mutable usize = 0
    while k < q:
        left: i64 = input[off]
        right: i64 = input[off + 1]
        off <- off + 2
        if left.u64() >= right.u64() or right.u64() > n64.u64(): return -1
        block: u32 = (left.usize() / block_size).u32()
        endpoint: u32 = right.u32()
        sweep: u32 = MAX_N.u32() - endpoint if (block & 1) != 0 else endpoint
        # Sort by block, sweep, then original ID. The endpoints travel with the key.
        queries[k] <- (block << 21) | (sweep << 13) | (k.u32() << 8) | left.u32()
        k <- k + 1
    bytes: usize = 8 * q
    if output == null or capacity < bytes: return -2
    # Gapped insertion passes limit long shifts on larger inputs.
    ordered: mutable usize = 1
    while ordered < n and sorted[ordered - 1] <= sorted[ordered]:
        ordered <- ordered + 1
    # Every subrange of a nondecreasing input has zero inversions.
    if ordered == n:
        for byte in 0..<bytes:
            output[byte] <- 0
        return bytes.i64()
    # A low-byte rank table suffices when all values share their high bits.
    ranks: mutable u16[MAX_N] = zeroed
    distinct: mutable usize = srin_dense_ranks(&sorted[0],&ranks[0],n) if n >= 32 else 0
    if distinct == 0:
        if n >= 16:
            gap: mutable usize = 4
            while gap < n / 3:
                gap <- 3 * gap + 1
            while gap > 1:
                i <- gap
                while i < n:
                    value: u64 = sorted[i]
                    j: mutable usize = i
                    while j >= gap and sorted[j - gap] > value:
                        sorted[j] <- sorted[j - gap]
                        j <- j - gap
                    sorted[j] <- value
                    i <- i + 1
                gap <- (gap - 1) / 3
        i <- 1
        while i < n:
            value: u64 = sorted[i]
            j: mutable usize = i
            while j > 0 and sorted[j - 1] > value:
                sorted[j] <- sorted[j - 1]
                j <- j - 1
            sorted[j] <- value
            i <- i + 1
        distinct <- srin_assign_ranks(&sorted[0],&ranks[0],n)
    i <- 1
    while i < q:
        query: u32 = queries[i]
        j: mutable usize = i
        while j > 0 and query < queries[j - 1]:
            queries[j] <- queries[j - 1]
            j <- j - 1
        queries[j] <- query
        i <- i + 1
    # All input data needed by the sweep is now in ranks and query keys.
    if distinct <= 8:
        srin_sweep(&queries[0],&ranks[0],output,q,distinct,true)
    else:
        srin_sweep(&queries[0],&ranks[0],output,q,distinct,false)
    bytes.i64()

export fn static_range_inversions_query(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = static_range_inversions_query_impl
