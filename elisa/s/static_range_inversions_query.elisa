# Inversion counts of static ranges, answered offline with Mo's ordering
# and a Fenwick tree over value ranks.
const MAX_N: usize = 128
const MAX_Q: usize = 32

def lower_bound_i64(sorted: view[i64], count: usize, value: i64) -> usize:
    low: mutable usize = 0
    high: mutable usize = count
    while low < high:
        middle: usize = low + (high - low) / 2
        if sorted[middle] < value:
            low <- middle + 1
        else:
            high <- middle
    low

def bit_sum(bit: view[i64], count_input: usize) -> i64:
    sum: mutable i64 = 0
    count: mutable usize = count_input
    while count != 0:
        sum <- sum + bit[count]
        count <- count - (count & (~count + 1))
    sum

def bit_add(bit: mutable view[i64], rank: usize, delta: i64) -> void:
    index: mutable usize = rank + 1
    while index <= MAX_N:
        bit[index] <- bit[index] + delta
        index <- index + (index & (~index + 1))

def before(block_a: usize, right_a: usize, id_a: usize, block_b: usize, right_b: usize, id_b: usize) -> bool:
    if block_a != block_b:
        return block_a < block_b
    if right_a != right_b:
        return right_a > right_b if (block_a & 1) != 0 else right_a < right_b
    id_a < id_b

def static_range_inversions_query_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 195:
        return -1
    n64: i64 = input[0]
    q64: i64 = input[1]
    if n64 < 1 or n64 > MAX_N.i64() or q64 < 1 or q64 > MAX_Q.i64():
        return -1
    n: usize = n64.usize()
    q: usize = q64.usize()
    if length != 2 + n + 2 * q:
        return -1
    values: mutable i64[128] = zeroed
    sorted: mutable i64[128] = zeroed
    i: mutable usize = 0
    while i < n:
        values[i] <- input[2 + i]
        if values[i] < 0 or values[i] > 1000000000:
            return -1
        sorted[i] <- values[i]
        i <- i + 1
    i <- 1
    while i < n:
        x: i64 = sorted[i]
        j: mutable usize = i
        while j != 0 and sorted[j - 1] > x:
            sorted[j] <- sorted[j - 1]
            j <- j - 1
        sorted[j] <- x
        i <- i + 1
    distinct: mutable usize = 0
    i <- 0
    while i < n:
        if distinct == 0 or sorted[i] != sorted[distinct - 1]:
            sorted[distinct] <- sorted[i]
            distinct <- distinct + 1
        i <- i + 1
    rank: mutable usize[128] = zeroed
    i <- 0
    while i < n:
        rank[i] <- lower_bound_i64(sorted[0:128], distinct, values[i])
        i <- i + 1

    query_left: mutable usize[32] = zeroed
    query_right: mutable usize[32] = zeroed
    query_id: mutable usize[32] = zeroed
    query_block: mutable usize[32] = zeroed
    offset: mutable usize = 2 + n
    block: mutable usize = 1
    while (block + 1) * (block + 1) <= n:
        block <- block + 1
    k: mutable usize = 0
    while k < q:
        l: i64 = input[offset]
        r: i64 = input[offset + 1]
        offset <- offset + 2
        if l < 0 or l >= r or r > n64:
            return -1
        query_left[k] <- l.usize()
        query_right[k] <- r.usize()
        query_id[k] <- k
        query_block[k] <- l.usize() / block
        k <- k + 1
    i <- 1
    while i < q:
        x_left: usize = query_left[i]
        x_right: usize = query_right[i]
        x_id: usize = query_id[i]
        x_block: usize = query_block[i]
        j: mutable usize = i
        while j != 0 and before(x_block, x_right, x_id, query_block[j - 1], query_right[j - 1], query_id[j - 1]):
            query_left[j] <- query_left[j - 1]
            query_right[j] <- query_right[j - 1]
            query_id[j] <- query_id[j - 1]
            query_block[j] <- query_block[j - 1]
            j <- j - 1
        query_left[j] <- x_left
        query_right[j] <- x_right
        query_id[j] <- x_id
        query_block[j] <- x_block
        i <- i + 1

    bit: mutable i64[129] = zeroed
    answers: mutable i64[32] = zeroed
    left: mutable usize = 0
    right: mutable usize = 0
    window: mutable usize = 0
    inversions: mutable i64 = 0
    qi: mutable usize = 0
    while qi < q:
        target_left: usize = query_left[qi]
        target_right: usize = query_right[qi]
        while left > target_left:
            left <- left - 1
            x: usize = rank[left]
            inversions <- inversions + bit_sum(bit[0:129], x)
            bit_add(bit[0:129], x, 1)
            window <- window + 1
        while right < target_right:
            x: usize = rank[right]
            inversions <- inversions + window.i64() - bit_sum(bit[0:129], x + 1)
            bit_add(bit[0:129], x, 1)
            window <- window + 1
            right <- right + 1
        while left < target_left:
            x: usize = rank[left]
            inversions <- inversions - bit_sum(bit[0:129], x)
            bit_add(bit[0:129], x, -1)
            window <- window - 1
            left <- left + 1
        while right > target_right:
            right <- right - 1
            x: usize = rank[right]
            inversions <- inversions - (window.i64() - bit_sum(bit[0:129], x + 1))
            bit_add(bit[0:129], x, -1)
            window <- window - 1
        answers[query_id[qi]] <- inversions
        qi <- qi + 1

    bytes: usize = 8 * q
    if output == null or capacity < bytes:
        return -2
    k <- 0
    while k < q:
        bits: u64 = answers[k].u64()
        b: mutable usize = 0
        while b < 8:
            output[8 * k + b] <- ((bits >> (8 * b)) & 255).u8()
            b <- b + 1
        k <- k + 1
    bytes.i64()

export fn static_range_inversions_query(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = static_range_inversions_query_impl
