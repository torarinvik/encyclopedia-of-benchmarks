from std.collections import InlineArray

def same_value_teleport_bfs_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > 65: return -2
    if input[0] < 1 or input[0] > 64 or length != input[0].usize() + 1: return -2
    let n = input[0].usize()
    for i in 0..<n:
        if input[i + 1] < -64 or input[i + 1] > 64: return -2
    if n == 1: return 0

    var first = InlineArray[Int32, 129](fill=-1)
    var next = InlineArray[Int32, 64](fill=-1)
    var queue = InlineArray[usize, 64](fill=0)
    var distance = InlineArray[Int32, 64](fill=-1)
    for i in 0..<n:
        let slot = (input[i + 1] + 64).usize()
        next[i] = first[slot]
        first[slot] = i.i32()
    var front: mutable usize = 0
    var back: mutable usize = 1
    queue[0] = 0
    distance[0] = 0
    while front < back:
        let index = queue[front]
        front <- front + 1
        if index == n - 1: return distance[index].i64()
        if index > 0 and distance[index - 1] < 0:
            distance[index - 1] = distance[index] + 1
            queue[back] = index - 1
            back <- back + 1
        if index + 1 < n and distance[index + 1] < 0:
            distance[index + 1] = distance[index] + 1
            queue[back] = index + 1
            back <- back + 1
        let slot = (input[index + 1] + 64).usize()
        var member: mutable i32 = first[slot]
        if member >= 0:
            first[slot] = -1
            while member >= 0:
                let member_index = member.usize()
                if distance[member_index] < 0:
                    distance[member_index] = distance[index] + 1
                    queue[back] = member_index
                    back <- back + 1
                member <- next[member_index]
    distance[n - 1].i64()

export fn same_value_teleport_bfs(input: i64&, length: usize) -> i64 = same_value_teleport_bfs_impl
