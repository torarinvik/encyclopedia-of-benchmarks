# Intersect three strictly increasing arrays and emit ascending signed i64 values.
const ARRAY_COUNT: usize = 3
const MAX_ARRAY_LENGTH: usize = 64
const BYTES_PER_VALUE: usize = 4

def sorted_arrays_intersection_store_i32(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u32 = value.u32()
    output[position] <- (bits & 255).u8()
    output[position + 1] <- ((bits >> 8) & 255).u8()
    output[position + 2] <- ((bits >> 16) & 255).u8()
    output[position + 3] <- ((bits >> 24) & 255).u8()

def sorted_arrays_intersection_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length < ARRAY_COUNT or length > ARRAY_COUNT * (MAX_ARRAY_LENGTH + 1):
        return -1
    starts: mutable usize[ARRAY_COUNT] = zeroed
    sizes: mutable usize[ARRAY_COUNT] = zeroed
    position: mutable usize = 0
    array: mutable usize = 0
    while array < ARRAY_COUNT:
        if position >= length or input[position] < 0 or input[position] > i64(MAX_ARRAY_LENGTH):
            return -1
        size: usize = input[position].usize()
        position <- position + 1
        if size > length - position:
            return -1
        starts[array] <- position
        sizes[array] <- size
        index: mutable usize = 0
        while index < size:
            if input[position + index] < -2147483648 or input[position + index] > 2147483647:
                return -1
            if index > 0 and input[position + index - 1] >= input[position + index]:
                return -1
            index <- index + 1
        position <- position + size
        array <- array + 1
    if position != length:
        return -1
    maximum_result: usize = sizes[0]
    if sizes[1] < maximum_result:
        maximum_result <- sizes[1]
    if sizes[2] < maximum_result:
        maximum_result <- sizes[2]
    if output_capacity < maximum_result * BYTES_PER_VALUE or (maximum_result > 0 and output == null):
        return -2

    cursor: mutable usize[ARRAY_COUNT] = zeroed
    result_count: mutable usize = 0
    while cursor[0] < sizes[0] and cursor[1] < sizes[1] and cursor[2] < sizes[2]:
        first: i64 = input[starts[0] + cursor[0]]
        second: i64 = input[starts[1] + cursor[1]]
        third: i64 = input[starts[2] + cursor[2]]
        if first == second and first == third:
            sorted_arrays_intersection_store_i32(first, output, result_count * BYTES_PER_VALUE)
            result_count <- result_count + 1
            cursor[0] <- cursor[0] + 1
            cursor[1] <- cursor[1] + 1
            cursor[2] <- cursor[2] + 1
        else if first < second:
            cursor[0] <- cursor[0] + 1
        else if second < third:
            cursor[1] <- cursor[1] + 1
        else:
            cursor[2] <- cursor[2] + 1
    result_count.i64()

export fn sorted_arrays_intersection(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = sorted_arrays_intersection_impl
