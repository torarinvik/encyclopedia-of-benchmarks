def sphere_impl(input: i64&, length: usize) -> f64:
    if length != 2:
        return -1.0e300
    mode: i64 = input[0]
    radius: i64 = input[1]
    if (mode != 0 and mode != 1) or radius < 0 or radius > 1000000:
        return -1.0e300
    r: f64 = f64(radius)
    r2: f64 = r * r
    pi: f64 = 3.14159265358979323846
    if mode == 0:
        return (((r2 * r) * pi) * 4.0) / 3.0
    return (r2 * pi) * 4.0

export fn sphere(input: i64&, length: usize) -> f64 = sphere_impl
