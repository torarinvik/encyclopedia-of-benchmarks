const MAX_LENGTH: i64 = 10
const MAX_SUPPORT: usize = 11

def spatial_choose(total:i64,selected0:i64)->i64:
    if total<0 or selected0<0 or selected0>total:return 0
    selected:mutable i64=selected0
    if selected>total-selected:selected<-total-selected
    result:mutable i64=1;factor:mutable i64=1
    while factor<=selected:result<-result*(total-selected+factor)/factor;factor<-factor+1
    result

def spatial_multinomial3(total:i64,first:i64,second:i64)->i64:
    if total<0 or first<0 or second<0 or first>total or second>total or first+second>total:return 0
    spatial_choose(total,first)*spatial_choose(total-first,second)

def spatial_gcd(left0:i64,right0:i64)->i64:
    left:mutable i64=left0;right:mutable i64=right0
    while right!=0:remainder:mutable i64=left%right;left<-right;right<-remainder
    left

def spatial_put_i64(value:i64,output:mutable view[u8],word:usize):
    bits:u64=value.u64();byte:mutable usize=0
    while byte<8:output[word*8+byte]<-((bits>>(byte*8))&255).u8();byte<-byte+1

def spatial_motif_different_type_contact_pmf(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("spatial_motif_different_type_contact_pmf"):
    if input.is_null() or length!=5:return -1
    n0:i64=input[0];x10:i64=input[1];y10:i64=input[2];x20:i64=input[3];y20:i64=input[4]
    if n0<1 or n0>MAX_LENGTH or x10<0 or y10<0 or x20<0 or y20<0 or x10>n0 or y10>n0 or x20>n0 or y20>n0:return -1
    if x10+y10>n0 or x20+y20>n0:return -1

    n: i64=n0;x1:i64=x10;y1:i64=y10;x2:i64=x20;y2:i64=y20
    neither1:=n-x1-y1;denominator:=spatial_multinomial3(n,x2,y2)
    numerators:mutable i64[MAX_SUPPORT]=zeroed
    m:mutable i64=0
    while m<=n:
        h:mutable i64=0
        while h<=x1:
            i:mutable i64=0
            while i<=x1-h:
                j:=m-i
                if j>=0 and j<=y1:
                    k:mutable i64=0
                    while k<=y1-j:
                        ways:=spatial_multinomial3(x1,h,i)*spatial_multinomial3(y1,j,k)*spatial_multinomial3(neither1,x2-h-j,y2-i-k)
                        numerators[m.usize()]<-numerators[m.usize()]+ways
                        k<-k+1
                i<-i+1
            h<-h+1
        m<-m+1

    expected_num:mutable i64=0;m<-0
    while m<=n:expected_num<-expected_num+m*numerators[m.usize()];m<-m+1
    expected_den:mutable i64=denominator;divisor:=spatial_gcd(expected_num,expected_den)
    expected_num<-expected_num/divisor;expected_den<-expected_den/divisor
    bytes:usize=(n.usize()+5)*8
    if output.is_null() or capacity<bytes:return -2
    spatial_put_i64(n,output[0:bytes],0);spatial_put_i64(denominator,output[0:bytes],1)
    m<-0
    while m<=n:spatial_put_i64(numerators[m.usize()],output[0:bytes],m.usize()+2);m<-m+1
    spatial_put_i64(expected_num,output[0:bytes],n.usize()+3);spatial_put_i64(expected_den,output[0:bytes],n.usize()+4)
    bytes.i64()
