# Recursive Sylvester recurrence on the signed 64-bit benchmark domain.
def sylvester_term(n: i64) -> i64:
    if n == 1:
        return 2
    previous: i64 = sylvester_term(n - 1)
    previous * (previous - 1) + 1

def sylvester_sequence_impl(n: i64) -> i64:
    if n < 1 or n > 7:
        return -1
    sylvester_term(n)

export fn sylvester_sequence(n: i64) -> i64 = sylvester_sequence_impl
