const STAR_MAX_DEPTH: usize = 2
const STAR_DIAGONAL_INPUT: usize = 16
const STAR_FAN_INPUT: usize = 24
const STAR_MAX_VERTICES: usize = 5
const STAR_MAX_TRIANGLES: usize = 4
const STAR_MAX_EDGES: usize = 8
const STAR_MAX_PAIRS: usize = 64
const STAR_MAX_OUTPUT_BYTES: usize = 1032

def star_stops(edges: u64&, edge_count: usize, bounds: u64) -> bool:
    guards: u64 = 0x8080808080808080
    candidates: mutable u64 = 31
    for edge in 0..<edge_count:
        if ((edges[2*edge] - bounds) & guards) == guards:
            candidates <- candidates & edges[2*edge+1]
            if candidates == 0: return false
    true

# Every triangle edge in the validated mesh is horizontal, vertical, or diagonal.
# Overlap on the four corresponding axes is sufficient for the closed box test.
# Each signed projection lies between -16 and 16. Bias each byte to
# keep its top bit free as a guard against borrow into the next lane.
def star_pack_cell(x: i32, y: i32, size: i32) -> u64:
    # Each lane is affine in the left edge, top edge and side length.
    # A vertex uses the same formula with a zero side length.
    (0x1010101010101010.u64() +
        x.u64() * 0xfeff00ffffff01.u64() +
        y.u64() * 0xff00ff00ff010000.u64() +
        size.u64() * 0xfffdfefefffeff00.u64())

def star_visit(triangles: u64&, edges: u64&, triangle_count: usize,
               edge_count: usize, pairs: mutable i64&) -> i32:
    pair_count: mutable usize = 0
    key: mutable usize = 0
    # Every accepted mesh contains the four boundary edges. They all hit
    # the root and share no endpoint, so the root always splits.
    stride: mutable usize = 4
    while key < 16:
        # A cell is identified by the Morton key of its first finest-level cell.
        xmin: i32 = (2 * (key & 1) + (key & 4)).i32()
        ymax: i32 = 8 - ((key & 2) + ((key & 8) >> 1)).i32()
        size: i32 = 2 if stride == 1 else 4
        bounds: u64 = star_pack_cell(xmin,ymax,size)
        if not star_stops(edges,edge_count,bounds):
            if stride == 1: return -1
            stride <- 1
        else:
            guards: u64 = 0x8080808080808080
            for tid in 0..<triangle_count:
                if ((triangles[tid] - bounds) & guards) == guards:
                    if pair_count >= STAR_MAX_PAIRS: return -1
                    pairs[2*pair_count] <- key.i64()
                    pairs[2*pair_count+1] <- tid.i64()
                    pair_count <- pair_count + 1
            key <- key + stride
            # Each group of four finest cells starts at depth one.

            stride <- 4 if (key & 3) == 0 else 1
    pair_count.i32()

def star_store_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset+byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

@inline(never)
def star_validate_mesh(input: i64&, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    vertex_count_raw: i64 = input[0]
    triangle_count_raw: i64 = input[1]
    if not ((vertex_count_raw == 4 and triangle_count_raw == 2) or
            (vertex_count_raw == 5 and triangle_count_raw == 4)): return -1
    vertex_count: usize = vertex_count_raw.usize()
    triangle_count: usize = triangle_count_raw.usize()
    if length != 2 + 2*vertex_count + 3*triangle_count: return -1
    corners: i64[8] = [0,0,8,0,8,8,0,8]
    vertices_data: mutable i32[10] = zeroed
    vertices: mutable i32& = &vertices_data[0]
    i: mutable usize = 0
    while i < 8:
        if input[2+i] != corners[i]: return -1
        vertices[i] <- corners[i].i32()
        i <- i + 1
    if vertex_count == 5:
        if input[10] != 4 or input[11] != 4: return -1
        vertices[8] <- 4
        vertices[9] <- 4
    triangles_data: mutable i32[12] = zeroed
    triangles: mutable i32& = &triangles_data[0]
    start: usize = 2 + 2*vertex_count
    i <- 0
    while i < 3*triangle_count:
        id: i64 = input[start+i]
        if id < 0 or id >= vertex_count_raw: return -1
        triangles[i] <- id.i32()
        i <- i + 1
    diag02: bool = vertex_count == 4 and triangles[0] == 0 and triangles[1] == 1 and triangles[2] == 2 and
        triangles[3] == 0 and triangles[4] == 2 and triangles[5] == 3
    diag13: bool = vertex_count == 4 and triangles[0] == 0 and triangles[1] == 1 and triangles[2] == 3 and
        triangles[3] == 1 and triangles[4] == 2 and triangles[5] == 3
    fan: i32[12] = [0,1,4,1,2,4,2,3,4,3,0,4]
    fan_ok: mutable bool = vertex_count == 5
    i <- 0
    while i < 12:
        if triangles[i] != fan[i]: fan_ok <- false
        i <- i + 1
    if not diag02 and not diag13 and not fan_ok: return -1
    star_mesh_output(vertices,triangles,vertex_count,triangle_count,output,capacity)

def star_bounds_union(left: u64, right: u64) -> u64:
    # Each guard bit records whether the left lane is at least the right lane.
    guards: u64 = 0x8080808080808080
    choose_left: u64 = ((((left | guards) - right) & guards) >> 7) * 255
    right ^ ((left ^ right) & choose_left)

@inline(never)
def star_mesh_output(vertices: i32&, triangles: i32&, vertex_count: usize, triangle_count: usize,
                     output: mutable u8&?, capacity: usize) -> i64:
    vertex_projections: mutable u64[5] = zeroed
    for vertex in 0..<vertex_count:
        x: i32 = vertices[2*vertex]
        y: i32 = vertices[2*vertex+1]
        vertex_projections[vertex] <- star_pack_cell(x,y,0)
    projections_data: mutable u64[4] = zeroed
    projections: mutable u64& = &projections_data[0]
    edges_data: mutable u64[16] = zeroed
    edges: mutable u64& = &edges_data[0]
    edge_count: mutable usize = 0
    seen_edges: mutable u32 = 0
    tid: mutable usize = 0
    while tid < triangle_count:
        a: usize = triangles[3*tid].usize()
        b: usize = triangles[3*tid+1].usize()
        c: usize = triangles[3*tid+2].usize()
        bounds: u64 = star_bounds_union(vertex_projections[a],vertex_projections[b])
        projections[tid] <- star_bounds_union(bounds,vertex_projections[c]) | 0x8080808080808080.u64()
        k: mutable usize = 0
        while k < 3:
            a: usize = triangles[3*tid+k].usize()
            b: usize = triangles[3*tid+(k+1)%3].usize()
            low: usize = a if a < b else b
            high: usize = b if a < b else a
            # Validated vertex IDs are in 0..4, so 25 bits cover all pairs.
            edge_bit: u32 = 1.u32() << (5 * low + high)
            if (seen_edges & edge_bit) == 0:
                seen_edges <- seen_edges | edge_bit
                slot: usize = 2 * edge_count
                edges[slot] <- (star_bounds_union(vertex_projections[low],vertex_projections[high]) |
                    0x8080808080808080.u64())
                edges[slot+1] <- (1.u64() << low) | (1.u64() << high)
                edge_count <- edge_count + 1
            k <- k + 1
        tid <- tid + 1
    pairs_data: mutable i64[128] = zeroed
    pairs: mutable i64& = &pairs_data[0]
    result: i32 = star_visit(projections,edges,triangle_count,edge_count,
        pairs)
    if result < 0: return -1
    pair_count: usize = result.usize()
    required: usize = (1 + 2*pair_count)*8
    if output == null or capacity < required: return -2
    star_store_le(output,0,pair_count.i64())
    i: mutable usize = 0
    while i < pair_count:
        star_store_le(output,8+16*i,pairs[2*i])
        star_store_le(output,16+16*i,pairs[2*i+1])
        i <- i + 1
    required.i64()

def star_quadtree_fat_triangulation_impl(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64:
    if input == null: return -1
    if length != STAR_DIAGONAL_INPUT and length != STAR_FAN_INPUT: return -1
    star_validate_mesh(input,length,output,capacity)

export fn star_quadtree_fat_triangulation(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64 = star_quadtree_fat_triangulation_impl
