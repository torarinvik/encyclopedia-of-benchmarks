# Quadtree over an 8x8 square split until each cell touches only edges that
# share a vertex, then list which triangles each leaf cell overlaps.
const MAX_VERTICES: usize = 5
const MAX_TRIANGLES: usize = 4
const MAX_EDGES: usize = 8
const MAX_PAIRS: usize = 64
const MAX_DEPTH: i64 = 2
const MAX_INPUT: usize = 25
const MAX_OUTPUT: usize = 1032

struct StarMesh:
    vertex_x: i64[5]
    vertex_y: i64[5]
    triangles: i64[12]
    edge_a: i64[8]
    edge_b: i64[8]
    vertex_count: i64
    triangle_count: i64
    edge_count: i64

struct StarBox:
    xmin: i64
    ymin: i64
    xmax: i64
    ymax: i64

def star_orient(ax: i64, ay: i64, bx: i64, by: i64, cx: i64, cy: i64) -> i64:
    (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)

def star_between(a: i64, b: i64, p: i64) -> bool:
    (a <= p and p <= b) or (b <= p and p <= a)

def star_on_segment(ax: i64, ay: i64, bx: i64, by: i64, px: i64, py: i64) -> bool:
    star_between(ax, bx, px) and star_between(ay, by, py)

def star_segments_intersect(ax: i64, ay: i64, bx: i64, by: i64, cx: i64, cy: i64, dx: i64, dy: i64) -> bool:
    o1: i64 = star_orient(ax, ay, bx, by, cx, cy)
    o2: i64 = star_orient(ax, ay, bx, by, dx, dy)
    o3: i64 = star_orient(cx, cy, dx, dy, ax, ay)
    o4: i64 = star_orient(cx, cy, dx, dy, bx, by)
    if ((o1 < 0 and o2 > 0) or (o1 > 0 and o2 < 0)) and ((o3 < 0 and o4 > 0) or (o3 > 0 and o4 < 0)):
        return true
    (o1 == 0 and star_on_segment(ax, ay, bx, by, cx, cy)) or (o2 == 0 and star_on_segment(ax, ay, bx, by, dx, dy)) or (o3 == 0 and star_on_segment(cx, cy, dx, dy, ax, ay)) or (o4 == 0 and star_on_segment(cx, cy, dx, dy, bx, by))

def star_segment_hits_box_sides(ax: i64, ay: i64, bx: i64, by: i64, cell: StarBox) -> bool:
    star_segments_intersect(ax, ay, bx, by, cell.xmin, cell.ymin, cell.xmax, cell.ymin) or star_segments_intersect(ax, ay, bx, by, cell.xmax, cell.ymin, cell.xmax, cell.ymax) or star_segments_intersect(ax, ay, bx, by, cell.xmax, cell.ymax, cell.xmin, cell.ymax) or star_segments_intersect(ax, ay, bx, by, cell.xmin, cell.ymax, cell.xmin, cell.ymin)

def star_inside(cell: StarBox, x: i64, y: i64) -> bool:
    cell.xmin <= x and x <= cell.xmax and cell.ymin <= y and y <= cell.ymax

def star_edge_hits_box(mesh: StarMesh&, edge_id: usize, cell: StarBox) -> bool:
    a: usize = mesh.edge_a[edge_id].usize()
    b: usize = mesh.edge_b[edge_id].usize()
    ax: i64 = mesh.vertex_x[a]
    ay: i64 = mesh.vertex_y[a]
    bx: i64 = mesh.vertex_x[b]
    by: i64 = mesh.vertex_y[b]
    if star_inside(cell, ax, ay) or star_inside(cell, bx, by):
        return true
    star_segment_hits_box_sides(ax, ay, bx, by, cell)

def star_stop_cell(mesh: StarMesh&, cell: StarBox) -> bool:
    touched: mutable bool[8] = zeroed
    touched_count: mutable i64 = 0
    e: mutable usize = 0
    while e.i64() < mesh.edge_count:
        touched[e] <- star_edge_hits_box(mesh, e, cell)
        if touched[e]:
            touched_count <- touched_count + 1
        e <- e + 1
    if touched_count == 0:
        return true
    v: mutable i64 = 0
    while v < mesh.vertex_count:
        common: mutable bool = true
        e <- 0
        while e.i64() < mesh.edge_count:
            if touched[e] and mesh.edge_a[e] != v and mesh.edge_b[e] != v:
                common <- false
                break
            e <- e + 1
        if common:
            return true
        v <- v + 1
    false

def star_point_in_triangle(mesh: StarMesh&, px: i64, py: i64, a: usize, b: usize, c: usize) -> bool:
    o1: i64 = star_orient(mesh.vertex_x[a], mesh.vertex_y[a], mesh.vertex_x[b], mesh.vertex_y[b], px, py)
    o2: i64 = star_orient(mesh.vertex_x[b], mesh.vertex_y[b], mesh.vertex_x[c], mesh.vertex_y[c], px, py)
    o3: i64 = star_orient(mesh.vertex_x[c], mesh.vertex_y[c], mesh.vertex_x[a], mesh.vertex_y[a], px, py)
    o1 >= 0 and o2 >= 0 and o3 >= 0

def star_triangle_hits_box(mesh: StarMesh&, tid: usize, cell: StarBox) -> bool:
    t0: usize = mesh.triangles[3 * tid].usize()
    t1: usize = mesh.triangles[3 * tid + 1].usize()
    t2: usize = mesh.triangles[3 * tid + 2].usize()
    i: mutable usize = 0
    while i < 3:
        v: usize = mesh.triangles[3 * tid + i].usize()
        if star_inside(cell, mesh.vertex_x[v], mesh.vertex_y[v]):
            return true
        i <- i + 1
    if star_point_in_triangle(mesh, cell.xmin, cell.ymin, t0, t1, t2) or star_point_in_triangle(mesh, cell.xmax, cell.ymin, t0, t1, t2) or star_point_in_triangle(mesh, cell.xmax, cell.ymax, t0, t1, t2) or star_point_in_triangle(mesh, cell.xmin, cell.ymax, t0, t1, t2):
        return true
    i <- 0
    while i < 3:
        edge: usize = mesh.triangles[3 * tid + i].usize()
        next: usize = mesh.triangles[3 * tid + (i + 1) % 3].usize()
        if star_segment_hits_box_sides(mesh.vertex_x[edge], mesh.vertex_y[edge], mesh.vertex_x[next], mesh.vertex_y[next], cell):
            return true
        i <- i + 1
    false

# Visit one quadtree cell; returns the new pair count, or -1 once a cell
# would split past the depth limit or the pair table overflows.
def star_visit(mesh: StarMesh&, depth: i64, ix: i64, iy: i64, path_code: i64, pairs: mutable view[i64], pair_count: i64) -> i64:
    size: i64 = 8 >> depth
    xmin: i64 = ix * size
    ymax: i64 = 8 - iy * size
    cell: StarBox = StarBox{xmin: xmin, ymin: ymax - size, xmax: xmin + size, ymax: ymax}
    if not star_stop_cell(mesh, cell):
        if depth >= MAX_DEPTH:
            return -1
        count: mutable i64 = pair_count
        q: mutable i64 = 0
        while q < 4:
            count <- star_visit(mesh, depth + 1, 2 * ix + (q & 1), 2 * iy + (q >> 1), 4 * path_code + q, pairs, count)
            if count < 0:
                return -1
            q <- q + 1
        return count
    key: i64 = path_code << (2 * (MAX_DEPTH - depth))
    count: mutable i64 = pair_count
    t: mutable usize = 0
    while t.i64() < mesh.triangle_count:
        if star_triangle_hits_box(mesh, t, cell):
            if count >= MAX_PAIRS.i64():
                return -1
            pairs[2 * count.usize()] <- key
            pairs[2 * count.usize() + 1] <- t.i64()
            count <- count + 1
        t <- t + 1
    count

def star_store_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    i: mutable usize = 0
    while i < 8:
        output[offset + i] <- ((bits >> (8 * i).u64()) & 255).u8()
        i <- i + 1

def star_quadtree_fat_triangulation_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT:
        return -1
    if not ((input[0] == 4 and input[1] == 2) or (input[0] == 5 and input[1] == 4)):
        return -1
    v: i64 = input[0]
    t: i64 = input[1]
    if length != (2 + 2 * v + 3 * t).usize():
        return -1
    corners: i64[8] = [0, 0, 8, 0, 8, 8, 0, 8]
    vertex_x: mutable i64[5] = zeroed
    vertex_y: mutable i64[5] = zeroed
    i: mutable usize = 0
    while i < 4:
        x: i64 = input[2 + 2 * i]
        y: i64 = input[3 + 2 * i]
        if x != corners[2 * i] or y != corners[2 * i + 1]:
            return -1
        vertex_x[i] <- x
        vertex_y[i] <- y
        i <- i + 1
    if v == 5:
        if input[10] != 4 or input[11] != 4:
            return -1
        vertex_x[4] <- 4
        vertex_y[4] <- 4
    start: usize = (2 + 2 * v).usize()
    triangles: mutable i64[12] = zeroed
    i <- 0
    while i.i64() < t:
        j: mutable usize = 0
        while j < 3:
            id: i64 = input[start + 3 * i + j]
            if id < 0 or id >= v:
                return -1
            triangles[3 * i + j] <- id
            j <- j + 1
        i <- i + 1
    if v == 4:
        diagonal_02: bool = triangles[0] == 0 and triangles[1] == 1 and triangles[2] == 2 and triangles[3] == 0 and triangles[4] == 2 and triangles[5] == 3
        diagonal_13: bool = triangles[0] == 0 and triangles[1] == 1 and triangles[2] == 3 and triangles[3] == 1 and triangles[4] == 2 and triangles[5] == 3
        if not diagonal_02 and not diagonal_13:
            return -1
    else:
        fan: i64[12] = [0, 1, 4, 1, 2, 4, 2, 3, 4, 3, 0, 4]
        i <- 0
        while i < 12:
            if input[start + i] != fan[i]:
                return -1
            i <- i + 1
    edge_a: mutable i64[8] = zeroed
    edge_b: mutable i64[8] = zeroed
    edge_count: mutable usize = 0
    i <- 0
    while i < 3 * t.usize():
        first: i64 = triangles[i]
        second: i64 = triangles[i - i % 3 + (i % 3 + 1) % 3]
        a: i64 = first if first < second else second
        b: i64 = second if first < second else first
        known: mutable bool = false
        e: mutable usize = 0
        while e < edge_count:
            if edge_a[e] == a and edge_b[e] == b:
                known <- true
            e <- e + 1
        if not known:
            if edge_count >= MAX_EDGES:
                return -1
            edge_a[edge_count] <- a
            edge_b[edge_count] <- b
            edge_count <- edge_count + 1
        i <- i + 1
    mesh: StarMesh = StarMesh{vertex_x: vertex_x, vertex_y: vertex_y, triangles: triangles, edge_a: edge_a, edge_b: edge_b, vertex_count: v, triangle_count: t, edge_count: edge_count.i64()}

    pairs: mutable i64[128] = zeroed
    pair_count: i64 = star_visit(&mesh, 0, 0, 0, 0, pairs[0:2 * MAX_PAIRS], 0)
    if pair_count < 0:
        return -1
    bytes: usize = (1 + 2 * pair_count.usize()) * 8
    if bytes > MAX_OUTPUT:
        return -1
    if output == null or capacity < bytes:
        return -2
    star_store_i64_le(output, 0, pair_count)
    cursor: mutable usize = 8
    i <- 0
    while i < 2 * pair_count.usize():
        star_store_i64_le(output, cursor, pairs[i])
        cursor <- cursor + 8
        i <- i + 1
    bytes.i64()

export fn star_quadtree_fat_triangulation(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = star_quadtree_fat_triangulation_impl
