# Return the first pattern occurrence using a direct character-by-character scan.
def str_str_brute_force_impl(input_values: i64&, length: usize) -> i64:
    if length < 2 or length > 2050:
        return -1
    text_length_value: i64 = input_values[0]
    pattern_length_value: i64 = input_values[1]
    if text_length_value < 0 or text_length_value > 1024:
        return -1
    if pattern_length_value < 0 or pattern_length_value > 1024:
        return -1
    text_length: usize = text_length_value.usize()
    pattern_length: usize = pattern_length_value.usize()
    if length != 2 + text_length + pattern_length:
        return -1

    valid_input: bool =
        while index < text_length + pattern_length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = input_values[2 + index]
            if value < 1 or value > 127:
                break false
            index <- index + 1
            valid
    if not valid_input:
        return -1
    if pattern_length == 0:
        return 0
    if pattern_length > text_length:
        return -1

    pattern_start: usize = 2 + text_length
    result: i64 =
        while start <= text_length - pattern_length |start: mutable usize = 0, result: mutable i64 = -1| -> result:
            matches: bool =
                while offset < pattern_length |offset: mutable usize = 0, equal: mutable bool = true| -> equal:
                    if input_values[2 + start + offset] != input_values[pattern_start + offset]:
                        break false
                    offset <- offset + 1
            if matches:
                break start.i64()
            start <- start + 1
            result
    result

export fn str_str_brute_force(input_values: i64&, length: usize) -> i64 = str_str_brute_force_impl
