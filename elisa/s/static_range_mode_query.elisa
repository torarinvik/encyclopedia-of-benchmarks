# Static range mode queries using whole-block modes and occurrence lists.
const MAX_N: usize = 32
const MAX_Q: usize = 16
const MAX_BLOCKS: usize = 6
const MAX_INPUT_LENGTH: usize = 66

def lower_bound_i64(values: view[i64], begin_input: usize, end_input: usize, target: i64) -> usize:
    begin: mutable usize = begin_input
    end: mutable usize = end_input
    while begin < end:
        middle: usize = begin + (end - begin) / 2
        if values[middle] < target:
            begin <- middle + 1
        else:
            end <- middle
    begin

def lower_bound_size(values: view[usize], begin_input: usize, end_input: usize, target: usize) -> usize:
    begin: mutable usize = begin_input
    end: mutable usize = end_input
    while begin < end:
        middle: usize = begin + (end - begin) / 2
        if values[middle] < target:
            begin <- middle + 1
        else:
            end <- middle
    begin

def range_frequency(occurrences: view[usize], offsets: view[usize], id: usize, left: usize, right: usize) -> usize:
    begin: usize = offsets[id]
    end: usize = offsets[id + 1]
    lower_bound_size(occurrences, begin, end, right) - lower_bound_size(occurrences, begin, end, left)

def write_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def static_range_mode_query_impl(input: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    if n_value < 1 or n_value > MAX_N.i64() or q_value < 1 or q_value > MAX_Q.i64():
        return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if length != 2 + n + 2 * q:
        return -1
    index: mutable usize = 0
    while index < n:
        if input[2 + index] < 0 or input[2 + index] > 1000000000:
            return -1
        index <- index + 1
    query: mutable usize = 0
    while query < q:
        left: i64 = input[2 + n + 2 * query]
        right: i64 = input[3 + n + 2 * query]
        if left < 0 or right <= left or right > n_value:
            return -1
        query <- query + 1
    if output == null or output_capacity < 16 * q:
        return -2

    sorted: mutable i64[32] = zeroed
    unique_values: mutable i64[32] = zeroed
    compressed: mutable usize[32] = zeroed
    frequencies: mutable usize[32] = zeroed
    offsets: mutable usize[33] = zeroed
    cursor: mutable usize[32] = zeroed
    occurrences: mutable usize[32] = zeroed
    block_mode: mutable usize[36] = zeroed
    index <- 0
    while index < n:
        value: i64 = input[2 + index]
        position: mutable usize = index
        while position > 0 and sorted[position - 1] > value:
            sorted[position] <- sorted[position - 1]
            position <- position - 1
        sorted[position] <- value
        index <- index + 1
    distinct: mutable usize = 0
    index <- 0
    while index < n:
        if distinct == 0 or sorted[index] != unique_values[distinct - 1]:
            unique_values[distinct] <- sorted[index]
            distinct <- distinct + 1
        index <- index + 1

    index <- 0
    while index < n:
        id: usize = lower_bound_i64(unique_values[0:32], 0, distinct, input[2 + index])
        compressed[index] <- id
        frequencies[id] <- frequencies[id] + 1
        index <- index + 1
    id: mutable usize = 0
    while id < distinct:
        offsets[id + 1] <- offsets[id] + frequencies[id]
        id <- id + 1
    id <- 0
    while id < distinct:
        cursor[id] <- offsets[id]
        id <- id + 1
    index <- 0
    while index < n:
        occurrences[cursor[compressed[index]]] <- index
        cursor[compressed[index]] <- cursor[compressed[index]] + 1
        index <- index + 1

    block_size: mutable usize = 1
    while block_size * block_size < n:
        block_size <- block_size + 1
    block_count: usize = (n + block_size - 1) / block_size
    frequency: mutable usize[32] = zeroed
    first: mutable usize = 0
    while first < block_count:
        id <- 0
        while id < distinct:
            frequency[id] <- 0
            id <- id + 1
        best_id: mutable usize = 0
        best_count: mutable usize = 0
        last: mutable usize = first
        while last < block_count:
            begin: usize = last * block_size
            end: mutable usize = begin + block_size
            if end > n:
                end <- n
            index <- begin
            while index < end:
                current: usize = compressed[index]
                frequency[current] <- frequency[current] + 1
                count: usize = frequency[current]
                if count > best_count or (count == best_count and current < best_id):
                    best_id <- current
                    best_count <- count
                index <- index + 1
            block_mode[first * MAX_BLOCKS + last] <- best_id
            last <- last + 1
        first <- first + 1

    query <- 0
    while query < q:
        left: usize = input[2 + n + 2 * query].usize()
        right: usize = input[3 + n + 2 * query].usize()
        first_full: usize = (left + block_size - 1) / block_size
        after_full: usize = right / block_size
        best_id: mutable usize = 0
        best_count: mutable usize = 0
        if first_full < after_full:
            best_id <- block_mode[first_full * MAX_BLOCKS + after_full - 1]
            best_count <- range_frequency(occurrences[0:32], offsets[0:33], best_id, left, right)
            span_start: usize = first_full * block_size
            span_end: usize = after_full * block_size
            index <- left
            while index < span_start:
                current: usize = compressed[index]
                count: usize = range_frequency(occurrences[0:32], offsets[0:33], current, left, right)
                if count > best_count or (count == best_count and current < best_id):
                    best_id <- current
                    best_count <- count
                index <- index + 1
            index <- span_end
            while index < right:
                current: usize = compressed[index]
                count: usize = range_frequency(occurrences[0:32], offsets[0:33], current, left, right)
                if count > best_count or (count == best_count and current < best_id):
                    best_id <- current
                    best_count <- count
                index <- index + 1
        else:
            index <- left
            while index < right:
                current: usize = compressed[index]
                count: usize = range_frequency(occurrences[0:32], offsets[0:33], current, left, right)
                if count > best_count or (count == best_count and current < best_id):
                    best_id <- current
                    best_count <- count
                index <- index + 1
        write_i64(output, 16 * query, unique_values[best_id])
        write_i64(output, 16 * query + 8, best_count.i64())
        query <- query + 1
    (16 * q).i64()

export fn static_range_mode_query(input: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64 = static_range_mode_query_impl
