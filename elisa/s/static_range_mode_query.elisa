# Static range mode queries with whole-block modes and occurrence bitmasks.
const MAX_N: usize = 32
const MAX_Q: usize = 16
const MAX_BLOCKS: usize = 6
const MAX_INPUT_LENGTH: usize = 66

def mode_frequency(positions: u32, range_mask: u32) -> usize:
    bits: u32 = positions & range_mask
    pairs: u32 = bits - ((bits >> 1) & 0x55555555.u32())
    nibbles: u32 = (pairs & 0x33333333.u32()) + ((pairs >> 2) & 0x33333333.u32())
    bytes: u32 = (nibbles + (nibbles >> 4)) & 0x0f0f0f0f.u32()
    ((bytes * 0x01010101.u32()) >> 24).usize()

def mode_write_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

@inline(always)
def mode_insert(sorted: mutable i64&, index: usize, value: i64) -> void:
    position: mutable usize = index
    while position > 0 and sorted[position - 1] > value:
        sorted[position] <- sorted[position - 1]
        position <- position - 1
    sorted[position] <- value

def static_range_mode_query_impl(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or input_length < 2 or input_length > MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    if n_value < 1 or n_value > 32 or q_value < 1 or q_value > 16:
        return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if input_length != 2 + n + 2 * q:
        return -1
    for index in 0..<n:
        value: i64 = input[2 + index]
        if value < 0 or value > 1000000000:
            return -1
    for query in 0..<q:
        left: i64 = input[2 + n + 2 * query]
        right: i64 = input[3 + n + 2 * query]
        if left < 0 or right <= left or right > n_value:
            return -1
    if output == null or output_capacity < 16 * q:
        return -2

    sorted: mutable i64[MAX_N] = zeroed
    unique_values: mutable u32[MAX_N] = zeroed
    compressed: mutable u8[MAX_N] = zeroed
    positions: mutable u32[MAX_N] = zeroed
    block_mode: mutable u8[MAX_BLOCKS * MAX_BLOCKS] = zeroed
    if n >= 16:
        for index in 0..<n:
            sorted[index] <- (input[2 + index] << 5) | index.i64()
        # A gap of four limits long shifts before the final insertion pass.
        for index in 4..<n:
            value: i64 = sorted[index]
            position: mutable usize = index
            while position >= 4 and sorted[position - 4] > value:
                sorted[position] <- sorted[position - 4]
                position <- position - 4
            sorted[position] <- value
        for index in 1..<n:
            mode_insert(&sorted[0], index, sorted[index])
    else:
        for index in 0..<n:
            mode_insert(&sorted[0], index, (input[2 + index] << 5) | index.i64())

    # The low five bits carry the original position through the sort.
    distinct: mutable usize = 0
    previous: mutable i64 = -1
    for index in 0..<n:
        item: i64 = sorted[index]
        value: i64 = item >> 5
        if value != previous:
            unique_values[distinct] <- value.u32()
            distinct <- distinct + 1
            previous <- value
        id: usize = distinct - 1
        position: usize = (item & 31).usize()
        compressed[position] <- id.u8()
        positions[id] <- positions[id] | (1.u32() << position)

    # Round the block width up to a power of two for shift-based indexing.
    block_shift: usize = 1 if n <= 4 else (2 if n <= 16 else 3)
    block_size: usize = 1.usize() << block_shift
    # Extend each starting block’s histogram only as far as requested.
    row_counts: mutable u8[MAX_BLOCKS * MAX_N] = zeroed
    row_score: mutable usize[MAX_BLOCKS] = zeroed
    row_end: mutable usize[MAX_BLOCKS] = zeroed
    answers: mutable i64[2 * MAX_Q] = zeroed
    for query in 0..<q:
        left: usize = input[2 + n + 2 * query].usize()
        right: usize = input[3 + n + 2 * query].usize()
        # Use a wider word so the final right endpoint may be 32.
        range_mask: u32 = ((1.u64() << right) - (1.u64() << left)).u32()
        first_full: usize = (left + block_size - 1) >> block_shift
        after_full: usize = right >> block_shift
        best_id: mutable usize = 0
        # Minimize rank minus 32 times frequency, so ties favor the smaller rank.
        best_score_query: mutable i64 = 0
        if first_full < after_full:
            span_start: usize = first_full << block_shift
            span_end: usize = after_full << block_shift
            slot: usize = first_full * MAX_BLOCKS + after_full - 1
            stored: u8 = block_mode[slot]
            if stored == 0:
                next_block: mutable usize = first_full if row_end[first_full] == 0 else row_end[first_full]
                best_score: mutable usize = row_score[first_full]
                count_base: usize = first_full * MAX_N
                while next_block < after_full:
                    begin: usize = next_block << block_shift
                    for index in begin..<(begin + block_size):
                        id: usize = compressed[index].usize()
                        count_slot: usize = count_base + id
                        count: u8 = row_counts[count_slot] + 1
                        row_counts[count_slot] <- count
                        score: usize = (count.usize() << 5) | (31 - id)
                        best_score <- score if score > best_score
                    block_mode[first_full * MAX_BLOCKS + next_block] <- (32 - (best_score & 31)).u8()
                    next_block <- next_block + 1
                row_end[first_full] <- after_full
                row_score[first_full] <- best_score
                best_id <- 31 - (best_score & 31)
            else:
                best_id <- stored.usize() - 1
            best_score_query <- best_id.i64() - (mode_frequency(positions[best_id], range_mask).i64() << 5)
            for index in left..<span_start:
                id: usize = compressed[index].usize()
                score: i64 = id.i64() - (mode_frequency(positions[id], range_mask).i64() << 5)
                best_score_query <- score if score < best_score_query
            for index in span_end..<right:
                id: usize = compressed[index].usize()
                score: i64 = id.i64() - (mode_frequency(positions[id], range_mask).i64() << 5)
                best_score_query <- score if score < best_score_query
        else:
            for index in left..<right:
                id: usize = compressed[index].usize()
                score: i64 = id.i64() - (mode_frequency(positions[id], range_mask).i64() << 5)
                best_score_query <- score if score < best_score_query
        answers[2 * query] <- unique_values[(best_score_query & 31).usize()].i64()
        answers[2 * query + 1] <- 0 - (best_score_query >> 5)
    for answer in 0..<(2 * q):
        mode_write_i64(output, 8 * answer, answers[answer])
    (16 * q).i64()

export fn static_range_mode_query(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64 = static_range_mode_query_impl
