# Static range mode queries with whole-block modes and occurrence bitmasks.
const MAX_N: usize = 32
const MAX_Q: usize = 16
const MAX_BLOCKS: usize = 6
const MAX_INPUT_LENGTH: usize = 66

def mode_frequency(positions: u32, range_mask: u32) -> usize:
    bits: u32 = positions & range_mask
    pairs: u32 = bits - ((bits >> 1) & 0x55555555.u32())
    nibbles: u32 = (pairs & 0x33333333.u32()) + ((pairs >> 2) & 0x33333333.u32())
    bytes: u32 = (nibbles + (nibbles >> 4)) & 0x0f0f0f0f.u32()
    ((bytes * 0x01010101.u32()) >> 24).usize()

def mode_write_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def static_range_mode_query_impl(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or input_length < 2 or input_length > MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    if n_value < 1 or n_value > 32 or q_value < 1 or q_value > 16:
        return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if input_length != 2 + n + 2 * q:
        return -1
    for index in 0..<n:
        value: i64 = input[2 + index]
        if value < 0 or value > 1000000000:
            return -1
    for query in 0..<q:
        left: i64 = input[2 + n + 2 * query]
        right: i64 = input[3 + n + 2 * query]
        if left < 0 or right <= left or right > n_value:
            return -1
    if output == null or output_capacity < 16 * q:
        return -2

    sorted: mutable i64[MAX_N] = zeroed
    unique_values: mutable i64[MAX_N] = zeroed
    compressed: mutable usize[MAX_N] = zeroed
    positions: mutable u32[MAX_N] = zeroed
    block_mode: mutable usize[MAX_BLOCKS * MAX_BLOCKS] = zeroed
    for index in 0..<n:
        value: i64 = (input[2 + index] << 5) | index.i64()
        position: mutable usize = index
        while position > 0 and sorted[position - 1] > value:
            sorted[position] <- sorted[position - 1]
            position <- position - 1
        sorted[position] <- value

    # The low five bits carry the original position through the sort.
    distinct: mutable usize = 0
    previous: mutable i64 = -1
    for index in 0..<n:
        item: i64 = sorted[index]
        value: i64 = item >> 5
        if value != previous:
            unique_values[distinct] <- value
            distinct <- distinct + 1
            previous <- value
        id: usize = distinct - 1
        position: usize = (item & 31).usize()
        compressed[position] <- id
        positions[id] <- positions[id] | (1.u32() << position)

    block_size: mutable usize = 1
    while block_size * block_size < n:
        block_size <- block_size + 1
    block_count: usize = (n + block_size - 1) / block_size
    frequency: mutable u8[MAX_N] = zeroed
    for first in 0..<block_count:
        for id in 0..<distinct:
            frequency[id] <- 0
        best_score: mutable usize = 0
        last: mutable usize = first
        while last < block_count:
            begin: usize = last * block_size
            end: mutable usize = begin + block_size
            if end > n: end <- n
            for index in begin..<end:
                id: usize = compressed[index]
                frequency[id] <- frequency[id] + 1
                # Larger counts win, then smaller ranks.
                score: usize = (frequency[id].usize() << 5) | (31 - id)
                best_score <- score if score > best_score
            block_mode[first * MAX_BLOCKS + last] <- 31 - (best_score & 31)
            last <- last + 1

    answers: mutable i64[2 * MAX_Q] = zeroed
    for query in 0..<q:
        left: usize = input[2 + n + 2 * query].usize()
        right: usize = input[3 + n + 2 * query].usize()
        # Use a wider word so the final right endpoint may be 32.
        range_mask: u32 = ((1.u64() << right) - (1.u64() << left)).u32()
        first_full: usize = (left + block_size - 1) / block_size
        after_full: usize = right / block_size
        best_id: mutable usize = 0
        best_count: mutable usize = 0
        if first_full < after_full:
            best_id <- block_mode[first_full * MAX_BLOCKS + after_full - 1]
            best_count <- mode_frequency(positions[best_id], range_mask)
            span_start: usize = first_full * block_size
            span_end: usize = after_full * block_size
            for index in left..<span_start:
                id: usize = compressed[index]
                count: usize = mode_frequency(positions[id], range_mask)
                if count > best_count or (count == best_count and id < best_id):
                    best_id <- id
                    best_count <- count
            for index in span_end..<right:
                id: usize = compressed[index]
                count: usize = mode_frequency(positions[id], range_mask)
                if count > best_count or (count == best_count and id < best_id):
                    best_id <- id
                    best_count <- count
        else:
            for index in left..<right:
                id: usize = compressed[index]
                count: usize = mode_frequency(positions[id], range_mask)
                if count > best_count or (count == best_count and id < best_id):
                    best_id <- id
                    best_count <- count
        answers[2 * query] <- unique_values[best_id]
        answers[2 * query + 1] <- best_count.i64()
    for answer in 0..<(2 * q):
        mode_write_i64(output, 8 * answer, answers[answer])
    (16 * q).i64()

export fn static_range_mode_query(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64 = static_range_mode_query_impl
