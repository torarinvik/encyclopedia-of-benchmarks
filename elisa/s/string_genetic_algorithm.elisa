# Seeded, bounded string evolution with fixed population and portable byte output.
def string_genetic_algorithm_next_random(state: mutable u64&) -> u64:
    # Since 2^31 is congruent to 1, fold the high bits and reduce once.
    modulus: u64 = 2147483647
    product: u64 = state * 48271.u64()
    folded: u64 = (product & modulus) + (product >> 31)
    # Adding one carries into bit 31 exactly when the folded value reaches the modulus.
    state <- (folded + ((folded + 1) >> 31)) & modulus
    state

def string_genetic_algorithm_write_i64(output: mutable u8&, offset: usize, value: u32) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255.u64()).u8()

def string_genetic_algorithm_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if values == null or length < 6 or length > 44:
        return -2
    target_length_value: i64 = values[0]
    gene_count_value: i64 = values[1]
    seed_value: i64 = values[2]
    max_generations_value: i64 = values[3]
    if target_length_value < 1 or target_length_value > 8 or gene_count_value < 1 or gene_count_value > 32:
        return -2
    if seed_value < 1 or seed_value >= 2147483647 or max_generations_value < 1 or max_generations_value > 1000:
        return -2
    target_length: usize = target_length_value.usize()
    gene_count: usize = gene_count_value.usize()
    max_generations: usize = max_generations_value.usize()
    if length != 4 + target_length + gene_count:
        return -2
    genes: mutable u8[32] = zeroed
    target_word: mutable u64 = 0
    target_low: mutable u64 = 0
    target_high: mutable u64 = 0
    for index in 0..<target_length:
        value: i64 = values[4 + index]
        if value < 32 or value > 126:
            return -2
        target_word <- target_word | (value.u64() << (8 * index))
        bit: u64 = 1.u64() << (value.u64() & 63)
        if value < 64:
            target_low <- target_low | bit
        else:
            target_high <- target_high | bit
    gene_low: mutable u64 = 0
    gene_high: mutable u64 = 0
    for index in 0..<gene_count:
        value: i64 = values[4 + target_length + index]
        if value < 32 or value > 126:
            return -2
        genes[index] <- value.u8()
        bit: u64 = 1.u64() << (value.u64() & 63)
        if value < 64:
            gene_low <- gene_low | bit
        else:
            gene_high <- gene_high | bit
    if (target_low & ~gene_low) != 0 or (target_high & ~gene_high) != 0 or output == null:
        return -2

    if gene_count == 1:
        if output_capacity < 16: return -2
        string_genetic_algorithm_write_i64(output, 0, 1)
        string_genetic_algorithm_write_i64(output, 8, 200)
        return 16

    # Every random gene index is reduced modulo the validated gene count.
    gene_table: u8& = &genes[0]
    population: mutable u64[200] = zeroed
    next_population: mutable u64[200] = zeroed
    mismatches: mutable u8[200] = zeroed
    state: mutable u64 = seed_value.u64()
    for individual in 0..<200 |individual, population, gene_table, state, target_length, gene_count, target_word, output, output_capacity|:
        word: mutable u64 = 0.u64()
        for position in 0..<target_length:
            gene_index: usize = (string_genetic_algorithm_next_random(state) % gene_count.u64()).usize()
            word <- (word >> 8) | (gene_table[gene_index].u64() << 56)
        candidate: u64 = word >> ((8 - target_length) * 8)
        if candidate == target_word:
            if output_capacity < 16: return -2
            string_genetic_algorithm_write_i64(output, 0, 1)
            string_genetic_algorithm_write_i64(output, 8, 200)
            return 16
        population[individual] <- candidate

    generation: mutable usize = 1
    while generation < max_generations |generation, population, mismatches, target_word, target_length, output, next_population, state, gene_table, gene_count|:
        for individual in 0..<200:
            # ASCII XOR leaves the high bit clear. Adding 127 flags each unequal byte.
            difference: u64 = population[individual] ^ target_word
            unequal: u64 = ((difference + 0x7f7f7f7f7f7f7f7f.u64()) >> 7) & 0x0101010101010101.u64()
            mismatch_count: usize = ((unequal * 0x0101010101010101.u64()) >> 56).usize()
            mismatches[individual] <- mismatch_count.u8()
            if mismatch_count == 0:
                if output_capacity < 16:
                    return -2
                string_genetic_algorithm_write_i64(output, 0, generation.u32())
                string_genetic_algorithm_write_i64(output, 8, generation.u32() * 200)
                return 16
        # Count mismatch buckets, then scatter in population order to preserve ties.
        offsets: mutable usize[9] = zeroed
        # Mismatch counts range from zero through eight.
        buckets: mutable usize& = &offsets[0]
        for individual in 0..<200:
            rank: usize = mismatches[individual].usize()
            buckets[rank] <- buckets[rank] + 1
        offset: mutable usize = 0
        for rank in 0..<9:
            count: usize = buckets[rank]
            buckets[rank] <- offset
            offset <- offset + count
        for individual in 0..<200:
            rank: usize = mismatches[individual].usize()
            destination: usize = buckets[rank]
            if destination < 66:
                next_population[destination] <- population[individual]
            buckets[rank] <- destination + 1
        # After scattering, this bucket ends just before the zero-fitness parents.
        positive_parents: usize = buckets[target_length - 1]
        next_count: mutable usize = 66
        # Pairs start at an even index below 200, so both slots exist.
        offspring: mutable u64& = &next_population[0]
        for parent_rank in 0..<50 |parent_rank, next_count, positive_parents, target_length, state, gene_table, gene_count, next_population|:
            if next_count >= 200:
                break
            first: u64 = next_population[parent_rank]
            # Every positive fitness reaches the cap for target lengths from one to eight.
            child_count: usize = 10 if parent_rank < positive_parents else 1
            for round in 0..<child_count |round, next_count, state, first, target_length, gene_table, gene_count, next_population, offspring|:
                if next_count >= 200:
                    break
                second: u64 = next_population[(string_genetic_algorithm_next_random(state) % 51.u64()).usize()]
                cut: usize = (string_genetic_algorithm_next_random(state) % target_length.u64()).usize()
                # The low bytes come from one parent and the high bytes from the other.
                low_mask: u64 = (1.u64() << (8 * cut)) - 1
                exchanged: u64 = (first ^ second) & low_mask
                children: mutable u64[2] = [second ^ exchanged, first ^ exchanged]
                for child in 0..<2 |child, children, state, target_length, gene_table, gene_count, next_count, offspring|:
                    if string_genetic_algorithm_next_random(state) % 5.u64() < 2.u64():
                        position: usize = (string_genetic_algorithm_next_random(state) % target_length.u64()).usize()
                        replacement_index: usize = (string_genetic_algorithm_next_random(state) % gene_count.u64()).usize()
                        shift: usize = 8 * position
                        mask: u64 = 255.u64() << shift
                        children[child] <- (children[child] & ~mask) | (gene_table[replacement_index].u64() << shift)
                    offspring[next_count + child] <- children[child]
                next_count <- next_count + 2
        for index in 0..<200:
            population[index] <- next_population[index]
        generation <- generation + 1
    # The last generation needs equality only because it has no offspring.
    if generation != 1:
        for individual in 0..<200:
            if population[individual] == target_word:
                if output_capacity < 16: return -2
                string_genetic_algorithm_write_i64(output, 0, generation.u32())
                string_genetic_algorithm_write_i64(output, 8, generation.u32() * 200)
                return 16
    -1

export fn string_genetic_algorithm(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = string_genetic_algorithm_impl
