const ST_N: usize = 4
const ST_MAX_INPUT: usize = 37

struct ST_Edge:
    u: usize
    v: usize
    w: u32

def st_put_i64(output: mutable u8&, word: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for b in 0..<8:
        output[word * 8 + b] <- (bits & 255).u8()
        bits <- bits >> 8

# Component labels occupy four two-bit fields, initially 0, 1, 2 and 3.
const SINGLETON_LABELS: u32 = 0xe4

def st_label(labels: u32, value: usize) -> usize:
    ((labels >> (2*value)) & 3).usize()

def st_join(labels: mutable u32&, a: usize, b: usize) -> bool:
    ra: usize = st_label(labels, a)
    rb: usize = st_label(labels, b)
    if ra == rb:
        return false
    differing: u32 = labels ^ (rb.u32() * 0x55)
    matching: u32 = ~(differing | (differing >> 1)) & 0x55
    labels <- labels ^ (matching * (ra ^ rb).u32())
    true

@intrinsic("llvm.cttz.i32")
extern st_trailing_zeros(value: u32, zero_undefined: bool) -> u32

def st_count_vertices(bits: u32) -> usize:
    pairs: u32 = bits - ((bits >> 1) & 5)
    ((pairs & 3) + (pairs >> 2)).usize()

def st_group_count(mask: i64, h: u32) -> usize:
    labels: mutable u32 = SINGLETON_LABELS
    pending: mutable u32 = h
    while pending != 0:
        edge: usize = st_trailing_zeros(pending, true).usize()
        st_join(&labels, edge >> 2, edge & 3)
        pending <- pending & (pending - 1)
    seen: mutable u32 = 0
    vertices: mutable u32 = mask.u32()
    while vertices != 0:
        vertex: usize = st_trailing_zeros(vertices, true).usize()
        bit: u32 = 1.u32() << st_label(labels, vertex)
        seen <- seen | bit
        vertices <- vertices & (vertices - 1)
    st_count_vertices(seen)

def st_less(a: ST_Edge, b: ST_Edge) -> bool:
    a.w < b.w or (a.w == b.w and (a.u < b.u or (a.u == b.u and a.v < b.v)))

def st_mst_h(edges: ST_Edge[6]&, ec: usize, h: u32, tree: mutable ST_Edge[3]&, tree_n: mutable usize&) -> u32:
    labels: mutable u32 = SINGLETON_LABELS
    tree_n <- 0
    cost: mutable u32 = 0
    for i in 0..<ec:
        e: ST_Edge = edges[i]
        if (h & (1.u32() << (e.u * 4 + e.v))) != 0 and st_join(&labels, e.u, e.v):
            tree[tree_n] <- e
            tree_n <- tree_n + 1
            cost <- cost + e.w
    cost

def st_contracted_mst(n: usize, mask: i64, w: u32[16], h: u32) -> u32:
    d: mutable u32[16] = zeroed
    labels: mutable u32 = SINGLETON_LABELS
    for i in 0..<4:
        for j in 0..<4:
            d[i * 4 + j] <- w[i * 4 + j]
    for i in 0..<n:
        for j in (i + 1)..<n:
            if (h & (1.u32() << (i * 4 + j))) != 0:
                d[i * 4 + j] <- 0
                d[j * 4 + i] <- 0
                st_join(&labels, i, j)
    for k in 0..<n:
        for i in 0..<n:
            for j in 0..<n:
                if d[i * 4 + j] > d[i * 4 + k] + d[k * 4 + j]:
                    d[i * 4 + j] <- d[i * 4 + k] + d[k * 4 + j]
    roots: mutable usize[4] = zeroed
    g: mutable usize = 0
    for v in 0..<n:
        if (mask & (1.i64() << v)) != 0:
            r: usize = st_label(labels, v)
            found: mutable bool = false
            for x in 0..<g:
                if roots[x] == r:
                    found <- true
            if not found:
                roots[g] <- r
                g <- g + 1
    if g <= 1:
        return 0
    q: mutable u32[16] = zeroed
    for a in 0..<g:
        for b in (a + 1)..<g:
            best: mutable u32 = 10000.u32()
            for u in 0..<n:
                if st_label(labels, u) == roots[a]:
                    for v in 0..<n:
                        if st_label(labels, v) == roots[b] and d[u * 4 + v] < best:
                            best <- d[u * 4 + v]
            q[a * 4 + b] <- best
            q[b * 4 + a] <- best
    used: mutable bool[4] = zeroed
    best: mutable u32[4] = zeroed
    for i in 0..<4:
        best[i] <- 10000.u32()
    used[0] <- true
    for j in 1..<g:
        best[j] <- q[j]
    total: mutable u32 = 0
    for _ in 1..<g:
        pick: mutable usize = 4
        for v in 0..<g:
            if not used[v] and (pick == 4 or best[v] < best[pick] or (best[v] == best[pick] and v < pick)):
                pick <- v
        total <- total + best[pick]
        used[pick] <- true
        for v in 0..<g:
            if not used[v] and q[pick * 4 + v] < best[v]:
                best[v] <- q[pick * 4 + v]
    total

def steiner_tree_gain_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 4 or length > ST_MAX_INPUT:
        return -1
    n0: i64 = input[0]
    mask: i64 = input[1]
    count0: i64 = input[2]
    if n0 < 2 or n0 > 4 or mask <= 0 or (mask >> n0) != 0 or count0 < 1 or count0 > 4:
        return -1
    n: usize = n0.usize()
    count: usize = count0.usize()
    terminals: usize = st_count_vertices(mask.u32())
    if terminals < 2:
        return -1
    w: mutable u32[16] = zeroed
    at: mutable usize = 3
    for i in 0..<n:
        for j in (i + 1)..<n:
            if at >= length or input[at] < 0 or input[at] > 1000:
                return -1
            w[i * 4 + j] <- input[at].u32()
            w[j * 4 + i] <- input[at].u32()
            at <- at + 1
    for i in 0..<n:
        for j in (i + 1)..<n:
            ij: u64 = w[i * 4 + j].u64()
            for k in (j + 1)..<n:
                ik: u64 = w[i * 4 + k].u64()
                jk: u64 = w[j * 4 + k].u64()
                if ij > ik + jk or ik > ij + jk or jk > ij + ik:
                    return -1
    family_u: mutable usize[12] = zeroed
    family_v: mutable usize[12] = zeroed
    sizes: mutable usize[4] = zeroed
    family_h: mutable u32 = 0
    component_edges: mutable u32[4] = zeroed
    for c in 0..<count:
        if at >= length:
            return -1
        ec0: i64 = input[at]
        at <- at + 1
        if ec0 < 1 or ec0 > n0 - 1 or at + 2 * ec0.usize() > length:
            return -1
        ec: usize = ec0.usize()
        labels: mutable u32 = SINGLETON_LABELS
        degree: mutable usize[4] = zeroed
        for e in 0..<ec:
            u0: i64 = input[at]
            v0: i64 = input[at + 1]
            at <- at + 2
            if u0 < 0 or u0 >= n0 or v0 < 0 or v0 >= n0 or u0 == v0:
                return -1
            u: mutable usize = u0.usize()
            v: mutable usize = v0.usize()
            if not st_join(&labels, u, v):
                return -1
            if u > v:
                tmp: usize = u
                u <- v
                v <- tmp
            family_u[c * 3 + e] <- u
            family_v[c * 3 + e] <- v
            edge_bit: u32 = 1.u32() << (u * 4 + v)
            family_h <- family_h | edge_bit
            component_edges[c] <- component_edges[c] | edge_bit
            degree[u] <- degree[u] + 1
            degree[v] <- degree[v] + 1
        seen: mutable usize = 0
        leaves: mutable usize = 0
        for v in 0..<n:
            if degree[v] > 0:
                seen <- seen + 1
                if degree[v] == 1:
                    if (mask & (1.i64() << v)) == 0:
                        return -1
                    leaves <- leaves + 1
                elif (mask & (1.i64() << v)) != 0:
                    return -1
        # Cycle-free edges span one component exactly when seen equals ec + 1.
        if seen != ec + 1 or leaves < 2 or leaves > 3 or (count == 1 and leaves != terminals):
            return -1
        sizes[c] <- ec
    if at != length or (count > 1 and st_group_count(mask, family_h) != 1):
        return -1
    h: mutable u32 = 0
    selected: mutable bool[4] = zeroed
    tree: mutable ST_Edge[3] = zeroed
    tree_n: mutable usize = 0
    cost: mutable u32 = 0
    groups: mutable usize = terminals
    if count == 1:
        # The component is already a tree. Order its edges as Kruskal would.
        tree_n <- sizes[0]
        for edge in 0..<tree_n:
            u: usize = family_u[edge]
            v: usize = family_v[edge]
            entry: ST_Edge = ST_Edge{u: u, v: v, w: w[u * 4 + v]}
            cost <- cost + entry.w
            position: mutable usize = edge
            while position > 0 and st_less(entry, tree[position - 1]):
                tree[position] <- tree[position - 1]
                position <- position - 1
            tree[position] <- entry
        groups <- 1
    edges: mutable ST_Edge[6] = zeroed
    ec: mutable usize = 0
    if groups > 1:
        for i in 0..<n:
            for j in (i + 1)..<n:
                if (family_h & (1.u32() << (i * 4 + j))) != 0:
                    edges[ec] <- ST_Edge{u: i, v: j, w: w[i * 4 + j]}
                    ec <- ec + 1
        for i in 1..<ec:
            x: ST_Edge = edges[i]
            j: mutable usize = i
            while j > 0 and st_less(x, edges[j - 1]):
                edges[j] <- edges[j - 1]
                j <- j - 1
            edges[j] <- x
    while groups > 1:
        best: mutable usize = 4
        best_cost: mutable u32 = 0
        best_groups: mutable usize = groups
        for c in 0..<count:
            if selected[c]:
                continue
            trial: u32 = h | component_edges[c]
            trial_groups: usize = st_group_count(mask, trial)
            if trial_groups >= groups:
                continue
            scratch: mutable ST_Edge[3] = zeroed
            scratch_n: mutable usize = 0
            contracted: mutable u32 = 0
            if trial_groups > 1:
                contracted <- st_contracted_mst(n, mask, w, trial)
            forest_cost: u32 = st_mst_h(&edges, ec, trial, &scratch, &scratch_n)
            trial_cost: u32 = contracted + forest_cost
            if best == 4 or trial_cost < best_cost:
                best <- c
                best_cost <- trial_cost
                best_groups <- trial_groups
                if trial_groups == 1:
                    tree <- scratch
                    tree_n <- scratch_n
                    cost <- forest_cost
        if best == 4:
            return -1
        groups <- best_groups
        selected[best] <- true
        h <- h | component_edges[best]
    bytes: usize = 8 * (3 + 2 * tree_n)
    if output == null or capacity < bytes:
        return -2
    st_put_i64(output,0,1)
    st_put_i64(output,1,cost.i64())
    st_put_i64(output,2,tree_n.i64())
    for i in 0..<tree_n:
        st_put_i64(output,3+2*i,tree[i].u.i64())
        st_put_i64(output,4+2*i,tree[i].v.i64())
    bytes.i64()

export fn steiner_tree_gain_greedy(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = steiner_tree_gain_impl
