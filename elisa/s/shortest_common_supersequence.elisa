def shortest_common_supersequence_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 130: return -1
    m_value: i64 = input[0]
    n_value: i64 = input[1]
    if m_value < 0 or m_value > 64 or n_value < 0 or n_value > 64: return -1
    m: usize = m_value.usize()
    n: usize = n_value.usize()
    if length != 2 + m + n: return -1
    index: usize = 0
    while index < m + n:
        if input[2 + index] < 32 or input[2 + index] > 126: return -1
        index <- index + 1

    lcs: mutable [65][65]i64 = [[0; 65]; 65]
    i: usize = 1
    while i <= m:
        j: usize = 1
        while j <= n:
            if input[1 + i] == input[1 + m + j]:
                lcs[i][j] <- lcs[i - 1][j - 1] + 1
            else:
                above: i64 = lcs[i - 1][j]
                left: i64 = lcs[i][j - 1]
                lcs[i][j] <- if above > left: above else: left
            j <- j + 1
        i <- i + 1

    reversed: mutable [128]u8 = [0; 128]
    used: mutable usize = 0
    i <- m
    j: usize = n
    while i > 0 and j > 0:
        if input[1 + i] == input[1 + m + j]:
            reversed[used] <- input[1 + i].u8()
            used <- used + 1
            i <- i - 1
            j <- j - 1
        else if lcs[i - 1][j] > lcs[i][j - 1]:
            reversed[used] <- input[1 + i].u8()
            used <- used + 1
            i <- i - 1
        else:
            # The pinned implementations choose Y when the LCS values tie.
            reversed[used] <- input[1 + m + j].u8()
            used <- used + 1
            j <- j - 1
    while i > 0:
        reversed[used] <- input[1 + i].u8()
        used <- used + 1
        i <- i - 1
    while j > 0:
        reversed[used] <- input[1 + m + j].u8()
        used <- used + 1
        j <- j - 1

    if output == null or capacity < used: return -2
    index <- 0
    while index < used:
        output[index] <- reversed[used - 1 - index]
        index <- index + 1
    used.i64()

export fn shortest_common_supersequence(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = shortest_common_supersequence_impl
