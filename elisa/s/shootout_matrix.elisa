const MATRIX_SIZE: usize = 10
const CELL_COUNT: usize = MATRIX_SIZE * MATRIX_SIZE
const MAX_ITERATIONS: i64 = 4096
const MAX_OUTPUT_BYTES: usize = 23

def append_integer(buffer: mutable u8&, used: mutable usize&, value: i64):
    reversed: mutable u8[10] = zeroed
    remaining: mutable i64 = value
    count: mutable usize = 0
    while true:
        reversed[count] <- (48 + remaining % 10).u8()
        count <- count + 1
        remaining <- remaining / 10
        if remaining == 0:
            break
    while count > 0:
        count <- count - 1
        buffer[used] <- reversed[count]
        used <- used + 1

def shootout_matrix_impl(iteration_count: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if iteration_count < 0 or iteration_count > MAX_ITERATIONS:
        return -1

    left: mutable i64[CELL_COUNT] = zeroed
    right: mutable i64[CELL_COUNT] = zeroed
    product: mutable i64[CELL_COUNT] = zeroed
    index: mutable usize = 0
    while index < CELL_COUNT:
        left[index] <- (index + 1).i64()
        right[index] <- (index + 1).i64()
        product[index] <- (index + 1).i64()
        index <- index + 1

    iteration: mutable i64 = 0
    while iteration < iteration_count:
        row: mutable usize = 0
        while row < MATRIX_SIZE:
            column: mutable usize = 0
            while column < MATRIX_SIZE:
                value: mutable i64 = 0
                inner: mutable usize = 0
                while inner < MATRIX_SIZE:
                    value <- value + left[row * MATRIX_SIZE + inner] * right[inner * MATRIX_SIZE + column]
                    inner <- inner + 1
                product[row * MATRIX_SIZE + column] <- value
                column <- column + 1
            row <- row + 1
        iteration <- iteration + 1

    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    used: mutable usize = 0
    append_integer(staged, used, product[0])
    staged[used] <- 32u8
    used <- used + 1
    append_integer(staged, used, product[23])
    staged[used] <- 32u8
    used <- used + 1
    append_integer(staged, used, product[32])
    staged[used] <- 32u8
    used <- used + 1
    append_integer(staged, used, product[44])
    staged[used] <- 10u8
    used <- used + 1

    if output.is_null() or output_capacity < used:
        return -2
    index <- 0
    while index < used:
        output[index] <- staged[index]
        index <- index + 1
    used.i64()

export fn shootout_matrix(iteration_count: i64, output: mutable u8&, output_capacity: usize) -> i64 = shootout_matrix_impl
