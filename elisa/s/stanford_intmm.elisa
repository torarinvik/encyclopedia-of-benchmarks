# Port the fixed-size integer matrix multiplication from Stanford IntMM.
def stanford_intmm_decimal_width(value: i32) -> usize:
    magnitude: mutable i64 = value.i64()
    if magnitude < 0:
        magnitude <- -magnitude
    width: mutable usize = if value < 0: 1 else: 0
    while true:
        width <- width + 1
        magnitude <- magnitude / 10
        if magnitude == 0: break
    width

def stanford_intmm_write_decimal(value: i32, output: mutable u8&, position: mutable usize&) -> void:
    magnitude: mutable i64 = value.i64()
    if magnitude < 0:
        output[position] <- 45u8
        position <- position + 1
        magnitude <- -magnitude
    digits: mutable u8[10] = zeroed
    count: mutable usize = 0
    while true:
        digits[count] <- (48 + magnitude % 10).u8()
        count <- count + 1
        magnitude <- magnitude / 10
        if magnitude == 0: break
    while count > 0:
        count <- count - 1
        output[position] <- digits[count]
        position <- position + 1

def stanford_intmm_impl(pass_count: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if pass_count < 1 or pass_count > 10:
        return -1

    a: mutable i32[1600] = zeroed
    b: mutable i32[1600] = zeroed
    product: mutable i32[1600] = zeroed
    diagonal: mutable i32[10] = zeroed
    pass: mutable i64 = 0
    while pass < pass_count:
        seed: mutable i64 = 74755
        index: mutable usize = 0
        while index < 1600:
            seed <- (seed * 1309 + 13849) & 65535
            a[index] <- (seed % 120 - 60).i32()
            index <- index + 1
        index <- 0
        while index < 1600:
            seed <- (seed * 1309 + 13849) & 65535
            b[index] <- (seed % 120 - 60).i32()
            index <- index + 1

        row: mutable usize = 0
        while row < 40:
            column: mutable usize = 0
            while column < 40:
                sum: mutable i32 = 0
                inner: mutable usize = 0
                while inner < 40:
                    sum <- sum + a[row * 40 + inner] * b[inner * 40 + column]
                    inner <- inner + 1
                product[row * 40 + column] <- sum
                column <- column + 1
            row <- row + 1
        diagonal[pass.usize()] <- product[pass.usize() * 40 + pass.usize()]
        pass <- pass + 1

    required: mutable usize = 0
    pass <- 0
    while pass < pass_count:
        required <- required + stanford_intmm_decimal_width(diagonal[pass.usize()]) + 1
        pass <- pass + 1
    if output.is_null() or output_capacity < required:
        return -2

    position: mutable usize = 0
    pass <- 0
    while pass < pass_count:
        stanford_intmm_write_decimal(diagonal[pass.usize()], output, position)
        output[position] <- 10u8
        position <- position + 1
        pass <- pass + 1
    position.i64()

export fn stanford_intmm(pass_count: i64, output: mutable u8&, output_capacity: usize) -> i64 = stanford_intmm_impl
