const MAX_TEXT_LENGTH: usize = 32
const MAX_INPUT_LENGTH: usize = 34
const PACKED_FIELD_WORDS: usize = 4
const PACKED_LIST_WORDS: usize = 2

def field_get(fields: view[u64], index: usize) -> i64:
    word_index: usize = index / 9
    shift: usize = (index % 9) * 7
    value: i64 = ((fields[word_index] >> shift) & 127).i64()
    if value == 127: return -1
    value

def field_set(fields: mutable view[u64], index: usize, value: i64) -> void:
    word_index: usize = index / 9
    shift: usize = (index % 9) * 7
    mask: u64 = 127.u64() << shift
    encoded: u64 = if value < 0: 127.u64() else: value.u64()
    fields[word_index] <- (fields[word_index] & ~mask) | (encoded << shift)

def list_get(values: view[u64], index: usize) -> usize:
    word_index: usize = index / 10
    shift: usize = (index % 10) * 6
    ((values[word_index] >> shift) & 63).usize()

def list_set(values: mutable view[u64], index: usize, value: usize) -> void:
    word_index: usize = index / 10
    shift: usize = (index % 10) * 6
    mask: u64 = 63.u64() << shift
    values[word_index] <- (values[word_index] & ~mask) | (value.u64() << shift)

def bit_is_set(bits: u64, index: usize) -> bool:
    ((bits >> index) & 1) != 0

def bit_count(bits0: u64) -> usize:
    bits: mutable u64 = bits0
    count: mutable usize = 0
    while bits != 0:
        bits <- bits & (bits - 1)
        count <- count + 1
    count

def bits_below(bits: u64, index: usize) -> usize:
    if index == 0: return 0
    mask: u64 = (1.u64() << index) - 1
    bit_count(bits & mask)

def input_symbol(raw: view[i64], packed: view[u64], raw_length: usize,
                 raw_offset: usize, packed_mode: bool, index: usize) -> usize:
    if not packed_mode:
        if index == raw_length: return 0
        return (raw[index + raw_offset] + 1).usize()
    list_get(packed, index)

def sa_get(output: view[u8], index: usize) -> i64:
    bits: mutable u64 = 0
    offset: usize = index * 8
    byte: mutable usize = 0
    while byte < 8:
        bits <- bits | (output[offset + byte].u64() << (byte * 8))
        byte <- byte + 1
    if (bits >> 63) != 0: return -1
    bits.i64()

def sa_set(output: mutable view[u8], index: usize, value: i64) -> void:
    offset: usize = index * 8
    byte: mutable usize = 0
    if value < 0:
        while byte < 8: output[offset + byte] <- 255; byte <- byte + 1
        return
    bits: mutable u64 = value.u64()
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def build_buckets(raw: view[i64], packed: view[u64], raw_length: usize,
                  raw_offset: usize, packed_mode: bool, length: usize, upper: usize,
                  types: u64, heads: mutable view[u64], tails: mutable view[u64],
                  s_starts: mutable view[u64]) -> void:
    counts: mutable u64[PACKED_FIELD_WORDS] = zeroed
    l_counts: mutable u64[PACKED_FIELD_WORDS] = zeroed
    count_view: mutable view[u64] = counts[0:PACKED_FIELD_WORDS]
    l_count_view: mutable view[u64] = l_counts[0:PACKED_FIELD_WORDS]
    prefix: mutable i64 = 0
    index: mutable usize = 0
    while index < length:
        symbol: usize = input_symbol(raw, packed, raw_length, raw_offset, packed_mode, index)
        field_set(count_view, symbol, field_get(count_view, symbol) + 1)
        if not bit_is_set(types, index):
            field_set(l_count_view, symbol, field_get(l_count_view, symbol) + 1)
        index <- index + 1
    symbol <- 0
    while symbol <= upper:
        count: i64 = field_get(count_view, symbol)
        field_set(heads, symbol, prefix)
        field_set(tails, symbol, prefix + count - 1)
        field_set(s_starts, symbol, prefix + field_get(l_count_view, symbol))
        prefix <- prefix + count
        symbol <- symbol + 1

def same_lms_substring(raw: view[i64], packed: view[u64], raw_length: usize,
                       raw_offset: usize, packed_mode: bool, length: usize,
                       types: u64, lms: u64, left: usize, right: usize) -> bool:
    if left == right: return true
    offset: mutable usize = 0
    while offset < length:
        a: usize = left + offset
        b: usize = right + offset
        if a >= length or b >= length or
           input_symbol(raw, packed, raw_length, raw_offset, packed_mode, a) !=
           input_symbol(raw, packed, raw_length, raw_offset, packed_mode, b) or
           bit_is_set(types, a) != bit_is_set(types, b): return false
        if offset > 0 and (bit_is_set(lms, a) or bit_is_set(lms, b)):
            return bit_is_set(lms, a) and bit_is_set(lms, b)
        offset <- offset + 1
    false

def induce(raw: view[i64], packed: view[u64], raw_length: usize,
           raw_offset: usize, packed_mode: bool, length: usize, upper: usize,
           types: u64, lms: u64, seeds: view[u64], seed_count: usize,
           use_lms_mask: bool, output: mutable view[u8]) -> void:
    heads: mutable u64[PACKED_FIELD_WORDS] = zeroed
    tails: mutable u64[PACKED_FIELD_WORDS] = zeroed
    s_starts: mutable u64[PACKED_FIELD_WORDS] = zeroed
    l_cursor: mutable u64[PACKED_FIELD_WORDS] = zeroed
    s_cursor: mutable u64[PACKED_FIELD_WORDS] = zeroed
    heads_view: mutable view[u64] = heads[0:PACKED_FIELD_WORDS]
    tails_view: mutable view[u64] = tails[0:PACKED_FIELD_WORDS]
    s_starts_view: mutable view[u64] = s_starts[0:PACKED_FIELD_WORDS]
    l_view: mutable view[u64] = l_cursor[0:PACKED_FIELD_WORDS]
    s_view: mutable view[u64] = s_cursor[0:PACKED_FIELD_WORDS]
    build_buckets(raw, packed, raw_length, raw_offset, packed_mode,
                  length, upper, types, heads_view, tails_view, s_starts_view)
    index: mutable usize = 0
    while index < length: sa_set(output, index, -1); index <- index + 1
    symbol: mutable usize = 0
    while symbol <= upper:
        field_set(s_view, symbol, field_get(s_starts_view, symbol))
        symbol <- symbol + 1
    if use_lms_mask:
        position: mutable usize = 0
        while position < length:
            if bit_is_set(lms, position):
                char: usize = input_symbol(raw, packed, raw_length, raw_offset, packed_mode, position)
                slot: i64 = field_get(s_view, char)
                sa_set(output, slot.usize(), position.i64())
                field_set(s_view, char, slot + 1)
            position <- position + 1
    else:
        item: mutable usize = 0
        while item < seed_count:
            position: usize = list_get(seeds, item)
            char: usize = input_symbol(raw, packed, raw_length, raw_offset, packed_mode, position)
            slot: i64 = field_get(s_view, char)
            sa_set(output, slot.usize(), position.i64())
            field_set(s_view, char, slot + 1)
            item <- item + 1
    symbol <- 0
    while symbol <= upper:
        field_set(l_view, symbol, field_get(heads_view, symbol))
        field_set(s_view, symbol, field_get(tails_view, symbol) + 1)
        symbol <- symbol + 1
    slot: mutable usize = 0
    while slot < length:
        position: i64 = sa_get(output, slot)
        if position > 0:
            previous: usize = (position - 1).usize()
            if not bit_is_set(types, previous):
                char: usize = input_symbol(raw, packed, raw_length, raw_offset, packed_mode, previous)
                target: i64 = field_get(l_view, char)
                sa_set(output, target.usize(), previous.i64())
                field_set(l_view, char, target + 1)
        slot <- slot + 1
    slot <- length
    while slot > 0:
        slot <- slot - 1
        position <- sa_get(output, slot)
        if position > 0:
            previous <- (position - 1).usize()
            if bit_is_set(types, previous):
                char <- input_symbol(raw, packed, raw_length, raw_offset, packed_mode, previous)
                target <- field_get(s_view, char) - 1
                sa_set(output, target.usize(), previous.i64())
                field_set(s_view, char, target)

def sais_readonly(raw: view[i64], packed: view[u64], raw_length: usize,
                  raw_offset: usize, packed_mode: bool, length: usize,
                  upper: usize, output: mutable view[u8]) -> void:
    if length == 0: return
    if length == 1: sa_set(output, 0, 0); return
    if length == 2:
        if input_symbol(raw, packed, raw_length, raw_offset, packed_mode, 0) >=
           input_symbol(raw, packed, raw_length, raw_offset, packed_mode, 1):
            sa_set(output, 0, 1); sa_set(output, 1, 0)
        else:
            sa_set(output, 0, 0); sa_set(output, 1, 1)
        return
    types: mutable u64 = 1.u64() << (length - 1)
    index: mutable usize = length - 1
    while index > 0:
        index <- index - 1
        current: usize = input_symbol(raw, packed, raw_length, raw_offset, packed_mode, index)
        next: usize = input_symbol(raw, packed, raw_length, raw_offset, packed_mode, index + 1)
        if current < next or (current == next and bit_is_set(types, index + 1)):
            types <- types | (1.u64() << index)
    lms: mutable u64 = 0
    lms_positions: mutable u64[PACKED_LIST_WORDS] = zeroed
    lms_view: mutable view[u64] = lms_positions[0:PACKED_LIST_WORDS]
    lms_count: mutable usize = 0
    index <- 1
    while index < length:
        if not bit_is_set(types, index - 1) and bit_is_set(types, index):
            lms <- lms | (1.u64() << index)
            list_set(lms_view, lms_count, index)
            lms_count <- lms_count + 1
        index <- index + 1
    empty_seeds: mutable u64[PACKED_LIST_WORDS] = zeroed
    empty_view: view[u64] = empty_seeds[0:PACKED_LIST_WORDS]
    induce(raw, packed, raw_length, raw_offset, packed_mode, length, upper,
           types, lms, empty_view, 0, true, output)
    reduced: mutable u64[PACKED_LIST_WORDS] = zeroed
    reduced_view: mutable view[u64] = reduced[0:PACKED_LIST_WORDS]
    name: mutable usize = 0
    sorted_count: mutable usize = 0
    previous_lms: mutable i64 = -1
    slot: mutable usize = 0
    while slot < length:
        candidate: i64 = sa_get(output, slot)
        if candidate >= 0 and bit_is_set(lms, candidate.usize()):
            position: usize = candidate.usize()
            if previous_lms >= 0 and not same_lms_substring(raw, packed, raw_length,
                raw_offset, packed_mode, length, types, lms, previous_lms.usize(), position):
                name <- name + 1
            list_set(reduced_view, bits_below(lms, position), name)
            previous_lms <- candidate
            sorted_count <- sorted_count + 1
        slot <- slot + 1
    if sorted_count != lms_count: return
    if name + 1 == lms_count:
        index <- 0
        while index < lms_count:
            sa_set(output, list_get(reduced_view, index), index.i64())
            index <- index + 1
    else:
        sais_readonly(raw, reduced_view, 0, 0, true, lms_count, name, output)
    ordered_lms: mutable u64[PACKED_LIST_WORDS] = zeroed
    ordered_view: mutable view[u64] = ordered_lms[0:PACKED_LIST_WORDS]
    index <- 0
    while index < lms_count:
        ordinal: usize = sa_get(output, index).usize()
        list_set(ordered_view, index, list_get(lms_view, ordinal))
        index <- index + 1
    induce(raw, packed, raw_length, raw_offset, packed_mode, length, upper,
           types, lms, ordered_view, lms_count, false, output)

def validate_suffix_input(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 1 or length > MAX_INPUT_LENGTH: return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > MAX_TEXT_LENGTH.i64(): return -1
    count: usize = count_value.usize()
    if length != count + 1: return -1
    index: mutable usize = 0
    while index < count:
        if input[index + 1] < 0 or input[index + 1] >= count.i64(): return -1
        index <- index + 1
    count.i64()

def construct_suffix_array(input: view[i64], count: usize,
        output: mutable view[u8]) -> void:
    empty_words: mutable u64[PACKED_LIST_WORDS] = zeroed
    empty_packed: view[u64] = empty_words[0:PACKED_LIST_WORDS]
    sais_readonly(input, empty_packed, count, 1, false,
                  count + 1, count, output)
    index: mutable usize = 0
    while index < count:
        position: i64 = sa_get(output, index + 1)
        sa_set(output, index, position)
        index <- index + 1

export fn suffix_array_inplace_readonly_integer(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_INPUT_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    count_value: i64 = validate_suffix_input(input_view)
    if count_value < 0: return -1
    count: usize = count_value.usize()
    workspace_bytes: usize = (count + 1) * 8
    if output.is_null() or capacity < workspace_bytes: return -2
    output_view: mutable view[u8] = output[0:workspace_bytes]
    construct_suffix_array(input_view, count, output_view)
    (count * 8).i64()
