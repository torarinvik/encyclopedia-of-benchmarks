extern pow(base: f64, exponent: f64) -> f64
extern sqrt(value: f64) -> f64

def standard_deviation_impl(values: i64&, length: usize) -> f64:
    if length == 0 or length > 64:
        return -1.0e300
    total: mutable f64 = 0.0
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < -1000000 or value > 1000000:
            return -1.0e300
        total <- total + value.f64()
        index <- index + 1
    average: f64 = total / length.f64()
    squared_deviations: mutable f64 = 0.0
    index <- 0
    while index < length:
        difference: f64 = values[index].f64() - average
        squared_deviations <- squared_deviations + pow(difference, 2.0)
        index <- index + 1
    sqrt(squared_deviations / length.f64())

export fn standard_deviation(values: i64&, length: usize) -> f64 = standard_deviation_impl
