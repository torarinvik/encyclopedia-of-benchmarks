const MAX_INPUT: usize = 97
const MAX_TEXT: usize = 64
const BOARD_SIZE: usize = 30

def straddling_checkerboard_find_symbol(values: i64&, value: i64) -> i64:
    for position in 0..<BOARD_SIZE |position, values|:
        if values[1 + position] != 0 and values[1 + position] == value:
            return position.i64()
    -1

def straddling_checkerboard_impl(values: i64&, input_length: usize, output: mutable u8&) -> i64:
    if input_length < 32 or input_length > MAX_INPUT:
        return -1
    mode: i64 = values[0]
    if mode != 0 and mode != 1:
        return -1
    hole_a: mutable usize = 0
    hole_b: mutable usize = 0
    holes: mutable usize = 0
    seen_low: mutable u64 = 0
    seen_high: mutable u64 = 0
    for position in 0..<BOARD_SIZE |position, values, hole_a, hole_b, holes, seen_low, seen_high|:
        value: i64 = values[1 + position]
        if position < 10 and value == 0:
            if holes == 0:
                hole_a <- position
            elif holes == 1:
                hole_b <- position
            holes <- holes + 1
            continue
        if value < 32 or value > 126:
            return -1
        bit: u64 = 1.u64() << (value.u64() & 63)
        if value < 64:
            if (seen_low & bit) != 0:
                return -1
            seen_low <- seen_low | bit
        else:
            if (seen_high & bit) != 0:
                return -1
            seen_high <- seen_high | bit
    if holes != 2:
        return -1
    text_length_value: i64 = values[31]
    if text_length_value < 0 or text_length_value > MAX_TEXT.i64():
        return -1
    text_length: usize = text_length_value.usize()
    if input_length != 32 + text_length:
        return -1

    out: mutable usize = 0
    if mode == 0:
        for index in 0..<text_length |index, values, output, out, hole_a, hole_b|:
            found: i64 = straddling_checkerboard_find_symbol(values, values[32 + index])
            if found < 0:
                return -1
            position: usize = found.usize()
            if position < 10:
                output[out] <- (48 + position).u8()
                out <- out + 1
            else:
                row_digit: usize = hole_b if position >= 20 else hole_a
                output[out] <- (48 + row_digit).u8()
                output[out + 1] <- (48 + (position % 10)).u8()
                out <- out + 2
    else:
        index: mutable usize = 0
        while index < text_length |index, out, values, output, hole_a|:
            digit: u64 = values[32 + index].u64() - 48
            if digit > 9:
                return -1
            column: usize = digit.usize()
            top: i64 = values[1 + column]
            if top != 0:
                output[out] <- top.u8()
                index <- index + 1
            else:
                if index + 1 >= text_length:
                    return -1
                next_digit: u64 = values[32 + index + 1].u64() - 48
                if next_digit > 9:
                    return -1
                row_offset: usize = 10 if column == hole_a else 20
                output[out] <- values[1 + row_offset + next_digit.usize()].u8()
                index <- index + 2
            out <- out + 1
    out.i64()

def straddling_checkerboard_entry(input: i64&?, input_length: usize,
        output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or input_length < 32 or input_length > MAX_INPUT:
        return -1
    staged: mutable u8[128] = zeroed
    staged_view: mutable u8& = &staged[0]
    result: i64 = straddling_checkerboard_impl(input, input_length, staged_view)
    if result < 0:
        return result
    if output == null or output_capacity < result.usize():
        return -2
    for index in 0..<result.usize() |index, staged_view, output|:
        output[index] <- staged_view[index]
    result

export fn straddling_checkerboard_transducer(input: i64&?, input_length: usize,
        output: mutable u8&?, output_capacity: usize) -> i64 = straddling_checkerboard_entry
