alias MAX_N = 16
alias MAX_M = 20
alias MAX_PARSEABLE_LENGTH = 64

def secret_find(parent: mutable view[usize], node_input: usize) -> usize:
    var node: mutable usize = node_input
    while parent[node] != node |parent, node|:
        parent[node] <- parent[parent[node]]
        node <- parent[node]
    return node

def secret_join(parent: mutable view[usize], sizes: mutable view[usize],
                left: usize, right: usize) -> void:
    var a: mutable usize = secret_find(parent, left)
    var b: mutable usize = secret_find(parent, right)
    if a == b: return
    if sizes[a] < sizes[b]:
        let swap = a
        a <- b
        b <- swap
    parent[b] <- a
    sizes[a] <- sizes[a] + sizes[b]

def secret_sharing_time_batched_dsu_impl(values: view[i64]) -> i64:
    if values.len() < 3 or values.len() > MAX_PARSEABLE_LENGTH: return -1
    let n_value = values[0]
    let first_value = values[1]
    let m_value = values[2]
    if n_value < 2 or n_value > MAX_N or first_value < 1 or first_value >= n_value
        or m_value < 0 or m_value > MAX_M: return -1
    let n = n_value.usize()
    let first = first_value.usize()
    let m = m_value.usize()
    if values.len() != 3 + 3 * m: return -1
    for i in range(m):
        let u = values[3 + 3 * i]
        let v = values[4 + 3 * i]
        let time = values[5 + 3 * i]
        if u < 0 or u >= n_value or v < 0 or v >= n_value or u == v or time < 1 or time > 20:
            return -1

    var parent: mutable usize[MAX_N] = zeroed
    var sizes: mutable usize[MAX_N] = zeroed
    for i in range(n):
        parent[i] <- i
        sizes[i] <- 1
    let parent_view: mutable view[usize] = parent[0:MAX_N]
    let sizes_view: mutable view[usize] = sizes[0:MAX_N]
    secret_join(parent_view, sizes_view, 0, first)
    for time in range(1, 21):
        var touched: mutable bool[MAX_N] = zeroed
        for i in range(m):
            let u = values[3 + 3 * i].usize()
            let v = values[4 + 3 * i].usize()
            if values[5 + 3 * i] == time.i64():
                secret_join(parent_view, sizes_view, u, v)
                touched[u] <- true
                touched[v] <- true
        let known_root = secret_find(parent_view, 0)
        for node in range(n):
            if touched[node] and secret_find(parent_view, node) != known_root:
                parent[node] <- node
                sizes[node] <- 1
    let known_root = secret_find(parent_view, 0)
    var result: mutable i64 = 0
    for node in range(n):
        if secret_find(parent_view, node) == known_root:
            result <- result | (1.i64() << node)
    result

export fn secret_sharing_time_batched_dsu(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_PARSEABLE_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    secret_sharing_time_batched_dsu_impl(input_view)
