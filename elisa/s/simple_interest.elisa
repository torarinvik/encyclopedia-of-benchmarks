def simple_interest_impl(principal: f64, daily_rate: f64, days: f64) -> f64:
    if principal != principal or daily_rate != daily_rate or days != days or
        not (principal > 0.0) or principal > 1000000.0 or
        not (daily_rate >= 0.0) or daily_rate > 1.0 or
        not (days > 0.0) or days > 3650.0:
        return -1e300
    principal * daily_rate * days

export fn simple_interest(principal: f64, daily_rate: f64, days: f64) -> f64 = simple_interest_impl
