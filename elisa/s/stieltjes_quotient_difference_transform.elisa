const MODULUS: i64 = 998244353
const MAX_WORDS: usize = 11
const TABLE_COLUMNS: usize = 9

def stieltjes_mod(value_input: i64) -> i64:
    reduced: mutable i64 = value_input % MODULUS
    if reduced < 0: reduced <- reduced + MODULUS
    reduced

def stieltjes_mul(left: i64, right: i64) -> i64:
    (left * right) % MODULUS

def stieltjes_power(base_input: i64, exponent_input: i64) -> i64:
    base: mutable i64 = base_input
    exponent: mutable i64 = exponent_input
    result: mutable i64 = 1
    while exponent > 0:
        if (exponent & 1) != 0: result <- stieltjes_mul(result, base)
        base <- stieltjes_mul(base, base)
        exponent <- exponent >> 1
    result

def stieltjes_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def stieltjes_impl(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_WORDS: return -1
    n0: i64 = input[0]
    if n0 < 2 or n0 > 9 or length != n0.usize() + 1: return -1
    n: usize = n0.usize()
    i: mutable usize = 0
    while i < n:
        if input[i + 1] <= 0 or input[i + 1] >= MODULUS: return -1
        i <- i + 1

    q: mutable i64[45] = zeroed
    e: mutable i64[45] = zeroed
    k: mutable usize = 0
    while k + 1 < n:
        q[TABLE_COLUMNS + k] <- stieltjes_mul(input[k + 2], stieltjes_power(input[k + 1], MODULUS - 2))
        k <- k + 1
    j: mutable usize = 1
    while j <= 4:
        last_e: i64 = n.i64() - 2 * j.i64() - 1
        if last_e < 0: break
        k <- 0
        while k.i64() <= last_e:
            e[j * TABLE_COLUMNS + k] <- stieltjes_mod(
                e[(j - 1) * TABLE_COLUMNS + k + 1] + q[j * TABLE_COLUMNS + k + 1] - q[j * TABLE_COLUMNS + k])
            k <- k + 1
        last_q: i64 = n.i64() - 2 * j.i64() - 2
        if last_q >= 0:
            k <- 0
            while k.i64() <= last_q:
                pivot: i64 = e[j * TABLE_COLUMNS + k]
                if pivot == 0: return -1
                product: i64 = stieltjes_mul(q[j * TABLE_COLUMNS + k + 1], e[j * TABLE_COLUMNS + k + 1])
                q[(j + 1) * TABLE_COLUMNS + k] <- stieltjes_mul(product, stieltjes_power(pivot, MODULUS - 2))
                k <- k + 1
        j <- j + 1

    required: usize = 8 * (n + 1)
    if output == null or capacity < required: return -2
    first_coefficient: i64 = input[1]
    stieltjes_store_i64(output, 0, n0)
    stieltjes_store_i64(output, 8, first_coefficient)
    index: mutable usize = 1
    while index < n:
        value: i64 = q[((index + 1) / 2) * TABLE_COLUMNS] if (index & 1) != 0 else e[(index / 2) * TABLE_COLUMNS]
        stieltjes_store_i64(output, 8 * (index + 1), value)
        index <- index + 1
    required.i64()

export fn stieltjes_quotient_difference_transform(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64 = stieltjes_impl
