# Keep each value that is not smaller than the last retained value.
const MAX_INPUT_LENGTH: usize = 128

def stalin_sort_impl(values: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if length > MAX_INPUT_LENGTH:
        return -1
    # An empty trace keeps nothing, so only the output check remains.
    if length == 0:
        return -2 if output == null else 0
    if values == null:
        return -1
    i: mutable usize = 0
    while i < length:
        if values[i] < -2147483648 or values[i] > 2147483647:
            return -1
        i <- i + 1

    kept: mutable usize = 0
    last: mutable i64 = 0
    i <- 0
    while i < length:
        if kept == 0 or values[i] >= last:
            kept <- kept + 1
            last <- values[i]
        i <- i + 1
    output_bytes: usize = kept * 4
    if output == null or output_capacity < output_bytes:
        return -2

    output_index: mutable usize = 0
    last <- 0
    i <- 0
    while i < length:
        if output_index == 0 or values[i] >= last:
            bits: u32 = values[i].i32().u32()
            byte: mutable usize = 0
            while byte < 4:
                output[output_index * 4 + byte] <- ((bits >> (byte * 8).u32()) & 255).u8()
                byte <- byte + 1
            output_index <- output_index + 1
            last <- values[i]
        i <- i + 1
    output_bytes.i64()

export fn stalin_sort(values: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64 = stalin_sort_impl
