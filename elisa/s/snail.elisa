const MAX_CELLS: usize = 256
const MAX_INPUT_LENGTH: usize = 259

def snail_put_i32_le(output: mutable view[u8], index: usize, value: i32) -> void:
    bits: mutable u32 = value.u32()
    offset: usize = index * 4
    byte: mutable usize = 0
    while byte < 4:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def snail_impl(input: i32&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    rows_value: i32 = input[0]
    columns_value: i32 = input[1]
    if rows_value < 0 or rows_value > 16 or columns_value < 0 or columns_value > 16:
        return -1
    if rows_value == 0 and columns_value != 0:
        return -1
    if columns_value == 1 and rows_value != 1:
        return -1

    rows: usize = rows_value.usize()
    columns: usize = columns_value.usize()
    cell_count: usize = rows * columns
    if length != 2 + cell_count:
        return -1

    required_bytes: usize = 4 * cell_count
    if output.is_null() or output_capacity < required_bytes:
        return -2
    if cell_count == 0:
        return 0

    matrix: mutable i32[256] = zeroed
    index: mutable usize = 0
    while index < cell_count:
        matrix[index] <- input[2 + index]
        index <- index + 1

    top: mutable i32 = 0
    bottom: mutable i32 = rows_value - 1
    left: mutable i32 = 0
    right: mutable i32 = columns_value - 1
    written: mutable usize = 0
    while top <= bottom and left <= right:
        column: mutable i32 = left
        while column <= right:
            matrix_index: usize = top.usize() * columns + column.usize()
            snail_put_i32_le(output[0:output_capacity], written, matrix[matrix_index])
            written <- written + 1
            column <- column + 1
        top <- top + 1

        row: mutable i32 = top
        while row <= bottom:
            matrix_index: usize = row.usize() * columns + right.usize()
            snail_put_i32_le(output[0:output_capacity], written, matrix[matrix_index])
            written <- written + 1
            row <- row + 1
        right <- right - 1

        if top <= bottom and left <= right:
            column <- right
            while true:
                matrix_index: usize = bottom.usize() * columns + column.usize()
                snail_put_i32_le(output[0:output_capacity], written, matrix[matrix_index])
                written <- written + 1
                if column == left:
                    break
                column <- column - 1
            bottom <- bottom - 1

        if top <= bottom and left <= right:
            row <- bottom
            while true:
                matrix_index: usize = row.usize() * columns + left.usize()
                snail_put_i32_le(output[0:output_capacity], written, matrix[matrix_index])
                written <- written + 1
                if row == top:
                    break
                row <- row - 1
            left <- left + 1

    required_bytes.i64()

export fn snail(input: i32&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = snail_impl
