const MAX_INPUT: usize = 4
const MAX_TRIPS: usize = 32

def ski_rental_deterministic(input: i64&, length: usize,
                             output: mutable u8&, capacity: usize) -> i64 @export("ski_rental_deterministic"):
    if input.is_null() or length < 3 or length > MAX_INPUT: return -1
    rent: i64 = input[0]
    purchase: i64 = input[1]
    trips: i64 = input[2]
    if length != 3 or rent < 1 or rent > 32 or purchase < 1 or purchase > 64 or trips < 0 or trips > 32: return -1
    count: usize = trips.usize()
    if output.is_null() or capacity < count: return -2
    actions: mutable u8[MAX_TRIPS] = zeroed
    threshold: i64 = purchase / rent
    trip: mutable usize = 0
    while trip < count:
        if trip.i64() < threshold: actions[trip] <- 0
        else if trip.i64() == threshold: actions[trip] <- 1
        else: actions[trip] <- 2
        trip <- trip + 1
    trip <- 0
    while trip < count:
        output[trip] <- actions[trip]
        trip <- trip + 1
    count.i64()
