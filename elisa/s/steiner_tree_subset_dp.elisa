const STD_MAX_N: usize = 8
const STD_MAX_M: usize = 14
const STD_MAX_K: usize = 5
const STD_MAX_INPUT: usize = 50
const STD_MAX_MASKS: usize = 32
const STD_INF: i64 = 1000000000000000000

def std_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 3 or length > STD_MAX_INPUT: return -1
    if input[0] < 1 or input[0] > 8 or input[1] < 0 or input[1] > 14 or input[2] < 1 or input[2] > 5 or input[2] > input[0]: return -1
    n: usize = input[0].usize()
    m: usize = input[1].usize()
    k: usize = input[2].usize()
    if m > n * (n - 1) / 2 or length != 3 + k + 3 * m: return -1

    terminal_seen: mutable bool[STD_MAX_N] = zeroed
    terminals: mutable usize[STD_MAX_K] = zeroed
    for i in 0..<k:
        raw: i64 = input[3 + i]
        if raw < 0 or raw >= input[0] or terminal_seen[raw.usize()]: return -1
        terminal_seen[raw.usize()] <- true
        terminals[i] <- raw.usize()

    present: mutable bool[STD_MAX_N * STD_MAX_N] = zeroed
    weights: mutable i64[STD_MAX_N * STD_MAX_N] = zeroed
    for i in 0..<m:
        u0: i64 = input[3 + k + 3 * i]
        v0: i64 = input[4 + k + 3 * i]
        w: i64 = input[5 + k + 3 * i]
        if u0 < 0 or u0 >= v0 or v0 >= input[0] or w < 0 or w > 1000: return -1
        u: usize = u0.usize()
        v: usize = v0.usize()
        edge: usize = u * STD_MAX_N + v
        if present[edge]: return -1
        present[edge] <- true
        present[v * STD_MAX_N + u] <- true
        weights[edge] <- w
        weights[v * STD_MAX_N + u] <- w

    dp: mutable i64[STD_MAX_MASKS * STD_MAX_N] = zeroed
    for i in 0..<STD_MAX_MASKS * STD_MAX_N: dp[i] <- STD_INF
    for bit in 0..<k: dp[(1 << bit) * STD_MAX_N + terminals[bit]] <- 0
    masks: usize = 1 << k
    for mask in 1..<masks:
        if (mask & (mask - 1)) != 0:
            sub: mutable usize = (mask - 1) & mask
            while sub != 0:
                other: usize = mask ^ sub
                if sub < other:
                    for v in 0..<n:
                        left: i64 = dp[sub * STD_MAX_N + v]
                        right: i64 = dp[other * STD_MAX_N + v]
                        if left < STD_INF and right < STD_INF and left + right < dp[mask * STD_MAX_N + v]:
                            dp[mask * STD_MAX_N + v] <- left + right
                sub <- (sub - 1) & mask
        used: mutable bool[STD_MAX_N] = zeroed
        for step in 0..<n:
            chosen: mutable usize = n
            for v in 0..<n:
                if not used[v] and (chosen == n or dp[mask * STD_MAX_N + v] < dp[mask * STD_MAX_N + chosen]): chosen <- v
            if chosen == n or dp[mask * STD_MAX_N + chosen] >= STD_INF: break
            used[chosen] <- true
            for v in 0..<n:
                edge: usize = chosen * STD_MAX_N + v
                if present[edge] and not used[v]:
                    candidate: i64 = dp[mask * STD_MAX_N + chosen] + weights[edge]
                    if candidate < dp[mask * STD_MAX_N + v]: dp[mask * STD_MAX_N + v] <- candidate
    answer: mutable i64 = STD_INF
    for v in 0..<n:
        if dp[(masks - 1) * STD_MAX_N + v] < answer: answer <- dp[(masks - 1) * STD_MAX_N + v]
    if answer >= STD_INF: return -2
    answer

export fn steiner_tree_subset_dp(values: i64&, length: usize) -> i64:
    if values.is_null() or length > STD_MAX_INPUT: return -1
    std_impl(values[0:length])
