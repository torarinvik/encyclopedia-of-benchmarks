const MOD: i64 = 998244353
const MAX_N: usize = 8
const MAX_K: usize = 64
const MAX_PARSEABLE_INPUT: usize = 195

def sparse_matrix_det_add(a: i64, b: i64) -> i64:
    let value: i64 = a + b
    if value >= MOD: return value - MOD
    return value

def sparse_matrix_det_sub(a: i64, b: i64) -> i64:
    let value: i64 = a - b
    if value < 0: return value + MOD
    return value

def sparse_matrix_det_mul(a: i64, b: i64) -> i64:
    return (a * b) % MOD

def sparse_matrix_det_pow(value_input: i64, exponent_input: i64) -> i64:
    let value: mutable i64 = value_input
    let exponent: mutable i64 = exponent_input
    let result: mutable i64 = 1
    while exponent > 0:
        if (exponent & 1) != 0: result <- sparse_matrix_det_mul(result, value)
        value <- sparse_matrix_det_mul(value, value)
        exponent <- exponent >> 1
    return result

def sparse_matrix_det_next(state: mutable i64&) -> i64:
    state <- (state * 48271 + 1) % MOD
    return state

def sparse_matrix_det_bm(sequence: view[i64], length: usize,
        connection: mutable view[i64]) -> usize:
    let previous: mutable i64[MAX_N + 1] = zeroed
    let temporary: mutable i64[MAX_N + 1] = zeroed
    for i in 0 .. MAX_N + 1: connection[i] <- 0
    connection[0] <- 1
    previous[0] <- 1
    let degree: mutable usize = 0
    let shift: mutable usize = 1
    let previous_degree: mutable usize = 0
    let last_discrepancy: mutable i64 = 1
    let index: mutable usize = 0
    while index < length:
        let discrepancy: mutable i64 = sequence[index]
        let i: mutable usize = 1
        while i <= degree:
            discrepancy <- sparse_matrix_det_add(discrepancy,
                sparse_matrix_det_mul(connection[i], sequence[index - i]))
            i <- i + 1
        if discrepancy == 0:
            shift <- shift + 1
            index <- index + 1
            continue
        for i in 0 .. MAX_N + 1: temporary[i] <- connection[i]
        let scale: i64 = sparse_matrix_det_mul(discrepancy,
            sparse_matrix_det_pow(last_discrepancy, MOD - 2))
        i <- 0
        while i <= previous_degree:
            let target: usize = i + shift
            if target <= MAX_N:
                connection[target] <- sparse_matrix_det_sub(connection[target],
                    sparse_matrix_det_mul(scale, previous[i]))
            i <- i + 1
        if 2 * degree <= index:
            let old_degree: usize = degree
            degree <- index + 1 - degree
            for i in 0 .. MAX_N + 1: previous[i] <- temporary[i]
            previous_degree <- old_degree
            last_discrepancy <- discrepancy
            shift <- 1
        else:
            shift <- shift + 1
        index <- index + 1
    return degree

def sparse_matrix_det_dense(row: view[i64], column: view[i64], entry: view[i64],
        n: usize, k: usize) -> i64:
    let matrix: mutable i64[MAX_N * MAX_N] = zeroed
    let e: mutable usize = 0
    while e < k:
        matrix[row[e].usize() * MAX_N + column[e].usize()] <- entry[e]
        e <- e + 1
    let determinant: mutable i64 = 1
    let c: mutable usize = 0
    while c < n:
        let pivot: mutable usize = c
        while pivot < n and matrix[pivot * MAX_N + c] == 0: pivot <- pivot + 1
        if pivot == n: return 0
        if pivot != c:
            let j: mutable usize = 0
            while j < n:
                let temporary: i64 = matrix[c * MAX_N + j]
                matrix[c * MAX_N + j] <- matrix[pivot * MAX_N + j]
                matrix[pivot * MAX_N + j] <- temporary
                j <- j + 1
            determinant <- MOD - determinant
        let pivot_value: i64 = matrix[c * MAX_N + c]
        determinant <- sparse_matrix_det_mul(determinant, pivot_value)
        let inverse: i64 = sparse_matrix_det_pow(pivot_value, MOD - 2)
        let i: mutable usize = c + 1
        while i < n:
            if matrix[i * MAX_N + c] != 0:
                let factor: i64 = sparse_matrix_det_mul(matrix[i * MAX_N + c], inverse)
                let j: mutable usize = c + 1
                while j < n:
                    matrix[i * MAX_N + j] <- sparse_matrix_det_sub(matrix[i * MAX_N + j],
                        sparse_matrix_det_mul(factor, matrix[c * MAX_N + j]))
                    j <- j + 1
                matrix[i * MAX_N + c] <- 0
            i <- i + 1
        c <- c + 1
    return determinant

def sparse_matrix_det_wiedemann(row: view[i64], column: view[i64], entry: view[i64],
        n: usize, k: usize, seed_input: i64, success: mutable bool&) -> i64:
    let state: mutable i64 = seed_input
    let diagonal: mutable i64[MAX_N] = zeroed
    let left: mutable i64[MAX_N] = zeroed
    let vector: mutable i64[MAX_N] = zeroed
    let next: mutable i64[MAX_N] = zeroed
    let weighted: mutable i64[MAX_N] = zeroed
    let sequence: mutable i64[2 * MAX_N] = zeroed
    let diagonal_product: mutable i64 = 1
    let i: mutable usize = 0
    while i < n:
        diagonal[i] <- sparse_matrix_det_next(state)
        if diagonal[i] == 0: diagonal[i] <- 1
        left[i] <- sparse_matrix_det_next(state)
        vector[i] <- sparse_matrix_det_next(state)
        diagonal_product <- sparse_matrix_det_mul(diagonal_product, diagonal[i])
        i <- i + 1
    let step: mutable usize = 0
    while step < 2 * n:
        let dot: mutable i64 = 0
        i <- 0
        while i < n:
            dot <- sparse_matrix_det_add(dot, sparse_matrix_det_mul(left[i], vector[i]))
            i <- i + 1
        sequence[step] <- dot
        i <- 0
        while i < n:
            weighted[i] <- sparse_matrix_det_mul(diagonal[i], vector[i])
            next[i] <- 0
            i <- i + 1
        let e: mutable usize = 0
        while e < k:
            let r: usize = row[e].usize()
            let c: usize = column[e].usize()
            next[r] <- sparse_matrix_det_add(next[r], sparse_matrix_det_mul(entry[e], weighted[c]))
            e <- e + 1
        i <- 0
        while i < n:
            vector[i] <- next[i]
            i <- i + 1
        step <- step + 1
    let connection: mutable i64[MAX_N + 1] = zeroed
    if sparse_matrix_det_bm(sequence[0:2 * n], 2 * n, connection) != n:
        success <- false
        return 0
    let constant: mutable i64 = connection[n]
    if (n & 1) != 0 and constant != 0: constant <- MOD - constant
    success <- true
    return sparse_matrix_det_mul(constant,
        sparse_matrix_det_pow(diagonal_product, MOD - 2))

def sparse_matrix_det_store(value: i64, output: mutable view[u8]) -> void:
    let bits: mutable u64 = value.u64()
    let byte: mutable usize = 0
    while byte < 8:
        output[byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def sparse_matrix_det_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_PARSEABLE_INPUT: return -1
    let n_value: i64 = input[0]
    let k_value: i64 = input[1]
    if n_value < 1 or n_value > MAX_N.i64() or k_value < 1 or k_value > MAX_K.i64(): return -1
    let n: usize = n_value.usize()
    let k: usize = k_value.usize()
    if length != 2 + 3 * k: return -1
    let seen: mutable bool[MAX_N * MAX_N] = zeroed
    let row: mutable i64[MAX_K] = zeroed
    let column: mutable i64[MAX_K] = zeroed
    let entry: mutable i64[MAX_K] = zeroed
    let e: mutable usize = 0
    while e < k:
        let r: i64 = input[2 + 3 * e]
        let c: i64 = input[3 + 3 * e]
        let value: i64 = input[4 + 3 * e]
        if r < 0 or r >= n_value or c < 0 or c >= n_value or value < 1 or value >= MOD: return -1
        let key: usize = r.usize() * MAX_N + c.usize()
        if seen[key]: return -1
        seen[key] <- true
        row[e] <- r
        column[e] <- c
        entry[e] <- value
        e <- e + 1
    let determinant: mutable i64 = 0
    let found: mutable bool = false
    let attempt: mutable usize = 0
    while attempt < 4:
        let seed: mutable i64 = 104729 + attempt.i64() * 1000003
        if seed >= MOD: seed <- seed % MOD
        determinant <- sparse_matrix_det_wiedemann(row, column, entry, n, k, seed, found)
        if found: break
        attempt <- attempt + 1
    if not found: determinant <- sparse_matrix_det_dense(row, column, entry, n, k)
    if output.is_null() or capacity < 8: return -2
    sparse_matrix_det_store(determinant, output[0:8])
    return 8

export fn sparse_matrix_det(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = sparse_matrix_det_impl
