# Fresh bounded port based on NyaanNyaan's CC0 radix-2 Schönhage-Strassen method.
const LIMB_COUNT: usize = 513
const PADDED: usize = 2048
const SCRATCH_SIZE: usize = 4096
const OUTPUT_BYTES: usize = 129

def ss_zero(a: mutable view[i64], n: usize) -> void:
    for i in 0..<n: a[i] <- 0

def ss_copy(dst: mutable view[i64], src: view[i64], n: usize) -> void:
    for i in 0..<n: dst[i] <- src[i]

def ss_add(dst: mutable view[i64], src: view[i64], n: usize) -> void:
    for i in 0..<n: dst[i] <- dst[i] + src[i]

def ss_sub(dst: mutable view[i64], src: view[i64], n: usize) -> void:
    for i in 0..<n: dst[i] <- dst[i] - src[i]

def ss_rot(dst: mutable view[i64], src: view[i64], size: usize, shift: usize) -> void:
    d: mutable usize = shift
    wrapped: bool = d >= size
    if wrapped: d <- d - size
    i: mutable usize = 0
    if wrapped:
        while i < size - d:
            dst[i + d] <- -src[i]
            i <- i + 1
        while i < size:
            dst[i + d - size] <- src[i]
            i <- i + 1
    else:
        while i < size - d:
            dst[i + d] <- src[i]
            i <- i + 1
        while i < size:
            dst[i + d - size] <- -src[i]
            i <- i + 1

def ss_ctz(value: usize) -> usize:
    x: mutable usize = value
    bits: mutable usize = 0
    while (x & 1) == 0:
        bits <- bits + 1
        x <- x >> 1
    bits

def ss_fft(a: mutable view[i64], l: usize, m: usize, buf: mutable view[i64]) -> void:
    if l == 0: return
    len: usize = 1 << l
    block: usize = 1 << m
    dw: mutable i64[16] = zeroed
    for i in 0..<l - 1:
        dw[i] <- (1 << (l - 2 - i)) + (1 << (l - 1 - i)) - (1 << (l - 1))
        if dw[i] < 0: dw[i] <- dw[i] + len.i64()
        if len == block: dw[i] <- dw[i] * 2
        if 2 * len == block: dw[i] <- dw[i] * 4
    d: mutable usize = len / 2
    while d > 0:
        w: mutable i64 = 0
        s: mutable usize = 0
        k: mutable usize = 0
        while true:
            for i in s..<s + d:
                ai: mutable view[i64] = a[i * block:i * block + block]
                aj: mutable view[i64] = a[(i + d) * block:(i + d) * block + block]
                ss_rot(buf[0:block], aj, block, w.usize())
                ss_copy(aj, ai, block)
                ss_add(ai, buf[0:block], block)
                ss_sub(aj, buf[0:block], block)
            s <- s + 2 * d
            if s >= len: break
            k <- k + 1
            w <- w + dw[ss_ctz(k)]
            if w >= 2 * block.i64(): w <- w - 2 * block.i64()
        d <- d / 2

def ss_ifft(a: mutable view[i64], l: usize, m: usize, buf: mutable view[i64]) -> void:
    if l == 0: return
    len: usize = 1 << l
    block: usize = 1 << m
    dw: mutable i64[16] = zeroed
    for i in 0..<l - 1:
        dw[i] <- (1 << (l - 2 - i)) + (1 << (l - 1 - i)) - (1 << (l - 1))
        if dw[i] < 0: dw[i] <- dw[i] + len.i64()
        if len == block: dw[i] <- dw[i] * 2
        if 2 * len == block: dw[i] <- dw[i] * 4
    d: mutable usize = 1
    while d < len:
        w: mutable i64 = 0
        s: mutable usize = 0
        k: mutable usize = 0
        while true:
            for i in s..<s + d:
                ai: mutable view[i64] = a[i * block:i * block + block]
                aj: mutable view[i64] = a[(i + d) * block:(i + d) * block + block]
                ss_copy(buf[0:block], ai, block)
                ss_add(ai, aj, block)
                ss_sub(buf[0:block], aj, block)
                ss_rot(aj, buf[0:block], block, w.usize())
            s <- s + 2 * d
            if s >= len: break
            k <- k + 1
            w <- w - dw[ss_ctz(k)]
            if w < 0: w <- w + 2 * block.i64()
        d <- d * 2

def ss_naive(a: mutable view[i64], b: view[i64], n: usize, buf: mutable view[i64]) -> void:
    size: usize = 1 << n
    ss_zero(buf[0:size], size)
    for i in 0..<size:
        j: mutable usize = 0
        while j < size - i:
            buf[i + j] <- buf[i + j] + a[i] * b[j]
            j <- j + 1
        while j < size:
            buf[i + j - size] <- buf[i + j - size] - a[i] * b[j]
            j <- j + 1
    ss_copy(a[0:size], buf[0:size], size)

def ss_mul(a: mutable view[i64], b: view[i64], n: usize, buf: mutable view[i64]) -> void:
    if n <= 5:
        ss_naive(a, b, n, buf)
        return
    l: usize = (n + 1) / 2
    m: usize = n / 2
    len: usize = 1 << l
    block: usize = 1 << m
    aa: mutable i64[SCRATCH_SIZE] = zeroed
    bb: mutable i64[SCRATCH_SIZE] = zeroed
    ss_zero(buf[block:2 * block], block)
    for i in 0..<len:
        s: usize = i * (2 * block / len)
        ss_copy(buf[0:block], a[i * block:i * block + block], block)
        ss_rot(aa[i * block * 2:i * block * 2 + 2 * block], buf[0:2 * block], 2 * block, s)
        ss_copy(buf[0:block], b[i * block:i * block + block], block)
        ss_rot(bb[i * block * 2:i * block * 2 + 2 * block], buf[0:2 * block], 2 * block, s)
    ss_fft(aa[0:SCRATCH_SIZE], l, m + 1, buf)
    ss_fft(bb[0:SCRATCH_SIZE], l, m + 1, buf)
    for i in 0..<len: ss_mul(aa[i * block * 2:i * block * 2 + 2 * block], bb[i * block * 2:i * block * 2 + 2 * block], m + 1, buf)
    ss_ifft(aa[0:SCRATCH_SIZE], l, m + 1, buf)
    for i in 0..<len:
        s: usize = i * (2 * block / len)
        ss_copy(buf[0:2 * block], aa[i * block * 2:i * block * 2 + 2 * block], 2 * block)
        ss_rot(aa[i * block * 2:i * block * 2 + 2 * block], buf[0:2 * block], 2 * block, s)
    for i in 0..<len:
        for j in 0..<block:
            a[i * block + j] <- aa[i * block * 2 + j]
            if i == 0: a[i * block + j] <- a[i * block + j] - aa[(len - 1) * block * 2 + block + j]
            else: a[i * block + j] <- a[i * block + j] + aa[(i - 1) * block * 2 + block + j]

def ss_mul_cyclic(a: mutable view[i64], b: view[i64], n: usize, buf: mutable view[i64]) -> void:
    if n <= 5:
        ss_naive(a, b, n, buf)
        return
    l: usize = (n + 1) / 2
    m: usize = n / 2
    len: usize = 1 << l
    block: usize = 1 << m
    aa: mutable i64[SCRATCH_SIZE] = zeroed
    bb: mutable i64[SCRATCH_SIZE] = zeroed
    for i in 0..<len:
        ss_copy(aa[i * block * 2:i * block * 2 + 2 * block], a[i * block:i * block + block], block)
        ss_copy(bb[i * block * 2:i * block * 2 + 2 * block], b[i * block:i * block + block], block)
    ss_fft(aa[0:SCRATCH_SIZE], l, m + 1, buf)
    ss_fft(bb[0:SCRATCH_SIZE], l, m + 1, buf)
    for i in 0..<len: ss_mul(aa[i * block * 2:i * block * 2 + 2 * block], bb[i * block * 2:i * block * 2 + 2 * block], m + 1, buf)
    ss_ifft(aa[0:SCRATCH_SIZE], l, m + 1, buf)
    for i in 0..<len:
        previous: usize = if i == 0: len - 1 else: i - 1
        for j in 0..<block:
            a[i * block + j] <- aa[i * block * 2 + j] + aa[previous * block * 2 + block + j]

def schoenhage_strassen_multiply_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() || length != 1027 || input[0] != LIMB_COUNT.i64(): return -1
    a: mutable i64[PADDED] = zeroed
    b: mutable i64[PADDED] = zeroed
    scratch: mutable i64[PADDED] = zeroed
    for i in 0..<LIMB_COUNT:
        x: i64 = input[1 + i]
        y: i64 = input[1 + LIMB_COUNT + i]
        if x < 0 || x > 1 || y < 0 || y > 1: return -1
        a[i] <- x
        b[i] <- y
    if a[LIMB_COUNT - 1] != 1 || b[LIMB_COUNT - 1] != 1: return -1
    if output.is_null() || capacity < OUTPUT_BYTES: return -2
    ss_mul_cyclic(a[0:PADDED], b[0:PADDED], 11, scratch[0:PADDED])
    result: mutable u8[OUTPUT_BYTES] = zeroed
    carry: mutable i64 = 0
    for i in 0..<1025:
        value: i64 = a[i] + carry
        bit: u8 = (value % 2).u8()
        carry <- value / 2
        if bit != 0: result[OUTPUT_BYTES - 1 - i / 8] <- result[OUTPUT_BYTES - 1 - i / 8] | (bit << (i % 8))
    bit_index: mutable usize = 1025
    while carry > 0:
        if carry % 2 != 0: result[OUTPUT_BYTES - 1 - bit_index / 8] <- result[OUTPUT_BYTES - 1 - bit_index / 8] | (1.u8() << (bit_index % 8))
        carry <- carry / 2
        bit_index <- bit_index + 1
    for i in 0..<OUTPUT_BYTES: output[i] <- result[i]
    OUTPUT_BYTES.i64()

export fn schoenhage_strassen_multiply(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = schoenhage_strassen_multiply_impl
