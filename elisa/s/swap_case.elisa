def swap_case_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length > 4096:
        return -1
    if length > 0 and input.is_null():
        return -1
    invalid: mutable bool = false
    index: mutable usize = 0
    while index < length and not invalid:
        if input[index] < 0 or input[index] > 127:
            invalid <- true
        else:
            index <- index + 1
    if invalid:
        return -1
    if length > capacity or (length > 0 and output.is_null()):
        return -2
    index <- 0
    while index < length:
        value: mutable i64 = input[index]
        if value >= 65 and value <= 90:
            value <- value + 32
        else if value >= 97 and value <= 122:
            value <- value - 32
        output[index] <- value.u8()
        index <- index + 1
    length.i64()

export fn swap_case(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = swap_case_impl
