# Nonnegative subset existence with descending dynamic programming.
const MAX_ITEMS: usize = 64
const MAX_TARGET: i64 = 4096
const WIDTH: usize = 4097

def subset_sum_nonnegative_exists_impl(input: i64&, length: usize) -> i64:
    if length == 0 or length > MAX_ITEMS + 1:
        return -1
    target: i64 = input[0]
    if target < 0 or target > MAX_TARGET:
        return -1
    index: mutable usize = 1
    while index < length:
        if input[index] < 0 or input[index] > MAX_TARGET:
            return -1
        index <- index + 1
    reachable: mutable bool[WIDTH] = zeroed
    reachable[0] <- true
    index <- 1
    while index < length:
        item: i64 = input[index]
        sum: mutable i64 = target
        while sum >= item:
            if reachable[(sum - item).usize()]:
                reachable[sum.usize()] <- true
            sum <- sum - 1
        index <- index + 1
    if reachable[target.usize()]:
        return 1
    0

export fn subset_sum_nonnegative_exists(input: i64&, length: usize) -> i64 = subset_sum_nonnegative_exists_impl
