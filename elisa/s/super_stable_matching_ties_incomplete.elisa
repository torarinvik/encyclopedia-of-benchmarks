const SS_MAX_N: usize = 4
const SS_MAX_PARSEABLE_LENGTH: usize = 34

def super_stable_matching_ties_incomplete_impl(input: view[i64]) -> i64:
    if input.len() < 1 or input.len() > SS_MAX_PARSEABLE_LENGTH: return -1
    n_raw: i64 = input[0]
    if n_raw < 1 or n_raw > SS_MAX_N.i64(): return -1
    n: usize = n_raw.usize()
    if input.len() != 1 + 2 * n * n: return -1
    side: usize = n * n

    men_rank: mutable i64[SS_MAX_N][SS_MAX_N] = zeroed
    women_rank: mutable i64[SS_MAX_N][SS_MAX_N] = zeroed
    for man in 0..<n:
        for woman in 0..<n:
            rank: i64 = input[1 + man * n + woman]
            if rank < 0 or rank > n_raw: return -1
            men_rank[man][woman] <- rank
    for woman in 0..<n:
        for man in 0..<n:
            rank: i64 = input[1 + side + woman * n + man]
            if rank < 0 or rank > n_raw or ((rank > 0) != (men_rank[man][woman] > 0)): return -1
            women_rank[woman][man] <- rank
    for person in 0..<n:
        maximum: mutable i64 = 0
        for partner in 0..<n:
            if men_rank[person][partner] > maximum: maximum <- men_rank[person][partner]
        level: mutable i64 = 1
        while level <= maximum:
            found: mutable bool = false
            for partner in 0..<n:
                if men_rank[person][partner] == level: found <- true
            if not found: return -1
            level <- level + 1
        maximum <- 0
        for partner in 0..<n:
            if women_rank[person][partner] > maximum: maximum <- women_rank[person][partner]
        level <- 1
        while level <= maximum:
            found: mutable bool = false
            for partner in 0..<n:
                if women_rank[person][partner] == level: found <- true
            if not found: return -1
            level <- level + 1

    alive: mutable bool[SS_MAX_N][SS_MAX_N] = zeroed
    engaged: mutable bool[SS_MAX_N][SS_MAX_N] = zeroed
    proposed: mutable bool[SS_MAX_N] = zeroed
    for man in 0..<n:
        for woman in 0..<n: alive[man][woman] <- men_rank[man][woman] > 0
    while true:
        proposer: mutable usize = SS_MAX_N
        for man in 0..<n:
            has_engagement: mutable bool = false
            has_choice: mutable bool = false
            for woman in 0..<n:
                if engaged[man][woman]: has_engagement <- true
                if alive[man][woman]: has_choice <- true
            if proposer == SS_MAX_N and not has_engagement and has_choice: proposer <- man
        if proposer == SS_MAX_N: break
        head_rank: mutable i64 = n_raw + 1
        for woman in 0..<n:
            if alive[proposer][woman] and men_rank[proposer][woman] < head_rank:
                head_rank <- men_rank[proposer][woman]
        for woman in 0..<n:
            if not alive[proposer][woman]
                or men_rank[proposer][woman] != head_rank: continue
            proposed[woman] <- true
            engaged[proposer][woman] <- true
            for successor in 0..<n:
                if alive[successor][woman]
                    and women_rank[woman][successor] > women_rank[woman][proposer]:
                    engaged[successor][woman] <- false
                    alive[successor][woman] <- false
        for woman in 0..<n:
            count: mutable usize = 0
            tail_rank: mutable i64 = 0
            for man in 0..<n:
                if engaged[man][woman]: count <- count + 1
                if alive[man][woman] and women_rank[woman][man] > tail_rank:
                    tail_rank <- women_rank[woman][man]
            if count > 1:
                for man in 0..<n:
                    engaged[man][woman] <- false
                    if alive[man][woman] and women_rank[woman][man] == tail_rank:
                        alive[man][woman] <- false

    base: i64 = n_raw + 1
    limit: mutable i64 = 1
    for i in 0..<n: limit <- limit * base
    best_code: mutable i64 = 0
    best_size: mutable i64 = -1
    for code in 0..<limit:
        used: mutable i64 = 0
        size: mutable i64 = 0
        valid: mutable bool = true
        place: mutable i64 = limit / base
        for man in 0..<n:
            woman: usize = ((code / place) % base).usize()
            if woman < n:
                if not engaged[man][woman] or (used & (1 << woman)) != 0: valid <- false
                used <- used | (1 << woman)
                size <- size + 1
            if man + 1 < n: place <- place / base
        if valid and size > best_size:
            best_size <- size
            best_code <- code
    matched: mutable bool[SS_MAX_N] = zeroed
    place: mutable i64 = limit / base
    for man in 0..<n:
        woman: usize = ((best_code / place) % base).usize()
        if woman < n: matched[woman] <- true
        if man + 1 < n: place <- place / base
    for woman in 0..<n:
        if proposed[woman] and not matched[woman]: return -2
    best_code

export fn super_stable_matching_ties_incomplete(input: i64&, length: usize): i64:
    if input.is_null() or length < 1 or length > SS_MAX_PARSEABLE_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    super_stable_matching_ties_incomplete_impl(input_view)
