def streaming_triangles_put_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits >> (byte * 8)).u8()

def streaming_triangles_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 10 or length > 340: return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    se0: i64 = input[2]
    sw0: i64 = input[3]
    if n0 < 2 or n0 > 8 or m0 < 1 or m0 > 28 or se0 < 2 or se0 > 4 or sw0 < 1 or sw0 > 4: return -1
    m: usize = m0.usize()
    se: usize = se0.usize()
    sw: usize = sw0.usize()
    stride: usize = 2 + 2 * sw
    if length != 4 + 2 * m + m * stride: return -1
    seen: mutable u64 = 0
    edges: mutable u64[28] = zeroed
    for i in 0..<m:
        u: i64 = input[4 + 2 * i]
        v: i64 = input[5 + 2 * i]
        if u < 0 or v <= u or v >= n0: return -1
        bit: u64 = 1.u64() << ((u.u64() << 3) | v.u64())
        if (seen & bit) != 0: return -1
        seen <- seen | bit
        edges[i] <- (1.u64() << u.u64()) | (1.u64() << v.u64())
    edge_slots: mutable u64[4] = zeroed
    wedge_slots: mutable u64[4] = zeroed
    closed: mutable bool[4] = zeroed
    total: mutable i64 = 0
    staged: mutable i64[84] = zeroed
    at: mutable usize = 0
    tape: usize = 4 + 2 * m
    previous_limit: mutable u64 = 0
    for ti in 0..<m:
        t: usize = ti + 1
        rec: usize = tape + ti * stride
        incoming: u64 = edges[ti]
        for s in 0..<sw:
            if wedge_slots[s] == incoming: closed[s] <- true
        draw: i64 = input[rec]
        slot0: i64 = input[rec + 1]
        time_squared: u64 = t.u64() * t.u64()
        limit: u64 = time_squared if se == 2 else (time_squared * t.u64() if se == 3 else time_squared * time_squared)
        threshold: u64 = limit - previous_limit
        previous_limit <- limit
        if draw.u64() >= limit: return -1
        update: bool = draw.u64() < threshold
        fresh_wedge: mutable u64[4] = zeroed
        fresh_count: mutable usize = 0
        removed_count: mutable usize = 0
        if update:
            if slot0 < 0 or slot0 >= se.i64(): return -1
            slot: usize = slot0.usize()
            evicted: u64 = edge_slots[slot]
            for j in 0..<se:
                if j != slot:
                    resident: u64 = edge_slots[j]
                    if (evicted & resident) != 0:
                        removed_count <- removed_count + 1
                    # Distinct edges share at most one vertex. XOR leaves the two endpoints.
                    if (incoming & resident) != 0:
                        fresh_wedge[fresh_count] <- incoming ^ resident
                        fresh_count <- fresh_count + 1
            edge_slots[slot] <- incoming
        else:
            if slot0 != 0: return -1
        total <- total + fresh_count.i64() - removed_count.i64()
        if total < 0: return -1
        for s in 0..<sw:
            wd: i64 = input[rec + 2 + 2 * s]
            pick: i64 = input[rec + 3 + 2 * s]
            if fresh_count > 0:
                if wd < 0 or wd >= total: return -1
                if wd < fresh_count.i64():
                    if pick < 0 or pick >= fresh_count.i64(): return -1
                    wedge_slots[s] <- fresh_wedge[pick.usize()]
                    closed[s] <- false
                elif pick != 0: return -1
            elif wd != 0 or pick != 0: return -1
        hits: mutable i64 = 0
        for s in 0..<sw:
            if closed[s]: hits <- hits + 1
        staged[at] <- total
        staged[at + 1] <- ((3000000 * hits.u64()) / sw.u64()).i64()
        staged[at + 2] <- ((hits.u64() * time_squared * total.u64() * 1000000) / (sw * se * (se - 1)).u64()).i64()
        at <- at + 3
    bytes: usize = 24 * m
    if output == null or capacity < bytes: return -2
    for i in 0..<at:
        streaming_triangles_put_i64(output, i * 8, staged[i])
    bytes.i64()

export fn streaming_triangles(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = streaming_triangles_impl
