const MAX_VALUES: usize = 64
const MAX_INPUT_LENGTH: usize = 66
const MAX_FUNCTION_VALUE: i64 = 1000000

@intrinsic("llvm.ctpop.i32")
extern population_count(value: u32) -> u32

def sum_over_subsets_zeta_transform_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    bit_count64: i64 = input[0]
    if bit_count64 < 0 or bit_count64 > 6:
        return -1
    bit_count: usize = bit_count64.usize()
    state_count: usize = 1 << bit_count
    if length != state_count + 1:
        return -1

    checksum: mutable u64 = 0
    for mask in 0..<state_count:
        value: u64 = input[mask + 1].u64()
        if value > MAX_FUNCTION_VALUE.u64():
            return -1
        free_bits: u32 = (state_count - 1 - mask).u32()
        # Free bits occur in half the supersets. The bits in mask occur in all of them.
        # The sum of (superset + 1) over all supersets of mask.
        weight: u64 = ((state_count + mask + 1).u64() << population_count(free_bits)) >> 1
        checksum <- checksum + value * weight
    checksum.i64()

export fn sum_over_subsets_zeta_transform(input: i64&, length: usize) -> i64 = sum_over_subsets_zeta_transform_impl
