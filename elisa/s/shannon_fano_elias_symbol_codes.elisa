from std.collections import InlineArray

@export("shannon_fano_elias_symbol_codes")
fn shannon_fano_elias_symbol_codes(
    input: i64&, length: usize, output: mutable u8&, capacity: usize
) abi("C") -> Int64:
    if input.is_null() or length < 2 or length > 10:
        return -1
    let values: view[i64] = input[0:length]
    let raw_n = values[0]
    if raw_n < 1 or raw_n > 8 or length != (raw_n + 1).usize():
        return -1
    let n = raw_n.usize()
    var total: i64 = 0
    for i in range(n):
        let weight = values[1 + i]
        if weight < 1 or weight > 15: return -1
        total += weight
    if total > 120: return -1

    let needed = 1 + 2 * n
    if output.is_null() or capacity < needed: return -2
    var staged = InlineArray[UInt8, 17]()
    staged[0] = n.u8()
    var prefix: i64 = 0
    for i in range(n):
        let weight = values[1 + i]
        var bits: Int = 1
        while (i64(1) << (bits - 1)) * weight < total: bits += 1
        let numerator = (2 * prefix + weight) * (i64(1) << (bits - 1))
        let code = (numerator / total).u8()
        staged[1 + 2 * i] = bits.u8()
        staged[2 + 2 * i] = code << (8 - bits)
        prefix += weight
    let output_view: mutable view[u8] = output[0:needed]
    for i in range(needed): output_view[i] <- staged[i]
    Int64(needed)
