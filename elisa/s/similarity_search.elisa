extern sqrt(value: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def similarity_search_put_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8: output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def similarity_search_put_f64(output: mutable u8&, offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for byte in 0..<8: output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def similarity_search_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 3 or length > 643: return -1
    rows64: i64 = input[0]
    queries64: i64 = input[1]
    features64: i64 = input[2]
    if rows64 < 1 or rows64 > 32 or queries64 < 1 or queries64 > 8 or features64 < 1 or features64 > 16: return -1
    rows: usize = rows64.usize()
    queries: usize = queries64.usize()
    features: usize = features64.usize()
    if length != 3 + (rows + queries) * features: return -1
    for i in 0..<(rows + queries) * features:
        if input[3 + i] < -1000000 or input[3 + i] > 1000000: return -1
    record: usize = 16 + 8 * features
    needed: usize = queries * record
    if output == null or output_capacity < needed: return -2
    for query in 0..<queries:
        best: mutable usize = 0
        sum: mutable f64 = 0.0
        for f in 0..<features:
            delta: f64 = input[3 + f].f64() / 1000000.0 - input[3 + rows * features + query * features + f].f64() / 1000000.0
            sum <- sum + delta * delta
        best_distance: mutable f64 = sqrt(sum)
        for row in 1..<rows:
            sum <- 0.0
            for f in 0..<features:
                delta: f64 = input[3 + row * features + f].f64() / 1000000.0 - input[3 + rows * features + query * features + f].f64() / 1000000.0
                sum <- sum + delta * delta
            distance: f64 = sqrt(sum)
            if distance < best_distance:
                best <- row
                best_distance <- distance
        base: usize = query * record
        similarity_search_put_i64(output, base, best.i64())
        similarity_search_put_f64(output, base + 8, best_distance)
        for f in 0..<features: similarity_search_put_i64(output, base + 16 + 8 * f, input[3 + best * features + f])
    needed.i64()

export fn similarity_search(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = similarity_search_impl
