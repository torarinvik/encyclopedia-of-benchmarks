# Minimum turns for a printer that prints one symbol over a range per turn.
const MAX_LENGTH: i64 = 8
const MAX_SYMBOL: i64 = 2
const TABLE_SIDE: usize = 9

def strange_printer_impl(input: i64&?, length: usize) -> i64:
    if input == null or length < 1 or length > 10:
        return -1
    n_raw: i64 = input[0]
    if n_raw < 0 or n_raw > MAX_LENGTH or length != n_raw.usize() + 1:
        return -1
    n: usize = n_raw.usize()
    position: mutable usize = 0
    while position < n:
        if input[position + 1] < 0 or input[position + 1] > MAX_SYMBOL:
            return -1
        position <- position + 1
    if n == 0:
        return 0

    dp: mutable i64[81] = zeroed
    left: mutable usize = n
    while left > 0:
        left <- left - 1
        dp[left * TABLE_SIDE + left] <- 1
        right: mutable usize = left + 1
        while right < n:
            best: mutable i64 = dp[(left + 1) * TABLE_SIDE + right] + 1
            merge: mutable usize = left + 1
            while merge <= right:
                if input[left + 1] == input[merge + 1]:
                    middle: i64 = 0 if merge == left + 1 else dp[(left + 1) * TABLE_SIDE + merge - 1]
                    candidate: i64 = middle + dp[merge * TABLE_SIDE + right]
                    if candidate < best:
                        best <- candidate
                merge <- merge + 1
            dp[left * TABLE_SIDE + right] <- best
            right <- right + 1
    dp[n - 1]

export fn strange_printer(input: i64&?, length: usize) -> i64 = strange_printer_impl
