const SP_MAX_LENGTH: usize = 8
const SP_TABLE_SIDE: usize = 8

def strange_printer_impl(input: i64&?, length: usize) -> i64:
    if input == null or length - 1 > SP_MAX_LENGTH: return -1
    length_from_header: usize = length - 1
    if input[0].usize() != length_from_header: return -1
    symbols: mutable u8[8] = zeroed
    n: mutable usize = 0
    previous: mutable u64 = 3
    position: mutable usize = 0
    while position < length_from_header:
        symbol: u64 = input[position + 1].u64()
        if symbol > 2: return -1
        if symbol != previous:
            symbols[n] <- symbol.u8()
            n <- n + 1
            previous <- symbol
        position <- position + 1
    if n < 2: return n.i64()

    if n == 2: return 2
    if n == 3:
        if symbols[0] == symbols[2]: return 2
        return 3

    dp: mutable u8[64] = zeroed
    left: mutable usize = n
    while left > 0:
        left <- left - 1
        dp[left * SP_TABLE_SIDE + left] <- 1
        right: mutable usize = left + 1
        while right < n:
            best: mutable u8 = dp[(left + 1) * SP_TABLE_SIDE + right] + 1
            merge: mutable usize = left + 2
            while merge <= right:
                if symbols[left] == symbols[merge]:
                    middle: u8 = dp[(left + 1) * SP_TABLE_SIDE + merge - 1]
                    candidate: u8 = middle + dp[merge * SP_TABLE_SIDE + right]
                    if candidate < best: best <- candidate
                merge <- merge + 1
            dp[left * SP_TABLE_SIDE + right] <- best
            right <- right + 1
    return dp[n - 1].i64()


export fn strange_printer(input: i64&?, length: usize) -> i64 = strange_printer_impl
