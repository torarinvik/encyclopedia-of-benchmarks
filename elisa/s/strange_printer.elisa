const SP_MAX_LENGTH: usize = 8
const SP_TABLE_SIDE: usize = 8

@inline(always)
def append_printer_symbol(symbol: u64, symbols: mutable u64&, count: mutable usize&, previous: mutable u64&) -> bool:
    if symbol > 2: return false
    if symbol != previous[0]:
        symbols[0] <- symbols[0] | (symbol << (count[0] * 2))
        count[0] <- count[0] + 1
        previous[0] <- symbol
    true

def strange_printer_impl(input: i64&?, length: usize) -> i64:
    if input == null or length - 1 > SP_MAX_LENGTH: return -1
    length_from_header: usize = length - 1
    if input[0].usize() != length_from_header: return -1
    if length_from_header == 0: return 0
    first: u64 = input[1].u64()
    if first > 2: return -1
    symbols: mutable u64 = first
    n: mutable usize = 1
    previous: mutable u64 = first
    if length > 2 and not append_printer_symbol(input[2].u64(), &symbols, &n, &previous): return -1
    if length > 3 and not append_printer_symbol(input[3].u64(), &symbols, &n, &previous): return -1
    if length > 4 and not append_printer_symbol(input[4].u64(), &symbols, &n, &previous): return -1
    if length > 5 and not append_printer_symbol(input[5].u64(), &symbols, &n, &previous): return -1
    if length > 6 and not append_printer_symbol(input[6].u64(), &symbols, &n, &previous): return -1
    if length > 7 and not append_printer_symbol(input[7].u64(), &symbols, &n, &previous): return -1
    if length > 8 and not append_printer_symbol(input[8].u64(), &symbols, &n, &previous): return -1
    if n < 2: return n.i64()

    if n == 2: return 2
    if n == 3:
        if (symbols & 3) == ((symbols >> 4) & 3): return 2
        return 3

    # Two turns can create at most three runs. Four runs over three symbols
    # repeat some symbol, so one shared turn plus two others suffices.
    if n == 4: return 3

    strange_printer_interval(symbols, n)

@inline(never)
def strange_printer_interval(symbols: u64, n: usize) -> i64:
    dp: mutable u8[64] = zeroed
    left: mutable usize = n
    while left > 0:
        left <- left - 1
        dp[left * SP_TABLE_SIDE + left] <- 1
        right: mutable usize = left + 1
        while right < n:
            best: mutable u8 = dp[(left + 1) * SP_TABLE_SIDE + right] + 1
            merge: mutable usize = left + 2
            while merge <= right:
                if ((symbols >> (left * 2)) & 3) == ((symbols >> (merge * 2)) & 3):
                    middle: u8 = dp[(left + 1) * SP_TABLE_SIDE + merge - 1]
                    candidate: u8 = middle + dp[merge * SP_TABLE_SIDE + right]
                    if candidate < best: best <- candidate
                merge <- merge + 1
            dp[left * SP_TABLE_SIDE + right] <- best
            right <- right + 1
    return dp[n - 1].i64()


export fn strange_printer(input: i64&?, length: usize) -> i64 = strange_printer_impl
