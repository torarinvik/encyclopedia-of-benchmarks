const SP_MAX_LENGTH: usize = 8
const SP_TABLE_SIDE: usize = 8

@inline(always)
def append_printer_symbol(symbol: u64, symbols: mutable u64&, previous: mutable u64&, invalid: mutable u64&) -> void:
    invalid[0] <- invalid[0] | (1 if symbol > 2 else 0)
    if symbol != previous[0]:
        # Fixed shifts pack the runs in reverse order. Reversing every print
        # interval preserves the optimal turn count.
        symbols[0] <- (symbols[0] << 2) | symbol
        previous[0] <- symbol

def strange_printer_impl(input: i64&?, length: usize) -> i64:
    if input == null or length - 1 > SP_MAX_LENGTH: return -1
    length_from_header: usize = length - 1
    if input[0].usize() != length_from_header: return -1
    if length_from_header == 0: return 0
    first: u64 = input[1].u64()
    if first > 2: return -1
    if length_from_header == 1: return 1
    if length_from_header <= 4:
        second: u64 = input[2].u64()
        if second > 2: return -1
        if length_from_header == 2:
            return 1 if first == second else 2
        third: u64 = input[3].u64()
        if third > 2: return -1
        if length_from_header == 3:
            if first == third: return 1 if first == second else 2
            return 2 if second == first or second == third else 3
        fourth: u64 = input[4].u64()
        if fourth > 2: return -1
        # Count run boundaries directly. Three runs with equal endpoints
        # take two turns, and four runs over three symbols take three.
        left: i64 = 1 if first != second else 0
        middle: i64 = 1 if second != third else 0
        right: i64 = 1 if third != fourth else 0
        count: i64 = left + middle + right
        if count == 3: return 3
        return count if count == 2 and first == fourth else count + 1
    if length_from_header == SP_MAX_LENGTH:
        last: u64 = input[8].u64()
        # Equal endpoints can only use the uniform fast path.
        if last == first:
            differences: mutable u64 = 0
            for position in 2..<8:
                differences <- differences | (input[position].u64() ^ first)
            if differences == 0: return 1
        # One change between distinct valid endpoints proves two runs.
        elif last <= 2:
            equal_edges: mutable i64 = 0
            previous: mutable u64 = first
            for position in 2..<9:
                symbol: u64 = input[position].u64()
                equal_edges <- equal_edges + (1 if previous == symbol else 0)
                previous <- symbol
            if equal_edges == 6: return 2
    # The leading 1 sits just above the two bits for each run.
    symbols: mutable u64 = 4 | first
    previous: mutable u64 = first
    # Reject accumulated invalid symbols before interpreting the packed runs.
    invalid: mutable u64 = 0
    if length > 2: append_printer_symbol(input[2].u64(), &symbols, &previous, &invalid)
    if length > 3: append_printer_symbol(input[3].u64(), &symbols, &previous, &invalid)
    if length > 4: append_printer_symbol(input[4].u64(), &symbols, &previous, &invalid)
    if length > 5: append_printer_symbol(input[5].u64(), &symbols, &previous, &invalid)
    if length > 6: append_printer_symbol(input[6].u64(), &symbols, &previous, &invalid)
    if length > 7: append_printer_symbol(input[7].u64(), &symbols, &previous, &invalid)
    if length > 8: append_printer_symbol(input[8].u64(), &symbols, &previous, &invalid)
    if invalid != 0: return -1
    if symbols < 64: return 1 if symbols < 16 else 2
    if symbols < 256:
        if (symbols & 3) == ((symbols >> 4) & 3): return 2
        return 3
    # Two turns can create at most three runs. Four runs over three symbols
    # repeat some symbol, so one shared turn plus two others suffices.
    if symbols < 1024: return 3

    n: usize = (5 if symbols < 4096 else 6) if symbols < 16384 else (7 if symbols < 65536 else 8)
    # The interval worker only reads lanes below n, excluding the marker.
    strange_printer_interval(symbols, n)

@inline(always)
def first_printer_lane(bits: u64) -> usize:
    if bits == 0: return 0
    remaining: mutable u64 = bits
    zeros: mutable usize = 0
    while (remaining & 1) == 0:
        remaining <- remaining >> 1
        zeros <- zeros + 1
    zeros >> 1

@inline(never)
def strange_printer_interval(symbols: u64, n: usize) -> i64:
    if n < 5 or n > SP_MAX_LENGTH: return -1
    table: mutable u8[64] = zeroed
    # Every row and column index is below n, so offsets stay below 64.
    dp: mutable u8& = &table[0]
    # Seed the rows too short for the main loop.
    dp[(n - 1) * SP_TABLE_SIDE + n - 1] <- 1
    dp[(n - 2) * SP_TABLE_SIDE + n - 2] <- 1
    dp[(n - 2) * SP_TABLE_SIDE + n - 1] <- 2
    dp[(n - 3) * SP_TABLE_SIDE + n - 3] <- 1
    dp[(n - 3) * SP_TABLE_SIDE + n - 2] <- 2
    last_three: u64 = symbols >> ((n - 3) * 2)
    dp[(n - 3) * SP_TABLE_SIDE + n - 1] <- 2 if (last_three & 3) == ((last_three >> 4) & 3) else 3
    left: mutable usize = n - 3
    while left > 0:
        left <- left - 1
        dp[left * SP_TABLE_SIDE + left] <- 1
        dp[left * SP_TABLE_SIDE + left + 1] <- 2
        lane: u64 = (symbols >> (left * 2)) & 3
        # One low bit per two-bit lane marks each equal symbol.
        differences: u64 = symbols ^ (lane * 0x5555)
        matches: u64 = ~(differences | (differences >> 1)) & 0x5555
        lower_mask: u64 = (1.u64() << ((left + 2) * 2)) - 1
        eligible: u64 = matches & ~lower_mask
        # Three symbols can share a turn only when their endpoints match.
        third_lane: u64 = 1.u64() << ((left + 2) * 2)
        dp[left * SP_TABLE_SIDE + left + 2] <- 2 if (matches & third_lane) != 0 else 3
        # Four compressed symbols over a three-symbol alphabet need three turns.
        dp[left * SP_TABLE_SIDE + left + 3] <- 3
        # Admit one more two-bit lane as the right endpoint advances.
        upper_mask: mutable u64 = (lower_mask << 6) | 63
        right: mutable usize = left + 4
        while right < n:
            best: mutable u8 = dp[(left + 1) * SP_TABLE_SIDE + right] + 1
            candidates: mutable u64 = eligible & upper_mask
            while candidates != 0:
                merge: usize = first_printer_lane(candidates)
                middle: u8 = dp[(left + 1) * SP_TABLE_SIDE + merge - 1]
                candidate: u8 = middle + dp[merge * SP_TABLE_SIDE + right]
                if candidate < best: best <- candidate
                # Four or more compressed symbols need at least three turns.

                if best <= 3: break
                candidates <- candidates & (candidates - 1)
            dp[left * SP_TABLE_SIDE + right] <- best
            upper_mask <- (upper_mask << 2) | 3
            right <- right + 1
    return dp[n - 1].i64()


export fn strange_printer(input: i64&?, length: usize) -> i64 = strange_printer_impl
