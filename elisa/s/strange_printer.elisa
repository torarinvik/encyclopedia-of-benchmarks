const SP_MAX_LENGTH: usize = 8
const SP_TABLE_SIDE: usize = 8

@inline(always)
def append_printer_symbol(symbol: u64, symbols: mutable u64&, previous: mutable u64&) -> bool:
    if symbol > 2: return false
    if symbol != previous[0]:
        # Fixed shifts pack the runs in reverse order. Reversing every print
        # interval preserves the optimal turn count.
        symbols[0] <- (symbols[0] << 2) | symbol
        previous[0] <- symbol
    true

def strange_printer_impl(input: i64&?, length: usize) -> i64:
    if input == null or length - 1 > SP_MAX_LENGTH: return -1
    length_from_header: usize = length - 1
    if input[0].usize() != length_from_header: return -1
    if length_from_header == 0: return 0
    first: u64 = input[1].u64()
    if first > 2: return -1
    # Up to three positions need exactly one turn per distinct symbol.
    if length_from_header == 1: return 1
    if length_from_header <= 3:
        second: u64 = input[2].u64()
        if second > 2: return -1
        if length_from_header == 2:
            return 1 if first == second else 2
        third: u64 = input[3].u64()
        if third > 2: return -1
        second_is_new: i64 = 1 if first != second else 0
        third_is_new: i64 = 1 if first != third and second != third else 0
        return 1 + second_is_new + third_is_new
    # A full-length uniform input needs one turn. A different last symbol
    # rules it out before reading the interior a second time.
    if length_from_header == SP_MAX_LENGTH and input[8].u64() == first:
        left: u64 = (input[2].u64() ^ first) | (input[3].u64() ^ first)
        middle: u64 = (input[4].u64() ^ first) | (input[5].u64() ^ first)
        right: u64 = (input[6].u64() ^ first) | (input[7].u64() ^ first)
        if (left | middle | right) == 0: return 1
    # A single transition means every symbol equals one of the validated endpoints.
    if length_from_header == SP_MAX_LENGTH:
        last: u64 = input[8].u64()
        if last <= 2 and last != first:
            symbol_2: u64 = input[2].u64()
            symbol_3: u64 = input[3].u64()
            symbol_4: u64 = input[4].u64()
            symbol_5: u64 = input[5].u64()
            symbol_6: u64 = input[6].u64()
            symbol_7: u64 = input[7].u64()
            transitions: mutable i64 = (1 if first != symbol_2 else 0)
            transitions <- transitions + (1 if symbol_2 != symbol_3 else 0)
            transitions <- transitions + (1 if symbol_3 != symbol_4 else 0)
            transitions <- transitions + (1 if symbol_4 != symbol_5 else 0)
            transitions <- transitions + (1 if symbol_5 != symbol_6 else 0)
            transitions <- transitions + (1 if symbol_6 != symbol_7 else 0)
            transitions <- transitions + (1 if symbol_7 != last else 0)
            if transitions == 1: return 2
    # The leading 1 sits just above the two bits for each run.
    symbols: mutable u64 = 4 | first
    previous: mutable u64 = first
    if length > 2 and not append_printer_symbol(input[2].u64(), &symbols, &previous): return -1
    if length > 3 and not append_printer_symbol(input[3].u64(), &symbols, &previous): return -1
    if length > 4 and not append_printer_symbol(input[4].u64(), &symbols, &previous): return -1
    if length > 5 and not append_printer_symbol(input[5].u64(), &symbols, &previous): return -1
    if length > 6 and not append_printer_symbol(input[6].u64(), &symbols, &previous): return -1
    if length > 7 and not append_printer_symbol(input[7].u64(), &symbols, &previous): return -1
    if length > 8 and not append_printer_symbol(input[8].u64(), &symbols, &previous): return -1
    if symbols < 64: return 1 if symbols < 16 else 2
    if symbols < 256:
        if (symbols & 3) == ((symbols >> 4) & 3): return 2
        return 3
    # Two turns can create at most three runs. Four runs over three symbols
    # repeat some symbol, so one shared turn plus two others suffices.
    if symbols < 1024: return 3

    n: mutable usize = 5
    n <- 6 if symbols >= 4096
    n <- 7 if symbols >= 16384
    n <- 8 if symbols >= 65536
    # The interval worker only reads lanes below n, excluding the marker.
    strange_printer_interval(symbols, n)

@inline(always)
def first_printer_lane(bits: u64) -> usize:
    if bits == 0: return 0
    remaining: mutable u64 = bits
    zeros: mutable usize = 0
    while (remaining & 1) == 0:
        remaining <- remaining >> 1
        zeros <- zeros + 1
    zeros >> 1

@inline(never)
def strange_printer_interval(symbols: u64, n: usize) -> i64:
    if n < 5 or n > SP_MAX_LENGTH: return -1
    table: mutable u8[64] = zeroed
    # Every row and column index is below n, so offsets stay below 64.
    dp: mutable u8& = &table[0]
    left: mutable usize = n
    while left > 0:
        left <- left - 1
        dp[left * SP_TABLE_SIDE + left] <- 1
        lane: u64 = (symbols >> (left * 2)) & 3
        # One low bit per two-bit lane marks each equal symbol.
        differences: u64 = symbols ^ (lane * 0x5555)
        matches: u64 = ~(differences | (differences >> 1)) & 0x5555
        right: mutable usize = left + 1
        while right < n:
            best: mutable u8 = dp[(left + 1) * SP_TABLE_SIDE + right] + 1
            candidates: mutable u64 = matches & ((1.u64() << ((right + 1) * 2)) - 1) & ~((1.u64() << ((left + 2) * 2)) - 1)
            while candidates != 0:
                merge: usize = first_printer_lane(candidates)
                middle: u8 = dp[(left + 1) * SP_TABLE_SIDE + merge - 1]
                candidate: u8 = middle + dp[merge * SP_TABLE_SIDE + right]
                if candidate < best: best <- candidate
                candidates <- candidates & (candidates - 1)
            dp[left * SP_TABLE_SIDE + right] <- best
            right <- right + 1
    return dp[n - 1].i64()


export fn strange_printer(input: i64&?, length: usize) -> i64 = strange_printer_impl
