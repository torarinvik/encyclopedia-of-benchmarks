const SEPM_MODULUS: i64 = 998_244_353
const SEPM_MAX_DEGREE: usize = 32
const SEPM_MOMENT_COUNT: usize = 33
const SEPM_CHOOSE_COUNT: usize = 1089

def sepm_shift(source: view[i64], shift: u64, degree: usize,
               choose: view[i64], destination: mutable view[i64]) -> void:
    powers: mutable i64[SEPM_MOMENT_COUNT] = zeroed
    powers[0] <- 1
    reduced_shift: i64 = (shift % SEPM_MODULUS.u64()).i64()
    for i in 1..<degree + 1:
        powers[i] <- powers[i - 1] * reduced_shift % SEPM_MODULUS
    for d in 0..<degree + 1:
        total: mutable i64 = 0
        for k in 0..<d + 1:
            term: i64 = choose[d * SEPM_MOMENT_COUNT + k] * powers[d - k] % SEPM_MODULUS
            total <- (total + term * source[k]) % SEPM_MODULUS
        destination[d] <- total

def sepm_evaluate(input: view[i64], length: usize) -> i64:
    if length != 3: return -1
    r: i64 = input[0]
    degree_value: i64 = input[1]
    n_value: i64 = input[2]
    if r < 0 or r >= SEPM_MODULUS or degree_value < 0 or degree_value > SEPM_MAX_DEGREE.i64() or
        n_value < 0 or n_value > 1_000_000_000_000_000_000: return -1
    degree: usize = degree_value.usize()
    choose: mutable i64[SEPM_CHOOSE_COUNT] = zeroed
    choose[0] <- 1
    for d in 1..<degree + 1:
        choose[d * SEPM_MOMENT_COUNT] <- 1
        choose[d * SEPM_MOMENT_COUNT + d] <- 1
        for k in 1..<d:
            choose[d * SEPM_MOMENT_COUNT + k] <-
                (choose[(d - 1) * SEPM_MOMENT_COUNT + k - 1] +
                 choose[(d - 1) * SEPM_MOMENT_COUNT + k]) % SEPM_MODULUS

    accumulated: mutable i64[SEPM_MOMENT_COUNT] = zeroed
    block: mutable i64[SEPM_MOMENT_COUNT] = zeroed
    shifted: mutable i64[SEPM_MOMENT_COUNT] = zeroed
    choose_view: view[i64] = choose[0:SEPM_CHOOSE_COUNT]
    block_view: view[i64] = block[0:SEPM_MOMENT_COUNT]
    shifted_view: mutable view[i64] = shifted[0:SEPM_MOMENT_COUNT]
    block[0] <- 1
    accumulated_power: mutable i64 = 1
    block_power: mutable i64 = r
    accumulated_length: mutable u64 = 0
    block_length: mutable u64 = 1
    remaining: mutable u64 = n_value.u64()
    while remaining > 0:
        if (remaining & 1) != 0:
            sepm_shift(block_view, accumulated_length, degree, choose_view, shifted_view)
            for d in 0..<degree + 1:
                accumulated[d] <- (accumulated[d] + accumulated_power * shifted[d]) % SEPM_MODULUS
            accumulated_power <- accumulated_power * block_power % SEPM_MODULUS
            accumulated_length <- accumulated_length + block_length
        sepm_shift(block_view, block_length, degree, choose_view, shifted_view)
        for d in 0..<degree + 1:
            block[d] <- (block[d] + block_power * shifted[d]) % SEPM_MODULUS
        block_power <- block_power * block_power % SEPM_MODULUS
        block_length <- block_length << 1
        remaining <- remaining >> 1
    accumulated[degree]

export fn sum_of_exponential_times_polynomial(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 3: return -1
    input_view: view[i64] = input[0:length]
    sepm_evaluate(input_view, length)
