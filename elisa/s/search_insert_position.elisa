# Return the insertion point in a strictly increasing signed 32-bit array.
def search_insert_position_impl(input: i64&, length: usize) -> i64:
    if length < 1 or length > 257:
        return -1
    target: i64 = input[0]
    if target < -2147483648 or target > 2147483647:
        return -1
    for index in 1..<length |input|:
        if input[index] < -2147483648 or input[index] > 2147483647:
            return -1
        if index > 1 and input[index - 1] >= input[index]:
            return -1
    low: mutable usize = 0
    high: mutable usize = length - 1
    while low < high |low, high, input, target|:
        middle: usize = low + (high - low) / 2
        if input[middle + 1] < target:
            low <- middle + 1
        else:
            high <- middle
    low.i64()

export fn search_insert_position(input: i64&, length: usize) -> i64 = search_insert_position_impl
