def select_bits_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 1 or length > 3:
        return -1

    number: i64 = values[0]
    if number < 0 or number > 9007199254740991:
        return -1

    first: i64 = 1
    last: i64 = 53
    if length >= 2:
        first = values[1]
    if length >= 3:
        last = values[2]
    if first < 1 or first > 53 or last < 1 or last > 53:
        return -1

    modulus: i64 = 1.i64() << last.u32()
    (number % modulus) >> (first - 1).u32()

export fn select_bits(values: i64&, length: usize) -> i64 = select_bits_impl
