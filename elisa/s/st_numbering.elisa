# Even-Tarjan st-numbering: DFS lowpoints from s over the edge (s, t) first,
# then the sign-driven list insertion in preorder.
const MAX_VERTICES: usize = 8
const MAX_EDGES: usize = 28
const MAX_INPUT: usize = 60

def st_numbering_impl(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or input_length < 4 or input_length > MAX_INPUT:
        return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    s_value: i64 = input[2]
    t_value: i64 = input[3]
    if n_value < 2 or n_value > MAX_VERTICES.i64() or m_value < 0 or m_value > MAX_EDGES.i64() or s_value < 0 or s_value >= n_value or t_value < 0 or t_value >= n_value or s_value == t_value or input_length != 4 + 2 * m_value.usize():
        return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    s: usize = s_value.usize()
    t: usize = t_value.usize()

    edge_u: mutable usize[28] = zeroed
    edge_v: mutable usize[28] = zeroed
    adjacent: mutable u16[8] = zeroed
    st_edge: mutable i64 = -1
    edge: mutable usize = 0
    while edge < m:
        u_value: i64 = input[4 + 2 * edge]
        v_value: i64 = input[5 + 2 * edge]
        if u_value < 0 or u_value >= n_value or v_value < 0 or v_value >= n_value or u_value == v_value:
            return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        if (adjacent[u] & (1.u16() << v.u16())) != 0:
            return -1
        adjacent[u] <- adjacent[u] | (1.u16() << v.u16())
        adjacent[v] <- adjacent[v] | (1.u16() << u.u16())
        edge_u[edge] <- u
        edge_v[edge] <- v
        if (u == s and v == t) or (u == t and v == s):
            st_edge <- edge.i64()
        edge <- edge + 1
    if st_edge < 0:
        return -1

    head: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
    arc_to: mutable usize[56] = zeroed
    arc_next: mutable i64[56] = zeroed
    arc_count: mutable usize = 0
    edge <- 0
    while edge < m:
        if edge.i64() != st_edge:
            u: usize = edge_u[edge]
            v: usize = edge_v[edge]
            arc_to[arc_count] <- v
            arc_next[arc_count] <- head[u]
            head[u] <- arc_count.i64()
            arc_count <- arc_count + 1
            arc_to[arc_count] <- u
            arc_next[arc_count] <- head[v]
            head[v] <- arc_count.i64()
            arc_count <- arc_count + 1
        edge <- edge + 1
    arc_to[arc_count] <- t
    arc_next[arc_count] <- head[s]
    head[s] <- arc_count.i64()
    arc_count <- arc_count + 1
    arc_to[arc_count] <- s
    arc_next[arc_count] <- head[t]
    head[t] <- arc_count.i64()
    arc_count <- arc_count + 1

    parent: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
    discovery: mutable i64[8] = zeroed
    low_vertex: mutable usize[8] = zeroed
    children: mutable i64[8] = zeroed
    next_arc: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
    preorder: mutable usize[8] = zeroed
    vertex: mutable usize = 0
    while vertex < n:
        low_vertex[vertex] <- vertex
        vertex <- vertex + 1
    dfs_stack: mutable usize[8] = zeroed
    top: mutable usize = 0
    clock: mutable i64 = 1
    preorder_count: mutable usize = 1
    discovery[s] <- clock
    preorder[0] <- s
    next_arc[s] <- head[s]
    dfs_stack[top] <- s
    top <- top + 1
    while top > 0:
        current: usize = dfs_stack[top - 1]
        arc: i64 = next_arc[current]
        if arc < 0:
            top <- top - 1
            ancestor: i64 = parent[current]
            if ancestor >= 0 and discovery[low_vertex[current]] < discovery[low_vertex[ancestor.usize()]]:
                low_vertex[ancestor.usize()] <- low_vertex[current]
            continue
        next_arc[current] <- arc_next[arc.usize()]
        neighbor: usize = arc_to[arc.usize()]
        if neighbor.i64() == parent[current]:
            continue
        if discovery[neighbor] == 0:
            parent[neighbor] <- current.i64()
            children[current] <- children[current] + 1
            clock <- clock + 1
            discovery[neighbor] <- clock
            low_vertex[neighbor] <- neighbor
            preorder[preorder_count] <- neighbor
            preorder_count <- preorder_count + 1
            next_arc[neighbor] <- head[neighbor]
            dfs_stack[top] <- neighbor
            top <- top + 1
        elif discovery[neighbor] < discovery[current] and discovery[neighbor] < discovery[low_vertex[current]]:
            low_vertex[current] <- neighbor
    if preorder_count != n or children[s] != 1:
        return -1
    vertex <- 0
    while vertex < n:
        if vertex != s:
            child: mutable usize = 0
            while child < n:
                if parent[child] == vertex.i64() and discovery[low_vertex[child]] >= discovery[vertex]:
                    return -1
                child <- child + 1
        vertex <- vertex + 1

    previous: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
    following: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
    sign: mutable i64[8] = zeroed
    sign[s] <- -1
    following[s] <- t.i64()
    previous[t] <- s.i64()
    list_head: mutable i64 = s.i64()
    order: mutable usize = 2
    while order < n:
        current: usize = preorder[order]
        ancestor: usize = parent[current].usize()
        if sign[low_vertex[current]] == -1:
            left: i64 = previous[ancestor]
            previous[current] <- left
            following[current] <- ancestor.i64()
            previous[ancestor] <- current.i64()
            if left >= 0:
                following[left.usize()] <- current.i64()
            else:
                list_head <- current.i64()
            sign[ancestor] <- 1
        else:
            right: i64 = following[ancestor]
            previous[current] <- ancestor.i64()
            following[current] <- right
            following[ancestor] <- current.i64()
            if right >= 0:
                previous[right.usize()] <- current.i64()
            sign[ancestor] <- -1
        order <- order + 1

    rank: mutable i64[8] = zeroed
    staged: mutable u8[8] = zeroed
    rank_value: mutable i64 = 1
    walk: mutable i64 = list_head
    while walk >= 0 and rank_value <= n_value:
        rank[walk.usize()] <- rank_value
        staged[walk.usize()] <- rank_value.u8()
        rank_value <- rank_value + 1
        walk <- following[walk.usize()]
    if rank_value != n_value + 1 or rank[s] != 1 or rank[t] != n_value:
        return -1
    vertex <- 0
    while vertex < n:
        if vertex != s and vertex != t:
            lower: mutable bool = false
            higher: mutable bool = false
            arc: mutable i64 = head[vertex]
            while arc >= 0:
                neighbor: usize = arc_to[arc.usize()]
                lower <- lower or rank[neighbor] < rank[vertex]
                higher <- higher or rank[neighbor] > rank[vertex]
                arc <- arc_next[arc.usize()]
            if not lower or not higher:
                return -1
        vertex <- vertex + 1
    if output == null or output_capacity < n:
        return -2
    vertex <- 0
    while vertex < n:
        output[vertex] <- staged[vertex]
        vertex <- vertex + 1
    n_value

export fn st_numbering(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64 = st_numbering_impl
