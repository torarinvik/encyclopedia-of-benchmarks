@inline(never)
def st_numbering_valid_shape(input: i64&, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input_length < 4 or input_length > 60:
        return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    s_value: i64 = input[2]
    t_value: i64 = input[3]
    if n_value < 2 or n_value > 8 or m_value.u64() > 28 or s_value.u64() >= n_value.u64() or t_value.u64() >= n_value.u64() or s_value == t_value:
        return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    s: usize = s_value.usize()
    t: usize = t_value.usize()
    if input_length != 4 + 2 * m:
        return -1

    # Each of the eight byte lanes holds one vertex’s adjacency mask.
    adjacency: mutable u64 = 0
    # Set the high bit of each four-bit entry so vertex zero is distinguishable
    # from an empty list. Each vertex has at most seven neighbors.
    pending_neighbors: mutable u32[8] = zeroed
    vertex: mutable usize = 0
    edge: mutable usize = 0
    while edge < m:
        u_value: i64 = input[4 + 2 * edge]
        v_value: i64 = input[5 + 2 * edge]
        if u_value.u64() >= n_value.u64() or v_value.u64() >= n_value.u64() or u_value == v_value:
            return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        u_bit: u64 = 1 << (8 * u + v)
        v_bit: u64 = 1 << (8 * v + u)
        if (adjacency & u_bit) != 0:
            return -1
        adjacency <- adjacency | u_bit | v_bit
        if u != s and v != s:
            pending_neighbors[u] <- (pending_neighbors[u] << 4) | (v.u32() | 8)
            pending_neighbors[v] <- (pending_neighbors[v] << 4) | (u.u32() | 8)
        edge <- edge + 1
    if (adjacency & (1 << (8 * s + t))) == 0:
        return -1

    if n == 2:
        if output == null or output_capacity < 2:
            return -2
        output[s] <- 1
        output[t] <- 2
        return 2

    if n == 3:
        if m != 3:
            return -1
        if output == null or output_capacity < 3:
            return -2
        output[s] <- 1
        output[3 - s - t] <- 2
        output[t] <- 3
        return 3

    parent: mutable i64[8] = zeroed
    discovery: mutable u8[8] = zeroed
    low_rank: mutable u8[8] = zeroed
    preorder: mutable usize[8] = zeroed
    # A valid root has only the terminal t as its DFS child. Start there and
    # reject the graph if this subtree does not reach every vertex.
    preorder_count: mutable usize = 2
    discovery[s] <- 1
    discovery[t] <- 2
    parent[t] <- s.i64()
    low_rank[t] <- 2
    preorder[0] <- s
    preorder[1] <- t
    vertex <- t
    current_parent: mutable usize = s
    while vertex != s:
        neighbors: u32 = pending_neighbors[vertex]
        if neighbors == 0:
            ancestor: usize = current_parent
            if ancestor != s:
                child_low: u8 = low_rank[vertex]
                if child_low >= discovery[ancestor]:
                    return -1
                if child_low < low_rank[ancestor]:
                    low_rank[ancestor] <- child_low
            vertex <- ancestor
            current_parent <- parent[vertex].usize()
            continue
        pending_neighbors[vertex] <- neighbors >> 4
        neighbor: usize = (neighbors & 7).usize()
        if neighbor == current_parent:
            continue
        if discovery[neighbor] == 0:
            parent[neighbor] <- vertex.i64()
            # An edge to s reaches the earliest discovery rank immediately.
            preorder[preorder_count] <- neighbor
            preorder_count <- preorder_count + 1
            discovery[neighbor] <- preorder_count.u8()
            low_rank[neighbor] <- 1 if (adjacency & (1 << (8 * s + neighbor))) != 0 else preorder_count.u8()
            current_parent <- vertex
            vertex <- neighbor
        elif discovery[neighbor] < low_rank[vertex]:
            low_rank[vertex] <- discovery[neighbor]
    if preorder_count != n:
        return -1
    previous: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
    following: mutable i64[8] = [-1, -1, -1, -1, -1, -1, -1, -1]
    # Only negative signs affect insertion. One bit per discovery rank is enough.
    negative_signs: mutable u64 = 2
    following[s] <- t.i64()
    previous[t] <- s.i64()
    list_head: mutable usize = s
    order: mutable usize = 2
    while order < n:
        vertex <- preorder[order]
        ancestor: usize = parent[vertex].usize()
        if (negative_signs & (1 << low_rank[vertex].usize())) != 0:
            left_value: i64 = previous[ancestor]
            previous[vertex] <- left_value
            following[vertex] <- ancestor.i64()
            previous[ancestor] <- vertex.i64()
            if left_value >= 0:
                following[left_value.usize()] <- vertex.i64()
            else:
                list_head <- vertex
            negative_signs <- negative_signs & ~(1 << discovery[ancestor].usize())
        else:
            right_value: i64 = following[ancestor]
            previous[vertex] <- ancestor.i64()
            following[vertex] <- right_value
            following[ancestor] <- vertex.i64()
            if right_value >= 0:
                previous[right_value.usize()] <- vertex.i64()
            negative_signs <- negative_signs | (1 << discovery[ancestor].usize())
        order <- order + 1

    staged: mutable u8[8] = zeroed
    lower_vertices: mutable u64 = 0
    rank_value: mutable i64 = 1
    vertex_value: mutable i64 = list_head.i64()
    while vertex_value >= 0 and rank_value <= n.i64():
        vertex <- vertex_value.usize()
        if vertex != s and vertex != t:
            # Previously visited vertices have lower rank, and self-loops were rejected.
            neighbors: u64 = (adjacency >> (vertex * 8)) & 255
            if (neighbors & lower_vertices) == 0 or (neighbors & ~lower_vertices) == 0:
                return -1
        lower_vertices <- lower_vertices | (1 << vertex)
        staged[vertex] <- rank_value.u8()
        rank_value <- rank_value + 1
        vertex_value <- following[vertex]
    if rank_value != n.i64() + 1 or staged[s] != 1 or staged[t] != n.u8():
        return -1
    if output == null or output_capacity < n:
        return -2
    vertex <- 0
    while vertex < n:
        output[vertex] <- staged[vertex]
        vertex <- vertex + 1
    n.i64()

# Even-Tarjan DFS/lowpoint st-numbering with packed adjacency lists.
def st_numbering_impl(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null:
        return -1
    st_numbering_valid_shape(input, input_length, output, output_capacity)

export fn st_numbering(input: i64&?, input_length: usize, output: mutable u8&?, output_capacity: usize) -> i64 = st_numbering_impl
