const MAX_N: usize = 8
const MAX_INPUT_LENGTH: usize = 129

def stable_matching_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH: return -1
    n_arg: i64 = input[0]
    if n_arg < 0 or n_arg > MAX_N.i64(): return -1
    n: usize = n_arg.usize()
    side_size: usize = n * n
    if length != 1 + 2 * side_size: return -1

    if n == 0: return -2 if output == null else 0
    stable_matching_valid_input(input, n, output, capacity)

@inline(never)
def stable_matching_valid_input(input: i64&, n: usize, output: mutable u8&?, capacity: usize) -> i64:
    n_arg: i64 = n.i64()
    side_size: usize = n * n
    men_preferences: mutable u8[64] = zeroed
    women_rank: mutable u8[64] = zeroed
    complete_row: u64 = (1.u64() << n) - 1
    row: mutable usize = 0
    while row < n:
        seen: mutable u64 = 0
        row_start: usize = 1 + row * n
        rank: mutable usize = 0
        while rank < n:
            participant: i64 = input[row_start + rank]
            if participant.u64() >= n_arg.u64(): return -1
            seen <- seen | (1.u64() << participant.u64())
            men_preferences[row * MAX_N + rank] <- participant.u8()
            rank <- rank + 1
        if seen != complete_row: return -1
        row <- row + 1

    row <- 0
    while row < n:
        seen: mutable u64 = 0
        row_start: usize = 1 + side_size + row * n
        rank: mutable usize = 0
        while rank < n:
            participant: i64 = input[row_start + rank]
            if participant.u64() >= n_arg.u64(): return -1
            seen <- seen | (1.u64() << participant.u64())
            women_rank[row * MAX_N + participant.usize()] <- rank.u8()
            rank <- rank + 1
        if seen != complete_row: return -1
        row <- row + 1

    output_bytes: usize = 16 * n
    if output == null or capacity < output_bytes: return -2

    woman_partner: mutable u8[8] = zeroed
    man_partner: mutable i64[8] = zeroed
    next_proposal: mutable usize[8] = zeroed
    proposer: mutable usize = 0
    while proposer < n:
        active: mutable usize = proposer
        while true:
            rank: usize = next_proposal[active]
            next_proposal[active] <- rank + 1
            woman: usize = men_preferences[active * MAX_N + rank].usize()
            incumbent_code: usize = woman_partner[woman].usize()
            if incumbent_code == 0:
                woman_partner[woman] <- (active + 1).u8()
                man_partner[active] <- woman.i64()
                break
            if women_rank[woman * MAX_N + active] < women_rank[woman * MAX_N + (incumbent_code - 1)]:
                woman_partner[woman] <- (active + 1).u8()
                man_partner[active] <- woman.i64()
                active <- (incumbent_code - 1)
        proposer <- proposer + 1

    man: mutable usize = 0
    while man < n:
        pair_index: mutable usize = 0
        while pair_index < 2:
            value: i64 = man.i64() if pair_index == 0 else man_partner[man]
            bits: mutable u64 = value.u64()
            byte: mutable usize = 0
            while byte < 8:
                output[(man * 2 + pair_index) * 8 + byte] <- (bits & 255).u8()
                bits <- bits >> 8
                byte <- byte + 1
            pair_index <- pair_index + 1
        man <- man + 1
    output_bytes.i64()

export fn stable_matching(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stable_matching_impl
