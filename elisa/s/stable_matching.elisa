# Men-proposing deferred acceptance for bounded complete preference lists.
const MAX_N: usize = 8
const MAX_INPUT_LENGTH: usize = 129

def stable_matching_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    if input[0] < 0 or input[0] > MAX_N.i64():
        return -1
    n: usize = input[0].usize()
    side_size: usize = n * n
    if length != 1 + 2 * side_size:
        return -1

    men_preferences: mutable i64[64] = zeroed
    women_rank: mutable i64[64] = zeroed
    row: mutable usize = 0
    while row < 2 * n:
        seen: mutable u8[8] = zeroed
        row_start: usize = 1 + row * n if row < n else 1 + side_size + (row - n) * n
        rank: mutable usize = 0
        while rank < n:
            participant: i64 = input[row_start + rank]
            if participant < 0 or participant >= n.i64() or seen[participant.usize()] != 0:
                return -1
            seen[participant.usize()] <- 1
            if row < n:
                men_preferences[row * n + rank] <- participant
            else:
                women_rank[(row - n) * n + participant.usize()] <- rank.i64()
            rank <- rank + 1
        row <- row + 1

    output_bytes: usize = 16 * n
    if output == null or capacity < output_bytes:
        return -2

    woman_partner: mutable i64[8] = zeroed
    man_partner: mutable i64[8] = zeroed
    next_proposal: mutable usize[8] = zeroed
    free_queue: mutable usize[8] = zeroed
    index: mutable usize = 0
    while index < n:
        woman_partner[index] <- -1
        man_partner[index] <- -1
        free_queue[index] <- index
        index <- index + 1
    queue_start: mutable usize = 0
    queue_end: mutable usize = 0
    queue_count: mutable usize = n
    while queue_count > 0:
        man: usize = free_queue[queue_start]
        queue_start <- (queue_start + 1) % n
        queue_count <- queue_count - 1
        rank: usize = next_proposal[man]
        next_proposal[man] <- rank + 1
        woman: usize = men_preferences[man * n + rank].usize()
        incumbent: i64 = woman_partner[woman]
        if incumbent < 0:
            woman_partner[woman] <- man.i64()
            man_partner[man] <- woman.i64()
        elif women_rank[woman * n + man] < women_rank[woman * n + incumbent.usize()]:
            woman_partner[woman] <- man.i64()
            man_partner[man] <- woman.i64()
            man_partner[incumbent.usize()] <- -1
            free_queue[queue_end] <- incumbent.usize()
            queue_end <- (queue_end + 1) % n
            queue_count <- queue_count + 1
        else:
            free_queue[queue_end] <- man
            queue_end <- (queue_end + 1) % n
            queue_count <- queue_count + 1

    man: mutable usize = 0
    while man < n:
        pair: i64[2] = [man.i64(), man_partner[man]]
        item: mutable usize = 0
        while item < 2:
            bits: mutable u64 = pair[item].u64()
            byte: mutable usize = 0
            while byte < 8:
                output[(man * 2 + item) * 8 + byte] <- (bits & 255).u8()
                bits <- bits >> 8
                byte <- byte + 1
            item <- item + 1
        man <- man + 1
    output_bytes.i64()

export fn stable_matching(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stable_matching_impl
