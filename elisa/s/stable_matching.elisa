const MAX_N: usize = 8
const MAX_INPUT_LENGTH: usize = 129

def stable_matching_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH: return -1
    n_arg: i64 = input[0]
    if n_arg < 0 or n_arg > MAX_N.i64(): return -1
    n: usize = n_arg.usize()
    side_size: usize = n * n
    if length != 1 + 2 * side_size: return -1

    men_preferences: mutable i64[64] = zeroed
    women_rank: mutable i64[64] = zeroed
    row: mutable usize = 0
    while row < 2 * n:
        seen: mutable bool[8] = zeroed
        row_start: mutable usize = 1 + row * n
        if row >= n: row_start <- 1 + side_size + (row - n) * n
        rank: mutable usize = 0
        while rank < n:
            participant: i64 = input[row_start + rank]
            if participant < 0 or participant >= n_arg or seen[participant.usize()]: return -1
            seen[participant.usize()] <- true
            if row < n: men_preferences[row * n + rank] <- participant
            else: women_rank[(row - n) * n + participant.usize()] <- rank.i64()
            rank <- rank + 1
        row <- row + 1

    output_bytes: usize = 16 * n
    if output == null or capacity < output_bytes: return -2

    woman_partner: mutable i64[8] = zeroed
    man_partner: mutable i64[8] = zeroed
    next_proposal: mutable usize[8] = zeroed
    free_queue: mutable usize[8] = zeroed
    index: mutable usize = 0
    while index < n:
        woman_partner[index] <- -1
        man_partner[index] <- -1
        free_queue[index] <- index
        index <- index + 1
    head: mutable usize = 0
    tail: mutable usize = 0
    queue_count: mutable usize = n
    while queue_count > 0:
        man: usize = free_queue[head]
        head <- (head + 1) % n
        queue_count <- queue_count - 1
        rank: usize = next_proposal[man]
        next_proposal[man] <- next_proposal[man] + 1
        woman: usize = men_preferences[man * n + rank].usize()
        incumbent: i64 = woman_partner[woman]
        if incumbent < 0:
            woman_partner[woman] <- man.i64()
            man_partner[man] <- woman.i64()
        elif women_rank[woman * n + man] < women_rank[woman * n + incumbent.usize()]:
            woman_partner[woman] <- man.i64()
            man_partner[man] <- woman.i64()
            man_partner[incumbent.usize()] <- -1
            free_queue[tail] <- incumbent.usize()
            tail <- (tail + 1) % n
            queue_count <- queue_count + 1
        else:
            free_queue[tail] <- man
            tail <- (tail + 1) % n
            queue_count <- queue_count + 1

    man: mutable usize = 0
    while man < n:
        pair_index: mutable usize = 0
        while pair_index < 2:
            value: i64 = if pair_index == 0 then man.i64() else man_partner[man]
            bits: mutable u64 = value.u64()
            byte: mutable usize = 0
            while byte < 8:
                output[(man * 2 + pair_index) * 8 + byte] <- (bits & 255).u8()
                bits <- bits >> 8
                byte <- byte + 1
            pair_index <- pair_index + 1
        man <- man + 1
    output_bytes.i64()

export fn stable_matching(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = stable_matching_impl
