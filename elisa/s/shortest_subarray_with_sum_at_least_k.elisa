const MAX_COUNT: usize = 256
const MAX_INPUT: usize = 259

def shortest_subarray_with_sum_at_least_k_impl(input_values: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_INPUT:
        return -1
    target: i64 = input_values[0]
    count: i64 = input_values[1]
    if target < -4096 or target > 4096 or count < 0 or count > 256:
        return -1
    n: usize = count.usize()
    if length != n + 2:
        return -1

    prefix: mutable i64[MAX_COUNT + 1] = zeroed
    index: mutable usize = 0
    while index < n:
        value: i64 = input_values[index + 2]
        if value < -1000 or value > 1000:
            return -1
        prefix[index + 1] <- prefix[index] + value
        index <- index + 1

    deque: mutable usize[MAX_COUNT + 1] = zeroed
    head: mutable usize = 0
    tail_value: mutable usize = 0
    best: mutable i64 = count + 1
    right: mutable usize = 0
    while right <= n:
        while head < tail_value and prefix[right] - prefix[deque[head]] >= target:
            width: i64 = (right - deque[head]).i64()
            if width < best:
                best <- width
            head <- head + 1
        while head < tail_value and prefix[right] <= prefix[deque[tail_value - 1]]:
            tail_value <- tail_value - 1
        deque[tail_value] <- right
        tail_value <- tail_value + 1
        right <- right + 1
    if best <= n.i64():
        return best
    return 0

def shortest_subarray_with_sum_at_least_k_entry(input_values: i64&, length: usize) -> i64:
    if input_values == null or length < 2 or length > MAX_INPUT:
        return -1
    input_view: i64& = input_values
    shortest_subarray_with_sum_at_least_k_impl(input_view, length)

export fn shortest_subarray_with_sum_at_least_k(input_values: i64&, length: usize) -> i64 = shortest_subarray_with_sum_at_least_k_entry
