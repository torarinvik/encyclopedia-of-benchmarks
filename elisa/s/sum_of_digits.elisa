# Add the decimal digits of a signed 32-bit integer's magnitude.
def sum_of_digits_impl(input: i64) -> i64:
    if input < -2147483648 or input > 2147483647:
        return -1
    magnitude: mutable u32 = input.u32()
    if input < 0:
        magnitude <- (-input).u32()

    # The remainders telescope: sum(q - 10 * next_q) = magnitude - 9 * sum(next_q).
    quotients: u32 =
        while remaining >= 10 |remaining: u32 = magnitude, total: u32 = 0| -> total:
            next_quotient: u32 = remaining / 10
            remaining <- remaining / 100
            total <- total + next_quotient + remaining
    (magnitude - 9 * quotients).i64()

export fn sum_of_digits(input: i64) -> i64 = sum_of_digits_impl
