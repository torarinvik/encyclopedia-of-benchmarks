# Add the decimal digits of a signed 32-bit integer's magnitude.
def sum_of_digits_impl(input: i64) -> i64:
    if input < -2147483648 or input > 2147483647:
        return -1
    magnitude: mutable u32 = input.u32()
    if input < 0:
        magnitude <- (-input).u32()

    return magnitude.i64() if magnitude < 10
    quotient_1: u32 = magnitude / 10
    quotient_2: u32 = magnitude / 100
    quotient_3: u32 = magnitude / 1000
    quotient_4: u32 = magnitude / 10000
    quotient_5: u32 = magnitude / 100000
    quotient_6: u32 = magnitude / 1000000
    quotient_7: u32 = magnitude / 10000000
    quotient_8: u32 = magnitude / 100000000
    quotient_9: u32 = magnitude / 1000000000
    (magnitude - 9 * (quotient_1 + quotient_2 + quotient_3 + quotient_4 + quotient_5 + quotient_6 + quotient_7 + quotient_8 + quotient_9)).i64()

export fn sum_of_digits(input: i64) -> i64 = sum_of_digits_impl
