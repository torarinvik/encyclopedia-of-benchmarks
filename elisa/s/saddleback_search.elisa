# Top-right staircase search for a strictly increasing integer matrix.
def saddleback_search_impl(values: i64&, length: usize) -> i64:
    if length < 3:
        return -1
    rows_value: i64 = values[0]
    columns_value: i64 = values[1]
    target: i64 = values[2]
    if rows_value <= 0 or rows_value > 32 or columns_value <= 0 or columns_value > 32:
        return -1
    if target < -2147483648 or target > 2147483647:
        return -1
    rows: usize = rows_value.usize()
    columns: usize = columns_value.usize()
    cells: usize = rows * columns
    if length != 3 + cells:
        return -1
    index: mutable usize = 0
    while index < cells:
        value: i64 = values[3 + index]
        if value < -2147483648 or value > 2147483647:
            return -1
        index <- index + 1

    row: mutable usize = 0
    column: mutable usize = columns - 1
    while row < rows:
        value: i64 = values[3 + row * columns + column]
        if value == target:
            return (row * columns + column + 1).i64()
        if value < target:
            row <- row + 1
        else if column == 0:
            break
        else:
            column <- column - 1
    0

export fn saddleback_search(values: i64&, length: usize) -> i64 = saddleback_search_impl
