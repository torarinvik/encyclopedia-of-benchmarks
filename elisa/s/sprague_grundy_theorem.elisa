// Compute a bounded single-heap subtraction game's Sprague-Grundy number.
const MAX_POSITION: usize = 64
const MAX_MOVE_COUNT: usize = 32
const MAX_MOVE_SIZE: i64 = 32
const MAX_INPUT_LENGTH: usize = 34

def calculate_grundy(position: i64, memo: mutable i64&, values: i64&, move_count: usize) -> i64:
    index: usize = position.usize()
    if memo[index] != -1:
        return memo[index]
    if position == 0:
        memo[0] <- 0
        return 0

    reachable: mutable bool[33] = zeroed
    move_index: mutable usize = 0
    while move_index < move_count:
        move: i64 = values[2 + move_index]
        if move <= position:
            child: i64 = calculate_grundy(position - move, memo, values, move_count)
            if child >= 0 and child <= MAX_MOVE_COUNT.i64():
                reachable[child.usize()] <- true
        move_index <- move_index + 1
    mex: mutable i64 = 0
    while mex <= MAX_MOVE_COUNT.i64() and reachable[mex.usize()]:
        mex <- mex + 1
    memo[index] <- mex
    return mex

def sprague_grundy_theorem_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    position: i64 = values[0]
    move_count_value: i64 = values[1]
    if position < 0 or position > MAX_POSITION.i64() or move_count_value < 0 or move_count_value > MAX_MOVE_COUNT.i64():
        return -1
    move_count: usize = move_count_value.usize()
    if length != 2 + move_count:
        return -1
    move_index: mutable usize = 0
    while move_index < move_count:
        if values[2 + move_index] < 1 or values[2 + move_index] > MAX_MOVE_SIZE:
            return -1
        move_index <- move_index + 1

    memo: mutable i64[65] = zeroed
    index: mutable usize = 0
    while index <= position.usize():
        memo[index] <- -1
        index <- index + 1
    return calculate_grundy(position, memo, values, move_count)

export fn sprague_grundy_theorem(values: i64&, length: usize) -> i64 = sprague_grundy_theorem_impl
