def sieve_impl(iterations: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if iterations < 0 or iterations > 64:
        return -1

    flags: mutable u8[8193] = zeroed
    count: mutable i64 = 0
    pass: mutable i64 = 0
    while pass < iterations:
        count <- 0
        value: mutable usize = 2
        while value <= 8192:
            flags[value] <- 1.u8()
            value <- value + 1
        value <- 2
        while value <= 8192:
            if flags[value] != 0:
                count <- count + 1
                multiple: mutable usize = value + value
                while multiple <= 8192:
                    flags[multiple] <- 0.u8()
                    multiple <- multiple + value
            value <- value + 1
        pass <- pass + 1

    reversed_digits: mutable u8[10] = zeroed
    digit_count: mutable usize = 0
    remaining: mutable i64 = count
    while true:
        reversed_digits[digit_count] <- (48.i64() + remaining % 10).u8()
        digit_count <- digit_count + 1
        remaining <- remaining / 10
        if remaining == 0:
            break
    required: usize = 8 + digit_count
    if output.is_null() or output_capacity < required:
        return -2
    output[0] <- 67.u8(); output[1] <- 111.u8(); output[2] <- 117.u8()
    output[3] <- 110.u8(); output[4] <- 116.u8(); output[5] <- 58.u8()
    output[6] <- 32.u8()
    index: mutable usize = 0
    while index < digit_count:
        output[7 + index] <- reversed_digits[digit_count - index - 1]
        index <- index + 1
    output[required - 1] <- 10.u8()
    required.i64()

export fn sieve(iterations: i64, output: mutable u8&, output_capacity: usize) -> i64 = sieve_impl
