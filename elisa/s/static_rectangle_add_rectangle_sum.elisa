const MAX_N: usize = 32
const MAX_Q: usize = 32
const MAX_COORDS: usize = 128
const STRIDE: usize = 129
const MODULUS: i64 = 998244353

def sras_lower(a: view[i64], count: usize, value: i64) -> usize:
    lo: mutable usize = 0
    hi: mutable usize = count
    while lo < hi:
        middle: usize = lo + (hi - lo) / 2
        if a[middle] < value: lo <- middle + 1
        else: hi <- middle
    lo

def sras_sort_unique(a: mutable view[i64], count: mutable usize&) -> void:
    i: mutable usize = 1
    while i < count:
        value: i64 = a[i]
        j: mutable usize = i
        while j > 0 and a[j - 1] > value:
            a[j] <- a[j - 1]
            j <- j - 1
        a[j] <- value
        i <- i + 1
    out: mutable usize = 0
    i <- 0
    while i < count:
        if out == 0 or a[i] != a[out - 1]:
            a[out] <- a[i]
            out <- out + 1
        i <- i + 1
    count <- out

def sras_put64(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def static_rectangle_add_rectangle_sum_impl(input: i64&?, length: usize,
    output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 291: return -1
    n64: i64 = input[0]
    q64: i64 = input[1]
    if n64 < 1 or n64 > 32 or q64 < 0 or q64 > 32: return -1
    n: usize = n64.usize()
    q: usize = q64.usize()
    if length != 2 + 5 * n + 4 * q: return -1
    for update in 0..<n:
        base: usize = 2 + 5*update
        left: i64 = input[base]
        down: i64 = input[base+1]
        right: i64 = input[base+2]
        up: i64 = input[base+3]
        weight: i64 = input[base+4]
        if left < 0 or left >= right or right > 1000000 or down < 0 or down >= up or up > 1000000 or weight < 0 or weight >= MODULUS: return -1
    for query in 0..<q:
        base: usize = 2 + 5*n + 4*query
        left: i64 = input[base]
        down: i64 = input[base+1]
        right: i64 = input[base+2]
        up: i64 = input[base+3]
        if left < 0 or left >= right or right > 1000000 or down < 0 or down >= up or up > 1000000: return -1
    bytes: usize = 8 * q
    if output == null or capacity < bytes: return -2
    if q == 0: return 0
    if n*q <= 64:
        direct: mutable i64[MAX_Q] = zeroed
        for query in 0..<q:
            query_base: usize = 2 + 5*n + 4*query
            residue: mutable u64 = 0
            for update in 0..<n:
                update_base: usize = 2 + 5*update
                left: mutable i64 = input[query_base + 0]
                left <- input[update_base + 0] if input[update_base + 0] > input[query_base + 0]
                right: mutable i64 = input[query_base + 2]
                right <- input[update_base + 2] if input[update_base + 2] < input[query_base + 2]
                down: mutable i64 = input[query_base + 1]
                down <- input[update_base + 1] if input[update_base + 1] > input[query_base + 1]
                up: mutable i64 = input[query_base + 3]
                up <- input[update_base + 3] if input[update_base + 3] < input[query_base + 3]
                if right > left and up > down:
                    area: u64 = (right.u64() - left.u64()) * (up.u64() - down.u64())
                    weighted: u64 = ((area % MODULUS.u64()) * input[update_base + 4].u64()) % MODULUS.u64()
                    residue <- residue + weighted
            direct[query] <- (residue % MODULUS.u64()).i64()
        for query in 0..<q:
            sras_put64(direct[query], output, 8*query)
        return bytes.i64()
    ul: mutable i64[MAX_N] = zeroed
    ud: mutable i64[MAX_N] = zeroed
    ur: mutable i64[MAX_N] = zeroed
    uu: mutable i64[MAX_N] = zeroed
    uw: mutable i64[MAX_N] = zeroed
    ql: mutable i64[MAX_Q] = zeroed
    qd: mutable i64[MAX_Q] = zeroed
    qr: mutable i64[MAX_Q] = zeroed
    qu: mutable i64[MAX_Q] = zeroed
    xs: mutable i64[MAX_COORDS] = zeroed
    ys: mutable i64[MAX_COORDS] = zeroed
    nx: mutable usize = 0
    ny: mutable usize = 0
    off: mutable usize = 2
    i: mutable usize = 0
    while i < n:
        ul[i] <- input[off]
        ud[i] <- input[off + 1]
        ur[i] <- input[off + 2]
        uu[i] <- input[off + 3]
        uw[i] <- input[off + 4]
        off <- off + 5
        xs[nx] <- ul[i]
        xs[nx + 1] <- ur[i]
        ys[ny] <- ud[i]
        ys[ny + 1] <- uu[i]
        nx <- nx + 2
        ny <- ny + 2
        i <- i + 1
    i <- 0
    while i < q:
        ql[i] <- input[off]
        qd[i] <- input[off + 1]
        qr[i] <- input[off + 2]
        qu[i] <- input[off + 3]
        off <- off + 4
        xs[nx] <- ql[i]
        xs[nx + 1] <- qr[i]
        ys[ny] <- qd[i]
        ys[ny + 1] <- qu[i]
        nx <- nx + 2
        ny <- ny + 2
        i <- i + 1
    sras_sort_unique(xs[0:MAX_COORDS], nx)
    sras_sort_unique(ys[0:MAX_COORDS], ny)
    # Corner differences can wrap while accumulating. The recovered cell weight
    # is nonnegative and at most MAX_N times the largest allowed weight.
    diff: mutable u64[MAX_COORDS * MAX_COORDS] = zeroed
    prefix: mutable u64[STRIDE * STRIDE] = zeroed
    k: mutable usize = 0
    while k < n:
        x0: usize = sras_lower(xs[0:MAX_COORDS], nx, ul[k])
        x1: usize = sras_lower(xs[0:MAX_COORDS], nx, ur[k])
        y0: usize = sras_lower(ys[0:MAX_COORDS], ny, ud[k])
        y1: usize = sras_lower(ys[0:MAX_COORDS], ny, uu[k])
        diff[x0 * MAX_COORDS + y0] <- diff[x0 * MAX_COORDS + y0] + uw[k].u64()
        diff[x1 * MAX_COORDS + y0] <- diff[x1 * MAX_COORDS + y0] - uw[k].u64()
        diff[x0 * MAX_COORDS + y1] <- diff[x0 * MAX_COORDS + y1] - uw[k].u64()
        diff[x1 * MAX_COORDS + y1] <- diff[x1 * MAX_COORDS + y1] + uw[k].u64()
        k <- k + 1
    i <- 0
    while i < nx:
        j: mutable usize = 0
        while j < ny:
            at: usize = i * MAX_COORDS + j
            value: mutable u64 = diff[at]
            if i > 0: value <- value + diff[(i - 1) * MAX_COORDS + j]
            if j > 0: value <- value + diff[i * MAX_COORDS + j - 1]
            if i > 0 and j > 0: value <- value - diff[(i - 1) * MAX_COORDS + j - 1]
            diff[at] <- value
            j <- j + 1
        i <- i + 1
    i <- 0
    while i + 1 < nx:
        j: mutable usize = 0
        while j + 1 < ny:
            value: u64 = diff[i * MAX_COORDS + j] % MODULUS.u64()
            dx: u64 = xs[i + 1].u64() - xs[i].u64()
            dy: u64 = ys[j + 1].u64() - ys[j].u64()
            cell: u64 = value * ((dx * dy) % MODULUS.u64()) % MODULUS.u64()
            at: usize = (i + 1) * STRIDE + j + 1
            sum: u64 = (MODULUS.u64() + cell + prefix[i * STRIDE + j + 1] + prefix[(i + 1) * STRIDE + j] - prefix[i * STRIDE + j]) % MODULUS.u64()
            prefix[at] <- sum
            j <- j + 1
        i <- i + 1
    answer: mutable i64[MAX_Q] = zeroed
    k <- 0
    while k < q:
        x0: usize = sras_lower(xs[0:MAX_COORDS], nx, ql[k])
        x1: usize = sras_lower(xs[0:MAX_COORDS], nx, qr[k])
        y0: usize = sras_lower(ys[0:MAX_COORDS], ny, qd[k])
        y1: usize = sras_lower(ys[0:MAX_COORDS], ny, qu[k])
        value: u64 = 2 * MODULUS.u64() + prefix[x1 * STRIDE + y1] - prefix[x0 * STRIDE + y1] - prefix[x1 * STRIDE + y0] + prefix[x0 * STRIDE + y0]
        answer[k] <- (value % MODULUS.u64()).i64()
        k <- k + 1
    k <- 0
    while k < q:
        sras_put64(answer[k], output, 8 * k)
        k <- k + 1
    bytes.i64()

export fn static_rectangle_add_rectangle_sum(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = static_rectangle_add_rectangle_sum_impl
