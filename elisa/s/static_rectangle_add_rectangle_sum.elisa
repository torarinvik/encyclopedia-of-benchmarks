const MAX_N: usize = 32
const MAX_Q: usize = 32
const MAX_COORDS: usize = 128
const STRIDE: usize = 129
const MODULUS: i64 = 998244353

def sras_lower(a: view[i64], count: usize, value: i64) -> usize:
    lo: mutable usize = 0
    hi: mutable usize = count
    while lo < hi:
        middle: usize = lo + (hi - lo) / 2
        if a[middle] < value: lo <- middle + 1
        else: hi <- middle
    lo

def sras_sort_unique(a: mutable view[i64], count: mutable usize&) -> void:
    i: mutable usize = 1
    while i < count:
        value: i64 = a[i]
        j: mutable usize = i
        while j > 0 and a[j - 1] > value:
            a[j] <- a[j - 1]
            j <- j - 1
        a[j] <- value
        i <- i + 1
    out: mutable usize = 0
    i <- 0
    while i < count:
        if out == 0 or a[i] != a[out - 1]:
            a[out] <- a[i]
            out <- out + 1
        i <- i + 1
    count <- out

def sras_put64(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def static_rectangle_add_rectangle_sum_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 291: return -1
    n64: i64 = input[0]
    q64: i64 = input[1]
    if n64 < 1 or n64 > 32 or q64 < 0 or q64 > 32: return -1
    n: usize = n64.usize()
    q: usize = q64.usize()
    if length != 2 + 5 * n + 4 * q: return -1
    ul: mutable i64[MAX_N] = zeroed
    ud: mutable i64[MAX_N] = zeroed
    ur: mutable i64[MAX_N] = zeroed
    uu: mutable i64[MAX_N] = zeroed
    uw: mutable i64[MAX_N] = zeroed
    ql: mutable i64[MAX_Q] = zeroed
    qd: mutable i64[MAX_Q] = zeroed
    qr: mutable i64[MAX_Q] = zeroed
    qu: mutable i64[MAX_Q] = zeroed
    xs: mutable i64[MAX_COORDS] = zeroed
    ys: mutable i64[MAX_COORDS] = zeroed
    nx: mutable usize = 0
    ny: mutable usize = 0
    off: mutable usize = 2
    i: mutable usize = 0
    while i < n:
        ul[i] <- input[off]
        ud[i] <- input[off + 1]
        ur[i] <- input[off + 2]
        uu[i] <- input[off + 3]
        uw[i] <- input[off + 4]
        off <- off + 5
        if ul[i] < 0 or ul[i] >= ur[i] or ur[i] > 1000000 or ud[i] < 0 or ud[i] >= uu[i] or uu[i] > 1000000 or uw[i] < 0 or uw[i] >= MODULUS: return -1
        xs[nx] <- ul[i]
        xs[nx + 1] <- ur[i]
        ys[ny] <- ud[i]
        ys[ny + 1] <- uu[i]
        nx <- nx + 2
        ny <- ny + 2
        i <- i + 1
    i <- 0
    while i < q:
        ql[i] <- input[off]
        qd[i] <- input[off + 1]
        qr[i] <- input[off + 2]
        qu[i] <- input[off + 3]
        off <- off + 4
        if ql[i] < 0 or ql[i] >= qr[i] or qr[i] > 1000000 or qd[i] < 0 or qd[i] >= qu[i] or qu[i] > 1000000: return -1
        xs[nx] <- ql[i]
        xs[nx + 1] <- qr[i]
        ys[ny] <- qd[i]
        ys[ny + 1] <- qu[i]
        nx <- nx + 2
        ny <- ny + 2
        i <- i + 1
    sras_sort_unique(xs, nx)
    sras_sort_unique(ys, ny)
    diff: mutable i64[MAX_COORDS * MAX_COORDS] = zeroed
    prefix: mutable i64[STRIDE * STRIDE] = zeroed
    k: mutable usize = 0
    while k < n:
        x0: usize = sras_lower(xs, nx, ul[k])
        x1: usize = sras_lower(xs, nx, ur[k])
        y0: usize = sras_lower(ys, ny, ud[k])
        y1: usize = sras_lower(ys, ny, uu[k])
        diff[x0 * MAX_COORDS + y0] <- diff[x0 * MAX_COORDS + y0] + uw[k]
        diff[x1 * MAX_COORDS + y0] <- diff[x1 * MAX_COORDS + y0] - uw[k]
        diff[x0 * MAX_COORDS + y1] <- diff[x0 * MAX_COORDS + y1] - uw[k]
        diff[x1 * MAX_COORDS + y1] <- diff[x1 * MAX_COORDS + y1] + uw[k]
        k <- k + 1
    i <- 0
    while i < nx:
        j: mutable usize = 0
        while j < ny:
            at: usize = i * MAX_COORDS + j
            value: mutable i64 = diff[at]
            if i > 0: value <- value + diff[(i - 1) * MAX_COORDS + j]
            if j > 0: value <- value + diff[i * MAX_COORDS + j - 1]
            if i > 0 and j > 0: value <- value - diff[(i - 1) * MAX_COORDS + j - 1]
            diff[at] <- value
            j <- j + 1
        i <- i + 1
    i <- 0
    while i + 1 < nx:
        j: mutable usize = 0
        while j + 1 < ny:
            value: i64 = diff[i * MAX_COORDS + j] % MODULUS
            dx: i64 = (xs[i + 1] - xs[i]) % MODULUS
            dy: i64 = (ys[j + 1] - ys[j]) % MODULUS
            cell: i64 = value * ((dx * dy) % MODULUS) % MODULUS
            at: usize = (i + 1) * STRIDE + j + 1
            sum: mutable i64 = (cell + prefix[i * STRIDE + j + 1] + prefix[(i + 1) * STRIDE + j] - prefix[i * STRIDE + j]) % MODULUS
            if sum < 0: sum <- sum + MODULUS
            prefix[at] <- sum
            j <- j + 1
        i <- i + 1
    answer: mutable i64[MAX_Q] = zeroed
    k <- 0
    while k < q:
        x0: usize = sras_lower(xs, nx, ql[k])
        x1: usize = sras_lower(xs, nx, qr[k])
        y0: usize = sras_lower(ys, ny, qd[k])
        y1: usize = sras_lower(ys, ny, qu[k])
        value: mutable i64 = prefix[x1 * STRIDE + y1] - prefix[x0 * STRIDE + y1] - prefix[x1 * STRIDE + y0] + prefix[x0 * STRIDE + y0]
        value <- value % MODULUS
        if value < 0: value <- value + MODULUS
        answer[k] <- value
        k <- k + 1
    bytes: usize = 8 * q
    if output.is_null() or capacity < bytes: return -2
    k <- 0
    while k < q:
        sras_put64(answer[k], output, 8 * k)
        k <- k + 1
    bytes.i64()

export def static_rectangle_add_rectangle_sum(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    static_rectangle_add_rectangle_sum_impl(input, length, output, capacity)
