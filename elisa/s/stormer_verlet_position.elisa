const SVP_MAX_STEPS: usize = 32
const SVP_MAX_INPUT_VALUES: usize = SVP_MAX_STEPS + 1
const SVP_MAX_OUTPUT_BYTES: usize = SVP_MAX_STEPS * 8

def svp_store_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def stormer_verlet_position_impl(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 3 or length > SVP_MAX_INPUT_VALUES: return -1
    count: usize = length - 1
    if input[0] != count.i64(): return -1
    first: i64 = input[1]
    second: i64 = input[2]
    invalid_first: i64 = 1 if first.u64() + 1024 > 2048 else 0
    invalid_second: i64 = 1 if second.u64() + 1024 > 2048 else 0
    if (invalid_first | invalid_second) != 0:
        return -1
    byte_count: usize = 8 * count
    if count <= 4:
        third: mutable u64 = 0
        fourth: mutable u64 = 0
        if count >= 3:
            acceleration: u64 = input[3].u64()
            if acceleration + 64 > 128:
                return -1
            third <- 2 * second.u64() - first.u64() + acceleration
        if count == 4:
            acceleration: u64 = input[4].u64()
            if acceleration + 64 > 128:
                return -1
            fourth <- 2 * third - second.u64() + acceleration
        if output == null or capacity < byte_count:
            return -2
        svp_store_i64_le(output, 0, first)
        svp_store_i64_le(output, 8, second)
        if count >= 3:
            svp_store_i64_le(output, 16, third.i64())
        if count == 4:
            svp_store_i64_le(output, 24, fourth.i64())
        return byte_count.i64()
    if count <= 6:
        first_acceleration: u64 = input[3].u64()
        second_acceleration: u64 = input[4].u64()
        third_acceleration: u64 = input[5].u64()
        if first_acceleration + 64 > 128 or second_acceleration + 64 > 128 or third_acceleration + 64 > 128:
            return -1
        third: u64 = 2 * second.u64() - first.u64() + first_acceleration
        fourth: u64 = 2 * third - second.u64() + second_acceleration
        fifth: u64 = 2 * fourth - third + third_acceleration
        sixth: mutable u64 = 0
        if count == 6:
            acceleration: u64 = input[6].u64()
            if acceleration + 64 > 128:
                return -1
            sixth <- 2 * fifth - fourth + acceleration
        if output == null or capacity < byte_count:
            return -2
        svp_store_i64_le(output, 0, first)
        svp_store_i64_le(output, 8, second)
        svp_store_i64_le(output, 16, third.i64())
        svp_store_i64_le(output, 24, fourth.i64())
        svp_store_i64_le(output, 32, fifth.i64())
        if count == 6:
            svp_store_i64_le(output, 40, sixth.i64())
        return byte_count.i64()
    staged: mutable u8[SVP_MAX_OUTPUT_BYTES] = zeroed
    staged_view: mutable u8& = &staged[0]
    # The validated trajectory fits in signed 64 bits. Unsigned arithmetic
    # keeps the two’s-complement representation of each position.
    current: mutable u64 = second.u64()
    svp_store_i64_le(staged_view, 0, first)
    svp_store_i64_le(staged_view, 8, current.i64())
    delta: mutable u64 = current - first.u64()
    pair_limit: usize = count >> 1
    byte_offset: mutable usize = 16
    for pair in 1..<pair_limit:
        index: usize = 1 + 2 * pair
        acceleration: u64 = input[index].u64()
        next_acceleration: u64 = input[index + 1].u64()
        if acceleration + 64 > 128 or next_acceleration + 64 > 128:
            return -1
        delta <- delta + acceleration
        current <- current + delta
        svp_store_i64_le(staged_view, byte_offset, current.i64())
        delta <- delta + next_acceleration
        current <- current + delta
        svp_store_i64_le(staged_view, byte_offset + 8, current.i64())
        byte_offset <- byte_offset + 16
    if (count & 1) != 0:
        acceleration: u64 = input[count].u64()
        if acceleration + 64 > 128:
            return -1
        current <- current + delta + acceleration
        svp_store_i64_le(staged_view, byte_offset, current.i64())
    if output == null or capacity < byte_count: return -2
    for byte in 0..<byte_count:
        output[byte] <- staged[byte]
    byte_count.i64()

export fn stormer_verlet_position(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64 = stormer_verlet_position_impl
