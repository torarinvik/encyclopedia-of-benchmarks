# Position Stormer-Verlet: x[n+1] = 2 x[n] - x[n-1] + a[n] for unit time steps.
const MAX_STEPS: usize = 32
const MAX_INPUT_VALUES: usize = MAX_STEPS + 1
const MAX_OUTPUT_BYTES: usize = MAX_STEPS * 8

def svp_store_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte).u64()) & 255).u8()
        byte <- byte + 1

def stormer_verlet_position_impl(input: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_INPUT_VALUES:
        return -1
    count_value: i64 = input[0]
    if count_value < 2 or count_value > MAX_STEPS.i64():
        return -1
    if length != count_value.usize() + 1:
        return -1
    if input[1] < -1024 or input[1] > 1024 or input[2] < -1024 or input[2] > 1024:
        return -1
    count: usize = count_value.usize()
    step: mutable usize = 0
    while step < count - 2:
        if input[3 + step] < -64 or input[3 + step] > 64:
            return -1
        step <- step + 1

    byte_count: usize = 8 * count
    if output == null or output_capacity < byte_count:
        return -2
    staged: mutable u8[256] = zeroed
    previous: mutable i64 = input[1]
    current: mutable i64 = input[2]
    svp_store_i64_le(staged[0:MAX_OUTPUT_BYTES], 0, previous)
    svp_store_i64_le(staged[0:MAX_OUTPUT_BYTES], 8, current)
    index: mutable usize = 2
    while index < count:
        next: i64 = 2 * current - previous + input[index + 1]
        svp_store_i64_le(staged[0:MAX_OUTPUT_BYTES], 8 * index, next)
        previous <- current
        current <- next
        index <- index + 1
    byte: mutable usize = 0
    while byte < byte_count:
        output[byte] <- staged[byte]
        byte <- byte + 1
    byte_count.i64()

export fn stormer_verlet_position(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stormer_verlet_position_impl
