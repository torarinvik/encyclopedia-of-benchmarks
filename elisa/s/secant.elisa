const INVALID_RESULT: f64 = -1.0e300

def objective(x: f64) -> f64:
    x * x - 3.0

def secant_impl(values: i64&, length: usize) -> f64:
    if values.is_null() or length != 5:
        return INVALID_RESULT
    if values[0] != 0 or values[1] < 1000000 or values[1] > 1500000 or
        values[2] < 1600000 or values[2] > 2000000 or values[1] >= values[2] or
        values[3] < 1 or values[3] > 100000 or values[4] < 0 or values[4] > 32:
        return INVALID_RESULT
    x0: mutable f64 = (values[1] as f64) / 1000000.0
    x1: mutable f64 = (values[2] as f64) / 1000000.0
    tolerance: f64 = (values[3] as f64) / 1000000000.0
    max_updates: i64 = values[4]
    update: mutable i64 = 0
    while update <= max_updates:
        f1: f64 = objective(x1)
        if abs(f1) <= tolerance:
            return x1
        if update == max_updates:
            break
        f0: f64 = objective(x0)
        denominator: f64 = f1 - f0
        if denominator == 0.0:
            return INVALID_RESULT
        x2: f64 = x1 - f1 * (x1 - x0) / denominator
        x0 <- x1
        x1 <- x2
        update <- update + 1
    INVALID_RESULT

export fn secant(values: i64&, length: usize) -> f64 = secant_impl(values, length)
