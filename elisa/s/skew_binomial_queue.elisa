const MAX_OPERATIONS: usize = 64
const MAX_ITEMS: usize = 32
const MAX_NODES: usize = 64
const MAX_INPUT_LENGTH: usize = 194
const MAX_KEY: i64 = 1000000

def skew_binomial_less(keys: view[i64], serials: view[i64], item_ids: view[i64],
        first: usize, second: usize) -> bool:
    if keys[first] != keys[second]:
        return keys[first] < keys[second]
    if serials[first] != serials[second]:
        return serials[first] < serials[second]
    if item_ids[first] != item_ids[second]:
        return item_ids[first] < item_ids[second]
    first < second

def skew_binomial_collect_roots(roots: mutable view[usize], node_count: usize,
        ranks: view[i64], serials: view[i64], parents: view[i64], alive: view[bool]) -> usize:
    root_count: mutable usize = 0
    node: mutable usize = 0
    while node < node_count:
        if alive[node] and parents[node] == -1:
            roots[root_count] <- node
            root_count <- root_count + 1
        node <- node + 1
    index: mutable usize = 1
    while index < root_count:
        key: usize = roots[index]
        position: mutable usize = index
        while position > 0:
            previous: usize = roots[position - 1]
            should_shift: bool = ranks[previous] > ranks[key] or (ranks[previous] == ranks[key] and (serials[previous] > serials[key] or (serials[previous] == serials[key] and previous > key)))
            if not should_shift:
                break
            roots[position] <- previous
            position <- position - 1
        roots[position] <- key
        index <- index + 1
    root_count

def skew_binomial_simple_link(keys: view[i64], serials: view[i64], item_ids: view[i64],
        ranks: mutable view[i64], first_child: mutable view[i64], next_sibling: mutable view[i64],
        parents: mutable view[i64], first: usize, second: usize) -> usize:
    winner: mutable usize = first
    loser: mutable usize = second
    if not skew_binomial_less(keys, serials, item_ids, first, second):
        winner <- second
        loser <- first
    old_children: i64 = first_child[winner]
    first_child[winner] <- loser.i64()
    next_sibling[loser] <- old_children
    parents[loser] <- winner.i64()
    ranks[winner] <- ranks[winner] + 1
    winner

def skew_binomial_skew_link(keys: view[i64], serials: view[i64], item_ids: view[i64],
        ranks: mutable view[i64], first_child: mutable view[i64], next_sibling: mutable view[i64],
        parents: mutable view[i64], singleton: usize, first: usize, second: usize) -> void:
    new_rank: i64 = ranks[first] + 1
    winner: mutable usize = first
    loser: mutable usize = second
    if skew_binomial_less(keys, serials, item_ids, singleton, first) and skew_binomial_less(keys, serials, item_ids, singleton, second):
        winner <- singleton
        first_child[winner] <- first.i64()
        next_sibling[first] <- second.i64()
        next_sibling[second] <- -1
        parents[first] <- winner.i64()
        parents[second] <- winner.i64()
    else:
        if not skew_binomial_less(keys, serials, item_ids, first, second):
            winner <- second
            loser <- first
        old_children: i64 = first_child[winner]
        first_child[winner] <- singleton.i64()
        next_sibling[singleton] <- loser.i64()
        next_sibling[loser] <- old_children
        parents[singleton] <- winner.i64()
        parents[loser] <- winner.i64()
    parents[winner] <- -1
    ranks[winner] <- new_rank

def skew_binomial_insert_singleton(keys: view[i64], serials: view[i64], item_ids: view[i64],
        ranks: mutable view[i64], first_child: mutable view[i64], next_sibling: mutable view[i64],
        parents: mutable view[i64], alive: view[bool], node_count: usize, singleton: usize) -> void:
    parents[singleton] <- -2
    roots: mutable usize[MAX_NODES] = zeroed
    root_count: usize = skew_binomial_collect_roots(roots[0:MAX_NODES], node_count, ranks, serials, parents, alive)
    next_sibling[singleton] <- -1
    if root_count >= 2 and ranks[roots[0]] == ranks[roots[1]]:
        skew_binomial_skew_link(keys, serials, item_ids, ranks, first_child, next_sibling, parents, singleton, roots[0], roots[1])
    else:
        parents[singleton] <- -1

def skew_binomial_normalize_roots(keys: view[i64], serials: view[i64], item_ids: view[i64],
        ranks: mutable view[i64], first_child: mutable view[i64], next_sibling: mutable view[i64],
        parents: mutable view[i64], roots: mutable view[usize], root_count: usize) -> void:
    index: mutable usize = 1
    while index < root_count:
        key: usize = roots[index]
        position: mutable usize = index
        while position > 0:
            previous: usize = roots[position - 1]
            should_shift: bool = ranks[previous] > ranks[key] or (ranks[previous] == ranks[key] and (serials[previous] > serials[key] or (serials[previous] == serials[key] and previous > key)))
            if not should_shift:
                break
            roots[position] <- previous
            position <- position - 1
        roots[position] <- key
        index <- index + 1

    buckets: mutable i64[MAX_NODES] = zeroed
    bucket: mutable usize = 0
    while bucket < MAX_NODES:
        buckets[bucket] <- -1
        bucket <- bucket + 1
    index <- 0
    while index < root_count:
        current: mutable usize = roots[index]
        current_rank: mutable usize = ranks[current].usize()
        while buckets[current_rank] >= 0:
            previous_root: usize = buckets[current_rank].usize()
            buckets[current_rank] <- -1
            current <- skew_binomial_simple_link(keys, serials, item_ids, ranks, first_child, next_sibling, parents, previous_root, current)
            current_rank <- ranks[current].usize()
        buckets[current_rank] <- current.i64()
        index <- index + 1

def skew_binomial_minimum_root(keys: view[i64], serials: view[i64], item_ids: view[i64],
        parents: view[i64], alive: view[bool], node_count: usize) -> i64:
    best: mutable i64 = -1
    node: mutable usize = 0
    while node < node_count:
        if alive[node] and parents[node] == -1:
            if best < 0:
                best <- node.i64()
            else:
                best_index: usize = best.usize()
                if skew_binomial_less(keys, serials, item_ids, node, best_index):
                    best <- node.i64()
        node <- node + 1
    best

def skew_binomial_queue_impl(values: i64&, values_length: usize) -> i64:
    if values_length < 1 or values_length > MAX_INPUT_LENGTH:
        return -1
    operation_value: i64 = values[0]
    if operation_value < 0 or operation_value > MAX_OPERATIONS.i64():
        return -1
    operation_count: usize = operation_value.usize()
    if values_length != 1 + 3 * operation_count or values_length > 193:
        return -1

    keys: mutable i64[MAX_NODES] = zeroed
    item_ids: mutable i64[MAX_NODES] = zeroed
    serials: mutable i64[MAX_NODES] = zeroed
    ranks: mutable i64[MAX_NODES] = zeroed
    first_child: mutable i64[MAX_NODES] = zeroed
    next_sibling: mutable i64[MAX_NODES] = zeroed
    parents: mutable i64[MAX_NODES] = zeroed
    alive: mutable bool[MAX_NODES] = zeroed
    item_nodes: mutable i64[MAX_ITEMS] = zeroed
    active: mutable bool[MAX_ITEMS] = zeroed
    for item_id in 0..<MAX_ITEMS:
        item_nodes[item_id] <- -1
    node_count: mutable usize = 0
    insertion_serial: mutable i64 = 0
    result: mutable i64 = 0

    operation_index: mutable usize = 0
    while operation_index < operation_count:
        offset: usize = 1 + 3 * operation_index
        opcode: i64 = values[offset]
        item_value: i64 = values[offset + 1]
        key: i64 = values[offset + 2]
        if opcode == 1:
            if item_value < 0 or item_value >= MAX_ITEMS.i64() or key < 0 or key > MAX_KEY:
                return -1
            item_id: usize = item_value.usize()
            if active[item_id] or node_count >= MAX_NODES:
                return -1
            node: usize = node_count
            node_count <- node_count + 1
            keys[node] <- key
            item_ids[node] <- item_value
            serials[node] <- insertion_serial
            insertion_serial <- insertion_serial + 1
            ranks[node] <- 0
            first_child[node] <- -1
            next_sibling[node] <- -1
            parents[node] <- -2
            alive[node] <- true
            item_nodes[item_id] <- node.i64()
            active[item_id] <- true
            skew_binomial_insert_singleton(keys[0:MAX_NODES], serials[0:MAX_NODES], item_ids[0:MAX_NODES], ranks[0:MAX_NODES], first_child[0:MAX_NODES], next_sibling[0:MAX_NODES], parents[0:MAX_NODES], alive[0:MAX_NODES], node_count, node)
        elif opcode == 2 or opcode == 3:
            if item_value != 0 or key != 0:
                return -1
            root_value: i64 = skew_binomial_minimum_root(keys[0:MAX_NODES], serials[0:MAX_NODES], item_ids[0:MAX_NODES], parents[0:MAX_NODES], alive[0:MAX_NODES], node_count)
            if root_value < 0:
                return -1
            root: usize = root_value.usize()
            removed_item: usize = item_ids[root].usize()
            result <- result + (operation_index + 1).i64() * (keys[root] + 1) + removed_item.i64()
            if opcode == 2:
                operation_index <- operation_index + 1
                continue

            active[removed_item] <- false
            item_nodes[removed_item] <- -1
            children: mutable usize[MAX_NODES] = zeroed
            child_count: mutable usize = 0
            child: mutable i64 = first_child[root]
            while child >= 0:
                child_index: usize = child.usize()
                following: i64 = next_sibling[child_index]
                parents[child_index] <- -1
                next_sibling[child_index] <- -1
                children[child_count] <- child_index
                child_count <- child_count + 1
                child <- following
            alive[root] <- false
            parents[root] <- -2
            item_ids[root] <- -1
            first_child[root] <- -1
            next_sibling[root] <- -1

            zero_rank_children: mutable usize[MAX_NODES] = zeroed
            positive_roots: mutable usize[MAX_NODES] = zeroed
            zero_count: mutable usize = 0
            positive_count: mutable usize = 0
            child_index: mutable usize = 0
            while child_index < child_count:
                child_node: usize = children[child_index]
                if ranks[child_node] == 0:
                    zero_rank_children[zero_count] <- child_node
                    zero_count <- zero_count + 1
                else:
                    positive_roots[positive_count] <- child_node
                    positive_count <- positive_count + 1
                child_index <- child_index + 1
            child_index <- 1
            while child_index < zero_count:
                child_key: usize = zero_rank_children[child_index]
                position: mutable usize = child_index
                while position > 0:
                    previous: usize = zero_rank_children[position - 1]
                    if serials[previous] < serials[child_key] or (serials[previous] == serials[child_key] and previous < child_key):
                        break
                    zero_rank_children[position] <- previous
                    position <- position - 1
                zero_rank_children[position] <- child_key
                child_index <- child_index + 1

            roots: mutable usize[MAX_NODES] = zeroed
            root_count: mutable usize = 0
            node: mutable usize = 0
            while node < node_count:
                is_child: mutable bool = false
                child_index <- 0
                while child_index < child_count:
                    if children[child_index] == node:
                        is_child <- true
                        break
                    child_index <- child_index + 1
                if alive[node] and parents[node] == -1 and not is_child:
                    roots[root_count] <- node
                    root_count <- root_count + 1
                node <- node + 1
            child_index <- 0
            while child_index < positive_count:
                roots[root_count] <- positive_roots[child_index]
                root_count <- root_count + 1
                child_index <- child_index + 1
            skew_binomial_normalize_roots(keys[0:MAX_NODES], serials[0:MAX_NODES], item_ids[0:MAX_NODES], ranks[0:MAX_NODES], first_child[0:MAX_NODES], next_sibling[0:MAX_NODES], parents[0:MAX_NODES], roots[0:MAX_NODES], root_count)
            child_index <- 0
            while child_index < zero_count:
                skew_binomial_insert_singleton(keys[0:MAX_NODES], serials[0:MAX_NODES], item_ids[0:MAX_NODES], ranks[0:MAX_NODES], first_child[0:MAX_NODES], next_sibling[0:MAX_NODES], parents[0:MAX_NODES], alive[0:MAX_NODES], node_count, zero_rank_children[child_index])
                child_index <- child_index + 1
        else:
            return -1
        operation_index <- operation_index + 1
    result

def skew_binomial_queue_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    skew_binomial_queue_impl(input, length)

export fn skew_binomial_queue(input: i64&, length: usize) -> i64 = skew_binomial_queue_entry
