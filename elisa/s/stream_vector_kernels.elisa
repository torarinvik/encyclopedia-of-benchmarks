def stream_vector_kernels_write_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def stream_vector_kernels_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 259:
        return -1
    mode: i64 = input[0]
    count_value: i64 = input[1]
    if mode < 0 or mode > 3 or count_value < 0 or count_value > 128:
        return -1
    count: usize = count_value.usize()
    has_alpha: bool = mode == 1 or mode == 3
    array_count: mutable usize = 1
    if mode == 2 or mode == 3:
        array_count <- 2
    expected_length: mutable usize = 2 + count * array_count
    if has_alpha:
        expected_length <- expected_length + 1
    if length != expected_length:
        return -1

    a_start: mutable usize = 2
    alpha: mutable i64 = 0
    if has_alpha:
        alpha <- input[2]
        if alpha < -1000 or alpha > 1000:
            return -1
        a_start <- 3
    b_start: usize = a_start + count
    invalid: mutable u64 = 0
    for index in 0..<array_count * count:
        out_of_range: u64 = 1.u64() if input[a_start + index].u64() + 1000 > 2000 else 0.u64()
        invalid <- invalid + out_of_range
    if invalid != 0: return -1

    output_bytes: usize = count * 8
    if output == null or capacity < output_bytes:
        return -2
    if count == 0: return 0
    # Validated operands keep results within i64. Modular arithmetic preserves
    # their exact two's-complement output bytes.
    staged: mutable u64[128] = zeroed
    if mode == 0:
        for index in 0..<count:
            staged[index] <- input[a_start + index].u64()
    elif mode == 1:
        for index in 0..<count:
            staged[index] <- alpha.u64() * input[a_start + index].u64()
    elif mode == 2:
        for index in 0..<count:
            staged[index] <- input[a_start + index].u64() + input[b_start + index].u64()
    else:
        for index in 0..<count:
            staged[index] <- input[a_start + index].u64() + alpha.u64() * input[b_start + index].u64()
    index: mutable usize = 0
    while index < count:
        stream_vector_kernels_write_i64_le(output, index * 8, staged[index].i64())
        index <- index + 1
    output_bytes.i64()

export fn stream_vector_kernels(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stream_vector_kernels_impl
