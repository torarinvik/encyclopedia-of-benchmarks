const SCI_MAX_N: usize = 12
const SCI_WIDTH: usize = 16
const SCI_CELLS: usize = SCI_WIDTH * SCI_WIDTH
const SCI_INF: i64 = 1000

def sci_run_cost(kept: usize) -> i64:
    if kept == 1: return 1
    3 if kept >= 10 else 2

def sci_compute(input: i64&?, length: usize) -> i64:
    if input == null or length < 2: return -1
    raw_length: u64 = input[0].u64()
    if raw_length > SCI_MAX_N.u64() or raw_length != (length - 2).u64(): return -1
    raw_budget: u64 = input[1].u64()
    if raw_budget > raw_length: return -1
    n: usize = raw_length.usize()
    budget: usize = raw_budget.usize()
    if budget == 0 and n != 0:
        previous: mutable i64 = input[2]
        if previous.u64() > 25: return -1
        cost: mutable i64 = 1
        kept: mutable usize = 1
        for index in 1..<n:
            symbol: i64 = input[index + 2]
            if symbol.u64() > 25: return -1
            kept <- kept + 1 if symbol == previous else 1
            # Run lengths 1, 2, and 10 each add an encoded byte.
            cost <- cost + ((1030.u64() >> kept.u64()) & 1).i64()
            previous <- symbol
        return cost

    if budget == n:
        for index in 0..<n:
            if input[index + 2].u64() > 25: return -1
        return 0
    first_symbol: i64 = input[2]
    if first_symbol.u64() > 25: return -1
    matching: mutable usize = 1
    for index in 1..<n:
        symbol: i64 = input[index + 2]
        if symbol.u64() > 25: return -1
        matching <- matching + (1 if symbol == first_symbol else 0)

    # A single run attains the minimum possible cost for this retained length.
    retained: usize = n - budget
    if retained == 1: return 1
    if matching >= retained: return sci_run_cost(retained)

    # Store matching endpoints as one-based positions. Zero ends a chain.
    next_match: mutable usize[SCI_MAX_N] = zeroed
    latest_match: mutable usize[26] = zeroed
    repeated_endpoint: mutable usize = 0
    position: mutable usize = n
    while position != 0:
        symbol: usize = input[position + 1].usize()
        next_position: usize = latest_match[symbol]
        next_match[position - 1] <- next_position
        repeated_endpoint <- repeated_endpoint | next_position
        latest_match[symbol] <- position
        position <- position - 1

    if repeated_endpoint == 0: return retained.i64()

    dp: mutable i64[SCI_CELLS] = zeroed
    for i in 0..<SCI_CELLS:
        dp[i] <- SCI_INF
    dp[0] <- 0
    final_state: usize = n * SCI_WIDTH + budget
    dp[final_state] <- retained.i64()
    for start in 0..<n:
        remaining: usize = n - start
        first_used: usize = budget - remaining + 1 if budget >= remaining else 0
        last_used: usize = start if start < budget else budget
        for used in first_used..=last_used:
            prefix_cost: i64 = dp[start * SCI_WIDTH + used]
            kept_limit: usize = retained - (start - used)
            if prefix_cost + sci_run_cost(kept_limit) >= dp[final_state]: continue
            if used < budget:
                next_state: usize = (start + 1) * SCI_WIDTH + used + 1
                if prefix_cost < dp[next_state]: dp[next_state] <- prefix_cost
            if kept_limit == 0: continue
            endpoint: mutable usize = start + 1
            kept: mutable usize = 1
            while endpoint != 0:
                deleted: usize = used + endpoint - start - kept
                if deleted > budget: break
                candidate: i64 = prefix_cost + sci_run_cost(kept)
                state: usize = final_state if kept == kept_limit else endpoint * SCI_WIDTH + deleted
                if candidate < dp[state]: dp[state] <- candidate
                if kept == kept_limit: break
                endpoint <- next_match[endpoint - 1]
                kept <- kept + 1
    dp[final_state]

export fn string_compression_ii(input: i64&?, length: usize) -> i64 = sci_compute
