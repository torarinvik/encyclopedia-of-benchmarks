const SCI_MAX_N: usize = 12
const SCI_WIDTH: usize = 16
const SCI_CELLS: usize = SCI_WIDTH * (SCI_MAX_N + 1)
const SCI_SCORE_BASE: u32 = 16

def sci_run_cost(kept: usize) -> i64:
    if kept == 1: return 1
    3 if kept >= 10 else 2

def sci_compute(input: i64&?, length: usize) -> i64:
    if input == null or length < 2: return -1
    raw_length: u64 = input[0].u64()
    if raw_length > SCI_MAX_N.u64() or raw_length != (length - 2).u64(): return -1
    raw_budget: u64 = input[1].u64()
    if raw_budget > raw_length: return -1
    n: usize = raw_length.usize()
    budget: usize = raw_budget.usize()
    if budget == 0 and n != 0:
        previous: mutable i64 = input[2]
        if previous.u64() > 25: return -1
        cost: mutable i64 = 1
        kept: mutable usize = 1
        for index in 1..<n:
            symbol: i64 = input[index + 2]
            if symbol.u64() > 25: return -1
            kept <- kept + 1 if symbol == previous else 1
            # Run lengths 1, 2, and 10 each add an encoded byte.
            cost <- cost + ((1030.u64() >> kept.u64()) & 1).i64()
            previous <- symbol
        return cost

    if budget == n:
        for index in 0..<n:
            if input[index + 2].u64() > 25: return -1
        return 0
    first_symbol: i64 = input[2]
    if first_symbol.u64() > 25: return -1
    matching: mutable usize = 1
    for index in 1..<n:
        symbol: i64 = input[index + 2]
        if symbol.u64() > 25: return -1
        matching <- matching + (1 if symbol == first_symbol else 0)

    # A single run attains the minimum possible cost for this retained length.
    retained: usize = n - budget
    if retained <= 2: return retained.i64()
    if matching >= retained: return sci_run_cost(retained)

    if retained == 4: return sci_keep_four(input, n)
    sci_search(input, n.u32(), budget.u32(), retained.u32())

@inline(never)
def sci_delete_one(input: i64&, n: usize, next_match: u8&) -> i64:
    cost: mutable i64 = 0
    saving: mutable i64 = 0
    older_symbol: mutable i64 = -1
    older_length: mutable usize = 0
    previous_symbol: mutable i64 = -1
    previous_length: mutable usize = 0
    start: mutable usize = 0
    while start < n:
        symbol: i64 = input[start + 2]
        ending: mutable usize = start + 1
        while next_match[ending].usize() == ending + 1:
            ending <- ending + 1
        run_length: usize = ending - start
        run_cost: i64 = sci_run_cost(run_length)
        cost <- cost + run_cost
        if run_length == 1 or run_length == 2 or run_length == 10:
            if saving == 0: saving <- 1
        # Deleting a singleton can join the equal runs on either side.
        if previous_length == 1 and older_symbol == symbol:
            extra_left: i64 = 1 if older_length > 1 else 0
            extra_right: i64 = 1 if run_length > 1 else 0
            crosses_ten: i64 = 1 if older_length < 10 and run_length < 10 and older_length + run_length >= 10 else 0
            merged_saving: i64 = 1 + extra_left + extra_right - crosses_ten
            if merged_saving > saving: saving <- merged_saving
        older_symbol <- previous_symbol
        older_length <- previous_length
        previous_symbol <- symbol
        previous_length <- run_length
        start <- ending
    cost - saving

@inline(never)
def sci_keep_four(input: i64&, n: usize) -> i64:
    counts: mutable u64 = 0
    for index in 0..<n:
        shift: u64 = input[index + 2].u64() * 2
        if ((counts >> shift) & 3) == 3: return 2
        counts <- counts + (1.u64() << shift)
    triples: mutable u64 = counts & (counts >> 1) & 0x5555555555555555.u64()
    # The fourth symbol must fit before or after the chosen triple.
    if input[2] == input[n + 1]:
        triples <- triples & (0xffffffffffffffff.u64() ^ (1.u64() << (input[2].u64() * 2)))
    3 if triples != 0 else 4

@inline(never)
def sci_search(input: i64&, n: u32, budget: u32, retained: u32) -> i64:
    # With at most two occurrences of each symbol, every kept byte costs one.
    # The high bit of each two-bit counter is set after the second occurrence.
    counts: mutable u64 = 0
    position: mutable u32 = 0
    while position < n:
        shift: u64 = input[position + 2].u64() * 2
        increment: u64 = 1.u64() << shift
        if ((counts >> shift) & 2) != 0: break
        counts <- counts + increment
        position <- position + 1
    if position == n: return retained.i64()
    if retained == 3: return 2

    next_match: mutable u8[SCI_MAX_N + 1] = zeroed
    latest_match: mutable u8[26] = zeroed
    position <- n
    while position != 0:
        symbol: u32 = input[position + 1].u32()
        next_match[position] <- latest_match[symbol]
        latest_match[symbol] <- position.u8()
        position <- position - 1

    if budget == 1: return sci_delete_one(input, n.usize(), &next_match[0])

    dp: mutable u32[SCI_CELLS] = zeroed
    # Scores are the base minus the encoded cost. Zero marks an unset state.
    dp[0] <- SCI_SCORE_BASE
    best_score: mutable u32 = SCI_SCORE_BASE - retained
    for start in 0..<n:
        first_used: u32 = (start + 1 if start + 1 > retained else retained) - retained
        last_used: u32 = start if start < budget else budget
        for used in first_used..=last_used:
            prefix_score: u32 = dp[start * SCI_WIDTH.u32() + used]
            kept_limit: u32 = retained - (start - used)
            if kept_limit <= 2:
                if prefix_score > best_score + kept_limit: best_score <- prefix_score - kept_limit
                continue
            minimum_cost: u32 = 2 if kept_limit < 10 else 3
            if prefix_score <= best_score + minimum_cost: continue
            if used < budget:
                next_state: u32 = (start + 1) * SCI_WIDTH.u32() + used + 1
                if prefix_score > dp[next_state]: dp[next_state] <- prefix_score
            singleton_score: u32 = prefix_score - 1
            first_endpoint: u32 = start + 1
            singleton_state: u32 = first_endpoint * SCI_WIDTH.u32() + used
            if singleton_score > dp[singleton_state]: dp[singleton_state] <- singleton_score
            second_endpoint: u32 = next_match[first_endpoint].u32()
            if second_endpoint == 0: continue
            pair_deleted: u32 = used + second_endpoint - start - 2
            if pair_deleted > budget: continue
            pair_state: u32 = second_endpoint * SCI_WIDTH.u32() + pair_deleted
            pair_score: u32 = prefix_score - 2
            if pair_score > dp[pair_state]: dp[pair_state] <- pair_score
            endpoint: mutable u32 = next_match[second_endpoint].u32()
            kept: mutable u32 = 3
            while endpoint != 0:
                deleted: u32 = used + endpoint - start - kept
                if deleted > budget: break
                run_cost: u32 = 2 if kept < 10 else 3
                candidate: u32 = prefix_score - run_cost
                if kept == kept_limit:
                    if candidate > best_score: best_score <- candidate
                    break
                state: u32 = endpoint * SCI_WIDTH.u32() + deleted
                if candidate > dp[state]: dp[state] <- candidate
                endpoint <- next_match[endpoint].u32()
                kept <- kept + 1
    (SCI_SCORE_BASE - best_score).i64()

export fn string_compression_ii(input: i64&?, length: usize) -> i64 = sci_compute
