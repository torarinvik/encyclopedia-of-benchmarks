# Recursive binary search membership check over an ascending sequence.
def simple_binary_search_range(values: view[i64], low: usize, high: usize, target: i64) -> i64:
    if low >= high:
        return 0

    middle: usize = low + (high - low) / 2
    if values[middle] == target:
        return 1
    if target < values[middle]:
        return simple_binary_search_range(values, low, middle, target)
    simple_binary_search_range(values, middle + 1, high, target)

def simple_binary_search_impl(values: i64&, length: usize, target: i64) -> i64:
    simple_binary_search_range(values[0:length], 0, length, target)

export fn simple_binary_search(values: i64&, length: usize, target: i64) -> i64 = simple_binary_search_impl
