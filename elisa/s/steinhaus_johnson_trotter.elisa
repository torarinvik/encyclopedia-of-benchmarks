# Steinhaus-Johnson-Trotter permutations in Heap-style inversion-counter order.
const SJT_MAX_LENGTH: usize = 6

# Emit one row of little-endian i32 values and return the next offset.
def sjt_emit_row(values: view[i32], length: usize, output: mutable u8&, offset: usize) -> usize:
    at: mutable usize = offset
    index: mutable usize = 0
    while index < length:
        bits: u32 = values[index].u32()
        byte: mutable usize = 0
        while byte < 4:
            output[at] <- ((bits >> (8 * byte).u32()) & 255).u8()
            at <- at + 1
            byte <- byte + 1
        index <- index + 1
    at

def steinhaus_johnson_trotter_impl(input: i32&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or length == 0 or length > SJT_MAX_LENGTH:
        return -1
    permutations: mutable usize = 1
    factor: mutable usize = 2
    while factor <= length:
        permutations <- permutations * factor
        factor <- factor + 1
    required: usize = 4 * length * permutations
    if output == null or output_capacity < required:
        return -2

    values: mutable i32[6] = zeroed
    inversion: mutable usize[6] = zeroed
    index: mutable usize = 0
    while index < length:
        values[index] <- input[index]
        index <- index + 1
    offset: mutable usize = sjt_emit_row(values[0:SJT_MAX_LENGTH], length, output, 0)

    index <- 1
    while index < length:
        if inversion[index] < index:
            swap_index: usize = 0 if index % 2 == 0 else inversion[index]
            temporary: i32 = values[swap_index]
            values[swap_index] <- values[index]
            values[index] <- temporary
            offset <- sjt_emit_row(values[0:SJT_MAX_LENGTH], length, output, offset)
            inversion[index] <- inversion[index] + 1
            index <- 1
        else:
            inversion[index] <- 0
            index <- index + 1
    required.i64()

export fn steinhaus_johnson_trotter(input: i32&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64 = steinhaus_johnson_trotter_impl
