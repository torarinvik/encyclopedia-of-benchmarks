const MAX_LENGTH: usize = 6
# Four bytes per value, with length! rows.
const ROW_BYTES: usize[8] = [0, 4, 16, 72, 384, 2400, 17280, 0]

def sjt_emit_value(value: i32, output: mutable u8&, offset: usize) -> void:
    bits: u32 = value.u32()
    output[offset] <- bits.u8()
    output[offset+1] <- (bits >> 8).u8()
    output[offset+2] <- (bits >> 16).u8()
    output[offset+3] <- (bits >> 24).u8()

def sjt_emit_row(values: mutable i32[MAX_LENGTH]&, length: usize, output: mutable u8&, offset: mutable usize&) -> void:
    sjt_emit_value(values[0], output, offset)
    sjt_emit_value(values[1], output, offset+4)
    sjt_emit_value(values[2], output, offset+8)
    sjt_emit_value(values[3], output, offset+12)
    if length > 4:
        sjt_emit_value(values[4], output, offset+16)
    if length > 5:
        sjt_emit_value(values[5], output, offset+20)
    offset <- offset+4*length

def sjt_emit_triple(first: i32, second: i32, third: i32, output: mutable u8&, offset: usize) -> void:
    sjt_emit_value(first, output, offset)
    sjt_emit_value(second, output, offset+4)
    sjt_emit_value(third, output, offset+8)

def steinhaus_johnson_trotter_impl(input: i32&?, length: usize,
        output: mutable u8&?, output_capacity: usize) -> i64:
    if length == 3:
        if input == null:
            return -1
        if output == null or output_capacity < 72:
            return -2
        first: i32 = input[0]
        second: i32 = input[1]
        third: i32 = input[2]
        # The pinned inversion-vector order for three positions.
        sjt_emit_triple(first, second, third, output, 0)
        sjt_emit_triple(second, first, third, output, 12)
        sjt_emit_triple(third, first, second, output, 24)
        sjt_emit_triple(first, third, second, output, 36)
        sjt_emit_triple(second, third, first, output, 48)
        sjt_emit_triple(third, second, first, output, 60)
        return 72
    if input == null:
        return -1
    if length == 2:
        if output == null or output_capacity < 16:
            return -2
        first: i32 = input[0]
        second: i32 = input[1]
        sjt_emit_value(first, output, 0)
        sjt_emit_value(second, output, 4)
        sjt_emit_value(second, output, 8)
        sjt_emit_value(first, output, 12)
        return 16
    if length == 1:
        if output == null or output_capacity < 4:
            return -2
        sjt_emit_value(input[0], output, 0)
        return 4
    if length < 4 or length > MAX_LENGTH:
        return -1
    sjt_emit_many(input, length, output, output_capacity)

@inline(never)
def sjt_emit_many(input: i32&, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    required: usize = ROW_BYTES[length & 7]
    if output == null or output_capacity < required:
        return -2

    values: mutable i32[MAX_LENGTH] = zeroed
    inversion: mutable usize[MAX_LENGTH] = zeroed
    values[0] <- input[0]
    values[1] <- input[1]
    values[2] <- input[2]
    values[3] <- input[3]
    if length > 4:
        values[4] <- input[4]
    if length > 5:
        values[5] <- input[5]
    offset: mutable usize = 0
    sjt_emit_row(&values, length, output, offset)

    index: mutable usize = 1
    while index < length |values, inversion, output, offset, index|:
        if inversion[index] < index:
            swap_index: mutable usize = 0
            if index % 2 != 0:
                swap_index <- inversion[index]
            temporary: i32 = values[swap_index]
            values[swap_index] <- values[index]
            values[index] <- temporary
            sjt_emit_row(&values, length, output, offset)
            inversion[index] <- inversion[index] + 1
            index <- 1
        else:
            inversion[index] <- 0
            index <- index + 1
    required.i64()

export fn steinhaus_johnson_trotter(input: i32&?, length: usize,
        output: mutable u8&?, output_capacity: usize) -> i64 = steinhaus_johnson_trotter_impl
