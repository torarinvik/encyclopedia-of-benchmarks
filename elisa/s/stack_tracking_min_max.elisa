def stack_tracking_min_max_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 130:
        return -1
    max_size: u64 = input[0].u64()
    operation_count: u64 = input[1].u64()
    if max_size > 64 or operation_count > 64:
        return -1

    if operation_count == 0:
        if length != 2:
            return -1
        return -2 if output == null else 0

    position: mutable usize = 2
    for operation in 0..<operation_count.usize():
        if position >= length:
            return -1
        opcode: i64 = input[position]
        position <- position + 1
        if opcode == 1:
            if position >= length:
                return -1
            value: i64 = input[position]
            if value < -2147483648 or value > 2147483647:
                return -1
            position <- position + 1
        elif opcode < 2 or opcode > 5:
            return -1
    if position != length:
        return -1

    values: mutable i64[64] = zeroed
    minima: mutable i64[64] = zeroed
    maxima: mutable i64[64] = zeroed
    records: mutable i64[192] = zeroed
    top: mutable usize = 0
    words: mutable usize = 0
    position <- 2
    for operation in 0..<operation_count.usize():
        opcode: i64 = input[position]
        position <- position + 1
        tag: mutable i64 = 0
        result: mutable i64 = 0
        if opcode == 1:
            value: i64 = input[position]
            position <- position + 1
            if top == max_size.usize():
                records[words] <- 1
                records[words + 1] <- 4
                records[words + 2] <- 1
                words <- words + 3
                break
            values[top] <- value
            minima[top] <- value
            maxima[top] <- value
            if top != 0:
                previous_min: i64 = minima[top - 1]
                previous_max: i64 = maxima[top - 1]
                minima[top] <- previous_min if previous_min < value else value
                maxima[top] <- previous_max if previous_max > value else value
            top <- top + 1
            tag <- 1
            result <- 1
        elif opcode == 5:
            tag <- 1
            result <- 1 if top != 0 else 0
        elif top == 0:
            tag <- 3
        elif opcode == 2:
            top <- top - 1
            result <- values[top]
        elif opcode == 3:
            result <- minima[top - 1]
        else:
            result <- maxima[top - 1]
        records[words] <- opcode
        records[words + 1] <- tag
        records[words + 2] <- result
        words <- words + 3

    output_bytes: usize = words * 8
    if output == null or capacity < output_bytes:
        return -2
    for word in 0..<words:
        bits: u64 = records[word].u64()
        for byte in 0..<8:
            output[word * 8 + byte] <- (bits >> (byte * 8)).u8()
    output_bytes.i64()

export fn stack_tracking_min_max(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stack_tracking_min_max_impl
