# A bounded stack that tracks its running minimum and maximum per level.
def stack_tracking_put64(output: mutable u8&, position: usize, value: i64) -> usize:
    bits: mutable u64 = value.u64()
    at: mutable usize = position
    j: mutable usize = 0
    while j < 8:
        output[at] <- (bits & 255).u8()
        at <- at + 1
        bits <- bits >> 8
        j <- j + 1
    at

def stack_tracking_min_max_impl(input: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > 130:
        return -1
    max_size: i64 = input[0]
    op_count: i64 = input[1]
    if max_size < 0 or max_size > 64 or op_count < 0 or op_count > 64:
        return -1
    p: mutable usize = 2
    i: mutable i64 = 0
    while i < op_count:
        if p >= length:
            return -1
        op: i64 = input[p]
        p <- p + 1
        if op == 1:
            if p >= length or input[p] < -2147483648 or input[p] > 2147483647:
                return -1
            p <- p + 1
        elif op < 2 or op > 5:
            return -1
        i <- i + 1
    if p != length:
        return -1

    values: mutable i64[64] = zeroed
    mins: mutable i64[64] = zeroed
    maxs: mutable i64[64] = zeroed
    records: mutable i64[192] = zeroed
    top: mutable usize = 0
    record_count: mutable usize = 0
    p <- 2
    i <- 0
    while i < op_count:
        op: i64 = input[p]
        p <- p + 1
        tag: mutable i64 = 0
        result: mutable i64 = 0
        if op == 1:
            x: i64 = input[p]
            p <- p + 1
            if top == max_size.usize():
                records[record_count * 3] <- 1
                records[record_count * 3 + 1] <- 4
                records[record_count * 3 + 2] <- 1
                record_count <- record_count + 1
                break
            values[top] <- x
            mins[top] <- (mins[top - 1] if mins[top - 1] < x else x) if top != 0 else x
            maxs[top] <- (maxs[top - 1] if maxs[top - 1] > x else x) if top != 0 else x
            top <- top + 1
            tag <- 1
            result <- 1
        elif op == 2:
            if top != 0:
                top <- top - 1
                result <- values[top]
            else:
                tag <- 3
        elif op == 3:
            if top != 0:
                result <- mins[top - 1]
            else:
                tag <- 3
        elif op == 4:
            if top != 0:
                result <- maxs[top - 1]
            else:
                tag <- 3
        else:
            tag <- 1
            result <- 1 if top != 0 else 0
        records[record_count * 3] <- op
        records[record_count * 3 + 1] <- tag
        records[record_count * 3 + 2] <- result
        record_count <- record_count + 1
        i <- i + 1
    need: usize = record_count * 24
    if output == null or output_capacity < need:
        return -2
    position: mutable usize = 0
    i <- 0
    while i.usize() < record_count * 3:
        position <- stack_tracking_put64(output, position, records[i.usize()])
        i <- i + 1
    position.i64()

export fn stack_tracking_min_max(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stack_tracking_min_max_impl
