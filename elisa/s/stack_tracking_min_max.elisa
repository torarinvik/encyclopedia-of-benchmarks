def put64(output: mutable u8&, pos: mutable usize&, value: i64) -> void:
    bits: u64 = value.u64()
    for j in 0..<8: output[pos] <- ((bits >> (8*j)) & 255).u8(); pos <- pos+1

def stack_tracking_min_max_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null || length < 2 || length > 130: return -1
    max_size: i64 = input[0]; op_count: i64 = input[1]
    if max_size < 0 || max_size > 64 || op_count < 0 || op_count > 64: return -1
    p: mutable usize = 2
    for i in 0..<op_count.usize():
        if p >= length: return -1
        op: i64 = input[p]; p <- p+1
        if op == 1:
            if p >= length || input[p] < -2147483648 || input[p] > 2147483647: return -1
            p <- p+1
        else if op < 2 || op > 5: return -1
    if p != length: return -1
    vals: mutable [64]i64 = [0;64]; mins: mutable [64]i64 = [0;64]; maxs: mutable [64]i64 = [0;64]
    records: mutable [64][3]i64 = [[0;3];64]; top: mutable usize = 0; rc: mutable usize = 0; p <- 2
    for i in 0..<op_count.usize():
        op: i64 = input[p]; p <- p+1; tag: mutable i64 = 0; result: mutable i64 = 0
        if op == 1:
            x: i64 = input[p]; p <- p+1
            if top == max_size.usize(): records[rc] <- [1,4,1]; rc <- rc+1; break
            vals[top] <- x
            mins[top] <- if top == 0: x else: if mins[top-1] < x: mins[top-1] else: x
            maxs[top] <- if top == 0: x else: if maxs[top-1] > x: maxs[top-1] else: x
            top <- top+1; tag <- 1; result <- 1
        else if op == 2:
            if top > 0: top <- top-1; result <- vals[top]
            else: tag <- 3
        else if op == 3:
            if top > 0: result <- mins[top-1]
            else: tag <- 3
        else if op == 4:
            if top > 0: result <- maxs[top-1]
            else: tag <- 3
        else: tag <- 1; result <- if top > 0: 1 else: 0
        records[rc] <- [op,tag,result]; rc <- rc+1
    need: usize = rc*24
    if output == null || capacity < need: return -2
    pos: mutable usize = 0
    for i in 0..<rc:
        for j in 0..<3: put64(output,pos,records[i][j])
    pos.i64()
export fn stack_tracking_min_max(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = stack_tracking_min_max_impl
