# Sentinel search for the shared mutable-input benchmark contract.
def sentinel_search_impl(values: mutable i64&, length: usize, target: i64) -> i64:
    if length == 0:
        return -1

    last_index: usize = length - 1
    saved_last: i64 = values[last_index]
    if saved_last == target:
        return last_index.i64()

    values[last_index] <- target
    index: mutable usize = 0
    while values[index] != target:
        index <- index + 1
    values[last_index] <- saved_last

    if index == last_index:
        return -1
    index.i64()

export fn sentinel_search(values: mutable i64&, length: usize, target: i64) -> i64 = sentinel_search_impl
