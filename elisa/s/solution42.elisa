const MAX_INPUT_LENGTH: usize = 16384

def solution42_is_triangle_score(score: i64) -> bool:
    n: mutable i64 = 1
    while n <= 100:
        if n * (n + 1) == 2 * score: return true
        n <- n + 1
    false

def solution42_count_first_line(input: i64&, length: usize) -> i64:
    line_end: mutable usize = length
    index: mutable usize = 0
    while index < length:
        if input[index] == 10 or input[index] == 13:
            line_end <- index
            break
        index <- index + 1
    count: mutable i64 = 0
    token_start: mutable usize = 0
    position: mutable usize = 0
    while position <= line_end:
        if position != line_end and input[position] != 44:
            position <- position + 1
            continue
        start: mutable usize = token_start
        finish: mutable usize = position
        while start < finish and input[start] == 34:
            start <- start + 1
        while start < finish and input[finish - 1] == 34:
            finish <- finish - 1
        score: mutable i64 = 0
        index <- start
        while index < finish:
            score <- score + input[index] - 64
            index <- index + 1
        if solution42_is_triangle_score(score):
            count <- count + 1
        token_start <- position + 1
        position <- position + 1
    count

def solution42_impl(input: i64&, length: usize) -> i64:
    if length > MAX_INPUT_LENGTH: return -1
    if input.is_null():
        if length == 0: return 0
        return -1
    if length == 0: return 0
    index: mutable usize = 0
    while index < length:
        if input[index] < 0 or input[index] > 127: return -1
        index <- index + 1
    solution42_count_first_line(input, length)

export fn solution42(input: i64&, length: usize) -> i64 = solution42_impl
