def simulated_annealing_score(x: i64, y: i64) -> i64:
    x * x + y * y

def simulated_annealing_impl(packed: i64&, length: usize) -> i64:
    if packed.is_null() or length < 13 or length > 366: return -1
    x0: i64 = packed[0]
    y0: i64 = packed[1]
    step: i64 = packed[2]
    min_x: i64 = packed[3]
    max_x: i64 = packed[4]
    min_y: i64 = packed[5]
    max_y: i64 = packed[6]
    find_max: i64 = packed[7]
    start_raw: i64 = packed[8]
    rate_raw: i64 = packed[9]
    threshold_raw: i64 = packed[10]
    selection_count: i64 = packed[11]
    if x0 < -16 or x0 > 16 or y0 < -16 or y0 > 16 or step < 1 or step > 4: return -1
    if min_x < -16 or max_x > 16 or min_x > max_x or min_y < -16 or max_y > 16 or min_y > max_y: return -1
    if x0 < min_x or x0 > max_x or y0 < min_y or y0 > max_y or (find_max != 0 and find_max != 1): return -1
    if start_raw < 1000000 or start_raw > 10000000 or rate_raw < 100000 or rate_raw > 500000: return -1
    if threshold_raw < 1000000 or threshold_raw > 9999999 or threshold_raw >= start_raw: return -1
    if selection_count < 0 or selection_count > 176 or selection_count > (length - 13).i64(): return -1
    selection_n: usize = selection_count.usize()
    acceptance_count_index: usize = 12 + selection_n
    acceptance_count: i64 = packed[acceptance_count_index]
    if acceptance_count < 0 or acceptance_count > 176: return -1
    if length != 13 + selection_n + acceptance_count.usize(): return -1

    index: mutable usize = 0
    while index < selection_n:
        if packed[12 + index] < 0 or packed[12 + index] > 7: return -1
        index <- index + 1
    acceptance_start: usize = acceptance_count_index + 1
    index <- 0
    while index < acceptance_count.usize():
        draw: i64 = packed[acceptance_start + index]
        if draw != 0 and draw != 999999: return -1
        index <- index + 1

    current_temp: mutable f64 = start_raw.f64() / 1000000.0
    rate: f64 = rate_raw.f64() / 1000000.0
    threshold: f64 = threshold_raw.f64() / 1000000.0
    current_x: mutable i64 = x0
    current_y: mutable i64 = y0
    best_x: mutable i64 = x0
    best_y: mutable i64 = y0
    best_score: mutable i64 = simulated_annealing_score(x0, y0)
    selection_cursor: mutable usize = 0
    acceptance_cursor: mutable usize = 0
    stopped: mutable bool = false
    iteration: mutable i64 = 0

    while iteration < 22:
        current_score: i64 = simulated_annealing_score(current_x, current_y)
        if current_score > best_score:
            best_score <- current_score
            best_x <- current_x
            best_y <- current_y
        neighbor_x: mutable i64[8] = zeroed
        neighbor_y: mutable i64[8] = zeroed
        neighbor_x[0] <- current_x - step
        neighbor_x[1] <- current_x - step
        neighbor_x[2] <- current_x - step
        neighbor_x[3] <- current_x
        neighbor_x[4] <- current_x
        neighbor_x[5] <- current_x + step
        neighbor_x[6] <- current_x + step
        neighbor_x[7] <- current_x + step
        neighbor_y[0] <- current_y - step
        neighbor_y[1] <- current_y
        neighbor_y[2] <- current_y + step
        neighbor_y[3] <- current_y - step
        neighbor_y[4] <- current_y + step
        neighbor_y[5] <- current_y - step
        neighbor_y[6] <- current_y
        neighbor_y[7] <- current_y + step
        remaining: mutable usize = 8
        found: mutable bool = false
        next_x: mutable i64 = 0
        next_y: mutable i64 = 0
        while not found and remaining > 0:
            if selection_cursor >= selection_n: return -1
            rank: usize = packed[12 + selection_cursor].usize()
            selection_cursor <- selection_cursor + 1
            if rank >= remaining: return -1
            candidate_x: i64 = neighbor_x[rank]
            candidate_y: i64 = neighbor_y[rank]
            raw_change: i64 = simulated_annealing_score(candidate_x, candidate_y) - current_score
            shift: mutable usize = rank + 1
            while shift < remaining:
                neighbor_x[shift - 1] <- neighbor_x[shift]
                neighbor_y[shift - 1] <- neighbor_y[shift]
                shift <- shift + 1
            remaining <- remaining - 1
            if candidate_x < min_x or candidate_x > max_x or candidate_y < min_y or candidate_y > max_y:
                continue
            change: i64 = raw_change
            if find_max == 0: change <- -raw_change
            if change > 0:
                found <- true
            else:
                if acceptance_cursor >= acceptance_count.usize(): return -1
                draw: i64 = packed[acceptance_start + acceptance_cursor]
                acceptance_cursor <- acceptance_cursor + 1
                if change == 0 or draw == 0: found <- true
            if found:
                next_x <- candidate_x
                next_y <- candidate_y
        current_temp <- current_temp - current_temp * rate
        if current_temp < threshold or not found:
            stopped <- true
            break
        current_x <- next_x
        current_y <- next_y
        iteration <- iteration + 1
    if not stopped: return -1
    (best_x + 16) * 33 + (best_y + 16)

export fn simulated_annealing(packed: i64&, length: usize) -> i64 = simulated_annealing_impl
