const MAX_MESSAGE_BYTES: usize = 4096
const MAX_PARSEABLE_INPUT_LENGTH: usize = 4099
const MAX_OUTPUT_BYTES: usize = 64

def sha3_rotate_left(value: u64, amount: usize) -> u64:
    if amount == 0: return value
    (value << amount) | (value >> (64 - amount))

def sha3_keccak_f(state: mutable view[u64]) -> void:
    constants: u64[24] = [
        0x0000000000000001,0x0000000000008082,0x800000000000808A,0x8000000080008000,
        0x000000000000808B,0x0000000080000001,0x8000000080008081,0x8000000000008009,
        0x000000000000008A,0x0000000000000088,0x0000000080008009,0x000000008000000A,
        0x000000008000808B,0x800000000000008B,0x8000000080008089,0x8000000000008003,
        0x8000000000008002,0x8000000000000080,0x000000000000800A,0x800000008000000A,
        0x8000000080008081,0x8000000000008080,0x0000000080000001,0x8000000080008008]
    rotations: usize[25] = [0,1,62,28,27,36,44,6,55,20,3,10,43,25,39,41,45,15,21,8,18,2,61,56,14]
    round: mutable usize = 0
    while round < 24:
        column: mutable u64[5] = zeroed
        delta: mutable u64[5] = zeroed
        moved: mutable u64[25] = zeroed
        x: mutable usize = 0
        while x < 5:
            column[x] <- state[x] ^ state[x + 5] ^ state[x + 10] ^ state[x + 15] ^ state[x + 20]
            x <- x + 1
        x <- 0
        while x < 5:
            delta[x] <- column[(x + 4) % 5] ^ sha3_rotate_left(column[(x + 1) % 5], 1)
            x <- x + 1
        y: mutable usize = 0
        while y < 5:
            x <- 0
            while x < 5:
                state[x + 5 * y] <- state[x + 5 * y] ^ delta[x]
                x <- x + 1
            y <- y + 1
        y <- 0
        while y < 5:
            x <- 0
            while x < 5:
                source: usize = x + 5 * y
                target: usize = y + 5 * ((2 * x + 3 * y) % 5)
                moved[target] <- sha3_rotate_left(state[source], rotations[source])
                x <- x + 1
            y <- y + 1
        y <- 0
        while y < 5:
            x <- 0
            while x < 5:
                state[x + 5 * y] <- moved[x + 5 * y] ^
                    ((~moved[(x + 1) % 5 + 5 * y]) & moved[(x + 2) % 5 + 5 * y])
                x <- x + 1
            y <- y + 1
        state[0] <- state[0] ^ constants[round]
        round <- round + 1

def sha3_absorb_byte(state: mutable view[u64], offset: usize, value: u8) -> void:
    state[offset / 8] <- state[offset / 8] ^ (value.u64() << ((offset % 8) * 8))

def sha3_impl(input: i64&, input_length: usize,
              output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 2 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    if input[0] < 0 or input[0] > 3 or input[1] < 0 or input[1] > MAX_MESSAGE_BYTES.i64(): return -1
    variant: usize = input[0].usize()
    message_length: usize = input[1].usize()
    if input_length != 2 + message_length: return -1
    index: mutable usize = 0
    while index < message_length:
        if input[2 + index] < 0 or input[2 + index] > 255: return -1
        index <- index + 1

    digest_lengths: usize[4] = [28, 32, 48, 64]
    rates: usize[4] = [144, 136, 104, 72]
    digest_length: usize = digest_lengths[variant]
    rate: usize = rates[variant]
    if output.is_null() or output_capacity < digest_length: return -2

    state: mutable u64[25] = zeroed
    offset: mutable usize = 0
    while message_length - offset >= rate:
        index <- 0
        while index < rate:
            sha3_absorb_byte(state[0:25], index, input[2 + offset + index].u8())
            index <- index + 1
        sha3_keccak_f(state[0:25])
        offset <- offset + rate

    block: mutable u8[144] = zeroed
    remaining: usize = message_length - offset
    index <- 0
    while index < remaining:
        block[index] <- input[2 + offset + index].u8()
        index <- index + 1
    block[remaining] <- block[remaining] ^ 0x06.u8()
    block[rate - 1] <- block[rate - 1] ^ 0x80.u8()
    index <- 0
    while index < rate:
        sha3_absorb_byte(state[0:25], index, block[index])
        index <- index + 1
    sha3_keccak_f(state[0:25])

    index <- 0
    while index < digest_length:
        output[index] <- ((state[index / 8] >> ((index % 8) * 8)) & 255).u8()
        index <- index + 1
    digest_length.i64()

export fn sha3(input: i64&, input_length: usize,
               output: mutable u8&, output_capacity: usize) -> i64 = sha3_impl
