# Sum leaf values reached through left-child links.
def sum_of_left_leaves_visit(nodes: i64&, node_count: usize, node: i64, is_left: bool) -> i64:
    if node == -1:
        return 0
    if node < 0 or node.u64() >= node_count.u64():
        return -2000000000
    index: usize = node.usize()
    value: i64 = nodes[3 * index]
    left: i64 = nodes[3 * index + 1]
    right: i64 = nodes[3 * index + 2]
    invalid_left: bool = left < -1 or (left >= 0 and left.u64() >= node_count.u64())
    invalid_right: bool = right < -1 or (right >= 0 and right.u64() >= node_count.u64())
    if value < -1000 or value > 1000 or invalid_left or invalid_right:
        return -2000000000
    if left == -1 and right == -1:
        return value if is_left else 0
    left_sum: i64 = sum_of_left_leaves_visit(nodes, node_count, left, true)
    if left_sum == -2000000000:
        return -2000000000
    right_sum: i64 = sum_of_left_leaves_visit(nodes, node_count, right, false)
    if right_sum == -2000000000:
        return -2000000000
    left_sum + right_sum

def sum_of_left_leaves_impl(nodes: i64&, node_count: usize, root_index: i64) -> i64:
    if node_count > 1023:
        return -1
    if node_count == 0:
        return 0 if root_index == -1 else -1
    if root_index < 0 or root_index.u64() >= node_count.u64():
        return -1
    result: i64 = sum_of_left_leaves_visit(nodes, node_count, root_index, false)
    -1 if result == -2000000000 else result

export fn sum_of_left_leaves(nodes: i64&, node_count: usize, root_index: i64) -> i64 = sum_of_left_leaves_impl
