def string_switch_case_is_space(value: i64) -> bool =
    value == 32 or (value >= 9 and value <= 13) or (value >= 28 and value <= 31)

def string_switch_case_is_word(value: i64) -> bool =
    (value >= 65 and value <= 90) or (value >= 97 and value <= 122) or
    (value >= 48 and value <= 57)

def string_switch_case_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > 1027:
        return -1
    mode: i64 = input[0]
    separator: i64 = input[1]
    text_length: i64 = input[2]
    if mode < 0 or mode > 8 or separator < 0 or separator > 127 or
        text_length < 0 or text_length > 1024 or length != text_length.usize() + 3 or
        ((mode != 3 and mode != 4) and separator != 0):
        return -1
    index: mutable usize = 0
    invalid: mutable bool = false
    while index < text_length.usize() and not invalid:
        value: i64 = input[index + 3]
        if value < 0 or value > 127:
            invalid <- true
        else:
            index <- index + 1
    if invalid:
        return -1

    result: mutable u8[1024] = zeroed
    used: mutable usize = 0
    if mode <= 2:
        at_word_start: mutable bool = true
        index <- 0
        while index < text_length.usize():
            value: mutable i64 = input[index + 3]
            if not string_switch_case_is_word(value):
                at_word_start <- true
            else:
                if at_word_start:
                    if value >= 97 and value <= 122:
                        value <- value - 32
                    at_word_start <- false
                else if value >= 65 and value <= 90:
                    value <- value + 32
                result[used] <- value.u8()
                used <- used + 1
            index <- index + 1
        if mode == 2:
            if used == 0:
                empty_message: u8[16] = [110,111,116,32,118,97,108,105,100,32,115,116,114,105,110,103]
                index <- 0
                while index < 16:
                    result[used] <- empty_message[index]
                    used <- used + 1
                    index <- index + 1
            else if result[0] >= 65 and result[0] <= 90:
                result[0] <- result[0] + 32
    else:
        upper: bool = mode == 4 or mode == 6 or mode == 8
        delimiter: mutable i64 = separator
        if mode > 4 and mode <= 6:
            delimiter <- 95
        else if mode > 6:
            delimiter <- 45
        group_has_word: mutable bool = false
        pending_space: mutable bool = false
        index <- 0
        while index < text_length.usize():
            value: mutable i64 = input[index + 3]
            if string_switch_case_is_space(value):
                if group_has_word:
                    pending_space <- true
            else if not string_switch_case_is_word(value):
                group_has_word <- false
                pending_space <- false
            else:
                if pending_space and group_has_word:
                    result[used] <- delimiter.u8()
                    used <- used + 1
                pending_space <- false
                if upper and value >= 97 and value <= 122:
                    value <- value - 32
                else if not upper and value >= 65 and value <= 90:
                    value <- value + 32
                result[used] <- value.u8()
                used <- used + 1
                group_has_word <- true
            index <- index + 1
    if used > capacity or (used > 0 and output.is_null()):
        return -2
    index <- 0
    while index < used:
        output[index] <- result[index]
        index <- index + 1
    used.i64()

export fn string_switch_case(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = string_switch_case_impl
