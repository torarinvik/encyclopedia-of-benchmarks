# A stack on a doubly linked list of pooled nodes; records each operation.
const MAX_OPERATIONS: usize = 64
const MAX_INPUT_LENGTH: usize = 129
const MAX_OUTPUT_BYTES: usize = 1536

struct StackNode:
    value: i64
    next: usize
    previous: mutable usize

def stack_write_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte).u64()) & 255).u8()
        byte <- byte + 1

def stack_write_record(output: mutable view[u8], offset: usize, opcode: i64, tag: i64, value: i64) -> void:
    stack_write_i64_le(output, offset, opcode)
    stack_write_i64_le(output, offset + 8, tag)
    stack_write_i64_le(output, offset + 16, value)

def stack_with_doubly_linked_list_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > MAX_OPERATIONS.i64():
        return -1
    count: usize = count_value.usize()
    opcodes: mutable i64[64] = zeroed
    arguments: mutable i64[64] = zeroed
    cursor: mutable usize = 1
    i: mutable usize = 0
    while i < count:
        if cursor >= length:
            return -1
        opcode: i64 = input[cursor]
        cursor <- cursor + 1
        opcodes[i] <- opcode
        if opcode == 1:
            if cursor >= length:
                return -1
            value: i64 = input[cursor]
            cursor <- cursor + 1
            if value < -2147483648 or value > 2147483647:
                return -1
            arguments[i] <- value
        elif opcode < 2 or opcode > 4:
            return -1
        i <- i + 1
    if cursor != length:
        return -1

    nodes: mutable StackNode[65] = zeroed
    next_node: mutable usize = 0
    head: mutable usize = 0
    written: mutable usize = 0
    buffer: mutable u8[1536] = zeroed
    i <- 0
    while i < count:
        opcode: i64 = opcodes[i]
        tag: mutable i64 = 2
        value: mutable i64 = 0
        if opcode == 1:
            next_node <- next_node + 1
            node_id: usize = next_node
            nodes[node_id] <- StackNode{value: arguments[i], next: head, previous: 0}
            if head != 0:
                nodes[head].previous <- node_id
            head <- node_id
        elif opcode == 2:
            if head != 0:
                tag <- 0
                value <- nodes[head].value
                head <- nodes[head].next
                if head != 0:
                    nodes[head].previous <- 0
        elif opcode == 3:
            if head != 0:
                tag <- 0
                value <- nodes[head].value
        else:
            tag <- 0
            node: mutable usize = head
            while node != 0:
                value <- value + 1
                node <- nodes[node].next
        stack_write_record(buffer[0:MAX_OUTPUT_BYTES], written, opcode, tag, value)
        written <- written + 24
        i <- i + 1
    if output == null or capacity < written:
        return -2
    i <- 0
    while i < written:
        output[i] <- buffer[i]
        i <- i + 1
    written.i64()

export fn stack_with_doubly_linked_list(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = stack_with_doubly_linked_list_impl
