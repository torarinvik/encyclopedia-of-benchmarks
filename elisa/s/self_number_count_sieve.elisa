const MAX_LIMIT: i64 = 100000
const MAX_PARSEABLE_LENGTH: usize = 2

def self_number_count_sieve_impl(input: view[i64]) -> i64:
    if input.length < 1 or input.length > MAX_PARSEABLE_LENGTH: return -1
    let limit: i64 = input[0]
    if input.length != 1 or limit < 1 or limit > MAX_LIMIT: return -1

    generated: mutable u64[1563] = zeroed
    generated_view: mutable view[u64] = generated[0:1563]
    source: mutable i64 = 1
    while source <= limit:
        remaining: mutable i64 = source
        digit_sum: mutable i64 = 0
        while remaining > 0:
            digit_sum <- digit_sum + remaining % 10
            remaining <- remaining / 10
        target: i64 = source + digit_sum
        if target <= limit:
            word: usize = target.usize() / 64
            bit: usize = target.usize() % 64
            generated_view[word] <- generated_view[word] | (u64(1) << bit)
        source <- source + 1

    count: mutable i64 = 0
    value: mutable i64 = 1
    while value <= limit:
        word: usize = value.usize() / 64
        bit: usize = value.usize() % 64
        if generated_view[word] & (u64(1) << bit) == 0:
            count <- count + 1
        value <- value + 1
    count

export fn self_number_count_sieve(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_PARSEABLE_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    self_number_count_sieve_impl(input_view)
