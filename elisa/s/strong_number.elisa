# Check whether the sum of the decimal digits' factorials equals the input.
def strong_number_impl(number: i64) -> i64:
    if number < -2147483648 or number > 2147483647:
        return -1
    if number < 0:
        return 0
    remaining: mutable i64 = number
    sum: mutable i64 = 0
    if remaining == 0:
        sum <- 1
    while remaining > 0:
        digit: i64 = remaining % 10
        factorial: mutable i64 = 1
        factor: mutable i64 = 2
        while factor <= digit:
            factorial <- factorial * factor
            factor <- factor + 1
        sum <- sum + factorial
        remaining <- remaining / 10
    if sum == number:
        return 1
    return 0

export fn strong_number(number: i64) -> i64 = strong_number_impl
