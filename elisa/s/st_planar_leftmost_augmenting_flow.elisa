const MAX_N: usize = 6

const MAX_M: usize = 10

const MAX_INPUT: usize = 60

def planar_flow(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if (((input == null) or (length < 4)) or (length > MAX_INPUT)):
        return (-1)
    n0: i64 = input[0]
    m0: i64 = input[1]
    s0: i64 = input[2]
    t0: i64 = input[3]
    if (((((((((n0 < 2) or (n0 > 6)) or (m0 < 1)) or (m0 > 10)) or (s0 < 0)) or (s0 >= n0)) or (t0 < 0)) or (t0 >= n0)) or (s0 == t0)):
        return (-1)
    n: usize = n0.usize()
    m: usize = m0.usize()
    s: usize = s0.usize()
    t: usize = t0.usize()
    if (length < (4 + (3 * m))):
        return (-1)
    eu: mutable usize[MAX_M] = zeroed
    ev: mutable usize[MAX_M] = zeroed
    caps: mutable i64[MAX_M] = zeroed
    # Each byte holds the undirected neighbors of one vertex.
    adjacency: mutable u64 = 0
    at: mutable usize = 4
    e: mutable usize = 0
    while (e < m):
        u0: i64 = input[at]
        v0: i64 = input[(at + 1)]
        c: i64 = input[(at + 2)]
        at <- (at + 3)
        if (((((((u0 < 0) or (u0 >= n0)) or (v0 < 0)) or (v0 >= n0)) or (u0 == v0)) or (c < 0)) or (c > 5)):
            return (-1)
        u: usize = u0.usize()
        v: usize = v0.usize()
        edge_bit: u64 = 1 << (8 * u + v)
        if (adjacency & edge_bit) != 0:
            return -1
        adjacency <- adjacency | edge_bit | (1.u64() << (8 * v + u))
        eu[e] <- u
        ev[e] <- v
        caps[e] <- c
        e <- (e + 1)
    degree: mutable usize[MAX_N] = zeroed
    rot: mutable usize[MAX_N * MAX_N] = zeroed
    # Each edge has two bits, one for each endpoint in the rotation.
    occurrences: mutable u64 = 0
    x: mutable usize = 0
    while (x < n):
        if (at >= length):
            return (-1)
        d0: i64 = input[at]
        at <- (at + 1)
        if (((d0 < 0) or (d0 >= n0)) or ((at + d0.usize()) > length)):
            return (-1)
        d: usize = d0.usize()
        degree[x] <- d
        j: mutable usize = 0
        while (j < d):
            e0: i64 = input[at]
            at <- (at + 1)
            if ((e0 < 0) or (e0 >= m0)):
                return (-1)
            edge: usize = e0.usize()
            if eu[edge] != x and ev[edge] != x:
                return -1
            endpoint: usize = 0 if eu[edge] == x else 1
            bit: u64 = 1 << (2 * edge + endpoint)
            if (occurrences & bit) != 0:
                return -1
            occurrences <- occurrences | bit
            rot[x * MAX_N + j] <- edge
            j <- (j + 1)
        x <- (x + 1)
    if at != length or occurrences != ((1.u64() << (2 * m)) - 1):
        return -1
    all_vertices: u64 = (1.u64() << n) - 1
    connected: mutable u64 = 1 << s
    while connected != all_vertices:
        previous: u64 = connected
        vertex: mutable usize = 0
        while vertex < n:
            if (connected & (1.u64() << vertex)) != 0:
                connected <- connected | ((adjacency >> (8 * vertex)) & 255)
            vertex <- vertex + 1
        if connected == previous:
            return -1
    flow: mutable i64[MAX_M] = zeroed
    total: mutable i64 = 0
    while true:
        seen: mutable bool[MAX_N] = zeroed
        parent: mutable i64[MAX_N] = zeroed
        parent_edge: mutable i64[MAX_N] = zeroed
        parent_dir: mutable i64[MAX_N] = zeroed
        next_edge: mutable usize[MAX_N] = zeroed
        # A discovered vertex has a parent chain back to the source.
        search_stack: mutable usize[MAX_N] = zeroed
        top: mutable usize = 0
        seen[s] <- true
        search_stack[top] <- s
        top <- (top + 1)
        while ((top > 0) and (not seen[t])):
            u: usize = search_stack[(top - 1)]
            if (next_edge[u] >= degree[u]):
                top <- (top - 1)
                continue
            edge: usize = rot[((u * MAX_N) + next_edge[u])]
            next_edge[u] <- (next_edge[u] + 1)
            v: mutable usize = eu[edge]
            residual: mutable i64 = flow[edge]
            direction: mutable i64 = (-1)
            if (eu[edge] == u):
                v <- ev[edge]
                residual <- (caps[edge] - flow[edge])
                direction <- 1
            if ((residual > 0) and (not seen[v])):
                seen[v] <- true
                parent[v] <- u.i64()
                parent_edge[v] <- edge.i64()
                parent_dir[v] <- direction
                search_stack[top] <- v
                top <- (top + 1)
        if (not seen[t]):
            break
        delta: mutable i64 = 1000000
        y: mutable usize = t
        while (y != s):
            u: usize = parent[y].usize()
            edge: usize = parent_edge[y].usize()
            residual: mutable i64 = flow[edge]
            if (eu[edge] == u):
                residual <- (caps[edge] - flow[edge])
            if (residual < delta):
                delta <- residual
            y <- u
        y <- t
        while (y != s):
            edge: usize = parent_edge[y].usize()
            flow[edge] <- (flow[edge] + (parent_dir[y] * delta))
            y <- parent[y].usize()
        total <- (total + delta)
    if ((output == null) or (capacity < 8)):
        return (-2)
    bits: u64 = total.u64()
    b: mutable usize = 0
    while (b < 8):
        output[b] <- ((bits >> (8 * b)) & 255).u8()
        b <- (b + 1)
    return 8.i64()

export fn st_planar_leftmost_augmenting_flow(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = planar_flow
