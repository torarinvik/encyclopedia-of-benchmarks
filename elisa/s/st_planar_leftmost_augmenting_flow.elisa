const MAX_N: usize = 6

# Packed predecessors use three bits for a vertex ID.
const VERTEX_SLOTS: usize = 8

const MAX_M: usize = 10

# DFS paths store the residual arc index in five bits.
const ARC_SLOTS: usize = 32

const MAX_INPUT: usize = 60

def planar_flow(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if (((input == null) or (length < 4)) or (length > MAX_INPUT)):
        return (-1)
    n0: i64 = input[0]
    m0: i64 = input[1]
    s0: i64 = input[2]
    t0: i64 = input[3]
    if (((((((((n0 < 2) or (n0 > 6)) or (m0 < 1)) or (m0 > 10)) or (s0 < 0)) or (s0 >= n0)) or (t0 < 0)) or (t0 >= n0)) or (s0 == t0)):
        return (-1)
    n: usize = n0.usize()
    m: usize = m0.usize()
    s: usize = s0.usize()
    t: usize = t0.usize()
    if (length < (4 + (3 * m))):
        return (-1)
    arc_target: mutable usize[ARC_SLOTS] = zeroed
    residual_capacity: mutable i64[ARC_SLOTS] = zeroed
    # Each byte holds the undirected neighbors of one vertex.
    adjacency: mutable u64 = 0
    at: mutable usize = 4
    e: mutable usize = 0
    while (e < m):
        u0: i64 = input[at]
        v0: i64 = input[(at + 1)]
        c: i64 = input[(at + 2)]
        at <- (at + 3)
        if (((((((u0 < 0) or (u0 >= n0)) or (v0 < 0)) or (v0 >= n0)) or (u0 == v0)) or (c < 0)) or (c > 5)):
            return (-1)
        u: usize = u0.usize()
        v: usize = v0.usize()
        edge_bit: u64 = 1 << (8 * u + v)
        if (adjacency & edge_bit) != 0:
            return -1
        adjacency <- adjacency | edge_bit | (1.u64() << (8 * v + u))
        arc_target[2 * e] <- v
        arc_target[2 * e + 1] <- u
        residual_capacity[2 * e] <- c
        e <- (e + 1)
    degree: mutable usize[VERTEX_SLOTS] = zeroed
    rot: mutable usize[VERTEX_SLOTS * VERTEX_SLOTS] = zeroed
    # Each edge has two bits, one for each endpoint in the rotation.
    occurrences: mutable u64 = 0
    x: mutable usize = 0
    while (x < n):
        if (at >= length):
            return (-1)
        d0: i64 = input[at]
        at <- (at + 1)
        if (((d0 < 0) or (d0 >= n0)) or ((at + d0.usize()) > length)):
            return (-1)
        d: usize = d0.usize()
        degree[x] <- d
        j: mutable usize = 0
        while (j < d):
            e0: i64 = input[at]
            at <- (at + 1)
            if ((e0 < 0) or (e0 >= m0)):
                return (-1)
            edge: usize = e0.usize()
            forward_arc: usize = 2 * edge
            if arc_target[forward_arc + 1] != x and arc_target[forward_arc] != x:
                return -1
            arc: usize = forward_arc + (0 if arc_target[forward_arc + 1] == x else 1)
            bit: u64 = 1 << arc
            if (occurrences & bit) != 0:
                return -1
            occurrences <- occurrences | bit
            rot[x * VERTEX_SLOTS + j] <- arc
            j <- (j + 1)
        x <- (x + 1)
    if at != length or occurrences != ((1.u64() << (2 * m)) - 1):
        return -1
    all_vertices: u64 = (1.u64() << n) - 1
    connected: mutable u64 = 1 << s
    while connected != all_vertices:
        previous: u64 = connected
        vertex: mutable usize = 0
        while vertex < n:
            if (connected & (1.u64() << vertex)) != 0:
                connected <- connected | ((adjacency >> (8 * vertex)) & 255)
            vertex <- vertex + 1
        if connected == previous:
            return -1
    total: mutable i64 = 0
    while true:
        seen: mutable bool[VERTEX_SLOTS] = zeroed
        # The low byte stores predecessor and arc, and the high byte stores capacity.
        path: mutable u16[VERTEX_SLOTS] = zeroed
        path[s] <- 5 << 8
        next_edge: mutable usize[VERTEX_SLOTS] = zeroed
        # A discovered vertex has a parent chain back to the source.
        seen[s] <- true
        u: mutable usize = s & (VERTEX_SLOTS - 1)
        while not seen[t]:
            if next_edge[u] >= degree[u]:
                if u == s:
                    break
                u <- path[u].usize() & (VERTEX_SLOTS - 1)
                continue
            arc: usize = rot[u * VERTEX_SLOTS + (next_edge[u] & (VERTEX_SLOTS - 1))] & (ARC_SLOTS - 1)
            next_edge[u] <- next_edge[u] + 1
            v: usize = arc_target[arc] & (VERTEX_SLOTS - 1)
            available: i64 = residual_capacity[arc]
            if available > 0 and not seen[v]:
                seen[v] <- true
                parent_capacity: i64 = (path[u] >> 8).i64()
                path_capacity: i64 = available if available < parent_capacity else parent_capacity
                path[v] <- (u | (arc << 3) | (path_capacity.usize() << 8)).u16()
                u <- v
        if (not seen[t]):
            break
        delta: i64 = (path[t] >> 8).i64()
        y: mutable usize = t & (VERTEX_SLOTS - 1)
        while (y != s):
            link: usize = path[y].usize()
            arc: usize = (link >> 3) & (ARC_SLOTS - 1)
            reverse_arc: usize = arc ^ 1
            residual_capacity[arc] <- residual_capacity[arc] - delta
            residual_capacity[reverse_arc] <- residual_capacity[reverse_arc] + delta
            y <- link & (VERTEX_SLOTS - 1)
        total <- (total + delta)
    if ((output == null) or (capacity < 8)):
        return (-2)
    bits: u64 = total.u64()
    b: mutable usize = 0
    while (b < 8):
        output[b] <- ((bits >> (8 * b)) & 255).u8()
        b <- (b + 1)
    return 8.i64()

export fn st_planar_leftmost_augmenting_flow(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = planar_flow
