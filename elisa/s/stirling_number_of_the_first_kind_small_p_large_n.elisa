const MAX_N:i64=1000000000000000000
const MAX_T:usize=8
const MAX_K:usize=8
const WIDTH:usize=9

# Bit i marks whether the odd candidate 2*i+1 is prime in the supported range.
const PRIME_MASK: u64 = 0x1129a64b4cb60

def is_prime(value: i64) -> bool:
    (value & 1) != 0 and (PRIME_MASK & (1.u64() << (value.u64() >> 1))) != 0

def stirling_value(n:i64,k:usize,modulus:i64)->i64:
    quotient:i64=n/modulus
    remainder:i64=n%modulus
    if quotient>k.i64():return 0
    target:usize=k-quotient.usize()
    if remainder == 0:
        if target != 0: return 0
        return 1 if (quotient & 1) == 0 else modulus-1
    if target == 0 or target.i64() > remainder: return 0
    # The first factor is x, so the constant coefficient stays zero.
    prime: u64 = modulus.u64()
    coefficients: mutable u64[9] = zeroed
    coefficients[1] <- 1
    residue: mutable u64 = 1
    while residue < remainder.u64():
        degree: mutable usize = target
        while degree > 0:
            coefficients[degree] <- (coefficients[degree-1]+residue*(prime-coefficients[degree]))%prime
            degree <- degree-1
        residue <- residue+1
    coefficient:i64=coefficients[target].i64()
    if quotient%2==0 or coefficient==0:return coefficient
    modulus-coefficient

def stirling_impl(input: i64&?, length: usize) -> i64:
    if input == null or length<4 or length>18:return -1
    count_value:i64=input[0]
    modulus:i64=input[1]
    if count_value<1 or count_value>8 or length!=(2+2*count_value).usize() or modulus<11 or modulus>97 or not is_prime(modulus):return -1

    result:mutable i64=0
    case_index:mutable usize=0
    count:usize=count_value.usize()
    while case_index<count:
        n:i64=input[2+2*case_index]
        k_value:i64=input[3+2*case_index]
        if n<0 or n>MAX_N or k_value<0 or k_value>8 or k_value>n:return -1
        k:usize=k_value.usize()
        value:i64=stirling_value(n,k,modulus)
        next:i64=(case_index+1).i64()
        result<-(result+next*next*value)%modulus
        case_index<-case_index+1
    result

export fn stirling_number_of_the_first_kind_small_p_large_n(input: i64&?, length: usize) -> i64 = stirling_impl
