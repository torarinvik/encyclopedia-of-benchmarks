const MAX_N:i64=1000000000000000000
const MAX_T:usize=8
const MAX_K:usize=8
const WIDTH:usize=9

def is_prime(value:i64)->bool:
    if value<2:return false
    divisor:mutable i64=2
    while divisor<=value/divisor:
        if value%divisor==0:return false
        divisor<-divisor+1
    true

def stirling_value(n:i64,k:usize,modulus:i64)->i64:
    quotient:i64=n/modulus
    remainder:i64=n%modulus
    if quotient>k.i64():return 0
    target:usize=k-quotient.usize()
    coefficients:mutable InlineArray[i64,9]=zeroed
    coefficients[0]<-1
    residue:mutable i64=0
    while residue<remainder:
        degree:mutable usize=target
        while degree>0:
            coefficients[degree]<-(coefficients[degree-1]-residue*coefficients[degree])%modulus
            if coefficients[degree]<0:coefficients[degree]<-coefficients[degree]+modulus
            degree<-degree-1
        coefficients[0]<-(-residue*coefficients[0])%modulus
        if coefficients[0]<0:coefficients[0]<-coefficients[0]+modulus
        residue<-residue+1
    coefficient:i64=coefficients[target]
    if quotient%2==0 or coefficient==0:return coefficient
    modulus-coefficient

def stirling_number_of_the_first_kind_small_p_large_n(input:i64&,length:usize)->i64 @export("stirling_number_of_the_first_kind_small_p_large_n"):
    if input.is_null() or length<4 or length>18:return -1
    count_value:i64=input[0]
    modulus:i64=input[1]
    if count_value<1 or count_value>8 or length!=(2+2*count_value).usize() or modulus<11 or modulus>97 or not is_prime(modulus):return -1

    result:mutable i64=0
    case_index:mutable usize=0
    count:usize=count_value.usize()
    while case_index<count:
        n:i64=input[2+2*case_index]
        k_value:i64=input[3+2*case_index]
        if n<0 or n>MAX_N or k_value<0 or k_value>8 or k_value>n:return -1
        k:usize=k_value.usize()
        value:i64=stirling_value(n,k,modulus)
        next:i64=(case_index+1).i64()
        result<-(result+next*next*value)%modulus
        case_index<-case_index+1
    result
