@intrinsic("llvm.cttz.i64")
extern srm_trailing_zeros(value: u64, zero_undefined: bool) -> u64

def srm_root(parent: mutable usize[36]&, start: usize) -> usize:
    x: mutable usize = start
    while parent[x] != x:
        parent[x] <- parent[parent[x]]
        x <- parent[x]
    x

def statistical_region_merging_table_impl(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 4 or length > 74: return -1
    if input[0] < 1 or input[0] > 6 or input[1] < 1 or input[1] > 6: return -1
    width: usize = input[1].usize()
    n: usize = input[0].usize() * width
    if length != 2 + 2*n: return -1
    for i in 0..<n:
        if input[2+i] < 0 or input[2+i] > 65535 or input[2+n+i] < 0 or input[2+n+i] > 255: return -1
    if output == null or capacity < n: return -2
    if n == 1:
        output[0] <- 0
        return 1
    parent: mutable usize[36] = zeroed
    sizes: mutable usize[36] = zeroed
    minimum: mutable usize[36] = zeroed
    sums: mutable u64[36] = zeroed
    for i in 0..<n:
        parent[i] <- i
        sizes[i] <- 1
        minimum[i] <- i
        sums[i] <- input[2+n+i].u64()
    occupied: mutable u64[4] = zeroed
    heads: mutable usize[256] = zeroed
    edges: mutable usize[64] = zeroed
    links: mutable usize[64] = zeroed
    edge_count: mutable usize = 0
    # Prepend edges in reverse order to retain row-major, right-before-down ties.
    for reverse in 0..<n:
        p: usize = n - 1 - reverse
        for direction in 0..<2:
            q: usize = p + width if direction == 0 else p + 1
            if direction == 0 and q >= n: continue
            if direction == 1 and p % width + 1 == width: continue
            distance: mutable i64 = input[2+n+p] - input[2+n+q]
            if distance < 0: distance <- -distance
            bucket: usize = distance.usize() & 255
            edge_count <- edge_count + 1
            edge: usize = edge_count & 63
            edges[edge] <- (p << 6) | q
            links[edge] <- heads[bucket]
            heads[bucket] <- edge
            word: usize = bucket >> 6
            occupied[word] <- occupied[word] | (1.u64() << (bucket & 63))
    for word in 0..<4:
        pending: mutable u64 = occupied[word]
        while pending != 0:
            difference: usize = 64*word + srm_trailing_zeros(pending, true).usize()
            pending <- pending & (pending - 1)
            edge: mutable usize = heads[difference]
            while edge != 0:
                pair: usize = edges[edge & 63]
                edge <- links[edge & 63]
                p: usize = pair >> 6
                q: usize = pair & 63
                a: mutable usize = srm_root(&parent, p)
                b: mutable usize = srm_root(&parent, q)
                if a == b: continue
                na: u64 = sizes[a].u64()
                nb: u64 = sizes[b].u64()
                delta: u64 = sums[a]*nb - sums[b]*na
                bound: u64 = input[1+sizes[a]].u64() + input[1+sizes[b]].u64()
                # The square fits in u64, even when the subtraction wraps.
                if delta*delta > bound*na*na*nb*nb: continue
                if sizes[a] < sizes[b]:
                    t: usize = a
                    a <- b
                    b <- t
                parent[b] <- a
                sizes[a] <- sizes[a] + sizes[b]
                sums[a] <- sums[a] + sums[b]
                if minimum[b] < minimum[a]: minimum[a] <- minimum[b]
    for i in 0..<n:
        output[i] <- minimum[srm_root(&parent, i)].u8()
    n.i64()

export fn statistical_region_merging_table(input: i64&?, length: usize,
        output: mutable u8&?, capacity: usize) -> i64 = statistical_region_merging_table_impl
