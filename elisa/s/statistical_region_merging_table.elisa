# Statistical region merging on a small grid: visit 4-neighbor pairs in order
# of increasing intensity difference and merge regions whose mean difference
# passes the tabulated bound.
def srm_root(parent: mutable view[usize], start: usize) -> usize:
    x: mutable usize = start
    while parent[x] != x:
        parent[x] <- parent[parent[x]]
        x <- parent[x]
    x

def statistical_region_merging_table_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 4 or length > 74 or input[0] < 1 or input[0] > 6 or input[1] < 1 or input[1] > 6:
        return -1
    width: usize = input[1].usize()
    n: usize = input[0].usize() * width
    if length != 2 + 2 * n:
        return -1
    i: mutable usize = 0
    while i < n:
        if input[2 + i] < 0 or input[2 + i] > 65535 or input[2 + n + i] < 0 or input[2 + n + i] > 255:
            return -1
        i <- i + 1
    parent: mutable usize[36] = zeroed
    sizes: mutable usize[36] = zeroed
    minimum: mutable usize[36] = zeroed
    sums: mutable i64[36] = zeroed
    i <- 0
    while i < n:
        parent[i] <- i
        minimum[i] <- i
        sizes[i] <- 1
        sums[i] <- input[2 + n + i]
        i <- i + 1
    difference: mutable i64 = 0
    while difference < 256:
        p: mutable usize = 0
        while p < n:
            neighbors: mutable usize[2] = zeroed
            count: mutable usize = 0
            if p % width + 1 < width:
                neighbors[count] <- p + 1
                count <- count + 1
            if p + width < n:
                neighbors[count] <- p + width
                count <- count + 1
            k: mutable usize = 0
            while k < count:
                q: usize = neighbors[k]
                d: mutable i64 = input[2 + n + p] - input[2 + n + q]
                if d < 0:
                    d <- -d
                if d == difference:
                    a: mutable usize = srm_root(parent[0:36], p)
                    b: mutable usize = srm_root(parent[0:36], q)
                    if a != b:
                        na: i64 = sizes[a].i64()
                        nb: i64 = sizes[b].i64()
                        delta: i64 = sums[a] * nb - sums[b] * na
                        bound: i64 = input[2 + sizes[a] - 1] + input[2 + sizes[b] - 1]
                        if delta * delta <= bound * na * na * nb * nb:
                            if sizes[a] < sizes[b]:
                                swap: usize = a
                                a <- b
                                b <- swap
                            parent[b] <- a
                            sizes[a] <- sizes[a] + sizes[b]
                            sums[a] <- sums[a] + sums[b]
                            if minimum[b] < minimum[a]:
                                minimum[a] <- minimum[b]
                k <- k + 1
            p <- p + 1
        difference <- difference + 1
    if output == null or capacity < n:
        return -2
    i <- 0
    while i < n:
        output[i] <- minimum[srm_root(parent[0:36], i)].u8()
        i <- i + 1
    n.i64()

export fn statistical_region_merging_table(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = statistical_region_merging_table_impl
