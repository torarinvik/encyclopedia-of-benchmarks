def srm_root(parent: mutable view[usize], start: usize) -> usize:
    x: mutable usize = start
    while parent[x] != x:
        parent[x] <- parent[parent[x]]
        x <- parent[x]
    x

def statistical_region_merging_table_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > 74: return -1
    values: view[i64] = input[0:length]
    if values[0] < 1 or values[0] > 6 or values[1] < 1 or values[1] > 6: return -1
    width: usize = values[1].usize()
    n: usize = values[0].usize() * width
    if length != 2 + 2*n: return -1
    for i in 0..<n:
        if values[2+i] < 0 or values[2+i] > 65535 or values[2+n+i] < 0 or values[2+n+i] > 255: return -1
    parent: mutable usize[36] = zeroed
    sizes: mutable usize[36] = zeroed
    minimum: mutable usize[36] = zeroed
    sums: mutable i64[36] = zeroed
    parents: mutable view[usize] = parent[0:36]
    for i in 0..<n:
        parent[i] <- i
        sizes[i] <- 1
        minimum[i] <- i
        sums[i] <- values[2+n+i]
    for difference in 0..<256:
        for p in 0..<n:
            neighbors: mutable usize[2] = zeroed
            count: mutable usize = 0
            if p % width + 1 < width:
                neighbors[count] <- p+1
                count <- count+1
            if p + width < n:
                neighbors[count] <- p+width
                count <- count+1
            for k in 0..<count:
                q: usize = neighbors[k]
                d: mutable i64 = values[2+n+p] - values[2+n+q]
                if d < 0: d <- -d
                if d != difference.i64(): continue
                a: mutable usize = srm_root(parents, p)
                b: mutable usize = srm_root(parents, q)
                if a == b: continue
                na: i64 = sizes[a].i64()
                nb: i64 = sizes[b].i64()
                delta: i64 = sums[a]*nb - sums[b]*na
                bound: i64 = values[1+sizes[a]] + values[1+sizes[b]]
                if delta*delta > bound*na*na*nb*nb: continue
                if sizes[a] < sizes[b]:
                    t: usize = a
                    a <- b
                    b <- t
                parent[b] <- a
                sizes[a] <- sizes[a] + sizes[b]
                sums[a] <- sums[a] + sums[b]
                if minimum[b] < minimum[a]: minimum[a] <- minimum[b]
    if output.is_null() or capacity < n: return -2
    out: mutable view[u8] = output[0:n]
    for i in 0..<n: out[i] <- minimum[srm_root(parents, i)].u8()
    n.i64()

export fn statistical_region_merging_table(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = statistical_region_merging_table_impl
