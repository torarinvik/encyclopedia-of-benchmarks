const MAX_TEXT_LENGTH: usize = 128
const CHECKSUM_BASE: i64 = 1100000

def substring_end_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 1 or length > MAX_TEXT_LENGTH + 1: return -1
    text_length: usize = length - 1
    start: i64 = values[0]
    if start < 0 or start > i64(text_length): return -1
    for i in 0..text_length:
        if values[i + 1] < 1 or values[i + 1] > 127: return -1
    count: usize = text_length - usize(start)
    checksum: mutable i64 = 0
    for i in 0..count: checksum <- checksum + i64(i + 1) * values[usize(start) + i + 1]
    i64(count) * CHECKSUM_BASE + checksum

export fn substring_end(values: i64&, length: usize) -> i64 = substring_end_impl
