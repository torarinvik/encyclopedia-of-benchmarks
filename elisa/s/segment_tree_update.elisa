const MAX_N: usize = 64
const MAX_OPERATIONS: usize = 64
const MAX_INPUT_LENGTH: usize = 259
const MAX_TREE_LENGTH: usize = 128
const VALUE_MIN: i64 = -1000000
const VALUE_MAX: i64 = 1000000
const FNV_OFFSET: u64 = 14695981039346656037.u64()
const FNV_PRIME: u64 = 1099511628211.u64()

def segment_tree_update_query_sum(tree: i32&, node: usize, segment_left: usize, segment_right: usize,
                                  query_left: usize, query_right: usize) -> i32:
    if query_left <= segment_left and segment_right <= query_right:
        return tree[node]
    if query_right < segment_left or segment_right < query_left:
        return 0
    middle: usize = segment_left + (segment_right - segment_left) / 2
    left_sum: i32 = segment_tree_update_query_sum(tree, node * 2, segment_left, middle, query_left, query_right)
    right_sum: i32 = segment_tree_update_query_sum(tree, node * 2 + 1, middle + 1, segment_right, query_left, query_right)
    left_sum + right_sum

def segment_tree_update_hash_word(hash_value: u64, word: i64) -> u64:
    bits: mutable u64 = word.u64()
    hash: mutable u64 = hash_value
    byte: mutable usize = 0
    while byte < 8:
        hash <- (hash ^ (bits & 255.u64())) * FNV_PRIME
        bits <- bits >> 8
        byte <- byte + 1
    hash

def segment_tree_update_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_INPUT_LENGTH:
        return -1
    n_arg: i64 = input[0]
    if n_arg < 1 or n_arg > MAX_N.i64():
        return -1
    n: usize = n_arg.usize()
    if length < n + 2:
        return -1
    operation_count_arg: i64 = input[n + 1]
    if operation_count_arg < 1 or operation_count_arg > MAX_OPERATIONS.i64():
        return -1
    operation_count: usize = operation_count_arg.usize()
    if length != n + 2 + 3 * operation_count:
        return -1

    initial_values: mutable i32[MAX_N] = zeroed
    index: mutable usize = 0
    while index < n:
        value: i64 = input[index + 1]
        if value < VALUE_MIN or value > VALUE_MAX:
            return -1
        initial_values[index] <- value.i32()
        index <- index + 1

    operations_start: usize = n + 2
    query_count: mutable usize = 0
    operation: mutable usize = 0
    while operation < operation_count:
        offset: usize = operations_start + 3 * operation
        kind: i64 = input[offset]
        first: i64 = input[offset + 1]
        second: i64 = input[offset + 2]
        if kind == 0:
            if first < 0 or first > second or second >= n_arg:
                return -1
            query_count <- query_count + 1
        elif kind == 1:
            if first < 0 or first >= n_arg or second < VALUE_MIN or second > VALUE_MAX:
                return -1
        else:
            return -1
        operation <- operation + 1
    if query_count == 0:
        return -1

    power: mutable usize = 1
    while power < n:
        power <- power * 2
    tree: mutable i32[MAX_TREE_LENGTH] = zeroed
    index <- 0
    while index < n:
        tree[power + index] <- initial_values[index]
        index <- index + 1
    node: mutable usize = power - 1
    while node > 0:
        tree[node] <- tree[node * 2] + tree[node * 2 + 1]
        node <- node - 1

    hash: mutable u64 = segment_tree_update_hash_word(FNV_OFFSET, query_count.i64())
    operation <- 0
    while operation < operation_count:
        offset: usize = operations_start + 3 * operation
        kind: i64 = input[offset]
        first: i64 = input[offset + 1]
        second: i64 = input[offset + 2]
        if kind == 0:
            sum: i32 = segment_tree_update_query_sum(
                &tree[0], 1, 1, power, first.usize() + 1, second.usize() + 1)
            hash <- segment_tree_update_hash_word(hash, sum.i64())
        else:
            leaf: mutable usize = power + first.usize()
            tree[leaf] <- second.i32()
            while leaf > 1:
                leaf <- leaf / 2
                tree[leaf] <- tree[leaf * 2] + tree[leaf * 2 + 1]
        operation <- operation + 1
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn segment_tree_update_benchmark(input: i64&, length: usize) -> i64 =
    segment_tree_update_impl(input, length)
