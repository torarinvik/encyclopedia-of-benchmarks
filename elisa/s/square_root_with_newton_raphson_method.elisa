# Newton-Raphson square root under the pinned integer input contract.
@link_name("llvm.fabs.f64")
extern absolute(value: f64) -> f64

@link_name("llvm.fptosi.sat.i32.f64")
extern saturate_to_integer(value: f64) -> i32

@inline(never)
def refine(input: f64) -> f64:
    guess: mutable f64 = input
    root: mutable f64 = 0.5 * (guess + input / guess)
    while absolute(root - guess) > 1e-7:
        guess <- root
        root <- 0.5 * (guess + input / guess)
    root

def square_root_with_newton_raphson_method_impl(input: f64) -> f64:
    # Only positive i32 values that round-trip exactly satisfy the input contract.
    integer: i32 = saturate_to_integer(input)
    if not (integer > 0 and integer.f64() == input):
        return -1.0e300
    refine(input)

export fn square_root_with_newton_raphson_method(input: f64) -> f64 = square_root_with_newton_raphson_method_impl
