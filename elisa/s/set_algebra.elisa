const MAX_SET_SIZE: usize = 64
const MAX_RESULT_SIZE: usize = 2 * MAX_SET_SIZE
const MAX_INPUT_LENGTH: usize = 4 + 2 * MAX_SET_SIZE

def set_algebra_contains(values: i64&, count: usize, target: i64) -> bool:
    index: mutable usize = 0
    while index < count:
        if values[index] == target: return true
        index <- index + 1
    false

def set_algebra_subset(left: i64&, left_count: usize, right: i64&, right_count: usize) -> bool:
    if left_count > right_count: return false
    index: mutable usize = 0
    while index < left_count:
        if not set_algebra_contains(right, right_count, left[index]): return false
        index <- index + 1
    true

def set_algebra_put_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def set_algebra_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 4 or length > MAX_INPUT_LENGTH: return -1
    operation: i64 = input[0]
    left_raw: i64 = input[1]
    right_raw: i64 = input[2]
    query_key: i64 = input[3]
    if operation < 0 or operation > 8 or left_raw < 0 or left_raw > MAX_SET_SIZE.i64() or right_raw < 0 or right_raw > MAX_SET_SIZE.i64() or query_key < -1000000 or query_key > 1000000: return -1
    left_length: usize = left_raw.usize()
    right_length: usize = right_raw.usize()
    if length != 4 + left_length + right_length: return -1

    left: mutable i64[MAX_SET_SIZE] = zeroed
    right: mutable i64[MAX_SET_SIZE] = zeroed
    result: mutable i64[MAX_RESULT_SIZE] = zeroed
    left_count: mutable usize = 0
    right_count: mutable usize = 0
    result_count: mutable usize = 0
    index: mutable usize = 0
    while index < left_length:
        value: i64 = input[4 + index]
        if value < -1000000 or value > 1000000: return -1
        if not set_algebra_contains(&left[0], left_count, value):
            left[left_count] <- value
            left_count <- left_count + 1
        index <- index + 1
    index <- 0
    while index < right_length:
        value: i64 = input[4 + left_length + index]
        if value < -1000000 or value > 1000000: return -1
        if not set_algebra_contains(&right[0], right_count, value):
            right[right_count] <- value
            right_count <- right_count + 1
        index <- index + 1

    answer: mutable bool = false
    if operation == 0: answer <- set_algebra_contains(&left[0], left_count, query_key)
    else if operation == 1: answer <- set_algebra_subset(&left[0], left_count, &right[0], right_count)
    else if operation == 2: answer <- left_count < right_count and set_algebra_subset(&left[0], left_count, &right[0], right_count)
    else if operation == 3: answer <- set_algebra_subset(&right[0], right_count, &left[0], left_count)
    else if operation == 4: answer <- right_count < left_count and set_algebra_subset(&right[0], right_count, &left[0], left_count)
    if operation < 5:
        result[0] <- if answer: 1 else: 0
        result_count <- 1
    else if operation == 5:
        index <- 0
        while index < left_count: result[result_count] <- left[index]; result_count <- result_count + 1; index <- index + 1
        index <- 0
        while index < right_count:
            if not set_algebra_contains(&left[0], left_count, right[index]): result[result_count] <- right[index]; result_count <- result_count + 1
            index <- index + 1
    else if operation == 6:
        index <- 0
        while index < left_count:
            if set_algebra_contains(&right[0], right_count, left[index]): result[result_count] <- left[index]; result_count <- result_count + 1
            index <- index + 1
    else if operation == 7:
        index <- 0
        while index < left_count:
            if not set_algebra_contains(&right[0], right_count, left[index]): result[result_count] <- left[index]; result_count <- result_count + 1
            index <- index + 1
    else:
        index <- 0
        while index < left_count:
            if not set_algebra_contains(&right[0], right_count, left[index]): result[result_count] <- left[index]; result_count <- result_count + 1
            index <- index + 1
        index <- 0
        while index < right_count:
            if not set_algebra_contains(&left[0], left_count, right[index]): result[result_count] <- right[index]; result_count <- result_count + 1
            index <- index + 1
    index <- 1
    while index < result_count:
        value: i64 = result[index]
        cursor: mutable usize = index
        while cursor > 0 and result[cursor - 1] > value: result[cursor] <- result[cursor - 1]; cursor <- cursor - 1
        result[cursor] <- value
        index <- index + 1

    output_bytes: usize = result_count * 8
    if capacity < output_bytes or (output_bytes > 0 and output.is_null()): return -2
    index <- 0
    while index < result_count:
        set_algebra_put_i64_le(output, index * 8, result[index])
        index <- index + 1
    output_bytes.i64()

export fn set_algebra(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = set_algebra_impl
