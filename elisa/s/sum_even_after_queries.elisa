const MAX_NUMBERS: usize = 1000
const MAX_QUERIES: usize = 1000

# Keep the signed values as their 32-bit representations. The total magnitude
# cannot exceed the initial sum plus the total magnitude of all deltas.
def even_contribution(value: u32) -> u32:
    value & ((value & 1) - 1)

def apply_even_queries(values: i64&, number_count: usize, query_count: usize,
        output: mutable u8&, output_capacity: usize, working: mutable u32&) -> i64:
    even_sum: mutable u32 = 0
    index: mutable usize = 0
    while index < number_count:
        raw: u64 = values[2 + index].u64()
        return -1 if raw == 0 or raw > 1000
        value: u32 = raw.u32()
        working[index] <- value
        even_sum <- even_sum + even_contribution(value)
        index <- index + 1
    query: mutable usize = 0
    while query < query_count:
        offset: usize = 2 + number_count + 2 * query
        delta: u64 = values[offset].u64()
        slot: u64 = values[offset + 1].u64()
        return -1 if delta + 1000 > 2000 or slot >= number_count.u64()
        query <- query + 1
    output_bytes: usize = query_count * 4
    if output_capacity < output_bytes:
        return -2

    query <- 0
    while query < query_count:
        offset: usize = 2 + number_count + 2 * query
        delta: u32 = values[offset].u32()
        index <- values[offset + 1].usize()
        old: u32 = working[index]
        updated: u32 = old + delta
        working[index] <- updated
        even_sum <- even_sum + (even_contribution(updated) - even_contribution(old))
        output[query * 4] <- (even_sum & 255).u8()
        output[query * 4 + 1] <- ((even_sum >> 8) & 255).u8()
        output[query * 4 + 2] <- ((even_sum >> 16) & 255).u8()
        output[query * 4 + 3] <- ((even_sum >> 24) & 255).u8()
        query <- query + 1
    query_count.i64()

# Apply each point update, then emit the running even sum as little-endian i32s.
def sum_even_after_queries_impl(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length < 5 or length > 4002:
        return -1
    if values[0] < 1 or values[0] > MAX_NUMBERS.i64() or values[1] < 1 or values[1] > MAX_QUERIES.i64():
        return -1
    number_count: usize = values[0].usize()
    query_count: usize = values[1].usize()
    if length != 2 + number_count + 2 * query_count:
        return -1

    if number_count <= 16:
        small: mutable u32[16] = zeroed
        return apply_even_queries(values, number_count, query_count, output, output_capacity, &small[0])
    working: mutable u32[1000] = zeroed
    apply_even_queries(values, number_count, query_count, output, output_capacity, &working[0])

export fn sum_even_after_queries(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = sum_even_after_queries_impl
