extern exp(value: f64) -> f64

def sigmoid_without_inbuilt_impl(x: f64, slope: f64) -> f64:
    if x != x or slope != slope or x < -10.0 or x > 10.0 or slope < -10.0 or slope > 10.0:
        return -1.0e300
    1.0 / (1.0 + exp(-slope * x))

export fn sigmoid_without_inbuilt(x: f64, slope: f64) -> f64 = sigmoid_without_inbuilt_impl

