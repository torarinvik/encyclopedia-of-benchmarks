const MAX_STEPS: usize = 4
const MAX_PARSEABLE_INPUT_LENGTH: usize = 6
const MAX_WORD: usize = 41

def sturmian_standard_word_impl(input: view[i64], output: mutable u8&,
                                capacity: usize) -> i64:
    if input.len() < 1 or input.len() > MAX_PARSEABLE_INPUT_LENGTH: return -1
    let steps_word: i64 = input[0]
    if steps_word < 0 or steps_word > MAX_STEPS.i64(): return -1
    let steps: usize = steps_word.usize()
    if input.len() != steps + 1: return -1

    let directives: mutable i64[MAX_STEPS] = zeroed
    let mut i: usize = 0
    while i < steps:
        let repeat: i64 = input[i + 1]
        if i == 0:
            if repeat < 0 or repeat > 2: return -1
        else:
            if repeat < 1 or repeat > 2: return -1
        directives[i] <- repeat
        i <- i + 1
    }

    let previous: mutable u8[MAX_WORD] = zeroed
    let current: mutable u8[MAX_WORD] = zeroed
    let following: mutable u8[MAX_WORD] = zeroed
    previous[0] <- 98.u8()
    current[0] <- 97.u8()
    let previous_length: mutable usize = 1
    let current_length: mutable usize = 1

    let step: mutable usize = 0
    while step < steps:
        let repeat: usize = directives[step].usize()
        let following_length: usize = current_length * repeat + previous_length
        let position: mutable usize = 0
        let copy: mutable usize = 0
        while copy < repeat:
            i <- 0
            while i < current_length:
                following[position] <- current[i]
                position <- position + 1
                i <- i + 1
            copy <- copy + 1
        i <- 0
        while i < previous_length:
            following[position] <- previous[i]
            position <- position + 1
            i <- i + 1
        i <- 0
        while i < current_length:
            previous[i] <- current[i]
            i <- i + 1
        i <- 0
        while i < following_length:
            current[i] <- following[i]
            i <- i + 1
        previous_length <- current_length
        current_length <- following_length
        step <- step + 1
    if output == null or capacity < current_length: return -2
    let result: mutable view[u8] = output[0:current_length]
    i <- 0
    while i < current_length:
        result[i] <- current[i]
        i <- i + 1
    current_length.i64()

export fn sturmian_standard_word(input: i64&, input_length: usize,
                                output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    sturmian_standard_word_impl(input[0:input_length], output, output_capacity)
