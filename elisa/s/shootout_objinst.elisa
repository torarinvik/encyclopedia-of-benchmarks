const MIN_N: i64 = -100000
const MAX_N: i64 = 100000
const OUTPUT_BYTES: usize = 72

struct Toggle:
    state: mutable bool
    activate: mutable fn(mutable Toggle&) -> void
    value: mutable fn(Toggle&) -> bool

struct NthToggle:
    state: mutable bool
    count_max: mutable i32
    counter: mutable i32
    activate: mutable fn(mutable NthToggle&) -> void
    value: mutable fn(NthToggle&) -> bool

extern benchmark_allocate_toggle(size: usize) -> mutable Toggle&?
extern benchmark_release_toggle(object: mutable Toggle&) -> void
extern benchmark_observe_toggle(object: Toggle&) -> void
extern benchmark_allocate_nth_toggle(size: usize) -> mutable NthToggle&?
extern benchmark_release_nth_toggle(object: mutable NthToggle&) -> void
extern benchmark_observe_nth_toggle(object: NthToggle&) -> void

def toggle_activate(toggle: mutable Toggle&) -> void:
    toggle.state <- not toggle.state

def toggle_value(toggle: Toggle&) -> bool:
    toggle.state

def nth_toggle_activate(toggle: mutable NthToggle&) -> void:
    toggle.counter <- toggle.counter + 1
    if toggle.counter >= toggle.count_max:
        toggle.state <- not toggle.state
        toggle.counter <- 0

def nth_toggle_value(toggle: NthToggle&) -> bool:
    toggle.state

def append_state(staged: mutable view[u8], used: mutable usize&, state: bool) -> void:
    if state:
        staged[used] <- 116u8
        used <- used + 1
        staged[used] <- 114u8
        used <- used + 1
        staged[used] <- 117u8
        used <- used + 1
        staged[used] <- 101u8
        used <- used + 1
    else:
        staged[used] <- 102u8
        used <- used + 1
        staged[used] <- 97u8
        used <- used + 1
        staged[used] <- 108u8
        used <- used + 1
        staged[used] <- 115u8
        used <- used + 1
        staged[used] <- 101u8
        used <- used + 1
    staged[used] <- 10u8
    used <- used + 1

def shootout_objinst_impl(n: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if n < MIN_N or n > MAX_N: return -1
    if output == null or output_capacity < OUTPUT_BYTES: return -2

    staged: mutable u8[OUTPUT_BYTES] = zeroed
    used: mutable usize = 0
    toggle: mutable Toggle& = get benchmark_allocate_toggle(size_of(Toggle)) else return -1
    toggle.state <- true
    toggle.activate <- toggle_activate
    toggle.value <- toggle_value
    for _ in 0..<5:
        toggle_activate_fn: fn(mutable Toggle&) -> void = toggle.activate
        toggle_activate_fn(toggle)
        toggle_value_fn: fn(Toggle&) -> bool = toggle.value
        append_state(staged[0:OUTPUT_BYTES], used, toggle_value_fn(toggle))
    benchmark_release_toggle(toggle)

    iterations: mutable usize = 0
    if n > 0: iterations <- n.usize()
    for _ in 0..<iterations:
        extra: mutable Toggle& = get benchmark_allocate_toggle(size_of(Toggle)) else return -1
        extra.state <- true
        extra.activate <- toggle_activate
        extra.value <- toggle_value
        benchmark_observe_toggle(extra)
        benchmark_release_toggle(extra)

    staged[used] <- 10u8
    used <- used + 1
    nth_toggle: mutable NthToggle& = get benchmark_allocate_nth_toggle(size_of(NthToggle)) else return -1
    nth_toggle.state <- true
    nth_toggle.count_max <- 3
    nth_toggle.counter <- 0
    nth_toggle.activate <- nth_toggle_activate
    nth_toggle.value <- nth_toggle_value
    for _ in 0..<8:
        nth_toggle_activate_fn: fn(mutable NthToggle&) -> void = nth_toggle.activate
        nth_toggle_activate_fn(nth_toggle)
        nth_toggle_value_fn: fn(NthToggle&) -> bool = nth_toggle.value
        append_state(staged[0:OUTPUT_BYTES], used, nth_toggle_value_fn(nth_toggle))
    benchmark_release_nth_toggle(nth_toggle)

    for _ in 0..<iterations:
        extra: mutable NthToggle& = get benchmark_allocate_nth_toggle(size_of(NthToggle)) else return -1
        extra.state <- true
        extra.count_max <- 3
        extra.counter <- 0
        extra.activate <- nth_toggle_activate
        extra.value <- nth_toggle_value
        benchmark_observe_nth_toggle(extra)
        benchmark_release_nth_toggle(extra)

    if used != OUTPUT_BYTES: return -1
    for index in 0..<used:
        output[index] <- staged[index]
    used.i64()

export fn shootout_objinst(n: i64, output: mutable u8&, output_capacity: usize) -> i64 = shootout_objinst_impl
