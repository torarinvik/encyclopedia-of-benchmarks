# Shell sort using the pinned Python 1.3 gap shrink factor.
def shrink_shell_sort_impl(values: mutable i64&, length: usize) -> void:
    gap: mutable usize = length
    while gap > 1:
        gap <- (gap.f64() / 1.3).usize()
        index: mutable usize = gap
        while index < length:
            key: i64 = values[index]
            position: mutable usize = index
            while position >= gap and values[position - gap] > key:
                values[position] <- values[position - gap]
                position <- position - gap
            values[position] <- key
            index <- index + 1

export fn shrink_shell_sort(values: mutable i64&, length: usize) -> void = shrink_shell_sort_impl
