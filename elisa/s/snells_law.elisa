extern sin(value: f64) -> f64
extern asin(value: f64) -> f64
extern fabs(value: f64) -> f64
extern floor(value: f64) -> f64

const PI: f64 = 3.141592653589793238462643383279502884

def snells_law_round_two_even(value: f64) -> f64:
    scaled: f64 = value * 100.0
    lower: f64 = floor(scaled)
    fraction: f64 = scaled - lower
    rounded: i64 = lower.i64()
    if fraction > 0.5 or (fraction == 0.5 and rounded % 2 != 0):
        rounded <- rounded + 1
    rounded.f64() / 100.0

def snells_law_impl(n1: f64, n2: f64, incident_angle_degrees: f64) -> f64:
    if n1 != n1 or n2 != n2 or incident_angle_degrees != incident_angle_degrees or
        n1 < 0.5 or n1 > 2.5 or n2 < 0.5 or n2 > 2.5 or incident_angle_degrees < -90.0 or incident_angle_degrees > 90.0:
        return -1.0e300
    incident_angle_radians: f64 = incident_angle_degrees * (PI / 180.0)
    refraction_sine: f64 = (n1 / n2) * sin(incident_angle_radians)
    scale: f64 = fabs(refraction_sine)
    if scale < 1.0:
        scale <- 1.0
    if fabs(refraction_sine - 1.0) <= 1.0e-9 * scale:
        return 90.0
    if fabs(refraction_sine + 1.0) <= 1.0e-9 * scale:
        return -90.0
    if refraction_sine < -1.0 or refraction_sine > 1.0:
        return -1.0e300
    refraction_angle_degrees: f64 = asin(refraction_sine) * (180.0 / PI)
    snells_law_round_two_even(refraction_angle_degrees)

export fn snells_law(n1: f64, n2: f64, incident_angle_degrees: f64) -> f64 = snells_law_impl
