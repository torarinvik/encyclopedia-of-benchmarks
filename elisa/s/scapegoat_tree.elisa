const SCAPEGOAT_MAX_OPERATIONS: usize = 64
const SCAPEGOAT_MAX_LIVE_KEYS: usize = 32
const SCAPEGOAT_MAX_INPUT_LENGTH: usize = 1 + 2 * SCAPEGOAT_MAX_OPERATIONS
const SCAPEGOAT_MAX_PARSEABLE_INPUT_LENGTH: usize = SCAPEGOAT_MAX_INPUT_LENGTH + 1
const SCAPEGOAT_MAX_OUTPUT_BYTES: usize = 8 * (2 + SCAPEGOAT_MAX_OPERATIONS + SCAPEGOAT_MAX_LIVE_KEYS)

struct ScapegoatNode:
    key: i64
    left: i64
    right: i64
    active: bool

def scapegoat_subtree_size(nodes: view[ScapegoatNode], root: i64) -> usize:
    if root < 0: return 0
    return 1 + scapegoat_subtree_size(nodes, nodes[root.usize()].left) + scapegoat_subtree_size(nodes, nodes[root.usize()].right)

def scapegoat_alpha_height(nodes: view[ScapegoatNode], root: i64) -> usize:
    size: mutable usize = scapegoat_subtree_size(nodes, root)
    height: mutable usize = 0
    while size > 1:
        size <- size >> 1
        height <- height + 1
    return height

def scapegoat_flatten(nodes: view[ScapegoatNode], root: i64, order: mutable view[i64], length: mutable usize&) -> void:
    if root < 0: return
    scapegoat_flatten(nodes, nodes[root.usize()].left, order, length)
    order[length] <- root
    length <- length + 1
    scapegoat_flatten(nodes, nodes[root.usize()].right, order, length)

def scapegoat_rebuild(nodes: mutable view[ScapegoatNode], order: view[i64], start: usize, end: usize) -> i64:
    if start >= end: return -1
    pivot: usize = (start + end) / 2
    root: i64 = order[pivot]
    nodes[root.usize()].left <- scapegoat_rebuild(nodes, order, start, pivot)
    nodes[root.usize()].right <- scapegoat_rebuild(nodes, order, pivot + 1, end)
    return root

def scapegoat_find(nodes: view[ScapegoatNode], root_value: i64, key: i64) -> bool:
    root: mutable i64 = root_value
    while root >= 0:
        if nodes[root.usize()].key == key: return true
        if key < nodes[root.usize()].key: root <- nodes[root.usize()].left
        else: root <- nodes[root.usize()].right
    return false

def scapegoat_allocate(nodes: mutable view[ScapegoatNode], key: i64) -> i64:
    index: mutable usize = 0
    while index < SCAPEGOAT_MAX_LIVE_KEYS:
        if not nodes[index].active:
            nodes[index].key <- key
            nodes[index].left <- -1
            nodes[index].right <- -1
            nodes[index].active <- true
            return index.i64()
        index <- index + 1
    return -1

def scapegoat_insert(nodes: mutable view[ScapegoatNode], root: mutable i64&, size: mutable usize&,
                     max_size: mutable usize&, key: i64) -> bool:
    if root < 0:
        root <- scapegoat_allocate(nodes, key)
        if root < 0: return false
        size <- size + 1
        if size > max_size: max_size <- size
        return true
    path: mutable i64[SCAPEGOAT_MAX_LIVE_KEYS] = zeroed
    path_length: mutable usize = 0
    current: mutable i64 = root
    while true:
        path[path_length] <- current
        path_length <- path_length + 1
        if nodes[current.usize()].key == key: return false
        if key < nodes[current.usize()].key:
            if nodes[current.usize()].left < 0:
                nodes[current.usize()].left <- scapegoat_allocate(nodes, key)
                break
            current <- nodes[current.usize()].left
        else:
            if nodes[current.usize()].right < 0:
                nodes[current.usize()].right <- scapegoat_allocate(nodes, key)
                break
            current <- nodes[current.usize()].right
    size <- size + 1
    if size > max_size: max_size <- size
    if path_length > scapegoat_alpha_height(nodes, root):
        depth: mutable usize = 1
        scapegoat: mutable i64 = -1
        parent: mutable i64 = -1
        while path_length > 0:
            path_length <- path_length - 1
            candidate: i64 = path[path_length]
            if depth > scapegoat_alpha_height(nodes, candidate):
                scapegoat <- candidate
                if path_length > 0:
                    path_length <- path_length - 1
                    parent <- path[path_length]
                break
            depth <- depth + 1
        order: mutable i64[SCAPEGOAT_MAX_LIVE_KEYS] = zeroed
        order_length: mutable usize = 0
        scapegoat_flatten(nodes, scapegoat, order[0:SCAPEGOAT_MAX_LIVE_KEYS], order_length&)
        rebuilt: i64 = scapegoat_rebuild(nodes, order[0:SCAPEGOAT_MAX_LIVE_KEYS], 0, order_length)
        if parent < 0: root <- rebuilt
        elif nodes[parent.usize()].key < nodes[rebuilt.usize()].key:
            nodes[parent.usize()].right <- rebuilt
        else: nodes[parent.usize()].left <- rebuilt
    return true

def scapegoat_remove(nodes: mutable view[ScapegoatNode], root: mutable i64&, size: mutable usize&,
                     max_size: mutable usize&, key: i64) -> bool:
    parent: mutable i64 = -1
    node: mutable i64 = root
    while node >= 0 and nodes[node.usize()].key != key:
        parent <- node
        if key < nodes[node.usize()].key: node <- nodes[node.usize()].left
        else: node <- nodes[node.usize()].right
    if node < 0: return false
    left: i64 = nodes[node.usize()].left
    right: i64 = nodes[node.usize()].right
    if left >= 0 and right >= 0:
        predecessor_parent: mutable i64 = node
        predecessor: mutable i64 = left
        while nodes[predecessor.usize()].right >= 0:
            predecessor_parent <- predecessor
            predecessor <- nodes[predecessor.usize()].right
        nodes[node.usize()].key <- nodes[predecessor.usize()].key
        replacement: i64 = nodes[predecessor.usize()].left
        if predecessor_parent == node: nodes[node.usize()].left <- replacement
        else: nodes[predecessor_parent.usize()].right <- replacement
        nodes[predecessor.usize()].active <- false
        nodes[predecessor.usize()].left <- -1
        nodes[predecessor.usize()].right <- -1
    else:
        replacement: i64 = if left >= 0: left else: right
        if parent < 0: root <- replacement
        elif nodes[parent.usize()].left == node: nodes[parent.usize()].left <- replacement
        else: nodes[parent.usize()].right <- replacement
        nodes[node.usize()].active <- false
        nodes[node.usize()].left <- -1
        nodes[node.usize()].right <- -1
    size <- size - 1
    if root >= 0 and 2 * size < max_size:
        order: mutable i64[SCAPEGOAT_MAX_LIVE_KEYS] = zeroed
        order_length: mutable usize = 0
        scapegoat_flatten(nodes, root, order[0:SCAPEGOAT_MAX_LIVE_KEYS], order_length&)
        root <- scapegoat_rebuild(nodes, order[0:SCAPEGOAT_MAX_LIVE_KEYS], 0, order_length)
        max_size <- size
    return true

def scapegoat_root_weight_balanced(nodes: view[ScapegoatNode], root: i64) -> bool:
    if root < 0: return true
    total: usize = scapegoat_subtree_size(nodes, root)
    left_size: usize = scapegoat_subtree_size(nodes, nodes[root.usize()].left)
    right_size: usize = scapegoat_subtree_size(nodes, nodes[root.usize()].right)
    return 2 * left_size <= total and 2 * right_size <= total

def scapegoat_write_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def scapegoat_tree_impl(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > SCAPEGOAT_MAX_PARSEABLE_INPUT_LENGTH: return -1
    if input[0] < 0 or input[0] > SCAPEGOAT_MAX_OPERATIONS.i64(): return -1
    operation_count: usize = input[0].usize()
    if input_length != 1 + 2 * operation_count: return -1

    active_keys: mutable i64[SCAPEGOAT_MAX_LIVE_KEYS] = zeroed
    active_count: mutable usize = 0
    operation: mutable usize = 0
    while operation < operation_count:
        offset: usize = 1 + 2 * operation
        opcode: i64 = input[offset]
        key: i64 = input[offset + 1]
        if key < -2147483648 or key > 2147483647 or opcode < 0 or opcode > 6: return -1
        if opcode >= 3 and key != 0: return -1
        if opcode == 0:
            present: mutable bool = false
            index: mutable usize = 0
            while index < active_count:
                if active_keys[index] == key: present <- true
                index <- index + 1
            if not present:
                if active_count == SCAPEGOAT_MAX_LIVE_KEYS: return -1
                active_keys[active_count] <- key
                active_count <- active_count + 1
        elif opcode == 2:
            index <- 0
            while index < active_count:
                if active_keys[index] == key:
                    movement: mutable usize = index
                    while movement + 1 < active_count:
                        active_keys[movement] <- active_keys[movement + 1]
                        movement <- movement + 1
                    active_count <- active_count - 1
                    break
                index <- index + 1
        elif opcode == 6: active_count <- 0
        operation <- operation + 1

    nodes: mutable ScapegoatNode[SCAPEGOAT_MAX_LIVE_KEYS] = zeroed
    index: mutable usize = 0
    while index < SCAPEGOAT_MAX_LIVE_KEYS:
        nodes[index].left <- -1
        nodes[index].right <- -1
        index <- index + 1
    root: mutable i64 = -1
    size: mutable usize = 0
    max_size: mutable usize = 0
    results: mutable i64[SCAPEGOAT_MAX_OPERATIONS] = zeroed
    operation <- 0
    while operation < operation_count:
        offset: usize = 1 + 2 * operation
        opcode: i64 = input[offset]
        key: i64 = input[offset + 1]
        if opcode == 0: results[operation] <- if scapegoat_insert(nodes[0:SCAPEGOAT_MAX_LIVE_KEYS], root&, size&, max_size&, key): 1 else: 0
        elif opcode == 1: results[operation] <- if scapegoat_find(nodes[0:SCAPEGOAT_MAX_LIVE_KEYS], root, key): 1 else: 0
        elif opcode == 2: results[operation] <- if scapegoat_remove(nodes[0:SCAPEGOAT_MAX_LIVE_KEYS], root&, size&, max_size&, key): 1 else: 0
        elif opcode == 3: results[operation] <- size.i64()
        elif opcode == 4: results[operation] <- max_size.i64()
        elif opcode == 5: results[operation] <- if scapegoat_root_weight_balanced(nodes[0:SCAPEGOAT_MAX_LIVE_KEYS], root): 1 else: 0
        else:
            index <- 0
            while index < SCAPEGOAT_MAX_LIVE_KEYS:
                nodes[index].active <- false
                nodes[index].left <- -1
                nodes[index].right <- -1
                index <- index + 1
            root <- -1
            size <- 0
            max_size <- 0
            results[operation] <- -2
        operation <- operation + 1

    output_bytes: usize = (2 + operation_count + size) * 8
    if output.is_null() or output_capacity < output_bytes: return -2
    staged: mutable u8[SCAPEGOAT_MAX_OUTPUT_BYTES] = zeroed
    scapegoat_write_i64_le(staged[0:SCAPEGOAT_MAX_OUTPUT_BYTES], 0, operation_count.i64())
    operation <- 0
    while operation < operation_count:
        scapegoat_write_i64_le(staged[0:SCAPEGOAT_MAX_OUTPUT_BYTES], (1 + operation) * 8, results[operation])
        operation <- operation + 1
    scapegoat_write_i64_le(staged[0:SCAPEGOAT_MAX_OUTPUT_BYTES], (1 + operation_count) * 8, size.i64())
    order: mutable i64[SCAPEGOAT_MAX_LIVE_KEYS] = zeroed
    order_length: mutable usize = 0
    scapegoat_flatten(nodes[0:SCAPEGOAT_MAX_LIVE_KEYS], root,
            order[0:SCAPEGOAT_MAX_LIVE_KEYS], order_length&)
    index <- 0
    while index < order_length:
        scapegoat_write_i64_le(staged[0:SCAPEGOAT_MAX_OUTPUT_BYTES], (2 + operation_count + index) * 8, nodes[order[index].usize()].key)
        index <- index + 1
    byte: mutable usize = 0
    while byte < output_bytes:
        output[byte] <- staged[byte]
        byte <- byte + 1
    return output_bytes.i64()

export fn scapegoat_tree(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64 = scapegoat_tree_impl
