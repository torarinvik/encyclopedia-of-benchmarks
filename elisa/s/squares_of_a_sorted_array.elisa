const MAX_ARRAY_LENGTH: usize = 10000

# Square a sorted array and emit the results in ascending order.
def squares_of_a_sorted_array_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length > MAX_ARRAY_LENGTH:
        return -1
    index: mutable usize = 0
    while index < length:
        value: i64 = input[index]
        if value < -10000 or value > 10000:
            return -1
        if index > 0 and input[index - 1] > value:
            return -1
        index <- index + 1

    output_bytes: usize = length * 8
    if output_capacity < output_bytes:
        return -2

    left: mutable usize = 0
    right: mutable usize = length
    destination: mutable usize = length
    while destination > 0:
        destination <- destination - 1
        left_value: i64 = input[left]
        right_value: i64 = input[right - 1]
        left_magnitude: mutable i64 = left_value
        if left_value < 0:
            left_magnitude <- -left_value
        right_magnitude: mutable i64 = right_value
        if right_value < 0:
            right_magnitude <- -right_value
        value: mutable i64 = 0
        if left_magnitude > right_magnitude:
            value <- left_value
            left <- left + 1
        else:
            value <- right_value
            right <- right - 1
        square: u64 = (value * value).u64()
        byte: mutable usize = 0
        while byte < 8:
            output[destination * 8 + byte] <- ((square >> (byte * 8)) & 255).u8()
            byte <- byte + 1
    length.i64()

export fn squares_of_a_sorted_array(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = squares_of_a_sorted_array_impl
