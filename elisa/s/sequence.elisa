const MAX_COUNT: i64 = 64
const MAX_PARSEABLE_INPUT_LENGTH: usize = 3
const MAX_OUTPUT_BYTES: usize = 512

def sequence_generate_nth_term(index: i64) -> i64:
    if index == 0 or index == 1:
        return index
    if index % 2 == 0:
        return 4 * sequence_generate_nth_term(index / 2)
    4 * sequence_generate_nth_term(index / 2) + 1

def sequence_put_i64_le(value: i64, output: mutable view[u8], offset: usize):
    bits: mutable u64 = value.u64()
    for byte in 0..<8 |output, bits|:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def sequence_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    if length != 1 or input[0] < -MAX_COUNT or input[0] > MAX_COUNT:
        return -1
    if input[0] <= 0:
        return 0

    count: usize = input[0].usize()
    required: usize = count * 8
    if output == null or output_capacity < required or required > MAX_OUTPUT_BYTES:
        return -2
    for index in 0..<count |output|:
        sequence_put_i64_le(sequence_generate_nth_term(index.i64()), output[0:required], index * 8)
    required.i64()

export fn sequence(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = sequence_impl
