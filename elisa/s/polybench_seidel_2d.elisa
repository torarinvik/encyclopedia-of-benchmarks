# PolyBench/C seidel-2d bounded port. See benchmarks/s/polybench_seidel_2d/LICENSE.txt.
extern trunc(value: f64) -> f64
const MAX_N: usize = 6

def polybench_seidel_2d_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length != 2: return -1
    nv: f64 = input[0]
    sv: f64 = input[1]
    if nv != nv or sv != sv or trunc(nv) != nv or trunc(sv) != sv: return -1
    if nv < 1.0 or nv > MAX_N.f64() or sv < 0.0 or sv > 4.0: return -1
    n: usize = nv.usize()
    steps: usize = sv.usize()
    cells: usize = n * n
    if output.is_null() or capacity < cells: return -2
    a: mutable f64[36] = zeroed
    staged: mutable f64[36] = zeroed
    for i in 0..<n:
        for j in 0..<n: a[i * n + j] <- (i.f64() * (j + 2).f64() + 2.0) / n.f64()
    for _ in 0..<steps:
        if n > 2:
            for i in 1..<(n - 1):
                for j in 1..<(n - 1):
                    q: usize = i * n + j
                    sum: f64 = a[q - n - 1] + a[q - n] + a[q - n + 1] + a[q - 1] + a[q] + a[q + 1] + a[q + n - 1] + a[q + n] + a[q + n + 1]
                    a[q] <- sum / 9.0
    for q in 0..<cells: staged[q] <- a[q]
    for q in 0..<cells: output[q] <- staged[q]
    cells.i64()

export fn polybench_seidel_2d(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = polybench_seidel_2d_impl
