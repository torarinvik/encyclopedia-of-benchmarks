const MAX_ITEMS: usize = 64
const MAX_OPERATIONS: usize = 128
const MAX_INPUT_VALUES: usize = 2 + MAX_ITEMS + 4 * MAX_OPERATIONS
const TREE_SIZE: usize = 4 * MAX_ITEMS
const VALUE_LIMIT: i64 = 1000000
const INF: i64 = 2305843009213693951
const QUERY_OFFSET: i64 = 8256000001

struct SegmentBeatsNode:
    sum: i64
    max1: i64
    max2: i64
    min1: i64
    min2: i64
    add: i64
    max_count: usize
    min_count: usize

def segment_tree_beats_pull(tree: mutable view[SegmentBeatsNode], node: usize) -> void:
    left: SegmentBeatsNode = tree[2 * node]
    right: SegmentBeatsNode = tree[2 * node + 1]
    current: mutable SegmentBeatsNode = tree[node]
    current.sum <- left.sum + right.sum
    current.add <- 0
    if left.max1 == right.max1:
        current.max1 <- left.max1
        current.max2 <- if left.max2 > right.max2 then left.max2 else right.max2
        current.max_count <- left.max_count + right.max_count
    else if left.max1 > right.max1:
        current.max1 <- left.max1
        current.max2 <- if left.max2 > right.max1 then left.max2 else right.max1
        current.max_count <- left.max_count
    else:
        current.max1 <- right.max1
        current.max2 <- if left.max1 > right.max2 then left.max1 else right.max2
        current.max_count <- right.max_count
    if left.min1 == right.min1:
        current.min1 <- left.min1
        current.min2 <- if left.min2 < right.min2 then left.min2 else right.min2
        current.min_count <- left.min_count + right.min_count
    else if left.min1 < right.min1:
        current.min1 <- left.min1
        current.min2 <- if left.min2 < right.min1 then left.min2 else right.min1
        current.min_count <- left.min_count
    else:
        current.min1 <- right.min1
        current.min2 <- if left.min1 < right.min2 then left.min1 else right.min2
        current.min_count <- right.min_count
    tree[node] <- current

def segment_tree_beats_build(tree: mutable view[SegmentBeatsNode], values: view[i64],
                             node: usize, low: usize, high: usize) -> void:
    if high - low == 1:
        value: i64 = values[low]
        tree[node] <- SegmentBeatsNode{sum: value, max1: value, max2: -INF,
            min1: value, min2: INF, add: 0, max_count: 1, min_count: 1}
        return
    middle: usize = low + (high - low) / 2
    segment_tree_beats_build(tree, values, 2 * node, low, middle)
    segment_tree_beats_build(tree, values, 2 * node + 1, middle, high)
    segment_tree_beats_pull(tree, node)

def segment_tree_beats_apply_add(tree: mutable view[SegmentBeatsNode], node: usize,
                                 length: usize, delta: i64) -> void:
    tree[node].sum <- tree[node].sum + delta * length.i64()
    tree[node].max1 <- tree[node].max1 + delta
    tree[node].min1 <- tree[node].min1 + delta
    if tree[node].max2 != -INF: tree[node].max2 <- tree[node].max2 + delta
    if tree[node].min2 != INF: tree[node].min2 <- tree[node].min2 + delta
    tree[node].add <- tree[node].add + delta

def segment_tree_beats_apply_chmin(tree: mutable view[SegmentBeatsNode], node: usize, ceiling: i64) -> void:
    if tree[node].max1 <= ceiling: return
    tree[node].sum <- tree[node].sum + (ceiling - tree[node].max1) * tree[node].max_count.i64()
    if tree[node].min1 == tree[node].max1: tree[node].min1 <- ceiling
    else if tree[node].min2 == tree[node].max1: tree[node].min2 <- ceiling
    tree[node].max1 <- ceiling

def segment_tree_beats_apply_chmax(tree: mutable view[SegmentBeatsNode], node: usize, floor: i64) -> void:
    if tree[node].min1 >= floor: return
    tree[node].sum <- tree[node].sum + (floor - tree[node].min1) * tree[node].min_count.i64()
    if tree[node].max1 == tree[node].min1: tree[node].max1 <- floor
    else if tree[node].max2 == tree[node].min1: tree[node].max2 <- floor
    tree[node].min1 <- floor

def segment_tree_beats_push(tree: mutable view[SegmentBeatsNode], node: usize,
                            low: usize, high: usize) -> void:
    if high - low == 1: return
    middle: usize = low + (high - low) / 2
    delta: i64 = tree[node].add
    if delta != 0:
        segment_tree_beats_apply_add(tree, 2 * node, middle - low, delta)
        segment_tree_beats_apply_add(tree, 2 * node + 1, high - middle, delta)
        tree[node].add <- 0
    max1: i64 = tree[node].max1
    if tree[2 * node].max1 > max1: segment_tree_beats_apply_chmin(tree, 2 * node, max1)
    if tree[2 * node + 1].max1 > max1: segment_tree_beats_apply_chmin(tree, 2 * node + 1, max1)
    min1: i64 = tree[node].min1
    if tree[2 * node].min1 < min1: segment_tree_beats_apply_chmax(tree, 2 * node, min1)
    if tree[2 * node + 1].min1 < min1: segment_tree_beats_apply_chmax(tree, 2 * node + 1, min1)

def segment_tree_beats_range_add(tree: mutable view[SegmentBeatsNode], node: usize,
                                 low: usize, high: usize, ql: usize, qr: usize, delta: i64) -> void:
    if qr <= low or high <= ql or delta == 0: return
    if ql <= low and high <= qr:
        segment_tree_beats_apply_add(tree, node, high - low, delta)
        return
    segment_tree_beats_push(tree, node, low, high)
    middle: usize = low + (high - low) / 2
    segment_tree_beats_range_add(tree, 2 * node, low, middle, ql, qr, delta)
    segment_tree_beats_range_add(tree, 2 * node + 1, middle, high, ql, qr, delta)
    segment_tree_beats_pull(tree, node)

def segment_tree_beats_range_chmin(tree: mutable view[SegmentBeatsNode], node: usize,
                                   low: usize, high: usize, ql: usize, qr: usize, ceiling: i64) -> void:
    if qr <= low or high <= ql or tree[node].max1 <= ceiling: return
    if ql <= low and high <= qr and tree[node].max2 < ceiling:
        segment_tree_beats_apply_chmin(tree, node, ceiling)
        return
    segment_tree_beats_push(tree, node, low, high)
    middle: usize = low + (high - low) / 2
    segment_tree_beats_range_chmin(tree, 2 * node, low, middle, ql, qr, ceiling)
    segment_tree_beats_range_chmin(tree, 2 * node + 1, middle, high, ql, qr, ceiling)
    segment_tree_beats_pull(tree, node)

def segment_tree_beats_range_chmax(tree: mutable view[SegmentBeatsNode], node: usize,
                                   low: usize, high: usize, ql: usize, qr: usize, floor: i64) -> void:
    if qr <= low or high <= ql or tree[node].min1 >= floor: return
    if ql <= low and high <= qr and tree[node].min2 > floor:
        segment_tree_beats_apply_chmax(tree, node, floor)
        return
    segment_tree_beats_push(tree, node, low, high)
    middle: usize = low + (high - low) / 2
    segment_tree_beats_range_chmax(tree, 2 * node, low, middle, ql, qr, floor)
    segment_tree_beats_range_chmax(tree, 2 * node + 1, middle, high, ql, qr, floor)
    segment_tree_beats_pull(tree, node)

def segment_tree_beats_range_sum(tree: mutable view[SegmentBeatsNode], node: usize,
                                 low: usize, high: usize, ql: usize, qr: usize) -> i64:
    if qr <= low or high <= ql: return 0
    if ql <= low and high <= qr: return tree[node].sum
    segment_tree_beats_push(tree, node, low, high)
    middle: usize = low + (high - low) / 2
    segment_tree_beats_range_sum(tree, 2 * node, low, middle, ql, qr) +
        segment_tree_beats_range_sum(tree, 2 * node + 1, middle, high, ql, qr)

def segment_tree_beats_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 2 or length > MAX_INPUT_VALUES: return -1
    n_value: i64 = values[0]
    if n_value < 1 or n_value > MAX_ITEMS.i64(): return -1
    n: usize = n_value.usize()
    if length < n + 2: return -1
    q_value: i64 = values[n + 1]
    if q_value < 0 or q_value > MAX_OPERATIONS.i64(): return -1
    q: usize = q_value.usize()
    if length != n + 2 + 4 * q: return -1
    for i in 0..<n:
        if values[i + 1] < -VALUE_LIMIT or values[i + 1] > VALUE_LIMIT: return -1
    for i in 0..<q:
        p: usize = n + 2 + 4 * i
        opcode: i64 = values[p]
        left: i64 = values[p + 1]
        right: i64 = values[p + 2]
        argument: i64 = values[p + 3]
        if opcode < 0 or opcode > 3 or left < 0 or left >= right or right > n_value: return -1
        if opcode == 3:
            if argument != 0: return -1
        else if argument < -VALUE_LIMIT or argument > VALUE_LIMIT: return -1

    tree: mutable SegmentBeatsNode[TREE_SIZE] = zeroed
    segment_tree_beats_build(tree[0:TREE_SIZE], values[1:n + 1], 1, 0, n)
    checksum: mutable i64 = 0
    ordinal: mutable i64 = 0
    for i in 0..<q:
        p: usize = n + 2 + 4 * i
        left: usize = values[p + 1].usize()
        right: usize = values[p + 2].usize()
        argument: i64 = values[p + 3]
        if values[p] == 0:
            segment_tree_beats_range_chmin(tree[0:TREE_SIZE], 1, 0, n, left, right, argument)
        else if values[p] == 1:
            segment_tree_beats_range_chmax(tree[0:TREE_SIZE], 1, 0, n, left, right, argument)
        else if values[p] == 2:
            segment_tree_beats_range_add(tree[0:TREE_SIZE], 1, 0, n, left, right, argument)
        else:
            ordinal <- ordinal + 1
            checksum <- checksum + ordinal * (segment_tree_beats_range_sum(tree[0:TREE_SIZE], 1, 0, n, left, right) + QUERY_OFFSET)
    checksum

export fn segment_tree_beats(values: i64&, length: usize) -> i64 = segment_tree_beats_impl
