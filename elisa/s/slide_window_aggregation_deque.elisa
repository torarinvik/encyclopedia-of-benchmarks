# Two-stack aggregate deque with midpoint rebuilding.
const SWAD_MAX_OPERATIONS: usize = 32
const SWAD_MAX_INPUT_LENGTH: usize = 162
const SWAD_MODULUS: i64 = 97

struct SwadMatrix:
    a: i64
    b: i64
    c: i64
    d: i64

def swad_identity() -> SwadMatrix:
    SwadMatrix(a=1, b=0, c=0, d=1)

def swad_multiply(x: SwadMatrix, y: SwadMatrix) -> SwadMatrix:
    SwadMatrix(
        a=(x.a * y.a + x.b * y.c) % SWAD_MODULUS,
        b=(x.a * y.b + x.b * y.d) % SWAD_MODULUS,
        c=(x.c * y.a + x.d * y.c) % SWAD_MODULUS,
        d=(x.c * y.b + x.d * y.d) % SWAD_MODULUS
    )

def swad_pack(value: SwadMatrix) -> i64:
    value.a + SWAD_MODULUS * value.b + SWAD_MODULUS * SWAD_MODULUS * value.c + SWAD_MODULUS * SWAD_MODULUS * SWAD_MODULUS * value.d

def swad_push_front(items: mutable SwadMatrix[32], aggregates: mutable SwadMatrix[32], count: usize, value: SwadMatrix) -> usize:
    items[count] <- value
    aggregates[count] <- if count == 0: value else: swad_multiply(value, aggregates[count - 1])
    count + 1

def swad_push_back(items: mutable SwadMatrix[32], aggregates: mutable SwadMatrix[32], count: usize, value: SwadMatrix) -> usize:
    items[count] <- value
    aggregates[count] <- if count == 0: value else: swad_multiply(aggregates[count - 1], value)
    count + 1

def slide_window_aggregation_deque_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 1 or length > SWAD_MAX_INPUT_LENGTH: return -1
    operation_count_value: i64 = input[0]
    if operation_count_value < 0 or operation_count_value > SWAD_MAX_OPERATIONS.i64(): return -1
    operation_count: usize = operation_count_value.usize()

    front: mutable SwadMatrix[32] = zeroed
    front_aggregate: mutable SwadMatrix[32] = zeroed
    back: mutable SwadMatrix[32] = zeroed
    back_aggregate: mutable SwadMatrix[32] = zeroed
    temporary: mutable SwadMatrix[32] = zeroed
    front_count: mutable usize = 0
    back_count: mutable usize = 0
    cursor: mutable usize = 1
    query_ordinal: mutable usize = 0
    checksum: mutable i64 = 0

    for operation in 0..<operation_count:
        if cursor >= length: return -1
        opcode: i64 = input[cursor]
        cursor <- cursor + 1
        if opcode == 0 or opcode == 1:
            if cursor + 4 > length: return -1
            value: SwadMatrix = SwadMatrix(a=input[cursor], b=input[cursor + 1], c=input[cursor + 2], d=input[cursor + 3])
            if value.a < 0 or value.a >= SWAD_MODULUS or value.b < 0 or value.b >= SWAD_MODULUS or value.c < 0 or value.c >= SWAD_MODULUS or value.d < 0 or value.d >= SWAD_MODULUS: return -1
            cursor <- cursor + 4
            if opcode == 0: front_count <- swad_push_front(front, front_aggregate, front_count, value)
            else: back_count <- swad_push_back(back, back_aggregate, back_count, value)
        elif opcode == 2 or opcode == 3:
            if front_count + back_count == 0: return -1
            if opcode == 2:
                if front_count == 0:
                    total: usize = front_count + back_count
                    front_size: usize = total / 2 + total % 2
                    for index in 0..<back_count: temporary[index] <- back[index]
                    front_count <- 0
                    back_count <- 0
                    for index in 0..<front_size:
                        front_count <- swad_push_front(front, front_aggregate, front_count, temporary[front_size - 1 - index])
                    for index in front_size..<total:
                        back_count <- swad_push_back(back, back_aggregate, back_count, temporary[index])
                front_count <- front_count - 1
            else:
                if back_count == 0:
                    total: usize = front_count + back_count
                    front_size: usize = total / 2
                    for index in 0..<front_count: temporary[index] <- front[front_count - 1 - index]
                    front_count <- 0
                    back_count <- 0
                    for index in 0..<front_size:
                        front_count <- swad_push_front(front, front_aggregate, front_count, temporary[front_size - 1 - index])
                    for index in front_size..<total:
                        back_count <- swad_push_back(back, back_aggregate, back_count, temporary[index])
                back_count <- back_count - 1
        elif opcode == 4:
            left: SwadMatrix = if front_count == 0: swad_identity() else: front_aggregate[front_count - 1]
            right: SwadMatrix = if back_count == 0: swad_identity() else: back_aggregate[back_count - 1]
            query_ordinal <- query_ordinal + 1
            checksum <- checksum + query_ordinal.i64() * (swad_pack(swad_multiply(left, right)) + 1)
        else:
            return -1
    if cursor != length: return -1
    checksum

export fn slide_window_aggregation_deque(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > SWAD_MAX_INPUT_LENGTH: return -1
    slide_window_aggregation_deque_impl(input[0:length])
