# Stockham autosort radix-2 FFT: ping-pong stages that write each butterfly
# straight to its sorted position, so no bit-reversal pass is needed.
@intrinsic("llvm.sin.f64")
extern sin(value: f64) -> f64
@intrinsic("llvm.cos.f64")
extern cos(value: f64) -> f64
@intrinsic("llvm.fabs.f64")
extern fabs(value: f64) -> f64
@intrinsic("llvm.floor.f64")
extern floor(value: f64) -> f64

const MAX_N: usize = 64
const MAX_INPUT_LENGTH: usize = 130
const MAX_SCALARS: usize = 128
const TAU: f64 = 6.283185307179586476925286766559

const MAX_FINITE: f64 = 1.7976931348623157e308

# False for NaN and both infinities, like C's isfinite.
def stockham_finite(value: f64) -> bool:
    fabs(value) <= MAX_FINITE

def stockham_stage(source: view[f64], destination: mutable view[f64], n: usize, stride: usize) -> void:
    j: mutable usize = 0
    while j < n / 2:
        column: usize = j % stride
        group: usize = j / stride
        base: usize = group * 2 * stride + column
        angle: f64 = -TAU * column.f64() / (2 * stride).f64()
        cosine: f64 = cos(angle)
        sine: f64 = sin(angle)
        left: usize = 2 * j
        right: usize = 2 * (j + n / 2)
        product_real: f64 = cosine * source[right] - sine * source[right + 1]
        product_imag: f64 = cosine * source[right + 1] + sine * source[right]
        first_real: f64 = source[left]
        first_imag: f64 = source[left + 1]
        out_left: usize = 2 * base
        out_right: usize = 2 * (base + stride)
        destination[out_left] <- first_real + product_real
        destination[out_left + 1] <- first_imag + product_imag
        destination[out_right] <- first_real - product_real
        destination[out_right + 1] <- first_imag - product_imag
        j <- j + 1

def stockham_autosort_radix2_fft_impl(input: f64&?, input_length: usize, output: mutable f64&?, output_capacity: usize) -> i64:
    if input == null or input_length < 3 or input_length > MAX_INPUT_LENGTH:
        return -1
    i: mutable usize = 0
    while i < input_length:
        if not stockham_finite(input[i]):
            return -1
        i <- i + 1
    n_value: f64 = input[0]
    if n_value < 1.0 or n_value > MAX_N.f64() or floor(n_value) != n_value:
        return -1
    n: usize = n_value.usize()
    if (n & (n - 1)) != 0 or input_length != 1 + 2 * n:
        return -1
    i <- 0
    while i < MAX_SCALARS and i < 2 * n:
        if input[i + 1] < -8.0 or input[i + 1] > 8.0:
            return -1
        i <- i + 1

    first: mutable f64[128] = zeroed
    second: mutable f64[128] = zeroed
    i <- 0
    while i < 2 * n:
        first[i] <- input[i + 1]
        i <- i + 1
    # Stages alternate first -> second -> first; the parity of the stage
    # count says which buffer holds the result.
    source_is_first: mutable bool = true
    stride: mutable usize = 1
    while stride < n:
        if source_is_first:
            stockham_stage(first[0:MAX_SCALARS], second[0:MAX_SCALARS], n, stride)
        else:
            stockham_stage(second[0:MAX_SCALARS], first[0:MAX_SCALARS], n, stride)
        source_is_first <- not source_is_first
        stride <- stride * 2

    needed: usize = 2 * n
    if output == null or output_capacity < needed:
        return -2
    i <- 0
    while i < needed:
        output[i] <- first[i] if source_is_first else second[i]
        i <- i + 1
    needed.i64()

export fn stockham_autosort_radix2_fft(input: f64&?, input_length: usize, output: mutable f64&?, output_capacity: usize) -> i64 = stockham_autosort_radix2_fft_impl
