# Source-ordered double-precision matrix multiplication from Stanford RealMM.
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

const ROWSIZE: usize = 40
const CELL_COUNT: usize = ROWSIZE * ROWSIZE
const MAX_PASSES: i64 = 10
const MAX_OUTPUT_BYTES: usize = 140

def rounded_micro_units(bits: u64) -> u64:
    exponent: i64 = ((bits >> 52) & 0x7ff).i64()
    if exponent == 0:
        return 0.u64()
    significand: u64 = (bits & ((1.u64() << 52) - 1.u64())) | (1.u64() << 52)
    shift: i64 = 1075 - exponent
    if shift >= 74:
        return 0.u64()
    low_product: u64 = (significand & ((1.u64() << 32) - 1.u64())) * 1000000.u64()
    high_product: u64 = (significand >> 32) * 1000000.u64()
    middle: u64 = (low_product >> 32) + (high_product & ((1.u64() << 32) - 1.u64()))
    limb0: u64 = low_product & ((1.u64() << 32) - 1.u64())
    limb1: u64 = middle & ((1.u64() << 32) - 1.u64())
    limb2: u64 = (high_product >> 32) + (middle >> 32)
    quotient: mutable u64 = 0.u64()
    half_bit: mutable u64 = 0.u64()
    lower_nonzero: mutable bool = false
    if shift < 64:
        part: i64 = shift - 32
        quotient <- (limb1 >> part) | (limb2 << (32 - part))
        half_bit <- (limb1 >> (part - 1)) & 1.u64()
        lower_nonzero <- limb0 != 0.u64() or (limb1 & ((1.u64() << (part - 1)) - 1.u64())) != 0.u64()
    else if shift == 64:
        quotient <- limb2
        half_bit <- limb1 >> 31
        lower_nonzero <- limb0 != 0.u64() or (limb1 & ((1.u64() << 31) - 1.u64())) != 0.u64()
    else:
        part: i64 = shift - 64
        quotient <- limb2 >> part
        half_bit <- (limb2 >> (part - 1)) & 1.u64()
        lower_nonzero <- limb0 != 0.u64() or limb1 != 0.u64() or (limb2 & ((1.u64() << (part - 1)) - 1.u64())) != 0.u64()
    if half_bit != 0.u64() and (lower_nonzero or (quotient & 1.u64()) != 0.u64()):
        quotient <- quotient + 1.u64()
    quotient

def append_integer(buffer: mutable u8&, used: mutable usize&, value: u64):
    reversed: mutable u8[20] = zeroed
    remaining: mutable u64 = value
    count: mutable usize = 0
    while true:
        reversed[count] <- (48.u64() + remaining % 10.u64()).u8()
        count <- count + 1
        remaining <- remaining / 10.u64()
        if remaining == 0.u64():
            break
    while count > 0:
        count <- count - 1
        buffer[used] <- reversed[count]
        used <- used + 1

def append_fixed(buffer: mutable u8&, used: mutable usize&, value: f64):
    bits: mutable u64 = 0.u64()
    memcpy(&bits, &value, 8)
    if (bits >> 63) != 0.u64():
        buffer[used] <- 45u8
        used <- used + 1
    scaled: u64 = rounded_micro_units(bits & ((1.u64() << 63) - 1.u64()))
    append_integer(buffer, used, scaled / 1000000.u64())
    buffer[used] <- 46u8
    used <- used + 1
    fraction: mutable u64 = scaled % 1000000.u64()
    place: mutable u64 = 100000.u64()
    while place > 0.u64():
        buffer[used] <- (48.u64() + fraction / place).u8()
        used <- used + 1
        fraction <- fraction % place
        place <- place / 10.u64()

def stanford_realmm_impl(pass_count: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if pass_count < 1 or pass_count > MAX_PASSES:
        return -1
    if output.is_null():
        return -2

    a: mutable f64[CELL_COUNT] = zeroed
    b: mutable f64[CELL_COUNT] = zeroed
    product: mutable f64[CELL_COUNT] = zeroed
    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    used: mutable usize = 0
    pass: mutable i64 = 0
    while pass < pass_count:
        seed: mutable i64 = 74755
        index: mutable usize = 0
        while index < CELL_COUNT:
            seed <- (seed * 1309 + 13849) & 65535
            temp: i64 = seed
            residue: i64 = temp - (temp / 120) * 120 - 60
            a[index] <- residue.f64() / 3.0
            index <- index + 1
        index <- 0
        while index < CELL_COUNT:
            seed <- (seed * 1309 + 13849) & 65535
            temp: i64 = seed
            residue: i64 = temp - (temp / 120) * 120 - 60
            b[index] <- residue.f64() / 3.0
            index <- index + 1

        row: mutable usize = 0
        while row < ROWSIZE:
            column: mutable usize = 0
            while column < ROWSIZE:
                sum: mutable f64 = 0.0
                inner: mutable usize = 0
                while inner < ROWSIZE:
                    sum <- sum + a[row * ROWSIZE + inner] * b[inner * ROWSIZE + column]
                    inner <- inner + 1
                product[row * ROWSIZE + column] <- sum
                column <- column + 1
            row <- row + 1
        diagonal: usize = pass.usize() * ROWSIZE + pass.usize()
        append_fixed(staged, used, product[diagonal])
        staged[used] <- 10u8
        used <- used + 1
        pass <- pass + 1

    if output_capacity < used:
        return -2
    index <- 0
    while index < used:
        output[index] <- staged[index]
        index <- index + 1
    used.i64()

export fn stanford_realmm(pass_count: i64, output: mutable u8&, output_capacity: usize) -> i64 = stanford_realmm_impl
