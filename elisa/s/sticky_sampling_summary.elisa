# Sticky sampling frequency summary over a replayed coin-flip tape.
def sticky_put_word(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def sticky_summary_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 3 or length > 323 or input[0] < 1 or input[0] > 8 or input[1] < 0 or input[1] > 64 or input[2] < 0 or input[2] > 256:
        return -1
    t: usize = input[0].usize()
    n: usize = input[1].usize()
    k: usize = input[2].usize()
    if length != 3 + n + k:
        return -1
    i: mutable usize = 0
    while i < n:
        if input[3 + i] < 0 or input[3 + i] > 15:
            return -1
        i <- i + 1
    i <- 0
    while i < k:
        if input[3 + n + i] < 0 or input[3 + n + i] > 255:
            return -1
        i <- i + 1

    count: mutable i64[16] = zeroed
    cursor: mutable usize = 0
    rate: mutable usize = 1
    phase_end: mutable usize = 2 * t
    i <- 0
    while i < n:
        if i == phase_end:
            rate <- rate * 2
            phase_end <- phase_end + rate * t
            item: mutable usize = 0
            while item < 16:
                while count[item] != 0:
                    if cursor == k:
                        return -1
                    draw: i64 = input[3 + n + cursor]
                    cursor <- cursor + 1
                    if (draw & 1) != 0:
                        break
                    count[item] <- count[item] - 1
                item <- item + 1
        item: usize = input[3 + i].usize()
        if count[item] != 0:
            count[item] <- count[item] + 1
        else:
            if cursor == k:
                return -1
            draw: usize = input[3 + n + cursor].usize()
            cursor <- cursor + 1
            if draw % rate == 0:
                count[item] <- 1
        i <- i + 1
    if cursor != k:
        return -1
    active: mutable usize = 0
    item: mutable usize = 0
    while item < 16:
        if count[item] != 0:
            active <- active + 1
        item <- item + 1
    bytes: usize = 8 + 16 * active
    if output == null or capacity < bytes:
        return -2
    sticky_put_word(output, 0, active.i64())
    offset: mutable usize = 8
    item <- 0
    while item < 16:
        if count[item] != 0:
            sticky_put_word(output, offset, item.i64())
            sticky_put_word(output, offset + 8, count[item])
            offset <- offset + 16
        item <- item + 1
    bytes.i64()

export fn sticky_sampling_summary(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = sticky_summary_impl
