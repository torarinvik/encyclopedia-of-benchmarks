@intrinsic("llvm.cttz.i32")
extern sticky_first_item(bits: u32, zero_undefined: bool) -> u32
@intrinsic("llvm.ctpop.i32")
extern sticky_count_items(bits: u32) -> u32

def sticky_put_word(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for i in 0..<8:
        output[offset+i] <- (bits & 255).u8()
        bits <- bits >> 8

def sticky_solve(input: i64&, output: mutable u8&?, capacity: usize) -> i64:
    t: usize = input[0].usize()
    n: usize = input[1].usize()
    k: usize = input[2].usize()
    counts: mutable i64[16] = zeroed
    occupied: mutable u32 = 0
    cursor: mutable usize = 0
    rate: mutable usize = 1
    # The sampling rate is a power of two, so divisibility uses its low bits.
    phase_end: mutable usize = 2*t
    for i in 0..<n:
        if i == phase_end:
            rate <- rate*2
            phase_end <- phase_end+rate*t
            pending: mutable u32 = occupied
            while pending != 0:
                item: usize = (sticky_first_item(pending, true) & 15).usize()
                pending <- pending & (pending-1)
                while counts[item] != 0:
                    if cursor == k: return -1
                    draw: i64 = input[3+n+cursor]
                    cursor <- cursor+1
                    if (draw & 1) == 1: break
                    counts[item] <- counts[item]-1
                if counts[item] == 0: occupied <- occupied & ~(1.u32() << item)
        item: usize = input[3+i].usize()
        if counts[item] != 0:
            counts[item] <- counts[item]+1
        else:
            if cursor == k: return -1
            draw: usize = input[3+n+cursor].usize()
            cursor <- cursor+1
            if (draw & (rate-1)) == 0:
                counts[item] <- 1
                occupied <- occupied | (1.u32() << item)
    if cursor != k: return -1
    active: usize = sticky_count_items(occupied).usize()
    bytes: usize = 8+16*active
    if output == null or capacity < bytes: return -2
    sticky_put_word(output, 0, active.i64())
    offset: mutable usize = 8
    while occupied != 0:
        item: usize = (sticky_first_item(occupied, true) & 15).usize()
        occupied <- occupied & (occupied-1)
        sticky_put_word(output, offset, item.i64())
        sticky_put_word(output, offset+8, counts[item])
        offset <- offset+16
    bytes.i64()

def sticky_summary_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 3 or length > 323: return -1
    if input[0] < 1 or input[0] > 8 or input[1] < 0 or input[1] > 64 or input[2] < 0 or input[2] > 256: return -1
    n: usize = input[1].usize()
    k: usize = input[2].usize()
    if length != 3+n+k: return -1
    for i in 0..<n:
        if input[3+i] < 0 or input[3+i] > 15: return -1
    for i in 0..<k:
        if input[3+n+i] < 0 or input[3+n+i] > 255: return -1
    sticky_solve(input, output, capacity)

export fn sticky_sampling_summary(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = sticky_summary_impl
