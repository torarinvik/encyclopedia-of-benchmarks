def sticky_put_word(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for i in 0..<8:
        output[offset+i] <- (bits & 255).u8()
        bits <- bits >> 8

def sticky_solve(input: view[i64], output: mutable u8&, capacity: usize) -> i64:
    t: usize = input[0].usize()
    n: usize = input[1].usize()
    k: usize = input[2].usize()
    counts: mutable i64[16] = zeroed
    cursor: mutable usize = 0
    rate: mutable usize = 1
    phase_end: mutable usize = 2*t
    for i in 0..<n:
        if i == phase_end:
            rate <- rate*2
            phase_end <- phase_end+rate*t
            for item in 0..<16:
                while counts[item] != 0:
                    if cursor == k: return -1
                    draw: i64 = input[3+n+cursor]
                    cursor <- cursor+1
                    if draw%2 == 1: break
                    counts[item] <- counts[item]-1
        item: usize = input[3+i].usize()
        if counts[item] != 0:
            counts[item] <- counts[item]+1
        else:
            if cursor == k: return -1
            draw: usize = input[3+n+cursor].usize()
            cursor <- cursor+1
            if draw%rate == 0: counts[item] <- 1
    if cursor != k: return -1
    active: mutable usize = 0
    for item in 0..<16:
        if counts[item] != 0: active <- active+1
    bytes: usize = 8+16*active
    if output.is_null() or capacity < bytes: return -2
    out: mutable view[u8] = output[0:bytes]
    sticky_put_word(out, 0, active.i64())
    offset: mutable usize = 8
    for item in 0..<16:
        if counts[item] != 0:
            sticky_put_word(out, offset, item.i64())
            sticky_put_word(out, offset+8, counts[item])
            offset <- offset+16
    bytes.i64()

export fn sticky_sampling_summary(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > 323: return -1
    values: view[i64] = input[0:length]
    if values[0] < 1 or values[0] > 8 or values[1] < 0 or values[1] > 64 or values[2] < 0 or values[2] > 256: return -1
    n: usize = values[1].usize()
    k: usize = values[2].usize()
    if length != 3+n+k: return -1
    for i in 0..<n:
        if values[3+i] < 0 or values[3+i] > 15: return -1
    for i in 0..<k:
        if values[3+n+i] < 0 or values[3+n+i] > 255: return -1
    sticky_solve(values, output, capacity)
