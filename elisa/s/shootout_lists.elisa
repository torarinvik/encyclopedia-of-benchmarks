const LIST_SIZE: usize = 100
const MIN_RUNS: i64 = 0
const MAX_RUNS: i64 = 10000
const NODE_COUNT: usize = 203

struct ListNode:
    value: i32
    next: usize
    prev: usize

def init_sequence(nodes: mutable ListNode&, head: usize, base: usize) -> void:
    nodes[head].value <- LIST_SIZE.i32()
    nodes[head].next <- base
    nodes[head].prev <- base + LIST_SIZE - 1
    for offset in 0..<LIST_SIZE:
        item: usize = base + offset
        nodes[item].value <- (offset + 1).i32()
        nodes[item].prev <- if offset == 0: head else: item - 1
        nodes[item].next <- if offset + 1 == LIST_SIZE: head else: item + 1

def list_length(nodes: ListNode&, head: usize) -> i32:
    nodes[head].value

def pop_head(nodes: mutable ListNode&, head: usize) -> i64:
    if list_length(nodes, head) == 0: return -1
    item: usize = nodes[head].next
    next: usize = nodes[item].next
    nodes[head].next <- next
    nodes[next].prev <- head
    nodes[head].value <- nodes[head].value - 1
    item.i64()

def pop_tail(nodes: mutable ListNode&, head: usize) -> i64:
    if list_length(nodes, head) == 0: return -1
    item: usize = nodes[head].prev
    prev: usize = nodes[item].prev
    nodes[head].prev <- prev
    nodes[prev].next <- head
    nodes[head].value <- nodes[head].value - 1
    item.i64()

def push_tail(nodes: mutable ListNode&, head: usize, item: usize) -> void:
    tail: usize = nodes[head].prev
    nodes[tail].next <- item
    nodes[item].next <- head
    nodes[head].prev <- item
    nodes[item].prev <- tail
    nodes[head].value <- nodes[head].value + 1

def reverse_list(nodes: mutable ListNode&, head: usize) -> void:
    current: mutable usize = head
    while true:
        old_next: usize = nodes[current].next
        nodes[current].next <- nodes[current].prev
        nodes[current].prev <- old_next
        current <- old_next
        if current == head: break

def lists_equal(nodes: ListNode&, left: usize, right: usize) -> bool:
    if list_length(nodes, left) != list_length(nodes, right): return false
    a: mutable usize = nodes[left].next
    b: mutable usize = nodes[right].next
    while a != left and b != right:
        if nodes[a].value != nodes[b].value: return false
        a <- nodes[a].next
        b <- nodes[b].next
    a == left and b == right

def test_lists() -> bool:
    nodes: mutable ListNode[NODE_COUNT] = zeroed
    original: usize = 0
    copied: usize = 101
    staging: usize = 202
    init_sequence(nodes, original, 1)
    init_sequence(nodes, copied, 102)
    nodes[staging].value <- 0
    nodes[staging].next <- staging
    nodes[staging].prev <- staging
    if not lists_equal(nodes, copied, original): return false
    while list_length(nodes, copied) > 0:
        item: i64 = pop_head(nodes, copied)
        if item < 0: return false
        push_tail(nodes, staging, item.usize())
    if list_length(nodes, copied) != 0: return false
    while list_length(nodes, staging) > 0:
        item: i64 = pop_tail(nodes, staging)
        if item < 0: return false
        push_tail(nodes, copied, item.usize())
    if list_length(nodes, staging) != 0: return false
    reverse_list(nodes, original)
    nodes[nodes[original].next].value == LIST_SIZE.i32() and
        nodes[nodes[original].prev].value == 1 and
        nodes[nodes[copied].next].value == LIST_SIZE.i32() and
        nodes[nodes[copied].prev].value == 1 and
        list_length(nodes, original) == LIST_SIZE.i32() and
        lists_equal(nodes, original, copied)

def shootout_lists_impl(runs: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if runs < MIN_RUNS or runs > MAX_RUNS: return -1
    if output.is_null(): return -2
    staged: mutable u8[4] = zeroed
    output_bytes: mutable usize = 4
    if runs == 0:
        staged[0] <- 48u8
        staged[1] <- 10u8
        output_bytes <- 2
    else:
        staged[0] <- 49u8
        staged[1] <- 48u8
        staged[2] <- 48u8
        staged[3] <- 10u8
    if output_capacity < output_bytes: return -2
    for _ in 0..<runs.usize():
        if not test_lists(): return -1
    for index in 0..<output_bytes:
        output[index] <- staged[index]
    output_bytes.i64()

export fn shootout_lists(runs: i64, output: mutable u8&, output_capacity: usize) -> i64 = shootout_lists_impl
