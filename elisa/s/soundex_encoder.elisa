const MAX_TEXT_LENGTH: usize = 64
const MAX_INPUT_LENGTH: usize = MAX_TEXT_LENGTH + 1
const MAX_PARSEABLE_INPUT_LENGTH: usize = MAX_INPUT_LENGTH + 2
const MAX_OUTPUT_BYTES: usize = 4

def soundex_encoder_is_ascii_letter(value: i64) -> bool:
    (value >= 65 and value <= 90) or (value >= 97 and value <= 122)

def soundex_encoder_digit_for(input_value: i64) -> i64:
    value: mutable i64 = input_value
    if value >= 65 and value <= 90:
        value <- value + 32
    if value == 97 or value == 101 or value == 105 or value == 111 or value == 117 or value == 121:
        return 0
    if value == 104 or value == 119:
        return 8
    if value == 98 or value == 102 or value == 112 or value == 118:
        return 1
    if value == 99 or value == 103 or value == 106 or value == 107 or value == 113 or value == 115 or value == 120 or value == 122:
        return 2
    if value == 100 or value == 116:
        return 3
    if value == 108:
        return 4
    if value == 109 or value == 110:
        return 5
    if value == 114:
        return 6
    -1

def soundex_encoder_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or length > MAX_PARSEABLE_INPUT_LENGTH or input == null:
        return -1
    text_length: i64 = input[0]
    if text_length < 1 or text_length > MAX_TEXT_LENGTH.i64() or length > MAX_INPUT_LENGTH or length != text_length.usize() + 1:
        return -1
    for index in 1..<length |input|:
        if not soundex_encoder_is_ascii_letter(input[index]):
            return -1

    mapped: mutable i64[MAX_TEXT_LENGTH] = zeroed
    mapped_count: mutable usize = 0
    for index in 1..<length |input, mapped, mapped_count|:
        letter: mutable i64 = input[index]
        if letter >= 65 and letter <= 90:
            letter <- letter + 32
        if letter == 104 or letter == 119:
            continue
        digit: i64 = soundex_encoder_digit_for(letter)
        append_digit: mutable bool = false
        if mapped_count == 0:
            append_digit <- true
        else if mapped[mapped_count - 1] != digit:
            append_digit <- true
        if append_digit:
            mapped[mapped_count] <- digit
            mapped_count <- mapped_count + 1

    code_count: mutable usize = 0
    for index in 0..<mapped_count |mapped, code_count|:
        if mapped[index] != 0:
            mapped[code_count] <- mapped[index]
            code_count <- code_count + 1
    if code_count == 0:
        return -1

    first_letter: mutable i64 = input[1]
    if first_letter >= 65 and first_letter <= 90:
        first_letter <- first_letter + 32
    start: mutable usize = 0
    if mapped[0] == soundex_encoder_digit_for(first_letter):
        if code_count == 1:
            return -1
        start <- 1

    encoded: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    initial: mutable i64 = input[1]
    if initial >= 97 and initial <= 122:
        initial <- initial - 32
    encoded[0] <- initial.u8()
    for index in 0..<3 |mapped, encoded, start, code_count|:
        digit: mutable i64 = 0
        if start + index < code_count:
            digit <- mapped[start + index]
        encoded[index + 1] <- (48 + digit).u8()

    if output == null or output_capacity < MAX_OUTPUT_BYTES:
        return -2
    for index in 0..<MAX_OUTPUT_BYTES |encoded, output|:
        output[index] <- encoded[index]
    MAX_OUTPUT_BYTES.i64()

export fn soundex_encoder(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = soundex_encoder_impl
