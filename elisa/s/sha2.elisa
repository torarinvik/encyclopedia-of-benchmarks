const MAX_MESSAGE_BYTES: usize = 4096
const MAX_PARSEABLE_INPUT_LENGTH: usize = 4099
const MAX_PADDED_BYTES: usize = 4224
const MAX_OUTPUT_BYTES: usize = 64

def sha2_add32(left: u32, right: u32) -> u32:
    ((left.u64() + right.u64()) & 0xFFFF_FFFF.u64()).u32()

def sha2_add64(left: u64, right: u64) -> u64:
    low_sum: u64 = (left & 0xFFFF_FFFF.u64()) + (right & 0xFFFF_FFFF.u64())
    low: u64 = low_sum & 0xFFFF_FFFF.u64()
    high: u64 = ((left >> 32) + (right >> 32) + (low_sum >> 32)) & 0xFFFF_FFFF.u64()
    ((high << 32) | low).u64()

def sha2_rotr32(value: u32, amount: usize) -> u32:
    (value >> amount) | (value << (32 - amount))

def sha2_rotr64(value: u64, amount: usize) -> u64:
    (value >> amount) | (value << (64 - amount))

def sha2_compress32(state: mutable u32&, block: u8&) -> void:
    constants: u32[64] = [
        0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
        0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
        0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
        0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
        0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
        0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
        0x19A4C116,0x1E376C08,0x2748774C,0x34B0BCB5,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
        0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2]
    words: mutable u32[64] = zeroed
    for index in 0..<16:
        position: usize = index * 4
        words[index] <- (block[position].u32() << 24) | (block[position + 1].u32() << 16) |
            (block[position + 2].u32() << 8) | block[position + 3].u32()
    for index in 16..<64:
        x: u32 = words[index - 15]
        y: u32 = words[index - 2]
        s0: u32 = sha2_rotr32(x, 7) ^ sha2_rotr32(x, 18) ^ (x >> 3)
        s1: u32 = sha2_rotr32(y, 17) ^ sha2_rotr32(y, 19) ^ (y >> 10)
        words[index] <- sha2_add32(sha2_add32(sha2_add32(words[index - 16], s0), words[index - 7]), s1)
    a: mutable u32 = state[0]
    b: mutable u32 = state[1]
    c: mutable u32 = state[2]
    d: mutable u32 = state[3]
    e: mutable u32 = state[4]
    f: mutable u32 = state[5]
    g: mutable u32 = state[6]
    h: mutable u32 = state[7]
    for index in 0..<64:
        sigma1: u32 = sha2_rotr32(e, 6) ^ sha2_rotr32(e, 11) ^ sha2_rotr32(e, 25)
        choose: u32 = (e & f) ^ ((~e) & g)
        temp1: u32 = sha2_add32(sha2_add32(sha2_add32(sha2_add32(h, sigma1), choose), constants[index]), words[index])
        sigma0: u32 = sha2_rotr32(a, 2) ^ sha2_rotr32(a, 13) ^ sha2_rotr32(a, 22)
        majority: u32 = (a & b) ^ (a & c) ^ (b & c)
        temp2: u32 = sha2_add32(sigma0, majority)
        h <- g
        g <- f
        f <- e
        e <- sha2_add32(d, temp1)
        d <- c
        c <- b
        b <- a
        a <- sha2_add32(temp1, temp2)
    state[0] <- sha2_add32(state[0], a)
    state[1] <- sha2_add32(state[1], b)
    state[2] <- sha2_add32(state[2], c)
    state[3] <- sha2_add32(state[3], d)
    state[4] <- sha2_add32(state[4], e)
    state[5] <- sha2_add32(state[5], f)
    state[6] <- sha2_add32(state[6], g)
    state[7] <- sha2_add32(state[7], h)

def sha2_compress64(state: mutable u64&, block: u8&) -> void:
    constants: u64[80] = [
        0x428A2F98D728AE22,0x7137449123EF65CD,0xB5C0FBCFEC4D3B2F,0xE9B5DBA58189DBBC,
        0x3956C25BF348B538,0x59F111F1B605D019,0x923F82A4AF194F9B,0xAB1C5ED5DA6D8118,
        0xD807AA98A3030242,0x12835B0145706FBE,0x243185BE4EE4B28C,0x550C7DC3D5FFB4E2,
        0x72BE5D74F27B896F,0x80DEB1FE3B1696B1,0x9BDC06A725C71235,0xC19BF174CF692694,
        0xE49B69C19EF14AD2,0xEFBE4786384F25E3,0x0FC19DC68B8CD5B5,0x240CA1CC77AC9C65,
        0x2DE92C6F592B0275,0x4A7484AA6EA6E483,0x5CB0A9DCBD41FBD4,0x76F988DA831153B5,
        0x983E5152EE66DFAB,0xA831C66D2DB43210,0xB00327C898FB213F,0xBF597FC7BEEF0EE4,
        0xC6E00BF33DA88FC2,0xD5A79147930AA725,0x06CA6351E003826F,0x142929670A0E6E70,
        0x27B70A8546D22FFC,0x2E1B21385C26C926,0x4D2C6DFC5AC42AED,0x53380D139D95B3DF,
        0x650A73548BAF63DE,0x766A0ABB3C77B2A8,0x81C2C92E47EDAEE6,0x92722C851482353B,
        0xA2BFE8A14CF10364,0xA81A664BBC423001,0xC24B8B70D0F89791,0xC76C51A30654BE30,
        0xD192E819D6EF5218,0xD69906245565A910,0xF40E35855771202A,0x106AA07032BBD1B8,
        0x19A4C116B8D2D0C8,0x1E376C085141AB53,0x2748774CDF8EEB99,0x34B0BCB5E19B48A8,
        0x391C0CB3C5C95A63,0x4ED8AA4AE3418ACB,0x5B9CCA4F7763E373,0x682E6FF3D6B2B8A3,
        0x748F82EE5DEFB2FC,0x78A5636F43172F60,0x84C87814A1F0AB72,0x8CC702081A6439EC,
        0x90BEFFFA23631E28,0xA4506CEBDE82BDE9,0xBEF9A3F7B2C67915,0xC67178F2E372532B,
        0xCA273ECEEA26619C,0xD186B8C721C0C207,0xEADA7DD6CDE0EB1E,0xF57D4F7FEE6ED178,
        0x06F067AA72176FBA,0x0A637DC5A2C898A6,0x113F9804BEF90DAE,0x1B710B35131C471B,
        0x28DB77F523047D84,0x32CAAB7B40C72493,0x3C9EBE0A15C9BEBC,0x431D67C49C100D4C,
        0x4CC5D4BECB3E42B6,0x597F299CFC657E2A,0x5FCB6FAB3AD6FAEC,0x6C44198C4A475817]
    words: mutable u64[80] = zeroed
    for index in 0..<16:
        value: mutable u64 = 0
        for byte in 0..<8:
            value <- (value << 8) | block[index * 8 + byte].u64()
        words[index] <- value
    for index in 16..<80:
        x: u64 = words[index - 15]
        y: u64 = words[index - 2]
        s0: u64 = sha2_rotr64(x, 1) ^ sha2_rotr64(x, 8) ^ (x >> 7)
        s1: u64 = sha2_rotr64(y, 19) ^ sha2_rotr64(y, 61) ^ (y >> 6)
        words[index] <- sha2_add64(sha2_add64(sha2_add64(words[index - 16], s0), words[index - 7]), s1)
    a: mutable u64 = state[0]
    b: mutable u64 = state[1]
    c: mutable u64 = state[2]
    d: mutable u64 = state[3]
    e: mutable u64 = state[4]
    f: mutable u64 = state[5]
    g: mutable u64 = state[6]
    h: mutable u64 = state[7]
    for index in 0..<80:
        sigma1: u64 = sha2_rotr64(e, 14) ^ sha2_rotr64(e, 18) ^ sha2_rotr64(e, 41)
        choose: u64 = (e & f) ^ ((~e) & g)
        temp1: u64 = sha2_add64(sha2_add64(sha2_add64(sha2_add64(h, sigma1), choose), constants[index]), words[index])
        sigma0: u64 = sha2_rotr64(a, 28) ^ sha2_rotr64(a, 34) ^ sha2_rotr64(a, 39)
        majority: u64 = (a & b) ^ (a & c) ^ (b & c)
        temp2: u64 = sha2_add64(sigma0, majority)
        h <- g
        g <- f
        f <- e
        e <- sha2_add64(d, temp1)
        d <- c
        c <- b
        b <- a
        a <- sha2_add64(temp1, temp2)
    state[0] <- sha2_add64(state[0], a)
    state[1] <- sha2_add64(state[1], b)
    state[2] <- sha2_add64(state[2], c)
    state[3] <- sha2_add64(state[3], d)
    state[4] <- sha2_add64(state[4], e)
    state[5] <- sha2_add64(state[5], f)
    state[6] <- sha2_add64(state[6], g)
    state[7] <- sha2_add64(state[7], h)

def sha2_impl(input: i64&, input_length: usize,
              output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 2 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    if input[0] < 0 or input[0] > 5 or input[1] < 0 or input[1] > MAX_MESSAGE_BYTES.i64(): return -1
    variant: usize = input[0].usize()
    message_length: usize = input[1].usize()
    if input_length != 2 + message_length: return -1
    index: mutable usize = 0
    while index < message_length:
        if input[2 + index] < 0 or input[2 + index] > 255: return -1
        index <- index + 1
    digest_lengths: usize[6] = [28, 32, 48, 64, 28, 32]
    digest_length: usize = digest_lengths[variant]
    if digest_length > MAX_OUTPUT_BYTES: return -1
    if output.is_null() or output_capacity < digest_length: return -2

    padded: mutable u8[MAX_PADDED_BYTES] = zeroed
    for index in 0..<message_length:
        padded[index] <- input[2 + index].u8()
    padded[message_length] <- 128
    digest: mutable u8[64] = zeroed
    if variant < 2:
        padded_length: mutable usize = message_length + 1
        while padded_length % 64 != 56:
            padded_length <- padded_length + 1
        padded_length <- padded_length + 8
        bit_length: u64 = message_length.u64() * 8
        for byte in 0..<8:
            padded[padded_length - 1 - byte] <- ((bit_length >> (8 * byte)) & 255).u8()
        state: mutable u32[8] = if variant == 0:
            [0xC1059ED8,0x367CD507,0x3070DD17,0xF70E5939,0xFFC00B31,0x68581511,0x64F98FA7,0xBEFA4FA4]
        else:
            [0x6A09E667,0xBB67AE85,0x3C6EF372,0xA54FF53A,0x510E527F,0x9B05688C,0x1F83D9AB,0x5BE0CD19]
        blocks: usize = padded_length / 64
        for block_index in 0..<blocks:
            sha2_compress32(state&, padded[block_index * 64]&)
        for word in 0..<8:
            for byte in 0..<4:
                out_index: usize = word * 4 + byte
                if out_index < digest_length:
                    digest[out_index] <- ((state[word] >> (24 - 8 * byte)) & 255).u8()
    else:
        padded_length: mutable usize = message_length + 1
        while padded_length % 128 != 112:
            padded_length <- padded_length + 1
        padded_length <- padded_length + 16
        bit_length: u64 = message_length.u64() * 8
        for byte in 0..<8:
            padded[padded_length - 1 - byte] <- ((bit_length >> (8 * byte)) & 255).u8()
        state: mutable u64[8] = if variant == 2:
            [0xCBBB9D5DC1059ED8,0x629A292A367CD507,0x9159015A3070DD17,0x152FECD8F70E5939,0x67332667FFC00B31,0x8EB44A8768581511,0xDB0C2E0D64F98FA7,0x47B5481DBEFA4FA4]
        else if variant == 3:
            [0x6A09E667F3BCC908,0xBB67AE8584CAA73B,0x3C6EF372FE94F82B,0xA54FF53A5F1D36F1,0x510E527FADE682D1,0x9B05688C2B3E6C1F,0x1F83D9ABFB41BD6B,0x5BE0CD19137E2179]
        else if variant == 4:
            [0x8C3D37C819544DA2,0x73E1996689DCD4D6,0x1DFAB7AE32FF9C82,0x679DD514582F9FCF,0x0F6D2B697BD44DA8,0x77E36F7304C48942,0x3F9D85A86A1D36C8,0x1112E6AD91D692A1]
        else:
            [0x22312194FC2BF72C,0x9F555FA3C84C64C2,0x2393B86B6F53B151,0x963877195940EABD,0x96283EE2A88EFFE3,0xBE5E1E2553863992,0x2B0199FC2C85B8AA,0x0EB72DDC81C52CA2]
        blocks: usize = padded_length / 128
        for block_index in 0..<blocks:
            sha2_compress64(state&, padded[block_index * 128]&)
        for word in 0..<8:
            for byte in 0..<8:
                out_index: usize = word * 8 + byte
                if out_index < digest_length:
                    digest[out_index] <- ((state[word] >> (56 - 8 * byte)) & 255).u8()
    for index in 0..<digest_length:
        output[index] <- digest[index]
    digest_length.i64()

export fn sha2(input: i64&, input_length: usize,
               output: mutable u8&, output_capacity: usize) -> i64 = sha2_impl
