const MAX_N: i64 = 12344
const MAX_PARSEABLE_INPUT_LENGTH: usize = 12348
const MAX_TABLE_SIZE: usize = 172816

def sparse_table_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    raw_n: i64 = input[0]
    if raw_n < 1 or raw_n > MAX_N:
        return -1
    n: usize = raw_n.usize()
    if length != n + 3:
        return -1
    raw_left: i64 = input[n + 1]
    raw_right: i64 = input[n + 2]
    if raw_left < 0 or raw_right < raw_left or raw_right >= raw_n:
        return -1
    left: usize = raw_left.usize()
    right: usize = raw_right.usize()

    table: mutable i64[MAX_TABLE_SIZE] = zeroed
    logs: mutable i64[12345] = zeroed
    logs[0] <- -1
    i: mutable usize = 0
    while i < n:
        table[i] <- i.i64()
        increment: mutable i64 = 0
        if (i & (i + 1)) == 0:
            increment <- 1
        logs[i + 1] <- logs[i] + increment
        i <- i + 1
    }

    levels: mutable usize = 1
    span: mutable usize = 2
    while span <= n:
        levels <- levels + 1
        span <- span * 2
    span <- 2
    level: mutable usize = 1
    while level < levels:
        half: usize = span / 2
        i <- 0
        while i + span <= n:
            x: usize = table[(level - 1) * n + i].usize()
            y: usize = table[(level - 1) * n + i + half].usize()
            if input[1 + x] <= input[1 + y]:
                table[level * n + i] <- x.i64()
            else:
                table[level * n + i] <- y.i64()
            i <- i + 1
        span <- span * 2
        level <- level + 1
    }

    query_length: usize = right - left + 1
    query_level: usize = logs[query_length].usize()
    block: mutable usize = 1
    bit: mutable usize = 0
    while bit < query_level:
        block <- block * 2
        bit <- bit + 1
    x: usize = table[query_level * n + left].usize()
    y: usize = table[query_level * n + right - block + 1].usize()
    if input[1 + x] <= input[1 + y]:
        return x.i64()
    y.i64()

export fn sparse_table(input: i64&, length: usize) -> i64 = sparse_table_impl
