const SORTED_LIST_MAX_PARSEABLE_LENGTH: usize = 1025
const SORTED_LIST_CHECKSUM_OFFSET: i64 = 1000000
const SORTED_LIST_MAX_VALUE: i64 = 1000000

def sorted_list_lower_bound(values: view[i64], size: usize, target: i64) -> usize:
    left: mutable usize = 0
    right: mutable usize = size
    while left < right:
        middle: usize = left + (right - left) / 2
        if values[middle] < target:
            left <- middle + 1
        else:
            right <- middle
    left

def sorted_list_impl(input: i64&, length: usize) -> i64:
    if length > SORTED_LIST_MAX_PARSEABLE_LENGTH or (length > 0 and input == null) or (length % 2 != 0):
        return -1
    operation_count: usize = length / 2
    if operation_count > 512: return -1

    items: mutable i64[256] = zeroed
    size: mutable usize = 0
    checksum: mutable i64 = 0
    operation: mutable usize = 0
    while operation < operation_count:
        opcode: i64 = input[2 * operation]
        payload: i64 = input[2 * operation + 1]
        observed: mutable i64 = 0
        has_observation: mutable bool = true

        if opcode == 0:
            if payload < 0 or payload > SORTED_LIST_MAX_VALUE or size >= 256: return -1
            position: usize = sorted_list_lower_bound(items[0:256], size, payload)
            index: mutable usize = size
            while index > position:
                items[index] <- items[index - 1]
                index <- index - 1
            items[position] <- payload
            size <- size + 1
            has_observation <- false
        elif opcode == 1 or opcode == 2:
            if payload < 0 or payload > SORTED_LIST_MAX_VALUE: return -1
            position: usize = sorted_list_lower_bound(items[0:256], size, payload)
            found: bool = position < size and items[position] == payload
            if found: observed <- 1
            if opcode == 2 and found:
                index: mutable usize = position
                while index + 1 < size:
                    items[index] <- items[index + 1]
                    index <- index + 1
                size <- size - 1
        elif opcode == 3:
            if payload != 0: return -1
            observed <- size.i64()
        elif opcode == 4:
            if payload < 0 or payload >= size.i64(): return -1
            observed <- items[payload.usize()]
        elif opcode == 5:
            if payload != 0: return -1
            size <- 0
            has_observation <- false
        else:
            return -1

        if has_observation:
            checksum <- checksum + (operation.i64() + 1) * (observed + SORTED_LIST_CHECKSUM_OFFSET)
        operation <- operation + 1

    index: mutable usize = 0
    while index < size:
        checksum <- checksum + (operation_count.i64() + index.i64() + 1) *
                    (items[index] + SORTED_LIST_CHECKSUM_OFFSET)
        index <- index + 1
    checksum

export fn sorted_list_benchmark(input: i64&, length: usize) -> i64 = sorted_list_impl
