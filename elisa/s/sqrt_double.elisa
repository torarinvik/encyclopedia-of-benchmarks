# Bisection square root matching the pinned C++ update and stopping rule.
def sqrt_double_bisect(value: f64) -> f64:
    low: mutable f64 = 0.0
    high: mutable f64 = value
    # Each midpoint lies between the bounds, so the interval stays ordered.
    while true:
        mid: f64 = (low + high) / 2.0
        square: f64 = mid * mid
        if square > value:
            high <- mid
        else:
            if value - square < 1e-12:
                return mid
            low <- mid
    return -1.0

def sqrt_double_impl(value: f64) -> f64:
    if value == 0.0:
        return 0.0
    if not (value >= 1.0 / 256.0 and value <= 64.0):
        return -1.0
    reciprocal: bool = value < 1.0
    root: f64 = sqrt_double_bisect(1.0 / value if reciprocal else value)
    return 1.0 / root if reciprocal else root

export fn sqrt_double(value: f64) -> f64 = sqrt_double_impl
