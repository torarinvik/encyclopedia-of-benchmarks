# Count minimum swaps needed to order a distinct-value array.
const MAX_VALUES: usize = 256

def swap_position_less(keys: i64&, order: usize&, left: usize, right: usize) -> bool:
    left_index: usize = order[left]
    right_index: usize = order[right]
    return keys[left_index] < keys[right_index] or (keys[left_index] == keys[right_index] and left_index < right_index)

def swap_sift_down(keys: i64&, order: mutable usize&, heap_length: usize, root_value: usize) -> void:
    root: mutable usize = root_value
    while root < heap_length / 2:
        child: mutable usize = root * 2 + 1
        if child + 1 < heap_length and swap_position_less(keys, order, child, child + 1):
            child <- child + 1
        if not swap_position_less(keys, order, root, child):
            break
        temporary: usize = order[root]
        order[root] <- order[child]
        order[child] <- temporary
        root <- child

def swap_sort_impl(values: i64&, length: usize) -> i64:
    if length > MAX_VALUES:
        return -1
    keys: mutable i64[256] = zeroed
    order: mutable usize[256] = zeroed
    visited: mutable bool[256] = zeroed
    index: mutable usize = 0
    while index < length:
        keys[index] <- values[index]
        order[index] <- index
        index <- index + 1
    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        swap_sift_down(&keys[0], &order[0], length, start)
    end: mutable usize = length
    while end > 1:
        end <- end - 1
        temporary: usize = order[0]
        order[0] <- order[end]
        order[end] <- temporary
        swap_sift_down(&keys[0], &order[0], end, 0)
    index <- 1
    while index < length:
        if keys[order[index - 1]] == keys[order[index]]:
            return -1
        index <- index + 1
    swaps: mutable usize = 0
    start <- 0
    while start < length:
        if not visited[start]:
            node: mutable usize = start
            cycle_length: mutable usize = 0
            while not visited[node]:
                visited[node] <- true
                node <- order[node]
                cycle_length <- cycle_length + 1
            if cycle_length > 0:
                swaps <- swaps + cycle_length - 1
        start <- start + 1
    return swaps.i64()

export fn swap_sort(values: i64&, length: usize) -> i64 = swap_sort_impl
