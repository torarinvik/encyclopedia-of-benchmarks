const MAX_INPUT_LENGTH: usize = 70

def feed_hash(hash_value: i64, value: i64) -> i64:
    bits: mutable u64 = hash_value.u64()
    encoded: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        bits <- (bits ^ ((encoded >> (byte * 8)) & 255)) *% 0x100000001b3
        byte <- byte + 1
    bits.i64()

def submatrix_impl(values: i64&, length: usize) -> i64:
    if length < 6 or length > MAX_INPUT_LENGTH:
        return -1
    rows: i64 = values[0]
    cols: i64 = values[1]
    row_start: i64 = values[2]
    col_start: i64 = values[3]
    out_rows: i64 = values[4]
    out_cols: i64 = values[5]
    if rows < 1 or rows > 8 or cols < 1 or cols > 8 or rows * cols > 64 or length != (6 + rows * cols).usize():
        return -1
    if row_start < 0 or row_start > rows or col_start < 0 or col_start > cols or out_rows < 0 or out_rows > rows or out_cols < 0 or out_cols > cols:
        return -1
    if row_start + out_rows > rows or col_start + out_cols > cols:
        return -1
    index: mutable usize = 6
    while index < length:
        if values[index] < -2147483648 or values[index] > 2147483647:
            return -1
        index <- index + 1

    hash_value: mutable i64 = feed_hash(0xCBF29CE484222325.i64(), out_rows)
    hash_value <- feed_hash(hash_value, out_cols)
    r: mutable usize = 0
    while r < out_rows.usize():
        c: mutable usize = 0
        while c < out_cols.usize():
            cell: usize = 6 + (row_start.usize() + r) * cols.usize() + col_start.usize() + c
            hash_value <- feed_hash(hash_value, values[cell])
            c <- c + 1
        r <- r + 1
    hash_value

export fn submatrix(values: i64&, length: usize) -> i64 = submatrix_impl
