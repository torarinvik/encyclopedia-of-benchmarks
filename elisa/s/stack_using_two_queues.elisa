# A LIFO stack from two FIFO queues: each push enqueues the new value into
# the empty queue, drains the other queue behind it, then swaps their roles.
const MAX_OPERATIONS: usize = 128
const MAX_INPUT_LENGTH: usize = 257

# Push value: it leads the empty queue, followed by everything in main_queue.
def stack_push(main_queue: view[i64], temp_queue: mutable view[i64], main_head: usize, main_tail: usize, value: i64) -> usize:
    temp_tail: mutable usize = 0
    temp_queue[temp_tail] <- value
    temp_tail <- temp_tail + 1
    head: mutable usize = main_head
    while head < main_tail:
        temp_queue[temp_tail] <- main_queue[head]
        temp_tail <- temp_tail + 1
        head <- head + 1
    temp_tail

def stack_using_two_queues_impl(input: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    if input[0] < 0 or input[0] > MAX_OPERATIONS.i64() or length != 1 + 2 * input[0].usize():
        return -1

    queue_a: mutable i64[128] = zeroed
    queue_b: mutable i64[128] = zeroed
    tags: mutable i64[128] = zeroed
    results: mutable i64[128] = zeroed
    main_is_a: mutable bool = true
    main_head: mutable usize = 0
    main_tail: mutable usize = 0
    record_count: mutable usize = 0
    position: mutable usize = 1
    operation_count: usize = input[0].usize()
    op_index: mutable usize = 0
    while op_index < operation_count:
        opcode: i64 = input[position]
        operand: i64 = input[position + 1]
        position <- position + 2
        if opcode == 0:
            if operand < -2147483648 or operand > 2147483647:
                return -1
            if main_is_a:
                main_tail <- stack_push(queue_a[0:MAX_OPERATIONS], queue_b[0:MAX_OPERATIONS], main_head, main_tail, operand)
            else:
                main_tail <- stack_push(queue_b[0:MAX_OPERATIONS], queue_a[0:MAX_OPERATIONS], main_head, main_tail, operand)
            main_is_a <- not main_is_a
            main_head <- 0
        elif opcode == 1:
            if operand != 0 or main_head == main_tail:
                return -1
            tags[record_count] <- 0
            results[record_count] <- queue_a[main_head] if main_is_a else queue_b[main_head]
            record_count <- record_count + 1
            main_head <- main_head + 1
        elif opcode == 2:
            if operand != 0:
                return -1
            if main_head == main_tail:
                tags[record_count] <- 1
                results[record_count] <- 0
            else:
                tags[record_count] <- 0
                results[record_count] <- queue_a[main_head] if main_is_a else queue_b[main_head]
            record_count <- record_count + 1
        else:
            return -1
        op_index <- op_index + 1
    output_length: usize = record_count * 16
    if output == null or output_capacity < output_length:
        return -2
    i: mutable usize = 0
    while i < record_count:
        words: u64[2] = [tags[i].u64(), results[i].u64()]
        word: mutable usize = 0
        while word < 2:
            byte: mutable usize = 0
            while byte < 8:
                output[16 * i + 8 * word + byte] <- ((words[word] >> (8 * byte).u64()) & 255).u8()
                byte <- byte + 1
            word <- word + 1
        i <- i + 1
    output_length.i64()

export fn stack_using_two_queues(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stack_using_two_queues_impl
