# The validated limit of 128 operations bounds both queues. Each push
# copies into the other array and can increase the live length by at most one.
def push_new(main_queue: i64&, temp_queue: mutable i64&, head: usize, queue_size: usize, value: i64) -> usize:
    temp_queue[0] <- value
    if queue_size == 1:
        temp_queue[1] <- main_queue[head + 0]
        return 2
    for index in 0.usize()..<queue_size:
        temp_queue[index + 1] <- main_queue[head + index]
    queue_size + 1

def stack_using_two_queues_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length > 257 or (length & 1) == 0: return -1
    if input[0] != (length >> 1).i64(): return -1
    if input[0] == 0:
        return -2 if output == null else 0
    stack_using_two_queues_run(input, input[0].usize(), output, capacity)

@inline(never)
def stack_using_two_queues_run(input: i64&, operation_count: usize, output: mutable u8&?, capacity: usize) -> i64:
    queue_a: mutable i64[128] = zeroed
    queue_b: mutable i64[128] = zeroed
    records: mutable i64[256] = zeroed
    main_is_a: mutable bool = true
    head: mutable usize = 0
    queue_size: mutable usize = 0
    record_count: mutable usize = 0
    position: mutable usize = 1
    operation_index: mutable usize = 0
    while operation_index < operation_count:
        opcode: i64 = input[position]
        operand: i64 = input[position + 1]
        position <- position + 2
        if opcode == 0:
            if operand < -2147483648 or operand > 2147483647: return -1
            if main_is_a:
                queue_size <- push_new(&queue_a[0], &queue_b[0], head, queue_size, operand)
            else:
                queue_size <- push_new(&queue_b[0], &queue_a[0], head, queue_size, operand)
            head <- 0
            main_is_a <- not main_is_a
        elif opcode == 1:
            if operand != 0 or queue_size == 0: return -1
            records[2 * record_count] <- 0
            if main_is_a: records[2 * record_count + 1] <- queue_a[head]
            else: records[2 * record_count + 1] <- queue_b[head]
            record_count <- record_count + 1
            head <- head + 1
            queue_size <- queue_size - 1
        elif opcode == 2:
            if operand != 0: return -1
            if queue_size == 0:
                records[2 * record_count] <- 1
                records[2 * record_count + 1] <- 0
            else:
                records[2 * record_count] <- 0
                if main_is_a: records[2 * record_count + 1] <- queue_a[head]
                else: records[2 * record_count + 1] <- queue_b[head]
            record_count <- record_count + 1
        else:
            return -1
        operation_index <- operation_index + 1
    output_length: usize = record_count * 16
    if output == null or capacity < output_length: return -2
    for index in 0..<2 * record_count:
        bits: u64 = records[index].u64()
        for byte in 0..<8:
            output[index * 8 + byte] <- (bits >> (byte * 8)).u8()
    output_length.i64()

export fn stack_using_two_queues(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stack_using_two_queues_impl
