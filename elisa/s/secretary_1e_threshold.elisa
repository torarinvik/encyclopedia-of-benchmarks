const MAX_N: usize = 16
const MAX_INPUT: usize = 17

def sample_count(n:usize)->usize:
    if n==3:return 1
    if n==4:return 1
    if n==5:return 1
    if n==6:return 2
    if n==7:return 2
    if n==8:return 2
    if n==9:return 3
    if n==10:return 3
    if n==11:return 4
    if n==12:return 4
    if n==13:return 4
    if n==14:return 5
    if n==15:return 5
    return 5

def put64(value:i64,output:mutable view[u8],pos:usize)->void:
    bits:u64=value.u64()
    j:mutable usize=0
    while j<8:
        output[pos+j]<-((bits>>(8*j))&255).u8()
        j<-j+1

def secretary_1e_threshold(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("secretary_1e_threshold"):
    if input.is_null() or length<4 or length>MAX_INPUT:return -1
    n64:i64=input[0]
    if n64<3 or n64>16 or length!=n64.usize()+1:return -1
    n:usize=n64.usize();seen:mutable u8[17]=zeroed;i:mutable usize=0
    while i<n:
        rank:i64=input[i+1]
        if rank<1 or rank>n64 or seen[rank.usize()]!=0:return -1
        seen[rank.usize()]<-1
        i<-i+1
    observed:usize=sample_count(n);threshold:i64=input[1];i<-1
    while i<observed:
        if input[i+1]>threshold:threshold<-input[i+1]
        i<-i+1
    selected:mutable i64=-1;i<-observed
    while i<n:
        if input[i+1]>threshold:selected<-i.i64();break
        i<-i+1
    if output.is_null() or capacity<8:return -2
    staged:mutable u8[8]=zeroed;put64(selected,staged[0:8],0);i<-0
    while i<8:output[i]<-staged[i];i<-i+1
    return 8
