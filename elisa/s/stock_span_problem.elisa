# Return source-compatible spans for a bounded price sequence.
def stock_span_problem_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 66:
        return -1
    count_value: i64 = input[0]
    if count_value < 1 or count_value > 64:
        return -1
    count: usize = count_value.usize()
    if length != count + 1:
        return -1
    day: mutable usize = 0
    while day < count:
        if input[day + 1] < -2147483648 or input[day + 1] > 2147483647:
            return -1
        day <- day + 1

    output_bytes: usize = count * 8
    if output == null or capacity < output_bytes:
        return -2
    decreasing: mutable usize[64] = zeroed
    top: mutable usize = 0
    day <- 0
    while day < count:
        price: i64 = input[day + 1]
        while top != 0 and input[decreasing[top - 1] + 1] <= price:
            top <- top - 1
        span: usize = day + 1 if top == 0 else day - decreasing[top - 1]
        encoded: u64 = span.u64()
        byte: mutable usize = 0
        while byte < 8:
            output[day * 8 + byte] <- ((encoded >> (byte * 8).u64()) & 255).u8()
            byte <- byte + 1
        decreasing[top] <- day
        top <- top + 1
        day <- day + 1
    count.i64()

export fn stock_span_problem(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = stock_span_problem_impl
