@intrinsic("llvm.ctlz.i64")
extern stock_span_leading_zeroes(bits: u64, zero_undefined: bool) -> u64

def stock_span_problem_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 66: return -1
    count_value: i64 = input[0]
    if count_value < 1 or count_value > 64: return -1
    count: usize = count_value.usize()
    if length != count + 1: return -1
    day: mutable usize = 0
    while day < count:
        price: i64 = input[day + 1]
        if price < -2147483648 or price > 2147483647: return -1
        day <- day + 1

    output_bytes: usize = count * 8
    if output == null or capacity < output_bytes: return -2
    if count == 1:
        output[0] <- 1
        for byte in 1..<8:
            output[byte] <- 0
        return 1
    # The highest set bit is the latest day in the monotone stack.
    decreasing: mutable u64 = 0
    day <- 0
    while day < count:
        price: i64 = input[day + 1]
        span: mutable usize = day+1
        while decreasing != 0:
            previous: usize = (63-stock_span_leading_zeroes(decreasing, true)).usize()
            if input[previous+1] > price:
                span <- day-previous
                break
            decreasing <- decreasing ^ (1.u64() << previous)
        encoded: mutable u64 = span.u64()
        byte: mutable usize = 0
        while byte < 8:
            output[day * 8 + byte] <- (encoded & 255).u8()
            encoded <- encoded >> 8
            byte <- byte + 1
        decreasing <- decreasing | (1.u64() << day)
        day <- day + 1
    count_value

export fn stock_span_problem(input: i64&?, length: usize,
    output: mutable u8&?, capacity: usize) -> i64 = stock_span_problem_impl
