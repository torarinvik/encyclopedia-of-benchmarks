@intrinsic("llvm.cttz.i64")
extern mt_pair_index(bits: u64, zero_undefined: bool) -> u64

@intrinsic("llvm.cttz.i32")
extern mt_edge_index(bits: u32, zero_undefined: bool) -> u32

const MT_N: usize = 8
const MT_M: usize = 14
const MT_MAX_INPUT: usize = 54
const MT_MAX_OUTPUT: usize = 72
# A shortest path uses at most seven edges of weight at most nine.
const MT_UNREACHED: u32 = 256 << 3

# The eight component labels occupy consecutive three-bit fields.
const MT_SINGLETON_LABELS: u32 = 0xfac688
const MT_LABEL_LOW_BITS: u32 = 0x249249

def mt_label(labels: u32, vertex: usize) -> u32:
    (labels >> (3*vertex)) & 7

def mt_join(labels: mutable u32&, a: usize, b: usize) -> bool:
    first: u32 = mt_label(labels, a)
    second: u32 = mt_label(labels, b)
    if first == second:
        return false
    different: u32 = labels ^ (second * MT_LABEL_LOW_BITS)
    matching: u32 = ~(different | (different >> 1) | (different >> 2)) & MT_LABEL_LOW_BITS
    labels <- labels ^ (matching * (first ^ second))
    true

def mt_put_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for i in 0..<8:
        output[offset+i] <- (bits & 255).u8()
        bits <- bits >> 8

def mt_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length > MT_MAX_INPUT:
        return -1
    if length < 3 or length > MT_MAX_INPUT:
        return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    k0: i64 = input[2]
    if n0 < 2 or n0 > MT_N.i64() or m0 < 1 or m0 > MT_M.i64() or k0 < 2 or k0 > n0:
        return -1
    n: usize = n0.usize()
    m: usize = m0.usize()
    k: usize = k0.usize()
    if length < 3+k+3*m:
        return -1
    terminals: mutable usize[MT_N] = zeroed
    terminal_mask: mutable u32 = 0
    at: mutable usize = 3
    for i in 0..<k:
        raw: i64 = input[at]
        at <- at+1
        if raw < 0 or raw >= n0:
            return -1
        t: usize = raw.usize()
        terminal_bit: u32 = 1.u32() << t
        if (terminal_mask & terminal_bit) != 0:
            return -1
        terminals[i] <- t
        terminal_mask <- terminal_mask | terminal_bit
    # Store each edge in the same format as an all-terminal Kruskal candidate.
    edges: mutable u32[16] = zeroed
    input_labels: mutable u32 = MT_SINGLETON_LABELS
    incident: mutable u32[MT_N] = zeroed
    pair_seen: mutable u64 = 0
    edge: mutable usize = 0
    while edge < m:
        u0: i64 = input[at]
        v0: i64 = input[at+1]
        w: i64 = input[at+2]
        at <- at+3
        if u0 < 0 or u0 >= v0 or v0 >= n0 or w < 1 or w > 9:
            return -1
        u: usize = u0.usize()
        v: usize = v0.usize()
        pair_bit: u64 = 1.u64() << (u*MT_N+v)
        if (pair_seen & pair_bit) != 0:
            return -1
        pair_seen <- pair_seen | pair_bit
        edges[edge & 15] <- (w.u32() << 16) | (u.u32() << 13) | (v.u32() << 10) | edge.u32()
        mt_join(&input_labels, u, v)
        bit: u32 = 1.u32() << edge
        incident[u] <- incident[u] | bit
        incident[v] <- incident[v] | bit
        edge <- edge+1
    if at != length:
        return -1

    first_component: u32 = mt_label(input_labels, 0)
    for vertex in 1..<n:
        if mt_label(input_labels, vertex) != first_component:
            return -1
    vertex: mutable usize = 0

    # Order by distance, then by owner in the low three bits.
    distance_key: mutable u32[MT_N] = zeroed
    # The predecessor vertex occupies the high bits for tie-breaking.
    predecessor: mutable u8[MT_N] = zeroed
    settled: mutable u32 = 0
    if k == n:
        for vertex in 0..<n:
            distance_key[vertex] <- vertex.u32()
    else:
        vertex <- 0
        while vertex < n:
            distance_key[vertex] <- MT_UNREACHED
            predecessor[vertex] <- 255
            vertex <- vertex+1
        for i in 0..<k:
            t: usize = terminals[i]
            distance_key[t] <- t.u32()
        step: mutable usize = 0
        while step < n:
            chosen_vertex: mutable usize = MT_N
            chosen_key: mutable u32 = MT_UNREACHED
            vertex <- 0
            while vertex < n:
                if (settled & (1.u32() << vertex)) == 0 and distance_key[vertex] < chosen_key:
                    chosen_vertex <- vertex
                    chosen_key <- distance_key[vertex]
                vertex <- vertex+1
            if chosen_vertex == MT_N:
                break
            settled <- settled | (1.u32() << chosen_vertex)
            pending: mutable u32 = incident[chosen_vertex]
            while pending != 0:
                edge <- mt_edge_index(pending, true).usize()
                pending <- pending & (pending - 1)
                next_vertex: usize = ((edges[edge & 15] >> 13) & 7).usize() ^ ((edges[edge & 15] >> 10) & 7).usize() ^ chosen_vertex
                if (settled & (1.u32() << next_vertex)) != 0:
                    continue
                next_key: u32 = chosen_key + ((edges[edge & 15] >> 16) << 3)
                route: u8 = ((chosen_vertex << 4) | edge).u8()
                if next_key < distance_key[next_vertex]:
                    distance_key[next_vertex] <- next_key
                    predecessor[next_vertex] <- route
                elif next_key == distance_key[next_vertex] and route < predecessor[next_vertex]:
                    predecessor[next_vertex] <- route
            step <- step+1
        vertex <- 0
        while vertex < n:
            if distance_key[vertex] == MT_UNREACHED:
                return -1
            vertex <- vertex+1

    candidates: mutable u32[16] = zeroed
    cn: mutable usize = 0
    if k == n:
        # Each edge already connects its own pair of terminal owners.
        for index in 0..<m:
            candidates[index & 15] <- edges[index & 15]
        cn <- m
    else:
        best_candidate: mutable u32[64] = zeroed
        occupied_pairs: mutable u64 = 0
        edge <- 0
        while edge < m:
            u: usize = ((edges[edge & 15] >> 13) & 7).usize()
            v: usize = ((edges[edge & 15] >> 10) & 7).usize()
            a: mutable usize = (distance_key[u] & 7).usize()
            b: mutable usize = (distance_key[v] & 7).usize()
            if a != b:
                left: mutable usize = u
                right: mutable usize = v
                if a > b:
                    tmp: usize = a
                    a <- b
                    b <- tmp
                    left <- v
                    right <- u
                ix: usize = a*MT_N+b
                cw: u32 = (distance_key[u] >> 3) + (edges[edge & 15] >> 16) + (distance_key[v] >> 3)
                # The key orders weight, owners, endpoints and original edge ID.
                key: u32 = (cw << 16) | (a.u32() << 13) | (b.u32() << 10) | (left.u32() << 7) | (right.u32() << 4) | edge.u32()
                occupied_pairs <- occupied_pairs | (1.u64() << ix)
                previous: u32 = best_candidate[ix & 63]
                if previous == 0 or key < previous:
                    best_candidate[ix & 63] <- key
            edge <- edge+1
        while occupied_pairs != 0:
            pair: usize = mt_pair_index(occupied_pairs, true).usize()
            occupied_pairs <- occupied_pairs & (occupied_pairs - 1)
            candidates[cn & 15] <- best_candidate[pair & 63]
            cn <- cn+1
    i: mutable usize = 1
    j: mutable usize = 0
    while i < cn:
        key: u32 = candidates[i & 15]
        j <- i
        while j > 0 and key < candidates[(j-1) & 15]:
            candidates[j & 15] <- candidates[(j-1) & 15]
            j <- j-1
        candidates[j & 15] <- key
        i <- i+1
    labels: mutable u32 = MT_SINGLETON_LABELS
    tree: mutable u32 = 0
    count: mutable usize = 0
    cost: mutable u32 = 0
    chosen: mutable usize[MT_N] = zeroed
    ch: mutable usize = 0
    i <- 0
    while i < cn and ch < k-1:
        key: u32 = candidates[i & 15]
        if mt_join(&labels, ((key >> 13) & 7).usize(), ((key >> 10) & 7).usize()):
            if k == n:
                tree <- tree | (1.u32() << (key & 15))
                cost <- cost+(key >> 16)
            else:
                chosen[ch] <- i
            ch <- ch+1
        i <- i+1
    if ch != k-1:
        return -1
    if k == n:
        # The first Kruskal pass already produced the required tree.
        count <- ch
    else:
        used: mutable u32 = 0
        ix: mutable usize = 0
        i <- 0
        while i < ch:
            ix <- chosen[i]
            key: u32 = candidates[ix & 15]
            used <- used | (1.u32() << (key & 15))
            x: mutable usize = ((key >> 7) & 7).usize()
            while x != ((key >> 13) & 7).usize():
                route: u8 = predecessor[x]
                if route == 255:
                    return -1
                used <- used | (1.u32() << (route & 15).usize())
                x <- (route >> 4).usize()
            x <- ((key >> 4) & 7).usize()
            while x != ((key >> 10) & 7).usize():
                route: u8 = predecessor[x]
                if route == 255:
                    return -1
                used <- used | (1.u32() << (route & 15).usize())
                x <- (route >> 4).usize()
            i <- i+1
        order: mutable u32[16] = zeroed
        on: mutable usize = 0
        while used != 0:
            edge <- mt_edge_index(used, true).usize()
            used <- used & (used - 1)
            key: u32 = ((edges[edge & 15] >> 16) << 4) | edge.u32()
            j <- on
            while j > 0 and key < order[(j-1) & 15]:
                order[j & 15] <- order[(j-1) & 15]
                j <- j-1
            order[j & 15] <- key
            on <- on+1
        labels <- MT_SINGLETON_LABELS
        degree: mutable usize[MT_N] = zeroed
        for index in 0..<on:
            key: u32 = order[index & 15]
            e: usize = (key & 15).usize()
            u: usize = ((edges[e & 15] >> 13) & 7).usize()
            v: usize = ((edges[e & 15] >> 10) & 7).usize()
            if mt_join(&labels, u, v):
                tree <- tree | (1.u32() << e)
                degree[u] <- degree[u]+1
                degree[v] <- degree[v]+1
                count <- count+1
                cost <- cost+(key >> 4)
        first_label: u32 = mt_label(labels, terminals[0])
        for index in 1..<k:
            if mt_label(labels, terminals[index]) != first_label:
                return -1
        leaves: mutable usize[MT_N] = zeroed
        queued: mutable bool[MT_N] = zeroed
        head: mutable usize = 0
        queue_end: mutable usize = 0
        vertex <- 0
        while vertex < n:
            if not ((terminal_mask & (1.u32() << vertex)) != 0) and degree[vertex] <= 1:
                leaves[queue_end] <- vertex
                queue_end <- queue_end+1
                queued[vertex] <- true
            vertex <- vertex+1
        while head < queue_end:
            u: usize = leaves[head]
            head <- head+1
            if degree[u] > 1:
                continue
            pending: u32 = incident[u] & tree
            if pending != 0:
                edge <- mt_edge_index(pending, true).usize()
                tree <- tree ^ pending
                count <- count-1
                cost <- cost-(edges[edge & 15] >> 16)
                v: usize = ((edges[edge & 15] >> 13) & 7).usize() ^ ((edges[edge & 15] >> 10) & 7).usize() ^ u
                degree[u] <- 0
                degree[v] <- degree[v]-1
                if not ((terminal_mask & (1.u32() << v)) != 0) and degree[v] <= 1 and not queued[v]:
                    leaves[queue_end] <- v
                    queue_end <- queue_end+1
                    queued[v] <- true
    if count == 0 or count > n-1:
        return -1
    bytes: usize = (2+count)*8
    if output == null or capacity < bytes:
        return -2
    mt_put_i64(output,0,cost.i64())
    mt_put_i64(output,8,count.i64())
    i <- 0
    while tree != 0:
        edge <- mt_edge_index(tree, true).usize()
        tree <- tree & (tree - 1)
        mt_put_i64(output,16+i*8,edge.i64())
        i <- i+1
    bytes.i64()


export fn steiner_tree_mehlhorn_voronoi_mst(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = mt_impl
