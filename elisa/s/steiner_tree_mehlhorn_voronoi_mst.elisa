# Mehlhorn's Steiner tree approximation: terminal Voronoi regions by
# multi-source Dijkstra, Kruskal over the cheapest bridge per region pair,
# path expansion, an MST of the expanded edges and non-terminal leaf pruning.
const MAX_N: usize = 8
const MAX_M: usize = 14
const MAX_INPUT: usize = 54
const MAX_OUTPUT: usize = 72
const INF: i64 = 0x3fffffffffffffff

struct SteinerEdge:
    u: usize
    v: usize
    weight: i64

struct SteinerCandidate:
    a: u32
    b: u32
    left: u32
    right: u32
    edge: u32
    weight: i64

struct SteinerResult:
    cost: i64
    count: usize

def steiner_find_root(parent: mutable view[usize], start: usize) -> usize:
    x: mutable usize = start
    while parent[x] != x:
        parent[x] <- parent[parent[x]]
        x <- parent[x]
    x

def steiner_join(parent: mutable view[usize], rank: mutable view[i64], first: usize, second: usize) -> bool:
    root_a: mutable usize = steiner_find_root(parent, first)
    root_b: mutable usize = steiner_find_root(parent, second)
    if root_a == root_b:
        return false
    if rank[root_a] < rank[root_b]:
        swap: usize = root_a
        root_a <- root_b
        root_b <- swap
    parent[root_b] <- root_a
    if rank[root_a] == rank[root_b]:
        rank[root_a] <- rank[root_a] + 1
    true

def steiner_candidate_before(x: SteinerCandidate, y: SteinerCandidate) -> bool:
    if x.weight != y.weight:
        return x.weight < y.weight
    if x.a != y.a:
        return x.a < y.a
    if x.b != y.b:
        return x.b < y.b
    if x.left != y.left:
        return x.left < y.left
    if x.right != y.right:
        return x.right < y.right
    x.edge < y.edge

def steiner_edge_before(edges: view[SteinerEdge], first: usize, second: usize) -> bool:
    if edges[first].weight != edges[second].weight:
        return edges[first].weight < edges[second].weight
    first < second

# The endpoint of edge opposite to vertex, or -1 when edge does not touch it.
def steiner_other(edge: SteinerEdge, vertex: usize) -> i64:
    if edge.u == vertex:
        return edge.v.i64()
    if edge.v == vertex:
        return edge.u.i64()
    -1

def steiner_parse(input: i64&, length: usize, terminals: mutable view[usize], edges: mutable view[SteinerEdge]) -> bool:
    if length < 3 or length > MAX_INPUT:
        return false
    n0: i64 = input[0]
    m0: i64 = input[1]
    k0: i64 = input[2]
    if n0 < 2 or n0 > MAX_N.i64() or m0 < 1 or m0 > MAX_M.i64() or k0 < 2 or k0 > n0:
        return false
    n: usize = n0.usize()
    m: usize = m0.usize()
    k: usize = k0.usize()
    if length < 3 + k + 3 * m:
        return false
    is_terminal: mutable bool[8] = zeroed
    at: mutable usize = 3
    i: mutable usize = 0
    while i < k:
        t: i64 = input[at]
        at <- at + 1
        if t < 0 or t >= n0 or is_terminal[t.usize()]:
            return false
        terminals[i] <- t.usize()
        is_terminal[t.usize()] <- true
        i <- i + 1
    seen: mutable u32[8] = zeroed
    e: mutable usize = 0
    while e < m:
        u: i64 = input[at]
        v: i64 = input[at + 1]
        w: i64 = input[at + 2]
        at <- at + 3
        if u < 0 or u >= v or v >= n0 or w < 1 or w > 9:
            return false
        if (seen[u.usize()] & (1.u32() << v.u32())) != 0:
            return false
        seen[u.usize()] <- seen[u.usize()] | (1.u32() << v.u32())
        edges[e] <- SteinerEdge{u: u.usize(), v: v.usize(), weight: w}
        e <- e + 1
    if at != length:
        return false
    reached: mutable bool[8] = zeroed
    queue: mutable usize[8] = zeroed
    queue_start: mutable usize = 0
    queue_end: mutable usize = 0
    reached[0] <- true
    queue[queue_end] <- 0
    queue_end <- queue_end + 1
    while queue_start < queue_end:
        u: usize = queue[queue_start]
        queue_start <- queue_start + 1
        e <- 0
        while e < m:
            v: i64 = steiner_other(edges[e], u)
            if v >= 0 and not reached[v.usize()]:
                reached[v.usize()] <- true
                queue[queue_end] <- v.usize()
                queue_end <- queue_end + 1
            e <- e + 1
    v: mutable usize = 0
    while v < n:
        if not reached[v]:
            return false
        v <- v + 1
    true

def steiner_solve(n: usize, m: usize, k: usize, terminals: view[usize], edges: view[SteinerEdge], result_edges: mutable view[usize]) -> SteinerResult:
    failed: SteinerResult = SteinerResult{cost: 0, count: 0}
    dist: mutable i64[8] = zeroed
    owner: mutable usize[8] = zeroed
    pred: mutable i64[8] = zeroed
    pred_edge: mutable i64[8] = zeroed
    settled: mutable bool[8] = zeroed
    v: mutable usize = 0
    while v < n:
        dist[v] <- INF
        owner[v] <- n
        pred[v] <- -1
        pred_edge[v] <- -1
        v <- v + 1
    i: mutable usize = 0
    while i < k:
        dist[terminals[i]] <- 0
        owner[terminals[i]] <- terminals[i]
        i <- i + 1
    iteration: mutable usize = 0
    while iteration < n:
        chosen: mutable i64 = -1
        v <- 0
        while v < n:
            if not settled[v]:
                if chosen < 0:
                    chosen <- v.i64()
                else:
                    u: usize = chosen.usize()
                    if dist[v] < dist[u] or (dist[v] == dist[u] and (owner[v] < owner[u] or (owner[v] == owner[u] and v < u))):
                        chosen <- v.i64()
            v <- v + 1
        if chosen < 0 or dist[chosen.usize()] == INF:
            break
        u: usize = chosen.usize()
        settled[u] <- true
        e: mutable usize = 0
        while e < m:
            other: i64 = steiner_other(edges[e], u)
            if other >= 0:
                target: usize = other.usize()
                next_distance: i64 = dist[u] + edges[e].weight
                if next_distance < dist[target] or (next_distance == dist[target] and owner[u] < owner[target]):
                    dist[target] <- next_distance
                    owner[target] <- owner[u]
                    pred[target] <- u.i64()
                    pred_edge[target] <- e.i64()
                elif next_distance == dist[target] and owner[u] == owner[target] and not settled[target] and (pred[target] < 0 or u.i64() < pred[target] or (u.i64() == pred[target] and e.i64() < pred_edge[target])):
                    pred[target] <- u.i64()
                    pred_edge[target] <- e.i64()
            e <- e + 1
        iteration <- iteration + 1
    v <- 0
    while v < n:
        if dist[v] == INF or owner[v] == n:
            return failed
        v <- v + 1

    best: mutable SteinerCandidate[64] = zeroed
    has: mutable bool[64] = zeroed
    e: mutable usize = 0
    while e < m:
        u: usize = edges[e].u
        w: usize = edges[e].v
        a: mutable usize = owner[u]
        b: mutable usize = owner[w]
        if a != b:
            left: mutable usize = u
            right: mutable usize = w
            if a > b:
                swap: usize = a
                a <- b
                b <- swap
                left <- w
                right <- u
            candidate: SteinerCandidate = SteinerCandidate{a: a.u32(), b: b.u32(), left: left.u32(), right: right.u32(), edge: e.u32(), weight: dist[u] + edges[e].weight + dist[w]}
            old: SteinerCandidate = best[a * MAX_N + b]
            if not has[a * MAX_N + b] or candidate.weight < old.weight or (candidate.weight == old.weight and (candidate.left < old.left or (candidate.left == old.left and (candidate.right < old.right or (candidate.right == old.right and candidate.edge < old.edge))))):
                best[a * MAX_N + b] <- candidate
                has[a * MAX_N + b] <- true
        e <- e + 1
    candidates: mutable SteinerCandidate[14] = zeroed
    candidate_count: mutable usize = 0
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a + 1
        while b < n:
            if has[a * MAX_N + b]:
                candidates[candidate_count] <- best[a * MAX_N + b]
                candidate_count <- candidate_count + 1
            b <- b + 1
        a <- a + 1
    i <- 1
    while i < candidate_count:
        x: SteinerCandidate = candidates[i]
        j: mutable usize = i
        while j > 0 and steiner_candidate_before(x, candidates[j - 1]):
            candidates[j] <- candidates[j - 1]
            j <- j - 1
        candidates[j] <- x
        i <- i + 1
    parent: mutable usize[8] = zeroed
    rank: mutable i64[8] = zeroed
    chosen: mutable usize[8] = zeroed
    chosen_count: mutable usize = 0
    v <- 0
    while v < n:
        parent[v] <- v
        v <- v + 1
    i <- 0
    while i < candidate_count and chosen_count < k - 1:
        if steiner_join(parent[0:MAX_N], rank[0:MAX_N], candidates[i].a.usize(), candidates[i].b.usize()):
            chosen[chosen_count] <- i
            chosen_count <- chosen_count + 1
        i <- i + 1
    if chosen_count != k - 1:
        return failed

    used: mutable bool[14] = zeroed
    i <- 0
    while i < chosen_count:
        c: SteinerCandidate = candidates[chosen[i]]
        used[c.edge.usize()] <- true
        x: mutable usize = c.left.usize()
        while x != c.a.usize():
            if pred_edge[x] < 0:
                return failed
            used[pred_edge[x].usize()] <- true
            x <- pred[x].usize()
        x <- c.right.usize()
        while x != c.b.usize():
            if pred_edge[x] < 0:
                return failed
            used[pred_edge[x].usize()] <- true
            x <- pred[x].usize()
        i <- i + 1

    order: mutable usize[14] = zeroed
    order_count: mutable usize = 0
    e <- 0
    while e < m:
        if used[e]:
            order[order_count] <- e
            order_count <- order_count + 1
        e <- e + 1
    i <- 1
    while i < order_count:
        x: usize = order[i]
        j: mutable usize = i
        while j > 0 and steiner_edge_before(edges, x, order[j - 1]):
            order[j] <- order[j - 1]
            j <- j - 1
        order[j] <- x
        i <- i + 1
    v <- 0
    while v < n:
        parent[v] <- v
        v <- v + 1
    v <- 0
    while v < n:
        rank[v] <- 0
        v <- v + 1
    tree: mutable bool[14] = zeroed
    i <- 0
    while i < order_count:
        edge: usize = order[i]
        if steiner_join(parent[0:MAX_N], rank[0:MAX_N], edges[edge].u, edges[edge].v):
            tree[edge] <- true
        i <- i + 1
    root: usize = steiner_find_root(parent[0:MAX_N], terminals[0])
    i <- 1
    while i < k:
        if steiner_find_root(parent[0:MAX_N], terminals[i]) != root:
            return failed
        i <- i + 1

    terminal_flag: mutable bool[8] = zeroed
    degree: mutable i64[8] = zeroed
    incident: mutable bool[112] = zeroed
    i <- 0
    while i < k:
        terminal_flag[terminals[i]] <- true
        i <- i + 1
    e <- 0
    while e < m:
        if tree[e]:
            degree[edges[e].u] <- degree[edges[e].u] + 1
            degree[edges[e].v] <- degree[edges[e].v] + 1
            incident[edges[e].u * MAX_M + e] <- true
            incident[edges[e].v * MAX_M + e] <- true
        e <- e + 1
    queue: mutable usize[16] = zeroed
    queued: mutable bool[8] = zeroed
    queue_start: mutable usize = 0
    queue_end: mutable usize = 0
    v <- 0
    while v < n:
        if not terminal_flag[v] and degree[v] <= 1:
            queue[queue_end] <- v
            queue_end <- queue_end + 1
            queued[v] <- true
        v <- v + 1
    while queue_start < queue_end:
        u: usize = queue[queue_start]
        queue_start <- queue_start + 1
        if degree[u] <= 1:
            e <- 0
            while e < m:
                if tree[e] and incident[u * MAX_M + e]:
                    tree[e] <- false
                    w: usize = edges[e].v if edges[e].u == u else edges[e].u
                    degree[u] <- degree[u] - 1
                    degree[w] <- degree[w] - 1
                    if not terminal_flag[w] and degree[w] <= 1 and not queued[w]:
                        queue[queue_end] <- w
                        queue_end <- queue_end + 1
                        queued[w] <- true
                e <- e + 1
    count: mutable usize = 0
    cost: mutable i64 = 0
    e <- 0
    while e < m:
        if tree[e]:
            result_edges[count] <- e
            count <- count + 1
            cost <- cost + edges[e].weight
        e <- e + 1
    if count == 0 or count > n - 1:
        return failed
    SteinerResult{cost: cost, count: count}

def steiner_put_i64(output: mutable u8&, at: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    i: mutable usize = 0
    while i < 8:
        output[at + i] <- (bits & 255).u8()
        bits <- bits >> 8
        i <- i + 1

def steiner_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_INPUT:
        return -1
    terminals: mutable usize[8] = zeroed
    edges: mutable SteinerEdge[14] = zeroed
    result_edges: mutable usize[14] = zeroed
    if not steiner_parse(input, length, terminals[0:MAX_N], edges[0:MAX_M]):
        return -1
    n: usize = input[0].usize()
    m: usize = input[1].usize()
    k: usize = input[2].usize()
    result: SteinerResult = steiner_solve(n, m, k, terminals[0:MAX_N], edges[0:MAX_M], result_edges[0:MAX_M])
    if result.count == 0:
        return -1
    bytes: usize = (2 + result.count) * 8
    if output == null or capacity < bytes or bytes > MAX_OUTPUT:
        return -2
    steiner_put_i64(output, 0, result.cost)
    steiner_put_i64(output, 8, result.count.i64())
    i: mutable usize = 0
    while i < result.count:
        steiner_put_i64(output, 16 + i * 8, result_edges[i].i64())
        i <- i + 1
    bytes.i64()

export fn steiner_tree_mehlhorn_voronoi_mst(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = steiner_impl
