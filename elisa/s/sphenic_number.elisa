def source_sieve_flag(value: i64) -> bool:
    if value < 2:
        return true
    divisor: mutable i64 = 2
    while divisor <= value / divisor:
        if value % divisor == 0:
            return false
        divisor <- divisor + 1
    true

def sphenic_number_impl(value: i64) -> i64:
    if value < 0 or value > 1000:
        return -1
    first: mutable i64[3] = zeroed
    count: mutable i64 = 0
    divisor: mutable i64 = 1
    while divisor <= value:
        if value % divisor == 0 and count < 9:
            if count < 3:
                first[count.usize()] <- divisor
            count <- count + 1
        divisor <- divisor + 1
    if count == 8 and source_sieve_flag(first[0]) and source_sieve_flag(first[1]) and source_sieve_flag(first[2]):
        return 1
    0

export fn sphenic_number(value: i64) -> i64 = sphenic_number_impl
