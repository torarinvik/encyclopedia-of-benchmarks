const MAX_N: usize = 3
const MAX_M: usize = 3
const MAX_CUTS: usize = 45
const MAX_INPUT: usize = 12

def cut_popcount(value0: u64) -> usize:
    bits: mutable u64 = value0
    count: mutable usize = 0
    while bits != 0:
        bits <- bits & (bits - 1)
        count <- count + 1
    count

def cut_shift(cut: u64, n: usize, delay: usize) -> u64:
    result: mutable u64 = 0
    bit: mutable usize = 0
    while bit < 3*n:
        if (cut & (1.u64() << bit)) != 0:
            next_delay: usize = bit % 3 + delay
            if next_delay > 2: return 18446744073709551615.u64()
            result <- result | (1.u64() << (3*(bit/3)+next_delay))
        bit <- bit + 1
    result

def cut_add(cuts: mutable u64[MAX_N*MAX_CUTS], counts: mutable usize[MAX_N], node: usize, mask: u64, k: usize):
    if cut_popcount(mask) > k: return
    i: mutable usize = 0
    while i < counts[node]:
        if cuts[node*MAX_CUTS+i] == mask: return
        i <- i+1
    if counts[node] < MAX_CUTS:
        cuts[node*MAX_CUTS+counts[node]] <- mask
        counts[node] <- counts[node]+1

def cut_put_i64(value: i64, output: mutable view[u8], word: usize):
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[word*8+byte] <- ((bits>>(8*byte))&255).u8()
        byte <- byte+1

def sequential_lut_k_cut_enumeration(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("sequential_lut_k_cut_enumeration"):
    if input.is_null() or length < 3 or length > MAX_INPUT: return -1
    n0:i64=input[0]; k0:i64=input[1]; m0:i64=input[2]
    if n0<1 or n0>3 or k0<1 or k0>2 or m0<0 or m0>3 or length!=(3+3*m0).usize():return -1
    n:usize=n0.usize(); k:usize=k0.usize(); m:usize=m0.usize()
    edge_u:mutable usize[MAX_M]=zeroed; edge_v:mutable usize[MAX_M]=zeroed; edge_d:mutable usize[MAX_M]=zeroed
    e:mutable usize=0
    while e<m:
        u:i64=input[3+3*e]; v:i64=input[4+3*e]; d:i64=input[5+3*e]
        if u<0 or v<=u or v>=n0 or (d!=0 and d!=1):return -1
        j:mutable usize=0
        while j<e:
            if edge_u[j]==u.usize() and edge_v[j]==v.usize() and edge_d[j]==d.usize():return -1
            j<-j+1
        edge_u[e]<-u.usize();edge_v[e]<-v.usize();edge_d[e]<-d.usize();e<-e+1
    in_u:mutable usize[MAX_N*MAX_M]=zeroed; in_d:mutable usize[MAX_N*MAX_M]=zeroed; degree:mutable usize[MAX_N]=zeroed
    e<-0
    while e<m:
        v:=edge_v[e]; slot:=degree[v];in_u[v*MAX_M+slot]<-edge_u[e];in_d[v*MAX_M+slot]<-edge_d[e];degree[v]<-degree[v]+1;e<-e+1
    cuts:mutable u64[MAX_N*MAX_CUTS]=zeroed; counts:mutable usize[MAX_N]=zeroed
    v:mutable usize=0
    while v<n:
        cut_add(cuts,counts,v,1.u64()<<(3*v),k)
        if degree[v]>0:
            c0:usize=counts[in_u[v*MAX_M]];c1:usize=1;c2:usize=1
            if degree[v]>1:c1<-counts[in_u[v*MAX_M+1]]
            if degree[v]>2:c2<-counts[in_u[v*MAX_M+2]]
            a:mutable usize=0
            while a<c0:
                b:mutable usize=0
                while b<c1:
                    c:mutable usize=0
                    while c<c2:
                        merged:mutable u64=0
                        slot:mutable usize=0
                        while slot<degree[v]:
                            index:usize=if slot==0:a else if slot==1:b else:c
                            u:=in_u[v*MAX_M+slot]
                            shifted:=cut_shift(cuts[u*MAX_CUTS+index],n,in_d[v*MAX_M+slot])
                            if shifted==18446744073709551615.u64():return -1
                            merged<-merged|shifted;slot<-slot+1
                        cut_add(cuts,counts,v,merged,k)
                        c<-c+1
                    b<-b+1
                a<-a+1
        i:mutable usize=1
        while i<counts[v]:
            value:=cuts[v*MAX_CUTS+i];j:mutable usize=i
            while j>0 and cuts[v*MAX_CUTS+j-1]>value:
                cuts[v*MAX_CUTS+j]<-cuts[v*MAX_CUTS+j-1];j<-j-1
            cuts[v*MAX_CUTS+j]<-value;i<-i+1
        v<-v+1
    words:mutable usize=1;v<-0
    while v<n:words<-words+1+counts[v];v<-v+1
    bytes:=words*8
    if output.is_null() or capacity<bytes:return -2
    cut_put_i64(n.i64(),output[0:bytes],0);at:mutable usize=1;v<-0
    while v<n:
        cut_put_i64(counts[v].i64(),output[0:bytes],at);at<-at+1;i<-0
        while i<counts[v]:cut_put_i64(cuts[v*MAX_CUTS+i].i64(),output[0:bytes],at);at<-at+1;i<-i+1
        v<-v+1
    bytes.i64()
