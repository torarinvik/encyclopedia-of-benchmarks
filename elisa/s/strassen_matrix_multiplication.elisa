@inline(always)
def strassen_store_word(output: mutable u8&, offset: usize, bits: u64) -> void:
    output[offset + 0] <- (bits >> 0).u8()
    output[offset + 1] <- (bits >> 8).u8()
    output[offset + 2] <- (bits >> 16).u8()
    output[offset + 3] <- (bits >> 24).u8()
    output[offset + 4] <- (bits >> 32).u8()
    output[offset + 5] <- (bits >> 40).u8()
    output[offset + 6] <- (bits >> 48).u8()
    output[offset + 7] <- (bits >> 56).u8()

# The validated product fits in i64. Arithmetic modulo 2^64 preserves its
# exact little-endian bit pattern, including negative results.
@inline(always)
def strassen_two[T](a: T&, b: T&, c: mutable u64&) -> void:
    m1: u64 = (a[0].u64() + a[3].u64()) * (b[0].u64() + b[3].u64())
    m2: u64 = (a[2].u64() + a[3].u64()) * b[0].u64()
    m3: u64 = a[0].u64() * (b[1].u64() - b[3].u64())
    m4: u64 = a[3].u64() * (b[2].u64() - b[0].u64())
    m5: u64 = (a[0].u64() + a[1].u64()) * b[3].u64()
    m6: u64 = (a[2].u64() - a[0].u64()) * (b[0].u64() + b[1].u64())
    m7: u64 = (a[1].u64() - a[3].u64()) * (b[2].u64() + b[3].u64())
    c[0] <- m1 + m4 - m5 + m7
    c[1] <- m3 + m5
    c[2] <- m2 + m4
    c[3] <- m1 - m2 + m3 + m6

@inline(never)
def strassen_multiply[T, dimension: usize](a: T&, b: T&, c: mutable u64&) -> void:
    h: usize = dimension / 2
    x: mutable u64[16] = zeroed
    y: mutable u64[16] = zeroed
    product: mutable u64[16] = zeroed
    r: mutable usize = 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            q: usize = r * dimension + col
            x[i] <- a[q].u64() + a[(r + h) * dimension + col + h].u64()
            y[i] <- b[q].u64() + b[(r + h) * dimension + col + h].u64()
            col <- col + 1
        r <- r + 1
    if dimension == 4:
        strassen_two[u64](&x[0], &y[0], &product[0])
    else:
        strassen_multiply[u64, 4](&x[0], &y[0], &product[0])
    for row in 0..<h:
        for column in 0..<h:
            i: usize = row * h + column
            c[row * dimension + column] <- product[i]
            c[(row + h) * dimension + column + h] <- product[i]
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[(r + h) * dimension + col].u64() + a[(r + h) * dimension + col + h].u64()
            y[i] <- b[r * dimension + col].u64()
            col <- col + 1
        r <- r + 1
    if dimension == 4:
        strassen_two[u64](&x[0], &y[0], &product[0])
    else:
        strassen_multiply[u64, 4](&x[0], &y[0], &product[0])
    for row in 0..<h:
        for column in 0..<h:
            i: usize = row * h + column
            c[(row + h) * dimension + column] <- product[i]
            c[(row + h) * dimension + column + h] <- c[(row + h) * dimension + column + h] - product[i]
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[(r + h) * dimension + col].u64() - a[r * dimension + col].u64()
            y[i] <- b[r * dimension + col].u64() + b[r * dimension + col + h].u64()
            col <- col + 1
        r <- r + 1
    if dimension == 4:
        strassen_two[u64](&x[0], &y[0], &product[0])
    else:
        strassen_multiply[u64, 4](&x[0], &y[0], &product[0])
    for row in 0..<h:
        for column in 0..<h:
            i: usize = row * h + column
            c[(row + h) * dimension + column + h] <- c[(row + h) * dimension + column + h] + product[i]
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[r * dimension + col].u64()
            y[i] <- b[r * dimension + col + h].u64() - b[(r + h) * dimension + col + h].u64()
            col <- col + 1
        r <- r + 1
    if dimension == 4:
        strassen_two[u64](&x[0], &y[0], &product[0])
    else:
        strassen_multiply[u64, 4](&x[0], &y[0], &product[0])
    for row in 0..<h:
        for column in 0..<h:
            i: usize = row * h + column
            c[row * dimension + column + h] <- product[i]
            c[(row + h) * dimension + column + h] <- c[(row + h) * dimension + column + h] + product[i]
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[r * dimension + col].u64() + a[r * dimension + col + h].u64()
            y[i] <- b[(r + h) * dimension + col + h].u64()
            col <- col + 1
        r <- r + 1
    if dimension == 4:
        strassen_two[u64](&x[0], &y[0], &product[0])
    else:
        strassen_multiply[u64, 4](&x[0], &y[0], &product[0])
    for row in 0..<h:
        for column in 0..<h:
            i: usize = row * h + column
            c[row * dimension + column] <- c[row * dimension + column] - product[i]
            c[row * dimension + column + h] <- c[row * dimension + column + h] + product[i]
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[r * dimension + col + h].u64() - a[(r + h) * dimension + col + h].u64()
            y[i] <- b[(r + h) * dimension + col].u64() + b[(r + h) * dimension + col + h].u64()
            col <- col + 1
        r <- r + 1
    if dimension == 4:
        strassen_two[u64](&x[0], &y[0], &product[0])
    else:
        strassen_multiply[u64, 4](&x[0], &y[0], &product[0])
    for row in 0..<h:
        for column in 0..<h:
            i: usize = row * h + column
            c[row * dimension + column] <- c[row * dimension + column] + product[i]
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[(r + h) * dimension + col + h].u64()
            y[i] <- b[(r + h) * dimension + col].u64() - b[r * dimension + col].u64()
            col <- col + 1
        r <- r + 1
    if dimension == 4:
        strassen_two[u64](&x[0], &y[0], &product[0])
    else:
        strassen_multiply[u64, 4](&x[0], &y[0], &product[0])
    for row in 0..<h:
        for column in 0..<h:
            i: usize = row * h + column
            c[row * dimension + column] <- c[row * dimension + column] + product[i]
            c[(row + h) * dimension + column] <- c[(row + h) * dimension + column] + product[i]


def strassen_matrix_multiplication_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null: return -1
    if length == 3:
        if input[0] != 1: return -1
        left: i64 = input[1]
        right: i64 = input[2]
        if left.u64() + 2 > 4 or right.u64() + 2 > 4: return -1
        if output == null or capacity < 8: return -2
        bits: mutable u64 = (left * right).u64()
        for byte in 0..<8:
            output[byte] <- (bits & 255).u8()
            bits <- bits >> 8
        return 8
    n: usize = (2 if length == 9 else 0) if length < 33 else (4 if length == 33 else (8 if length == 129 else 0))
    if n == 0 or input[0].usize() != n: return -1
    return strassen_matrix_frame(input, n, output, capacity)

@inline(never)
def strassen_matrix_frame(input: i64&, n: usize, output: mutable u8&?, capacity: usize) -> i64:
    if n == 2:
        invalid: mutable u64 = 0
        for index in 1..<9:
            invalid <- invalid | (1.u64() if input[index].u64() + 2 > 4 else 0.u64())
        if invalid != 0: return -1
        if output == null or capacity < 32: return -2
        small_result: mutable u64[4] = zeroed
        strassen_two[i64](&input[1], &input[5], &small_result[0])
        for index in 0..<4:
            strassen_store_word(output, 8 * index, small_result[index].u64())
        return 32
    return strassen_large_dispatch(input, n, output, capacity)

@inline(never)
def strassen_large_dispatch(input: i64&, n: usize, output: mutable u8&?, capacity: usize) -> i64:
    if n == 4: return strassen_large_frame[4, 16](input, output, capacity)
    return strassen_large_frame[8, 64](input, output, capacity)

@inline(never)
def strassen_large_frame[dimension: usize, cells: usize](input: i64&, output: mutable u8&?, capacity: usize) -> i64:
    invalid: mutable u64 = 0
    for index in 0..<2 * cells:
        out_of_range: u64 = 1.u64() if input[index + 1].u64() + 2 > 4 else 0.u64()
        invalid <- invalid + out_of_range if dimension == 4 else invalid | out_of_range
    if invalid != 0: return -1
    if output == null or capacity < 8 * cells: return -2
    return strassen_product[dimension, cells](input, output)

@inline(never)
def strassen_product[dimension: usize, cells: usize](input: i64&, output: mutable u8&) -> i64:
    result: mutable u64[64] = zeroed
    strassen_multiply[i64, dimension](&input[1], &input[1 + cells], &result[0])
    i: mutable usize = 0
    while i < cells:
        bits: mutable u64 = result[i].u64()
        byte: mutable usize = 0
        while byte < 8:
            output[i * 8 + byte] <- (bits & 255).u8()
            bits <- bits >> 8
            byte <- byte + 1
        i <- i + 1
    (8 * cells).i64()

export fn strassen_matrix_multiplication(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = strassen_matrix_multiplication_impl
