# Seven-product Strassen multiplication for bounded square matrices.
const MAX_N: usize = 8
const MAX_INPUT_LENGTH: usize = 129

def strassen_multiply(a: i64&, b: i64&, c: mutable i64&, n: usize) -> void:
    if n == 1:
        c[0] <- a[0] * b[0]
        return
    half: usize = n / 2
    x: mutable i64[16] = zeroed
    y: mutable i64[16] = zeroed
    m1: mutable i64[16] = zeroed
    m2: mutable i64[16] = zeroed
    m3: mutable i64[16] = zeroed
    m4: mutable i64[16] = zeroed
    m5: mutable i64[16] = zeroed
    m6: mutable i64[16] = zeroed
    m7: mutable i64[16] = zeroed
    row: mutable usize = 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            x[i] <- a[row * n + column] + a[(row + half) * n + column + half]
            y[i] <- b[row * n + column] + b[(row + half) * n + column + half]
            column <- column + 1
        row <- row + 1
    strassen_multiply(&x[0], &y[0], &m1[0], half)
    row <- 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            x[i] <- a[(row + half) * n + column] + a[(row + half) * n + column + half]
            y[i] <- b[row * n + column]
            column <- column + 1
        row <- row + 1
    strassen_multiply(&x[0], &y[0], &m2[0], half)
    row <- 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            x[i] <- a[row * n + column]
            y[i] <- b[row * n + column + half] - b[(row + half) * n + column + half]
            column <- column + 1
        row <- row + 1
    strassen_multiply(&x[0], &y[0], &m3[0], half)
    row <- 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            x[i] <- a[(row + half) * n + column + half]
            y[i] <- b[(row + half) * n + column] - b[row * n + column]
            column <- column + 1
        row <- row + 1
    strassen_multiply(&x[0], &y[0], &m4[0], half)
    row <- 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            x[i] <- a[row * n + column] + a[row * n + column + half]
            y[i] <- b[(row + half) * n + column + half]
            column <- column + 1
        row <- row + 1
    strassen_multiply(&x[0], &y[0], &m5[0], half)
    row <- 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            x[i] <- a[(row + half) * n + column] - a[row * n + column]
            y[i] <- b[row * n + column] + b[row * n + column + half]
            column <- column + 1
        row <- row + 1
    strassen_multiply(&x[0], &y[0], &m6[0], half)
    row <- 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            x[i] <- a[row * n + column + half] - a[(row + half) * n + column + half]
            y[i] <- b[(row + half) * n + column] + b[(row + half) * n + column + half]
            column <- column + 1
        row <- row + 1
    strassen_multiply(&x[0], &y[0], &m7[0], half)

    row <- 0
    while row < half:
        column: mutable usize = 0
        while column < half:
            i: usize = row * half + column
            c[row * n + column] <- m1[i] + m4[i] - m5[i] + m7[i]
            c[row * n + column + half] <- m3[i] + m5[i]
            c[(row + half) * n + column] <- m2[i] + m4[i]
            c[(row + half) * n + column + half] <- m1[i] - m2[i] + m3[i] + m6[i]
            column <- column + 1
        row <- row + 1

def strassen_matrix_multiplication_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value != 1 and n_value != 2 and n_value != 4 and n_value != 8:
        return -1
    n: usize = n_value.usize()
    matrix_cells: usize = n * n
    if length != 1 + 2 * matrix_cells:
        return -1
    i: mutable usize = 0
    while i < 2 * matrix_cells:
        if input[1 + i] < -2 or input[1 + i] > 2:
            return -1
        i <- i + 1

    output_bytes: usize = 8 * matrix_cells
    if output == null or capacity < output_bytes:
        return -2
    result: mutable i64[64] = zeroed
    strassen_multiply(&input[1], &input[1 + matrix_cells], &result[0], n)
    i <- 0
    while i < matrix_cells:
        bits: mutable u64 = result[i].u64()
        byte: mutable usize = 0
        while byte < 8:
            output[i * 8 + byte] <- (bits & 255).u8()
            bits <- bits >> 8
            byte <- byte + 1
        i <- i + 1
    output_bytes.i64()

export fn strassen_matrix_multiplication(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = strassen_matrix_multiplication_impl
