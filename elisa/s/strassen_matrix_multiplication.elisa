@inline(always)
def strassen_store_word(output: mutable u8&, offset: usize, bits: u64) -> void:
    output[offset + 0] <- (bits >> 0).u8()
    output[offset + 1] <- (bits >> 8).u8()
    output[offset + 2] <- (bits >> 16).u8()
    output[offset + 3] <- (bits >> 24).u8()
    output[offset + 4] <- (bits >> 32).u8()
    output[offset + 5] <- (bits >> 40).u8()
    output[offset + 6] <- (bits >> 48).u8()
    output[offset + 7] <- (bits >> 56).u8()

@inline(always)
def strassen_two(a: i64&, b: i64&, c: mutable i64&) -> void:
    m1: i64 = (a[0] + a[3]) * (b[0] + b[3])
    m2: i64 = (a[2] + a[3]) * b[0]
    m3: i64 = a[0] * (b[1] - b[3])
    m4: i64 = a[3] * (b[2] - b[0])
    m5: i64 = (a[0] + a[1]) * b[3]
    m6: i64 = (a[2] - a[0]) * (b[0] + b[1])
    m7: i64 = (a[1] - a[3]) * (b[2] + b[3])
    c[0] <- m1 + m4 - m5 + m7
    c[1] <- m3 + m5
    c[2] <- m2 + m4
    c[3] <- m1 - m2 + m3 + m6

def strassen_multiply(a: i64&, b: i64&, c: mutable i64&, n: usize) -> void:
    if n == 1:
        c[0] <- a[0] * b[0]
        return
    if n == 2:
        strassen_two(a, b, c)
        return
    h: usize = n / 2
    x: mutable i64[16] = zeroed
    y: mutable i64[16] = zeroed
    m1: mutable i64[16] = zeroed
    m2: mutable i64[16] = zeroed
    m3: mutable i64[16] = zeroed
    m4: mutable i64[16] = zeroed
    m5: mutable i64[16] = zeroed
    m6: mutable i64[16] = zeroed
    m7: mutable i64[16] = zeroed
    r: mutable usize = 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            q: usize = r * n + col
            x[i] <- a[q] + a[(r + h) * n + col + h]
            y[i] <- b[q] + b[(r + h) * n + col + h]
            col <- col + 1
        r <- r + 1
    strassen_multiply(&x[0], &y[0], &m1[0], h)
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[(r + h) * n + col] + a[(r + h) * n + col + h]
            y[i] <- b[r * n + col]
            col <- col + 1
        r <- r + 1
    strassen_multiply(&x[0], &y[0], &m2[0], h)
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[r * n + col]
            y[i] <- b[r * n + col + h] - b[(r + h) * n + col + h]
            col <- col + 1
        r <- r + 1
    strassen_multiply(&x[0], &y[0], &m3[0], h)
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[(r + h) * n + col + h]
            y[i] <- b[(r + h) * n + col] - b[r * n + col]
            col <- col + 1
        r <- r + 1
    strassen_multiply(&x[0], &y[0], &m4[0], h)
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[r * n + col] + a[r * n + col + h]
            y[i] <- b[(r + h) * n + col + h]
            col <- col + 1
        r <- r + 1
    strassen_multiply(&x[0], &y[0], &m5[0], h)
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[(r + h) * n + col] - a[r * n + col]
            y[i] <- b[r * n + col] + b[r * n + col + h]
            col <- col + 1
        r <- r + 1
    strassen_multiply(&x[0], &y[0], &m6[0], h)
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            x[i] <- a[r * n + col + h] - a[(r + h) * n + col + h]
            y[i] <- b[(r + h) * n + col] + b[(r + h) * n + col + h]
            col <- col + 1
        r <- r + 1
    strassen_multiply(&x[0], &y[0], &m7[0], h)
    r <- 0
    while r < h:
        col: mutable usize = 0
        while col < h:
            i: usize = r * h + col
            c[r * n + col] <- m1[i] + m4[i] - m5[i] + m7[i]
            c[r * n + col + h] <- m3[i] + m5[i]
            c[(r + h) * n + col] <- m2[i] + m4[i]
            c[(r + h) * n + col + h] <- m1[i] - m2[i] + m3[i] + m6[i]
            col <- col + 1
        r <- r + 1

def strassen_matrix_multiplication_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null: return -1
    if length == 3:
        if input[0] != 1: return -1
        left: i64 = input[1]
        right: i64 = input[2]
        if left.u64() + 2 > 4 or right.u64() + 2 > 4: return -1
        if output == null or capacity < 8: return -2
        bits: mutable u64 = (left * right).u64()
        for byte in 0..<8:
            output[byte] <- (bits & 255).u8()
            bits <- bits >> 8
        return 8
    n: usize = (2 if length == 9 else 0) if length < 33 else (4 if length == 33 else (8 if length == 129 else 0))
    if n == 0 or input[0].usize() != n: return -1
    return strassen_matrix_frame(input, n, output, capacity)

@inline(never)
def strassen_matrix_frame(input: i64&, n: usize, output: mutable u8&?, capacity: usize) -> i64:
    cells: usize = n * n
    if n == 2:
        invalid: mutable u64 = 0
        for index in 1..<9:
            invalid <- invalid | (1.u64() if input[index].u64() + 2 > 4 else 0.u64())
        if invalid != 0: return -1
        if output == null or capacity < 32: return -2
        small_result: mutable i64[4] = zeroed
        strassen_two(&input[1], &input[5], &small_result[0])
        for index in 0..<4:
            strassen_store_word(output, 8 * index, small_result[index].u64())
        return 32
    else:
        invalid: mutable u64 = 0
        for index in 0..<2 * cells:
            invalid <- invalid | (1.u64() if input[index + 1].u64() + 2 > 4 else 0.u64())
        if invalid != 0: return -1
    output_bytes: usize = 8 * cells
    if output == null or capacity < output_bytes: return -2
    return strassen_product(input, output, n, cells, output_bytes)

@inline(never)
def strassen_product(input: i64&, output: mutable u8&, n: usize, cells: usize, output_bytes: usize) -> i64:
    result: mutable i64[64] = zeroed
    strassen_multiply(&input[1], &input[1 + cells], &result[0], n)
    i: mutable usize = 0
    while i < cells:
        bits: mutable u64 = result[i].u64()
        byte: mutable usize = 0
        while byte < 8:
            output[i * 8 + byte] <- (bits & 255).u8()
            bits <- bits >> 8
            byte <- byte + 1
        i <- i + 1
    output_bytes.i64()

export fn strassen_matrix_multiplication(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = strassen_matrix_multiplication_impl
