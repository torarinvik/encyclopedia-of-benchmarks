# Port the generated-double heapsort from the Shootout benchmark.
def shootout_heapsort_sift(length: usize, values: mutable f64&) -> void:
    l: mutable usize = (length / 2) + 1
    ir: mutable usize = length
    i: mutable usize = 0
    j: mutable usize = 0
    rra: mutable f64 = 0.0
    while true:
        if l > 1:
            l <- l - 1
            rra <- values[l]
        else:
            rra <- values[ir]
            values[ir] <- values[1]
            ir <- ir - 1
            if ir == 1:
                values[1] <- rra
                break
        i <- l
        j <- l * 2
        while j <= ir:
            if j < ir and values[j] < values[j + 1]: j <- j + 1
            if rra < values[j]:
                values[i] <- values[j]
                i <- j
                j <- j + i
            else:
                j <- ir + 1
        values[i] <- rra

def shootout_heapsort_impl(length: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2 or length > 8192: return -1
    if output.is_null() or output_capacity < 9: return -2

    values: mutable f64[8193] = zeroed
    state: mutable i64 = 42
    index: mutable usize = 1
    while index <= length.usize():
        state <- (state * 3877 + 29573) % 139968
        values[index] <- 1.0 * state.f64() / 139968.0
        index <- index + 1
    shootout_heapsort_sift(length.usize(), values)

    millionths: mutable u64 = (values[length.usize()] * 1000000.0 + 0.5).u64()
    whole: mutable u64 = millionths / 1000000
    fraction: mutable u64 = millionths % 1000000
    output[0] <- (48 + whole).u8()
    output[1] <- 46u8
    divisor: mutable u64 = 100000
    index <- 2
    while index < 8:
        output[index] <- (48 + (fraction / divisor) % 10).u8()
        divisor <- divisor / 10
        index <- index + 1
    output[8] <- 10u8
    9

export fn shootout_heapsort(length: i64, output: mutable u8&, output_capacity: usize) -> i64 = shootout_heapsort_impl
