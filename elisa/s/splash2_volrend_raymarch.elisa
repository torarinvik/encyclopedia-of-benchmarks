const VRM_MAX_SIDE: usize = 8
const VRM_MAX_RAYS: usize = 16
const VRM_MAX_SAMPLES: usize = 32
const VRM_MAX_VOXELS: usize = 512
const VRM_MAX_INPUT: usize = 3 + 2 * VRM_MAX_VOXELS + 6 * VRM_MAX_RAYS
const VRM_MAX_PARSEABLE: usize = VRM_MAX_INPUT + 1
const VRM_MAX_MASKS: usize = 4 * VRM_MAX_VOXELS
const VRM_Q8: i64 = 256
const VRM_Q16: i64 = 65536
const VRM_WEIGHT_DEN: i64 = 16777216
const VRM_ALPHA_DEN: i64 = 255 * VRM_WEIGHT_DEN
const VRM_COLOR_DEN: i64 = 255 * 255 * VRM_WEIGHT_DEN

def vrm_voxel_index(side: usize, x: usize, y: usize, z: usize) -> usize:
    (z * side + y) * side + x

def vrm_mask_index(level: usize, x: usize, y: usize, z: usize) -> usize:
    ((level * VRM_MAX_SIDE + z) * VRM_MAX_SIDE + y) * VRM_MAX_SIDE + x

def vrm_round_half_up(numerator: i64, denominator: i64) -> i64:
    (numerator + denominator / 2) / denominator

def vrm_to_byte(value: i64) -> u8:
    ((value * 255 + VRM_Q16 / 2) / VRM_Q16).u8()

def splash2_volrend_raymarch_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if length < 3 or length > VRM_MAX_PARSEABLE: return -1
    side_raw: i64 = input[0]
    rays_raw: i64 = input[1]
    samples_raw: i64 = input[2]
    if (side_raw != 2 and side_raw != 4 and side_raw != 8) or rays_raw < 1 or rays_raw > 16 or samples_raw < 1 or samples_raw > 32: return -1
    side: usize = side_raw.usize()
    ray_count: usize = rays_raw.usize()
    sample_count: usize = samples_raw.usize()
    voxel_count: usize = side * side * side
    ray_start: usize = 3 + 2 * voxel_count
    if length != ray_start + 6 * ray_count: return -1

    alpha: mutable u8[VRM_MAX_VOXELS] = zeroed
    gray: mutable u8[VRM_MAX_VOXELS] = zeroed
    rays: mutable i32[VRM_MAX_RAYS * 6] = zeroed
    for voxel in 0..<voxel_count:
        a: i64 = input[3 + 2 * voxel]
        g: i64 = input[4 + 2 * voxel]
        if a < 0 or a > 255 or g < 0 or g > 255: return -1
        alpha[voxel] <- a.u8()
        gray[voxel] <- g.u8()

    coord_max: i64 = (side.i64() - 1) * VRM_Q8
    for ray in 0..<ray_count:
        at: usize = ray_start + 6 * ray
        for axis in 0..<3:
            origin: i64 = input[at + axis]
            delta: i64 = input[at + axis + 3]
            if origin < 0 or origin > coord_max or delta < -coord_max or delta > coord_max: return -1
            rays[6 * ray + axis] <- origin.i32()
            rays[6 * ray + axis + 3] <- delta.i32()
        if sample_count > 1 and rays[6 * ray + 3] == 0 and rays[6 * ray + 4] == 0 and rays[6 * ray + 5] == 0: return -1
        for sample in 0..<sample_count:
            for axis in 0..<3:
                q: i64 = rays[6 * ray + axis].i64() + sample.i64() * rays[6 * ray + axis + 3].i64()
                if q < 0 or q > coord_max: return -1

    output_bytes: usize = 5 * ray_count
    if output == null: return -2
    if capacity < output_bytes: return -3

    support: mutable u8[VRM_MAX_MASKS] = zeroed
    for z in 0..<side:
        for y in 0..<side:
            for x in 0..<side:
                occupied: mutable u8 = 0
                for dz in 0..<2:
                    for dy in 0..<2:
                        for dx in 0..<2:
                            nx: mutable usize = x
                            ny: mutable usize = y
                            nz: mutable usize = z
                            if dx != 0 and x + 1 < side: nx <- x + 1
                            if dy != 0 and y + 1 < side: ny <- y + 1
                            if dz != 0 and z + 1 < side: nz <- z + 1
                            if alpha[vrm_voxel_index(side, nx, ny, nz)] != 0: occupied <- 1
                support[vrm_mask_index(0, x, y, z)] <- occupied

    levels: mutable usize = 0
    dimension: mutable usize = side
    while dimension > 1:
        dimension <- dimension / 2
        levels <- levels + 1
    for level in 1..<(levels + 1):
        dim: usize = side >> level
        for z in 0..<dim:
            for y in 0..<dim:
                for x in 0..<dim:
                    occupied: mutable u8 = 0
                    for dz in 0..<2:
                        for dy in 0..<2:
                            for dx in 0..<2:
                                if support[vrm_mask_index(level - 1, 2 * x + dx, 2 * y + dy, 2 * z + dz)] != 0: occupied <- 1
                    support[vrm_mask_index(level, x, y, z)] <- occupied

    for ray in 0..<ray_count:
        accumulated_alpha: mutable i64 = 0
        accumulated_gray: mutable i64 = 0
        used: mutable usize = 0
        for sample in 0..<sample_count:
            used <- sample + 1
            xq: i64 = rays[6 * ray].i64() + sample.i64() * rays[6 * ray + 3].i64()
            yq: i64 = rays[6 * ray + 1].i64() + sample.i64() * rays[6 * ray + 4].i64()
            zq: i64 = rays[6 * ray + 2].i64() + sample.i64() * rays[6 * ray + 5].i64()
            cx: usize = (xq / VRM_Q8).usize()
            cy: usize = (yq / VRM_Q8).usize()
            cz: usize = (zq / VRM_Q8).usize()
            supported: mutable bool = true
            for reverse_level in 0..<(levels + 1):
                level: usize = levels - reverse_level
                if support[vrm_mask_index(level, cx >> level, cy >> level, cz >> level)] == 0:
                    supported <- false
                    break
            if supported:
                low_x: usize = cx
                low_y: usize = cy
                low_z: usize = cz
                frac_x: usize = (xq % VRM_Q8).usize()
                frac_y: usize = (yq % VRM_Q8).usize()
                frac_z: usize = (zq % VRM_Q8).usize()
                high_x: mutable usize = low_x
                high_y: mutable usize = low_y
                high_z: mutable usize = low_z
                if low_x + 1 < side: high_x <- low_x + 1
                if low_y + 1 < side: high_y <- low_y + 1
                if low_z + 1 < side: high_z <- low_z + 1
                opacity_sum: mutable i64 = 0
                premul_sum: mutable i64 = 0
                for dz in 0..<2:
                    iz: mutable usize = low_z
                    wz: mutable i64 = VRM_Q8 - frac_z.i64()
                    if dz != 0:
                        iz <- high_z
                        wz <- frac_z.i64()
                    for dy in 0..<2:
                        iy: mutable usize = low_y
                        wy: mutable i64 = VRM_Q8 - frac_y.i64()
                        if dy != 0:
                            iy <- high_y
                            wy <- frac_y.i64()
                        for dx in 0..<2:
                            ix: mutable usize = low_x
                            wx: mutable i64 = VRM_Q8 - frac_x.i64()
                            if dx != 0:
                                ix <- high_x
                                wx <- frac_x.i64()
                            at_voxel: usize = vrm_voxel_index(side, ix, iy, iz)
                            weight: i64 = wx * wy * wz
                            opacity_sum <- opacity_sum + alpha[at_voxel].i64() * weight
                            premul_sum <- premul_sum + alpha[at_voxel].i64() * gray[at_voxel].i64() * weight
                sample_alpha: i64 = vrm_round_half_up(opacity_sum * VRM_Q16, VRM_ALPHA_DEN)
                sample_gray: i64 = vrm_round_half_up(premul_sum * VRM_Q16, VRM_COLOR_DEN)
                remaining: i64 = VRM_Q16 - accumulated_alpha
                accumulated_alpha <- accumulated_alpha + vrm_round_half_up(remaining * sample_alpha, VRM_Q16)
                accumulated_gray <- accumulated_gray + vrm_round_half_up(remaining * sample_gray, VRM_Q16)
                if accumulated_alpha > VRM_Q16: accumulated_alpha <- VRM_Q16
                if accumulated_gray > VRM_Q16: accumulated_gray <- VRM_Q16
                if accumulated_alpha == VRM_Q16: break

        at: usize = 5 * ray
        value: u8 = vrm_to_byte(accumulated_gray)
        output[at] <- value
        output[at + 1] <- value
        output[at + 2] <- value
        output[at + 3] <- vrm_to_byte(accumulated_alpha)
        output[at + 4] <- used.u8()
    output_bytes.i64()

def splash2_volrend_raymarch_entry(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > VRM_MAX_PARSEABLE: return -1
    splash2_volrend_raymarch_impl(input, length, output, capacity)

export fn splash2_volrend_raymarch(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = splash2_volrend_raymarch_entry
