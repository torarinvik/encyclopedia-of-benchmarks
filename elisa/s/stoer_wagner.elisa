@intrinsic("llvm.cttz.i64")
extern stoer_trailing_zeros(value: u64, zero_undefined: bool) -> u64

const MAX_N: usize = 16
const MAX_INPUT_VALUES: usize = 257
const MAX_WEIGHT: i64 = 1000000

def stoer_wagner_impl(input: i64&?, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_VALUES:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 16:
        return -1
    n: usize = n_value.usize()
    if length != 1 + n * n:
        return -1

    if n == 2:
        weight: i64 = input[2]
        if input[1] != 0 or input[4] != 0 or weight < 0 or weight > MAX_WEIGHT or input[3] != weight:
            return -1
        return weight

    graph: mutable i64[256] = zeroed
    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            weight: i64 = input[1 + row * n + column]
            if weight < 0 or weight > MAX_WEIGHT:
                return -1
            graph[row * MAX_N + column] <- weight
            column <- column + 1
        row <- row + 1
    row <- 0
    while row < n:
        if graph[row * MAX_N + row] != 0:
            return -1
        column: mutable usize = row + 1
        while column < n:
            if graph[row * MAX_N + column] != graph[column * MAX_N + row]:
                return -1
            column <- column + 1
        row <- row + 1

    active: mutable u64 = (1.u64() << n) - 1
    min_cut: mutable i64 = 120000001
    phase: mutable usize = 0
    while phase + 1 < n:
        available: mutable u64 = active
        weights: mutable i64[16] = zeroed
        previous_index: mutable usize = 0
        last_index: mutable usize = 0
        vertex: mutable usize = 0
        while available != 0:
            current: mutable usize = stoer_trailing_zeros(available, true).usize() & 15
            max_weight: mutable i64 = weights[current]
            pending: mutable u64 = available & (available - 1)
            while pending != 0:
                vertex <- stoer_trailing_zeros(pending, true).usize() & 15
                if weights[vertex] > max_weight:
                    current <- vertex
                    max_weight <- weights[vertex]
                pending <- pending & (pending - 1)
            available <- available & ~(1.u64() << (current & 15))
            previous_index <- last_index
            last_index <- current
            pending <- available
            while pending != 0:
                vertex <- stoer_trailing_zeros(pending, true).usize() & 15
                weights[vertex] <- weights[vertex] + graph[current * MAX_N + vertex]
                pending <- pending & (pending - 1)
        if weights[last_index] < min_cut:
            min_cut <- weights[last_index]
        vertex <- 0
        while vertex < n:
            graph[previous_index * MAX_N + vertex] <- graph[previous_index * MAX_N + vertex] + graph[last_index * MAX_N + vertex]
            graph[vertex * MAX_N + previous_index] <- graph[previous_index * MAX_N + vertex]
            vertex <- vertex + 1
        active <- active & ~(1.u64() << (last_index & 15))
        phase <- phase + 1
    min_cut

export fn stoer_wagner(input: i64&?, length: usize) -> i64 = stoer_wagner_impl
