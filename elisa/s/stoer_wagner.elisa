@intrinsic("llvm.cttz.i64")
extern stoer_trailing_zeros(value: u64, zero_undefined: bool) -> u64

const MAX_N: usize = 16
const MAX_INPUT_VALUES: usize = 257
const MAX_WEIGHT: i64 = 1000000

def stoer_wagner_impl(input: i64&?, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_VALUES:
        return -1
    if length == 5:
        weight: i64 = input[2]
        if ((input[0] ^ 2) | input[1] | input[4] | (input[3] ^ weight)) != 0 or weight.u64() > MAX_WEIGHT.u64():
            return -1
        return weight

    if length == 10:
        first: i64 = input[2]
        second: i64 = input[3]
        third: i64 = input[6]
        header_and_diagonal: i64 = (input[0] ^ 3) | input[1] | input[5] | input[9]
        asymmetric_edges: i64 = (first ^ input[4]) | (second ^ input[7]) | (third ^ input[8])
        if (header_and_diagonal | asymmetric_edges) != 0:
            return -1
        # Validate the unsigned maximum, which also catches negative inputs.
        largest: mutable u64 = first.u64()
        if second.u64() > largest:
            largest <- second.u64()
        if third.u64() > largest:
            largest <- third.u64()
        if largest > MAX_WEIGHT.u64():
            return -1
        # Every nontrivial cut isolates one vertex. Use the two lightest edges.
        return first.i32().i64() + second.i32().i64() + third.i32().i64() - largest.i32().i64()

    n_value: i64 = input[0]
    if n_value < 2 or n_value > 16:
        return -1
    n: usize = n_value.usize()
    if length != 1 + n * n:
        return -1

    stoer_wagner_contract(input, n)

@inline(never)
def stoer_wagner_contract(input: i64&, n: usize) -> i64:
    # Contracted weights are bounded by the total of all original edges.
    graph: mutable i32[256] = zeroed
    row: mutable usize = 0
    while row < n:
        input_row: usize = 1 + row * n
        graph_row: usize = row * MAX_N
        if input[input_row + row] != 0:
            return -1
        column: mutable usize = row + 1
        while column < n:
            weight: i64 = input[input_row + column]
            if weight.u64() > MAX_WEIGHT.u64() or weight != input[1 + column * n + row]:
                return -1
            graph[graph_row + column] <- weight.i32()
            graph[column * MAX_N + row] <- weight.i32()
            column <- column + 1
        row <- row + 1

    if n == 4:
        return stoer_wagner_four_cut(&graph)

    active: mutable u64 = (1.u64() << n) - 1
    min_cut: mutable i64 = 120000001
    remaining: mutable usize = n - 2
    while remaining != 0:
        # Zero initial weights select vertex zero first. It cannot be the
        # last vertex of a phase, so it remains active after every contraction.
        available: mutable u64 = active & ~1.u64()
        weights: mutable i32[16] = zeroed
        for vertex in 0..<MAX_N:
            weights[vertex] <- graph[vertex]
        previous_index: mutable usize = 0
        vertex: mutable usize = 0
        current: mutable usize = stoer_trailing_zeros(available, true).usize() & 15
        max_weight: mutable i32 = weights[current]
        pending: mutable u64 = available & (available - 1)
        while pending != 0:
            vertex <- stoer_trailing_zeros(pending, true).usize() & 15
            if weights[vertex] > max_weight:
                current <- vertex
                max_weight <- weights[vertex]
            pending <- pending & (pending - 1)
        while (available & (available - 1)) != 0:
            previous_index <- current
            available <- available & ~(1.u64() << (current & 15))
            selected_row: usize = current * MAX_N
            pending <- available
            max_weight <- -1
            while pending != 0:
                vertex <- stoer_trailing_zeros(pending, true).usize() & 15
                weight: i32 = (weights[vertex].i64() + graph[selected_row + vertex].i64()).i32()
                weights[vertex] <- weight
                if weight > max_weight:
                    current <- vertex
                    max_weight <- weight
                pending <- pending & (pending - 1)
        last_index: usize = current
        if weights[last_index].i64() < min_cut:
            min_cut <- weights[last_index].i64()
        active <- active & ~(1.u64() << (last_index & 15))
        neighbors: mutable u64 = active & ~(1.u64() << (previous_index & 15))
        while neighbors != 0:
            vertex <- stoer_trailing_zeros(neighbors, true).usize() & 15
            merged_weight: i32 = (graph[previous_index * MAX_N + vertex].i64() + graph[last_index * MAX_N + vertex].i64()).i32()
            graph[previous_index * MAX_N + vertex] <- merged_weight
            graph[vertex * MAX_N + previous_index] <- merged_weight
            neighbors <- neighbors & (neighbors - 1)
        remaining <- remaining - 1
    # The final two supervertices have only one edge between them.
    remaining_vertex: usize = stoer_trailing_zeros(active & ~1.u64(), true).usize() & 15
    final_cut: i64 = graph[remaining_vertex].i64()
    if final_cut < min_cut:
        return final_cut
    min_cut

def stoer_wagner_four_cut(graph: i32[256]&) -> i64:
    # Four singleton cuts and three pair cuts exhaust the partitions.
    ab: i64 = graph[1].i64()
    ac: i64 = graph[2].i64()
    ad: i64 = graph[3].i64()
    bc: i64 = graph[18].i64()
    bd: i64 = graph[19].i64()
    cd: i64 = graph[35].i64()
    best: mutable i64 = ab + ac + ad
    isolate_b: i64 = ab + bc + bd
    if isolate_b < best:
        best <- isolate_b
    isolate_c: i64 = ac + bc + cd
    if isolate_c < best:
        best <- isolate_c
    isolate_d: i64 = ad + bd + cd
    if isolate_d < best:
        best <- isolate_d
    separate_ab: i64 = ac + ad + bc + bd
    if separate_ab < best:
        best <- separate_ab
    separate_ac: i64 = ab + ad + bc + cd
    if separate_ac < best:
        best <- separate_ac
    separate_ad: i64 = ab + ac + bd + cd
    if separate_ad < best:
        best <- separate_ad
    best

export fn stoer_wagner(input: i64&?, length: usize) -> i64 = stoer_wagner_impl
