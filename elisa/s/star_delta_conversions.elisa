const INVALID: i64 = -1
def star_delta_conversions_impl(v: i64&?, n: usize) -> i64:
    if v == null or n != 4 or (v[0] != 0 and v[0] != 1): return INVALID
    i: mutable usize = 1
    while i < 4:
        if v[i] < 1000 or v[i] > 100000: return INVALID
        i <- i + 1
    a: u64 = v[1].u64()
    b: u64 = v[2].u64()
    c: u64 = v[3].u64()
    seed: u64 = 14695981039346656037.u64()
    if v[0] == 0:
        pair_sum: u64 = a * b + b * c + c * a
        return hash_quantized(hash_quantized(hash_quantized(seed, quantize(pair_sum, a)), quantize(pair_sum, b)), quantize(pair_sum, c)).i64()
    total: u64 = a + b + c
    hash_quantized(hash_quantized(hash_quantized(seed, quantize(b * c, total)), quantize(c * a, total)), quantize(a * b, total)).i64()

# Products and sums are exact in binary64. Non-ties are at least 1/(2*denominator)
# from a half integer, farther than binary64 rounding can move them here.
def quantize(numerator: u64, denominator: u64) -> u64:
    (numerator + denominator / 2) / denominator

def hash_quantized(seed: u64, bits: u64) -> u64:
    hash: mutable u64 = seed
    # The largest star-to-delta result is b + c + b*c/a <= 10,200,000.
    # Delta-to-star results are smaller, so either direction fits in 24 bits.
    for byte_index in 0..<3:
        byte: u64 = (bits >> (8 * byte_index)) & 255.u64()
        hash <- (hash ^ byte) * 1099511628211.u64()
    # The five high bytes are zero, so fold their FNV multiplications.
    hash * 913917546033277539.u64()

export fn star_delta_conversions(v: i64&?, n: usize) -> i64 = star_delta_conversions_impl
