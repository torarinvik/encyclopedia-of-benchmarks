extern floor(x: f64) -> f64
const INVALID: i64 = -1
def star_delta_conversions_impl(v: i64&?, n: usize) -> i64:
    if v == null or n != 4 or (v[0] != 0 and v[0] != 1): return INVALID
    i: mutable usize = 1
    while i < 4:
        if v[i] < 1000 or v[i] > 100000: return INVALID
        i <- i + 1
    a: f64 = v[1].f64()
    b: f64 = v[2].f64()
    c: f64 = v[3].f64()
    seed: u64 = 14695981039346656037.u64()
    if v[0] == 0:
        pair_sum: f64 = a * b + b * c + c * a
        return hash_quantized(hash_quantized(hash_quantized(seed, pair_sum / a), pair_sum / b), pair_sum / c).i64()
    total: f64 = a + b + c
    hash_quantized(hash_quantized(hash_quantized(seed, b * c / total), c * a / total), a * b / total).i64()

def hash_quantized(seed: u64, value: f64) -> u64:
    bits: u64 = floor(value + 0.5).i64().u64()
    hash: mutable u64 = seed
    for byte_index in 0..<8:
        byte: u64 = (bits >> (8 * byte_index)) & 255.u64()
        hash <- (hash ^ byte) * 1099511628211.u64()
    hash

export fn star_delta_conversions(v: i64&?, n: usize) -> i64 = star_delta_conversions_impl
