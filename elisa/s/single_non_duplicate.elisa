# Binary search the pair alignment around the unique value.
def single_non_duplicate_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 1025 or length % 2 == 0:
        return -2147483649
    left: mutable usize = 0
    right: mutable usize = length / 2
    while left < right:
        middle: usize = left + (right - left) / 2
        if values[middle * 2] == values[middle * 2 + 1]:
            left <- middle + 1
        else:
            right <- middle
    values[left * 2]

export fn single_non_duplicate(values: i64&, length: usize) -> i64 = single_non_duplicate_impl
