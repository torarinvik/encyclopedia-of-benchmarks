def put64(out: mutable u8&, index: usize, value: i64) -> void:
    raw: u64 = value.u64()
    for byte in 0..8: out[index * 8 + byte] <- ((raw >> (byte * 8)) & 255).u8()

def rodinia_streamcluster_pgain_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values.is_null() or length < 5 or length > 53: return -1
    pn: i64 = values[0]; dim: i64 = values[1]; candidate: i64 = values[2]; z: i64 = values[3]; mask: i64 = values[4]
    if pn < 2 or pn > 8 or dim < 1 or dim > 3 or length != 5 + pn.usize() * (3 + dim).usize() or candidate < 0 or candidate >= pn or z < 1 or z > 64 or mask <= 0 or mask.u64() >= (1.u64() << pn.usize()) or mask & (1.i64() << candidate.usize()) != 0: return -1
    p: usize = pn.usize(); d: usize = dim.usize(); x: usize = candidate.usize(); q: mutable usize = 5
    ass: mutable [8]usize = [0; 8]; weights: mutable [8]i64 = [0; 8]; costs: mutable [8]i64 = [0; 8]; points: mutable [[3]i64; 8] = [[0; 3]; 8]
    for i in 0..p:
        if values[q] < 0 or values[q] >= pn: return -1
        ass[i] <- values[q].usize(); q <- q + 1
        if mask & (1.i64() << ass[i]) == 0: return -1
    for i in 0..p:
        if values[q] < 1 or values[q] > 4: return -1
        weights[i] <- values[q]; q <- q + 1
    for i in 0..p: costs[i] <- values[q]; q <- q + 1
    for i in 0..p:
        for k in 0..d:
            if values[q] < -8 or values[q] > 8: return -1
            points[i][k] <- values[q]; q <- q + 1
    for i in 0..p:
        distance: mutable i64 = 0
        for k in 0..d:
            delta: i64 = points[i][k] - points[ass[i]][k]; distance <- distance + delta * delta
        if costs[i] != weights[i] * distance or (mask & (1.i64() << i) != 0 and (ass[i] != i or costs[i] != 0)): return -1
    switched: mutable [8]bool = [false; 8]; closing: mutable [8]bool = [false; 8]; lower: mutable [8]i64 = [0; 8]; opening: mutable i64 = z
    for i in 0..p:
        dist: mutable i64 = 0
        for k in 0..d:
            delta: i64 = points[i][k] - points[x][k]; dist <- dist + delta * delta
        candidate_cost: i64 = weights[i] * dist
        if candidate_cost < costs[i]: switched[i] <- true; opening <- opening + candidate_cost - costs[i]
        else: lower[ass[i]] <- lower[ass[i]] + costs[i] - candidate_cost
    for j in 0..p:
        if mask & (1.i64() << j) != 0:
            low: i64 = z + lower[j]
            if low > 0: closing[j] <- true; opening <- opening - low
    opened: bool = opening < 0; out_mask: mutable i64 = mask; out_ass: mutable [8]usize = ass; out_cost: mutable [8]i64 = costs
    if opened:
        for i in 0..p:
            if switched[i] or closing[ass[i]]:
                dist: mutable i64 = 0
                for k in 0..d:
                    delta: i64 = points[i][k] - points[x][k]; dist <- dist + delta * delta
                out_ass[i] <- x; out_cost[i] <- weights[i] * dist
        for j in 0..p:
            if closing[j]: out_mask <- out_mask & ~(1.i64() << j)
        out_mask <- out_mask | (1.i64() << x)
    count: mutable i64 = 0; objective: mutable i64 = 0
    for j in 0..p: if out_mask & (1.i64() << j) != 0: count <- count + 1
    objective <- count * z
    for i in 0..p: objective <- objective + out_cost[i]
    if output.is_null() or capacity < 8 * (5 + 2 * p): return -2
    put64(output, 0, if opened: 1 else: 0); put64(output, 1, if opened: -opening else: 0); put64(output, 2, count); put64(output, 3, out_mask); put64(output, 4, objective)
    for i in 0..p: put64(output, 5 + i, out_ass[i].i64()); put64(output, 5 + p + i, out_cost[i])
    (5 + 2 * p).i64()

export fn rodinia_streamcluster_pgain(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = rodinia_streamcluster_pgain_impl
