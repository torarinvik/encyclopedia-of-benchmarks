const MAX_NODE_COUNT: usize = 5000
const MAX_VALUE: i64 = 10000000

def search_in_bst_impl(input: i64&, length: usize) -> i64:
    if length < 3:
        return -1
    count_value: i64 = input[0]
    root: i64 = input[1]
    target: i64 = input[2]
    if (count_value < 0 or count_value > MAX_NODE_COUNT or
       length != 3 + 3 * count_value.usize() or target < 1 or target > MAX_VALUE):
        return -1
    count: usize = count_value.usize()
    if count == 0:
        return -1
    if root < 0 or root.u64() >= count.u64():
        return -1
    node: mutable i64 = root
    while node != -1:
        if node < 0 or node.u64() >= count.u64():
            return -1
        offset: usize = 3 + 3 * node.usize()
        value: i64 = input[offset]
        left: i64 = input[offset + 1]
        right: i64 = input[offset + 2]
        if value < 1 or value > MAX_VALUE or left < -1 or right < -1:
            return -1
        if (left >= 0 and left.u64() >= count.u64()) or (right >= 0 and right.u64() >= count.u64()):
            return -1
        if value == target:
            return node
        if target < value:
            node <- left
        else:
            node <- right
    -1

export fn search_in_bst(input: i64&, length: usize) -> i64 = search_in_bst_impl
