const MAX_LENGTH: usize = 256
const MIN_VALUE: i64 = -1000000
const MAX_VALUE: i64 = 1000000
const CHECKSUM_OFFSET: i64 = 1000001
const INVALID_RESULT: i64 = -1

def simplesort_impl(input: i64&, length: usize) -> i64:
    if length > MAX_LENGTH or (length != 0 and input.is_null()):
        return INVALID_RESULT
    working: mutable i64[MAX_LENGTH] = zeroed
    for index in 0..<length:
        if input[index] < MIN_VALUE or input[index] > MAX_VALUE:
            return INVALID_RESULT
        working[index] <- input[index]

    i: mutable usize = 0
    while i < length:
        j: mutable usize = 0
        while j < length:
            if working[i] < working[j]:
                temporary: i64 = working[i]
                working[i] <- working[j]
                working[j] <- temporary
            j <- j + 1
        i <- i + 1
    checksum: mutable i64 = 0
    index: mutable usize = 0
    while index < length:
        checksum <- checksum + (index + 1).i64() * (working[index] + CHECKSUM_OFFSET)
        index <- index + 1
    checksum

export fn {name}(input: i64&, length: usize) -> i64 = {name}_impl
