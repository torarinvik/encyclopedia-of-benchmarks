const MAX_APPEND_COUNT: i64 = 4096
const MAX_TEXT_BYTES: usize = 24576

def shootout_strcat_impl(append_count: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if append_count < 0 or append_count > MAX_APPEND_COUNT:
        return -1

    text: mutable u8[MAX_TEXT_BYTES + 1] = zeroed
    length: mutable usize = 0
    buffer_capacity: mutable usize = 32
    append: mutable i64 = 0
    while append < append_count:
        if buffer_capacity - length < 7:
            buffer_capacity <- buffer_capacity * 2
        text[length] <- 104
        text[length + 1] <- 101
        text[length + 2] <- 108
        text[length + 3] <- 108
        text[length + 4] <- 111
        text[length + 5] <- 10
        length <- length + 6
        text[length] <- 0
        append <- append + 1

    staged: mutable u8[6] = zeroed
    reversed_digits: mutable u8[5] = zeroed
    digit_count: mutable usize = 0
    value: mutable usize = 0
    while text[value] != 0:
        value <- value + 1
    while true:
        reversed_digits[digit_count] <- (48 + value % 10).u8()
        digit_count <- digit_count + 1
        value <- value / 10
        if value == 0: break
    used: mutable usize = 0
    while digit_count > 0:
        digit_count <- digit_count - 1
        staged[used] <- reversed_digits[digit_count]
        used <- used + 1
    staged[used] <- 10
    used <- used + 1

    if output == null or output_capacity < used:
        return -2
    index: mutable usize = 0
    while index < used:
        output[index] <- staged[index]
        index <- index + 1
    used.i64()

export fn shootout_strcat(append_count: i64, output: mutable u8&, output_capacity: usize) -> i64 = shootout_strcat_impl
