const SCIMARK2_SOR_MAX_INPUT: usize = 67

def scimark2_sor_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > SCIMARK2_SOR_MAX_INPUT: return -1
    rows_value: i64 = input[0]
    cols_value: i64 = input[1]
    iterations_value: i64 = input[2]
    if rows_value < 2 or rows_value > 8 or cols_value < 2 or cols_value > 8 or iterations_value < 0 or iterations_value > 8: return -1
    rows: usize = rows_value.usize()
    cols: usize = cols_value.usize()
    iterations: usize = iterations_value.usize()
    if length != 3 + rows * cols: return -1
    grid: mutable i64[64] = zeroed
    index: mutable usize = 0
    while index < rows * cols:
        value: i64 = input[3 + index]
        if value < -1000 or value > 1000: return -1
        grid[index] <- value
        index <- index + 1
    pass: mutable usize = 0
    while pass < iterations:
        row: mutable usize = 1
        while row + 1 < rows:
            col: mutable usize = 1
            while col + 1 < cols:
                cell: usize = row * cols + col
                neighbors: i64 = grid[cell - cols] + grid[cell + cols] + grid[cell - 1] + grid[cell + 1]
                numerator: i64 = 1250 * neighbors - 1000 * grid[cell]
                if numerator < 0:
                    grid[cell] <- -((-numerator) / 4000)
                else:
                    grid[cell] <- numerator / 4000
                col <- col + 1
            row <- row + 1
        pass <- pass + 1
    checksum: mutable i64 = 0
    index <- 0
    while index < rows * cols:
        checksum <- checksum + (index + 1).i64() * grid[index]
        index <- index + 1
    checksum

export fn scimark2_sor(input: i64&, length: usize) -> i64 = scimark2_sor_impl
