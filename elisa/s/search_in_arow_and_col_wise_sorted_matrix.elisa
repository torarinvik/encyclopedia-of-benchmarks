const MAX_DIMENSION: i64 = 63
const MAX_INPUT_VALUES: usize = 3971

def write_i32_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u32 = value.i32().u32()
    byte: mutable usize = 0
    while byte < 4:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

export fn search_in_arow_and_col_wise_sorted_matrix(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_VALUES: return -1
    n_value: i64 = input[0]
    target: i64 = input[1]
    if n_value < 1 or n_value > MAX_DIMENSION or target < -2147483648 or target > 2147483647: return -1
    n: usize = n_value.usize()
    if length != 2 + n * n: return -1

    target_count: mutable usize = 0
    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            index: usize = row * n + column
            value: i64 = input[2 + index]
            if value < -2147483648 or value > 2147483647: return -1
            if column > 0 and value < input[2 + index - 1]: return -1
            if row > 0 and value < input[2 + index - n]: return -1
            if value == target:
                target_count <- target_count + 1
                if target_count > 1: return -1
            column <- column + 1
        row <- row + 1

    result_row: mutable i64 = -1
    result_column: mutable i64 = -1
    found: mutable i64 = 0
    row <- 0
    column_search: mutable i64 = n_value - 1
    while row < n and column_search >= 0:
        value: i64 = input[2 + row * n + column_search.usize()]
        if value == target:
            result_row <- row.i64()
            result_column <- column_search
            found <- 1
            break
        if target > value:
            row <- row + 1
        else:
            column_search <- column_search - 1

    if output.is_null() or capacity < 8: return -2
    buffer: mutable u8[8] = zeroed
    write_i32_le(buffer[0], 0, result_row)
    write_i32_le(buffer[0], 4, result_column)
    index: mutable usize = 0
    while index < 8:
        output[index] <- buffer[index]
        index <- index + 1
    found
