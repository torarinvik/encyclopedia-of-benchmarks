const MAX_QUERIES: usize = 128
const MAX_RUNS: usize = 64
const MAX_INPUT_LENGTH: usize = 16384
const MAX_OUTPUT_WORDS: usize = 32768
const MAX_COMPONENT: i64 = 1000000000

struct SbtRun:
    direction: i64
    count: i64

struct SbtDecoded:
    numerator: mutable i64
    denominator: mutable i64
    lower_num: mutable i64
    lower_den: mutable i64
    upper_num: mutable i64
    upper_den: mutable i64

def sbt_fraction_in_range(numerator: i64, denominator: i64) -> bool:
    numerator >= 1 and numerator <= MAX_COMPONENT and denominator >= 1 and
        denominator <= MAX_COMPONENT

def sbt_encode_path(numerator_value: i64, denominator_value: i64,
    runs: mutable view[SbtRun]) -> i64:
    numerator: mutable i64 = numerator_value
    denominator: mutable i64 = denominator_value
    run_count: mutable usize = 0
    while numerator != denominator:
        if run_count >= MAX_RUNS: return -1
        if numerator < denominator:
            count: i64 = (denominator - 1) / numerator
            runs[run_count] <- SbtRun{direction: 0, count: count}
            denominator <- denominator - count * numerator
        else:
            count: i64 = (numerator - 1) / denominator
            runs[run_count] <- SbtRun{direction: 1, count: count}
            numerator <- numerator - count * denominator
        run_count <- run_count + 1
    # The subtractive Euclidean steps preserve the gcd.
    if numerator != 1: return -1
    run_count.i64()

# Walk the quotient runs while accumulating their Farey bounds.
def sbt_descendant_bounds(numerator_value: i64, denominator_value: i64, bounds: mutable SbtDecoded&) -> bool:
    numerator: mutable i64 = numerator_value
    denominator: mutable i64 = denominator_value
    bounds.lower_num <- 0
    bounds.lower_den <- 1
    bounds.upper_num <- 1
    bounds.upper_den <- 0
    while numerator != denominator:
        if numerator < denominator:
            count: i64 = (denominator - 1) / numerator
            denominator <- denominator - count * numerator
            bounds.upper_num <- bounds.upper_num + count * bounds.lower_num
            bounds.upper_den <- bounds.upper_den + count * bounds.lower_den
        else:
            count: i64 = (numerator - 1) / denominator
            numerator <- numerator - count * denominator
            bounds.lower_num <- bounds.lower_num + count * bounds.upper_num
            bounds.lower_den <- bounds.lower_den + count * bounds.upper_den
    numerator == 1

def sbt_decode_path(runs: view[SbtRun], decoded: mutable SbtDecoded&) -> bool:
    lower_num: mutable i64 = 0
    lower_den: mutable i64 = 1
    upper_num: mutable i64 = 1
    upper_den: mutable i64 = 0
    previous: mutable i64 = -1
    index: mutable usize = 0
    while index < runs.len:
        direction: i64 = runs[index].direction
        count: i64 = runs[index].count
        if (direction != 0 and direction != 1) or count < 1 or count > MAX_COMPONENT or direction == previous:
            return false
        if direction == 0:
            upper_num <- upper_num + count * lower_num
            upper_den <- upper_den + count * lower_den
            if upper_num > MAX_COMPONENT or upper_den > MAX_COMPONENT: return false
        else:
            lower_num <- lower_num + count * upper_num
            lower_den <- lower_den + count * upper_den
            if lower_num > MAX_COMPONENT or lower_den > MAX_COMPONENT: return false
        previous <- direction
        index <- index + 1
    numerator: i64 = lower_num + upper_num
    denominator: i64 = lower_den + upper_den
    # The bounds remain determinant-one neighbors, so their mediant is reduced.
    if not sbt_fraction_in_range(numerator, denominator): return false
    decoded.numerator <- numerator
    decoded.denominator <- denominator
    decoded.lower_num <- lower_num
    decoded.lower_den <- lower_den
    decoded.upper_num <- upper_num
    decoded.upper_den <- upper_den
    true

def sbt_common_prefix(left: view[SbtRun], right: view[SbtRun], prefix: mutable view[SbtRun]) -> usize:
    left_index: mutable usize = 0
    right_index: mutable usize = 0
    left_used: mutable i64 = 0
    right_used: mutable i64 = 0
    count: mutable usize = 0
    while left_index < left.len and right_index < right.len and
        left[left_index].direction == right[right_index].direction:
        left_remaining: i64 = left[left_index].count - left_used
        right_remaining: i64 = right[right_index].count - right_used
        shared: i64 = left_remaining if left_remaining < right_remaining else right_remaining
        prefix[count] <- SbtRun{direction: left[left_index].direction, count: shared}
        count <- count + 1
        left_used <- left_used + shared
        right_used <- right_used + shared
        if left_used == left[left_index].count:
            left_index <- left_index + 1
            left_used <- 0
        if right_used == right[right_index].count:
            right_index <- right_index + 1
            right_used <- 0
    count

def sbt_append(words: mutable view[i64], word_count: mutable usize&, value: i64) -> bool:
    if word_count >= words.len: return false
    words[word_count] <- value
    word_count <- word_count + 1
    true

def sbt_store_word(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset+byte] <- (bits >> (byte*8)).u8()

def sbt_single_bounds(numerator: i64, denominator: i64, output: mutable u8&?, capacity: usize) -> i64:
    if not sbt_fraction_in_range(numerator, denominator): return -1
    bounds: mutable SbtDecoded = zeroed
    if not sbt_descendant_bounds(numerator, denominator, bounds): return -1
    if output == null or capacity < 40: return -2
    sbt_store_word(output, 0, 4)
    sbt_store_word(output, 8, bounds.lower_num)
    sbt_store_word(output, 16, bounds.lower_den)
    sbt_store_word(output, 24, bounds.upper_num)
    sbt_store_word(output, 32, bounds.upper_den)
    1

def sbt_single_path(numerator: i64, denominator: i64, output: mutable u8&?, capacity: usize) -> i64:
    if not sbt_fraction_in_range(numerator, denominator): return -1
    a: mutable i64 = numerator
    b: mutable i64 = denominator
    run_count: mutable usize = 0
    while a != b:
        if a < b:
            b <- (b-1)%a+1
        else:
            a <- (a-1)%b+1
        run_count <- run_count+1
    if a != 1 or run_count > MAX_RUNS: return -1
    if output == null or capacity < 16+16*run_count: return -2
    sbt_store_word(output, 0, 0)
    sbt_store_word(output, 8, run_count.i64())
    a <- numerator
    b <- denominator
    for index in 0..<run_count:
        if a < b:
            count: i64 = (b-1)/a
            sbt_store_word(output, 16+16*index, 0)
            sbt_store_word(output, 24+16*index, count)
            b <- b-count*a
        else:
            count: i64 = (a-1)/b
            sbt_store_word(output, 16+16*index, 1)
            sbt_store_word(output, 24+16*index, count)
            a <- a-count*b
    1

# Decode directly from the input words. Check the whole record before writing.
def sbt_single_decode(input: i64&, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if length < 3: return -1
    run_count: i64 = input[2]
    if run_count < 0 or run_count > MAX_RUNS.i64() or length != 3+2*run_count.usize(): return -1
    lower_num: mutable i64 = 0
    lower_den: mutable i64 = 1
    upper_num: mutable i64 = 1
    upper_den: mutable i64 = 0
    previous: mutable i64 = -1
    for index in 0..<run_count.usize():
        direction: i64 = input[3+2*index]
        count: i64 = input[4+2*index]
        if (direction != 0 and direction != 1) or direction == previous or count < 1 or count > MAX_COMPONENT:
            return -1
        if direction == 0:
            upper_num <- upper_num + count * lower_num
            upper_den <- upper_den + count * lower_den
            if upper_num > MAX_COMPONENT or upper_den > MAX_COMPONENT: return -1
        else:
            lower_num <- lower_num + count * upper_num
            lower_den <- lower_den + count * upper_den
            if lower_num > MAX_COMPONENT or lower_den > MAX_COMPONENT: return -1
        previous <- direction
    numerator: i64 = lower_num + upper_num
    denominator: i64 = lower_den + upper_den
    if not sbt_fraction_in_range(numerator, denominator): return -1
    if output == null or capacity < 24: return -2
    sbt_store_word(output, 0, 1)
    sbt_store_word(output, 8, numerator)
    sbt_store_word(output, 16, denominator)
    1

def sbt_is_reduced(numerator: i64, denominator: i64) -> bool:
    if numerator == 1 or denominator == 1: return true
    a: mutable i64 = numerator
    b: mutable i64 = denominator
    while b != 0:
        remainder: i64 = a % b
        a <- b
        b <- remainder
    a == 1

def sbt_single_lca(input: i64&, output: mutable u8&?, capacity: usize) -> i64:
    a: mutable i64 = input[2]
    b: mutable i64 = input[3]
    c: mutable i64 = input[4]
    d: mutable i64 = input[5]
    if not sbt_fraction_in_range(a, b) or not sbt_fraction_in_range(c, d): return -1

    lower_num: mutable i64 = 0
    lower_den: mutable i64 = 1
    upper_num: mutable i64 = 1
    upper_den: mutable i64 = 0
    while a != b and c != d:
        if a < b and c < d:
            left_count: i64 = (b-1)/a
            right_count: i64 = (d-1)/c
            shared: i64 = left_count if left_count < right_count else right_count
            upper_num <- upper_num + shared*lower_num
            upper_den <- upper_den + shared*lower_den
            if left_count != right_count: break
            b <- b-shared*a
            d <- d-shared*c
        elif a > b and c > d:
            left_count: i64 = (a-1)/b
            right_count: i64 = (c-1)/d
            shared: i64 = left_count if left_count < right_count else right_count
            lower_num <- lower_num + shared*upper_num
            lower_den <- lower_den + shared*upper_den
            if left_count != right_count: break
            a <- a-shared*b
            c <- c-shared*d
        else:
            break
    # Common quotient steps preserve both gcds. Check only the residual pairs.
    if not sbt_is_reduced(a, b) or not sbt_is_reduced(c, d): return -1
    if output == null or capacity < 24: return -2
    sbt_store_word(output, 0, 2)
    sbt_store_word(output, 8, lower_num+upper_num)
    sbt_store_word(output, 16, lower_den+upper_den)
    1

def sbt_single_ancestor(input: i64&, output: mutable u8&?, capacity: usize) -> i64:
    remaining: mutable i64 = input[2]
    numerator: mutable i64 = input[3]
    denominator: mutable i64 = input[4]
    if remaining < 1 or remaining > MAX_COMPONENT or not sbt_fraction_in_range(numerator, denominator): return -1
    lower_num: mutable i64 = 0
    lower_den: mutable i64 = 1
    upper_num: mutable i64 = 1
    upper_den: mutable i64 = 0
    while numerator != denominator:
        if numerator < denominator:
            count: i64 = (denominator-1)/numerator
            take: i64 = remaining if remaining < count else count
            denominator <- denominator-count*numerator
            upper_num <- upper_num+take*lower_num
            upper_den <- upper_den+take*lower_den
            remaining <- remaining-take
        else:
            count: i64 = (numerator-1)/denominator
            take: i64 = remaining if remaining < count else count
            numerator <- numerator-count*denominator
            lower_num <- lower_num+take*upper_num
            lower_den <- lower_den+take*upper_den
            remaining <- remaining-take
    if numerator != 1: return -1
    required: usize = 16 if remaining != 0 else 24
    if output == null or capacity < required: return -2
    sbt_store_word(output, 0, 3)
    if remaining != 0:
        sbt_store_word(output, 8, -1)
    else:
        sbt_store_word(output, 8, lower_num+upper_num)
        sbt_store_word(output, 16, lower_den+upper_den)
    1

def stern_brocot_tree_impl(input: i64&?, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH: return -1
    query_count: i64 = input[0]
    if query_count < 1 or query_count > MAX_QUERIES.i64(): return -1
    if query_count == 1:
        if length == 4:
            if input[1] == 4:
                return sbt_single_bounds(input[2], input[3], output, output_capacity)
            if input[1] == 0:
                return sbt_single_path(input[2], input[3], output, output_capacity)
        if length == 6 and input[1] == 2:
            return sbt_single_lca(input, output, output_capacity)
        if length == 5 and input[1] == 3:
            return sbt_single_ancestor(input, output, output_capacity)
        if input[1] == 1:
            return sbt_single_decode(input, length, output, output_capacity)
        return sbt_process_single(input, length, output, output_capacity)
    sbt_process_batch(input, length, output, output_capacity, query_count)

@inline(never)
def sbt_process_single(input: i64&, length: usize, output: mutable u8&?, output_capacity: usize) -> i64:
    # A path record uses two header words and at most two words per run.
    words: mutable i64[2+2*MAX_RUNS] = zeroed
    sbt_process(input, length, output, output_capacity, 1, words[0:2+2*MAX_RUNS])

@inline(never)
def sbt_process_batch(input: i64&, length: usize, output: mutable u8&?, output_capacity: usize, query_count: i64) -> i64:
    words: mutable i64[MAX_OUTPUT_WORDS] = zeroed
    sbt_process(input, length, output, output_capacity, query_count, words[0:MAX_OUTPUT_WORDS])

@inline(never)
def sbt_process(input: i64&, length: usize, output: mutable u8&?, output_capacity: usize, query_count: i64, words: mutable view[i64]) -> i64:
    word_count: mutable usize = 0
    position: mutable usize = 1
    query: mutable i64 = 0
    while query < query_count:
        if position >= length: return -1
        operation: i64 = input[position]
        position <- position + 1
        if operation == 0:
            if position + 2 > length: return -1
            numerator: i64 = input[position]
            denominator: i64 = input[position + 1]
            position <- position + 2
            if not sbt_fraction_in_range(numerator, denominator): return -1
            runs: mutable SbtRun[MAX_RUNS] = zeroed
            run_count: i64 = sbt_encode_path(numerator, denominator, runs[0:MAX_RUNS])
            if run_count < 0 or not sbt_append(words, word_count, operation) or
                not sbt_append(words, word_count, run_count): return -1
            index: mutable usize = 0
            while index < run_count.usize():
                if not sbt_append(words, word_count, runs[index].direction) or
                    not sbt_append(words, word_count, runs[index].count): return -1
                index <- index + 1
        elif operation == 1:
            if position >= length: return -1
            raw_count: i64 = input[position]
            position <- position + 1
            if raw_count < 0 or raw_count > MAX_RUNS.i64() or position + raw_count.usize() * 2 > length: return -1
            runs: mutable SbtRun[MAX_RUNS] = zeroed
            index: mutable usize = 0
            while index < raw_count.usize():
                runs[index] <- SbtRun{direction: input[position], count: input[position + 1]}
                position <- position + 2
                index <- index + 1
            decoded: mutable SbtDecoded = zeroed
            if not sbt_decode_path(runs[0:raw_count.usize()], decoded) or
                not sbt_append(words, word_count, operation) or
                not sbt_append(words, word_count, decoded.numerator) or
                not sbt_append(words, word_count, decoded.denominator): return -1
        elif operation == 2:
            if position + 4 > length: return -1
            a: i64 = input[position]
            b: i64 = input[position + 1]
            c: i64 = input[position + 2]
            d: i64 = input[position + 3]
            position <- position + 4
            if not sbt_fraction_in_range(a, b) or not sbt_fraction_in_range(c, d): return -1
            left: mutable SbtRun[MAX_RUNS] = zeroed
            right: mutable SbtRun[MAX_RUNS] = zeroed
            prefix: mutable SbtRun[MAX_RUNS] = zeroed
            left_count: i64 = sbt_encode_path(a, b, left[0:MAX_RUNS])
            right_count: i64 = sbt_encode_path(c, d, right[0:MAX_RUNS])
            if left_count < 0 or right_count < 0: return -1
            prefix_count: usize = sbt_common_prefix(left[0:left_count.usize()], right[0:right_count.usize()], prefix[0:MAX_RUNS])
            decoded: mutable SbtDecoded = zeroed
            if not sbt_decode_path(prefix[0:prefix_count], decoded) or
                not sbt_append(words, word_count, operation) or
                not sbt_append(words, word_count, decoded.numerator) or
                not sbt_append(words, word_count, decoded.denominator): return -1
        elif operation == 3:
            if position + 3 > length: return -1
            depth: i64 = input[position]
            numerator: i64 = input[position + 1]
            denominator: i64 = input[position + 2]
            position <- position + 3
            if depth < 1 or depth > MAX_COMPONENT or not sbt_fraction_in_range(numerator, denominator): return -1
            path: mutable SbtRun[MAX_RUNS] = zeroed
            prefix: mutable SbtRun[MAX_RUNS] = zeroed
            path_count: i64 = sbt_encode_path(numerator, denominator, path[0:MAX_RUNS])
            if path_count < 0 or not sbt_append(words, word_count, operation): return -1
            total_depth: mutable i64 = 0
            index: mutable usize = 0
            while index < path_count.usize():
                total_depth <- total_depth + path[index].count
                index <- index + 1
            if depth > total_depth:
                if not sbt_append(words, word_count, -1): return -1
            else:
                remaining: mutable i64 = depth
                prefix_count: mutable usize = 0
                index <- 0
                while index < path_count.usize() and remaining > 0:
                    take: i64 = remaining if remaining < path[index].count else path[index].count
                    prefix[prefix_count] <- SbtRun{direction: path[index].direction, count: take}
                    prefix_count <- prefix_count + 1
                    remaining <- remaining - take
                    index <- index + 1
                decoded: mutable SbtDecoded = zeroed
                if not sbt_decode_path(prefix[0:prefix_count], decoded) or
                    not sbt_append(words, word_count, decoded.numerator) or
                    not sbt_append(words, word_count, decoded.denominator): return -1
        elif operation == 4:
            if position + 2 > length: return -1
            numerator: i64 = input[position]
            denominator: i64 = input[position + 1]
            position <- position + 2
            if not sbt_fraction_in_range(numerator, denominator): return -1
            decoded: mutable SbtDecoded = zeroed
            if not sbt_descendant_bounds(numerator, denominator, decoded) or
                not sbt_append(words, word_count, operation) or
                not sbt_append(words, word_count, decoded.lower_num) or
                not sbt_append(words, word_count, decoded.lower_den) or
                not sbt_append(words, word_count, decoded.upper_num) or
                not sbt_append(words, word_count, decoded.upper_den): return -1
        else:
            return -1
        query <- query + 1
    if position != length: return -1
    byte_count: usize = word_count * 8
    if output_capacity < byte_count or output == null: return -2
    index: mutable usize = 0
    while index < word_count:
        bits: u64 = words[index].u64()
        byte: mutable usize = 0
        while byte < 8:
            output[index * 8 + byte] <- ((bits >> (byte * 8)) & 255).u8()
            byte <- byte + 1
        index <- index + 1
    query_count

export fn stern_brocot_tree(input: i64&?, length: usize,
    output: mutable u8&?, output_capacity: usize) -> i64 = stern_brocot_tree_impl
