# mode 0 checks a prefix; mode 1 checks a suffix. Values are UTF-16 code units.
def string_prefix_suffix_impl(values: i64&, length: usize) -> i64:
    if length < 3 or length > 2052:
        return -1
    mode: i64 = values[0]
    text_count_value: i64 = values[1]
    pattern_count_value: i64 = values[2]
    if (mode != 0 and mode != 1) or text_count_value < 0 or text_count_value > 1024 or pattern_count_value < 0 or pattern_count_value > 1024:
        return -1
    text_count: usize = text_count_value.usize()
    pattern_count: usize = pattern_count_value.usize()
    if length != 3 + text_count + pattern_count:
        return -1
    for index in 0..<(text_count + pattern_count):
        unit: i64 = values[3 + index]
        if unit < 0 or unit > 65535:
            return -1
    if pattern_count > text_count:
        return 0
    start: usize = 0
    if mode == 1:
        start = text_count - pattern_count
    for index in 0..<pattern_count:
        if values[3 + start + index] != values[3 + text_count + index]:
            return 0
    1

export fn string_prefix_suffix(values: i64&, length: usize) -> i64 = string_prefix_suffix_impl
