# A bounded wavelet matrix with per-level zero-partition prefix sums.
def range_sum_upper_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or input[0] < 1 or input[0] > 64 or input[1] < 1 or input[1] > 64:
        return -1
    n: usize = input[0].usize()
    q: usize = input[1].usize()
    if length != 2 + n + 3 * q:
        return -1
    current: mutable u32[64] = zeroed
    next: mutable u32[64] = zeroed
    i: mutable usize = 0
    while i < n:
        if input[2 + i] < 0 or input[2 + i] > 1000000000:
            return -1
        current[i] <- input[2 + i].u32()
        i <- i + 1
    i <- 0
    while i < q:
        l: i64 = input[2 + n + 3 * i]
        r: i64 = input[3 + n + 3 * i]
        x: i64 = input[4 + n + 3 * i]
        if l < 0 or l > r or r > n.i64() or x < 0 or x > 1000000000:
            return -1
        i <- i + 1
    if output == null or capacity < 16 * q:
        return -2
    zeros: mutable u8[1950] = zeroed
    zero_total: mutable u8[30] = zeroed
    sums: mutable u64[1950] = zeroed
    level: mutable usize = 0
    while level < 30:
        bit: u32 = 29 - level.u32()
        row: usize = level * 65
        i <- 0
        while i < n:
            zero: bool = ((current[i] >> bit) & 1) == 0
            zeros[row + i + 1] <- zeros[row + i] + (1.u8() if zero else 0.u8())
            sums[row + i + 1] <- sums[row + i] + (current[i].u64() if zero else 0.u64())
            i <- i + 1
        zero_total[level] <- zeros[row + n]
        a: mutable usize = 0
        b: mutable usize = zero_total[level].usize()
        i <- 0
        while i < n:
            if ((current[i] >> bit) & 1) != 0:
                next[b] <- current[i]
                b <- b + 1
            else:
                next[a] <- current[i]
                a <- a + 1
            i <- i + 1
        i <- 0
        while i < n:
            current[i] <- next[i]
            i <- i + 1
        level <- level + 1
    i <- 0
    while i < q:
        l: mutable usize = input[2 + n + 3 * i].usize()
        r: mutable usize = input[3 + n + 3 * i].usize()
        upper: u32 = input[4 + n + 3 * i].u32() + 1
        count: mutable u64 = 0
        sum: mutable u64 = 0
        level <- 0
        while level < 30:
            row: usize = level * 65
            zl: usize = zeros[row + l].usize()
            zr: usize = zeros[row + r].usize()
            if ((upper >> (29 - level.u32())) & 1) != 0:
                count <- count + (zr - zl).u64()
                sum <- sum + (sums[row + r] - sums[row + l])
                l <- zero_total[level].usize() + l - zl
                r <- zero_total[level].usize() + r - zr
            else:
                l <- zl
                r <- zr
            level <- level + 1
        byte: mutable usize = 0
        while byte < 8:
            output[16 * i + byte] <- ((count >> (8 * byte)) & 255).u8()
            output[16 * i + 8 + byte] <- ((sum >> (8 * byte)) & 255).u8()
            byte <- byte + 1
        i <- i + 1
    (16 * q).i64()

export fn static_range_sum_with_upper_bound(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = range_sum_upper_impl
