@intrinsic("llvm.ctlz.i32")
extern leading_zeros(value: u32, zero_undefined: bool) -> u32
def range_sum_upper_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 258: return -1
    if input[0] < 1 or input[0] > 64 or input[1] < 1 or input[1] > 64: return -1
    n: usize = input[0].usize()
    q: usize = input[1].usize()
    if length != 2+n+3*q: return -1
    current: mutable i64[128] = zeroed
    maximum: mutable i64 = 0
    for i in 0..<n:
        if input[2+i] < 0 or input[2+i] > 1000000000: return -1
        current[i] <- input[2+i]
        maximum <- current[i] if current[i] > maximum
    needs_partitions: mutable bool = false
    for i in 0..<q:
        b: usize = 2+n+3*i
        if input[b] < 0 or input[b] > input[b+1] or input[b+1] > n.i64(): return -1
        if input[b+2] < 0 or input[b+2] > 1000000000: return -1
        needs_partitions <- needs_partitions or input[b+2] < maximum
    if output == null or capacity < 16*q: return -2
    # The maximum sum is 64 billion, which fits below bit 36.
    prefixes: mutable i64[1950] = zeroed
    offsets: mutable usize[30] = zeroed
    # Leading zero bits cannot partition any input value.
    first_level: mutable usize = 0
    if needs_partitions:
        first_level <- (leading_zeros(maximum.u32() | 1, false) - 2).usize()
        for level in first_level..<30:
            mask: i64 = 1.i64() << (29-level)
            source: usize = ((level - first_level) & 1) << 6
            target: usize = source ^ 64
            zeros: mutable usize = 0
            prefix: mutable i64 = 0
            for i in 0..<n:
                value: i64 = current[source + i]
                if (value & mask) == 0:
                    zeros <- zeros + 1
                    prefix <- prefix + (1.i64() << 36) + value
                prefixes[65*level+i+1] <- prefix
            offsets[level] <- zeros
            if level == 29: break
            z: mutable usize = 0
            o: mutable usize = zeros
            for i in 0..<n:
                value: i64 = current[source + i]
                if (value & mask) == 0:
                    current[target + z] <- value
                    z <- z+1
                else:
                    current[target + o] <- value
                    o <- o+1
    answers: mutable i64[128] = zeroed
    for i in 0..<q:
        b: usize = 2+n+3*i
        l: mutable usize = input[b].usize()
        r: mutable usize = input[b+1].usize()
        key: i64 = input[b+2]+1
        count: mutable i64 = 0
        total: mutable i64 = 0
        if key > maximum:
            count <- (r - l).i64()
            for index in l..<r:
                total <- total + input[2 + index]
        else:
            prefix_total: mutable i64 = 0
            for level in first_level..<30:
                left: i64 = prefixes[65*level+l]
                right: i64 = prefixes[65*level+r]
                zl: usize = (left >> 36).usize()
                zr: usize = (right >> 36).usize()
                if (key & (1.i64() << (29-level))) != 0:
                    prefix_total <- prefix_total + right - left
                    l <- l+offsets[level]-zl
                    r <- r+offsets[level]-zr
                else:
                    l <- zl
                    r <- zr
            count <- prefix_total >> 36
            total <- prefix_total & ((1.i64() << 36) - 1)
        answers[2*i] <- count
        answers[2*i+1] <- total
    for i in 0..<q:
        count: i64 = answers[2*i]
        total: i64 = answers[2*i+1]
        for byte in 0..<8:
            output[16*i+byte] <- ((count >> (8*byte)) & 255).u8()
            output[16*i+8+byte] <- ((total >> (8*byte)) & 255).u8()
    return (16*q).i64()

export fn static_range_sum_with_upper_bound(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = range_sum_upper_impl
