# Range longest increasing subsequence queries over a permutation, each
# answered by patience sorting with binary-searched tails.
const MAX_N: usize = 128
const MAX_Q: usize = 32

def lis_lower_bound(a: view[i64], n: usize, x: i64) -> usize:
    lo: mutable usize = 0
    hi: mutable usize = n
    while lo < hi:
        mid: usize = lo + (hi - lo) / 2
        if a[mid] < x:
            lo <- mid + 1
        else:
            hi <- mid
    lo

def lis_write_i64_le(output: mutable u8&, at: usize, value: i64) -> void:
    bits: u64 = value.u64()
    b: mutable usize = 0
    while b < 8:
        output[at + b] <- ((bits >> (8 * b).u64()) & 255).u8()
        b <- b + 1

def static_range_lis_query_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 195:
        return -1
    n64: i64 = input[0]
    q64: i64 = input[1]
    if n64 < 1 or n64 > MAX_N.i64() or q64 < 1 or q64 > MAX_Q.i64():
        return -1
    n: usize = n64.usize()
    q: usize = q64.usize()
    if length != 2 + n + 2 * q:
        return -1
    permutation: mutable i64[128] = zeroed
    left: mutable i64[32] = zeroed
    right: mutable i64[32] = zeroed
    seen: mutable u8[128] = zeroed
    i: mutable usize = 0
    while i < n:
        value: i64 = input[2 + i]
        if value < 0 or value >= n64 or seen[value.usize()] != 0:
            return -1
        seen[value.usize()] <- 1
        permutation[i] <- value
        i <- i + 1
    off: mutable usize = 2 + n
    k: mutable usize = 0
    while k < q:
        left[k] <- input[off]
        right[k] <- input[off + 1]
        off <- off + 2
        if left[k] < 0 or left[k] > right[k] or right[k] > n64:
            return -1
        k <- k + 1
    answers: mutable i64[32] = zeroed
    tails: mutable i64[128] = zeroed
    k <- 0
    while k < q:
        count: mutable usize = 0
        i <- left[k].usize()
        while i < right[k].usize():
            at: usize = lis_lower_bound(tails[0:MAX_N], count, permutation[i])
            tails[at] <- permutation[i]
            if at == count:
                count <- count + 1
            i <- i + 1
        answers[k] <- count.i64()
        k <- k + 1
    bytes: usize = 8 * q
    if output == null or capacity < bytes:
        return -2
    k <- 0
    while k < q:
        lis_write_i64_le(output, 8 * k, answers[k])
        k <- k + 1
    bytes.i64()

export fn static_range_lis_query(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = static_range_lis_query_impl
