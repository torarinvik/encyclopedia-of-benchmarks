const MAX_Q: usize = 32

def lis_popcount(bits: u64) -> u8:
    pairs: u64 = bits - ((bits >> 1) & 0x5555555555555555.u64())
    nibbles: u64 = (pairs & 0x3333333333333333.u64()) + ((pairs >> 2) & 0x3333333333333333.u64())
    bytes: u64 = (nibbles + (nibbles >> 4)) & 0x0f0f0f0f0f0f0f0f.u64()
    ((bytes * 0x0101010101010101.u64()) >> 56).u8()

# Each set bit is the smallest known tail for one subsequence length.
# Insert the new tail and clear its smallest successor, including across words.
@inline(always)
def lis_bit_count(input: i64&, left: usize, right: usize, wide: bool) -> u8:
    lower: mutable u64 = 0
    upper: mutable u64 = 0
    for index in (2 + left)..<(2 + right):
        value: u64 = input[index].u64()
        bit: u64 = 1.u64() << (value & 63)
        if not wide or value < 64:
            successors: u64 = lower & (0.u64() - bit)
            lower <- (lower ^ (successors & (0.u64() - successors))) | bit
            if wide and successors == 0: upper <- upper & (upper - 1) if wide
        else:
            successors: u64 = upper & (0.u64() - bit)
            upper <- (upper ^ (successors & (0.u64() - successors))) | bit
    lis_popcount(lower) + lis_popcount(upper)

def static_range_lis_query_impl(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64:
    if input == null or length < 2 or length > 195: return -1
    n64: u64 = input[0].u64()
    q64: u64 = input[1].u64()
    if n64 - 1 >= 128 or q64 - 1 >= 32: return -1
    n: usize = n64.usize()
    q: usize = q64.usize()
    if length != 2 + n + 2 * q: return -1
    if n <= 64:
        seen: mutable u64 = 0
        for index in 2..<(2 + n):
            value: u64 = input[index].u64()
            if value >= n64: return -1
            mask: u64 = 1.u64() << value
            if (seen & mask) != 0: return -1
            seen <- seen | mask
    else:
        seen: mutable u64[2] = zeroed
        for index in 2..<(2 + n):
            value: u64 = input[index].u64()
            if value >= n64: return -1
            word: usize = (value >> 6).usize()
            mask: u64 = 1.u64() << (value & 63)
            if (seen[word] & mask) != 0: return -1
            seen[word] <- seen[word] | mask
    bytes: usize = 8 * q
    can_write: bool = output != null and capacity >= bytes
    answers: mutable u8[MAX_Q] = zeroed
    for query in 0..<q:
        offset: usize = 2 + n + 2 * query
        left: u64 = input[offset].u64()
        right: u64 = input[offset + 1].u64()
        if left > right or right > n64: return -1
        if can_write:
            answers[query] <- lis_bit_count(input, left.usize(), right.usize(), false) if n <= 64 else lis_bit_count(input, left.usize(), right.usize(), true)
    if output == null or capacity < bytes: return -2
    # All reads are finished, so output can overlap the input frame.
    for query in 0..<q:
        output[8 * query] <- answers[query]
        for byte in 1..<8:
            output[8 * query + byte] <- 0
    bytes.i64()

export fn static_range_lis_query(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = static_range_lis_query_impl
