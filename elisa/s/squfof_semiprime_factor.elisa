const SQ_MAX_NUMBER: i64 = 1000000000000
const SQ_MAX_STEPS: i64 = 256

@link_name("llvm.sqrt.f64")
extern sqrt(value: f64) -> f64

def sq_gcd(left_value: i64, right_value: i64) -> i64:
    left: mutable i64 = left_value
    right: mutable i64 = right_value
    while right != 0:
        remainder: i64 = left % right
        left <- right
        right <- remainder
    left

def sq_reverse(number: i64, discriminant: i64, a: i64, p: i64, q: i64, cap: i64) -> i64:
    if q <= 0:
        return 0
    # Consecutive denominators multiply to D - p*p, so q is at most D.
    root: i64 = sqrt(q.f64()).i64()
    if root * root != q:
        return 0
    quotient: i64 = (a - p) / root
    r: mutable i64 = quotient * root + p
    previous_s: mutable i64 = root
    s: mutable i64 = (discriminant - r * r) / root
    step: mutable i64 = 0
    while step < cap:
        next_quotient: i64 = (a + r) / s
        next_r: i64 = a - (a + r) % s
        if next_r == r:
            factor: i64 = sq_gcd(number, r)
            if factor > 1 and factor < number:
                other: i64 = number / factor
                if factor < other:
                    return factor
                return other
            return 0
        next_s: i64 = previous_s + next_quotient * (r - next_r)
        previous_s <- s
        s <- next_s
        r <- next_r
        step <- step + 1
    0

def squfof_semiprime_factor_impl(input: i64&?, input_length: usize) -> i64:
    if input_length != 3 or input == null:
        return -1
    number: i64 = input[0]
    forward_cap: i64 = input[1]
    reverse_cap: i64 = input[2]
    if number < 3 or number > SQ_MAX_NUMBER or number % 2 == 0 or forward_cap < 0 or forward_cap > SQ_MAX_STEPS or reverse_cap < 0 or reverse_cap > SQ_MAX_STEPS:
        return -1
    # Validation bounds the number and discriminant below 2^41 for exact floor roots.
    exact_root: i64 = sqrt(number.f64()).i64()
    if exact_root * exact_root == number:
        return exact_root
    discriminant: i64 = 2 * number if number % 4 == 1 else number
    a: i64 = sqrt(discriminant.f64()).i64()
    previous_q: mutable i64 = 1
    q: mutable i64 = discriminant - a * a
    p: mutable i64 = a
    step: mutable i64 = 0
    while step < forward_cap:
        quotient: i64 = (a + p) / q
        next_p: i64 = a - (a + p) % q
        next_q: i64 = previous_q + quotient * (p - next_p)
        previous_q <- q
        q <- next_q
        p <- next_p
        if (step & 1) == 0:
            factor: i64 = sq_reverse(number, discriminant, a, p, q, reverse_cap)
            if factor != 0:
                return factor
        step <- step + 1
    0

export fn squfof_semiprime_factor(input: i64&?, input_length: usize) -> i64 = squfof_semiprime_factor_impl
