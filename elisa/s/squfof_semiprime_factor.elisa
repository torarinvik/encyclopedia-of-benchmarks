# Shanks' square forms factorization: a forward walk to a square form, then a
# reverse walk to the symmetry point whose numerator shares a factor.
const SQUFOF_MAX_NUMBER: i64 = 1000000000000
const SQUFOF_MAX_STEPS: i64 = 256

def squfof_isqrt(value: i64, upper: i64) -> i64:
    low: mutable i64 = 0
    high: mutable i64 = upper + 1
    while low + 1 < high:
        middle: i64 = low + (high - low) / 2
        if middle * middle <= value:
            low <- middle
        else:
            high <- middle
    low

def squfof_gcd(left_value: i64, right_value: i64) -> i64:
    left: mutable i64 = left_value
    right: mutable i64 = right_value
    while right != 0:
        remainder: i64 = left % right
        left <- right
        right <- remainder
    left

def squfof_reverse(number: i64, discriminant: i64, root_bound: i64, p: i64, q: i64, reverse_cap: i64) -> i64:
    square_root: i64 = squfof_isqrt(q, root_bound)
    if square_root * square_root != q:
        return 0
    quotient: i64 = (root_bound - p) / square_root
    r: mutable i64 = quotient * square_root + p
    previous_s: mutable i64 = square_root
    s: mutable i64 = (discriminant - r * r) / square_root
    step: mutable i64 = 0
    while step < reverse_cap:
        next_quotient: i64 = (root_bound + r) / s
        next_r: i64 = next_quotient * s - r
        if next_r == r:
            factor: i64 = squfof_gcd(number, r)
            if factor > 1 and factor < number:
                other: i64 = number / factor
                return factor if factor < other else other
            return 0
        next_s: i64 = previous_s + next_quotient * (r - next_r)
        previous_s <- s
        s <- next_s
        r <- next_r
        step <- step + 1
    0

def squfof_semiprime_factor_impl(input: i64&?, length: usize) -> i64:
    if input == null or length != 3:
        return -1
    number: i64 = input[0]
    forward_cap: i64 = input[1]
    reverse_cap: i64 = input[2]
    if number < 3 or number > SQUFOF_MAX_NUMBER or number % 2 == 0 or forward_cap < 0 or forward_cap > SQUFOF_MAX_STEPS or reverse_cap < 0 or reverse_cap > SQUFOF_MAX_STEPS:
        return -1

    initial_root: i64 = squfof_isqrt(number, 1000000)
    if initial_root * initial_root == number:
        return initial_root
    discriminant: i64 = 2 * number if number % 4 == 1 else number
    a: i64 = squfof_isqrt(discriminant, 1414214)
    previous_q: mutable i64 = 1
    q: mutable i64 = discriminant - a * a
    p: mutable i64 = a
    index: mutable i64 = 1
    step: mutable i64 = 0
    while step < forward_cap:
        quotient: i64 = (a + p) / q
        next_p: i64 = quotient * q - p
        next_q: i64 = previous_q + quotient * (p - next_p)
        previous_q <- q
        q <- next_q
        p <- next_p
        index <- index + 1
        if index % 2 == 0:
            factor: i64 = squfof_reverse(number, discriminant, a, p, q, reverse_cap)
            if factor != 0:
                return factor
        step <- step + 1
    0

export fn squfof_semiprime_factor(input: i64&?, length: usize) -> i64 = squfof_semiprime_factor_impl
