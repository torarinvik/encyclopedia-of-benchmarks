const MODULUS: u64 = 998244353
const MAX_INPUT_LENGTH: usize = 19

def square_four(value: u64) -> u64:
    squared: u64 = (value * value) % MODULUS
    fourth: u64 = (squared * squared) % MODULUS
    eighth: u64 = (fourth * fourth) % MODULUS
    (eighth * eighth) % MODULUS

def field_inverse(value: u64) -> u64:
    # Fermat's exponent p-2 is 0x3B7FFFFF. Append one hex digit at a time.
    second: u64 = (value * value) % MODULUS
    third: u64 = (second * value) % MODULUS
    fourth: u64 = (second * second) % MODULUS
    seventh: u64 = (third * fourth) % MODULUS
    eleventh: u64 = (seventh * fourth) % MODULUS
    fifteenth: u64 = (eleventh * fourth) % MODULUS
    high: u64 = (square_four(third) * eleventh) % MODULUS
    result: mutable u64 = (square_four(high) * seventh) % MODULUS
    for digit in 0..<5:
        result <- (square_four(result) * fifteenth) % MODULUS
    result

def store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def steed_continued_fraction_impl(input: i64&?, length: usize, output: mutable u8&?,
                                  capacity: usize) -> i64:

    if input == null or length < 4 or length > MAX_INPUT_LENGTH: return -1
    levels_value: i64 = input[0]
    if levels_value < 1 or levels_value > 8: return -1
    levels: usize = levels_value.usize()
    if length != 2 + 2 * levels: return -1
    for index in 1..<length:
        if input[index] < 0 or input[index].u64() >= MODULUS: return -1
    if input[2] == 0: return -1
    convergents: mutable u64[9] = zeroed
    current: mutable u64 = input[1].u64()
    convergents[0] <- current
    d_value: mutable u64 = field_inverse(input[2].u64())
    delta: mutable u64 = (input[3].u64() * d_value) % MODULUS
    current <- (current + delta) % MODULUS
    convergents[1] <- current
    for level in 2..<(levels + 1):
        b_value: u64 = input[2 * level].u64()
        a_value: u64 = input[2 * level + 1].u64()
        denominator: u64 = (d_value * a_value + b_value) % MODULUS
        if denominator == 0: return -1
        d_value <- field_inverse(denominator)
        factor: u64 = (b_value * d_value + MODULUS - 1) % MODULUS
        delta <- (factor * delta) % MODULUS
        current <- (current + delta) % MODULUS
        convergents[level] <- current
    required: usize = 8 * (levels + 2)
    if output == null or capacity < required: return -2
    store_i64_le(levels_value + 1, output, 0)
    for index in 0..<(levels + 1):
        store_i64_le(convergents[index].i64(), output, 8 * (index + 1))
    required.i64()

export fn steed_continued_fraction_convergents(input: i64&?, length: usize, output: mutable u8&?, capacity: usize) -> i64 = steed_continued_fraction_impl
