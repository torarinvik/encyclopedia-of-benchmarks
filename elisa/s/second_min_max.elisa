const INVALID_RESULT: i64 = -9223372036854775808
const INT32_MIN_VALUE: i64 = -2147483648
const INT32_MAX_VALUE: i64 = 2147483647
const MAX_INPUT_LENGTH: usize = 259

def second_min_max_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4 or length > MAX_INPUT_LENGTH:
        return INVALID_RESULT
    operation: i64 = input[0]
    raw_count: i64 = input[1]
    if (operation != 0 and operation != 1) or raw_count < 2 or raw_count > 256:
        return INVALID_RESULT
    count: usize = raw_count.usize()
    if length != count + 2:
        return INVALID_RESULT
    initial: i64 = if operation == 0: INT32_MAX_VALUE else: INT32_MIN_VALUE
    best: mutable i64 = initial
    second: mutable i64 = initial
    index: mutable usize = 0
    while index < count:
        value: i64 = input[index + 2]
        if value < INT32_MIN_VALUE or value > INT32_MAX_VALUE:
            return INVALID_RESULT
        better: bool = if operation == 0: value < best else: value > best
        if better:
            second <- best
            best <- value
        else:
            improves_second: bool = if operation == 0: value < second else: value > second
            if improves_second and value != best:
                second <- value
        index <- index + 1
    if second == initial:
        return INVALID_RESULT
    second

export fn second_min_max(input: i64&, length: usize) -> i64 = second_min_max_impl
