# Bounded array-backed integer stack used by the shared operation-trace benchmark.
const INVALID_RESULT: i64 = -1
const CAPACITY: usize = 256
const MAX_OPERATIONS: usize = 512
const VALUE_OFFSET: i64 = 1000000

def stack_benchmark_impl(values: i64&, length: usize) -> i64:
    if length > 2 * MAX_OPERATIONS or length % 2 != 0:
        return INVALID_RESULT
    operation_count: usize = length / 2
    data_stack: mutable i64[256] = zeroed
    top: mutable usize = 0
    checksum: mutable i64 = 0
    operation: mutable usize = 0
    while operation < operation_count:
        opcode: i64 = values[2 * operation]
        payload: i64 = values[2 * operation + 1]
        observed: mutable i64 = 0
        returns_value: mutable bool = true
        if opcode == 0:
            if payload < -VALUE_OFFSET or payload > VALUE_OFFSET or top == CAPACITY:
                return INVALID_RESULT
            data_stack[top] <- payload
            top <- top + 1
            returns_value <- false
        elif opcode == 1:
            if payload != 0 or top == 0:
                return INVALID_RESULT
            top <- top - 1
            observed <- data_stack[top]
        elif opcode == 2:
            if payload != 0 or top == 0:
                return INVALID_RESULT
            observed <- data_stack[top - 1]
        elif opcode == 3:
            if payload != 0:
                return INVALID_RESULT
            observed <- 1 if top == 0 else 0
        else:
            return INVALID_RESULT
        if returns_value:
            checksum <- checksum + (operation.i64() + 1) * (observed + VALUE_OFFSET)
        operation <- operation + 1
    index: mutable usize = 0
    while index < top:
        checksum <- checksum + (operation_count.i64() + index.i64() + 1) * (data_stack[index] + VALUE_OFFSET)
        index <- index + 1
    checksum

export fn stack_benchmark(values: i64&, length: usize) -> i64 = stack_benchmark_impl
