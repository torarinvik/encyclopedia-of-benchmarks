# Bounded array-backed integer stack with deterministic operation-trace checksum.
def stack_benchmark_impl(values: i64&, length: usize) -> i64:
    if length == 0:
        return 0
    if length == 2:
        opcode: i64 = values[0]
        payload: i64 = values[1]
        if opcode == 0:
            encoded: u64 = payload.u64() + 1000000
            return (2 * encoded).i64() if encoded <= 2000000 else -1
        return 1000001 if ((opcode ^ 3) | payload) == 0 else -1
    if length > 1024 or length % 2 != 0:
        return -1
    operation_count: usize = length / 2
    # Even an all-push trace cannot exceed the small stack here.
    if operation_count <= 8:
        small_stack: mutable i32[8] = zeroed
        return stack_run(values, operation_count, &small_stack[0])
    data_stack: mutable i32[256] = zeroed
    stack_run(values, operation_count, &data_stack[0])

@inline(never)
def stack_run(values: i64&, operation_count: usize, data_stack: mutable i32&) -> i64:
    top: mutable usize = 0
    # At most 768 terms, each bounded by 768 * 2000000.
    checksum: mutable u64 = 0
    operation: mutable usize = 0
    while operation < operation_count:
        opcode: i64 = values[2 * operation]
        payload: i64 = values[2 * operation + 1]
        operation <- operation + 1
        if opcode == 0:
            encoded: u64 = payload.u64() + 1000000
            if encoded > 2000000 or top == 256:
                return -1
            data_stack[top] <- encoded.i32()
            top <- top + 1
        else:
            if (payload.u64() | (opcode.u64() >> 2)) != 0:
                return -1
            if opcode == 3:
                observed: u64 = 1000001 if top == 0 else 1000000
                checksum <- checksum + operation.u64() * observed
            else:
                if top == 0:
                    return -1
                last: usize = top - 1
                checksum <- checksum + operation.u64() * data_stack[last & 255].u64()
                if opcode == 1:
                    top <- last
    # Each product fits in u32 (weight at most 768, value at most 2000000).
    index: mutable usize = 0
    while index < top:
        checksum <- checksum + ((operation_count + index + 1).u32() * data_stack[index].u32()).u64()
        index <- index + 1
    checksum.i64()

export fn stack_benchmark(values: i64&, length: usize) -> i64 = stack_benchmark_impl
