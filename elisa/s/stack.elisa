# Bounded array-backed integer stack with deterministic operation-trace checksum.
def stack_benchmark_impl(values: i64&, length: usize) -> i64:
    if length == 0:
        return 0
    if length % 2 != 0:
        return -1
    if length == 2:
        opcode: i64 = values[0]
        payload: i64 = values[1]
        if opcode == 3:
            return 1000001 if payload == 0 else -1
        if opcode != 0:
            return -1
        encoded: u64 = payload.u64() + 1000000
        return (2 * encoded).i64() if encoded <= 2000000 else -1
    if length > 1024:
        return -1
    # Validated length bounds the operation count to 512.
    operation_count: usize = length / 2
    # Even an all-push trace fits here, so the inlined loop needs no capacity check.
    if operation_count <= 8:
        return stack_short(values, operation_count.u8())
    stack_large(values, operation_count.u32())

@inline(never)
def stack_short(values: i64&, operation_count: u8) -> i64:
    small_stack: mutable u32[8] = zeroed
    stack_run(values, operation_count.u32(), &small_stack[0], false)

@inline(never)
def stack_large(values: i64&, operation_count: u32) -> i64:
    if operation_count <= 8 or operation_count > 512:
        return -1
    data_stack: mutable u32[256] = zeroed
    stack_run(values, operation_count, &data_stack[0], true)

@inline(always)
def stack_run(values: i64&, operation_count: u32, data_stack: mutable u32&, check_capacity: bool) -> i64:
    top: mutable u32 = 0
    # At most 768 terms, each bounded by 768 * 2000000.
    checksum: mutable u64 = 0
    operation: mutable u32 = 0
    cursor: mutable i64& = values
    # The entry point handles empty and single-operation traces before either helper.
    while true:
        opcode: i64 = cursor[0]
        payload: i64 = cursor[1]
        operation <- operation + 1
        if opcode == 0:
            encoded: u64 = payload.u64() + 1000000
            if (check_capacity and top == 256) or encoded > 2000000:
                return -1
            data_stack[top] <- encoded.u32()
            top <- top + 1
        else:
            if (payload.u64() | (opcode.u64() >> 2)) != 0:
                return -1
            observed: mutable u64 = 0
            if opcode == 3:
                observed <- 1000001 if top == 0 else 1000000
            else:
                if top == 0:
                    return -1
                last: u32 = top - 1
                value: u64 = data_stack[last].u64()
                if opcode == 1:
                    top <- last
                observed <- value
            checksum <- checksum + operation.u64() * observed
        if operation == operation_count:
            break
        cursor <- &cursor[2]
    index: mutable u32 = 0
    weight: mutable u32 = operation_count + 1
    depth: u32 = top if check_capacity or top <= 8 else 8
    while index < depth:
        checksum <- checksum + weight.u64() * data_stack[index].u64()
        index <- index + 1
        weight <- weight + 1
    checksum.i64()

export fn stack_benchmark(values: i64&, length: usize) -> i64 = stack_benchmark_impl
