# Bounded array-backed integer stack with deterministic operation-trace checksum.
def stack_benchmark_impl(values: i64&, length: usize) -> i64:
    if length > 1024 or length % 2 != 0:
        return -1
    operation_count: usize = length / 2
    if operation_count == 0:
        return 0
    # Even an all-push trace cannot exceed the small stack here.
    if operation_count <= 8:
        small_stack: mutable i32[8] = zeroed
        return stack_run(values, operation_count, &small_stack[0])
    data_stack: mutable i32[256] = zeroed
    stack_run(values, operation_count, &data_stack[0])

@inline(never)
def stack_run(values: i64&, operation_count: usize, data_stack: mutable i32&) -> i64:
    top: mutable usize = 0
    checksum: mutable i64 = 0
    operation: mutable usize = 0
    while operation < operation_count:
        opcode: i64 = values[2 * operation]
        payload: i64 = values[2 * operation + 1]
        observed: mutable i64 = 0
        returns_value: mutable bool = true
        if opcode == 0:
            if payload < -1000000 or payload > 1000000 or top == 256:
                return -1
            data_stack[top] <- payload.i32()
            top <- top + 1
            returns_value <- false
        elif opcode == 1:
            if payload != 0 or top == 0:
                return -1
            top <- top - 1
            observed <- data_stack[top & 255].i64()
        elif opcode == 2:
            if payload != 0 or top == 0:
                return -1
            observed <- data_stack[(top - 1) & 255].i64()
        elif opcode == 3:
            if payload != 0:
                return -1
            if top == 0:
                observed <- 1
        else:
            return -1
        if returns_value:
            checksum <- checksum + (operation + 1).i64() * (observed + 1000000)
        operation <- operation + 1
    index: mutable usize = 0
    while index < top:
        checksum <- checksum + (operation_count + index + 1).i64() * (data_stack[index].i64() + 1000000)
        index <- index + 1
    checksum

export fn stack_benchmark(values: i64&, length: usize) -> i64 = stack_benchmark_impl
