const P8: i64[8] = [6, 3, 7, 4, 8, 5, 10, 9]
const P10: i64[10] = [3, 5, 2, 7, 4, 10, 1, 9, 8, 6]
const P4: i64[4] = [2, 4, 3, 1]
const IP: i64[8] = [2, 6, 3, 1, 4, 8, 5, 7]
const IP_INVERSE: i64[8] = [4, 1, 3, 5, 7, 2, 8, 6]
const EXPANSION: i64[8] = [4, 1, 2, 3, 2, 3, 4, 1]
const SBOXES: i64[32] = [1, 0, 3, 2, 3, 2, 1, 0, 0, 2, 1, 3, 3, 1, 3, 2, 0, 1, 2, 3, 2, 0, 1, 3, 3, 0, 1, 0, 2, 1, 0, 3]

def sdes_table(which: usize, index: usize) -> u32:
    if which == 0: return P8[index].u32()
    if which == 1: return P10[index].u32()
    if which == 2: return IP[index].u32()
    if which == 3: return IP_INVERSE[index].u32()
    if which == 4: return EXPANSION[index].u32()
    P4[index].u32()

def sdes_permute(value: u32, input_bits: u32, which: usize, count: usize) -> u32:
    result: mutable u32 = 0
    index: mutable usize = 0
    while index < count:
        position: u32 = sdes_table(which, index)
        result <- (result << 1) | ((value >> (input_bits - position)) & 1)
        index <- index + 1
    result

def sdes_rotate5(value: u32, amount: u32) -> u32:
    ((value << amount) | (value >> (5 - amount))) & 31

def sdes_subkey(key: u32, round: u32) -> u32:
    selected: u32 = sdes_permute(key, 10, 1, 10)
    left: mutable u32 = selected >> 5
    right: mutable u32 = selected & 31
    left <- sdes_rotate5(left, 1)
    right <- sdes_rotate5(right, 1)
    if round != 0:
        left <- sdes_rotate5(left, 2)
        right <- sdes_rotate5(right, 2)
    sdes_permute((left << 5) | right, 10, 0, 8)

def sdes_sbox(which: usize, nibble: u32) -> u32:
    row: usize = (((nibble & 8) >> 2) | (nibble & 1)).usize()
    column: usize = ((nibble >> 1) & 3).usize()
    SBOXES[which * 16 + row * 4 + column].u32()

def sdes_fk(state: u32, key: u32) -> u32:
    left: u32 = state >> 4
    right: u32 = state & 15
    mixed: u32 = sdes_permute(right, 4, 4, 8) ^ key
    substituted: u32 = (sdes_sbox(0, mixed >> 4) << 2) | sdes_sbox(1, mixed & 15)
    ((left ^ sdes_permute(substituted, 4, 5, 4)) << 4) | right

def sdes_crypt(message: u32, key: u32, decrypt: bool) -> u32:
    first: u32 = sdes_subkey(key, 0)
    second: u32 = sdes_subkey(key, 1)
    state: mutable u32 = sdes_permute(message, 8, 2, 8)
    if decrypt:
        state <- sdes_fk(state, second)
    else:
        state <- sdes_fk(state, first)
    state <- ((state & 15) << 4) | (state >> 4)
    if decrypt:
        state <- sdes_fk(state, first)
    else:
        state <- sdes_fk(state, second)
    sdes_permute(state, 8, 3, 8)

def sdes_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length != 2:
        return -1
    if input[0] < 0 or input[0] > 1023 or input[1] < 0 or input[1] > 255:
        return -1
    if output.is_null() or output_capacity < 2:
        return -2
    key: u32 = input[0].u32()
    ciphertext: u32 = sdes_crypt(input[1].u32(), key, false)
    recovered: u32 = sdes_crypt(ciphertext, key, true)
    output[0] <- ciphertext.u8()
    output[1] <- recovered.u8()
    2

export fn sdes(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = sdes_impl
