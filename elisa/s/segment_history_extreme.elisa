# Historical maximum segment tree with ordered lazy add/assign summaries.
const SH_MAX_N: usize = 32
const SH_MAX_Q: usize = 32
const SH_TREE_SIZE: usize = 4 * SH_MAX_N
const SH_VALUE_LIMIT: i64 = 1000

struct ShNode:
    maximum: i64
    history_maximum: i64
    add: i64
    add_peak: i64
    set_value: i64
    set_peak: i64
    has_set: bool

def sh_max(a: i64, b: i64) -> i64:
    if a > b: a else: b

def sh_apply_add_summary(node: mutable view[ShNode], index: usize, net: i64, peak: i64) -> void:
    node[index].history_maximum <- sh_max(node[index].history_maximum, node[index].maximum + peak)
    node[index].maximum <- node[index].maximum + net
    if node[index].has_set:
        node[index].set_peak <- sh_max(node[index].set_peak, node[index].set_value + peak)
        node[index].set_value <- node[index].set_value + net
    else:
        node[index].add_peak <- sh_max(node[index].add_peak, node[index].add + peak)
        node[index].add <- node[index].add + net

def sh_apply_add(node: mutable view[ShNode], index: usize, delta: i64) -> void:
    if node[index].has_set:
        node[index].set_peak <- sh_max(node[index].set_peak, node[index].set_value + delta)
        node[index].set_value <- node[index].set_value + delta
    else:
        node[index].add_peak <- sh_max(node[index].add_peak, node[index].add + delta)
        node[index].add <- node[index].add + delta
    node[index].history_maximum <- sh_max(node[index].history_maximum, node[index].maximum + delta)
    node[index].maximum <- node[index].maximum + delta

def sh_apply_set_summary(node: mutable view[ShNode], index: usize, value: i64, peak: i64) -> void:
    node[index].history_maximum <- sh_max(node[index].history_maximum, peak)
    node[index].maximum <- value
    if node[index].has_set:
        node[index].set_peak <- sh_max(node[index].set_peak, peak)
    else:
        node[index].has_set <- true
        node[index].set_peak <- peak
    node[index].set_value <- value

def sh_apply_set(node: mutable view[ShNode], index: usize, value: i64) -> void:
    node[index].history_maximum <- sh_max(node[index].history_maximum, value)
    node[index].maximum <- value
    if node[index].has_set:
        node[index].set_peak <- sh_max(node[index].set_peak, value)
    else:
        node[index].has_set <- true
        node[index].set_peak <- value
    node[index].set_value <- value

def sh_push(tree: mutable view[ShNode], node: usize) -> void:
    add: i64 = tree[node].add
    add_peak: i64 = tree[node].add_peak
    has_set: bool = tree[node].has_set
    set_value: i64 = tree[node].set_value
    set_peak: i64 = tree[node].set_peak
    if add != 0 or add_peak != 0:
        sh_apply_add_summary(tree, 2 * node, add, add_peak)
        sh_apply_add_summary(tree, 2 * node + 1, add, add_peak)
        tree[node].add <- 0
        tree[node].add_peak <- 0
    if has_set:
        sh_apply_set_summary(tree, 2 * node, set_value, set_peak)
        sh_apply_set_summary(tree, 2 * node + 1, set_value, set_peak)
        tree[node].has_set <- false
        tree[node].set_value <- 0
        tree[node].set_peak <- 0

def sh_pull(tree: mutable view[ShNode], node: usize) -> void:
    tree[node].maximum <- sh_max(tree[2 * node].maximum, tree[2 * node + 1].maximum)
    tree[node].history_maximum <- sh_max(tree[2 * node].history_maximum, tree[2 * node + 1].history_maximum)

def sh_build(tree: mutable view[ShNode], values: view[i64], node: usize, left: usize, right: usize) -> void:
    if right - left == 1:
        tree[node].maximum <- values[left]
        tree[node].history_maximum <- values[left]
        return
    middle: usize = left + (right - left) / 2
    sh_build(tree, values, 2 * node, left, middle)
    sh_build(tree, values, 2 * node + 1, middle, right)
    sh_pull(tree, node)

def sh_update(tree: mutable view[ShNode], node: usize, left: usize, right: usize,
              ql: usize, qr: usize, assignment: bool, value: i64) -> void:
    if ql <= left and right <= qr:
        if assignment: sh_apply_set(tree, node, value)
        else: sh_apply_add(tree, node, value)
        return
    sh_push(tree, node)
    middle: usize = left + (right - left) / 2
    if ql < middle: sh_update(tree, 2 * node, left, middle, ql, qr, assignment, value)
    if middle < qr: sh_update(tree, 2 * node + 1, middle, right, ql, qr, assignment, value)
    sh_pull(tree, node)

def sh_query(tree: mutable view[ShNode], node: usize, left: usize, right: usize,
             ql: usize, qr: usize, historical: bool) -> i64:
    if ql <= left and right <= qr:
        if historical: return tree[node].history_maximum
        return tree[node].maximum
    sh_push(tree, node)
    middle: usize = left + (right - left) / 2
    answer: mutable i64 = -1000000000000
    if ql < middle: answer <- sh_query(tree, 2 * node, left, middle, ql, qr, historical)
    if middle < qr: answer <- sh_max(answer, sh_query(tree, 2 * node + 1, middle, right, ql, qr, historical))
    return answer

def sh_write_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def segment_history_extreme(input: i64&, input_length: usize, output: mutable u8&,
    output_capacity: usize) -> i64 @export("segment_history_extreme"):
    if input.is_null() or input_length < 2 or input_length > 2 + SH_MAX_N + 4 * SH_MAX_Q: return -1
    values: view[i64] = input[0:input_length]
    n_value: i64 = values[0]
    q_value: i64 = values[1]
    if n_value < 1 or n_value > SH_MAX_N.i64() or q_value < 0 or q_value > SH_MAX_Q.i64(): return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if input_length != 2 + n + 4 * q: return -1
    i: mutable usize = 0
    while i < n:
        if values[2 + i] < -SH_VALUE_LIMIT or values[2 + i] > SH_VALUE_LIMIT: return -1
        i <- i + 1
    operation_offset: usize = 2 + n
    i <- 0
    while i < q:
        offset: usize = operation_offset + 4 * i
        op: i64 = values[offset]
        left: i64 = values[offset + 1]
        right: i64 = values[offset + 2]
        arg: i64 = values[offset + 3]
        if op < 0 or op > 3 or left < 0 or right <= left or right > n_value: return -1
        if op < 2:
            if arg < -SH_VALUE_LIMIT or arg > SH_VALUE_LIMIT: return -1
        else:
            if arg != 0: return -1
        i <- i + 1

    tree: mutable ShNode[SH_TREE_SIZE] = zeroed
    staged: mutable i64[SH_MAX_Q] = zeroed
    tree_view: mutable view[ShNode] = tree[0:SH_TREE_SIZE]
    staged_view: mutable view[i64] = staged[0:SH_MAX_Q]
    initial: view[i64] = values[2:2 + n]
    sh_build(tree_view, initial, 1, 0, n)
    answer_count: mutable usize = 0
    i <- 0
    while i < q:
        offset: usize = operation_offset + 4 * i
        op: i64 = values[offset]
        left: usize = values[offset + 1].usize()
        right: usize = values[offset + 2].usize()
        arg: i64 = values[offset + 3]
        if op < 2:
            sh_update(tree_view, 1, 0, n, left, right, op == 0, arg)
        else:
            staged_view[answer_count] <- sh_query(tree_view, 1, 0, n, left, right, op == 3)
            answer_count <- answer_count + 1
        i <- i + 1
    output_bytes: usize = 8 * answer_count
    if output.is_null() or output_capacity < output_bytes: return -2
    output_view: mutable view[u8] = output[0:output_bytes]
    i <- 0
    while i < answer_count:
        sh_write_i64(output_view, 8 * i, staged_view[i])
        i <- i + 1
    output_bytes.i64()
