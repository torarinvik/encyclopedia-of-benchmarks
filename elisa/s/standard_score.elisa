@link_name("llvm.fabs.f64")
extern magnitude(value: f64) -> f64

def standard_score_impl(value: f64, mean: f64, std_dev: f64) -> f64:
    deviation_magnitude: f64 = magnitude(std_dev)
    if not (magnitude(value) <= 1000000.0 and magnitude(mean) <= 1000000.0 and
            deviation_magnitude >= 0.000001 and deviation_magnitude <= 1000000.0):
        return -1e300
    (value - mean) / std_dev

export fn standard_score(value: f64, mean: f64, std_dev: f64) -> f64 = standard_score_impl
