struct StackScratch:
    node_values: i64[65]
    next_ids: usize[65]
    buffer: i64[192]

const STACK_MAX_OPERATIONS: usize = 64
const STACK_MAX_INPUT_LENGTH: usize = 129
def stack_with_singly_linked_list_impl(input: i64&, length: usize,
                                       output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > STACK_MAX_INPUT_LENGTH: return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > 64: return -1
    count: usize = count_value.usize()
    if count == 0:
        if length != 1: return -1
        return -2 if output == null else 0
    scratch: mutable StackScratch = zeroed
    node_count: mutable usize = 0
    head: mutable usize = 0
    written: mutable usize = 0
    cursor: mutable usize = 1
    index: mutable usize = 0
    stopped: mutable bool = false
    while index < count:
        if cursor >= length: return -1
        opcode: i64 = input[cursor]
        cursor <- cursor + 1
        if opcode < 1 or opcode > 5: return -1
        pushed: mutable i64 = 0
        if opcode == 1:
            if cursor >= length: return -1
            pushed <- input[cursor]
            cursor <- cursor + 1
            if pushed < -2147483648 or pushed > 2147483647: return -1
        index <- index + 1
        # An empty pop or peek stops output but the remaining input still needs validation.
        if stopped: continue
        tag: mutable i64 = 2
        value: mutable i64 = 0
        if opcode == 1:
            node_count <- node_count + 1
            scratch.node_values[node_count] <- pushed
            scratch.next_ids[node_count] <- head
            head <- node_count
        else:
            if opcode == 2 or opcode == 3:
                if head == 0:
                    scratch.buffer[written] <- opcode
                    scratch.buffer[written + 1] <- 4
                    scratch.buffer[written + 2] <- 2
                    written <- written + 3
                    stopped <- true
                    continue
                tag <- 0
                value <- scratch.node_values[head]
                if opcode == 2: head <- scratch.next_ids[head]
            else:
                if opcode == 4:
                    head <- 0
                else:
                    tag <- 0
                    node: mutable usize = head
                    while node != 0:
                        value <- value + 1
                        node <- scratch.next_ids[node]
        scratch.buffer[written] <- opcode
        scratch.buffer[written + 1] <- tag
        scratch.buffer[written + 2] <- value
        written <- written + 3

    if cursor != length: return -1
    output_length: usize = written * 8
    if output == null or capacity < output_length: return -2
    for word in 0..<written:
        bits: u64 = scratch.buffer[word].u64()
        for byte in 0..<8:
            output[word * 8 + byte] <- (bits >> (byte * 8)).u8()
    output_length.i64()


export fn stack_with_singly_linked_list(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = stack_with_singly_linked_list_impl
