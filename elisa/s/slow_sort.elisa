# SlowSort over an inclusive interval.
def slow_sort_range(values: mutable view[i64], first: usize, last: usize) -> void:
    if first >= last:
        return
    middle: usize = first + (last - first) / 2
    slow_sort_range(values, first, middle)
    slow_sort_range(values, middle + 1, last)
    if values[last] < values[middle]:
        temporary: i64 = values[last]
        values[last] <- values[middle]
        values[middle] <- temporary
    slow_sort_range(values, first, last - 1)

def slow_sort_impl(values: mutable i64&, length: usize) -> void:
    if length > 1:
        slow_sort_range(values[0:length], 0, length - 1)

export fn slow_sort(values: mutable i64&, length: usize) -> void = slow_sort_impl
