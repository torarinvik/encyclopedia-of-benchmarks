extern trunc(value: f64) -> f64
extern sqrt(value: f64) -> f64
extern cos(value: f64) -> f64
extern sin(value: f64) -> f64

const MAX_N: usize = 64
const MAX_STEPS: usize = 8
const MAX_INPUT_LENGTH: usize = 2 + 4 * MAX_N
const TAU: f64 = 6.28318530717958647692528676655900577

def split_operator_bounded_integer(value: f64, minimum: f64, maximum: f64) -> bool:
    value == value and value >= minimum and value <= maximum and trunc(value) == value

def split_operator_fft(real: mutable view[f64], imag: mutable view[f64], n: usize,
                       inverse: bool) -> void:
    reverse: mutable usize = 0
    for position in 1..n:
        bit: mutable usize = n >> 1
        while bit != 0 and (reverse & bit) != 0:
            reverse <- reverse ^ bit
            bit <- bit >> 1
        reverse <- reverse ^ bit
        if position < reverse:
            temporary: f64 = real[position]
            real[position] <- real[reverse]
            real[reverse] <- temporary
            temporary <- imag[position]
            imag[position] <- imag[reverse]
            imag[reverse] <- temporary
    block: mutable usize = 2
    while block <= n:
        direction: f64 = if inverse: 1.0 else: -1.0
        angle: f64 = direction * TAU / block.f64()
        step_real: f64 = cos(angle)
        step_imag: f64 = sin(angle)
        start: mutable usize = 0
        while start < n:
            weight_real: mutable f64 = 1.0
            weight_imag: mutable f64 = 0.0
            for offset in 0..(block / 2):
                first: usize = start + offset
                second: usize = first + block / 2
                product_real: f64 = weight_real * real[second] - weight_imag * imag[second]
                product_imag: f64 = weight_real * imag[second] + weight_imag * real[second]
                first_real: f64 = real[first]
                first_imag: f64 = imag[first]
                real[first] <- first_real + product_real
                imag[first] <- first_imag + product_imag
                real[second] <- first_real - product_real
                imag[second] <- first_imag - product_imag
                next_real: f64 = weight_real * step_real - weight_imag * step_imag
                weight_imag <- weight_real * step_imag + weight_imag * step_real
                weight_real <- next_real
            start <- start + block
        block <- block * 2
    if inverse:
        for index in 0..n:
            real[index] <- real[index] / n.f64()
            imag[index] <- imag[index] / n.f64()

def split_operator_normalize(real: mutable view[f64], imag: mutable view[f64], n: usize) -> void:
    norm_squared: mutable f64 = 0.0
    for i in 0..n: norm_squared <- norm_squared + real[i] * real[i] + imag[i] * imag[i]
    norm: f64 = sqrt(norm_squared)
    for i in 0..n:
        real[i] <- real[i] / norm
        imag[i] <- imag[i] / norm

def split_operator_imaginary_time_impl(input: view[f64], input_length: usize,
    output: mutable view[f64], output_capacity: usize) -> i64:
    if input.is_null() || input_length < 2 || input_length > MAX_INPUT_LENGTH: return -1
    if not split_operator_bounded_integer(input[0], 2.0, MAX_N.f64()) or
        not split_operator_bounded_integer(input[1], 0.0, MAX_STEPS.f64()): return -1
    n: usize = input[0].usize()
    steps: usize = input[1].usize()
    if (n & (n - 1)) != 0 || input_length != 2 + 4 * n: return -1
    momentum_start: usize = 2 + n
    state_start: usize = 2 + 2 * n
    norm_squared: mutable f64 = 0.0
    for i in 0..n:
        position: f64 = input[2 + i]
        momentum: f64 = input[momentum_start + i]
        real_value: f64 = input[state_start + 2 * i]
        imag_value: f64 = input[state_start + 2 * i + 1]
        if position != position || position < 0.25 || position > 1.0 ||
            momentum != momentum || momentum < 0.25 || momentum > 1.0 ||
            real_value != real_value || real_value < -1.0 || real_value > 1.0 ||
            imag_value != imag_value || imag_value < -1.0 || imag_value > 1.0: return -1
        norm_squared <- norm_squared + real_value * real_value + imag_value * imag_value
    if norm_squared <= 0.0: return -1
    output_count: usize = 2 * n
    if output.is_null() || output_capacity < output_count: return -2

    real: mutable f64[MAX_N] = zeroed
    imag: mutable f64[MAX_N] = zeroed
    for i in 0..n:
        real[i] <- input[state_start + 2 * i]
        imag[i] <- input[state_start + 2 * i + 1]
    split_operator_normalize(real[0:n], imag[0:n], n)
    for step in 0..steps:
        for i in 0..n:
            real[i] <- real[i] * input[2 + i]
            imag[i] <- imag[i] * input[2 + i]
        split_operator_fft(real[0:n], imag[0:n], n, false)
        for i in 0..n:
            real[i] <- real[i] * input[momentum_start + i]
            imag[i] <- imag[i] * input[momentum_start + i]
        split_operator_fft(real[0:n], imag[0:n], n, true)
        for i in 0..n:
            real[i] <- real[i] * input[2 + i]
            imag[i] <- imag[i] * input[2 + i]
        split_operator_normalize(real[0:n], imag[0:n], n)
    for i in 0..n:
        output[2 * i] <- real[i]
        output[2 * i + 1] <- imag[i]
    output_count.i64()

export fn split_operator_imaginary_time(input: f64&, input_length: usize,
    output: mutable f64&, output_capacity: usize) -> i64 = split_operator_imaginary_time_impl
