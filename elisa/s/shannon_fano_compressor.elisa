const MAX_TEXT: usize = 16
const MAX_SYMBOLS: usize = 16
const MAX_CODE: usize = 15
const MAX_OUTPUT: usize = 514

def sf_make_codes(symbols: u8&, count: usize, freq: f64&, prefix: mutable u8&, depth: usize,
        codes: mutable u8&, lengths: mutable u8&) -> bool:
    if count == 1:
        i: usize = 0
        while i < depth:
            codes[symbols[0].usize() * MAX_CODE + i] <- prefix[i]
            i <- i + 1
        lengths[symbols[0].usize()] <- depth.u8()
        return true
    total: mutable f64 = 0.0
    i: usize = 0
    while i < count:
        total <- total + freq[symbols[i].usize()]
        i <- i + 1
    capacity: f64 = 0.5 * total
    running: mutable f64 = 0.0
    left: mutable u8[MAX_SYMBOLS] = zeroed
    right: mutable u8[MAX_SYMBOLS] = zeroed
    nl: mutable usize = 0
    nr: mutable usize = 0
    i <- 0
    while i < count:
        symbol: u8 = symbols[i]
        if running + freq[symbol.usize()] <= capacity:
            left[nl] <- symbol
            nl <- nl + 1
            running <- running + freq[symbol.usize()]
        else:
            right[nr] <- symbol
            nr <- nr + 1
        i <- i + 1
    if nl == 0 or nr == 0 or depth >= MAX_CODE: return false
    prefix[depth] <- '0'.u8()
    if not sf_make_codes(left[0], nl, freq, prefix, depth + 1, codes, lengths): return false
    prefix[depth] <- '1'.u8()
    return sf_make_codes(right[0], nr, freq, prefix, depth + 1, codes, lengths)

def shannon_fano_compressor_impl(input: i64&, input_length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input_length > 18 or (input.is_null() and input_length != 0) or (not input.is_null() and input_length == 0): return -1
    text_length: mutable usize = 0
    if not input.is_null():
        if input[0] < 0 or input[0] > MAX_TEXT.i64(): return -1
        text_length <- input[0].usize()
        if input_length != text_length + 1: return -1
    text: mutable u8[MAX_TEXT] = zeroed
    symbols: mutable u8[MAX_SYMBOLS] = zeroed
    seen: mutable u8[128] = zeroed
    counts: mutable usize[128] = zeroed
    symbol_count: mutable usize = 0
    i: mutable usize = 0
    while i < text_length:
        value: i64 = input[i + 1]
        if value < 0 or value > 127: return -1
        text[i] <- value.u8()
        s: usize = text[i].usize()
        if seen[s] == 0:
            seen[s] <- 1
            symbols[symbol_count] <- text[i]
            symbol_count <- symbol_count + 1
        counts[s] <- counts[s] + 1
        i <- i + 1
    freq: mutable f64[128] = zeroed
    if text_length != 0:
        s: usize = 0
        while s < 128:
            freq[s] <- (1.0 * counts[s].f64()) / text_length.f64()
            s <- s + 1
    codes: mutable u8[128 * MAX_CODE] = zeroed
    lengths: mutable u8[128] = zeroed
    if symbol_count == 1:
        codes[symbols[0].usize() * MAX_CODE] <- '1'.u8()
        lengths[symbols[0].usize()] <- 1
    else if symbol_count > 1:
        prefix: mutable u8[MAX_CODE] = zeroed
        if not sf_make_codes(symbols[0], symbol_count, freq[0], prefix[0], 0, codes[0], lengths[0]): return -1
    staged: mutable u8[MAX_OUTPUT] = zeroed
    n: mutable usize = 0
    compressed_length: mutable usize = 0
    i <- 0
    while i < text_length:
        compressed_length <- compressed_length + lengths[text[i].usize()].usize()
        i <- i + 1
    staged[n] <- compressed_length.u8()
    n <- n + 1
    i <- 0
    while i < text_length:
        s: usize = text[i].usize()
        j: usize = 0
        while j < lengths[s].usize():
            staged[n] <- codes[s * MAX_CODE + j]
            n <- n + 1
            j <- j + 1
        i <- i + 1
    staged[n] <- symbol_count.u8()
    n <- n + 1
    s: usize = 0
    while s < 128:
        if lengths[s] != 0:
            staged[n] <- s.u8()
            n <- n + 1
            staged[n] <- lengths[s]
            n <- n + 1
            j: usize = 0
            while j < lengths[s].usize():
                staged[n] <- codes[s * MAX_CODE + j]
                n <- n + 1
                j <- j + 1
        s <- s + 1
    if output.is_null() or capacity < n: return -2
    i <- 0
    while i < n:
        output[i] <- staged[i]
        i <- i + 1
    return n.i64()

export fn shannon_fano_compressor(input: i64&, input_length: usize,
    output: mutable u8&, capacity: usize) -> i64 = shannon_fano_compressor_impl
