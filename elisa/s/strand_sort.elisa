# Stable strand sort using caller-provided temporary storage.
def strand_sort_impl(values: mutable i64&, scratch: mutable i64&, length: usize) -> void:
    if length < 2:
        return
    remaining: mutable usize = length
    result_length: mutable usize = 0
    while remaining > 0:
        last: mutable i64 = values[0]
        scratch[0] <- last
        strand_length: mutable usize = 1
        remaining_write: mutable usize = 0
        read: mutable usize = 1
        while read < remaining:
            value: i64 = values[read]
            if value >= last:
                scratch[strand_length] <- value
                strand_length <- strand_length + 1
                last <- value
            else:
                values[remaining_write] <- value
                remaining_write <- remaining_write + 1
            read <- read + 1
        old_start: usize = length - result_length
        new_start: usize = old_start - strand_length
        # The gap before the unread suffix equals the number of strand items left.
        # Once the strand is exhausted, the rest of the suffix is already in place.
        left: mutable usize = old_start
        right: mutable usize = 0
        destination: mutable usize = new_start
        while left < length and right < strand_length:
            if values[left] <= scratch[right]:
                values[destination] <- values[left]
                left <- left + 1
            else:
                values[destination] <- scratch[right]
                right <- right + 1
            destination <- destination + 1
        while right < strand_length:
            values[destination] <- scratch[right]
            right <- right + 1
            destination <- destination + 1
        remaining <- remaining_write
        result_length <- result_length + strand_length


export fn strand_sort(values: mutable i64&, scratch: mutable i64&, length: usize) -> void = strand_sort_impl
