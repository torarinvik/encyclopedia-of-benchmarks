const MAX_ROWS: usize = 8
const MAX_COLUMNS: usize = 8
const MAX_PARSEABLE_INPUT_LENGTH: usize = 19
const MAX_OUTPUT_BYTES: usize = 272

def set_cover_put_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def set_cover_domination_reduction_impl(
    input: i64&, length: usize, output: mutable u8&, capacity: usize
) -> i64:
    compact_column: mutable usize = 0
    candidate: mutable usize = 0
    if input == null or length < 4 or length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    values: i64& = input
    rows_raw: i64 = values[0]
    columns_raw: i64 = values[1]
    if rows_raw < 1 or rows_raw > MAX_ROWS.i64() or columns_raw < 1 or columns_raw > MAX_COLUMNS.i64():
        return -1
    rows: usize = rows_raw.usize()
    columns: usize = columns_raw.usize()
    if length != 2 + rows + columns: return -1

    weights: mutable i64[MAX_COLUMNS] = zeroed
    masks: mutable u64[MAX_ROWS] = zeroed
    active_rows: mutable bool[MAX_ROWS] = zeroed
    active_columns: mutable bool[MAX_COLUMNS] = zeroed
    column: mutable usize = 0
    while column < columns:
        weight: i64 = values[2 + column]
        if weight < 1 or weight > 20: return -1
        weights[column] <- weight
        active_columns[column] <- true
        column <- column + 1

    valid_columns: u64 = (1.u64() << columns) - 1
    row: mutable usize = 0
    while row < rows:
        raw_mask: i64 = values[2 + columns + row]
        if raw_mask < 0 or (raw_mask.u64() & ~valid_columns) != 0: return -1
        masks[row] <- raw_mask.u64()
        active_rows[row] <- true
        row <- row + 1

    while true:
        changed: mutable bool = false
        keep_row: mutable usize = 0
        while keep_row < rows and not changed:
            if active_rows[keep_row]:
                drop_row: mutable usize = 0
                while drop_row < rows:
                    if active_rows[drop_row] and keep_row != drop_row and (masks[keep_row] & ~masks[drop_row]) == 0 and (masks[keep_row] != masks[drop_row] or keep_row < drop_row):
                        active_rows[drop_row] <- false
                        changed <- true
                        break
                    drop_row <- drop_row + 1
            keep_row <- keep_row + 1
        if changed: continue

        drop_column:mutable  mutable usize = 0
        while drop_column < columns and not changed:
            if active_columns[drop_column]:
                drop_coverage: mutable u64 = 0
                row <- 0
                while row < rows:
                    if active_rows[row] and (masks[row] & (1.u64() << drop_column)) != 0:
                        drop_coverage <- drop_coverage | (1.u64() << row)
                    row <- row + 1
                keep_column: mutable usize = 0
                while keep_column < columns:
                    if active_columns[keep_column] and keep_column != drop_column:
                        keep_coverage: mutable u64 = 0
                        row <- 0
                        while row < rows:
                            if active_rows[row] and (masks[row] & (1.u64() << keep_column)) != 0:
                                keep_coverage <- keep_coverage | (1.u64() << row)
                            row <- row + 1
                        if (drop_coverage & ~keep_coverage) == 0 and weights[drop_column] >= weights[keep_column] and (drop_coverage != keep_coverage or weights[drop_column] != weights[keep_column] or keep_column < drop_column):
                            active_columns[drop_column] <- false
                            row <- 0
                            while row < rows:
                                masks[row] <- masks[row] & ~(1.u64() << drop_column)
                                row <- row + 1
                            changed <- true
                            break
                    keep_column <- keep_column + 1
            drop_column <- drop_column + 1
        if changed: continue

        drop_column <- 0
        while drop_column < columns and not changed:
            if active_columns[drop_column]:
                drop_coverage: mutable u64 = 0
                row <- 0
                while row < rows:
                    if active_rows[row] and (masks[row] & (1.u64() << drop_column)) != 0:
                        drop_coverage <- drop_coverage | (1.u64() << row)
                    row <- row + 1
                keep_column: mutable usize = 0
                while keep_column < columns:
                    if active_columns[keep_column] and keep_column != drop_column:
                        keep_coverage: mutable u64 = 0
                        row <- 0
                        while row < rows:
                            if active_rows[row] and (masks[row] & (1.u64() << keep_column)) != 0:
                                keep_coverage <- keep_coverage | (1.u64() << row)
                            row <- row + 1
                        exclusive_rows: u64 = drop_coverage & ~keep_coverage
                        if (drop_coverage & keep_coverage) != 0 and exclusive_rows != 0:
                            replacement_columns: mutable u64 = 0
                            feasible: mutable bool = true
                            row <- 0
                            while row < rows:
                                if (exclusive_rows & (1.u64() << row)) != 0:
                                    minimum_column: mutable i64 = -1
                                    candidate <- 0
                                    while candidate < columns:
                                        if active_columns[candidate] and (masks[row] & (1.u64() << candidate)) != 0 and (minimum_column < 0 or weights[candidate] < weights[minimum_column.usize()] or (weights[candidate] == weights[minimum_column.usize()] and candidate < minimum_column.usize())):
                                            minimum_column <- candidate.i64()
                                        candidate <- candidate + 1
                                    if minimum_column < 0:
                                        feasible <- false
                                        break
                                    replacement_columns <- replacement_columns | (1.u64() << minimum_column.usize())
                                row <- row + 1
                            replacement_cost: mutable i64 = weights[keep_column]
                            candidate <- 0
                            while candidate < columns:
                                if (replacement_columns & (1.u64() << candidate)) != 0:
                                    replacement_cost <- replacement_cost + weights[candidate]
                                candidate <- candidate + 1
                            if feasible and weights[drop_column] >= replacement_cost:
                                active_columns[drop_column] <- false
                                row <- 0
                                while row < rows:
                                    masks[row] <- masks[row] & ~(1.u64() << drop_column)
                                    row <- row + 1
                                changed <- true
                                break
                    keep_column <- keep_column + 1
            drop_column <- drop_column + 1
        if not changed: break

    row_ids: mutable i64[MAX_ROWS] = zeroed
    column_ids: mutable i64[MAX_COLUMNS] = zeroed
    reduced_masks: mutable u64[MAX_ROWS] = zeroed
    row_count: mutable usize = 0
    column_count: mutable usize = 0
    row <- 0
    while row < rows:
        if active_rows[row]:
            row_ids[row_count] <- row.i64()
            row_count <- row_count + 1
        row <- row + 1
    column <- 0
    while column < columns:
        if active_columns[column]:
            column_ids[column_count] <- column.i64()
            column_count <- column_count + 1
        column <- column + 1
    compact_row:mutable  mutable usize = 0
    while compact_row < row_count:
        compact_column <- 0
        while compact_column < column_count:
            if (masks[row_ids[compact_row].usize()] & (1.u64() << column_ids[compact_column].usize())) != 0:
                reduced_masks[compact_row] <- reduced_masks[compact_row] | (1.u64() << compact_column)
            compact_column <- compact_column + 1
        compact_row <- compact_row + 1

    words: usize = 2 + 2 * row_count + 2 * column_count
    byte_count: usize = 8 * words
    if output == null or capacity < byte_count: return -2
    result: mutable u8& = output
    cursor: mutable usize = 0
    set_cover_put_i64_le(row_count.i64(), result, 8 * cursor)
    cursor <- cursor + 1
    set_cover_put_i64_le(column_count.i64(), result, 8 * cursor)
    cursor <- cursor + 1
    compact_row <- 0
    while compact_row < row_count:
        set_cover_put_i64_le(row_ids[compact_row], result, 8 * cursor)
        cursor <- cursor + 1
        compact_row <- compact_row + 1
    compact_column <- 0
    while compact_column < column_count:
        set_cover_put_i64_le(column_ids[compact_column], result, 8 * cursor)
        cursor <- cursor + 1
        compact_column <- compact_column + 1
    compact_column <- 0
    while compact_column < column_count:
        set_cover_put_i64_le(weights[column_ids[compact_column].usize()], result, 8 * cursor)
        cursor <- cursor + 1
        compact_column <- compact_column + 1
    compact_row <- 0
    while compact_row < row_count:
        set_cover_put_i64_le(reduced_masks[compact_row].i64(), result, 8 * cursor)
        cursor <- cursor + 1
        compact_row <- compact_row + 1
    byte_count.i64()

export fn set_cover_domination_reduction( input: i64&, length: usize, output: mutable u8&, capacity: usize ) -> i64 = set_cover_domination_reduction_impl
