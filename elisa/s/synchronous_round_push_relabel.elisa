const SRPR_MAX_VERTICES: usize = 8
const SRPR_MAX_ARCS: i64 = 24
const SRPR_MAX_INPUT_LENGTH: usize = 77
const SRPR_MAX_CAPACITY: i64 = 15

def synchronous_round_push_relabel_impl(input: i64&, input_length: usize) -> i64:
    neighbor: mutable usize = 0
    length:  usize = input_length
    if length < 4 or length > SRPR_MAX_INPUT_LENGTH: return -1
    raw_n:  i64 = input[0]
    raw_m:  i64 = input[1]
    raw_source:  i64 = input[2]
    raw_sink:  i64 = input[3]
    if raw_n < 2 or raw_n > SRPR_MAX_VERTICES.i64() or raw_m < 0 or raw_m > SRPR_MAX_ARCS or raw_source < 0 or raw_source >= raw_n or raw_sink < 0 or raw_sink >= raw_n or raw_source == raw_sink or length != 4 + 3 * raw_m.usize(): return -1
    n:  usize = raw_n.usize()
    m:  usize = raw_m.usize()
    source:  usize = raw_source.usize()
    sink:  usize = raw_sink.usize()
    stride:  usize = SRPR_MAX_VERTICES
    capacity: mutable i64[SRPR_MAX_VERTICES * SRPR_MAX_VERTICES] = zeroed
    operation: mutable usize = 0
    while operation < m:
        offset:  usize = 4 + 3 * operation
        u:  i64 = input[offset]
        v:  i64 = input[offset + 1]
        amount:  i64 = input[offset + 2]
        if u < 0 or u >= raw_n or v < 0 or v >= raw_n or u == v or amount < 0 or amount > SRPR_MAX_CAPACITY: return -1
        capacity[u.usize() * stride + v.usize()] <-
            capacity[u.usize() * stride + v.usize()] + amount
        operation <- operation + 1

    residual: mutable i64[SRPR_MAX_VERTICES * SRPR_MAX_VERTICES] = zeroed
    excess: mutable i64[SRPR_MAX_VERTICES] = zeroed
    height: mutable i64[SRPR_MAX_VERTICES] = zeroed
    index: mutable usize = 0
    while index < stride * stride:
        residual[index] <- capacity[index]
        index <- index + 1
    height[source] <- n.i64()

    mut_vertex:  mutable usize = 0
    while mut_vertex < n:
        if mut_vertex != source:
            forward:  usize = source * stride + mut_vertex
            reverse:  usize = mut_vertex * stride + source
            amount:  i64 = residual[forward]
            if amount != 0:
                residual[forward] <- 0
                residual[reverse] <- residual[reverse] + amount
                excess[source] <- excess[source] - amount
                excess[mut_vertex] <- excess[mut_vertex] + amount
        mut_vertex <- mut_vertex + 1

    while true:
        active: mutable i64[SRPR_MAX_VERTICES] = zeroed
        active_count: mutable usize = 0
        vertex: mutable usize = 0
        while vertex < n:
            if vertex != source and vertex != sink and excess[vertex] > 0 and height[vertex] < n.i64():
                active[active_count] <- vertex.i64()
                active_count <- active_count + 1
            vertex <- vertex + 1
        if active_count == 0: return excess[sink]

        change: mutable i64[SRPR_MAX_VERTICES] = zeroed
        active_index: mutable usize = 0
        while active_index < active_count:
            u:  usize = active[active_index].usize()
            remaining: mutable i64 = excess[u]
            neighbor <- 0
            while neighbor < n and remaining > 0:
                forward:  usize = u * stride + neighbor
                reverse:  usize = neighbor * stride + u
                if residual[forward] > 0 and height[u] == height[neighbor] + 1:
                    amount:  i64 = remaining if (remaining < residual[forward]) else residual[forward]
                    residual[forward] <- residual[forward] - amount
                    residual[reverse] <- residual[reverse] + amount
                    change[u] <- change[u] - amount
                    change[neighbor] <- change[neighbor] + amount
                    remaining <- remaining - amount
                neighbor <- neighbor + 1
            active_index <- active_index + 1

        next_excess: mutable i64[SRPR_MAX_VERTICES] = zeroed
        next_height: mutable i64[SRPR_MAX_VERTICES] = zeroed
        vertex <- 0
        while vertex < n:
            next_excess[vertex] <- excess[vertex] + change[vertex]
            next_height[vertex] <- height[vertex]
            vertex <- vertex + 1
        active_index <- 0
        while active_index < active_count:
            u:  usize = active[active_index].usize()
            if next_excess[u] > 0:
                minimum: mutable i64 = (2 * SRPR_MAX_VERTICES + 1).i64()
                neighbor <- 0
                while neighbor < n:
                    if residual[u * stride + neighbor] > 0 and height[neighbor] < minimum:
                        minimum <- height[neighbor]
                    neighbor <- neighbor + 1
                next_height[u] <- n.i64() + 1 if minimum == (2 * SRPR_MAX_VERTICES + 1).i64() else minimum + 1
            active_index <- active_index + 1
        vertex <- 0
        while vertex < n:
            excess[vertex] <- next_excess[vertex]
            height[vertex] <- next_height[vertex]
            vertex <- vertex + 1
    -1

def synchronous_round_push_relabel_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 4 or length > SRPR_MAX_INPUT_LENGTH: return -1
    synchronous_round_push_relabel_impl(input, length)

export fn synchronous_round_push_relabel(input: i64&, length: usize) -> i64 = synchronous_round_push_relabel_entry
