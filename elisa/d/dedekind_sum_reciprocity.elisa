const DEDEKIND_MAX_MODULUS: i64 = 100000
const DEDEKIND_MAX_LENGTH: usize = 3
const DEDEKIND_OFFSET: i64 = 29999700001

def dedekind_gcd(left_value: i64, right_value: i64) -> i64:
    left: mutable i64 = left_value
    right: mutable i64 = right_value
    while right != 0:
        remainder: i64 = left % right
        left <- right
        right <- remainder
    left

def dedekind_scaled(numerator: i64, modulus: i64) -> i64:
    if modulus == 1: return 0
    tail_value: i64 = dedekind_scaled(modulus % numerator, numerator)
    top: i64 = numerator*numerator + modulus*modulus + 1 - 3*numerator*modulus - modulus*tail_value
    top/numerator

def dedekind_sum_impl(input: i64&, input_length: usize) -> i64:
    length: usize = input_length
    if length < 2 or length > DEDEKIND_MAX_LENGTH or length != 2: return -1
    numerator: i64 = input[0]
    modulus: i64 = input[1]
    if modulus < 1 or modulus > DEDEKIND_MAX_MODULUS or numerator < 0 or numerator >= modulus: return -1
    if dedekind_gcd(numerator, modulus) != 1: return -1
    DEDEKIND_OFFSET + dedekind_scaled(numerator, modulus)

def dedekind_sum_reciprocity_impl(input: i64&, length: usize) -> i64:
    if input == null or length > DEDEKIND_MAX_LENGTH: return -1
    dedekind_sum_impl(input, length)

export fn dedekind_sum_reciprocity(input: i64&, length: usize) -> i64 = dedekind_sum_reciprocity_impl
