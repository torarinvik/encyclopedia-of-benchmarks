const MAX_LENGTH: usize = 1024

def capital_is_upper(value: i64) -> bool:
    return value >= 65 and value <= 90

def capital_is_lower(value: i64) -> bool:
    return value >= 97 and value <= 122

def detect_capital_usage_impl(input: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    valid_input: bool =
        for index in 0..<length |valid: mutable bool = true| -> valid:
            value: i64 = input[index]
            if not capital_is_upper(value) and not capital_is_lower(value):
                break false
            valid
    if not valid_input:
        return -1
    uppercase_count: usize =
        for index in 0..<length |count: mutable usize = 0| -> count:
            if capital_is_upper(input[index]):
                count <- count + 1
            count
    if uppercase_count == 0 or uppercase_count == length or (uppercase_count == 1 and length != 0 and capital_is_upper(input[0])):
        return 1
    return 0

export fn detect_capital_usage(input: i64&, length: usize) -> i64 = detect_capital_usage_impl
