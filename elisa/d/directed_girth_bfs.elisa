def directed_girth_bfs_impl(input: view[i64], length: usize) -> i64:
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 16 or m_value < 0 or m_value > 64: return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + 2 * m: return -1
    outgoing: mutable u64[16] = zeroed
    for edge in 0..<m:
        u: i64 = input[2 + 2 * edge]
        v: i64 = input[3 + 2 * edge]
        if u < 0 or v < 0 or u >= n_value or v >= n_value: return -1
        outgoing[u.usize()] <- outgoing[u.usize()] | (1.u64() << v.usize())
    best: mutable i64 = 17
    for start in 0..<n:
        distance: mutable i64[16] = zeroed
        queue: mutable usize[16] = zeroed
        for i in 0..<n: distance[i] <- -1
        distance[start] <- 0
        queue[0] <- start
        head: mutable usize = 0
        tail: mutable usize = 1
        while head < tail:
            u: usize = queue[head]
            head <- head + 1
            for v in 0..<n:
                if (outgoing[u] & (1.u64() << v)) != 0:
                    if v == start:
                        if distance[u] + 1 < best: best <- distance[u] + 1
                    elif distance[v] < 0:
                        distance[v] <- distance[u] + 1
                        queue[tail] <- v
                        tail <- tail + 1
    if best == 17: return 0
    best

export fn directed_girth_bfs(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > 131: return -1
    directed_girth_bfs_impl(input[0:length], length)
