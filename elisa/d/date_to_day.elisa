# Return the English weekday name for a bounded ASCII d/m/yyyy date.
def date_to_day_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 9 or length > 11 or input[length - 1] != 0:
        return -1
    date_length: usize = length - 1
    fields: mutable i64[3] = zeroed
    cursor: mutable usize = 0
    field: mutable usize = 0
    while field < 3:
        start: usize = cursor
        value: mutable i64 = 0
        while cursor < date_length and input[cursor] >= 48 and input[cursor] <= 57:
            value <- value * 10 + input[cursor] - 48
            cursor <- cursor + 1
        digits: usize = cursor - start
        max_digits: usize = 2
        if field == 2:
            max_digits <- 4
        if digits == 0 or digits > max_digits or (field == 2 and digits != 4):
            return -1
        fields[field] <- value
        if field < 2:
            if cursor >= date_length or input[cursor] != 47:
                return -1
            cursor <- cursor + 1
        field <- field + 1
    if cursor != date_length:
        return -1
    day: i64 = fields[0]
    month: i64 = fields[1]
    year: i64 = fields[2]
    if year < 1 or year > 9999 or month < 1 or month > 12 or day < 1:
        return -1
    leap: bool = year % 400 == 0 or (year % 4 == 0 and year % 100 != 0)
    month_days: i64[12] = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if leap:
        month_days[1] <- 29
    if day > month_days[month.usize() - 1]:
        return -1

    adjusted_year: mutable i64 = year
    adjusted_month: mutable i64 = month
    if adjusted_month < 3:
        adjusted_year <- adjusted_year - 1
        adjusted_month <- adjusted_month + 12
    year_of_century: i64 = adjusted_year % 100
    century: i64 = adjusted_year / 100
    weekday: usize = ((day + ((adjusted_month + 1) * 26) / 10 + year_of_century +
        year_of_century / 4 + century / 4 + 5 * century) % 7).usize()
    name_bytes: u8[50] = [83,97,116,117,114,100,97,121,83,117,110,100,97,121,77,111,110,100,97,121,84,117,101,115,100,97,121,87,101,100,110,101,115,100,97,121,84,104,117,114,115,100,97,121,70,114,105,100,97,121]
    name_offsets: usize[7] = [0, 8, 14, 20, 27, 36, 44]
    name_lengths: usize[7] = [8, 6, 6, 7, 9, 8, 6]
    output_length: usize = name_lengths[weekday]
    if output_capacity < output_length or output.is_null():
        return -2
    index: mutable usize = 0
    while index < output_length:
        output[index] <- name_bytes[name_offsets[weekday] + index]
        index <- index + 1
    output_length.i64()

export fn date_to_day(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = date_to_day_impl
