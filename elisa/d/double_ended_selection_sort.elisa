def store_le(output: mutable view[u8], offset: usize, x: i64):
    bits: u64 = x.u64()
    b: mutable usize = 0
    while b < 8:
        output[offset + b] <- ((bits >> (b * 8)) & 255).u8()
        b <- b + 1

def double_ended_selection_sort_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if (values.is_null() and length > 0) or length > 257: return -1
    if length > 256: return -1
    work: mutable i64[256] = zeroed
    starts: mutable i64[256] = zeroed
    ends: mutable i64[256] = zeroed
    result: mutable i64[256] = zeroed
    i: mutable usize = 0
    while i < length: work[i] <- values[i]; i <- i + 1
    count: mutable usize = length
    used: mutable usize = 0
    end_count: mutable usize = 0
    while count > 1:
        min_i: mutable usize = 0
        max_i: mutable usize = 0
        i <- 1
        while i < count:
            if work[i] < work[min_i]: min_i <- i
            if work[i] > work[max_i]: max_i <- i
            i <- i + 1
        min_v: i64 = work[min_i]
        max_v: i64 = work[max_i]
        starts[used] <- min_v; used <- used + 1
        ends[end_count] <- max_v; end_count <- end_count + 1
        i <- min_i
        while i + 1 < count: work[i] <- work[i + 1]; i <- i + 1
        count <- count - 1
        max_pos: mutable usize = 0
        while max_pos < count and work[max_pos] != max_v: max_pos <- max_pos + 1
        if max_pos == count: return -1
        i <- max_pos
        while i + 1 < count: work[i] <- work[i + 1]; i <- i + 1
        count <- count - 1
    out_n: mutable usize = 0
    i <- 0
    while i < used: result[out_n] <- starts[i]; out_n <- out_n + 1; i <- i + 1
    i <- 0
    while i < count: result[out_n] <- work[i]; out_n <- out_n + 1; i <- i + 1
    i <- end_count
    while i > 0: i <- i - 1; result[out_n] <- ends[i]; out_n <- out_n + 1
    bytes: usize = 8 * out_n
    if output.is_null() or capacity < bytes: return -2
    i <- 0
    while i < out_n: store_le(output[0:bytes], 8 * i, result[i]); i <- i + 1
    bytes.i64()

export fn double_ended_selection_sort(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = double_ended_selection_sort_impl
