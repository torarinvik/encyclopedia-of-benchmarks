# Write the minimal-width ASCII binary form of n ^ (n >> 1).
def decimal_to_gray_impl(value: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if value < 0:
        return -1
    gray: i64 = value ^ (value >> 1)
    width: usize =
        while remaining > 1 |remaining: i64 = gray, count: usize = 1| -> count:
            remaining <- remaining / 2
            count <- count + 1
    if output_capacity < width:
        return -2
    while position > 0 |position: usize = width, remaining: i64 = gray, output| -> output:
        position <- position - 1
        if remaining % 2 == 0:
            output[position] <- 48
        else:
            output[position] <- 49
        remaining <- remaining / 2
    width.i64()

export fn decimal_to_gray(value: i64, output: mutable u8&, output_capacity: usize) -> i64 = decimal_to_gray_impl
