const MAX_NODE_COUNT: usize = 1023
const ERROR_SENTINEL: i64 = -2000000000

def diameter_of_binary_tree_height(nodes: view[i64], node_count: usize, node: i64,
        seen: mutable view[bool], visited: mutable usize&) -> i64:
    if node == -1:
        return 0
    if node < 0 or node.usize() >= node_count:
        return ERROR_SENTINEL
    index: usize = node.usize()
    if seen[index]:
        return ERROR_SENTINEL
    seen[index] <- true
    visited <- visited + 1
    left: i64 = nodes[3 * index + 1]
    right: i64 = nodes[3 * index + 2]
    if left < -1 or right < -1 or (left >= 0 and left.usize() >= node_count) or (right >= 0 and right.usize() >= node_count):
        return ERROR_SENTINEL
    left_height: i64 = diameter_of_binary_tree_height(nodes, node_count, left, seen, visited)
    if left_height == ERROR_SENTINEL:
        return ERROR_SENTINEL
    right_height: i64 = diameter_of_binary_tree_height(nodes, node_count, right, seen, visited)
    if right_height == ERROR_SENTINEL:
        return ERROR_SENTINEL
    if left_height > right_height:
        return left_height + 1
    return right_height + 1

def diameter_of_binary_tree_impl(nodes: i64&, node_count: usize, root_index: i64) -> i64:
    if node_count == 0 or node_count > MAX_NODE_COUNT or root_index < 0 or root_index.usize() >= node_count:
        return -1
    root: usize = root_index.usize()
    left: i64 = nodes[3 * root + 1]
    right: i64 = nodes[3 * root + 2]
    if left < -1 or right < -1 or (left >= 0 and left.usize() >= node_count) or (right >= 0 and right.usize() >= node_count):
        return -1
    seen: mutable bool[MAX_NODE_COUNT] = zeroed
    seen[root] <- true
    visited: mutable usize = 1
    left_height: i64 = diameter_of_binary_tree_height(nodes[0:3 * node_count], node_count, left, seen[0:MAX_NODE_COUNT], visited)
    if left_height == ERROR_SENTINEL:
        return -1
    right_height: i64 = diameter_of_binary_tree_height(nodes[0:3 * node_count], node_count, right, seen[0:MAX_NODE_COUNT], visited)
    if right_height == ERROR_SENTINEL or visited != node_count:
        return -1
    left_height + right_height + 1

export fn diameter_of_binary_tree(nodes: i64&, node_count: usize, root_index: i64) -> i64 = diameter_of_binary_tree_impl
