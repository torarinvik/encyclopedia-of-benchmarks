def dancing_links_search(columns: usize, row_count: usize, rows: u64&,
                         covered: u64, selected: usize,
                         found: mutable bool&, solution_count: mutable usize&) -> void:
    full_mask: u64 = (1.u64() << columns) - 1.u64()
    if covered == full_mask:
        if not found[selected]:
            found[selected] <- true
            solution_count <- solution_count + 1
        return

    best_column: mutable usize = columns
    best_count: mutable usize = row_count + 1
    column: mutable usize = 0
    while column < columns:
        bit: u64 = 1.u64() << column
        if (covered & bit) == 0:
            candidates: mutable usize = 0
            row: mutable usize = 0
            while row < row_count:
                if (rows[row] & bit) != 0 and (rows[row] & covered) == 0:
                    candidates <- candidates + 1
                row <- row + 1
            if candidates == 0:
                return
            if candidates < best_count:
                best_column <- column
                best_count <- candidates
        column <- column + 1

    bit: u64 = 1.u64() << best_column
    row: mutable usize = 0
    while row < row_count:
        row_mask: u64 = rows[row]
        if (row_mask & bit) != 0 and (row_mask & covered) == 0:
            dancing_links_search(columns, row_count, rows, covered | row_mask,
                                 selected | (1.usize() << row), found, solution_count)
        row <- row + 1

def dancing_links_impl(input: i64&, length: usize,
                       output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 10:
        return -1
    universe_value: i64 = input[0]
    row_count_value: i64 = input[1]
    if universe_value < 1 or universe_value > 8 or row_count_value < 0 or row_count_value > 8:
        return -1
    universe: usize = universe_value.usize()
    row_count: usize = row_count_value.usize()
    if length != row_count + 2:
        return -1
    full_mask: i64 = (1 << universe) - 1
    rows: mutable u64[8] = zeroed
    row: mutable usize = 0
    while row < row_count:
        mask: i64 = input[row + 2]
        if mask <= 0 or (mask & ~full_mask) != 0:
            return -1
        rows[row] <- mask.u64()
        row <- row + 1

    found: mutable bool[256] = zeroed
    solution_count: mutable usize = 0
    dancing_links_search(universe, row_count, &rows[0], 0, 0, &found[0], solution_count)
    if output_capacity < solution_count or (solution_count > 0 and output.is_null()):
        return -2
    position: mutable usize = 0
    selection: mutable usize = 0
    while selection < 256:
        if found[selection]:
            output[position] <- selection.u8()
            position <- position + 1
        selection <- selection + 1
    solution_count.i64()

export fn dancing_links(input: i64&, length: usize, output: mutable u8&,
                        output_capacity: usize) -> i64 = dancing_links_impl
