const MAX_ATTRIBUTES: usize = 51
const MAX_INPUT_LENGTH: usize = 1 + 2 * MAX_ATTRIBUTES

def dbms_key_float_bits_valid(payload: i64) -> i64:
    if payload < 0 or payload > 4294967295: return -1
    bits: u32 = payload.u32()
    exponent: u32 = (bits >> 23) & 255.u32()
    fraction: u32 = bits & 0x7fffff.u32()
    if exponent == 255.u32() and fraction == 0: return 0
    1

def versabench_dbms_valid_attributes_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 1 or length > MAX_INPUT_LENGTH + 1: return -1
    raw_count: i64 = values[0]
    if raw_count < 0 or raw_count > MAX_ATTRIBUTES.i64(): return -1
    count: usize = raw_count.usize()
    if length != 1 + 2 * count: return -1
    for i in 0..<count:
        code: i64 = values[1 + 2 * i]
        payload: i64 = values[2 + 2 * i]
        if code < 0 or code > 50: return 0
        if code < 8:
            valid: i64 = dbms_key_float_bits_valid(payload)
            if valid < 0: return -1
            if valid == 0: return 0
        else:
            if payload != 0 and payload != 1: return -1
            if payload == 0: return 0
    1

export fn versabench_dbms_valid_attributes(values: i64&, length: usize) -> i64 = versabench_dbms_valid_attributes_impl
