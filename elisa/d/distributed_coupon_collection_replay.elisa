const COUPON_MAX_INPUT: usize = 76

def coupon_put64(value: i64, output: mutable u8&, pos: usize) -> void:
    bits: u64 = value.u64()
    for j in 0..<8:
        output[pos + j] <- (bits >> (8 * j)).u8()

def distributed_coupon_collection_replay_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 4 or length > COUPON_MAX_INPUT:
        return -1
    n64: i64 = input[0]
    coupons64: i64 = input[1]
    copies: i64 = input[2]
    steps64: i64 = input[3]
    if n64 < 2 or n64 > 8 or coupons64 < 1 or coupons64 > 8 or copies < 1 or copies > n64 or steps64 < 1 or steps64 > 8:
        return -1
    n: usize = n64.usize()
    coupons: usize = coupons64.usize()
    steps: usize = steps64.usize()
    if length != 4 + n + n * steps:
        return -1
    full: u64 = (1.u64() << coupons) - 1
    bins: mutable u64[8] = zeroed
    for b in 0..<n:
        raw: i64 = input[4 + b]
        if raw < 0 or (raw.u64() & ~full) != 0:
            return -1
        bins[b] <- raw.u64()
    for coupon in 0..<coupons:
        count: mutable usize = 0
        for b in 0..<n:
            if ((bins[b] >> coupon) & 1) != 0:
                count <- count + 1
        if count < copies.usize():
            return -1
    tape_at: usize = 4 + n
    for i in 0..<(n * steps):
        bit: i64 = input[tape_at + i]
        if bit != 0 and bit != 1:
            return -1
    if output == null or capacity < 16:
        return -2
    collected: mutable u64 = 0
    singleton_steps: mutable i64 = 0
    for step in 0..<steps:
        open_count: mutable usize = 0
        opened_bin: mutable usize = 0
        for b in 0..<n:
            if input[tape_at + step * n + b] == 1:
                open_count <- open_count + 1
                opened_bin <- b
        if open_count == 1:
            singleton_steps <- singleton_steps + 1
            collected <- collected | bins[opened_bin]
    coupon_put64(collected.i64(), output, 0)
    coupon_put64(singleton_steps, output, 8)
    16

export fn distributed_coupon_collection_replay(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = distributed_coupon_collection_replay_impl
