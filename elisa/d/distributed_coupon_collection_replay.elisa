const MAX_N:usize=8
const MAX_INPUT:usize=76

def put64(value:i64,output:mutable view[u8],pos:usize)->void:
    bits:u64=value.u64()
    j:mutable usize=0
    while j<8:
        output[pos+j]<-((bits>>(8*j))&255).u8()
        j<-j+1

def distributed_coupon_collection_replay(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("distributed_coupon_collection_replay"):
    if input.is_null() or length<4 or length>MAX_INPUT:return -1
    n64:i64=input[0]; coupons64:i64=input[1]; copies:i64=input[2]; steps64:i64=input[3]
    if n64<2 or n64>8 or coupons64<1 or coupons64>8 or copies<1 or copies>n64 or steps64<1 or steps64>8 or length!=4+n64.usize()+n64.usize()*steps64.usize():return -1
    n:usize=n64.usize(); coupons:usize=coupons64.usize(); steps:usize=steps64.usize(); full:u64=(1.u64<<coupons)-1
    bins:mutable u64[8]=zeroed
    b:mutable usize=0
    while b<n:
        raw:i64=input[4+b]
        if raw<0 or (raw.u64()&~full)!=0:return -1
        bins[b]<-raw.u64(); b<-b+1
    coupon:mutable usize=0
    while coupon<coupons:
        count:mutable usize=0; b<-0
        while b<n:
            if ((bins[b]>>coupon)&1)!=0:count<-count+1
            b<-b+1
        if count<copies.usize():return -1
        coupon<-coupon+1
    tape_at:usize=4+n
    i:mutable usize=0
    while i<n*steps:
        bit:i64=input[tape_at+i]
        if bit!=0 and bit!=1:return -1
        i<-i+1
    if output.is_null() or capacity<16:return -2
    collected:mutable u64=0
    singleton_steps:mutable i64=0
    step:mutable usize=0
    while step<steps:
        open_count:mutable usize=0; opened_bin:mutable usize=0; b<-0
        while b<n:
            if input[tape_at+step*n+b]==1:open_count<-open_count+1; opened_bin<-b
            b<-b+1
        if open_count==1:singleton_steps<-singleton_steps+1; collected<-collected|bins[opened_bin]
        step<-step+1
    put64(collected.i64(),output[0:16],0); put64(singleton_steps,output[0:16],8)
    16
