def digital_root_impl(n: i64) -> i64:
    if n < 0:
        return -1
    result: i64 =
        while number >= 10 |number: mutable i64 = n, total: mutable i64 = 0| -> number:
            while number > 0:
                total <- total + number % 10
                number <- number / 10
            number <- total
            total <- 0
    result

export fn digital_root(n: i64) -> i64 = digital_root_impl(n)
