extern sqrt(value: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def dispersion_put_f64_le(value: f64, output: mutable u8&, offset: usize) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def dispersion_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values.is_null() or length == 0 or length > 128: return -1
    for i in 0..<length:
        if values[i] < -10000 or values[i] > 10000: return -1
    if output.is_null() or capacity < 16: return -2
    sum: mutable f64 = 0.0
    for i in 0..<length:
        sum <- sum + values[i].f64()
    mean: f64 = sum / length.f64()
    squared_deviations: mutable f64 = 0.0
    for i in 0..<length:
        deviation: f64 = values[i].f64() - mean
        squared_deviations <- squared_deviations + deviation * deviation
    variance: f64 = squared_deviations / length.f64()
    dispersion_put_f64_le(variance, output, 0)
    dispersion_put_f64_le(sqrt(variance), output, 8)
    16

export fn dispersion(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = dispersion_impl
