extern cos(value: f64) -> f64
extern sin(value: f64) -> f64

const max_n: usize = 64
const max_input_length: usize = 130
const tau: f64 = 6.283185307179586476925286766559
const finite_limit: f64 = 1.7976931348623157e308

def finite(value: f64) -> bool:
    value == value and value <= finite_limit and value >= -finite_limit

def exact_size(value: f64) -> bool:
    finite(value) and value >= 1.0 and value <= 64.0 and value.i64().f64() == value

def valid_input(values: view[f64]) -> bool:
    if values.len() < 2 or values.len() > max_input_length:
        return false
    for index in 0..<values.len():
        if not finite(values[index]):
            return false
    if not exact_size(values[0]):
        return false
    n: usize = values[0].i64().usize()
    if values.len() != 1 + 2 * n:
        return false
    for index in 1..<values.len():
        if values[index] < -8.0 or values[index] > 8.0:
            return false
    true

def direct_dft_impl(values: view[f64], output: mutable view[f64]) -> i64:
    n: usize = values[0].i64().usize()
    for k in 0..<n:
        real_sum: mutable f64 = 0.0
        imag_sum: mutable f64 = 0.0
        for j in 0..<n:
            angle: f64 = -tau * j.f64() * k.f64() / n.f64()
            cosine: f64 = cos(angle)
            sine: f64 = sin(angle)
            sample_real: f64 = values[1 + 2 * j]
            sample_imag: f64 = values[2 + 2 * j]
            real_sum <- real_sum + sample_real * cosine + sample_imag * sine
            imag_sum <- imag_sum + sample_imag * cosine - sample_real * sine
        output[2 * k] <- real_sum
        output[2 * k + 1] <- imag_sum
    (2 * n).i64()

def direct_discrete_fourier_transform_impl(input: f64&, input_length: usize,
                                           output: mutable f64&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 2 or input_length > max_input_length:
        return -1
    input_view: view[f64] = input[0:input_length]
    if not valid_input(input_view):
        return -1
    n: usize = input_view[0].i64().usize()
    needed: usize = 2 * n
    if output.is_null() or output_capacity < needed:
        return -2
    output_view: mutable view[f64] = output[0:needed]
    direct_dft_impl(input_view, output_view)

export fn direct_discrete_fourier_transform(input: f64&, input_length: usize,
                                             output: mutable f64&, output_capacity: usize) -> i64 = direct_discrete_fourier_transform_impl

