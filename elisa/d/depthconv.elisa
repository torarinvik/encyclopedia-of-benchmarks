const MAX_CHANNELS: usize = 8

def rounded_shift(value: i64, shift: usize) -> i64:
    divisor: i64 = 1.i64() << shift
    if value >= 0: return value / divisor
    -((-value + divisor - 1) / divisor)

def depthconv_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values.is_null() or length < 1 or length > 1 + 11 * MAX_CHANNELS: return -1
    channels: i64 = values[0]
    if channels < 1 or channels > MAX_CHANNELS.i64() or length != 1 + 11 * channels.usize(): return -1
    count: usize = channels.usize()
    for index in 1..<(1 + 8 * count):
        if values[index] < -128 or values[index] > 127: return -1
    for index in (1 + 8 * count)..<(1 + 9 * count):
        if values[index] < -1_000_000 or values[index] > 1_000_000: return -1
    for index in (1 + 9 * count)..<(1 + 10 * count):
        if values[index] < 0 or values[index] > 2_147_483_647: return -1
    for index in (1 + 10 * count)..<length:
        if values[index] < -8 or values[index] > 0: return -1
    if output.is_null() or capacity < count: return -2
    for channel in 0..<count:
        accumulator: mutable i64 = 0
        for row in 0..<4:
            input_value: i64 = values[1 + row * count + channel] + 128
            filter_value: i64 = values[1 + 4 * count + row * count + channel]
            accumulator <- accumulator + filter_value * input_value
        accumulator <- accumulator + values[1 + 8 * count + channel]
        shift: usize = (31 - values[1 + 10 * count + channel]).usize()
        round: i64 = 1.i64() << (shift - 1)
        scaled: i64 = rounded_shift(accumulator * values[1 + 9 * count + channel] + round, shift)
        if scaled > 127: scaled <- 127
        if scaled < -128: scaled <- -128
        if scaled < 0: output[channel] <- (scaled + 256).u8()
        else: output[channel] <- scaled.u8()
    count.i64()

export fn depthconv(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = depthconv_impl
