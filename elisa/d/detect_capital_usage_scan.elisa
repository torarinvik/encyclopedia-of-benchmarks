const MAX_LENGTH: usize = 1024

def scan_capital_is_upper(value: i64) -> bool:
    return value >= 65 and value <= 90

def scan_capital_is_lower(value: i64) -> bool:
    return value >= 97 and value <= 122

def detect_capital_usage_scan_impl(input: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    valid_input: bool =
        for index in 0..<length |valid: mutable bool = true| -> valid:
            value: i64 = input[index]
            if not scan_capital_is_upper(value) and not scan_capital_is_lower(value):
                break false
            valid
    if not valid_input:
        return -1
    if length <= 1:
        return 1
    scan_result: bool =
        for index in 1..<length |valid: mutable bool = true| -> valid:
            if scan_capital_is_upper(input[index]):
                all_upper: bool =
                    for check in 0..<length |all_upper: mutable bool = true| -> all_upper:
                        if scan_capital_is_lower(input[check]):
                            break false
                        all_upper
                if not all_upper:
                    break false
            valid
    if not scan_result:
        return 0
    1

export fn detect_capital_usage_scan(input: i64&, length: usize) -> i64 = detect_capital_usage_scan_impl
