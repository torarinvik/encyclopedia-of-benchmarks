def dc_find(parent: mutable i64[32]&, x0: usize) -> usize:
    x: mutable usize = x0
    while parent[x] != x.i64():
        parent[x] <- parent[parent[x].usize()]
        x <- parent[x].usize()
    x

def dc_side(adj: u64[32]&, n: usize, start: usize, output_nodes: mutable usize[32]&) -> usize:
    seen: mutable bool[32] = zeroed
    nodes: mutable usize[32] = zeroed
    top: mutable usize = 1
    count: mutable usize = 0
    nodes[0] <- start
    while top > 0:
        top <- top - 1
        u: usize = nodes[top]
        if not seen[u]:
            seen[u] <- true
            output_nodes[count] <- u
            count <- count + 1
            v: mutable usize = 0
            while v < n:
                if ((adj[u] >> v) & 1) != 0 and not seen[v]:
                    nodes[top] <- v
                    top <- top + 1
                v <- v + 1
    count

def decremental_connectivity_impl(a: i64&, length: usize) -> i64:
    if length < 3 or length > 449:
        return -1
    n64: i64 = a[0]
    m64: i64 = a[1]
    if n64 < 1 or n64 > 32 or m64 < 0 or m64 >= n64:
        return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    ep: usize = 2 + 2 * m
    if length <= ep:
        return -1
    q64: i64 = a[ep]
    if q64 < 0 or q64 > 128 or length != ep + 1 + 3 * q64.usize():
        return -1
    q: usize = q64.usize()
    adj: mutable u64[32] = zeroed
    parent: mutable i64[32] = zeroed
    i: mutable usize = 0
    while i < n:
        parent[i] <- i.i64()
        i <- i + 1
    i <- 0
    while i < m:
        u64_value: i64 = a[2 + 2 * i]
        v64_value: i64 = a[3 + 2 * i]
        if u64_value < 0 or u64_value >= n64 or v64_value < 0 or v64_value >= n64 or u64_value == v64_value:
            return -1
        u: usize = u64_value.usize()
        v: usize = v64_value.usize()
        if ((adj[u] >> v) & 1) != 0:
            return -1
        ru: usize = dc_find(&parent[0], u)
        rv: usize = dc_find(&parent[0], v)
        if ru == rv:
            return -1
        parent[rv] <- ru.i64()
        adj[u] <- adj[u] | (1 << v)
        adj[v] <- adj[v] | (1 << u)
        i <- i + 1
    comp: mutable i64[32] = zeroed
    i <- 0
    while i < n:
        comp[i] <- -1
        i <- i + 1
    next: mutable usize = 0
    node_stack: mutable usize[32] = zeroed
    start: mutable usize = 0
    while start < n:
        if comp[start] < 0:
            top: mutable usize = 1
            node_stack[0] <- start
            comp[start] <- next.i64()
            while top > 0:
                top <- top - 1
                u: usize = node_stack[top]
                v: mutable usize = 0
                while v < n:
                    if ((adj[u] >> v) & 1) != 0 and comp[v] < 0:
                        comp[v] <- next.i64()
                        node_stack[top] <- v
                        top <- top + 1
                    v <- v + 1
            next <- next + 1
        start <- start + 1
    h: mutable u64 = 14695981039346656037
    k: mutable usize = 0
    while k < q:
        p: usize = ep + 1 + 3 * k
        op: i64 = a[p]
        u64_value: i64 = a[p + 1]
        v64_value: i64 = a[p + 2]
        if (op != 0 and op != 1) or u64_value < 0 or u64_value >= n64 or v64_value < 0 or v64_value >= n64:
            return -1
        u: usize = u64_value.usize()
        v: usize = v64_value.usize()
        if op == 1:
            h <- (h ^ (comp[u] == comp[v]).u64()) * 1099511628211
        else:
            if ((adj[u] >> v) & 1) == 0 or comp[u] != comp[v]:
                return -1
            adj[u] <- adj[u] & ~(1 << v)
            adj[v] <- adj[v] & ~(1 << u)
            left: mutable usize[32] = zeroed
            right: mutable usize[32] = zeroed
            lc: usize = dc_side(&adj[0], n, u, &left[0])
            rc: usize = dc_side(&adj[0], n, v, &right[0])
            j: mutable usize = 0
            if lc < rc or (lc == rc and u < v):
                while j < lc:
                    comp[left[j]] <- next.i64()
                    j <- j + 1
            else:
                while j < rc:
                    comp[right[j]] <- next.i64()
                    j <- j + 1
            next <- next + 1
        k <- k + 1
    h.i64()

export fn decremental_connectivity(a: i64&, length: usize) -> i64 = decremental_connectivity_impl
