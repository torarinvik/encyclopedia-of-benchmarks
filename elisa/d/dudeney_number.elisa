# Test whether n is a positive Dudeney number: cube root equals digit sum.
def dudeney_number_impl(number: i64) -> i64:
    if number <= 0 or number > 2147483647:
        return -1
    low: mutable i64 = 1
    high: mutable i64 = 1290
    root: mutable i64 = 0
    while low <= high:
        middle: i64 = low + (high - low) / 2
        cube: i64 = middle * middle * middle
        if cube == number:
            root <- middle
            break
        if cube < number:
            low <- middle + 1
        else:
            high <- middle - 1
    if root == 0:
        return 0
    remaining: mutable i64 = number
    sum: mutable i64 = 0
    while remaining > 0:
        sum <- sum + remaining % 10
        remaining <- remaining / 10
    if sum == root:
        return 1
    return 0

export fn dudeney_number(number: i64) -> i64 = dudeney_number_impl
