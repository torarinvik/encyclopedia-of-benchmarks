const MAX_CHILDREN: usize = 8
const MAX_INPUT_LENGTH: usize = 1 + 8 * MAX_CHILDREN + 8

def dbms_valid_box(values: i64&, at: usize) -> bool:
    for d in 0..<4:
        if values[at + d] < -8 or values[at + d] > 8 or values[at + 4 + d] < -8 or values[at + 4 + d] > 8 or values[at + d] >= values[at + 4 + d]: return false
    true

def dbms_volume_at(values: i64&, at: usize) -> i64:
    result: mutable i64 = 1
    for d in 0..<4: result <- result * (values[at + 4 + d] - values[at + d])
    result

def dbms_penalty_at(values: i64&, child: usize, incoming: usize) -> i64:
    joined_volume: mutable i64 = 1
    for d in 0..<4:
        child_lo: i64 = values[child + d]
        incoming_lo: i64 = values[incoming + d]
        child_hi: i64 = values[child + 4 + d]
        incoming_hi: i64 = values[incoming + 4 + d]
        lo: i64 = if child_lo < incoming_lo: child_lo else: incoming_lo
        hi: i64 = if child_hi > incoming_hi: child_hi else: incoming_hi
        joined_volume <- joined_volume * (hi - lo)
    joined_volume - dbms_volume_at(values, child)

def versabench_dbms_choose_entry_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 1 or length > MAX_INPUT_LENGTH + 1: return -1
    raw_count: i64 = values[0]
    if raw_count < 1 or raw_count > MAX_CHILDREN.i64(): return -1
    count: usize = raw_count.usize()
    if length != 1 + 8 * count + 8: return -1
    incoming: usize = 1 + 8 * count
    for i in 0..<count:
        if not dbms_valid_box(&values[0], 1 + 8 * i): return -1
    if not dbms_valid_box(&values[0], incoming): return -1
    best: mutable usize = 0
    best_penalty: mutable i64 = dbms_penalty_at(&values[0], 1, incoming)
    for i in 1..<count:
        candidate: i64 = dbms_penalty_at(&values[0], 1 + 8 * i, incoming)
        if candidate < best_penalty:
            best <- i
            best_penalty <- candidate
    best.i64()

export fn versabench_dbms_choose_entry(values: i64&, length: usize) -> i64 = versabench_dbms_choose_entry_impl
