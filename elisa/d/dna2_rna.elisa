const MAX_INPUT_VALUES: usize = 1001

def dna2_rna_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or length > MAX_INPUT_VALUES or values[0] != 0:
        return -1
    count: usize = length - 1
    for index in 1..<length:
        if values[index] < 65 or values[index] > 90:
            return -1
    if output_capacity < count:
        return -2
    for index in 0..<count:
        base: i64 = values[index + 1]
        if base == 84:
            output[index] <- 85.u8()
        else:
            output[index] <- base.u8()
    count.i64()

export fn dna2_rna(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = dna2_rna_impl
