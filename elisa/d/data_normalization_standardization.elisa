extern sqrt(value: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def data_normalization_standardization_put_f64_le(value: f64, output: mutable u8&, offset: usize) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def data_normalization_standardization_impl(values: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if values.is_null() or length < 4 or length > 130: return -1
    mode: i64 = values[0]
    count_value: i64 = values[1]
    if (mode != 0 and mode != 1) or count_value < 2 or count_value > 128 or length != count_value.usize() + 2: return -1
    count: usize = count_value.usize()
    minimum: mutable i64 = values[2]
    maximum: mutable i64 = values[2]
    sum: mutable f64 = 0.0
    for index in 0..<count:
        value: i64 = values[index + 2]
        if value < -100000 or value > 100000: return -1
        if value < minimum: minimum <- value
        if value > maximum: maximum <- value
        sum <- sum + value.f64()
    if minimum == maximum: return -1
    output_bytes: usize = count * 8
    if output.is_null() or capacity < output_bytes: return -2
    if mode == 0:
        span: f64 = (maximum - minimum).f64()
        for index in 0..<count:
            normalized: f64 = (values[index + 2] - minimum).f64() / span
            data_normalization_standardization_put_f64_le(normalized, output, index * 8)
    else:
        mean: f64 = sum / count.f64()
        squared_deviations: mutable f64 = 0.0
        for index in 0..<count:
            deviation: f64 = values[index + 2].f64() - mean
            squared_deviations <- squared_deviations + deviation * deviation
        sample_deviation: f64 = sqrt(squared_deviations / (count - 1).f64())
        for index in 0..<count:
            standardized: f64 = (values[index + 2].f64() - mean) / sample_deviation
            data_normalization_standardization_put_f64_le(standardized, output, index * 8)
    output_bytes.i64()

export fn data_normalization_standardization(values: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = data_normalization_standardization_impl
