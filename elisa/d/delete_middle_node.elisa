const MAX_NODES: usize = 1024

# Remove the middle node using the source's two-pass fast/slow traversal.
def delete_middle_node_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length > MAX_NODES:
        return -1
    for index in 0..<length |input|:
        value: i64 = input[index]
        if value < -2147483648 or value > 2147483647:
            return -1
    if length <= 1:
        return 0
    next_node: mutable usize[1025] = zeroed
    for index in 0..<length |next_node|:
        next_node[index] <- index + 1
    next_node[length] <- length
    node_count: mutable usize = 0
    cursor: mutable usize = 0
    while cursor != length |cursor, node_count, next_node|:
        node_count <- node_count + 1
        cursor <- next_node[cursor]
    fast: mutable usize = 0
    slow: mutable usize = 0
    previous: mutable usize = length
    while next_node[fast] != length and next_node[next_node[fast]] != length |fast, slow, previous, next_node|:
        previous <- slow
        slow <- next_node[slow]
        fast <- next_node[next_node[fast]]
    if node_count % 2 == 0:
        previous <- slow
        slow <- next_node[slow]
    next_node[previous] <- next_node[slow]
    survivor_count: usize = node_count - 1
    output_bytes: usize = survivor_count * 4
    if output_capacity < output_bytes:
        return -2
    node: mutable usize = 0
    written: mutable usize = 0
    while node != length |node, written, next_node, input, output|:
        bits: u32 = input[node].u32()
        output[written * 4] <- (bits & 255).u8()
        output[written * 4 + 1] <- ((bits >> 8) & 255).u8()
        output[written * 4 + 2] <- ((bits >> 16) & 255).u8()
        output[written * 4 + 3] <- ((bits >> 24) & 255).u8()
        written <- written + 1
        node <- next_node[node]
    written.i64()

export fn delete_middle_node(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = delete_middle_node_impl
