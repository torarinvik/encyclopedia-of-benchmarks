const MAX_AMOUNT: i64 = 30
const MAX_DENOMINATIONS: i64 = 4

def demonetization_ways(amount: i64, input: i64&, count: i64) -> i64:
    if amount < 0 or count < 0:
        return 0
    if amount == 0:
        return 1
    if count == 0:
        return 0
    denomination: i64 = input[(count + 1).usize()]
    demonetization_ways(amount, input, count - 1) + demonetization_ways(amount - denomination, input, count)

# Count denomination combinations with the source's recursive recurrence.
def demonetization_impl(input: i64&, length: usize) -> i64:
    if length < 2 or length > 6:
        return -1
    amount: i64 = input[0]
    count: i64 = input[1]
    if amount < -MAX_AMOUNT or amount > MAX_AMOUNT or count < 0 or count > MAX_DENOMINATIONS or length != (count + 2).usize():
        return -1
    index: mutable usize = 0
    while index < count.usize():
        denomination: i64 = input[index + 2]
        if denomination < 1 or denomination > MAX_AMOUNT:
            return -1
        index <- index + 1
    demonetization_ways(amount, input, count)

export fn demonetization(input: i64&, length: usize) -> i64 = demonetization_impl
