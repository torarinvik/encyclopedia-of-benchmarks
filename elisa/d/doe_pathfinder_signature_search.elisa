const MAX_NODES: usize = 10
const MAX_EDGES: usize = 100
const MAX_SIGNATURE_LENGTH: usize = 4
const MAX_LABEL: i64 = 7

def search_leg(values: i64&, labels_start: usize, signature_start: usize,
               edge_count: usize, signature_length: usize, node: usize, signature_index: usize,
               visited: mutable u64&) -> bool:
    bit: u64 = (1).u64() << node
    if (visited & bit) != 0:
        return false
    visited <- visited | bit
    target_label: i64 = values[signature_start + signature_index]

    for edge in 0..<edge_count:
        if values[3 + 2 * edge].usize() != node:
            continue
        target: usize = values[3 + 2 * edge + 1].usize()
        if values[labels_start + target] != target_label:
            continue
        if signature_index + 1 == signature_length:
            return true
        next_visited: mutable u64 = 0
        if search_leg(values, labels_start, signature_start, edge_count, signature_length,
                      target, signature_index + 1, next_visited):
            return true

    for edge in 0..<edge_count:
        if values[3 + 2 * edge].usize() != node:
            continue
        target: usize = values[3 + 2 * edge + 1].usize()
        if search_leg(values, labels_start, signature_start, edge_count, signature_length,
                      target, signature_index, visited):
            return true
    false

def doe_pathfinder_signature_search_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 3 or values[0] < 1 or values[0] > MAX_NODES.i64() or
       values[1].u64() > MAX_EDGES.u64() or values[2] < 2 or
       values[2] > MAX_SIGNATURE_LENGTH.i64():
        return -2
    node_count: usize = values[0].usize()
    edge_count: usize = values[1].usize()
    signature_length: usize = values[2].usize()
    if edge_count > node_count * node_count or
       length != 3 + 2 * edge_count + node_count + signature_length:
        return -2

    seen_targets: mutable u16[10] = zeroed
    for edge in 0..<edge_count:
        source: usize = values[3 + 2 * edge].usize()
        target: usize = values[4 + 2 * edge].usize()
        if source >= node_count or target >= node_count:
            return -2
        bit: u16 = 1.u16() << target
        if (seen_targets[source] & bit) != 0:
            return -2
        seen_targets[source] <- seen_targets[source] | bit
    labels_start: usize = 3 + 2 * edge_count
    signature_start: usize = labels_start + node_count
    for node in 0..<node_count:
        if values[labels_start + node] < -1 or values[labels_start + node] > MAX_LABEL:
            return -2
    for index in 0..<signature_length:
        if values[signature_start + index].u64() > MAX_LABEL.u64():
            return -2

    if edge_count == 0: return 0
    first_label: i64 = values[signature_start]
    # A single edge can be reused only when it is a self-loop.
    if edge_count == 1:
        source: usize = values[3].usize()
        target: usize = values[4].usize()
        if values[labels_start + source] != first_label:
            return 0
        if source != target and signature_length != 2:
            return 0
        target_label: i64 = values[labels_start + target]
        for index in 1..<signature_length:
            if values[signature_start + index] != target_label:
                return 0
        return 1
    for node in 0..<node_count:
        if values[labels_start + node] == first_label:
            visited: mutable u64 = 0
            if search_leg(values, labels_start, signature_start,
                          edge_count, signature_length, node, 1, visited):
                return 1
    0

export fn doe_pathfinder_signature_search(values: i64&, length: usize) -> i64 = doe_pathfinder_signature_search_impl
