@intrinsic("llvm.cttz.i32")
extern domination_trailing_zeros(value: u32, zero_undefined: bool) -> u32

def domination_local_reduction_put_word(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for b in 0..<8:
        output[offset + b] <- (bits >> (8 * b)).u8()

def domination_local_reduction_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > 135: return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    p0: i64 = input[2]
    if n0 < 1 or n0 > 12 or m0 < 0 or m0 > 66 or p0 < 0 or p0 >= n0 or length != (3 + 2 * m0).usize(): return -1
    n: usize = n0.usize()
    m: usize = m0.usize()
    p: usize = p0.usize()
    adj: mutable u16[12] = zeroed
    for e in 0..<m:
        u0: i64 = input[3 + 2 * e]
        v0: i64 = input[4 + 2 * e]
        # Unsigned ordering rejects negative endpoints and enforces 0 <= u < v < n.
        if v0.u64() >= n0.u64() or u0.u64() >= v0.u64(): return -1
        u: usize = u0.usize()
        v: usize = v0.usize()
        u_bit: u16 = 1.u16() << u
        v_bit: u16 = 1.u16() << v
        if (adj[u] & v_bit) != 0: return -1
        adj[u] <- adj[u] | v_bit
        adj[v] <- adj[v] | u_bit
    neighbors: u16 = adj[p]
    closed: u16 = neighbors | (1.u16() << p)
    exits: mutable u16 = 0
    remaining_neighbors: mutable u32 = neighbors.u32()
    while remaining_neighbors != 0:
        u: usize = domination_trailing_zeros(remaining_neighbors, true).usize()
        bit: u32 = remaining_neighbors & (0.u32() - remaining_neighbors)
        remaining_neighbors <- remaining_neighbors ^ bit
        if (adj[u] & ~closed) != 0:
            exits <- exits | bit.u16()
    candidates: u16 = neighbors & ~exits
    remaining_candidates: mutable u32 = candidates.u32()
    has_prisoner: mutable bool = exits == 0 and candidates != 0
    while not has_prisoner and remaining_candidates != 0:
        u: usize = domination_trailing_zeros(remaining_candidates, true).usize()
        if (adj[u] & exits) == 0:
            has_prisoner <- true
            break
        remaining_candidates <- remaining_candidates & (remaining_candidates - 1.u32())
    if not has_prisoner: return -1
    # At most twelve vertex IDs fit in twelve four-bit slots.
    packed_ids: mutable u64 = 0
    pivot_index: mutable usize = 0
    kept: mutable usize = 0
    for u in 0..<n:
        if (candidates & (1.u16() << u)) == 0:
            packed_ids <- packed_ids | (u.u64() << (4 * kept))
            if u == p: pivot_index <- kept
            kept <- kept + 1
    k: usize = kept + 1
    leaf: usize = k - 1
    bytes: usize = (1 + 2 * k) * 8
    if output == null or capacity < bytes: return -2
    domination_local_reduction_put_word(output, 0, k.i64())
    domination_local_reduction_put_word(output, 8 * (1 + kept), -1)
    for i in 0..<kept:
        vertex: usize = ((packed_ids >> (4 * i)) & 15).usize()
        domination_local_reduction_put_word(output, 8 * (1 + i), vertex.i64())
        neighbors_of_vertex: u16 = adj[vertex]
        row: mutable i64 = 0
        for j in 0..<kept:
            original_vertex: u64 = (packed_ids >> (4 * (kept - 1 - j))) & 15
            edge: i64 = ((neighbors_of_vertex >> original_vertex) & 1).i64()
            row <- (row << 1) | edge
        if i == pivot_index: row <- row | (1.i64() << leaf)
        domination_local_reduction_put_word(output, 8 * (1 + k + i), row)
    domination_local_reduction_put_word(output, 8 * (1 + k + leaf), 1.i64() << pivot_index)
    bytes.i64()

export fn domination_local_reduction(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = domination_local_reduction_impl
