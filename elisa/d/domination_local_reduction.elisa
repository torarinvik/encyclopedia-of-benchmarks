def domination_local_reduction_put_word(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for b in 0..<8: output[offset + b] <- (bits >> (8 * b)).u8()

def domination_local_reduction_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > 135: return -1
    n0: i64=input[0];m0: i64=input[1];p0: i64=input[2]
    if n0<1 or n0>12 or m0<0 or m0>66 or p0<0 or p0>=n0 or length!=(3+2*m0).usize():return -1
    n:usize=n0.usize();m:usize=m0.usize();p:usize=p0.usize()
    adj: mutable bool[144]=zeroed
    for e in 0..<m:
        u0:i64=input[3+2*e];v0:i64=input[4+2*e]
        if u0<0 or v0<=u0 or v0>=n0:return -1
        u:usize=u0.usize();v:usize=v0.usize();if adj[u*12+v]:return -1
        adj[u*12+v]<-true;adj[v*12+u]<-true
    closed:mutable bool[12]=zeroed;exits:mutable bool[12]=zeroed;guards:mutable bool[12]=zeroed;prisoners:mutable bool[12]=zeroed
    closed[p]<-true
    for u in 0..<n:if adj[p*12+u]:closed[u]<-true
    for u in 0..<n:
        if adj[p*12+u]:
            for x in 0..<n:if adj[u*12+x] and not closed[x]:exits[u]<-true;break
    for u in 0..<n:
        if adj[p*12+u] and not exits[u]:
            for x in 0..<n:if exits[x] and adj[u*12+x]:guards[u]<-true;break
    np:mutable usize=0
    for u in 0..<n:if adj[p*12+u] and not exits[u] and not guards[u]:prisoners[u]<-true;np<-np+1
    if np==0:return -1
    ids:mutable usize[12]=zeroed;remap:mutable i64[12]=zeroed
    for u in 0..<n:remap[u]<- -1
    kept:mutable usize=0
    for u in 0..<n:if not guards[u] and not prisoners[u]:ids[kept]<-u;remap[u]<-kept.i64();kept<-kept+1
    k:usize=kept+1;leaf:usize=k-1;words:mutable i64[25]=zeroed;words[0]<-k.i64()
    for i in 0..<kept:words[1+i]<-ids[i].i64()
    words[1+kept]<- -1
    for i in 0..<kept:
        for j in 0..<kept:if adj[ids[i]*12+ids[j]]:words[1+k+i]<-words[1+k+i] or (1'i64 << j)
    rp:usize=remap[p].usize();words[1+k+rp]<-words[1+k+rp] or (1'i64 << leaf);words[1+k+leaf]<-1'i64 << rp
    count:usize=1+2*k;bytes:usize=count*8
    if output==null or capacity<bytes:return -2
    for i in 0..<count:domination_local_reduction_put_word(output[0:bytes],i*8,words[i])
    bytes.i64()

export fn domination_local_reduction(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = domination_local_reduction_impl
