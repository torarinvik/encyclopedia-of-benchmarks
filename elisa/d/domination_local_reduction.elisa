# Alber-Fellows-Niedermeier local reduction around a pivot: classify its
# neighbors into exit, guard and prison sets, then emit the reduced graph with
# the prisoners and guards replaced by a single leaf attached to the pivot.
def domination_local_reduction_put_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    i: mutable usize = 0
    while i < 8:
        output[offset + i] <- ((bits >> (8 * i).u64()) & 255).u8()
        i <- i + 1

def domination_local_reduction_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > 135:
        return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    p0: i64 = input[2]
    if n0 < 1 or n0 > 12 or m0 < 0 or m0 > 66 or p0 < 0 or p0 >= n0 or length != 3 + 2 * m0.usize():
        return -1
    n: usize = n0.usize()
    m: usize = m0.usize()
    p: usize = p0.usize()
    a: mutable u8[144] = zeroed
    e: mutable usize = 0
    while e < m:
        u0: i64 = input[3 + 2 * e]
        v0: i64 = input[4 + 2 * e]
        if u0 < 0 or v0 <= u0 or v0 >= n0:
            return -1
        u: usize = u0.usize()
        v: usize = v0.usize()
        if a[u * 12 + v] != 0:
            return -1
        a[u * 12 + v] <- 1
        a[v * 12 + u] <- 1
        e <- e + 1
    closed: mutable u8[12] = zeroed
    exits: mutable u8[12] = zeroed
    guard: mutable u8[12] = zeroed
    prisoner: mutable u8[12] = zeroed
    closed[p] <- 1
    u: mutable usize = 0
    while u < n:
        if a[p * 12 + u] != 0:
            closed[u] <- 1
        u <- u + 1
    u <- 0
    while u < n:
        if a[p * 12 + u] != 0:
            x: mutable usize = 0
            while x < n:
                if a[u * 12 + x] != 0 and closed[x] == 0:
                    exits[u] <- 1
                    break
                x <- x + 1
        u <- u + 1
    u <- 0
    while u < n:
        if a[p * 12 + u] != 0 and exits[u] == 0:
            x: mutable usize = 0
            while x < n:
                if exits[x] != 0 and a[u * 12 + x] != 0:
                    guard[u] <- 1
                    break
                x <- x + 1
        u <- u + 1
    prisoner_count: mutable usize = 0
    u <- 0
    while u < n:
        if a[p * 12 + u] != 0 and exits[u] == 0 and guard[u] == 0:
            prisoner[u] <- 1
            prisoner_count <- prisoner_count + 1
        u <- u + 1
    if prisoner_count == 0:
        return -1
    ids: mutable usize[12] = zeroed
    remap: mutable i64[12] = zeroed
    kept: mutable usize = 0
    u <- 0
    while u < n:
        remap[u] <- -1
        if guard[u] == 0 and prisoner[u] == 0:
            ids[kept] <- u
            remap[u] <- kept.i64()
            kept <- kept + 1
        u <- u + 1
    k: usize = kept + 1
    leaf: usize = k - 1
    words: mutable i64[25] = zeroed
    words[0] <- k.i64()
    i: mutable usize = 0
    while i < kept:
        words[1 + i] <- ids[i].i64()
        i <- i + 1
    words[1 + kept] <- -1
    i <- 0
    while i < k:
        words[1 + k + i] <- 0
        i <- i + 1
    i <- 0
    while i < kept:
        j: mutable usize = 0
        while j < kept:
            if a[ids[i] * 12 + ids[j]] != 0:
                words[1 + k + i] <- words[1 + k + i] | (1.u64() << j.u64()).i64()
            j <- j + 1
        i <- i + 1
    pivot: usize = remap[p].usize()
    words[1 + k + pivot] <- words[1 + k + pivot] | (1.u64() << leaf.u64()).i64()
    words[1 + k + leaf] <- (1.u64() << pivot.u64()).i64()
    count: usize = 1 + 2 * k
    bytes: usize = count * 8
    if output == null or capacity < bytes:
        return -2
    i <- 0
    while i < count:
        domination_local_reduction_put_i64(output, 8 * i, words[i])
        i <- i + 1
    bytes.i64()

export fn domination_local_reduction(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = domination_local_reduction_impl
