def domination_local_reduction_put_word(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for b in 0..<8:
        output[offset + b] <- (bits >> (8 * b)).u8()

def domination_local_reduction_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > 135: return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    p0: i64 = input[2]
    if n0 < 1 or n0 > 12 or m0 < 0 or m0 > 66 or p0 < 0 or p0 >= n0 or length != (3 + 2 * m0).usize(): return -1
    n: usize = n0.usize()
    m: usize = m0.usize()
    p: usize = p0.usize()
    adj: mutable u16[12] = zeroed
    for e in 0..<m:
        u0: i64 = input[3 + 2 * e]
        v0: i64 = input[4 + 2 * e]
        if u0 < 0 or v0 <= u0 or v0 >= n0: return -1
        u: usize = u0.usize()
        v: usize = v0.usize()
        u_bit: u16 = 1.u16() << u
        v_bit: u16 = 1.u16() << v
        if (adj[u] & v_bit) != 0: return -1
        adj[u] <- adj[u] | v_bit
        adj[v] <- adj[v] | u_bit
    neighbors: u16 = adj[p]
    closed: u16 = neighbors | (1.u16() << p)
    exits: mutable u16 = 0
    for u in 0..<n:
        bit: u16 = 1.u16() << u
        if (neighbors & bit) != 0 and (adj[u] & ~closed) != 0:
            exits <- exits | bit
    candidates: u16 = neighbors & ~exits
    guards: mutable u16 = 0
    for u in 0..<n:
        bit: u16 = 1.u16() << u
        if (candidates & bit) != 0 and (adj[u] & exits) != 0:
            guards <- guards | bit
    if (candidates & ~guards) == 0: return -1
    # At most twelve vertex IDs fit in twelve four-bit slots.
    packed_ids: mutable u64 = 0
    pivot_index: mutable usize = 0
    kept: mutable usize = 0
    for u in 0..<n:
        if (candidates & (1.u16() << u)) == 0:
            packed_ids <- packed_ids | (u.u64() << (4 * kept))
            if u == p: pivot_index <- kept
            kept <- kept + 1
    k: usize = kept + 1
    leaf: usize = k - 1
    bytes: usize = (1 + 2 * k) * 8
    if output == null or capacity < bytes: return -2
    domination_local_reduction_put_word(output, 0, k.i64())
    for i in 0..<kept:
        domination_local_reduction_put_word(output, 8 * (1 + i), ((packed_ids >> (4 * i)) & 15).i64())
    domination_local_reduction_put_word(output, 8 * (1 + kept), -1)
    for i in 0..<kept:
        neighbors_of_vertex: u16 = adj[((packed_ids >> (4 * i)) & 15).usize()]
        remaining_ids: mutable u64 = packed_ids
        row: mutable i64 = 0
        for j in 0..<kept:
            if (neighbors_of_vertex & (1.u16() << (remaining_ids & 15))) != 0:
                row <- row | (1.i64() << j)
            remaining_ids <- remaining_ids >> 4
        if i == pivot_index: row <- row | (1.i64() << leaf)
        domination_local_reduction_put_word(output, 8 * (1 + k + i), row)
    domination_local_reduction_put_word(output, 8 * (1 + k + leaf), 1.i64() << pivot_index)
    bytes.i64()

export fn domination_local_reduction(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = domination_local_reduction_impl
