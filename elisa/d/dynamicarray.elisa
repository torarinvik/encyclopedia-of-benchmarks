const MAX_OPERATIONS: usize = 128
const MAX_ELEMENTS: usize = 64
const MAX_INPUT_LENGTH: usize = 385

def dynamicarray_write_i64(output: mutable view[u8], word_index: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[word_index * 8 + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def dynamicarray_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    operation_count_value: i64 = input[0]
    if operation_count_value < 0 or operation_count_value > 128:
        return -1
    first: mutable i64[64] = zeroed
    second: mutable i64[64] = zeroed
    query_results: mutable i64[128] = zeroed
    active_first: mutable bool = true
    size: mutable usize = 0
    capacity: mutable usize = 0
    cursor: mutable usize = 1
    query_count: mutable usize = 0
    operation_index: mutable usize = 0
    operation_count: usize = operation_count_value.usize()
    while operation_index < operation_count:
        if cursor >= length:
            return -1
        operation: i64 = input[cursor]
        cursor <- cursor + 1
        if operation == 0:
            if cursor >= length or size >= MAX_ELEMENTS:
                return -1
            value: i64 = input[cursor]
            cursor <- cursor + 1
            if size == capacity:
                index: mutable usize = 0
                if active_first:
                    while index < size:
                        second[index] <- first[index]
                        index <- index + 1
                    active_first <- false
                else:
                    while index < size:
                        first[index] <- second[index]
                        index <- index + 1
                    active_first <- true
                if capacity == 0:
                    capacity <- 10
                else:
                    capacity <- capacity * 2
            if active_first:
                first[size] <- value
            else:
                second[size] <- value
            size <- size + 1
        elif operation == 1:
            if cursor + 1 >= length:
                return -1
            index_value: i64 = input[cursor]
            value: i64 = input[cursor + 1]
            cursor <- cursor + 2
            if index_value < 0 or index_value >= size.i64():
                return -1
            index: usize = index_value.usize()
            if active_first:
                first[index] <- value
            else:
                second[index] <- value
        elif operation == 2 or operation == 3:
            if cursor >= length:
                return -1
            index_value: i64 = input[cursor]
            cursor <- cursor + 1
            if index_value < 0 or index_value >= size.i64():
                return -1
            index: usize = index_value.usize()
            if operation == 2:
                if query_count >= MAX_OPERATIONS:
                    return -1
                if active_first:
                    query_results[query_count] <- first[index]
                else:
                    query_results[query_count] <- second[index]
                query_count <- query_count + 1
            else:
                if active_first:
                    while index + 1 < size:
                        first[index] <- first[index + 1]
                        index <- index + 1
                else:
                    while index + 1 < size:
                        second[index] <- second[index + 1]
                        index <- index + 1
                size <- size - 1
        elif operation >= 4 and operation <= 6:
            if query_count >= MAX_OPERATIONS:
                return -1
            if operation == 4:
                query_results[query_count] <- size.i64()
            elif operation == 5:
                query_results[query_count] <- capacity.i64()
            else:
                if size == 0:
                    query_results[query_count] <- 1
                else:
                    query_results[query_count] <- 0
            query_count <- query_count + 1
        else:
            return -1
        operation_index <- operation_index + 1
    if cursor != length:
        return -1
    output_words: usize = 3 + query_count + size
    if output_capacity < output_words * 8:
        return -2
    dynamicarray_write_i64(output[0:output_words * 8], 0, query_count.i64())
    index: mutable usize = 0
    while index < query_count:
        dynamicarray_write_i64(output[0:output_words * 8], index + 1, query_results[index])
        index <- index + 1
    dynamicarray_write_i64(output[0:output_words * 8], query_count + 1, size.i64())
    dynamicarray_write_i64(output[0:output_words * 8], query_count + 2, capacity.i64())
    index <- 0
    while index < size:
        value: mutable i64 = 0
        if active_first:
            value <- first[index]
        else:
            value <- second[index]
        dynamicarray_write_i64(output[0:output_words * 8], query_count + 3 + index, value)
        index <- index + 1
    output_words.i64()

export fn dynamicarray(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = dynamicarray_impl
