const N: usize = 1023

def diff_views_impl(a: view[i64], n: usize, root: i64, view: i64, out: mutable view[i64], cap: usize) -> i64:
    if n > N or view < 0 or view > 3:
        return -1
    if n == 0:
        if root == -1:
            return 0
        return -1
    if root < 0 or root.u64() >= n.u64():
        return -1
    if cap < n:
        return -2
    parents: mutable usize[N] = zeroed
    for i in 0..<n |a, parents|:
        v: i64 = a[3 * i]
        l: i64 = a[3 * i + 1]
        r: i64 = a[3 * i + 2]
        if v < -2147483648 or v > 2147483647 or l < -1 or r < -1 or (l >= 0 and l.u64() >= n.u64()) or (r >= 0 and r.u64() >= n.u64()):
            return -1
        if l >= 0:
            x: usize = l.usize()
            parents[x] <- parents[x] + 1
            if parents[x] > 1:
                return -1
        if r >= 0:
            x: usize = r.usize()
            parents[x] <- parents[x] + 1
            if parents[x] > 1:
                return -1
    rr: usize = root.usize()
    if parents[rr] != 0:
        return -1
    for i in 0..<n |parents, rr|:
        if i != rr and parents[i] != 1:
            return -1
    q: mutable usize[N] = zeroed
    depth: mutable usize[N] = zeroed
    col: mutable i64[N] = zeroed
    seen: mutable i64[N] = zeroed
    selected: mutable i64[2 * N + 1] = zeroed
    has_value: mutable i64[2 * N + 1] = zeroed
    head: mutable usize = 0
    endq: mutable usize = 1
    q[0] <- rr
    seen[rr] <- 1
    while head < endq |head, endq, q, depth, col, seen, selected, has_value, a|:
        u: usize = q[head]
        head <- head + 1
        d: usize = depth[u]
        c: i64 = col[u]
        v: i64 = a[3 * u]
        idx: mutable usize = (c + i64(N)).usize()
        if view < 2:
            idx <- d
        if has_value[idx] == 0 or view == 0 or view == 3:
            selected[idx] <- v
            has_value[idx] <- 1
        l: i64 = a[3 * u + 1]
        r: i64 = a[3 * u + 2]
        if l >= 0:
            x: usize = l.usize()
            if seen[x] != 0 or endq >= n:
                return -1
            seen[x] <- 1
            depth[x] <- d + 1
            col[x] <- c - 1
            q[endq] <- x
            endq <- endq + 1
        if r >= 0:
            x: usize = r.usize()
            if seen[x] != 0 or endq >= n:
                return -1
            seen[x] <- 1
            depth[x] <- d + 1
            col[x] <- c + 1
            q[endq] <- x
            endq <- endq + 1
    if endq != n:
        return -1
    written: mutable usize = 0
    if view < 2:
        for i in 0..<n |selected, has_value, out, written|:
            if has_value[i] != 0:
                out[written] <- selected[i]
                written <- written + 1
    else:
        for i in 0..<(2 * N + 1) |selected, has_value, out, written|:
            if has_value[i] != 0:
                out[written] <- selected[i]
                written <- written + 1
    return written.i64()

export fn diff_views_of_binary_tree(a: i64&, n: usize, root: i64, view: i64,
        out: mutable i64&, cap: usize) -> i64:
    diff_views_impl(a[0:3 * n], n, root, view, out[0:cap], cap)
