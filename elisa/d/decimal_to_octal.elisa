# Write the octal digits of a nonnegative signed 64-bit input.
def decimal_to_octal_impl(value: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if value < 0:
        return -1
    width: usize =
        while remaining >= 8 |remaining: mutable i64 = value, count: mutable usize = 1| -> count:
            remaining <- remaining / 8
            count <- count + 1
    if output_capacity < width:
        return -2
    while position > 0 |position: mutable usize = width, remaining: mutable i64 = value, output| -> output:
        position <- position - 1
        digit: i64 = remaining % 8
        output[position] <- (48 + digit).u8()
        remaining <- remaining / 8
    width.i64()

export fn decimal_to_octal(value: i64, output: mutable u8&, output_capacity: usize) -> i64 = decimal_to_octal_impl
