extern exp(value: f64) -> f64
extern log2(value: f64) -> f64
extern exp2(value: f64) -> f64

def dimensionality_reduction_tsne(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if input == null or input_len != 5 or input[0] != 1.0 or input[1] != 3.0: return -1
    i: mutable usize = 2
    j: mutable usize = 0
    iter: mutable usize = 0
    total: mutable f64 = 0.0
    while i < 5:
        x: f64 = input[i]
        if x != x or x > 100.0 or x < -100.0: return -1
        i <- i + 1
    if output == null or output_capacity < 3: return -2
    dist: mutable f64[9] = zeroed
    cond: mutable f64[9] = zeroed
    high: mutable f64[9] = zeroed
    q: mutable f64[9] = zeroed
    den: mutable f64[9] = zeroed
    i <- 0
    while i < 3:
        j <- 0
        while j < 3:
            delta: f64 = input[2+i] - input[2+j]
            dist[i*3+j] <- delta*delta
            j <- j+1
        i <- i+1
    i <- 0
    while i < 3:
        beta: mutable f64 = 1.0
        lower: mutable f64 = 0.0
        upper: mutable f64 = 0.0
        has_lower: mutable bool = false
        has_upper: mutable bool = false
        iter <- 0
        while iter < 50:
            e: mutable f64[3] = zeroed
            total <- 0.0
            j <- 0
            while j < 3:
                if i != j:
                    e[j] <- exp(-dist[i*3+j]*beta)
                total <- total+e[j]
                j <- j+1
            if total == 0.0: break
            entropy: mutable f64 = 0.0
            j <- 0
            while j < 3:
                if e[j] > 0.0:
                    probability: f64 = e[j]/total
                    entropy <- entropy-probability*log2(probability+1e-12)
                j <- j+1
            current: f64 = exp2(entropy)
            if current-1.5 < 0.00001 and current-1.5 > -0.00001:
                j <- 0
                while j < 3:
                    cond[i*3+j] <- e[j]/total
                    j <- j+1
                break
            if current > 1.5:
                lower <- beta
                has_lower <- true
                if has_upper: beta <- (beta+upper)/2.0
                else: beta <- beta*2.0
            else:
                upper <- beta
                has_upper <- true
                if has_lower: beta <- (beta+lower)/2.0
                else: beta <- beta/2.0
            if iter == 49:
                j <- 0
                while j < 3:
                    cond[i*3+j] <- e[j]/total
                    j <- j+1
            iter <- iter+1
        i <- i+1
    i <- 0
    while i < 3:
        j <- 0
        while j < 3:
            value: mutable f64 = (cond[i*3+j]+cond[j*3+i])/6.0
            if value < 1e-12: value <- 1e-12
            high[i*3+j] <- value
            j <- j+1
        i <- i+1
    y: mutable f64[3] = [0.000030471707975443136, -0.00010399841062404956, 0.00007504511958064573]
    momentum: mutable f64[3] = zeroed
    iter <- 0
    while iter < 5:
        total <- 0.0
        i <- 0
        while i < 3:
            j <- 0
            while j < 3:
                delta: f64 = y[i]-y[j]
                den[i*3+j] <- 1.0+delta*delta
                if i == j: q[i*3+j] <- 0.0
                else: q[i*3+j] <- 1.0/den[i*3+j]
                total <- total+q[i*3+j]
                j <- j+1
            i <- i+1
        i <- 0
        while i < 3:
            j <- 0
            while j < 3:
                if total != 0.0: q[i*3+j] <- q[i*3+j]/total
                if q[i*3+j] < 1e-12: q[i*3+j] <- 1e-12
                j <- j+1
            i <- i+1
        gradient: mutable f64[3] = zeroed
        i <- 0
        while i < 3:
            j <- 0
            while j < 3:
                gradient[i] <- gradient[i]+(high[i*3+j]-q[i*3+j])*(1.0/den[i*3+j])*(y[i]-y[j])
                j <- j+1
            gradient[i] <- gradient[i]*4.0
            i <- i+1
        i <- 0
        while i < 3:
            momentum[i] <- 0.5*momentum[i]-10.0*gradient[i]
            y[i] <- y[i]+momentum[i]
            i <- i+1
        iter <- iter+1
    i <- 0
    while i < 3:
        output[i] <- y[i]
        i <- i+1
    return 3

export fn dimensionality_reduction_tsne(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64 = dimensionality_reduction_tsne
