const DOMINO_TROMINO_MAX_WIDTH = 32
const DOMINO_TROMINO_MAX_INPUT_LENGTH = 2

def count_tilings(width: i64) -> i64:
    var state0: i64 = 1
    var state1: i64 = 0
    var state2: i64 = 0
    var state3: i64 = 0
    for _ in range(Int(width)):
        let next0 = state0 + state3
        let next1 = state0 + state2
        let next2 = state0 + state1
        let next3 = state0 + state1 + state2
        state0 <- next0
        state1 <- next1
        state2 <- next2
        state3 <- next3
    state0

def domino_l_tromino_impl(input: view[i64]) -> i64:
    if input.len() != 1: return -1
    let width = input[0]
    if width < 0 or width > DOMINO_TROMINO_MAX_WIDTH: return -1
    count_tilings(width)

@export("domino_l_tromino_tilings_2xn")
fn domino_l_tromino_tilings_2xn(input: i64&, length: usize) abi("C") -> i64:
    if input.is_null() or length < 1 or length > DOMINO_TROMINO_MAX_INPUT_LENGTH: return -1
    let input_view: view[i64] = input[0:Int(length)]
    domino_l_tromino_impl(input_view)
