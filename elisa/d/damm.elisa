def damm_row(state: i64) -> i64:
    if state == 0: return 317598642
    if state == 1: return 7092154863
    if state == 2: return 4206871359
    if state == 3: return 1750983426
    if state == 4: return 6123045978
    if state == 5: return 3674209581
    if state == 6: return 5869720134
    if state == 7: return 8945362017
    if state == 8: return 9438617205
    if state == 9: return 2581436790
    0

# Damm validation and appended check digit for bounded decimal digit arrays.
def damm_impl(input: i64&, length: usize) -> i64:
    if length < 3 or length > 258: return -1
    mode: i64 = input[0]
    n: i64 = input[1]
    if (mode != 0 and mode != 1) or n < 1 or n > 256 or length != (n + 2).usize(): return -1
    state: mutable i64 = 0
    index: mutable usize = 0
    while index < n.usize():
        digit: i64 = input[index + 2]
        if digit < 0 or digit > 9: return -1
        row: i64 = damm_row(state)
        divisor: mutable i64 = 1
        power: mutable i64 = 0
        while power < 9 - digit:
            divisor <- divisor * 10
            power <- power + 1
        state <- (row / divisor) % 10
        index <- index + 1
    if mode == 0:
        if state == 0: return 1
        return 0
    state
export fn damm(input: i64&, length: usize) -> i64 = damm_impl
