const TABLE_SIZE: usize = 65536
const TABLE_MASK: usize = TABLE_SIZE - 1
const MAX_MODULUS: u64 = 1000000000

def dlm_gcd(left: u64, right: u64) -> u64:
    a: mutable u64 = left
    b: mutable u64 = right
    while b != 0:
        remainder: u64 = a % b
        a <- b
        b <- remainder
    a

def dlm_ceil_sqrt(value: u64) -> u64:
    low: mutable u64 = 1
    high: mutable u64 = 31623
    while low < high:
        middle: u64 = low + (high - low) / 2
        if middle * middle >= value:
            high <- middle
        else:
            low <- middle + 1
    low

def dlm_pow_mod(initial_base: u64, initial_exponent: u64, modulus: u64) -> u64:
    base: mutable u64 = initial_base
    exponent: mutable u64 = initial_exponent
    result: mutable u64 = 1 % modulus
    while exponent != 0:
        if (exponent & 1) != 0:
            result <- (result * base) % modulus
        base <- (base * base) % modulus
        exponent <- exponent >> 1
    result

def dlm_inverse(value: u64, modulus: u64) -> i64:
    old_remainder: mutable i64 = value.i64()
    remainder: mutable i64 = modulus.i64()
    old_coefficient: mutable i64 = 1
    coefficient: mutable i64 = 0
    while remainder != 0:
        quotient: i64 = old_remainder / remainder
        next_remainder: i64 = old_remainder - quotient * remainder
        next_coefficient: i64 = old_coefficient - quotient * coefficient
        old_remainder <- remainder
        remainder <- next_remainder
        old_coefficient <- coefficient
        coefficient <- next_coefficient
    if old_remainder != 1:
        return -1
    old_coefficient <- old_coefficient % modulus.i64()
    if old_coefficient < 0:
        old_coefficient <- old_coefficient + modulus.i64()
    old_coefficient

def dlm_insert_baby(keys: mutable view[u64], steps: mutable view[u32], key: u64, step: usize) -> void:
    slot: mutable usize = (key & TABLE_MASK.u64()).usize()
    while steps[slot] != 0:
        if keys[slot] == key:
            return
        slot <- (slot + 1) & TABLE_MASK
    keys[slot] <- key
    steps[slot] <- step.u32() + 1

def dlm_find_baby(keys: view[u64], steps: view[u32], key: u64) -> usize:
    slot: mutable usize = (key & TABLE_MASK.u64()).usize()
    while steps[slot] != 0:
        if keys[slot] == key:
            return (steps[slot] - 1).usize()
        slot <- (slot + 1) & TABLE_MASK
    TABLE_SIZE

def dlm_coprime_log(x: u64, y: u64, modulus: u64) -> i64:
    if y == 1 % modulus:
        return 0
    width: u64 = dlm_ceil_sqrt(modulus)
    keys: mutable InlineArray[u64, 65536] = zeroed
    steps: mutable InlineArray[u32, 65536] = zeroed
    residue: mutable u64 = 1 % modulus
    step: mutable u64 = 0
    while step < width:
        dlm_insert_baby(keys[0:TABLE_SIZE], steps[0:TABLE_SIZE], residue, step.usize())
        residue <- (residue * x) % modulus
        step <- step + 1
    inverse: i64 = dlm_inverse(x, modulus)
    if inverse < 0:
        return -1
    giant_factor: u64 = dlm_pow_mod(inverse.u64(), width, modulus)
    giant: mutable u64 = y
    block: mutable u64 = 0
    while block * width <= modulus:
        baby: usize = dlm_find_baby(keys[0:TABLE_SIZE], steps[0:TABLE_SIZE], giant)
        if baby != TABLE_SIZE:
            answer: u64 = block * width + baby.u64()
            if answer <= modulus:
                return answer.i64()
            return -1
        giant <- (giant * giant_factor) % modulus
        block <- block + 1
    -1

def dlm_extended_log(x: u64, initial_y: u64, initial_modulus: u64) -> i64:
    y: mutable u64 = initial_y
    modulus: mutable u64 = initial_modulus
    if modulus == 1:
        return 0
    accumulator: mutable u64 = 1
    added: mutable u64 = 0
    while dlm_gcd(x, modulus) > 1:
        divisor: u64 = dlm_gcd(x, modulus)
        if y == accumulator:
            return added.i64()
        if y % divisor != 0:
            return -1
        y <- y / divisor
        modulus <- modulus / divisor
        accumulator <- (accumulator * (x / divisor)) % modulus
        added <- added + 1
        if modulus == 1:
            return added.i64()
    inverse: i64 = dlm_inverse(accumulator, modulus)
    if inverse < 0:
        return -1
    target: u64 = (y * inverse.u64()) % modulus
    remaining: i64 = dlm_coprime_log(x % modulus, target, modulus)
    if remaining < 0:
        return -1
    added.i64() + remaining

def discrete_logarithm_mod_impl(values: i64&, length: usize) -> i64:
    if length != 3:
        return -1
    if values[0] < 0 or values[1] < 0 or values[2] < 1 or values[2].u64() > MAX_MODULUS or
        values[0] >= values[2] or values[1] >= values[2]:
        return -1
    dlm_extended_log(values[0].u64(), values[1].u64(), values[2].u64())

export fn discrete_logarithm_mod(values: i64&, length: usize) -> i64 = discrete_logarithm_mod_impl
