# Iterative reachability search in a bounded undirected graph.
def depth_first_search_iterative_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4 or length > 518: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    source_value: i64 = input[2]
    target_value: i64 = input[3]
    if n_value < 1 or n_value > 64 or m_value < 0 or m_value > 256: return -1
    if source_value < 0 or source_value >= n_value: return -1
    m: usize = m_value.usize()
    if length != 4 + 2 * m: return -1
    for edge in 0..<m:
        left: i64 = input[4 + 2 * edge]
        right: i64 = input[5 + 2 * edge]
        if left < 0 or left >= n_value or right < 0 or right >= n_value: return -1
    visited: mutable bool[64] = zeroed
    pending: mutable usize[64] = zeroed
    top: mutable usize = 1
    source: usize = source_value.usize()
    pending[0] <- source
    visited[source] <- true
    while top > 0:
        top <- top - 1
        current: usize = pending[top]
        if current.i64() == target_value: return 1
        for edge in 0..<m:
            left: i64 = input[4 + 2 * edge]
            right: i64 = input[5 + 2 * edge]
            neighbor: i64 = -1
            if left == current.i64(): neighbor <- right
            elif right == current.i64(): neighbor <- left
            if neighbor >= 0:
                neighbor_index: usize = neighbor.usize()
                if not visited[neighbor_index]:
                    visited[neighbor_index] <- true
                    pending[top] <- neighbor_index
                    top <- top + 1
    0
export fn depth_first_search_iterative(input: i64&, length: usize) -> i64 = depth_first_search_iterative_impl
