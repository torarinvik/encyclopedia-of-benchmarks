def mix_hash(h0: u64, x0: u64) -> u64:
    h: mutable u64 = h0
    x: mutable u64 = x0
    b: mutable usize = 0
    while b < 8:
        h <- (h ^ (x & 255)) * 1099511628211
        x <- x >> 8
        b <- b + 1
    h

def deep_clone_graph_impl(a: i64&, length: usize) -> i64:
    if a.is_null() or length < 4 or length > 34:
        return -1
    n64: i64 = a[0]
    root64: i64 = a[1]
    if n64 < 1 or n64 > 16 or root64 < 0 or root64 >= n64 or length != (2 + 2 * n64).usize():
        return -1
    n: usize = n64.usize()
    root: usize = root64.usize()
    labels: mutable i64[16] = zeroed
    masks: mutable u64[16] = zeroed
    copied: mutable u64[16] = zeroed
    seen: mutable bool[16] = zeroed
    node_stack: mutable usize[256] = zeroed
    i: mutable usize = 0
    while i < n:
        value: i64 = a[2 + i]
        row: i64 = a[2 + n + i]
        if value < -2147483648 or value > 2147483647 or row < 0 or (row.u64() >> n) != 0:
            return -1
        labels[i] <- value
        masks[i] <- row.u64()
        i <- i + 1
    i <- 0
    while i < n:
        j: mutable usize = 0
        while j < n:
            if ((masks[i] >> j) & 1) != ((masks[j] >> i) & 1):
                return -1
            j <- j + 1
        i <- i + 1
    top: mutable usize = 1
    node_stack[0] <- root
    count: mutable u64 = 0
    while top > 0:
        top <- top - 1
        u: usize = node_stack[top]
        if not seen[u]:
            seen[u] <- true
            count <- count + 1
            copied[u] <- masks[u]
            v: mutable usize = 0
            while v < n:
                if ((masks[u] >> v) & 1) != 0 and not seen[v]:
                    node_stack[top] <- v
                    top <- top + 1
                v <- v + 1
    h: u64 = mix_hash(14695981039346656037, count)
    h <- mix_hash(h, root64.u64())
    i <- 0
    while i < n:
        if seen[i]:
            h <- mix_hash(h, labels[i].u64())
            h <- mix_hash(h, copied[i])
        i <- i + 1
    h.i64()

export fn deep_clone_graph(a: i64&, length: usize) -> i64 = deep_clone_graph_impl
