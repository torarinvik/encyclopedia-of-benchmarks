const MAX_N: usize=8
const MAX_INPUT: usize=75

def put64(value:i64,output:mutable u8&,pos:usize)->void:
    bits:u64=value.u64()
    j:mutable usize=0
    while j<8:
        output[pos+j]<-((bits>>(8*j))&255).u8()
        j<-j+1

def radio_network_decay_phase(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("radio_network_decay_phase"):
    if input.is_null() or length<3 or length>MAX_INPUT:return -1
    n64:i64=input[0]; k64:i64=input[1]; initial:i64=input[2]
    if n64<2 or n64>8 or k64<1 or k64>8 or length!=3+n64.usize()+n64.usize()*k64.usize():return -1
    n:usize=n64.usize(); k:usize=k64.usize(); full:u64=(1.u64<<n)-1
    if initial<=0 or (initial.u64()&~full)!=0:return -1
    adjacency:mutable u64[8]=zeroed
    v:mutable usize=0
    while v<n:
        raw:i64=input[3+v]
        if raw<0 or (raw.u64()&~full)!=0 or (raw.u64()&(1.u64<<v))!=0:return -1
        adjacency[v]<-raw.u64(); v<-v+1
    u:mutable usize=0
    while u<n:
        v<-0
        while v<n:
            if ((adjacency[u]>>v)&1)!=((adjacency[v]>>u)&1):return -1
            v<-v+1
        u<-u+1
    tape_at:usize=3+n
    i:mutable usize=0
    while i<n*k:
        bit:i64=input[tape_at+i]
        if bit!=0 and bit!=1:return -1
        i<-i+1
    if output.is_null() or capacity<16:return -2
    active:mutable bool[8]=zeroed
    v<-0
    while v<n:
        active[v]<-((initial.u64()>>v)&1)!=0
        v<-v+1
    newly:mutable u64=0
    transmissions:mutable i64=0
    slot:mutable usize=0
    while slot<k:
        u<-0
        while u<n:
            if active[u]:transmissions<-transmissions+1
            u<-u+1
        v<-0
        while v<n:
            if ((initial.u64()>>v)&1)==0:
                count:mutable usize=0
                u<-0
                while u<n:
                    if active[u] and ((adjacency[u]>>v)&1)!=0:count<-count+1
                    u<-u+1
                if count==1:newly<-newly|(1.u64<<v)
            v<-v+1
        u<-0
        while u<n:
            if active[u] and (input[tape_at+u*k+slot]==0 or slot+1==k):active[u]<-false
            u<-u+1
        slot<-slot+1
    put64(newly.i64(),output&,0); put64(transmissions,output&,8)
    16
