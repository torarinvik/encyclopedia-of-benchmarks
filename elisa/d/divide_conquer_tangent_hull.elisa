def dcth_cross(values: view[i64], a: usize, b: usize, c: usize) -> i64:
    ax: i64 = values[1 + 2 * a]
    ay: i64 = values[2 + 2 * a]
    (values[1 + 2 * b] - ax) * (values[2 + 2 * c] - ay) - (values[2 + 2 * b] - ay) * (values[1 + 2 * c] - ax)

def dcth_chain(values: view[i64], order: view[usize], output: mutable view[usize],
        lo: usize, hi: usize, base: usize, upper: bool) -> usize:
    if hi - lo == 1:
        output[base] <- order[lo]
        return 1
    middle: usize = lo + (hi - lo) / 2
    left_capacity: usize = middle - lo
    left_count: usize = dcth_chain(values, order, output, lo, middle, base, upper)
    right_count: usize = dcth_chain(values, order, output, middle, hi, base + left_capacity, upper)
    i: mutable usize = left_count - 1
    j: mutable usize = 0
    changed: mutable bool = true
    while changed:
        changed <- false
        while i > 0:
            sign: i64 = dcth_cross(values, output[base + i], output[base + left_capacity + j], output[base + i - 1])
            if (upper and sign <= 0) or (not upper and sign >= 0): break
            i <- i - 1
            changed <- true
        while j + 1 < right_count:
            sign: i64 = dcth_cross(values, output[base + i], output[base + left_capacity + j], output[base + left_capacity + j + 1])
            if (upper and sign <= 0) or (not upper and sign >= 0): break
            j <- j + 1
            changed <- true
    suffix: usize = right_count - j
    for k in 0..<suffix: output[base + i + 1 + k] <- output[base + left_capacity + j + k]
    i + 1 + suffix

def divide_conquer_tangent_hull_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 7 or length > 66: return -1
    values: view[i64] = input[0:length]
    raw: i64 = values[0]
    if raw < 3 or raw > 32: return -1
    n: usize = raw.usize()
    if length != 1 + 2 * n: return -1
    for i in 0..<n:
        x: i64 = values[1 + 2 * i]
        y: i64 = values[2 + 2 * i]
        if x < -1000 or x > 1000 or y < -1000 or y > 1000: return -1
        for j in 0..<i:
            if x == values[1 + 2 * j]: return -1
    for i in 0..<n:
        for j in (i + 1)..<n:
            for k in (j + 1)..<n:
                if dcth_cross(values, i, j, k) == 0: return -1
    order: mutable usize[32] = zeroed
    scratch: mutable usize[32] = zeroed
    for i in 0..<n: order[i] <- i
    width: mutable usize = 1
    while width < n:
        begin: mutable usize = 0
        while begin < n:
            middle: mutable usize = begin + width
            if middle > n: middle <- n
            finish: mutable usize = begin + 2 * width
            if finish > n: finish <- n
            left: mutable usize = begin
            right: mutable usize = middle
            dest: mutable usize = begin
            while left < middle and right < finish:
                if values[1 + 2 * order[right]] < values[1 + 2 * order[left]]:
                    scratch[dest] <- order[right]
                    right <- right + 1
                else:
                    scratch[dest] <- order[left]
                    left <- left + 1
                dest <- dest + 1
            while left < middle:
                scratch[dest] <- order[left]
                left <- left + 1
                dest <- dest + 1
            while right < finish:
                scratch[dest] <- order[right]
                right <- right + 1
                dest <- dest + 1
            begin <- begin + 2 * width
        for i in 0..<n: order[i] <- scratch[i]
        width <- width * 2
    lower: mutable usize[32] = zeroed
    upper: mutable usize[32] = zeroed
    lower_count: usize = dcth_chain(values, order[0:n], lower[0:n], 0, n, 0, false)
    upper_count: usize = dcth_chain(values, order[0:n], upper[0:n], 0, n, 0, true)
    hull: mutable usize[32] = zeroed
    count: mutable usize = 0
    for i in 0..<lower_count:
        hull[count] <- lower[i]
        count <- count + 1
    i: mutable usize = upper_count - 1
    while i > 1:
        i <- i - 1
        hull[count] <- upper[i]
        count <- count + 1
    bytes: usize = 16 * count
    if output.is_null() or capacity < bytes: return -2
    target: mutable view[u8] = output[0:bytes]
    for index in 0..<count:
        for axis in 0..<2:
            bits: mutable u64 = values[1 + 2 * hull[index] + axis].u64()
            for b in 0..<8:
                target[16 * index + 8 * axis + b] <- (bits & 255).u8()
                bits <- bits >> 8
    bytes.i64()

export fn divide_conquer_tangent_hull(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = divide_conquer_tangent_hull_impl
