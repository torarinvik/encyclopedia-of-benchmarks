def directed_perfect_phylogeny_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > 146:
        return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    if n0 < 1 or n0 > 12 or m0 < 1 or m0 > 12 or length != 2 + (n0 * m0).usize():
        return -1
    n: usize = n0.usize()
    m: usize = m0.usize()
    sets: mutable u16[12] = zeroed
    for row in 0..<n:
        for col in 0..<m:
            bit: i64 = input[2 + row * m + col]
            if bit != 0 and bit != 1:
                return -1
            if bit == 1:
                sets[col] <- sets[col] | (1.u16() << row)
    feasible: mutable bool = true
    for a in 0..<m:
        for b in a + 1..<m:
            overlap: u16 = sets[a] & sets[b]
            if overlap != 0 and overlap != sets[a] and overlap != sets[b]:
                feasible <- false
    if output == null or capacity < 8:
        return -2
    result: i64 = 0
    if feasible:
        result <- 1
    bits: u64 = result.u64()
    for byte in 0..<8:
        output[byte] <- (bits >> (byte * 8)).u8()
    8

export fn directed_perfect_phylogeny(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = directed_perfect_phylogeny_impl
