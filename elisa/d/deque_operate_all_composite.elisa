# Segment-tree aggregate deque for ordered affine composition.
const MAX_OPERATIONS: usize = 64
const MAX_INPUT_LENGTH: usize = 193
const TREE_BASE: usize = 128
const TREE_NODES: usize = 256
const MODULUS: i64 = 998244353

struct Affine:
    a: i64
    b: i64

def identity() -> Affine:
    result: Affine
    result.a <- 1
    result.b <- 0
    result

def compose(first: Affine, second: Affine) -> Affine:
    result: Affine
    result.a <- (second.a * first.a) % MODULUS
    result.b <- (second.a * first.b + second.b) % MODULUS
    result

def update(tree: mutable view[Affine], position: usize, value: Affine) -> void:
    node: mutable usize = TREE_BASE + position
    tree[node] <- value
    while node > 1 |node, tree|:
        node <- node / 2
        tree[node] <- compose(tree[node * 2], tree[node * 2 + 1])

def deque_operate_all_composite_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_INPUT_LENGTH: return -1
    operation_value: i64 = input[0]
    if operation_value < 0 or operation_value > 64: return -1
    operation_count: usize = operation_value.usize()

    tree: mutable Affine[TREE_NODES] = zeroed
    for node in 0..<TREE_NODES:
        tree[node] <- identity()
    head: mutable usize = 64
    tail: mutable usize = 64
    position: mutable usize = 1
    checksum: mutable i64 = 0
    query_number: mutable i64 = 0

    for operation in 0..<operation_count:
        if position >= length: return -1
        opcode: i64 = input[position]
        position <- position + 1
        if opcode == 0 or opcode == 1:
            if length - position < 2: return -1
            a: i64 = input[position]
            b: i64 = input[position + 1]
            position <- position + 2
            if a < 1 or a >= MODULUS or b < 0 or b >= MODULUS: return -1
            function: Affine
            function.a <- a
            function.b <- b
            if opcode == 0:
                if head == 0: return -1
                head <- head - 1
                update(tree[0:TREE_NODES], head, function)
            else:
                if tail == TREE_BASE: return -1
                update(tree[0:TREE_NODES], tail, function)
                tail <- tail + 1
        else if opcode == 2 or opcode == 3:
            if head == tail: return -1
            if opcode == 2:
                update(tree[0:TREE_NODES], head, identity())
                head <- head + 1
            else:
                tail <- tail - 1
                update(tree[0:TREE_NODES], tail, identity())
        else if opcode == 4:
            if position >= length: return -1
            x: i64 = input[position]
            position <- position + 1
            if x < 0 or x >= MODULUS: return -1
            answer: i64 = (tree[1].a * x + tree[1].b) % MODULUS
            query_number <- query_number + 1
            checksum <- checksum + query_number * (answer + 1)
        else:
            return -1
    if position != length: return -1
    checksum

export fn deque_operate_all_composite(input: i64&, length: usize) -> i64 = deque_operate_all_composite_impl
