# Return the largest signed value in a nonempty array.
def find_max_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 512:
        return -1
    result: i64 =
        while index < length |index: mutable usize = 1, best: mutable i64 = values[0]| -> best:
            if values[index] > best:
                best <- values[index]
            index <- index + 1
    result

export fn find_max(values: i64&, length: usize) -> i64 = find_max_impl
