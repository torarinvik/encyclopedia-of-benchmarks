extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def store_f64_le(output: mutable view[u8], position: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for byte in 0..<8:
        output[position + byte] <- (bits & 255.u64()).u8()
        bits <- bits >> 8

def full_wave_rectifier_impl(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if values.is_null() or length != 5:
        return -1
    rf_i: i64 = values[0]
    rs_i: i64 = values[1]
    rl_i: i64 = values[2]
    vm_i: i64 = values[3]
    im_i: i64 = values[4]
    if rf_i < 0 or rf_i > 1000000 or rs_i < 0 or rs_i > 1000000 or
            rl_i < 1 or rl_i > 1000000 or vm_i < -1000000 or vm_i > 1000000 or
            im_i < -1000000 or im_i > 1000000:
        return -1
    if output.is_null() or output_capacity < 48:
        return -2

    rf: f64 = rf_i.f64()
    rs: f64 = rs_i.f64()
    rl: f64 = rl_i.f64()
    vm: f64 = vm_i.f64()
    im: f64 = im_i.f64()
    store_f64_le(output[0:48], 0, vm / (rf + rs + rl))
    store_f64_le(output[0:48], 8, 2.0 * im * 0.318)
    store_f64_le(output[0:48], 16, 2.0 * 0.318 * vm)
    store_f64_le(output[0:48], 24, vm / rl)
    store_f64_le(output[0:48], 32, im * 0.707)
    store_f64_le(output[0:48], 40, vm * 0.707)
    48.i64()

export fn full_wave_rectifier(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = full_wave_rectifier_impl
