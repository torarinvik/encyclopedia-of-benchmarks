def conditional_reduction_put_u64(output: mutable u8&, word: usize, value: u64) -> void:
    for byte in 0..<8:
        output[word * 8 + byte] <- (value >> (byte * 8)).u8()

def frequent_itemset_conditional_db_reduction_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 6 or length > 69:
        return -1
    n0: i64 = input[0]
    rows0: i64 = input[1]
    minimum: i64 = input[2]
    tail: i64 = input[3]
    prefix0: i64 = input[4]
    if n0 < 1 or n0 > 8 or rows0 < 1 or rows0 > 64 or minimum < 1 or minimum > rows0 or length != (5 + rows0).usize():
        return -1
    if tail < -1 or tail >= n0 or prefix0 < 0:
        return -1
    n: usize = n0.usize()
    row_count: usize = rows0.usize()
    limit: u64 = 1.u64() << n
    prefix: u64 = prefix0.u64()
    if prefix >= limit or (tail == -1 and prefix != 0.u64()) or (tail >= 0 and (((prefix >> tail.usize()) & 1.u64()) == 0.u64 or (prefix >> (tail.usize() + 1)) != 0.u64)):
        return -1
    selected: mutable u64[64] = zeroed
    support: mutable u64[8] = zeroed
    selected_count: mutable usize = 0
    for row in 0..<row_count:
        row0: i64 = input[5 + row]
        if row0 < 0 or row0.u64() >= limit:
            return -1
        mask: u64 = row0.u64()
        if (mask & prefix) != prefix:
            continue
        selected[selected_count] <- mask
        selected_count <- selected_count + 1
        for item in (tail + 1).usize()..<n:
            if (mask & (1.u64() << item)) != 0.u64:
                support[item] <- support[item] + 1.u64
    if selected_count < minimum.usize():
        return -1
    keep: mutable u64 = if tail >= 0: 1.u64() << tail.usize() else: 0.u64
    for item in (tail + 1).usize()..<n:
        if support[item] >= minimum.u64():
            keep <- keep | (1.u64() << item)
    below: u64 = if tail > 0: (1.u64() << tail.usize()) - 1.u64() else: 0.u64()
    masks: mutable u64[64] = zeroed
    counts: mutable u64[64] = zeroed
    distinct: mutable usize = 0
    for row in 0..<selected_count:
        reduced: u64 = selected[row] & ~below & keep
        at: mutable usize = 0
        while at < distinct and masks[at] != reduced:
            at <- at + 1
        if at == distinct:
            masks[distinct] <- reduced
            distinct <- distinct + 1
        counts[at] <- counts[at] + 1.u64()
    for i in 1..<distinct:
        saved_mask: mutable u64 = masks[i]
        saved_count: mutable u64 = counts[i]
        j: mutable usize = i
        while j > 0 and masks[j - 1] > saved_mask:
            masks[j] <- masks[j - 1]
            counts[j] <- counts[j - 1]
            j <- j - 1
        masks[j] <- saved_mask
        counts[j] <- saved_count
    word_count: usize = 1 + 2 * distinct
    bytes: usize = 8 * word_count
    if bytes > 1032:
        return -1
    if output == null or capacity < bytes:
        return -2
    conditional_reduction_put_u64(output, 0, distinct.u64())
    for i in 0..<distinct:
        conditional_reduction_put_u64(output, 1 + 2 * i, masks[i])
        conditional_reduction_put_u64(output, 2 + 2 * i, counts[i])
    bytes.i64()

export fn frequent_itemset_conditional_db_reduction(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = frequent_itemset_conditional_db_reduction_impl
