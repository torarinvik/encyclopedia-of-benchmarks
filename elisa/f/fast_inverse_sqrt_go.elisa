@link_name("llvm.fma.f32")
extern multiply_round(a: f32, b: f32, addend: f32) -> f32

@link_name("llvm.memcpy.p0.p0.i64")
extern copy_seed_bits(destination: mutable u32&, source: f32&, bytes: usize, is_volatile: bool) -> void
@link_name("llvm.memcpy.inline.p0.p0.i64")
extern copy_seed_value(destination: mutable f32&, source: u32&, bytes: usize, is_volatile: bool) -> void

def newton_step(x2: f32, y: f32) -> f32:
    product1: f32 = x2 * y
    # The zero addend rounds the product to binary32 before the subtraction.
    product2: f32 = multiply_round(product1, y, 0.0.f32())
    correction: f32 = 1.5.f32() - product2
    y * correction

@inline(never)
def inverse_root_refinement(value: f64) -> f64:
    number: f32 = value.f32()
    x2: f32 = number * 0.5.f32()
    bits: mutable u32 = 0
    copy_seed_bits(&bits, &number, 4, false)
    seed_bits: u32 = 0x5f3759df - (bits >> 1)
    inverse_root: mutable f32 = 0.0
    copy_seed_value(&inverse_root, &seed_bits, 4, false)
    inverse_root <- newton_step(x2, inverse_root)
    inverse_root <- newton_step(x2, inverse_root)
    inverse_root.f64()

def fast_inverse_sqrt_go_impl(value: f64) -> f64:
    if not (value >= 1e-6 and value <= 1e6): return -1.0
    inverse_root_refinement(value)

export fn fast_inverse_sqrt_go(value: f64) -> f64 = fast_inverse_sqrt_go_impl
