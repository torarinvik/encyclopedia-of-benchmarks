# Iterative factorial for the shared signed 64-bit benchmark contract.
def factorial_impl(n: i64) -> i64:
    if n < 0 or n > 20:
        return -1
    while factor <= n |factor: i64 = 2, product: i64 = 1| -> product:
        product <- product * factor
        factor <- factor + 1

export fn factorial(n: i64) -> i64 = factorial_impl
