# Iterative Fibonacci for the shared signed 64-bit benchmark contract.
def fibonacci_impl(n: i64) -> i64:
    if n < 0 or n > 92:
        return -1
    if n == 0:
        return 0
    while index < n |index: i64 = 1, previous: i64 = 0, current: i64 = 1| -> current:
        next: i64 = previous + current
        previous <- current
        current <- next
        index <- index + 1

export fn fibonacci(n: i64) -> i64 = fibonacci_impl
