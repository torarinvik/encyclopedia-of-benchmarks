# Iterative Fibonacci for the shared signed 64-bit benchmark contract.
def fibonacci_impl(n: i64) -> i64:
    if n < 0 or n > 92:
        return -1
    if n == 0:
        return 0
    index: mutable i64 = 1
    previous: mutable i64 = 0
    current: mutable i64 = 1
    while index + 1 < n:
        next: i64 = previous + current
        current <- next + current
        previous <- next
        index <- index + 2
    if index < n:
        current <- previous + current
    current

export fn fibonacci(n: i64) -> i64 = fibonacci_impl
