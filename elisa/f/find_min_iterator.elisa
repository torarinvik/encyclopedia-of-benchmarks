def find_min_iterator_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > 129: return -1
    if input[0] < 0 or input[0] > 128 or length != input[0].usize() + 1: return -1
    count: usize = input[0].usize()
    if count == 0: return -1
    minimum: mutable i64 = 2147483647
    for i in 0..<count:
        value: i64 = input[i + 1]
        if value < 0 or value > 2147483647: return -1
        if value < minimum: minimum <- value
    minimum

export fn find_min_iterator(input: i64&, length: usize) -> i64 = find_min_iterator_impl
