def fizz_buzz_token_length(value: i64) -> usize:
    if value % 15 == 0:
        return 8.usize()
    if value % 3 == 0 or value % 5 == 0:
        return 4.usize()
    if value >= 100:
        return 3.usize()
    if value >= 10:
        return 2.usize()
    return 1.usize()

def fizz_buzz_append_number(value_value: i64, output: mutable u8&, position_value: usize) -> usize:
    value: mutable i64 = value_value
    position: mutable usize = position_value
    if value >= 100:
        output[position] <- (48 + value / 100).u8()
        position <- position + 1
        value <- value % 100
        output[position] <- (48 + value / 10).u8()
        position <- position + 1
        output[position] <- (48 + value % 10).u8()
        position <- position + 1
    else if value >= 10:
        output[position] <- (48 + value / 10).u8()
        position <- position + 1
        output[position] <- (48 + value % 10).u8()
        position <- position + 1
    else:
        output[position] <- (48 + value).u8()
        position <- position + 1
    position

def fizz_buzz_impl(value: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if value < 1 or value > 512:
        return -1
    width: mutable usize = 0
    current: mutable i64 = 1
    while current <= value:
        width <- width + fizz_buzz_token_length(current) + 1.usize()
        current <- current + 1
    if output == null or output_capacity < width:
        return -2
    position: mutable usize = 0
    current <- 1
    while current <= value:
        if current % 15 == 0:
            output[position] <- 70.u8(); output[position + 1] <- 105.u8(); output[position + 2] <- 122.u8(); output[position + 3] <- 122.u8()
            output[position + 4] <- 66.u8(); output[position + 5] <- 117.u8(); output[position + 6] <- 122.u8(); output[position + 7] <- 122.u8()
            position <- position + 8
        else if current % 3 == 0:
            output[position] <- 70.u8(); output[position + 1] <- 105.u8(); output[position + 2] <- 122.u8(); output[position + 3] <- 122.u8()
            position <- position + 4
        else if current % 5 == 0:
            output[position] <- 66.u8(); output[position + 1] <- 117.u8(); output[position + 2] <- 122.u8(); output[position + 3] <- 122.u8()
            position <- position + 4
        else:
            position <- fizz_buzz_append_number(current, output, position)
        output[position] <- 32.u8()
        position <- position + 1
        current <- current + 1
    position.i64()

export fn fizz_buzz(value: i64, output: mutable u8&, output_capacity: usize) -> i64 = fizz_buzz_impl
