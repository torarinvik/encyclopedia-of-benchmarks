def fibonacci_matrix_impl(index: i64) -> i64:
    if index < 0 or index > 92:
        return -1
    if index == 0:
        return 0
    r00: mutable i64 = 1
    r01: mutable i64 = 0
    r10: mutable i64 = 0
    r11: mutable i64 = 1
    b00: mutable i64 = 1
    b01: mutable i64 = 1
    b10: mutable i64 = 1
    b11: mutable i64 = 0
    exponent: mutable i64 = index - 1
    while exponent > 0:
        if exponent % 2 == 1:
            n00: i64 = r00 * b00 + r01 * b10
            n01: i64 = r00 * b01 + r01 * b11
            n10: i64 = r10 * b00 + r11 * b10
            n11: i64 = r10 * b01 + r11 * b11
            r00 <- n00
            r01 <- n01
            r10 <- n10
            r11 <- n11
            exponent <- exponent - 1
        else:
            n00: i64 = b00 * b00 + b01 * b10
            n01: i64 = b00 * b01 + b01 * b11
            n10: i64 = b10 * b00 + b11 * b10
            n11: i64 = b10 * b01 + b11 * b11
            b00 <- n00
            b01 <- n01
            b10 <- n10
            b11 <- n11
            exponent <- exponent / 2
    r00

export fn fibonacci_matrix(index: i64) -> i64 = fibonacci_matrix_impl
