alias FORNBERG_MODULUS = Int64(998244353)
alias FORNBERG_MAX_NODES = 8
alias FORNBERG_MAX_INPUT = 12

fn fornberg_mod_norm(value: Int64) -> Int64:
    let reduced = value % FORNBERG_MODULUS
    if reduced < 0: reduced + FORNBERG_MODULUS else: reduced

fn fornberg_mod_pow(base_value: Int64, exponent_value: Int64) -> Int64:
    let base: mutable Int64 = base_value
    let exponent: mutable Int64 = exponent_value
    let result: mutable Int64 = 1
    while exponent > 0:
        if (exponent & 1) != 0: result <- result * base % FORNBERG_MODULUS
        base <- base * base % FORNBERG_MODULUS
        exponent <- exponent >> 1
    result

fn fornberg_store_i64_le(value: Int64, output: mutable view[u8], offset: Int) -> void:
    let bits: mutable UInt64 = value.bitcast[UInt64]()
    for byte in range(8):
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

fn fornberg_compute(input: view[i64], result_words: mutable view[i64]) -> Int64:
    let length: Int = input.len()
    if length < 4 or length > FORNBERG_MAX_INPUT: return -1
    let n_value: Int64 = input[0]
    let order: Int64 = input[1]
    let target: Int64 = input[2]
    if n_value < 1 or n_value > FORNBERG_MAX_NODES.i64() or order < 0 or order > 3
        or order >= n_value or length != n_value + 3: return -1
    let n: Int = n_value.int()
    if target < 0 or target >= FORNBERG_MODULUS: return -1
    for index in range(n):
        let node: Int64 = input[3 + index]
        if node < 0 or node >= FORNBERG_MODULUS: return -1
        for previous in range(index):
            if node == input[3 + previous]: return -1

    let table: mutable [8][4]i64 = [[0; 4]; 8]
    table[0][0] <- 1
    let previous_product: mutable Int64 = 1
    for new_index in range(1, n):
        let old_last: mutable [4]i64 = [0; 4]
        for derivative in range(4): old_last[derivative] <- table[new_index - 1][derivative]
        let product: mutable Int64 = 1
        let node: Int64 = input[3 + new_index]
        let factor: Int64 = fornberg_mod_norm(node - target)
        let max_derivative: Int = min(new_index, order.int())
        for old_index in range(new_index):
            let difference: Int64 = fornberg_mod_norm(node - input[3 + old_index])
            product <- product * difference % FORNBERG_MODULUS
            let inverse_difference: Int64 = fornberg_mod_pow(difference, FORNBERG_MODULUS - 2)
            let derivative: mutable Int = max_derivative
            while derivative >= 0:
                let lower: Int64 = if derivative == 0: 0 else: table[old_index][derivative - 1]
                let numerator: Int64 = fornberg_mod_norm(
                    factor * table[old_index][derivative] - derivative.i64() * lower)
                table[old_index][derivative] <- numerator * inverse_difference % FORNBERG_MODULUS
                derivative <- derivative - 1
        let product_inverse: Int64 = fornberg_mod_pow(product, FORNBERG_MODULUS - 2)
        let last_factor: Int64 = fornberg_mod_norm(input[2 + new_index] - target)
        for derivative in range(max_derivative + 1):
            let lower: Int64 = if derivative == 0: 0 else: old_last[derivative - 1]
            let numerator: Int64 = fornberg_mod_norm(
                derivative.i64() * lower - last_factor * old_last[derivative])
            table[new_index][derivative] <- previous_product * product_inverse
                % FORNBERG_MODULUS * numerator % FORNBERG_MODULUS
        previous_product <- product

    result_words[0] <- n_value
    for index in range(n): result_words[index + 1] <- table[index][order.int()]
    8 * (n + 1)

@export("fornberg_finite_difference_weights")
fn fornberg_finite_difference_weights(
    input: i64&, length: usize,
    output: mutable u8&, capacity: usize
) abi("C") -> Int64:
    if input.is_null() or length < 4
        or length > FORNBERG_MAX_INPUT: return -1
    let input_view: view[i64] = input[0:length]
    let result_words: mutable [9]i64 = [0; 9]
    let result_view: mutable view[i64] = result_words[0:9]
    let required: Int64 = fornberg_compute(input_view, result_view)
    if required < 0: return required
    if output.is_null() or capacity < required.usize(): return -2
    let output_view: mutable view[u8] = output[0:required.usize()]
    for index in range(result_words[0].int() + 1):
        fornberg_store_i64_le(result_words[index], output_view, 8 * index)
    required
