const FACTOR_MAX_N: usize = 8
const FACTOR_MAX_POLY: usize = 9
const FACTOR_MAX_FACTORS: usize = 8
const FACTOR_MAX_INPUT: usize = 12
const FACTOR_MAX_OUTPUT_BYTES: usize = 216

def factor_power_small(base: usize, exponent: usize) -> usize:
    value: mutable usize = 1
    for _ in 0..<exponent: value <- value * base
    value

def factor_monic_from_code(polynomial: mutable view[i64], degree: usize,
    code_input: usize, prime: usize) -> void:
    code: mutable usize = code_input
    for i in 0..<degree:
        polynomial[i] <- (code % prime).i64()
        code <- code / prime
    polynomial[degree] <- 1

def factor_exact_quotient(polynomial: view[i64], degree: usize,
    divisor: view[i64], divisor_degree: usize, prime: i64,
    quotient: mutable view[i64]) -> bool:
    if degree < divisor_degree: return false
    remainder: mutable i64[FACTOR_MAX_POLY] = zeroed
    for i in 0..=degree: remainder[i] <- polynomial[i]
    quotient_degree: usize = degree - divisor_degree
    for i in 0..<FACTOR_MAX_POLY: quotient[i] <- 0
    shift_plus_one: mutable usize = quotient_degree + 1
    while shift_plus_one > 0:
        shift: usize = shift_plus_one - 1
        factor: i64 = remainder[shift + divisor_degree]
        quotient[shift] <- factor
        for j in 0..=divisor_degree:
            value: mutable i64 = (remainder[shift + j] - factor * divisor[j]) % prime
            if value < 0: value <- value + prime
            remainder[shift + j] <- value
        shift_plus_one <- shift_plus_one - 1
    for i in 0..<divisor_degree:
        if remainder[i] != 0: return false
    true

def factor_is_irreducible(candidate: view[i64], degree: usize, prime: usize) -> bool:
    for divisor_degree in 1..=(degree / 2):
        limit: usize = factor_power_small(prime, divisor_degree)
        for code in 0..<limit:
            divisor: mutable i64[FACTOR_MAX_POLY] = zeroed
            quotient: mutable i64[FACTOR_MAX_POLY] = zeroed
            factor_monic_from_code(divisor[0:FACTOR_MAX_POLY], divisor_degree, code, prime)
            if factor_exact_quotient(candidate, degree, divisor[0:FACTOR_MAX_POLY],
                divisor_degree, prime.i64(), quotient[0:FACTOR_MAX_POLY]): return false
    true

def factor_swap(factors: mutable view[i64], degrees: mutable view[i64],
    multiplicities: mutable view[i64], left: usize, right: usize) -> void:
    for j in 0..<FACTOR_MAX_POLY:
        saved: i64 = factors[left * FACTOR_MAX_POLY + j]
        factors[left * FACTOR_MAX_POLY + j] <- factors[right * FACTOR_MAX_POLY + j]
        factors[right * FACTOR_MAX_POLY + j] <- saved
    saved_degree: i64 = degrees[left]
    degrees[left] <- degrees[right]
    degrees[right] <- saved_degree
    saved_multiplicity: i64 = multiplicities[left]
    multiplicities[left] <- multiplicities[right]
    multiplicities[right] <- saved_multiplicity

def factorize(coefficients: view[i64], degree: usize, prime: usize,
    factors: mutable view[i64], degrees: mutable view[i64],
    multiplicities: mutable view[i64]) -> usize:
    work: mutable i64[FACTOR_MAX_POLY] = zeroed
    for i in 0..=degree: work[i] <- coefficients[i]
    work_degree: mutable usize = degree
    factor_count: mutable usize = 0
    for candidate_degree in 1..=(degree / 2):
        limit: usize = factor_power_small(prime, candidate_degree)
        for code in 0..<limit:
            candidate: mutable i64[FACTOR_MAX_POLY] = zeroed
            factor_monic_from_code(candidate[0:FACTOR_MAX_POLY], candidate_degree, code, prime)
            if factor_is_irreducible(candidate[0:FACTOR_MAX_POLY], candidate_degree, prime):
                quotient: mutable i64[FACTOR_MAX_POLY] = zeroed
                multiplicity: mutable usize = 0
                while work_degree >= candidate_degree:
                    if not factor_exact_quotient(work[0:FACTOR_MAX_POLY], work_degree,
                        candidate[0:FACTOR_MAX_POLY], candidate_degree, prime.i64(),
                        quotient[0:FACTOR_MAX_POLY]): break
                    multiplicity <- multiplicity + 1
                    work_degree <- work_degree - candidate_degree
                    for i in 0..=work_degree: work[i] <- quotient[i]
                if multiplicity > 0:
                    for i in 0..=candidate_degree:
                        factors[factor_count * FACTOR_MAX_POLY + i] <- candidate[i]
                    degrees[factor_count] <- candidate_degree.i64()
                    multiplicities[factor_count] <- multiplicity.i64()
                    factor_count <- factor_count + 1
    if work_degree > 0:
        for i in 0..=work_degree: factors[factor_count * FACTOR_MAX_POLY + i] <- work[i]
        degrees[factor_count] <- work_degree.i64()
        multiplicities[factor_count] <- 1
        factor_count <- factor_count + 1
    for i in 0..<factor_count:
        for j in (i + 1)..<factor_count:
            left_degree: usize = degrees[i].usize()
            right_degree: usize = degrees[j].usize()
            after: mutable bool = left_degree > right_degree
            if left_degree == right_degree:
                for k in 0..=left_degree:
                    left: i64 = factors[i * FACTOR_MAX_POLY + k]
                    right: i64 = factors[j * FACTOR_MAX_POLY + k]
                    if left != right:
                        after <- left > right
                        break
            if after: factor_swap(factors, degrees, multiplicities, i, j)
    factor_count

def factor_store_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def factorization_of_polynomials_impl(input: view[i64], length: usize,
    output: mutable view[u8], capacity: usize, output_is_null: bool) -> i64:
    if length < 3 or length > FACTOR_MAX_INPUT: return -1
    degree_value: i64 = input[0]
    prime_value: i64 = input[1]
    if degree_value < 0 or degree_value > FACTOR_MAX_N.i64() or
        (prime_value != 2 and prime_value != 3 and prime_value != 5): return -1
    degree: usize = degree_value.usize()
    prime: usize = prime_value.usize()
    if length != degree + 3 or input[degree + 2] != 1: return -1
    for i in 0..=degree:
        if input[i + 2] < 0 or input[i + 2] >= prime_value: return -1

    factors: mutable i64[FACTOR_MAX_FACTORS * FACTOR_MAX_POLY] = zeroed
    degrees: mutable i64[FACTOR_MAX_FACTORS] = zeroed
    multiplicities: mutable i64[FACTOR_MAX_FACTORS] = zeroed
    factor_count: usize = factorize(input[2:length], degree, prime,
        factors[0:FACTOR_MAX_FACTORS * FACTOR_MAX_POLY],
        degrees[0:FACTOR_MAX_FACTORS], multiplicities[0:FACTOR_MAX_FACTORS])
    words: mutable usize = 1
    for i in 0..<factor_count: words <- words + degrees[i].usize() + 3
    output_bytes: usize = words * 8
    if output_bytes > FACTOR_MAX_OUTPUT_BYTES: return -1
    if output_is_null or capacity < output_bytes: return -2

    word: mutable usize = 0
    factor_store_le(factor_count.i64(), output, 8 * word)
    word <- word + 1
    for i in 0..<factor_count:
        factor_store_le(multiplicities[i], output, 8 * word)
        word <- word + 1
        factor_store_le(degrees[i], output, 8 * word)
        word <- word + 1
        for j in 0..=degrees[i].usize():
            factor_store_le(factors[i * FACTOR_MAX_POLY + j], output, 8 * word)
            word <- word + 1
    output_bytes.i64()

export fn factorization_of_polynomials(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > FACTOR_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return factorization_of_polynomials_impl(input_view, length, scratch[0:1], 0, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > FACTOR_MAX_OUTPUT_BYTES: safe_capacity <- FACTOR_MAX_OUTPUT_BYTES
    output_view: mutable view[u8] = output[0:safe_capacity]
    factorization_of_polynomials_impl(input_view, length, output_view, capacity, false)
