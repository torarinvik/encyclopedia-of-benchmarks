const MAX_NODE_COUNT: usize = 1023
const MAX_TREE_HEIGHT: usize = 512

def flatten_validate(nodes: view[i64], count: usize, index: i64, depth: usize,
        visited: mutable view[u8], seen: mutable usize&) -> bool:
    if index == -1: return true
    if index < 0 or index.u64() >= count.u64() or depth > MAX_TREE_HEIGHT: return false
    node: usize = index.usize()
    if visited[node] != 0: return false
    visited[node] <- 1.u8()
    seen <- seen + 1
    offset: usize = 3 * node
    value: i64 = nodes[offset]
    left: i64 = nodes[offset + 1]
    right: i64 = nodes[offset + 2]
    if value < -2147483648 or value > 2147483647 or left < -1 or right < -1 or
            (left >= 0 and left.u64() >= count.u64()) or
            (right >= 0 and right.u64() >= count.u64()): return false
    flatten_validate(nodes, count, left, depth + 1, visited, seen) and
        flatten_validate(nodes, count, right, depth + 1, visited, seen)

def flatten_in_place(nodes: mutable view[i64], index: i64) -> void:
    if index == -1: return
    offset: usize = 3 * index.usize()
    left: i64 = nodes[offset + 1]
    flatten_in_place(nodes, left)
    original_right: i64 = nodes[offset + 2]
    nodes[offset + 2] <- left
    nodes[offset + 1] <- -1
    tail: mutable i64 = index
    while nodes[3 * tail.usize() + 2] != -1:
        tail <- nodes[3 * tail.usize() + 2]
    nodes[3 * tail.usize() + 2] <- original_right
    flatten_in_place(nodes, original_right)

def flatten_store_i64(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- (bits % 256.u64()).u8()
        bits <- bits / 256.u64()
        byte <- byte + 1

def flatten_binarytree_to_linkedlist(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or (length - 1) % 3 != 0 or length > 1 + 3 * MAX_NODE_COUNT: return -1
    count: usize = (length - 1) / 3
    root: i64 = values[0]
    if count == 0: return if root == -1: 0 else: -1
    if root < 0 or root.u64() >= count.u64(): return -1
    nodes: mutable i64[3 * MAX_NODE_COUNT] = zeroed
    visited: mutable u8[MAX_NODE_COUNT] = zeroed
    i: mutable usize = 0
    while i < 3 * count:
        nodes[i] <- values[i + 1]
        i <- i + 1
    seen: mutable usize = 0
    if not flatten_validate(nodes[0:3 * count], count, root, 1,
            visited[0:MAX_NODE_COUNT], seen) or seen != count: return -1
    required: usize = 24 * count
    if output_capacity < required: return -2
    flatten_in_place(nodes[0:3 * count], root)
    i <- 0
    while i < count:
        flatten_store_i64(nodes[3 * i], output[0:output_capacity], 24 * i)
        flatten_store_i64(nodes[3 * i + 1], output[0:output_capacity], 24 * i + 8)
        flatten_store_i64(nodes[3 * i + 2], output[0:output_capacity], 24 * i + 16)
        i <- i + 1
    count.i64()

export fn flatten_binarytree_to_linkedlist(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = flatten_binarytree_to_linkedlist
