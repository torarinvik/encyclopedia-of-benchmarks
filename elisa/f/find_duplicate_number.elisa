# Find the cycle entrance induced by the duplicate value.
def find_duplicate_number_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 100001:
        return -1
    maximum_value: usize = length - 1
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < 1:
            return -1
        if value.usize() > maximum_value:
            return -1
        index <- index + 1

    slow: mutable usize = values[0].usize()
    fast: mutable usize = slow
    slow <- values[slow].usize()
    fast <- values[values[fast].usize()].usize()
    while slow != fast:
        slow <- values[slow].usize()
        fast <- values[values[fast].usize()].usize()

    slow <- values[0].usize()
    while slow != fast:
        slow <- values[slow].usize()
        fast <- values[fast].usize()
    slow.i64()

export fn find_duplicate_number(values: i64&, length: usize) -> i64 = find_duplicate_number_impl
