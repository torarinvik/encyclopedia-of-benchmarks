# Return vertices with no outgoing neighbors, in ascending vertex order.
def find_isolated_nodes_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if length < 1 or length > 65 or (length - 1) % 2 != 0:
        return -2
    vertices_value: i64 = values[0]
    if vertices_value < 0 or vertices_value > 64:
        return -2
    vertices: usize = vertices_value.usize()
    adjacency: mutable u64[64] = zeroed
    edge_count: usize = (length - 1) / 2
    edge: mutable usize = 0
    while edge < edge_count:
        origin_value: i64 = values[1 + 2 * edge]
        destination_value: i64 = values[2 + 2 * edge]
        if origin_value < 0 or destination_value < 0:
            return -2
        if origin_value.u64() >= vertices.u64() or destination_value.u64() >= vertices.u64():
            return -2
        origin: usize = origin_value.usize()
        destination: usize = destination_value.usize()
        adjacency[origin] <- adjacency[origin] | (1.u64() << destination)
        edge <- edge + 1
    isolated: mutable u8[64] = zeroed
    count: mutable usize = 0
    vertex: mutable usize = 0
    while vertex < vertices:
        if adjacency[vertex] == 0:
            isolated[count] <- vertex.u8()
            count <- count + 1
        vertex <- vertex + 1
    if output_capacity < count:
        return -2
    index: mutable usize = 0
    while index < count:
        output[index] <- isolated[index]
        index <- index + 1
    count.i64()

export fn find_isolated_nodes(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = find_isolated_nodes_impl
