from std.collections import InlineArray
from std.ffi import c_size_t

const MAX_CELLS: usize = 64
const MAX_INPUT: usize = 1095

def forest_fire_put_word(output: mutable view[u8], word: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[word * 8 + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def forest_fire_impl(input: view[i64], output: mutable u8&, capacity: usize) -> i64:
    length: usize = input.len()
    if length < 6 or length > MAX_INPUT: return -1
    if input[0] < 1 or input[0] > 8 or input[1] < 1 or input[1] > 8 or
        input[2] < 0 or input[2] > 8 or input[3] != 10000 or
        input[4] < 0 or input[4] > 10000 or input[5] < 0 or input[5] > 10000: return -1
    rows: usize = input[0].usize()
    cols: usize = input[1].usize()
    steps: usize = input[2].usize()
    cells: usize = rows * cols
    if length != 6 + cells + 2 * steps * cells: return -1
    i: mutable usize = 0
    while i < cells:
        if input[6 + i] < 0 or input[6 + i] > 2: return -1
        i <- i + 1
    var row: mutable usize = 0
    while row < rows:
        var col: mutable usize = 0
        while col < cols:
            if (row == 0 or row + 1 == rows or col == 0 or col + 1 == cols) and input[6 + row * cols + col] != 0: return -1
            col <- col + 1
        row <- row + 1
    let tape: usize = 6 + cells
    i <- 0
    while i < 2 * steps * cells:
        if input[tape + i] < 0 or input[tape + i] >= 10000: return -1
        i <- i + 1
    let bytes: usize = (1 + 3 * steps + cells) * 8
    if output.is_null() or capacity < bytes: return -2

    var current = InlineArray[UInt8, MAX_CELLS](fill=0)
    var next = InlineArray[UInt8, MAX_CELLS](fill=0)
    i <- 0
    while i < cells:
        current[i] <- input[6 + i].u8()
        i <- i + 1
    var out: mutable view[u8] = output[0:bytes]
    forest_fire_put_word(out, 0, steps.i64())
    var tick: mutable usize = 0
    while tick < steps:
        row <- 0
        while row < rows:
            var col: mutable usize = 0
            while col < cols:
                let site: usize = row * cols + col
                if row == 0 or row + 1 == rows or col == 0 or col + 1 == cols:
                    next[site] <- 0
                elif current[site] == 2:
                    next[site] <- 0
                elif current[site] == 0:
                    next[site] <- if input[tape + tick * cells + site] < input[4]: 1 else: 0
                else:
                    var near_fire: mutable bool = false
                    let r0: usize = if row > 0: row - 1 else: 0
                    let r1: usize = if row + 1 < rows: row + 1 else: row
                    let c0: usize = if col > 0: col - 1 else: 0
                    let c1: usize = if col + 1 < cols: col + 1 else: col
                    var r: mutable usize = r0
                    while r <= r1:
                        var c: mutable usize = c0
                        while c <= c1:
                            if (r != row or c != col) and current[r * cols + c] == 2: near_fire <- true
                            c <- c + 1
                        r <- r + 1
                    let strike: i64 = input[tape + steps * cells + tick * cells + site]
                    next[site] <- if near_fire or strike < input[5]: 2 else: 1
                col <- col + 1
            row <- row + 1
        var totals = InlineArray[i64, 3](fill=0)
        i <- 0
        while i < cells:
            totals[next[i].usize()] <- totals[next[i].usize()] + 1
            i <- i + 1
        let base: usize = 1 + 3 * tick
        var state: mutable usize = 0
        while state < 3:
            forest_fire_put_word(out, base + state, totals[state])
            state <- state + 1
        i <- 0
        while i < cells:
            current[i] <- next[i]
            i <- i + 1
        tick <- tick + 1
    let final_base: usize = 1 + 3 * steps
    i <- 0
    while i < cells:
        forest_fire_put_word(out, final_base + i, current[i].i64())
        i <- i + 1
    bytes.i64()

export fn forest_fire_synchronous_stochastic_ca(
    input: i64&, length: c_size_t,
    output: mutable u8&, capacity: usize,
) abi("C") -> Int64:
    if input.is_null() or length < 6 or length > c_size_t(MAX_INPUT):
        return -1
    forest_fire_impl(input[0:length], output, capacity)
