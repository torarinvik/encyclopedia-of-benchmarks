const MIN_YEAR: i64 = 1899
const MAX_YEAR: i64 = 2100
const MAX_OUTPUT_BYTES: usize = 181

def find_month_calendar_is_leap_year(year: i64) -> bool:
    year % 400 == 0 or (year % 100 != 0 and year % 4 == 0)

def find_month_calendar_month_length(year: i64, month: i64) -> i64:
    if month == 2 and find_month_calendar_is_leap_year(year): return 29
    if month == 2: return 28
    if month == 4 or month == 6 or month == 9 or month == 11: return 30
    31

def find_month_calendar_start_offset(month: i64, year: i64) -> usize:
    difference: mutable i64 = 0
    current_year: mutable i64 = 1900
    current_month: mutable i64 = 1
    if year >= 1900:
        current_year <- 1900
        while current_year < year:
            if find_month_calendar_is_leap_year(current_year): difference <- difference + 366
            else: difference <- difference + 365
            current_year <- current_year + 1
        current_month <- 1
        while current_month < month:
            difference <- difference + find_month_calendar_month_length(year, current_month)
            current_month <- current_month + 1
        return (difference % 7).usize()
    current_year <- year
    while current_year < 1900:
        if find_month_calendar_is_leap_year(current_year): difference <- difference + 366
        else: difference <- difference + 365
        current_year <- current_year + 1
    current_month <- 1
    while current_month < month:
        difference <- difference - find_month_calendar_month_length(1900, current_month)
        current_month <- current_month + 1
    ((7 - (difference % 7)) % 7).usize()

def find_month_calendar_write_byte(output: mutable view[u8], position: mutable usize&, value: i64) -> void:
    output[position] <- value.u8()
    position <- position + 1

def find_month_calendar_write_cell(output: mutable view[u8], position: mutable usize&, day: i64) -> void:
    if day == 0:
        find_month_calendar_write_byte(output, position, 32)
        find_month_calendar_write_byte(output, position, 32)
        find_month_calendar_write_byte(output, position, 32)
        find_month_calendar_write_byte(output, position, 32)
    elif day >= 10:
        find_month_calendar_write_byte(output, position, 48 + day / 10)
        find_month_calendar_write_byte(output, position, 48 + day % 10)
        find_month_calendar_write_byte(output, position, 32)
        find_month_calendar_write_byte(output, position, 32)
    else:
        find_month_calendar_write_byte(output, position, 48 + day)
        find_month_calendar_write_byte(output, position, 32)
        find_month_calendar_write_byte(output, position, 32)
        find_month_calendar_write_byte(output, position, 32)

def find_month_calendar_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if values == null or length != 2: return -1
    month: i64 = values[0]
    year: i64 = values[1]
    if month < 1 or month > 12 or year < MIN_YEAR or year > MAX_YEAR: return -1

    offset: usize = find_month_calendar_start_offset(month, year)
    total_cells: usize = offset + find_month_calendar_month_length(year, month).usize()
    required: usize = 27 + total_cells * 4 + (total_cells + 6) / 7
    if required > MAX_OUTPUT_BYTES: return -1
    if output == null or output_capacity < required: return -2

    output_view: mutable view[u8] = output[0:output_capacity]
    position: mutable usize = 0
    find_month_calendar_write_byte(output_view, position, 77)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 84)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 87)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 84)
    find_month_calendar_write_byte(output_view, position, 104)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 70)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 83)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 32)
    find_month_calendar_write_byte(output_view, position, 83)
    find_month_calendar_write_byte(output_view, position, 117)
    find_month_calendar_write_byte(output_view, position, 10)

    cursor: mutable usize = 0
    while cursor < total_cells:
        cells: mutable usize = total_cells - cursor
        if cells > 7: cells <- 7
        column: mutable usize = 0
        while column < cells:
            cell: usize = cursor + column
            day: mutable i64 = 0
            if cell >= offset: day <- (cell - offset + 1).i64()
            find_month_calendar_write_cell(output_view, position, day)
            column <- column + 1
        find_month_calendar_write_byte(output_view, position, 10)
        cursor <- cursor + cells
    position.i64()

export fn find_month_calendar(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = find_month_calendar_impl
