def fps_impl(values: i64&, values_length: usize) -> i64:
    if values_length != 16: return -1

    blank: mutable i64 = -1
    for i in 0 ..< 16:
        if values[i] < 0 or values[i] >= 16: return -1
        for j in 0 ..< i:
            if values[i] == values[j]: return -1
        if values[i] == 0: blank <- i
    if blank < 0: return -1

    inversions: mutable i64 = 0
    for i in 0 ..< 16:
        if values[i] == 0: continue
        for j in i + 1 ..< 16:
            if values[j] != 0 and values[i] > values[j]:
                inversions += 1
    blank_row_from_top: i64 = blank / 4 + 1
    if (inversions + blank_row_from_top) % 2 == 0: return 1
    return 0

def fifteen_puzzle_solvability_impl(input: i64&, length: usize) -> i64:
    if input == null or length != 16: return -1
    fps_impl(input, length)

export fn fifteen_puzzle_solvability(input: i64&, length: usize) -> i64 = fifteen_puzzle_solvability_impl
