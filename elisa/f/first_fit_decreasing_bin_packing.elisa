def ffd_put_i64(output: mutable view[u8], word: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[word * 8 + byte] <- (bits >> (byte * 8)).u8()

def first_fit_decreasing_bin_packing_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > 65:
        return -1
    n0: i64 = input[0]
    if n0 < 0 or n0 > 64 or length != (1 + n0).usize():
        return -1
    n: usize = n0.usize()
    for i in 0..<n:
        size: i64 = input[i + 1]
        if size < 1 or size > 1000000:
            return -1
    order: mutable usize[64] = zeroed
    loads: mutable i64[64] = zeroed
    assignments: mutable i64[64] = zeroed
    for i in 0..<n:
        order[i] <- i
    for i in 1..<n:
        key: usize = order[i]
        j: mutable usize = i
        while j > 0 and input[order[j - 1] + 1] < input[key + 1]:
            order[j] <- order[j - 1]
            j <- j - 1
        order[j] <- key
    bins: mutable usize = 0
    for pos in 0..<n:
        item: usize = order[pos]
        size: i64 = input[item + 1]
        selected: mutable usize = 0
        while selected < bins and loads[selected] + size > 1000000:
            selected <- selected + 1
        if selected == bins:
            loads[bins] <- size
            assignments[item] <- bins.i64()
            bins <- bins + 1
        else:
            loads[selected] <- loads[selected] + size
            assignments[item] <- selected.i64()
    bytes: usize = 8 * (n + 1)
    if output == null or capacity < bytes:
        return -2
    ffd_put_i64(output[0:bytes], 0, bins.i64())
    for i in 0..<n:
        ffd_put_i64(output[0:bytes], i + 1, assignments[i])
    bytes.i64()

export fn first_fit_decreasing_bin_packing(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = first_fit_decreasing_bin_packing_impl
