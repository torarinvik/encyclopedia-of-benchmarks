# Clean-room, bounded BEEBS FASTA generation profile.
const MAX_COUNT: i64 = 1000
const MAX_STATE: i64 = 139967
const WIDTH: usize = 60
const ALU: str = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGGGAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGACCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAATACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCAGCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGGAGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCCAGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"
const IUB_WEIGHTS: f32[15] = [0.27.f32(),0.12.f32(),0.12.f32(),0.27.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32(),0.02.f32()]
const IUB_SYMBOLS: u8[15] = [97,99,103,116,66,68,72,75,77,78,82,83,86,87,89]
const HUMAN_WEIGHTS: f32[4] = [0.3029549426680.f32(),0.1979883004921.f32(),0.1975473066391.f32(),0.3015094502008.f32()]
const HUMAN_SYMBOLS: u8[4] = [97,99,103,116]

def fasta_wrapped_lines(count: usize) -> usize:
    (count + WIDTH - 1) / WIDTH

def fasta_output_length(count: usize) -> usize:
    77 + 10 * count + fasta_wrapped_lines(2 * count) + fasta_wrapped_lines(3 * count) + fasta_wrapped_lines(5 * count)

def fasta_accumulate_probabilities(weights: mutable f32&, size: usize) -> void:
    cumulative: mutable f32 = 0.0.f32()
    for index in 0..<size:
        cumulative <- cumulative + weights[index]
        weights[index] <- cumulative

def fasta_next_base(state: mutable i64&, weights: f32&, symbols: u8&, size: usize) -> u8:
    state <- (state * 3877 + 29573) % 139968
    random_value: f32 = state.f32() / 139968.f32()
    for index in 0..<size:
        if weights[index] >= random_value: return symbols[index]
    symbols[size - 1]

def fasta_write_repeat(output: mutable u8&, offset: mutable usize&, count: usize) -> void:
    for index in 0..<count:
        output[offset] <- ALU.byte(index % ALU.len())
        offset <- offset + 1
        if (index + 1) % WIDTH == 0 or index + 1 == count:
            output[offset] <- 10
            offset <- offset + 1

def fasta_write_weighted(output: mutable u8&, offset: mutable usize&, count: usize,
                         state: mutable i64&, weights: f32&, symbols: u8&, size: usize) -> void:
    for index in 0..<count:
        output[offset] <- fasta_next_base(state, weights, symbols, size)
        offset <- offset + 1
        if (index + 1) % WIDTH == 0 or index + 1 == count:
            output[offset] <- 10
            offset <- offset + 1

def beebs_fasta_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values == null or length != 2: return -1
    count_value: i64 = values[0]
    seed_value: i64 = values[1]
    if count_value < 1 or count_value > MAX_COUNT or seed_value < 0 or seed_value > MAX_STATE: return -1
    count: usize = count_value.usize()
    needed: usize = fasta_output_length(count)
    if output.is_null() or capacity < needed: return -2
    iub_thresholds: mutable f32[15] = IUB_WEIGHTS
    human_thresholds: mutable f32[4] = HUMAN_WEIGHTS
    fasta_accumulate_probabilities(iub_thresholds, 15)
    fasta_accumulate_probabilities(human_thresholds, 4)
    header_one: &str = ">ONE Homo sapiens alu\n"
    header_two: &str = ">TWO IUB ambiguity codes\n"
    header_three: &str = ">THREE Homo sapiens frequency\n"
    offset: mutable usize = 0
    for i in 0..<header_one.len():
        output[offset] <- header_one.byte(i)
        offset <- offset + 1
    fasta_write_repeat(output, offset, 2 * count)
    for i in 0..<header_two.len():
        output[offset] <- header_two.byte(i)
        offset <- offset + 1
    state: mutable i64 = seed_value
    fasta_write_weighted(output, offset, 3 * count, state, iub_thresholds, IUB_SYMBOLS, 15)
    for i in 0..<header_three.len():
        output[offset] <- header_three.byte(i)
        offset <- offset + 1
    fasta_write_weighted(output, offset, 5 * count, state, human_thresholds, HUMAN_SYMBOLS, 4)
    offset.i64()

export fn beebs_fasta(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = beebs_fasta_impl
