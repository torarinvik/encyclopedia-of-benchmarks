# List all positive divisors in ascending decimal order.
def decimal_length(value: i64) -> usize:
    length: mutable usize = 1
    remaining: mutable i64 = value
    while remaining >= 10:
        remaining <- remaining / 10
        length <- length + 1
    length

def append_decimal(value: i64, output: mutable view[u8], position_value: usize) -> usize:
    digits: mutable u8[3]
    count: mutable usize = 0
    remaining: mutable i64 = value
    while remaining > 0:
        digits[count] <- (48 + remaining % 10).u8()
        count <- count + 1
        remaining <- remaining / 10
    position: mutable usize = position_value
    while count > 0:
        count <- count - 1
        output[position] <- digits[count]
        position <- position + 1
    position

def factors_impl(value: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if value < 1 or value > 256:
        return -1
    required: mutable usize = 0
    count: mutable usize = 0
    divisor: mutable i64 = 1
    while divisor <= value:
        if value % divisor == 0:
            required <- required + decimal_length(divisor)
            required <- required + 1 if count > 0
            count <- count + 1
        divisor <- divisor + 1
    if output_capacity < required:
        return -2
    position: mutable usize = 0
    count <- 0
    divisor <- 1
    while divisor <= value:
        if value % divisor == 0:
            if count > 0:
                output[position] <- 44.u8()
                position <- position + 1
            position <- append_decimal(divisor, output[0:required], position)
            count <- count + 1
        divisor <- divisor + 1
    position.i64()

export fn factors(value: i64, output: mutable u8&, output_capacity: usize) -> i64 = factors_impl
