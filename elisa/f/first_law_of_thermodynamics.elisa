# Numeric first-law operations over a bounded integer-valued domain.
def first_law_of_thermodynamics_impl(operation: f64, a: f64, b: f64) -> f64:
    if operation != operation or a != a or b != b:
        return -1e300
    if operation < 0.0 or operation > 2.0 or operation != f64(i64(operation)):
        return -1e300
    if a < -1000000.0 or a > 1000000.0 or b < -1000000.0 or b > 1000000.0:
        return -1e300
    if a != f64(i64(a)) or b != f64(i64(b)):
        return -1e300
    if operation == 0.0:
        return a - b
    if operation == 1.0:
        return a + b
    return a - b

export fn first_law_of_thermodynamics(operation: f64, a: f64, b: f64) -> f64 = first_law_of_thermodynamics_impl
