extern floor(value: f64) -> f64
extern log10(value: f64) -> f64

def finding_number_of_digits_in_a_number_using_log_impl(value: f64) -> f64:
    if not (value >= -1000000.0 and value <= 1000000.0):
        return -1.0e300
    if value == 0.0:
        return 0.0
    magnitude: mutable f64 = value
    if magnitude < 0.0:
        magnitude <- -magnitude
    floor(log10(magnitude) + 1.0)

export fn finding_number_of_digits_in_a_number_using_log(value: f64) -> f64 = finding_number_of_digits_in_a_number_using_log_impl
