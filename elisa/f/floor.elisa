# Floor for bounded finite binary64 inputs, correcting truncation below zero.
def floor_impl(value: f64) -> f64:
    if value < -1000000.0 or value > 1000000.0:
        return -1.0
    truncated: i64 = i64(value)
    if value < truncated.f64():
        return (truncated - 1).f64()
    truncated.f64()

export fn floor(value: f64) -> f64 = floor_impl
