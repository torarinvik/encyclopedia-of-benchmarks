@link_name("llvm.floor.f64")
extern round_down(value: f64) -> f64

def floor_impl(value: f64) -> f64:
    if not (value >= -1000000.0 and value <= 1000000.0):
        return -1.0
    # Preserve the original integer conversion’s positive zero result.
    round_down(value) + 0.0

export fn floor(value: f64) -> f64 = floor_impl
