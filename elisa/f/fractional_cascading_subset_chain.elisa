const FCSC_MAX_M: usize = 8
const FCSC_MAX_Q: usize = 8
const FCSC_MAX_N: usize = 16
const FCSC_MAX_LENGTH: usize = 147
const FCSC_NO_SUCCESSOR: i64 = 34

def fcsc_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 2 or length > FCSC_MAX_LENGTH: return -1
    if input[0] < 2 or input[0] > 8 or input[1] < 1 or input[1] > 8: return -1
    m: usize = input[0].usize()
    q: usize = input[1].usize()
    catalogs: mutable i64[8][16] = zeroed
    sizes: mutable usize[8] = zeroed
    cursor: mutable usize = 2
    i: mutable usize = 0
    while i < m:
        if cursor >= length or input[cursor] < 1 or input[cursor] > 16: return -1
        n: usize = input[cursor].usize()
        cursor <- cursor + 1
        if cursor + n > length: return -1
        sizes[i] <- n
        j: mutable usize = 0
        while j < n:
            key: i64 = input[cursor]
            cursor <- cursor + 1
            if key < -16 or key > 16: return -1
            if j > 0 and catalogs[i][j - 1] >= key: return -1
            catalogs[i][j] <- key
            j <- j + 1
        if i > 0:
            parent_pos: mutable usize = 0
            child_pos: mutable usize = 0
            while parent_pos < sizes[i - 1] and child_pos < n:
                if catalogs[i - 1][parent_pos] < catalogs[i][child_pos]:
                    parent_pos <- parent_pos + 1
                else:
                    if catalogs[i - 1][parent_pos] == catalogs[i][child_pos]:
                        parent_pos <- parent_pos + 1
                        child_pos <- child_pos + 1
                    else:
                        return -1
            if child_pos != n: return -1
        i <- i + 1
    if cursor + q != length: return -1
    i <- 0
    while i < q:
        if input[cursor + i] < -17 or input[cursor + i] > 17: return -1
        i <- i + 1

    bridge: mutable usize[7][17] = zeroed
    i <- 0
    while i + 1 < m:
        child_pos: mutable usize = 0
        slot: mutable usize = 0
        while slot < sizes[i]:
            while child_pos < sizes[i + 1] and catalogs[i + 1][child_pos] < catalogs[i][slot]:
                child_pos <- child_pos + 1
            bridge[i][slot] <- child_pos
            slot <- slot + 1
        bridge[i][sizes[i]] <- sizes[i + 1]
        i <- i + 1

    checksum: mutable i64 = 0
    qi: mutable usize = 0
    while qi < q:
        key: i64 = input[cursor + qi]
        low: mutable usize = 0
        high: mutable usize = sizes[0]
        while low < high:
            middle: usize = (low + high) / 2
            if catalogs[0][middle] < key:
                low <- middle + 1
            else:
                high <- middle
        slot: mutable usize = low
        ci: mutable usize = 0
        while ci < m:
            code: i64 = if slot < sizes[ci]: catalogs[ci][slot] + 17 else: FCSC_NO_SUCCESSOR
            checksum <- checksum + (qi + 1).i64() * (ci + 1).i64() * code
            if ci + 1 < m: slot <- bridge[ci][slot]
            ci <- ci + 1
        qi <- qi + 1
    checksum

export fn fractional_cascading_subset_chain(input: i64&, length: usize) -> i64:
    if input.is_null() or length > FCSC_MAX_LENGTH: return -1
    fcsc_impl(input[0:length])
