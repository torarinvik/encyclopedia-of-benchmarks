# One-dimensional squared distance transform by a bounded parabola envelope.
export fn felzenszwalb_huttenlocher_1d_squared_distance_transform(
        input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if input == null or length < 2 or length > 130: return -1
    values: view[i64] = input[0:length]
    n64: i64 = values[0]
    if n64 < 1 or n64 > 128: return -1
    n: usize = n64.usize()
    if length != n + 1: return -1
    for i in 0..<n:
        if values[i + 1] < 0 or values[i + 1] > 1000000: return -1
    output_bytes: usize = n * 16
    if output.is_null() or output_capacity < output_bytes: return -2

    sites: mutable usize[128] = zeroed
    starts: mutable i64[128] = zeroed
    top: mutable usize = 0
    sites[0] <- 0
    starts[0] <- -4611686018427387904
    for q in 1..<n:
        loop:
            p: usize = sites[top]
            numerator: i64 = values[q + 1] + (q * q).i64()
                - values[p + 1] - (p * p).i64()
            denominator: i64 = (2 * (q - p)).i64()
            quotient: mutable i64 = numerator / denominator
            remainder: i64 = numerator % denominator
            if remainder != 0 and numerator < 0: quotient <- quotient - 1
            first: i64 = quotient + 1
            if top == 0 or first > starts[top]:
                top <- top + 1
                sites[top] <- q
                starts[top] <- first
                break
            top <- top - 1

    active: mutable usize = 0
    result: mutable view[u8] = output[0:output_bytes]
    for x in 0..<n:
        while active < top and starts[active + 1] <= x.i64():
            active <- active + 1
        site: usize = sites[active]
        delta: i64 = x.i64() - site.i64()
        distance: i64 = delta * delta + values[site + 1]
        distance_bits: u64 = distance.u64()
        site_bits: u64 = site.i64().u64()
        for byte in 0..<8:
            result[x * 16 + byte] <- ((distance_bits >> (byte * 8)) & 255).u8()
            result[x * 16 + 8 + byte] <- ((site_bits >> (byte * 8)) & 255).u8()
    output_bytes.i64()
