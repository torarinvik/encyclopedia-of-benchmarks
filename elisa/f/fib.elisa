def fib_impl(n: i64) -> i64:
    if n < 0 |return -1|
    if n > 90 |return -1|
    while index < n |index: i64 = 0, previous: i64 = 1, current: i64 = 2| -> previous:
        next: i64 = previous + current
        previous <- current
        current <- next
        index <- index + 1

export fn fib(n: i64) -> i64 = fib_impl
