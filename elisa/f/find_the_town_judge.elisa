const MAX_PEOPLE: i64 = 1000
const MAX_TRUST_ROWS: i64 = 10000
const MAX_INPUT_LENGTH: usize = 20002

def find_the_town_judge_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_INPUT_LENGTH:
        return -2
    people: i64 = values[0]
    trust_count: i64 = values[1]
    if people < 1 or people > MAX_PEOPLE or trust_count < 0 or trust_count > MAX_TRUST_ROWS:
        return -2
    edge_count: usize = trust_count.usize()
    if length != 2 + 2 * edge_count:
        return -2

    incoming: mutable i64[1001] = zeroed
    outgoing: mutable i64[1001] = zeroed
    for edge in 0..<edge_count |values, incoming, outgoing|:
        from: i64 = values[2 + 2 * edge]
        to: i64 = values[3 + 2 * edge]
        if from < 1 or from > people or to < 1 or to > people or from == to:
            return -2
        outgoing[from.usize()] <- outgoing[from.usize()] + 1
        incoming[to.usize()] <- incoming[to.usize()] + 1

    judge: mutable i64 = -1
    person: mutable i64 = 1
    while person <= people |judge, person, incoming, outgoing|:
        if incoming[person.usize()] == people - 1 and outgoing[person.usize()] == 0:
            if judge != -1:
                return -1
            judge <- person
        person <- person + 1
    judge

export fn find_the_town_judge(values: i64&, length: usize) -> i64 = find_the_town_judge_impl
