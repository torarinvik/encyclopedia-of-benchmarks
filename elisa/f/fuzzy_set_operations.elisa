extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&
def putd(output: mutable view[u8], offset: usize, value: f64):
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    k: mutable usize = 0
    while k < 8:
        output[offset+k] <- (bits & 255).u8()
        bits <- bits >> 8
        k <- k+1
def fuzzy_set_operations_impl(v: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 8: return -1
    op: i64 = v[0]; n: i64 = v[1]
    if op < 0 or op > 8 or n < 1 or n > 8 or length != (5+3*n).usize(): return -1
    i: mutable usize = 5
    while i < length:
        if v[i] < 0 or v[i] > 1000: return -1
        i <- i+1
    left: i64 = v[2]; peak: i64 = v[3]; right: i64 = v[4]
    if op == 0:
        if left < 0 or peak < left or right < peak or right > 1000: return -1
        i <- 0
        while i < n.usize():
            if v[5+n.usize()+i] != 0 or v[5+2*n.usize()+i] != 0: return -1
            i <- i+1
    else:
        if left != 0 or peak != 0 or right != 0: return -1
        i <- 0
        while i < n.usize():
            if v[5+i] != 0: return -1
            i <- i+1
    if capacity < n.usize()*8: return -2
    i <- 0
    while i < n.usize():
        z: mutable f64 = 0.0
        if op == 0:
            x: f64 = v[5+i].f64()/1000.0; a: f64 = left.f64()/1000.0; b: f64 = peak.f64()/1000.0; c: f64 = right.f64()/1000.0
            u: f64 = if b > a: (x-a)/(b-a) else: if x < b: 0.0 else: 1.0
            w: f64 = if c > b: (c-x)/(c-b) else: if x > c: 0.0 else: 1.0
            z <- max(0.0,min(1.0,min(u,w)))
        else:
            a: f64 = v[5+n.usize()+i].f64()/1000.0; b: f64 = v[5+2*n.usize()+i].f64()/1000.0
            if op == 1: z <- max(a,b)
            if op == 2: z <- min(a,b)
            if op == 3: z <- 1.0-a
            if op == 4: z <- min(a,1.0-b)
            if op == 5: z <- a+b-a*b
            if op == 6: z <- a*b
            if op == 7: z <- min(1.0,a+b)
            if op == 8: z <- max(0.0,a+b-1.0)
        putd(output[0:n.usize()*8],i*8,z); i <- i+1
    (n*8)
export fuzzy_set_operations(v: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = fuzzy_set_operations_impl
