@link_name("llvm.memcpy.p0.p0.i64")
extern copy_seed_bits(destination: mutable u32&, source: f32&, bytes: usize, is_volatile: bool) -> void
@link_name("llvm.memcpy.inline.p0.p0.i64")
extern copy_seed_value(destination: mutable f32&, source: u32&, bytes: usize, is_volatile: bool) -> void

def fast_inverse_square_root_impl(value: f64) -> f64:
    if not (value >= 1e-6 and value <= 1e6): return -1.0
    rounded: f32 = value.f32()
    bits: mutable u32 = 0
    copy_seed_bits(&bits, &rounded, 4, false)
    seed_bits: u32 = 0x5f3759df - (bits >> 1)
    seed: mutable f32 = 0.0
    copy_seed_value(&seed, &seed_bits, 4, false)
    y: f64 = seed.f64()
    y * (1.5 - 0.5 * value * y * y)

export fn fast_inverse_square_root(value: f64) -> f64 = fast_inverse_square_root_impl
