def digit_factor(digit: i64) -> i64:
    if digit == 0: 1
    elif digit == 1: 1
    elif digit == 2: 2
    elif digit == 3: 6
    else: 4

def two_power_mod_10(exponent_mod_four: i64) -> i64:
    if exponent_mod_four == 0: 1
    elif exponent_mod_four == 1: 2
    elif exponent_mod_four == 2: 4
    else: 8

def factorial_last_nonzero_digit_impl(input: i64&, input_length: usize) -> i64:
    if input_length != 1: return -1
    n: mutable i64 = input[0]
    if n < 0: return -1
    result: mutable i64 = 1
    while n >= 5:
        quotient: i64 = n / 5
        remainder: i64 = n % 5
        result <- result * digit_factor(remainder) % 10
        result <- result * two_power_mod_10(quotient % 4) % 10
        n <- quotient
    result * digit_factor(n) % 10

def factorial_last_nonzero_digit_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > 2: return -1
    factorial_last_nonzero_digit_impl(input, length)

export fn factorial_last_nonzero_digit(input: i64&, length: usize) -> i64 = factorial_last_nonzero_digit_entry
