def digit_factor(digit: i64) -> i64:
    if digit == 0: 1
    else if digit == 1: 1
    else if digit == 2: 2
    else if digit == 3: 6
    else: 4

def two_power_mod_10(exponent_mod_four: i64) -> i64:
    if exponent_mod_four == 0: 1
    else if exponent_mod_four == 1: 2
    else if exponent_mod_four == 2: 4
    else: 8

def factorial_last_nonzero_digit_impl(input: view[i64]) -> i64:
    if input.len() != 1: return -1
    var n: mutable i64 = input[0]
    if n < 0: return -1
    var result: mutable i64 = 1
    while n >= 5:
        quotient: i64 = n / 5
        remainder: i64 = n % 5
        result <- result * digit_factor(remainder) % 10
        result <- result * two_power_mod_10(quotient % 4) % 10
        n <- quotient
    result * digit_factor(n) % 10

export fn factorial_last_nonzero_digit(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > 2: return -1
    factorial_last_nonzero_digit_impl(input[0:length])
