extern cos(value: f64) -> f64
extern sin(value: f64) -> f64

def quantize(value: f64) -> i64:
    scaled: f64 = value * 1000000.0
    if scaled >= 0.0: return (scaled + 0.5).i64()
    (scaled - 0.5).i64()

def store_i64(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def fft(real: mutable view[f64], imag: mutable view[f64], n: usize, inverse: bool) -> void:
    reverse: mutable usize = 0
    position: mutable usize = 1
    while position < n:
        bit: mutable usize = n >> 1
        while (reverse & bit) != 0:
            reverse <- reverse ^ bit
            bit <- bit >> 1
        reverse <- reverse ^ bit
        if position < reverse:
            t: mutable f64 = real[position]
            real[position] <- real[reverse]
            real[reverse] <- t
            t <- imag[position]
            imag[position] <- imag[reverse]
            imag[reverse] <- t
        position <- position + 1
    block: mutable usize = 2
    while block <= n:
        direction: mutable f64 = -1.0
        if inverse: direction <- 1.0
        angle: f64 = direction * 6.2831853071795864769 / block.f64()
        cr: f64 = cos(angle)
        ci: f64 = sin(angle)
        start: mutable usize = 0
        while start < n:
            wr: mutable f64 = 1.0
            wi: mutable f64 = 0.0
            k: mutable usize = 0
            while k < block / 2:
                u: usize = start + k
                v: usize = u + block / 2
                pr: f64 = wr * real[v] - wi * imag[v]
                pi: f64 = wr * imag[v] + wi * real[v]
                ur: f64 = real[u]
                ui: f64 = imag[u]
                real[u] <- ur + pr
                imag[u] <- ui + pi
                real[v] <- ur - pr
                imag[v] <- ui - pi
                nr: f64 = wr * cr - wi * ci
                wi <- wr * ci + wi * cr
                wr <- nr
                k <- k + 1
            start <- start + block
        block <- block * 2
    if inverse:
        index: mutable usize = 0
        while index < n:
            real[index] <- real[index] / n.f64()
            imag[index] <- imag[index] / n.f64()
            index <- index + 1

def fft_bluestein_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values == null or length < 2 or length > 9: return -1
    m: i64 = values[0]
    if m < 1 or m > 8 or length != m.usize() + 1: return -1
    i: mutable usize = 0
    while i < m.usize():
        if values[i + 1] < -8 or values[i + 1] > 8: return -1
        i <- i + 1
    z: mutable usize = 1
    need: usize = (3 * m - 2).usize()
    while z < need: z <- z * 2
    bytes: usize = m.usize() * 16
    if output == null or capacity < bytes: return -2
    ar: mutable f64[32] = zeroed
    ai: mutable f64[32] = zeroed
    br: mutable f64[32] = zeroed
    bi: mutable f64[32] = zeroed
    j: mutable usize = 0
    while j < m.usize():
        angle: f64 = -3.14159265358979323846 * j.f64() * j.f64() / m.f64()
        ar[j] <- values[j + 1].f64() * cos(angle)
        ai[j] <- values[j + 1].f64() * sin(angle)
        j <- j + 1
    k: mutable i64 = -(m - 1)
    while k <= m - 1:
        angle: f64 = 3.14159265358979323846 * k.f64() * k.f64() / m.f64()
        ix: usize = (k + m - 1).usize()
        br[ix] <- cos(angle)
        bi[ix] <- sin(angle)
        k <- k + 1
    fft(ar[0:z], ai[0:z], z, false)
    fft(br[0:z], bi[0:z], z, false)
    i <- 0
    while i < z:
        x: f64 = ar[i] * br[i] - ai[i] * bi[i]
        ai[i] <- ar[i] * bi[i] + ai[i] * br[i]
        ar[i] <- x
        i <- i + 1
    fft(ar[0:z], ai[0:z], z, true)
    k <- 0
    while k < m:
        angle: f64 = -3.14159265358979323846 * k.f64() * k.f64() / m.f64()
        cr: f64 = cos(angle)
        ci: f64 = sin(angle)
        ix: usize = k.usize() + m.usize() - 1
        re: f64 = ar[ix] * cr - ai[ix] * ci
        im: f64 = ar[ix] * ci + ai[ix] * cr
        store_i64(quantize(re), output[0:capacity], 16 * k.usize())
        store_i64(quantize(im), output[0:capacity], 16 * k.usize() + 8)
        k <- k + 1
    bytes.i64()

export fn fft_bluestein(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = fft_bluestein_impl
