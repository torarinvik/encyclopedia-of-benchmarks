def ff_card_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits >> (byte * 8)).u8()

def first_fit_cardinality_bin_packing_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 4 or length > 35:
        return -1
    n0: i64 = input[0]
    item_limit: i64 = input[1]
    cap: i64 = input[2]
    if n0 < 1 or n0 > 32 or item_limit < 1 or item_limit > 32 or cap < 1 or cap > 10000 or length != n0.usize() + 3:
        return -1
    n: usize = n0.usize()
    for i in 0..<n:
        if input[3 + i] < 1 or input[3 + i] > cap:
            return -1
    loads: mutable i64[32] = zeroed
    used: mutable i64[32] = zeroed
    owners: mutable i64[32] = zeroed
    bins: mutable usize = 0
    for i in 0..<n:
        size: i64 = input[3 + i]
        b: mutable usize = 0
        while b < bins and (used[b] >= item_limit or loads[b] > cap - size):
            b <- b + 1
        if b == bins:
            bins <- bins + 1
        loads[b] <- loads[b] + size
        used[b] <- used[b] + 1
        owners[i] <- b.i64()
    output_length: usize = 8 * (n + 1)
    if output == null or capacity < output_length:
        return -2
    ff_card_put_i64(output[0:output_length], 0, bins.i64())
    for i in 0..<n:
        ff_card_put_i64(output[0:output_length], (i + 1) * 8, owners[i])
    output_length.i64()

export fn first_fit_cardinality_bin_packing(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = first_fit_cardinality_bin_packing_impl
