def frt_tree_metric_within(distance: i64, beta: i64, level: i64) -> bool:
    if level >= 0:
        return distance * 1024 <= beta * (1.i64() << level.usize())
    return distance * 1024 * (1.i64() << (-level).usize()) <= beta

def frt_tree_metric_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits >> (byte * 8)).u8()

def frt_tree_metric_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 8 or length > 74:
        return -1
    n0: i64 = input[0]
    beta: i64 = input[1]
    if n0 < 2 or n0 > 8 or beta < 1024 or beta > 2047:
        return -1
    n: usize = n0.usize()
    if length != 2 + n + n * n:
        return -1
    perm: mutable usize[8] = zeroed
    seen: mutable bool[8] = zeroed
    for i in 0..<n:
        p: i64 = input[2 + i]
        if p < 0 or p >= n0 or seen[p.usize()]:
            return -1
        seen[p.usize()] <- true
        perm[i] <- p.usize()
    d: mutable i64[64] = zeroed
    maxd: mutable i64 = 0
    base: usize = 2 + n
    for i in 0..<n:
        for j in 0..<n:
            x: i64 = input[base + i * n + j]
            if x < 0 or x > 255 or (i == j and x != 0) or (i != j and x == 0):
                return -1
            d[i * n + j] <- x
            if x > maxd: maxd <- x
    for i in 0..<n:
        for j in 0..<n:
            if d[i * n + j] != d[j * n + i]: return -1
            for k in 0..<n:
                if d[i * n + j] > d[i * n + k] + d[k * n + j]: return -1
    high: mutable i64 = 0
    while (1.i64() << high.usize()) < maxd:
        high <- high + 1
    staged: mutable i64[64] = zeroed
    clusters: mutable u64[256] = zeroed
    next: mutable u64[256] = zeroed
    count: mutable usize = 1
    clusters[0] <- (1.u64() << n) - 1
    level: mutable i64 = high
    while level >= -10:
        next_count: mutable usize = 0
        tree_distance: i64 = 1.i64() << (level + 13).usize()
        for ci in 0..<count:
            remaining: mutable u64 = clusters[ci]
            done: mutable u64 = 0
            while remaining != 0:
                center: mutable usize = n
                for p in 0..<n:
                    if (remaining & (1.u64() << perm[p])) != 0:
                        center <- perm[p]
                        break
                if center == n: return -1
                child: mutable u64 = 0
                for v in 0..<n:
                    if (remaining & (1.u64() << v)) != 0 and frt_tree_metric_within(d[center * n + v], beta, level):
                        child <- child | (1.u64() << v)
                if child == 0: child <- 1.u64() << center
                for u in 0..<n:
                    if (done & (1.u64() << u)) != 0:
                        for v in 0..<n:
                            if (child & (1.u64() << v)) != 0:
                                staged[u * n + v] <- tree_distance
                                staged[v * n + u] <- tree_distance
                done <- done | child
                remaining <- remaining & (~child)
                next[next_count] <- child
                next_count <- next_count + 1
        for i in 0..<next_count: clusters[i] <- next[i]
        count <- next_count
        level <- level - 1
    bytes: usize = 8 * n * n
    if output == null or capacity < bytes: return -2
    for i in 0..<(n*n): frt_tree_metric_put_i64(output[0:bytes], i*8, staged[i])
    bytes.i64()

export fn frt_tree_metric(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = frt_tree_metric_impl
