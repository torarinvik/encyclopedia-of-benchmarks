alias FGCP_MAX_N = 64
alias FGCP_ENCODING_BASE = 65

def fgcp_next(values: view[i64], node: i64) -> i64:
    values[(2 + node) as usize]

def fgcp_solve(values: view[i64]) -> i64:
    if values.len() < 3 or values.len() > FGCP_MAX_N + 2: return -1
    n: i64 = values[0]
    start: i64 = values[1]
    if n < 1 or n > FGCP_MAX_N or start < 0 or start >= n or values.len() != (n + 2) as usize:
        return -1
    i: mutable usize = 0
    while i < n as usize:
        successor: i64 = values[i + 2]
        if successor < 0 or successor >= n: return -1
        i <- i + 1

    tortoise: mutable i64 = fgcp_next(values, start)
    hare: mutable i64 = fgcp_next(values, fgcp_next(values, start))
    while tortoise != hare:
        tortoise <- fgcp_next(values, tortoise)
        hare <- fgcp_next(values, fgcp_next(values, hare))

    mu: mutable i64 = 0
    tortoise <- start
    while tortoise != hare:
        tortoise <- fgcp_next(values, tortoise)
        hare <- fgcp_next(values, hare)
        mu <- mu + 1

    lambda: mutable i64 = 1
    hare <- fgcp_next(values, tortoise)
    while hare != tortoise:
        hare <- fgcp_next(values, hare)
        lambda <- lambda + 1
    FGCP_ENCODING_BASE * mu + lambda

export fn functional_graph_cycle_parameters(input: i64&, length: usize) -> i64:
    if input.is_null(): return -1
    fgcp_solve(input[0:length])
