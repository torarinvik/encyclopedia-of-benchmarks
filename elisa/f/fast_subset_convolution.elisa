const MOD: i64 = 998244353

def fast_subset_convolution_put(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    output[offset + 0] <- (bits >> 0).u8()
    output[offset + 1] <- (bits >> 8).u8()
    output[offset + 2] <- (bits >> 16).u8()
    output[offset + 3] <- (bits >> 24).u8()
    output[offset + 4] <- (bits >> 32).u8()
    output[offset + 5] <- (bits >> 40).u8()
    output[offset + 6] <- (bits >> 48).u8()
    output[offset + 7] <- (bits >> 56).u8()

def fast_subset_convolution_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > 33:
        return -1
    n64: i64 = input[0]
    if n64.u64() > 4:
        return -1
    size: usize = (1.u32() << n64.u32()).usize()
    if length != 1 + 2 * size:
        return -1
    if size == 1:
        left: u64 = input[1].u64()
        right: u64 = input[2].u64()
        if left >= MOD.u64() or right >= MOD.u64():
            return -1
        if capacity < 8 or output == null:
            return -2
        fast_subset_convolution_put(output, 0, ((left * right) % MOD.u64()).i64())
        return 8
    # Unsigned maximum detects negative and oversized coefficients in one pass.
    largest_coefficient: mutable u64 = 0
    for index in 0..<(2 * size):
        value: u64 = input[1 + index].u64()
        largest_coefficient <- value if value > largest_coefficient else largest_coefficient
    if largest_coefficient >= MOD.u64():
        return -1
    required: usize = size * 8
    if capacity < required or output == null:
        return -2

    left_coefficients: i64& = &input[1]
    right_coefficients: i64& = &input[1 + size]

    # Stage results before any stores so the output may overlap the input.
    coefficients: mutable u64[16] = zeroed
    coefficients[0] <- (left_coefficients[0].u64() * right_coefficients[0].u64()) % MOD.u64()
    mask: mutable usize = 1
    while mask < size:
        lowest_bit: usize = mask & (0.usize() - mask)
        # Each pair assigns the lowest bit to a different coefficient.
        upper_mask: usize = mask ^ lowest_bit
        subset: mutable usize = upper_mask
        sum: mutable u64 = 0
        while true:
            complement: usize = upper_mask ^ subset
            sum <- sum + left_coefficients[subset].u64() * right_coefficients[complement | lowest_bit].u64()
            sum <- sum + left_coefficients[subset | lowest_bit].u64() * right_coefficients[complement].u64()
            if subset == 0:
                break
            subset <- (subset - 1) & upper_mask
        # At most sixteen products fit in u64, so reduce only once.
        coefficients[mask] <- sum % MOD.u64()
        mask <- mask + 1
    mask <- 0
    while mask < size:
        fast_subset_convolution_put(output, 8 * mask, coefficients[mask].i64())
        mask <- mask + 1
    required.i64()

export fn fast_subset_convolution(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = fast_subset_convolution_impl
