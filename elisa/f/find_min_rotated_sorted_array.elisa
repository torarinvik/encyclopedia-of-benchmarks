# Find the minimum in a rotation of a strictly increasing i64 array.
def find_min_rotated_sorted_array_impl(values: i64&, length: usize) -> i64:
    if length < 1 or length > 256:
        return -1
    minimum_index: usize =
        while low < high |low: mutable usize = 0, high: mutable usize = length - 1| -> low:
            middle: usize = low + (high - low) / 2
            if values[middle] <= values[high]:
                high <- middle
            else:
                low <- middle + 1
    values[minimum_index]

export fn find_min_rotated_sorted_array(values: i64&, length: usize) -> i64 = find_min_rotated_sorted_array_impl
