# Bounded eight-connected region replacement with a breadth-first queue.
const MAX_CELLS: usize = 1024
const MAX_PARSEABLE_INPUT_LENGTH: usize = 1031

def flood_fill_breadth_first_compute(input: view[i64], image: mutable view[i64],
                                     queue: mutable view[usize]) -> i64:
    length: usize = input.len()
    if length < 6 or length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    width_value: i64 = input[0]
    height_value: i64 = input[1]
    start_x_value: i64 = input[2]
    start_y_value: i64 = input[3]
    new_color: i64 = input[4]
    target_color: i64 = input[5]
    if width_value < 1 or width_value > 32 or height_value < 1 or height_value > 32:
        return -1
    if new_color < -2147483648 or new_color > 2147483647 or
       target_color < -2147483648 or target_color > 2147483647 or
       new_color == target_color:
        return -1
    width: usize = width_value.usize()
    height: usize = height_value.usize()
    if length != 6 + width * height or start_x_value < 0 or
       start_x_value >= width_value or start_y_value < 0 or
       start_y_value >= height_value:
        return -1
    cells: usize = width * height
    for index in 0..<cells:
        image[index] <- input[6 + index]
        if image[index] < -2147483648 or image[index] > 2147483647:
            return -1
    start: usize = start_x_value.usize() * height + start_y_value.usize()
    if image[start] == target_color:
        head: mutable usize = 0
        tail: mutable usize = 0
        image[start] <- new_color
        queue[tail] <- start
        tail <- tail + 1
        while head < tail:
            index: usize = queue[head]
            head <- head + 1
            x: i64 = (index / height).i64()
            y: i64 = (index % height).i64()
            dx: mutable i64 = -1
            while dx <= 1:
                dy: mutable i64 = -1
                while dy <= 1:
                    if dx != 0 or dy != 0:
                        next_x: i64 = x + dx
                        next_y: i64 = y + dy
                        if next_x >= 0 and next_x < width_value and
                           next_y >= 0 and next_y < height_value:
                            next: usize = next_x.usize() * height + next_y.usize()
                            if image[next] == target_color:
                                image[next] <- new_color
                                queue[tail] <- next
                                tail <- tail + 1
                    dy <- dy + 1
                dx <- dx + 1
    (cells * 8).i64()

def flood_fill_breadth_first_store_i64(value: i64, output: mutable view[u8],
                                       offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

export fn flood_fill_breadth_first(input: i64&, length: usize, output: mutable u8&,
                                   capacity: usize) -> i64:
    if input.is_null() or length < 6 or length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    image: mutable i64[MAX_CELLS] = zeroed
    queue: mutable usize[MAX_CELLS] = zeroed
    required_result: i64 = flood_fill_breadth_first_compute(
        input_view, image[0:MAX_CELLS], queue[0:MAX_CELLS])
    if required_result < 0: return required_result
    required: usize = required_result.usize()
    if output.is_null() or capacity < required: return -2
    output_view: mutable view[u8] = output[0:required]
    cells: usize = required / 8
    for index in 0..<cells:
        flood_fill_breadth_first_store_i64(image[index], output_view, index * 8)
    required_result
