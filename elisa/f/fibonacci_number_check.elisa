# Check the Fibonacci square identity without overflowing signed 64-bit values.
def fibonacci_square_i64(value: i64) -> bool:
    if value < 0:
        return false
    low: mutable i64 = 0
    high: mutable i64 = 3037000499
    while low <= high:
        middle: i64 = low + (high - low) / 2
        square: i64 = middle * middle
        if square == value:
            return true
        if square < value:
            low <- middle + 1
        else:
            high <- middle - 1
    return false

def fibonacci_number_check_impl(number: i64) -> i64:
    if number < -1300000000 or number > 1300000000:
        return -1
    value: i64 = 5 * number * number
    if fibonacci_square_i64(value + 4) or fibonacci_square_i64(value - 4):
        return 1
    return 0

export fn fibonacci_number_check(number: i64) -> i64 = fibonacci_number_check_impl
