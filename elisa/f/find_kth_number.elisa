const INVALID_RESULT: i64 = -9223372036854775807 - 1
const MAX_VALUES: usize = 1024

def find_kth_number_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_VALUES + 1:
        return INVALID_RESULT
    k: i64 = values[0]
    count: usize = length - 1
    if k < 1 or k > count.i64():
        return INVALID_RESULT
    heap: mutable i32[1024] = [0; 1024]
    i: mutable usize = 0
    while i < count:
        input: i64 = values[i + 1]
        if input < -2147483648 or input > 2147483647:
            return INVALID_RESULT
        index: mutable usize = i
        heap[index] <- input.i32()
        while index > 0:
            parent: usize = (index - 1) / 2
            if heap[parent] >= heap[index]:
                break
            temp: i32 = heap[parent]
            heap[parent] <- heap[index]
            heap[index] <- temp
            index <- parent
        i <- i + 1
    heap_size: mutable usize = count
    removed: mutable i64 = 1
    while removed < k:
        heap_size <- heap_size - 1
        heap[0] <- heap[heap_size]
        index: mutable usize = 0
        while index * 2 + 1 < heap_size:
            child: mutable usize = index * 2 + 1
            if child + 1 < heap_size and heap[child + 1] > heap[child]:
                child <- child + 1
            if heap[index] >= heap[child]:
                break
            temp: i32 = heap[index]
            heap[index] <- heap[child]
            heap[child] <- temp
            index <- child
        removed <- removed + 1
    heap[0].i64()

export fn find_kth_number(values: i64&, length: usize) -> i64 = find_kth_number_impl
