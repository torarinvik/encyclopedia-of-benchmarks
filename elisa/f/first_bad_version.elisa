# Find the first bad version with a lower-bound binary search.
def first_bad_version_impl(version_count: u64, first_bad: u64) -> i64:
    if version_count == 0 or version_count > 2147483647.u64() or first_bad == 0 or first_bad > version_count:
        return -1

    low: mutable u64 = 1
    high: mutable u64 = version_count
    while low < high:
        middle: u64 = low + (high - low) / 2
        if middle >= first_bad:
            high <- middle
        else:
            low <- middle + 1
    low.i64()

export fn first_bad_version(version_count: u64, first_bad: u64) -> i64 = first_bad_version_impl
