const MAX_OPERATIONS: usize = 256
const MAX_INPUT_LENGTH: usize = 770

def fixed_priority_queue_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255.u64()).u8()

def fixed_priority_queue_using_list_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    operation_count_value: i64 = input[0]
    if operation_count_value < 0 or operation_count_value > 256 or length != 1 + 3 * operation_count_value.usize():
        return -1
    operation_count: usize = operation_count_value.usize()
    buckets: mutable i32[3][100] = zeroed
    counts: mutable usize[3] = zeroed
    dequeued: mutable i64[128] = zeroed
    dequeued_count: mutable usize = 0
    for index in 0..<operation_count:
        opcode: i64 = input[1 + 3 * index]
        priority: i64 = input[2 + 3 * index]
        data: i64 = input[3 + 3 * index]
        if opcode == 0:
            if priority < -3 or priority > 2 or data < -2147483648 or data > 2147483647:
                return -1
            bucket: usize = if priority < 0: (priority + 3).usize() else: priority.usize()
            if counts[bucket] == 100:
                return -1
            buckets[bucket][counts[bucket]] <- data.i32()
            counts[bucket] <- counts[bucket] + 1
        else if opcode == 1:
            if priority != 0 or data != 0:
                return -1
            bucket: mutable usize = 0
            while bucket < 3 and counts[bucket] == 0:
                bucket <- bucket + 1
            if bucket == 3:
                return -1
            dequeued[dequeued_count] <- buckets[bucket][0].i64()
            dequeued_count <- dequeued_count + 1
            counts[bucket] <- counts[bucket] - 1
            for position in 0..<counts[bucket]:
                buckets[bucket][position] <- buckets[bucket][position + 1]
        else:
            return -1
    output_bytes: usize = dequeued_count * 8
    if output == null or capacity < output_bytes:
        return -2
    for index in 0..<dequeued_count:
        fixed_priority_queue_store_i64(&output[0], index * 8, dequeued[index])
    output_bytes.i64()

export fn fixed_priority_queue_using_list(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = fixed_priority_queue_using_list_impl
