const MAX_STRING_LENGTH: usize = 4096
const MAX_PACKED_LENGTH: usize = 8195

# Return the lowercase byte added to t by subtracting the two character sums.
def find_the_difference_impl(input: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_PACKED_LENGTH:
        return -1
    if input[0] < 0 or input[0] > 4096 or input[1] < 1 or input[1] > 4097:
        return -1
    s_length: usize = input[0].usize()
    t_length: usize = input[1].usize()
    if t_length != s_length + 1 or length != 2 + s_length + t_length:
        return -1
    sum_s: i64 =
        for index in 0..<s_length |total: mutable i64 = 0| -> total:
            value: i64 = input[2 + index]
            if value < 97 or value > 122:
                break -1
            total <- total + value
            total
    if sum_s < 0:
        return -1
    t_start: usize = 2 + s_length
    sum_t: i64 =
        for index in 0..<t_length |total: mutable i64 = 0| -> total:
            value: i64 = input[t_start + index]
            if value < 97 or value > 122:
                break -1
            total <- total + value
            total
    if sum_t < 0:
        return -1
    difference: i64 = sum_t - sum_s
    if difference < 97 or difference > 122:
        return -1
    difference

export fn find_the_difference(input: i64&, length: usize) -> i64 = find_the_difference_impl
