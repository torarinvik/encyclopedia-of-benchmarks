const MAX_N: i64 = 256
const DECIMAL_CAPACITY: usize = 80

fn add_decimal(left: u8&, left_length: usize, right: u8&, right_length: usize,
               result: mutable u8&) -> usize:
    reversed: mutable u8[80] = zeroed
    length: mutable usize = 0
    carry: mutable i64 = 0
    left_remaining: mutable usize = left_length
    right_remaining: mutable usize = right_length
    while left_remaining > 0 || right_remaining > 0 || carry != 0:
        left_digit: i64 = 0
        right_digit: i64 = 0
        if left_remaining > 0:
            left_remaining <- left_remaining - 1
            left_digit <- left[left_remaining].i64() - 48
        if right_remaining > 0:
            right_remaining <- right_remaining - 1
            right_digit <- right[right_remaining].i64() - 48
        sum: i64 = left_digit + right_digit + carry
        reversed[length] <- (48 + sum % 10).u8()
        length <- length + 1
        carry <- sum / 10
    i: mutable usize = 0
    while i < length:
        result[i] <- reversed[length - 1 - i]
        i <- i + 1
    result[length] <- 0
    length

fn string_fibonacci_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null || length != 1: return -1
    n: i64 = input[0]
    if n < 0 || n > MAX_N: return -1

    fib_minus_one: mutable u8[80] = zeroed
    fib_minus_two: mutable u8[80] = zeroed
    fib_minus_one[0] <- 49
    fib_minus_two[0] <- 48
    minus_one_length: mutable usize = 1
    minus_two_length: mutable usize = 1
    step: mutable usize = 0
    while step < n.usize():
        sum: mutable u8[80] = zeroed
        sum_length: usize = add_decimal(fib_minus_one, minus_one_length,
                                        fib_minus_two, minus_two_length, sum)
        i: mutable usize = 0
        while i < minus_one_length:
            fib_minus_two[i] <- fib_minus_one[i]
            i <- i + 1
        minus_two_length <- minus_one_length
        i <- 0
        while i < sum_length:
            fib_minus_one[i] <- sum[i]
            i <- i + 1
        fib_minus_one[sum_length] <- 0
        minus_one_length <- sum_length
        step <- step + 1

    if output == null || capacity < minus_two_length: return -2
    i: mutable usize = 0
    while i < minus_two_length:
        output[i] <- fib_minus_two[i]
        i <- i + 1
    minus_two_length.i64()

export fn string_fibonacci(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = string_fibonacci_impl
