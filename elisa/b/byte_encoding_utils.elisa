# Reverse the eight bytes in a 64-bit bit pattern.
def byte_encoding_utils_impl(value: i64) -> i64:
    bits: u64 = value.u64()
    reversed: u64 = ((bits & 0x00000000000000ff) << 56) | ((bits & 0x000000000000ff00) << 40) | ((bits & 0x0000000000ff0000) << 24) | ((bits & 0x00000000ff000000) << 8) | ((bits & 0x000000ff00000000) >> 8) | ((bits & 0x0000ff0000000000) >> 24) | ((bits & 0x00ff000000000000) >> 40) | ((bits & 0xff00000000000000) >> 56)
    if reversed <= 0x7fffffffffffffff:
        return reversed.i64()
    -1 - (0xffffffffffffffff - reversed).i64()

export fn byte_encoding_utils(value: i64) -> i64 = byte_encoding_utils_impl
