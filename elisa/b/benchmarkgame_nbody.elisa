extern sqrt(value: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&
struct Body:
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    mass: f64
def put_f64(output: mutable u8&, offset: usize, value: f64):
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for k in 0..<8:
        output[offset+k] <- (bits & 255).u8()
        bits <- bits >> 8
def body_energy(bodies: Body&) -> f64:
    energy: mutable f64 = 0.0
    for i in 0..<5:
        energy <- energy + 0.5*bodies[i].mass*(bodies[i].vx*bodies[i].vx+bodies[i].vy*bodies[i].vy+bodies[i].vz*bodies[i].vz)
        for j in (i+1)..<5:
            dx: f64 = bodies[i].x-bodies[j].x
            dy: f64 = bodies[i].y-bodies[j].y
            dz: f64 = bodies[i].z-bodies[j].z
            distance: f64 = sqrt(dx*dx+dy*dy+dz*dz)
            energy <- energy-(bodies[i].mass*bodies[j].mass)/distance
    energy
def benchmarkgame_nbody_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length != 1 or input[0] < 0 or input[0] > 1000: return -1
    if output == null or capacity < 16: return -2
    pi: f64 = 3.141592653589793
    solar: f64 = 4.0*pi*pi
    days: f64 = 365.24
    bodies: mutable [5]Body = zeroed
    bodies[0] = Body(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar)
    bodies[1] = Body(x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01, vx: 1.66007664274403694e-03*days, vy: 7.69901118419740425e-03*days, vz: -6.90460016972063023e-05*days, mass: 9.54791938424326609e-04*solar)
    bodies[2] = Body(x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01, vx: -2.76742510726862411e-03*days, vy: 4.99852801234917238e-03*days, vz: 2.30417297573763929e-05*days, mass: 2.85885980666130812e-04*solar)
    bodies[3] = Body(x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01, vx: 2.96460137564761618e-03*days, vy: 2.37847173959480950e-03*days, vz: -2.96589568540237556e-05*days, mass: 4.36624404335156298e-05*solar)
    bodies[4] = Body(x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01, vx: 2.68067772490389322e-03*days, vy: 1.62824170038242295e-03*days, vz: -9.51592254519715870e-05*days, mass: 5.15138902046611451e-05*solar)
    px: mutable f64 = 0.0; py: mutable f64 = 0.0; pz: mutable f64 = 0.0
    for i in 0..<5:
        px <- px+bodies[i].vx*bodies[i].mass
        py <- py+bodies[i].vy*bodies[i].mass
        pz <- pz+bodies[i].vz*bodies[i].mass
    bodies[0].vx <- -px/solar; bodies[0].vy <- -py/solar; bodies[0].vz <- -pz/solar
    initial: f64 = body_energy(bodies)
    for _ in 0..<input[0].usize():
        for i in 0..<5:
            for j in (i+1)..<5:
                dx: f64 = bodies[i].x-bodies[j].x; dy: f64 = bodies[i].y-bodies[j].y; dz: f64 = bodies[i].z-bodies[j].z
                distance: f64 = sqrt(dx*dx+dy*dy+dz*dz)
                mag: f64 = 0.01/(distance*distance*distance)
                bodies[i].vx <- bodies[i].vx-dx*bodies[j].mass*mag
                bodies[i].vy <- bodies[i].vy-dy*bodies[j].mass*mag
                bodies[i].vz <- bodies[i].vz-dz*bodies[j].mass*mag
                bodies[j].vx <- bodies[j].vx+dx*bodies[i].mass*mag
                bodies[j].vy <- bodies[j].vy+dy*bodies[i].mass*mag
                bodies[j].vz <- bodies[j].vz+dz*bodies[i].mass*mag
        for i in 0..<5:
            bodies[i].x <- bodies[i].x+0.01*bodies[i].vx
            bodies[i].y <- bodies[i].y+0.01*bodies[i].vy
            bodies[i].z <- bodies[i].z+0.01*bodies[i].vz
    put_f64(output, 0, initial)
    put_f64(output, 8, body_energy(bodies))
    16
export fn benchmarkgame_nbody(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = benchmarkgame_nbody_impl
