const MAX_N: usize = 100

def boundary_validate(nodes: i64&, count: usize, node: i64, seen: mutable bool&, reached: mutable usize&) -> bool:
    if node == -1: return true
    if node < 0 or node.u64() >= count.u64(): return false
    i: usize = node.usize()
    if seen[i]: return false
    seen[i] <- true
    reached <- reached + 1
    value: i64 = nodes[3*i]
    left: i64 = nodes[3*i+1]
    right: i64 = nodes[3*i+2]
    if value < -2147483648 or value > 2147483647 or left < -1 or right < -1: return false
    if (left >= 0 and left.u64() >= count.u64()) or (right >= 0 and right.u64() >= count.u64()): return false
    boundary_validate(nodes,count,left,seen,reached) and boundary_validate(nodes,count,right,seen,reached)

def boundary_is_leaf(nodes: i64&, i: usize) -> bool:
    nodes[3*i+1] == -1 and nodes[3*i+2] == -1

def boundary_emit_leaves(nodes: i64&, node: i64, output: mutable i64&, used: mutable usize&) -> void:
    if node == -1: return
    i: usize = node.usize()
    if boundary_is_leaf(nodes,i): output[used] <- nodes[3*i]; used <- used+1; return
    boundary_emit_leaves(nodes,nodes[3*i+1],output,used)
    boundary_emit_leaves(nodes,nodes[3*i+2],output,used)

def boundary_traversal_impl(nodes: i64&, count: usize, root: i64, output: mutable i64&, capacity: usize) -> i64:
    if count > MAX_N or capacity < count: return -1
    if count == 0: return 0 if root == -1 else -1
    if root < 0 or root.u64() >= count.u64(): return -1
    seen: mutable bool[100] = zeroed
    reached: mutable usize = 0
    if not boundary_validate(nodes,count,root,seen,reached) or reached != count: return -1
    used: mutable usize = 0
    ri: usize = root.usize()
    if not boundary_is_leaf(nodes,ri): output[used] <- nodes[3*ri]; used <- used+1
    cur: mutable i64 = nodes[3*ri+1]
    if cur == -1 and nodes[3*ri+2] != -1: cur <- nodes[3*ri+2]
    while cur != -1:
        i: usize = cur.usize()
        if not boundary_is_leaf(nodes,i): output[used] <- nodes[3*i]; used <- used+1
        cur <- if nodes[3*i+1] != -1: nodes[3*i+1] else: nodes[3*i+2]
    boundary_emit_leaves(nodes,root,output,used)
    if nodes[3*ri+2] != -1 and nodes[3*ri+1] == -1: return used.i64()
    right: mutable i64[100] = zeroed
    rn: mutable usize = 0
    cur <- nodes[3*ri+2]
    while cur != -1:
        i: usize = cur.usize()
        if not boundary_is_leaf(nodes,i): right[rn] <- nodes[3*i]; rn <- rn+1
        cur <- if nodes[3*i+2] != -1: nodes[3*i+2] else: nodes[3*i+1]
    while rn > 0: rn <- rn-1; output[used] <- right[rn]; used <- used+1
    used.i64()

export fn boundary_traversal(nodes: i64&, count: usize, root: i64, output: mutable i64&, capacity: usize) -> i64 = boundary_traversal_impl
