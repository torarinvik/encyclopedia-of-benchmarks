# Maximum profit from one buy followed by one sell.
def best_time_to_buy_and_sell_stock_impl(prices: i64&, length: usize) -> i64:
    if length > 4096:
        return -1
    if length == 0:
        return 0
    first: i64 = prices[0]
    if first < 0 or first > 1000000000:
        return -1
    minimum: mutable i32 = first.i32()
    best: mutable i64 = 0
    day: mutable usize = 1
    while day < length:
        price: i64 = prices[day]
        if price < 0 or price > 1000000000:
            return -1
        current: i32 = price.i32()
        # A new minimum gives a negative profit against the previous minimum.
        profit: i64 = current.i64() - minimum.i64()
        if current < minimum:
            minimum <- current
        if profit > best:
            best <- profit
        day <- day + 1
    best

export fn best_time_to_buy_and_sell_stock(prices: i64&, length: usize) -> i64 = best_time_to_buy_and_sell_stock_impl
