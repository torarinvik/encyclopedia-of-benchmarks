# Maximum profit from one buy followed by one sell.
def best_time_to_buy_and_sell_stock_impl(prices: i64&, length: usize) -> i64:
    if length > 4096:
        return -1
    if length == 0:
        return 0
    best: i64 =
        while day < length |day: mutable usize = 0, minimum: mutable i64 = prices[0], best: mutable i64 = 0| -> best:
            price: i64 = prices[day]
            if price < 0 or price > 1000000000:
                break -1
            if price < minimum:
                minimum <- price
            profit: i64 = price - minimum
            if profit > best:
                best <- profit
            day <- day + 1
    if best < 0:
        return -1
    best

export fn best_time_to_buy_and_sell_stock(prices: i64&, length: usize) -> i64 = best_time_to_buy_and_sell_stock_impl(prices, length)
