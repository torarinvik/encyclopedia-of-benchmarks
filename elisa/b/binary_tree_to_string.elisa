const MAX_NODES: usize = 127

def binary_tree_to_string_decimal_length(value: i64) -> usize:
    magnitude: i64 = if value < 0 then -value else value
    length: mutable usize = if value < 0 then 1 else 0
    while true:
        length <- length + 1
        magnitude <- magnitude / 10
        if magnitude == 0:
            return length
    0

def binary_tree_to_string_append_value(value: i64, output: mutable u8&, position: mutable usize&) -> void:
    magnitude: mutable i64 = if value < 0 then -value else value
    if value < 0:
        output[position] <- 45
        position <- position + 1
    digits: mutable u8[10] = zeroed
    count: mutable usize = 0
    while true:
        digit: usize = (magnitude % 10).usize()
        digits[count] <- (48 + digit).u8()
        count <- count + 1
        magnitude <- magnitude / 10
        if magnitude == 0:
            break
    while count > 0:
        count <- count - 1
        output[position] <- digits[count]
        position <- position + 1

def binary_tree_to_string_emit(values: i64&, index: usize, output: mutable u8&, position: mutable usize&) -> void:
    base: usize = 2 + 3 * index
    left: i64 = values[base + 1]
    right: i64 = values[base + 2]
    binary_tree_to_string_append_value(values[base], output, position)
    if left >= 0:
        output[position] <- 40
        position <- position + 1
        binary_tree_to_string_emit(values, left.usize(), output, position)
        output[position] <- 41
        position <- position + 1
    else if right >= 0:
        output[position] <- 40
        position <- position + 1
        output[position] <- 41
        position <- position + 1
    if right >= 0:
        output[position] <- 40
        position <- position + 1
        binary_tree_to_string_emit(values, right.usize(), output, position)
        output[position] <- 41
        position <- position + 1

def binary_tree_to_string_valid(values: i64&, count: usize, root: usize) -> bool:
    parents: mutable usize[127] = zeroed
    seen: mutable bool[127] = zeroed
    stack: mutable usize[127] = zeroed
    for index in 0..<count:
        base: usize = 2 + 3 * index
        value: i64 = values[base]
        left: i64 = values[base + 1]
        right: i64 = values[base + 2]
        if value < -2147483648 or value > 2147483647 or left < -1 or right < -1:
            return false
        if (left >= 0 and left.u64() >= count.u64()) or (right >= 0 and right.u64() >= count.u64()):
            return false
        if left >= 0:
            child: usize = left.usize()
            parents[child] <- parents[child] + 1
            if parents[child] > 1:
                return false
        if right >= 0:
            child: usize = right.usize()
            parents[child] <- parents[child] + 1
            if parents[child] > 1:
                return false
    for index in 0..<count:
        if parents[index] != (if index == root then 0 else 1):
            return false
    top: mutable usize = 1
    visited: mutable usize = 0
    stack[0] <- root
    while top > 0:
        top <- top - 1
        index: usize = stack[top]
        if seen[index]:
            return false
        seen[index] <- true
        visited <- visited + 1
        base: usize = 2 + 3 * index
        left: i64 = values[base + 1]
        right: i64 = values[base + 2]
        if left >= 0:
            stack[top] <- left.usize()
            top <- top + 1
        if right >= 0:
            stack[top] <- right.usize()
            top <- top + 1
    visited == count

def binary_tree_to_string_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2:
        return -1
    if values[0] < 0 or values[0] > MAX_NODES.i64():
        return -1
    count: usize = values[0].usize()
    if length != 2 + 3 * count:
        return -1
    root_value: i64 = values[1]
    if count == 0:
        return 0 if root_value == -1 else -1
    if root_value < 0 or root_value.u64() >= count.u64():
        return -1
    root: usize = root_value.usize()
    if not binary_tree_to_string_valid(values, count, root):
        return -1
    required: mutable usize = 2 * (count - 1)
    for index in 0..<count:
        base: usize = 2 + 3 * index
        required <- required + binary_tree_to_string_decimal_length(values[base])
        if values[base + 1] == -1 and values[base + 2] >= 0:
            required <- required + 2
    if output_capacity < required:
        return -2
    position: mutable usize = 0
    binary_tree_to_string_emit(values, root, output, position)
    position.i64()

export fn binary_tree_to_string(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = binary_tree_to_string_impl
