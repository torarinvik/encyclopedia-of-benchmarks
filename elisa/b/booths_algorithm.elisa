def booths_algorithm_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values == null or length == 0 or length > 256:
        return -1
    index: mutable usize = 0
    while index < length:
        if values[index] < 0 or values[index] > 127:
            return -1
        index <- index + 1
    if output == null or capacity < length:
        return -2

    failure: mutable i64[512] = zeroed
    index <- 0
    while index < 2 * length:
        failure[index] <- -1
        index <- index + 1
    start: mutable usize = 0
    j: mutable usize = 1
    while j < 2 * length:
        current: i64 = values[j % length]
        matched: mutable i64 = failure[j - start - 1]
        while matched != -1 and current != values[(start + matched.usize() + 1) % length]:
            if current < values[(start + matched.usize() + 1) % length]:
                start <- j - matched.usize() - 1
            matched <- failure[matched.usize()]
        if matched == -1 and current != values[start % length]:
            if current < values[start % length]:
                start <- j
            failure[j - start] <- -1
        else:
            failure[j - start] <- matched + 1
        j <- j + 1

    index <- 0
    while index < length:
        output[index] <- values[(start + index) % length].u8()
        index <- index + 1
    length.i64()

export fn booths_algorithm(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = booths_algorithm_impl
