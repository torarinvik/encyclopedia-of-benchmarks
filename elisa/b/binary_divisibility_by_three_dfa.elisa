# Decide binary divisibility by three with a three-state streaming DFA.
const BINARY_DIVISIBILITY_MAX_BITS: usize = 4096
const BINARY_DIVISIBILITY_MAX_INPUT_LENGTH: usize = 4098

def binary_divisibility_by_three_dfa_impl(
    input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize
) -> i64:
    if input.is_null() or input_length == 0
            or input_length > BINARY_DIVISIBILITY_MAX_INPUT_LENGTH: return -1
    input_view: view[i64] = input[0:input_length]
    bit_count: i64 = input_view[0]
    if bit_count < 1 or bit_count > 4096
            or input_length != bit_count.usize() + 1: return -1
    remainder: mutable i64 = 0
    index: mutable usize = 1
    while index < input_length:
        bit: i64 = input_view[index]
        if bit != 0 and bit != 1: return -1
        remainder <- (2 * remainder + bit) % 3
        index <- index + 1
    if output.is_null() or output_capacity < 1: return -2

    output_view: mutable view[u8] = output[0:1]
    output_view[0] <- if remainder == 0: 1 else: 0
    1

export fn binary_divisibility_by_three_dfa(
    input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize
) -> i64 = binary_divisibility_by_three_dfa_impl
