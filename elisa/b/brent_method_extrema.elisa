extern cos(value: f64) -> f64
extern sqrt(value: f64) -> f64

const EPSILON: f64 = 1.4901161193847656e-8
const PI: f64 = 3.141592653589793238462643383279502884
const TWO_PI: f64 = 2.0 * PI
const THREE_PI: f64 = 3.0 * PI

def absolute(value: f64) -> f64:
    if value < 0.0:
        return -value
    value

def objective_value(x: f64, objective_id: f64) -> f64:
    if objective_id == 0.0:
        offset: f64 = x - 2.0
        return offset * offset
    if objective_id == 0.5:
        return cos(x)
    -cos(x)

def has_valid_bracket(low: f64, high: f64, objective_id: f64) -> bool:
    if objective_id == 0.0:
        return low < 2.0 and 2.0 < high
    if objective_id == 0.5:
        return low >= 0.0 and high <= TWO_PI and low < PI and PI < high
    objective_id == 1.0 and low >= PI and high <= THREE_PI and low < TWO_PI and TWO_PI < high

def brent_method_extrema_impl(start: f64, end: f64, objective_id: f64) -> f64:
    if (start != start or end != end or objective_id != objective_id or
       start < -10.0 or start > 10.0 or end < -10.0 or end > 10.0):
        return -1.0
    a: mutable f64 = start
    b: mutable f64 = end
    if a > b:
        swap: f64 = a
        a <- b
        b <- swap
    if (b - a <= EPSILON or
       (objective_id != 0.0 and objective_id != 0.5 and objective_id != 1.0) or
       not has_valid_bracket(a, b, objective_id)):
        return -1.0

    golden_ratio: f64 = (3.0 - sqrt(5.0)) / 2.0
    v: mutable f64 = a + golden_ratio * (b - a)
    w: mutable f64 = v
    x: mutable f64 = v
    fv: mutable f64 = objective_value(v, objective_id)
    fw: mutable f64 = fv
    fx: mutable f64 = fv
    p: mutable f64 = 0.0
    q: mutable f64 = 0.0
    r: mutable f64 = 0.0
    d: mutable f64 = 0.0
    e: mutable f64 = 0.0

    for iteration in 0..<256:
        midpoint: f64 = (a + b) / 2.0
        tolerance: f64 = EPSILON * absolute(x)
        tolerance2: f64 = 2.0 * tolerance
        if absolute(e) > tolerance2:
            r <- (x - w) * (fx - fv)
            q <- (x - v) * (fx - fw)
            p <- (x - v) * q - (x - w) * r
            q <- 2.0 * (q - r)
            if q > 0.0:
                p <- -p
            else:
                q <- -q
            r <- e
            e <- d
        if absolute(p) < absolute(0.5 * q * r) and p < q * (b - x):
            d <- p / q
            u: f64 = x + d
            if u - a < tolerance2 or b - u < tolerance2:
                if x < midpoint:
                    d <- tolerance
                else:
                    d <- -tolerance
        else:
            if x < midpoint:
                e <- b - x
            else:
                e <- a - x
            d <- golden_ratio * e
        u: mutable f64 = d
        if absolute(d) < tolerance:
            if d > 0.0:
                u <- tolerance
            else:
                u <- -tolerance
        u <- u + x
        fu: f64 = objective_value(u, objective_id)
        if fu <= fx:
            if u < x:
                b <- x
            else:
                a <- x
            v <- w
            fv <- fw
            w <- x
            fw <- fx
            x <- u
            fx <- fu
        else:
            if u < x:
                a <- u
            else:
                b <- u
            if fu <= fw or x == w:
                v <- w
                fv <- fw
                w <- u
                fw <- fu
            elif fu <= fv or v == x or v == w:
                v <- u
                fv <- fu
        if not (absolute(x - midpoint) > tolerance - (b - a) / 2.0):
            return x
    x

export fn brent_method_extrema(start: f64, end: f64, objective_id: f64) -> f64 = brent_method_extrema_impl
