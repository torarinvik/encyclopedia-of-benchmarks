# Check whether the process/resource state has a safe completion order.
def bankers_algorithm_impl(values: i64&, length: usize) -> i64:
    if length < 5 or length > 266: return -1
    process_value: i64 = values[0]
    resource_value: i64 = values[1]
    if process_value < 1 or process_value > 16 or resource_value < 1 or resource_value > 8: return -1
    processes: usize = process_value.usize()
    resources: usize = resource_value.usize()
    maximum_offset: usize = 2 + resources
    allocation_offset: usize = maximum_offset + processes * resources
    if length != allocation_offset + processes * resources: return -1
    work: mutable i64[8] = zeroed
    for resource in 0..<resources:
        available: i64 = values[2 + resource]
        if available < 0 or available > 100: return -1
        work[resource] <- available
    for process in 0..<processes:
        for resource in 0..<resources:
            index: usize = process * resources + resource
            maximum: i64 = values[maximum_offset + index]
            allocation: i64 = values[allocation_offset + index]
            if maximum < 0 or maximum > 100 or allocation < 0 or allocation > maximum: return -1
    finished: mutable bool[16] = zeroed
    completed: mutable usize = 0
    while completed < processes:
        progress: mutable bool = false
        for process in 0..<processes:
            if finished[process]: continue
            feasible: mutable bool = true
            for resource in 0..<resources:
                index: usize = process * resources + resource
                need: i64 = values[maximum_offset + index] - values[allocation_offset + index]
                if need > work[resource]: feasible <- false; break
            if feasible:
                for resource in 0..<resources:
                    work[resource] <- work[resource] + values[allocation_offset + process * resources + resource]
                finished[process] <- true
                completed <- completed + 1
                progress <- true
        if not progress: return 0
    1

export fn bankers_algorithm(values: i64&, length: usize) -> i64 = bankers_algorithm_impl
