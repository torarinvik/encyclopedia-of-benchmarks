const MAX_VERTICES: usize = 64
const MAX_EDGES: usize = 256
const MAX_INPUT_LENGTH: usize = 2 + 2 * MAX_EDGES
const MAX_CELLS: usize = MAX_VERTICES * MAX_VERTICES

def bipartite_graph_dfs_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH: return -1
    if input[0] < 1 or input[0] > MAX_VERTICES.i64() or input[1] < 0 or input[1] > MAX_EDGES.i64(): return -1
    n: usize = input[0].usize()
    m: usize = input[1].usize()
    if length != 2 + 2 * m: return -1

    adjacency: mutable bool[MAX_CELLS] = zeroed
    edge: mutable usize = 0
    while edge < m:
        from_value: i64 = input[2 + 2 * edge]
        to_value: i64 = input[3 + 2 * edge]
        if from_value < 0 or from_value >= n.i64() or to_value < 0 or to_value >= n.i64(): return -1
        from: usize = from_value.usize()
        to: usize = to_value.usize()
        adjacency[from * n + to] <- true
        adjacency[to * n + from] <- true
        edge <- edge + 1

    color: mutable i64[MAX_VERTICES] = zeroed
    stack: mutable usize[MAX_VERTICES] = zeroed
    index: mutable usize = 0
    while index < n: color[index] <- -1; index <- index + 1
    start: mutable usize = 0
    while start < n:
        if color[start] == -1:
            top: mutable usize = 1
            stack[0] <- start
            color[start] <- 0
            while top > 0:
                top <- top - 1
                node: usize = stack[top]
                neighbor: mutable usize = 0
                while neighbor < n:
                    if adjacency[node * n + neighbor]:
                        if color[neighbor] == -1:
                            color[neighbor] <- 1 - color[node]
                            stack[top] <- neighbor
                            top <- top + 1
                        else if color[neighbor] == color[node]: return 0
                    neighbor <- neighbor + 1
        start <- start + 1
    1

export fn bipartite_graph_dfs(input: i64&, length: usize) -> i64 = bipartite_graph_dfs_impl
