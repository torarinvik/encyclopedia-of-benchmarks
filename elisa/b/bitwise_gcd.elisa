@intrinsic("llvm.cttz.i64")
extern trailing_zeros(value: u64, zero_undefined: bool) -> u64

def bitwise_gcd_impl(left: u64, right: u64) -> i64:
    if left == 0 or right == 0 or left == right:
        return (left | right).i64()

    common_twos: u64 = trailing_zeros(left | right, true)
    a: mutable u64 = left >> trailing_zeros(left, true)
    b: mutable u64 = right
    while b != 0:
        b <- b >> trailing_zeros(b, true)
        if a > b:
            temp: u64 = a
            a <- b
            b <- temp
        b <- b - a
    (a << common_twos).i64()

export fn bitwise_gcd(left: u64, right: u64) -> i64 = bitwise_gcd_impl
