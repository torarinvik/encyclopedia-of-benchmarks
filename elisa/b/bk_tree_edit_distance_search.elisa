const BK_TREE_MAX_WORDS: usize = 16
const BK_TREE_MAX_QUERIES: usize = 8
const BK_TREE_MAX_WORD_LENGTH: usize = 10
const BK_TREE_MAX_PARSEABLE: usize = 28

def bk_tree_valid_word(word: i64) -> bool:
    if word < 0: return false
    packed_value: u64 = word.u64()
    if (packed_value >> 44) != 0: return false
    word_length: usize = ((packed_value >> 40) & 15).usize()
    if word_length > BK_TREE_MAX_WORD_LENGTH: return false
    position: mutable usize = 0
    while position < BK_TREE_MAX_WORD_LENGTH:
        symbol: usize = ((packed_value >> (4 * position)) & 15).usize()
        if position < word_length:
            if symbol == 0: return false
        elif symbol != 0:
            return false
        position <- position + 1
    true

def bk_tree_edit_distance(left: i64, right: i64) -> usize:
    a: u64 = left.u64()
    b: u64 = right.u64()
    n: usize = ((a >> 40) & 15).usize()
    m: usize = ((b >> 40) & 15).usize()
    previous: mutable usize[11] = zeroed
    current: mutable usize[11] = zeroed
    j: mutable usize = 0
    while j <= m:
        previous[j] <- j
        j <- j + 1
    i: mutable usize = 1
    while i <= n:
        current[0] <- i
        a_symbol: usize = ((a >> (4 * (i - 1))) & 15).usize()
        j <- 1
        while j <= m:
            b_symbol: usize = ((b >> (4 * (j - 1))) & 15).usize()
            deletion: usize = previous[j] + 1
            insertion: usize = current[j - 1] + 1
            replacement: mutable usize = previous[j - 1]
            if a_symbol != b_symbol: replacement <- replacement + 1
            best:mutable  mutable usize = deletion
            if insertion < best: best <- insertion
            if replacement < best: best <- replacement
            current[j] <- best
            j <- j + 1
        j <- 0
        while j <= m:
            previous[j] <- current[j]
            j <- j + 1
        i <- i + 1
    previous[m]

def bk_tree_edit_distance_search_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 3 or input_length > BK_TREE_MAX_PARSEABLE: return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    radius_value: i64 = input[2]
    if n_value < 0 or n_value > BK_TREE_MAX_WORDS.i64()
        or q_value < 0 or q_value > BK_TREE_MAX_QUERIES.i64()
        or radius_value < 0 or radius_value > 3: return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    radius: usize = radius_value.usize()
    if input_length != 3 + n + q: return -1
    i: mutable usize = 0
    while i < n + q:
        if not bk_tree_valid_word(input[3 + i]): return -1
        i <- i + 1
    i <- 0
    while i < n:
        j: mutable usize = 0
        while j < i:
            if input[3 + i] == input[3 + j]: return -1
            j <- j + 1
        i <- i + 1

    children: mutable i32[176] = zeroed
    i <- 0
    while i < 176:
        children[i] <- -1
        i <- i + 1
    node: mutable usize = 1
    while node < n:
        pivot: mutable usize = 0
        while true:
            edge: usize = bk_tree_edit_distance(input[3 + node], input[3 + pivot])
            slot: usize = pivot * 11 + edge
            if children[slot] == -1:
                children[slot] <- node.i32()
                break
            pivot <- children[slot].usize()
        node <- node + 1

    result: mutable i64 = 0
    query_index: mutable usize = 0
    while query_index < q:
        matches: mutable i64 = 0
        index_sum: mutable i64 = 0
        if n != 0:
            stack_value: mutable usize[16] = zeroed
            top: mutable usize = 1
            stack_value[0] <- 0
            while top != 0:
                top <- top - 1
                current_node: usize = stack_value[top]
                distance: usize = bk_tree_edit_distance(input[3 + n + query_index], input[3 + current_node])
                if distance <= radius:
                    matches <- matches + 1
                    index_sum <- index_sum + current_node.i64()
                low: mutable usize = 0
                if distance > radius: low <- distance - radius
                high: mutable usize = distance + radius
                if high > BK_TREE_MAX_WORD_LENGTH: high <- BK_TREE_MAX_WORD_LENGTH
                edge: mutable usize = low
                while edge <= high:
                    child: i32 = children[current_node * 11 + edge]
                    if child >= 0:
                        stack_value[top] <- child.usize()
                        top <- top + 1
                    edge <- edge + 1
        result <- result + (query_index.i64() + 1) * (17 * matches + index_sum)
        query_index <- query_index + 1
    result

def bk_tree_edit_distance_search_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 3 or length > BK_TREE_MAX_PARSEABLE: return -1
    bk_tree_edit_distance_search_impl(input, length)

export fn bk_tree_edit_distance_search(input: i64&, length: usize) -> i64 = bk_tree_edit_distance_search_entry
