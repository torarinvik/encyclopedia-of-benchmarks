# Integer-threshold maximum-average search over a bounded input view.
const MAX_AVG_N: usize = 32
const MAX_AVG_INPUT: usize = 35
const INVALID_AVG_RESULT: i64 = -1_000_001

def avg_threshold_feasible(values: view[i64], n: usize, minimum_length: usize, threshold: i64) -> bool:
    prefix: mutable i64[33] = zeroed
    index: mutable usize = 0
    while index < n:
        prefix[index + 1] <- prefix[index] + 1000 * values[index + 2] - threshold
        index <- index + 1

    minimum_prefix: mutable i64 = 9_223_372_036_854_775_807
    end: mutable usize = minimum_length
    while end <= n:
        eligible_start: usize = end - minimum_length
        if prefix[eligible_start] < minimum_prefix:
            minimum_prefix <- prefix[eligible_start]
        if prefix[end] >= minimum_prefix: return true
        end <- end + 1
    false

def binary_search_maximum_average_segment_impl(values: view[i64], length: usize) -> i64:
    if length < 3 or length > MAX_AVG_INPUT or values.len() != length: return INVALID_AVG_RESULT
    n_value: i64 = values[0]
    minimum_value: i64 = values[1]
    if n_value < 1 or n_value > MAX_AVG_N.i64() or minimum_value < 1 or minimum_value > n_value:
        return INVALID_AVG_RESULT
    n: usize = n_value.usize()
    if length != n + 2: return INVALID_AVG_RESULT
    index: mutable usize = 0
    while index < n:
        if values[index + 2] < -1000 or values[index + 2] > 1000: return INVALID_AVG_RESULT
        index <- index + 1

    low: mutable i64 = -1_000_000
    high: mutable i64 = 1_000_001
    while high - low > 1:
        middle: i64 = low + (high - low) // 2
        if avg_threshold_feasible(values, n, minimum_value.usize(), middle):
            low <- middle
        else:
            high <- middle
    low

export fn binary_search_maximum_average_segment(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_AVG_INPUT: return INVALID_AVG_RESULT
    let values: view[i64] = input[0:length]
    binary_search_maximum_average_segment_impl(values, length)
