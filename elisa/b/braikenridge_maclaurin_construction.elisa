# Compute the six exact 5x5 determinant coefficients of a conic.
def braikenridge_determinant(features: i64[30], coefficient: usize) -> i64:
    columns: i64[30] = [1, 2, 3, 4, 5, 0, 2, 3, 4, 5, 0, 1, 3, 4, 5, 0, 1, 2, 4, 5, 0, 1, 2, 3, 5, 0, 1, 2, 3, 4]
    paths: mutable i64[32] = zeroed
    paths[0] <- 1
    row: mutable usize = 0
    while row < 5:
        next: mutable i64[32] = zeroed
        mask: mutable usize = 0
        while mask < 32:
            selected: mutable usize = 0
            bit_index: mutable usize = 0
            while bit_index < 5:
                selected <- selected + ((mask >> bit_index) & 1)
                bit_index <- bit_index + 1
            if selected == row and paths[mask] != 0:
                column: mutable usize = 0
                while column < 5:
                    bit: usize = 1 << column
                    if (mask & bit) == 0:
                        inversions: mutable usize = 0
                        previous: mutable usize = column + 1
                        while previous < 5:
                            inversions <- inversions + ((mask >> previous) & 1)
                            previous <- previous + 1
                        feature_column: usize = coefficient * 5 + column
                        feature_index: usize = row * 6 + columns[feature_column].usize()
                        term: i64 = paths[mask] * features[feature_index]
                        if (inversions & 1) == 0:
                            next[mask | bit] <- next[mask | bit] + term
                        else:
                            next[mask | bit] <- next[mask | bit] - term
                    column <- column + 1
            mask <- mask + 1
        mask <- 0
        while mask < 32:
            paths[mask] <- next[mask]
            mask <- mask + 1
        row <- row + 1
    paths[31]

def braikenridge_maclaurin_construction_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length != 10:
        return -2
    features: mutable i64[30] = zeroed
    point: mutable usize = 0
    while point < 5:
        x: i64 = values[2 * point]
        y: i64 = values[2 * point + 1]
        if x < -10 or x > 10 or y < -10 or y > 10:
            return -2
        features[point * 6] <- x * x
        features[point * 6 + 1] <- x * y
        features[point * 6 + 2] <- y * y
        features[point * 6 + 3] <- x
        features[point * 6 + 4] <- y
        features[point * 6 + 5] <- 1
        point <- point + 1
    coefficients: mutable i64[6] = zeroed
    index: mutable usize = 0
    while index < 6:
        value: i64 = braikenridge_determinant(features, index)
        if index % 2 == 0:
            coefficients[index] <- value
        else:
            coefficients[index] <- -value
        index <- index + 1
    if output_capacity < 48:
        return -2
    index <- 0
    while index < 6:
        bits: i64 = coefficients[index]
        byte: mutable usize = 0
        while byte < 8:
            output[index * 8 + byte] <- ((bits >> (byte * 8)) & 255).u8()
            byte <- byte + 1
        index <- index + 1
    6

export fn braikenridge_maclaurin_construction(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = braikenridge_maclaurin_construction_impl
