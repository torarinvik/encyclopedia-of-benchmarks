# Exclusive integer scan using bounded upsweep and downsweep levels.
def blelloch_parallel_prefix_scan_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > 66: return -1
    values: i64& = input
    n64: i64 = values[0]
    if n64 < 1 or n64 > 64: return -1
    n: usize = n64.usize()
    if length != n + 1: return -1

    tree: mutable i64[64] = zeroed
    padded: mutable usize = 1
    while padded < n:
        padded <- padded << 1
    for i in 0..<n:
        value: i64 = values[i + 1]
        if value < -1000000 or value > 1000000: return -1
        tree[i] <- value
    output_bytes: usize = n * 8
    if output == null or output_capacity < output_bytes: return -2

    stride: mutable usize = 2
    while stride <= padded:
        half: usize = stride >> 1
        right: mutable usize = stride - 1
        while right < padded:
            tree[right] <- tree[right] + tree[right - half]
            right <- right + stride
        stride <- stride << 1
    tree[padded - 1] <- 0
    stride <- padded
    while stride >= 2:
        half: usize = stride >> 1
        right: mutable usize = stride - 1
        while right < padded:
            left: usize = right - half
            partial: i64 = tree[left]
            tree[left] <- tree[right]
            tree[right] <- tree[right] + partial
            right <- right + stride
        stride <- stride >> 1

    result: mutable u8& = output
    for i in 0..<n:
        bits: u64 = tree[i].u64()
        for byte in 0..<8:
            result[i * 8 + byte] <- ((bits >> (byte * 8)) & 255).u8()
    output_bytes.i64()

export fn blelloch_parallel_prefix_scan(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = blelloch_parallel_prefix_scan_impl
