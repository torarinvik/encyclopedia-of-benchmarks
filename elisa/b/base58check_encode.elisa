const MAX_WORDS: usize = 35
const MAX_PAYLOAD: usize = 32
const MAX_BASE58: usize = 51
const ALPHABET = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"

def base58_add32(left: u32, right: u32) -> u32:
    ((left.u64() + right.u64()) & 0xFFFF_FFFF.u64()).u32()

def base58_rotr(value: u32, amount: usize) -> u32:
    (value >> amount) | (value << (32 - amount))

def base58_sha256(input: view[u8], length: usize, output: mutable view[u8]):
    constants: u32[64] = [
        0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
        0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
        0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
        0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
        0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
        0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
        0x19A4C116,0x1E376C08,0x2748774C,0x34B0BCB5,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
        0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2]
    padded: mutable u8[64] = zeroed
    for index in 0..<length:
        padded[index] <- input[index]
    padded[length] <- 128
    bit_length: u64 = length.u64() * 8
    for index in 0..<8:
        padded[63 - index] <- ((bit_length >> (8 * index)) & 255).u8()
    state: mutable u32[8] = [0x6A09E667,0xBB67AE85,0x3C6EF372,0xA54FF53A,0x510E527F,0x9B05688C,0x1F83D9AB,0x5BE0CD19]
    words: mutable u32[64] = zeroed
    for index in 0..<16:
        position: usize = index * 4
        words[index] <- (padded[position].u32() << 24) | (padded[position + 1].u32() << 16) | (padded[position + 2].u32() << 8) | padded[position + 3].u32()
    for index in 16..<64:
        x: u32 = words[index - 15]
        y: u32 = words[index - 2]
        small0: u32 = base58_rotr(x, 7) ^ base58_rotr(x, 18) ^ (x >> 3)
        small1: u32 = base58_rotr(y, 17) ^ base58_rotr(y, 19) ^ (y >> 10)
        words[index] <- base58_add32(base58_add32(base58_add32(small1, words[index - 7]), small0), words[index - 16])
    a: mutable u32 = state[0]
    b: mutable u32 = state[1]
    c: mutable u32 = state[2]
    d: mutable u32 = state[3]
    e: mutable u32 = state[4]
    f: mutable u32 = state[5]
    g: mutable u32 = state[6]
    h: mutable u32 = state[7]
    for index in 0..<64:
        big1: u32 = base58_rotr(e, 6) ^ base58_rotr(e, 11) ^ base58_rotr(e, 25)
        choose: u32 = (e & f) ^ ((~e) & g)
        first: u32 = base58_add32(base58_add32(base58_add32(base58_add32(h, big1), choose), constants[index]), words[index])
        big0: u32 = base58_rotr(a, 2) ^ base58_rotr(a, 13) ^ base58_rotr(a, 22)
        majority: u32 = (a & b) ^ (a & c) ^ (b & c)
        second: u32 = base58_add32(big0, majority)
        h <- g
        g <- f
        f <- e
        e <- base58_add32(d, first)
        d <- c
        c <- b
        b <- a
        a <- base58_add32(first, second)
    state[0] <- base58_add32(state[0], a)
    state[1] <- base58_add32(state[1], b)
    state[2] <- base58_add32(state[2], c)
    state[3] <- base58_add32(state[3], d)
    state[4] <- base58_add32(state[4], e)
    state[5] <- base58_add32(state[5], f)
    state[6] <- base58_add32(state[6], g)
    state[7] <- base58_add32(state[7], h)
    for word in 0..<8:
        for byte in 0..<4:
            output[word * 4 + byte] <- ((state[word] >> (24 - 8 * byte)) & 255).u8()

def base58check_encode_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2 or length > MAX_WORDS:
        return -1
    version: i64 = input[0]
    payload_value: i64 = input[1]
    if version < 0 or version > 255 or payload_value < 0 or payload_value > 32:
        return -1
    payload_length: usize = payload_value.usize()
    if length != payload_length + 2:
        return -1
    message: mutable u8[33] = zeroed
    first_digest: mutable u8[32] = zeroed
    second_digest: mutable u8[32] = zeroed
    raw: mutable u8[37] = zeroed
    message[0] <- version.u8()
    raw[0] <- version.u8()
    for index in 0..<payload_length:
        byte: i64 = input[index + 2]
        if byte < 0 or byte > 255:
            return -1
        message[index + 1] <- byte.u8()
        raw[index + 1] <- byte.u8()
    message_length: usize = payload_length + 1
    base58_sha256(message[0:message_length], message_length, first_digest[0:32])
    second_input: mutable u8[33] = zeroed
    for index in 0..<32:
        second_input[index] <- first_digest[index]
    base58_sha256(second_input[0:32], 32, second_digest[0:32])
    raw_length: usize = message_length + 4
    for index in 0..<4:
        raw[message_length + index] <- second_digest[index]
    leading_zeroes: mutable usize = 0
    while leading_zeroes < raw_length and raw[leading_zeroes] == 0:
        leading_zeroes <- leading_zeroes + 1
    digits: mutable u8[MAX_BASE58] = zeroed
    digit_count: mutable usize = 0
    for index in leading_zeroes..<raw_length:
        carry: mutable u32 = raw[index].u32()
        for digit in 0..<digit_count:
            carry <- carry + digits[digit].u32() * 256
            digits[digit] <- (carry % 58).u8()
            carry <- carry / 58
        while carry > 0:
            digits[digit_count] <- (carry % 58).u8()
            digit_count <- digit_count + 1
            carry <- carry / 58
    encoded_length: usize = leading_zeroes + digit_count
    if output_capacity < encoded_length:
        return -2
    written: mutable usize = 0
    while written < leading_zeroes:
        output[written] <- 49.u8()
        written <- written + 1
    while digit_count > 0:
        digit_count <- digit_count - 1
        output[written] <- ALPHABET[digits[digit_count]].u8()
        written <- written + 1
    encoded_length.i64()

def base58check_encode_entry(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > MAX_WORDS:
        return -1
    if output == null:
        scratch: mutable u8[1] = zeroed
        return base58check_encode_impl(input, length, &scratch[0], 0)
    writable_length: mutable usize = output_capacity
    if writable_length > MAX_BASE58:
        writable_length <- MAX_BASE58
    base58check_encode_impl(input, length,
        output, output_capacity)

export fn base58check_encode(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = base58check_encode_entry
