# Count low-order zero bits, like __builtin_ctzll.
@intrinsic("llvm.cttz.i64")
extern count_trailing_zeros(value: u64, zero_undefined: bool) -> u64

def binary_count_trailing_zeros_impl(n: i64) -> i64:
    if n <= 0:
        return -1 if n < 0 else 0
    count_trailing_zeros(n.u64(), true).i64()

export fn binary_count_trailing_zeros(n: i64) -> i64 = binary_count_trailing_zeros_impl
