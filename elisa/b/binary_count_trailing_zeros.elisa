# Count the ones in the mask below the lowest set bit. The parallel population
# count gives LLVM a portable pattern for its trailing-zero instruction.
def binary_count_trailing_zeros_impl(n: i64) -> i64:
    if n <= 0:
        return -1 if n < 0 else 0
    value: u64 = n.u64()
    low_bits: u64 = (value - 1) & ~value
    pairs: u64 = low_bits - ((low_bits >> 1) & 0x5555555555555555.u64())
    nibbles: u64 = (pairs & 0x3333333333333333.u64()) + ((pairs >> 2) & 0x3333333333333333.u64())
    bytes: u64 = (nibbles + (nibbles >> 4)) & 0x0f0f0f0f0f0f0f0f.u64()
    ((bytes * 0x0101010101010101.u64()) >> 56).i64()

export fn binary_count_trailing_zeros(n: i64) -> i64 = binary_count_trailing_zeros_impl
