const MAX_N: usize = 8
const MAX_REQUESTS: usize = 32
const MAX_INPUT: usize = 82
const MAX_OUTPUT_BYTES: usize = 392

def comb_store64(output: mutable view[u8], offset: usize, value: i64): void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def comb_list_update_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize): i64:
    if input.is_null() or length < 4 or length > MAX_INPUT: return -1
    n_raw: i64 = input[0]
    requests_raw: i64 = input[1]
    if n_raw < 1 or n_raw > MAX_N.i64() or requests_raw < 0 or requests_raw > MAX_REQUESTS.i64(): return -1
    n: usize = n_raw.usize()
    request_count: usize = requests_raw.usize()
    if length != 2 + 2 * n + 2 * request_count: return -1
    order: mutable usize[MAX_N] = zeroed
    seen: mutable bool[MAX_N] = zeroed
    for i in 0..<n:
        page: i64 = input[2 + i]
        if page < 0 or page >= n_raw or seen[page.usize()]: return -1
        order[i] <- page.usize()
        seen[page.usize()] <- true
    request_ids: mutable usize[MAX_REQUESTS] = zeroed
    for i in 0..<request_count:
        page: i64 = input[2 + n + i]
        if page < 0 or page >= n_raw: return -1
        request_ids[i] <- page.usize()
    bits: mutable i64[MAX_N] = zeroed
    for i in 0..<n:
        bit: i64 = input[2 + n + request_count + i]
        if bit != 0 and bit != 1: return -1
        bits[i] <- bit
    modes: mutable usize[MAX_REQUESTS] = zeroed
    for i in 0..<request_count:
        mode: i64 = input[2 + 2 * n + request_count + i]
        if mode < 0 or mode > 4: return -1
        modes[i] <- mode.usize()
    last_request: mutable i64[MAX_N] = zeroed
    for i in 0..<n: last_request[i] <- -1
    positions: mutable i64[MAX_REQUESTS] = zeroed
    total_cost: mutable i64 = 0
    for time in 0..<request_count:
        page: usize = request_ids[time]
        position: mutable usize = 0
        while position < n and order[position] != page: position <- position + 1
        if position == n: return -1
        positions[time] <- (position + 1).i64()
        total_cost <- total_cost + (position + 1).i64()
        if modes[time] < 4:
            bits[page] <- bits[page] ^ 1
            if bits[page] == 1 and position > 0:
                shift: mutable usize = position
                while shift > 0:
                    order[shift] <- order[shift - 1]
                    shift <- shift - 1
                order[0] <- page
        elif last_request[page] >= 0:
            for target in 0..<position:
                candidate: usize = order[target]
                occurrences: mutable usize = 0
                for t in (last_request[page].usize() + 1)..<time:
                    if request_ids[t] == candidate: occurrences <- occurrences + 1
                if occurrences <= 1:
                    shift: mutable usize = position
                    while shift > target:
                        order[shift] <- order[shift - 1]
                        shift <- shift - 1
                    order[target] <- page
                    break
        last_request[page] <- time.i64()
    words: mutable i64[1 + 2 * MAX_N + MAX_REQUESTS] = zeroed
    words[0] <- total_cost
    for i in 0..<n: words[1 + i] <- order[i].i64()
    for i in 0..<request_count: words[1 + n + i] <- positions[i]
    for i in 0..<n: words[1 + n + request_count + i] <- bits[i]
    output_bytes: usize = 8 * (1 + 2 * n + request_count)
    if output.is_null() or capacity < output_bytes: return -2
    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    for word in 0..<(1 + 2 * n + request_count): comb_store64(staged[0:output_bytes], 8 * word, words[word])
    for byte in 0..<output_bytes: output[byte] <- staged[byte]
    output_bytes.i64()

export fn comb_list_update(input: i64&, length: usize, output: mutable u8&, capacity: usize): i64 = comb_list_update_impl
