# Eagerly materialize a BST's in-order sequence, then consume it through an iterator.
def bst_iterator_impl(nodes: i64&, node_count: usize, root_index: i64) -> i64:
    if node_count > 1023:
        return -1
    if node_count == 0:
        return 0 if root_index == -1 else -1
    if root_index < 0 or root_index.u64() >= node_count.u64():
        return -1
    iterator_values: mutable i64[1023] = zeroed
    traversal_stack: mutable usize[1023] = zeroed
    top: mutable usize = 0
    value_count: mutable usize = 0
    current: mutable i64 = root_index
    while current != -1 or top != 0:
        while current != -1:
            if current < 0 or current.u64() >= node_count.u64() or top >= node_count:
                return -1
            index: usize = current.usize()
            left: i64 = nodes[3 * index + 1]
            right: i64 = nodes[3 * index + 2]
            invalid_left: bool = left < -1 or (left >= 0 and left.u64() >= node_count.u64())
            invalid_right: bool = right < -1 or (right >= 0 and right.u64() >= node_count.u64())
            if invalid_left or invalid_right:
                return -1
            traversal_stack[top] <- index
            top <- top + 1
            current <- left
        top <- top - 1
        index: usize = traversal_stack[top]
        if value_count >= node_count:
            return -1
        value: i64 = nodes[3 * index]
        if value < -100000 or value > 100000:
            return -1
        if value_count != 0 and iterator_values[value_count - 1] >= value:
            return -1
        iterator_values[value_count] <- value
        value_count <- value_count + 1
        current <- nodes[3 * index + 2]
    if value_count != node_count:
        return -1
    checksum: mutable i64 = 0
    next_index: mutable usize = 0
    while next_index < value_count:
        checksum <- checksum + (next_index.i64() + 1) * (iterator_values[next_index] + 100001)
        next_index <- next_index + 1
    checksum

export fn bst_iterator(nodes: i64&, node_count: usize, root_index: i64) -> i64 = bst_iterator_impl
