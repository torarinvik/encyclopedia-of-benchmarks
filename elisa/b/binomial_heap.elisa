const MAX_OPS: usize = 128
const ROOT_COUNT: usize = 9

def link_tree(values: view[i64], children: mutable view[i64], siblings: mutable view[i64], degrees: mutable view[i64], a: usize, b: usize) -> usize:
    parent: usize = a
    child: usize = b
    if values[a] >= values[b]:
        parent <- b
        child <- a
    siblings[child] <- children[parent]
    children[parent] <- child.i64()
    degrees[parent] <- degrees[parent] + 1
    parent

def add_tree(values: view[i64], children: mutable view[i64], siblings: mutable view[i64], degrees: mutable view[i64], roots: mutable view[i64], initial: usize) -> void:
    root: mutable usize = initial
    degree: mutable usize = degrees[root].usize()
    while roots[degree] >= 0:
        root <- link_tree(values, children, siblings, degrees, root, roots[degree].usize())
        roots[degree] <- -1
        degree <- degree + 1
    roots[degree] <- root.i64()

def insert(values: mutable view[i64], children: mutable view[i64], siblings: mutable view[i64], degrees: mutable view[i64], roots: mutable view[i64], used: mutable usize&, size: mutable usize&, value: i64) -> void:
    root: usize = used
    used <- used + 1
    values[root] <- value
    children[root] <- -1
    siblings[root] <- -1
    degrees[root] <- 0
    size <- size + 1
    add_tree(values, children, siblings, degrees, roots, root)

def min_root(values: view[i64], roots: view[i64]) -> i64:
    best: mutable i64 = -1
    for degree in 0..<ROOT_COUNT:
        root: i64 = roots[degree]
        if root >= 0 and (best < 0 or values[root.usize()] < values[best.usize()]):
            best <- root
    best

def extract_min(values: view[i64], children: mutable view[i64], siblings: mutable view[i64], degrees: mutable view[i64], roots: mutable view[i64], size: mutable usize&) -> i64:
    best: i64 = min_root(values, roots)
    root: usize = best.usize()
    degree: usize = degrees[root].usize()
    value: i64 = values[root]
    roots[degree] <- -1
    child: mutable i64 = children[root]
    while child >= 0:
        child_index: usize = child.usize()
        next: i64 = siblings[child_index]
        siblings[child_index] <- -1
        add_tree(values, children, siblings, degrees, roots, child_index)
        child <- next
    size <- size - 1
    value

def put_i64(output: mutable view[u8], index: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[index * 8 + byte] <- (bits & 255).u8()
        bits <- bits >> 8

export fn binomial_heap_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or input[0] < 0 or input[0] > 128 or length != 1 + 2 * input[0].usize():
        return -1
    count: usize = input[0].usize()
    queries: mutable usize = 0
    size: mutable usize = 0
    for op in 0..<count:
        code: i64 = input[1 + 2 * op]
        value: i64 = input[2 + 2 * op]
        if code == 0:
            if value < -2147483648 or value > 2147483647:
                return -1
            size <- size + 1
        else if code >= 1 and code <= 3:
            if value != 0 or ((code == 1 or code == 2) and size == 0):
                return -1
            if code == 2:
                size <- size - 1
            queries <- queries + 1
        else:
            return -1
    output_bytes: usize = queries * 8
    if capacity < output_bytes or (output_bytes > 0 and output.is_null()):
        return -2
    values: mutable i64[MAX_OPS] = zeroed
    children: mutable i64[MAX_OPS] = zeroed
    siblings: mutable i64[MAX_OPS] = zeroed
    degrees: mutable i64[MAX_OPS] = zeroed
    roots: mutable i64[ROOT_COUNT] = zeroed
    for d in 0..<ROOT_COUNT: roots[d] <- -1
    used: mutable usize = 0
    size <- 0
    written: mutable usize = 0
    for op in 0..<count:
        code: i64 = input[1 + 2 * op]
        value: i64 = input[2 + 2 * op]
        if code == 0:
            insert(values[0:MAX_OPS], children[0:MAX_OPS], siblings[0:MAX_OPS], degrees[0:MAX_OPS], roots[0:ROOT_COUNT], used, size, value)
        else:
            result: mutable i64 = 0
            if code == 1:
                root: i64 = min_root(values[0:MAX_OPS], roots[0:ROOT_COUNT])
                result <- values[root.usize()]
            else if code == 2:
                result <- extract_min(values[0:MAX_OPS], children[0:MAX_OPS], siblings[0:MAX_OPS], degrees[0:MAX_OPS], roots[0:ROOT_COUNT], size)
            else if size == 0:
                result <- 1
            put_i64(output[0:output_bytes], written, result)
            written <- written + 1
    written.i64()

export fn binomial_heap(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = binomial_heap_impl
