# Sum every node reachable from the root of a bounded indexed binary tree.
const INVALID_RESULT: i64 = -9000000000000000000

def binary_tree_node_sum_visit(nodes: i64&, node_count: usize, node: i64, depth: usize) -> i64:
    if node < 0 or node.u64() >= node_count.u64() or depth >= node_count:
        return INVALID_RESULT
    index: usize = node.usize()
    value: i64 = nodes[3 * index]
    left: i64 = nodes[3 * index + 1]
    right: i64 = nodes[3 * index + 2]
    if value < -1000000000 or value > 1000000000 or left < -1 or right < -1:
        return INVALID_RESULT
    if (left >= 0 and left.u64() >= node_count.u64()) or (right >= 0 and right.u64() >= node_count.u64()):
        return INVALID_RESULT
    left_sum: i64 = 0
    if left >= 0:
        left_sum = binary_tree_node_sum_visit(nodes, node_count, left, depth + 1)
        if left_sum == INVALID_RESULT:
            return INVALID_RESULT
    right_sum: i64 = 0
    if right >= 0:
        right_sum = binary_tree_node_sum_visit(nodes, node_count, right, depth + 1)
        if right_sum == INVALID_RESULT:
            return INVALID_RESULT
    value + left_sum + right_sum

def binary_tree_node_sum_impl(nodes: i64&, node_count: usize, root_index: i64) -> i64:
    if node_count == 0 or node_count > 900 or root_index < 0 or root_index.u64() >= node_count.u64():
        return INVALID_RESULT
    binary_tree_node_sum_visit(nodes, node_count, root_index, 0)

export fn binary_tree_node_sum(nodes: i64&, node_count: usize, root_index: i64) -> i64 = binary_tree_node_sum_impl
