# Directed edge triples, separate reachability, and checked distance addition.
def bellman_ford_impl(edges: i64&, vertices: usize, edge_count: usize, source: usize, distances: mutable i64&, reachable: mutable u8&) -> i64:
    if vertices == 0:
        return 0 if source == 0 and edge_count == 0 else -3
    if source >= vertices:
        return -3
    edge: mutable usize = 0
    while edge < edge_count:
        origin: i64 = edges[3 * edge]
        destination: i64 = edges[3 * edge + 1]
        if origin < 0 or destination < 0:
            return -3
        if origin.u64() >= vertices.u64() or destination.u64() >= vertices.u64():
            return -3
        edge <- edge + 1
    vertex: mutable usize = 0
    while vertex < vertices:
        distances[vertex] <- 0
        reachable[vertex] <- 0
        vertex <- vertex + 1
    reachable[source] <- 1
    round: mutable usize = 0
    while round < vertices:
        changed: mutable bool = false
        edge <- 0
        while edge < edge_count:
            origin: usize = edges[3 * edge].usize()
            destination: usize = edges[3 * edge + 1].usize()
            weight: i64 = edges[3 * edge + 2]
            if reachable[origin] != 0:
                base: i64 = distances[origin]
                if weight > 0 and base > 9223372036854775807 - weight:
                    return -2
                if weight < 0 and base < (-9223372036854775807 - 1) - weight:
                    return -2
                candidate: i64 = base + weight
                if reachable[destination] == 0 or candidate < distances[destination]:
                    if round == vertices - 1:
                        return -1
                    distances[destination] <- candidate
                    reachable[destination] <- 1
                    changed <- true
            edge <- edge + 1
        if not changed:
            return 0
        round <- round + 1
    0

export fn bellman_ford(edges: i64&, vertices: usize, edge_count: usize, source: usize, distances: mutable i64&, reachable: mutable u8&) -> i64 = bellman_ford_impl
