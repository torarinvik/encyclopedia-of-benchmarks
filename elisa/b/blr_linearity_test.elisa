const MAX_N: usize = 6
const MAX_Q: usize = 32
const MAX_INPUT: usize = 130
const MAX_OUTPUT: usize = 24

def blr_linearity_test_put(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def blr_linearity_test(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 @export("blr_linearity_test"):
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    q64: i64 = input[1]
    if n64 < 1 or n64 > MAX_N.i64() or q64 < 1 or q64 > MAX_Q.i64(): return -1
    n: usize = n64.usize()
    q: usize = q64.usize()
    domain: usize = 1 << n
    if length != 2 + domain + 2 * q: return -1
    table_at: usize = 2
    tape_at: usize = table_at + domain
    i: mutable usize = 0
    while i < domain:
        if input[table_at + i] != 0 and input[table_at + i] != 1: return -1
        i <- i + 1
    i <- 0
    while i < 2 * q:
        point: i64 = input[tape_at + i]
        if point < 0 or point >= domain.i64(): return -1
        i <- i + 1
    rounds: mutable usize = 0
    accepted: mutable i64 = 1
    i <- 0
    while i < q:
        x: usize = input[tape_at + 2 * i].usize()
        y: usize = input[tape_at + 2 * i + 1].usize()
        rounds <- rounds + 1
        if (input[table_at + x] ^ input[table_at + y]) != input[table_at + (x ^ y]):
            accepted <- 0
            break
        i <- i + 1
    if output.is_null() or capacity < MAX_OUTPUT: return -2
    staged: mutable u8[MAX_OUTPUT] = zeroed
    blr_linearity_test_put(accepted, staged[0:24], 0)
    blr_linearity_test_put(rounds.i64(), staged[0:24], 8)
    blr_linearity_test_put((3 * rounds).i64(), staged[0:24], 16)
    i <- 0
    while i < MAX_OUTPUT:
        output[i] <- staged[i]
        i <- i + 1
    return MAX_OUTPUT.i64()
