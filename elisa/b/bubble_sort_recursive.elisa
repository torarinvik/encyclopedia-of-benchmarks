# Recursive bubble sort with an early exit after an unchanged pass.
const MAX_VALUES: usize = 256

def bubble_sort_recursive_impl(values: mutable i64&, length: usize) -> void:
    if length <= 1:
        return
    swapped: mutable bool = false
    index: mutable usize = 0
    while index + 1 < length:
        if values[index] > values[index + 1]:
            temporary: i64 = values[index]
            values[index] <- values[index + 1]
            values[index + 1] <- temporary
            swapped <- true
        index <- index + 1
    if swapped:
        bubble_sort_recursive_impl(values, length - 1)

export fn bubble_sort_recursive(values: mutable i64&, length: usize) -> void = bubble_sort_recursive_impl
