const TRAINING: i64[44] = [
    2,99,255,1,37,44,58,0,139,169,229,1,
    14,255,10,1,2,28,1,0,20,33,20,0,
    252,227,65,1,71,65,24,0,168,80,80,1,
    119,35,90,0,186,13,126,1
]

def brightness_impl(input: i64&, length: usize) -> i64:
    if length != 3:
        return -1
    red: i64 = input[0]
    green: i64 = input[1]
    blue: i64 = input[2]
    if red < 0 or red > 255 or green < 0 or green > 255 or blue < 0 or blue > 255:
        return -1
    best_distance: mutable i64 = 195076
    best_label: mutable i64 = -1
    sample: mutable usize = 0
    while sample < 11:
        red_delta: i64 = red - TRAINING[sample * 4]
        green_delta: i64 = green - TRAINING[sample * 4 + 1]
        blue_delta: i64 = blue - TRAINING[sample * 4 + 2]
        distance: i64 = red_delta * red_delta + green_delta * green_delta + blue_delta * blue_delta
        if distance < best_distance:
            best_distance <- distance
            best_label <- TRAINING[sample * 4 + 3]
        sample <- sample + 1
    best_label

export fn brightness(input: i64&, length: usize) -> i64 = brightness_impl
