const BTC_MAX_OUTPUT_BYTES: usize = 41

def balanced_ternary_conversion_impl(input: view[i64], output: mutable view[u8],
        output_is_null: bool) -> i64:
    if input.length != 1:
        return -1
    reversed: mutable u8[BTC_MAX_OUTPUT_BYTES] = zeroed
    digit_count: mutable usize = 0
    value: mutable i64 = input[0]
    if value == 0:
        reversed[digit_count] <- 48
        digit_count <- digit_count + 1
    while value != 0:
        quotient: mutable i64 = value / 3
        remainder: i64 = value % 3
        digit: mutable u8 = 49
        if remainder == 2:
            digit <- 90
            quotient <- quotient + 1
        else if remainder == -2:
            digit <- 49
            quotient <- quotient - 1
        else if remainder == -1:
            digit <- 90
        else if remainder == 0:
            digit <- 48
        reversed[digit_count] <- digit
        digit_count <- digit_count + 1
        value <- quotient
    if output_is_null or output.length < digit_count:
        return -2
    staged_view: mutable view[u8] = reversed[0:BTC_MAX_OUTPUT_BYTES]
    for index in 0..<digit_count:
        output[index] <- staged_view[digit_count - index - 1]
    digit_count.i64()

export fn balanced_ternary_conversion(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input == null or length != 1:
        return -1
    input_view: view[i64] = input[0:length]
    if output == null:
        empty_storage: mutable u8[1] = zeroed
        empty_view: mutable view[u8] = empty_storage[0:0]
        return balanced_ternary_conversion_impl(input_view, empty_view, true)
    output_view: mutable view[u8] = output[0:capacity]
    balanced_ternary_conversion_impl(input_view, output_view, false)
