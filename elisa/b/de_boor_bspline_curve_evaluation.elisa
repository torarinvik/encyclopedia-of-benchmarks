const MAX_INPUT_LENGTH: usize = 24

def finite(value: f64) -> bool:
    value == value and value <= 1.0e308 and value >= -1.0e308

def exact_integer(value: f64, low: i64, high: i64) -> bool:
    if not finite(value) or value < low.f64() or value > high.f64(): return false
    value.i64().f64() == value

def valid_input(input: f64&, input_length: usize) -> bool:
    if input_length < 3 or input_length > MAX_INPUT_LENGTH: return false
    if not exact_integer(input[0],1,3): return false
    degree: i64 = input[0].i64()
    if not exact_integer(input[1],degree+1,8) or not finite(input[2]): return false
    count: i64 = input[1].i64()
    knot_count: usize = (count+degree+1).usize()
    if input_length != 3+knot_count+count.usize(): return false
    index: mutable usize = 0
    while index < knot_count:
        knot: f64 = input[3+index]
        if not finite(knot) or knot < -1000.0 or knot > 1000.0: return false
        if index > 0 and knot < input[2+index]: return false
        index <- index+1
    control_index: mutable usize = 0
    while control_index < count.usize():
        control: f64 = input[3+knot_count+control_index]
        if not finite(control) or control < -1000.0 or control > 1000.0: return false
        control_index <- control_index+1
    run: mutable i64 = 1
    index <- 1
    while index < knot_count:
        if input[3+index] == input[2+index]: run <- run+1
        else: run <- 1
        if run > degree+1: return false
        index <- index+1
    lower: f64 = input[3+degree.usize()]
    upper: f64 = input[3+count.usize()]
    input[2] >= lower and input[2] <= upper and lower < upper

def evaluate(input: f64&) -> f64:
    degree: i64 = input[0].i64()
    count: i64 = input[1].i64()
    knot_count: usize = (count+degree+1).usize()
    knots: f64& = &input[3]
    controls: f64& = &input[3+knot_count]
    parameter: f64 = input[2]
    span: mutable i64 = degree
    if parameter == knots[count.usize()]: span <- count-1
    else:
        while span < count-1 and parameter >= knots[(span+1).usize()]:
            span <- span+1
    local: mutable f64[4] = zeroed
    slot: mutable i64 = 0
    while slot <= degree:
        local[slot.usize()] <- controls[(span-degree+slot).usize()]
        slot <- slot+1
    level: mutable i64 = 1
    while level <= degree:
        slot <- degree
        while slot >= level:
            left: i64 = span-degree+slot
            right: i64 = span+slot-level+1
            denominator: f64 = knots[right.usize()]-knots[left.usize()]
            alpha: mutable f64 = 0.0
            if denominator != 0.0: alpha <- (parameter-knots[left.usize()])/denominator
            local[slot.usize()] <- (1.0-alpha)*local[(slot-1).usize()]+alpha*local[slot.usize()]
            slot <- slot-1
        level <- level+1
    local[degree.usize()]

def de_boor_bspline_curve_evaluation_impl(input: f64&, input_length: usize,
                                           output: mutable f64&, capacity: usize) -> i64:
    if input == null or input_length > MAX_INPUT_LENGTH: return -1
    input_view: f64& = input
    if not valid_input(input_view,input_length): return -1
    if output == null or capacity < 1: return -2
    result: f64 = evaluate(input_view)
    if not finite(result): return -1
    output_view: mutable f64& = output
    output_view[0] <- result
    1

export fn de_boor_bspline_curve_evaluation(input: f64&, input_length: usize, output: mutable f64&, capacity: usize) -> i64 = de_boor_bspline_curve_evaluation_impl
