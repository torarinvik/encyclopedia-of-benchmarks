# Calculate C(n, k) by updating one row of Pascal's triangle.
def binomial_coefficient_impl(n: u64, k: u64) -> i64:
    if n > 66:
        return -1
    if k > n:
        return 0
    if k == 0:
        return 1
    n_value: usize = n.usize()
    k_value: usize = k.usize()
    # Every entry through row 66 fits in signed 64-bit as well as u64.
    coefficients: mutable u64[67] = zeroed
    coefficients[0] <- 1
    row: mutable usize = 1
    while row <= n_value:
        column: mutable usize = k_value if k_value < row else row
        while column > 0:
            coefficients[column] <- coefficients[column] + coefficients[column - 1]
            column <- column - 1
        row <- row + 1
    coefficients[k_value].i64()

export fn binomial_coefficient(n: u64, k: u64) -> i64 = binomial_coefficient_impl
