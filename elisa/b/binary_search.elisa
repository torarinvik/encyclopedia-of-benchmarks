# Binary search in an ascending sequence for the shared benchmark contract.
def binary_search_impl(values: i64&, length: usize, target: i64) -> i64:
    found: i64 =
        while low < high |low: usize = 0, high: usize = length, result: i64 = -1| -> result:
            middle: usize = low + (high - low) / 2
            value: i64 = values[middle]
            if value == target:
                break middle.i64()
            if value < target:
                low <- middle + 1
            else:
                high <- middle
    found

export fn binary_search(values: i64&, length: usize, target: i64) -> i64 = binary_search_impl
