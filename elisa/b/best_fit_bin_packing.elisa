def best_fit_put_i64(output: mutable u8&, word: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[word * 8 + byte] <- (bits >> (byte * 8)).u8()

def best_fit_bin_packing_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > 65:
        return -1
    n0: i64 = input[0]
    if n0 < 0 or n0 > 64 or length != (1 + n0).usize():
        return -1
    n: usize = n0.usize()
    for i in 0..<n:
        size: i64 = input[i + 1]
        if size < 1 or size > 1000000:
            return -1
    loads: mutable i64[64] = zeroed
    assignments: mutable i64[64] = zeroed
    bins: mutable usize = 0
    for i in 0..<n:
        size: i64 = input[i + 1]
        selected: mutable usize = bins
        least_remaining: mutable i64 = 1000001
        for bin in 0..<bins:
            if loads[bin] + size <= 1000000:
                remaining: i64 = 1000000 - loads[bin] - size
                if remaining < least_remaining:
                    least_remaining <- remaining
                    selected <- bin
        if selected == bins:
            loads[bins] <- size
            assignments[i] <- bins.i64()
            bins <- bins + 1
        else:
            loads[selected] <- loads[selected] + size
            assignments[i] <- selected.i64()
    bytes: usize = 8 * (n + 1)
    if output == null or capacity < bytes:
        return -2
    best_fit_put_i64(output, 0, bins.i64())
    for i in 0..<n:
        best_fit_put_i64(output, i + 1, assignments[i])
    bytes.i64()

export fn best_fit_bin_packing(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = best_fit_bin_packing_impl
