module batch_gcd_small_range_precomputed;

const MAX_VALUE: i64 = 64;
const MAX_VALUE_SIZE: usz = 64;
const MAX_QUERIES: usz = 64;
const MAX_INPUT_LENGTH: usz = 2 + 2 * MAX_QUERIES;
const MAX_SMALL: usz = 8;

fn bg_store_i64_le(value: i64, output: mutable view[u8], offset: usz) -> void:
    bits: u64 = value.u64()
    byte: mutable usz = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

fn bg_compute(input: view[i64], results: mutable view[i64]) -> i64:
    length: usz = input.len()
    if length < 2 or length > MAX_INPUT_LENGTH + 1: return -1
    limit_value: i64 = input[0]
    query_value: i64 = input[1]
    if limit_value < 1 or limit_value > MAX_VALUE or query_value < 0 or
        query_value > MAX_QUERIES.i64(): return -1
    limit: mutable usz = limit_value.usz()
    queries: mutable usz = query_value.usz()
    if length != 2 + 2 * queries: return -1
    query: mutable usz = 0
    while query < queries:
        left: i64 = input[2 + 2 * query]
        right: i64 = input[3 + 2 * query]
        if left < 0 or left > limit_value or right < 0 or right > limit_value: return -1
        query <- query + 1

    least: mutable usz[MAX_VALUE_SIZE + 1] = zeroed
    primes: mutable usz[MAX_VALUE_SIZE + 1] = zeroed
    prime_count: mutable usz = 0
    value: mutable usz = 2
    while value <= limit:
        if least[value] == 0:
            least[value] <- value
            primes[prime_count] <- value
            prime_count <- prime_count + 1
        index: mutable usz = 0
        while index < prime_count:
            prime: usz = primes[index]
            composite: usz = value * prime
            if composite > limit or prime > least[value]: break
            least[composite] <- prime
            index <- index + 1
        value <- value + 1

    factors: mutable usz[(MAX_VALUE_SIZE + 1) * 3] = zeroed
    factors[3] <- 1
    factors[4] <- 1
    factors[5] <- 1
    value <- 2
    while value <= limit:
        prime: usz = least[value]
        quotient: usz = value / prime
        a: mutable usz = factors[3 * quotient] * prime
        b: mutable usz = factors[3 * quotient + 1]
        c: mutable usz = factors[3 * quotient + 2]
        temp: mutable usz = 0
        if a > b:
            temp <- a
            a <- b
            b <- temp
        if b > c:
            temp <- b
            b <- c
            c <- temp
        if a > b:
            temp <- a
            a <- b
            b <- temp
        factors[3 * value] <- a
        factors[3 * value + 1] <- b
        factors[3 * value + 2] <- c
        value <- value + 1

    small_limit: mutable usz = 1
    while (small_limit + 1) * (small_limit + 1) <= limit:
        small_limit <- small_limit + 1
    gcd_table: mutable usz[(MAX_SMALL + 1) * (MAX_SMALL + 1)] = zeroed
    a: mutable usz = 1
    while a <= small_limit:
        gcd_table[(MAX_SMALL + 1) * a] <- a
        b: mutable usz = 1
        while b < a:
            gcd_table[(MAX_SMALL + 1) * a + b] <-
                gcd_table[(MAX_SMALL + 1) * b + (a % b)]
            b <- b + 1
        a <- a + 1

    query <- 0
    while query < queries:
        left: usz = input[2 + 2 * query].usz()
        remaining: mutable usz = input[3 + 2 * query].usz()
        result: mutable usz = 0
        if left == 0:
            result <- remaining
        else:
            result <- 1
            part: mutable usz = 0
            while part < 3:
                factor: usz = factors[3 * left + part]
                common: mutable usz = 1
                if factor <= small_limit:
                    common <- gcd_table[(MAX_SMALL + 1) * factor + (remaining % factor)]
                elif remaining % factor == 0:
                    common <- factor
                remaining <- remaining / common
                result <- result * common
                part <- part + 1
        results[query] <- result.i64()
        query <- query + 1
    (8 * queries).i64()

export fn batch_gcd_small_range_precomputed(input: i64&, length: usz,
    output: mutable u8&, capacity: usz) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_LENGTH + 1: return -1
    input_view: view[i64] = input[0:length]
    result_storage: mutable i64[MAX_QUERIES] = zeroed
    result_view: mutable view[i64] = result_storage[0:MAX_QUERIES]
    required_signed: i64 = bg_compute(input_view, result_view)
    if required_signed < 0: return required_signed
    required: usz = required_signed.usz()
    if output.is_null() or capacity < required: return -2
    output_view: mutable view[u8] = output[0:required]
    query: mutable usz = 0
    while query < required / 8:
        bg_store_i64_le(result_view[query], output_view, 8 * query)
        query <- query + 1
    required.i64()
