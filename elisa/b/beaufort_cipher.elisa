# Preserve the pinned Python source's plaintext-minus-repeating-key transform.
def beaufort_cipher_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if length < 3 or length > 2051:
        return -1
    mode: i64 = values[0]
    text_length_value: i64 = values[1]
    key_length_value: i64 = values[2]
    if (mode != 0 and mode != 1) or text_length_value < 0 or text_length_value > 1024 or key_length_value < 0 or key_length_value > 1024:
        return -1
    text_length: usize = text_length_value.usize()
    key_length: usize = key_length_value.usize()
    if length != 3 + text_length + key_length or (text_length == 0 and key_length != 0) or (text_length != 0 and (key_length == 0 or key_length > text_length)):
        return -1
    key_start: usize = 3 + text_length
    for index in 0..<text_length:
        value: i64 = values[3 + index]
        if value != 32 and (value < 65 or value > 90):
            return -1
    for index in 0..<key_length:
        if values[key_start + index] < 65 or values[key_start + index] > 90:
            return -1
    if output_capacity < text_length:
        return -2
    key_index: mutable usize = 0
    for index in 0..<text_length:
        value: i64 = values[3 + index]
        if value == 32:
            output[index] <- 32.u8()
        else:
            letter: i64 = value - 65
            key_letter: i64 = values[key_start + key_index % key_length] - 65
            mapped: i64 =
                if mode == 0:
                    (letter - key_letter + 26) % 26
                else:
                    (letter + key_letter) % 26
            output[index] <- (65 + mapped).u8()
            key_index <- key_index + 1
    text_length.i64()

export fn beaufort_cipher(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = beaufort_cipher_impl
