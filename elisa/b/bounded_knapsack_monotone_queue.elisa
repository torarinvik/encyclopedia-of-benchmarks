const BKM_MAX_CAPACITY: usize = 64
const BKM_MAX_TYPES: usize = 16
const BKM_MAX_INPUT: usize = 51

export fn bounded_knapsack_monotone_queue(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > BKM_MAX_INPUT:
        return -1
    input_view: view[i64] = input[0:length]
    capacity_value: i64 = input_view[0]
    type_count_value: i64 = input_view[1]
    if capacity_value < 0 or capacity_value > BKM_MAX_CAPACITY.i64() or
       type_count_value < 0 or type_count_value > BKM_MAX_TYPES.i64():
        return -1
    capacity: usize = capacity_value.usize()
    type_count: usize = type_count_value.usize()
    if length != 2 + 3 * type_count:
        return -1

    for item in 0..<type_count:
        weight: i64 = input_view[2 + 3 * item]
        value: i64 = input_view[3 + 3 * item]
        count: i64 = input_view[4 + 3 * item]
        if weight < 1 or weight > 16 or value < 0 or value > 100 or count < 0 or count > 16:
            return -1

    dp_storage: mutable i64[65] = zeroed
    next_storage: mutable i64[65] = zeroed
    score_storage: mutable i64[65] = zeroed
    index_storage: mutable i64[65] = zeroed
    dp: mutable view[i64] = dp_storage[0:65]
    next: mutable view[i64] = next_storage[0:65]
    queue_score: mutable view[i64] = score_storage[0:65]
    queue_index: mutable view[i64] = index_storage[0:65]

    for item in 0..<type_count:
        weight: usize = input_view[2 + 3 * item].usize()
        value: i64 = input_view[3 + 3 * item]
        count: usize = input_view[4 + 3 * item].usize()
        for residue in 0..<weight:
            if residue > capacity:
                break
            head: mutable usize = 0
            tail: mutable usize = 0
            max_t: usize = (capacity - residue) / weight
            for t in 0..<max_t + 1:
                current: usize = residue + t * weight
                score: i64 = dp[current] - t.i64() * value
                while tail > head and queue_score[tail - 1] <= score:
                    tail <- tail - 1
                queue_index[tail] <- t.i64()
                queue_score[tail] <- score
                tail <- tail + 1
                first_allowed: usize = 0
                if t > count:
                    first_allowed = t - count
                while head < tail and queue_index[head].usize() < first_allowed:
                    head <- head + 1
                next[current] <- t.i64() * value + queue_score[head]
        for c in 0..<capacity + 1:
            dp[c] <- next[c]
    return dp[capacity]
