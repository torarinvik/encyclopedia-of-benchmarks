# Group each minimum value at the front, then find the next present value.
const MAX_VALUES: usize = 1024

def bingo_sort_impl(values: mutable i64&, length: usize) -> void:
    if length > MAX_VALUES or length < 2:
        return
    bingo: mutable i64 = values[0]
    index: mutable usize = 1
    while index < length:
        if values[index] < bingo:
            bingo <- values[index]
        index <- index + 1

    next_position: mutable usize = 0
    while next_position < length:
        has_next: mutable bool = false
        next_bingo: mutable i64 = 0
        index <- next_position
        while index < length:
            if values[index] == bingo:
                temporary: i64 = values[index]
                values[index] <- values[next_position]
                values[next_position] <- temporary
                next_position <- next_position + 1
            else:
                if not has_next or values[index] < next_bingo:
                    next_bingo <- values[index]
                    has_next <- true
            index <- index + 1
        if next_position == length:
            break
        bingo <- next_bingo

export fn bingo_sort(values: mutable i64&, length: usize) -> void = bingo_sort_impl
