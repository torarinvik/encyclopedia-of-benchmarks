# Check (), [], and {} nesting; ignore other character codes.
def balanced_parentheses_impl(values: i64&, length: usize) -> i64:
    if length > 4096:
        return -1
    depth: i64 =
        while index < length and depth >= 0 |index: mutable usize = 0, openers: mutable i64[4096] = zeroed, depth: mutable i64 = 0| -> depth:
            value: i64 = values[index]
            if value == 40 or value == 91 or value == 123:
                openers[depth.usize()] <- value
                depth <- depth + 1
            elif value == 41 or value == 93 or value == 125:
                if depth == 0:
                    depth <- -1
                else:
                    depth <- depth - 1
                    opener: i64 = openers[depth.usize()]
                    if (value == 41 and opener != 40) or (value == 93 and opener != 91) or (value == 125 and opener != 123):
                        depth <- -1
            index <- index + 1
    if depth == 0:
        return 1
    0

export fn balanced_parentheses(values: i64&, length: usize) -> i64 = balanced_parentheses_impl
