# Convert most-significant-first binary digits to a signed 64-bit decimal value.
def binary_to_decimal_impl(bits: i64&, length: usize) -> i64:
    if length == 0 or length > 63:
        return -1
    index: mutable usize = 0
    while index < length:
        if bits[index] != 0 and bits[index] != 1:
            return -1
        index <- index + 1
    result: i64 =
        while index < length |index: usize = 0, value: i64 = 0| -> value:
            value <- value * 2 + bits[index]
            index <- index + 1
    result

export fn binary_to_decimal(bits: i64&, length: usize) -> i64 = binary_to_decimal_impl
