def babylonian_method_impl(input: f64) -> f64:
    if not (input >= 2.0 and input <= 999999.0):
        return -1.0
    radicand: i64 = input.i64()
    if radicand.f64() != input:
        return -1.0
    i: mutable i64 = 1
    while i * i <= radicand:
        i <- i + 1
    i <- i - 1
    if i * i == radicand:
        return -1.0
    x0: f64 = i.f64()
    (input / x0 + x0) / 2.0

export fn babylonian_method(input: f64) -> f64 = babylonian_method_impl
