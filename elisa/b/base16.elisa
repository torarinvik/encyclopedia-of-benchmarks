# Encode bytes as uppercase Base16 or decode uppercase Base16 bytes.
def base16_nibble(byte: i64) -> i64:
    if byte >= 48 and byte <= 57:
        return byte - 48
    if byte >= 65 and byte <= 70:
        return byte - 55
    -1

def base16_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or length > 65:
        return -1
    mode: i64 = input[0]
    if mode == 0:
        count: usize = length - 1
        valid_input: bool =
            while index < length |index: mutable usize = 1, valid: mutable bool = true| -> valid:
                if input[index] < 0 or input[index] > 255:
                    break false
                index <- index + 1
        if not valid_input:
            return -1
        output_length: usize = count * 2
        if output_capacity < output_length:
            return -2
        while index < count |index: mutable usize = 0, output| -> output:
            byte: i64 = input[index + 1]
            high: i64 = byte / 16
            low: i64 = byte % 16
            if high < 10:
                output[2 * index] <- (48 + high).u8()
            else:
                output[2 * index] <- (55 + high).u8()
            if low < 10:
                output[2 * index + 1] <- (48 + low).u8()
            else:
                output[2 * index + 1] <- (55 + low).u8()
            index <- index + 1
            output
        output_length.i64()
    else:
        if mode != 1:
            return -1
        encoded_length: usize = length - 1
        if encoded_length % 2 != 0:
            return -1
        valid_input: bool =
            while index < encoded_length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
                if base16_nibble(input[index + 1]) < 0:
                    break false
                index <- index + 1
        if not valid_input:
            return -1
        output_length: usize = encoded_length / 2
        if output_capacity < output_length:
            return -2
        while index < output_length |index: mutable usize = 0, output| -> output:
            high: i64 = base16_nibble(input[1 + 2 * index])
            low: i64 = base16_nibble(input[2 + 2 * index])
            output[index] <- (high * 16 + low).u8()
            index <- index + 1
            output
        output_length.i64()

export fn base16(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = base16_impl
