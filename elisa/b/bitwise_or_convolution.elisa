const OR_MAX_N: usize = 8
const OR_MAX_SIZE: usize = 256
const OR_MAX_INPUT: usize = 513
const OR_MOD: i64 = 998244353

def bitwise_or_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

export fn bitwise_or_convolution(input: i64&, length: usize, output: mutable u8&,
        capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > OR_MAX_INPUT: return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > 8: return -1
    n: usize = n_value.usize()
    size: usize = 1 << n
    if length != 1 + 2 * size: return -1
    i: mutable usize = 0
    while i < 2 * size:
        value: i64 = input[1 + i]
        if value < 0 or value >= OR_MOD: return -1
        i <- i + 1
    bytes: usize = 8 * size
    if output.is_null() or capacity < bytes: return -2
    a: mutable i64[256] = zeroed
    b: mutable i64[256] = zeroed
    i <- 0
    while i < size:
        a[i] <- input[1 + i]
        b[i] <- input[1 + size + i]
        i <- i + 1
    bit: mutable usize = 0
    while bit < n:
        bit_mask: usize = 1 << bit
        mask: mutable usize = 0
        while mask < size:
            if (mask & bit_mask) != 0:
                a[mask] <- (a[mask] + a[mask ^ bit_mask]) % OR_MOD
                b[mask] <- (b[mask] + b[mask ^ bit_mask]) % OR_MOD
            mask <- mask + 1
        bit <- bit + 1
    i <- 0
    while i < size:
        a[i] <- (a[i] * b[i]) % OR_MOD
        i <- i + 1
    bit <- 0
    while bit < n:
        bit_mask <- 1 << bit
        mask <- 0
        while mask < size:
            if (mask & bit_mask) != 0:
                a[mask] <- a[mask] - a[mask ^ bit_mask]
                if a[mask] < 0: a[mask] <- a[mask] + OR_MOD
            mask <- mask + 1
        bit <- bit + 1
    output_view: mutable view[u8] = output[0:bytes]
    i <- 0
    while i < size:
        bitwise_or_store(a[i], output_view, 8 * i)
        i <- i + 1
    bytes.i64()
