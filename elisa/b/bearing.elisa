# Return a spherical initial bearing in integer microdegrees.
extern sin(value: f64) -> f64
extern cos(value: f64) -> f64
extern atan2(y: f64, x: f64) -> f64

def bearing_impl(values: i64&, length: usize) -> i64:
    if length != 4:
        return -1
    latitude1_value: i64 = values[0]
    longitude1_value: i64 = values[1]
    latitude2_value: i64 = values[2]
    longitude2_value: i64 = values[3]
    if (latitude1_value < -90000000 or latitude1_value > 90000000 or
       latitude2_value < -90000000 or latitude2_value > 90000000 or
       longitude1_value < -180000000 or longitude1_value > 180000000 or
       longitude2_value < -180000000 or longitude2_value > 180000000 or
       (latitude1_value == latitude2_value and longitude1_value == longitude2_value)):
        return -1

    radians_per_microdegree: f64 = 0.000001 * (3.14159265358979323846 / 180.0)
    latitude1: f64 = latitude1_value.f64() * radians_per_microdegree
    longitude1: f64 = longitude1_value.f64() * radians_per_microdegree
    latitude2: f64 = latitude2_value.f64() * radians_per_microdegree
    longitude2: f64 = longitude2_value.f64() * radians_per_microdegree
    delta_longitude: f64 = longitude2 - longitude1
    east: f64 = sin(delta_longitude) * cos(latitude2)
    north: f64 = (cos(latitude1) * sin(latitude2) -
                 sin(latitude1) * cos(latitude2) * cos(delta_longitude))
    degrees: mutable f64 = atan2(east, north) * 57.2957795130823208768
    if degrees < 0.0:
        degrees <- degrees + 360.0
    result: i64 = (degrees * 1000000.0 + 0.5).i64()
    if result >= 360000000:
        return 0
    result

export fn bearing(values: i64&, length: usize) -> i64 = bearing_impl
