# Exponentiation by squaring with exact i64 overflow detection.
const MAX_I32: i64 = 2147483647
const MAX_RESULT: u64 = 9223372036854775807

def binary_exponentiation_impl(values: i64&, length: usize) -> i64:
    if values == null or length != 2:
        return -1
    base_input: i64 = values[0]
    exponent_input: i64 = values[1]
    if base_input < 0 or base_input > MAX_I32 or exponent_input < 0 or exponent_input > MAX_I32:
        return -1
    base: mutable u64 = base_input.u64()
    exponent: mutable u64 = exponent_input.u64()
    result: mutable u64 = 1
    while exponent != 0:
        if (exponent & 1) != 0:
            if base != 0 and result > MAX_RESULT / base:
                return -1
            result <- result * base
        exponent <- exponent >> 1
        if exponent != 0:
            if base != 0 and base > MAX_RESULT / base:
                return -1
            base <- base * base
    result.i64()

export fn binary_exponentiation(values: i64&, length: usize) -> i64 = binary_exponentiation_impl
