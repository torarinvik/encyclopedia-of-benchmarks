# Recursive row search matching the pinned matrix-search source.
def search_row(values: view[i64], lower: i64, upper: i64, target: i64) -> i64:
    middle: i64 = (lower + upper) / 2
    value: i64 = values[middle.usize()]
    if value == target:
        return middle
    if lower >= upper:
        return -1
    if value < target:
        return search_row(values, middle + 1, upper, target)
    search_row(values, lower, middle - 1, target)

def binary_search_matrix_impl(values: i64&, length: usize) -> i64:
    if length < 3:
        return -1
    rows_value: i64 = values[0]
    columns_value: i64 = values[1]
    target: i64 = values[2]
    if rows_value <= 0 or rows_value > 32 or columns_value <= 0 or columns_value > 32:
        return -1
    rows: usize = rows_value.usize()
    columns: usize = columns_value.usize()
    if length != 3 + rows * columns:
        return -1
    if values[3] == target:
        return 0
    row: mutable usize = 0
    while row < rows and values[3 + row * columns] < target:
        row_start: usize = 3 + row * columns
        column: i64 = search_row(values[row_start:row_start + columns], 0, columns.i64() - 1, target)
        if column != -1:
            return (row * columns).i64() + column
        row <- row + 1
    -1

export fn binary_search_matrix(values: i64&, length: usize) -> i64 = binary_search_matrix_impl
