def bdd_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits >> (byte * 8)).u8()

def binary_decision_graph_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 65:
        return -1
    nv: i64 = input[0]
    if nv < 1 or nv > 6 or length != 1 + (1 << nv.usize()):
        return -1
    n: usize = nv.usize()
    count: usize = 1 << n
    ids: mutable i64[64] = zeroed
    next: mutable i64[64] = zeroed
    vars: mutable i64[63] = zeroed
    lows: mutable i64[63] = zeroed
    highs: mutable i64[63] = zeroed
    for i in 0..<count:
        if input[i + 1] != 0 and input[i + 1] != 1:
            return -1
        ids[i] <- input[i + 1]
    nodes: mutable usize = 0
    current_count: mutable usize = count
    for step in 0..<n:
        variable: usize = n - 1 - step
        next_count: usize = current_count / 2
        for p in 0..<next_count:
            lo: i64 = ids[2 * p]
            hi: i64 = ids[2 * p + 1]
            if lo == hi:
                next[p] <- lo
            else:
                found: mutable usize = nodes
                j: mutable usize = nodes
                while j > 0:
                    j <- j - 1
                    if vars[j].usize() != variable:
                        break
                    if lows[j] == lo and highs[j] == hi:
                        found <- j
                        break
                if found == nodes:
                    vars[nodes] <- variable.i64()
                    lows[nodes] <- lo
                    highs[nodes] <- hi
                    next[p] <- (2 + nodes).i64()
                    nodes <- nodes + 1
                else:
                    next[p] <- (2 + found).i64()
        for p in 0..<next_count:
            ids[p] <- next[p]
        current_count <- next_count
    output_length: usize = 8 * (2 + 3 * nodes)
    if output == null or capacity < output_length:
        return -2
    bdd_put_i64(output[0:output_length], 0, ids[0])
    bdd_put_i64(output[0:output_length], 8, nodes.i64())
    for i in 0..<nodes:
        bdd_put_i64(output[0:output_length], (2 + 3 * i) * 8, vars[i])
        bdd_put_i64(output[0:output_length], (3 + 3 * i) * 8, lows[i])
        bdd_put_i64(output[0:output_length], (4 + 3 * i) * 8, highs[i])
    output_length.i64()

export fn binary_decision_graph(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = binary_decision_graph_impl
