def binomial_calculate_impl(input: i64&, length: usize) -> i64:
    if length != 2 or input.is_null():
        return -1
    n: i64 = input[0]
    k: mutable i64 = input[1]
    if n < 0 or n > 62 or k < 0 or k > n:
        return -1
    if k > n / 2:
        k <- n - k
    result: mutable u64 = 1.u64()
    i: mutable i64 = 1
    while i <= k:
        result <- result * (n - k + i).u64()
        result <- result / i.u64()
        i <- i + 1
    result.i64()

export fn binomial_calculate(input: i64&, length: usize) -> i64 = binomial_calculate_impl
