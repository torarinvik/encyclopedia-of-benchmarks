const N: usize = 24
const E: usize = 2 * N + N * (N - 1) / 2
const P: usize = N * (N - 1) / 2
struct BentleySeg:
    x1: i64
    y1: i64
    x2: i64
    y2: i64
struct BentleyEvent:
    x: i64
    y: i64
    a: usize
    b: usize
    kind: usize
    done: bool

def bentley_cross(ax: i64, ay: i64, bx: i64, by: i64) -> i64:
    ax * by - ay * bx

def bentley_intersection(a: BentleySeg, b: BentleySeg, x: mutable i64&, y: mutable i64&) -> bool:
    rx: i64 = a.x2 - a.x1
    ry: i64 = a.y2 - a.y1
    sx: i64 = b.x2 - b.x1
    sy: i64 = b.y2 - b.y1
    d: mutable i64 = bentley_cross(rx, ry, sx, sy)
    if d == 0:
        return false
    t: mutable i64 = bentley_cross(b.x1 - a.x1, b.y1 - a.y1, sx, sy)
    u: mutable i64 = bentley_cross(b.x1 - a.x1, b.y1 - a.y1, rx, ry)
    if d < 0:
        d <- -d
        t <- -t
        u <- -u
    if t <= 0 or t >= d or u <= 0 or u >= d:
        return false
    xn: i64 = a.x1 * d + t * rx
    yn: i64 = a.y1 * d + t * ry
    if xn % d != 0 or yn % d != 0:
        return false
    x <- xn / d
    y <- yn / d
    true

def bentley_less(s: BentleySeg[N], a: usize, b: usize, x: i64) -> bool:
    da: i64 = s[a].x2 - s[a].x1
    db: i64 = s[b].x2 - s[b].x1
    na: i64 = s[a].y1 * da + (x - s[a].x1) * (s[a].y2 - s[a].y1)
    nb: i64 = s[b].y1 * db + (x - s[b].x1) * (s[b].y2 - s[b].y1)
    c: i64 = na * db - nb * da
    if c != 0:
        return c < 0
    slope: i64 = (s[a].y2 - s[a].y1) * db - (s[b].y2 - s[b].y1) * da
    if slope != 0:
        return slope < 0
    a < b

def bentley_put(output: mutable view[u8], slot: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for i in 0..<8:
        output[slot * 8 + i] <- (bits & 255).u8()
        bits <- bits >> 8

def bentley_ottmann_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or input[0] < 0 or input[0] > N.i64():
        return -1
    n: usize = input[0].usize()
    if length != 1 + 4 * n:
        return -1
    segments: mutable BentleySeg[N] = zeroed
    for i in 0..<n:
        x1: i64 = input[1 + 4 * i]
        y1: i64 = input[2 + 4 * i]
        x2: i64 = input[3 + 4 * i]
        y2: i64 = input[4 + 4 * i]
        if x1 < -1000 or x1 > 1000 or x2 < -1000 or x2 > 1000 or y1 < -1000 or y1 > 1000 or y2 < -1000 or y2 > 1000 or x1 == x2:
            return -1
        if x1 < x2:
            segments[i] <- BentleySeg(x1, y1, x2, y2)
        else:
            segments[i] <- BentleySeg(x2, y2, x1, y1)
    events: mutable BentleyEvent[E] = zeroed
    ec: mutable usize = 0
    for i in 0..<n:
        events[ec] <- BentleyEvent(segments[i].x1, segments[i].y1, i, 0, 0, false)
        ec <- ec + 1
        events[ec] <- BentleyEvent(segments[i].x2, segments[i].y2, i, 0, 1, false)
        ec <- ec + 1
    scheduled: mutable bool[N * N] = zeroed
    active: mutable usize[N] = zeroed
    ac: mutable usize = 0
    points: mutable i64[P * 2] = zeroed
    pc: mutable usize = 0
    while true:
        ei: mutable usize = ec
        for j in 0..<ec:
            if not events[j].done and (ei == ec or events[j].x < events[ei].x or (events[j].x == events[ei].x and events[j].y < events[ei].y)):
                ei <- j
        if ei == ec:
            break
        e: BentleyEvent = events[ei]
        events[ei].done <- true
        if e.kind == 0:
            active[ac] <- e.a
            ac <- ac + 1
        else if e.kind == 1:
            for j in 0..<ac:
                if active[j] == e.a:
                    for k in (j + 1)..<ac:
                        active[k - 1] <- active[k]
                    ac <- ac - 1
                    break
        else:
            points[pc * 2] <- e.x
            points[pc * 2 + 1] <- e.y
            pc <- pc + 1
        for i in 1..<ac:
            v: usize = active[i]
            j: mutable usize = i
            while j > 0 and bentley_less(segments, v, active[j - 1], e.x):
                active[j] <- active[j - 1]
                j <- j - 1
            active[j] <- v
        for i in 1..<ac:
            a: usize = active[i - 1]
            b: usize = active[i]
            if scheduled[a * N + b]:
                continue
            x: mutable i64 = 0
            y: mutable i64 = 0
            if bentley_intersection(segments[a], segments[b], x, y) and x > e.x:
                if ec >= E:
                    return -1
                events[ec] <- BentleyEvent(x, y, a, b, 2, false)
                ec <- ec + 1
                scheduled[a * N + b] <- true
                scheduled[b * N + a] <- true
    for i in 1..<pc:
        x: i64 = points[i * 2]
        y: i64 = points[i * 2 + 1]
        j: mutable usize = i
        while j > 0 and (points[(j - 1) * 2] > x or (points[(j - 1) * 2] == x and points[(j - 1) * 2 + 1] > y)):
            points[j * 2] <- points[(j - 1) * 2]
            points[j * 2 + 1] <- points[(j - 1) * 2 + 1]
            j <- j - 1
        points[j * 2] <- x
        points[j * 2 + 1] <- y
    bytes: usize = (1 + 2 * pc) * 8
    if output == null or capacity < bytes:
        return -2
    bentley_put(output[0:bytes], 0, pc.i64())
    for i in 0..<pc:
        bentley_put(output[0:bytes], 1 + 2 * i, points[2 * i])
        bentley_put(output[0:bytes], 2 + 2 * i, points[2 * i + 1])
    bytes.i64()

export def bentley_ottmann(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    bentley_ottmann_impl(input, length, output, capacity)
