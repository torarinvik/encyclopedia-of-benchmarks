# Reduce the input array to its minimum with a sign-bit mask.
const MAX_LENGTH: usize = 4096
const MAX_VALUE: i64 = 2147483647

def bitwisemin_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > MAX_LENGTH:
        return -1
    minimum: mutable i64 = values[0]
    if minimum < 0 or minimum > MAX_VALUE:
        return -1
    index: mutable usize = 1
    while index < length:
        value: i64 = values[index]
        if value < 0 or value > MAX_VALUE:
            return -1
        difference: i64 = minimum - value
        sign: u32 = (difference.u32() >> 31) & 1.u32()
        keep_minimum: u32 = 0xFFFF_FFFF.u32() * sign
        minimum <- ((minimum.u32() & keep_minimum) | (value.u32() & ~keep_minimum)).i64()
        index <- index + 1
    minimum

export fn bitwisemin(values: i64&, length: usize) -> i64 = bitwisemin_impl
