const MAX_DIMENSION: usize = 8
const MAX_INPUT_LENGTH: usize = 65
const INVALID_RESULT: i64 = -9223372036854775807 - 1

def bareiss_determinant_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_INPUT_LENGTH:
        return INVALID_RESULT
    dimension_value: i64 = input[0]
    if dimension_value < 1 or dimension_value > 8:
        return INVALID_RESULT
    dimension: usize = dimension_value.usize()
    if length != 1 + dimension * dimension:
        return INVALID_RESULT

    matrix: mutable i64[64] = zeroed
    index: mutable usize = 0
    while index < dimension * dimension:
        value: i64 = input[1 + index]
        if value < -4 or value > 4:
            return INVALID_RESULT
        matrix[index] <- value
        index <- index + 1

    sign: mutable i64 = 1
    previous_pivot: mutable i64 = 1
    pivot_index: mutable usize = 0
    while pivot_index + 1 < dimension:
        pivot_offset: usize = pivot_index * dimension + pivot_index
        if matrix[pivot_offset] == 0:
            replacement: mutable usize = pivot_index + 1
            while replacement < dimension and matrix[replacement * dimension + pivot_index] == 0:
                replacement <- replacement + 1
            if replacement == dimension:
                return 0
            column: mutable usize = 0
            while column < dimension:
                temporary: i64 = matrix[pivot_index * dimension + column]
                matrix[pivot_index * dimension + column] <- matrix[replacement * dimension + column]
                matrix[replacement * dimension + column] <- temporary
                column <- column + 1
            sign <- -sign

        pivot: i64 = matrix[pivot_offset]
        row: mutable usize = pivot_index + 1
        while row < dimension:
            column: mutable usize = pivot_index + 1
            while column < dimension:
                numerator: i64 = (
                    matrix[row * dimension + column] * pivot
                    - matrix[row * dimension + pivot_index] * matrix[pivot_index * dimension + column]
                )
                matrix[row * dimension + column] <- numerator / previous_pivot
                column <- column + 1
            matrix[row * dimension + pivot_index] <- 0
            row <- row + 1
        previous_pivot <- pivot
        pivot_index <- pivot_index + 1

    sign * matrix[(dimension - 1) * dimension + dimension - 1]

export fn bareiss_determinant(input: i64&, length: usize) -> i64 = bareiss_determinant_impl
