# Binary-grouped bounded knapsack with an ABI-boundary reference and safe view.
const BKB_MAX_TYPES: usize = 16
const BKB_MAX_CAPACITY: usize = 64
const BKB_MAX_INPUT: usize = 51

def bounded_knapsack_binary_grouping_impl(values: view[i64], length: usize) -> i64:
    if length < 2 or length > BKB_MAX_INPUT or values.len() != length: return -1
    n_value: i64 = values[0]
    capacity_value: i64 = values[1]
    if n_value < 0 or n_value > BKB_MAX_TYPES.i64() or
       capacity_value < 0 or capacity_value > BKB_MAX_CAPACITY.i64(): return -1
    n: usize = n_value.usize()
    capacity: usize = capacity_value.usize()
    if length != 2 + 3 * n: return -1
    item: mutable usize = 0
    while item < n:
        weight: i64 = values[2 + 3 * item]
        value: i64 = values[3 + 3 * item]
        count: i64 = values[4 + 3 * item]
        if weight < 1 or weight > 16 or value < 0 or value > 100 or count < 0 or count > 16:
            return -1
        item <- item + 1

    best_storage: mutable i64[65] = zeroed
    best: mutable view[i64] = best_storage[0:65]
    item <- 0
    while item < n:
        weight: usize = values[2 + 3 * item].usize()
        value: i64 = values[3 + 3 * item]
        remaining: mutable usize = values[4 + 3 * item].usize()
        bundle_size: mutable usize = 1
        while remaining > 0:
            copies: usize = bundle_size
            if copies > remaining: copies <- remaining
            bundle_weight: usize = weight * copies
            bundle_value: i64 = value * copies.i64()
            if bundle_weight <= capacity:
                limit: mutable usize = capacity
                while limit >= bundle_weight:
                    candidate: i64 = best[limit - bundle_weight] + bundle_value
                    if candidate > best[limit]: best[limit] <- candidate
                    if limit == bundle_weight: break
                    limit <- limit - 1
            remaining <- remaining - copies
            bundle_size <- bundle_size * 2
        item <- item + 1
    best[capacity]

export fn bounded_knapsack_binary_grouping(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > BKB_MAX_INPUT: return -1
    let values: view[i64] = input[0:length]
    bounded_knapsack_binary_grouping_impl(values, length)
