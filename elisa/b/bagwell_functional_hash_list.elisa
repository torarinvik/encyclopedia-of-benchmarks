# Clean-room bounded Bagwell functional hash-list; raw pointers are confined to FFI.
const BFH_SLOTS: usize = 56
const BFH_MAX_INPUT: usize = 131
const BFH_ABSENT: i64 = -9223372036854775807 - 1

def bfh_start(block: usize) -> usize:
    if block == 0: return 0
    if block == 1: return 8
    24

def bfh_side(block: usize) -> usize:
    if block == 0: return 8
    if block == 1: return 16
    32

def bfh_put(output: mutable view[u8], at: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[at + byte] <- (bits >> (8 * byte)).u8()
        byte <- byte + 1

def bfh_impl(input: view[i64], output: mutable view[u8], capacity: usize,
             output_is_null: bool) -> i64:
    if input.length < 2 or input.length > BFH_MAX_INPUT: return -1
    n64: i64 = input[0]
    if n64 < 0 or n64 > 32: return -1
    n: usize = n64.usize()
    q_at: usize = 1 + 2 * n
    if q_at >= input.length: return -1
    q64: i64 = input[q_at]
    if q64 < 1 or q64 > 32: return -1
    q: usize = q64.usize()
    query_at: usize = q_at + 1
    if input.length != 2 + 2 * n + 2 * q: return -1
    i: mutable usize = 0
    while i < n:
        if input[1 + 2 * i] < -2147483648 or input[1 + 2 * i] > 2147483647 or
           input[2 + 2 * i] < -2147483648 or input[2 + 2 * i] > 2147483647: return -1
        i <- i + 1
    i <- 0
    while i < q:
        root: i64 = input[query_at + 2 * i]
        key: i64 = input[query_at + 2 * i + 1]
        if root < 0 or root > n64 or key < -2147483648 or key > 2147483647: return -1
        i <- i + 1
    output_bytes: usize = 8 * q
    if output_is_null or output.length < output_bytes or capacity < output_bytes: return -2

    var keys = InlineArray[i64, 56](fill=0)
    var vals = InlineArray[i64, 56](fill=0)
    var next = InlineArray[i64, 56](fill=-1)
    var heads = InlineArray[i64, 56](fill=-1)
    var prev = InlineArray[i64, 3](fill=-1)
    var root_block = InlineArray[i64, 33](fill=-1)
    var root_offset = InlineArray[i64, 33](fill=-1)
    var keys_view: mutable view[i64] = keys[0:56]
    var vals_view: mutable view[i64] = vals[0:56]
    var next_view: mutable view[i64] = next[0:56]
    var heads_view: mutable view[i64] = heads[0:56]
    var prev_view: mutable view[i64] = prev[0:3]
    var blocks_view: mutable view[i64] = root_block[0:33]
    var offsets_view: mutable view[i64] = root_offset[0:33]
    var current: usize = 0
    i <- 0
    while i < n:
        if i == 8 or i == 24:
            prev_view[current + 1] <- current.i64()
            current <- current + 1
        start: usize = bfh_start(current)
        side: usize = bfh_side(current)
        offset: usize = i - start
        slot: usize = start + offset
        key: i64 = input[1 + 2 * i]
        bucket: usize = start + (key.u64() & (side - 1).u64()).usize()
        keys_view[slot] <- key
        vals_view[slot] <- input[2 + 2 * i]
        next_view[slot] <- heads_view[bucket]
        heads_view[bucket] <- offset.i64()
        blocks_view[i + 1] <- current.i64()
        offsets_view[i + 1] <- offset.i64()
        i <- i + 1

    var j: mutable usize = 0
    while j < q:
        root: usize = input[query_at + 2 * j].usize()
        key: i64 = input[query_at + 2 * j + 1]
        block: mutable i64 = blocks_view[root]
        limit: i64 = offsets_view[root]
        answer: mutable i64 = BFH_ABSENT
        if block >= 0:
            first: mutable bool = true
            while block >= 0 and answer == BFH_ABSENT:
                b: usize = block.usize()
                start: usize = bfh_start(b)
                side: usize = bfh_side(b)
                bucket: usize = start + (key.u64() & (side - 1).u64()).usize()
                chain: mutable i64 = heads_view[bucket]
                while chain >= 0:
                    slot: usize = start + chain.usize()
                    if (not first or chain <= limit) and keys_view[slot] == key:
                        answer <- vals_view[slot]
                        break
                    chain <- next_view[slot]
                block <- prev_view[b]
                first <- false
        bfh_put(output, 8 * j, answer)
        j <- j + 1
    output_bytes.i64()

export fn bagwell_functional_hash_list(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > BFH_MAX_INPUT: return -1
    if output.is_null():
        var empty_output = InlineArray[u8, 1](fill=0)
        return bfh_impl(input[0:length], empty_output[0:0], capacity, true)
    bfh_impl(input[0:length], output[0:capacity], capacity, false)
