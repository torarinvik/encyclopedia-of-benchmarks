const MAX_TEXT_LENGTH: usize = 4096
const MAX_PATTERN_LENGTH: usize = 63

def bitap_string_match_impl(values: i64&, length: usize) -> i64:
    if length < 2 or values[0] < 0 or values[0] > 4096 or values[1] < 0 or values[1] > 63:
        return -2
    text_length: usize = values[0].usize()
    pattern_length: usize = values[1].usize()
    if length != 2 + text_length + pattern_length:
        return -2
    for index in 2..<length:
        if values[index] < 97 or values[index] > 122:
            return -2
    if pattern_length == 0:
        return 0
    if pattern_length > text_length:
        return -1

    masks: mutable u64[26] = zeroed
    for letter in 0..<26:
        masks[letter] <- (-1).u64()
    for index in 0..<pattern_length:
        letter: usize = (values[2 + text_length + index] - 97).usize()
        masks[letter] <- masks[letter] & ~((1).u64() << index)
    state: mutable u64 = (-2).u64()
    for index in 0..<text_length:
        letter: usize = (values[2 + index] - 97).usize()
        state <- state | masks[letter]
        state <- state << 1
        if (state & ((1).u64() << pattern_length)) == 0:
            return index.i64() - pattern_length.i64() + 1
    -1

export fn bitap_string_match(values: i64&, length: usize) -> i64 = bitap_string_match_impl
