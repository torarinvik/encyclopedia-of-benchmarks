# Hopcroft-Karp maximum cardinality matching for a bounded bipartite graph.
const MAX_SIDE: usize = 64
const MAX_EDGES: usize = 4096
const INF_DISTANCE: i64 = 1000000

def dfs_augment(left: usize, right_count: usize, adjacency: view[i64], distance: mutable view[i64],
    nil_distance: i64, pair_left: mutable view[i64], pair_right: mutable view[i64]) -> bool:
    right: mutable usize = 0
    while right < right_count:
        if adjacency[left * MAX_SIDE + right] != 0:
            mate: i64 = pair_right[right]
            if mate < 0:
                if distance[left] + 1 == nil_distance:
                    pair_left[left] <- right.i64()
                    pair_right[right] <- left.i64()
                    return true
            else:
                if (distance[mate.usize()] == distance[left] + 1 and
                    dfs_augment(mate.usize(), right_count, adjacency, distance,
                        nil_distance, pair_left, pair_right)):
                    pair_left[left] <- right.i64()
                    pair_right[right] <- left.i64()
                    return true
        right <- right + 1
    distance[left] <- INF_DISTANCE
    false

def bfs_layers(left_count: usize, right_count: usize, adjacency: view[i64],
    pair_right: view[i64], distance: mutable view[i64]) -> i64:
    queue: mutable usize[64] = zeroed
    head: mutable usize = 0
    queue_end: mutable usize = 0
    left: mutable usize = 0
    right: mutable usize = 0
    while left < left_count:
        if distance[left] == 0:
            queue[queue_end] <- left
            queue_end <- queue_end + 1
        left <- left + 1
    nil_distance: mutable i64 = INF_DISTANCE
    while head < queue_end:
        left <- queue[head]
        head <- head + 1
        if distance[left] + 1 <= nil_distance:
            right <- 0
            while right < right_count:
                if adjacency[left * MAX_SIDE + right] != 0:
                    mate: i64 = pair_right[right]
                    if mate < 0:
                        if distance[left] + 1 < nil_distance:
                            nil_distance <- distance[left] + 1
                    else:
                        if distance[mate.usize()] < 0:
                            distance[mate.usize()] <- distance[left] + 1
                            queue[queue_end] <- mate.usize()
                            queue_end <- queue_end + 1
                right <- right + 1
    nil_distance

export fn bipartite_matching_hopcroft_karp(input: i64&, length: usize) -> i64:
    if length < 3:
        return -1
    left_value: i64 = input[0]
    right_value: i64 = input[1]
    edge_value: i64 = input[2]
    if left_value < 0 or left_value > 64 or right_value < 0 or right_value > 64 or edge_value < 0 or edge_value > 4096:
        return -1
    left_count: usize = left_value.usize()
    right_count: usize = right_value.usize()
    edge_count: usize = edge_value.usize()
    if length != 3 + 2 * edge_count:
        return -1
    adjacency: mutable i64[4096] = zeroed
    edge: mutable usize = 0
    while edge < edge_count:
        left: i64 = input[3 + 2 * edge]
        right: i64 = input[4 + 2 * edge]
        if left < 0 or left >= left_value or right < 0 or right >= right_value:
            return -1
        adjacency[left.usize() * MAX_SIDE + right.usize()] <- 1
        edge <- edge + 1
    pair_left: mutable i64[64] = zeroed
    pair_right: mutable i64[64] = zeroed
    distance: mutable i64[64] = zeroed
    left: mutable usize = 0
    while left < left_count:
        pair_left[left] <- -1
        left <- left + 1
    right: mutable usize = 0
    while right < right_count:
        pair_right[right] <- -1
        right <- right + 1
    matching: mutable i64 = 0
    while true:
        left <- 0
        while left < left_count:
            if pair_left[left] < 0:
                distance[left] <- 0
            else:
                distance[left] <- -1
            left <- left + 1
        nil_distance: i64 = bfs_layers(left_count, right_count,
            adjacency[0:4096], pair_right[0:64], distance[0:64])
        if nil_distance == INF_DISTANCE:
            break
        left <- 0
        while left < left_count:
            if pair_left[left] < 0 and dfs_augment(left, right_count,
                adjacency[0:4096], distance[0:64],
                nil_distance, pair_left[0:64], pair_right[0:64]):
                matching <- matching + 1
            left <- left + 1
    matching
