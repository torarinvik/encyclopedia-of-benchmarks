# Integer Bresenham rasterization with both endpoints included.
def bresenham_line_write_i32(output: mutable view[u8], position: usize, value: i64) -> void:
    bits: u32 = value.u32()
    output[position] <- (bits & 255).u8()
    output[position + 1] <- ((bits >> 8) & 255).u8()
    output[position + 2] <- ((bits >> 16) & 255).u8()
    output[position + 3] <- ((bits >> 24) & 255).u8()

def bresenham_line_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if length != 4:
        return -1
    for index in 0..<4:
        if values[index] < -1000000 or values[index] > 1000000:
            return -1

    x0: i64 = values[0]
    y0: i64 = values[1]
    x1: i64 = values[2]
    y1: i64 = values[3]
    dx: mutable i64 = x0 - x1
    if x0 < x1:
        dx <- x1 - x0
    else:
        dx <- x0 - x1
    dy: mutable i64 = y0 - y1
    if y0 < y1:
        dy <- y1 - y0
    else:
        dy <- y0 - y1
    major_steps: mutable i64 = dx
    if dy > major_steps:
        major_steps <- dy
    if major_steps > 4096:
        return -1
    required: usize = (major_steps + 1).usize() * 8
    if output_capacity < required:
        return -2

    sx: mutable i64 = -1
    if x0 < x1:
        sx <- 1
    sy: mutable i64 = -1
    if y0 < y1:
        sy <- 1
    x: mutable i64 = x0
    y: mutable i64 = y0
    err: mutable i64 = dx - dy
    position: mutable usize = 0
    while true:
        bresenham_line_write_i32(output[0:required], position, x)
        bresenham_line_write_i32(output[0:required], position + 4, y)
        position <- position + 8
        if x == x1 and y == y1:
            break
        e2: i64 = 2 * err
        if e2 > -dy:
            err <- err - dy
            x <- x + sx
        if e2 < dx:
            err <- err + dx
            y <- y + sy
    position.i64()

export fn bresenham_line(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = bresenham_line_impl
