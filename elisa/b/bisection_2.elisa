const INVALID_RESULT: f64 = -1.0e300
const MAX_ENDPOINT_MILLI: i64 = 100000

def equation(x: f64) -> f64:
    10.0 - x * x

def bisection_2_impl(input: i64&, length: usize) -> f64:
    if input == null or length != 2:
        return INVALID_RESULT
    left_milli: i64 = input[0]
    right_milli: i64 = input[1]
    if left_milli < -MAX_ENDPOINT_MILLI or left_milli > MAX_ENDPOINT_MILLI or right_milli < -MAX_ENDPOINT_MILLI or right_milli > MAX_ENDPOINT_MILLI or left_milli >= right_milli:
        return INVALID_RESULT
    a: mutable f64 = f64(left_milli) / 1000.0
    b: mutable f64 = f64(right_milli) / 1000.0
    if equation(a) * equation(b) >= 0.0:
        return INVALID_RESULT
    c: mutable f64 = a
    while b - a >= 0.01:
        c <- (a + b) / 2.0
        if equation(c) == 0.0:
            break
        if equation(c) * equation(a) < 0.0:
            b <- c
        else:
            a <- c
    c

export fn bisection_2(input: i64&, length: usize) -> f64 = bisection_2_impl
