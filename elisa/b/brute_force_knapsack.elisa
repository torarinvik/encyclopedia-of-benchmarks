def brute_force_knapsack_solve(packed: view[i64], item_count: usize, capacity: i64) -> i64:
    if item_count == 0 or capacity == 0:
        return 0
    weight: i64 = packed[2 + 2 * (item_count - 1)]
    value: i64 = packed[3 + 2 * (item_count - 1)]
    if weight > capacity:
        return brute_force_knapsack_solve(packed, item_count - 1, capacity)
    excluded: i64 = brute_force_knapsack_solve(packed, item_count - 1, capacity)
    included: i64 = value + brute_force_knapsack_solve(packed, item_count - 1, capacity - weight)
    if excluded > included:
        return excluded
    included

def brute_force_knapsack_impl(packed: i64&, length: usize) -> i64:
    if packed == null or length < 2 or length > 30:
        return -1
    capacity: i64 = packed[0]
    count_value: i64 = packed[1]
    if capacity < 0 or capacity > 512 or count_value < 0 or count_value > 14:
        return -1
    item_count: usize = count_value.usize()
    if length != 2 + 2 * item_count:
        return -1
    index: mutable usize = 0
    while index < item_count:
        weight: i64 = packed[2 + 2 * index]
        value: i64 = packed[3 + 2 * index]
        if weight < 1 or weight > 4096 or value < 0 or value > 100000000:
            return -1
        index <- index + 1
    brute_force_knapsack_solve(packed[0:length], item_count, capacity)

export fn brute_force_knapsack(packed: i64&, length: usize) -> i64 = brute_force_knapsack_impl
