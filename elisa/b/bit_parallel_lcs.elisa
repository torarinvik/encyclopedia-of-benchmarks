# Uncompiled multiword bit-parallel LCS length draft.
def bplcs_solve(values: i64&, values_length: usize) -> i64:
    if values_length < 2 or values_length > 515: return -1
    nr: i64 = values[0]
    mr: i64 = values[1]
    if nr < 0 or nr > 256 or mr < 0 or mr > 256: return -1
    n: usize = nr.usize()
    m: usize = mr.usize()
    if values_length != 2 + n + m: return -1
    for i in 2..<values_length:
        if values[i] < 0 or values[i] > 255: return -1
    masks: mutable u64[1024] = zeroed
    row: mutable u64[4] = zeroed
    words: usize = (n + 63) / 64
    for i in 0..<n:
        slot: usize = values[2 + i].usize() * 4 + i / 64
        masks[slot] <- masks[slot] | (1.u64() << (i % 64))
    for i in 0..<m:
        symbol: usize = values[2 + n + i].usize()
        carry: mutable u64 = 1
        borrow: mutable u64 = 0
        for j in 0..<words:
            old: u64 = row[j]
            combined: u64 = old | masks[symbol * 4 + j]
            shifted: u64 = (old << 1) | carry
            carry <- old >> 63
            partial: mutable u64 = 0
            first_borrow: bool = combined < shifted
            if first_borrow: partial <- ~(shifted - combined) + 1
            else: partial <- combined - shifted
            second_borrow: bool = partial < borrow
            difference: mutable u64 = 0
            if second_borrow: difference <- ~0.u64()
            else: difference <- partial - borrow
            borrow <- 1 if first_borrow or second_borrow else 0
            row[j] <- combined & (combined ^ difference)
    result: mutable i64 = 0
    for j in 0..<words:
        word: mutable u64 = row[j]
        while word != 0:
            word <- word & (word - 1)
            result <- result + 1
    result

def bit_parallel_lcs_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > 515: return -1
    bplcs_solve(input, length)

export fn bit_parallel_lcs(input: i64&, length: usize) -> i64 = bit_parallel_lcs_impl
