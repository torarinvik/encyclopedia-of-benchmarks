# Evaluate net present value for each supplied discount rate.
extern pow(base: f64, exponent: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def store_f64_le(value: f64, output: mutable u8&, offset: usize) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    b: mutable usize = 0
    while b < 8:
        output[offset + b] <- (bits & 255).u8()
        bits <- bits >> 8
        b <- b + 1

def npv_sensitivity_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2 or input[0] < 0 or input[0] > 64 or input[1] < 0 or input[1] > 32: return -1
    n: usize = input[0].usize()
    rate_count: usize = input[1].usize()
    if length != 2 + n + rate_count: return -1
    i: mutable usize = 0
    while i < n:
        if input[2 + i] < -1000000 or input[2 + i] > 1000000: return -1
        i <- i + 1
    i <- 0
    while i < rate_count:
        if input[2 + n + i] < 0 or input[2 + n + i] > 1000: return -1
        i <- i + 1
    if capacity < rate_count * 8: return -2
    rate_index: mutable usize = 0
    while rate_index < rate_count:
        rate: f64 = input[2 + n + rate_index].f64() / 10000.0
        total: mutable f64 = 0.0
        t: mutable usize = 0
        while t < n:
            term: f64 = input[2 + t].f64() / pow(1.0 + rate, t.f64())
            total <- total + term
            t <- t + 1
        store_f64_le(total, output, rate_index * 8)
        rate_index <- rate_index + 1
    (rate_count * 8).i64()

export fn npv_sensitivity(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = npv_sensitivity_impl
