# Count labeled binary trees using the pinned Catalan-times-factorial formula.
def number_of_possible_binary_trees_impl(node_count: i64) -> i64:
    if node_count < 1 or node_count > 14:
        return -1
    binomial: mutable i64 = 1
    index: mutable i64 = 0
    while index < node_count:
        binomial <- binomial * (2 * node_count - index)
        binomial <- binomial / (index + 1)
        index <- index + 1
    catalan: i64 = binomial / (node_count + 1)
    factorial: mutable i64 = 1
    factor: mutable i64 = 2
    while factor <= node_count:
        factorial <- factorial * factor
        factor <- factor + 1
    catalan * factorial

export fn number_of_possible_binary_trees(node_count: i64) -> i64 = number_of_possible_binary_trees_impl
