const MAX_ITEMS: usize = 256
const RNG_MODULUS: i64 = 2147483647
const RNG_PERIOD: i64 = 2147483646

def naive_shuffler_impl(input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if length < 2 or length > MAX_ITEMS + 2:
        return -1
    if input[0] < 0 or input[0] >= RNG_PERIOD or input[1] < 0 or input[1] > 256:
        return -1
    count: usize = input[1].usize()
    if length != count + 2:
        return -1
    items: mutable u8[MAX_ITEMS] = zeroed
    index: mutable usize = 0
    while index < count:
        if input[index + 2] < 0 or input[index + 2] > 255:
            return -1
        items[index] <- input[index + 2].u8()
        index <- index + 1
    if output_capacity < count:
        return -2

    state: mutable i64 = input[0] + 1
    index <- 0
    while index < count:
        bound: i64 = count.i64()
        limit: i64 = RNG_PERIOD - RNG_PERIOD % bound
        sample: mutable i64 = 0
        accepted: mutable bool = false
        while not accepted:
            state <- (state * 48271) % RNG_MODULUS
            sample <- state - 1
            if sample < limit:
                accepted <- true
        other: usize = (sample % bound).usize()
        temporary: u8 = items[index]
        items[index] <- items[other]
        items[other] <- temporary
        index <- index + 1
    index <- 0
    while index < count:
        output[index] <- items[index]
        index <- index + 1
    count.i64()

export fn naive_shuffler(input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = naive_shuffler_impl
