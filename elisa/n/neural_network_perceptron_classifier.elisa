def neural_network_perceptron_classifier_impl(v: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 5: return -1
    f: i64 = v[0]; s: i64 = v[1]; bias: i64 = v[2]
    if f < 1 or f > 3 or s < 1 or s > 4 or bias < -10000 or bias > 10000 or length != (3+f+f*s).usize(): return -1
    i: mutable usize = 0
    while i < f.usize():
        if v[3+i] < -10000 or v[3+i] > 10000: return -1
        i <- i+1
    while i < (f+s*f).usize():
        if v[3+i] < -10 or v[3+i] > 10: return -1
        i <- i+1
    if capacity < s.usize(): return -2
    j: mutable usize = 0
    while j < s.usize():
        z: mutable i64 = bias
        i <- 0
        while i < f.usize():
            z <- z+v[3+i]*v[3+f.usize()+i*s.usize()+j]
            i <- i+1
        output[j] <- (z > 0).u8()
        j <- j+1
    s
export neural_network_perceptron_classifier(v: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = neural_network_perceptron_classifier_impl
