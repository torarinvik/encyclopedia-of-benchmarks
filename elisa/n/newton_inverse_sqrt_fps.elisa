const INVERSE_SQRT_MODULUS: i64 = 998244353
const INVERSE_SQRT_HALF: i64 = 499122177

def inverse_sqrt_multiply(left: view[i64], right: view[i64], width: usize,
    result: mutable view[i64]) -> void:
    for i in 0..<width:
        result[i] <- 0
    for i in 0..<width:
        for j in 0..<(width - i):
            result[i + j] <- (result[i + j] + left[i] * right[j]) % INVERSE_SQRT_MODULUS

def newton_inverse_sqrt_fps_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize, output_is_null: bool) -> i64:
    if length < 2 or length > 66: return -1
    if input[0] < 1 or input[0] > 64: return -1
    n: usize = input[0].usize()
    if length != n + 1: return -1
    for i in 0..<n:
        if input[i + 1] < 0 or input[i + 1] >= INVERSE_SQRT_MODULUS: return -1
    if input[1] != 1: return -1
    bytes: usize = 8 * n
    if output_is_null or capacity < bytes: return -2
    f: mutable i64[64] = zeroed
    inverse: mutable i64[64] = zeroed
    square: mutable i64[64] = zeroed
    product: mutable i64[64] = zeroed
    correction: mutable i64[64] = zeroed
    next: mutable i64[64] = zeroed
    for i in 0..<n:
        f[i] <- input[i + 1]
    inverse[0] <- 1
    precision: mutable usize = 1
    while precision < n:
        width: mutable usize = 2 * precision
        if width > n: width <- n
        inverse_sqrt_multiply(inverse[0:width], inverse[0:width], width, square[0:width])
        inverse_sqrt_multiply(f[0:width], square[0:width], width, product[0:width])
        correction[0] <- (3 + INVERSE_SQRT_MODULUS - product[0]) * INVERSE_SQRT_HALF % INVERSE_SQRT_MODULUS
        for i in 1..<width:
            correction[i] <- (INVERSE_SQRT_MODULUS - product[i]) * INVERSE_SQRT_HALF % INVERSE_SQRT_MODULUS
        inverse_sqrt_multiply(inverse[0:width], correction[0:width], width, next[0:width])
        for i in 0..<width:
            inverse[i] <- next[i]
        precision <- width
    for i in 0..<n:
        bits: mutable u64 = inverse[i].u64()
        for byte in 0..<8:
            output[8 * i + byte] <- (bits & 255).u8()
            bits <- bits >> 8
    bytes.i64()

def newton_inverse_sqrt_fps_entry(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 66: return -1
    input_view: i64& = input
    if output == null:
        scratch: mutable u8[1] = zeroed
        return newton_inverse_sqrt_fps_impl(input_view, length, &scratch[0], 0, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > 512: safe_capacity <- 512
    output_view: mutable u8& = output
    newton_inverse_sqrt_fps_impl(input_view, length, output_view, capacity, false)

export fn newton_inverse_sqrt_fps(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = newton_inverse_sqrt_fps_entry
