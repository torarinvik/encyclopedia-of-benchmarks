def nearest_neighbor_interpolation_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 3 or length > 258:
        return -1
    rows_value: i64 = input[0]
    columns_value: i64 = input[1]
    if rows_value < 1 or rows_value > 16 or columns_value < 1 or columns_value > 16:
        return -1
    rows: usize = rows_value.usize()
    columns: usize = columns_value.usize()
    input_cells: usize = rows * columns
    if length != 2 + input_cells:
        return -1
    for index in 0..<input_cells:
        if input[2 + index] < 0 or input[2 + index] > 255:
            return -1

    output_rows: usize = 3 * rows / 2
    output_columns: usize = 3 * columns / 2
    output_bytes: usize = output_rows * output_columns
    if output == null or output_capacity < output_bytes:
        return -2
    for y in 0..<output_rows:
        source_y: usize = (4 * (y + 1) + 3) / 6 - 1
        for x in 0..<output_columns:
            source_x: usize = (4 * (x + 1) + 3) / 6 - 1
            output[y * output_columns + x] <- input[2 + source_y * columns + source_x].u8()
    output_bytes.i64()

export fn nearest_neighbor_interpolation(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = nearest_neighbor_interpolation_impl
