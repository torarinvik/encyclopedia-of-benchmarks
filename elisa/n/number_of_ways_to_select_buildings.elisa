const MAX_LENGTH: usize = 4096

def building_ways_for_target(values: i64&, length: usize, target: i64) -> i64:
    ways: i64 =
        while index < length |index: mutable usize = 0, first_count: mutable i64 = 0, middle_count: mutable i64 = 0, ways: mutable i64 = 0| -> ways:
            if values[index] == target:
                ways <- ways + middle_count
                first_count <- first_count + 1
            else:
                middle_count <- middle_count + first_count
            index <- index + 1
            ways
    ways

# Count alternating 0-1-0 and 1-0-1 subsequences with two linear scans.
def number_of_ways_to_select_buildings_impl(values: i64&, length: usize) -> i64:
    if length == 0:
        return 0
    if length > MAX_LENGTH:
        return -1
    valid_values: bool =
        while index < length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = values[index]
            if value != 48 and value != 49:
                break false
            index <- index + 1
            valid
    if not valid_values:
        return -1
    building_ways_for_target(values, length, 48) + building_ways_for_target(values, length, 49)

export fn number_of_ways_to_select_buildings(values: i64&, length: usize) -> i64 = number_of_ways_to_select_buildings_impl
