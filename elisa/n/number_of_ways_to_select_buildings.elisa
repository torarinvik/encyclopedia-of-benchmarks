const MAX_LENGTH: usize = 4096

# Count alternating triples as each possible last building arrives.
def number_of_ways_to_select_buildings_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    different_bits: mutable u64 = 0
    zeros: mutable u32 = 0
    ones: mutable u32 = 0
    zero_one: mutable u32 = 0
    one_zero: mutable u32 = 0
    ways: mutable u64 = 0
    index: mutable usize = 0
    while index < length:
        byte: u64 = values[index].u64() ^ 48
        different_bits <- different_bits | byte
        is_one: bool = (byte & 1) != 0
        ways <- ways + (one_zero if is_one else zero_one).u64()
        zero_one <- zero_one + (zeros if is_one else 0)
        one_zero <- one_zero + (0 if is_one else ones)
        zeros <- zeros + (0 if is_one else 1)
        ones <- ones + (1 if is_one else 0)
        index <- index + 1
    return -1 if different_bits > 1
    ways.i64()

export fn number_of_ways_to_select_buildings(values: i64&, length: usize) -> i64 = number_of_ways_to_select_buildings_impl
