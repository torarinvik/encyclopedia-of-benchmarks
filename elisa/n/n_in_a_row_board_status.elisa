# Check full rows, columns, and diagonals for one square-board player.
def n_in_a_row_board_status_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 258:
        return -1
    size_value: i64 = values[0]
    player: i64 = values[1]
    if size_value < 2 or size_value > 16 or (player != 1 and player != 2):
        return -1
    size: usize = size_value.usize()
    if length != 2 + size * size:
        return -1
    index: mutable usize = 0
    while index < size * size:
        cell: i64 = values[2 + index]
        if cell < 0 or cell > 2:
            return -1
        index <- index + 1

    has_empty: mutable bool = false
    row: mutable usize = 0
    column: mutable usize = 0
    while row < size:
        row_win: mutable bool = true
        column <- 0
        while column < size:
            cell: i64 = values[2 + row * size + column]
            if cell == 0:
                has_empty <- true
            if cell != player:
                row_win <- false
            column <- column + 1
        if row_win:
            return 1
        row <- row + 1

    column <- 0
    while column < size:
        column_win: mutable bool = true
        row <- 0
        while row < size:
            if values[2 + row * size + column] != player:
                column_win <- false
            row <- row + 1
        if column_win:
            return 1
        column <- column + 1

    main_diagonal_win: mutable bool = true
    anti_diagonal_win: mutable bool = true
    index <- 0
    while index < size:
        if values[2 + index * size + index] != player:
            main_diagonal_win <- false
        if values[2 + index * size + size - 1 - index] != player:
            anti_diagonal_win <- false
        index <- index + 1
    if main_diagonal_win or anti_diagonal_win:
        return 1
    if has_empty:
        return 0
    2

export fn n_in_a_row_board_status(values: i64&, length: usize) -> i64 = n_in_a_row_board_status_impl
