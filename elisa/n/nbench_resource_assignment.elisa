const NMAX: usize = 8
const CELLS: usize = 64
const MAX_ADJUST: usize = 2048

def first_assignment(a: mutable view[i64], mark: mutable view[u8], n: usize) -> usize:
    i: usize = 0
    while i < n*n:
        mark[i] <- 0
        i <- i+1
    total: mutable usize = 0
    while true:
        made: mutable usize = 0
        i <- 0
        while i < n:
            count: mutable usize = 0
            selected: mutable usize = 0
            j: usize = 0
            while j < n:
                if a[i*n+j] == 0 and mark[i*n+j] == 0:
                    count <- count+1
                    selected <- j
                j <- j+1
            if count == 1:
                made <- made+1
                total <- total+1
                mark[i*n+selected] <- 1
                j <- 0
                while j < n:
                    if j != i and a[j*n+selected] == 0: mark[j*n+selected] <- 2
                    j <- j+1
            i <- i+1
        j <- 0
        while j < n:
            count <- 0
            selected <- 0
            i <- 0
            while i < n:
                if a[i*n+j] == 0 and mark[i*n+j] == 0:
                    count <- count+1
                    selected <- i
                i <- i+1
            if count == 1:
                made <- made+1
                total <- total+1
                mark[selected*n+j] <- 1
                i <- 0
                while i < n:
                    if i != j and a[selected*n+i] == 0: mark[selected*n+i] <- 2
                    i <- i+1
            j <- j+1
        if made == 0: break
    if total == n: return total
    i <- 0
    while i < n:
        selected: mutable usize = n
        j: usize = 0
        while j < n:
            if a[i*n+j] == 0 and mark[i*n+j] == 0:
                selected <- j
                break
            j <- j+1
        if selected < n:
            mark[i*n+selected] <- 1
            total <- total+1
            j <- 0
            while j < n:
                if j != selected and a[i*n+j] == 0: mark[i*n+j] <- 2
                j <- j+1
            j <- 0
            while j < n:
                if j != i and a[j*n+selected] == 0: mark[j*n+selected] <- 2
                j <- j+1
        i <- i+1
    total

def adjust_tableau(a: mutable view[i64], mark: mutable view[u8], n: usize) -> bool:
    rows: mutable u8[NMAX] = zeroed
    cols: mutable u8[NMAX] = zeroed
    i: usize = 0
    while i < n:
        assigned: bool = false
        j: usize = 0
        while j < n:
            if mark[i*n+j] == 1: assigned <- true
            j <- j+1
        if not assigned: rows[i] <- 1
        i <- i+1
    while true:
        added: mutable usize = 0
        i <- 0
        while i < n:
            if rows[i] == 1:
                j: usize = 0
                while j < n:
                    if a[i*n+j] == 0: cols[j] <- 1
                    j <- j+1
            i <- i+1
        j <- 0
        while j < n:
            if cols[j] == 1:
                i <- 0
                while i < n:
                    if mark[i*n+j] == 1 and rows[i] != 1:
                        rows[i] <- 1
                        added <- added+1
                    i <- i+1
            j <- j+1
        if added == 0: break
    smallest: mutable i64 = 9223372036854775807
    i <- 0
    while i < n:
        if rows[i] == 1:
            j <- 0
            while j < n:
                if cols[j] == 0 and a[i*n+j] < smallest: smallest <- a[i*n+j]
                j <- j+1
        i <- i+1
    if smallest == 9223372036854775807: return false
    i <- 0
    while i < n:
        j <- 0
        while j < n:
            if rows[i] == 1 and cols[j] == 0: a[i*n+j] <- a[i*n+j]-smallest
            elif rows[i] == 0 and cols[j] == 1: a[i*n+j] <- a[i*n+j]+smallest
            j <- j+1
        i <- i+1
    true

def nbench_resource_assignment_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 66: return -1
    raw: i64 = input[0]
    if raw < 1 or raw > 8: return -1
    n: usize = raw.usize()
    if length != 1+n*n: return -1
    a: mutable i64[CELLS] = zeroed
    i: usize = 0
    while i < n*n:
        if input[i+1] < 0 or input[i+1] > 1000: return -1
        a[i] <- input[i+1]
        i <- i+1
    i <- 0
    while i < n:
        minimum: i64 = a[i*n]
        j: usize = 1
        while j < n:
            if a[i*n+j] < minimum: minimum <- a[i*n+j]
            j <- j+1
        j <- 0
        while j < n:
            a[i*n+j] <- a[i*n+j]-minimum
            j <- j+1
        i <- i+1
    j <- 0
    while j < n:
        minimum: i64 = a[j]
        i <- 1
        while i < n:
            if a[i*n+j] < minimum: minimum <- a[i*n+j]
            i <- i+1
        if minimum != 0:
            i <- 0
            while i < n:
                a[i*n+j] <- a[i*n+j]-minimum
                i <- i+1
        j <- j+1
    mark: mutable u8[CELLS] = zeroed
    done: mutable bool = false
    iteration: usize = 0
    while iteration <= MAX_ADJUST:
        if first_assignment(a[0:n * n], mark[0:n * n], n) == n:
            done <- true
            break
        if not adjust_tableau(a[0:n * n], mark[0:n * n], n): return -1
        iteration <- iteration+1
    if not done: return -1
    columns: mutable i32[NMAX] = zeroed
    seen: mutable bool[NMAX] = zeroed
    i <- 0
    while i < n:
        column: mutable usize = n
        j <- 0
        while j < n:
            if mark[i*n+j] == 1:
                if column != n: return -1
                column <- j
            j <- j+1
        if column == n or seen[column]: return -1
        columns[i] <- column.i32()
        seen[column] <- true
        i <- i+1
    bytes: usize = n*4
    if output.is_null() or capacity < bytes: return -2
    i <- 0
    while i < n:
        encoded: u32 = columns[i].u32()
        j: usize = 0
        while j < 4:
            output[i*4+j] <- ((encoded >> (j*8)) & 255).u8()
            j <- j+1
        i <- i+1
    bytes.i64()

export fn nbench_resource_assignment(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = nbench_resource_assignment_impl
