# Net present value with source-ordered binary64 terms.
extern pow(base: f64, exponent: f64) -> f64

def npv_impl(input: i64&, length: usize) -> f64:
    invalid: f64 = -1e300
    if length < 2 or input[0] < 0 or input[0] > 64 or input[1] < 0 or input[1] > 1000: return invalid
    n: usize = input[0].usize()
    if length != n + 2: return invalid
    t: mutable usize = 0
    while t < n:
        if input[t + 2] < -1000000 or input[t + 2] > 1000000: return invalid
        t <- t + 1
    rate: f64 = input[1].f64() / 10000.0
    total: mutable f64 = 0.0
    t <- 0
    while t < n:
        term: f64 = input[t + 2].f64() / pow(1.0 + rate, t.f64())
        total <- total + term
        t <- t + 1
    total

export fn npv(input: i64&, length: usize) -> f64 = npv_impl
