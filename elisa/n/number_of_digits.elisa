# Count base-10 digits in the magnitude of any signed 64-bit value.
def number_of_digits_impl(value: i64) -> i64:
    magnitude: mutable u64 = (-(value + 1)).u64() + 1 if value < 0 else value.u64()
    if magnitude < 10:
        return 1
    digits: mutable i64 = 1
    while magnitude >= 10000:
        magnitude <- magnitude / 10000
        digits <- digits + 4
    if magnitude < 10:
        return digits
    if magnitude < 100:
        return digits + 1
    digits + (2 if magnitude < 1000 else 3)

export fn number_of_digits(value: i64) -> i64 = number_of_digits_impl
