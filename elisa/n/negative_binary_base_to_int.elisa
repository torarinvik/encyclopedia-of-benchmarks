# Interpret most-significant-first bits in radix -2 with checked i64 folding.
def negative_binary_base_to_int_impl(input: i64&, length: usize) -> i64:
    if length < 1 or length > 63:
        return -1
    result: i64 =
        while index < length |index: mutable usize = 0, value: mutable i64 = 0| -> value:
            bit: i64 = input[index]
            if bit != 0 and bit != 1:
                return -1
            if value > 4611686018427387904 or value < -4611686018427387903:
                return -1
            value <- value * -2 + bit
            index <- index + 1
    result

export fn negative_binary_base_to_int(input: i64&, length: usize) -> i64 = negative_binary_base_to_int_impl
