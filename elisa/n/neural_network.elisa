extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&
def putd(output: mutable view[u8], offset: usize, value: f64):
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    k: mutable usize = 0
    while k < 8:
        output[offset+k] <- (bits & 255).u8()
        bits <- bits >> 8
        k <- k+1
def sigmoid(x: f64) -> f64: 1.0/(1.0+exp(-x))
def neural_network_impl(v: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 7: return -1
    ni: i64 = v[0]; nh: i64 = v[1]; no: i64 = v[2]
    if ni < 1 or ni > 3 or nh < 1 or nh > 3 or no < 1 or no > 3 or length != (3+ni+ni*nh+nh*no).usize(): return -1
    i: mutable usize = 3
    while i < length:
        if v[i] < -1000 or v[i] > 1000: return -1
        i <- i+1
    if capacity < no.usize()*8: return -2
    xs: usize = 3; w1: usize = xs+ni.usize(); w2: usize = w1+ni.usize()*nh.usize()
    hidden: [3]f64
    j: mutable usize = 0
    while j < nh.usize():
        z: mutable f64 = 0.0; i <- 0
        while i < ni.usize():
            z <- z+v[xs+i].f64()/1000.0*(v[w1+i*nh.usize()+j].f64()/1000.0)
            i <- i+1
        hidden[j] <- sigmoid(z); j <- j+1
    j <- 0
    while j < no.usize():
        z: mutable f64 = 0.0; i <- 0
        while i < nh.usize():
            z <- z+hidden[i]*(v[w2+i*no.usize()+j].f64()/1000.0)
            i <- i+1
        putd(output[0:capacity],j*8,sigmoid(z)); j <- j+1
    (no*8)
export neural_network(v: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = neural_network_impl
