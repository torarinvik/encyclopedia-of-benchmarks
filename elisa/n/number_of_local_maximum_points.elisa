const MAX_LENGTH: usize = 4096
const INT32_MIN_VALUE: i64 = -2147483648
const INT32_MAX_VALUE: i64 = 2147483647

def is_local_maximum(values: i64&, length: usize, index: usize) -> bool:
    if index == 0:
        return values[0] > values[1]
    if index == length - 1:
        return values[index] > values[index - 1]
    values[index] > values[index - 1] and values[index] > values[index + 1]

def count_range(values: i64&, length: usize, start: usize, end: usize) -> i64:
    if start == end:
        return if is_local_maximum(values, length, start): 1 else: 0
    middle: usize = (start + end) / 2
    count_range(values, length, start, middle) + count_range(values, length, middle + 1, end)

# Count strict local maxima using the pinned recursive partition.
def number_of_local_maximum_points_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > MAX_LENGTH:
        return -1
    i: mutable usize = 0
    while i < length:
        if values[i] < INT32_MIN_VALUE or values[i] > INT32_MAX_VALUE:
            return -1
        i <- i + 1
    if length == 1:
        return 0
    count_range(values, length, 0, length - 1)

export fn number_of_local_maximum_points(values: i64&, length: usize) -> i64 = number_of_local_maximum_points_impl
