# A neon number equals the sum of the digits of its square.
def neon_number_impl(number: i64) -> i64:
    if number < 0:
        return 0
    if number > 3000000000:
        return -1
    square: mutable i64 = number * number
    digit_sum: mutable i64 = 0
    while square > 0:
        digit_sum <- digit_sum + square % 10
        square <- square / 10
    if digit_sum == number:
        return 1
    return 0

export fn neon_number(number: i64) -> i64 = neon_number_impl
