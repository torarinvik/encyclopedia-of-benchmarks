const MAX_INPUT: usize = 39
const MODULUS: i64 = 1000000007

def number_of_ways_of_cutting_a_pizza_impl(input_values: view[i64], length: usize) -> i64:
    if length < 3 or length > MAX_INPUT:
        return -1
    rows_value: i64 = input_values[0]
    columns_value: i64 = input_values[1]
    cuts_value: i64 = input_values[2]
    if rows_value < 1 or rows_value > 6 or columns_value < 1 or columns_value > 6:
        return -1
    if cuts_value < 0 or cuts_value > 5:
        return -1
    rows: usize = rows_value.usize()
    columns: usize = columns_value.usize()
    cuts: usize = cuts_value.usize()
    if length != 3 + rows * columns:
        return -1

    cells: mutable i64[36] = zeroed
    for index in 0..(rows * columns):
        let cell: i64 = input_values[3 + index]
        if cell != 0 and cell != 1:
            return -1
        cells[index] <- cell

    suffix: mutable i64[49] = zeroed
    previous: mutable i64[49] = zeroed
    current: mutable i64[49] = zeroed
    row_offset: mutable usize = 0
    while row_offset < rows:
        let row: usize = rows - 1 - row_offset
        column_offset: mutable usize = 0
        while column_offset < columns:
            let column: usize = columns - 1 - column_offset
            let at: usize = row * 7 + column
            suffix[at] <- cells[row * columns + column]
                + suffix[(row + 1) * 7 + column]
                + suffix[row * 7 + column + 1]
                - suffix[(row + 1) * 7 + column + 1]
            column_offset <- column_offset + 1
        row_offset <- row_offset + 1

    row_offset <- 0
    while row_offset < rows:
        column_offset <- 0
        while column_offset < columns:
            let at: usize = row_offset * 7 + column_offset
            if suffix[at] > 0:
                previous[at] <- 1
            column_offset <- column_offset + 1
        row_offset <- row_offset + 1

    remaining: mutable usize = 1
    while remaining <= cuts:
        index: mutable usize = 0
        while index < 49:
            current[index] <- 0
            index <- index + 1
        row_offset <- 0
        while row_offset < rows:
            let row: usize = rows - 1 - row_offset
            column_offset <- 0
            while column_offset < columns:
                let column: usize = columns - 1 - column_offset
                let origin: usize = row * 7 + column
                ways: mutable i64 = 0
                cut_row: mutable usize = row + 1
                while cut_row < rows:
                    let removed: i64 = suffix[origin] - suffix[cut_row * 7 + column]
                    if removed > 0:
                        ways <- ways + previous[cut_row * 7 + column]
                    cut_row <- cut_row + 1
                cut_column: mutable usize = column + 1
                while cut_column < columns:
                    let removed: i64 = suffix[origin] - suffix[row * 7 + cut_column]
                    if removed > 0:
                        ways <- ways + previous[row * 7 + cut_column]
                    cut_column <- cut_column + 1
                current[origin] <- ways % MODULUS
                column_offset <- column_offset + 1
            row_offset <- row_offset + 1
        index <- 0
        while index < 49:
            previous[index] <- current[index]
            index <- index + 1
        remaining <- remaining + 1
    previous[0]

export fn number_of_ways_of_cutting_a_pizza(input_values: i64&, length: usize) -> i64:
    if input_values.is_null() or length < 3 or length > MAX_INPUT:
        return -1
    input_view: view[i64] = input_values[0:length]
    number_of_ways_of_cutting_a_pizza_impl(input_view, length)
