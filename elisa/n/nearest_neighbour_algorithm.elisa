def nearest_neighbour_algorithm_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2 or length > 257: return -1
    count: i64 = values[0]
    if count < 1 or count > 16 or length != (1 + count * count).usize(): return -1
    i: mutable usize = 1
    while i < length:
        if values[i] < 0 or values[i] > 1000000: return -1
        i <- i + 1
    seen: mutable [16]bool = [false; 16]
    path: mutable [16]usize = [0; 16]
    current: mutable usize = 0
    step: mutable usize = 0
    while step < count.usize():
        path[step] <- current
        seen[current] <- true
        if step + 1 < count.usize():
            best: mutable usize = count.usize()
            distance: mutable i64 = 0
            j: mutable usize = 0
            while j < count.usize():
                if not seen[j]:
                    d: i64 = values[1 + current * count.usize() + j]
                    if best == count.usize() or d < distance:
                        best <- j
                        distance <- d
                j <- j + 1
            current <- best
        step <- step + 1
    scratch: mutable [64]u8 = [0; 64]
    used: mutable usize = 0
    i <- 0
    while i < count.usize():
        if i > 0: scratch[used] <- 44u8()
        if i > 0: used <- used + 1
        x: usize = path[i]
        if x >= 10:
            scratch[used] <- (48 + x / 10).u8()
            used <- used + 1
        scratch[used] <- (48 + x % 10).u8(); used <- used + 1
        i <- i + 1
    if used > capacity: return -2
    i <- 0
    while i < used: output[i] <- scratch[i]; i <- i + 1
    return used.i64()

export fn nearest_neighbour_algorithm(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = nearest_neighbour_algorithm_impl
