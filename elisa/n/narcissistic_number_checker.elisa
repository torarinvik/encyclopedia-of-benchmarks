# Check whether n equals the sum of each decimal digit raised to digit count.
def narcissistic_number_checker_impl(n: i64) -> i64:
    if n < -2147483648 or n > 999999:
        return -1
    original: i64 = n
    remaining: mutable i64 = n
    digits: mutable i64 = 0
    while remaining != 0:
        digits <- digits + 1
        remaining <- remaining / 10
    sum: mutable i64 = 0
    remaining <- n
    while remaining > 0:
        digit: i64 = remaining % 10
        power: mutable i64 = 1
        exponent: mutable i64 = 0
        while exponent < digits:
            power <- power * digit
            exponent <- exponent + 1
        sum <- sum + power
        remaining <- remaining / 10
    if sum == original:
        return 1
    0

export fn narcissistic_number_checker(n: i64) -> i64 = narcissistic_number_checker_impl
