# Emit the nearest strictly smaller value to the left of every input value.
def store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    b: mutable usize = 0
    while b < 8:
        output[offset + b] <- (bits & 255).u8()
        bits <- bits >> 8
        b <- b + 1

def next_smaller_element_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 1 or input[0] < 0 or input[0] > 1024: return -1
    n: usize = input[0].usize()
    if length != n + 1: return -1
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < -2147483648 or input[i + 1] > 2147483647: return -1
        i <- i + 1
    if capacity < n * 8: return -2
    stack: mutable i64[1024] = zeroed
    top: mutable usize = 0
    i <- 0
    while i < n:
        value: i64 = input[i + 1]
        while top > 0 and stack[top - 1] >= value: top <- top - 1
        previous: i64 = -1
        if top > 0: previous <- stack[top - 1]
        store_i64_le(previous, output[0:capacity], i * 8)
        stack[top] <- value
        top <- top + 1
        i <- i + 1
    (n * 8).i64()

export fn next_smaller_element(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = next_smaller_element_impl
