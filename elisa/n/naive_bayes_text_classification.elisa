extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&
def putd(output: mutable u8&, offset: usize, value: f64):
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    k: mutable usize = 0
    while k < 8:
        output[offset+k] <- (bits & 255).u8()
        bits <- bits >> 8
        k <- k+1
def token(values: i64&, start: usize, count: usize, key: mutable u64&) -> bool:
    key <- 0
    i: mutable usize = 0
    while i < count:
        x: mutable i64 = values[start+i]
        if x >= 65 and x <= 90: x <- x+32
        if not ((x >= 97 and x <= 122) or (x >= 48 and x <= 57) or x == 39): return false
        key <- key*128+x.u64()
        i <- i+1
    true
def naive_bayes_text_classification_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 7: return -1
    d: i64 = values[0]; alpha: i64 = values[1]
    if d < 2 or d > 6 or alpha < 1 or alpha > 10000: return -1
    words: [6]u64; labels: [6]usize; seen: [2]bool; totals: [2]usize
    pos: mutable usize = 2
    i: mutable usize = 0
    while i < d.usize():
        if pos+2 > length: return -1
        lab: i64 = values[pos]; n: i64 = values[pos+1]; pos <- pos+2
        if lab < 0 or lab > 1 or n < 0 or n > 8 or pos+n.usize() > length: return -1
        if not token(values,pos,n.usize(),words[i]): return -1
        labels[i] <- lab.usize(); seen[labels[i]] <- true
        if n > 0: totals[labels[i]] <- totals[labels[i]]+1
        pos <- pos+n.usize(); i <- i+1
    if pos >= length: return -1
    qlen: i64 = values[pos]; pos <- pos+1
    if qlen < 0 or qlen > 8 or pos+qlen.usize() != length or not seen[0] or not seen[1]: return -1
    query: mutable u64 = 0
    if not token(values,pos,qlen.usize(),query): return -1
    vocab: mutable usize = 0
    i <- 0
    while i < d.usize():
        if words[i] != 0:
            fresh: mutable bool = true
            j: mutable usize = 0
            while j < i:
                if words[j] == words[i]: fresh <- false
                j <- j+1
            if fresh: vocab <- vocab+1
        i <- i+1
    if vocab == 0 and qlen > 0: return -1
    if capacity < 16: return -2
    score: [2]f64
    c: mutable usize = 0
    while c < 2:
        docs: mutable usize = 0; count: mutable usize = 0; i <- 0
        while i < d.usize():
            if labels[i] == c:
                docs <- docs+1
                if qlen > 0 and words[i] == query: count <- count+1
            i <- i+1
        score[c] <- ln(docs.f64()/d.f64())
        if qlen > 0:
            a: f64 = alpha.f64()/1000.0
            score[c] <- score[c]+ln((count.f64()+a)/(totals[c].f64()+a*vocab.f64()))
        c <- c+1
    high: f64 = if score[0] > score[1]: score[0] else: score[1]
    a: f64 = exp(score[0]-high); b: f64 = exp(score[1]-high)
    putd(output,0,a/(a+b)); putd(output,8,b/(a+b)); 16
export naive_bayes_text_classification(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = naive_bayes_text_classification_impl
