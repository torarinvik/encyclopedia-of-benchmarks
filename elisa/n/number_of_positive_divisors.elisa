# Count positive divisors of the absolute value of one signed integer.
def number_of_positive_divisors_impl(values: i64&, length: usize) -> i64:
    if length != 1 or values[0] < -1000000000 or values[0] > 1000000000:
        return -1
    # The validated magnitude is at most one billion.
    signed_value: i64 = values[0]
    remaining: mutable u64 = (-signed_value).u64() if signed_value < 0 else signed_value.u64()
    count: mutable u64 = 1
    factor: mutable u64 = 2
    while factor * factor <= remaining:
        exponent: mutable u64 = 0
        while remaining % factor == 0:
            remaining <- remaining / factor
            exponent <- exponent + 1
        count <- count * (exponent + 1)
        factor <- factor + 1
    if remaining > 1:
        count <- count * 2
    count.i64()

export fn number_of_positive_divisors(values: i64&, length: usize) -> i64 = number_of_positive_divisors_impl
