@intrinsic("llvm.ctlz.i32")
extern leading_zeros(value: u32, zero_undefined: bool) -> u32

# Find the smallest power of two at least as large as the input.
def next_power_of_two_impl(number: i64) -> i64:
    # Subtracting one keeps exact powers unchanged and validates both bounds.
    below: u64 = number.u64() - 1
    if below >= 1073741824:
        return -1
    position: u32 = 32 - leading_zeros(below.u32(), false)
    (1.u32() << position).i64()

export fn next_power_of_two(number: i64) -> i64 = next_power_of_two_impl
