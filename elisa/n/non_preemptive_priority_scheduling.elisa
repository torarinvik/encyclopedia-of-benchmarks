def put_i32(output: mutable view[u8], offset: usize, value: i64):
    bits: mutable u32 = value.i32().u32()
    k: mutable usize = 0
    while k < 4:
        output[offset+k] <- (bits & 255).u8()
        bits <- bits >> 8
        k <- k+1
def non_preemptive_priority_scheduling_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 4: return -1
    count: i64 = values[0]
    if count < 1 or count > 10 or length != (1+3*count).usize(): return -1
    arrivals: mutable [10]i64 = [0; 10]
    bursts: mutable [10]i64 = [0; 10]
    priorities: mutable [10]i64 = [0; 10]
    done: mutable [10]bool = [false; 10]
    i: mutable usize = 0
    while i < count.usize():
        arrival: i64 = values[1+3*i]
        burst: i64 = values[2+3*i]
        priority: i64 = values[3+3*i]
        if arrival < 0 or arrival > 20 or burst < 1 or burst > 10 or priority < 0 or priority > 10: return -1
        j: mutable usize = 0
        while j < i:
            if priorities[j] == priority: return -1
            j <- j+1
        arrivals[i] <- arrival; bursts[i] <- burst; priorities[i] <- priority
        i <- i+1
    if capacity < count.usize()*4: return -2
    now: mutable i64 = 0
    z: mutable usize = 0
    while z < count.usize():
        pick: mutable i64 = -1
        i <- 0
        while i < count.usize():
            if not done[i] and arrivals[i] <= now and (pick < 0 or priorities[i] < priorities[pick.usize()] or (priorities[i] == priorities[pick.usize()] and arrivals[i] < arrivals[pick.usize()])): pick <- i.i64()
            i <- i+1
        if pick < 0:
            next: mutable i64 = 100000
            i <- 0
            while i < count.usize():
                if not done[i] and arrivals[i] < next: next <- arrivals[i]
                i <- i+1
            now <- next
        else:
            done[pick.usize()] <- true
            put_i32(output[0:capacity],z,pick)
            now <- now+bursts[pick.usize()]
            z <- z+1
    (count*4).i64()
export non_preemptive_priority_scheduling(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = non_preemptive_priority_scheduling_impl
