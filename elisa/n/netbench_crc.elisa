const MAX_LENGTH: usize = 256
const POLYNOMIAL: u64 = 0x04c11db7
const OUTPUT_MASK: u64 = 0xffffffff

def netbench_crc_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH or (length > 0 and values == null):
        return -1
    index: mutable usize = 0
    while index < length:
        if values[index] < 0 or values[index] > 255:
            return -1
        index <- index + 1

    table: mutable u64[256] = zeroed
    byte: mutable usize = 0
    while byte < 256:
        remainder: mutable u64 = byte.u64() << 24
        bit: mutable usize = 0
        while bit < 8:
            if (remainder & 0x80000000) != 0:
                remainder <- ((remainder << 1) ^ POLYNOMIAL)
            else:
                remainder <- remainder << 1
            bit <- bit + 1
        table[byte] <- remainder
        byte <- byte + 1

    crc: mutable u64 = 0
    index <- 0
    while index < length:
        byte_value: u64 = values[index].u64()
        table_index: usize = (((crc >> 24) ^ byte_value) & 0xff).usize()
        crc <- (crc << 8) ^ table[table_index]
        index <- index + 1
    (crc & OUTPUT_MASK).i64()

export fn netbench_crc(values: i64&, length: usize) -> i64 = netbench_crc_impl
