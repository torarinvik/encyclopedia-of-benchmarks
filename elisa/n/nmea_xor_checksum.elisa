def nmea_xor_checksum_impl(values: i64&, length: usize) -> i64:
    if values == null or length == 0 or length > 78: return -1
    payload_length: i64 = values[0]
    if payload_length < 0 or payload_length > 76: return -1
    if length != payload_length.usize() + 1: return -1
    checksum: mutable i64 = 0
    i: mutable usize = 0
    while i < payload_length.usize():
        byte: i64 = values[i + 1]
        if byte < 0 or byte > 127: return -1
        checksum <- checksum ^ byte
        i <- i + 1
    checksum

export fn nmea_xor_checksum(values: i64&, length: usize) -> i64 = nmea_xor_checksum_impl
