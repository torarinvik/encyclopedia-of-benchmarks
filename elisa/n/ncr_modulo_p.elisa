const INVALID_RESULT: i64 = -9223372036854775807 - 1

def inverse(a: i64, m: i64) -> i64:
    old_r: mutable i64 = a
    r: mutable i64 = m
    old_s: mutable i64 = 1
    s: mutable i64 = 0
    while r != 0:
        quotient: i64 = old_r / r
        next_r: i64 = old_r - quotient * r
        next_s: i64 = old_s - quotient * s
        old_r <- r
        r <- next_r
        old_s <- s
        s <- next_s
    if old_r == 1: (old_s + m) % m else: -1

def ncr_modulo_p_impl(values: i64&, length: usize): i64 = {
    if length != 4:
        return INVALID_RESULT
    size: i64 = values[0]
    p: i64 = values[1]
    n: i64 = values[2]
    r: i64 = values[3]
    if size < 0 or size > 64 or p < 2 or p > 1009 or n < 0 or n > size or
        r < 0 or r > 64:
        return INVALID_RESULT

    fac: mutable [65]i64 = [0; 65]
    fac[0] <- 1
    i: mutable i64 = 1
    while i <= size:
        fac[i] <- (fac[i - 1] * i) % p
        i <- i + 1
    if r > n:
        return 0
    if r == 1:
        return n % p
    if r == 0 or r == n:
        return 1
    denominator: i64 = (fac[r] * fac[n - r]) % p
    denominator_inv: i64 = inverse(denominator, p)
    if denominator_inv < 0:
        return -1
    (fac[n] * denominator_inv) % p
}

export fn ncr_modulo_p(values: i64&, length: usize) -> i64 = ncr_modulo_p_impl
