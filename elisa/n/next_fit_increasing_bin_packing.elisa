def next_fit_increasing_put_i64(output: mutable u8&, word: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[word * 8 + byte] <- (bits >> (byte * 8)).u8()

def next_fit_increasing_bin_packing_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > 65:
        return -1
    n0: i64 = input[0]
    if n0 < 0 or n0 > 64 or length != (1 + n0).usize():
        return -1
    n: usize = n0.usize()
    for i in 0..<n:
        size: i64 = input[i + 1]
        if size < 1 or size > 1000000:
            return -1
    order: mutable usize[64] = zeroed
    assignments: mutable i64[64] = zeroed
    for i in 0..<n:
        order[i] <- i
    # Stable ascending insertion sort preserves original order on equal sizes.
    for i in 1..<n:
        item: usize = order[i]
        j: mutable usize = i
        while j > 0 and input[order[j - 1] + 1] > input[item + 1]:
            order[j] <- order[j - 1]
            j <- j - 1
        order[j] <- item
    bins: mutable i64 = 0
    remaining: mutable i64 = 0
    for rank in 0..<n:
        item: usize = order[rank]
        size: i64 = input[item + 1]
        if bins == 0 or size > remaining:
            assignments[item] <- bins
            bins <- bins + 1
            remaining <- 1000000 - size
        else:
            assignments[item] <- bins - 1
            remaining <- remaining - size
    bytes: usize = 8 * (n + 1)
    if output == null or capacity < bytes:
        return -2
    next_fit_increasing_put_i64(output, 0, bins)
    for i in 0..<n:
        next_fit_increasing_put_i64(output, i + 1, assignments[i])
    bytes.i64()

export fn next_fit_increasing_bin_packing(input: i64&, length: usize,
                                          output: mutable u8&, capacity: usize) -> i64 = next_fit_increasing_bin_packing_impl
