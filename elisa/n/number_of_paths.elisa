# Count vertex-simple directed paths with recursive DFS.
def count_from(values: view[i64], n: usize, current: usize, destination: usize, visited: u64) -> u64:
    if current == destination:
        return 1
    seen: u64 = visited | (1 << current)
    count: mutable u64 = 0
    next: mutable usize = 0
    while next < n:
        if values[3 + current * n + next] == 1 and (seen & (1 << next)) == 0:
            count <- count + count_from(values, n, next, destination, seen)
        next <- next + 1
    count

def number_of_paths_impl(values: i64&, length: usize) -> i64:
    if length < 3 or values[0] < 1 or values[0] > 10:
        return -1
    n: usize = values[0] as usize
    if length != 3 + n * n:
        return -1
    if values[1] < 0 or values[1] > 4294967295 or values[2] < 0 or values[2] > 4294967295:
        return -1
    i: mutable usize = 3
    while i < length:
        if values[i] != 0 and values[i] != 1:
            return -1
        i <- i + 1
    source: usize = values[1] as usize
    destination: usize = values[2] as usize
    if source >= n or destination >= n:
        return 0
    count_from(values[0:length], n, source, destination, 0) as i64

export fn number_of_paths(values: i64&, length: usize) -> i64 = number_of_paths_impl
