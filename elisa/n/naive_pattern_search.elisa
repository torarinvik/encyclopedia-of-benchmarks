def naive_pattern_search_impl(v: i64&, n: usize) -> i64:
    if n < 2 or n > 512: return -2
    tn: i64=v[0]; pn: i64=v[1]
    if tn < 0 or tn > 255 or pn < 0 or pn > tn or n != (2+tn+pn).usize(): return -2
    i: usize=0
    while i < (tn+pn).usize():
        if v[2+i] < 0 or v[2+i] > 127: return -2
        i += 1
    if pn == 0: return -1
    start: i64=0
    while start <= tn-pn:
        j: i64=0
        while j < pn and v[2+(start+j).usize()] == v[2+tn.usize()+j.usize()]: j += 1
        if j == pn: return start
        start += 1
    return -1
export fn naive_pattern_search(v: i64&, n: usize) -> i64 = naive_pattern_search_impl
