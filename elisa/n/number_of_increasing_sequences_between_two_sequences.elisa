## Clean-room bounded implementation of the Library Checker sequence-counting task.

const INCSEQ_MAX_N: usize = 64
const INCSEQ_MAX_M: usize = 64
const INCSEQ_MAX_INPUT: usize = 130
const INCSEQ_MOD: i64 = 998244353

def number_of_increasing_sequences_between_two_sequences_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4 or length > INCSEQ_MAX_INPUT:
        return -1
    if input[0] < 1 or input[0] > 64 or input[1] < 1 or input[1] > 64:
        return -1
    n: usize = input[0].usize()
    m: usize = input[1].usize()
    if length != 2 + 2 * n:
        return -1
    lower: mutable i64[64] = zeroed
    upper: mutable i64[64] = zeroed
    i: mutable usize = 0
    while i < n:
        lower[i] <- input[2 + i]
        upper[i] <- input[2 + n + i]
        if lower[i] < 0 or lower[i] >= upper[i] or upper[i] > m.i64():
            return -1
        i <- i + 1

    previous: mutable i64[64] = zeroed
    current: mutable i64[64] = zeroed
    value: mutable usize = lower[0].usize()
    while value < upper[0].usize():
        previous[value] <- 1
        value <- value + 1
    position: mutable usize = 1
    while position < n:
        prefix: mutable i64 = 0
        value <- 0
        while value < m:
            prefix <- prefix + previous[value]
            if prefix >= INCSEQ_MOD:
                prefix <- prefix - INCSEQ_MOD
            if lower[position] <= value.i64() and value.i64() < upper[position]:
                current[value] <- prefix
            else:
                current[value] <- 0
            value <- value + 1
        value <- 0
        while value < m:
            previous[value] <- current[value]
            value <- value + 1
        position <- position + 1
    answer: mutable i64 = 0
    value <- 0
    while value < m:
        answer <- answer + previous[value]
        if answer >= INCSEQ_MOD:
            answer <- answer - INCSEQ_MOD
        value <- value + 1
    answer

export fn number_of_increasing_sequences_between_two_sequences(input: i64&, length: usize) -> i64 = number_of_increasing_sequences_between_two_sequences_impl
