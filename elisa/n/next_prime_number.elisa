# Find the smallest prime strictly greater than the input.
def next_prime_number_impl(value: i64) -> i64:
    if value < -4096 or value > 4096:
        return -1
    if value < 2:
        return 2
    if value == 2:
        return 3

    candidate: mutable u32 = (value.u32() + 1) | 1
    while not is_candidate_prime(candidate):
        candidate <- candidate + 2
    candidate.i64()

def is_candidate_prime(value: u32) -> bool:
    # 4099 is prime, so candidates and trial squares are bounded by the input contract.
    if value % 3 == 0:
        return false
    divisor: mutable u32 = 5
    while divisor * divisor <= value:
        if value % divisor == 0 or value % (divisor + 2) == 0:
            return false
        divisor <- divisor + 6
    true

export fn next_prime_number(value: i64) -> i64 = next_prime_number_impl
