const MAX_ROWS: usize = 64
const MAX_COLS: usize = 8
const MAX_INPUT: usize = 514
const OFFSET: u64 = 14695981039346656037
const PRIME: u64 = 1099511628211

def pareto_feed(hash: u64, value: i64) -> u64:
    bits: u64 = value.u64()
    result: mutable u64 = hash
    for shift in 0..<8:
        byte: u8 = ((bits >> (shift * 8)) & 255.u64()).u8()
        result <- (result ^ byte.u64()) * PRIME
    result

def pareto_optimization_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT: return -1
    rows64: i64 = input[0]
    cols64: i64 = input[1]
    if rows64 < 1 or rows64 > MAX_ROWS.i64() or cols64 < 1 or cols64 > MAX_COLS.i64() or length != (2 + rows64 * cols64).usize(): return -1
    rows: usize = rows64.usize()
    cols: usize = cols64.usize()
    for k in 0..<(rows * cols):
        if input[2 + k] < -1000 or input[2 + k] > 1000: return -1
    keep: mutable bool[MAX_ROWS] = zeroed
    retained: mutable i64 = 0
    for i in 0..<rows:
        keep[i] <- true
        for j in 0..<rows:
            if i == j: continue
            all_ge: mutable bool = true
            any_gt: mutable bool = false
            for c in 0..<cols:
                left: i64 = input[2 + j * cols + c]
                right: i64 = input[2 + i * cols + c]
                if left < right: all_ge <- false
                if left > right: any_gt <- true
            if all_ge and (any_gt or j < i):
                keep[i] <- false
                break
        if keep[i]: retained <- retained + 1
    hash: mutable u64 = pareto_feed(OFFSET, retained)
    hash <- pareto_feed(hash, cols64)
    for i in 0..<rows:
        if keep[i]:
            for c in 0..<cols:
                hash <- pareto_feed(hash, input[2 + i * cols + c])
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn pareto_optimization(input: i64&, length: usize) -> i64 = pareto_optimization_impl
