# Count sol2's bounded, source-ordered digit-factorial chains.
const MAX_CHAIN_LENGTH: i64 = 60
const MAX_NUMBER_LIMIT: i64 = 1000000
const PATH_CAPACITY: usize = 61
const DIGIT_FACTORIALS: i64[10] = [1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880]

def digit_factorial_sum(value: i64) -> i64:
    remaining: mutable i64 = value
    total: mutable i64 = 0
    while remaining > 0:
        total <- total + DIGIT_FACTORIALS[(remaining % 10).usize()]
        remaining <- remaining / 10
    if value == 0:
        total <- 1
    total

def cache_contains(value: i64, number_limit: i64, cache: mutable u32&) -> bool:
    if value < 1 or value >= number_limit:
        return false
    cache[value.usize()] != 0.u32()

def path_contains(path: i64[PATH_CAPACITY], path_length: usize, value: i64) -> bool:
    for index in 0..<path_length:
        if path[index] == value:
            return true
    false

def problem74_sol2_impl(chain_length: i64, number_limit: i64) -> i64:
    if chain_length < 1 or chain_length > MAX_CHAIN_LENGTH or number_limit < 1 or number_limit > MAX_NUMBER_LIMIT:
        return -1
    if number_limit == 1:
        return 0

    cache: mutable u32[MAX_NUMBER_LIMIT] = zeroed
    chains_counter: mutable i64 = 0
    for start in 1..<number_limit:
        path: mutable i64[PATH_CAPACITY] = zeroed
        path_length: mutable usize = 0
        chain_set_length: mutable i64 = 0
        chain_element: mutable i64 = start
        while not cache_contains(chain_element, number_limit, cache) and not path_contains(path, path_length, chain_element) and chain_set_length <= chain_length:
            path[path_length] <- chain_element
            path_length <- path_length + 1
            chain_set_length <- chain_set_length + 1
            chain_element <- digit_factorial_sum(chain_element)
        if cache_contains(chain_element, number_limit, cache):
            chain_set_length <- chain_set_length + cache[chain_element.usize()].i64()

        cache[start.usize()] <- chain_set_length.u32()
        if chain_set_length == chain_length:
            chains_counter <- chains_counter + 1
    chains_counter

export fn problem74_sol2(chain_length: i64, number_limit: i64) -> i64 = problem74_sol2_impl(chain_length, number_limit)
