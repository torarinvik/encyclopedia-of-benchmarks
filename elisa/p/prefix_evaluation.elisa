const INVALID: f64 = -1e300
fn is_op(value: u8) -> bool:
    value == 43 or value == 45 or value == 42 or value == 47
export fn prefix_evaluation(input: i64&, length: usize) -> f64:
    if input.is_null() or length < 2 or length > 63 or input[0] < 1 or input[0] > 62 or length != input[0].usize() + 1: return INVALID
    tokens: mutable u8[31]
    count: mutable usize = 0
    need_token: mutable bool = true
    i: mutable usize = 1
    while i < length:
        if input[i] < 0 or input[i] > 127: return INVALID
        value: u8 = input[i].u8()
        if value == 32:
            if need_token: return INVALID
            need_token <- true
        else:
            if not (is_op(value) or (value >= 48 and value <= 57)) or not need_token or count >= 31: return INVALID
            tokens[count] <- value
            count <- count + 1
            need_token <- false
        i <- i + 1
    if need_token or count == 0: return INVALID
    stack: mutable f64[31]
    top: mutable usize = 0
    pos: mutable usize = count
    while pos > 0:
        pos <- pos - 1
        value: u8 = tokens[pos]
        if value >= 48 and value <= 57:
            stack[top] <- (value - 48).f64()
            top <- top + 1
        else:
            if top < 2: return INVALID
            top <- top - 1
            first: f64 = stack[top]
            top <- top - 1
            second: f64 = stack[top]
            result: f64 = 0
            if value == 43: result <- first + second
            else if value == 45: result <- first - second
            else if value == 42: result <- first * second
            else:
                if second == 0: return INVALID
                result <- first / second
            stack[top] <- result
            top <- top + 1
    if top == 1: return stack[0]
    INVALID
