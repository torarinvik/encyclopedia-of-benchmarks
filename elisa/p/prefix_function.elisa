const MAX_TEXT: usize = 4096
def prefix_function_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_TEXT + 1 or input[0] < 0 or input[0] > MAX_TEXT.i64(): return -1
    count: usize = input[0].usize()
    if length != count + 1: return -1
    i: usize = 0
    while i < count:
        if input[i + 1] < 0 or input[i + 1] > 127: return -1
        i <- i + 1
    bytes: usize = count * 4
    if bytes > capacity or (bytes > 0 and output.is_null()): return -2
    prefix: mutable usize[MAX_TEXT]
    i <- 1
    while i < count:
        j: mutable usize = prefix[i - 1]
        while j > 0 and input[i + 1] != input[j + 1]: j <- prefix[j - 1]
        if input[i + 1] == input[j + 1]: j <- j + 1
        prefix[i] <- j
        i <- i + 1
    i <- 0
    while i < count:
        value: usize = prefix[i]
        output[4 * i] <- (value & 255).u8()
        output[4 * i + 1] <- ((value >> 8) & 255).u8()
        output[4 * i + 2] <- ((value >> 16) & 255).u8()
        output[4 * i + 3] <- ((value >> 24) & 255).u8()
        i <- i + 1
    bytes.i64()

export fn prefix_function(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = prefix_function_impl
