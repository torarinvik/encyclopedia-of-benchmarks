const MAX_ROW: i64 = 30
const MODULUS: i64 = 1000000007
export fn pascal_triangle_ii(row: i64) -> i64:
    if row < 0 or row > MAX_ROW: return -9223372036854775808
    triangle: mutable i64[961] = zeroed
    triangle[0] <- 1
    i: mutable usize = 1
    while i <= row.usize():
        triangle[i * 31] <- 1
        triangle[i * 31 + i] <- 1
        j: mutable usize = 1
        while j < i:
            triangle[i * 31 + j] <- triangle[(i - 1) * 31 + j - 1] + triangle[(i - 1) * 31 + j]
            j <- j + 1
        i <- i + 1
    hash: mutable i64 = 0
    j: mutable usize = 0
    while j <= row.usize():
        hash <- (hash * 31 + triangle[row.usize() * 31 + j]) % MODULUS
        j <- j + 1
    hash
