def pi_approximation_impl(points: f64&, point_count: usize) -> f64:
    inside: mutable usize = 0
    for index in 0..<point_count:
        x: f64 = points[2 * index]
        y: f64 = points[2 * index + 1]
        if x * x + y * y <= 1.0:
            inside <- inside + 1
    4.0 * f64(inside) / f64(point_count)

export fn pi_approximation(points: f64&, point_count: usize) -> f64 = pi_approximation_impl
