const MIN_N: i64 = 2
const MAX_N: i64 = 46340
const MAX_STEPS: i64 = 4096

def java_remainder(value: i64, modulus: i64) -> i64:
    if value < 0: -((-value) % modulus) else: value % modulus

def next_value(value: i64, modulus: i64) -> i64:
    java_remainder(value * value - 1, modulus)

def gcd_nonnegative(left_value: i64, right_value: i64) -> i64:
    left: mutable i64 = left_value
    right: mutable i64 = right_value
    while right != 0:
        remainder: i64 = left % right
        left <- right
        right <- remainder
    left

def pollard_rho_java_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 2: return -1
    n: i64 = input[0]
    step_limit: i64 = input[1]
    if n < MIN_N or n > MAX_N or step_limit < 1 or step_limit > MAX_STEPS: return -1

    x: mutable i64 = 2
    y: mutable i64 = 2
    step: mutable i64 = 0
    while step < step_limit:
        x <- next_value(x, n)
        y <- next_value(next_value(y, n), n)
        difference: mutable i64 = x - y
        if difference < 0: difference <- -difference
        divisor: i64 = gcd_nonnegative(difference, n)
        if divisor != 1:
            if divisor == n: return 0
            return divisor
        step <- step + 1
    -2

export fn pollard_rho_java(input: i64&, length: usize) -> i64 = pollard_rho_java_impl
