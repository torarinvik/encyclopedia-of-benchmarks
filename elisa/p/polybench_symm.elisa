const POLYBENCH_SYMM_MAX_DIMENSION: usize = 64
const POLYBENCH_SYMM_MAX_CELLS: usize = POLYBENCH_SYMM_MAX_DIMENSION * POLYBENCH_SYMM_MAX_DIMENSION
const POLYBENCH_SYMM_INVALID_RESULT: f64 = -1e300

def polybench_symm_impl(values: i64&, length: usize) -> f64:
    if values.is_null() or length != 2:
        return POLYBENCH_SYMM_INVALID_RESULT
    if values[0] < 1 or values[0] > POLYBENCH_SYMM_MAX_DIMENSION.i64() or
       values[1] < 1 or values[1] > POLYBENCH_SYMM_MAX_DIMENSION.i64():
        return POLYBENCH_SYMM_INVALID_RESULT
    m: usize = values[0].usize()
    n: usize = values[1].usize()
    a: mutable f64[POLYBENCH_SYMM_MAX_CELLS] = zeroed
    b: mutable f64[POLYBENCH_SYMM_MAX_CELLS] = zeroed
    c: mutable f64[POLYBENCH_SYMM_MAX_CELLS] = zeroed
    alpha: f64 = 1.5
    beta: f64 = 1.2
    i: mutable usize = 0
    while i < m:
        j: mutable usize = 0
        while j < n:
            c[i * n + j] <- ((i + j) % 100).f64() / m.f64()
            b[i * n + j] <- ((n + i - j) % 100).f64() / m.f64()
            j <- j + 1
        i <- i + 1
    i <- 0
    while i < m:
        j: mutable usize = 0
        while j < m:
            if j <= i:
                a[i * m + j] <- ((i + j) % 100).f64() / m.f64()
            else:
                a[i * m + j] <- -999.0
            j <- j + 1
        i <- i + 1
    i <- 0
    while i < m:
        j: mutable usize = 0
        while j < n:
            temp2: mutable f64 = 0.0
            k: mutable usize = 0
            while k < i:
                c[k * n + j] <- c[k * n + j] + alpha * b[i * n + j] * a[i * m + k]
                temp2 <- temp2 + b[k * n + j] * a[i * m + k]
                k <- k + 1
            c[i * n + j] <- beta * c[i * n + j] + alpha * b[i * n + j] * a[i * m + i] + alpha * temp2
            j <- j + 1
        i <- i + 1
    result: mutable f64 = 0.0
    i <- 0
    while i < m:
        j: mutable usize = 0
        while j < n:
            result <- result + c[i * n + j]
            j <- j + 1
        i <- i + 1
    result

export fn polybench_symm(values: i64&, length: usize) -> f64 = polybench_symm_impl
