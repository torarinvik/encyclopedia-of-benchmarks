extern pow(base: f64, exponent: f64) -> f64

def si_exponent(code: f64) -> i32:
    if code == 0.0: return 24
    if code == 1.0: return 21
    if code == 2.0: return 18
    if code == 3.0: return 15
    if code == 4.0: return 12
    if code == 5.0: return 9
    if code == 6.0: return 6
    if code == 7.0: return 3
    if code == 8.0: return 2
    if code == 9.0: return 1
    if code == 10.0: return -1
    if code == 11.0: return -2
    if code == 12.0: return -3
    if code == 13.0: return -6
    if code == 14.0: return -9
    if code == 15.0: return -12
    if code == 16.0: return -15
    if code == 17.0: return -18
    if code == 18.0: return -21
    if code == 19.0: return -24
    return 1000

def binary_exponent(code: f64) -> i32:
    if code == 20.0: return 8
    if code == 21.0: return 7
    if code == 22.0: return 6
    if code == 23.0: return 5
    if code == 24.0: return 4
    if code == 25.0: return 3
    if code == 26.0: return 2
    if code == 27.0: return 1
    return 1000

def prefix_conversions_impl(known_amount: f64, known_code: f64, unknown_code: f64) -> f64:
    if known_amount != known_amount or known_amount < -1000000.0 or known_amount > 1000000.0:
        return -1e300
    known_si: i32 = si_exponent(known_code)
    unknown_si: i32 = si_exponent(unknown_code)
    if known_si != 1000 and unknown_si != 1000:
        return known_amount * pow(10.0, (known_si - unknown_si).f64())
    known_binary: i32 = binary_exponent(known_code)
    unknown_binary: i32 = binary_exponent(unknown_code)
    if known_binary != 1000 and unknown_binary != 1000:
        return known_amount * pow(2.0, ((known_binary - unknown_binary) * 10).f64())
    return -1e300

export fn prefix_conversions(known_amount: f64, known_code: f64, unknown_code: f64) -> f64 = prefix_conversions_impl
