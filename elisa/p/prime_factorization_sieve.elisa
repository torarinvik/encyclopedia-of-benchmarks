const MAX_INPUT: usize = 1000005

def prime_factorization_sieve_write_u32le(value: u32,
        output: mutable u8&, position: usize) -> void:
    byte: mutable usize = 0
    while byte < 4:
        output[position + byte] <- ((value >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def prime_factorization_sieve_impl(value: i64,
        output: mutable u8&, output_capacity: usize) -> i64:
    if value < 1 or value > MAX_INPUT.i64():
        return -1
    if value == 1:
        return 0
    limit: usize = value.usize()
    is_prime: mutable bool[MAX_INPUT + 1] = zeroed
    index: mutable usize = 2
    while index <= limit:
        is_prime[index] <- true
        index <- index + 1
    prime: mutable usize = 2
    while prime <= limit / prime:
        if is_prime[prime]:
            multiple: mutable usize = prime * prime
            while multiple <= limit:
                is_prime[multiple] <- false
                multiple <- multiple + prime
        prime <- prime + 1

    primes: mutable u32[10] = zeroed
    exponents: mutable u32[10] = zeroed
    count: mutable usize = 0
    remaining: mutable i64 = value
    prime <- 2
    while prime <= limit and remaining > 1:
        if is_prime[prime]:
            exponent: mutable u32 = 0
            while remaining % prime.i64() == 0:
                remaining <- remaining / prime.i64()
                exponent <- exponent + 1
            if exponent != 0:
                primes[count] <- prime.u32()
                exponents[count] <- exponent
                count <- count + 1
        prime <- prime + 1

    required: usize = count * 8
    if output_capacity < required:
        return -2
    index <- 0
    while index < count:
        prime_factorization_sieve_write_u32le(primes[index], output, 8 * index)
        prime_factorization_sieve_write_u32le(exponents[index], output, 8 * index + 4)
        index <- index + 1
    required.i64()

export fn prime_factorization_sieve(value: i64,
        output: mutable u8&, output_capacity: usize) -> i64 = prime_factorization_sieve_impl
