# Preserve the source's factor-of-two reduction for Proth membership.
def is_proth_number_impl(input: i64) -> i64:
    if input <= 0:
        return -1
    if input == 1:
        return 0

    remainder: i64 = input - 1
    exponent: i64 = 0
    while remainder % 2 == 0:
        exponent = exponent + 1
        remainder = remainder / 2
    if remainder < (1 << exponent):
        return 1
    0

export fn is_proth_number(input: i64) -> i64 = is_proth_number_impl
