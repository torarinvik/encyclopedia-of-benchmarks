def postfix_evaluator_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > 129 or input[0] < 1 or input[0] > 128.i64(): return -1
    count: usize = input[0].usize()
    if length != count + 1: return -1
    stack: i64[128]
    sp: usize = 0
    i: usize = 1
    while i < length:
        token: i64 = input[i]
        if token == -9000000000000000001.i64() or token == -9000000000000000002.i64() or token == -9000000000000000003.i64() or token == -9000000000000000004.i64():
            if sp < 2: return -1
            b: i64 = stack[sp - 1]
            a: i64 = stack[sp - 2]
            sp <- sp - 2
            value: i64 = 0
            if token == -9000000000000000001.i64(): value <- (a + b).i32().i64()
            elif token == -9000000000000000002.i64(): value <- (a - b).i32().i64()
            elif token == -9000000000000000003.i64(): value <- (a * b).i32().i64()
            else:
                if b == 0: return -1
                if a == -2147483648 and b == -1: value <- -2147483648
                else: value <- a / b
            stack[sp] <- value
            sp <- sp + 1
        else:
            if token < -2147483648 or token > 2147483647 or sp >= 128: return -1
            stack[sp] <- token
            sp <- sp + 1
        i <- i + 1
    if sp == 1: return stack[0]
    -1

export fn postfix_evaluator(input: i64&, length: usize) -> i64 = postfix_evaluator_impl
