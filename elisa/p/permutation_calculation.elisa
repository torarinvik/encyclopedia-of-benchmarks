def permutation_factorial(n: i64) -> i64:
    result: i64 = 1
    i: i64 = 1
    while i <= n:
        result <- result * i
        i <- i + 1
    result

def permutation_calculation_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 2 or input[0] < 0 or input[0] > 15 or input[1] < 0 or input[1] > input[0]: return -1
    permutation_factorial(input[0]) / permutation_factorial(input[0] - input[1])

export fn permutation_calculation(input: i64&, length: usize) -> i64 = permutation_calculation_impl
