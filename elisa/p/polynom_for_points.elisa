# Bounded source-order interpolation with Python-compatible signed-zero spelling.
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

const MIN_POINTS: usize = 2
const MAX_POINTS: usize = 8
const MIN_X: i64 = -4
const MAX_X: i64 = 4
const MIN_Y: i64 = -25000
const MAX_Y: i64 = 25000
const MAX_COEFFICIENT: f64 = 1000000.0
const MAX_CONTRACT_BYTES: usize = 124
const SCRATCH_BYTES: usize = 125

def append_text(buffer: mutable view[u8], position: mutable usize&, text: &str) -> void:
    for index in 0..<text.length():
        buffer[position] <- text[index].u8()
        position <- position + 1

def append_i64(buffer: mutable view[u8], position: mutable usize&, value_value: i64) -> void:
    value: mutable i64 = value_value
    digits: mutable u8[24] = zeroed
    count: mutable usize = 0
    if value < 0:
        buffer[position] <- '-'.u8()
        position <- position + 1
        value <- -value
    while true:
        digits[count] <- ('0'.i64() + value % 10).u8()
        count <- count + 1
        value <- value / 10
        if value == 0:
            break
    while count > 0:
        count <- count - 1
        buffer[position] <- digits[count]
        position <- position + 1

def append_coefficient(buffer: mutable view[u8], position: mutable usize&, value: f64) -> void:
    if value == 0.0:
        bits: mutable u64 = 0
        memcpy(&bits, &value, 8)
        if bits >> 63 != 0:
            buffer[position] <- '-'.u8()
            position <- position + 1
        append_text(buffer, position, "0.0")
        return
    append_i64(buffer, position, value.i64())
    append_text(buffer, position, ".0")

def polynom_for_points_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if values.is_null() or length < 1 or length > 1 + 2 * MAX_POINTS:
        return -1
    raw_n: i64 = values[0]
    if raw_n < MIN_POINTS.i64() or raw_n > MAX_POINTS.i64() or
            length != 1 + 2 * raw_n.usize():
        return -1
    n: usize = raw_n.usize()
    xs: mutable i64[MAX_POINTS] = zeroed
    matrix: mutable f64[MAX_POINTS][MAX_POINTS] = [[0.0; MAX_POINTS]; MAX_POINTS]
    vector: mutable f64[MAX_POINTS] = zeroed
    for row in 0..<n:
        x: i64 = values[1 + 2 * row]
        y: i64 = values[2 + 2 * row]
        if x < MIN_X or x > MAX_X or y < MIN_Y or y > MAX_Y:
            return -1
        for previous in 0..<row:
            if xs[previous] == x:
                return -1
        xs[row] <- x
        for column in 0..<n:
            power: mutable i64 = 1
            exponent: usize = n - column - 1
            for _ in 0..<exponent:
                power <- power * x
            matrix[row][column] <- power.f64()
        vector[row] <- y.f64()

    for count in 0..<n:
        if matrix[count][count] == 0.0:
            pivot_row: mutable usize = count + 1
            for row in count + 2..<n:
                left: f64 = matrix[row][count]
                right: f64 = matrix[pivot_row][count]
                if (if left < 0.0: -left else: left) > (if right < 0.0: -right else: right):
                    pivot_row <- row
            if pivot_row >= n or matrix[pivot_row][count] == 0.0:
                return -1
            for column in 0..<n:
                temporary: f64 = matrix[count][column]
                matrix[count][column] <- matrix[pivot_row][column]
                matrix[pivot_row][column] <- temporary
            temporary_vector: f64 = vector[count]
            vector[count] <- vector[pivot_row]
            vector[pivot_row] <- temporary_vector
        for row in 0..<n:
            if row == count:
                continue
            fraction: f64 = matrix[row][count] / matrix[count][count]
            for column in 0..<n:
                product: f64 = matrix[count][column] * fraction
                matrix[row][column] <- matrix[row][column] - product
            product_vector: f64 = vector[count] * fraction
            vector[row] <- vector[row] - product_vector

    coefficients: mutable f64[MAX_POINTS] = zeroed
    for index in 0..<n:
        value: f64 = vector[index] / matrix[index][index]
        if value != value or value < -MAX_COEFFICIENT or value > MAX_COEFFICIENT or
                value != value.i64().f64():
            return -1
        coefficients[index] <- value

    buffer: mutable u8[SCRATCH_BYTES] = zeroed
    position: mutable usize = 0
    append_text(buffer[0:SCRATCH_BYTES], position, "f(x)=")
    for index in 0..<n:
        if index != 0:
            buffer[position] <- '+'.u8()
            position <- position + 1
        append_text(buffer[0:SCRATCH_BYTES], position, "x^")
        append_i64(buffer[0:SCRATCH_BYTES], position, (n - index - 1).i64())
        buffer[position] <- '*'.u8()
        position <- position + 1
        append_coefficient(buffer[0:SCRATCH_BYTES], position, coefficients[index])
    if position > MAX_CONTRACT_BYTES:
        return -1
    if output.is_null() or output_capacity < position:
        return -2
    for index in 0..<position:
        output[index] <- buffer[index]
    position.i64()

export fn polynom_for_points(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = polynom_for_points_impl
