extern sqrt(value: f64) -> f64

const POLYBENCH_CHOLESKY_MAX_DIMENSION: usize = 64
const POLYBENCH_CHOLESKY_MAX_CELLS: usize = POLYBENCH_CHOLESKY_MAX_DIMENSION * POLYBENCH_CHOLESKY_MAX_DIMENSION
const POLYBENCH_CHOLESKY_INVALID_RESULT: f64 = -1e300

def polybench_cholesky_impl(values: i64&, length: usize) -> f64:
    if values.is_null() or length != 1 or values[0] < 1 or values[0] > POLYBENCH_CHOLESKY_MAX_DIMENSION.i64():
        return POLYBENCH_CHOLESKY_INVALID_RESULT
    n: usize = values[0].usize()
    a: mutable f64[POLYBENCH_CHOLESKY_MAX_CELLS] = zeroed
    product: mutable f64[POLYBENCH_CHOLESKY_MAX_CELLS] = zeroed
    i: mutable usize = 0
    while i < n:
        j: mutable usize = 0
        while j <= i:
            negative_remainder: i64 = -((j % n).i64())
            a[i * n + j] <- negative_remainder.f64() / n.f64() + 1.0
            j <- j + 1
        while j < n:
            a[i * n + j] <- 0.0
            j <- j + 1
        a[i * n + i] <- 1.0
        i <- i + 1
    t: mutable usize = 0
    while t < n:
        i <- 0
        while i < n:
            j <- 0
            while j < n:
                product[i * n + j] <- product[i * n + j] + a[i * n + t] * a[j * n + t]
                j <- j + 1
            i <- i + 1
        t <- t + 1
    i <- 0
    while i < n:
        j <- 0
        while j < n:
            a[i * n + j] <- product[i * n + j]
            j <- j + 1
        i <- i + 1
    i <- 0
    while i < n:
        j <- 0
        while j < i:
            k: mutable usize = 0
            while k < j:
                a[i * n + j] <- a[i * n + j] - a[i * n + k] * a[j * n + k]
                k <- k + 1
            a[i * n + j] <- a[i * n + j] / a[j * n + j]
            j <- j + 1
        k: mutable usize = 0
        while k < i:
            a[i * n + i] <- a[i * n + i] - a[i * n + k] * a[i * n + k]
            k <- k + 1
        a[i * n + i] <- sqrt(a[i * n + i])
        i <- i + 1
    result: mutable f64 = 0.0
    i <- 0
    while i < n:
        j <- 0
        while j <= i:
            result <- result + a[i * n + j]
            j <- j + 1
        i <- i + 1
    result

export fn polybench_cholesky(values: i64&, length: usize) -> f64 = polybench_cholesky_impl
