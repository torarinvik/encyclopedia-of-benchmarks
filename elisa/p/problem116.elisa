# Count single-color block replacements for lengths two, three, and four.
const MAX_LENGTH: i64 = 91

def problem116_impl(length: i64) -> i64:
    if length > MAX_LENGTH:
        return -1
    if length < 0:
        return -1
    ways: mutable i64[276] = zeroed
    row_length: mutable i64 = 0
    while row_length <= length:
        tile_length: mutable i64 = 2
        while tile_length < 5:
            color: i64 = tile_length - 2
            tile_start: mutable i64 = 0
            while tile_start < row_length - tile_length + 1:
                suffix: i64 = row_length - tile_start - tile_length
                index: i64 = row_length * 3 + color
                suffix_index: i64 = suffix * 3 + color
                ways[index.usize()] <- ways[index.usize()] + ways[suffix_index.usize()] + 1
                tile_start <- tile_start + 1
            tile_length <- tile_length + 1
        row_length <- row_length + 1
    ways[(length * 3).usize()] + ways[(length * 3 + 1).usize()] + ways[(length * 3 + 2).usize()]

export fn problem116(length: i64) -> i64 = problem116_impl
