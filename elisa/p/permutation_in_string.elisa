# Check for a permutation of one lowercase ASCII string inside another.
const MAX_STRING_LENGTH: usize = 1024
const MAX_INPUT_LENGTH: usize = 2050

def permutation_in_string_impl(input: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    first_length_value: i64 = input[0]
    second_length_value: i64 = input[1]
    if first_length_value < 0 or first_length_value > 1024 or second_length_value < 0 or second_length_value > 1024:
        return -1
    first_length: usize = first_length_value.usize()
    second_length: usize = second_length_value.usize()
    if length != 2 + first_length + second_length:
        return -1
    index: mutable usize = 2
    while index < length:
        if input[index] < 97 or input[index] > 122:
            return -1
        index <- index + 1
    if first_length > second_length:
        return 0

    differences: mutable i64[26] = zeroed
    nonzero: mutable i64 = 0
    index <- 0
    letter: mutable usize = 0
    while index < first_length:
        letter <- (input[2 + index] - 97).usize()
        if differences[letter] == 0:
            nonzero <- nonzero + 1
        differences[letter] <- differences[letter] + 1
        if differences[letter] == 0:
            nonzero <- nonzero - 1
        letter <- (input[2 + first_length + index] - 97).usize()
        if differences[letter] == 0:
            nonzero <- nonzero + 1
        differences[letter] <- differences[letter] - 1
        if differences[letter] == 0:
            nonzero <- nonzero - 1
        index <- index + 1
    if nonzero == 0:
        return 1
    start: mutable usize = 0
    while start < second_length - first_length:
        outgoing: usize = 2 + first_length + start
        incoming: usize = outgoing + first_length
        letter <- (input[outgoing] - 97).usize()
        if differences[letter] == 0:
            nonzero <- nonzero + 1
        differences[letter] <- differences[letter] + 1
        if differences[letter] == 0:
            nonzero <- nonzero - 1
        letter <- (input[incoming] - 97).usize()
        if differences[letter] == 0:
            nonzero <- nonzero + 1
        differences[letter] <- differences[letter] - 1
        if differences[letter] == 0:
            nonzero <- nonzero - 1
        if nonzero == 0:
            return 1
        start <- start + 1
    0

export fn permutation_in_string(input: i64&, length: usize) -> i64 = permutation_in_string_impl
