def idea_mul(a: u16, b: u16) -> u16:
    x: u64 = if a == 0 then 65536 else a.u64()
    y: u64 = if b == 0 then 65536 else b.u64()
    z: u64 = (x*y) % 65537
    if z == 65536 then 0 else z.u16()
def idea_add(a: u16, b: u16) -> u16: ((a.u32()+b.u32()) & 65535).u16()
def idea_expand(key: u8&, subkeys: u16&) -> void:
    state: mutable [8]u16 = [0;8]
    for i in 0..<8: state[i] <- ((key[2*i].u16() << 8) | key[2*i+1].u16())
    offset: mutable usize = 0
    while offset < 52:
        count: usize = if 52-offset < 8 then 52-offset else 8
        for i in 0..<count: subkeys[offset+i] <- state[i]
        rotated: mutable [8]u16 = [0;8]
        for i in 0..<8: rotated[i] <- ((state[(i+1)&7].u32() << 9) | (state[(i+2)&7].u32() >> 7)).u16()
        for i in 0..<8: state[i] <- rotated[i]
        offset <- offset+8
def idea_encrypt(subkeys: u16&, block: u8&, output: u8&) -> void:
    x1: mutable u16 = ((block[0].u16()<<8)|block[1].u16())
    x2: mutable u16 = ((block[2].u16()<<8)|block[3].u16())
    x3: mutable u16 = ((block[4].u16()<<8)|block[5].u16())
    x4: mutable u16 = ((block[6].u16()<<8)|block[7].u16())
    for round in 0..<8:
        at: usize = round*6
        a: u16 = idea_mul(x1,subkeys[at])
        b: u16 = idea_add(x2,subkeys[at+1])
        c: u16 = idea_add(x3,subkeys[at+2])
        d: u16 = idea_mul(x4,subkeys[at+3])
        p: u16 = idea_mul(a ^ c,subkeys[at+4])
        q: u16 = idea_mul(idea_add(b ^ d,p),subkeys[at+5])
        t: u16 = idea_add(p,q)
        x1 <- a ^ q; x2 <- c ^ q; x3 <- b ^ t; x4 <- d ^ t
    words: [4]u16 = [idea_mul(x1,subkeys[48]),idea_add(x3,subkeys[49]),idea_add(x2,subkeys[50]),idea_mul(x4,subkeys[51])]
    for i in 0..<4: output[2*i] <- (words[i] >> 8).u8(); output[2*i+1] <- (words[i] & 255).u8()
def idea_cfb64_impl(values: i64&, length: usize, output: u8&, capacity: usize) -> i64:
    if values.is_null() or length < 27 or length > 51: return -1
    mode: i64 = values[0]
    raw_len: i64 = values[1]
    if mode < 0 or mode > 1 or raw_len < 1 or raw_len > 24 or length != 26+raw_len.usize(): return -1
    text_len: usize = raw_len.usize()
    key: mutable [16]u8 = [0;16]; state: mutable [8]u8 = [0;8]; text: mutable [24]u8 = [0;24]
    for i in 0..<16:
        if values[2+i] < 0 or values[2+i] > 255: return -1
        key[i] <- values[2+i].u8()
    for i in 0..<8:
        if values[18+i] < 0 or values[18+i] > 255: return -1
        state[i] <- values[18+i].u8()
    for i in 0..<text_len:
        if values[26+i] < 0 or values[26+i] > 255: return -1
        text[i] <- values[26+i].u8()
    subkeys: mutable [52]u16 = [0;52]
    idea_expand(&key[0],&subkeys[0])
    result: mutable [24]u8 = [0;24]
    pos: mutable usize = 0
    while pos < text_len:
        stream: mutable [8]u8 = [0;8]
        idea_encrypt(&subkeys[0],&state[0],&stream[0])
        take: usize = if text_len-pos < 8 then text_len-pos else 8
        for j in 0..<take:
            result[pos+j] <- text[pos+j] ^ stream[j]
            if mode == 0: state[j] <- result[pos+j] else: state[j] <- text[pos+j]
        pos <- pos+take
    if output.is_null() or capacity < text_len: return -2
    for i in 0..<text_len: output[i] <- result[i]
    text_len.i64()
export fn idea_cfb64(values: i64&, length: usize, output: u8&, capacity: usize) -> i64 = idea_cfb64_impl
