# Check whether a signed 32-bit integer is a perfect cube.
def perfect_cube_checker_impl(n: i64) -> i64:
    if n < -2147483648 or n > 2147483647:
        return -1
    magnitude: i64 = if n < 0: -n else: n
    low: mutable i64 = 0
    high: mutable i64 = 1290
    while low <= high:
        mid: i64 = low + (high - low) / 2
        cube: i64 = mid * mid * mid
        if cube == magnitude:
            return 1
        if cube < magnitude:
            low <- mid + 1
        else:
            high <- mid - 1
    0

export fn perfect_cube_checker(n: i64) -> i64 = perfect_cube_checker_impl
