def problem121_impl(num_turns: i64) -> i64:
    if num_turns < 1 or num_turns > 15:
        return -1
    denominator: mutable i64 = 1
    turn: mutable i64 = 2
    while turn <= num_turns + 1:
        denominator <- denominator * turn
        turn <- turn + 1

    sequence_count: mutable i64 = 1
    turn <- 0
    while turn < num_turns:
        sequence_count <- sequence_count * 2
        turn <- turn + 1
    winning_weight: mutable i64 = 0
    mask: mutable i64 = 0
    while mask < sequence_count:
        remaining: mutable i64 = mask
        blue: mutable i64 = 0
        weight: mutable i64 = 1
        turn <- 0
        while turn < num_turns:
            if remaining % 2 == 0:
                weight <- weight * (turn + 1)
            else:
                blue <- blue + 1
            remaining <- remaining / 2
            turn <- turn + 1
        if 2 * blue > num_turns:
            winning_weight <- winning_weight + weight
        mask <- mask + 1
    denominator / winning_weight

export fn problem121(num_turns: i64) -> i64 = problem121_impl
