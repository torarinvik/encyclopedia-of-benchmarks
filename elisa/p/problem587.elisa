extern asin(value: f64) -> f64
extern sqrt(value: f64) -> f64
const INVALID_RESULT: f64 = -1.0e300
const MIN_FRACTION: f64 = 0.001
const MAX_FRACTION: f64 = 0.1
const MAX_N: i64 = 100000
const PI_VALUE: f64 = 3.141592653589793238462643383279502884

def circle_bottom_arc_integral(point: f64) -> f64:
    ((1.0 - 2.0 * point) * sqrt(point - point * point) + 2.0 * point + asin(sqrt(1.0 - point))) / 4.0

def concave_triangle_area(n: i64) -> f64:
    circles: f64 = n.f64()
    intersection_y: f64 = (circles + 1.0 - sqrt(2.0 * circles)) / (2.0 * (circles * circles + 1.0))
    intersection_x: f64 = circles * intersection_y
    triangle_area: f64 = intersection_x * intersection_y / 2.0
    concave_region_area: f64 = circle_bottom_arc_integral(0.5) - circle_bottom_arc_integral(intersection_x)
    triangle_area + concave_region_area

def problem587_impl(fraction: f64) -> f64:
    if fraction != fraction or fraction < MIN_FRACTION or fraction > MAX_FRACTION:
        return INVALID_RESULT
    l_section_area: f64 = (1.0 - PI_VALUE / 4.0) / 4.0
    n: mutable i64 = 1
    while n <= MAX_N:
        if concave_triangle_area(n) / l_section_area < fraction:
            return n.f64()
        n <- n + 1
    INVALID_RESULT

export fn problem587(fraction: f64) -> f64 = problem587_impl
