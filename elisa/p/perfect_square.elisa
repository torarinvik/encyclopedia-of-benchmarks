# Exact perfect-square check using integer binary search and division.
def perfect_square_impl(input: i64) -> i64:
    if input < 0:
        return 0
    if input < 2:
        return 1
    number: u64 = input.u64()
    low: mutable u64 = 1
    high: mutable u64 = number / 2
    while low <= high:
        middle: u64 = low + (high - low) / 2
        quotient: u64 = number / middle
        if quotient == middle:
            if number % middle == 0:
                return 1
            if middle == high:
                return 0
            low <- middle + 1
        elif quotient < middle:
            if middle == low:
                return 0
            high <- middle - 1
        else:
            if middle == high:
                return 0
            low <- middle + 1
    0

export fn perfect_square(input: i64) -> i64 = perfect_square_impl
