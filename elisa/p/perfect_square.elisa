@intrinsic("llvm.sqrt.f64")
extern square_root(number: f64) -> f64

def perfect_square_impl(input: i64) -> i64:
    if input < 0:
        return 0
    if input < 2:
        return 1
    number: u64 = input.u64()
    # Only 0, 1, 4 and 9 are squares modulo 16.
    if ((0x0213.u64() >> (number & 15)) & 1) == 0:
        return 0
    # For a perfect square in the signed 64-bit range, f64 conversion and
    # square root leave the result within half a unit of the integer root.
    # The integer product decides equality exactly.
    root: u64 = (square_root(number.f64()) + 0.5).u64()
    return 1 if root * root == number else 0

export fn perfect_square(input: i64) -> i64 = perfect_square_impl
