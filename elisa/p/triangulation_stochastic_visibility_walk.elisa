fn tsw_cross(ax:i64,ay:i64,bx:i64,by:i64,px:i64,py:i64)->i64:
    (bx-ax)*(py-ay)-(by-ay)*(px-ax)

fn tsw_same(a:usize,b:usize,c:usize,d:usize)->bool:
    (a==c and b==d) or (a==d and b==c)

fn tsw_on(ax:i64,ay:i64,bx:i64,by:i64,px:i64,py:i64)->bool:
    tsw_cross(ax,ay,bx,by,px,py)==0 and px>=min(ax,bx) and px<=max(ax,bx) and py>=min(ay,by) and py<=max(ay,by)

fn tsw_intersect(ax:i64,ay:i64,bx:i64,by:i64,cx:i64,cy:i64,dx:i64,dy:i64)->bool:
    o1:i64=tsw_cross(ax,ay,bx,by,cx,cy);o2:i64=tsw_cross(ax,ay,bx,by,dx,dy)
    o3:i64=tsw_cross(cx,cy,dx,dy,ax,ay);o4:i64=tsw_cross(cx,cy,dx,dy,bx,by)
    if (o1==0 and tsw_on(ax,ay,bx,by,cx,cy)) or (o2==0 and tsw_on(ax,ay,bx,by,dx,dy)) or (o3==0 and tsw_on(cx,cy,dx,dy,ax,ay)) or (o4==0 and tsw_on(cx,cy,dx,dy,bx,by)):return true
    ((o1<0 and o2>0) or (o1>0 and o2<0)) and ((o3<0 and o4>0) or (o3>0 and o4<0))

def tsw_impl(input:view[i64])->i64:
    if input.len()<8 or input.len()>57:return -1
    vr:i64=input[0];br:i64=input[1];tr:i64=input[2];sr:i64=input[3]
    px:i64=input[4];py:i64=input[5];capr:i64=input[6];kr:i64=input[7]
    if vr<3 or vr>6 or br<3 or br>vr or tr!=2*vr-br-2 or tr<1 or tr>7 or sr<0 or sr>=tr or capr<0 or capr>12 or kr<0 or kr>12 or px< -200 or px>200 or py< -200 or py>200:return -1
    v:usize=vr.usize();bcount:usize=br.usize();tcount:usize=tr.usize();start:usize=sr.usize();cap:usize=capr.usize();k:usize=kr.usize()
    if input.len()!=8+2*v+bcount+3*tcount+k:return -1
    xs:mutable i64[6]=zeroed;ys:mutable i64[6]=zeroed
    boundary:mutable usize[6]=zeroed;faces:mutable usize[21]=zeroed;neighbors:mutable i64[21]=zeroed;used:mutable bool[6]=zeroed
    cursor:mutable usize=8
    for i in 0..<v:
        xs[i]=input[cursor];ys[i]=input[cursor+1];cursor <- cursor+2
        if xs[i]< -200 or xs[i]>200 or ys[i]< -200 or ys[i]>200:return -1
        for j in 0..<i:if xs[i]==xs[j] and ys[i]==ys[j]:return -1
    for i in 0..<bcount:
        raw:i64=input[cursor];cursor <- cursor+1
        if raw<0 or raw>=vr:return -1
        boundary[i]=raw.usize()
        for j in 0..<i:if boundary[i]==boundary[j]:return -1
    for i in 0..<bcount:
        a:usize=boundary[i];b:usize=boundary[(i+1)%bcount]
        for j in 0..<bcount:
            c:usize=boundary[j]
            if c!=a and c!=b and tsw_cross(xs[a],ys[a],xs[b],ys[b],xs[c],ys[c])<=0:return -1
    for p in 0..<v:
        on_boundary:mutable bool=false
        for j in 0..<bcount:if boundary[j]==p:on_boundary=true
        if not on_boundary:
            for j in 0..<bcount:
                a:usize=boundary[j];b:usize=boundary[(j+1)%bcount]
                if tsw_cross(xs[a],ys[a],xs[b],ys[b],xs[p],ys[p])<=0:return -1
    area_sum:mutable i64=0
    for f in 0..<tcount:
        for e in 0..<3:
            raw:i64=input[cursor];cursor <- cursor+1
            if raw<0 or raw>=vr:return -1
            faces[f*3+e]=raw.usize()
        a:usize=faces[f*3];b:usize=faces[f*3+1];c:usize=faces[f*3+2]
        if a==b or b==c or c==a or tsw_cross(xs[a],ys[a],xs[b],ys[b],xs[c],ys[c])<=0:return -1
        used[a]=true;used[b]=true;used[c]=true
        area_sum <- area_sum+tsw_cross(xs[a],ys[a],xs[b],ys[b],xs[c],ys[c])
        for g in 0..<f:
            same:mutable bool=true
            for e in 0..<3:
                found:mutable bool=false
                for j in 0..<3:if faces[f*3+e]==faces[g*3+j]:found=true
                if not found:same=false
            if same:return -1
        for e in 0..<3:neighbors[f*3+e] <- -1
    for i in 0..<v:if not used[i]:return -1
    polygon_area:mutable i64=0
    for i in 0..<bcount:
        a:usize=boundary[i];b:usize=boundary[(i+1)%bcount]
        polygon_area <- polygon_area+xs[a]*ys[b]-ys[a]*xs[b]
    if polygon_area<=0 or polygon_area!=area_sum:return -1
    for i in 0..<bcount:
        a:usize=boundary[i];b:usize=boundary[(i+1)%bcount];owners:mutable usize=0
        for f in 0..<tcount:for e in 0..<3:if tsw_same(a,b,faces[f*3+e],faces[f*3+(e+1)%3]):owners <- owners+1
        if owners!=1:return -1
    for f in 0..<tcount:
        for e in 0..<3:
            a:usize=faces[f*3+e];b:usize=faces[f*3+(e+1)%3];first:mutable bool=true
            for g in 0..<(f+1):
                for ge in 0..<3:
                    if g==f and ge>=e:continue
                    if tsw_same(a,b,faces[g*3+ge],faces[g*3+(ge+1)%3]):first=false
            if first:
                for p in 0..<v:
                    if p!=a and p!=b and tsw_on(xs[a],ys[a],xs[b],ys[b],xs[p],ys[p]):return -1
                for g in f..<tcount:
                    for ge in 0..<3:
                        if g==f and ge<=e:continue
                        c:usize=faces[g*3+ge];d:usize=faces[g*3+(ge+1)%3]
                        if a==c or a==d or b==c or b==d:continue
                        if tsw_intersect(xs[a],ys[a],xs[b],ys[b],xs[c],ys[c],xs[d],ys[d]):return -1
    for f in 0..<tcount:
        for e in 0..<3:
            a:usize=faces[f*3+e];b:usize=faces[f*3+(e+1)%3];boundary_edge:mutable bool=false
            for i in 0..<bcount:if tsw_same(a,b,boundary[i],boundary[(i+1)%bcount]):boundary_edge=true
            owners:mutable usize=0;other:mutable i64=-1;first_u:mutable usize=0;first_v:mutable usize=0
            for g in 0..<tcount:
                for ge in 0..<3:
                    if tsw_same(a,b,faces[g*3+ge],faces[g*3+(ge+1)%3]):
                        if owners==0:first_u=faces[g*3+ge];first_v=faces[g*3+(ge+1)%3]
                        elif faces[g*3+ge]!=first_v or faces[g*3+(ge+1)%3]!=first_u:return -1
                        owners <- owners+1
                        if g!=f:other=g.i64()
            expected_owners:usize=if boundary_edge:1 else:2
            if owners!=expected_owners:return -1
            if not boundary_edge:neighbors[f*3+e] <- other
    for i in 0..<k:if input[cursor+i]<0 or input[cursor+i]>1:return -1
    for i in 0..<bcount:
        a:usize=boundary[i];b:usize=boundary[(i+1)%bcount]
        if tsw_cross(xs[a],ys[a],xs[b],ys[b],px,py)<=0:return -1
    containing:mutable usize=0
    for f in 0..<tcount:
        a:usize=faces[f*3];b:usize=faces[f*3+1];c:usize=faces[f*3+2]
        if tsw_cross(xs[a],ys[a],xs[b],ys[b],px,py)>0 and tsw_cross(xs[b],ys[b],xs[c],ys[c],px,py)>0 and tsw_cross(xs[c],ys[c],xs[a],ys[a],px,py)>0:containing <- containing+1
    if containing!=1:return -1
    face:mutable usize=start;steps:mutable usize=0;choice_index:mutable usize=0;trace:mutable i64=(face+1).i64();predicates:mutable i64=0;status:mutable i64=0
    while true:
        a:usize=faces[face*3];b:usize=faces[face*3+1];c:usize=faces[face*3+2]
        eu:mutable usize[3]=zeroed;ev:mutable usize[3]=zeroed;eligible:mutable usize[3]=zeroed;count:mutable usize=0
        eu[0]=a;eu[1]=b;eu[2]=c;ev[0]=b;ev[1]=c;ev[2]=a
        for e in 0..<3:
            predicates <- predicates+1
            if tsw_cross(xs[eu[e]],ys[eu[e]],xs[ev[e]],ys[ev[e]],px,py)<0:eligible[count]=e;count <- count+1
        if count==0:status <- 0;break
        if steps==cap:status <- 2;break
        selected:mutable usize=0
        if count==1:selected=eligible[0]
        elif count==2:
            if choice_index==k:status <- 1;break
            selected=eligible[input[cursor+choice_index].usize()];choice_index <- choice_index+1
        else:return -1
        next_face:i64=neighbors[face*3+selected]
        if next_face<0:return -1
        face=next_face.usize()
        steps <- steps+1;trace <- trace*9+face.i64()+1
    (trace*40+predicates)*3+status

export fn triangulation_stochastic_visibility_walk(input:i64&,length:usize)->i64:
    if input.is_null() or length<8 or length>57:return -1
    tsw_impl(input[0:length])
