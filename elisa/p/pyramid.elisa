extern sqrt(value: f64) -> f64
extern pow(base: f64, exponent: f64) -> f64
def pyramid_impl(v: i64&, n: usize) -> f64:
    if v.is_null() or n != 3 or v[0] < 0 or v[0] > 1 or v[1] < 1 or v[1] > 10000000 or v[2] < 1 or v[2] > 10000000: return -1e300
    b: f64 = v[1].f64() / 1000.0
    h: f64 = v[2].f64() / 1000.0
    area: f64 = pow(b, 2.0)
    if v[0] == 0: return (area * h) / 3.0
    area + ((b * 4.0) / 2.0) * sqrt(pow(b / 2.0, 2.0) + pow(h, 2.0))
export fn pyramid(v: i64&, n: usize) -> f64 = pyramid_impl
