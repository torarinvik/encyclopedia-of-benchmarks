export fn pattern_matching(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > 130 or input[0] < 0 or input[0] > 64.i64(): return -1
    text_size: usize = input[0].usize()
    p_offset: usize = text_size + 1
    if length < p_offset + 1 or input[p_offset] < 1 or input[p_offset] > 64.i64(): return -1
    pattern_size: usize = input[p_offset].usize()
    if length != p_offset + pattern_size + 1 or pattern_size > text_size: return -1
    i: mutable usize = 1
    while i < p_offset:
        if input[i] < 0 or input[i] > 127: return -1
        i <- i + 1
    i <- p_offset + 1
    while i < length:
        if input[i] < 0 or input[i] > 127: return -1
        i <- i + 1
    start: mutable usize = 0
    while start <= text_size - pattern_size:
        j: mutable usize = 0
        while j < pattern_size and input[start + j + 1] == input[p_offset + j + 1]: j <- j + 1
        if j == pattern_size: return start.i64()
        start <- start + 1
    return -1

