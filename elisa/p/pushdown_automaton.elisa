// Recognize the bounded language (1|2)^n 0^n with a pushdown-style counter.
const MAX_BYTE_LENGTH: usize = 256
const MAX_INPUT_LENGTH: usize = 257

def pushdown_automaton_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    byte_length: i64 = values[0]
    if byte_length < 0 or byte_length > MAX_BYTE_LENGTH.i64():
        return -1
    count: usize = byte_length.usize()
    if length != count + 1:
        return -1

    index: mutable usize = 0
    while index < count:
        if values[index + 1] < 48 or values[index + 1] > 50:
            return -1
        index <- index + 1

    if count == 0 or count % 2 != 0:
        return 0
    half: usize = count / 2
    index <- 0
    while index < half:
        if values[index + 1] != 49 and values[index + 1] != 50:
            return 0
        index <- index + 1
    index <- half
    while index < count:
        if values[index + 1] != 48:
            return 0
        index <- index + 1
    return 1

export fn pushdown_automaton(values: i64&, length: usize) -> i64 = pushdown_automaton_impl
