def pairwise_iteration_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 129 or input[0] < 0 or input[0] > 128.i64() or length != input[0].usize() + 1: return -1
    count: usize = input[0].usize()
    i: usize = 0
    while i < count:
        if input[i + 1] < -1000000 or input[i + 1] > 1000000: return -1
        i <- i + 1
    pairs: usize = if count > 0: count - 1 else: 0
    needed: usize = pairs * 16
    if needed > capacity or (needed > 0 and output.is_null()): return -2
    k: mutable usize = 0
    i <- 0
    while i < pairs:
        j: usize = 0
        while j < 2:
            bits: u64 = input[i + j + 1].u64()
            b: usize = 0
            while b < 8:
                output[k] <- ((bits >> (8 * b)) and 255).u8()
                k <- k + 1
                b <- b + 1
            j <- j + 1
        i <- i + 1
    needed.i64()

export fn pairwise_iteration(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = pairwise_iteration_impl
