# Sum both members of amicable pairs whose smaller member is below the limit.
def problem21_pair_sum_proper_divisor_sum(value: i64) -> i64:
    if value <= 1:
        return 0
    total: mutable i64 = 1
    divisor: mutable i64 = 2
    while divisor <= value / divisor:
        if value % divisor == 0:
            partner: i64 = value / divisor
            total <- total + divisor
            if partner != divisor:
                total <- total + partner
        divisor <- divisor + 1
    total

def problem21_pair_sum_impl(limit: i64) -> i64:
    if limit < 2 or limit > 10000:
        return -1
    total: mutable i64 = 0
    smaller: mutable i64 = 2
    while smaller < limit:
        larger: i64 = problem21_pair_sum_proper_divisor_sum(smaller)
        if larger > smaller and problem21_pair_sum_proper_divisor_sum(larger) == smaller:
            total <- total + smaller + larger
        smaller <- smaller + 1
    total

export fn problem21_pair_sum(limit: i64) -> i64 = problem21_pair_sum_impl
