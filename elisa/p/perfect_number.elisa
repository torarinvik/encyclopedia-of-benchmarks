def perfect_number_scan(number: u64, stride: u64, initial_total: u64) -> i64:
    factor: mutable u64 = 3
    total: mutable u64 = initial_total
    # The public input cap is 10^12, so factor never exceeds 1,000,002.
    while factor * factor <= number:
        partner: u64 = number / factor
        if partner * factor == number:
            total <- total + factor
            if partner != factor:
                total <- total + partner
            if total > number:
                return 0
        factor <- factor + stride
    return 1 if total == number else 0

# Check whether n equals the sum of its positive proper divisors.
def perfect_number_impl(n: i64) -> i64:
    if n <= 1:
        return 0
    if n > 1000000000000:
        return -1
    number: u64 = n.u64()
    # Odd numbers have no even divisors.
    stride: u64 = 1 + (number & 1)
    total: mutable u64 = 1
    if stride == 1 and number >= 4:
        half: u64 = number >> 1
        total <- 3 if half == 2 else 3 + half
    if stride == 1:
        return perfect_number_scan(number, 1, total)
    perfect_number_scan(number, 2, total)

export fn perfect_number(n: i64) -> i64 = perfect_number_impl
