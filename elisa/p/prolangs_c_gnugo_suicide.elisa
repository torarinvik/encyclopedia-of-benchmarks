def group_liberties(board: u8&, start: usize, color: u8) -> usize:
    seen: mutable bool[361] = zeroed
    lib_seen: mutable bool[361] = zeroed
    stack: mutable usize[361] = zeroed
    top: mutable usize = 1
    total: mutable usize = 0
    stack[0] <- start
    seen[start] <- true
    while top > 0:
        top <- top - 1
        at: usize = stack[top]
        r: usize = at / 19
        c: usize = at % 19
        neighbors: mutable usize[4] = zeroed
        n: mutable usize = 0
        if r > 0: neighbors[n] <- at - 19; n <- n + 1
        if r < 18: neighbors[n] <- at + 19; n <- n + 1
        if c > 0: neighbors[n] <- at - 1; n <- n + 1
        if c < 18: neighbors[n] <- at + 1; n <- n + 1
        j: mutable usize = 0
        while j < n:
            next: usize = neighbors[j]
            if board[next] == 0:
                if not lib_seen[next]: lib_seen[next] <- true; total <- total + 1
            else if board[next] == color and not seen[next]:
                seen[next] <- true
                stack[top] <- next
                top <- top + 1
            j <- j + 1
    total

def prolangs_c_gnugo_suicide_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 6 or length > 246: return -1
    row: i64 = input[0]
    col: i64 = input[1]
    own: i64 = input[2]
    opponent: i64 = input[3]
    ko: i64 = input[4]
    count: i64 = input[5]
    if row < 0 or row >= 19 or col < 0 or col >= 19 or (own != 1 and own != 2) or (opponent != 1 and opponent != 2) or own == opponent or ko < -1 or ko >= 361 or count < 0 or count > 120: return -1
    if length != 6 + 2 * count.usize(): return -1
    board: mutable u8[361] = zeroed
    k: mutable usize = 0
    while k < count.usize():
        at: i64 = input[6 + 2*k]
        stone: i64 = input[7 + 2*k]
        if at < 0 or at >= 361 or (stone != 1 and stone != 2) or board[at.usize()] != 0: return -1
        board[at.usize()] <- stone.u8()
        k <- k + 1
    target: usize = (row * 19 + col).usize()
    if board[target] != 0: return -1
    board[target] <- opponent.u8()
    if group_liberties(board, target, opponent.u8()) > 0: return 0
    dead: mutable i64 = 0
    i: mutable usize = 0
    while i < 361:
        if board[i] == own.u8() and group_liberties(board, i, own.u8()) == 0: dead <- dead + 1
        i <- i + 1
    if dead == 0 or (dead == 1 and ko == target.i64()): return 1
    0

export fn prolangs_c_gnugo_suicide(input: i64&, length: usize) -> i64 = prolangs_c_gnugo_suicide_impl
