const INTERPOLATION_MODULUS: i64 = 998_244_353
const INTERPOLATION_MAX_N: usize = 12
const INTERPOLATION_MAX_INPUT: usize = 25
const INTERPOLATION_MAX_OUTPUT_BYTES: usize = 96

def polynomial_interpolation_normalize(value: i64) -> i64:
    reduced: mutable i64 = value % INTERPOLATION_MODULUS
    if reduced < 0: reduced <- reduced + INTERPOLATION_MODULUS
    reduced

def polynomial_interpolation_power(base_value: i64, exponent_value: i64) -> i64:
    base: mutable i64 = base_value
    exponent: mutable i64 = exponent_value
    result: mutable i64 = 1
    while exponent > 0:
        if (exponent & 1) != 0:
            result <- result * base % INTERPOLATION_MODULUS
        base <- base * base % INTERPOLATION_MODULUS
        exponent <- exponent >> 1
    result

def polynomial_interpolation_store_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def polynomial_interpolation_impl(input: view[i64], length: usize,
    output: mutable view[u8], capacity: usize, output_is_null: bool) -> i64:
    if length < 3 or length > INTERPOLATION_MAX_INPUT: return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > INTERPOLATION_MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n: return -1
    for i in 0..<n:
        xi: i64 = input[1 + i]
        yi: i64 = input[1 + n + i]
        if xi < 0 or xi >= INTERPOLATION_MODULUS or yi < 0 or yi >= INTERPOLATION_MODULUS: return -1
        for j in 0..<i:
            if xi == input[1 + j]: return -1

    output_bytes: usize = 8 * n
    if output_is_null or capacity < output_bytes: return -2
    result: mutable i64[INTERPOLATION_MAX_N] = zeroed
    for i in 0..<n:
        basis: mutable i64[INTERPOLATION_MAX_N + 1] = zeroed
        basis[0] <- 1
        degree: mutable usize = 0
        denominator: mutable i64 = 1
        for j in 0..<n:
            if j == i: continue
            xj: i64 = input[1 + j]
            denominator <- denominator * (input[1 + i] - xj) % INTERPOLATION_MODULUS
            expanded: mutable i64[INTERPOLATION_MAX_N + 1] = zeroed
            for k in 0..=degree:
                expanded[k] <- polynomial_interpolation_normalize(expanded[k] - basis[k] * xj)
                expanded[k + 1] <- polynomial_interpolation_normalize(expanded[k + 1] + basis[k])
            for k in 0..=degree + 1: basis[k] <- expanded[k]
            degree <- degree + 1
        scale: i64 = input[1 + n + i] * polynomial_interpolation_power(
            polynomial_interpolation_normalize(denominator), INTERPOLATION_MODULUS - 2
        ) % INTERPOLATION_MODULUS
        for k in 0..<n:
            result[k] <- (result[k] + scale * basis[k]) % INTERPOLATION_MODULUS
    for i in 0..<n: polynomial_interpolation_store_le(result[i], output, 8 * i)
    output_bytes.i64()

export fn polynomial_interpolation(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > INTERPOLATION_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return polynomial_interpolation_impl(input_view, length, scratch[0:1], 0, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > INTERPOLATION_MAX_OUTPUT_BYTES: safe_capacity <- INTERPOLATION_MAX_OUTPUT_BYTES
    output_view: mutable view[u8] = output[0:safe_capacity]
    polynomial_interpolation_impl(input_view, length, output_view, capacity, false)
