def problem188_modexpt(base: i64, exponent: i64, modulus: i64) -> i64:
    if exponent == 1:
        return base
    if exponent % 2 == 0:
        half: i64 = problem188_modexpt(base, exponent / 2, modulus) % modulus
        return (half * half) % modulus
    (base * problem188_modexpt(base, exponent - 1, modulus)) % modulus

def problem188_impl(base: i64, height: i64, digits: i64) -> i64:
    if base < 1 or base > 1000000000 or base % 10 == 0 or height < 1 or height > 10000 or digits < 1 or digits > 8:
        return -1
    modulus: mutable i64 = 1
    index: mutable i64 = 0
    while index < digits:
        modulus <- modulus * 10
        index <- index + 1
    result: mutable i64 = base
    level: mutable i64 = 1
    while level < height:
        result <- problem188_modexpt(base, result, modulus)
        level <- level + 1
    result

export fn problem188(base: i64, height: i64, digits: i64) -> i64 = problem188_impl
