const MAX_TEAMS: usize = 8
const MAX_GAMES: i64 = 64
const MAX_NET: i64 = 4096

struct FootballFraction:
    numerator: i64
    denominator: i64

struct FootballGroup:
    lo: usize
    hi: usize
    stage: usize

def football_same_division(input: view[i64], order: view[usize], lo: usize, hi: usize) -> bool:
    first: usize = 1 + 12 * order[lo]
    position: mutable usize = lo + 1
    while position < hi:
        current: usize = 1 + 12 * order[position]
        if input[first + 1] != input[current + 1] or input[first + 2] != input[current + 2]: return false
        position <- position + 1
    true

def football_score(input: view[i64], n: usize, order: view[usize], lo: usize, hi: usize,
                   team: usize, stage: usize, same_div: bool) -> FootballFraction:
    if stage == 0:
        cells: usize = n * n
        wins_start: usize = 1 + 12 * n
        ties_start: usize = wins_start + cells
        won: mutable i64 = 0
        lost: mutable i64 = 0
        tied: mutable i64 = 0
        position: mutable usize = lo
        while position < hi:
            other: usize = order[position]
            if other != team:
                won <- won + input[wins_start + team * n + other]
                lost <- lost + input[wins_start + other * n + team]
                tied <- tied + input[ties_start + team * n + other]
            position <- position + 1
        games: i64 = won + lost + tied
        denominator: i64 = if games == 0: 1 else: 2 * games
        return FootballFraction{numerator: 2 * won + tied, denominator: denominator}
    base: usize = 1 + 12 * team
    if stage >= 1 and stage <= 3:
        field: usize = if stage == 1: 3 else: (if stage == 2: 5 else: 7)
        games: i64 = input[base + field + 1]
        denominator: i64 = if games == 0: 1 else: 2 * games
        return FootballFraction{numerator: input[base + field], denominator: denominator}
    if stage == 4:
        field: usize = if same_div: 9 else: 10
        return FootballFraction{numerator: input[base + field], denominator: 1}
    FootballFraction{numerator: input[base + 11], denominator: 1}

def football_compare(a: FootballFraction, b: FootballFraction) -> i64:
    left: i64 = a.numerator * b.denominator
    right: i64 = b.numerator * a.denominator
    if left > right: return 1
    if left < right: return -1
    0

def football_refine(input: view[i64], n: usize, order: mutable view[usize], lo: usize, hi: usize,
                    stage: usize, same_div: bool, output: mutable view[FootballGroup], output_count: mutable usize&) -> void:
    index: mutable usize = lo + 1
    while index < hi:
        item: usize = order[index]
        item_score: FootballFraction = football_score(input, n, order, lo, hi, item, stage, same_div)
        position: mutable usize = index
        while position > lo:
            previous: FootballFraction = football_score(input, n, order, lo, hi, order[position - 1], stage, same_div)
            if football_compare(item_score, previous) <= 0: break
            order[position] <- order[position - 1]
            position <- position - 1
        order[position] <- item
        index <- index + 1
    best: FootballFraction = football_score(input, n, order, lo, hi, order[lo], stage, same_div)
    split: mutable bool = false
    index <- lo + 1
    while index < hi:
        if football_compare(best, football_score(input, n, order, lo, hi, order[index], stage, same_div)) != 0:
            split <- true
        index <- index + 1
    if not split:
        output[output_count] <- FootballGroup{lo: lo, hi: hi, stage: stage + 1}
        output_count <- output_count + 1
        return
    start: mutable usize = lo
    while start < hi:
        value: FootballFraction = football_score(input, n, order, lo, hi, order[start], stage, same_div)
        finish: mutable usize = start + 1
        while finish < hi and football_compare(value, football_score(input, n, order, lo, hi, order[finish], stage, same_div)) == 0:
            finish <- finish + 1
        output[output_count] <- FootballGroup{lo: start, hi: finish, stage: 0}
        output_count <- output_count + 1
        start <- finish

def football_sweep(input: view[i64], n: usize, order: view[usize], lo: usize, hi: usize) -> i64:
    cells: usize = n * n
    wins_start: usize = 1 + 12 * n
    ties_start: usize = wins_start + cells
    position: mutable usize = 0
    while position < hi - lo:
        team: usize = order[lo + position]
        win: mutable bool = true
        lose: mutable bool = true
        other_position: mutable usize = 0
        while other_position < hi - lo:
            other: usize = order[lo + other_position]
            if other != team:
                won: i64 = input[wins_start + team * n + other]
                lost: i64 = input[wins_start + other * n + team]
                tied: i64 = input[ties_start + team * n + other]
                if won + lost + tied == 0 or tied != 0:
                    win <- false
                    lose <- false
                if lost != 0: win <- false
                if won != 0: lose <- false
            other_position <- other_position + 1
        if win: return (position + 1).i64()
        if lose: return -((position + 1).i64())
        position <- position + 1
    0

def football_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or input[0] < 2 or input[0] > MAX_TEAMS.i64(): return -2
    n: usize = input[0].usize()
    cells: usize = n * n
    if length != 1 + 12 * n + 2 * cells: return -2
    team: mutable usize = 0
    while team < n:
        base: usize = 1 + 12 * team
        id: i64 = input[base]
        if id < 0 or id > 31 or input[base + 1] < 0 or input[base + 1] > 1 or input[base + 2] < 0 or input[base + 2] > 2:
            return -2
        field: mutable usize = 3
        while field <= 7:
            points: i64 = input[base + field]
            games: i64 = input[base + field + 1]
            if games < 0 or games > MAX_GAMES or points < 0 or points > 2 * games: return -2
            field <- field + 2
        field <- 9
        while field <= 11:
            if input[base + field] < -MAX_NET or input[base + field] > MAX_NET: return -2
            field <- field + 1
        previous: mutable usize = 0
        while previous < team:
            if input[1 + 12 * previous] == id: return -2
            previous <- previous + 1
        team <- team + 1
    wins_start: usize = 1 + 12 * n
    ties_start: usize = wins_start + cells
    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            wins: i64 = input[wins_start + row * n + column]
            ties: i64 = input[ties_start + row * n + column]
            if wins < 0 or wins > MAX_GAMES or ties < 0 or ties > MAX_GAMES: return -2
            if row == column and (wins != 0 or ties != 0): return -2
            if ties != input[ties_start + column * n + row]: return -2
            column <- column + 1
        row <- row + 1
    order: mutable usize[8] = zeroed
    team <- 0
    while team < n:
        order[team] <- team
        team <- team + 1
    index: mutable usize = 1
    while index < n:
        item: usize = order[index]
        position: mutable usize = index
        while position > 0 and (input[1 + 12 * order[position - 1] + 1] > input[1 + 12 * item + 1] or
            (input[1 + 12 * order[position - 1] + 1] == input[1 + 12 * item + 1] and input[1 + 12 * order[position - 1]] > input[1 + 12 * item])):
            order[position] <- order[position - 1]
            position <- position - 1
        order[position] <- item
        index <- index + 1

    groups: mutable FootballGroup[8] = zeroed
    next: mutable FootballGroup[8] = zeroed
    group_count: mutable usize = 1
    groups[0] <- FootballGroup{lo: 0, hi: n, stage: 0}
    while true:
        next_count <- 0
        active: mutable bool = false
        group_index: mutable usize = 0
        while group_index < group_count:
            lo: usize = groups[group_index].lo
            hi: usize = groups[group_index].hi
            stage: usize = groups[group_index].stage
            if hi - lo <= 1 or stage >= 6:
                next[next_count] <- FootballGroup{lo: lo, hi: hi, stage: 6}
                next_count <- next_count + 1
                group_index <- group_index + 1
                continue
            active <- true
            same: bool = football_same_division(input[0:length], order[0:n], lo, hi)
            if stage == 0:
                if same or hi - lo == 2:
                    football_refine(input[0:length], n, order[0:n], lo, hi, 0, same, next[0:8], next_count&)
                else:
                    sweep: i64 = football_sweep(input[0:length], n, order[0:n], lo, hi)
                    if sweep > 0:
                        position: usize = lo + (sweep - 1).usize()
                        first: usize = order[lo]
                        order[lo] <- order[position]
                        order[position] <- first
                        next[next_count] <- FootballGroup{lo: lo, hi: lo + 1, stage: 0}
                        next_count <- next_count + 1
                        next[next_count] <- FootballGroup{lo: lo + 1, hi: hi, stage: 0}
                        next_count <- next_count + 1
                    else if sweep < 0:
                        position: usize = lo + (-sweep - 1).usize()
                        last: usize = order[hi - 1]
                        order[hi - 1] <- order[position]
                        order[position] <- last
                        next[next_count] <- FootballGroup{lo: lo, hi: hi - 1, stage: 0}
                        next_count <- next_count + 1
                        next[next_count] <- FootballGroup{lo: hi - 1, hi: hi, stage: 0}
                        next_count <- next_count + 1
                    else:
                        next[next_count] <- FootballGroup{lo: lo, hi: hi, stage: 1}
                        next_count <- next_count + 1
            else if stage == 1 and not same:
                next[next_count] <- FootballGroup{lo: lo, hi: hi, stage: 2}
                next_count <- next_count + 1
            else if stage == 3:
                skip_common: mutable bool = false
                p: mutable usize = lo
                while p < hi:
                    if input[1 + 12 * order[p] + 8] < 4: skip_common <- true
                    p <- p + 1
                if skip_common:
                    next[next_count] <- FootballGroup{lo: lo, hi: hi, stage: 4}
                    next_count <- next_count + 1
                else:
                    football_refine(input[0:length], n, order[0:n], lo, hi, stage, same, next[0:8], next_count&)
            else:
                football_refine(input[0:length], n, order[0:n], lo, hi, stage, same, next[0:8], next_count&)
            group_index <- group_index + 1
        group_index <- 0
        while group_index < next_count:
            groups[group_index] <- next[group_index]
            group_index <- group_index + 1
        group_count <- next_count
        if not active: break
    result: mutable i64 = 0
    index <- 0
    while index < n:
        result <- result * 32 + input[1 + 12 * order[index]]
        index <- index + 1
    result

export fn prolangs_football_tiebreaks(input: i64&, length: usize) -> i64 = football_impl
