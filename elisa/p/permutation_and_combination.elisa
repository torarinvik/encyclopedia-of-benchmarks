export fn permutation_and_combination(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 3: return -1
    op: i64 = input[0]; n: i64 = input[1]; r: mutable i64 = input[2]
    if op < 0 or op > 2 or n < 0 or n > 18: return -1
    if op != 0 and (r < 0 or r > n): return -1
    result: mutable i64 = 1
    if op == 0:
        i: mutable i64 = 2
        while i <= n: result <- result * i; i <- i + 1
    elif op == 1:
        i: mutable i64 = n - r + 1
        while i <= n: result <- result * i; i <- i + 1
    else:
        if r > n - r: r <- n - r
        i: mutable i64 = 1
        while i <= r: result <- result * (n - r + i) / i; i <- i + 1
    result
