const MODULUS: i64 = 998_244_353
const MAX_N: usize = 16
const MAX_OPERATIONS: usize = 32
const MAX_INPUT_LENGTH: usize = 162
const TREE_CAPACITY: usize = 64

struct AffineMap:
    a: i64
    b: i64

def identity_map() -> AffineMap:
    result: AffineMap
    result.a <- 1
    result.b <- 0
    result

def compose(left: AffineMap, right: AffineMap) -> AffineMap:
    result: AffineMap
    result.a <- (right.a * left.a) % MODULUS
    result.b <- (right.a * left.b + right.b) % MODULUS
    result

fn point_set_range_composite_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_LENGTH: return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    if n_value < 1 or n_value > 16 or q_value < 0 or q_value > 32: return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if length != 2 + 2 * n + 4 * q: return -1

    for index in 0..<n:
        a: i64 = input[2 + 2 * index]
        b: i64 = input[3 + 2 * index]
        if a < 0 or a >= MODULUS or b < 0 or b >= MODULUS: return -1

    base: mutable usize = 1
    while base < n: base <- base * 2
    tree: mutable AffineMap[TREE_CAPACITY] = zeroed
    for index in 0..<TREE_CAPACITY: tree[index] <- identity_map()
    for index in 0..<n:
        map: AffineMap
        map.a <- input[2 + 2 * index]
        map.b <- input[3 + 2 * index]
        tree[base + index] <- map
    node: mutable usize = base
    while node > 1:
        node <- node - 1
        tree[node] <- compose(tree[2 * node], tree[2 * node + 1])

    checksum: mutable i64 = 0
    query_number: mutable i64 = 0
    cursor: mutable usize = 2 + 2 * n
    for _ in 0..<q:
        opcode: i64 = input[cursor]
        first: i64 = input[cursor + 1]
        second: i64 = input[cursor + 2]
        third: i64 = input[cursor + 3]
        cursor <- cursor + 4
        if opcode == 0:
            if first < 0 or first >= n_value or second < 0 or second >= MODULUS or
                third < 0 or third >= MODULUS: return -1
            node: mutable usize = base + first.usize()
            map: AffineMap
            map.a <- second
            map.b <- third
            tree[node] <- map
            while node > 1:
                node <- node / 2
                tree[node] <- compose(tree[2 * node], tree[2 * node + 1])
        else if opcode == 1:
            if first < 0 or first > second or second > n_value or third < 0 or third >= MODULUS: return -1
            left_index: mutable usize = base + first.usize()
            right_index: mutable usize = base + second.usize()
            left: mutable AffineMap = identity_map()
            right: mutable AffineMap = identity_map()
            while left_index < right_index:
                if left_index % 2 == 1:
                    left <- compose(left, tree[left_index])
                    left_index <- left_index + 1
                if right_index % 2 == 1:
                    right_index <- right_index - 1
                    right <- compose(tree[right_index], right)
                left_index <- left_index / 2
                right_index <- right_index / 2
            range: AffineMap = compose(left, right)
            answer: i64 = (range.a * third + range.b) % MODULUS
            query_number <- query_number + 1
            checksum <- (checksum + query_number * answer) % MODULUS
        else:
            return -1
    if cursor != length: return -1
    checksum

export fn point_set_range_composite(input: i64&, length: usize) -> i64 = point_set_range_composite_impl
