fn pack_repetitions_mix(hash: u64, byte: u8) -> u64:
    ((hash xor byte.u64()) * 16777619) & 4294967295

fn pack_repetitions_feed(hash: mutable u64&, value: u32) -> void:
    bits: u32 = value
    index: mutable usize = 0
    while index < 4:
        hash <- pack_repetitions_mix(hash, (bits >> (8 * index)).u8())
        index <- index + 1

export fn pack_consecutive_repetitions_in_sublist(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > 65 or input[0] < 0 or input[0] > 64 or length != input[0].usize() + 1: return -1
    count: usize = input[0].usize()
    i: mutable usize = 0
    while i < count:
        if input[i + 1] < -2147483648 or input[i + 1] > 2147483647: return -1
        i <- i + 1
    hash: mutable u64 = 2166136261
    i <- 0
    while i < count:
        value: i32 = input[i + 1].i32()
        j: mutable usize = i + 1
        while j < count and input[j + 1] == value.i64(): j <- j + 1
        pack_repetitions_feed(hash, value.u32())
        pack_repetitions_feed(hash, (j - i).u32())
        i <- j
    hash.i64()
