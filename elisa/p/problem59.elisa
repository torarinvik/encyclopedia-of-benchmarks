const MAX_CIPHER: usize = 4096
const KEY_COUNT: usize = 17576

def problem59_allowed(value: i64) -> bool:
    (value >= 9 and value <= 13) or (value >= 32 and value <= 126)

def problem59_word_length(id: usize) -> usize:
    if id == 0 or id == 4: return 3
    if id == 6 or id == 7: return 4
    2

def problem59_word_char(id: usize, index: usize) -> i64:
    if id == 0:
        if index == 0: return 116
        if index == 1: return 104
        return 101
    if id == 1:
        return if index == 0 then 98 else 101
    if id == 2:
        return if index == 0 then 116 else 111
    if id == 3:
        return if index == 0 then 111 else 102
    if id == 4:
        if index == 0: return 97
        if index == 1: return 110
        return 100
    if id == 5:
        return if index == 0 then 105 else 110
    if id == 6:
        if index == 0: return 116
        if index == 1: return 104
        if index == 2: return 97
        return 116
    if index == 0: return 104
    if index == 1: return 97
    if index == 2: return 118
    return 101

def problem59_lower(value: i64) -> i64:
    if value >= 65 and value <= 90: return value + 32
    value

def problem59_contains(input: view[i64], length: usize, keys: u8[52728], index: usize, word: usize) -> bool:
    width: usize = problem59_word_length(word)
    if length < width: return false
    start: mutable usize = 0
    while start + width <= length:
        matched: mutable bool = true
        j: mutable usize = 0
        while j < width:
            pos: usize = start + j
            value: i64 = input[pos] ^ keys[index * 3 + pos % 3].i64()
            if problem59_lower(value) != problem59_word_char(word, j):
                matched <- false
                break
            j <- j + 1
        if matched: return true
        start <- start + 1
    false

def problem59_impl(input: i64&, length: usize) -> i64:
    if input == null or length == 0 or length > MAX_CIPHER: return -1
    for i in 0..<length:
        if input[i] < 0 or input[i] > 255: return -1
    keys: mutable u8[52728] = zeroed
    count: mutable usize = 0
    for a in 97..123:
        for b in 97..123:
            for c in 97..123:
                valid: mutable bool = true
                for i in 0..<length:
                    key: usize = if i % 3 == 0 then a.usize() else if i % 3 == 1 then b.usize() else c.usize()
                    if not problem59_allowed(input[i] ^ key.i64()):
                        valid <- false
                        break
                if valid:
                    keys[count * 3] <- a.u8(); keys[count * 3 + 1] <- b.u8(); keys[count * 3 + 2] <- c.u8()
                    count <- count + 1
    for word in 0..<8:
        kept: mutable usize = 0
        for i in 0..<count:
            if problem59_contains(input[0:length], length, keys, i, word):
                if kept != i:
                    keys[kept * 3] <- keys[i * 3]
                    keys[kept * 3 + 1] <- keys[i * 3 + 1]
                    keys[kept * 3 + 2] <- keys[i * 3 + 2]
                kept <- kept + 1
        count <- kept
        if count == 1: break
    if count == 0: return -1
    total: mutable i64 = 0
    for i in 0..<length: total <- total + (input[i] ^ keys[i % 3].i64())
    total

export fn problem59(input: i64&, length: usize) -> i64 = problem59_impl
