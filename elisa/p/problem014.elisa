def collatz_length(start: u64) -> u64:
    current: mutable u64 = start
    length: mutable u64 = 1.u64()
    while current != 1.u64():
        if length >= 10000.u64(): return 0.u64()
        if current % 2.u64() == 0.u64():
            current <- current / 2.u64()
        else:
            if current > 3002399751580330.u64(): return 0.u64()
            current <- 3.u64() * current + 1.u64()
        length <- length + 1.u64()
    length

def problem014_impl(limit: i64) -> i64:
    if limit < 1 or limit > 1000000: return -1
    best_start: mutable u64 = 1.u64()
    best_length: mutable u64 = 1.u64()
    start: mutable u64 = 2.u64()
    while start < limit.u64():
        length: u64 = collatz_length(start)
        if length == 0.u64(): return -1
        if length > best_length:
            best_start <- start
            best_length <- length
        start <- start + 1.u64()
    best_start.i64()

export fn problem014(limit: i64) -> i64 = problem014_impl
