const MAX_TOTAL: usize = 200
const MAX_PARTS: usize = 200
const MEMO_SIZE: usize = (MAX_TOTAL + 1) * MAX_PARTS

def problem76_impl(total: i64) -> i64:
    if total < 1 or total > MAX_TOTAL.i64():
        return -1
    bound: usize = total.usize()
    memo: mutable i64[MEMO_SIZE] = zeroed
    n: mutable usize = 0
    while n <= bound:
        memo[n * MAX_PARTS] <- 1
        n <- n + 1
    n <- 0
    while n <= bound:
        k: mutable usize = 1
        while k < bound:
            index: usize = n * MAX_PARTS + k
            memo[index] <- memo[index] + memo[index - 1]
            if n > k:
                previous_row: usize = n - k - 1
                memo[index] <- memo[index] + memo[previous_row * MAX_PARTS + k]
            k <- k + 1
        n <- n + 1
    memo[bound * MAX_PARTS + bound - 1] - 1

export fn problem76(total: i64) -> i64 = problem76_impl
