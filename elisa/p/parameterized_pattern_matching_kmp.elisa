const MAX_TEXT: usize = 64
const MAX_PATTERN: usize = 16
const MAX_ALPHABET: usize = 16
const MAX_PARSEABLE_INPUT: usize = 84
const MAX_OUTPUT_BYTES: usize = 520

def store_word(value: i64, output: mutable view[u8], word: usize) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[word * 8 + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def pattern_pair_matches(pattern: i64&, previous: view[i64],
        previous_at: view[i64], current: usize, prefix_position: usize) -> bool:
    prior: i64 = previous[current]
    if prior < 0 or current.i64() - prior > prefix_position.i64():
        return previous_at[prefix_position] < 0
    distance: usize = current - prior.usize()
    return pattern[prefix_position] == pattern[prefix_position - distance]

def text_symbol_matches(text: i64&, text_position: usize,
        pattern_position: usize, previous: view[i64], last_text: view[i64]) -> bool:
    prior: i64 = previous[pattern_position]
    symbol: usize = text[text_position].usize()
    if prior < 0:
        return last_text[symbol] < (text_position - pattern_position).i64()
    distance: usize = pattern_position - prior.usize()
    return text[text_position] == text[text_position - distance]

def parameterized_pattern_matching_kmp_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_PARSEABLE_INPUT: return -1
    values: i64& = input
    n_value: i64 = values[0]
    m_value: i64 = values[1]
    alphabet_value: i64 = values[2]
    if n_value < 0 or n_value > MAX_TEXT.i64() or m_value < 1 or m_value > MAX_PATTERN.i64() or alphabet_value < 1 or alphabet_value > MAX_ALPHABET.i64(): return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    alphabet_size: i64 = alphabet_value
    if length != 3 + n + m: return -1
    index: mutable usize = 3
    while index < length:
        if values[index] < 0 or values[index] >= alphabet_size: return -1
        index <- index + 1
    text: i64& = &values[3]
    pattern: i64& = &values[3 + n]

    previous: mutable i64[MAX_PATTERN] = zeroed
    previous_at: mutable i64[MAX_PATTERN] = zeroed
    last_pattern: mutable i64[MAX_ALPHABET] = zeroed
    index <- 0
    while index < MAX_ALPHABET:
        last_pattern[index] <- -1
        index <- index + 1
    index <- 0
    while index < m:
        symbol: usize = pattern[index].usize()
        previous[index] <- last_pattern[symbol]
        previous_at[index] <- previous[index]
        last_pattern[symbol] <- index.i64()
        index <- index + 1

    failure: mutable usize[MAX_PATTERN] = zeroed
    current: mutable usize = 1
    while current < m:
        matched: mutable usize = failure[current - 1]
        while matched > 0 and not pattern_pair_matches(pattern,
                previous[0:MAX_PATTERN], previous_at[0:MAX_PATTERN], current, matched):
            matched <- failure[matched - 1]
        if pattern_pair_matches(pattern, previous[0:MAX_PATTERN],
                previous_at[0:MAX_PATTERN], current, matched): matched <- matched + 1
        failure[current] <- matched
        current <- current + 1

    last_text: mutable i64[MAX_ALPHABET] = zeroed
    index <- 0
    while index < MAX_ALPHABET:
        last_text[index] <- -1
        index <- index + 1
    matches: mutable i64[MAX_TEXT] = zeroed
    match_count: mutable usize = 0
    matched: mutable usize = 0
    if m <= n:
        text_position: mutable usize = 0
        while text_position < n:
            while true:
                if text_symbol_matches(text, text_position, matched,
                        previous[0:MAX_PATTERN], last_text[0:MAX_ALPHABET]):
                    matched <- matched + 1
                    if matched == m:
                        matches[match_count] <- (text_position + 1 - m).i64()
                        match_count <- match_count + 1
                        matched <- failure[m - 1]
                    break
                if matched == 0: break
                matched <- failure[matched - 1]
            last_text[text[text_position].usize()] <- text_position.i64()
            text_position <- text_position + 1

    output_bytes: usize = 8 * (match_count + 1)
    if output == null or capacity < output_bytes: return -2
    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    store_word(match_count.i64(), staged[0:MAX_OUTPUT_BYTES], 0)
    index <- 0
    while index < match_count:
        store_word(matches[index], staged[0:MAX_OUTPUT_BYTES], index + 1)
        index <- index + 1
    index <- 0
    while index < output_bytes:
        output[index] <- staged[index]
        index <- index + 1
    output_bytes.i64()

export fn parameterized_pattern_matching_kmp(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = parameterized_pattern_matching_kmp_impl
