# Evaluate bounded integer postfix expressions with a local operand stack.
def apply_postfix_operator(opcode: i64, left: i64, right: i64) -> i64:
    value: mutable i64 = -1000000001
    if opcode == 1:
        value <- left + right
    elif opcode == 2:
        value <- left - right
    elif opcode == 3:
        value <- left * right
    elif opcode == 4:
        if right == 0:
            return -1000000001
        magnitude_left: mutable i64 = left
        magnitude_right: mutable i64 = right
        if magnitude_left < 0:
            magnitude_left <- 0 - magnitude_left
        if magnitude_right < 0:
            magnitude_right <- 0 - magnitude_right
        quotient: i64 = magnitude_left / magnitude_right
        if (left < 0 and right >= 0) or (left >= 0 and right < 0):
            value <- 0 - quotient
        else:
            value <- quotient
    else:
        return -1000000001
    if value < -1000000000 or value > 1000000000:
        return -1000000001
    value

def postfix_evaluation_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 512 or length % 2 != 0:
        return -1000000001
    token_count: usize = length / 2
    result: i64 =
        while token < token_count |token: mutable usize = 0, values_stack: mutable i64[256] = zeroed, top: mutable usize = 0, result: mutable i64 = -1000000001| -> result:
            opcode: i64 = values[2 * token]
            operand: i64 = values[2 * token + 1]
            if opcode == 0:
                if operand < -1000000 or operand > 1000000:
                    break -1000000001
                values_stack[top] <- operand
                top <- top + 1
            else:
                if opcode < 1 or opcode > 4 or operand != 0 or top < 2:
                    break -1000000001
                right: i64 = values_stack[top - 1]
                left: i64 = values_stack[top - 2]
                top <- top - 2
                computed: i64 = apply_postfix_operator(opcode, left, right)
                if computed == -1000000001:
                    break -1000000001
                values_stack[top] <- computed
                top <- top + 1
            if token + 1 == token_count:
                if top != 1:
                    result <- -1000000001
                else:
                    result <- values_stack[0]
            token <- token + 1
    result

export fn postfix_evaluation(values: i64&, length: usize) -> i64 = postfix_evaluation_impl
