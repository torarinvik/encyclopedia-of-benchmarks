# Match the pinned Python reflection equations and isclose root selection.
extern sqrt(value: f64) -> f64
extern fabs(value: f64) -> f64
const INVALID_RESULT: f64 = -1.0e300
const MAX_REFLECTIONS: i64 = 10000

def is_close(left: f64, right: f64) -> bool:
    left_abs: f64 = if left < 0.0: -left else: left
    right_abs: f64 = if right < 0.0: -right else: right
    scale: f64 = if left_abs > right_abs: left_abs else: right_abs
    fabs(left - right) <= 1.0e-9 * scale

def problem144_impl(first_x_coord: f64, first_y_coord: f64) -> f64:
    if first_x_coord != first_x_coord or first_y_coord != first_y_coord or first_x_coord < 1.0e-5 or first_x_coord > 5.0 or first_y_coord < -10.0 or first_y_coord > 0.0:
        return INVALID_RESULT
    ellipse_residual: f64 = 4.0 * first_x_coord * first_x_coord + first_y_coord * first_y_coord - 100.0
    if fabs(ellipse_residual) > 1.0e-6:
        return INVALID_RESULT

    point_x: mutable f64 = first_x_coord
    point_y: mutable f64 = first_y_coord
    gradient: mutable f64 = (10.1 - point_y) / (0.0 - point_x)
    reflections: mutable i64 = 0
    while not (point_x >= -0.01 and point_x <= 0.01 and point_y > 0.0):
        if reflections >= MAX_REFLECTIONS:
            return INVALID_RESULT
        normal_gradient: f64 = point_y / 4.0 / point_x
        s2: f64 = 2.0 * normal_gradient / (1.0 + normal_gradient * normal_gradient)
        c2: f64 = (1.0 - normal_gradient * normal_gradient) / (1.0 + normal_gradient * normal_gradient)
        outgoing_gradient: f64 = (s2 - c2 * gradient) / (c2 + s2 * gradient)
        quadratic_term: f64 = outgoing_gradient * outgoing_gradient + 4.0
        line_offset: f64 = point_y - outgoing_gradient * point_x
        linear_term: f64 = 2.0 * outgoing_gradient * line_offset
        constant_term: f64 = line_offset * line_offset - 100.0
        root: f64 = sqrt(linear_term * linear_term - 4.0 * quadratic_term * constant_term)
        x_minus: f64 = (-linear_term - root) / (2.0 * quadratic_term)
        x_plus: f64 = (-linear_term + root) / (2.0 * quadratic_term)
        next_x: f64 = if is_close(x_plus, point_x): x_minus else: x_plus
        next_y: f64 = point_y + outgoing_gradient * (next_x - point_x)
        if next_x != next_x or next_y != next_y:
            return INVALID_RESULT
        point_x <- next_x
        point_y <- next_y
        gradient <- outgoing_gradient
        reflections <- reflections + 1
    reflections.f64()

export fn problem144(first_x_coord: f64, first_y_coord: f64) -> f64 = problem144_impl
