# Compare the linked-list value sequence from both ends without mutation.
def palindrome_linked_list_impl(values: i64&, length: usize) -> i64:
    if length > 100000:
        return -1
    index: mutable usize = 0
    while index < length:
        if values[index] < 0 or values[index] > 9:
            return -1
        index <- index + 1

    left: mutable usize = 0
    right: mutable usize = length
    while left < right:
        right <- right - 1
        if values[left] != values[right]:
            return 0
        left <- left + 1
    1

export fn palindrome_linked_list(values: i64&, length: usize) -> i64 = palindrome_linked_list_impl
