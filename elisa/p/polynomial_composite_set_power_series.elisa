const MODULUS: i64 = 998244353
const MAX_COEFFICIENTS: usize = 8
const MAX_N: usize = 4
const MAX_SIZE: usize = 16
const MAX_INPUT: usize = 27
const MAX_OUTPUT: usize = 128

def store_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def polynomial_composite_set_power_series_impl(
    input: view[i64], length: usize, output: mutable view[u8],
    capacity: usize, output_is_null: bool,
) -> i64:
    if length < 2 or length > MAX_INPUT: return -1
    count_value: i64 = input[0]
    n_value: i64 = input[1]
    if count_value < 0 or count_value > MAX_COEFFICIENTS.i64(): return -1
    if n_value < 0 or n_value > MAX_N.i64(): return -1
    count: usize = count_value.usize()
    n: usize = n_value.usize()
    size: usize = 1 << n
    if length != 2 + count + size: return -1
    for index in 0..<(count + size):
        coefficient: i64 = input[2 + index]
        if coefficient < 0 or coefficient >= MODULUS: return -1

    bytes: usize = 8 * size
    if output_is_null or capacity < bytes: return -2

    series: mutable [MAX_SIZE]i64 = [0; MAX_SIZE]
    result: mutable [MAX_SIZE]i64 = [0; MAX_SIZE]
    temporary: mutable [MAX_SIZE]i64 = [0; MAX_SIZE]
    for mask in 0..<size:
        series[mask] <- input[2 + count + mask]

    for degree in 1..<(count + 1):
        total_degree: usize = count - degree
        for mask in 0..<size:
            total: mutable i64 = 0
            subset: mutable usize = mask
            while true:
                total <- (total + result[subset] * series[mask ^ subset]) % MODULUS
                if subset == 0: break
                subset <- (subset - 1) & mask
            temporary[mask] <- total
        temporary[0] <- (temporary[0] + input[2 + total_degree]) % MODULUS
        for mask in 0..<size:
            result[mask] <- temporary[mask]

    for mask in 0..<size:
        store_le(result[mask], output, 8 * mask)
    return bytes.i64()

export fn polynomial_composite_set_power_series(
    input: i64&, length: usize, output: mutable u8&, capacity: usize,
) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return polynomial_composite_set_power_series_impl(
            input_view, length, scratch[0:1], capacity, true,
        )
    safe_capacity: mutable usize = capacity
    if safe_capacity > MAX_OUTPUT: safe_capacity <- MAX_OUTPUT
    output_view: mutable view[u8] = output[0:safe_capacity]
    polynomial_composite_set_power_series_impl(
        input_view, length, output_view, capacity, false,
    )
