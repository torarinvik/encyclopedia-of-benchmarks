# Sum numbers equal to the factorial sum of their decimal digits.
def digit_factorial(digit: i64) -> i64:
    if digit == 0 or digit == 1:
        return 1
    result: mutable i64 = 1
    factor: mutable i64 = 2
    while factor <= digit:
        result <- result * factor
        factor <- factor + 1
    result

def problem34_impl(ignored: i64) -> i64:
    if ignored != 0:
        return -1
    total: mutable i64 = 0
    number: mutable i64 = 3
    while number <= 2540160:
        remaining: mutable i64 = number
        digit_sum: mutable i64 = 0
        while remaining > 0:
            digit_sum <- digit_sum + digit_factorial(remaining % 10)
            remaining <- remaining / 10
        if digit_sum == number:
            total <- total + number
        number <- number + 1
    total

export fn problem34(ignored: i64) -> i64 = problem34_impl
