const MAX_INPUT_WORDS: usize = 2
const MAX_LIMIT: i64 = 100

def powerful_squarefree(value: i64) -> bool:
    divisor: mutable i64 = 2
    while divisor <= value / divisor:
        if value % (divisor * divisor) == 0: return false
        divisor <- divisor + 1
    true

def powerful_store_i64_le(value: i64, output: mutable u8&, offset: usize):
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def powerful_numbers_square_cube_enumeration_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_WORDS or length != 1: return -1
    input_view: i64& = input
    limit: i64 = input_view[0]
    if limit < 1 or limit > MAX_LIMIT: return -1

    values: mutable i64[14] = zeroed
    count: mutable usize = 0
    b: mutable i64 = 1
    while b * b * b <= limit:
        if powerful_squarefree(b):
            cube: i64 = b * b * b
            a: mutable i64 = 1
            while a * a * cube <= limit:
                values[count] <- a * a * cube
                count <- count + 1
                a <- a + 1
        b <- b + 1

    index: mutable usize = 1
    while index < count:
        value: i64 = values[index]
        position: mutable usize = index
        while position > 0 and values[position - 1] > value:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- value
        index <- index + 1

    output_bytes: usize = (count + 1) * 8
    if output == null or capacity < output_bytes: return -2
    output_view: mutable u8& = output
    powerful_store_i64_le(count.i64(), output_view, 0)
    index <- 0
    while index < count:
        powerful_store_i64_le(values[index], output_view, (index + 1) * 8)
        index <- index + 1
    output_bytes.i64()

export fn powerful_numbers_square_cube_enumeration(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = powerful_numbers_square_cube_enumeration_impl
