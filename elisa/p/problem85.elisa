# Search triangular-number products for the rectangle count nearest the target.
extern sqrt(value: f64) -> f64
extern floor(value: f64) -> f64
extern ceil(value: f64) -> f64

const MAX_TARGET: i64 = 2000000000

def triangle(side: i64) -> i64:
    side * (side + 1) / 2

def absolute_difference(left: i64, right: i64) -> i64:
    difference: i64 = left - right
    if difference < 0:
        -difference
    else:
        difference

def problem85_impl(target: i64) -> i64:
    if target < 0 or target > MAX_TARGET:
        return -1
    bound: i64 = ceil(sqrt((target * 2).f64()) * 1.1).i64()
    best_product: mutable i64 = 0
    area: mutable i64 = 0
    triangle_a: mutable i64 = 0
    a: mutable i64 = 1
    while a < bound:
        triangle_a <- triangle_a + a
        estimate: f64 = (-1.0 + sqrt(1.0 + 8.0 * target.f64() / triangle_a.f64())) / 2.0
        b_floor: i64 = floor(estimate).i64()
        b_ceil: i64 = ceil(estimate).i64()
        first_product: i64 = triangle_a * triangle(b_floor)
        second_product: i64 = triangle_a * triangle(b_ceil)
        if absolute_difference(target, first_product) < absolute_difference(target, best_product):
            best_product <- first_product
            area <- a * b_floor
        if absolute_difference(target, second_product) < absolute_difference(target, best_product):
            best_product <- second_product
            area <- a * b_ceil
        a <- a + 1
    area

export fn problem85(target: i64) -> i64 = problem85_impl
