# Count distinct powers by their maximal perfect-power root and exponent.
def problem29_impl(limit: i64) -> i64:
    if limit < 1 or limit > 100:
        return -1
    if limit == 1:
        return 0
    roots: mutable i64[101] = zeroed
    exponents: mutable i64[101] = zeroed
    seen: mutable bool[60701] = zeroed
    distinct: mutable i64 = 0
    for a in 2..<(limit + 1):
        roots[a.usize()] <- a
        exponents[a.usize()] <- 1
        for candidate_exponent in 2..<7:
            for candidate_root in 2..<(a + 1):
                power: mutable i64 = 1
                for _ in 0..<candidate_exponent.usize():
                    power <- power * candidate_root
                    if power > a:
                        break
                if power == a and candidate_exponent > exponents[a.usize()]:
                    roots[a.usize()] <- candidate_root
                    exponents[a.usize()] <- candidate_exponent
        for b in 2..(limit + 1):
            key: usize = (roots[a.usize()] * 601 + exponents[a.usize()] * b).usize()
            if not seen[key]:
                seen[key] <- true
                distinct <- distinct + 1
    distinct

export fn problem29(limit: i64) -> i64 = problem29_impl
