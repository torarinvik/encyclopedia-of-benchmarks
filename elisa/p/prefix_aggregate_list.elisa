const MAX_INITIAL_VALUES: usize = 64
const MAX_OPERATIONS: usize = 64
const MAX_LIVE_VALUES: usize = 128
const MAX_PARSEABLE_INPUT_LENGTH: usize = 260
const MAX_OUTPUT_BYTES: usize = 512
const MAX_VALUE: i64 = 1000000

def prefix_aggregate_list_store_i64(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255.u64()).u8()
        bits <- bits >> 8

def prefix_aggregate_list_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1

    initial_count_value: i64 = input[0]
    if initial_count_value < 1 or initial_count_value > MAX_INITIAL_VALUES.i64():
        return -1
    initial_count: usize = initial_count_value.usize()
    if length < initial_count + 2:
        return -1

    prefix: mutable i64[MAX_LIVE_VALUES] = zeroed
    index: mutable usize = 0
    while index < initial_count:
        value: i64 = input[1 + index]
        if value < -MAX_VALUE or value > MAX_VALUE:
            return -1
        prefix[index] <- value + (if index == 0: 0 else: prefix[index - 1])
        index <- index + 1

    operation_count_value: i64 = input[1 + initial_count]
    if operation_count_value < 0 or operation_count_value > MAX_OPERATIONS.i64():
        return -1
    operation_count: usize = operation_count_value.usize()
    live_count: mutable usize = initial_count
    cursor: mutable usize = initial_count + 2
    query_count: mutable usize = 0
    encoded: mutable u8[MAX_OUTPUT_BYTES] = zeroed

    operation_index: mutable usize = 0
    while operation_index < operation_count:
        if cursor >= length:
            return -1
        operation: i64 = input[cursor]
        cursor <- cursor + 1
        if operation == 0:
            if cursor >= length or live_count >= MAX_LIVE_VALUES:
                return -1
            value: i64 = input[cursor]
            cursor <- cursor + 1
            if value < -MAX_VALUE or value > MAX_VALUE:
                return -1
            prefix[live_count] <- prefix[live_count - 1] + value
            live_count <- live_count + 1
        else if operation == 1:
            if live_count <= 1:
                return -1
            live_count <- live_count - 1
        else if operation == 2:
            if cursor + 1 >= length:
                return -1
            range_from: i64 = input[cursor]
            range_to: i64 = input[cursor + 1]
            cursor <- cursor + 2
            if range_from < 1 or range_to < range_from or range_to > live_count.i64():
                return -1
            from_index: usize = range_from.usize()
            to_index: usize = range_to.usize()
            result: i64 = prefix[to_index - 1] - (if from_index == 1: 0 else: prefix[from_index - 2])
            prefix_aggregate_list_store_i64(result, encoded[0:MAX_OUTPUT_BYTES], 8 * query_count)
            query_count <- query_count + 1
        else:
            return -1
        operation_index <- operation_index + 1

    if cursor != length:
        return -1
    output_bytes: usize = query_count * 8
    if output == null or capacity < output_bytes:
        return -2
    index <- 0
    while index < output_bytes:
        output[index] <- encoded[index]
        index <- index + 1
    output_bytes.i64()

export fn prefix_aggregate_list(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = prefix_aggregate_list_impl
