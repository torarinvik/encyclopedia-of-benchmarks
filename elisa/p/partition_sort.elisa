# First-element-pivot quicksort using Hoare's partition scheme.
def partition_sort_partition(values: mutable i64&, low: usize, high: usize) -> usize:
    pivot: i64 = values[low]
    left: mutable usize = low
    right: mutable usize = high
    while true:
        while values[left] < pivot:
            left <- left + 1
        while values[right] > pivot:
            right <- right - 1
        if left >= right:
            return right
        temporary: i64 = values[left]
        values[left] <- values[right]
        values[right] <- temporary
        left <- left + 1
        right <- right - 1

# Inclusive low/high bounds match the source's partitionSort routine.
def partition_sort_range(values: mutable i64&, low: usize, high: usize) -> void:
    if low < high:
        split: usize = partition_sort_partition(values, low, high)
        partition_sort_range(values, low, split)
        partition_sort_range(values, split + 1, high)

def partition_sort_impl(values: mutable i64&, length: usize) -> void:
    if length > 1:
        partition_sort_range(values, 0, length - 1)

export fn partition_sort(values: mutable i64&, length: usize) -> void = partition_sort_impl
