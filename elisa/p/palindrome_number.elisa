# Reverse half the digits to avoid overflow.
def palindrome_number_impl(value: i64) -> i64:
    if value < 0 or value > 2147483647:
        return -1
    if value == 0:
        return 1
    if value % 10 == 0:
        return 0
    # A valid input has at most ten digits. Reversal stops after at most six.
    remaining: mutable u32 = value.u32()
    reversed_half: mutable u32 = 0
    while remaining > reversed_half:
        reversed_half <- reversed_half * 10 + remaining % 10
        remaining <- remaining / 10
    if remaining == reversed_half or remaining == reversed_half / 10:
        return 1
    0

export fn palindrome_number(value: i64) -> i64 = palindrome_number_impl
