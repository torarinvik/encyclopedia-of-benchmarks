def pell_number_impl(index: i64) -> i64:
    if index < 0 or index > 50:
        return -1
    if index == 0:
        return 0
    previous: mutable i64 = 0
    current: mutable i64 = 1
    i: mutable i64 = 2
    while i + 1 <= index:
        next: i64 = 2 * current + previous
        current <- 2 * next + current
        previous <- next
        i <- i + 2
    if i <= index:
        current <- 2 * current + previous
    current

export fn pell_number(index: i64) -> i64 = pell_number_impl
