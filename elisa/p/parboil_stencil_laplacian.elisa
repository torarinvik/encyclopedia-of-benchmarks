extern trunc(value: f64) -> f64

def parboil_stencil_laplacian_impl(input: f64&, length: usize,
                                   output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > 129: return -1
    nx_value: f64 = input[0]
    ny_value: f64 = input[1]
    nz_value: f64 = input[2]
    steps_value: f64 = input[3]
    if nx_value != nx_value or ny_value != ny_value or nz_value != nz_value or steps_value != steps_value: return -1
    if trunc(nx_value) != nx_value or trunc(ny_value) != ny_value or trunc(nz_value) != nz_value or trunc(steps_value) != steps_value: return -1
    if nx_value < 3.0 or nx_value > 5.0 or ny_value < 3.0 or ny_value > 5.0 or nz_value < 3.0 or nz_value > 5.0 or steps_value < 1.0 or steps_value > 4.0: return -1
    nx: usize = nx_value.usize()
    ny: usize = ny_value.usize()
    nz: usize = nz_value.usize()
    steps: usize = steps_value.usize()
    cells: usize = nx * ny * nz
    if length != 4 + cells: return -1
    for q in 0..<cells:
        value: f64 = input[4 + q]
        if value != value or value < -8.0 or value > 8.0: return -1
    if output.is_null() or capacity < cells: return -2

    a: mutable f32[125] = zeroed
    b: mutable f32[125] = zeroed
    staged: mutable f64[125] = zeroed
    for q in 0..<cells:
        a[q] <- input[4 + q].f32()
        b[q] <- a[q]
    c0: f32 = 1.0.f32() / 6.0.f32()
    c1: f32 = (1.0.f32() / 6.0.f32()) / 6.0.f32()
    for _ in 0..<steps:
        for i in 1..<(nx - 1):
            for j in 1..<(ny - 1):
                for k in 1..<(nz - 1):
                    q: usize = i + nx * (j + ny * k)
                    sum: mutable f32 = a[q + nx * ny] + a[q - nx * ny]
                    sum <- sum + a[q + nx]
                    sum <- sum + a[q - nx]
                    sum <- sum + a[q + 1]
                    sum <- sum + a[q - 1]
                    neighbor_term: f32 = sum * c1
                    center_term: f32 = a[q] * c0
                    b[q] <- neighbor_term - center_term
        for q in 0..<cells:
            temp: f32 = a[q]
            a[q] <- b[q]
            b[q] <- temp
    for q in 0..<cells: staged[q] <- a[q].f64()
    for q in 0..<cells: output[q] <- staged[q]
    cells.i64()

export fn parboil_stencil_laplacian(input: f64&, length: usize,
                                    output: mutable f64&, capacity: usize) -> i64 = parboil_stencil_laplacian_impl
