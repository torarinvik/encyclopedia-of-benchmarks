const TAYLOR_MODULUS: i64 = 998_244_353
const TAYLOR_MAX_N: usize = 64
const TAYLOR_MAX_INPUT: usize = 66
const TAYLOR_MAX_OUTPUT_BYTES: usize = 512

def polynomial_taylor_shift_store_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def polynomial_taylor_shift_impl(input: view[i64], length: usize,
    output: mutable view[u8], capacity: usize, output_is_null: bool) -> i64:
    if length < 3 or length > TAYLOR_MAX_INPUT: return -1
    n_value: i64 = input[0]
    shift: i64 = input[1]
    if n_value < 1 or n_value > TAYLOR_MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != n + 2 or shift < 0 or shift >= TAYLOR_MODULUS: return -1
    for i in 0..<n:
        if input[i + 2] < 0 or input[i + 2] >= TAYLOR_MODULUS: return -1

    output_bytes: usize = 8 * n
    if output_is_null or capacity < output_bytes: return -2
    shifted: mutable i64[TAYLOR_MAX_N] = zeroed
    processed: mutable usize = 0
    source: mutable usize = n
    while source > 0:
        source <- source - 1
        degree: mutable usize = processed
        while degree > 0:
            shifted[degree] <- (shifted[degree] * shift + shifted[degree - 1]) % TAYLOR_MODULUS
            degree <- degree - 1
        shifted[0] <- (shifted[0] * shift + input[source + 2]) % TAYLOR_MODULUS
        processed <- processed + 1
    for i in 0..<n: polynomial_taylor_shift_store_le(shifted[i], output, 8 * i)
    output_bytes.i64()

export fn polynomial_taylor_shift(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > TAYLOR_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return polynomial_taylor_shift_impl(input_view, length, scratch[0:1], 0, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > TAYLOR_MAX_OUTPUT_BYTES: safe_capacity <- TAYLOR_MAX_OUTPUT_BYTES
    output_view: mutable view[u8] = output[0:safe_capacity]
    polynomial_taylor_shift_impl(input_view, length, output_view, capacity, false)
