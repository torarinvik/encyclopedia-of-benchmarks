# Clean-room bounded FreeBench pcompress2 compression pipeline.
const PC_MAX_LENGTH: usize = 32
const PC_MAX_OUTPUT: usize = 8 + PC_MAX_LENGTH * 16
const PC_SYMBOLS: usize = 257

def pc_rotation_less(input: view[u8], n: usize, left: usize, right: usize) -> bool:
    offset: usize = 0
    while offset < n:
        a: u8 = input[(left + offset) % n]
        b: u8 = input[(right + offset) % n]
        if a != b: return a < b
        offset <- offset + 1
    left < right

def pc_output_bit(output: mutable view[u8], outpos: mutable usize&, buffer: mutable u8&, bits_to_go: mutable usize&, bit: bool) -> void:
    buffer <- buffer >> 1
    if bit: buffer <- buffer | 0x80.u8()
    bits_to_go <- bits_to_go - 1
    if bits_to_go == 0:
        output[outpos] <- buffer
        outpos <- outpos + 1
        bits_to_go <- 8

def pc_bit_plus_follow(output: mutable view[u8], outpos: mutable usize&, buffer: mutable u8&, bits_to_go: mutable usize&, follow: mutable usize&, bit: bool) -> void:
    pc_output_bit(output, outpos, buffer, bits_to_go, bit)
    while follow > 0:
        pc_output_bit(output, outpos, buffer, bits_to_go, not bit)
        follow <- follow - 1

def pc_encode_symbol(symbol: usize, cum: view[i64], low: mutable u32&, high: mutable u32&, follow: mutable usize&, output: mutable view[u8], outpos: mutable usize&, buffer: mutable u8&, bits_to_go: mutable usize&) -> void:
    span: u64 = (high - low).u64() + 1
    old_low: u32 = low
    high <- old_low + (span * cum[symbol - 1].u64() / cum[0].u64()).u32() - 1
    low <- old_low + (span * cum[symbol].u64() / cum[0].u64()).u32()
    done: mutable bool = false
    while not done:
        if high < 32768.u32():
            pc_bit_plus_follow(output, outpos, buffer, bits_to_go, follow, false)
        else if low >= 32768.u32():
            pc_bit_plus_follow(output, outpos, buffer, bits_to_go, follow, true)
            low <- low - 32768.u32()
            high <- high - 32768.u32()
        else if low >= 16384.u32() and high < 49152.u32():
            follow <- follow + 1
            low <- low - 16384.u32()
            high <- high - 16384.u32()
        else:
            done <- true
        if not done:
            low <- low * 2.u32()
            high <- high * 2.u32() + 1.u32()

def pc_update_model(symbol: usize, char_to_index: mutable view[usize], index_to_char: mutable view[u8], freq: mutable view[i64], cum: mutable view[i64]) -> void:
    if cum[0] == 16383:
        total: mutable i64 = 0
        i: mutable i64 = PC_SYMBOLS.i64()
        while i >= 0:
            freq[i.usize()] <- (freq[i.usize()] + 1) / 2
            cum[i.usize()] <- total
            total <- total + freq[i.usize()]
            i <- i - 1
    i: mutable usize = symbol
    while freq[i] == freq[i - 1]: i <- i - 1
    if i < symbol:
        old_i: u8 = index_to_char[i]
        old_symbol: u8 = index_to_char[symbol]
        index_to_char[i] <- old_symbol
        index_to_char[symbol] <- old_i
        char_to_index[old_i.usize()] <- symbol
        char_to_index[old_symbol.usize()] <- i
    freq[i] <- freq[i] + 1
    while i > 0:
        i <- i - 1
        cum[i] <- cum[i] + 1

def pc_arithmetic_encode(data: view[u8], count: usize, encoded: mutable view[u8]) -> usize:
    char_to_index: mutable usize[256] = zeroed
    index_to_char: mutable u8[258] = zeroed
    freq: mutable i64[258] = zeroed
    cum: mutable i64[258] = zeroed
    i: mutable usize = 0
    while i < 256:
        char_to_index[i] <- i + 1
        index_to_char[i + 1] <- i.u8()
        i <- i + 1
    i <- 0
    while i <= PC_SYMBOLS:
        freq[i] <- 1
        cum[i] <- (PC_SYMBOLS.i64() - i.i64())
        i <- i + 1
    freq[0] <- 0
    outpos: mutable usize = 0
    buffer: mutable u8 = 0
    bits_to_go: mutable usize = 8
    low: mutable u32 = 0
    high: mutable u32 = 65535
    follow: mutable usize = 0
    i <- 0
    while i < count:
        symbol: usize = char_to_index[data[i].usize()]
        pc_encode_symbol(symbol, cum[0:258], low, high, follow, encoded, outpos, buffer, bits_to_go)
        pc_update_model(symbol, char_to_index[0:256], index_to_char[0:258], freq[0:258], cum[0:258])
        i <- i + 1
    pc_encode_symbol(257, cum[0:258], low, high, follow, encoded, outpos, buffer, bits_to_go)
    follow <- follow + 1
    pc_bit_plus_follow(encoded, outpos, buffer, bits_to_go, follow, low >= 16384.u32())
    encoded[outpos] <- (buffer >> bits_to_go.u8()).u8()
    outpos <- outpos + 1
    outpos

def pc_compress_bounded(input: view[u8], n: usize, output: mutable view[u8]) -> usize:
    order: mutable usize[PC_MAX_LENGTH] = zeroed
    last: mutable u8[PC_MAX_LENGTH] = zeroed
    rle: mutable u8[PC_MAX_LENGTH * 2] = zeroed
    i: mutable usize = 0
    while i < n:
        order[i] <- i
        i <- i + 1
    i <- 1
    while i < n:
        key: usize = order[i]
        j: mutable usize = i
        while j > 0 and pc_rotation_less(input, n, key, order[j - 1]):
            order[j] <- order[j - 1]
            j <- j - 1
        order[j] <- key
        i <- i + 1
    primary: mutable usize = 0
    i <- 0
    while i < n:
        if order[i] == 0: primary <- i
        last[i] <- input[(order[i] + n - 1) % n]
        i <- i + 1
    rle_length: mutable usize = 0
    i <- 0
    while i < n:
        count: mutable usize = 1
        value: u8 = last[i]
        while i + count < n and last[i + count] == value and count < 127: count <- count + 1
        if count == 1:
            while i + count < n and last[i + count - 1] != last[i + count] and (i + count + 1 == n or last[i + count] != last[i + count + 1]):
                count <- count + 1
            rle[rle_length] <- (count & 0x7f).u8()
            rle_length <- rle_length + 1
            j: usize = 0
            while j < count:
                rle[rle_length] <- last[i + j]
                rle_length <- rle_length + 1
                j <- j + 1
            i <- i + count
        else:
            rle[rle_length] <- (count | 0x80).u8()
            rle_length <- rle_length + 1
            rle[rle_length] <- value
            rle_length <- rle_length + 1
            i <- i + count
    output[0] <- n.u8()
    output[1] <- 0
    output[2] <- 0
    output[3] <- 0
    output[4] <- primary.u8()
    output[5] <- 0
    output[6] <- 0
    output[7] <- 0
    8 + pc_arithmetic_encode(rle[0:rle_length], rle_length, output[8:PC_MAX_OUTPUT])

def pcompress2_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values.is_null() or length < 2 or values[0] < 1 or values[0] > PC_MAX_LENGTH.i64(): return -1
    n: usize = values[0].usize()
    if length != n + 1: return -1
    input: mutable u8[PC_MAX_LENGTH] = zeroed
    i: usize = 0
    while i < n:
        value: i64 = values[i + 1]
        if value < 0 or value > 255: return -1
        input[i] <- value.u8()
        i <- i + 1
    encoded: mutable u8[PC_MAX_OUTPUT] = zeroed
    encoded_length: usize = pc_compress_bounded(input[0:n], n, encoded[0:PC_MAX_OUTPUT])
    if output.is_null() or capacity < encoded_length: return -2
    i <- 0
    while i < encoded_length:
        output[i] <- encoded[i]
        i <- i + 1
    encoded_length.i64()

export fn pcompress2(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = pcompress2_impl
