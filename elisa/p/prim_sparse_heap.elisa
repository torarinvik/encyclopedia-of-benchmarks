# Sparse Prim with an indexed decrease-key frontier; only the ABI boundary is pointer-backed.
def prim_sparse_heap_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 2 or length > 12290:
        return -2
    input: view[i64] = values[0:length]
    if input[0] < 0 or input[0] > 64 or input[1] < 0 or input[1] > 4096:
        return -2
    vertices: usize = input[0].usize()
    edge_count: usize = input[1].usize()
    if length != 2 + 3 * edge_count or (vertices == 0 and edge_count != 0):
        return -2
    if vertices == 0:
        return 0

    edge: mutable usize = 0
    while edge < edge_count:
        origin: i64 = input[2 + 3 * edge]
        destination: i64 = input[3 + 3 * edge]
        weight: i64 = input[4 + 3 * edge]
        if origin < 0 or destination < 0 or origin >= vertices.i64() or destination >= vertices.i64():
            return -2
        if weight < 0 or weight > 2147483647:
            return -2
        edge <- edge + 1

    head: mutable usize[64] = zeroed
    next: mutable usize[8192] = zeroed
    neighbor: mutable usize[8192] = zeroed
    arc_weight: mutable i64[8192] = zeroed
    vertex: mutable usize = 0
    while vertex < vertices:
        head[vertex] <- 8192
        vertex <- vertex + 1
    arc_count: mutable usize = 0
    edge <- 0
    while edge < edge_count:
        origin: usize = input[2 + 3 * edge].usize()
        destination: usize = input[3 + 3 * edge].usize()
        weight: i64 = input[4 + 3 * edge]
        if origin != destination:
            neighbor[arc_count] <- destination
            arc_weight[arc_count] <- weight
            next[arc_count] <- head[origin]
            head[origin] <- arc_count
            arc_count <- arc_count + 1
            neighbor[arc_count] <- origin
            arc_weight[arc_count] <- weight
            next[arc_count] <- head[destination]
            head[destination] <- arc_count
            arc_count <- arc_count + 1
        edge <- edge + 1

    best: mutable i64[64] = zeroed
    has_best: mutable bool[64] = zeroed
    selected: mutable bool[64] = zeroed
    heap: mutable usize[64] = zeroed
    position: mutable usize[64] = zeroed
    vertex <- 0
    while vertex < vertices:
        position[vertex] <- 64
        vertex <- vertex + 1
    heap[0] <- 0
    position[0] <- 0
    has_best[0] <- true
    heap_count: mutable usize = 1
    selected_count: mutable usize = 0
    total: mutable i64 = 0

    while heap_count > 0:
        origin: usize = heap[0]
        position[origin] <- 64
        heap_count <- heap_count - 1
        if heap_count > 0:
            last_vertex: usize = heap[heap_count]
            at: mutable usize = 0
            while 2 * at + 1 < heap_count:
                child: mutable usize = 2 * at + 1
                if child + 1 < heap_count and (best[heap[child + 1]] < best[heap[child]] or (best[heap[child + 1]] == best[heap[child]] and heap[child + 1] < heap[child])):
                    child <- child + 1
                if best[heap[child]] > best[last_vertex] or (best[heap[child]] == best[last_vertex] and heap[child] >= last_vertex):
                    break
                heap[at] <- heap[child]
                position[heap[at]] <- at
                at <- child
            heap[at] <- last_vertex
            position[last_vertex] <- at
        selected[origin] <- true
        selected_count <- selected_count + 1
        total <- total + best[origin]

        arc: mutable usize = head[origin]
        while arc != 8192:
            destination: usize = neighbor[arc]
            weight: i64 = arc_weight[arc]
            if not selected[destination] and (not has_best[destination] or weight < best[destination]):
                best[destination] <- weight
                has_best[destination] <- true
                if position[destination] == 64:
                    heap[heap_count] <- destination
                    position[destination] <- heap_count
                    heap_count <- heap_count + 1
                at: mutable usize = position[destination]
                while at > 0:
                    parent: usize = (at - 1) / 2
                    current_vertex: usize = heap[at]
                    parent_vertex: usize = heap[parent]
                    if best[current_vertex] > best[parent_vertex] or (best[current_vertex] == best[parent_vertex] and current_vertex >= parent_vertex):
                        break
                    heap[at] <- parent_vertex
                    position[parent_vertex] <- at
                    at <- parent
                heap[at] <- destination
                position[destination] <- at
            arc <- next[arc]

    return total if selected_count == vertices else -1

export fn prim_sparse_heap(values: i64&, length: usize) -> i64 = prim_sparse_heap_impl
