@intrinsic("llvm.ctpop.i64")
extern population_count(value: u64) -> u64

# Return the parity of the set-bit count.
def parity_impl(number: i64) -> i64:
    # Arithmetic right shift yields the required -1 for negative inputs.
    ((population_count(number.u64()) & 1).i64() | (number >> 63))

export fn parity(number: i64) -> i64 = parity_impl
