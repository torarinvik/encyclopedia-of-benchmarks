# Return the parity of the set-bit count using Kernighan's bit clearing.
def parity_impl(input: i64) -> i64:
    if input < 0:
        return -1
    number: mutable i64 = input
    result: mutable i64 = 0
    while number != 0:
        result <- result ^ 1
        number <- number & (number - 1)
    result

export fn parity(number: i64) -> i64 = parity_impl
