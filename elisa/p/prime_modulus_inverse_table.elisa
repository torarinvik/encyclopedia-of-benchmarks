const INVERSE_TABLE_MODULUS: i64 = 1000000007

def prime_modulus_inverse_table_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 34:
        return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > 32:
        return -1
    count: usize = count_value.usize()
    if length != count + 1:
        return -1
    maximum: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        operand: i64 = input[index + 1]
        if operand < 1 or operand > 256:
            return -1
        if operand.usize() > maximum:
            maximum <- operand.usize()
        index <- index + 1
    if count == 0:
        return 0
    output_length: usize = 4 * count
    if output.is_null() or capacity < output_length:
        return -2
    inverse: mutable i64[257]
    inverse[0] <- 0
    inverse[1] <- 1
    value: mutable usize = 2
    while value <= maximum:
        v: i64 = value.i64()
        inverse[value] <- INVERSE_TABLE_MODULUS - (INVERSE_TABLE_MODULUS / v) * inverse[(INVERSE_TABLE_MODULUS % v).usize()] % INVERSE_TABLE_MODULUS
        value <- value + 1
    index <- 0
    while index < count:
        result: i64 = inverse[input[index + 1].usize()]
        offset: usize = 4 * index
        output[offset] <- (result % 256).u8()
        output[offset + 1] <- ((result / 256) % 256).u8()
        output[offset + 2] <- ((result / 65536) % 256).u8()
        output[offset + 3] <- (result / 16777216).u8()
        index <- index + 1
    output_length.i64()

export fn prime_modulus_inverse_table(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = prime_modulus_inverse_table_impl
