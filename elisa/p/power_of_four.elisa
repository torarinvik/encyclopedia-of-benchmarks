# The even-position mask also excludes zero and the sign bit.
def power_of_four_impl(value: i64) -> i64:
    if value < -2147483648 or value > 2147483647:
        return -1
    bits: u32 = value.u32()
    return 1 if (bits & (bits - 1)) == 0 and (bits & 0x55555555) != 0 else 0

export fn power_of_four(value: i64) -> i64 = power_of_four_impl
