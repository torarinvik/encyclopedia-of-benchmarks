def gapbs_pagerank_pull_gs_impl(input: i64&, input_length: usize) -> i64:
    if input.is_null() or input_length < 6 or input_length > 66: return -1
    n_value: i64 = input[0]
    iterations_value: i64 = input[1]
    if n_value < 2 or n_value > 8 or iterations_value < 0 or iterations_value > 20: return -1
    n: usize = n_value.usize()
    iterations: usize = iterations_value.usize()
    if input_length != 2 + n * n: return -1
    matrix: mutable u8[64] = zeroed
    outdegree: mutable usize[8] = zeroed
    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            value: i64 = input[2 + row * n + column]
            if (value != 0 and value != 1) or (row == column and value != 0): return -1
            matrix[row * n + column] <- value.u8()
            outdegree[row] <- outdegree[row] + value.usize()
            column <- column + 1
        if outdegree[row] == 0: return -1
        row <- row + 1
    damping: f32 = 0.85
    init_score: f32 = 1.0 / n.f32()
    base_score: f32 = (1.0 - damping) / n.f32()
    scores: mutable f32[8] = zeroed
    outgoing: mutable f32[8] = zeroed
    row <- 0
    while row < n:
        scores[row] <- init_score
        outgoing[row] <- init_score / outdegree[row].f32()
        row <- row + 1
    iteration: mutable usize = 0
    while iteration < iterations:
        target: mutable usize = 0
        while target < n:
            incoming: mutable f32 = 0.0
            source: mutable usize = 0
            while source < n:
                if matrix[source * n + target] != 0: incoming <- incoming + outgoing[source]
                source <- source + 1
            scores[target] <- base_score + damping * incoming
            outgoing[target] <- scores[target] / outdegree[target].f32()
            target <- target + 1
        iteration <- iteration + 1
    weighted: mutable f64 = 0.0
    row <- 0
    while row < n:
        weighted <- weighted + (row + 1).f64() * scores[row].f64()
        row <- row + 1
    return (weighted * 100.0 + 0.5).i64()

export fn gapbs_pagerank_pull_gs(input: i64&, input_length: usize) -> i64 = gapbs_pagerank_pull_gs_impl
