export fn palindrome_singly_linked_list(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > 65 or input[0] < 0 or input[0] > 64.i64() or length != input[0].usize() + 1: return -1
    size: usize = input[0].usize()
    i: mutable usize = 1
    while i < length:
        if input[i] < -2147483648 or input[i] > 2147483647: return -1
        i <- i + 1
    slow: mutable usize = 0
    fast: mutable usize = 0
    while fast + 1 < size:
        slow <- slow + 1
        fast <- fast + 2
    suffix: usize = size - slow
    i <- 0
    while i < suffix:
        if input[i + 1] != input[size - i]: return 0
        i <- i + 1
    return 1

