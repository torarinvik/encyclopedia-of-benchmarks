const INVALID_RESULT: f64 = -1.0e300
const MIN_PROPORTION: f64 = 1.0e-5
const MAX_PROPORTION: f64 = 1.0
const MAX_PARTITIONS: i64 = 5000000

def is_power_of_two(input_value: i64) -> bool:
    if input_value < 1:
        return false
    value: mutable i64 = input_value
    while value % 2 == 0:
        value <- value / 2
    value == 1

def problem207_impl(max_proportion: f64) -> f64:
    if max_proportion != max_proportion or max_proportion < MIN_PROPORTION or max_proportion > MAX_PROPORTION:
        return INVALID_RESULT
    partitions: mutable i64 = 0
    perfect_partitions: mutable i64 = 0
    while partitions < MAX_PARTITIONS:
        partitions <- partitions + 1
        candidate: i64 = partitions * (partitions + 1)
        if is_power_of_two(partitions + 1):
            perfect_partitions <- perfect_partitions + 1
        if perfect_partitions.f64() / partitions.f64() < max_proportion:
            return candidate.f64()
    INVALID_RESULT

export fn problem207(max_proportion: f64) -> f64 = problem207_impl
