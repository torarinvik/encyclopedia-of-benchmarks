# Check whether a root-to-leaf path has the requested sum.
const MAX_NODES: usize = 63

def path_sum_has(input: view[i64], node: usize, sum: i64, target: i64) -> bool:
    base: usize = 2 + 3 * node
    next_sum: i64 = sum + input[base]
    left: i64 = input[base + 1]
    right: i64 = input[base + 2]
    if left == -1 and right == -1:
        return next_sum == target
    (left != -1 and path_sum_has(input, left.usize(), next_sum, target)) or (right != -1 and path_sum_has(input, right.usize(), next_sum, target))

def path_sum_impl(input: i64&, length: usize) -> i64:
    if length < 2 or input[1] < 0 or input[1] > 63:
        return -1
    count: usize = input[1].usize()
    if length != 2 + 3 * count:
        return -1
    if count == 0:
        return 0
    index: mutable usize = 0
    while index < count:
        base: usize = 2 + 3 * index
        if input[base] < -2147483648 or input[base] > 2147483647:
            return -1
        if input[base + 1] < -1 or input[base + 1] >= count.i64() or input[base + 2] < -1 or input[base + 2] >= count.i64():
            return -1
        index <- index + 1
    seen: mutable bool[63] = zeroed
    node_stack: mutable usize[63] = zeroed
    top: mutable usize = 1
    visited: mutable usize = 0
    node_stack[0] <- 0
    while top > 0:
        top <- top - 1
        node: usize = node_stack[top]
        if seen[node]:
            return -1
        seen[node] <- true
        visited <- visited + 1
        base: usize = 2 + 3 * node
        left: i64 = input[base + 1]
        right: i64 = input[base + 2]
        if left != -1:
            node_stack[top] <- left.usize()
            top <- top + 1
        if right != -1:
            node_stack[top] <- right.usize()
            top <- top + 1
    if visited != count:
        return -1
    if path_sum_has(input[0:length], 0, 0, input[0]):
        return 1
    0

export fn path_sum(input: i64&, length: usize) -> i64 = path_sum_impl
