const PLH_MAX_OPERATIONS: usize = 64
const PLH_MAX_INPUT_LENGTH: usize = 193
const PLH_MAX_NODES: i64 = 1024
const PLH_MAX_HEAP_SIZE: i64 = 128
const PLH_EMPTY_RANK: i64 = 20001

def plh_allocate(keys: mutable view[i64], left: mutable view[i64], right: mutable view[i64],
                 npl: mutable view[i64], used: mutable view[i64], key: i64,
                 left_child: i64, right_child: i64, null_path_length: i64) -> i64:
    if used[0] >= PLH_MAX_NODES:
        return -1
    node: i64 = used[0]
    used[0] <- used[0] + 1
    keys[node.usize()] <- key
    left[node.usize()] <- left_child
    right[node.usize()] <- right_child
    npl[node.usize()] <- null_path_length
    node

def plh_meld(keys: mutable view[i64], left: mutable view[i64], right: mutable view[i64],
             npl: mutable view[i64], used: mutable view[i64], left_root_input: i64,
             right_root_input: i64) -> i64:
    if left_root_input < 0 or right_root_input < 0:
        return -1
    if left_root_input == 0:
        return right_root_input
    if right_root_input == 0:
        return left_root_input
    left_root: mutable i64 = left_root_input
    right_root: mutable i64 = right_root_input
    if keys[left_root.usize()] > keys[right_root.usize()]:
        temporary: i64 = left_root
        left_root <- right_root
        right_root <- temporary

    winner_key: i64 = keys[left_root.usize()]
    winner_left: i64 = left[left_root.usize()]
    winner_right: i64 = right[left_root.usize()]
    winner_npl: i64 = npl[left_root.usize()]
    copy: i64 = plh_allocate(keys, left, right, npl, used, winner_key,
                             winner_left, winner_right, winner_npl)
    if copy < 0:
        return -1
    merged_right: i64 = plh_meld(keys, left, right, npl, used, winner_right, right_root)
    if merged_right < 0:
        return -1
    right[copy.usize()] <- merged_right
    left_index: usize = left[copy.usize()].usize()
    right_index: usize = right[copy.usize()].usize()
    if npl[left_index] < npl[right_index]:
        temporary: i64 = left[copy.usize()]
        left[copy.usize()] <- right[copy.usize()]
        right[copy.usize()] <- temporary
    npl[copy.usize()] <- npl[right[copy.usize()].usize()] + 1
    copy

def persistent_leftist_heap_impl(input: view[i64], length: usize) -> i64:
    if length < 1 or length > PLH_MAX_INPUT_LENGTH:
        return -1
    raw_operations: i64 = input[0]
    if raw_operations < 0 or raw_operations > PLH_MAX_OPERATIONS.i64():
        return -1
    operation_count: usize = raw_operations.usize()

    keys: mutable i64[1024] = zeroed
    left: mutable i64[1024] = zeroed
    right: mutable i64[1024] = zeroed
    npl: mutable i64[1024] = zeroed
    npl[0] <- -1
    used: mutable i64[1] = [1]
    roots: mutable i64[65] = zeroed
    sizes: mutable i64[65] = zeroed
    observation_sum: mutable i64 = 0
    observation_xor: mutable i64 = 0
    cursor: mutable usize = 1
    operation_index: mutable usize = 0

    while operation_index < operation_count:
        if cursor >= length:
            return -1
        operation: i64 = input[cursor]
        cursor <- cursor + 1
        first: mutable i64 = 0
        second: mutable i64 = 0
        if operation == 0 or operation == 1:
            if length - cursor < 2:
                return -1
            first <- input[cursor]
            second <- input[cursor + 1]
            cursor <- cursor + 2
        else if operation == 2 or operation == 3:
            if length - cursor < 1:
                return -1
            first <- input[cursor]
            cursor <- cursor + 1
        else:
            return -1

        new_root: mutable i64 = 0
        new_size: mutable i64 = 0
        if operation == 0:
            if first < 0 or first > operation_index.i64() or second < -10000 or second > 10000:
                return -1
            base: usize = first.usize()
            if sizes[base] >= PLH_MAX_HEAP_SIZE:
                return -1
            singleton: i64 = plh_allocate(keys[0:1024], left[0:1024], right[0:1024],
                                          npl[0:1024], used[0:1], second, 0, 0, 0)
            if singleton < 0:
                return -1
            new_root <- plh_meld(keys[0:1024], left[0:1024], right[0:1024],
                                 npl[0:1024], used[0:1], roots[base], singleton)
            if new_root < 0:
                return -1
            new_size <- sizes[base] + 1
        else if operation == 1:
            if first < 0 or first > operation_index.i64() or second < 0 or second > operation_index.i64():
                return -1
            left_version: usize = first.usize()
            right_version: usize = second.usize()
            new_size <- sizes[left_version] + sizes[right_version]
            if new_size > PLH_MAX_HEAP_SIZE:
                return -1
            new_root <- plh_meld(keys[0:1024], left[0:1024], right[0:1024],
                                 npl[0:1024], used[0:1], roots[left_version], roots[right_version])
            if new_root < 0:
                return -1
        else:
            if first < 0 or first > operation_index.i64():
                return -1
            version: usize = first.usize()
            root: usize = roots[version].usize()
            rank: i64 = PLH_EMPTY_RANK
            if root != 0:
                rank <- keys[root] + 10000
            observation_sum <- observation_sum + rank
            observation_xor <- observation_xor ^ rank
            if operation == 3:
                new_root <- roots[version]
                new_size <- sizes[version]
            else if root != 0:
                new_root <- plh_meld(keys[0:1024], left[0:1024], right[0:1024],
                                     npl[0:1024], used[0:1], left[root], right[root])
                if new_root < 0:
                    return -1
                new_size <- sizes[version] - 1

        if new_size > PLH_MAX_HEAP_SIZE:
            return -1
        roots[operation_index + 1] <- new_root
        sizes[operation_index + 1] <- new_size
        operation_index <- operation_index + 1

    if cursor != length:
        return -1
    (observation_sum << 15) | observation_xor

export fn persistent_leftist_heap(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > PLH_MAX_INPUT_LENGTH:
        return -1
    input_view: view[i64] = input[0:length]
    persistent_leftist_heap_impl(input_view, length)
