def prolangs_c_gnugo_liberty_count_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4 or length > 726: return -1
    row: i64 = input[0]
    col: i64 = input[1]
    color: i64 = input[2]
    count: i64 = input[3]
    if row < 0 or row >= 19 or col < 0 or col >= 19 or (color != 1 and color != 2) or count < 0 or count > 361: return -1
    if length != 4 + 2 * count.usize(): return -1
    board: mutable u8[361] = zeroed
    seen: mutable bool[361] = zeroed
    liberties: mutable bool[361] = zeroed
    k: mutable usize = 0
    while k < count.usize():
        at: i64 = input[4 + 2 * k]
        stone: i64 = input[5 + 2 * k]
        if at < 0 or at >= 361 or (stone != 1 and stone != 2) or board[at.usize()] != 0: return -1
        board[at.usize()] <- stone.u8()
        k <- k + 1
    start: usize = (row * 19 + col).usize()
    if board[start] != color.u8(): return -1
    stack: mutable usize[361] = zeroed
    top: mutable usize = 1
    total: mutable i64 = 0
    stack[0] <- start
    seen[start] <- true
    while top > 0:
        top <- top - 1
        at: usize = stack[top]
        r: usize = at / 19
        c: usize = at % 19
        neighbors: mutable usize[4] = zeroed
        n: mutable usize = 0
        if r > 0: neighbors[n] <- at - 19; n <- n + 1
        if r < 18: neighbors[n] <- at + 19; n <- n + 1
        if c > 0: neighbors[n] <- at - 1; n <- n + 1
        if c < 18: neighbors[n] <- at + 1; n <- n + 1
        j: mutable usize = 0
        while j < n:
            next: usize = neighbors[j]
            if board[next] == 0:
                if not liberties[next]:
                    liberties[next] <- true
                    total <- total + 1
            else if board[next] == color.u8() and not seen[next]:
                seen[next] <- true
                stack[top] <- next
                top <- top + 1
            j <- j + 1
    total

export fn prolangs_c_gnugo_liberty_count(input: i64&, length: usize) -> i64 = prolangs_c_gnugo_liberty_count_impl
