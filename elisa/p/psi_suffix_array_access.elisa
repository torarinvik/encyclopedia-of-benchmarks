def psi_access_put_u64(output: mutable u8&, word: usize, value: u64) -> void:
    for byte in 0..<8:
        output[word * 8 + byte] <- (value >> (byte * 8)).u8()

def psi_suffix_array_access_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 5 or length > 67:
        return -1
    n0: i64 = input[0]
    query0: i64 = input[1]
    stride0: i64 = input[2]
    if n0 < 1 or n0 > 32 or query0 < 0 or query0 >= n0 or stride0 < 1 or stride0 > n0 or length != (3 + 2 * n0).usize():
        return -1
    n: usize = n0.usize()
    query: usize = query0.usize()
    stride: usize = stride0.usize()
    destinations: mutable bool[32] = zeroed
    visited: mutable bool[32] = zeroed
    for i in 0..<n:
        next: i64 = input[3 + i]
        sample: i64 = input[3 + n + i]
        if next < 0 or next.usize() >= n or destinations[next.usize()] or sample < 0 or sample > n0:
            return -1
        destinations[next.usize()] <- true
    anchor: mutable usize = n
    for i in 0..<n:
        if input[3 + n + i] != 0:
            anchor <- i
            break
    if anchor == n:
        return -1
    anchor_value: i64 = input[3 + n + anchor]
    if (anchor_value - 1) % stride0 != 0:
        return -1
    full_sa: mutable u64[32] = zeroed
    rank: mutable usize = anchor
    value: mutable i64 = anchor_value
    for step in 0..<n:
        if visited[rank]:
            return -1
        visited[rank] <- true
        full_sa[rank] <- value.u64()
        rank <- input[3 + rank].usize()
        value <- if value == n0: 1 else: value + 1
    if rank != anchor or value != anchor_value:
        return -1
    for i in 0..<n:
        expected: i64 = if (full_sa[i] - 1.u64()) % stride.u64() == 0.u64(): full_sa[i].i64() else: 0
        if input[3 + n + i] != expected:
            return -1
    rank <- query
    hops: mutable usize = 0
    while input[3 + n + rank] == 0:
        rank <- input[3 + rank].usize()
        hops <- hops + 1
        if hops >= stride:
            return -1
    position0: mutable i64 = input[3 + n + rank] - 1 - hops.i64()
    position0 <- position0 % n0
    if position0 < 0:
        position0 <- position0 + n0
    if output == null or capacity < 16:
        return -2
    psi_access_put_u64(output, 0, (position0 + 1).u64())
    psi_access_put_u64(output, 1, hops.u64())
    16.i64()

export fn psi_suffix_array_access(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = psi_suffix_array_access_impl
