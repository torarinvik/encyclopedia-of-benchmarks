const MAX_COUNT: usize = 64
const MODULUS: i64 = 1000000007
const BASE: i64 = 2000000003
export fn partition_linked_list(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > 66 or input[0] < 0 or input[0] > 64 or length != input[0].usize() + 2 or input[1] < -2147483648 or input[1] > 2147483647: return -1
    count: usize = input[0].usize()
    less: mutable i64[64]
    greater: mutable i64[64]
    less_count: mutable usize = 0
    greater_count: mutable usize = 0
    i: mutable usize = 0
    while i < count:
        value: i64 = input[i + 2]
        if value < -2147483648 or value > 2147483647: return -1
        if value < input[1]:
            less[less_count] <- value
            less_count <- less_count + 1
        else:
            greater[greater_count] <- value
            greater_count <- greater_count + 1
        i <- i + 1
    hash: mutable i64 = 0
    i <- 0
    while i < less_count:
        hash <- (hash * BASE + less[i] + 2147483648) % MODULUS
        i <- i + 1
    i <- 0
    while i < greater_count:
        hash <- (hash * BASE + greater[i] + 2147483648) % MODULUS
        i <- i + 1
    hash
