const MAX_TARGET: i64 = 200
const COINS: i64[8] = [1, 2, 5, 10, 20, 50, 100, 200]

def problem31_recursive_count(target: i64, coin_index: usize) -> i64:
    if target < 0:
        return 0
    if coin_index == 0:
        return 1
    coin: i64 = COINS[coin_index]
    problem31_recursive_count(target - coin, coin_index) +
        problem31_recursive_count(target, coin_index - 1)

def problem31_recursive_impl(target: i64) -> i64:
    if target < 0 or target > MAX_TARGET:
        return -1
    problem31_recursive_count(target, 7)

export fn problem31_recursive(target: i64) -> i64 = problem31_recursive_impl
