# Bounded integer port of the pinned floating-point Horner routine.
const INVALID_RESULT: i64 = -9223372036854775807 - 1

def polynomial_evaluation_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 10:
        return INVALID_RESULT
    count: i64 = values[0]
    x: i64 = values[1]
    if count < 0 or count > 8 or length != (count + 2).usize():
        return INVALID_RESULT
    if x < -10 or x > 10:
        return INVALID_RESULT
    index: mutable usize = 0
    while index < count.usize():
        coefficient: i64 = values[index + 2]
        if coefficient < -1000 or coefficient > 1000:
            return INVALID_RESULT
        index <- index + 1
    result: mutable i64 = 0
    index <- count.usize()
    while index > 0:
        index <- index - 1
        result <- result * x + values[index + 2]
    result

export fn polynomial_evaluation(values: i64&, length: usize) -> i64 = polynomial_evaluation_impl
