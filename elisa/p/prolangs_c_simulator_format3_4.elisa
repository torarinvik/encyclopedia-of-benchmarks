def prolangs_c_simulator_format3_4_impl(v: i64&, n: usize) -> i64:
    if v.is_null() or n != 7: return -1
    pc: i64 = v[0]
    x_reg: i64 = v[1]
    b_reg: i64 = v[2]
    if pc < 0 or pc > 1048572 or x_reg < 0 or x_reg >= 16777216 or b_reg < 0 or b_reg >= 16777216: return -1
    j: mutable usize = 3
    while j < 7:
        if v[j] < 0 or v[j] > 255: return -1
        j <- j + 1
    byte0: i64 = v[3]
    byte1: i64 = v[4]
    byte2: i64 = v[5]
    byte3: i64 = v[6]
    nf: i64 = (byte0 >> 1) & 1
    inf: i64 = byte0 & 1
    xf: i64 = (byte1 >> 7) & 1
    bf: i64 = (byte1 >> 6) & 1
    pf: i64 = (byte1 >> 5) & 1
    ef: i64 = (byte1 >> 4) & 1
    sic: bool = nf == 0 and inf == 0
    fmt: i64 = 3
    if ef == 1 and not sic: fmt <- 4
    next_pc: i64 = pc + fmt
    address: mutable i64 = 0
    if fmt == 4:
        if bf != 0 or pf != 0: return -1
        address <- ((byte1 & 15) << 16) | (byte2 << 8) | byte3
        if xf != 0: address <- address + x_reg
    else:
        address <- ((byte1 & 15) << 8) | byte2
        if sic: return 0
        if bf != 0 and pf != 0: return -1
        if xf != 0: address <- address + x_reg
        if bf != 0: address <- address + b_reg
        if pf != 0:
            if address >= 2048: address <- address - 4096 + next_pc
            else: address <- address + next_pc
    if nf == 1 and inf == 0: return -1
    if address < 0: return -1
    if nf == 0 and inf == 1 and address >= 16777216: return -1
    address

export fn prolangs_c_simulator_format3_4(v: i64&, n: usize) -> i64 = prolangs_c_simulator_format3_4_impl
