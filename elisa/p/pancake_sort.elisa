# Pancake sort using prefix reversals for the shared sorting contract.
def flip_prefix(values: mutable i64&, last: usize) -> void:
    first: mutable usize = 0
    end: mutable usize = last
    while first < end:
        temporary: i64 = values[first]
        values[first] <- values[end]
        values[end] <- temporary
        first <- first + 1
        end <- end - 1

def pancake_sort_impl(values: mutable i64&, length: usize) -> void:
    prefix: mutable usize = length
    while prefix > 1:
        maximum: mutable usize = 0
        probe: mutable usize = 1
        while probe < prefix:
            if values[probe] > values[maximum]:
                maximum <- probe
            probe <- probe + 1
        if maximum != prefix - 1:
            flip_prefix(values, maximum)
            flip_prefix(values, prefix - 1)
        prefix <- prefix - 1

export fn pancake_sort(values: mutable i64&, length: usize) -> void = pancake_sort_impl
