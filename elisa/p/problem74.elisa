# Count starts with the source's memoized digit-factorial chain length.
const MAX_START: i64 = 1000000
const CACHE_SIZE: usize = 2540161
const MAX_PATH_LENGTH: usize = 128

def sum_digit_factorials(value: i64) -> i64:
    factorials: i64[10] = [1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880]
    remaining: mutable i64 = value
    total: mutable i64 = 0
    while remaining > 0:
        total <- total + factorials[(remaining % 10).usize()]
        remaining <- remaining / 10
    if value == 0:
        total <- 1
    total

def chain_length(start: i64, cache: mutable view[u8]) -> i64:
    path: mutable i64[MAX_PATH_LENGTH] = zeroed
    path_length: mutable usize = 0
    current: mutable i64 = start
    result: mutable i64 = 0
    while true:
        encoded: u8 = cache[current.usize()]
        if encoded != 0.u8():
            result <- encoded.i64() - 1
            break
        next_value: i64 = sum_digit_factorials(current)
        repeats: mutable bool = false
        for index in 0..<path_length:
            if path[index] == next_value:
                repeats <- true
                break
        if repeats:
            cache[current.usize()] <- 1.u8()
            result <- 0
            break
        path[path_length] <- current
        path_length <- path_length + 1
        current <- next_value
    while path_length > 0:
        path_length <- path_length - 1
        current <- path[path_length]
        result <- result + 1
        cache[current.usize()] <- (result + 1).u8()
    cache[start.usize()].i64() - 1

def problem74_impl(num_terms: i64, max_start: i64) -> i64:
    if max_start > MAX_START:
        return -1
    if max_start <= 1:
        return 0
    cache: mutable u8[CACHE_SIZE] = zeroed
    cache[145] <- 1.u8()
    cache[169] <- 4.u8()
    cache[36301] <- 4.u8()
    cache[1454] <- 4.u8()
    cache[871] <- 3.u8()
    cache[45361] <- 3.u8()
    cache[872] <- 3.u8()
    count: mutable i64 = 0
    start: mutable i64 = 1
    while start < max_start:
        if chain_length(start, cache[0:CACHE_SIZE]) == num_terms:
            count <- count + 1
        start <- start + 1
    count

export fn problem74(num_terms: i64, max_start: i64) -> i64 = problem74_impl
