# Return the rounded-down percentage of ASCII text code points matching a letter.
def percentage_of_letters_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 4097:
        return -1
    target: mutable i64 = values[0]
    if target >= 65 and target <= 90:
        target <- target + 32
    if target < 97 or target > 122:
        return -1
    text_length: usize = length - 1
    matches: mutable usize = 0
    i: mutable usize = 0
    while i < text_length:
        value: mutable i64 = values[i + 1]
        if value < 0 or value > 127:
            return -1
        if value >= 65 and value <= 90:
            value <- value + 32
        if value == target:
            matches <- matches + 1
        i <- i + 1
    (100 * i64(matches)) / i64(text_length)

export fn percentage_of_letters(values: i64&, length: usize) -> i64 = percentage_of_letters_impl
