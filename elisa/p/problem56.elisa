# Keep powers in little-endian decimal digits to avoid machine-integer overflow.
def multiply_digits(digits: mutable i64[512], length: i64, factor: i64) -> i64:
    carry: mutable i64 = 0
    index: mutable i64 = 0
    while index < length:
        value: i64 = digits[index.usize()] * factor + carry
        digits[index.usize()] <- value % 10
        carry <- value / 10
        index <- index + 1
    while carry > 0:
        digits[length.usize()] <- carry % 10
        length <- length + 1
        carry <- carry / 10
    length

def problem56_impl(a: i64, b: i64) -> i64:
    if a < 1 or a > 200 or b < 1 or b > 200: return -1
    best: mutable i64 = 0
    base: mutable i64 = 0
    while base < a:
        digits: mutable i64[512] = zeroed
        digits[0] <- 1
        length: mutable i64 = 1
        power: mutable i64 = 0
        while power < b:
            sum: mutable i64 = 0
            for i in 0..length: sum <- sum + digits[i.usize()]
            if sum > best: best <- sum
            if power + 1 < b: length <- multiply_digits(digits, length, base)
            power <- power + 1
        base <- base + 1
    best

export fn problem56(a: i64, b: i64) -> i64 = problem56_impl
