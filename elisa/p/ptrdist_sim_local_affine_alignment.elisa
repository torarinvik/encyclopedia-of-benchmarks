## Clean-room port of SIM's documented first-best local affine score.
const STRIDE: usize = 65
const MAX_LENGTH: usize = 64
const CELLS: usize = STRIDE * STRIDE

def ptrdist_sim_local_affine_alignment_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 4 or length > 130:
        return -1
    if input[0] < 1 or input[0] > MAX_LENGTH:
        return -1
    left: usize = input[0].usize()
    right_pos: usize = 1 + left
    if right_pos >= length or input[right_pos] < 1 or input[right_pos] > MAX_LENGTH:
        return -1
    right: usize = input[right_pos].usize()
    if length != right_pos + 1 + right:
        return -1
    i: mutable usize = 0
    while i < left:
        c: i64 = input[1+i]
        if c != 65 and c != 67 and c != 71 and c != 84:
            return -1
        i <- i + 1
    j: mutable usize = 0
    while j < right:
        c: i64 = input[right_pos+1+j]
        if c != 65 and c != 67 and c != 71 and c != 84:
            return -1
        j <- j + 1
    h: mutable i64[CELLS] = zeroed
    d: mutable i64[CELLS] = zeroed
    f: mutable i64[CELLS] = zeroed
    j <- 1
    while j <= right:
        d[j] <- -60
        j <- j + 1
    i <- 1
    while i <= left:
        f[i*STRIDE] <- -60
        i <- i + 1
    best: mutable i64 = 0
    i <- 1
    while i <= left:
        j <- 1
        while j <= right:
            p: usize = i*STRIDE+j
            d_open: i64 = h[p-STRIDE]-62
            d_extend: i64 = d[p-STRIDE]-2
            d[p] <- if d_open > d_extend: d_open else: d_extend
            f_open: i64 = h[p-1]-62
            f_extend: i64 = f[p-1]-2
            f[p] <- if f_open > f_extend: f_open else: f_extend
            score: mutable i64 = h[p-STRIDE-1] + (if input[i] == input[right_pos+j]: 10 else: -10)
            if score < 0:
                score <- 0
            if d[p] > score:
                score <- d[p]
            if f[p] > score:
                score <- f[p]
            h[p] <- score
            if score > best:
                best <- score
            j <- j + 1
        i <- i + 1
    best

export fn ptrdist_sim_local_affine_alignment(input: i64&, length: usize) -> i64 = ptrdist_sim_local_affine_alignment_impl
