module parboil_mri_gridding

extern sqrt(value: f64) -> f64

const CELLS: i64 = 27
const MAX_SAMPLES: i64 = 4
const WIDTH: f32 = 2.5.f32()
const OVERSAMPLE: f32 = 0.608933.f32()
const COEFF: f32[15] = [
    0.210580722890567e-22.f32(), 0.380715242345326e-19.f32(), 0.479440257548300e-16.f32(),
    0.435125971262668e-13.f32(), 0.300931127112960e-10.f32(), 0.160224679395361e-7.f32(),
    0.654858370096785e-5.f32(), 0.202591084143397e-2.f32(), 0.463076284721000e0.f32(),
    0.754337328948189e2.f32(), 0.830792541809429e4.f32(), 0.571661130563785e6.f32(),
    0.216415572361227e8.f32(), 0.356644482244025e9.f32(), 0.144048298227235e10.f32()
]

def fn f32 parboil_mri_gridding_decode(i64 raw):
    return raw.f32() / 1000000.0.f32()

def fn f32 parboil_mri_gridding_kernel(f32 value):
    z: f32 = value * value
    num: mutable f32 = COEFF[0]
    i: mutable i64 = 1
    while i < 15:
        product: f32 = z * num
        num <- product + COEFF[i]
        i <- i + 1
    den: mutable f32 = z - 0.307646912682801e4.f32()
    den <- z * den
    den <- den + 0.347626332405882e7.f32()
    den <- z * den
    den <- den - 0.144048298227235e10.f32()
    return -num / den

def fn f32 parboil_mri_gridding_beta():
    first: mutable f32 = 4.0.f32() * WIDTH
    first <- first * WIDTH
    divisor: f32 = OVERSAMPLE * OVERSAMPLE
    first <- first / divisor
    shifted: f64 = OVERSAMPLE.f64() - 0.5
    argument: mutable f64 = first.f64() * shifted
    argument <- argument * shifted
    argument <- argument - 0.8
    return (3.14159265359 * sqrt(argument)).f32()

def fn f32 parboil_mri_gridding_weight(f32 v, f32 inverse, f32 beta, f32 sdc):
    product: f32 = v * inverse
    radicand: f64 = 1.0 - product.f64()
    argument: f32 = (beta.f64() * sqrt(radicand)).f32()
    return parboil_mri_gridding_kernel(argument) * sdc

def fn i64 parboil_mri_gridding_lower(f32 k, f32 cutoff):
    difference: f32 = k - cutoff
    if difference < 0.0.f32(): return 0
    return difference.i64()

def fn i64 parboil_mri_gridding_upper(f32 k, f32 cutoff):
    sum: f32 = k + cutoff
    if sum > 2.0.f32(): return 2
    return sum.i64()

def fn i64 parboil_mri_gridding_quantize(f32 value):
    scaled: f32 = value * 1000.0.f32()
    magnitude: f32 = if scaled < 0.0.f32() { -scaled } else { scaled }
    whole: mutable i64 = magnitude.i64()
    if magnitude - whole.f32() >= 0.5.f32(): whole <- whole + 1
    return if scaled < 0.0.f32() { -whole } else { whole }

def fn i64 parboil_mri_gridding(i64* input, i64 input_length):
    if input == null or input_length < 1 or input_length > 25: return -1
    n: i64 = input[0]
    if n < 0 or n > MAX_SAMPLES or input_length != 1 + 6 * n: return -1
    s: mutable i64 = 0
    while s < n:
        p: i64 = 1 + 6 * s
        a: mutable i64 = 0
        while a < 3:
            if input[p+a] != 0 and input[p+a] != 1000000 and input[p+a] != 2000000: return -1
            a <- a + 1
        if input[p+3] < -1000000 or input[p+3] > 1000000 or input[p+4] < -1000000 or input[p+4] > 1000000 or input[p+5] < 0 or input[p+5] > 1000000: return -1
        s <- s + 1

    real_grid: mutable f32[27] = zeroed
    imag_grid: mutable f32[27] = zeroed
    density: mutable f32[27] = zeroed
    cutoff: f32 = (WIDTH.f64() / 2.0).f32()
    cutoff2: f32 = cutoff * cutoff
    inverse: f32 = 1.0.f32() / cutoff2
    beta: f32 = parboil_mri_gridding_beta()
    s <- 0
    while s < n:
        p <- 1 + 6 * s
        kx: f32 = parboil_mri_gridding_decode(input[p])
        ky: f32 = parboil_mri_gridding_decode(input[p+1])
        kz: f32 = parboil_mri_gridding_decode(input[p+2])
        sr: f32 = parboil_mri_gridding_decode(input[p+3])
        si: f32 = parboil_mri_gridding_decode(input[p+4])
        sdc: f32 = parboil_mri_gridding_decode(input[p+5])
        if (sr != 0.0.f32() or si != 0.0.f32()) and sdc != 0.0.f32():
            x0: i64 = parboil_mri_gridding_lower(kx, cutoff)
            x1: i64 = parboil_mri_gridding_upper(kx, cutoff)
            y0: i64 = parboil_mri_gridding_lower(ky, cutoff)
            y1: i64 = parboil_mri_gridding_upper(ky, cutoff)
            z0: i64 = parboil_mri_gridding_lower(kz, cutoff)
            z1: i64 = parboil_mri_gridding_upper(kz, cutoff)
            z: mutable i64 = z0
            while z <= z1:
                dz: f32 = kz - z.f32()
                dz2: f32 = dz * dz
                if dz2 < cutoff2:
                    y: mutable i64 = y0
                    while y <= y1:
                        dy: f32 = ky - y.f32()
                        dy2: f32 = dy * dy
                        yz: f32 = dz2 + dy2
                        if yz < cutoff2:
                            x: mutable i64 = x0
                            while x <= x1:
                                dx: f32 = kx - x.f32()
                                dx2: f32 = dx * dx
                                v: f32 = yz + dx2
                                if v < cutoff2:
                                    index: i64 = x + 3 * y + 9 * z
                                    w: f32 = parboil_mri_gridding_weight(v, inverse, beta, sdc)
                                    real_delta: f32 = w * sr
                                    imag_delta: f32 = w * si
                                    real_grid[index] <- real_grid[index] + real_delta
                                    imag_grid[index] <- imag_grid[index] + imag_delta
                                    density[index] <- (density[index].f64() + 1.0).f32()
                                x <- x + 1
                        y <- y + 1
                z <- z + 1
        s <- s + 1
    checksum: mutable i64 = 0
    i: mutable i64 = 0
    while i < CELLS:
        checksum <- checksum + (i+1) * (parboil_mri_gridding_quantize(real_grid[i]) + parboil_mri_gridding_quantize(imag_grid[i]) + density[i].i64())
        i <- i + 1
    return checksum

export fn parboil_mri_gridding
