def pkcs7_padding_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 5 or length > 69: return -1
    operation: i64 = input[0]
    block_arg: i64 = input[1]
    offset_arg: i64 = input[2]
    data_arg: i64 = input[3]
    if operation < 0 or operation > 2 or block_arg < 1 or block_arg > 16:
        return -1
    if data_arg < 1 or data_arg > 64:
        return -1
    if operation == 0 and (offset_arg < 0 or offset_arg > data_arg): return -1
    if length != data_arg.usize() + 4: return -1
    block_size: usize = block_arg.usize()
    offset: mutable usize = 0
    if operation == 0: offset <- offset_arg.usize()
    data_length: usize = data_arg.usize()
    index: mutable usize = 0
    while index < data_length:
        value: i64 = input[index + 4]
        if value < 0 or value > 255: return -1
        index <- index + 1

    padding_count: mutable usize = 0
    output_length: mutable usize = 0
    if operation == 0:
        padding_count <- block_size - data_length % block_size
        if offset + padding_count > data_length: return -1
        output_length <- data_length + 1
    else if operation == 1:
        if data_length % block_size != 0: return -1
        padding_count <- input[data_length + 3].usize()
        if padding_count == 0 or padding_count > block_size: return -1
        index <- data_length - padding_count
        while index < data_length:
            if input[index + 4] != padding_count.i64(): return -1
            index <- index + 1
        output_length <- data_length - padding_count
    else:
        padding_count <- input[data_length + 3].usize()
        padding_start: i64 = data_length.i64() - padding_count.i64()
        padding_check_failed: mutable i64 = (padding_start | (padding_count.i64() - 1)) >> 31
        index <- 0
        while index < data_length:
            difference: i64 = index.i64() - padding_start
            negative_bit: u32 = difference.u32() >> 31
            mask: i64 = -(1.u32() - negative_bit).i64()
            value: i64 = input[index + 4]
            padding_check_failed <- padding_check_failed | ((value ^ padding_count.i64()) & mask)
            index <- index + 1
        if padding_check_failed != 0: return -1
        output_length <- 1
    if output == null or output_capacity < output_length: return -2
    if operation == 0:
        output[0] <- padding_count.u8()
        index <- 0
        while index < data_length:
            byte: mutable i64 = input[index + 4]
            if index >= offset and index < offset + padding_count:
                byte <- padding_count.i64()
            output[index + 1] <- byte.u8()
            index <- index + 1
    else if operation == 1:
        index <- 0
        while index < output_length:
            output[index] <- input[index + 4].u8()
            index <- index + 1
    else:
        output[0] <- padding_count.u8()
    output_length.i64()

export fn pkcs7_padding(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = pkcs7_padding_impl
