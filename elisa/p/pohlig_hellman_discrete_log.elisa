const POHLIG_MIN_P: i64 = 3
const POHLIG_MAX_P: i64 = 1009
const POHLIG_MAX_PARSEABLE_LENGTH: usize = 4

def is_prime(value: i64) -> bool:
    if value < 2: return false
    divisor: mutable i64 = 2
    while divisor * divisor <= value:
        if value % divisor == 0: return false
        if divisor == 2: divisor <- 3
        else: divisor <- divisor + 2
    true

def pow_mod(base_value: i64, exponent_value: i64, modulus: i64) -> i64:
    result: mutable i64 = 1
    factor: mutable i64 = base_value % modulus
    exponent: mutable i64 = exponent_value
    while exponent > 0:
        if (exponent & 1) != 0: result <- result * factor % modulus
        factor <- factor * factor % modulus
        exponent <- exponent / 2
    result

def factorize(value_value: i64, primes: mutable view[i64], exponents: mutable view[i64]) -> usize:
    value: mutable i64 = value_value
    divisor: mutable i64 = 2
    count: mutable usize = 0
    while divisor * divisor <= value:
        if value % divisor != 0:
            if divisor == 2: divisor <- 3
            else: divisor <- divisor + 2
            continue
        exponent: mutable i64 = 0
        while value % divisor == 0:
            value <- value / divisor
            exponent <- exponent + 1
        primes[count] <- divisor
        exponents[count] <- exponent
        count <- count + 1
        if divisor == 2: divisor <- 3
        else: divisor <- divisor + 2
    if value > 1:
        primes[count] <- value
        exponents[count] <- 1
        count <- count + 1
    count

def prime_order_log(generator: i64, target: i64, order: i64, modulus: i64) -> i64:
    step: mutable i64 = 1
    while step * step < order: step <- step + 1
    baby: mutable i64[64] = zeroed
    value: mutable i64 = 1
    j: mutable usize = 0
    while j < step.usize():
        baby[j] <- value
        value <- value * generator % modulus
        j <- j + 1
    giant_factor: i64 = pow_mod(pow_mod(generator, step, modulus), modulus - 2, modulus)
    probe: mutable i64 = target
    i: mutable i64 = 0
    while i <= step:
        j <- 0
        while j < step.usize():
            if baby[j] == probe:
                candidate: i64 = i * step + j.i64()
                if candidate < order: return candidate
            j <- j + 1
        probe <- probe * giant_factor % modulus
        i <- i + 1
    -1

def inverse_mod(value: i64, modulus: i64) -> i64:
    old_r: mutable i64 = value
    r: mutable i64 = modulus
    old_s: mutable i64 = 1
    s: mutable i64 = 0
    while r != 0:
        quotient: i64 = old_r / r
        next_r: i64 = old_r - quotient * r
        next_s: i64 = old_s - quotient * s
        old_r <- r
        r <- next_r
        old_s <- s
        s <- next_s
    if old_r != 1: return -1
    (old_s % modulus + modulus) % modulus

def pohlig_hellman(p: i64, base: i64, target: i64) -> i64:
    if target == 0: return -2
    primes: mutable i64[16] = zeroed
    exponents: mutable i64[16] = zeroed
    factor_count: usize = factorize(p - 1, primes[0:16], exponents[0:16])
    order: mutable i64 = p - 1
    for i in 0..<factor_count:
        prime: i64 = primes[i]
        while order % prime == 0 and pow_mod(base, order / prime, p) == 1:
            order <- order / prime
    if order == 1:
        if target == 1: return 0
        return -2

    order_primes: mutable i64[16] = zeroed
    order_exponents: mutable i64[16] = zeroed
    order_factor_count: usize = factorize(order, order_primes[0:16], order_exponents[0:16])
    solution: mutable i64 = 0
    combined_modulus: mutable i64 = 1
    for i in 0..<order_factor_count:
        prime: i64 = order_primes[i]
        exponent: i64 = order_exponents[i]
        component_modulus: mutable i64 = 1
        j: mutable i64 = 0
        while j < exponent:
            component_modulus <- component_modulus * prime
            j <- j + 1
        partial_log: mutable i64 = 0
        place: mutable i64 = 1
        prime_generator: i64 = pow_mod(base, order / prime, p)
        digit_index: mutable i64 = 0
        while digit_index < exponent:
            current_power: i64 = pow_mod(base, partial_log, p)
            inverse_current: i64 = pow_mod(current_power, p - 2, p)
            residual: i64 = target * inverse_current % p
            digit_target: i64 = pow_mod(residual, order / (place * prime), p)
            digit: i64 = prime_order_log(prime_generator, digit_target, prime, p)
            if digit < 0: return -2
            partial_log <- partial_log + digit * place
            place <- place * prime
            digit_index <- digit_index + 1
        if combined_modulus == 1:
            solution <- partial_log
            combined_modulus <- component_modulus
        else:
            inverse: i64 = inverse_mod(combined_modulus % component_modulus, component_modulus)
            if inverse < 0: return -2
            difference: i64 = (partial_log - solution) % component_modulus
            adjustment: i64 = ((difference + component_modulus) % component_modulus) * inverse % component_modulus
            solution <- solution + combined_modulus * adjustment
            combined_modulus <- combined_modulus * component_modulus
    solution <- solution % order
    if pow_mod(base, solution, p) == target: return solution
    -2

def verify(input: view[i64]) -> i64:
    if input.len() != 3: return -1
    p: i64 = input[0]
    base: i64 = input[1]
    target: i64 = input[2]
    if p < POHLIG_MIN_P or p > POHLIG_MAX_P or not is_prime(p) or base < 1 or base >= p or target < 0 or target >= p: return -1
    pohlig_hellman(p, base, target)

export fn pohlig_hellman_discrete_log(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > POHLIG_MAX_PARSEABLE_LENGTH or length != 3: return -1
    verify(input[0:length])
