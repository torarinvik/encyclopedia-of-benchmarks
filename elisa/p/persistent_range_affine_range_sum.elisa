const MOD: i64 = 998244353
const MAX_Q: usize = 16
const NODE_CAPACITY: usize = 4096

struct AffineNode:
    sum: mutable i64
    mul: mutable i64
    add: mutable i64
    left: mutable i64
    right: mutable i64

def aff_norm(x: i64) -> i64:
    return ((x % MOD) + MOD) % MOD

def aff_clone(nodes: mutable view[AffineNode], used: mutable view[usize], source: i64) -> i64:
    if source < 0 or used[0] >= NODE_CAPACITY: return -1
    copy: i64 = used[0].i64()
    used[0] <- used[0] + 1
    nodes[copy.usize()].sum <- nodes[source.usize()].sum
    nodes[copy.usize()].mul <- nodes[source.usize()].mul
    nodes[copy.usize()].add <- nodes[source.usize()].add
    nodes[copy.usize()].left <- nodes[source.usize()].left
    nodes[copy.usize()].right <- nodes[source.usize()].right
    return copy

def aff_make(nodes: mutable view[AffineNode], used: mutable view[usize], value: i64,
             left: i64, right: i64) -> i64:
    if used[0] >= NODE_CAPACITY: return -1
    copy: i64 = used[0].i64()
    used[0] <- used[0] + 1
    nodes[copy.usize()].sum <- value
    nodes[copy.usize()].mul <- 1
    nodes[copy.usize()].add <- 0
    nodes[copy.usize()].left <- left
    nodes[copy.usize()].right <- right
    return copy

def aff_apply(nodes: mutable view[AffineNode], node: i64, m0: i64, b0: i64, length: i64) -> void:
    m: i64 = aff_norm(m0)
    b: i64 = aff_norm(b0)
    nodes[node.usize()].sum <- aff_norm(m * nodes[node.usize()].sum + b * length.i64())
    nodes[node.usize()].mul <- aff_norm(m * nodes[node.usize()].mul)
    nodes[node.usize()].add <- aff_norm(m * nodes[node.usize()].add + b)

def aff_push(nodes: mutable view[AffineNode], used: mutable view[usize], node: i64,
             left: i64, right: i64) -> bool:
    m: i64 = nodes[node.usize()].mul
    b: i64 = nodes[node.usize()].add
    if m == 1 and b == 0: return true
    if left < right:
        middle: i64 = left + (right - left) / 2
        lc: i64 = aff_clone(nodes, used, nodes[node.usize()].left)
        rc: i64 = aff_clone(nodes, used, nodes[node.usize()].right)
        if lc < 0 or rc < 0: return false
        nodes[node.usize()].left <- lc
        nodes[node.usize()].right <- rc
        aff_apply(nodes, lc, m, b, middle-left+1)
        aff_apply(nodes, rc, m, b, right-middle)
    nodes[node.usize()].mul <- 1
    nodes[node.usize()].add <- 0
    return true

def aff_build(nodes: mutable view[AffineNode], used: mutable view[usize],
              input: view[i64], offset: i64, left: i64, right: i64) -> i64:
    if left == right: return aff_make(nodes, used, input[(offset+left).usize()], -1, -1)
    middle: i64 = left + (right-left)/2
    x: i64 = aff_build(nodes, used, input, offset, left, middle)
    y: i64 = aff_build(nodes, used, input, offset, middle+1, right)
    if x < 0 or y < 0: return -1
    return aff_make(nodes, used, aff_norm(nodes[x.usize()].sum+nodes[y.usize()].sum), x, y)

def aff_update(nodes: mutable view[AffineNode], used: mutable view[usize], root: i64,
               left: i64, right: i64, ql: i64, qr: i64, m: i64, b: i64) -> i64:
    if ql <= left and right <= qr:
        x: i64 = aff_clone(nodes, used, root)
        if x < 0: return -1
        aff_apply(nodes, x, m, b, right-left+1)
        return x
    x: i64 = aff_clone(nodes, used, root)
    if x < 0 or not aff_push(nodes, used, x, left, right): return -1
    middle: i64 = left + (right-left)/2
    if ql <= middle:
        y: i64 = aff_update(nodes, used, nodes[x.usize()].left, left, middle, ql, qr, m, b)
        if y < 0: return -1
        nodes[x.usize()].left <- y
    if qr > middle:
        y: i64 = aff_update(nodes, used, nodes[x.usize()].right, middle+1, right, ql, qr, m, b)
        if y < 0: return -1
        nodes[x.usize()].right <- y
    nodes[x.usize()].sum <- aff_norm(nodes[nodes[x.usize()].left.usize()].sum + nodes[nodes[x.usize()].right.usize()].sum)
    return x

def aff_logical_child(nodes: mutable view[AffineNode], used: mutable view[usize], source: i64,
                      right_child: bool, left: i64, right: i64) -> i64:
    child: mutable i64 = nodes[source.usize()].left
    if right_child: child <- nodes[source.usize()].right
    copy: i64 = aff_clone(nodes, used, child)
    if copy < 0: return -1
    m: i64 = nodes[source.usize()].mul
    b: i64 = nodes[source.usize()].add
    if m != 1 or b != 0:
        middle: i64 = left + (right-left)/2
        child_length: mutable i64 = right-middle
        if not right_child: child_length <- middle-left+1
        aff_apply(nodes, copy, m, b, child_length)
    return copy

def aff_copy(nodes: mutable view[AffineNode], used: mutable view[usize], dst: i64, src: i64,
             left: i64, right: i64, ql: i64, qr: i64) -> i64:
    if ql <= left and right <= qr: return src
    x: i64 = aff_clone(nodes, used, dst)
    if x < 0 or not aff_push(nodes, used, x, left, right): return -1
    middle: i64 = left + (right-left)/2
    if ql <= middle:
        s: i64 = aff_logical_child(nodes, used, src, false, left, right)
        if s < 0: return -1
        y: i64 = aff_copy(nodes, used, nodes[x.usize()].left, s, left, middle, ql, qr)
        if y < 0: return -1
        nodes[x.usize()].left <- y
    if qr > middle:
        s: i64 = aff_logical_child(nodes, used, src, true, left, right)
        if s < 0: return -1
        y: i64 = aff_copy(nodes, used, nodes[x.usize()].right, s, middle+1, right, ql, qr)
        if y < 0: return -1
        nodes[x.usize()].right <- y
    nodes[x.usize()].sum <- aff_norm(nodes[nodes[x.usize()].left.usize()].sum + nodes[nodes[x.usize()].right.usize()].sum)
    return x

def aff_query(nodes: view[AffineNode], node: i64, left: i64, right: i64,
              ql: i64, qr: i64, cm: i64, ca: i64) -> i64:
    if ql <= left and right <= qr:
        return aff_norm(cm*nodes[node.usize()].sum + ca*(right-left+1).i64())
    middle: i64 = left + (right-left)/2
    nm: i64 = aff_norm(cm*nodes[node.usize()].mul)
    na: i64 = aff_norm(cm*nodes[node.usize()].add+ca)
    z: mutable i64 = 0
    if ql <= middle: z <- aff_query(nodes, nodes[node.usize()].left, left, middle, ql, qr, nm, na)
    if qr > middle: z <- aff_norm(z + aff_query(nodes, nodes[node.usize()].right, middle+1, right, ql, qr, nm, na))
    return z

def aff_put(output: mutable u8&, offset: i64, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset.usize()+byte] <- ((bits >> (8*byte)) & 255).u8()

def persistent_range_affine_range_sum_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 115: return -1
    frame_storage: darray[i64] = [input[index] for index in 0..<length]
    frame: view[i64] = frame_storage[0:length]
    n0: i64 = frame[0]
    q0: i64 = frame[1]
    if n0 < 1 or n0 > 16 or q0 < 1 or q0 > 16: return -1
    n: i64 = n0.i64()
    q: i64 = q0.i64()
    off: mutable i64 = 2+n
    if length < off.usize(): return -1
    for i in 0..<n.usize():
        if frame[2+i] < 0 or frame[2+i] >= MOD: return -1
    kind: mutable i64[MAX_Q] = zeroed
    refs: mutable i64[MAX_Q] = zeroed
    srcs: mutable i64[MAX_Q] = zeroed
    starts: mutable i64[MAX_Q] = zeroed
    ends: mutable i64[MAX_Q] = zeroed
    mults: mutable i64[MAX_Q] = zeroed
    adds: mutable i64[MAX_Q] = zeroed
    for i in 0..<MAX_Q:
        mults[i] <- 1
    for i in 0..<q.usize():
        if off >= length.i64(): return -1
        op: i64 = frame[(off).usize()]
        width: mutable i64 = 0
        if op == 0: width <- 6
        elif op == 1: width <- 5
        elif op == 2: width <- 4
        else: return -1
        if length.i64()-off < width: return -1
        k: i64 = frame[(off+1).usize()]
        if k < -1 or k >= i.i64(): return -1
        if k >= 0 and kind[k.usize()] != 0 and kind[k.usize()] != 1: return -1
        kind[i] <- op
        refs[i] <- k
        if op == 0 or op == 2:
            starts[i] <- frame[(off+2).usize()]
            ends[i] <- frame[(off+3).usize()]
            if starts[i] < 0 or ends[i] <= starts[i] or ends[i] > n0: return -1
        if op == 0:
            mults[i] <- frame[(off+4).usize()]
            adds[i] <- frame[(off+5).usize()]
            if mults[i] < 1 or mults[i] >= MOD or adds[i] < 0 or adds[i] >= MOD: return -1
        if op == 1:
            srcs[i] <- frame[(off+2).usize()]
            starts[i] <- frame[(off+3).usize()]
            ends[i] <- frame[(off+4).usize()]
            s: i64 = srcs[i]
            if s < -1 or s >= i.i64(): return -1
            if s >= 0 and kind[s.usize()] != 0 and kind[s.usize()] != 1: return -1
            if starts[i] < 0 or ends[i] <= starts[i] or ends[i] > n0: return -1
        off <- off + width
    if off != length.i64(): return -1
    nodes: mutable AffineNode[NODE_CAPACITY] = zeroed
    used: mutable usize[1] = zeroed
    initial: i64 = aff_build(nodes[0:NODE_CAPACITY], used[0:1], frame, 2, 0, n-1)
    if initial < 0: return -1
    roots: mutable i64[MAX_Q] = zeroed
    answers: mutable i64[MAX_Q] = zeroed
    answer_count: mutable i64 = 0
    for i in 0..<q.usize():
        base: mutable i64 = initial
        if refs[i] >= 0: base <- roots[refs[i].usize()]
        if kind[i] == 0:
            roots[i] <- aff_update(nodes[0:NODE_CAPACITY], used[0:1], base, 0, n-1,
                starts[i].i64(), ends[i].i64()-1, mults[i], adds[i])
            if roots[i] < 0: return -1
        elif kind[i] == 1:
            source: mutable i64 = initial
            if srcs[i] >= 0: source <- roots[srcs[i].usize()]
            roots[i] <- aff_copy(nodes[0:NODE_CAPACITY], used[0:1], base, source, 0, n-1,
                starts[i].i64(), ends[i].i64()-1)
            if roots[i] < 0: return -1
        else:
            answers[answer_count.usize()] <- aff_query(nodes[0:NODE_CAPACITY], base, 0, n-1,
                starts[i].i64(), ends[i].i64()-1, 1, 0)
            answer_count <- answer_count + 1
    required: usize = 8*answer_count.usize()
    if output == null or capacity < required: return -2
    for i in 0..<answer_count.usize():
        aff_put(output, (8*i).i64(), answers[i])
    return required.i64()

def persistent_range_affine_range_sum_entry(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    persistent_range_affine_range_sum_impl(input, length, output, capacity)

export fn persistent_range_affine_range_sum(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = persistent_range_affine_range_sum_entry