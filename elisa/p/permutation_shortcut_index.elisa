def shortcut_marked(bitmap: u64, vertex: usize) -> bool:
    (bitmap & (1.u64() << vertex)) != 0

def permutation_shortcut_index_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 4 or length > 52:
        return -1
    n0: i64 = input[0]
    stride0: i64 = input[1]
    if n0 < 1 or n0 > 16 or stride0 < 1 or stride0 > 16:
        return -1
    n: usize = n0.usize()
    stride: usize = stride0.usize()
    query_at: usize = 2 + n
    if length <= query_at:
        return -1
    query_count0: i64 = input[query_at]
    if query_count0 < 0 or query_count0 > 16 or length != query_at + 1 + 2 * query_count0.usize():
        return -1
    query_count: usize = query_count0.usize()
    successor: mutable usize[16] = zeroed
    seen: mutable bool[16] = zeroed
    for vertex in 0..<n:
        value: i64 = input[2 + vertex]
        if value < 1 or value > n0 or seen[(value - 1).usize()]:
            return -1
        seen[(value - 1).usize()] <- true
        successor[vertex] <- (value - 1).usize()
    for query in 0..<query_count:
        op: i64 = input[query_at + 1 + 2 * query]
        index: i64 = input[query_at + 2 + 2 * query]
        if (op != 0 and op != 1) or index < 1 or index > n0:
            return -1

    visited: mutable bool[16] = zeroed
    back_pointer: mutable usize[16] = zeroed
    bitmap: mutable u64 = 0
    for start in 0..<n:
        if visited[start]:
            continue
        cycle: mutable usize[16] = zeroed
        cycle_length: mutable usize = 0
        current: mutable usize = start
        while not visited[current]:
            visited[current] <- true
            cycle[cycle_length] <- current
            cycle_length <- cycle_length + 1
            current <- successor[current]
        if cycle_length >= stride:
            offset: mutable usize = 0
            while offset < cycle_length:
                vertex: usize = cycle[offset]
                bitmap <- bitmap | (1.u64() << vertex)
                back_steps: usize = stride % cycle_length
                back_offset: mutable usize = 0
                if offset >= back_steps:
                    back_offset <- offset - back_steps
                else:
                    back_offset <- cycle_length - (back_steps - offset)
                back_pointer[vertex] <- cycle[back_offset]
                offset <- offset + stride

    shortcuts: mutable usize[16] = zeroed
    shortcut_count: mutable usize = 0
    for vertex in 0..<n:
        if shortcut_marked(bitmap, vertex):
            shortcuts[shortcut_count] <- back_pointer[vertex]
            shortcut_count <- shortcut_count + 1
    answers: mutable i64[16] = zeroed
    for query in 0..<query_count:
        op: i64 = input[query_at + 1 + 2 * query]
        target: usize = (input[query_at + 2 + 2 * query] - 1).usize()
        answer: mutable i64 = 0
        if op == 0:
            answer <- successor[target].i64()
        else:
            marker: mutable usize = target
            steps: mutable usize = 0
            while steps < n and not shortcut_marked(bitmap, marker):
                marker <- successor[marker]
                steps <- steps + 1
            if not shortcut_marked(bitmap, marker):
                previous: mutable usize = target
                current: mutable usize = successor[target]
                while current != target:
                    previous <- current
                    current <- successor[current]
                answer <- previous.i64()
            else:
                rank: mutable usize = 0
                for vertex in 0..<marker:
                    if shortcut_marked(bitmap, vertex):
                        rank <- rank + 1
                current: mutable usize = shortcuts[rank]
                previous: mutable usize = current
                current <- successor[current]
                found: mutable bool = false
                steps <- 0
                while steps < n and not found:
                    if current == target:
                        found <- true
                    else:
                        previous <- current
                        current <- successor[current]
                        steps <- steps + 1
                if not found:
                    return -1
                answer <- previous.i64()
        answers[query] <- answer + 1

    bytes: usize = query_count * 8
    if output == null or capacity < bytes:
        return -2
    for query in 0..<query_count:
        bits: u64 = answers[query].u64()
        for byte in 0..<8:
            output[query * 8 + byte] <- ((bits >> (byte * 8)) & 255).u8()
    bytes.i64()

export fn permutation_shortcut_index(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = permutation_shortcut_index_impl
