# Check whether a signed 32-bit integer is a perfect square.
def perfect_square_checker_impl(n: i64) -> i64:
    if n < -2147483648 or n > 2147483647:
        return -1
    if n < 0:
        return 0
    low: mutable i64 = 0
    high: mutable i64 = 46340
    while low <= high:
        mid: i64 = low + (high - low) / 2
        square: i64 = mid * mid
        if square == n:
            return 1
        if square < n:
            low <- mid + 1
        else:
            high <- mid - 1
    0

export fn perfect_square_checker(n: i64) -> i64 = perfect_square_checker_impl
