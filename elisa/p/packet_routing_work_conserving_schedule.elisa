const MAX_N:usize=8
const MAX_M:usize=12
const MAX_P:usize=8
const MAX_HOPS:usize=56
const MAX_INPUT:usize=99

def pr_put_i64(value:i64,output:mutable u8&,word:usize):
    bits:u64=value.u64();b:mutable usize=0
    while b<8:output[word*8+b]<-((bits>>(8*b))&255).u8();b<-b+1

def packet_routing_work_conserving_schedule(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("packet_routing_work_conserving_schedule"):
    if input.is_null() or length<3 or length>MAX_INPUT:return -1
    n0:i64=input[0];m0:i64=input[1];p0:i64=input[2]
    if n0<2 or n0>8 or m0<1 or m0>12 or p0<1 or p0>8:return -1
    n:usize=n0.usize();m:usize=m0.usize();p:usize=p0.usize();at:mutable usize=3
    if at+2*m>length:return -1
    eu:mutable usize[MAX_M]=zeroed;ev:mutable usize[MAX_M]=zeroed;seen:mutable bool[MAX_N*MAX_N]=zeroed;e:mutable usize=0
    while e<m:
        u0:=input[at];v0:=input[at+1];at<-at+2
        if u0<0 or u0>=n0 or v0<0 or v0>=n0 or u0==v0:return -1
        u:=u0.usize();v:=v0.usize();lo:=u;hi:=v;if lo>hi:lo<-v;hi<-u
        key:=lo*MAX_N+hi;if seen[key]:return -1;seen[key]<-true;eu[e]<-u;ev[e]<-v;e<-e+1
    plen:mutable usize[MAX_P]=zeroed;paths:mutable usize[MAX_P*MAX_N]=zeroed;q:mutable usize=0
    while q<p:
        if at+2>length:return -1
        start:=input[at];k0:=input[at+1];at<-at+2
        if start<0 or start>=n0 or k0<1 or k0>=n0 or at+k0.usize()>length:return -1
        k:=k0.usize();plen[q]<-k;cur:=start.usize();usedv:mutable bool[MAX_N]=zeroed;usede:mutable bool[MAX_M]=zeroed;usedv[cur]<-true;j:mutable usize=0
        while j<k:
            e0:=input[at];at<-at+1;if e0<0 or e0>=m0:return -1
            edge:=e0.usize();if usede[edge]:return -1;usede[edge]<-true;paths[q*MAX_N+j]<-edge
            if eu[edge]==cur:cur<-ev[edge]
            else if ev[edge]==cur:cur<-eu[edge]
            else:return -1
            if usedv[cur]:return -1;usedv[cur]<-true;j<-j+1
        q<-q+1
    if at!=length:return -1
    pos:mutable usize[MAX_P]=zeroed;tt:mutable i64[MAX_HOPS]=zeroed;te:mutable i64[MAX_HOPS]=zeroed;tp:mutable i64[MAX_HOPS]=zeroed;count:mutable usize=0;time:mutable usize=0
    loop:
        active:mutable bool=false;chosen:mutable i64[MAX_M]=zeroed;e<-0
        while e<m:chosen[e]<--1;e<-e+1
        q<-0
        while q<p:
            if pos[q]<plen[q]:active<-true;link:=paths[q*MAX_N+pos[q]];if chosen[link]<0:chosen[link]<-q.i64()
            q<-q+1
        if not active:break
        e<-0
        while e<m:
            if chosen[e]>=0:
                if count>=MAX_HOPS:return -1
                tt[count]<-time.i64();te[count]<-e.i64();tp[count]<-chosen[e];count<-count+1;pos[chosen[e].usize()]<-pos[chosen[e].usize()]+1
            e<-e+1
        time<-time+1;if time>MAX_N*MAX_P:return -1
    words:usize=2+3*count;bytes:=words*8
    if output.is_null() or capacity<bytes:return -2
    pr_put_i64(time.i64(),output&,0);pr_put_i64(count.i64(),output&,1);q<-0
    while q<count:pr_put_i64(tt[q],output&,2+3*q);pr_put_i64(te[q],output&,3+3*q);pr_put_i64(tp[q],output&,4+3*q);q<-q+1
    bytes.i64()
