const MAX_PRIME = 4093
const MAX_INPUT_LENGTH = 2

def primitive_root_factorization_is_prime(value: i64) -> bool:
    if value < 2:
        return false
    divisor: mutable i64 = 2
    while divisor * divisor <= value:
        if value % divisor == 0:
            return false
        divisor <- divisor + 1
    true

def primitive_root_factorization_power_mod(base_input: i64, exponent_input: i64,
        modulus: i64) -> i64:
    base: mutable i64 = base_input
    exponent: mutable i64 = exponent_input
    result: mutable i64 = 1
    while exponent > 0:
        if exponent % 2 != 0:
            result <- result * base % modulus
        base <- base * base % modulus
        exponent <- exponent / 2
    result

def primitive_root_factorization_impl(input: i64&, input_length: usize) -> i64:
    if input_length != 1:
        return -1
    prime:  i64 = input[0]
    if prime < 2 or prime > MAX_PRIME or not primitive_root_factorization_is_prime(prime):
        return -1
    if prime == 2:
        return 1

    factors: mutable i64[16] = zeroed
    factor_count: mutable usize = 0
    remaining: mutable i64 = prime - 1
    divisor: mutable i64 = 2
    while divisor * divisor <= remaining:
        if remaining % divisor == 0:
            factors[factor_count] <- divisor
            factor_count <- factor_count + 1
            while remaining % divisor == 0:
                remaining <- remaining / divisor
        divisor <- divisor + 1
    if remaining > 1:
        factors[factor_count] <- remaining
        factor_count <- factor_count + 1

    candidate: mutable i64 = 2
    while candidate < prime:
        valid: mutable bool = true
        index: mutable usize = 0
        while index < factor_count:
            if primitive_root_factorization_power_mod(candidate,
                    (prime - 1) / factors[index], prime) == 1:
                valid <- false
                break
            index <- index + 1
        if valid:
            return candidate
        candidate <- candidate + 1
    -1

def primitive_root_factorization_entry(input: i64&, length: usize) -> i64:
    if input == null or length != 1 or length > MAX_INPUT_LENGTH:
        return -1
    input_view: i64& = input
    input_view_length: usize = length
    primitive_root_factorization_impl(input_view, input_view_length)

export fn primitive_root_factorization(input: i64&, length: usize) -> i64 = primitive_root_factorization_entry
