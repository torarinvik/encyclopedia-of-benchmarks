def problem5_gcd(left: u64, right: u64) -> u64:
    a: mutable u64 = left
    b: mutable u64 = right
    while b != 0:
        remainder: u64 = a % b
        a <- b
        b <- remainder
    a

def problem5_impl(limit: i64) -> i64:
    if limit < 1 or limit > 20:
        return -1
    result: mutable u64 = 1
    value: mutable u64 = 2
    while value <= limit.u64():
        result <- (result / problem5_gcd(result, value)) * value
        value <- value + 1
    result.i64()

export fn problem5(limit: i64) -> i64 = problem5_impl
