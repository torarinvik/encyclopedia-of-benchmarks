def problem5_gcd(left: i64, right: i64) -> i64:
    a: mutable i64 = left
    b: mutable i64 = right
    while b != 0:
        remainder: i64 = a % b
        a <- b
        b <- remainder
    a

def problem5_impl(limit: i64) -> i64:
    if limit < 1 or limit > 20:
        return -1
    result: mutable i64 = 1
    value: mutable i64 = 2
    while value <= limit:
        result <- (result / problem5_gcd(result, value)) * value
        value <- value + 1
    result

export fn problem5(limit: i64) -> i64 = problem5_impl
