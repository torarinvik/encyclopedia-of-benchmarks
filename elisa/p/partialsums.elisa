const MAX_N: usize = 10000
const OUTPUT_COUNT: usize = 9

extern sin(value: f64) -> f64
extern cos(value: f64) -> f64
extern sqrt(value: f64) -> f64
extern trunc(value: f64) -> f64

def partialsums_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input == null or length != 1:
        return -1
    n_value: f64 = input[0]
    if trunc(n_value) != n_value or n_value < 1.0 or n_value > MAX_N.f64():
        return -1
    n: usize = n_value.usize()
    geometric: mutable f64 = 0.0
    inverse_sqrt: mutable f64 = 0.0
    flint: mutable f64 = 0.0
    cookson: mutable f64 = 0.0
    telescoping: mutable f64[2] = zeroed
    harmonic: mutable f64[2] = zeroed
    zeta: mutable f64[2] = zeroed
    alternating: mutable f64[2] = zeroed
    gregory: mutable f64[2] = zeroed
    term: mutable f64 = 1.0
    vector_limit: usize = n + (n & 1)
    for k in 1..=vector_limit:
        kd: f64 = k.f64()
        lane: usize = (k - 1) & 1
        if k <= n:
            k3: f64 = kd * kd * kd
            s: f64 = sin(kd)
            c: f64 = cos(kd)
            geometric <- geometric + term
            term <- term * (2.0 / 3.0)
            inverse_sqrt <- inverse_sqrt + 1.0 / sqrt(kd)
            flint <- flint + 1.0 / (k3 * s * s)
            cookson <- cookson + 1.0 / (k3 * c * c)
        telescoping[lane] <- telescoping[lane] + 1.0 / (kd * (kd + 1.0))
        harmonic[lane] <- harmonic[lane] + 1.0 / kd
        zeta[lane] <- zeta[lane] + 1.0 / (kd * kd)
        alternating[lane] <- alternating[lane] + (if lane == 0: 1.0 else: -1.0) / kd
        gregory[lane] <- gregory[lane] + (if lane == 0: 1.0 else: -1.0) / (2.0 * kd - 1.0)
    if output == null or capacity < OUTPUT_COUNT:
        return -2
    output[0] = geometric
    output[1] = inverse_sqrt
    output[2] = telescoping[0] + telescoping[1]
    output[3] = flint
    output[4] = cookson
    output[5] = harmonic[0] + harmonic[1]
    output[6] = zeta[0] + zeta[1]
    output[7] = alternating[0] + alternating[1]
    output[8] = gregory[0] + gregory[1]
    OUTPUT_COUNT.i64()

export fn partialsums(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = partialsums_impl
