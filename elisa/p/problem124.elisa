def problem124_impl(n_max: i64, k: i64) -> i64:
    if n_max < 1 or n_max > 100000 or k < 1 or k > n_max: return -1
    n: i64 = n_max
    radicals: mutable i64[100001] = zeroed
    counts: mutable i64[100001] = zeroed
    i: mutable i64 = 1
    while i <= n:
        radicals[i.usize()] <- 1
        i <- i + 1
    p: mutable i64 = 2
    while p <= n:
        if radicals[p.usize()] == 1:
            multiple: mutable i64 = p
            while multiple <= n:
                radicals[multiple.usize()] <- radicals[multiple.usize()] * p
                multiple <- multiple + p
        p <- p + 1
    i <- 1
    while i <= n:
        r: i64 = radicals[i.usize()]
        counts[r.usize()] <- counts[r.usize()] + 1
        i <- i + 1
    rad: mutable i64 = 1
    remaining: mutable i64 = k
    while rad <= n:
        if remaining > counts[rad.usize()]:
            remaining <- remaining - counts[rad.usize()]
        else:
            i <- 1
            while i <= n:
                if radicals[i.usize()] == rad:
                    remaining <- remaining - 1
                    if remaining == 0: return i
                i <- i + 1
        rad <- rad + 1
    -1

export fn problem124(n_max: i64, k: i64) -> i64 = problem124_impl
