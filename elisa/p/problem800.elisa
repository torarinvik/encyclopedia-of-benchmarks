extern log2(value: f64) -> f64

def problem800_is_composite(bits: u64&, value: i64) -> bool:
    word: usize = (value / 64).usize()
    mask: u64 = 1.u64() << (value % 64).u32()
    (bits[word] & mask) != 0

def problem800_mark_composite(bits: mutable u64&, value: i64) -> void:
    word: usize = (value / 64).usize()
    mask: u64 = 1.u64() << (value % 64).u32()
    bits[word] <- bits[word] | mask

def problem800_impl(base: i64, degree: i64) -> i64:
    if base < 2 or base > 1000000 or degree < 1 or degree > 1000000:
        return -1
    upper_bound: f64 = degree.f64() * log2(base.f64())
    prime_limit: i64 = upper_bound.i64()
    if prime_limit <= 2:
        return 0

    composite: mutable u64[312500] = zeroed
    prime: mutable i64 = 2
    while prime <= (prime_limit - 1) / prime:
        if not problem800_is_composite(composite, prime):
            multiple: mutable i64 = prime * prime
            while multiple < prime_limit:
                problem800_mark_composite(composite, multiple)
                multiple <- multiple + prime
        prime <- prime + 1

    right_value: mutable i64 = 0
    prime_count: mutable i64 = 0
    value: mutable i64 = 2
    while value < prime_limit:
        if not problem800_is_composite(composite, value):
            right_value <- value
            prime_count <- prime_count + 1
        value <- value + 1
    if prime_count < 2:
        return 0

    right_rank: mutable i64 = prime_count - 1
    left_rank: mutable i64 = 0
    left_value: mutable i64 = 2
    count: mutable i64 = 0
    while left_rank < right_rank:
        while problem800_is_composite(composite, left_value):
            left_value <- left_value + 1
        left_log: f64 = log2(left_value.f64())
        while right_value.f64() * left_log + left_value.f64() * log2(right_value.f64()) > upper_bound:
            right_rank <- right_rank - 1
            right_value <- right_value - 1
            while right_value >= 2 and problem800_is_composite(composite, right_value):
                right_value <- right_value - 1
        count <- count + right_rank - left_rank
        left_rank <- left_rank + 1
        left_value <- left_value + 1
    count

export fn problem800(base: i64, degree: i64) -> i64 = problem800_impl
