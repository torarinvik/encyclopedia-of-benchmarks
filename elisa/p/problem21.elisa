# Sum amicable values below an exclusive limit using proper-divisor scans.
def problem21_proper_divisor_sum(value: i64) -> i64:
    if value <= 1:
        return 0
    total: mutable i64 = 1
    divisor: mutable i64 = 2
    while divisor <= value / divisor:
        if value % divisor == 0:
            partner: i64 = value / divisor
            total <- total + divisor
            if partner != divisor:
                total <- total + partner
        divisor <- divisor + 1
    total

def problem21_impl(limit: i64) -> i64:
    if limit < 1 or limit > 10000:
        return -1
    total: mutable i64 = 0
    value: mutable i64 = 1
    while value < limit:
        partner: i64 = problem21_proper_divisor_sum(value)
        if partner != value and problem21_proper_divisor_sum(partner) == value:
            total <- total + value
        value <- value + 1
    total

export fn problem21(limit: i64) -> i64 = problem21_impl
