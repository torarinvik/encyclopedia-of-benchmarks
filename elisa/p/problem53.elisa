# Count central binomial coefficients after they cross the threshold.
def problem53_impl(unused: i64) -> i64:
    if unused != 0: return -1
    total: mutable i64 = 0
    for n in 1..101:
        coefficient: mutable i64 = 1
        for r in 1..(n / 2 + 1):
            coefficient <- coefficient * (n-r+1) / r
            if coefficient > 1000000:
                total <- total + n - 2*r + 1
                break
    total

export fn problem53(unused: i64) -> i64 = problem53_impl
