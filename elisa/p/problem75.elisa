def gcd_i64(left_input: i64, right_input: i64) -> i64:
    left: mutable i64 = left_input
    right: mutable i64 = right_input
    while right != 0:
        remainder: i64 = left % right
        left <- right
        right <- remainder
    left

def problem75_impl(limit: i64) -> i64:
    if limit > 1500000: return -1
    if limit < 0: return 0
    frequency: mutable u8[1500001] = zeroed
    m: mutable i64 = 2
    while 2 * m * (m + 1) <= limit:
        n: mutable i64 = (m % 2) + 1
        while n < m:
            if gcd_i64(m, n) == 1:
                primitive_perimeter: i64 = 2 * m * (m + n)
                perimeter: mutable i64 = primitive_perimeter
                while perimeter <= limit:
                    if frequency[perimeter.usize()] < 2:
                        frequency[perimeter.usize()] <- frequency[perimeter.usize()] + 1
                    perimeter <- perimeter + primitive_perimeter
            n <- n + 2
        m <- m + 1
    unique: mutable i64 = 0
    perimeter: mutable i64 = 1
    while perimeter <= limit:
        if frequency[perimeter.usize()] == 1: unique <- unique + 1
        perimeter <- perimeter + 1
    unique

export fn problem75(limit: i64) -> i64 = problem75_impl
