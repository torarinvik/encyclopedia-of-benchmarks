def percentage_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 3 or input[0] < 1 or input[0] > 100000 or input[1] < 1 or input[1] > 100000 or input[2] < 1 or input[2] > 4: return -1
    scale: i64 = 1
    i: i64 = 0
    while i < input[2]:
        scale <- scale * 10
        i <- i + 1
    product: i64 = input[0] * input[1] * scale
    if product < 100: return -1
    product / 100

export fn percentage(input: i64&, length: usize) -> i64 = percentage_impl
