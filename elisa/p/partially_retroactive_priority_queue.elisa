const MAX_N: usize = 64
const MAX_Q: usize = 64
const MAX_INPUT: usize = 323
const BASE: usize = 128
const TREE_SIZE: usize = 256

struct RetroQueue:
    types: i64[65]
    values: i64[65]
    balance: i64[256]
    prefix_min: i64[256]
    suffix_max: i64[256]
    min_insert: i64[256]
    max_delete: i64[256]
    live_count: i64
    live_sum: i64

def retro_pick_min(q: mutable view[RetroQueue], a: i64, b: i64) -> i64:
    if a == 0: return b
    if b == 0: return a
    if q[0].values[a.usize()] != q[0].values[b.usize()]:
        return if q[0].values[a.usize()] < q[0].values[b.usize()]: a else: b
    return if a > b: a else: b

def retro_pick_max(q: mutable view[RetroQueue], a: i64, b: i64) -> i64:
    if a == -1: return b
    if b == -1: return a
    if a == 0 or b == 0: return 0
    if q[0].values[a.usize()] != q[0].values[b.usize()]:
        return if q[0].values[a.usize()] > q[0].values[b.usize()]: a else: b
    return if a < b: a else: b

def retro_pull(q: mutable view[RetroQueue], i: usize) -> void:
    p: mutable usize = (BASE + i) / 2
    while p > 0:
        left: usize = 2 * p
        right: usize = left + 1
        q[0].balance[p] <- q[0].balance[left] + q[0].balance[right]
        through_left: i64 = q[0].balance[left] + q[0].prefix_min[right]
        q[0].prefix_min[p] <- if q[0].prefix_min[left] < through_left: q[0].prefix_min[left] else: through_left
        through_right: i64 = q[0].suffix_max[left] + q[0].balance[right]
        q[0].suffix_max[p] <- if through_right > q[0].suffix_max[right]: through_right else: q[0].suffix_max[right]
        q[0].min_insert[p] <- retro_pick_min(q, q[0].min_insert[left], q[0].min_insert[right])
        q[0].max_delete[p] <- retro_pick_max(q, q[0].max_delete[left], q[0].max_delete[right])
        p <- p / 2

def retro_next_bridge(q: mutable view[RetroQueue], i: usize) -> usize:
    left: mutable usize = BASE
    right: mutable usize = BASE + i + 1
    acc: mutable i64 = 0
    while left < right:
        if (left & 1) == 1: acc <- acc + q[0].balance[left]; left <- left + 1
        if (right & 1) == 1: right <- right - 1; acc <- acc + q[0].balance[right]
        left <- left / 2
        right <- right / 2
    if acc == 0: return i + 1
    node: mutable usize = BASE + i + 1
    while true:
        while (node & 1) == 0: node <- node / 2
        if acc + q[0].prefix_min[node] == 0:
            while node < BASE:
                node <- node * 2
                if acc + q[0].prefix_min[node] > 0:
                    acc <- acc + q[0].balance[node]
                    node <- node + 1
            return node - BASE
        acc <- acc + q[0].balance[node]
        node <- node + 1
        if (node & (!node + 1)) == node: return BASE
    return BASE

def retro_prev_bridge(q: mutable view[RetroQueue], i: usize) -> usize:
    left: mutable usize = BASE + i
    right: mutable usize = BASE * 2
    acc: mutable i64 = 0
    while left < right:
        if (left & 1) == 1: acc <- acc + q[0].balance[left]; left <- left + 1
        if (right & 1) == 1: right <- right - 1; acc <- acc + q[0].balance[right]
        left <- left / 2
        right <- right / 2
    if acc == 0: return i
    node: mutable usize = BASE + i
    while true:
        node <- node - 1
        while node > 1 and (node & 1) == 1: node <- node / 2
        if q[0].suffix_max[node] + acc == 0:
            while node < BASE:
                node <- node * 2 + 1
                if q[0].suffix_max[node] + acc < 0:
                    acc <- acc + q[0].balance[node]
                    node <- node - 1
            return node - BASE
        acc <- acc + q[0].balance[node]
        if (node & (!node + 1)) == node: return 0
    return 0

def retro_find_min_insert(q: mutable view[RetroQueue], i: usize) -> i64:
    left: mutable usize = BASE
    right: mutable usize = BASE + retro_next_bridge(q, i)
    answer: mutable i64 = 0
    while left < right:
        if (left & 1) == 1: answer <- retro_pick_min(q, answer, q[0].min_insert[left]); left <- left + 1
        if (right & 1) == 1: right <- right - 1; answer <- retro_pick_min(q, answer, q[0].min_insert[right])
        left <- left / 2
        right <- right / 2
    return answer

def retro_find_max_delete(q: mutable view[RetroQueue], i: usize) -> i64:
    left: mutable usize = BASE + retro_prev_bridge(q, i)
    right: mutable usize = BASE * 2
    answer: mutable i64 = -1
    while left < right:
        if (left & 1) == 1: answer <- retro_pick_max(q, answer, q[0].max_delete[left]); left <- left + 1
        if (right & 1) == 1: right <- right - 1; answer <- retro_pick_max(q, answer, q[0].max_delete[right])
        left <- left / 2
        right <- right / 2
    return answer

def retro_add(q: mutable view[RetroQueue], i: usize) -> void:
    k: i64 = retro_find_max_delete(q, i)
    leaf: usize = BASE + i
    if retro_pick_max(q, i.i64(), k) == i.i64():
        q[0].live_sum <- q[0].live_sum + q[0].values[i]
        q[0].live_count <- q[0].live_count + 1
        q[0].min_insert[leaf] <- i.i64()
        retro_pull(q, i)
        return
    q[0].max_delete[leaf] <- i.i64()
    q[0].balance[leaf] <- 1
    q[0].suffix_max[leaf] <- 1
    retro_pull(q, i)
    mate: usize = BASE + k.usize()
    if k == 0:
        q[0].balance[mate] <- q[0].balance[mate] - 1
        q[0].suffix_max[mate] <- q[0].suffix_max[mate] - 1
        if q[0].balance[mate] == 0: q[0].max_delete[mate] <- -1
    else:
        q[0].live_sum <- q[0].live_sum + q[0].values[k.usize()]
        q[0].live_count <- q[0].live_count + 1
        q[0].min_insert[mate] <- k
        q[0].max_delete[mate] <- -1
        q[0].balance[mate] <- 0
        q[0].suffix_max[mate] <- 0
    retro_pull(q, mate - BASE)

def retro_unadd(q: mutable view[RetroQueue], i: usize) -> void:
    leaf: usize = BASE + i
    if q[0].balance[leaf] == 0:
        q[0].live_sum <- q[0].live_sum - q[0].values[i]
        q[0].live_count <- q[0].live_count - 1
        q[0].min_insert[leaf] <- 0
        retro_pull(q, i)
        return
    k: i64 = retro_find_min_insert(q, i)
    q[0].max_delete[leaf] <- -1
    q[0].balance[leaf] <- 0
    q[0].suffix_max[leaf] <- 0
    retro_pull(q, i)
    mate: usize = BASE + k.usize()
    if k > 0:
        q[0].live_sum <- q[0].live_sum - q[0].values[k.usize()]
        q[0].live_count <- q[0].live_count - 1
    q[0].min_insert[mate] <- 0
    q[0].max_delete[mate] <- k
    q[0].balance[mate] <- q[0].balance[mate] + 1
    q[0].suffix_max[mate] <- q[0].suffix_max[mate] + 1
    retro_pull(q, mate - BASE)

def retro_pop(q: mutable view[RetroQueue], i: usize) -> void:
    k: i64 = retro_find_min_insert(q, i)
    leaf: usize = BASE + i
    q[0].balance[leaf] <- -1
    q[0].prefix_min[leaf] <- -1
    retro_pull(q, i)
    if k > 0:
        q[0].live_sum <- q[0].live_sum - q[0].values[k.usize()]
        q[0].live_count <- q[0].live_count - 1
    mate: usize = BASE + k.usize()
    q[0].min_insert[mate] <- 0
    q[0].max_delete[mate] <- k
    q[0].balance[mate] <- q[0].balance[mate] + 1
    q[0].suffix_max[mate] <- q[0].suffix_max[mate] + 1
    retro_pull(q, mate - BASE)

def retro_unpop(q: mutable view[RetroQueue], i: usize) -> void:
    k: i64 = retro_find_max_delete(q, i)
    leaf: usize = BASE + i
    q[0].balance[leaf] <- 0
    q[0].prefix_min[leaf] <- 0
    retro_pull(q, i)
    mate: usize = BASE + k.usize()
    if k == 0:
        q[0].balance[mate] <- q[0].balance[mate] - 1
        q[0].suffix_max[mate] <- q[0].suffix_max[mate] - 1
        if q[0].balance[mate] == 0: q[0].max_delete[mate] <- -1
    else:
        q[0].live_sum <- q[0].live_sum + q[0].values[k.usize()]
        q[0].live_count <- q[0].live_count + 1
        q[0].min_insert[mate] <- k
        q[0].max_delete[mate] <- -1
        q[0].balance[mate] <- 0
        q[0].suffix_max[mate] <- 0
    retro_pull(q, mate - BASE)

def retro_set(q: mutable view[RetroQueue], index: usize, kind: i64, value: i64) -> void:
    i: usize = index + 1
    if q[0].types[i] == 0: retro_unadd(q, i)
    else if q[0].types[i] == 1: retro_unpop(q, i)
    q[0].types[i] <- kind
    q[0].values[i] <- value
    if kind == 0: retro_add(q, i)
    else if kind == 1: retro_pop(q, i)

def retro_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def partially_retroactive_priority_queue_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    frame: view[i64] = input[0:length]
    if frame[0] < 1 or frame[0] > MAX_N.i64() or frame[1] < 1 or frame[1] > MAX_Q.i64(): return -1
    n: usize = frame[0].usize()
    qn: usize = frame[1].usize()
    if length != 2 + 2 * n + 3 * qn: return -1
    cursor: mutable usize = 2
    while cursor < 2 + 2 * n:
        kind: i64 = frame[cursor]
        value: i64 = frame[cursor + 1]
        if kind == 0:
            if value < 0 or value > 1000000: return -1
        else if not ((kind == 1 or kind == 2) and value == -1): return -1
        cursor <- cursor + 2
    while cursor < length:
        index: i64 = frame[cursor]
        kind: i64 = frame[cursor + 1]
        value: i64 = frame[cursor + 2]
        if index < 0 or index >= n.i64(): return -1
        if kind == 0:
            if value < 0 or value > 1000000: return -1
        else if not ((kind == 1 or kind == 2) and value == -1): return -1
        cursor <- cursor + 3
    output_size: usize = 16 * qn
    if output.is_null() or capacity < output_size: return -2
    queue_storage: mutable RetroQueue[1] = zeroed
    queue: mutable view[RetroQueue] = queue_storage[0:1]
    i: mutable usize = 0
    while i <= n:
        queue[0].types[i] <- 2
        queue[0].values[i] <- -1
        i <- i + 1
    i <- 0
    while i < TREE_SIZE:
        queue[0].max_delete[i] <- -1
        i <- i + 1
    cursor <- 2
    i <- 0
    while i < n:
        kind: i64 = frame[cursor]
        value: i64 = frame[cursor + 1]
        cursor <- cursor + 2
        retro_set(queue, i, kind, value)
        i <- i + 1
    result: mutable view[u8] = output[0:output_size]
    written: mutable usize = 0
    i <- 0
    while i < qn:
        index: usize = frame[cursor].usize()
        kind: i64 = frame[cursor + 1]
        value: i64 = frame[cursor + 2]
        cursor <- cursor + 3
        retro_set(queue, index, kind, value)
        retro_store(queue[0].live_count, result, written)
        retro_store(queue[0].live_sum, result, written + 8)
        written <- written + 16
        i <- i + 1
    return written.i64()

export fn partially_retroactive_priority_queue(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = partially_retroactive_priority_queue_impl
