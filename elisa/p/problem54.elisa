# Rank one five-card hand by category and standard kicker order.
def problem54_rank_hand(cards: i64[5]) -> i64[6]:
    ranks: mutable i64[5] = zeroed
    suits: mutable i64[5] = zeroed
    counts: mutable i64[15] = zeroed
    for i in 0..<5:
        ranks[i] <- cards[i] / 4 + 2
        suits[i] <- cards[i] % 4
        counts[ranks[i].usize()] <- counts[ranks[i].usize()] + 1
    for i in 1..<5:
        value: i64 = ranks[i]
        j: mutable usize = i
        while j > 0 and ranks[j - 1] < value:
            ranks[j] <- ranks[j - 1]
            j <- j - 1
        ranks[j] <- value
    score: mutable i64[6] = zeroed
    flush: mutable bool = true
    for i in 1..<5:
        if suits[i] != suits[0]:
            flush <- false
    distinct: mutable bool = true
    for rank in 2..<15:
        if counts[rank] > 1:
            distinct <- false
    straight_high: mutable i64 = 0
    if distinct and ranks[0] - ranks[4] == 4:
        straight_high <- ranks[0]
    else if distinct and ranks[0] == 14 and ranks[1] == 5 and ranks[2] == 4 and ranks[3] == 3 and ranks[4] == 2:
        straight_high <- 5
    four: mutable i64 = 0
    three: mutable i64 = 0
    pair_high: mutable i64 = 0
    pair_low: mutable i64 = 0
    singles: mutable i64[5] = zeroed
    single_count: mutable usize = 0
    for rank in 2..<15:
        descending_rank: i64 = 16 - rank
        if counts[descending_rank.usize()] == 4:
            four <- descending_rank
        else if counts[descending_rank.usize()] == 3:
            three <- descending_rank
        else if counts[descending_rank.usize()] == 2:
            if pair_high == 0:
                pair_high <- descending_rank
            else:
                pair_low <- descending_rank
        else if counts[descending_rank.usize()] == 1:
            singles[single_count] <- descending_rank
            single_count <- single_count + 1
    if flush and straight_high != 0:
        if straight_high == 14:
            score[0] <- 9
        else:
            score[0] <- 8
        score[1] <- straight_high
    else if four != 0:
        score[0] <- 7
        score[1] <- four
        score[2] <- singles[0]
    else if three != 0 and pair_high != 0:
        score[0] <- 6
        score[1] <- three
        score[2] <- pair_high
    else if flush:
        score[0] <- 5
        for i in 0..<5: score[i + 1] <- ranks[i]
    else if straight_high != 0:
        score[0] <- 4
        score[1] <- straight_high
    else if three != 0:
        score[0] <- 3
        score[1] <- three
        score[2] <- singles[0]
        score[3] <- singles[1]
    else if pair_low != 0:
        score[0] <- 2
        score[1] <- pair_high
        score[2] <- pair_low
        score[3] <- singles[0]
    else if pair_high != 0:
        score[0] <- 1
        score[1] <- pair_high
        score[2] <- singles[0]
        score[3] <- singles[1]
        score[4] <- singles[2]
    else:
        score[0] <- 0
        for i in 0..<5: score[i + 1] <- ranks[i]
    score

def problem54_impl(input: i64&, length: usize) -> i64:
    if length != 10000:
        return -1
    wins: mutable i64 = 0
    for deal in 0..<1000:
        offset: usize = deal * 10
        for i in 0..<10:
            card: i64 = input[offset + i]
            if card < 0 or card >= 52:
                return -1
            for previous in 0..<i:
                if input[offset + previous] == card:
                    return -1
        first_cards: mutable i64[5] = zeroed
        second_cards: mutable i64[5] = zeroed
        for i in 0..<5:
            first_cards[i] <- input[offset + i]
            second_cards[i] <- input[offset + 5 + i]
        first_score: i64[6] = problem54_rank_hand(first_cards)
        second_score: i64[6] = problem54_rank_hand(second_cards)
        hand_wins: mutable bool = false
        for i in 0..<6:
            if first_score[i] > second_score[i]:
                hand_wins <- true
                break
            else if first_score[i] < second_score[i]:
                break
        if hand_wins:
            wins <- wins + 1
    wins

export fn problem54(input: i64&, length: usize) -> i64 = problem54_impl
