const MAX_LENGTH: usize = 256

def palindrome_partitioning_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length == 0 or length > MAX_LENGTH:
        return -1
    for index in 0..<length:
        if input[index] < 0 or input[index] > 127:
            return -1
    if output == null or output_capacity < 8:
        return -2

    palindrome: mutable bool[MAX_LENGTH * MAX_LENGTH] = zeroed
    cuts: mutable i64[MAX_LENGTH] = zeroed
    for end in 0..<length:
        best: mutable usize = end
        for start in 0..<(end + 1):
            if input[start] == input[end] and (end - start < 2 or palindrome[(start + 1) * MAX_LENGTH + end - 1]):
                palindrome[start * MAX_LENGTH + end] <- true
                candidate: usize = 0
                if start > 0:
                    candidate = cuts[start - 1].usize() + 1
                if candidate < best:
                    best <- candidate
        cuts[end] <- best.i64()

    bits: mutable u64 = cuts[length - 1].u64()
    for byte in 0..<8:
        output[byte] <- (bits & 255).u8()
        bits <- bits >> 8
    return 1

export fn palindrome_partitioning(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = palindrome_partitioning_impl
