# Count ordered final doubles and unordered first-two dart multiset combinations.
def problem109_impl(limit: i64) -> i64:
    values: mutable i64[63] = zeroed
    doubles: mutable i64[21] = zeroed
    value_count: mutable usize = 0
    double_count: mutable usize = 0
    for score in 1..21:
        values[value_count] <- score.i64()
        value_count <- value_count + 1
    values[value_count] <- 25
    value_count <- value_count + 1
    for score in 1..21:
        doubles[double_count] <- (2 * score).i64()
        values[value_count] <- (2 * score).i64()
        double_count <- double_count + 1
        value_count <- value_count + 1
    doubles[double_count] <- 50
    values[value_count] <- 50
    double_count <- double_count + 1
    value_count <- value_count + 1
    for score in 1..21:
        values[value_count] <- (3 * score).i64()
        value_count <- value_count + 1
    values[value_count] <- 0
    value_count <- value_count + 1
    count: mutable i64 = 0
    for d in 0..<double_count:
        for first in 0..<value_count:
            for second in first..<value_count:
                if doubles[d] + values[first] + values[second] < limit:
                    count <- count + 1
    count

export fn problem109(limit: i64) -> i64 = problem109_impl
