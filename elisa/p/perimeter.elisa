def perimeter_impl(values: i64&, length: usize) -> i64:
    if length != 2:
        return -1
    sides: i64 = values[0]
    side_length: i64 = values[1]
    if sides < 3 or sides > 256 or side_length < 1 or side_length > 255:
        return -1
    sides * side_length

export fn perimeter(values: i64&, length: usize) -> i64 = perimeter_impl
