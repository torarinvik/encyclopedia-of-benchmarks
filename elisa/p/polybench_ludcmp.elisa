const POLYBENCH_LUDCMP_MAX_DIMENSION: usize = 64
const POLYBENCH_LUDCMP_MAX_CELLS: usize = POLYBENCH_LUDCMP_MAX_DIMENSION * POLYBENCH_LUDCMP_MAX_DIMENSION
const POLYBENCH_LUDCMP_INVALID_RESULT: f64 = -1e300

def polybench_ludcmp_impl(values: i64&, length: usize) -> f64:
    if values.is_null() or length != 1 or values[0] < 1 or values[0] > POLYBENCH_LUDCMP_MAX_DIMENSION.i64():
        return POLYBENCH_LUDCMP_INVALID_RESULT
    n: usize = values[0].usize()
    a: mutable f64[POLYBENCH_LUDCMP_MAX_CELLS] = zeroed
    product: mutable f64[POLYBENCH_LUDCMP_MAX_CELLS] = zeroed
    b: mutable f64[POLYBENCH_LUDCMP_MAX_DIMENSION] = zeroed
    x: mutable f64[POLYBENCH_LUDCMP_MAX_DIMENSION] = zeroed
    y: mutable f64[POLYBENCH_LUDCMP_MAX_DIMENSION] = zeroed
    i: mutable usize = 0
    while i < n:
        x[i] <- 0.0
        y[i] <- 0.0
        b[i] <- ((i + 1).f64() / n.f64()) / 2.0 + 4.0
        i <- i + 1
    i <- 0
    while i < n:
        j: mutable usize = 0
        while j <= i:
            negative_remainder: i64 = -((j % n).i64())
            a[i * n + j] <- negative_remainder.f64() / n.f64() + 1.0
            j <- j + 1
        while j < n:
            a[i * n + j] <- 0.0
            j <- j + 1
        a[i * n + i] <- 1.0
        i <- i + 1
    r: mutable usize = 0
    while r < n:
        s: mutable usize = 0
        while s < n:
            product[r * n + s] <- 0.0
            s <- s + 1
        r <- r + 1
    t: mutable usize = 0
    while t < n:
        r <- 0
        while r < n:
            s <- 0
            while s < n:
                product[r * n + s] <- product[r * n + s] + a[r * n + t] * a[s * n + t]
                s <- s + 1
            r <- r + 1
        t <- t + 1
    r <- 0
    while r < n:
        s <- 0
        while s < n:
            a[r * n + s] <- product[r * n + s]
            s <- s + 1
        r <- r + 1
    i <- 0
    while i < n:
        j <- 0
        while j < i:
            w: mutable f64 = a[i * n + j]
            k: mutable usize = 0
            while k < j:
                w <- w - a[i * n + k] * a[k * n + j]
                k <- k + 1
            a[i * n + j] <- w / a[j * n + j]
            j <- j + 1
        j <- i
        while j < n:
            w: mutable f64 = a[i * n + j]
            k <- 0
            while k < i:
                w <- w - a[i * n + k] * a[k * n + j]
                k <- k + 1
            a[i * n + j] <- w
            j <- j + 1
        i <- i + 1
    i <- 0
    while i < n:
        w: mutable f64 = b[i]
        j: mutable usize = 0
        while j < i:
            w <- w - a[i * n + j] * y[j]
            j <- j + 1
        y[i] <- w
        i <- i + 1
    reverse: mutable i64 = n.i64()
    while reverse > 0:
        reverse <- reverse - 1
        i <- reverse.usize()
        w: mutable f64 = y[i]
        j <- i + 1
        while j < n:
            w <- w - a[i * n + j] * x[j]
            j <- j + 1
        x[i] <- w / a[i * n + i]
    result: mutable f64 = 0.0
    i <- 0
    while i < n:
        result <- result + x[i]
        i <- i + 1
    result

export fn polybench_ludcmp(values: i64&, length: usize) -> f64 = polybench_ludcmp_impl
