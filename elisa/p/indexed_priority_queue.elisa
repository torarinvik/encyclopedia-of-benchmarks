# Bounded identity-addressed min-heap event trace.
def indexed_priority_queue_key_in_use(heap_ids: i64&, heap_keys: i64&, size: usize,
        key: i64, except_id: i64) -> bool:
    index: mutable usize = 0
    while index < size:
        if heap_ids[index] != except_id and heap_keys[index] == key:
            return true
        index <- index + 1
    false

def indexed_priority_queue_sift_up(heap_ids: mutable i64&, heap_keys: mutable i64&,
        positions: mutable i64&, index_value: usize) -> bool:
    index: mutable usize = index_value
    original: usize = index
    item_id: i64 = heap_ids[index]
    item_key: i64 = heap_keys[index]
    while index > 0:
        parent: usize = (index - 1) / 2
        if item_key >= heap_keys[parent]:
            break
        heap_ids[index] <- heap_ids[parent]
        heap_keys[index] <- heap_keys[parent]
        positions[heap_ids[index].usize()] <- index.i64()
        index <- parent
    heap_ids[index] <- item_id
    heap_keys[index] <- item_key
    positions[item_id.usize()] <- index.i64()
    index != original

def indexed_priority_queue_sift_down(heap_ids: mutable i64&, heap_keys: mutable i64&,
        positions: mutable i64&, size: usize, index_value: usize) -> void:
    index: mutable usize = index_value
    item_id: i64 = heap_ids[index]
    item_key: i64 = heap_keys[index]
    half: usize = size / 2
    while index < half:
        child: mutable usize = index * 2 + 1
        right: usize = child + 1
        if right < size and heap_keys[child] > heap_keys[right]:
            child <- right
        if item_key <= heap_keys[child]:
            break
        heap_ids[index] <- heap_ids[child]
        heap_keys[index] <- heap_keys[child]
        positions[heap_ids[index].usize()] <- index.i64()
        index <- child
    heap_ids[index] <- item_id
    heap_keys[index] <- item_key
    positions[item_id.usize()] <- index.i64()

def indexed_priority_queue_remove_at(size: mutable usize&, heap_ids: mutable i64&,
        heap_keys: mutable i64&, positions: mutable i64&, index: usize) -> void:
    new_size: usize = size - 1
    removed_id: i64 = heap_ids[index]
    moved_id: i64 = heap_ids[new_size]
    moved_key: i64 = heap_keys[new_size]
    size <- new_size
    positions[removed_id.usize()] <- -1
    if index == new_size:
        return
    heap_ids[index] <- moved_id
    heap_keys[index] <- moved_key
    positions[moved_id.usize()] <- index.i64()
    if not indexed_priority_queue_sift_up(heap_ids, heap_keys, positions, index):
        indexed_priority_queue_sift_down(heap_ids, heap_keys, positions, size, index)

def indexed_priority_queue_store_i64(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- ((bits >> (byte * 8)) & 255.u64()).u8()
        byte <- byte + 1

def indexed_priority_queue_impl(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if values.is_null() or length < 1 or length > 1538:
        return -1
    event_count_value: i64 = values[0]
    if event_count_value < 0 or event_count_value > 256:
        return -1
    event_count: usize = event_count_value.usize()
    if length != 1 + 6 * event_count:
        return -1
    if event_count == 0:
        return 0

    heap_ids: mutable i64[64] = zeroed
    heap_keys: mutable i64[64] = zeroed
    positions: mutable i64[64] = zeroed
    records: mutable i64[1536] = zeroed
    id: mutable usize = 0
    while id < 64:
        positions[id] <- -1
        id <- id + 1
    size: mutable usize = 0
    event_index: mutable usize = 0
    while event_index < event_count:
        start: usize = 1 + event_index * 6
        opcode: i64 = values[start]
        element_id: i64 = values[start + 1]
        key: i64 = values[start + 2]
        if values[start + 3] != 0 or values[start + 4] != 0 or values[start + 5] != 0:
            return -1
        status: mutable i64 = 1
        result_id: mutable i64 = 0
        result_key: mutable i64 = 0

        if opcode == 0:
            if element_id < 0 or element_id >= 64 or key < -2147483648 or key > 2147483647:
                return -1
            if positions[element_id.usize()] >= 0 or size >= 64 or
                    indexed_priority_queue_key_in_use(heap_ids, heap_keys, size, key, -1):
                return -1
            heap_ids[size] <- element_id
            heap_keys[size] <- key
            positions[element_id.usize()] <- size.i64()
            size <- size + 1
            indexed_priority_queue_sift_up(heap_ids, heap_keys, positions, size - 1)
        else if opcode == 1 or opcode == 2:
            if element_id != 0 or key != 0:
                return -1
            if size == 0:
                status <- 0
            else:
                result_id <- heap_ids[0]
                result_key <- heap_keys[0]
                if opcode == 2:
                    indexed_priority_queue_remove_at(size, heap_ids, heap_keys, positions, 0)
        else if opcode == 3 or opcode == 4:
            if element_id < 0 or element_id >= 64 or key != 0:
                return -1
            position: i64 = positions[element_id.usize()]
            status <- if position >= 0: 1 else: 0
            if opcode == 3 and position >= 0:
                indexed_priority_queue_remove_at(size, heap_ids, heap_keys, positions, position.usize())
        else if opcode >= 5 and opcode <= 7:
            if element_id < 0 or element_id >= 64 or key < -2147483648 or key > 2147483647:
                return -1
            position: i64 = positions[element_id.usize()]
            if position < 0:
                return -1
            old_key: i64 = heap_keys[position.usize()]
            if (opcode == 6 and key >= old_key) or (opcode == 7 and key <= old_key) or
                    indexed_priority_queue_key_in_use(heap_ids, heap_keys, size, key, element_id):
                return -1
            heap_keys[position.usize()] <- key
            if opcode == 6:
                indexed_priority_queue_sift_up(heap_ids, heap_keys, positions, position.usize())
            else if opcode == 7:
                indexed_priority_queue_sift_down(heap_ids, heap_keys, positions, size, position.usize())
            else if not indexed_priority_queue_sift_up(heap_ids, heap_keys, positions, position.usize()):
                indexed_priority_queue_sift_down(heap_ids, heap_keys, positions, size, position.usize())
        else if opcode == 8 or opcode == 9 or opcode == 10:
            if element_id != 0 or key != 0:
                return -1
            if opcode == 8:
                id <- 0
                while id < size:
                    positions[heap_ids[id].usize()] <- -1
                    id <- id + 1
                size <- 0
            else if opcode == 9:
                result_id <- size.i64()
            else:
                result_id <- if size == 0: 1 else: 0
        else:
            return -1

        record: usize = event_index * 6
        records[record] <- status
        records[record + 1] <- result_id
        records[record + 2] <- result_key
        records[record + 3] <- size.i64()
        records[record + 4] <- if size == 0: 0 else: heap_ids[0]
        records[record + 5] <- if size == 0: 0 else: heap_keys[0]
        event_index <- event_index + 1

    required: usize = event_count * 48
    if output.is_null() or output_capacity < required:
        return -2
    event_index <- 0
    while event_index < event_count:
        field: mutable usize = 0
        while field < 6:
            indexed_priority_queue_store_i64(records[event_index * 6 + field], output,
                event_index * 48 + field * 8)
            field <- field + 1
        event_index <- event_index + 1
    required.i64()

export fn indexed_priority_queue(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = indexed_priority_queue_impl
