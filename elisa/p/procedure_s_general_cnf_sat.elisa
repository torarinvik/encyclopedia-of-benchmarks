const PROC_S_MAX_VARS: usize = 5
const PROC_S_MAX_CLAUSES: usize = 6
const PROC_S_MAX_LITS: usize = PROC_S_MAX_VARS * PROC_S_MAX_CLAUSES

struct ProcedureSFormula:
    count: usize
    lengths: usize[PROC_S_MAX_CLAUSES]
    literals: i64[PROC_S_MAX_LITS]

struct ProcedureSStats:
    calls: i64
    tests: i64
    branches: i64
    max_depth: i64

def procedure_s_put_i64(output: mutable u8&, word: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[word * 8 + byte] <- (bits >> (byte * 8)).u8()

def procedure_s_shorten(formula: ProcedureSFormula, k: usize) -> ProcedureSFormula:
    result: mutable ProcedureSFormula = zeroed
    result.count <- formula.count
    for clause in 0..<formula.count:
        take: usize = if formula.lengths[clause] < k: formula.lengths[clause] else: k
        result.lengths[clause] <- take
        for index in 0..<take:
            result.literals[clause * PROC_S_MAX_VARS + index] <- formula.literals[clause * PROC_S_MAX_VARS + index]
    result

def procedure_s_exact_sat(formula: ProcedureSFormula, variables: usize, fixed_mask: u64,
                          fixed_values: u64) -> (bool, u64):
    limit: usize = 1 << variables
    for code in 0..<limit:
        candidate: mutable u64 = 0
        for variable in 0..<variables:
            if ((code >> (variables - variable - 1)) & 1) != 0:
                candidate <- candidate | (1.u64() << variable)
        if ((candidate ^ fixed_values) & fixed_mask) != 0: continue
        all_satisfied: mutable bool = true
        for clause in 0..<formula.count:
            clause_satisfied: mutable bool = false
            for index in 0..<formula.lengths[clause]:
                literal: i64 = formula.literals[clause * PROC_S_MAX_VARS + index]
                variable: usize = if literal > 0: (literal - 1).usize() else: (-literal - 1).usize()
                truth: bool = (candidate & (1.u64() << variable)) != 0
                if (literal > 0 and truth) or (literal < 0 and not truth): clause_satisfied <- true
            if not clause_satisfied: all_satisfied <- false
        if all_satisfied: return (true, candidate)
    (false, 0)

def procedure_s_solve(formula: ProcedureSFormula, variables: usize, k: usize,
                      fixed_mask: u64, fixed_values: u64, depth: usize,
                      stats: mutable ProcedureSStats&, model: mutable u64&) -> bool:
    stats.calls <- stats.calls + 1
    if depth.i64() > stats.max_depth: stats.max_depth <- depth.i64()
    prefixes: ProcedureSFormula = procedure_s_shorten(formula, k)
    stats.tests <- stats.tests + 1
    base: (bool, u64) = procedure_s_exact_sat(prefixes, variables, fixed_mask, fixed_values)
    if base.0: model <- base.1; return true
    for branch in 0..<formula.count:
        if prefixes.lengths[branch] == 0: continue
        stats.branches <- stats.branches + 1
        next_mask: mutable u64 = fixed_mask
        next_values: mutable u64 = fixed_values
        conflict: mutable bool = false
        for index in 0..<prefixes.lengths[branch]:
            literal: i64 = prefixes.literals[branch * PROC_S_MAX_VARS + index]
            variable: usize = if literal > 0: (literal - 1).usize() else: (-literal - 1).usize()
            bit: u64 = 1.u64() << variable
            value: u64 = if literal < 0: bit else: 0
            if (next_mask & bit) != 0 and (next_values & bit) != value: conflict <- true
            next_mask <- next_mask | bit
            next_values <- (next_values & ~bit) | value
        if conflict or next_mask == fixed_mask: continue
        child: mutable ProcedureSFormula = zeroed
        newly_fixed: u64 = next_mask & ~fixed_mask
        for clause in 0..<formula.count:
            source: ProcedureSFormula = if clause < branch: prefixes else: formula
            satisfied: mutable bool = false
            kept: mutable usize = 0
            for index in 0..<source.lengths[clause]:
                literal: i64 = source.literals[clause * PROC_S_MAX_VARS + index]
                variable: usize = if literal > 0: (literal - 1).usize() else: (-literal - 1).usize()
                bit: u64 = 1.u64() << variable
                if (newly_fixed & bit) != 0:
                    truth: bool = (next_values & bit) != 0
                    if (literal > 0 and truth) or (literal < 0 and not truth): satisfied <- true
                else:
                    child.literals[child.count * PROC_S_MAX_VARS + kept] <- literal
                    kept <- kept + 1
            if not satisfied:
                child.lengths[child.count] <- kept
                child.count <- child.count + 1
        if procedure_s_solve(child, variables, k, next_mask, next_values, depth + 1, stats, model): return true
    false

def procedure_s_general_cnf_sat_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 3 or length > 39: return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    k0: i64 = input[2]
    if n0 < 1 or n0 > PROC_S_MAX_VARS.i64() or m0 < 0 or m0 > PROC_S_MAX_CLAUSES.i64() or k0 < 1 or k0 > n0: return -1
    variables: usize = n0.usize()
    clause_count: usize = m0.usize()
    k: usize = k0.usize()
    formula: mutable ProcedureSFormula = zeroed
    formula.count <- clause_count
    at: mutable usize = 3
    for clause in 0..<clause_count:
        if at >= length or input[at] < 1 or input[at] > n0: return -1
        count: usize = input[at].usize()
        at <- at + 1
        if at + count > length: return -1
        seen: mutable u64 = 0
        formula.lengths[clause] <- count
        for index in 0..<count:
            value: i64 = input[at]
            at <- at + 1
            if value == 0 or value > n0 or value < -n0: return -1
            literal: i64 = value
            variable: usize = if literal > 0: (literal - 1).usize() else: (-literal - 1).usize()
            bit: u64 = 1.u64() << variable
            if (seen & bit) != 0: return -1
            seen <- seen | bit
            formula.literals[clause * PROC_S_MAX_VARS + index] <- literal
    if at != length: return -1
    stats: mutable ProcedureSStats = zeroed
    model: mutable u64 = 0
    sat: bool = procedure_s_solve(formula, variables, k, 0, 0, 0, stats, model)
    if output == null or output_capacity < 48: return -2
    procedure_s_put_i64(output, 0, if sat: 1 else: 0)
    procedure_s_put_i64(output, 1, if sat: model.i64() else: 0)
    procedure_s_put_i64(output, 2, stats.calls)
    procedure_s_put_i64(output, 3, stats.tests)
    procedure_s_put_i64(output, 4, stats.branches)
    procedure_s_put_i64(output, 5, stats.max_depth)
    48

export fn procedure_s_general_cnf_sat(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = procedure_s_general_cnf_sat_impl
