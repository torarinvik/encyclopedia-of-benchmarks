# Encode all primes through an inclusive limit as comma-separated decimal bytes.
def is_prime(value: i64) -> bool:
    if value < 2:
        return false
    divisor: mutable i64 = 2
    quotient: mutable i64 = value / divisor
    while divisor <= quotient:
        if value - quotient * divisor == 0:
            return false
        divisor <- divisor + 1
        quotient <- value / divisor
    true

def decimal_length(value: i64) -> usize:
    length: mutable usize = 1
    remaining: mutable i64 = value
    while remaining >= 10:
        remaining <- remaining / 10
        length <- length + 1
    length

def required_length(limit: i64) -> usize:
    length: mutable usize = 0
    count: mutable usize = 0
    value: mutable i64 = 2
    while value <= limit:
        if is_prime(value):
            length <- length + decimal_length(value)
            length <- length + 1 if count > 0
            count <- count + 1
        value <- value + 1
    length

def append_decimal(value: i64, output: mutable u8&, position_value: usize) -> usize:
    digits: mutable u8[3]
    count: mutable usize = 0
    remaining: mutable i64 = value
    while remaining > 0:
        digits[count] <- (48 + remaining % 10).u8()
        count <- count + 1
        remaining <- remaining / 10
    position: mutable usize = position_value
    while count > 0:
        count <- count - 1
        output[position] <- digits[count]
        position <- position + 1
    position

def prime_numbers_impl(limit: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if limit < 0 or limit > 80:
        return -1
    required: usize = required_length(limit)
    if output == null or output_capacity < required:
        return -2
    return 0 if required == 0
    position: mutable usize = 0
    count: mutable usize = 0
    value: mutable i64 = 2
    while value <= limit:
        if is_prime(value):
            if count > 0:
                output[position] <- 44.u8()
                position <- position + 1
            position <- append_decimal(value, output, position)
            count <- count + 1
        value <- value + 1
    position.i64()

export fn prime_numbers(limit: i64, output: mutable u8&, output_capacity: usize) -> i64 = prime_numbers_impl
