const MAX_MESSAGE_LENGTH: usize = 64
const MAX_INPUT_LENGTH: usize = 98
const LIMB_MASK: u64 = 0x3ffffff

def poly1305_load32(bytes: view[u8], offset: usize) -> u64:
    bytes[offset].u64() or (bytes[offset + 1].u64() << 8) or
        (bytes[offset + 2].u64() << 16) or (bytes[offset + 3].u64() << 24)

def poly1305_store32(output: mutable view[u8], offset: usize, value: u64) -> void:
    for byte in 0..<4 |output, value|:
        output[offset + byte] <- ((value >> (8 * byte)) & 255).u8()

def poly1305_tag(key: view[u8], message: view[u8], message_length: usize,
        tag: mutable view[u8]) -> void:
    r0: u64 = poly1305_load32(key, 0) & 0x3ffffff
    r1: u64 = (poly1305_load32(key, 3) >> 2) & 0x3ffff03
    r2: u64 = (poly1305_load32(key, 6) >> 4) & 0x3ffc0ff
    r3: u64 = (poly1305_load32(key, 9) >> 6) & 0x3f03fff
    r4: u64 = (poly1305_load32(key, 12) >> 8) & 0x00fffff
    s1: u64 = r1 * 5
    s2: u64 = r2 * 5
    s3: u64 = r3 * 5
    s4: u64 = r4 * 5
    h0: mutable u64 = 0
    h1: mutable u64 = 0
    h2: mutable u64 = 0
    h3: mutable u64 = 0
    h4: mutable u64 = 0
    offset: mutable usize = 0
    while offset < message_length |message, h0, h1, h2, h3, h4, offset|:
        block: mutable u8[16] = zeroed
        block_length: mutable usize = message_length - offset
        if block_length > 16:
            block_length <- 16
        for i in 0..<block_length |block, message|:
            block[i] <- message[offset + i]
        high_bit: mutable u64 = u64(1) << 24
        if block_length < 16:
            block[block_length] <- 1
            high_bit <- 0
        block_view: view[u8] = block[0:16]
        h0 <- h0 + (poly1305_load32(block_view, 0) & LIMB_MASK)
        h1 <- h1 + ((poly1305_load32(block_view, 3) >> 2) & LIMB_MASK)
        h2 <- h2 + ((poly1305_load32(block_view, 6) >> 4) & LIMB_MASK)
        h3 <- h3 + ((poly1305_load32(block_view, 9) >> 6) & LIMB_MASK)
        h4 <- h4 + ((poly1305_load32(block_view, 12) >> 8) or high_bit)
        d0: u64 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
        d1: u64 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
        d2: u64 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
        d3: u64 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
        d4: u64 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
        carry: mutable u64 = d0 >> 26
        h0 <- d0 & LIMB_MASK
        q1: u64 = d1 + carry
        carry <- q1 >> 26
        h1 <- q1 & LIMB_MASK
        q2: u64 = d2 + carry
        carry <- q2 >> 26
        h2 <- q2 & LIMB_MASK
        q3: u64 = d3 + carry
        carry <- q3 >> 26
        h3 <- q3 & LIMB_MASK
        q4: u64 = d4 + carry
        carry <- q4 >> 26
        h4 <- q4 & LIMB_MASK
        h0 <- h0 + carry * 5
        carry <- h0 >> 26
        h0 <- h0 & LIMB_MASK
        h1 <- h1 + carry
        offset <- offset + block_length
    for pass in 0..<3 |h0, h1, h2, h3, h4|:
        carry: mutable u64 = h0 >> 26
        h0 <- h0 & LIMB_MASK
        h1 <- h1 + carry
        carry <- h1 >> 26
        h1 <- h1 & LIMB_MASK
        h2 <- h2 + carry
        carry <- h2 >> 26
        h2 <- h2 & LIMB_MASK
        h3 <- h3 + carry
        carry <- h3 >> 26
        h3 <- h3 & LIMB_MASK
        h4 <- h4 + carry
        carry <- h4 >> 26
        h4 <- h4 & LIMB_MASK
        h0 <- h0 + carry * 5
        carry <- h0 >> 26
        h0 <- h0 & LIMB_MASK
        h1 <- h1 + carry
    if h4 == LIMB_MASK and h3 == LIMB_MASK and h2 == LIMB_MASK and h1 == LIMB_MASK and h0 >= LIMB_MASK - 4:
        h0 <- h0 - (LIMB_MASK - 4)
        h1 <- 0
        h2 <- 0
        h3 <- 0
        h4 <- 0
    f0: u64 = ((h0 or (h1 << 26)) & 0xffffffff) + poly1305_load32(key, 16)
    f1: u64 = ((h1 >> 6 or (h2 << 20)) & 0xffffffff) + poly1305_load32(key, 20) + (f0 >> 32)
    f2: u64 = ((h2 >> 12 or (h3 << 14)) & 0xffffffff) + poly1305_load32(key, 24) + (f1 >> 32)
    f3: u64 = ((h3 >> 18 or (h4 << 8)) & 0xffffffff) + poly1305_load32(key, 28) + (f2 >> 32)
    poly1305_store32(tag, 0, f0)
    poly1305_store32(tag, 4, f1)
    poly1305_store32(tag, 8, f2)
    poly1305_store32(tag, 12, f3)

def poly1305_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 33 or length > MAX_INPUT_LENGTH:
        return -1
    raw_length: i64 = input[0]
    if raw_length < 0 or raw_length > i64(MAX_MESSAGE_LENGTH) or length != 33 + raw_length.usize():
        return -1
    for i in 1..<length |input|:
        if input[i] < 0 or input[i] > 255:
            return -1
    if output.is_null() or output_capacity < 16:
        return -2
    key: mutable u8[32] = zeroed
    message: mutable u8[MAX_MESSAGE_LENGTH] = zeroed
    tag: mutable u8[16] = zeroed
    for i in 0..<32 |input, key|:
        key[i] <- input[1 + i].u8()
    for i in 0..<raw_length.usize() |input, message|:
        message[i] <- input[33 + i].u8()
    poly1305_tag(key[0:32], message[0:raw_length.usize()], raw_length.usize(), tag[0:16])
    for i in 0..<16 |output, tag|:
        output[i] <- tag[i]
    16

export fn poly1305(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = poly1305_impl
