# Emit Java-style swap-recursion permutations, retaining duplicate rows.
const MAX_LENGTH: usize = 6
const MAX_PARSEABLE_LENGTH: usize = 8

def permutation_array_store_i32(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: u32 = value.u32()
    output[position] <- (bits & 255).u8()
    output[position + 1] <- ((bits >> 8) & 255).u8()
    output[position + 2] <- ((bits >> 16) & 255).u8()
    output[position + 3] <- ((bits >> 24) & 255).u8()

def permutation_array_generate(values: mutable view[i64], n: usize, index: usize,
        output: mutable view[u8], result_count: mutable usize&) -> void:
    if index == n:
        row_start: usize = result_count * n * 4
        column: usize = 0
        while column < n:
            permutation_array_store_i32(values[column], output, row_start + column * 4)
            column <- column + 1
        result_count <- result_count + 1
    else:
        position: mutable usize = index
        while position < n:
            saved: i64 = values[index]
            values[index] <- values[position]
            values[position] <- saved
            permutation_array_generate(values, n, index + 1, output, result_count)
            restore: i64 = values[index]
            values[index] <- values[position]
            values[position] <- restore
            position <- position + 1

def permutation_array_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_PARSEABLE_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > MAX_LENGTH.i64() or length != n_value.usize() + 1:
        return -1
    n: usize = n_value.usize()
    values: mutable i64[MAX_LENGTH] = zeroed
    index: mutable usize = 0
    while index < n:
        value: i64 = input[index + 1]
        if value < -2147483648 or value > 2147483647:
            return -1
        values[index] <- value
        index <- index + 1
    permutation_count: mutable usize = 1
    factor: mutable usize = 2
    while factor <= n:
        permutation_count <- permutation_count * factor
        factor <- factor + 1
    required: usize = permutation_count * n * 4
    if output_capacity < required or (required > 0 and output.is_null()):
        return -2
    result_count: mutable usize = 0
    permutation_array_generate(values[0:n], n, 0, output[0:output_capacity], result_count)
    result_count.i64()

export fn permutation_array(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = permutation_array_impl
