const MIN_N: i64 = 2
const MAX_N: i64 = 46340

def next_value(n: i64, x: i64) -> i64:
    (x * x + 1) % n

def gcd_nonnegative(left_value: i64, right_value: i64) -> i64:
    left: mutable i64 = left_value
    right: mutable i64 = right_value
    while right != 0:
        remainder: i64 = left % right
        left <- right
        right <- remainder
    left

def pollards_rho_factorizing_impl(n: i64) -> i64:
    if n < MIN_N or n > MAX_N: return -1
    x: mutable i64 = 2
    y: mutable i64 = 2
    divisor: mutable i64 = 1
    while divisor == 1:
        x <- next_value(n, x)
        y <- next_value(n, next_value(n, y))
        difference: i64 = if x >= y: x - y else: y - x
        divisor <- gcd_nonnegative(difference, n)
    divisor

export fn pollards_rho_factorizing(n: i64) -> i64 = pollards_rho_factorizing_impl
