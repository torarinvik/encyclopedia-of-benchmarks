# Return source-ordered unit-fraction denominators as little-endian i32s.
def egyptian_fraction_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length != 2:
        return -1
    numerator: mutable i64 = input[0]
    denominator: mutable i64 = input[1]
    if numerator < 0 or denominator < 1 or denominator > 10 or numerator > denominator:
        return -1

    terms: mutable u32[10] = zeroed
    count: mutable usize = 0
    while numerator != 0:
        unit_denominator: mutable i64 = denominator / numerator
        if denominator % numerator != 0:
            unit_denominator <- unit_denominator + 1
        terms[count] <- unit_denominator.u32()
        count <- count + 1
        numerator <- numerator * unit_denominator - denominator
        denominator <- denominator * unit_denominator
    required: usize = count * 4
    if output_capacity < required or (required > 0 and output.is_null()):
        return -2
    index: mutable usize = 0
    while index < count:
        value: u32 = terms[index]
        byte: mutable usize = 0
        while byte < 4:
            output[index * 4 + byte] <- ((value >> (byte * 8)) & 255).u8()
            byte <- byte + 1
        index <- index + 1
    required.i64()

export fn egyptian_fraction(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = egyptian_fraction_impl
