# Construct a directed Eulerian path with iterative Hierholzer traversal.
const MAX_VERTICES: usize = 32
const MAX_EDGES: usize = 256

def eulerian_path_put_i64(output: mutable view[u8], byte_offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[byte_offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def eulerian_path_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or input[0] < 0 or input[0] > MAX_VERTICES.i64() or input[1] < 0 or input[1] > MAX_EDGES.i64():
        return -1
    vertices: usize = input[0].usize()
    edges: usize = input[1].usize()
    if length != 2 + 2 * edges:
        return -1

    adjacency: mutable u8[MAX_VERTICES * MAX_EDGES] = zeroed
    in_degree: mutable usize[MAX_VERTICES] = zeroed
    out_degree: mutable usize[MAX_VERTICES] = zeroed
    edge: mutable usize = 0
    while edge < edges:
        source: i64 = input[2 + 2 * edge]
        destination: i64 = input[3 + 2 * edge]
        if source < 0 or source >= vertices.i64() or destination < 0 or destination >= vertices.i64():
            return -1
        source_index: usize = source.usize()
        destination_index: usize = destination.usize()
        adjacency[source_index * MAX_EDGES + out_degree[source_index]] <- destination_index.u8()
        out_degree[source_index] <- out_degree[source_index] + 1
        in_degree[destination_index] <- in_degree[destination_index] + 1
        edge <- edge + 1
    if edges == 0:
        return 0

    start: mutable usize = 0
    start_count: mutable usize = 0
    end_count: mutable usize = 0
    vertex: mutable usize = 0
    while vertex < vertices:
        difference: i64 = out_degree[vertex].i64() - in_degree[vertex].i64()
        if difference == 1:
            start <- vertex
            start_count <- start_count + 1
        else if difference == -1:
            end_count <- end_count + 1
        else if difference != 0:
            return 0
        vertex <- vertex + 1
    if not ((start_count == 0 and end_count == 0) or (start_count == 1 and end_count == 1)):
        return 0
    if start_count == 0:
        while start < vertices and out_degree[start] == 0:
            start <- start + 1
        if start == vertices:
            return 0

    remaining: mutable usize[MAX_VERTICES] = zeroed
    vertex <- 0
    while vertex < vertices:
        remaining[vertex] <- out_degree[vertex]
        vertex <- vertex + 1
    stack: mutable usize[MAX_EDGES + 1] = zeroed
    reverse_path: mutable usize[MAX_EDGES + 1] = zeroed
    top: mutable usize = 1
    path_count: mutable usize = 0
    stack[0] <- start
    while top > 0:
        current: usize = stack[top - 1]
        if remaining[current] > 0:
            remaining[current] <- remaining[current] - 1
            next: usize = adjacency[current * MAX_EDGES + remaining[current]].usize()
            stack[top] <- next
            top <- top + 1
        else:
            top <- top - 1
            reverse_path[path_count] <- stack[top]
            path_count <- path_count + 1
    if path_count != edges + 1:
        return 0
    bytes: usize = path_count * 8
    if output == null or capacity < bytes:
        return -2
    index: mutable usize = 0
    while index < path_count:
        eulerian_path_put_i64(output[0:bytes], index * 8, reverse_path[path_count - index - 1].i64())
        index <- index + 1
    bytes.i64()

export fn eulerian_path(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = eulerian_path_impl
