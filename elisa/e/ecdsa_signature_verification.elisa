@fieldwise_init
struct EcdsaPoint:
    infinity: bool
    x: i64
    y: i64

def ecdsa_mod(value_input: i64, modulus: i64) -> i64:
    value: mutable i64 = value_input % modulus
    if value < 0: value <- value + modulus
    value

def ecdsa_inverse(value_input: i64, modulus: i64) -> i64:
    old_r: mutable i64 = modulus
    r: mutable i64 = ecdsa_mod(value_input, modulus)
    old_t: mutable i64 = 0
    t: mutable i64 = 1
    while r != 0:
        quotient: i64 = old_r / r
        next_r: i64 = old_r - quotient * r
        next_t: i64 = old_t - quotient * t
        old_r <- r
        r <- next_r
        old_t <- t
        t <- next_t
    if old_r != 1: return 0
    ecdsa_mod(old_t, modulus)

def ecdsa_infinity() -> EcdsaPoint:
    EcdsaPoint(infinity=true, x=0, y=0)

def ecdsa_add(left: EcdsaPoint, right: EcdsaPoint) -> EcdsaPoint:
    if left.infinity: return right
    if right.infinity: return left
    if left.x == right.x and ecdsa_mod(left.y + right.y, 17) == 0: return ecdsa_infinity()
    numerator: mutable i64 = 0
    denominator: mutable i64 = 0
    if left.x == right.x and left.y == right.y:
        numerator <- ecdsa_mod(3 * left.x * left.x + 2, 17)
        denominator <- ecdsa_mod(2 * left.y, 17)
    else:
        numerator <- ecdsa_mod(right.y - left.y, 17)
        denominator <- ecdsa_mod(right.x - left.x, 17)
    slope: i64 = ecdsa_mod(numerator * ecdsa_inverse(denominator, 17), 17)
    x: i64 = ecdsa_mod(slope * slope - left.x - right.x, 17)
    y: i64 = ecdsa_mod(slope * (left.x - x) - left.y, 17)
    EcdsaPoint(infinity=false, x=x, y=y)

def ecdsa_multiply(point_input: EcdsaPoint, scalar_input: i64) -> EcdsaPoint:
    point: mutable EcdsaPoint = point_input
    scalar: mutable i64 = scalar_input
    result: mutable EcdsaPoint = ecdsa_infinity()
    while scalar > 0:
        if (scalar & 1) != 0: result <- ecdsa_add(result, point)
        scalar <- scalar >> 1
        if scalar > 0: point <- ecdsa_add(point, point)
    result

def ecdsa_on_curve(point: EcdsaPoint) -> bool:
    ecdsa_mod(point.y * point.y - point.x * point.x * point.x - 2 * point.x - 2, 17) == 0

def ecdsa_evaluate(values: view[i64]) -> i64:
    p: i64 = values[0]
    a: i64 = values[1]
    b: i64 = values[2]
    gx: i64 = values[3]
    gy: i64 = values[4]
    order: i64 = values[5]
    qx: i64 = values[6]
    qy: i64 = values[7]
    digest: i64 = values[8]
    r: i64 = values[9]
    s: i64 = values[10]
    if p != 17 or a != 2 or b != 2 or gx != 5 or gy != 1 or order != 19: return -1
    if ecdsa_mod(4 * a * a * a + 27 * b * b, p) == 0: return -1
    if qx < 0 or qx >= p or qy < 0 or qy >= p: return -1
    if digest < 0 or digest > 31 or r < 1 or r >= order or s < 1 or s >= order: return -1
    base: EcdsaPoint = EcdsaPoint(infinity=false, x=gx, y=gy)
    public: EcdsaPoint = EcdsaPoint(infinity=false, x=qx, y=qy)
    if not ecdsa_on_curve(base) or not ecdsa_on_curve(public): return -1
    if not ecdsa_multiply(base, order).infinity or not ecdsa_multiply(public, order).infinity: return -1
    w: i64 = ecdsa_inverse(s, order)
    if w == 0: return -1
    u1: i64 = digest * w % order
    u2: i64 = r * w % order
    check: EcdsaPoint = ecdsa_add(ecdsa_multiply(base, u1), ecdsa_multiply(public, u2))
    if not check.infinity and check.x % order == r: return 1
    0

def ecdsa_signature_verification_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length != 11: return -1
    values: view[i64] = input[0:length]
    result: i64 = ecdsa_evaluate(values)
    if result < 0: return -1
    if output.is_null() or capacity < 1: return -2
    target: mutable view[u8] = output[0:1]
    target[0] <- result.u8()
    1

export fn ecdsa_signature_verification(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = ecdsa_signature_verification_impl
