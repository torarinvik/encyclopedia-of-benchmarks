# Convert an ASCII Excel column title to its one-based column number.
def excel_title_to_column_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 13:
        return -1
    count: i64 = values[0]
    if count < 1 or count > 12 or length != (1 + count).usize():
        return -1

    column: mutable i64 = 0
    index: mutable i64 = 0
    while index < count:
        letter: mutable i64 = values[1 + index.usize()]
        if letter >= 97 and letter <= 122:
            letter <- letter - 32
        if letter < 65 or letter > 90:
            return -1
        column <- column * 26 + (letter - 65 + 1)
        index <- index + 1
    column

export fn excel_title_to_column(values: i64&, length: usize) -> i64 = excel_title_to_column_impl
