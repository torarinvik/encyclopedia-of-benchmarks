extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def put_f64_le(output: mutable view[u8], offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    byte_index: mutable usize = 0
    while byte_index < 8:
        output[offset + byte_index] <- (bits & 255).u8()
        bits <- bits >> 8
        byte_index <- byte_index + 1

def euler_method_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length != 4: return -1
    if input[0] < -8 or input[0] > 8 or input[1] < -8 or input[1] > 8 or input[2] < 1 or input[2] > 4 or input[3] < 1 or input[3] > 16: return -1
    steps: usize = input[3].usize()
    required: usize = 8 * (steps + 1)
    if output.is_null() or capacity < required: return -2
    h: mutable f64 = 1.0
    exponent: mutable i64 = 0
    while exponent < input[2]:
        h <- h / 2.0
        exponent <- exponent + 1
    x: mutable f64 = input[0].f64()
    y: mutable f64 = input[1].f64()
    put_f64_le(output[0:required], 0, y)
    step: mutable usize = 0
    while step < steps:
        y <- y + h * (x + y)
        x <- x + h
        put_f64_le(output[0:required], 8 * (step + 1), y)
        step <- step + 1
    required.i64()

export fn euler_method(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = euler_method_impl
