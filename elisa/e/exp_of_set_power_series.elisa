const MODULUS: i64 = 998244353
const MAX_N: usize = 5
const MAX_SIZE: usize = 32
const MAX_INPUT: usize = 33
const MAX_OUTPUT: usize = 256

def subset_size(mask: usize) -> usize:
    value: mutable usize = mask
    count: mutable usize = 0
    while value > 0:
        count <- count + (value & 1)
        value <- value >> 1
    return count

def store_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def exp_of_set_power_series_impl(
    input: view[i64], length: usize, output: mutable view[u8],
    capacity: usize, output_is_null: bool,
) -> i64:
    if length < 2 or length > MAX_INPUT: return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > MAX_N.i64(): return -1
    n: usize = n_value.usize()
    size: usize = 1 << n
    if length != 1 + size or input[1] != 0: return -1
    for mask in 0..<size:
        coefficient: i64 = input[1 + mask]
        if coefficient < 0 or coefficient >= MODULUS: return -1

    bytes: usize = 8 * size
    if output_is_null or capacity < bytes: return -2

    inverse: mutable [MAX_N + 1]i64 = [0; MAX_N + 1]
    values: mutable [MAX_SIZE]i64 = [0; MAX_SIZE]
    if n > 0: inverse[1] <- 1
    if n >= 2:
        for k in 2..<(n + 1):
            remainder: usize = (MODULUS % k.i64()).usize()
            inverse[k] <- MODULUS - (MODULUS / k.i64()) * inverse[remainder] % MODULUS
    values[0] <- 1
    for mask in 1..<size:
        total: mutable i64 = 0
        subset: mutable usize = mask
        while subset > 0:
            term: i64 = subset_size(subset).i64() * input[1 + subset] % MODULUS
            term <- term * values[mask ^ subset] % MODULUS
            total <- (total + term) % MODULUS
            subset <- (subset - 1) & mask
        values[mask] <- total * inverse[subset_size(mask)] % MODULUS
    for mask in 0..<size:
        store_le(values[mask], output, 8 * mask)
    return bytes.i64()

export fn exp_of_set_power_series(
    input: i64&, length: usize, output: mutable u8&, capacity: usize,
) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return exp_of_set_power_series_impl(input_view, length, scratch[0:1], capacity, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > MAX_OUTPUT: safe_capacity <- MAX_OUTPUT
    output_view: mutable view[u8] = output[0:safe_capacity]
    exp_of_set_power_series_impl(input_view, length, output_view, capacity, false)
