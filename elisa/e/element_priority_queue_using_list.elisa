const MAX_OPERATIONS: usize = 256
const MAX_INPUT_LENGTH: usize = 514

def element_priority_queue_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255.u64()).u8()

def element_priority_queue_using_list_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    operation_count_value: i64 = input[0]
    if operation_count_value < 0 or operation_count_value > 256 or length != 1 + 2 * operation_count_value.usize():
        return -1
    operation_count: usize = operation_count_value.usize()
    queue: mutable i32[100] = zeroed
    queue_count: mutable usize = 0
    dequeued: mutable i64[128] = zeroed
    dequeued_count: mutable usize = 0
    for index in 0..<operation_count:
        opcode: i64 = input[1 + 2 * index]
        argument: i64 = input[2 + 2 * index]
        if opcode == 0:
            if argument < -2147483648 or argument > 2147483647 or queue_count == 100:
                return -1
            queue[queue_count] <- argument.i32()
            queue_count <- queue_count + 1
        else if opcode == 1:
            if argument != 0 or queue_count == 0:
                return -1
            minimum: mutable usize = 0
            for position in 1..<queue_count:
                if queue[position] < queue[minimum]:
                    minimum <- position
            dequeued[dequeued_count] <- queue[minimum].i64()
            dequeued_count <- dequeued_count + 1
            queue_count <- queue_count - 1
            for position in minimum..<queue_count:
                queue[position] <- queue[position + 1]
        else:
            return -1
    output_bytes: usize = dequeued_count * 8
    if output == null or capacity < output_bytes:
        return -2
    for index in 0..<dequeued_count:
        element_priority_queue_store_i64(&output[0], index * 8, dequeued[index])
    output_bytes.i64()

export fn element_priority_queue_using_list(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = element_priority_queue_using_list_impl
