const EDS_MAX_VERTICES: usize = 12
const EDS_MAX_PARSEABLE_INPUT: usize = 135

def eds_popcount(bits0: usize) -> i64:
    bits: mutable usize = bits0
    count: mutable i64 = 0
    while bits != 0:
        bits <- bits & (bits - 1)
        count <- count + 1
    count

def eds_weighted_mis(square: usize[12], weights: i64[12], n: usize,
                     remaining: usize, current: i64, best: mutable i64&) -> void:
    upper: mutable i64 = current
    for vertex in 0..<n:
        if (remaining & (1 << vertex)) != 0: upper <- upper + weights[vertex]
    if upper <= best: return
    if remaining == 0:
        best <- current
        return
    branch: mutable usize = 0
    branch_degree: mutable i64 = -1
    for vertex in 0..<n:
        bit: usize = 1 << vertex
        if (remaining & bit) == 0: continue
        degree: i64 = eds_popcount(square[vertex] & remaining)
        if degree > branch_degree:
            branch <- vertex
            branch_degree <- degree
    bit: usize = 1 << branch
    eds_weighted_mis(square, weights, n, remaining & ~bit & ~square[branch],
                     current + weights[branch], best&)
    eds_weighted_mis(square, weights, n, remaining & ~bit, current, best&)

export def efficient_dominating_set_square_graph_mwis(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > EDS_MAX_PARSEABLE_INPUT: return -1
    values: view[i64] = input[0:length]
    n64: i64 = values[0]
    m64: i64 = values[1]
    if n64 < 1 or n64 > 12 or m64 < 0 or m64 > n64 * (n64 - 1) / 2: return -1
    if length != (2 + 2 * m64).usize(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    adjacency: mutable usize[12] = zeroed
    for edge in 0..<m:
        u64: i64 = values[2 + 2 * edge]
        v64: i64 = values[3 + 2 * edge]
        if u64 < 0 or u64 >= v64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        bit: usize = 1 << v
        if (adjacency[u] & bit) != 0: return -1
        adjacency[u] <- adjacency[u] | bit
        adjacency[v] <- adjacency[v] | (1 << u)
    square: mutable usize[12] = zeroed
    weights: mutable i64[12] = zeroed
    for vertex in 0..<n:
        square[vertex] <- adjacency[vertex]
        for neighbor in 0..<n:
            if (adjacency[vertex] & (1 << neighbor)) != 0:
                square[vertex] <- square[vertex] | adjacency[neighbor]
        square[vertex] <- square[vertex] & ~(1 << vertex)
        weights[vertex] <- eds_popcount(adjacency[vertex]) + 1
    best: mutable i64 = 0
    all_vertices: usize = (1 << n) - 1
    eds_weighted_mis(square, weights, n, all_vertices, 0, best&)
    if best == n64: return 1
    0
