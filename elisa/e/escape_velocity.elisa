# Escape velocity with the source's three-decimal result rounding.
extern sqrt(value: f64) -> f64
extern floor(value: f64) -> f64
extern fma(first: f64, second: f64, third: f64) -> f64

def round_three_even(value: f64) -> f64:
    scaled: f64 = value * 1000.0
    lower: f64 = floor(scaled)
    midpoint: f64 = lower + 0.5
    exact_side: f64 = fma(value, 1000.0, -midpoint)
    rounded: i64 = lower.i64()
    if exact_side > 0.0 or (exact_side == 0.0 and rounded % 2 != 0):
        rounded = rounded + 1
    rounded.f64() / 1000.0

def escape_velocity_impl(values: i64&, length: usize) -> f64:
    if length != 2:
        return -1.0e300
    mass: i64 = values[0]
    radius: i64 = values[1]
    if mass < 0 or mass > 1000000000000000 or radius < 1 or radius > 1000000000:
        return -1.0e300
    velocity: f64 = sqrt(2.0 * 6.67430e-11 * mass.f64() / radius.f64())
    round_three_even(velocity)

export fn escape_velocity(values: i64&, length: usize) -> f64 = escape_velocity_impl
