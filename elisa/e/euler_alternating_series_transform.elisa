const MAX_TERMS: usize = 16
const MAX_WORDS: usize = 18
const VALUE_LIMIT: i64 = 1000000
const OUTPUT_BYTES: usize = 16

def euler_gcd(left_value: u64, right_value: u64) -> u64:
    left: mutable u64 = left_value
    right: mutable u64 = right_value
    while right != 0:
        remainder: u64 = left % right
        left <- right
        right <- remainder
    left

def euler_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def euler_validate(input: i64&, length: usize) -> bool:
    if length < 2 or length > MAX_WORDS:
        return false
    n_value: i64 = input[0]
    if n_value < 1 or n_value > MAX_TERMS.i64():
        return false
    n: usize = n_value.usize()
    if length != n + 1:
        return false
    for index in 0..<n:
        if input[index + 1] < -VALUE_LIMIT or input[index + 1] > VALUE_LIMIT:
            return false
    true

def euler_alternating_series_transform_impl(input: i64&,
        output: mutable u8&, output_capacity: usize) -> i64:
    if output_capacity < OUTPUT_BYTES:
        return -2
    n: usize = input[0].usize()
    numerator: mutable i64 = 0
    for order in 0..<n:
        difference: mutable i64 = 0
        coefficient: mutable i64 = 1
        for index in 0..<(order + 1):
            term: i64 = input[order - index + 1]
            if index % 2 == 0:
                difference <- difference + coefficient * term
            else:
                difference <- difference - coefficient * term
            if index < order:
                coefficient <- coefficient * (order - index).i64() / (index + 1).i64()
        weight: i64 = 1.i64() << (n - order - 1)
        weighted: i64 = difference * weight
        if order % 2 == 0:
            numerator <- numerator + weighted
        else:
            numerator <- numerator - weighted

    denominator: mutable i64 = 1.i64() << n
    magnitude: u64 = (-numerator).u64() if numerator < 0 else numerator.u64()
    divisor: u64 = euler_gcd(magnitude, denominator.u64())
    numerator <- numerator / divisor.i64()
    denominator <- denominator / divisor.i64()
    euler_store_i64(output, 0, numerator)
    euler_store_i64(output, 8, denominator)
    OUTPUT_BYTES.i64()

def euler_alternating_series_transform_entry(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > MAX_WORDS:
        return -1
    if not euler_validate(input, length):
        return -1
    if output == null:
        return -2
    if output_capacity < OUTPUT_BYTES:
        return -2
    euler_alternating_series_transform_impl(
        input, output, output_capacity)

export fn euler_alternating_series_transform(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = euler_alternating_series_transform_entry
