# Gregorian Easter date packed as month * 100 + day.
def easter_impl(year: i64) -> i64:
    if year < 0 or year > 9999:
        return -1
    if year <= 1582:
        return 0
    a: i64 = year % 19
    b: i64 = year / 100
    c: i64 = year % 100
    d: i64 = b / 4
    e: i64 = b % 4
    f: i64 = (b + 8) / 25
    g: i64 = (b - f + 1) / 3
    h: i64 = (19 * a + b - d - g + 15) % 30
    i: i64 = c / 4
    k: i64 = c % 4
    r: i64 = (32 + 2 * e + 2 * i - h - k) % 7
    m: i64 = (a + 11 * h + 22 * r) / 451
    date: i64 = h + r - 7 * m + 114
    month: i64 = date / 31
    day: i64 = date % 31 + 1
    month * 100 + day

export fn easter(year: i64) -> i64 = easter_impl
