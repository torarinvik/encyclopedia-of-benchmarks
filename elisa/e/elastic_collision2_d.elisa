const INVALID: i64 = -1
def elastic_collision2_d_impl(v: i64&, n: usize) -> i64:
    if n != 12: return INVALID
    if v == null: return INVALID
    if v[0] < -200000 or v[0] > 200000 or v[1] < -200000 or v[1] > 200000 or v[6] < -200000 or v[6] > 200000 or v[7] < -200000 or v[7] > 200000: return INVALID
    if v[2] < -5000 or v[2] > 5000 or v[3] < -5000 or v[3] > 5000 or v[8] < -5000 or v[8] > 5000 or v[9] < -5000 or v[9] > 5000: return INVALID
    if v[4] < 1000 or v[4] > 100000 or v[10] < 1000 or v[10] > 100000: return INVALID
    if v[5] < 1 or v[5] > 10000 or v[11] < 1 or v[11] > 10000: return INVALID
    dx: f64 = (v[6] - v[0]).f64()
    dy: f64 = (v[7] - v[1]).f64()
    radius_squared: f64 = dx * dx + dy * dy
    if radius_squared == 0.0: return INVALID
    dist: mutable f64 = radius_squared
    if dist < 1.0: dist <- 1.0
    for iteration in 0..<40:
        dist <- (dist + radius_squared / dist) * 0.5
    if dist == 0.0: return INVALID
    ox: mutable f64 = v[2].f64()
    oy: mutable f64 = v[3].f64()
    if not (dist < (v[5] + v[11]).f64()):
        nx: f64 = dx / dist
        ny: f64 = dy / dist
        rv: f64 = (v[8] - v[2]).f64() * nx + (v[9] - v[3]).f64() * ny
        if rv <= 0.0:
            m1: f64 = v[4].f64()
            m2: f64 = v[10].f64()
            j: f64 = -2.0 * rv / (1.0 / m1 + 1.0 / m2)
            ox <- ox - j * nx / m1
            oy <- oy - j * ny / m1
    rounded_x: f64 = ox + 0.5
    rounded_y: f64 = oy + 0.5
    qx: mutable i64 = rounded_x.i64()
    qy: mutable i64 = rounded_y.i64()
    if rounded_x < 0.0 and qx.f64() != rounded_x: qx <- qx - 1
    if rounded_y < 0.0 and qy.f64() != rounded_y: qy <- qy - 1
    if qx < -32768 or qx > 32767 or qy < -32768 or qy > 32767: return INVALID
    ((qx & 0xffff) << 16) | (qy & 0xffff)

export fn elastic_collision2_d(v: i64&, n: usize) -> i64 = elastic_collision2_d_impl
