const MAX_PARSEABLE_LENGTH = 2
const MAX_N: i64 = 8

def euclid_mullin_least_prime_factor(value: i64) -> i64:
    divisor: mutable i64 = 2
    while divisor <= value / divisor:
        if value % divisor == 0: return divisor
        divisor <- divisor + 1
    value

def euclid_mullin_term(index: i64) -> i64:
    product: mutable i64 = 1
    term: mutable i64 = 1
    position: mutable i64 = 0
    while position < index:
        term <- euclid_mullin_least_prime_factor(product + 1)
        product <- product * term
        position <- position + 1
    term

def euclid_mullin_impl(input: i64&, input_length: usize) -> i64:
    if input_length != 1: return -1
    index: i64 = input[0]
    if index < 1 or index > MAX_N: return -1
    euclid_mullin_term(index)

def euclid_mullin_sequence_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_PARSEABLE_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    return euclid_mullin_impl(input_view, input_view_length)

export fn euclid_mullin_sequence(input: i64&, length: usize) -> i64 = euclid_mullin_sequence_impl
