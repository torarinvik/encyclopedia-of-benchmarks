# Return the first index with equal left and right sums.
const MAX_LENGTH: usize = 1024
const MIN_I32: i64 = -2147483648
const MAX_I32: i64 = 2147483647

def equilibrium_index_in_array_impl(values: i64&, length: usize) -> i64:
    if length < 1 or length > MAX_LENGTH + 1:
        return -2
    n: i64 = values[0]
    if n < 0 or n > i64(MAX_LENGTH) or length != usize(n) + 1:
        return -2
    total: mutable i64 = 0
    index: mutable usize = 1
    while index < length:
        value: i64 = values[index]
        if value < MIN_I32 or value > MAX_I32:
            return -2
        total <- total + value
        index <- index + 1
    left: mutable i64 = 0
    index <- 0
    while index < usize(n):
        value: i64 = values[index + 1]
        total <- total - value
        if left == total:
            return i64(index)
        left <- left + value
        index <- index + 1
    -1

export fn equilibrium_index_in_array(values: i64&, length: usize) -> i64 = equilibrium_index_in_array_impl
