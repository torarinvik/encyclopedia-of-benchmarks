def euler(v: i64&, n: usize) -> i64:
    if v.is_null() or n < 4 or n > 516: return -2
    count: i64 = v[0]; source: i64 = v[1]; dest: i64 = v[2]; edges: i64 = v[3]
    if count < 1 or count > 32 or source < 0 or source >= count or dest < 0 or dest >= count or edges < 0 or edges > 256 or n != (4 + 2 * edges).usize(): return -2
    adj: mutable u64[32] = zeroed; degree: mutable i64[32] = zeroed
    for i in 0..<edges.usize():
        x: i64 = v[4 + 2*i]; y: i64 = v[5 + 2*i]
        if x < 0 or y < 0 or x >= count or y >= count or x == y: return -2
        bx: u64 = 1 << x.usize(); by: u64 = 1 << y.usize()
        if (adj[x.usize()] & by) != 0: return -2
        adj[x.usize()] <- adj[x.usize()] | by; adj[y.usize()] <- adj[y.usize()] | bx
        degree[x.usize()] <- degree[x.usize()] + 1; degree[y.usize()] <- degree[y.usize()] + 1
    active: mutable bool = false
    for i in 0..<count.usize(): if degree[i] > 0: active <- true
    if active:
        start: mutable usize = 0
        while degree[start] == 0: start <- start + 1
        queue: mutable usize[32] = zeroed; head: mutable usize = 0; tail: mutable usize = 1; queue[0] <- start
        seen: mutable u64 = 1 << start
        while head < tail:
            u: usize = queue[head]; head <- head + 1
            for w in 0..<count.usize():
                if ((adj[u] >> w) & 1) != 0 and ((seen >> w) & 1) == 0:
                    seen <- seen | (1 << w); queue[tail] <- w; tail <- tail + 1
        for i in 0..<count.usize(): if degree[i] > 0 and ((seen >> i) & 1) == 0: return -2
    odd: mutable i64 = 0
    for i in 0..<count.usize():
        want: bool = source != dest and (i == source.usize() or i == dest.usize())
        is_odd: bool = degree[i] % 2 != 0
        if is_odd != want: return 0
        if is_odd: odd <- odd + 1
    if source == dest:
        if odd == 0: return 1
        return 0
    if odd == 2: return 1
    0
export fn euler(v: i64&, n: usize) -> i64 = euler
