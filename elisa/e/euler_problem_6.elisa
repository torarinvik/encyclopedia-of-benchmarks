const MAX_N: i64 = 100
const MAX_PARSEABLE_INPUT_LENGTH: usize = 2

def euler_problem_6_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    if length != 1 or input[0] < 1 or input[0] > MAX_N:
        return -1

    sum: mutable i64 = 0
    sum_of_squares: mutable i64 = 0
    value: mutable i64 = 1
    while value <= input[0]:
        sum <- sum + value
        sum_of_squares <- sum_of_squares + value * value
        value <- value + 1
    sum * sum - sum_of_squares

export fn euler_problem_6(input: i64&, length: usize) -> i64 = euler_problem_6_impl
