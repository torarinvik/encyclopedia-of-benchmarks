# Encode phi(1) through phi(n) as comma-separated decimal bytes.
def decimal_length(value: i64) -> usize:
    length: mutable usize = 1
    remaining: mutable i64 = value
    while remaining >= 10:
        remaining <- remaining / 10
        length <- length + 1
    length

def append_decimal(value_input: i64, output: mutable view[u8], position_input: usize) -> usize:
    digits: mutable u8[3] = zeroed
    count: mutable usize = 0
    value: mutable i64 = value_input
    while true:
        digits[count] <- (48 + (value % 10).u8()).u8()
        count <- count + 1
        value <- value / 10
        if value == 0:
            break
    position: mutable usize = position_input
    while count > 0:
        count <- count - 1
        output[position] <- digits[count]
        position <- position + 1
    position

def euler_totient_sequence_impl(n: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if n < 1 or n > 80:
        return -1
    phi: mutable i64[81] = zeroed
    value: mutable i64 = 1
    while value <= n:
        remaining: mutable i64 = value
        totient: mutable i64 = value
        p: mutable i64 = 2
        while p * p <= remaining:
            if remaining % p == 0:
                while remaining % p == 0:
                    remaining <- remaining / p
                totient <- totient - totient / p
            p <- p + 1
        if remaining > 1:
            totient <- totient - totient / remaining
        phi[value.usize()] <- totient
        value <- value + 1
    i: mutable i64 = 1
    required: mutable usize = (n - 1).usize()
    i <- 1
    while i <= n:
        required <- required + decimal_length(phi[i.usize()])
        i <- i + 1
    if output_capacity < required:
        return -2
    position: mutable usize = 0
    i <- 1
    while i <= n:
        if i > 1:
            output[position] <- 44
            position <- position + 1
        position <- append_decimal(phi[i.usize()], output[0:required], position)
        i <- i + 1
    position.i64()

export fn euler_totient_sequence(n: i64, output: mutable u8&, output_capacity: usize) -> i64 = euler_totient_sequence_impl
