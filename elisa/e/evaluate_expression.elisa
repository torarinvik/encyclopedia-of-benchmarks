extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def put_u32(out: mutable u8&, offset: usize, value: u32) -> void:
    for k in 0..<4:
        out[offset+k] <- ((value >> (k*8)) & 255).u8()

def put_f64(out: mutable u8&, offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for k in 0..<8:
        out[offset+k] <- (bits & 255).u8()
        bits <- bits >> 8

def evaluate_expression_impl(v: i64&, length: usize, out: mutable u8&, capacity: usize) -> i64:
    if v == null or length < 3 or length > 131: return -1
    count: i64 = v[0]
    if count < 1 or count > 64 or length != (1+2*count).usize(): return -1
    stack_value: mutable f64[64]
    depth: mutable i64 = 0
    valid: mutable bool = true
    for i in 0..<count:
        op: i64 = v[1+2*i]
        payload: i64 = v[2+2*i]
        if op == 0:
            if payload < -1000000000 or payload > 1000000000: return -1
            stack_value[depth] <- payload.f64()/1000.0
            depth <- depth+1
        elif op >= 1 and op <= 4:
            if payload != 0: return -1
            if depth < 2:
                valid <- false
                break
            depth <- depth-1
            right: f64 = stack_value[depth]
            depth <- depth-1
            left: f64 = stack_value[depth]
            if op == 1: stack_value[depth] <- left+right
            elif op == 2: stack_value[depth] <- left-right
            elif op == 3: stack_value[depth] <- left*right
            elif right == 0.0:
                valid <- false
                break
            else: stack_value[depth] <- left/right
            depth <- depth+1
        else:
            valid <- false
            break
    valid <- valid and depth == 1
    needed: usize = 12 if valid else 4
    if out == null or capacity < needed: return -2
    put_u32(out, 0, (1 if valid else 0))
    if valid: put_f64(out, 4, stack_value[0])
    needed.i64()

export fn evaluate_expression(v: i64&, length: usize, out: mutable u8&, capacity: usize) -> i64 = evaluate_expression_impl
