# Dispatch the seven pinned Python endianness helpers.
def endianness_signed_u64(bits: u64) -> i64:
    if bits <= 9223372036854775807.u64(): return bits.i64()
    ( -1 - (18446744073709551615.u64() - bits).i64() )

def endianness_swap_bytes(bits: u64, count: usize) -> u64:
    reversed: mutable u64 = 0.u64()
    remaining: mutable u64 = bits
    index: mutable usize = 0
    while index < count:
        reversed <- (reversed << 8) | (remaining & 255.u64())
        remaining <- remaining >> 8
        index <- index + 1
    reversed

def endianness_impl(input: i64&, length: usize) -> i64:
    if length < 1: return -1
    operation: i64 = input[0]
    if operation >= 0 and operation <= 2:
        if length != 2: return -1
        value: i64 = input[1]
        if operation == 0:
            if value < 0 or value > 65535: return -1
            return endianness_swap_bytes(value.u64(), 2).i64()
        if operation == 1:
            if value < 0 or value > 4294967295: return -1
            return endianness_swap_bytes(value.u64(), 4).i64()
        return endianness_signed_u64(endianness_swap_bytes(value.u64(), 8))
    if operation == 3 or operation == 4:
        if length < 3 or input[1] < 1 or input[1] > 8 or length != input[1].usize() + 2: return -1
        count: usize = input[1].usize()
        result: mutable u64 = 0.u64()
        index: usize = 0
        while index < count:
            byte: i64 = input[index + 2]
            if byte < 0 or byte > 255: return -1
            shift: usize = if operation == 3: 8 * index else: 8 * (count - 1 - index)
            result <- result | (byte.u64() << shift)
            index <- index + 1
        return endianness_signed_u64(result)
    if operation == 5 or operation == 6:
        if length != 3 or input[2] < 1 or input[2] > 8: return -1
        count: usize = input[2].usize()
        value: u64 = input[1].u64()
        if count < 8 and (input[1] < 0 or (value >> (8 * count)) != 0.u64()): return -1
        bits: u64 = if operation == 5: value else: endianness_swap_bytes(value, count)
        return endianness_signed_u64(bits)
    -1

export fn endianness(input: i64&, length: usize) -> i64 = endianness_impl
