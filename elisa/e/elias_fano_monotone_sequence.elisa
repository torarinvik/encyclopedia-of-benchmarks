const MAX_VALUES: usize = 32
const MAX_HIGH_BITS: usize = 96
const MAX_INPUT_LENGTH: usize = 35
const MAX_UNIVERSE: i64 = 1000000

def elias_fano_monotone_sequence_impl(values: view[i64]) -> i64:
    if values.len() < 3 or values.len() > MAX_INPUT_LENGTH:
        return -1
    count_value: i64 = values[0]
    upper: i64 = values[1]
    if count_value < 1 or count_value > MAX_VALUES.i64() or upper < 0 or upper > MAX_UNIVERSE:
        return -1
    count: usize = count_value.usize()
    if count_value > upper + 1 or values.len() != count + 2:
        return -1

    source: mutable i64[MAX_VALUES] = zeroed
    index: mutable usize = 0
    while index < count:
        value: i64 = values[index + 2]
        if value < 0 or value > upper:
            return -1
        if index > 0 and value < source[index - 1]:
            return -1
        source[index] <- value
        index <- index + 1

    low_width: mutable usize = 0
    low_power: mutable i64 = 1
    while count_value * low_power * 2 <= upper + 1:
        low_power <- low_power * 2
        low_width <- low_width + 1
    low_mask: i64 = low_power - 1
    low_parts: mutable i64[MAX_VALUES] = zeroed
    high_bits: mutable bool[MAX_HIGH_BITS] = zeroed
    high_length: usize = (upper / low_power).usize() + count
    if high_length > MAX_HIGH_BITS:
        return -1
    index <- 0
    while index < count:
        low_parts[index] <- source[index] & low_mask
        position: usize = (source[index] / low_power).usize() + index
        if position >= high_length:
            return -1
        high_bits[position] <- true
        index <- index + 1

    checksum: mutable i64 = 0
    item_index: mutable usize = 0
    position: mutable usize = 0
    while position < high_length:
        if high_bits[position]:
            if item_index >= count or position < item_index:
                return -1
            high_part: usize = position - item_index
            decoded: i64 = (high_part.i64() << low_width) | low_parts[item_index]
            checksum <- checksum + (item_index + 1).i64() * decoded
            item_index <- item_index + 1
        position <- position + 1
    if item_index != count:
        return -1
    checksum

export fn elias_fano_monotone_sequence(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_INPUT_LENGTH:
        return -1
    elias_fano_monotone_sequence_impl(input[0:length])
