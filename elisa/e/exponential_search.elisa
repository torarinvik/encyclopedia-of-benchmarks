# Exponential search in an ascending sequence for the shared benchmark contract.
def binary_search_range(values: i64&, low: usize, high: usize, target: i64) -> i64:
    found: i64 =
        while low < high |low, high, result: i64 = -1| -> result:
            middle := low + (high - low) / 2
            value := values[middle]
            if value == target:
                break middle.i64()
            if value < target:
                low <- middle + 1
            else:
                high <- middle
    found

def exponential_search_impl(values: i64&, length: usize, target: i64) -> i64:
    if length == 0:
        return -1
    upper: usize =
        while bound < length |bound: usize = 1| -> bound:
            break bound if values[bound] > target
            break length if bound > length / 2
            bound <- bound * 2
    binary_search_range(values, upper / 2, upper, target)

export fn exponential_search(values: i64&, length: usize, target: i64) -> i64 = exponential_search_impl
