# Solve one quantity in conductivity = electron concentration * mobility * charge.
def electric_conductivity_impl(values: i64&, length: usize) -> f64:
    if length != 3:
        return -1.0e300
    conductivity: i64 = values[0]
    electron_conc: i64 = values[1]
    mobility: i64 = values[2]
    if conductivity < 0 or conductivity > 1000 or electron_conc < 0 or electron_conc > 1000 or mobility < 0 or mobility > 1000:
        return -1.0e300
    zeros: mutable i64 = 0
    if conductivity == 0:
        zeros <- zeros + 1
    if electron_conc == 0:
        zeros <- zeros + 1
    if mobility == 0:
        zeros <- zeros + 1
    if zeros != 1:
        return -1.0e300
    charge: f64 = 1.6021e-19
    if conductivity == 0:
        return mobility.f64() * electron_conc.f64() * charge
    if electron_conc == 0:
        return conductivity.f64() / (mobility.f64() * charge)
    return conductivity.f64() / (electron_conc.f64() * charge)

export fn electric_conductivity(values: i64&, length: usize) -> f64 = electric_conductivity_impl
