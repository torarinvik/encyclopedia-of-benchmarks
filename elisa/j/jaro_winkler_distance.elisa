const MAX_STRING_LENGTH: usize = 32
const MAX_INPUT_LENGTH: usize = 2 + 2 * MAX_STRING_LENGTH
const SCALE: i64 = 1_000_000_000

def jaro_winkler_distance_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    first_length_value: i64 = input[0]
    if first_length_value < 0 or first_length_value > 32:
        return -1
    first_length: usize = first_length_value.usize()
    second_length_index: usize = 1 + first_length
    if second_length_index >= length:
        return -1
    second_length_value: i64 = input[second_length_index]
    if second_length_value < 0 or second_length_value > 32 or first_length_value < second_length_value or
        length != second_length_index + 1 + second_length_value.usize():
        return -1
    second_length: usize = second_length_value.usize()

    i: mutable usize = 0
    while i < first_length:
        value: i64 = input[1 + i]
        if value < 0 or value > 127:
            return -1
        i <- i + 1
    i <- 0
    while i < second_length:
        value: i64 = input[second_length_index + 1 + i]
        if value < 0 or value > 127:
            return -1
        i <- i + 1

    if first_length == second_length:
        equal: mutable bool = true
        i <- 0
        while i < first_length:
            if input[1 + i] != input[second_length_index + 1 + i]:
                equal <- false
                break
            i <- i + 1
        if equal:
            return 0
    if second_length == 0:
        return SCALE

    half: usize = first_length / 2
    radius: mutable usize = 0
    if half > 0:
        radius <- half - 1
    first_matched: mutable bool[MAX_STRING_LENGTH] = zeroed
    second_matched: mutable bool[MAX_STRING_LENGTH] = zeroed
    match_count: mutable usize = 0
    i <- 0
    while i < first_length:
        start: usize = 0
        if i > radius:
            start <- i - radius
        ending: mutable usize = i + radius
        if ending >= second_length:
            ending <- second_length - 1
        if start <= ending:
            j: mutable usize = start
            while j <= ending:
                if input[1 + i] == input[second_length_index + 1 + j] and not second_matched[j]:
                    first_matched[i] <- true
                    second_matched[j] <- true
                    match_count <- match_count + 1
                    break
                j <- j + 1
        i <- i + 1
    if match_count == 0:
        return SCALE

    second_index: mutable usize = 0
    mismatched_pairs: mutable usize = 0
    i <- 0
    while i < first_length:
        if first_matched[i]:
            while second_index < second_length and not second_matched[second_index]:
                second_index <- second_index + 1
            if second_index == second_length:
                return -1
            if input[1 + i] != input[second_length_index + 1 + second_index]:
                mismatched_pairs <- mismatched_pairs + 1
            second_index <- second_index + 1
        i <- i + 1

    matches: i64 = match_count.i64()
    first_size: i64 = first_length.i64()
    second_size: i64 = second_length.i64()
    transpositions: i64 = (mismatched_pairs / 2).i64()
    jaro_numerator: i64 = matches * matches * second_size + matches * matches * first_size +
        (matches - transpositions) * first_size * second_size
    jaro_denominator: i64 = 3 * first_size * second_size * matches

    prefix_length: mutable usize = 0
    prefix_limit: usize = 4
    if second_length < prefix_limit:
        prefix_limit <- second_length
    while prefix_length < prefix_limit and input[1 + prefix_length] == input[second_length_index + 1 + prefix_length]:
        prefix_length <- prefix_length + 1
    denominator: i64 = 10 * jaro_denominator
    numerator: i64 = (10 - prefix_length.i64()) * (jaro_denominator - jaro_numerator)
    (numerator * SCALE + denominator / 2) / denominator

export fn jaro_winkler_distance(input: i64&, length: usize) i64 = jaro_winkler_distance_impl
