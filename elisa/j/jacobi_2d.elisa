const MAX_N: usize = 30
const MAX_TSTEPS: usize = 20

extern trunc(value: f64) -> f64

def jacobi_2d_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length != 2:
        return -1
    n_value: f64 = input[0]
    steps_value: f64 = input[1]
    if trunc(n_value) != n_value or trunc(steps_value) != steps_value or n_value < 1.0 or n_value > MAX_N.f64() or steps_value < 0.0 or steps_value > MAX_TSTEPS.f64():
        return -1
    n: usize = n_value.usize()
    tsteps: usize = steps_value.usize()
    count: usize = n * n
    if output.is_null() or capacity < count:
        return -2

    a: mutable f64[MAX_N][MAX_N] = zeroed
    b: mutable f64[MAX_N][MAX_N] = zeroed
    for i in 0..n:
        for j in 0..n:
            a[i][j] <- (i.f64() * (j + 2).f64() + 2.0) / n.f64()
            b[i][j] <- (i.f64() * (j + 3).f64() + 3.0) / n.f64()
    for _ in 0..tsteps:
        if n > 2:
            for i in 1..(n - 1):
                for j in 1..(n - 1):
                    b[i][j] <- 0.2 * (a[i][j] + a[i][j - 1] + a[i][j + 1] + a[i + 1][j] + a[i - 1][j])
            for i in 1..(n - 1):
                for j in 1..(n - 1):
                    a[i][j] <- 0.2 * (b[i][j] + b[i][j - 1] + b[i][j + 1] + b[i + 1][j] + b[i - 1][j])
    for i in 0..n:
        for j in 0..n:
            output[i * n + j] <- a[i][j]
    count.i64()

export fn jacobi_2d(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = jacobi_2d_impl
