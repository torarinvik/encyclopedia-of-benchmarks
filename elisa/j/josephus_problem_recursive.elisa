def josephus_recursive_solve(n: i64, step: i64) -> i64:
    if n == 1:
        return 0
    (josephus_recursive_solve(n - 1, step) + step % n) % n
def josephus_problem_recursive_impl(values: i64&, length: usize) -> i64:
    if length != 2:
        return -1
    n: i64 = values[0]
    step: i64 = values[1]
    if n < 1 or n > 256 or step < 1:
        return -1
    josephus_recursive_solve(n, step) + 1
export fn josephus_problem_recursive(values: i64&, length: usize) -> i64 = josephus_problem_recursive_impl
