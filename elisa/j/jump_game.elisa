# Return 1 if the final array index is reachable, 0 if it is not.
def jump_game_impl(input: i64&, length: usize) -> i64:
    if input.is_null(): return -2
    if length < 2 or length > 1025 or input[0] < 1 or input[0] > 1024 or length != input[0].usize() + 1:
        return -2
    n: usize = input[0].usize()
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < 0 or input[i + 1] > 1000000:
            return -2
        i <- i + 1
    last_pos: mutable usize = n - 1
    i <- n
    while i > 0:
        i <- i - 1
        if i + input[i + 1].usize() >= last_pos:
            last_pos <- i
    if last_pos == 0: 1 else: 0

export fn jump_game(input: i64&, length: usize) -> i64 = jump_game_impl
