const MAX_SUPPORT_LENGTH: usize = 4
const MAX_PARSEABLE_INPUT_LENGTH: usize = 20
const MAX_OUTPUT_ELEMENTS: usize = 48
const MAX_SUPPORT_VALUE: i64 = 1000
const MAX_ABS_PROBABILITY: f64 = 1000000.0

def joint_probability_distribution_impl(input: f64&, input_length: usize,
        output: mutable f64&, output_capacity: usize) -> i64:
    if input == null or input_length < 2 or input_length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    nx_value: f64 = input[0]
    ny_value: f64 = input[1]
    if nx_value != nx_value or ny_value != ny_value or nx_value < 1.0 or nx_value > 4.0 or ny_value < 1.0 or ny_value > 4.0:
        return -1
    nx: usize = nx_value.usize()
    ny: usize = ny_value.usize()
    if nx_value != nx.f64() or ny_value != ny.f64():
        return -1
    if input_length != 2 + 2 * nx + 2 * ny:
        return -1

    x_start: usize = 2
    y_start: usize = x_start + nx
    x_probability_start: usize = y_start + ny
    y_probability_start: usize = x_probability_start + nx
    x_values: mutable i64[4] = zeroed
    y_values: mutable i64[4] = zeroed
    x_probabilities: mutable f64[4] = zeroed
    y_probabilities: mutable f64[4] = zeroed

    for index in 0..<nx |input, x_values, x_probabilities|:
        value: f64 = input[x_start + index]
        if value != value or value < -1000.0 or value > 1000.0:
            return -1
        x_values[index] <- value.i64()
        if value != x_values[index].f64():
            return -1
        probability: f64 = input[x_probability_start + index]
        if probability != probability or probability < -MAX_ABS_PROBABILITY or probability > MAX_ABS_PROBABILITY:
            return -1
        x_probabilities[index] <- probability
        for previous in 0..<index |x_values|:
            if x_values[previous] == x_values[index]:
                return -1
    for index in 0..<ny |input, y_values, y_probabilities|:
        value: f64 = input[y_start + index]
        if value != value or value < -1000.0 or value > 1000.0:
            return -1
        y_values[index] <- value.i64()
        if value != y_values[index].f64():
            return -1
        probability: f64 = input[y_probability_start + index]
        if probability != probability or probability < -MAX_ABS_PROBABILITY or probability > MAX_ABS_PROBABILITY:
            return -1
        y_probabilities[index] <- probability
        for previous in 0..<index |y_values|:
            if y_values[previous] == y_values[index]:
                return -1

    required: usize = 3 * nx * ny
    if required > MAX_OUTPUT_ELEMENTS or output == null or output_capacity < required:
        return -2
    position: mutable usize = 0
    for x_index in 0..<nx |x_values, y_values, x_probabilities, y_probabilities, output, position|:
        for y_index in 0..<ny |y_values, x_values, x_probabilities, y_probabilities, output, position|:
            output[position] <- x_values[x_index].f64()
            output[position + 1] <- y_values[y_index].f64()
            output[position + 2] <- x_probabilities[x_index] * y_probabilities[y_index]
            position <- position + 3
    required.i64()

export fn joint_probability_distribution(input: f64&, input_length: usize,
        output: mutable f64&, output_capacity: usize) -> i64 = joint_probability_distribution_impl
