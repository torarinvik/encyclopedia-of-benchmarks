# Bounded Johnson all-pairs distances for the pinned Java matrix contract.
const MAX_VERTICES: usize = 16
const MAX_INPUT_LENGTH: usize = 257
const MAX_WEIGHT: i64 = 32
const UNREACHABLE: i64 = 9223372036854775807
const UNREACHABLE_SENTINEL: i64 = 4611686018427387904
const FNV_OFFSET_BASIS: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211

def johnsons_algorithm_fnv_word(hash: u64, value: i64) -> u64:
    bits: u64 = value.u64()
    result: mutable u64 = hash
    for byte in 0..<8:
        octet: u64 = (bits >> (byte * 8)) & 255.u64()
        result <- (result ^ octet) * FNV_PRIME
    result

def johnsons_algorithm_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH: return -1
    vertex_value: i64 = input[0]
    if vertex_value < 1 or vertex_value > 16: return -1
    vertices: usize = vertex_value.usize()
    if length != 1 + vertices * vertices: return -1

    weight: mutable i64[256] = zeroed
    edge: mutable bool[256] = zeroed
    reachable: mutable bool[256] = zeroed
    for from in 0..<vertices:
        reachable[from * MAX_VERTICES + from] <- true
        for to in 0..<vertices:
            value: i64 = input[1 + from * vertices + to]
            if value < -MAX_WEIGHT or value > MAX_WEIGHT: return -1
            if from != to and value != 0:
                index: usize = from * MAX_VERTICES + to
                edge[index] <- true
                weight[index] <- value
                reachable[index] <- true
    for intermediate in 0..<vertices:
        for from in 0..<vertices:
            for to in 0..<vertices:
                index: usize = from * MAX_VERTICES + to
                reachable[index] <- reachable[index] or
                    (reachable[from * MAX_VERTICES + intermediate] and
                     reachable[intermediate * MAX_VERTICES + to])
    for from in 0..<vertices:
        for to in 0..<vertices:
            if not reachable[from * MAX_VERTICES + to]: return -1

    potential: mutable i64[16] = zeroed
    for iteration in 1..<vertices:
        updated: mutable bool = false
        for from in 0..<vertices:
            for to in 0..<vertices:
                index: usize = from * MAX_VERTICES + to
                if not edge[index]: continue
                candidate: i64 = potential[from] + weight[index]
                if candidate < potential[to]:
                    potential[to] <- candidate
                    updated <- true
        if not updated: break
    for from in 0..<vertices:
        for to in 0..<vertices:
            index: usize = from * MAX_VERTICES + to
            if not edge[index]: continue
            if potential[from] + weight[index] < potential[to] or
                weight[index] + potential[from] - potential[to] <= 0: return -1

    reweighted: mutable i64[256] = zeroed
    for from in 0..<vertices:
        for to in 0..<vertices:
            index: usize = from * MAX_VERTICES + to
            if edge[index]: reweighted[index] <- weight[index] + potential[from] - potential[to]

    result: mutable u64 = FNV_OFFSET_BASIS
    for source in 0..<vertices:
        distance: mutable i64[16] = zeroed
        visited: mutable bool[16] = zeroed
        for vertex in 0..<vertices: distance[vertex] <- UNREACHABLE
        distance[source] <- 0
        for step in 0..<vertices:
            current: mutable usize = vertices
            for vertex in 0..<vertices:
                if not visited[vertex] and
                    (current == vertices or distance[vertex] <= distance[current]): current <- vertex
            if current == vertices or distance[current] == UNREACHABLE: break
            visited[current] <- true
            for next in 0..<vertices:
                index: usize = current * MAX_VERTICES + next
                if not edge[index] or visited[next]: continue
                candidate: i64 = distance[current] + reweighted[index]
                if candidate < distance[next]: distance[next] <- candidate
        for destination in 0..<vertices:
            output: i64 = UNREACHABLE_SENTINEL
            if distance[destination] != UNREACHABLE:
                output <- distance[destination] - potential[source] + potential[destination]
            result <- johnsons_algorithm_fnv_word(result, output)
    (result & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn johnsons_algorithm(input: i64&, length: usize) -> i64 = johnsons_algorithm_impl
