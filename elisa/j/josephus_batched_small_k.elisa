# Batched small-step Josephus recurrence with bounded local frame storage.
def josephus_batched_small_k_impl(input: i64&, input_length: usize) -> i64:
    if input_length != 2: return -1
    n0: i64 = input[0]
    k: i64 = input[1]
    if n0 < 1 or n0 > 1000000 or k < 1 or k > 32: return -1
    if n0 == 1: return 0
    if k == 1: return n0 - 1
    frames: mutable i64[1024] = zeroed
    depth: mutable usize = 0
    n: mutable i64 = n0
    while n > 1:
        if depth == 1024: return -1
        frames[depth] <- n
        depth <- depth + 1
        if n < k: n <- n - 1
        else: n <- n - n / k
    survivor: mutable i64 = 0
    while depth > 0:
        depth <- depth - 1
        m: i64 = frames[depth]
        if m < k: survivor <- (survivor + k) % m
        else:
            survivor <- survivor - m % k
            if survivor < 0: survivor <- survivor + m
            else: survivor <- survivor + survivor / (k - 1)
    survivor

def josephus_batched_small_k_entry(values: i64&, length: usize) -> i64:
    if values == null or length != 2: return -1
    josephus_batched_small_k_impl(values, length)

export fn josephus_batched_small_k(values: i64&, length: usize) -> i64 = josephus_batched_small_k_entry
