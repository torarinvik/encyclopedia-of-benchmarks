const MAX_LENGTH: usize = 64

def jort_sort_impl(values: i64&, length: usize) -> i64:
    if length == 0: return 1
    if values.is_null() or length > MAX_LENGTH: return -1
    copy: mutable i64[MAX_LENGTH] = zeroed
    for i in 0..length:
        copy[i] <- values[i]
    for i in 2..length:
        key: i64 = copy[i]
        position: mutable usize = i
        while position > 1 and copy[position - 1] > key:
            copy[position] <- copy[position - 1]
            position <- position - 1
        copy[position] <- key
    for i in 0..length:
        if copy[i] != values[i]: return 0
    1

export fn jort_sort(values: i64&, length: usize) -> i64 = jort_sort_impl
