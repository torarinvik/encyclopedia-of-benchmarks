# Jump search in an ascending sequence for the shared benchmark contract.
def integer_sqrt(value: usize) -> usize:
    if value < 2:
        return value
    result: usize =
        while low <= high |low: usize = 1, high: usize = value / 2 + 1, result: usize = 1| -> result:
            middle: usize = low + (high - low) / 2
            if middle <= value / middle:
                result <- middle
                low <- middle + 1
            else:
                high <- middle - 1
    result

def jump_search_impl(values: i64&, length: usize, target: i64) -> i64:
    if length == 0:
        return -1
    step: usize = integer_sqrt(length)
    block_start: mutable usize = 0
    block_end: mutable usize = step if step < length else length
    while values[block_end - 1] < target |block_start, block_end|:
        break if block_end == length
        block_start <- block_end
        block_end <- length if step > length - block_end else block_end + step
    index: i64 =
        for index in block_start..<block_end |found: i64 = -1| -> found:
            if values[index] == target:
                break index.i64()
            if values[index] > target:
                break -1
    index

export fn jump_search(values: i64&, length: usize, target: i64) -> i64 = jump_search_impl
