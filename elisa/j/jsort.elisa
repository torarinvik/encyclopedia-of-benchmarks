# In-place JSort: directional heap partial orders followed by insertion sort.
def jsort_sift_down_min(values: mutable view[i64], root: usize, end: usize) -> void:
    current: mutable usize = root
    while current < end / 2:
        child: mutable usize = current * 2 + 1
        if child + 1 < end and values[child + 1] < values[child]:
            child <- child + 1
        if values[current] <= values[child]: break
        temporary: i64 = values[current]
        values[current] <- values[child]
        values[child] <- temporary
        current <- child

def jsort_sift_down_max(values: mutable view[i64], root: usize, end: usize) -> void:
    current: mutable usize = root
    while current < end / 2:
        child: mutable usize = current * 2 + 1
        if child + 1 < end and values[child + 1] > values[child]:
            child <- child + 1
        if values[current] >= values[child]: break
        temporary: i64 = values[current]
        values[current] <- values[child]
        values[child] <- temporary
        current <- child

def jsort_reverse(values: mutable view[i64], length: usize) -> void:
    left: mutable usize = 0
    while left < length / 2:
        right: usize = length - 1 - left
        temporary: i64 = values[left]
        values[left] <- values[right]
        values[right] <- temporary
        left <- left + 1

def jsort_impl(values: mutable i64&, length: usize) -> void:
    if length < 2: return
    items: mutable view[i64] = values[0:length]
    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        jsort_sift_down_min(items, start, length)

    jsort_reverse(items, length)
    start <- length / 2
    while start > 0:
        start <- start - 1
        jsort_sift_down_max(items, start, length)
    jsort_reverse(items, length)

    index: mutable usize = 1
    while index < length:
        key: i64 = items[index]
        position: mutable usize = index
        while position > 0 and items[position - 1] > key:
            items[position] <- items[position - 1]
            position <- position - 1
        items[position] <- key
        index <- index + 1

export fn jsort(values: mutable i64&, length: usize) -> void = jsort_impl
