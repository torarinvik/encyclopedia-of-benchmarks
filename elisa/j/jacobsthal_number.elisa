# Return J(n) for the bounded signed-64-bit Jacobsthal index.
def jacobsthal_number_impl(n: i64) -> i64:
    if n < 0 or n > 64:
        return -1
    if n == 0:
        return 0
    result: i64 =
        while index <= n |index: i64 = 2, previous: i64 = 0, current: i64 = 1| -> current:
            next_value: i64 = current + 2 * previous
            previous <- current
            current <- next_value
            index <- index + 1
    result

export fn jacobsthal_number(n: i64) -> i64 = jacobsthal_number_impl
