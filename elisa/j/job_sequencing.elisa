const MAX_JOBS: usize = 32
const MAX_INPUT_LENGTH: usize = 98
const MAX_PROFIT: i64 = 1000000

def job_sequencing_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 4 or length > MAX_INPUT_LENGTH:
        return -1
    raw_n: i64 = input[0]
    if raw_n < 1 or raw_n > 32:
        return -1
    n: usize = raw_n.usize()
    if length != 1 + 3 * n:
        return -1
    seen: mutable u8[128] = zeroed
    previous_profit: mutable i64 = MAX_PROFIT + 1
    for i in 0..<n |input, seen, previous_profit|:
        base: usize = 1 + 3 * i
        id: i64 = input[base]
        deadline: i64 = input[base + 1]
        profit: i64 = input[base + 2]
        letter: bool = (id >= 65 and id <= 90) or (id >= 97 and id <= 122)
        if not letter or seen[id.usize()] != 0.u8() or deadline < 1 or deadline > raw_n or profit < 1 or profit > MAX_PROFIT or profit >= previous_profit:
            return -1
        seen[id.usize()] <- 1.u8()
        previous_profit <- profit
    slots: mutable u8[32] = zeroed
    total_profit: mutable i64 = 0
    for i in 0..<n |input, slots, total_profit|:
        base: usize = 1 + 3 * i
        deadline: usize = input[base + 1].usize()
        remaining: mutable usize = deadline
        while remaining > 0 |slots, total_profit, remaining|:
            remaining <- remaining - 1
            if slots[remaining] == 0.u8():
                slots[remaining] <- input[base].u8()
                total_profit <- total_profit + input[base + 2]
                break
    count: mutable usize = 0
    for i in 0..<n |slots, count|:
        if slots[i] != 0.u8(): count <- count + 1
    required: usize = 9 + count
    if output == null or capacity < required: return -2
    output[0] <- count.u8()
    for i in 0..<8 |output|:
        output[1 + i] <- ((total_profit >> (8 * i)) & 255).u8()
    written: mutable usize = 9
    for i in 0..<n |slots, output, written|:
        if slots[i] != 0.u8():
            output[written] <- slots[i]
            written <- written + 1
    required.i64()

export fn job_sequencing(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = job_sequencing_impl
