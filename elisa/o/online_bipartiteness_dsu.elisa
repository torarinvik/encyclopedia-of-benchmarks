const MAX_INPUT_LENGTH = 195

def online_bipartiteness_dsu_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 2 or input_length > MAX_INPUT_LENGTH: return -1
    n_value:  i64 = input[0]
    q_value:  i64 = input[1]
    if n_value < 1 or n_value > 32 or q_value < 0 or q_value > 64: return -1
    n:  usize = n_value.usize()
    q:  usize = q_value.usize()
    if input_length != 2 + 3 * q: return -1
    operation: mutable usize = 0
    while operation < q:
        opcode:  i64 = input[2 + 3 * operation]
        a:  i64 = input[3 + 3 * operation]
        b:  i64 = input[4 + 3 * operation]
        if opcode == 0:
            if a < 0 or a >= n_value or b < 0 or b >= n_value: return -1
        elif opcode == 1:
            if a < 0 or a >= n_value or b != 0: return -1
        else:
            return -1
        operation <- operation + 1
    parent: mutable i64[32] = zeroed
    size: mutable i64[32] = zeroed
    parity: mutable i64[32] = zeroed
    bad: mutable bool[32] = zeroed
    operation <- 0
    while operation < n:
        parent[operation] <- operation.i64()
        size[operation] <- 1
        operation <- operation + 1
    checksum: mutable i64 = 0
    query_ordinal: mutable i64 = 0
    operation <- 0
    while operation < q:
        opcode:  i64 = input[2 + 3 * operation]
        a:  usize = input[3 + 3 * operation].usize()
        if opcode == 1:
            root: mutable usize = a
            total: mutable i64 = 0
            while parent[root].usize() != root:
                total <- total ^ parity[root]
                root <- parent[root].usize()
            current: mutable usize = a
            accumulated: mutable i64 = 0
            while parent[current].usize() != current:
                next:  usize = parent[current].usize()
                edge:  i64 = parity[current]
                parent[current] <- root.i64()
                parity[current] <- total ^ accumulated
                accumulated <- accumulated ^ edge
                current <- next
            answer:  i64 = 0 if (bad[root]) else 1
            checksum <- checksum + (query_ordinal + 1) * (answer + 1)
            query_ordinal <- query_ordinal + 1
            operation <- operation + 1
            continue
        b:  usize = input[4 + 3 * operation].usize()
        root_a: mutable usize = a
        total_a: mutable i64 = 0
        while parent[root_a].usize() != root_a:
            total_a <- total_a ^ parity[root_a]
            root_a <- parent[root_a].usize()
        current_a: mutable usize = a
        accumulated_a: mutable i64 = 0
        while parent[current_a].usize() != current_a:
            next_a:  usize = parent[current_a].usize()
            edge_a:  i64 = parity[current_a]
            parent[current_a] <- root_a.i64()
            parity[current_a] <- total_a ^ accumulated_a
            accumulated_a <- accumulated_a ^ edge_a
            current_a <- next_a
        root_b: mutable usize = b
        total_b: mutable i64 = 0
        while parent[root_b].usize() != root_b:
            total_b <- total_b ^ parity[root_b]
            root_b <- parent[root_b].usize()
        current_b: mutable usize = b
        accumulated_b: mutable i64 = 0
        while parent[current_b].usize() != current_b:
            next_b:  usize = parent[current_b].usize()
            edge_b:  i64 = parity[current_b]
            parent[current_b] <- root_b.i64()
            parity[current_b] <- total_b ^ accumulated_b
            accumulated_b <- accumulated_b ^ edge_b
            current_b <- next_b
        if root_a == root_b:
            if total_a == total_b: bad[root_a] <- true
        else:
            if size[root_a] < size[root_b]:
                old_root:  usize = root_a
                root_a <- root_b
                root_b <- old_root
                old_parity:  i64 = total_a
                total_a <- total_b
                total_b <- old_parity
            parent[root_b] <- root_a.i64()
            parity[root_b] <- total_a ^ total_b ^ 1
            size[root_a] <- size[root_a] + size[root_b]
            bad[root_a] <- bad[root_a] or bad[root_b]
        operation <- operation + 1
    checksum

def online_bipartiteness_dsu_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    online_bipartiteness_dsu_impl(input_view, input_view_length)

export fn online_bipartiteness_dsu(input: i64&, length: usize) -> i64 = online_bipartiteness_dsu_entry
