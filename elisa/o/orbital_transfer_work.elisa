@link_name("llvm.memcpy.p0.p0.i64")
extern copy_work_bytes(output: mutable u64&, source: f64&, bytes: usize, is_volatile: bool) -> void

def orbital_transfer_work_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values == null or length != 4: return -1
    central: i64 = values[0]
    object: i64 = values[1]
    initial: i64 = values[2]
    final: i64 = values[3]
    if central < -1000000000 or central > 1000000000 or object < -1000000 or object > 1000000 or initial < 1 or initial > 1000000000 or final < 1 or final > 1000000000: return -1
    if output == null or capacity < 8: return -2
    work: f64 = (6.67430e-11*central.f64()*object.f64()/2.0)*(1.0/initial.f64()-1.0/final.f64())
    # Reinterpret the work as bits, then write little-endian bytes.
    bits: mutable u64 = 0
    copy_work_bytes(&bits, &work, 8, false)
    for index in 0..<8:
        output[index] <- (bits >> (8 * index)).u8()
    8
export fn orbital_transfer_work(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = orbital_transfer_work_impl
