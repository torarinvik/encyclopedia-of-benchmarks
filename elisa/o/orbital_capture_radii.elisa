# Orbital capture radius from the pinned Python gravitational-focusing formula.
extern floor(value: f64) -> f64
extern sqrt(value: f64) -> f64

def round_nonnegative(value: f64) -> f64:
    if value >= 9007199254740992.0:
        return value
    lower: f64 = floor(value)
    fraction: f64 = value - lower
    lower_half: f64 = floor(lower / 2.0)
    odd: bool = lower - 2.0 * lower_half != 0.0
    if fraction > 0.5 or (fraction == 0.5 and odd):
        return lower + 1.0
    return lower

def orbital_capture_radii_impl(radius: f64, mass: f64, velocity: f64) -> f64:
    if not (radius >= 1.0e-6 and radius <= 1.0e10):
        return -1e300
    if not (mass >= 0.0 and mass <= 2.0e30):
        return -1e300
    if not (velocity >= 1.0e6 and velocity <= 299792458.0):
        return -1e300
    escape_velocity_squared: f64 = (2.0 * 6.67430e-11 * mass) / radius
    capture_radius: f64 = radius * sqrt(1.0 + escape_velocity_squared / (velocity * velocity))
    return round_nonnegative(capture_radius)

export fn orbital_capture_radii(radius: f64, mass: f64, velocity: f64) -> f64 = orbital_capture_radii_impl
