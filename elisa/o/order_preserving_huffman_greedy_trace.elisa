from std.collections import InlineArray

@export("order_preserving_huffman_greedy_trace")
fn order_preserving_huffman_greedy_trace(
    input: i64&, length: usize, output: mutable u8&, capacity: usize
) abi("C") -> Int64:
    if input.is_null() or length < 3 or length > 10: return -1
    let values: view[i64] = input[0:length]
    let raw_n = values[0]
    if raw_n < 2 or raw_n > 8 or length != (raw_n + 1).usize(): return -1
    let n = raw_n.usize()
    var weights = InlineArray[Int64, 15]()
    var left = InlineArray[Int, 15]()
    var right = InlineArray[Int, 15]()
    var active = InlineArray[Int, 8]()
    for i in range(15):
        left[i] = -1
        right[i] = -1
    var total: Int64 = 0
    for i in range(n):
        let w = values[i + 1]
        if w < 1 or w > 15: return -1
        weights[i] = w
        total += w
        active[i] = i
    if total > 120: return -1
    var count = n
    var next_node = n
    while count > 1:
        var pair = 0
        var best = weights[active[0]] + weights[active[1]]
        for i in range(1, count - 1):
            let candidate = weights[active[i]] + weights[active[i + 1]]
            if candidate < best:
                pair = i
                best = candidate
        let a = active[pair]
        let b = active[pair + 1]
        weights[next_node] = best
        left[next_node] = a
        right[next_node] = b
        var i = pair
        while i + 2 < count:
            active[i] = active[i + 2]
            i += 1
        count -= 2
        i = count
        while i > pair:
            active[i] = active[i - 1]
            i -= 1
        active[pair] = next_node
        count += 1
        next_node += 1
    var depths = InlineArray[Int64, 8]()
    var stack_node = InlineArray[Int, 16]()
    var stack_depth = InlineArray[Int64, 16]()
    var top = 1
    stack_node[0] = active[0]
    stack_depth[0] = 0
    while top > 0:
        top -= 1
        let node = stack_node[top]
        let depth = stack_depth[top]
        if node < n:
            depths[node] = depth
        else:
            stack_node[top] = left[node]
            stack_depth[top] = depth + 1
            top += 1
            stack_node[top] = right[node]
            stack_depth[top] = depth + 1
            top += 1
    var words = InlineArray[Int64, 10]()
    words[0] = raw_n
    for i in range(n):
        words[1] += values[i + 1] * depths[i]
        words[i + 2] = depths[i]
    let needed = 8 * (n + 2)
    var staged = InlineArray[UInt8, 80]()
    for i in range(n + 2):
        let bits = bitcast[UInt64](words[i])
        for b in range(8): staged[8 * i + b] = UInt8((bits >> (8 * b)) & 255)
    if output.is_null() or capacity < needed: return -2
    let output_view: mutable view[u8] = output[0:needed]
    for i in range(needed): output_view[i] <- staged[i]
    Int64(needed)
