const max_nodes: usize = 8
const max_degree: usize = 4

def olden_em3d_impl(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 2: return -1
    requested_n: f64 = input[0]
    requested_degree: f64 = input[1]
    if requested_n != requested_n or requested_n < 1.0 or requested_n > 8.0 or requested_n.i64().f64() != requested_n: return -1
    if requested_degree != requested_degree or requested_degree < 1.0 or requested_degree > 4.0 or requested_degree.i64().f64() != requested_degree: return -1
    n: usize = requested_n.i64().usize()
    degree: usize = requested_degree.i64().usize()
    edges: usize = n * degree
    if input_length != 2 + 2 * n + 4 * edges: return -1
    electric: mutable f64[max_nodes] = zeroed
    magnetic: mutable f64[max_nodes] = zeroed
    offset: mutable usize = 2
    i: mutable usize = 0
    while i < n:
        value: f64 = input[offset + i]
        if value != value or value < 0.0 or value > 1.0: return -1
        electric[i] <- value
        i <- i + 1
    offset <- offset + n
    i <- 0
    while i < n:
        value: f64 = input[offset + i]
        if value != value or value < 0.0 or value > 1.0: return -1
        magnetic[i] <- value
        i <- i + 1
    offset <- offset + n
    e_neighbors: usize = offset
    offset <- offset + edges
    e_coefficients: usize = offset
    offset <- offset + edges
    h_neighbors: usize = offset
    offset <- offset + edges
    h_coefficients: usize = offset
    i <- 0
    while i < edges:
        en: f64 = input[e_neighbors + i]
        hn: f64 = input[h_neighbors + i]
        if en != en or en < 0.0 or en >= n.f64() or en.i64().f64() != en: return -1
        if hn != hn or hn < 0.0 or hn >= n.f64() or hn.i64().f64() != hn: return -1
        ec: f64 = input[e_coefficients + i]
        hc: f64 = input[h_coefficients + i]
        if ec != ec or ec < 0.0 or ec > 1.0 or hc != hc or hc < 0.0 or hc > 1.0: return -1
        start: usize = (i / degree) * degree
        j: mutable usize = start
        while j < i:
            if input[e_neighbors + j] == en or input[h_neighbors + j] == hn: return -1
            j <- j + 1
        i <- i + 1
    if output.is_null() or output_capacity < 2 * n: return -2
    node: mutable usize = 0
    while node < n:
        current: mutable f64 = electric[node]
        base: usize = node * degree
        edge: mutable usize = 0
        while edge < degree:
            coefficient: usize = base + edge - (edge % 2)
            neighbor: usize = input[e_neighbors + base + edge].i64().usize()
            current <- current - input[e_coefficients + coefficient] * magnetic[neighbor]
            edge <- edge + 1
        electric[node] <- current
        node <- node + 1
    node <- 0
    while node < n:
        current: mutable f64 = magnetic[node]
        base: usize = node * degree
        edge: mutable usize = 0
        while edge < degree:
            coefficient: usize = base + edge - (edge % 2)
            neighbor: usize = input[h_neighbors + base + edge].i64().usize()
            current <- current - input[h_coefficients + coefficient] * electric[neighbor]
            edge <- edge + 1
        magnetic[node] <- current
        node <- node + 1
    i <- 0
    while i < n:
        output[i] <- electric[i]
        output[n + i] <- magnetic[i]
        i <- i + 1
    (2 * n).i64()

export fn olden_em3d(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64 = olden_em3d_impl
