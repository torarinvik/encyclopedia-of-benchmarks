# Clean-room bounded Kierstead-Trotter online interval coloring profile.
const ONLINE_INTERVAL_MAX_N: usize = 64
const ONLINE_INTERVAL_MAX_INPUT: usize = 129

def online_interval_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def online_interval_level_fits(left: i64&, right: i64&, levels: usize&, last: usize, candidate: usize) -> bool:
    anchor: mutable usize = 0
    while anchor <= last:
        point: i64 = left[anchor]
        overlap: mutable usize = 0
        item: mutable usize = 0
        while item <= last:
            if (item == last or levels[item] <= candidate) and left[item] <= point and point <= right[item]:
                overlap <- overlap + 1
            item <- item + 1
        if overlap > candidate: return false
        anchor <- anchor + 1
    true

def online_interval_coloring(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("online_interval_coloring"):
    if input.is_null() or length < 1 or length > ONLINE_INTERVAL_MAX_INPUT: return -1
    count64: i64 = input[0]
    if count64 < 0 or count64 > 64 or length != 1 + 2 * count64.usize(): return -1
    n: usize = count64.usize()
    left: mutable i64[64] = zeroed
    right: mutable i64[64] = zeroed
    i: mutable usize = 0
    while i < n:
        left[i] <- input[1 + 2 * i]
        right[i] <- input[2 + 2 * i]
        if left[i] < -1000 or left[i] > 1000 or right[i] < -1000 or right[i] > 1000 or left[i] > right[i]: return -1
        i <- i + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes: return -2

    levels: mutable usize[64] = zeroed
    local: mutable usize[64] = zeroed
    colors: mutable usize[64] = zeroed
    i <- 0
    while i < n:
        level: mutable usize = 1
        while !online_interval_level_fits(&left[0], &right[0], &levels[0], i, level):
            level <- level + 1
            if level > i + 1: return -1
        levels[i] <- level
        used: mutable bool[3] = zeroed
        prior: mutable usize = 0
        while prior < i:
            if levels[prior] == level and left[prior] <= right[i] and left[i] <= right[prior] and local[prior] < 3:
                used[local[prior]] <- true
            prior <- prior + 1
        color: mutable usize = 0
        while color < 3 and used[color]: color <- color + 1
        if color == 3: return -1
        local[i] <- color
        colors[i] <- 3 * (level - 1) + color
        i <- i + 1

    i <- 0
    while i < n:
        online_interval_store_i64_le(colors[i].i64(), output, 8 * i)
        i <- i + 1
    output_bytes.i64()
