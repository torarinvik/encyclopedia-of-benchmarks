# Deterministic onepad transform with the source's key supplied in the input.
def store_i64_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[position + byte] <- (bits % 256.u64()).u8()
        bits <- bits / 256.u64()

def onepad_cipher_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2 or length > 2050:
        return -1
    mode: i64 = input[0]
    count_value: i64 = input[1]
    if (mode != 0 and mode != 1) or count_value < 0 or count_value > 1024:
        return -1
    count: usize = count_value.usize()
    if length != 2 + 2 * count:
        return -1
    needed: mutable usize = count
    if mode == 0:
        needed <- 8 * count
    if output_capacity < needed:
        return -2
    for index in 0..<count |index, input, output, mode, count|:
        data: i64 = input[2 + index]
        key: i64 = input[2 + count + index]
        if key < 1 or key > 300:
            return -1
        if mode == 0:
            if data < 32 or data > 126:
                return -1
            store_i64_le((data + key) * key, output[0:output_capacity], 8 * index)
        else:
            key_square: i64 = key * key
            if data < key_square or (data - key_square) % key != 0:
                return -1
            plain: i64 = (data - key_square) / key
            if plain < 32 or plain > 126:
                return -1
            output[index] <- plain.u8()
    needed.i64()

export fn onepad_cipher(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = onepad_cipher_impl
