const OA_MAX_JOBS: usize = 2
const OA_MAX_TIME: usize = 4
const OA_MAX_INPUT: usize = 8
const OA_MAX_OUTPUT: usize = 152
const OA_MAX_SEGMENTS: usize = 3

def oa_gcd(a0: i64, b0: i64) -> i64:
    a: mutable i64 = a0
    b: mutable i64 = b0
    while b != 0:
        r: i64 = a%b
        a <- b
        b <- r
    if a < 0: return -a
    a

def oa_make(n0: i64, d0: i64, out_n: mutable i64&, out_d: mutable i64&) -> void:
    n: mutable i64 = n0
    d: mutable i64 = d0
    if d < 0:
        n <- -n
        d <- -d
    divisor: i64 = oa_gcd(n,d)
    out_n <- n/divisor
    out_d <- d/divisor

def oa_add(a_n: i64, a_d: i64, b_n: i64, b_d: i64,
           out_n: mutable i64&, out_d: mutable i64&) -> void:
    oa_make(a_n*b_d+b_n*a_d,a_d*b_d,out_n,out_d)

def oa_sub(a_n: i64, a_d: i64, b_n: i64, b_d: i64,
           out_n: mutable i64&, out_d: mutable i64&) -> void:
    oa_make(a_n*b_d-b_n*a_d,a_d*b_d,out_n,out_d)

def oa_mul(a_n: i64, a_d: i64, b_n: i64, b_d: i64,
           out_n: mutable i64&, out_d: mutable i64&) -> void:
    oa_make(a_n*b_n,a_d*b_d,out_n,out_d)

def oa_div(a_n: i64, a_d: i64, b_n: i64, b_d: i64,
           out_n: mutable i64&, out_d: mutable i64&) -> void:
    oa_make(a_n*b_d,a_d*b_n,out_n,out_d)

def oa_cmp(a_n: i64, a_d: i64, b_n: i64, b_d: i64) -> i64:
    left: i64 = a_n*b_d
    right: i64 = b_n*a_d
    if left > right: return 1
    if left < right: return -1
    0

def oa_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset+byte] <- ((bits>>(8*byte))&255).u8()
        byte <- byte+1

def oa_speed_scaling_impl(input: i64&, input_length: usize, output: mutable u8&, capacity: usize) -> i64:
    length: usize = input_length
    if length < 2 or length > OA_MAX_INPUT: return -1
    n64: i64 = input[0]
    if n64 < 1 or n64 > OA_MAX_JOBS.i64(): return -1
    n: usize = n64.usize()
    if length != 1+3*n: return -1
    release: mutable i64[OA_MAX_JOBS] = zeroed
    deadline: mutable i64[OA_MAX_JOBS] = zeroed
    work: mutable i64[OA_MAX_JOBS] = zeroed
    rem_n: mutable i64[OA_MAX_JOBS] = zeroed
    rem_d: mutable i64[OA_MAX_JOBS] = zeroed
    finish_n: mutable i64[OA_MAX_JOBS] = zeroed
    finish_d: mutable i64[OA_MAX_JOBS] = zeroed
    completed: mutable bool[OA_MAX_JOBS] = zeroed
    j: mutable usize = 0
    while j < n:
        r: i64 = input[1+3*j]
        d: i64 = input[2+3*j]
        w: i64 = input[3+3*j]
        if r < 0 or r >= d or d > OA_MAX_TIME.i64() or w < 1 or w > 4: return -1
        release[j] <- r
        deadline[j] <- d
        work[j] <- w
        rem_n[j] <- 0
        rem_d[j] <- 1
        finish_n[j] <- 0
        finish_d[j] <- 1
        j <- j+1

    seg_start: mutable i64[OA_MAX_SEGMENTS] = zeroed
    seg_end: mutable i64[OA_MAX_SEGMENTS] = zeroed
    seg_speed_n: mutable i64[OA_MAX_SEGMENTS] = zeroed
    seg_speed_d: mutable i64[OA_MAX_SEGMENTS] = zeroed
    seg_count: mutable usize = 0
    energy_n: mutable i64 = 0
    energy_d: mutable i64 = 1
    now: mutable i64 = 0
    while now <= OA_MAX_TIME.i64():
        has_arrival: mutable bool = false
        j <- 0
        while j < n:
            if release[j] == now:
                rem_n[j] <- work[j]
                rem_d[j] <- 1
                has_arrival <- true
            j <- j+1
        if has_arrival:
            next_release: mutable i64 = (OA_MAX_TIME+1).i64()
            j <- 0
            while j < n:
                if release[j] > now and release[j] < next_release: next_release <- release[j]
                j <- j+1
            order: mutable usize[OA_MAX_JOBS] = zeroed
            used: mutable usize = 0
            j <- 0
            while j < n:
                if rem_n[j] > 0 and deadline[j] > now:
                    order[used] <- j
                    used <- used+1
                j <- j+1
            i: mutable usize = 1
            while i < used:
                value: usize = order[i]
                k: mutable usize = i
                while k > 0 and (deadline[order[k-1]] > deadline[value] or (deadline[order[k-1]] == deadline[value] and order[k-1] > value)):
                    order[k] <- order[k-1]
                    k <- k-1
                order[k] <- value
                i <- i+1
            left: mutable i64 = now
            while used > 0:
                prefix_n: mutable i64 = 0
                prefix_d: mutable i64 = 1
                best_n: mutable i64 = 0
                best_d: mutable i64 = 1
                best_count: mutable usize = 0
                k: mutable usize = 1
                while k <= used:
                    idx: usize = order[k-1]
                    next_prefix_n: mutable i64 = 0
                    next_prefix_d: mutable i64 = 1
                    oa_add(prefix_n,prefix_d,rem_n[idx],rem_d[idx],next_prefix_n,next_prefix_d)
                    prefix_n <- next_prefix_n
                    prefix_d <- next_prefix_d
                    density_n: mutable i64 = 0
                    density_d: mutable i64 = 1
                    oa_make(prefix_n,prefix_d*(deadline[idx]-left),density_n,density_d)
                    if best_count == 0 or oa_cmp(density_n,density_d,best_n,best_d) > 0:
                        best_n <- density_n
                        best_d <- density_d
                        best_count <- k
                    k <- k+1
                right: i64 = deadline[order[best_count-1]]
                stop: i64 = right if right < next_release else next_release
                if stop > left:
                    if seg_count > 0 and seg_end[seg_count-1] == left and oa_cmp(best_n,best_d,seg_speed_n[seg_count-1],seg_speed_d[seg_count-1]) == 0:
                        seg_end[seg_count-1] <- stop
                    else:
                        seg_start[seg_count] <- left
                        seg_end[seg_count] <- stop
                        seg_speed_n[seg_count] <- best_n
                        seg_speed_d[seg_count] <- best_d
                        seg_count <- seg_count+1
                cube1_n: mutable i64 = 0
                cube1_d: mutable i64 = 1
                cube2_n: mutable i64 = 0
                cube2_d: mutable i64 = 1
                oa_mul(best_n,best_d,best_n,best_d,cube1_n,cube1_d)
                oa_mul(cube1_n,cube1_d,best_n,best_d,cube2_n,cube2_d)
                term_n: mutable i64 = 0
                term_d: mutable i64 = 1
                oa_mul(cube2_n,cube2_d,(stop-left),1,term_n,term_d)
                next_energy_n: mutable i64 = 0
                next_energy_d: mutable i64 = 1
                oa_add(energy_n,energy_d,term_n,term_d,next_energy_n,next_energy_d)
                energy_n <- next_energy_n
                energy_d <- next_energy_d
                cursor_n: mutable i64 = left
                cursor_d: mutable i64 = 1
                k <- 0
                while k < best_count:
                    idx: usize = order[k]
                    duration_n: mutable i64 = 0
                    duration_d: mutable i64 = 1
                    oa_div(rem_n[idx],rem_d[idx],best_n,best_d,duration_n,duration_d)
                    done_n: mutable i64 = 0
                    done_d: mutable i64 = 1
                    oa_add(cursor_n,cursor_d,duration_n,duration_d,done_n,done_d)
                    if oa_cmp(done_n,done_d,stop,1) <= 0:
                        finish_n[idx] <- done_n
                        finish_d[idx] <- done_d
                        completed[idx] <- true
                        rem_n[idx] <- 0
                        rem_d[idx] <- 1
                        cursor_n <- done_n
                        cursor_d <- done_d
                    else:
                        elapsed_n: mutable i64 = 0
                        elapsed_d: mutable i64 = 1
                        oa_sub(stop,1,cursor_n,cursor_d,elapsed_n,elapsed_d)
                        served_n: mutable i64 = 0
                        served_d: mutable i64 = 1
                        oa_mul(best_n,best_d,elapsed_n,elapsed_d,served_n,served_d)
                        next_rem_n: mutable i64 = 0
                        next_rem_d: mutable i64 = 1
                        oa_sub(rem_n[idx],rem_d[idx],served_n,served_d,next_rem_n,next_rem_d)
                        rem_n[idx] <- next_rem_n
                        rem_d[idx] <- next_rem_d
                        cursor_n <- stop
                        cursor_d <- 1
                        break
                    k <- k+1
                if stop < right: break
                k <- best_count
                while k < used:
                    order[k-best_count] <- order[k]
                    k <- k+1
                used <- used-best_count
                left <- right
        now <- now+1

    j <- 0
    while j < n:
        if not completed[j]: return -1
        j <- j+1
    values: mutable i64[OA_MAX_OUTPUT/8] = zeroed
    fields: mutable usize = 0
    values[fields] <- seg_count.i64()
    fields <- fields+1
    values[fields] <- energy_n
    values[fields+1] <- energy_d
    fields <- fields+2
    s: mutable usize = 0
    while s < seg_count:
        values[fields] <- seg_start[s]
        values[fields+1] <- seg_end[s]
        values[fields+2] <- seg_speed_n[s]
        values[fields+3] <- seg_speed_d[s]
        fields <- fields+4
        s <- s+1
    j <- 0
    while j < n:
        values[fields] <- finish_n[j]
        values[fields+1] <- finish_d[j]
        fields <- fields+2
        j <- j+1
    output_bytes: usize = 8*fields
    if output == null or capacity < output_bytes: return -2
    output_view: mutable u8& = output
    i: mutable usize = 0
    while i < fields:
        oa_store(values[i],output_view,8*i)
        i <- i+1
    output_bytes.i64()

def oa_speed_scaling_entry(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > OA_MAX_INPUT: return -1
    oa_speed_scaling_impl(input, length,output,capacity)

export fn oa_speed_scaling(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = oa_speed_scaling_entry
