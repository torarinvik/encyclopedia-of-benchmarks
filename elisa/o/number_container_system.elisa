def number_container_system_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 1: return -1
    count: i64 = values[0]
    if count < 0 or count > 32 or length != (1 + 3 * count).usize(): return -1
    slots: mutable [64]i64 = [0; 64]
    present: mutable [64]bool = [false; 64]
    result: mutable [128]u8 = [0; 128]
    used: mutable usize = 0
    for op_index in 0 .. count.usize():
        op: i64 = values[1 + 3 * op_index]
        a: i64 = values[2 + 3 * op_index]
        b: i64 = values[3 + 3 * op_index]
        if op == 0:
            if a < 0 or a > 63 or b < -100 or b > 100: return -1
            slots[a.usize()] <- b
            present[a.usize()] <- true
        else if op == 1:
            if a < -100 or a > 100 or b != 0: return -1
            found: mutable i64 = -1
            j: mutable usize = 0
            while j < 64:
                if present[j] and slots[j] == a: found <- j.i64(); break
                j <- j + 1
            if used > 0: result[used] <- 44u8(); used <- used + 1
            text: String = found.to_string()
            j <- 0
            while j < text.len(): result[used] <- text.byte_at(j); used <- used + 1; j <- j + 1
        else: return -1
    if used > capacity: return -2
    i: mutable usize = 0
    while i < used: output[i] <- result[i]; i <- i + 1
    return used.i64()

export fn number_container_system(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = number_container_system_impl
