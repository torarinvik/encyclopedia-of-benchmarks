def one_dimensional_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length != 1: return -1
    code: i64 = values[0]
    if code < 0 or code > 11111111: return -1
    digits: mutable [8]u8 = [0; 8]
    rules: mutable [8]u8 = [0; 8]
    x: mutable i64 = code
    count: mutable usize = 0
    while true:
        d: i64 = x % 10
        if d > 1: return -1
        digits[count] <- d.u8()
        count <- count + 1
        x <- x / 10
        if x == 0: break
        if count == 8: return -1
    i: mutable usize = 0
    while i < count:
        rules[8-count+i] <- digits[count-1-i]
        i <- i + 1
    cells: mutable [17][31]u8 = [[0; 31]; 17]
    cells[0][15] <- 1u8()
    r: mutable usize = 0
    while r < 16:
        i <- 0
        while i < 31:
            left: i64 = 0
            center: i64 = cells[r][i].i64()
            right: i64 = 0
            if i > 0: left <- cells[r][i-1].i64()
            if i < 30: right <- cells[r][i+1].i64()
            pattern: usize = ((left << 2) | (center << 1) | right).usize()
            cells[r+1][i] <- rules[7-pattern]
            i <- i + 1
        r <- r + 1
    if capacity < 1581: return -2
    pos: mutable usize = 0
    r <- 0
    while r < 17:
        i <- 0
        while i < 31:
            color: u8 = 255u8()
            if cells[r][i] == 1u8(): color <- 0u8()
            output[pos] <- color; output[pos+1] <- color; output[pos+2] <- color
            pos <- pos + 3
            i <- i + 1
        r <- r + 1
    return pos.i64()

export fn one_dimensional(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = one_dimensional_impl
