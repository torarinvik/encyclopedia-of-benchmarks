const MAX_VERTICES: usize = 16
const MAX_EVENTS: usize = 64
const MAX_INPUT_VALUES: usize = 2 + 4 * MAX_EVENTS + 1
const TREE_NODES: usize = 4 * MAX_EVENTS + 8

def odb_add_interval(node: usize, left: usize, right: usize,
    query_left: usize, query_right: usize, edge_id: usize,
    bucket_count: mutable view[usize], buckets: mutable view[usize]) -> void:
    if query_left <= left and right <= query_right:
        slot: usize = node * MAX_EVENTS + bucket_count[node]
        buckets[slot] <- edge_id
        bucket_count[node] <- bucket_count[node] + 1
        return
    middle: usize = left + (right - left) / 2
    if query_left < middle:
        odb_add_interval(2 * node, left, middle, query_left, query_right,
            edge_id, bucket_count, buckets)
    if query_right > middle:
        odb_add_interval(2 * node + 1, middle, right, query_left, query_right,
            edge_id, bucket_count, buckets)

def odb_constrain_opposite(left: usize, right: usize,
    parent: mutable view[usize], set_size: mutable view[usize],
    xor_parent: mutable view[usize], history_kind: mutable view[usize],
    history_child: mutable view[usize], history_root: mutable view[usize],
    history_size: mutable view[usize], history_xor: mutable view[usize],
    history_count: mutable usize&, contradictions: mutable usize&) -> void:
    root_left: mutable usize = left
    root_right: mutable usize = right
    parity_left: mutable usize = 0
    parity_right: mutable usize = 0
    while parent[root_left] != root_left:
        parity_left <- parity_left ^ xor_parent[root_left]
        root_left <- parent[root_left]
    while parent[root_right] != root_right:
        parity_right <- parity_right ^ xor_parent[root_right]
        root_right <- parent[root_right]
    if root_left == root_right:
        if (parity_left ^ parity_right) != 1:
            history_kind[history_count] <- 1
            history_count <- history_count + 1
            contradictions <- contradictions + 1
        return
    if set_size[root_left] > set_size[root_right]:
        temporary: usize = root_left
        root_left <- root_right
        root_right <- temporary
    history_kind[history_count] <- 0
    history_child[history_count] <- root_left
    history_root[history_count] <- root_right
    history_size[history_count] <- set_size[root_right]
    history_xor[history_count] <- xor_parent[root_left]
    history_count <- history_count + 1
    parent[root_left] <- root_right
    xor_parent[root_left] <- parity_left ^ parity_right ^ 1
    set_size[root_right] <- set_size[root_right] + set_size[root_left]

def odb_rollback(checkpoint: usize, parent: mutable view[usize],
    set_size: mutable view[usize], xor_parent: mutable view[usize],
    history_kind: view[usize], history_child: view[usize],
    history_root: view[usize], history_size: view[usize],
    history_xor: view[usize], history_count: mutable usize&,
    contradictions: mutable usize&) -> void:
    while history_count > checkpoint:
        history_count <- history_count - 1
        entry: usize = history_count
        if history_kind[entry] == 1:
            contradictions <- contradictions - 1
        else:
            child: usize = history_child[entry]
            root: usize = history_root[entry]
            parent[child] <- child
            xor_parent[child] <- history_xor[entry]
            set_size[root] <- history_size[entry]

def odb_solve_time_tree(node: usize, left: usize, right: usize,
    operation: view[i64], edge_left: view[i64], edge_right: view[i64],
    bucket_count: view[usize], buckets: view[usize],
    parent: mutable view[usize], set_size: mutable view[usize],
    xor_parent: mutable view[usize], history_kind: mutable view[usize],
    history_child: mutable view[usize], history_root: mutable view[usize],
    history_size: mutable view[usize], history_xor: mutable view[usize],
    history_count: mutable usize&, contradictions: mutable usize&,
    answer: mutable view[i64]) -> void:
    checkpoint: usize = history_count
    entry: mutable usize = 0
    while entry < bucket_count[node]:
        edge_id: usize = buckets[node * MAX_EVENTS + entry]
        odb_constrain_opposite(edge_left[edge_id].usize(), edge_right[edge_id].usize(),
            parent, set_size, xor_parent, history_kind, history_child, history_root,
            history_size, history_xor, history_count, contradictions)
        entry <- entry + 1
    if right - left == 1:
        if operation[left] == 2:
            answer[left] <- if contradictions == 0 then 1 else 0
    else:
        middle: usize = left + (right - left) / 2
        odb_solve_time_tree(2 * node, left, middle, operation, edge_left,
            edge_right, bucket_count, buckets, parent, set_size, xor_parent,
            history_kind, history_child, history_root, history_size, history_xor,
            history_count, contradictions, answer)
        odb_solve_time_tree(2 * node + 1, middle, right, operation, edge_left,
            edge_right, bucket_count, buckets, parent, set_size, xor_parent,
            history_kind, history_child, history_root, history_size, history_xor,
            history_count, contradictions, answer)
    odb_rollback(checkpoint, parent, set_size, xor_parent, history_kind,
        history_child, history_root, history_size, history_xor,
        history_count, contradictions)

def odb_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def offline_dynamic_bipartiteness_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_VALUES:
        return -1
    input_view: view[i64] = input[0:length]
    if input_view[0] < 1 or input_view[0] > MAX_VERTICES.i64() or
        input_view[1] < 0 or input_view[1] > MAX_EVENTS.i64():
        return -1
    vertex_count: usize = input_view[0].usize()
    event_count: usize = input_view[1].usize()
    if length != 2 + 4 * event_count:
        return -1

    operation: mutable i64[MAX_EVENTS] = zeroed
    first: mutable i64[MAX_EVENTS] = zeroed
    second: mutable i64[MAX_EVENTS] = zeroed
    edge_left: mutable i64[MAX_EVENTS] = zeroed
    edge_right: mutable i64[MAX_EVENTS] = zeroed
    start_time: mutable usize[MAX_EVENTS] = zeroed
    used_id: mutable bool[MAX_EVENTS] = zeroed
    active: mutable bool[MAX_EVENTS] = zeroed
    query_count: mutable usize = 0
    time: mutable usize = 0
    while time < event_count:
        offset: usize = 2 + 4 * time
        operation[time] <- input_view[offset]
        first[time] <- input_view[offset + 1]
        second[time] <- input_view[offset + 2]
        third: i64 = input_view[offset + 3]
        if operation[time] == 0:
            edge_id: i64 = first[time]
            if edge_id < 0 or edge_id >= MAX_EVENTS.i64() or second[time] < 0 or
                second[time] > third or third >= vertex_count.i64() or
                used_id[edge_id.usize()]:
                return -1
            prior: mutable usize = 0
            while prior < MAX_EVENTS:
                if active[prior] and edge_left[prior] == second[time] and
                    edge_right[prior] == third:
                    return -1
                prior <- prior + 1
            used_id[edge_id.usize()] <- true
            active[edge_id.usize()] <- true
            start_time[edge_id.usize()] <- time
            edge_left[edge_id.usize()] <- second[time]
            edge_right[edge_id.usize()] <- third
        elif operation[time] == 1:
            edge_id: i64 = first[time]
            if edge_id < 0 or edge_id >= MAX_EVENTS.i64() or
                not active[edge_id.usize()] or second[time] != 0 or third != 0:
                return -1
            active[edge_id.usize()] <- false
        elif operation[time] == 2:
            if first[time] != 0 or second[time] != 0 or third != 0:
                return -1
            query_count <- query_count + 1
        else:
            return -1
        time <- time + 1

    required: usize = 8 * query_count
    if output.is_null() or capacity < required:
        return -2
    bucket_count: mutable usize[TREE_NODES] = zeroed
    buckets: mutable usize[TREE_NODES * MAX_EVENTS] = zeroed
    edge_id: mutable usize = 0
    while edge_id < MAX_EVENTS:
        if used_id[edge_id]:
            end_time: mutable usize = event_count
            if not active[edge_id]:
                time <- start_time[edge_id] + 1
                while time < event_count:
                    if operation[time] == 1 and first[time] == edge_id.i64():
                        end_time <- time
                        break
                    time <- time + 1
            if start_time[edge_id] < end_time and event_count != 0:
                odb_add_interval(1, 0, event_count, start_time[edge_id], end_time,
                    edge_id, bucket_count[0:TREE_NODES], buckets[0:TREE_NODES * MAX_EVENTS])
        edge_id <- edge_id + 1

    parent: mutable usize[MAX_VERTICES] = zeroed
    set_size: mutable usize[MAX_VERTICES] = zeroed
    xor_parent: mutable usize[MAX_VERTICES] = zeroed
    vertex: mutable usize = 0
    while vertex < vertex_count:
        parent[vertex] <- vertex
        set_size[vertex] <- 1
        vertex <- vertex + 1
    history_kind: mutable usize[MAX_EVENTS] = zeroed
    history_child: mutable usize[MAX_EVENTS] = zeroed
    history_root: mutable usize[MAX_EVENTS] = zeroed
    history_size: mutable usize[MAX_EVENTS] = zeroed
    history_xor: mutable usize[MAX_EVENTS] = zeroed
    history_count: mutable usize = 0
    contradictions: mutable usize = 0
    answer: mutable i64[MAX_EVENTS] = zeroed
    if event_count != 0:
        odb_solve_time_tree(1, 0, event_count, operation[0:MAX_EVENTS],
            edge_left[0:MAX_EVENTS], edge_right[0:MAX_EVENTS],
            bucket_count[0:TREE_NODES], buckets[0:TREE_NODES * MAX_EVENTS],
            parent[0:MAX_VERTICES], set_size[0:MAX_VERTICES],
            xor_parent[0:MAX_VERTICES], history_kind[0:MAX_EVENTS],
            history_child[0:MAX_EVENTS], history_root[0:MAX_EVENTS],
            history_size[0:MAX_EVENTS], history_xor[0:MAX_EVENTS],
            history_count, contradictions, answer[0:MAX_EVENTS])

    output_view: mutable view[u8] = output[0:required]
    written: mutable usize = 0
    time <- 0
    while time < event_count:
        if operation[time] == 2:
            odb_store_i64_le(answer[time], output_view, written)
            written <- written + 8
        time <- time + 1
    written.i64()

export fn offline_dynamic_bipartiteness(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = offline_dynamic_bipartiteness_impl
