def ordf_add(tree: mutable view[i64], n: usize, position: usize, delta: i64) -> void:
    index: mutable i64 = (position + 1).i64()
    while index <= n.i64():
        tree[index.usize()] <- tree[index.usize()] + delta
        index <- index + (index & -index)

def ordf_prefix(tree: view[i64], end: usize) -> i64:
    index: mutable usize = end
    sum: mutable i64 = 0
    while index > 0:
        sum <- sum + tree[index]
        index <- index & (index - 1)
    sum

def ordf_solve(values: view[i64]) -> i64:
    if values.len() < 3 or values.len() > 195: return -1
    nr: i64 = values[0]
    qr: i64 = values[1]
    if nr < 1 or nr > 64 or qr < 0 or qr > 64: return -1
    n: usize = nr.usize()
    q: usize = qr.usize()
    if values.len() != 2 + n + 2 * q: return -1
    for i in 0..<n:
        if values[2 + i] < 0 or values[2 + i] > 255: return -1
    head: mutable i64[65] = zeroed
    next: mutable i64[64] = zeroed
    last: mutable i64[256] = zeroed
    tree: mutable i64[65] = zeroed
    for i in 0..<65: head[i] <- -1
    for i in 0..<256: last[i] <- -1
    for i in 0..<q:
        left: i64 = values[2 + n + 2 * i]
        right: i64 = values[3 + n + 2 * i]
        if left < 0 or left > right or right > nr: return -1
        next[i] <- head[right.usize()]
        head[right.usize()] <- i.i64()
    result: mutable i64 = 0
    for right in 0..<(n + 1):
        if right > 0:
            value: usize = values[1 + right].usize()
            if last[value] >= 0: ordf_add(tree[0..<(n + 1)], n, last[value].usize(), -1)
            ordf_add(tree[0..<(n + 1)], n, right - 1, 1)
            last[value] <- (right - 1).i64()
        query: mutable i64 = head[right]
        while query >= 0:
            index: usize = query.usize()
            left: usize = values[2 + n + 2 * index].usize()
            result <- result + (query + 1) * (ordf_prefix(tree[0..<(n + 1)], right) - ordf_prefix(tree[0..<(n + 1)], left))
            query <- next[index]
    result

export fn offline_range_distinct_fenwick(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > 195: return -1
    ordf_solve(input[0:length])
