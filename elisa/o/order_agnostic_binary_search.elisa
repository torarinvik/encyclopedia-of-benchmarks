# Binary search over a monotone sequence in either direction.
def order_agnostic_binary_search_impl(values: i64&, length: usize) -> i64:
    if length < 3 or length > 100001: return -1
    target: i64 = values[0]
    count: i64 = values[1]
    if target < -2147483648 or target > 2147483647 or count < 1 or count > 99999: return -1
    if length != count.usize() + 2: return -1
    ascending: bool = values[2] < values[count.usize() + 1]
    start: mutable i64 = 0
    right: mutable i64 = count - 1
    while start <= right:
        middle: i64 = start + (right - start) / 2
        value: i64 = values[(middle + 2).usize()]
        if value == target: return middle
        if ascending:
            if value < target: start <- middle + 1
            else: right <- middle - 1
        else:
            if value > target: start <- middle + 1
            else: right <- middle - 1
    return -1

export fn order_agnostic_binary_search(values: i64&, length: usize) -> i64 = order_agnostic_binary_search_impl
