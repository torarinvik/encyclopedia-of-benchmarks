def android_unlock_middle_point(first: usize, second: usize) -> i64:
    if first == second: return -1
    first_x: i64 = (first % 3).i64()
    first_y: i64 = (first / 3).i64()
    second_x: i64 = (second % 3).i64()
    second_y: i64 = (second / 3).i64()
    delta_x: i64 = second_x - first_x
    delta_y: i64 = second_y - first_y
    if delta_x % 2 != 0 or delta_y % 2 != 0: return -1
    middle_x: i64 = (first_x + second_x) / 2
    middle_y: i64 = (first_y + second_y) / 2
    middle: i64 = middle_y * 3 + middle_x
    if middle == first.i64() or middle == second.i64(): return -1
    middle

def android_unlock_count_from(last: usize, visited: i64, used: usize, target: usize) -> i64:
    if used == target: return 1
    count: mutable i64 = 0
    next: mutable usize = 0
    while next < 9:
        bit: i64 = 1.i64() << next
        if (visited & bit) == 0:
            middle: i64 = android_unlock_middle_point(last, next)
            if middle < 0 or (visited & (1.i64() << middle.usize())) != 0:
                count <- count + android_unlock_count_from(next, visited | bit, used + 1, target)
        next <- next + 1
    count

def android_unlock_pattern_count_impl(input: i64&, length: usize) -> i64:
    if input == null or length != 1: return -1
    target_value: i64 = input[0]
    if target_value < 4 or target_value > 9: return -1
    target: usize = target_value.usize()
    count: mutable i64 = 0
    start: mutable usize = 0
    while start < 9:
        count <- count + android_unlock_count_from(start, 1.i64() << start, 1, target)
        start <- start + 1
    count

export fn android_unlock_pattern_count(input: i64&, length: usize) -> i64 = android_unlock_pattern_count_impl
