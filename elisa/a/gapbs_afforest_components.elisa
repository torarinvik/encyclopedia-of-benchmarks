# Clean-room bounded GAPBS Afforest profile; see package LICENSE.txt.
const GAPBS_AFFOREST_MAX_N: usize = 16
const GAPBS_AFFOREST_MAX_M: usize = 64
const GAPBS_AFFOREST_MAX_SAMPLES: usize = 64
const GAPBS_AFFOREST_MAX_INPUT: usize = 195

def gapbs_afforest_link(u: usize, v: usize, component: mutable usize&) -> void:
    p1: mutable usize = component[u]
    p2: mutable usize = component[v]
    while p1 != p2:
        high: usize = if p1 > p2: p1 else: p2
        low: usize = if p1 < p2: p1 else: p2
        parent_high: usize = component[high]
        if parent_high == low: break
        if parent_high == high:
            component[high] <- low
            break
        p1 <- component[component[high]]
        p2 <- component[low]

def gapbs_afforest_compress(n: usize, component: mutable usize&) -> void:
    vertex: mutable usize = 0
    while vertex < n:
        while component[vertex] != component[component[vertex]]:
            component[vertex] <- component[component[vertex]]
        vertex <- vertex + 1

def gapbs_afforest_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def gapbs_afforest_components(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("gapbs_afforest_components"):
    if input.is_null() or length < 4 or length > GAPBS_AFFOREST_MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    sample_count64: i64 = input[2]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 64 or sample_count64 < 1 or sample_count64 > 64: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    sample_count: usize = sample_count64.usize()
    if length != 3 + sample_count + 2 * m: return -1
    samples: mutable usize[64] = zeroed
    i: mutable usize = 0
    while i < sample_count:
        sample: i64 = input[3 + i]
        if sample < 0 or sample >= n64: return -1
        samples[i] <- sample.usize()
        i <- i + 1
    adjacency: mutable u8[256] = zeroed
    edge: mutable usize = 0
    while edge < m:
        pos: usize = 3 + sample_count + 2 * edge
        u_value: i64 = input[pos]
        v_value: i64 = input[pos + 1]
        if u_value < 0 or v_value <= u_value or v_value >= n64: return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        if adjacency[u * 16 + v] != 0: return -1
        adjacency[u * 16 + v] <- 1
        adjacency[v * 16 + u] <- 1
        edge <- edge + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes: return -2

    neighbors: mutable usize[256] = zeroed
    degree: mutable usize[16] = zeroed
    u: mutable usize = 0
    while u < n:
        v: mutable usize = 0
        while v < n:
            if adjacency[u * 16 + v] != 0:
                neighbors[u * 16 + degree[u]] <- v
                degree[u] <- degree[u] + 1
            v <- v + 1
        u <- u + 1
    component: mutable usize[16] = zeroed
    u <- 0
    while u < n:
        component[u] <- u
        u <- u + 1
    round: mutable usize = 0
    while round < 2:
        u <- 0
        while u < n:
            if degree[u] > round:
                gapbs_afforest_link(u, neighbors[u * 16 + round], component)
            u <- u + 1
        gapbs_afforest_compress(n, component)
        round <- round + 1
    sample_counts: mutable usize[16] = zeroed
    i <- 0
    while i < sample_count:
        sample_counts[component[samples[i]]] <- sample_counts[component[samples[i]]] + 1
        i <- i + 1
    skip_label: mutable usize = 0
    label: mutable usize = 1
    while label < n:
        if sample_counts[label] > sample_counts[skip_label]: skip_label <- label
        label <- label + 1
    skip_is_safe: mutable bool = true
    u <- 0
    while u < n and skip_is_safe:
        if component[u] == skip_label:
            offset: mutable usize = 2
            while offset < degree[u]:
                if component[neighbors[u * 16 + offset]] != skip_label:
                    skip_is_safe <- false
                    break
                offset <- offset + 1
        u <- u + 1
    u <- 0
    while u < n:
        if not (skip_is_safe and component[u] == skip_label):
            offset: mutable usize = 2
            while offset < degree[u]:
                gapbs_afforest_link(u, neighbors[u * 16 + offset], component)
                offset <- offset + 1
        u <- u + 1
    gapbs_afforest_compress(n, component)
    u <- 0
    while u < n:
        gapbs_afforest_store_i64_le(component[u].i64(), output, 8 * u)
        u <- u + 1
    output_bytes.i64()
