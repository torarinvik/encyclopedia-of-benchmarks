# Count three-array occurrences and emit keys with total count exactly three.
const TABLE_SIZE: usize = 257
const MAX_OCCURRENCES: usize = 192
const ARRAY_COUNT: usize = 3

def arrays_intersection_add_occurrence(value: i64, keys: mutable i64&, counts: mutable usize&,
        occupied: mutable bool&, order: mutable usize&, order_length: mutable usize&) -> void:
    remainder: mutable i64 = value % 257
    if remainder < 0:
        remainder <- remainder + 257
    slot: mutable usize = remainder.usize()
    while occupied[slot] and keys[slot] != value:
        slot <- (slot + 1) % TABLE_SIZE
    if not occupied[slot]:
        occupied[slot] <- true
        keys[slot] <- value
        counts[slot] <- 0
        order[order_length] <- slot
        order_length <- order_length + 1
    counts[slot] <- counts[slot] + 1

def arrays_intersection_store_i32_le(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u32 = value.u32()
    for byte in 0 ..< 4:
        output[position + byte] <- ((bits >> (byte * 8)) & 255).u8()

def arrays_intersection_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < ARRAY_COUNT or length > 195:
        return -1
    starts: mutable usize[ARRAY_COUNT] = zeroed
    sizes: mutable usize[ARRAY_COUNT] = zeroed
    position: mutable usize = 0
    array: mutable usize = 0
    while array < ARRAY_COUNT:
        if position >= length or input[position] < 0 or input[position] > 64:
            return -1
        size: usize = input[position].usize()
        position <- position + 1
        if size > length - position:
            return -1
        starts[array] <- position
        sizes[array] <- size
        index: mutable usize = 0
        while index < size:
            if input[position + index] < -2147483648 or input[position + index] > 2147483647:
                return -1
            index <- index + 1
        position <- position + size
        array <- array + 1
    if position != length:
        return -1

    keys: mutable i64[TABLE_SIZE] = zeroed
    counts: mutable usize[TABLE_SIZE] = zeroed
    occupied: mutable bool[TABLE_SIZE] = zeroed
    order: mutable usize[MAX_OCCURRENCES] = zeroed
    order_length: mutable usize = 0
    array <- 0
    while array < ARRAY_COUNT:
        index <- 0
        while index < sizes[array]:
            arrays_intersection_add_occurrence(input[starts[array] + index], &keys[0], &counts[0], &occupied[0], &order[0], order_length)
            index <- index + 1
        array <- array + 1

    match_count: mutable usize = 0
    index <- 0
    while index < order_length:
        if counts[order[index]] == ARRAY_COUNT:
            match_count <- match_count + 1
        index <- index + 1
    required: usize = match_count * 4
    if output_capacity < required:
        return -2
    written: mutable usize = 0
    index <- 0
    while index < order_length:
        slot: usize = order[index]
        if counts[slot] == ARRAY_COUNT:
            arrays_intersection_store_i32_le(keys[slot], output, written * 4)
            written <- written + 1
        index <- index + 1
    written.i64()

export fn arrays_intersection(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = arrays_intersection_impl
