# Return the unique mode of a bounded integer sequence.
def average_mode_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 64:
        return -1
    index: mutable usize = 0
    while index < length:
        if values[index] < 0 or values[index] > 1000:
            return -1
        index <- index + 1

    mode: mutable i64 = -1
    maximum_count: mutable usize = 0
    tied: mutable bool = false
    index <- 0
    while index < length:
        seen: mutable bool = false
        before: mutable usize = 0
        while before < index:
            if values[before] == values[index]:
                seen <- true
                break
            before <- before + 1
        if not seen:
            count: mutable usize = 0
            scan: mutable usize = 0
            while scan < length:
                if values[scan] == values[index]:
                    count <- count + 1
                scan <- scan + 1
            if count > maximum_count:
                maximum_count <- count
                mode <- values[index]
                tied <- false
            elif count == maximum_count:
                tied <- true
        index <- index + 1
    if tied:
        return -1
    mode

export fn average_mode(values: i64&, length: usize) -> i64 = average_mode_impl
