const MAX_DIGITS: usize = 1024
const MAX_INPUT_LENGTH: usize = 2050

# Add reverse-order decimal digit lists with a carry propagated per node.
def add_two_numbers_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    first_length_value: i64 = input[0]
    second_length_value: i64 = input[1]
    if first_length_value < 0 or first_length_value > 1024 or second_length_value < 0 or second_length_value > 1024:
        return -1
    first_length: usize = first_length_value.usize()
    second_length: usize = second_length_value.usize()
    if length != first_length + second_length + 2:
        return -1
    for index in 0..<(first_length + second_length) |input|:
        value: i64 = input[index + 2]
        if value < 0 or value > 9:
            return -1

    digit_count: usize = first_length if first_length > second_length else second_length
    digits: mutable u8[1025] = zeroed
    result_length: mutable usize = 0
    carry: mutable i64 = 0
    index: mutable usize = 0
    while index < digit_count or carry != 0 |index, carry, result_length, digits, input, first_length, second_length|:
        first: mutable i64 = 0
        second: mutable i64 = 0
        if index < first_length:
            first <- input[index + 2]
        if index < second_length:
            second <- input[index + 2 + first_length]
        sum: i64 = first + second + carry
        digits[result_length] <- (sum % 10).u8()
        result_length <- result_length + 1
        carry <- sum / 10
        index <- index + 1
    if output_capacity < result_length:
        return -2
    for position in 0..<result_length |digits, output|:
        output[position] <- digits[position]
    result_length.i64()

export fn add_two_numbers(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = add_two_numbers_impl
