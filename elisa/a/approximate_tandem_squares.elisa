def tandem_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits >> (byte * 8)).u8()

def approximate_tandem_squares_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 34:
        return -1
    n0: i64 = input[0]
    budget: i64 = input[1]
    if n0 < 2 or n0 > 32 or budget < 0 or budget > 8 or length != n0.usize() + 2:
        return -1
    n: usize = n0.usize()
    for i in 0..<n:
        if input[2 + i] < 0 or input[2 + i] > 3:
            return -1
    records: mutable i64[768] = zeroed
    count: mutable usize = 0
    start: mutable usize = 0
    while start < n:
        period: mutable usize = 1
        while 2 * period <= n - start:
            mismatches: mutable i64 = 0
            i: mutable usize = 0
            while i < period:
                if input[2 + start + i] != input[2 + start + period + i]:
                    mismatches <- mismatches + 1
                i <- i + 1
            if mismatches <= budget:
                records[3 * count] <- start.i64()
                records[3 * count + 1] <- period.i64()
                records[3 * count + 2] <- mismatches
                count <- count + 1
            period <- period + 1
        start <- start + 1
    output_length: usize = 8 * (1 + 3 * count)
    if output == null or capacity < output_length:
        return -2
    tandem_put_i64(output[0:output_length], 0, count.i64())
    for i in 0..<3 * count:
        tandem_put_i64(output[0:output_length], (1 + i) * 8, records[i])
    output_length.i64()

export fn approximate_tandem_squares(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = approximate_tandem_squares_impl
