# Exact decimal digit powers; 1 for Armstrong numbers and 0 otherwise.
def armstrong_number_impl(n: i64) -> i64:
    return 0 if n < 0
    return 1 if n == 0
        
    digits: i64 =
        while remaining > 0 |remaining: i64 = n, count: i64 = 0| -> count:
            count <- count + 1
            remaining <- remaining / 10
    total: i64 =
        while remaining > 0 |remaining: i64 = n, sum: i64 = 0| -> sum:
            digit: i64 = remaining % 10
            power: i64 =
                while exponent < digits |exponent: i64 = 0, product: i64 = 1| -> product:
                    product <- product * digit
                    exponent <- exponent + 1
            
            return 0 if power > n - sum
            sum <- sum + power
            remaining <- remaining / 10
    1 if total == n else 0

export fn armstrong_number(n: i64) -> i64 = armstrong_number_impl
