const MAX_ENCODED_VALUE: i64 = 999999999

def anyto_any_impl(input: i64&, length: usize) -> i64:
    if length != 3:
        return -1
    encoded: mutable i64 = input[0]
    source_base: i64 = input[1]
    destination_base: i64 = input[2]
    if encoded < 0 or encoded > MAX_ENCODED_VALUE or source_base < 2 or source_base > 10 or destination_base < 2 or destination_base > 10:
        return -1

    decimal_value: mutable i64 = 0
    source_multiplier: mutable i64 = 1
    while encoded > 0:
        digit: i64 = encoded % 10
        if digit >= source_base:
            return -1
        decimal_value <- decimal_value + digit * source_multiplier
        source_multiplier <- source_multiplier * source_base
        encoded <- encoded / 10

    result: mutable i64 = 0
    destination_multiplier: mutable i64 = 1
    while decimal_value > 0:
        digit: i64 = decimal_value % destination_base
        result <- result + digit * destination_multiplier
        decimal_value <- decimal_value / destination_base
        if decimal_value > 0:
            if destination_multiplier > MAX_ENCODED_VALUE / 10:
                return -1
            destination_multiplier <- destination_multiplier * 10
    result

export fn anyto_any(input: i64&, length: usize) -> i64 = anyto_any_impl
