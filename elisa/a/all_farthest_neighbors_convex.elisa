struct FarthestPoint:
    x: i64
    y: i64

def farthest_score(points: view[FarthestPoint], n: usize, row: usize, col: usize) -> i64:
    if col <= row: return col.i64()-row.i64()
    if col >= row+n: return -1
    dx: i64 = points[row].x-points[col%n].x
    dy: i64 = points[row].y-points[col%n].y
    dx*dx+dy*dy

def farthest_maxima(points: view[FarthestPoint], n: usize, rows: view[usize],
                    columns: view[usize], answer: mutable view[usize]) -> void:
    if rows.len() == 0: return
    reduced: mutable usize[127] = zeroed
    count: mutable usize = 0
    for column_index in 0..<columns.len():
        col: usize = columns[column_index]
        while count > 0 and farthest_score(points,n,rows[count-1],col) > farthest_score(points,n,rows[count-1],reduced[count-1]):
            count <- count-1
        if count < rows.len():
            reduced[count] <- col
            count <- count+1
    odd: mutable usize[32] = zeroed
    odd_count: mutable usize = 0
    i: mutable usize = 1
    while i < rows.len():
        odd[odd_count] <- rows[i]
        odd_count <- odd_count+1
        i <- i+2
    farthest_maxima(points,n,odd[0:odd_count],reduced[0:count],answer)
    low: mutable usize = 0
    i <- 0
    while i < rows.len():
        high: mutable usize = count-1
        if i+1 < rows.len():
            high <- low
            while reduced[high] != answer[rows[i+1]]: high <- high+1
        best: mutable usize = low
        j: mutable usize = low+1
        while j <= high:
            if farthest_score(points,n,rows[i],reduced[j]) > farthest_score(points,n,rows[i],reduced[best]): best <- j
            j <- j+1
        answer[rows[i]] <- reduced[best]
        low <- high
        i <- i+2

def all_farthest_neighbors_convex_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 7 or length > 129: return -1
    values: view[i64] = input[0:length]
    if values[0] < 3 or values[0] > 64: return -1
    n: usize = values[0].usize()
    if length != 1+2*n: return -1
    points: mutable FarthestPoint[64] = zeroed
    for i in 0..<n:
        x: i64 = values[1+2*i]
        y: i64 = values[2+2*i]
        if x < -1000000 or x > 1000000 or y < -1000000 or y > 1000000: return -1
        points[i] <- FarthestPoint{x: x, y: y}
    for i in 0..<n:
        a: FarthestPoint = points[i]
        b: FarthestPoint = points[(i+1)%n]
        c: FarthestPoint = points[(i+2)%n]
        if (b.x-a.x)*(c.y-b.y)-(b.y-a.y)*(c.x-b.x) >= 0: return -1
    if output == null or capacity < 8*n: return -2
    result: mutable view[u8] = output[0:8*n]
    rows: mutable usize[64] = zeroed
    columns: mutable usize[127] = zeroed
    answer: mutable usize[64] = zeroed
    for i in 0..<n: rows[i] <- i
    for i in 0..<2*n-1: columns[i] <- i
    farthest_maxima(points[0:n],n,rows[0:n],columns[0:2*n-1],answer[0:n])
    for i in 0..<n:
        index: u64 = (answer[i]%n).u64()
        for byte in 0..<8: result[8*i+byte] <- ((index >> (8*byte)) & 255.u64()).u8()
    (8*n).i64()

export fn all_farthest_neighbors_convex(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = all_farthest_neighbors_convex_impl
