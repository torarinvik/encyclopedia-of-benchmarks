const MAX_TERMS: usize = 64
const MAX_WORDS: usize = 66
const VALUE_LIMIT: i64 = 1000000

def aitken_gcd(left_value: u64, right_value: u64) -> u64:
    left: mutable u64 = left_value
    right: mutable u64 = right_value
    while right != 0:
        remainder: u64 = left % right
        left <- right
        right <- remainder
    left

def aitken_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()

def aitken_validate(input: i64&, length: usize) -> bool:
    if length < 3 or length > MAX_WORDS:
        return false
    n_value: i64 = input[0]
    if n_value < 2 or n_value > MAX_TERMS.i64():
        return false
    n: usize = n_value.usize()
    if length != n + 1:
        return false
    for index in 0..<n:
        if input[index + 1] < -VALUE_LIMIT or input[index + 1] > VALUE_LIMIT:
            return false
    true

def aitken_delta_squared_sequence_transform_impl(input: i64&,
        output: mutable u8&, output_capacity: usize) -> i64:
    n: usize = input[0].usize()
    output_length: usize = 16 * (n - 2)
    if output_capacity < output_length:
        return -2

    for index in 0..<(n - 2):
        first: i64 = input[index + 1]
        middle: i64 = input[index + 2]
        last: i64 = input[index + 3]
        numerator: mutable i64 = first * last - middle * middle
        denominator: mutable i64 = first - 2 * middle + last
        if denominator == 0:
            if first == middle and middle == last:
                numerator <- first
                denominator <- 1
            else:
                numerator <- 0
        else:
            if denominator < 0:
                numerator <- -numerator
                denominator <- -denominator
            magnitude: u64 = (-numerator).u64() if numerator < 0 else numerator.u64()
            divisor: u64 = aitken_gcd(magnitude, denominator.u64())
            numerator <- numerator / divisor.i64()
            denominator <- denominator / divisor.i64()
        offset: usize = index * 16
        aitken_store_i64(output, offset, numerator)
        aitken_store_i64(output, offset + 8, denominator)
    output_length.i64()

def aitken_delta_squared_sequence_transform_entry(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_WORDS:
        return -1
    if not aitken_validate(input, length):
        return -1
    if output == null:
        return -2
    writable_length: mutable usize = output_capacity
    if writable_length > 992:
        writable_length <- 992
    aitken_delta_squared_sequence_transform_impl(
        input, output, output_capacity)

export fn aitken_delta_squared_sequence_transform(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = aitken_delta_squared_sequence_transform_entry
