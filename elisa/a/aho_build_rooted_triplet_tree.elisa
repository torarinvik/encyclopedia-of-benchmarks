from std.collections import InlineArray

const MAX_TAXA: usize = 7
const MAX_TRIPLETS: usize = 105
const MAX_NODES: usize = 13

def write_word(output: mutable view[u8], offset: usize, value: i64) -> void:
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((value >> (8 * byte)) & 255).u8()
        byte <- byte + 1

@export("aho_build_rooted_triplet_tree")
def aho_build_rooted_triplet_tree(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 318: return -1
    var values: view[i64] = input[0:length]
    if length < 2 or length > 318: return -1
    n0: i64 = values[0]
    q0: i64 = values[1]
    if n0 < 1 or n0 > 7 or q0 < 0: return -1
    n: usize = n0.usize()
    q_limit: mutable usize = 0
    if n >= 3: q_limit <- n * (n - 1) * (n - 2) / 2
    if q0 > q_limit.i64(): return -1
    q: usize = q0.usize()
    if length != 2 + 3 * q: return -1

    var triples = InlineArray[Int, 315](fill=0)
    i: mutable usize = 0
    while i < q:
        aa: i64 = values[2 + 3 * i]
        bb: i64 = values[3 + 3 * i]
        cc: i64 = values[4 + 3 * i]
        if aa < 0 or aa >= n0 or bb < 0 or bb >= n0 or cc < 0 or cc >= n0 or aa == bb or aa == cc or bb == cc: return -1
        a: mutable Int = aa.int()
        b: mutable Int = bb.int()
        c: Int = cc.int()
        if a > b:
            temp: Int = a
            a <- b
            b <- temp
        j: mutable usize = 0
        while j < i:
            if triples[3 * j] == a and triples[3 * j + 1] == b and triples[3 * j + 2] == c: return -1
            j <- j + 1
        triples[3 * i] <- a
        triples[3 * i + 1] <- b
        triples[3 * i + 2] <- c
        i <- i + 1

    var kind = InlineArray[Int, 13](fill=0)
    var node_value = InlineArray[Int, 13](fill=0)
    var tasks = InlineArray[Int, 13](fill=0)
    tasks[0] <- ((1 << n) - 1)
    top: mutable usize = 1
    node_count: mutable usize = 0
    compatible: mutable Bool = True
    while top > 0:
        top <- top - 1
        mask: Int = tasks[top]
        if (mask & (mask - 1)) == 0:
            label: mutable Int = 0
            while (mask & (1 << label)) == 0:
                label <- label + 1
            kind[node_count] <- 1
            node_value[node_count] <- label
            node_count <- node_count + 1
            continue
        var edge = InlineArray[Bool, 49](fill=False)
        j <- 0
        while j < q:
            a: Int = triples[3 * j]
            b: Int = triples[3 * j + 1]
            c: Int = triples[3 * j + 2]
            needed: Int = (1 << a) | (1 << b) | (1 << c)
            if (mask & needed) == needed:
                edge[a * 7 + b] <- True
                edge[b * 7 + a] <- True
            j <- j + 1
        var seen = InlineArray[Bool, 7](fill=False)
        var components = InlineArray[Int, 7](fill=0)
        component_count: mutable usize = 0
        start: mutable usize = 0
        while start < n:
            if (mask & (1 << start)) != 0 and not seen[start]:
                var queue = InlineArray[Int, 7](fill=0)
                head: mutable usize = 0
                tail: mutable usize = 1
                component: mutable Int = 0
                queue[0] <- start.int()
                seen[start] <- True
                while head < tail:
                    current: Int = queue[head]
                    head <- head + 1
                    component <- component | (1 << current)
                    other: mutable usize = 0
                    while other < n:
                        if edge[current * 7 + other.int()] and not seen[other]:
                            seen[other] <- True
                            queue[tail] <- other.int()
                            tail <- tail + 1
                        other <- other + 1
                components[component_count] <- component
                component_count <- component_count + 1
            start <- start + 1
        if component_count == 1:
            compatible <- False
            break
        kind[node_count] <- 0
        node_value[node_count] <- component_count.int()
        node_count <- node_count + 1
        k: mutable usize = component_count
        while k > 0:
            k <- k - 1
            tasks[top] <- components[k]
            top <- top + 1

    var words = InlineArray[i64, 14](fill=0)
    word_count: mutable usize = 1
    if compatible:
        words[0] <- node_count.i64()
        i <- 0
        while i < node_count:
            if kind[i] == 1: words[i + 1] <- -(node_value[i].i64() + 1)
            else: words[i + 1] <- node_value[i].i64()
            i <- i + 1
        word_count <- word_count + node_count
    bytes: usize = word_count * 8
    if output.is_null() or capacity < bytes: return -2
    var result: mutable view[u8] = output[0:bytes]
    i <- 0
    while i < word_count:
        write_word(result, i * 8, words[i])
        i <- i + 1
    bytes.i64()

