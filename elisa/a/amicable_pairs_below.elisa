# Enumerate amicable pairs below an exclusive upper limit using a divisor-sum sieve.
def write_u32_le(output: mutable u8&, position: mutable usize&, value: i64):
    encoded: mutable i64 = value
    byte: mutable usize = 0
    while byte < 4:
        output[position] <- (encoded % 256).u8()
        encoded <- encoded / 256
        position <- position + 1
        byte <- byte + 1

def amicable_pairs_below_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if length != 1:
        return -1
    limit_value: i64 = values[0]
    if limit_value < 1 or limit_value > 8000:
        return -1
    limit: usize = limit_value.usize()
    divisor_sums: mutable i64[8000] = zeroed
    divisor: mutable usize = 1
    while divisor < limit:
        multiple: mutable usize = divisor * 2
        while multiple < limit:
            divisor_sums[multiple] <- divisor_sums[multiple] + divisor.i64()
            multiple <- multiple + divisor
        divisor <- divisor + 1

    pair_count: mutable usize = 0
    smaller: mutable usize = 2
    while smaller < limit:
        larger: i64 = divisor_sums[smaller]
        if larger > smaller.i64() and larger < limit.i64() and divisor_sums[larger.usize()] == smaller.i64():
            pair_count <- pair_count + 1
        smaller <- smaller + 1
    required: usize = pair_count * 8
    if output_capacity < required:
        return -2

    position: mutable usize = 0
    smaller <- 2
    while smaller < limit:
        larger: i64 = divisor_sums[smaller]
        if larger > smaller.i64() and larger < limit.i64() and divisor_sums[larger.usize()] == smaller.i64():
            write_u32_le(output, position, smaller.i64())
            write_u32_le(output, position, larger)
        smaller <- smaller + 1
    pair_count.i64()

export fn amicable_pairs_below(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = amicable_pairs_below_impl
