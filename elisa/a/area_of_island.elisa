# Return the size of the largest four-connected nonzero region.
const MAX_CELLS: usize = 4096

def area_of_island_impl(input: i64&, length: usize) -> i64:
    if length < 2 or input[0] < 1 or input[0] > 64 or input[1] < 0 or input[1] > 64:
        return -1
    rows: usize = input[0].usize()
    columns: usize = input[1].usize()
    cells: usize = rows * columns
    if length != cells + 2:
        return -1

    visited: mutable bool[MAX_CELLS] = zeroed
    work_stack: mutable usize[MAX_CELLS] = zeroed
    maximum_area: mutable usize = 0
    start: mutable usize = 0
    while start < cells:
        if input[2 + start] != 0 and not visited[start]:
            top: mutable usize = 0
            area: mutable usize = 0
            visited[start] <- true
            work_stack[top] <- start
            top <- top + 1
            while top > 0:
                top <- top - 1
                current: usize = work_stack[top]
                area <- area + 1
                row: usize = current / columns
                column: usize = current % columns
                neighbor: mutable usize = 0
                if row > 0:
                    neighbor <- current - columns
                    if not visited[neighbor] and input[2 + neighbor] != 0:
                        visited[neighbor] <- true
                        work_stack[top] <- neighbor
                        top <- top + 1
                if column + 1 < columns:
                    neighbor <- current + 1
                    if not visited[neighbor] and input[2 + neighbor] != 0:
                        visited[neighbor] <- true
                        work_stack[top] <- neighbor
                        top <- top + 1
                if row + 1 < rows:
                    neighbor <- current + columns
                    if not visited[neighbor] and input[2 + neighbor] != 0:
                        visited[neighbor] <- true
                        work_stack[top] <- neighbor
                        top <- top + 1
                if column > 0:
                    neighbor <- current - 1
                    if not visited[neighbor] and input[2 + neighbor] != 0:
                        visited[neighbor] <- true
                        work_stack[top] <- neighbor
                        top <- top + 1
            if area > maximum_area:
                maximum_area <- area
        start <- start + 1
    maximum_area.i64()

export fn area_of_island(input: i64&, length: usize) -> i64 = area_of_island_impl
