# Scalar reverse-mode port of TheAlgorithms/Python automatic_differentiation.py.
const MAX_LEAVES: usize = 32
const MAX_OPERATIONS: usize = 64
const MAX_NODES: usize = 96
const INVALID_RESULT: f64 = -1.0e300

def automatic_differentiation_integer_power(value: f64, exponent: usize) -> f64:
    result: mutable f64 = 1.0
    index: mutable usize = 0
    while index < exponent:
        result <- result * value
        index <- index + 1
    result

def automatic_differentiation_impl(input: i64&, length: usize) -> f64:
    if input == null or length < 8:
        return INVALID_RESULT
    leaves_value: i64 = input[0]
    operations_value: i64 = input[1]
    if leaves_value < 1 or leaves_value > 32 or operations_value < 1 or operations_value > 64:
        return INVALID_RESULT
    leaves: usize = leaves_value.usize()
    operation_count: usize = operations_value.usize()
    if length != 4 + leaves + 3 * operation_count:
        return INVALID_RESULT
    node_count: usize = leaves + operation_count
    target_value: i64 = input[2]
    source_value: i64 = input[3]
    if target_value < leaves_value or target_value >= node_count.i64() or source_value < 0 or source_value >= leaves_value:
        return INVALID_RESULT
    target: usize = target_value.usize()
    source: usize = source_value.usize()

    nodes: mutable f64[96] = zeroed
    opcodes: mutable i64[64] = zeroed
    left_nodes: mutable usize[64] = zeroed
    right_fields: mutable i64[64] = zeroed
    for index in 0..<leaves:
        value: i64 = input[4 + index]
        if value < -16 or value > 16:
            return INVALID_RESULT
        nodes[index] <- value.f64()

    offset: mutable usize = 4 + leaves
    for operation in 0..<operation_count:
        opcode: i64 = input[offset]
        left_value: i64 = input[offset + 1]
        right_value: i64 = input[offset + 2]
        output_node: usize = leaves + operation
        if left_value < 0 or left_value >= output_node.i64():
            return INVALID_RESULT
        left: usize = left_value.usize()
        result: mutable f64 = 0.0
        if opcode == 5:
            if right_value < 1 or right_value > 8:
                return INVALID_RESULT
            result <- automatic_differentiation_integer_power(nodes[left], right_value.usize())
        else:
            if opcode < 0 or opcode > 3 or right_value < 0 or right_value >= output_node.i64():
                return INVALID_RESULT
            right: usize = right_value.usize()
            if opcode == 0:
                result <- nodes[left] + nodes[right]
            elif opcode == 1:
                result <- nodes[left] - nodes[right]
            elif opcode == 2:
                result <- nodes[left] * nodes[right]
            else:
                if nodes[right] == 0.0:
                    return INVALID_RESULT
                result <- nodes[left] / nodes[right]
        if result != result or result < -10000000000.0 or result > 10000000000.0:
            return INVALID_RESULT
        nodes[output_node] <- result
        opcodes[operation] <- opcode
        left_nodes[operation] <- left
        right_fields[operation] <- right_value
        offset <- offset + 3

    adjoints: mutable f64[96] = zeroed
    ancestors: mutable u8[96] = zeroed
    adjoints[target] <- 1.0
    ancestors[target] <- 1
    cursor: mutable usize = target - leaves + 1
    while cursor > 0:
        cursor <- cursor - 1
        operation: usize = cursor
        output_node: usize = leaves + operation
        if ancestors[output_node] == 0:
            continue
        left: usize = left_nodes[operation]
        adjoint: f64 = adjoints[output_node]
        ancestors[left] <- 1
        opcode: i64 = opcodes[operation]
        if opcode == 0:
            right: usize = right_fields[operation].usize()
            ancestors[right] <- 1
            adjoints[left] <- adjoints[left] + adjoint
            adjoints[right] <- adjoints[right] + adjoint
        elif opcode == 1:
            right: usize = right_fields[operation].usize()
            ancestors[right] <- 1
            adjoints[left] <- adjoints[left] + adjoint
            adjoints[right] <- adjoints[right] - adjoint
        elif opcode == 2:
            right: usize = right_fields[operation].usize()
            ancestors[right] <- 1
            adjoints[left] <- adjoints[left] + nodes[right] * adjoint
            adjoints[right] <- adjoints[right] + nodes[left] * adjoint
        elif opcode == 3:
            right: usize = right_fields[operation].usize()
            left_value: f64 = nodes[left]
            right_value: f64 = nodes[right]
            ancestors[right] <- 1
            adjoints[left] <- adjoints[left] + (1.0 / right_value) * adjoint
            adjoints[right] <- adjoints[right] + (-left_value / (right_value * right_value)) * adjoint
        else:
            exponent: usize = right_fields[operation].usize()
            local_derivative: f64 = exponent.f64() * automatic_differentiation_integer_power(nodes[left], exponent - 1)
            adjoints[left] <- adjoints[left] + local_derivative * adjoint
    if ancestors[source] == 0 or adjoints[source] != adjoints[source] or adjoints[source] < -1.0e300 or adjoints[source] > 1.0e300:
        return INVALID_RESULT
    adjoints[source]

export fn automatic_differentiation(input: i64&, length: usize) -> f64 = automatic_differentiation_impl
