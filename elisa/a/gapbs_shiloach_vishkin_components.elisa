const GAPBS_SV_MAX_N: usize = 16

def gapbs_shiloach_vishkin_components_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 130: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 16 or m_value < 0 or m_value > 64 or length != 2 + 2 * m_value.usize(): return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    adjacency: mutable u8[256] = zeroed
    edge: mutable usize = 0
    while edge < m:
        pos: usize = 2 + 2 * edge
        u_value: i64 = input[pos]
        v_value: i64 = input[pos + 1]
        if u_value < 0 or v_value <= u_value or v_value >= n_value: return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        if adjacency[u * 16 + v] != 0: return -1
        adjacency[u * 16 + v] <- 1
        adjacency[v * 16 + u] <- 1
        edge <- edge + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes: return -2
    component: mutable usize[16] = zeroed
    node: mutable usize = 0
    while node < n:
        component[node] <- node
        node <- node + 1
    changed: mutable bool = true
    rounds: mutable usize = 0
    round_limit: usize = n * n + 1
    while changed and rounds < round_limit:
        changed <- false
        u: mutable usize = 0
        while u < n:
            v: mutable usize = 0
            while v < n:
                if adjacency[u * 16 + v] != 0:
                    component_u: usize = component[u]
                    component_v: usize = component[v]
                    if component_u != component_v:
                        high: usize = if component_u > component_v: component_u else: component_v
                        low: usize = component_u + component_v - high
                        if component[high] == high:
                            changed <- true
                            component[high] <- low
                v <- v + 1
            u <- u + 1
        node <- 0
        while node < n:
            while component[node] != component[component[node]]:
                component[node] <- component[component[node]]
            node <- node + 1
        rounds <- rounds + 1
    if changed: return -1
    node <- 0
    while node < n:
        value: i64 = component[node].i64()
        bits: u64 = value.u64()
        byte: mutable usize = 0
        while byte < 8:
            output[node * 8 + byte] <- ((bits >> (byte * 8)) & 255).u8()
            byte <- byte + 1
        node <- node + 1
    return output_bytes.i64()

export fn gapbs_shiloach_vishkin_components(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = gapbs_shiloach_vishkin_components_impl
