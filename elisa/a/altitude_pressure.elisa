# Estimate altitude from pressure using the pinned source formula.
extern pow(base: f64, exponent: f64) -> f64

def altitude_pressure_impl(pressure: f64) -> f64:
    if pressure < 0.0 or pressure > 101325.0:
        return -1.0
    if pressure == 0.0:
        return 44330.0
    exponent: f64 = 1.0 / 5.5255
    return 44330.0 * (1.0 - pow(pressure / 101325.0, exponent))

export fn altitude_pressure(pressure: f64) -> f64 = altitude_pressure_impl
