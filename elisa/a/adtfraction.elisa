# ADTFraction operations from TheAlgorithms/Java, with a bounded packed scalar ABI.
def adtfraction_wrap32(value: i64) -> i64:
    bits: i64 = value % 4_294_967_296
    if bits > 2_147_483_647:
        return bits - 4_294_967_296
    if bits < -2_147_483_648:
        return bits + 4_294_967_296
    bits

def adtfraction_f32_bits(value: f64, negative_zero: bool) -> u32:
    rounded: f32 = value.f32()
    if rounded == 0.0:
        if negative_zero:
            return 2_147_483_648.u32()
        return 0
    negative: bool = rounded < 0.0
    magnitude: mutable f64 = if negative: -rounded.f64() else: rounded.f64()
    exponent: mutable i32 = 0
    while magnitude >= 2.0:
        magnitude <- magnitude / 2.0
        exponent <- exponent + 1
    while magnitude < 1.0:
        magnitude <- magnitude * 2.0
        exponent <- exponent - 1
    fraction: u32 = ((magnitude - 1.0) * 8_388_608.0).u32()
    bits: u32 = ((exponent + 127).u32() << 23) | fraction
    if negative:
        bits | 2_147_483_648.u32()
    else:
        bits

def adtfraction_impl(input: i64&, length: usize) -> i64:
    if length != 5:
        return -1
    index: usize = 0
    while index < 5:
        if input[index] < -100_000 or input[index] > 100_000:
            return -1
        index <- index + 1
    op: i64 = input[0]
    n: i64 = input[1]
    d: i64 = input[2]
    m: i64 = input[3]
    e: i64 = input[4]
    if op == 0:
        if d == 0 or e == 0:
            return -1
        denominator: i64 = adtfraction_wrap32(d * e)
        if denominator == 0:
            return -1
        numerator: i64 = adtfraction_wrap32(adtfraction_wrap32(d * m) + adtfraction_wrap32(n * e))
        low: i64 = if denominator < 0: denominator + 4_294_967_296 else: denominator
        return numerator * 4_294_967_296 + low
    if op == 1:
        if d == 0:
            return -1
        numerator: i64 = adtfraction_wrap32(n * m)
        low: i64 = if d < 0: d + 4_294_967_296 else: d
        return numerator * 4_294_967_296 + low
    if op == 2:
        if d == 0 or e == 0:
            return -1
        denominator: i64 = adtfraction_wrap32(d * e)
        if denominator == 0:
            return -1
        numerator: i64 = adtfraction_wrap32(n * m)
        low: i64 = if denominator < 0: denominator + 4_294_967_296 else: denominator
        return numerator * 4_294_967_296 + low
    if op == 3:
        if n == 0:
            return -1
        low: i64 = if n < 0: n + 4_294_967_296 else: n
        return d * 4_294_967_296 + low
    if op != 4 or d == 0:
        return -1
    # Return the source float32 result's IEEE-754 bits as a nonnegative scalar.
    value: f32 = n.f32() / d.f32()
    adtfraction_f32_bits(value.f64(), n == 0 and d < 0).i64()

export fn adtfraction(input: i64&, length: usize) -> i64 = adtfraction_impl
