# Apply the case-preserving Atbash mapping to a 7-bit ASCII byte sequence.
def atbash_cipher_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length > 66:
        return -1
    valid_input: bool =
        while index < length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = input[index]
            if value < 0 or value > 127:
                break false
            index <- index + 1
            valid
    if not valid_input:
        return -1
    if output_capacity < length:
        return -2
    while index < length |index: mutable usize = 0, output| -> output:
        value: i64 = input[index]
        mapped: mutable i64 = value
        if value >= 65 and value <= 90:
            mapped <- 155 - value
        elif value >= 97 and value <= 122:
            mapped <- 219 - value
        output[index] <- mapped.u8()
        index <- index + 1
        output
    length.i64()

export fn atbash_cipher(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = atbash_cipher_impl
