const MAX_LENGTH: usize = 4096

# Sort signed 32-bit values and sum the first of every adjacent pair.
def array_pair_sum_impl(input: i64&, length: usize) -> i64:
    if length > MAX_LENGTH or length % 2 != 0:
        return -1
    values: mutable i64[4096] = zeroed
    index: mutable usize = 0
    while index < length:
        value: i64 = input[index]
        if value < -2147483648 or value > 2147483647:
            return -1
        values[index] <- value
        index <- index + 1

    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        root: mutable usize = start
        while root * 2 + 1 < length:
            child: mutable usize = root * 2 + 1
            if child + 1 < length and values[child] < values[child + 1]:
                child <- child + 1
            if values[root] >= values[child]:
                break
            temporary: i64 = values[root]
            values[root] <- values[child]
            values[child] <- temporary
            root <- child

    end: mutable usize = length
    while end > 1:
        end <- end - 1
        temporary: mutable i64 = values[0]
        values[0] <- values[end]
        values[end] <- temporary
        root: mutable usize = 0
        while root * 2 + 1 < end:
            child: mutable usize = root * 2 + 1
            if child + 1 < end and values[child] < values[child + 1]:
                child <- child + 1
            if values[root] >= values[child]:
                break
            temporary <- values[root]
            values[root] <- values[child]
            values[child] <- temporary
            root <- child

    total: mutable i64 = 0
    index <- 0
    while index < length:
        total <- total + values[index]
        index <- index + 2
    total

export fn array_pair_sum(input: i64&, length: usize) -> i64 = array_pair_sum_impl
