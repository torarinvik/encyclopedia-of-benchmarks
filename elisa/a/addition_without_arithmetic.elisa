def signed_sum_from_bits(bits: u32) -> i64:
    if bits <= 2147483647.u32():
        return bits.i64()
    bits.i64() - 4294967296

def addition_without_arithmetic_impl(left_encoded: u64, right_encoded: u64) -> i64:
    if (left_encoded > 2147483647.u64() and left_encoded < 18446744071562067968.u64()) or (right_encoded > 2147483647.u64() and right_encoded < 18446744071562067968.u64()):
        return -1
    left_value: i64 = signed_sum_from_bits((left_encoded & 4294967295.u64()).u32())
    right_value: i64 = signed_sum_from_bits((right_encoded & 4294967295.u64()).u32())
    left: mutable u32 = (left_encoded & 4294967295.u64()).u32()
    right: mutable u32 = (right_encoded & 4294967295.u64()).u32()
    while right != 0.u32():
        carry: u32 = left & right
        left <- left ^ right
        right <- carry << 1
    result: i64 = signed_sum_from_bits(left)
    if (left_value < 0) == (right_value < 0) and (result < 0) != (left_value < 0):
        return -1
    result

export fn addition_without_arithmetic(left_value: i64, right_value: i64) -> i64 = addition_without_arithmetic_impl
