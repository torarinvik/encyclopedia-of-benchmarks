# Stable recursive top-down merge sort with reusable scratch storage.
const MAX_VALUES: usize = 1024

def adaptive_merge_sort_range(values: mutable i64&, scratch: mutable i64&, low: usize, high: usize) -> void:
    if high - low <= 1:
        return
    middle: usize = low + (high - low) / 2
    adaptive_merge_sort_range(values, scratch, low, middle)
    adaptive_merge_sort_range(values, scratch, middle, high)
    if values[middle - 1] <= values[middle]:
        return
    left: mutable usize = low
    right: mutable usize = middle
    output: mutable usize = low
    while left < middle and right < high:
        if values[left] <= values[right]:
            scratch[output] <- values[left]
            left <- left + 1
        else:
            scratch[output] <- values[right]
            right <- right + 1
        output <- output + 1
    while left < middle:
        scratch[output] <- values[left]
        left <- left + 1
        output <- output + 1
    while right < high:
        scratch[output] <- values[right]
        right <- right + 1
        output <- output + 1
    index: mutable usize = low
    while index < high:
        values[index] <- scratch[index]
        index <- index + 1

def adaptive_merge_sort_impl(values: mutable i64&, length: usize) -> void:
    if length > MAX_VALUES:
        return
    scratch: mutable i64[1024] = zeroed
    adaptive_merge_sort_range(values, scratch[0], 0, length)

export fn adaptive_merge_sort(values: mutable i64&, length: usize) -> void = adaptive_merge_sort_impl
