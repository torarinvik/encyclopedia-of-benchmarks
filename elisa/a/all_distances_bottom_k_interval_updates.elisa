const ABKI_MAX_N: usize = 32
const ABKI_MAX_K: usize = 4
const ABKI_MAX_INPUT: usize = 99
const ABKI_MAX_WORDS: usize = 97
const ABKI_DISTANCE_LIMIT: i64 = 1000000
const ABKI_END: i64 = 1000001

def abki_put_i64(value: i64, output: mutable u8&, word: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[word * 8 + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def all_distances_bottom_k_interval_updates_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    j: mutable usize = 0
    if input == null or length < 2 or length > ABKI_MAX_INPUT: return -1
    values: i64& = input
    n64: i64 = values[0]
    k64: i64 = values[1]
    if n64 < 2 or n64 > ABKI_MAX_N.i64() or k64 < 2 or k64 > ABKI_MAX_K.i64() or k64 > n64: return -1
    n: usize = n64.usize()
    k: usize = k64.usize()
    if length != 2 + 3 * n: return -1

    ids: mutable i64[ABKI_MAX_N] = zeroed
    distances: mutable i64[ABKI_MAX_N] = zeroed
    ranks: mutable i64[ABKI_MAX_N] = zeroed
    seen_id: mutable bool[ABKI_MAX_N] = zeroed
    seen_rank: mutable bool[ABKI_MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        ids[i] <- values[2 + 3 * i]
        distances[i] <- values[3 + 3 * i]
        ranks[i] <- values[4 + 3 * i]
        if ids[i] < 0 or ids[i] >= n64 or seen_id[ids[i].usize()]
                or ranks[i] < 0 or ranks[i] >= n64 or seen_rank[ranks[i].usize()]
                or distances[i] < 0 or distances[i] > ABKI_DISTANCE_LIMIT: return -1
        seen_id[ids[i].usize()] <- true
        seen_rank[ranks[i].usize()] <- true
        j <- 0
        while j < i:
            if distances[j] == distances[i]: return -1
            j <- j + 1
        i <- i + 1
    i <- 1
    while i < k:
        if distances[i - 1] >= distances[i]: return -1
        i <- i + 1
    i <- k
    while i < n:
        if distances[i] <= distances[k - 1]: return -1
        i <- i + 1

    interval_id: mutable i64[ABKI_MAX_N] = zeroed
    interval_rank: mutable i64[ABKI_MAX_N] = zeroed
    starts: mutable i64[ABKI_MAX_N] = zeroed
    ends: mutable i64[ABKI_MAX_N] = zeroed
    count: mutable usize = k
    i <- 0
    while i < k:
        interval_id[i] <- ids[i]
        interval_rank[i] <- ranks[i]
        starts[i] <- distances[i]
        ends[i] <- ABKI_END
        i <- i + 1

    i <- k
    while i < n:
        worst: mutable usize = ABKI_MAX_N
        active: mutable usize = 0
        j <- 0
        while j < count:
            if starts[j] <= distances[i] and distances[i] < ends[j]:
                active <- active + 1
                if worst == ABKI_MAX_N or interval_rank[j] > interval_rank[worst]: worst <- j
            j <- j + 1
        if active != k or worst == ABKI_MAX_N: return -1
        if ranks[i] >= interval_rank[worst]:
            i <- i + 1
            continue
        cursor: mutable i64 = ends[worst]
        ends[worst] <- distances[i]
        while cursor < ABKI_END:
            next_worst: mutable usize = ABKI_MAX_N
            j <- 0
            while j < count:
                if starts[j] <= cursor and cursor < ends[j]
                        and (next_worst == ABKI_MAX_N or interval_rank[j] > interval_rank[next_worst]):
                    next_worst <- j
                j <- j + 1
            if next_worst == ABKI_MAX_N or interval_rank[next_worst] <= ranks[i]: break
            next_cursor: i64 = ends[next_worst]
            ends[next_worst] <- cursor
            cursor <- next_cursor
        interval_id[count] <- ids[i]
        interval_rank[count] <- ranks[i]
        starts[count] <- distances[i]
        ends[count] <- cursor
        count <- count + 1
        i <- i + 1

    order: mutable usize[ABKI_MAX_N] = zeroed
    out_count: mutable usize = 0
    i <- 0
    while i < count:
        if starts[i] < ends[i]:
            order[out_count] <- i
            out_count <- out_count + 1
        i <- i + 1
    i <- 1
    while i < out_count:
        key: usize = order[i]
        j <- i
        while j > 0 and (starts[order[j - 1]] > starts[key]
                or (starts[order[j - 1]] == starts[key] and interval_id[order[j - 1]] > interval_id[key])):
            order[j] <- order[j - 1]
            j <- j - 1
        order[j] <- key
        i <- i + 1

    staged: mutable i64[ABKI_MAX_WORDS] = zeroed
    staged[0] <- out_count.i64()
    i <- 0
    while i < out_count:
        source: usize = order[i]
        staged[1 + 3 * i] <- interval_id[source]
        staged[2 + 3 * i] <- starts[source]
        staged[3 + 3 * i] <- ends[source]
        i <- i + 1
    bytes: usize = 8 * (1 + 3 * out_count)
    if output == null or capacity < bytes: return -2
    out: mutable u8& = output
    i <- 0
    while i < 1 + 3 * out_count:
        abki_put_i64(staged[i], out, i)
        i <- i + 1
    bytes.i64()

export fn all_distances_bottom_k_interval_updates(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = all_distances_bottom_k_interval_updates_impl
