# Decode one-based alphabet positions as lowercase ASCII letters.
def a1z26_decipher_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length > 66:
        return -1
    valid_input: bool =
        while index < length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = input[index]
            if value < 1 or value > 26:
                break false
            index <- index + 1
            valid
    if not valid_input:
        return -1
    if output_capacity < length:
        return -2
    while index < length |index: mutable usize = 0, output| -> output:
        output[index] <- (96 + input[index]).u8()
        index <- index + 1
        output
    length.i64()

export fn a1z26_decipher(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = a1z26_decipher_impl
