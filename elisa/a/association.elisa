# Apriori frequent itemsets, encoded as transaction and item bitmasks.
def popcount_impl(value_in: u64) -> usize:
    value: mutable u64 = value_in
    count: mutable usize = 0
    while value != 0:
        count <- count + (value & 1).usize()
        value <- value >> 1
    count

def write_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte_index: mutable usize = 0
    while byte_index < 8:
        output[offset + byte_index] <- (bits & 255).u8()
        bits <- bits >> 8
        byte_index <- byte_index + 1

def association_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2 or input[0] < 1 or input[0] > 64 or input[1] < 1 or input[1] > 11: return -1
    transactions: usize = input[0].usize()
    items: usize = input[1].usize()
    if length != 2 + transactions: return -1
    item_limit: u64 = 1 << items
    valid_bits: u64 = item_limit - 1
    row: mutable usize = 0
    while row < transactions:
        if input[2 + row] < 0 or input[2 + row].u64() > valid_bits: return -1
        row <- row + 1

    frequent: mutable bool[2048] = zeroed
    masks: mutable i64[2047] = zeroed
    supports: mutable i64[2047] = zeroed
    result_count: mutable usize = 0
    set_size: mutable usize = 1
    while set_size <= items:
        mask: mutable u64 = 1
        while mask < item_limit:
            if popcount_impl(mask) == set_size:
                all_subsets_frequent: mutable bool = true
                if set_size > 1:
                    bit: mutable usize = 0
                    while bit < items:
                        bit_mask: u64 = 1 << bit
                        if (mask & bit_mask) != 0 and not frequent[(mask ^ bit_mask).usize()]:
                            all_subsets_frequent <- false
                        bit <- bit + 1
                if all_subsets_frequent:
                    support: mutable i64 = 0
                    row <- 0
                    while row < transactions:
                        if (input[2 + row].u64() & mask) == mask: support <- support + 1
                        row <- row + 1
                    if support > 0:
                        frequent[mask.usize()] <- true
                        masks[result_count] <- mask.i64()
                        supports[result_count] <- support
                        result_count <- result_count + 1
            mask <- mask + 1
        set_size <- set_size + 1

    required: usize = result_count * 16
    if capacity < required or (required > 0 and output.is_null()): return -2
    row <- 0
    while row < result_count:
        write_i64_le(output[0:required], row * 16, masks[row])
        write_i64_le(output[0:required], row * 16 + 8, supports[row])
        row <- row + 1
    required.i64()

export fn association(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = association_impl
