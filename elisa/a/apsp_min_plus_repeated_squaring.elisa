const APSP_MAX_N: usize = 8
const APSP_MAX_INPUT: usize = 65
const APSP_INF: i64 = 1000000

def apsp_store_i64(output: mutable view[u8], offset: usize, value: i64): void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def apsp_min_plus_repeated_squaring_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize): i64:
    if input.is_null() or length < 2 or length > APSP_MAX_INPUT: return -1
    n_raw: i64 = input[0]
    if n_raw < 1 or n_raw > APSP_MAX_N.i64(): return -1
    n: usize = n_raw.usize()
    if length != 1 + n * n: return -1
    current: mutable i64[APSP_MAX_N * APSP_MAX_N] = zeroed
    next: mutable i64[APSP_MAX_N * APSP_MAX_N] = zeroed
    for i in 0..<n:
        for j in 0..<n:
            value: i64 = input[1 + i * n + j]
            if (i == j and value != 0) or
                    (i != j and value != APSP_INF and (value < 1 or value > 1000)): return -1
            current[i * n + j] <- value
    edge_bound: mutable usize = 1
    while edge_bound < n - 1:
        for i in 0..<n:
            for j in 0..<n:
                best: mutable i64 = APSP_INF
                for k in 0..<n:
                    left: i64 = current[i * n + k]
                    right: i64 = current[k * n + j]
                    if left != APSP_INF and right != APSP_INF and left + right < best:
                        best <- left + right
                next[i * n + j] <- best
        for index in 0..<n * n: current[index] <- next[index]
        edge_bound <- edge_bound * 2
    bytes: usize = 8 * n * n
    if output.is_null() or capacity < bytes: return -2
    for index in 0..<n * n: apsp_store_i64(current[index], output[0:bytes], 8 * index)
    bytes.i64()

export fn apsp_min_plus_repeated_squaring(input: i64&, length: usize,
        output: mutable u8&, capacity: usize): i64 = apsp_min_plus_repeated_squaring_impl
