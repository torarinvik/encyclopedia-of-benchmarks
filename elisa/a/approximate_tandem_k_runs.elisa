const MAX_TEXT: usize = 24
const MAX_INPUT: usize = 26
const MAX_OUTPUT: usize = 34504

def max_window_mismatches(text: i64&, start: usize, length: usize, period: usize) -> usize:
    maximum: mutable usize = 0
    window: mutable usize = 0
    while window < length - 2 * period + 1:
        count: mutable usize = 0
        offset: mutable usize = 0
        while offset < period:
            if text[start + window + offset] != text[start + window + period + offset]:
                count <- count + 1
            offset <- offset + 1
        if count > maximum: maximum <- count
        window <- window + 1
    maximum

def run_count(text: i64&, n: usize, budget: usize) -> usize:
    count: mutable usize = 0
    start: mutable usize = 0
    while start < n:
        remaining: usize = n - start
        period: mutable usize = 1
        while 2 * period + 1 <= remaining:
            length: mutable usize = 2 * period + 1
            while length <= remaining:
                if max_window_mismatches(text, start + 2, length, period) <= budget:
                    count <- count + 1
                length <- length + 1
            period <- period + 1
        start <- start + 1
    count

def run_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def approximate_tandem_k_runs(input: i64&, length: usize,
                                     output: mutable u8&, capacity: usize) -> i64
    @export("approximate_tandem_k_runs"):
    if input.is_null() or length < 5 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    budget64: i64 = input[1]
    if n64 < 3 or n64 > 24 or budget64 < 0 or budget64 > 8 or length != n64.usize() + 2: return -1
    n: usize = n64.usize()
    budget: usize = budget64.usize()
    i: mutable usize = 0
    while i < n:
        if input[2 + i] < 0 or input[2 + i] > 3: return -1
        i <- i + 1
    count: usize = run_count(input, n, budget)
    bytes: usize = 8 * (1 + 4 * count)
    if bytes > MAX_OUTPUT: return -1
    if output.is_null() or capacity < bytes: return -2
    run_store(count.i64(), output, 0)
    record: mutable usize = 0
    start: mutable usize = 0
    while start < n:
        remaining: usize = n - start
        period: mutable usize = 1
        while 2 * period + 1 <= remaining:
            factor_length: mutable usize = 2 * period + 1
            while factor_length <= remaining:
                errors: usize = max_window_mismatches(input, 2 + start, factor_length, period)
                if errors <= budget:
                    offset: usize = 8 * (1 + 4 * record)
                    run_store(start.i64(), output, offset)
                    run_store(factor_length.i64(), output, offset + 8)
                    run_store(period.i64(), output, offset + 16)
                    run_store(errors.i64(), output, offset + 24)
                    record <- record + 1
                factor_length <- factor_length + 1
            period <- period + 1
        start <- start + 1
    bytes.i64()
