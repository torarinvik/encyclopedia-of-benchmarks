const MAX_N: usize = 6
const MODULUS: i64 = 998244353

def adjugate_minor_determinant(matrix: view[i64], n: usize, skip_row: usize, skip_column: usize) -> i64:
    dimension: usize = n - 1
    if dimension == 0: return 1
    minor: mutable i64[MAX_N * MAX_N] = zeroed
    target_row: mutable usize = 0
    row: mutable usize = 0
    while row < n:
        if row != skip_row:
            target_column: mutable usize = 0
            column: mutable usize = 0
            while column < n:
                if column != skip_column:
                    minor[target_row * dimension + target_column] <- matrix[row * n + column]
                    target_column <- target_column + 1
                column <- column + 1
            target_row <- target_row + 1
        row <- row + 1

    dp: mutable i64[1 << (MAX_N - 1)] = zeroed
    dp[0] <- 1
    limit: usize = 1 << dimension
    mask: mutable usize = 0
    dp_column: mutable usize = 0
    while mask < limit:
        row_count: mutable usize = 0
        bits: mutable usize = mask
        while bits != 0:
            row_count <- row_count + (bits & 1)
            bits <- bits >> 1
        if row_count < dimension:
            dp_column <- 0
            while dp_column < dimension:
                if (mask & (1 << dp_column)) == 0:
                    inversions: mutable usize = 0
                    prior: mutable usize = dp_column + 1
                    while prior < dimension:
                        inversions <- inversions + ((mask >> prior) & 1)
                        prior <- prior + 1
                    next_mask: usize = mask | (1 << dp_column)
                    term: i64 = (dp[mask] * minor[row_count * dimension + dp_column]) % MODULUS
                    if (inversions & 1) == 0:
                        dp[next_mask] <- (dp[next_mask] + term) % MODULUS
                    else:
                        dp[next_mask] <- (dp[next_mask] - term + MODULUS) % MODULUS
                dp_column <- dp_column + 1
        mask <- mask + 1
    dp[limit - 1]

def adjugate_matrix_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

export fn adjugate_matrix(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = adjugate_matrix_impl

def adjugate_matrix_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 1 + MAX_N * MAX_N: return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != 1 + n * n: return -1

    matrix: mutable i64[MAX_N * MAX_N] = zeroed
    index: mutable usize = 0
    while index < n * n:
        value: i64 = input[1 + index]
        if value < 0 or value >= MODULUS: return -1
        matrix[index] <- value
        index <- index + 1

    output_bytes: usize = 8 * n * n
    if output.is_null() or capacity < output_bytes: return -2
    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            value: i64 = adjugate_minor_determinant(matrix[0:MAX_N * MAX_N], n, column, row)
            if ((row + column) & 1) != 0 and value != 0: value <- MODULUS - value
            adjugate_matrix_store(value, output[0:output_bytes], 8 * (row * n + column))
            column <- column + 1
        row <- row + 1
    output_bytes.i64()
