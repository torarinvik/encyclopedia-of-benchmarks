# Tarjan low-link cut-vertex search for an undirected graph.
const MAX_VERTEX_COUNT: usize = 64
const MAX_EDGE_COUNT: usize = 2047
const MAX_INPUT_LENGTH: usize = 2 + 2 * MAX_EDGE_COUNT

def articulation_points_visit(adjacency: u64&, discovery: mutable i64&, low: mutable i64&,
        parent: mutable i64&, is_articulation: mutable u8&, vertex_count: usize,
        vertex: usize, time: mutable usize&) -> void:
    discovery[vertex] <- time.i64()
    low[vertex] <- time.i64()
    time <- time + 1
    child_count: mutable usize = 0
    neighbor: mutable usize = 0
    while neighbor < vertex_count |neighbor, adjacency, discovery, low, parent, is_articulation, time, child_count|:
        if (adjacency[vertex] & (1.u64() << neighbor)) == 0:
            neighbor <- neighbor + 1
            continue
        if discovery[neighbor] == -1:
            parent[neighbor] <- vertex.i64()
            child_count <- child_count + 1
            articulation_points_visit(adjacency, discovery, low, parent, is_articulation,
                vertex_count, neighbor, time)
            if low[neighbor] < low[vertex]:
                low[vertex] <- low[neighbor]
            if parent[vertex] == -1 and child_count > 1:
                is_articulation[vertex] <- 1.u8()
            if parent[vertex] != -1 and low[neighbor] >= discovery[vertex]:
                is_articulation[vertex] <- 1.u8()
        elif neighbor.i64() != parent[vertex] and discovery[neighbor] < low[vertex]:
            low[vertex] <- discovery[neighbor]
        neighbor <- neighbor + 1

def articulation_points_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    if input[0] < 0 or input[0] > i64(MAX_VERTEX_COUNT) or input[1] < 0 or input[1] > i64(MAX_EDGE_COUNT):
        return -1
    vertex_count: usize = input[0].usize()
    edge_count: usize = input[1].usize()
    if length != 2 + 2 * edge_count:
        return -1
    adjacency: mutable u64[MAX_VERTEX_COUNT] = zeroed
    for edge in 0..<edge_count |input, adjacency|:
        left_value: i64 = input[2 + 2 * edge]
        right_value: i64 = input[3 + 2 * edge]
        if left_value < 0 or right_value < 0 or left_value >= vertex_count.i64() or right_value >= vertex_count.i64():
            return -1
        left: usize = left_value.usize()
        right: usize = right_value.usize()
        adjacency[left] <- adjacency[left] | (1.u64() << right)
        adjacency[right] <- adjacency[right] | (1.u64() << left)

    discovery: mutable i64[MAX_VERTEX_COUNT] = zeroed
    low: mutable i64[MAX_VERTEX_COUNT] = zeroed
    parent: mutable i64[MAX_VERTEX_COUNT] = zeroed
    is_articulation: mutable u8[MAX_VERTEX_COUNT] = zeroed
    vertex: mutable usize = 0
    while vertex < vertex_count |vertex, discovery, parent|:
        discovery[vertex] <- -1
        parent[vertex] <- -1
        vertex <- vertex + 1
    time: mutable usize = 0
    vertex <- 0
    while vertex < vertex_count |vertex, discovery, adjacency, low, parent, is_articulation, time|:
        if discovery[vertex] == -1:
            articulation_points_visit(&adjacency[0], &discovery[0], &low[0], &parent[0], &is_articulation[0],
                vertex_count, vertex, time)
        vertex <- vertex + 1
    point_count: mutable usize = 0
    vertex <- 0
    while vertex < vertex_count |vertex, is_articulation, point_count|:
        if is_articulation[vertex] != 0:
            point_count <- point_count + 1
        vertex <- vertex + 1
    if output_capacity < point_count:
        return -2
    position: mutable usize = 0
    vertex <- 0
    while vertex < vertex_count |vertex, is_articulation, position, output|:
        if is_articulation[vertex] != 0:
            output[position] <- vertex.u8()
            position <- position + 1
        vertex <- vertex + 1
    point_count.i64()

export fn articulation_points(input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = articulation_points_impl
