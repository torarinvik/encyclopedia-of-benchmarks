const MAX_COUNT: usize = 1000

def alternating_harmonic_series_impl(values: i64&, length: usize) -> i64:
    if length < 1 or length > 1 + 2 * MAX_COUNT:
        return -1
    count_value: i64 = values[0]
    if count_value < 0 or count_value > 1000:
        return -1
    count: usize = count_value.usize()
    if length != 1 + 2 * count:
        return -1
    if count == 0:
        return 0

    index: mutable usize = 0
    while index < count:
        numerator: i64 = values[1 + 2 * index]
        denominator: i64 = values[2 + 2 * index]
        if numerator < -1000 or numerator > 1000 or denominator < 1 or denominator > 1000:
            return -1
        signed_denominator: mutable i64 = denominator
        if index % 2 == 1:
            signed_denominator <- -denominator
        difference: mutable i64 = numerator * (index + 1).i64() - signed_denominator
        if difference < 0:
            difference <- -difference
        if difference * 1000000000 > denominator * (index + 1).i64():
            return 0
        index <- index + 1
    1

export fn alternating_harmonic_series(values: i64&, length: usize) -> i64 = alternating_harmonic_series_impl
