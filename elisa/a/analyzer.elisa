const MAX_EVENTS: usize = 64
const MAX_EPOCH: i64 = 15
const MAX_ADDRESS: i64 = 255

def analyzer_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > 194: return -1
    count_value:i64=input[0]
    if count_value < 0 or count_value > MAX_EVENTS.i64(): return -1
    count:usize=count_value.usize()
    if length != 1 + 3 * count: return -1
    latest_writer: mutable [256]i64 = [-1; 256]
    conflicts:mutable i64=0
    previous_epoch:mutable i64=0
    for event in 0..<count:
        base:usize=1+3*event
        epoch:i64=input[base]
        opcode:i64=input[base+1]
        address_value:i64=input[base+2]
        if (epoch < previous_epoch or epoch < 0 or epoch > MAX_EPOCH
                or (opcode != 0 and opcode != 1) or address_value < 0 or address_value > MAX_ADDRESS): return -1
        previous_epoch <- epoch
        address:usize=address_value.usize()
        if opcode == 0:
            latest_writer[address] <- event.i64()
        else:
            for prior in 0..<event:
                prior_base:usize=1+3*prior
                if (input[prior_base] < epoch and input[prior_base+1] == 0
                        and input[prior_base+2] == address_value and latest_writer[address] == prior.i64()):
                    conflicts <- conflicts + 1
    conflicts

export fn analyzer(input: i64&, length: usize) -> i64 = analyzer_impl
