# Return the exact scaled lower bound produced by arithmetic coding.
def arithmetic_coding_impl(input: i64&, length: usize) -> i64:
    if length < 2:
        return -1
    count: i64 = input[0]
    if count < 1 or count > 12 or length != count.usize() + 1:
        return -1

    frequency: mutable i64[256] = zeroed
    cumulative: mutable i64[257] = zeroed
    index: mutable usize = 0
    while index < count.usize():
        symbol: i64 = input[index + 1]
        if symbol < 0 or symbol > 255:
            return -1
        frequency[symbol.usize()] <- frequency[symbol.usize()] + 1
        index <- index + 1
    index <- 0
    while index < 256:
        cumulative[index + 1] <- cumulative[index] + frequency[index]
        index <- index + 1

    low: mutable i64 = 0
    high: mutable i64 = 1
    index <- 0
    while index < count.usize():
        symbol: usize = input[index + 1].usize()
        range: i64 = high - low
        base: i64 = low * count
        high <- base + range * cumulative[symbol + 1]
        low <- base + range * cumulative[symbol]
        index <- index + 1
    low

export fn arithmetic_coding(input: i64&, length: usize) -> i64 = arithmetic_coding_impl
