const MAX_LENGTH: usize = 100001
const MOD_ADLER: i64 = 65521

# Compute Adler-32 over byte values without modifying the input.
def adler32_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH or (length != 0 and values == null):
        return -1
    a: mutable i64 = 1
    b: mutable i64 = 0
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < 0 or value > 255:
            return -1
        a <- (a + value) % MOD_ADLER
        b <- (b + a) % MOD_ADLER
        index <- index + 1
    (b << 16) | a

export fn adler32(values: i64&, length: usize) -> i64 = adler32_impl
