# Fold most-significant-first digits in base 2 through 36 into i64.
def any_base_to_decimal_impl(input: i64&, length: usize) -> i64:
    if length < 2 or length > 65:
        return -1
        
    base: i64 = input[0]
    if base < 2 or base > 36:
        return -1
    
    while index < length |index: mutable usize = 1, result: mutable i64 = 0| -> result:
        digit: i64 = input[index]
        if digit < 0 or digit >= base or result > (9223372036854775807 - digit) / base:
            return -1
        result <- result * base + digit
        index <- index + 1
    

export fn any_base_to_decimal(input: i64&, length: usize) -> i64 = any_base_to_decimal_impl
