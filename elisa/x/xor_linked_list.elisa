def xor_linked_list_write_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def xor_linked_list_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > 66: return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > 64 or length != count_value.usize() + 1: return -1
    count: usize = count_value.usize()
    index: mutable usize = 0
    while index < count:
        value: i64 = input[index + 1]
        if value < -2147483648 or value > 2147483647: return -1
        index <- index + 1

    needed: usize = 8 + 8 * count
    if output == null or capacity < needed: return -2
    node_values: mutable i64[65] = zeroed
    both: mutable usize[65] = zeroed
    tail: mutable usize = 0
    index <- 0
    while index < count:
        node_id: usize = index + 1
        node_values[node_id] <- input[index + 1]
        both[node_id] <- tail
        if tail != 0: both[tail] <- both[tail] ^ node_id
        tail <- node_id
        index <- index + 1

    xor_linked_list_write_i64(output, 0, count_value)
    out: mutable usize = 8
    previous: mutable usize = 0
    current: mutable usize = if count == 0: 0 else: 1
    while current != 0:
        xor_linked_list_write_i64(output, out, node_values[current])
        out <- out + 8
        next_id: usize = previous ^ both[current]
        previous <- current
        current <- next_id
    needed.i64()

export fn xor_linked_list(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = xor_linked_list_impl
