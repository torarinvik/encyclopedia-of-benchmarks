def xs3_conversion_impl(input_values: i64&, length: usize) -> i64:
    if length != 2:
        return -1
    direction: i64 = input_values[0]
    value: mutable i64 = input_values[1]
    if direction == 0:
        if value < 0 or value > 2147483647:
            return -1
        decoded: mutable i64 = 0
        multiplier: mutable i64 = 1
        while value > 0:
            nibble: i64 = value & 15
            if nibble < 3 or nibble > 12:
                return -1
            decoded <- decoded + (nibble - 3) * multiplier
            multiplier <- multiplier * 10
            value <- value >> 4
        return decoded
    if direction == 1:
        if value < 0 or value > 9999999:
            return -1
        encoded: mutable i64 = 0
        shift: mutable usize = 0
        while value > 0:
            digit: i64 = value % 10 + 3
            encoded <- encoded | (digit << (shift * 4))
            value <- value / 10
            shift <- shift + 1
        return encoded
    return -1

export fn xs3_conversion(input_values: i64&, length: usize) -> i64 = xs3_conversion_impl
