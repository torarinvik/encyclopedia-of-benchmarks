# XOR-swap a bounded signed pair and pack the returned values into i64.
def xor_swap_two_integers_impl(first: i64, second: i64) -> i64:
    if first < -32768 or first > 32767 or second < -32768 or second > 32767:
        return -1
    a: mutable i64 = first
    b: mutable i64 = second
    if a < 0:
        a <- a + 65536
    if b < 0:
        b <- b + 65536
    a <- a ^ b
    b <- a ^ b
    a <- a ^ b
    swapped_first: mutable i64 = a
    swapped_second: mutable i64 = b
    if a >= 32768:
        swapped_first <- a - 65536
    if b >= 32768:
        swapped_second <- b - 65536
    (swapped_first + 32768) * 65536 + (swapped_second + 32768)

export fn xor_swap_two_integers(first: i64, second: i64) -> i64 = xor_swap_two_integers_impl
