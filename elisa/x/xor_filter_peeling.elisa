def xor_filter_solve(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 3 or length > 259 or input[0] < 0 or input[0] > 32 or input[1] < 3 or input[1] > 96 or input[2] < 0 or input[2] > 32: return -1
    n: usize = input[0].usize()
    slots: usize = input[1].usize()
    q: usize = input[2].usize()
    if length != 3 + 4 * (n + q): return -1
    for i in 0..<n + q:
        at: usize = 3 + 4 * i
        a: i64 = input[at]
        b: i64 = input[at + 1]
        c: i64 = input[at + 2]
        f: i64 = input[at + 3]
        if a < 0 or a >= slots.i64() or b < 0 or b >= slots.i64() or c < 0 or c >= slots.i64() or a == b or a == c or b == c or f < 0 or f > 255: return -1
    degree: mutable i64[96] = zeroed
    edge_xor: mutable i64[96] = zeroed
    queue: mutable i64[96] = zeroed
    stack_slot: mutable i64[32] = zeroed
    stack_edge: mutable i64[32] = zeroed
    table: mutable i64[96] = zeroed
    for edge in 0..<n:
        for j in 0..<3:
            slot: usize = input[3 + 4 * edge + j].usize()
            degree[slot] <- degree[slot] + 1
            edge_xor[slot] <- edge_xor[slot] ^ edge.i64()
    head: mutable usize = 0
    tail: mutable usize = 0
    used: mutable usize = 0
    for slot in 0..<slots:
        if degree[slot] == 1:
            queue[tail] <- slot.i64()
            tail <- tail + 1
    while head < tail:
        slot: usize = queue[head].usize()
        head <- head + 1
        if degree[slot] == 1:
            edge: usize = edge_xor[slot].usize()
            stack_slot[used] <- slot.i64()
            stack_edge[used] <- edge.i64()
            used <- used + 1
            for j in 0..<3:
                v: usize = input[3 + 4 * edge + j].usize()
                degree[v] <- degree[v] - 1
                edge_xor[v] <- edge_xor[v] ^ edge.i64()
                if degree[v] == 1:
                    queue[tail] <- v.i64()
                    tail <- tail + 1
    if used != n: return -2
    while used > 0:
        used <- used - 1
        slot: usize = stack_slot[used].usize()
        at: usize = 3 + 4 * stack_edge[used].usize()
        a: usize = input[at].usize()
        b: usize = input[at + 1].usize()
        c: usize = input[at + 2].usize()
        table[slot] <- input[at + 3] ^ table[a] ^ table[b] ^ table[c]
    result: mutable i64 = 0
    for i in 0..<q:
        at: usize = 3 + 4 * (n + i)
        a: usize = input[at].usize()
        b: usize = input[at + 1].usize()
        c: usize = input[at + 2].usize()
        if (table[a] ^ table[b] ^ table[c]) == input[at + 3]: result <- result + (i + 1).i64()
    result

export fn xor_filter_peeling(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > 259: return -1
    xor_filter_solve(input[0:length])
