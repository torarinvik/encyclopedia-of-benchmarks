const INVALID_RESULT: f64 = -1e300
const SCALE_Q: f64 = 1000000.0
const MAX_NUCLIDES: usize = 4
const MIN_GRIDPOINTS: usize = 2
const MAX_GRIDPOINTS: usize = 5
const MAX_UNION_POINTS: usize = 20
const MAX_LENGTH: usize = 232
const RECORD_SIZE: usize = 6

def decode(raw: i64) -> f64:
    raw.f64() / SCALE_Q

def binary_search(energies: i64[20], nuclide: usize, gridpoints: usize, quarry: i64) -> usize:
    minimum: mutable usize = 0
    maximum: mutable usize = gridpoints - 1
    base: usize = nuclide * MAX_GRIDPOINTS
    if energies[base] > quarry:
        return 0
    if energies[base + gridpoints - 1] < quarry:
        return gridpoints - 2
    while minimum <= maximum:
        middle: usize = minimum + (maximum - minimum) / 2
        energy: i64 = energies[base + middle]
        if energy < quarry:
            minimum <- middle + 1
        else if energy > quarry:
            maximum <- middle - 1
        else:
            return middle
    maximum

def grid_search(grid: i64[20], count: usize, quarry: i64) -> usize:
    lower: mutable usize = 0
    upper: mutable usize = count - 1
    span: mutable usize = upper - lower
    while span > 1:
        middle: usize = lower + span / 2
        if grid[middle] > quarry:
            upper <- middle
        else:
            lower <- middle
        span <- upper - lower
    lower

def doe_xsbench_unionized_macro_xs_impl(input: i64&, length: usize) -> f64:
    if input == null or length < 22 or length > MAX_LENGTH:
        return INVALID_RESULT
    nuclides_raw: i64 = input[0]
    gridpoints_raw: i64 = input[1]
    material_nuclides_raw: i64 = input[2]
    query_raw: i64 = input[3]
    if nuclides_raw < 1 or nuclides_raw > MAX_NUCLIDES.i64() or
       gridpoints_raw < MIN_GRIDPOINTS.i64() or gridpoints_raw > MAX_GRIDPOINTS.i64() or
       material_nuclides_raw < 1 or material_nuclides_raw > nuclides_raw or
       query_raw < 0 or query_raw > 1000000:
        return INVALID_RESULT

    nuclides: usize = nuclides_raw.usize()
    gridpoints: usize = gridpoints_raw.usize()
    material_nuclides: usize = material_nuclides_raw.usize()
    union_points: usize = nuclides * gridpoints
    composition_start: usize = 4
    union_start: usize = composition_start + 2 * material_nuclides
    pointer_start: usize = union_start + union_points
    grid_start: usize = pointer_start + union_points * nuclides
    if length != grid_start + union_points * RECORD_SIZE:
        return INVALID_RESULT

    composition_ids: mutable usize[4] = zeroed
    concentrations: mutable f64[4] = zeroed
    used: mutable bool[4] = zeroed
    for item in 0..<material_nuclides:
        id_raw: i64 = input[composition_start + 2 * item]
        concentration_raw: i64 = input[composition_start + 2 * item + 1]
        if id_raw < 0 or id_raw >= nuclides_raw or concentration_raw < 0 or concentration_raw > 1000000:
            return INVALID_RESULT
        id: usize = id_raw.usize()
        if used[id]:
            return INVALID_RESULT
        used[id] <- true
        composition_ids[item] <- id
        concentrations[item] <- decode(concentration_raw)

    union_grid: mutable i64[20] = zeroed
    for index in 0..<union_points:
        energy: i64 = input[union_start + index]
        if energy < 0 or energy > 1000000 or (index > 0 and energy <= union_grid[index - 1]):
            return INVALID_RESULT
        union_grid[index] <- energy

    nuclide_energies: mutable i64[20] = zeroed
    for nuclide in 0..<nuclides:
        for point in 0..<gridpoints:
            record: usize = grid_start + (nuclide * gridpoints + point) * RECORD_SIZE
            energy: i64 = input[record]
            energy_slot: usize = nuclide * MAX_GRIDPOINTS + point
            if energy < 0 or energy > 1000000 or
               (point > 0 and energy <= nuclide_energies[energy_slot - 1]):
                return INVALID_RESULT
            nuclide_energies[energy_slot] <- energy
            for channel in 1..<RECORD_SIZE:
                if input[record + channel] < 0 or input[record + channel] > 1000000:
                    return INVALID_RESULT

    for union_index in 0..<union_points:
        matches: mutable usize = 0
        for nuclide in 0..<nuclides:
            for point in 0..<gridpoints:
                if nuclide_energies[nuclide * MAX_GRIDPOINTS + point] == union_grid[union_index]:
                    matches <- matches + 1
        if matches != 1:
            return INVALID_RESULT
        for nuclide in 0..<nuclides:
            pointer: i64 = input[pointer_start + union_index * nuclides + nuclide]
            if pointer != binary_search(nuclide_energies, nuclide, gridpoints, union_grid[union_index]).i64():
                return INVALID_RESULT

    query_index: usize = grid_search(union_grid, union_points, query_raw)
    macro: mutable f64[5] = zeroed
    query: f64 = decode(query_raw)
    for item in 0..<material_nuclides:
        nuclide: usize = composition_ids[item]
        pointer: usize = input[pointer_start + query_index * nuclides + nuclide].usize()
        low_index: usize = if pointer == gridpoints - 1 { pointer - 1 } else { pointer }
        low_record: usize = grid_start + (nuclide * gridpoints + low_index) * RECORD_SIZE
        high_record: usize = low_record + RECORD_SIZE
        low_energy: f64 = decode(input[low_record])
        high_energy: f64 = decode(input[high_record])
        factor: f64 = (high_energy - query) / (high_energy - low_energy)
        for channel in 0..<5:
            low_xs: f64 = decode(input[low_record + channel + 1])
            high_xs: f64 = decode(input[high_record + channel + 1])
            microscopic: f64 = high_xs - factor * (high_xs - low_xs)
            macro[channel] <- macro[channel] + microscopic * concentrations[item]
    macro[0] + 2.0 * macro[1] + 3.0 * macro[2] + 5.0 * macro[3] + 7.0 * macro[4]

export fn doe_xsbench_unionized_macro_xs(input: i64&, length: usize) -> f64 = doe_xsbench_unionized_macro_xs_impl
