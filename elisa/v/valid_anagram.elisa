# Compare lowercase ASCII strings by their letter frequencies.
def valid_anagram_impl(input: i64&, length: usize) -> i64:
    return -1 if length < 2 or length > 2050
    first: u64 = input[0].u64()
    second: u64 = input[1].u64()
    return -1 if first > 1024 or second > 1024
    count: usize = first.usize()
    return -1 if length != 2 + count + second.usize()

    index: mutable usize = 2
    if first != second:
        while index < length:
            return -1 if input[index].u64() - 97 > 25
            index <- index + 1
        return 0

    # Each balance is between -1024 and 1024. A wrapping u16 balance
    # is zero exactly when the corresponding frequencies are equal.
    counts: mutable u16[26] = zeroed
    midpoint: usize = 2 + count
    while index < midpoint:
        left: u64 = input[index].u64() - 97
        right: u64 = input[index + count].u64() - 97
        return -1 if left > 25 or right > 25
        if left != right:
            left_slot: usize = left.usize()
            right_slot: usize = right.usize()
            counts[left_slot] <- counts[left_slot] + 1
            counts[right_slot] <- counts[right_slot] - 1
        index <- index + 1

    slot: mutable usize = 0
    while slot < 26:
        return 0 if counts[slot] != 0
        slot <- slot + 1
    1

export fn valid_anagram(input: i64&, length: usize) -> i64 = valid_anagram_impl
