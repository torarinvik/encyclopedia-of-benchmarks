const MAX_N: usize = 128
const MAX_Q: usize = 256
const MAX_INPUT_VALUES: usize = 2 * MAX_N + 1 + 3 * MAX_Q
const MAX_VALUE: i64 = 1000000

def vertex_add_subtree_sum_put(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def vertex_add_subtree_sum_impl(input: i64&, length: usize,
                                output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_VALUES:
        return -1
    n_value: i64 = input[0]
    q_value: i64 = input[1]
    if n_value < 1 or n_value > MAX_N or q_value < 0 or q_value > MAX_Q:
        return -1
    n: usize = n_value.usize()
    q: usize = q_value.usize()
    if length != 2 * n + 1 + 3 * q:
        return -1

    values: mutable i64[MAX_N] = zeroed
    first_child: mutable i64[MAX_N] = zeroed
    next_sibling: mutable i64[MAX_N] = zeroed
    for vertex in 0..<MAX_N:
        first_child[vertex] <- -1
        next_sibling[vertex] <- -1
    for vertex in 0..<n:
        values[vertex] <- input[2 + vertex]
        if values[vertex] < 0 or values[vertex] > MAX_VALUE:
            return -1
    parent_start: usize = 2 + n
    for vertex in 1..<n:
        parent_value: i64 = input[parent_start + vertex - 1]
        if parent_value < 0 or parent_value >= vertex.i64():
            return -1
        parent: usize = parent_value.usize()
        next_sibling[vertex] <- first_child[parent]
        first_child[parent] <- vertex.i64()

    tin: mutable usize[MAX_N] = zeroed
    tout: mutable usize[MAX_N] = zeroed
    stack_node: mutable usize[MAX_N] = zeroed
    stack_next_child: mutable i64[MAX_N] = zeroed
    timer: mutable usize = 0
    top: mutable usize = 1
    stack_node[0] <- 0
    stack_next_child[0] <- first_child[0]
    tin[0] <- timer
    timer <- timer + 1
    while top > 0:
        frame: usize = top - 1
        child_value: i64 = stack_next_child[frame]
        if child_value < 0:
            tout[stack_node[frame]] <- timer
            top <- top - 1
            continue
        child: usize = child_value.usize()
        stack_next_child[frame] <- next_sibling[child]
        tin[child] <- timer
        timer <- timer + 1
        stack_node[top] <- child
        stack_next_child[top] <- first_child[child]
        top <- top + 1

    fenwick: mutable i64[MAX_N + 1] = zeroed
    for vertex in 0..<n:
        index: mutable usize = tin[vertex] + 1
        while index <= n:
            fenwick[index] <- fenwick[index] + values[vertex]
            index <- index + (index & (!index + 1))

    answers: mutable i64[MAX_Q] = zeroed
    answer_count: mutable usize = 0
    operation_start: usize = parent_start + n - 1
    for operation_index in 0..<q:
        offset: usize = operation_start + 3 * operation_index
        kind: i64 = input[offset]
        vertex_value: i64 = input[offset + 1]
        operand: i64 = input[offset + 2]
        if kind == 0:
            if vertex_value < 0 or vertex_value >= n_value or operand < 0 or operand > MAX_VALUE:
                return -1
            vertex: usize = vertex_value.usize()
            values[vertex] <- values[vertex] + operand
            index: mutable usize = tin[vertex] + 1
            while index <= n:
                fenwick[index] <- fenwick[index] + operand
                index <- index + (index & (!index + 1))
        else if kind == 1:
            if vertex_value < 0 or vertex_value >= n_value or operand != 0:
                return -1
            vertex: usize = vertex_value.usize()
            right: mutable usize = tout[vertex]
            right_sum: mutable i64 = 0
            while right > 0:
                right_sum <- right_sum + fenwick[right]
                right <- right - (right & (!right + 1))
            left: mutable usize = tin[vertex]
            left_sum: mutable i64 = 0
            while left > 0:
                left_sum <- left_sum + fenwick[left]
                left <- left - (left & (!left + 1))
            answers[answer_count] <- right_sum - left_sum
            answer_count <- answer_count + 1
        else:
            return -1

    output_bytes: usize = answer_count * 8
    if output_bytes > 0 and (output.is_null() or capacity < output_bytes):
        return -2
    for answer in 0..<answer_count:
        vertex_add_subtree_sum_put(output[0:capacity], answer * 8, answers[answer])
    output_bytes.i64()

export fn vertex_add_subtree_sum(input: i64&, length: usize,
                                 output: mutable u8&, capacity: usize) -> i64 = vertex_add_subtree_sum_impl
