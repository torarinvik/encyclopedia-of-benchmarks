# Deterministic bounded Vogel approximation for balanced transportation tables.
def vogel_approximation_transportation_impl(input: i64&, input_length: usize) -> i64:
    length: usize = input_length
    if length < 5 or length > 18:
        return -1
    rows_value: i64 = input[0]
    cols_value: i64 = input[1]
    if rows_value < 1 or rows_value > 3 or cols_value < 1 or cols_value > 3:
        return -1
    rows: usize = rows_value.usize()
    cols: usize = cols_value.usize()
    cell_count: usize = rows * cols
    if length != 2 + cell_count + rows + cols:
        return -1

    costs: mutable i64[9] = zeroed
    supply: mutable i64[3] = zeroed
    demand: mutable i64[3] = zeroed
    offset: mutable usize = 2
    cell: mutable usize = 0
    while cell < cell_count:
        value: i64 = input[offset + cell]
        if value < 0 or value > 9:
            return -1
        costs[cell] <- value
        cell <- cell + 1
    offset <- offset + cell_count

    supply_total: mutable i64 = 0
    row: mutable usize = 0
    while row < rows:
        value: i64 = input[offset + row]
        if value < 1 or value > 3:
            return -1
        supply[row] <- value
        supply_total <- supply_total + value
        row <- row + 1
    offset <- offset + rows
    demand_total: mutable i64 = 0
    col: mutable usize = 0
    while col < cols:
        value: i64 = input[offset + col]
        if value < 1 or value > 3:
            return -1
        demand[col] <- value
        demand_total <- demand_total + value
        col <- col + 1
    if supply_total != demand_total:
        return -1

    active_rows: mutable bool[3] = zeroed
    active_cols: mutable bool[3] = zeroed
    row <- 0
    while row < 3:
        active_rows[row] <- true
        active_cols[row] <- true
        row <- row + 1
    allocation: mutable i64[9] = zeroed
    total_cost: mutable i64 = 0
    remaining: mutable i64 = supply_total
    while remaining > 0:
        best_kind: mutable i64 = -1
        best_line: mutable usize = 0
        best_penalty: mutable i64 = -1
        kind: mutable usize = 0
        while kind < 2:
            line_count: usize = rows if kind == 0 else cols
            partner_count: usize = cols if kind == 0 else rows
            line: mutable usize = 0
            while line < line_count:
                line_active: bool = active_rows[line] if kind == 0 else active_cols[line]
                if line_active:
                    first: mutable i64 = 10
                    second: mutable i64 = 10
                    found: mutable usize = 0
                    partner: mutable usize = 0
                    while partner < partner_count:
                        partner_active: bool = active_cols[partner] if kind == 0 else active_rows[partner]
                        if partner_active:
                            cell_row: usize = line if kind == 0 else partner
                            cell_col: usize = partner if kind == 0 else line
                            value: i64 = costs[cell_row * cols + cell_col]
                            if value < first:
                                second <- first
                                first <- value
                            elif value < second:
                                second <- value
                            found <- found + 1
                        partner <- partner + 1
                    if found > 0:
                        penalty: i64 = 10 if found == 1 else second - first
                        if penalty > best_penalty:
                            best_penalty <- penalty
                            best_kind <- kind.i64()
                            best_line <- line
                line <- line + 1
            kind <- kind + 1
        if best_kind < 0:
            return -1

        partner_count: usize = cols if best_kind == 0 else rows
        best_partner: mutable usize = partner_count
        cheapest: mutable i64 = 10
        partner: mutable usize = 0
        while partner < partner_count:
            partner_active: bool = active_cols[partner] if best_kind == 0 else active_rows[partner]
            if partner_active:
                cell_row: usize = best_line if best_kind == 0 else partner
                cell_col: usize = partner if best_kind == 0 else best_line
                value: i64 = costs[cell_row * cols + cell_col]
                if value < cheapest:
                    cheapest <- value
                    best_partner <- partner
            partner <- partner + 1
        if best_partner == partner_count:
            return -1
        row <- best_line if best_kind == 0 else best_partner
        col <- best_partner if best_kind == 0 else best_line
        quantity: i64 = supply[row] if (supply[row] < demand[col]) else demand[col]
        allocation[row * 3 + col] <- quantity
        total_cost <- total_cost + quantity * costs[row * cols + col]
        supply[row] <- supply[row] - quantity
        demand[col] <- demand[col] - quantity
        remaining <- remaining - quantity
        if supply[row] == 0:
            active_rows[row] <- false
        if demand[col] == 0:
            active_cols[col] <- false

    signature: mutable i64 = 0
    place: mutable i64 = 1
    cell <- 0
    while cell < 9:
        signature <- signature + allocation[cell] * place
        place <- place * 4
        cell <- cell + 1
    total_cost * place + signature

def vogel_approximation_transportation_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 5 or length > 18:
        return -1
    vogel_approximation_transportation_impl(input, length)

export fn vogel_approximation_transportation(input: i64&, length: usize) -> i64 = vogel_approximation_transportation_entry
