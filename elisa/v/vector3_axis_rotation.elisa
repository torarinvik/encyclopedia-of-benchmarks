extern floor(value: f64) -> f64
extern cos(value: f64) -> f64
extern sin(value: f64) -> f64

const COORDINATE_LIMIT: f64 = 1000000.0
const ANGLE_LIMIT: f64 = 1000000.0
const OUTPUT_LIMIT: f64 = 2000000.0
const PI: f64 = 3.14159265358979323846

def vector3_axis_rotation_impl(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if input.is_null() or input_len != 5: return -1
    i: mutable usize = 0
    while i < 3:
        value: f64 = input[i]
        if value != value or value < -COORDINATE_LIMIT or value > COORDINATE_LIMIT: return -1
        i <- i + 1
    axis: f64 = input[3]
    angle: mutable f64 = input[4]
    if (axis != 0.0 and axis != 1.0 and axis != 2.0) or angle != angle or angle < -ANGLE_LIMIT or angle > ANGLE_LIMIT: return -1
    angle <- angle - floor(angle / 360.0) * 360.0
    if angle == 0.0: angle <- 0.0
    angle <- angle / 450.0 * 180.0 / PI
    x: f64 = input[0]
    y: f64 = input[1]
    z: f64 = input[2]
    cosine: f64 = cos(angle)
    sine: f64 = sin(angle)
    result: mutable f64[3] = zeroed
    if axis == 0.0:
        result[0] <- x
        result[1] <- y * cosine - z * sine
        result[2] <- z * cosine + y * sine
    else if axis == 1.0:
        result[0] <- x * cosine - z * sine
        result[1] <- y
        result[2] <- z * cosine + x * sine
    else:
        result[0] <- x * cosine - y * sine
        result[1] <- y * cosine + x * sine
        result[2] <- z
    i <- 0
    while i < 3:
        value: f64 = result[i]
        if value != value or value < -OUTPUT_LIMIT or value > OUTPUT_LIMIT: return -1
        i <- i + 1
    if output.is_null() or output_capacity < 3: return -2
    i <- 0
    while i < 3:
        output[i] <- result[i]
        i <- i + 1
    3

export fn vector3_axis_rotation(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64 = vector3_axis_rotation_impl
