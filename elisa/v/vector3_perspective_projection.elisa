const INPUT_LIMIT: f64 = 1000000.0
const DENOMINATOR_FLOOR: f64 = 0.000001
const OUTPUT_LIMIT: f64 = 1.0e25

def vector3_perspective_projection_impl(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if input.is_null() or input_len != 5: return -1
    i: mutable usize = 0
    while i < 5:
        value: f64 = input[i]
        if value != value or value < -INPUT_LIMIT or value > INPUT_LIMIT: return -1
        i <- i + 1
    denominator: f64 = input[2] + input[4]
    if denominator > -DENOMINATOR_FLOOR and denominator < DENOMINATOR_FLOOR: return -1
    x: f64 = ((input[0] * input[4]) / denominator) * input[3]
    y: f64 = ((input[1] * input[4]) / denominator) * input[3]
    if x != x or y != y or x < -OUTPUT_LIMIT or x > OUTPUT_LIMIT or y < -OUTPUT_LIMIT or y > OUTPUT_LIMIT: return -1
    if output.is_null() or output_capacity < 2: return -2
    output[0] <- x
    output[1] <- y
    2

export fn vector3_perspective_projection(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64 = vector3_perspective_projection_impl
