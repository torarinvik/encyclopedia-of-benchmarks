def viterbi_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 1 or length > 64: return -1
    t: mutable usize = 0
    while t < length:
        if input[t] < 0 or input[t] > 2: return -1
        t <- t + 1
    if capacity < length * 8: return -2
    e0: mutable f64 = 0.1
    e1: mutable f64 = 0.6
    if input[0] == 0: e0 <- 0.5
    if input[0] == 1: e0 <- 0.4
    if input[0] == 0: e1 <- 0.1
    if input[0] == 1: e1 <- 0.3
    s0: mutable f64 = 0.6 * e0
    s1: mutable f64 = 0.4 * e1
    t <- 1
    while t < length:
        o: i64 = input[t]
        em0: mutable f64 = 0.1
        em1: mutable f64 = 0.6
        if o == 0: em0 <- 0.5
        if o == 1: em0 <- 0.4
        if o == 0: em1 <- 0.1
        if o == 1: em1 <- 0.3
        a0: f64 = s0 * 0.7 * em0
        b0: f64 = s1 * 0.4 * em0
        a1: f64 = s0 * 0.3 * em1
        b1: f64 = s1 * 0.6 * em1
        p0: mutable i64 = 0
        p1: mutable i64 = 0
        n0: mutable f64 = a0
        n1: mutable f64 = a1
        if b0 > a0:
            p0 <- 1
            n0 <- b0
        if b1 > a1:
            p1 <- 1
            n1 <- b1
        output[t * 8 + 1] <- (p0 + p1 * 2).u8()
        scale: mutable f64 = n0
        if n1 > scale: scale <- n1
        if scale > 0.0:
            s0 <- n0 / scale
            s1 <- n1 / scale
        else:
            s0 <- 0.0
            s1 <- 0.0
        t <- t + 1
    state: mutable i64 = 0
    if s1 > s0: state <- 1
    output[length * 8 - 8] <- state.u8()
    t <- length
    while t > 1:
        t <- t - 1
        state <- ((output[t * 8 + 1].i64() >> state) & 1)
        output[(t - 1) * 8] <- state.u8()
    i: mutable usize = 0
    while i < length:
        value: u8 = output[i * 8]
        output[i * 8] <- value
        j: mutable usize = 1
        while j < 8:
            output[i * 8 + j] <- 0
            j <- j + 1
        i <- i + 1
    length.i64() * 8

export fn viterbi(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = viterbi_impl
