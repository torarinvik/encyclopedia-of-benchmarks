# Alphabetic Vernam cipher with a repeating key and modulo-26 arithmetic.
def vernam_cipher_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 3 or length > 2051:
        return -1
    mode: i64 = input[0]
    text_length_value: i64 = input[1]
    key_length_value: i64 = input[2]
    if (mode != 0 and mode != 1) or text_length_value < 0 or text_length_value > 1024 or key_length_value < 1 or key_length_value > 1024:
        return -1
    text_length: usize = text_length_value.usize()
    key_length: usize = key_length_value.usize()
    if length != 3 + text_length + key_length:
        return -1
    key_start: usize = 3 + text_length
    for index in 0..<text_length |index, input|:
        if input[3 + index] < 65 or input[3 + index] > 90:
            return -1
    for index in 0..<key_length |index, input, key_start|:
        if input[key_start + index] < 65 or input[key_start + index] > 90:
            return -1
    if output_capacity < text_length:
        return -2
    for index in 0..<text_length |index, input, output, key_start, key_length, mode|:
        text_value: i64 = input[3 + index] - 65
        key_value: i64 = input[key_start + index % key_length] - 65
        mapped: mutable i64 = 0
        if mode == 0:
            mapped <- (text_value + key_value) % 26
        else:
            mapped <- (text_value - key_value + 26) % 26
        output[index] <- (65 + mapped).u8()
    text_length.i64()

export fn vernam_cipher(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = vernam_cipher_impl
