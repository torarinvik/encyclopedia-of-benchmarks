# Check bracket nesting with a bounded stack.
def valid_parentheses_impl(input: i64&, length: usize) -> i64:
    if length > 256:
        return -1
    bracket_stack: mutable u8[256] = zeroed
    top: mutable usize = 0
    is_valid: mutable bool = true
    for index in 0..<length |input|:
        value: i64 = input[index]
        if value != 40 and value != 41 and value != 91 and value != 93 and value != 123 and value != 125:
            return -1
    for index in 0..<length |input, bracket_stack, top, is_valid|:
        value: i64 = input[index]
        if value == 40 or value == 91 or value == 123:
            bracket_stack[top] <- value.u8()
            top <- top + 1
        else:
            if top == 0:
                is_valid <- false
            else:
                top <- top - 1
                if (value == 41 and bracket_stack[top] != 40.u8()) or (value == 93 and bracket_stack[top] != 91.u8()) or (value == 125 and bracket_stack[top] != 123.u8()):
                    is_valid <- false
    if is_valid and top == 0:
        return 1
    return 0

export fn valid_parentheses(input: i64&, length: usize) -> i64 = valid_parentheses_impl
