# Encode an opening bracket as its expected closer. A closer maps to zero.
def bracket_closer(value: i64) -> u8:
    return 41 if value == 40
    return 93 if value == 91
    return 125 if value == 123
    return 0 if value == 41 or value == 93 or value == 125
    255

def invalid_suffix(input: i64&, start: usize, length: usize) -> i64:
    index: mutable usize = start
    while index < length:
        return -1 if bracket_closer(input[index]) == 255
        index <- index + 1
    0

def check_brackets(input: i64&, length: usize, pending: mutable u8&) -> i64:
    top: mutable usize = 0
    index: mutable usize = 0
    while index < length:
        value: i64 = input[index]
        closer: u8 = bracket_closer(value)
        index <- index + 1
        return -1 if closer == 255
        if closer != 0:
            # There are too few remaining brackets to close a deeper stack.
            return invalid_suffix(input, index, length) if top >= length / 2
            pending[top] <- closer
            top <- top + 1
        else:
            return invalid_suffix(input, index, length) if top == 0
            top <- top - 1
            return invalid_suffix(input, index, length) if pending[top].i64() != value
    1 if top == 0 else 0

def valid_parentheses_impl(input: i64&, length: usize) -> i64:
    return -1 if length > 256
    return 1 if length == 0
    return invalid_suffix(input, 0, length) if (length & 1) != 0
    if length <= 32:
        short_stack: mutable u8[16] = zeroed
        return check_brackets(input, length, &short_stack[0])
    pending: mutable u8[128] = zeroed
    check_brackets(input, length, &pending[0])

export fn valid_parentheses(input: i64&, length: usize) -> i64 = valid_parentheses_impl
