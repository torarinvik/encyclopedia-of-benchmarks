def validate_subsequence_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 2 or length > 8194:
        -1
    else if values[0] < 0 or values[0] > 4096 or values[1] < 0 or values[1] > 4096:
        -1
    else:
        array_length: usize = values[0].usize()
        sequence_length: usize = values[1].usize()
        if length != 2 + array_length + sequence_length:
            -1
        else:
            invalid: bool = false
            for i: usize in 2..<length:
                if values[i] < -2147483648 or values[i] > 2147483647:
                    invalid <- true
            if invalid:
                -1
            else if array_length == 0:
                0
            else if sequence_length == 0:
                1
            else:
                sequence_start: usize = 2 + array_length
                array_index: usize = 0
                sequence_index: usize = 0
                while sequence_index < sequence_length and array_index < array_length:
                    if values[sequence_start + sequence_index] == values[2 + array_index]:
                        sequence_index <- sequence_index + 1
                    array_index <- array_index + 1
                if sequence_index == sequence_length:
                    1
                else:
                    0

export fn validate_subsequence(values: i64&, length: usize) -> i64 = validate_subsequence_impl
