# ASCII digits already have bit 5 set, so folding them leaves them unchanged.
def folded_alphanumeric(value: u64) -> bool:
    value - 48 <= 9 or value - 97 <= 25

def mismatch_result(text: i64&, left: usize, right: usize) -> i64:
    # A palindrome mismatch does not make an unvisited invalid byte acceptable.
    bits: mutable u64 = 0
    index: mutable usize = left
    while index < right:
        bits <- bits | text[index].u64()
        index <- index + 1
    -1 if bits > 127 else 0

def valid_palindrome_impl(text: i64&, length: usize) -> i64:
    return -1 if length > 4096
    if length <= 1:
        return -1 if length == 1 and text[0].u64() > 127
        return 1
    left: mutable usize = 0
    right: mutable usize = length
    while left < right:
        first: u64 = text[left].u64() | 32
        return -1 if first > 127
        left <- left + 1
        continue if not folded_alphanumeric(first)

        while left < right:
            right <- right - 1
            last: u64 = text[right].u64() | 32
            return -1 if last > 127
            if folded_alphanumeric(last):
                return mismatch_result(text, left, right) if first != last
                break
    1

export fn valid_palindrome(text: i64&, length: usize) -> i64 = valid_palindrome_impl
