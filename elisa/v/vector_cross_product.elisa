# Cross two bounded integer vectors and encode components plus magnitude.
extern sqrt(value: f64) -> f64

def store_i64_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[position + byte] <- (bits % 256.u64()).u8()
        bits <- bits / 256.u64()

def vector_cross_product_impl(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input_length != 6:
        return -1
    for index in 0..<6:
        if input[index] < -1000000 or input[index] > 1000000:
            return -1
    x: i64 = input[1] * input[5] - input[2] * input[4]
    y: i64 = -((input[0] * input[5]) - (input[2] * input[3]))
    z: i64 = input[0] * input[4] - input[1] * input[3]
    magnitude: f64 = sqrt(x.f64() * x.f64() + y.f64() * y.f64() + z.f64() * z.f64())
    magnitude_micro: i64 = (magnitude * 1000000.0 + 0.5).i64()
    if output_capacity < 32:
        return -2
    store_i64_le(x, output[0:output_capacity], 0)
    store_i64_le(y, output[0:output_capacity], 8)
    store_i64_le(z, output[0:output_capacity], 16)
    store_i64_le(magnitude_micro, output[0:output_capacity], 24)
    32

export fn vector_cross_product(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64 = vector_cross_product_impl
