const MAX_Q: usize = 48
const MAX_CONS: usize = 32
const MAX_ROOTS: usize = 49
const MAX_BLOCKS: usize = 6
const MAX_SLOTS: usize = 63
const MAX_PARSEABLE: usize = 146

struct VListBlock:
    previous_block: i64
    previous_offset: i64
    capacity: i64
    last_used: i64
    base: i64

fn vlist_length(blocks: VListBlock[6]&, root_blocks: i64[49]&, root_offsets: i64[49]&, root: usize) -> i64:
    block_id: mutable i64 = root_blocks[root]
    offset: mutable i64 = root_offsets[root]
    total: mutable i64 = 0
    while block_id >= 0:
        if block_id.usize() >= MAX_BLOCKS || offset < 0 || offset > blocks[block_id.usize()].last_used: return -1
        total <- total + offset + 1
        previous: i64 = blocks[block_id.usize()].previous_block
        offset <- blocks[block_id.usize()].previous_offset
        block_id <- previous
    total

fn vlist_nth(blocks: VListBlock[6]&, data: i64[63]&, root_blocks: i64[49]&, root_offsets: i64[49]&, root: usize, index: i64) -> i64:
    block_id: mutable i64 = root_blocks[root]
    offset: mutable i64 = root_offsets[root]
    remaining: mutable i64 = index
    while block_id >= 0:
        if block_id.usize() >= MAX_BLOCKS || offset < 0 || offset > blocks[block_id.usize()].last_used: return -1000001
        if remaining <= offset:
            position: usize = (blocks[block_id.usize()].base + offset - remaining).usize()
            return data[position]
        remaining <- remaining - offset - 1
        previous: i64 = blocks[block_id.usize()].previous_block
        offset <- blocks[block_id.usize()].previous_offset
        block_id <- previous
    -1000001

fn vlist_store_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

fn vlist_persistent_sequence_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() || length < 1 || length > MAX_PARSEABLE: return -1
    values: view[i64] = input[0:length]
    q_word: i64 = values[0]
    if q_word < 1 || q_word > MAX_Q.i64() || length != 1 + 3 * q_word.usize(): return -1
    q: usize = q_word.usize()

    blocks: mutable VListBlock[6] = zeroed
    data: mutable i64[63] = zeroed
    root_blocks: mutable i64[49] = zeroed
    root_offsets: mutable i64[49] = zeroed
    results: mutable i64[48] = zeroed
    i: mutable usize = 0
    while i < MAX_ROOTS:
        root_blocks[i] <- -1
        root_offsets[i] <- -1
        i <- i + 1
    block_count: mutable usize = 0
    root_count: mutable usize = 1
    slot_count: mutable usize = 0
    cons_count: mutable usize = 0
    query_phase: mutable bool = false
    at: mutable usize = 1
    op: mutable usize = 0
    while op < q:
        tag: i64 = values[at]
        root_word: i64 = values[at + 1]
        arg: i64 = values[at + 2]
        at <- at + 3
        if tag < 0 || tag > 3 || root_word < 0 || root_word.usize() >= root_count: return -1
        root: usize = root_word.usize()
        if tag == 0:
            if query_phase || root != root_count - 1 || cons_count >= MAX_CONS || arg < -1000000 || arg > 1000000: return -1
            block_id: mutable i64 = root_blocks[root]
            offset: mutable i64 = root_offsets[root]
            if block_id < 0:
                if cons_count != 0 || block_count != 0 || slot_count >= MAX_SLOTS: return -1
                blocks[block_count].previous_block <- -1
                blocks[block_count].previous_offset <- -1
                blocks[block_count].capacity <- 1
                blocks[block_count].last_used <- 0
                blocks[block_count].base <- slot_count.i64()
                data[slot_count] <- arg
                block_id <- block_count.i64()
                offset <- 0
                block_count <- block_count + 1
                slot_count <- slot_count + 1
            else:
                if block_id.usize() >= block_count || offset != blocks[block_id.usize()].last_used: return -1
                block_capacity: i64 = blocks[block_id.usize()].capacity
                if offset + 1 < block_capacity:
                    offset <- offset + 1
                    position: usize = (blocks[block_id.usize()].base + offset).usize()
                    data[position] <- arg
                    blocks[block_id.usize()].last_used <- offset
                else:
                    next_capacity: usize = (block_capacity * 2).usize()
                    if block_count >= MAX_BLOCKS || slot_count + next_capacity > MAX_SLOTS: return -1
                    blocks[block_count].previous_block <- block_id
                    blocks[block_count].previous_offset <- offset
                    blocks[block_count].capacity <- next_capacity.i64()
                    blocks[block_count].last_used <- 0
                    blocks[block_count].base <- slot_count.i64()
                    data[slot_count] <- arg
                    block_id <- block_count.i64()
                    offset <- 0
                    block_count <- block_count + 1
                    slot_count <- slot_count + next_capacity
            if root_count >= MAX_ROOTS: return -1
            root_blocks[root_count] <- block_id
            root_offsets[root_count] <- offset
            results[op] <- root_count.i64()
            root_count <- root_count + 1
            cons_count <- cons_count + 1
        else:
            query_phase <- true
            if tag == 1:
                if arg != -1 || vlist_length(blocks, root_blocks, root_offsets, root) <= 0: return -1
                block_id: mutable i64 = root_blocks[root]
                offset: mutable i64 = root_offsets[root]
                if offset > 0:
                    offset <- offset - 1
                else:
                    offset <- blocks[block_id.usize()].previous_offset
                    block_id <- blocks[block_id.usize()].previous_block
                if root_count >= MAX_ROOTS: return -1
                root_blocks[root_count] <- block_id
                root_offsets[root_count] <- offset
                results[op] <- root_count.i64()
                root_count <- root_count + 1
            elif tag == 2:
                n: i64 = vlist_length(blocks, root_blocks, root_offsets, root)
                if n < 0 || arg < 0 || arg >= n: return -1
                value: i64 = vlist_nth(blocks, data, root_blocks, root_offsets, root, arg)
                if value == -1000001: return -1
                results[op] <- value
            else:
                if arg != -1: return -1
                n: i64 = vlist_length(blocks, root_blocks, root_offsets, root)
                if n < 0: return -1
                results[op] <- n
        op <- op + 1
    needed: usize = q * 8
    if output.is_null() || capacity < needed: return -2
    output_view: mutable view[u8] = output[0:needed]
    op <- 0
    while op < q:
        vlist_store_i64_le(output_view, op * 8, results[op])
        op <- op + 1
    needed.i64()

export fn vlist_persistent_sequence(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = vlist_persistent_sequence_impl
