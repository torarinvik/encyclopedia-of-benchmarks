# Check strict BST bounds over a valid indexed binary tree.
def validate_bst_subtree(nodes: i64&, node_count: usize, node: i64,
                          has_lower: bool, lower: i64, has_upper: bool, upper: i64) -> i64:
    if node == -1:
        return 1
    if node < 0 or node.u64() >= node_count.u64():
        return -1
    index: usize = node.usize()
    value: i64 = nodes[3 * index]
    left: i64 = nodes[3 * index + 1]
    right: i64 = nodes[3 * index + 2]
    if value < -2147483648 or value > 2147483647:
        return -1
    if left < -1 or (left >= 0 and left.u64() >= node_count.u64()):
        return -1
    if right < -1 or (right >= 0 and right.u64() >= node_count.u64()):
        return -1
    if (has_lower and value <= lower) or (has_upper and value >= upper):
        return 0
    left_result: i64 = validate_bst_subtree(nodes, node_count, left, has_lower, lower, true, value)
    if left_result <= 0:
        return left_result
    validate_bst_subtree(nodes, node_count, right, true, value, has_upper, upper)

def validate_bst_impl(nodes: i64&, node_count: usize, root_index: i64) -> i64:
    if node_count > 1023:
        return -1
    if node_count == 0:
        return 1 if root_index == -1 else -1
    if root_index < 0 or root_index.u64() >= node_count.u64():
        return -1
    validate_bst_subtree(nodes, node_count, root_index, false, 0, false, 0)

export fn validate_bst(nodes: i64&, node_count: usize, root_index: i64) -> i64 = validate_bst_impl
