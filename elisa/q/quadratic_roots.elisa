extern sqrt(value: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def quadratic_roots_write_f64(output: mutable u8&, position: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def quadratic_roots_impl(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length != 3:
        return -1

    ai: i64 = values[0]
    bi: i64 = values[1]
    ci: i64 = values[2]
    if ai == 0 or ai < -1000000 or ai > 1000000 or
            bi < -1000000 or bi > 1000000 or ci < -1000000 or ci > 1000000:
        return -1

    a: f64 = ai.f64()
    b: f64 = bi.f64()
    c: f64 = ci.f64()
    discriminant: f64 = b * b - 4.0 * a * c
    if discriminant < 0.0:
        return 0

    if discriminant == 0.0:
        if output_capacity < 8:
            return -2
        quadratic_roots_write_f64(output, 0, -b / (2.0 * a))
        return 1

    if output_capacity < 16:
        return -2
    square_root: f64 = sqrt(discriminant)
    quadratic_roots_write_f64(output, 0, (-b + square_root) / (2.0 * a))
    quadratic_roots_write_f64(output, 8, (-b - square_root) / (2.0 * a))
    return 2

export fn quadratic_roots(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = quadratic_roots_impl

