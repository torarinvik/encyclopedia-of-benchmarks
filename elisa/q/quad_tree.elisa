const MAX_POINTS: usize = 64
const MAX_CAPACITY: usize = 8
const MAX_DEPTH: usize = 12
const MAX_NODES: usize = 1 + 4 * MAX_POINTS * MAX_DEPTH
const MAX_PARSEABLE_INPUT_LENGTH: usize = 137
const MAX_OUTPUT_WORDS: usize = 194
const MAX_OUTPUT_BYTES: usize = 1552

struct QuadPoint:
    x: f64
    y: f64

struct QuadNode:
    center_x: f64
    center_y: f64
    half_width: f64
    point_count: usize
    point_indices: usize[MAX_CAPACITY]
    children: usize[4]
    divided: bool

def quad_tree_contains(node: QuadNode, point: QuadPoint) -> bool:
    point.x >= node.center_x - node.half_width and point.x <= node.center_x + node.half_width and
        point.y >= node.center_y - node.half_width and point.y <= node.center_y + node.half_width

def quad_tree_intersects(node: QuadNode, query_x: f64, query_y: f64, query_half_width: f64) -> bool:
    query_x - query_half_width <= node.center_x + node.half_width and
        query_x + query_half_width >= node.center_x - node.half_width and
        query_y - query_half_width <= node.center_y + node.half_width and
        query_y + query_half_width >= node.center_y - node.half_width

def quad_tree_subdivide(nodes: mutable view[QuadNode], node_index: usize, node_count: mutable usize&) -> void:
    child_half: f64 = nodes[node_index].half_width / 2.0
    cx: f64 = nodes[node_index].center_x
    cy: f64 = nodes[node_index].center_y
    child_x: f64[4] = [cx - child_half, cx + child_half, cx - child_half, cx + child_half]
    child_y: f64[4] = [cy + child_half, cy + child_half, cy - child_half, cy - child_half]
    child: mutable usize = 0
    while child < 4:
        index: usize = node_count
        node_count <- node_count + 1
        nodes[index] <- zeroed
        nodes[index].center_x <- child_x[child]
        nodes[index].center_y <- child_y[child]
        nodes[index].half_width <- child_half
        nodes[node_index].children[child] <- index
        child <- child + 1
    nodes[node_index].divided <- true

def quad_tree_insert(nodes: mutable view[QuadNode], node_index: usize, point_index: usize,
                     points: view[QuadPoint], capacity: usize, node_count: mutable usize&) -> bool:
    node: QuadNode = nodes[node_index]
    point: QuadPoint = points[point_index]
    if not quad_tree_contains(node, point): return false
    if node.point_count < capacity:
        nodes[node_index].point_indices[node.point_count] <- point_index
        nodes[node_index].point_count <- node.point_count + 1
        return true
    if not node.divided: quad_tree_subdivide(nodes, node_index, node_count)
    child: mutable usize = 0
    while child < 4:
        child_index: usize = nodes[node_index].children[child]
        if quad_tree_insert(nodes, child_index, point_index, points, capacity, node_count): return true
        child <- child + 1
    false

def quad_tree_query(nodes: view[QuadNode], node_index: usize, points: view[QuadPoint],
                    query_x: f64, query_y: f64, query_half_width: f64,
                    query_indices: mutable view[usize], query_count: mutable usize&) -> void:
    node: QuadNode = nodes[node_index]
    if not quad_tree_intersects(node, query_x, query_y, query_half_width): return
    left: f64 = query_x - query_half_width
    right: f64 = query_x + query_half_width
    bottom: f64 = query_y - query_half_width
    top: f64 = query_y + query_half_width
    index: mutable usize = 0
    while index < node.point_count:
        point_index: usize = node.point_indices[index]
        point: QuadPoint = points[point_index]
        if point.x >= left and point.x <= right and point.y >= bottom and point.y <= top:
            query_indices[query_count] <- point_index
            query_count <- query_count + 1
        index <- index + 1
    if node.divided:
        child: mutable usize = 0
        while child < 4:
            quad_tree_query(nodes, nodes[node_index].children[child], points, query_x, query_y,
                            query_half_width, query_indices, query_count)
            child <- child + 1

def quad_tree_write_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        staged: u64 = (bits >> (byte * 8)) & 255
        output[offset + byte] <- staged.u8()
        byte <- byte + 1

def quad_tree_impl(input: i64&, input_length: usize,
                   output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or input_length < 8 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    if input[0] < -2048 or input[0] > 2048 or input[1] < -2048 or input[1] > 2048 or
       input[2] < 1 or input[2] > 1024 or input[3] < 1 or input[3] > MAX_CAPACITY.i64() or
       input[4] < 0 or input[4] > MAX_POINTS.i64(): return -1
    point_count: usize = input[4].usize()
    if input_length != 8 + 2 * point_count: return -1
    query_offset: usize = 5 + 2 * point_count
    if input[query_offset] < -8192 or input[query_offset] > 8192 or
       input[query_offset + 1] < -8192 or input[query_offset + 1] > 8192 or
       input[query_offset + 2] < 0 or input[query_offset + 2] > 8192: return -1

    nodes: mutable QuadNode[MAX_NODES] = zeroed
    nodes[0].center_x <- input[0].f64()
    nodes[0].center_y <- input[1].f64()
    nodes[0].half_width <- input[2].f64()
    node_count: mutable usize = 1
    points: mutable QuadPoint[MAX_POINTS] = zeroed
    point: mutable usize = 0
    while point < point_count:
        x: i64 = input[5 + 2 * point]
        y: i64 = input[6 + 2 * point]
        if x < -8192 or x > 8192 or y < -8192 or y > 8192: return -1
        earlier: mutable usize = 0
        while earlier < point:
            if input[5 + 2 * earlier] == x and input[6 + 2 * earlier] == y: return -1
            earlier <- earlier + 1
        points[point].x <- x.f64()
        points[point].y <- y.f64()
        point <- point + 1

    query_indices: mutable usize[MAX_POINTS] = zeroed
    query_count: mutable usize = 0
    words: mutable i64[MAX_OUTPUT_WORDS] = zeroed
    words[0] <- point_count.i64()
    point <- 0
    while point < point_count:
        words[1 + point] <- if quad_tree_insert(nodes[0:MAX_NODES], 0, point, points[0:MAX_POINTS], input[3].usize(), node_count) then 1 else 0
        point <- point + 1
    query_x: f64 = input[query_offset].f64()
    query_y: f64 = input[query_offset + 1].f64()
    query_half_width: f64 = input[query_offset + 2].f64()
    quad_tree_query(nodes[0:MAX_NODES], 0, points[0:MAX_POINTS], query_x, query_y, query_half_width, query_indices[0:MAX_POINTS], query_count)
    word_count: usize = 2 + point_count + 2 * query_count
    words[1 + point_count] <- query_count.i64()
    index: mutable usize = 0
    while index < query_count:
        result_point: QuadPoint = points[query_indices[index]]
        words[2 + point_count + 2 * index] <- result_point.x.i64()
        words[3 + point_count + 2 * index] <- result_point.y.i64()
        index <- index + 1

    output_bytes: usize = word_count * 8
    if output_bytes > MAX_OUTPUT_BYTES: return -1
    if output.is_null() or capacity < output_bytes: return -2
    output_view: mutable view[u8] = output[0:capacity]
    index <- 0
    while index < word_count:
        quad_tree_write_i64_le(output_view, index * 8, words[index])
        index <- index + 1
    output_bytes.i64()

export fn quad_tree(input: i64&, input_length: usize,
                    output: mutable u8&, capacity: usize) -> i64 = quad_tree_impl
