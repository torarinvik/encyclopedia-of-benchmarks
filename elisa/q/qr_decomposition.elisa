extern sqrt(value: f64) -> f64

const MAX_INPUT_LENGTH: usize = 18
const MAX_DIMENSION: usize = 4
const MAX_MATRIX_ELEMENTS: usize = 16

def qr_decomposition_exact_integer(value: f64, minimum: i64, maximum: i64) -> bool:
    if value != value or value >= 1.7976931348623157e308 or value <= -1.7976931348623157e308:
        return false
    if value < minimum.f64() or value > maximum.f64(): return false
    value.i64().f64() == value

def qr_decomposition_impl(input: f64&, input_length: usize,
                          output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > MAX_INPUT_LENGTH: return -1
    if not qr_decomposition_exact_integer(input[0], 1, MAX_DIMENSION.i64()): return -1
    dimension: usize = input[0].usize()
    matrix_elements: usize = dimension * dimension
    if input_length != 1 + matrix_elements: return -1

    matrix: mutable f64[MAX_MATRIX_ELEMENTS] = zeroed
    exact: mutable i64[MAX_MATRIX_ELEMENTS] = zeroed
    index: mutable usize = 0
    while index < matrix_elements:
        value: f64 = input[index + 1]
        if not qr_decomposition_exact_integer(value, -1, 1): return -1
        matrix[index] <- value
        exact[index] <- value.i64()
        index <- index + 1

    previous_pivot: mutable i64 = 1
    pivot_column: mutable usize = 0
    while pivot_column < dimension:
        pivot: i64 = exact[pivot_column * dimension + pivot_column]
        if pivot == 0: return -1
        row: mutable usize = pivot_column + 1
        while row < dimension:
            column: mutable usize = pivot_column + 1
            while column < dimension:
                numerator: i64 = exact[row * dimension + column] * pivot -
                    exact[row * dimension + pivot_column] * exact[pivot_column * dimension + column]
                exact[row * dimension + column] <- numerator / previous_pivot
                column <- column + 1
            exact[row * dimension + pivot_column] <- 0
            row <- row + 1
        previous_pivot <- pivot
        pivot_column <- pivot_column + 1

    q: mutable f64[MAX_MATRIX_ELEMENTS] = zeroed
    r: mutable f64[MAX_MATRIX_ELEMENTS] = zeroed
    column: mutable usize = 0
    while column < dimension:
        residual: mutable f64[4] = zeroed
        row: mutable usize = 0
        while row < dimension:
            residual[row] <- matrix[row * dimension + column]
            row <- row + 1
        previous: mutable usize = 0
        while previous < column:
            projection: mutable f64 = 0.0
            row <- 0
            while row < dimension:
                projection <- projection + q[row * dimension + previous] * residual[row]
                row <- row + 1
            r[previous * dimension + column] <- projection
            row <- 0
            while row < dimension:
                residual[row] <- residual[row] - projection * q[row * dimension + previous]
                row <- row + 1
            previous <- previous + 1
        squared: mutable f64 = 0.0
        row <- 0
        while row < dimension:
            squared <- squared + residual[row] * residual[row]
            row <- row + 1
        magnitude: f64 = sqrt(squared)
        if magnitude == 0.0 or magnitude != magnitude or magnitude >= 1.7976931348623157e308: return -1
        r[column * dimension + column] <- magnitude
        row <- 0
        while row < dimension:
            q[row * dimension + column] <- residual[row] / magnitude
            row <- row + 1
        column <- column + 1

    reconstruction_squared: mutable f64 = 0.0
    orthogonality_squared: mutable f64 = 0.0
    lower_squared: mutable f64 = 0.0
    row: mutable usize = 0
    while row < dimension:
        column <- 0
        while column < dimension:
            reconstructed: mutable f64 = 0.0
            orthogonality: mutable f64 = 0.0
            inner: mutable usize = 0
            while inner < dimension:
                reconstructed <- reconstructed + q[row * dimension + inner] * r[inner * dimension + column]
                orthogonality <- orthogonality + q[inner * dimension + row] * q[inner * dimension + column]
                inner <- inner + 1
            reconstruction_error: f64 = matrix[row * dimension + column] - reconstructed
            reconstruction_squared <- reconstruction_squared + reconstruction_error * reconstruction_error
            if row == column: orthogonality <- orthogonality - 1.0
            orthogonality_squared <- orthogonality_squared + orthogonality * orthogonality
            if row > column:
                lower_squared <- lower_squared + r[row * dimension + column] * r[row * dimension + column]
            column <- column + 1
        row <- row + 1

    result: mutable f64[3] = zeroed
    result[0] <- sqrt(reconstruction_squared)
    result[1] <- sqrt(orthogonality_squared)
    result[2] <- sqrt(lower_squared)
    index <- 0
    while index < 3:
        if result[index] != result[index] or result[index] >= 1.7976931348623157e308: return -1
        index <- index + 1
    if output.is_null() or capacity < 3: return -2
    index <- 0
    while index < 3:
        output[index] <- result[index]
        index <- index + 1
    3

export fn qr_decomposition(input: f64&, input_length: usize,
                           output: mutable f64&, capacity: usize) -> i64 = qr_decomposition_impl
