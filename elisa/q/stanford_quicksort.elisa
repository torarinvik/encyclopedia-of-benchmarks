const SORT_ELEMENTS: i64 = 5000
const MAX_PREFIX_COUNT: i64 = 100
const MAX_OUTPUT_BYTES: usize = 700

def stanford_quicksort_sort(values: mutable i64&, left_value: i64, right_value: i64) -> void:
    i: mutable i64 = left_value
    j: mutable i64 = right_value
    pivot: i64 = values[((left_value + right_value) / 2).usize()]
    while true:
        while values[i.usize()] < pivot:
            i <- i + 1
        while pivot < values[j.usize()]:
            j <- j - 1
        if i <= j:
            temporary: i64 = values[i.usize()]
            values[i.usize()] <- values[j.usize()]
            values[j.usize()] <- temporary
            i <- i + 1
            j <- j - 1
        if i > j:
            break
    if left_value < j:
        stanford_quicksort_sort(values, left_value, j)
    if i < right_value:
        stanford_quicksort_sort(values, i, right_value)

def stanford_quicksort_append_number(buffer: mutable u8&, used: mutable usize&, value_value: i64) -> void:
    reversed: mutable u8[20] = zeroed
    value: mutable i64 = value_value
    count: mutable usize = 0
    if value < 0:
        buffer[used] <- 45u8
        used <- used + 1
        value <- -value
    while true:
        reversed[count] <- (48 + value % 10).u8()
        count <- count + 1
        value <- value / 10
        if value == 0:
            break
    while count > 0:
        count <- count - 1
        buffer[used] <- reversed[count]
        used <- used + 1
    buffer[used] <- 10u8
    used <- used + 1

def stanford_quicksort_impl(prefix_count: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if prefix_count < 1 or prefix_count > MAX_PREFIX_COUNT:
        return -1
    if output.is_null():
        return -2

    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    used: mutable usize = 0
    run: mutable i64 = 0
    while run < prefix_count:
        values: mutable i64[5001] = zeroed
        state: mutable i64 = 74755
        index: mutable usize = 1
        while index <= SORT_ELEMENTS.usize():
            state <- (state * 1309 + 13849) & 65535
            values[index] <- state - 50000
            index <- index + 1
        stanford_quicksort_sort(values, 1, SORT_ELEMENTS)
        stanford_quicksort_append_number(staged, used, values[(run + 1).usize()])
        run <- run + 1

    if output_capacity < used:
        return -2
    index: mutable usize = 0
    while index < used:
        output[index] <- staged[index]
        index <- index + 1
    used.i64()

export fn stanford_quicksort(prefix_count: i64, output: mutable u8&, output_capacity: usize) -> i64 = stanford_quicksort_impl
