# Bounded ring-buffer queue with a deterministic operation-trace checksum.
def queue_benchmark_impl(values: i64&, length: usize) -> i64:
    if length > 1024 or length % 2 != 0:
        return -1
    operation_count: usize = length / 2
    checksum: i64 =
        while operation < operation_count |operation: mutable usize = 0, data_queue: mutable i64[256] = zeroed, head: mutable usize = 0, count: mutable usize = 0, checksum: mutable i64 = 0| -> checksum:
            opcode: i64 = values[2 * operation]
            payload: i64 = values[2 * operation + 1]
            observed: mutable i64 = 0
            returns_value: mutable bool = true
            if opcode == 0:
                if payload < -1000000 or payload > 1000000 or count == 256:
                    break -1
                data_queue[(head + count) % 256] <- payload
                count <- count + 1
                returns_value <- false
            elif opcode == 1:
                if payload != 0 or count == 0:
                    break -1
                observed <- data_queue[head]
                head <- (head + 1) % 256
                count <- count - 1
            elif opcode == 2:
                if payload != 0 or count == 0:
                    break -1
                observed <- data_queue[head]
            elif opcode == 3:
                if payload != 0 or count == 0:
                    break -1
                observed <- data_queue[(head + count - 1) % 256]
            elif opcode == 4:
                if payload != 0:
                    break -1
                if count == 0:
                    observed <- 1
            elif opcode == 5:
                if payload != 0:
                    break -1
                observed <- count.i64()
            else:
                break -1
            if returns_value:
                checksum <- checksum + (operation + 1).i64() * (observed + 1000000)
            operation <- operation + 1
            if operation == operation_count:
                checksum <- while index < count |index: mutable usize = 0, total: mutable i64 = checksum| -> total:
                    total <- total + (operation_count + index + 1).i64() * (data_queue[(head + index) % 256] + 1000000)
                    index <- index + 1
    checksum

export fn queue_benchmark(values: i64&, length: usize) -> i64 = queue_benchmark_impl
