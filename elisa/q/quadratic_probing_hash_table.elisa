const MAX_OPERATIONS: usize = 24
const MAX_INITIAL_CAPACITY: usize = 8
const MAX_TABLE_CAPACITY: usize = 64
const MAX_INPUT_LENGTH: usize = 51
const MAX_OUTPUT_BYTES: usize = 600

struct Table:
    slots: mutable i64[MAX_TABLE_CAPACITY]
    capacity: mutable usize
    size: mutable usize

def qph_probe_insert(table: Table&, key: i64) -> i64:
    probe: mutable usize = 0
    while probe < table.capacity * 100:
        index: usize = (key.usize() + probe * probe) % table.capacity
        if table.slots[index] == 0 or table.slots[index] == -1: return index.i64()
        probe <- probe + 1
    -1

def qph_probe_find(table: Table&, key: i64) -> i64:
    probe: mutable usize = 0
    while probe < table.capacity * 100:
        index: usize = (key.usize() + probe * probe) % table.capacity
        slot: i64 = table.slots[index]
        if slot == 0: return -1
        if slot == key: return index.i64()
        probe <- probe + 1
    -1

def qph_insert_key(table: mutable Table&, key: i64) -> bool

def qph_rehash(table: mutable Table&) -> bool:
    old_capacity: usize = table.capacity
    if old_capacity > MAX_TABLE_CAPACITY / 2: return false
    old_slots: mutable i64[MAX_TABLE_CAPACITY] = zeroed
    index: mutable usize = 0
    while index < old_capacity:
        old_slots[index] <- table.slots[index]
        index <- index + 1
    table.capacity <- old_capacity * 2
    index <- 0
    while index < table.capacity:
        table.slots[index] <- 0
        index <- index + 1
    index <- 0
    while index < old_capacity:
        key: i64 = old_slots[index]
        if key != 0 and key != -1:
            if table.size == 0: return false
            table.size <- table.size - 1
            if not qph_insert_key(table, key): return false
        index <- index + 1
    true

def qph_insert_key(table: mutable Table&, key: i64) -> bool:
    slot: i64 = qph_probe_insert(table, key)
    if slot < 0: return false
    table.slots[slot.usize()] <- key
    table.size <- table.size + 1
    if table.size * 2 >= table.capacity: return qph_rehash(table)
    true

def qph_put_i64_le(output: mutable u8&, offset: usize, value: i64):
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def qph_impl(input: i64&, input_length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or input_length < 2 or input_length > MAX_INPUT_LENGTH: return -1
    if input[0] < 1 or input[0] > MAX_INITIAL_CAPACITY.i64() or
        input[1] < 0 or input[1] > MAX_OPERATIONS.i64(): return -1
    operation_count: usize = input[1].usize()
    if input_length != 2 + 2 * operation_count: return -1

    table: mutable Table = zeroed
    table.capacity <- input[0].usize()
    active: mutable bool[MAX_TABLE_CAPACITY + 1] = zeroed
    find_results: mutable i64[MAX_OPERATIONS] = zeroed
    find_count: mutable usize = 0
    operation_index: mutable usize = 0
    while operation_index < operation_count:
        operation: i64 = input[2 + 2 * operation_index]
        key: i64 = input[3 + 2 * operation_index]
        if operation < 0 or operation > 2 or key < 1 or key > 64: return -1
        key_index: usize = key.usize()
        if operation == 0:
            if active[key_index] or not qph_insert_key(table, key): return -1
            active[key_index] <- true
        else if operation == 1:
            if not active[key_index]: return -1
            slot: i64 = qph_probe_find(table, key)
            if slot < 0: return -1
            table.slots[slot.usize()] <- -1
            active[key_index] <- false
            table.size <- table.size - 1
        else:
            slot: i64 = qph_probe_find(table, key)
            find_results[find_count] <- if slot <= 0: 0 else: table.slots[slot.usize()]
            find_count <- find_count + 1
        operation_index <- operation_index + 1

    output_words: usize = 3 + find_count + table.capacity
    output_bytes: usize = output_words * 8
    if output_bytes > MAX_OUTPUT_BYTES: return -1
    if output.is_null() or capacity < output_bytes: return -2
    qph_put_i64_le(output, 0, table.capacity.i64())
    qph_put_i64_le(output, 8, table.size.i64())
    qph_put_i64_le(output, 16, find_count.i64())
    index: mutable usize = 0
    while index < find_count:
        qph_put_i64_le(output, (3 + index) * 8, find_results[index])
        index <- index + 1
    index <- 0
    while index < table.capacity:
        qph_put_i64_le(output, (3 + find_count + index) * 8, table.slots[index])
        index <- index + 1
    output_bytes.i64()

export fn quadratic_probing_hash_table(input: i64&, input_length: usize,
        output: mutable u8&, capacity: usize) -> i64 = qph_impl
