# Iterative Lomuto quicksort using the final value as its pivot.
def quick_sort_iterative_partition(values: mutable i64&, low: usize, high: usize) -> usize:
    pivot: i64 = values[high - 1]
    boundary: mutable usize = low
    for scan in low..<(high - 1):
        if values[scan] <= pivot:
            temporary: i64 = values[boundary]
            values[boundary] <- values[scan]
            values[scan] <- temporary
            boundary <- boundary + 1
    temporary: i64 = values[boundary]
    values[boundary] <- values[high - 1]
    values[high - 1] <- temporary
    boundary

def quick_sort_iterative_impl(values: mutable i64&, length: usize) -> void:
    if length < 2:
        return

    stack_low: mutable usize[128] = zeroed
    stack_high: mutable usize[128] = zeroed
    stack_size: mutable usize = 0
    low: mutable usize = 0
    high: mutable usize = length
    finished: mutable bool = false
    while not finished:
        while high - low > 1:
            pivot: usize = quick_sort_iterative_partition(values, low, high)
            left_size: usize = pivot - low
            right_size: usize = high - pivot - 1
            if left_size < right_size:
                if right_size > 1:
                    stack_low[stack_size] <- pivot + 1
                    stack_high[stack_size] <- high
                    stack_size <- stack_size + 1
                high <- pivot
            else:
                if left_size > 1:
                    stack_low[stack_size] <- low
                    stack_high[stack_size] <- pivot
                    stack_size <- stack_size + 1
                low <- pivot + 1
        if stack_size == 0:
            finished <- true
        else:
            stack_size <- stack_size - 1
            low <- stack_low[stack_size]
            high <- stack_high[stack_size]

export fn quick_sort_iterative(values: mutable i64&, length: usize) -> void = quick_sort_iterative_impl
