const MAX_DAYS: usize = 365
def minimum_tickets_cost_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4 or length > 369 or input[0] < 0 or input[0] > MAX_DAYS.i64(): return -1
    count: usize = input[0].usize()
    if length != count + 4: return -1
    travel: mutable bool[366]
    i: usize = 0
    while i < count:
        day: i64 = input[i + 1]
        if day < 1 or day > 365 or travel[day.usize()]: return -1
        travel[day.usize()] <- true
        i <- i + 1
    c1: i64 = input[count + 1]
    c7: i64 = input[count + 2]
    c30: i64 = input[count + 3]
    if c1 < 0 or c1 > 1000000 or c7 < 0 or c7 > 1000000 or c30 < 0 or c30 > 1000000: return -1
    dp: mutable i64[397]
    day: mutable usize = 365
    while day > 0:
        dp[day] <- dp[day + 1]
        if travel[day]:
            one: i64 = c1 + dp[day + 1]
            week: i64 = c7 + dp[day + 7]
            month: i64 = c30 + dp[day + 30]
            if week < one: one <- week
            if month < one: one <- month
            dp[day] <- one
        day <- day - 1
    dp[1]

export fn minimum_tickets_cost(input: i64&, length: usize) -> i64 = minimum_tickets_cost_impl
