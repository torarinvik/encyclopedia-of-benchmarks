const MAX_ORDER: i64 = 31
const FNV_OFFSET: u64 = 0xcbf29ce484222325
const FNV_PRIME: u64 = 0x100000001b3

def magic_square_impl(n: i64) -> i64:
    if n < 1 or n > MAX_ORDER or n % 2 == 0:
        return -1
    order: i64 = n
    square: mutable i32[961] = zeroed
    row: mutable i64 = order / 2
    column: mutable i64 = order - 1
    square[row * MAX_ORDER + column] <- 1

    for value in 2..<order * order + 1:
        next_row: i64 = (row - 1 + order) % order
        next_column: i64 = (column + 1) % order
        if square[next_row * MAX_ORDER + next_column] == 0:
            row <- next_row
            column <- next_column
        else:
            column <- (column - 1 + order) % order
        square[row * MAX_ORDER + column] <- value.i32()

    hash: mutable u64 = FNV_OFFSET
    hash <- (hash ^ order.u8().u64()) * FNV_PRIME
    for r in 0..<order:
        for c in 0..<order:
            bits: u32 = square[r * MAX_ORDER + c].u32()
            for byte_index in 0..<4:
                byte: u32 = (bits >> (byte_index * 8)) & 255.u32()
                hash <- (hash ^ byte.u64()) * FNV_PRIME
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn magic_square(n: i64) i64 = magic_square_impl
