const MAX_VALUES: usize = 25
const MAX_INPUT_LENGTH: usize = 28

def insertion_sort(values: mutable view[i64], start: usize, end: usize) -> void:
    for index in start + 1..<end:
        value: i64 = values[index]
        position: mutable usize = index
        while position > start and values[position - 1] > value:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- value

def select_kth(values: mutable view[i64], length: usize, rank: usize) -> i64:
    medians: mutable i64[5] = zeroed
    median_count: mutable usize = 0
    start: mutable usize = 0
    while start < length:
        end: mutable usize = start + 5
        if end > length:
            end <- length
        insertion_sort(values, start, end)
        medians[median_count] <- values[(start + end) / 2]
        median_count <- median_count + 1
        start <- start + 5
    insertion_sort(medians[0:median_count], 0, median_count)
    pivot: i64 = medians[(median_count - 1) / 2]

    lower: mutable i64[MAX_VALUES] = zeroed
    higher: mutable i64[MAX_VALUES] = zeroed
    lower_count: mutable usize = 0
    higher_count: mutable usize = 0
    for index in 0..<length:
        if values[index] < pivot:
            lower[lower_count] <- values[index]
            lower_count <- lower_count + 1
        else if values[index] > pivot:
            higher[higher_count] <- values[index]
            higher_count <- higher_count + 1
    if rank < lower_count:
        return select_kth(lower[0:lower_count], lower_count, rank)
    if rank > lower_count:
        return select_kth(higher[0:higher_count], higher_count, rank - lower_count - 1)
    pivot

def median_of_medians_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_INPUT_LENGTH:
        return -1
    count_value: i64 = input[0]
    rank_value: i64 = input[1]
    if count_value < 1 or count_value > 25 or rank_value < 0 or rank_value >= count_value:
        return -1
    count: usize = count_value.usize()
    if length != count + 2:
        return -1

    values: mutable i64[MAX_VALUES] = zeroed
    for index in 0..<count:
        value: i64 = input[index + 2]
        if value < 0 or value > 2147483647:
            return -1
        for previous in 0..<index:
            if values[previous] == value:
                return -1
        values[index] <- value
    select_kth(values[0:count], count, rank_value.usize())

export fn median_of_medians(input: i64&, length: usize) -> i64 = median_of_medians_impl
