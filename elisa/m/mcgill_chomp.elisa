# Base-addressed dynamic programming for the seven-column Chomp profiles.
extern calloc(count: usize, size: usize) -> mutable u8&?
extern free(memory: mutable u8&) -> void

const CHOMP_COLUMNS: usize = 7

def chomp_state_id(heights: view[usize], powers: view[usize]) -> usize:
    id: mutable usize = 0
    index: mutable usize = 0
    while index < CHOMP_COLUMNS:
        id <- id + heights[index] * powers[index]
        index <- index + 1
    id

def chomp_evaluate_state(rows: usize, heights: view[usize],
                         powers: view[usize], values: mutable u8&) -> void:
    state_id: usize = chomp_state_id(heights, powers)
    has_move: mutable bool = false
    winning: mutable bool = false
    row: mutable usize = 0
    while row < rows:
        column: mutable usize = 0
        while column < CHOMP_COLUMNS:
            child_id: mutable usize = 0
            changed: mutable bool = false
            index: mutable usize = 0
            while index < CHOMP_COLUMNS:
                height: mutable usize = heights[index]
                if index >= column and height > row:
                    height <- row
                    changed <- true
                child_id <- child_id + height * powers[index]
                index <- index + 1
            if changed:
                has_move <- true
                if values[child_id] == 0: winning <- true
            column <- column + 1
        row <- row + 1
    values[state_id] <- (1.u8() if not has_move or winning else 0.u8())

def chomp_enumerate_states(rows: usize, column: i64, minimum_height: usize,
                           heights: mutable view[usize], powers: view[usize],
                           values: mutable u8&) -> void:
    if column < 0:
        chomp_evaluate_state(rows, heights, powers, values)
        return
    height: mutable usize = minimum_height
    while height <= rows:
        heights[column.usize()] <- height
        chomp_enumerate_states(rows, column - 1, height, heights, powers, values)
        height <- height + 1

def mcgill_chomp_impl(rows: i64) -> i64:
    if rows != 7 and rows != 8: return -1
    row_count: usize = rows.usize()
    base: usize = row_count + 1
    powers: mutable usize[7] = zeroed
    powers[0] <- 1
    column: mutable usize = 1
    while column < CHOMP_COLUMNS:
        powers[column] <- powers[column - 1] * base
        column <- column + 1
    state_space: usize = powers[CHOMP_COLUMNS - 1] * base
    values: mutable u8& = get calloc(state_space, 1) else return -1
    heights: mutable usize[7] = zeroed
    chomp_enumerate_states(row_count, 6, 0, heights[0:CHOMP_COLUMNS], powers[0:CHOMP_COLUMNS], values)
    result: i64 = values[state_space - 1].i64()
    free(values)
    result

export fn mcgill_chomp(rows: i64) -> i64 = mcgill_chomp_impl
