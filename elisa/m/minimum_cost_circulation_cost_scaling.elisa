const MCCS_MAX_N: usize = 8
const MCCS_MAX_M: usize = 10
const MCCS_MAX_ARCS: usize = 20
const MCCS_MAX_INPUT: usize = 43
const MCCS_COST_OFFSET: i64 = 81

export fn minimum_cost_circulation_cost_scaling(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MCCS_MAX_INPUT:
        return -1
    input_view: view[i64] = input[0:length]
    n_value: i64 = input_view[0]
    m_value: i64 = input_view[1]
    if n_value < 1 or n_value > MCCS_MAX_N.i64() or m_value < 0 or m_value > MCCS_MAX_M.i64():
        return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + 4 * m:
        return -1

    edge_from: mutable usize[MCCS_MAX_ARCS] = zeroed
    edge_to: mutable usize[MCCS_MAX_ARCS] = zeroed
    reverse: mutable usize[MCCS_MAX_ARCS] = zeroed
    capacity: mutable i64[MCCS_MAX_ARCS] = zeroed
    edge_cost: mutable i64[MCCS_MAX_ARCS] = zeroed
    max_scaled_cost: mutable i64 = 0
    for index in 0..<m:
        offset: usize = 2 + 4 * index
        from_value: i64 = input_view[offset]
        to_value: i64 = input_view[offset + 1]
        original_capacity: i64 = input_view[offset + 2]
        cost: i64 = input_view[offset + 3]
        if from_value < 0 or from_value >= n_value or to_value < 0 or to_value >= n_value or
                original_capacity < 0 or original_capacity > 2 or cost < -4 or cost > 4:
            return -1
        from: usize = from_value.usize()
        to: usize = to_value.usize()
        scaled_cost: i64 = cost * (n + 1).i64()
        forward: usize = 2 * index
        backward: usize = forward + 1
        edge_from[forward] <- from
        edge_to[forward] <- to
        reverse[forward] <- backward
        capacity[forward] <- original_capacity
        edge_cost[forward] <- scaled_cost
        edge_from[backward] <- to
        edge_to[backward] <- from
        reverse[backward] <- forward
        capacity[backward] <- 0
        edge_cost[backward] <- -scaled_cost
        magnitude: i64 = if scaled_cost < 0 then -scaled_cost else scaled_cost
        if magnitude > max_scaled_cost:
            max_scaled_cost <- magnitude

    epsilon: mutable i64 = 1
    while epsilon < max_scaled_cost:
        epsilon <- epsilon * 2
    price: mutable i64[MCCS_MAX_N] = zeroed
    arc_count: usize = 2 * m
    while epsilon > 1:
        epsilon <- epsilon / 2
        excess: mutable i64[MCCS_MAX_N] = zeroed
        for edge_index in 0..<arc_count:
            if capacity[edge_index] <= 0:
                continue
            from: usize = edge_from[edge_index]
            to: usize = edge_to[edge_index]
            reduced_cost: i64 = edge_cost[edge_index] + price[from] - price[to]
            if reduced_cost < 0:
                amount: i64 = capacity[edge_index]
                capacity[edge_index] <- 0
                capacity[reverse[edge_index]] <- capacity[reverse[edge_index]] + amount
                excess[from] <- excess[from] - amount
                excess[to] <- excess[to] + amount

        queue: mutable usize[MCCS_MAX_N] = zeroed
        queued: mutable bool[MCCS_MAX_N] = zeroed
        head: mutable usize = 0
        tail: mutable usize = 0
        queue_count: mutable usize = 0
        for vertex in 0..<n:
            if excess[vertex] > 0:
                queue[tail] <- vertex
                tail <- (tail + 1) % n
                queue_count <- queue_count + 1
                queued[vertex] <- true

        while queue_count > 0:
            vertex: usize = queue[head]
            head <- (head + 1) % n
            queue_count <- queue_count - 1
            queued[vertex] <- false
            while excess[vertex] > 0:
                admissible: mutable usize = MCCS_MAX_ARCS
                for edge_index in 0..<arc_count:
                    if edge_from[edge_index] != vertex or edge_to[edge_index] == vertex or capacity[edge_index] <= 0:
                        continue
                    to: usize = edge_to[edge_index]
                    if edge_cost[edge_index] + price[vertex] - price[to] < 0:
                        admissible <- edge_index
                        break

                if admissible < MCCS_MAX_ARCS:
                    to: usize = edge_to[admissible]
                    reverse_index: usize = reverse[admissible]
                    amount: i64 = if excess[vertex] < capacity[admissible] then excess[vertex] else capacity[admissible]
                    capacity[admissible] <- capacity[admissible] - amount
                    capacity[reverse_index] <- capacity[reverse_index] + amount
                    old_excess: i64 = excess[to]
                    excess[vertex] <- excess[vertex] - amount
                    excess[to] <- excess[to] + amount
                    if old_excess <= 0 and excess[to] > 0 and not queued[to]:
                        queue[tail] <- to
                        tail <- (tail + 1) % n
                        queue_count <- queue_count + 1
                        queued[to] <- true
                else:
                    has_exit: mutable bool = false
                    best_price: mutable i64 = 0
                    for edge_index in 0..<arc_count:
                        if edge_from[edge_index] != vertex or capacity[edge_index] <= 0:
                            continue
                        to: usize = edge_to[edge_index]
                        candidate: i64 = price[to] - edge_cost[edge_index] - epsilon
                        if not has_exit or candidate > best_price:
                            has_exit <- true
                            best_price <- candidate
                    if not has_exit:
                        return -1
                    price[vertex] <- best_price

        for vertex in 0..<n:
            if excess[vertex] != 0:
                return -1

    total_cost: mutable i64 = 0
    for index in 0..<m:
        original_capacity: i64 = input_view[2 + 4 * index + 2]
        original_cost: i64 = input_view[2 + 4 * index + 3]
        flow: i64 = original_capacity - capacity[2 * index]
        total_cost <- total_cost + flow * original_cost
    total_cost + MCCS_COST_OFFSET
