alias MAX_ROWS = 8
alias MAX_COLUMNS = 8
alias NO_FEASIBLE = -1025
alias INVALID_INPUT = -1026

def best_subarray_at_most(values: view[i64], limit: i64) -> i64:
    var prefixes: mutable i64[MAX_COLUMNS + 1] = zeroed
    var prefix_count: mutable usize = 1
    var running: mutable i64 = 0
    var best: mutable i64 = NO_FEASIBLE
    for i in range(values.len()):
        running <- running + values[i]
        let threshold = running - limit
        var low: mutable usize = 0
        var high: mutable usize = prefix_count
        while low < high:
            let middle = low + (high - low) / 2
            if prefixes[middle] < threshold: low <- middle + 1
            else: high <- middle
        if low < prefix_count:
            let candidate = running - prefixes[low]
            if best == NO_FEASIBLE or candidate > best: best <- candidate
        var insert: mutable usize = prefix_count
        while insert > 0 and prefixes[insert - 1] > running:
            prefixes[insert] <- prefixes[insert - 1]
            insert <- insert - 1
        prefixes[insert] <- running
        prefix_count <- prefix_count + 1
    best

def max_sum_rectangle_impl(values: view[i64]) -> i64:
    if values.len() < 3 or values.len() > 68: return INVALID_INPUT
    let rows_value = values[0]
    let columns_value = values[1]
    let limit = values[2]
    if rows_value < 1 or rows_value > MAX_ROWS or columns_value < 1 or columns_value > MAX_COLUMNS:
        return INVALID_INPUT
    if limit < -1024 or limit > 1024: return INVALID_INPUT
    let rows = rows_value.usize()
    let columns = columns_value.usize()
    if values.len() != 3 + rows * columns: return INVALID_INPUT
    var matrix: mutable i64[MAX_ROWS * MAX_COLUMNS] = zeroed
    for row in range(rows):
        for column in range(columns):
            let value = values[3 + row * columns + column]
            if value < -16 or value > 16: return INVALID_INPUT
            matrix[row * MAX_COLUMNS + column] <- value
    let short_dimension = if rows < columns: rows else: columns
    let long_dimension = if rows < columns: columns else: rows
    var best: mutable i64 = NO_FEASIBLE
    for first in range(short_dimension):
        var compressed: mutable i64[MAX_COLUMNS] = zeroed
        for last in range(first, short_dimension):
            for offset in range(long_dimension):
                let index = if rows <= columns:
                    last * MAX_COLUMNS + offset
                else:
                    offset * MAX_COLUMNS + last
                compressed[offset] <- compressed[offset] + matrix[index]
            let candidate = best_subarray_at_most(compressed[0:long_dimension], limit)
            if candidate != NO_FEASIBLE and (best == NO_FEASIBLE or candidate > best):
                best <- candidate
                if best == limit: return best
    best

export fn max_sum_rectangle_no_larger_than_k(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > 68: return INVALID_INPUT
    let values: view[i64] = input[0:length]
    max_sum_rectangle_impl(values)
