# Kadane-based maximum nonempty contiguous circular-subarray sum.
def maximum_circular_subarray_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 64 or values.is_null():
        return -9223372036854775807 - 1
    index: mutable usize = 0
    while index < length:
        if values[index] < -1000000 or values[index] > 1000000:
            return -9223372036854775807 - 1
        index <- index + 1

    total: mutable i64 = values[0]
    current_max: mutable i64 = values[0]
    max_so_far: mutable i64 = values[0]
    current_min: mutable i64 = values[0]
    min_so_far: mutable i64 = values[0]
    index <- 1
    while index < length:
        value: i64 = values[index]
        if current_max + value > value:
            current_max <- current_max + value
        else:
            current_max <- value
        if current_max > max_so_far:
            max_so_far <- current_max
        if current_min + value < value:
            current_min <- current_min + value
        else:
            current_min <- value
        if current_min < min_so_far:
            min_so_far <- current_min
        total <- total + value
        index <- index + 1
    if min_so_far == total:
        return max_so_far
    if max_so_far > total - min_so_far:
        return max_so_far
    total - min_so_far

export fn maximum_circular_subarray(values: i64&, length: usize) -> i64 = maximum_circular_subarray_impl
