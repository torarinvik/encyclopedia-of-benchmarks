const INVALID_RESULT: i64 = -9223372036854775808
const MAX_PARSEABLE_INPUT_LENGTH: usize = 4
const MAX_COMPONENT: i64 = 89000000
const MAX_EXPONENT: i64 = 64

def modpow_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_PARSEABLE_INPUT_LENGTH:
        return INVALID_RESULT
    if length != 3:
        return INVALID_RESULT
    base: i64 = input[0]
    exponent: i64 = input[1]
    modulus: i64 = input[2]
    if base < 0 or base > MAX_COMPONENT or exponent < 0 or exponent > MAX_EXPONENT:
        return INVALID_RESULT
    if modulus < 1 or modulus > MAX_COMPONENT:
        return INVALID_RESULT
    if exponent == 0:
        if base == 0:
            return INVALID_RESULT
        return 1 % modulus
    if base == 0:
        return 0
    result: mutable i64 = 1 % modulus
    while exponent > 0:
        if exponent % 2 == 1:
            result <- (result * base) % modulus
            exponent <- exponent - 1
        else:
            base <- (base * base) % modulus
            exponent <- exponent / 2
    result

export fn modpow(input: i64&, length: usize) -> i64 = modpow_impl
