const MAX_NODE_COUNT: usize = 63
const MAX_PARSEABLE_INPUT_LENGTH: usize = 65

def store_i32_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u32 = value.u32()
    output[offset] <- (bits & 255).u8()
    output[offset + 1] <- ((bits >> 8) & 255).u8()
    output[offset + 2] <- ((bits >> 16) & 255).u8()
    output[offset + 3] <- ((bits >> 24) & 255).u8()

# Bounded Morris inorder traversal over a complete level-order tree.
def morrisinorder_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if values.is_null() or length < 1 or length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    raw_count: i64 = values[0]
    if raw_count < 0 or raw_count > MAX_NODE_COUNT.i64():
        return -1
    count: usize = raw_count.usize()
    if length != count + 1:
        return -1
    index: usize = 0
    while index < count:
        node: i64 = values[index + 1]
        if node < -2147483648 or node > 2147483647:
            return -1
        index <- index + 1

    byte_count: usize = 4 * count
    if output.is_null() or output_capacity < byte_count:
        return -2

    left_nodes: mutable i64[MAX_NODE_COUNT] = zeroed
    right_nodes: mutable i64[MAX_NODE_COUNT] = zeroed
    index <- 0
    while index < count:
        left_index: usize = 2 * index + 1
        right_index: usize = 2 * index + 2
        if left_index < count:
            left_nodes[index] <- left_index.i64()
        else:
            left_nodes[index] <- -1
        if right_index < count:
            right_nodes[index] <- right_index.i64()
        else:
            right_nodes[index] <- -1
        index <- index + 1

    current: mutable i64 = 0
    if count == 0:
        current <- -1
    written: mutable usize = 0
    while current >= 0:
        current_index: usize = current.usize()
        if left_nodes[current_index] < 0:
            store_i32_le(values[current_index + 1], output, 4 * written)
            written <- written + 1
            current <- right_nodes[current_index]
        else:
            predecessor: mutable usize = left_nodes[current_index].usize()
            while right_nodes[predecessor] >= 0 and right_nodes[predecessor] != current:
                predecessor <- right_nodes[predecessor].usize()
            if right_nodes[predecessor] < 0:
                right_nodes[predecessor] <- current
                current <- left_nodes[current_index]
            else:
                right_nodes[predecessor] <- -1
                store_i32_le(values[current_index + 1], output, 4 * written)
                written <- written + 1
                current <- right_nodes[current_index]
    byte_count.i64()

export fn morrisinorder(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = morrisinorder_impl
