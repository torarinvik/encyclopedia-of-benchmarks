extern sqrt(value: f64) -> f64
extern exp(value: f64) -> f64

const MAX_SIMULATIONS: usize = 32
const MAX_PARSEABLE_INPUT_LENGTH: usize = 520

def finite_value(value: f64) -> bool:
    value == value and value >= -1.7976931348623157e308 and value <= 1.7976931348623157e308

def allowed_maturity(value: f64) -> bool:
    value == 0.25 or value == 0.5 or value == 1.0 or value == 2.0

def allowed_step_count(value: f64) -> bool:
    value == 1.0 or value == 2.0 or value == 4.0 or value == 8.0 or value == 16.0

def monte_carlo_simulation_impl(input: f64&, input_length: usize,
        output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or input_length < 7 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    i: mutable usize = 0
    while i < input_length:
        if not finite_value(input[i]): return -1
        i <- i + 1

    s0: f64 = input[0]
    strike: f64 = input[1]
    rate: f64 = input[2]
    volatility: f64 = input[3]
    maturity: f64 = input[4]
    step_value: f64 = input[5]
    simulation_value: f64 = input[6]
    if s0 < 1.0 or s0 > 1000.0 or strike < 0.0 or strike > 2000.0 or
            rate < -0.25 or rate > 0.25 or volatility < 0.0 or volatility > 0.5 or
            not allowed_maturity(maturity) or not allowed_step_count(step_value) or
            simulation_value < 1.0 or simulation_value > MAX_SIMULATIONS.f64() or
            simulation_value.i64().f64() != simulation_value: return -1

    steps: usize = step_value.usize()
    simulations: usize = simulation_value.usize()
    if input_length != 7 + steps * simulations: return -1
    i <- 7
    while i < input_length:
        if input[i] < -3.0 or input[i] > 3.0: return -1
        i <- i + 1

    dt: f64 = maturity / steps.f64()
    sqrt_dt: f64 = sqrt(dt)
    drift_rate: f64 = rate - 0.5 * (volatility * volatility)
    drift: f64 = drift_rate * maturity
    payoffs: mutable f64[32] = zeroed
    simulation: mutable usize = 0
    while simulation < simulations:
        brownian: mutable f64 = 0.0
        offset: usize = 7 + simulation * steps
        step: mutable usize = 0
        while step < steps:
            brownian <- brownian + sqrt_dt * input[offset + step]
            step <- step + 1
        exponent: f64 = drift + volatility * brownian
        terminal_price: f64 = s0 * exp(exponent)
        difference: f64 = terminal_price - strike
        payoffs[simulation] <- if difference > 0.0: difference else: 0.0
        simulation <- simulation + 1

    total: mutable f64 = 0.0
    simulation <- 0
    while simulation < simulations:
        total <- total + payoffs[simulation]
        simulation <- simulation + 1
    option_price: f64 = (total / simulations.f64()) * exp(-(rate * maturity))
    if not finite_value(option_price): return -1
    if output.is_null() or capacity < 1: return -2
    output[0] <- option_price
    return 1

export fn monte_carlo_simulation(input: f64&, input_length: usize,
        output: mutable f64&, capacity: usize) -> i64 = monte_carlo_simulation_impl
