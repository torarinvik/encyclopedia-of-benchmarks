const M1: i64 = 4294967087
const M2: i64 = 4294944443
const MAX_COUNT: i64 = 64

def mrg32k3a_residue(value: i64, modulus: i64) -> i64:
    residue: mutable i64 = value % modulus
    if residue < 0: residue <- residue + modulus
    residue

def mrg32k3a_put_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def mrg32k3a_impl(input: i64&, output: mutable u8&) -> i64:
    x1: mutable i64[3] = zeroed
    x2: mutable i64[3] = zeroed
    index: mutable usize = 0
    while index < 3:
        x1[index] <- input[index]
        x2[index] <- input[index + 3]
        index <- index + 1
    count: usize = input[6].usize()
    step: mutable usize = 0
    while step < count:
        next1: i64 = mrg32k3a_residue(1403580 * x1[1] - 810728 * x1[0], M1)
        next2: i64 = mrg32k3a_residue(527612 * x2[2] - 1370589 * x2[0], M2)
        x1[0] <- x1[1]
        x1[1] <- x1[2]
        x1[2] <- next1
        x2[0] <- x2[1]
        x2[1] <- x2[2]
        x2[2] <- next2
        z: mutable i64 = next1 - next2
        if z < 0: z <- z + M1
        mrg32k3a_put_i64_le(output, step * 8, z)
        step <- step + 1
    (count * 8).i64()

def mrg32k3a_combined_recursive_generator_impl(
    input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length != 7: return -1
    index: mutable usize = 0
    while index < 3:
        if input[index] < 0 or input[index] >= M1: return -1
        if input[index + 3] < 0 or input[index + 3] >= M2: return -1
        index <- index + 1
    if (input[0] | input[1] | input[2]) == 0: return -1
    if (input[3] | input[4] | input[5]) == 0: return -1
    if input[6] < 0 or input[6] > MAX_COUNT: return -1
    count: usize = input[6].usize()
    required: usize = count * 8
    if count == 0: return 0
    if output == null or capacity < required: return -2
    input_view: i64& = input
    output_view: mutable u8& = output
    mrg32k3a_impl(input_view, output_view)

export fn mrg32k3a_combined_recursive_generator( input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = mrg32k3a_combined_recursive_generator_impl
