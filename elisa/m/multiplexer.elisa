def multiplexer_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length != 3:
        return -1
    input0: i64 = values[0]
    input1: i64 = values[1]
    select: i64 = values[2]
    if (input0 != 0 and input0 != 1) or (input1 != 0 and input1 != 1) or (select != 0 and select != 1):
        return -1
    if select == 1:
        return input1
    return input0

export fn multiplexer(values: i64&, length: usize) -> i64 = multiplexer_impl
