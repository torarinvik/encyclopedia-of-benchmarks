const INVALID_RESULT: f64 = -1.0e300
const A1: f64 = -0.1666666666671334
const A2: f64 = 0.833333333809067e-2
const A3: f64 = 0.198412715551283e-3
const A4: f64 = 0.27557589750762e-5
const A5: f64 = 0.2507059876207e-7
const A6: f64 = 0.164105986683e-9
const B1: f64 = -0.4999999999982
const B2: f64 = 0.4166666664651e-1
const B3: f64 = -0.1388888805755e-2
const B4: f64 = 0.24801428034e-4
const B5: f64 = -0.2754213324e-6
const B6: f64 = 0.20189405e-8
const D1: f64 = 0.3999999946405e-1
const D2: f64 = 0.96e-3
const D3: f64 = 0.1233153e-5
const E2: f64 = 0.48e-3
const E3: f64 = 0.411051e-6

def sin_poly_legacy(w: f64) -> f64:
    value: mutable f64 = A6
    value <- value*w + A5
    value <- value*w + A4
    value <- value*w + A3
    value <- value*w + A2
    value <- value*w + A1
    value*w + 1.0

def sin_poly_alternating(w: f64) -> f64:
    value: mutable f64 = A6
    value <- value*w - A5
    value <- value*w + A4
    value <- value*w - A3
    value <- value*w + A2
    value <- value*w + A1
    value*w + 1.0

def cos_poly(w: f64) -> f64:
    value: mutable f64 = B6
    value <- value*w + B5
    value <- value*w + B4
    value <- value*w + B3
    value <- value*w + B2
    value <- value*w + B1
    value*w + 1.0

def misc_flops_impl(values: i64&, length: usize) -> f64:
    if values.is_null() or length != 2:
        return INVALID_RESULT
    module_id: i64 = values[0]
    steps: i64 = values[1]
    if module_id < 1 or module_id > 8 or steps < 2 or steps > 128:
        return INVALID_RESULT
    pi: f64 = 3.14159265358979323846
    sum: mutable f64 = 0.0
    result: mutable f64 = 0.0
    x: mutable f64 = 0.0
    u: mutable f64 = 0.0
    w: mutable f64 = 0.0
    if module_id == 1:
        n: i64 = 2 * steps
        dx: f64 = 1.0 / n.f64()
        v: mutable f64 = 0.0
        for i in 1..<n.usize():
            v <- v + 1.0
            u <- v * dx
            sum <- sum + (D1 + u*(D2 + u*D3)) / (1.0 + u*(D1 + u*(E2 + u*E3)))
        endpoint: f64 = (D1 + D2 + D3) / (1.0 + D1 + E2 + E3)
        result <- 1.0 / (dx * (endpoint + D1 + 2.0*sum) / 2.0)
    elif module_id == 2:
        sign: mutable f64 = -5.0
        partial: mutable f64 = -1.0
        for _ in 0..<steps.usize():
            sign <- -sign
            partial <- partial + sign
        v: mutable f64 = 0.0
        reciprocal_sum: mutable f64 = 0.0
        u <- partial
        x <- 0.0
        for _ in 0..<steps.usize():
            sign <- -sign
            partial <- partial + sign
            u <- u + 2.0
            x <- x + (sign - u)
            v <- v - sign*u
            reciprocal_sum <- reciprocal_sum + sign/u
        estimate: f64 = 4.0*reciprocal_sum/5.0 + 5.0/v
        result <- estimate - 31.25/(v*v*v)
    elif module_id == 3:
        dx: f64 = pi / (3.0*steps.f64())
        v: mutable f64 = 0.0
        for _ in 1..<steps.usize():
            v <- v + 1.0
            u <- v*dx
            w <- u*u
            sum <- sum + u*sin_poly_alternating(w)
        u <- pi/3.0
        w <- u*u
        result <- dx*(u*sin_poly_alternating(w)+2.0*sum)/2.0
    elif module_id == 4:
        dx: f64 = pi / (3.0*steps.f64())
        for i in 1..<steps.usize():
            u <- i.f64()*dx
            w <- u*u
            sum <- sum + w*(w*(w*(w*(w*(B6*w+B5)+B4)+B3)+B2)+B1)+1.0
        u <- pi/3.0
        w <- u*u
        endpoint: f64 = w*(w*(w*(w*(w*(B6*w+B5)+B4)+B3)+B2)+B1)+1.0
        result <- dx*(endpoint+1.0+2.0*sum)/2.0
    elif module_id == 5:
        dx: f64 = pi / (3.0*steps.f64())
        for i in 1..<steps.usize():
            u <- i.f64()*dx
            w <- u*u
            sum <- sum + (u*sin_poly_legacy(w))/cos_poly(w)
        u <- pi/3.0
        w <- u*u
        result <- dx*(u*sin_poly_legacy(w)/cos_poly(w)+2.0*sum)/2.0
    elif module_id == 6:
        dx: f64 = pi / (4.0*steps.f64())
        for i in 1..<steps.usize():
            u <- i.f64()*dx
            w <- u*u
            sum <- sum + (u*sin_poly_legacy(w))*cos_poly(w)
        u <- pi/4.0
        w <- u*u
        result <- dx*((u*sin_poly_legacy(w))*cos_poly(w)+2.0*sum)/2.0
    elif module_id == 7:
        finish: f64 = 102.3321513995275
        dx: f64 = finish/steps.f64()
        for i in 1..<steps.usize():
            x <- i.f64()*dx
            u <- x*x
            sum <- sum - 1.0/(x+1.0) - x/(u+1.0) - u/(x*u+1.0)
        x <- finish
        u <- x*x
        endpoint: f64 = -1.0 - 1.0/(x+1.0) - x/(u+1.0) - u/(x*u+1.0)
        result <- 18.0*dx*(endpoint+2.0*sum)
    else:
        dx: f64 = pi / (3.0*steps.f64())
        for i in 1..<steps.usize():
            u <- i.f64()*dx
            w <- u*u
            cosine: f64 = cos_poly(w)
            sum <- sum + cosine*cosine*u*sin_poly_legacy(w)
        u <- pi/3.0
        w <- u*u
        cosine: f64 = cos_poly(w)
        result <- dx*((u*sin_poly_legacy(w))*cosine*cosine+2.0*sum)/2.0
    result

export fn misc_flops(values: i64&, length: usize) -> f64 = misc_flops_impl
