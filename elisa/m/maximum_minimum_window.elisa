def store_i64_le(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u64 = if value < 0: (value + 18_446_744_073_709_551_616).u64() else: value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def maximum_minimum_window_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2: return -2
    n0: i64 = input[0]
    if n0 < 1 or n0 > 256 or length != n0.usize() + 1: return -2
    n: usize = n0.usize()
    index: mutable usize = 0
    while index < n:
        if input[index + 1] < 0 or input[index + 1] > 1_000_000: return -2
        index <- index + 1
    if output_capacity < n * 8: return -3
    result: mutable i64[257] = zeroed
    left: mutable i64[256] = zeroed
    right: mutable i64[256] = zeroed
    stack: mutable usize[256] = zeroed
    top: mutable usize = 0
    index <- 0
    while index < n:
        while top > 0 and input[stack[top - 1] + 1] >= input[index + 1]: top <- top - 1
        left[index] <- if top > 0: stack[top - 1].i64() else: -1
        stack[top] <- index
        top <- top + 1
        index <- index + 1
    top <- 0
    index <- n
    while index > 0:
        index <- index - 1
        while top > 0 and input[stack[top - 1] + 1] >= input[index + 1]: top <- top - 1
        right[index] <- if top > 0: stack[top - 1].i64() else: n.i64()
        stack[top] <- index
        top <- top + 1
    index <- 0
    while index < n:
        size: usize = (right[index] - left[index] - 1).usize()
        if result[size] < input[index + 1]: result[size] <- input[index + 1]
        index <- index + 1
    index <- n
    while index > 1:
        index <- index - 1
        if result[index] < result[index + 1]: result[index] <- result[index + 1]
    index <- 1
    while index <= n:
        store_i64_le(result[index], output, (index - 1) * 8)
        index <- index + 1
    n.i64()

export fn maximum_minimum_window(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = maximum_minimum_window_impl
