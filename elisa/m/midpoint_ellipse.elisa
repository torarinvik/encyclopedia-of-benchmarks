# Midpoint ellipse rasterization preserving Java's point order and duplicates.
def midpoint_ellipse_write_i32(output: mutable view[u8], position: usize, value: i64) -> void:
    bits: u32 = value.u32()
    output[position] <- (bits & 255).u8()
    output[position + 1] <- ((bits >> 8) & 255).u8()
    output[position + 2] <- ((bits >> 16) & 255).u8()
    output[position + 3] <- ((bits >> 24) & 255).u8()

def midpoint_ellipse_count(center_x: i64, center_y: i64, a: i64, b: i64) -> usize:
    if a == 0 and b == 0:
        return 1
    if a == 0:
        return (2 * b + 1).usize()
    if b == 0:
        return (2 * a + 1).usize()
    x: mutable i64 = 0
    y: mutable i64 = b
    d1: mutable f64 = (b * b - a * a * b).f64() + 0.25 * (a * a).f64()
    dx: mutable f64 = 2.0 * b * b * x
    dy: mutable f64 = 2.0 * a * a * y
    count: mutable usize = 0
    while dx < dy:
        count <- count + 4
        if d1 < 0:
            x <- x + 1
            dx <- dx + 2 * b * b
            d1 <- d1 + dx + b * b
        else:
            x <- x + 1
            y <- y - 1
            dx <- dx + 2 * b * b
            dy <- dy - 2 * a * a
            d1 <- d1 + dx - dy + b * b
    d2: mutable f64 = b * b * (x + 0.5) * (x + 0.5) + a * a * (y - 1) * (y - 1) - a * a * b * b
    while y >= 0:
        count <- count + 4
        if d2 > 0:
            y <- y - 1
            dy <- dy - 2 * a * a
            d2 <- d2 + a * a - dy
        else:
            y <- y - 1
            x <- x + 1
            dx <- dx + 2 * b * b
            dy <- dy - 2 * a * a
            d2 <- d2 + dx - dy + a * a
    count

def midpoint_ellipse_write_symmetric(output: mutable view[u8], position: mutable usize&,
        center_x: i64, center_y: i64, x: i64, y: i64) -> void:
    midpoint_ellipse_write_i32(output, position, center_x + x)
    midpoint_ellipse_write_i32(output, position + 4, center_y + y)
    position <- position + 8
    midpoint_ellipse_write_i32(output, position, center_x - x)
    midpoint_ellipse_write_i32(output, position + 4, center_y + y)
    position <- position + 8
    midpoint_ellipse_write_i32(output, position, center_x + x)
    midpoint_ellipse_write_i32(output, position + 4, center_y - y)
    position <- position + 8
    midpoint_ellipse_write_i32(output, position, center_x - x)
    midpoint_ellipse_write_i32(output, position + 4, center_y - y)
    position <- position + 8

def midpoint_ellipse_impl(input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if length != 4:
        return -1
    center_x: i64 = input[0]
    center_y: i64 = input[1]
    a: i64 = input[2]
    b: i64 = input[3]
    if (center_x < -10000 or center_x > 10000 or center_y < -10000 or center_y > 10000 or
            a < 0 or a > 100 or b < 0 or b > 100):
        return -1
    count: usize = midpoint_ellipse_count(center_x, center_y, a, b)
    required: usize = count * 8
    if output_capacity < required:
        return -2
    output_view: mutable view[u8] = output[0:required]
    if a == 0 and b == 0:
        midpoint_ellipse_write_i32(output_view, 0, center_x)
        midpoint_ellipse_write_i32(output_view, 4, center_y)
        return 1
    if a == 0:
        for index in 0..<count |output_view|:
            midpoint_ellipse_write_i32(output_view, index * 8, center_x)
            midpoint_ellipse_write_i32(output_view, index * 8 + 4, center_y - b + index.i64())
        return count.i64()
    if b == 0:
        for index in 0..<count |output_view|:
            midpoint_ellipse_write_i32(output_view, index * 8, center_x - a + index.i64())
            midpoint_ellipse_write_i32(output_view, index * 8 + 4, center_y)
        return count.i64()
    x: mutable i64 = 0
    y: mutable i64 = b
    d1: mutable f64 = (b * b - a * a * b).f64() + 0.25 * (a * a).f64()
    dx: mutable f64 = 2.0 * b * b * x
    dy: mutable f64 = 2.0 * a * a * y
    position: mutable usize = 0
    while dx < dy:
        midpoint_ellipse_write_symmetric(output_view, position, center_x, center_y, x, y)
        if d1 < 0:
            x <- x + 1
            dx <- dx + 2 * b * b
            d1 <- d1 + dx + b * b
        else:
            x <- x + 1
            y <- y - 1
            dx <- dx + 2 * b * b
            dy <- dy - 2 * a * a
            d1 <- d1 + dx - dy + b * b
    d2: mutable f64 = b * b * (x + 0.5) * (x + 0.5) + a * a * (y - 1) * (y - 1) - a * a * b * b
    while y >= 0:
        midpoint_ellipse_write_symmetric(output_view, position, center_x, center_y, x, y)
        if d2 > 0:
            y <- y - 1
            dy <- dy - 2 * a * a
            d2 <- d2 + a * a - dy
        else:
            y <- y - 1
            x <- x + 1
            dx <- dx + 2 * b * b
            dy <- dy - 2 * a * a
            d2 <- d2 + dx - dy + a * a
    count.i64()

export fn midpoint_ellipse(input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = midpoint_ellipse_impl
