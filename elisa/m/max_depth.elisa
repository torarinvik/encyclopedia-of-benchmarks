# Recursively return one plus the larger child depth for an indexed binary tree.
def max_depth_visit(nodes: i64&, node_count: usize, node: i64) -> i64:
    if node == -1:
        return 0
    if node < 0 or node.u64() >= node_count.u64():
        return -1
    index: usize = node.usize()
    left: i64 = nodes[3 * index + 1]
    right: i64 = nodes[3 * index + 2]
    invalid_left: bool = left < -1 or (left >= 0 and left.u64() >= node_count.u64())
    invalid_right: bool = right < -1 or (right >= 0 and right.u64() >= node_count.u64())
    if invalid_left or invalid_right:
        return -1
    left_depth: i64 = max_depth_visit(nodes, node_count, left)
    if left_depth < 0:
        return -1
    right_depth: i64 = max_depth_visit(nodes, node_count, right)
    if right_depth < 0:
        return -1
    1 + (left_depth if left_depth > right_depth else right_depth)

def max_depth_impl(nodes: i64&, node_count: usize, root_index: i64) -> i64:
    if node_count > 1023:
        return -1
    if node_count == 0:
        return 0 if root_index == -1 else -1
    if root_index < 0 or root_index.u64() >= node_count.u64():
        return -1
    max_depth_visit(nodes, node_count, root_index)

export fn max_depth(nodes: i64&, node_count: usize, root_index: i64) -> i64 = max_depth_impl
