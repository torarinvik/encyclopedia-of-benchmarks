const MAX_OPERATIONS: usize = 512
const MAX_INSERTIONS: usize = 256

def max_heap_store(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value as u64
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255) as u8
        bits <- bits >> 8
        byte <- byte + 1

export fn max_heap(input: mutable i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 1: return -1
    operations_value: i64 = input[0]
    if operations_value < 0 or operations_value > MAX_OPERATIONS as i64: return -1
    operations: usize = operations_value as usize
    if length != 1 + operations * 2: return -1
    inserts: mutable usize = 0
    words: mutable usize = 0
    i: mutable usize = 0
    while i < operations:
        op: i64 = input[1 + 2 * i]
        value: i64 = input[2 + 2 * i]
        if op < 0 or op > 2: return -1
        if op == 0:
            inserts <- inserts + 1
            if inserts > MAX_INSERTIONS or value < -2147483648 or value > 2147483647: return -1
        else:
            if value != 0: return -1
            words <- words + 1
        i <- i + 1
    if capacity < words * 8: return -2
    heap: mutable i64[MAX_INSERTIONS] = zeroed
    size: mutable usize = 0
    out_index: mutable usize = 0
    i <- 0
    while i < operations:
        op: i64 = input[1 + 2 * i]
        value: i64 = input[2 + 2 * i]
        if op == 0:
            at: mutable usize = size
            heap[at] <- value
            size <- size + 1
            while at > 0:
                parent: usize = (at - 1) / 2
                if heap[parent] >= heap[at]: break
                temporary: i64 = heap[parent]
                heap[parent] <- heap[at]
                heap[at] <- temporary
                at <- parent
        else:
            result: mutable i64 = -9223372036854775808
            if size > 0:
                result <- heap[0]
                if op == 2:
                    size <- size - 1
                    heap[0] <- heap[size]
                    at: mutable usize = 0
                    while at < size / 2:
                        child: mutable usize = at * 2 + 1
                        if child + 1 < size and heap[child + 1] > heap[child]: child <- child + 1
                        if heap[at] >= heap[child]: break
                        temporary: i64 = heap[at]
                        heap[at] <- heap[child]
                        heap[child] <- temporary
                        at <- child
            max_heap_store(output[0:words * 8], out_index * 8, result)
            out_index <- out_index + 1
        i <- i + 1
    words as i64
