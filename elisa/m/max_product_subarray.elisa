def max_product_subarray_impl(values: i64&, length: usize) -> i64:
    if length > 9:
        return -9223372036854775807 - 1
    if length == 0:
        return 0
    if values[0] < -10 or values[0] > 10:
        return -9223372036854775807 - 1
    max_now: mutable i64 = values[0]
    min_now: mutable i64 = values[0]
    max_product: mutable i64 = values[0]
    i: mutable usize = 1
    while i < length:
        value: mutable i64 = values[i]
        if value < -10 or value > 10:
            return -9223372036854775807 - 1
        if value < 0:
            swap: mutable i64 = max_now
            max_now <- min_now
            min_now <- swap
        product: mutable i64 = max_now * value
        if value > product:
            max_now <- value
        else:
            max_now <- product
        product <- min_now * value
        if value < product:
            min_now <- value
        else:
            min_now <- product
        if max_now > max_product:
            max_product <- max_now
        i <- i + 1
    max_product

export fn max_product_subarray(values: i64&, length: usize) -> i64 = max_product_subarray_impl
