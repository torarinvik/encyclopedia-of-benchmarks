const MILLER_MODULUS: i64 = 998244353
const MILLER_MAX_INPUT: usize = 35

def miller_mod_pow(base_value: i64, exponent_value: i64) -> i64:
    let base: mutable i64 = base_value
    let exponent: mutable i64 = exponent_value
    let result: mutable i64 = 1
    while exponent > 0:
        if (exponent & 1) != 0: result <- (result * base) % MILLER_MODULUS
        base <- (base * base) % MILLER_MODULUS
        exponent <- exponent >> 1
    result

def miller_store_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    let bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def miller_prepare(input: view[i64], result_words: mutable view[i64]) -> i64:
    let length: usize = input.len()
    if length < 6 or length > MILLER_MAX_INPUT: return -1
    if result_words.len() < 10: return -1
    let levels_value: i64 = input[0]
    if levels_value < 1 or levels_value > 8: return -1
    let levels: usize = levels_value.usize()
    if length != 4 * levels + 2: return -1
    for index in 1..<length:
        if input[index] < 0 or input[index] >= MILLER_MODULUS: return -1
    for level in 1..<=levels:
        if input[3 * level] == 0: return -1

    for index in 0..<result_words.len():
        result_words[index] <- 0
    result_words[levels] <- 1
    let level: mutable usize = levels
    while level > 0:
        let a_value: i64 = input[3 * level - 2]
        let b_value: i64 = input[3 * level - 1]
        let c_value: i64 = input[3 * level]
        let positive: i64 = (b_value * result_words[level]) % MILLER_MODULUS
        let negative: i64 = (a_value * result_words[level + 1]) % MILLER_MODULUS
        let numerator: i64 = (positive + MILLER_MODULUS - negative) % MILLER_MODULUS
        result_words[level - 1] <- (numerator * miller_mod_pow(c_value, MILLER_MODULUS - 2)) % MILLER_MODULUS
        level <- level - 1
    let lambda_start: usize = 3 * levels + 1
    let normalizer: mutable i64 = 0
    for index in 0..<=levels:
        normalizer <- (normalizer + input[lambda_start + index] * result_words[index]) % MILLER_MODULUS
    if normalizer == 0: return -1
    let scale: i64 = miller_mod_pow(normalizer, MILLER_MODULUS - 2)
    let required: usize = 8 * (levels + 2)
    let index: mutable usize = levels + 1
    while index > 0:
        index <- index - 1
        result_words[index + 1] <- (result_words[index] * scale) % MILLER_MODULUS
    result_words[0] <- levels_value
    required.i64()

export fn miller_backward_recurrence_normalization(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 6 or length > MILLER_MAX_INPUT: return -1
    let input_view: view[i64] = input[0:length]
    let result_storage: mutable [10]i64 = [0; 10]
    let result_words: mutable view[i64] = result_storage[0:10]
    let required: i64 = miller_prepare(input_view, result_words)
    if required < 0: return required
    let required_bytes: usize = required.usize()
    if output.is_null() or capacity < required_bytes: return -2
    let output_view: mutable view[u8] = output[0:required_bytes]
    let word_count: usize = required_bytes / 8
    for word in 0..<word_count:
        miller_store_le(result_words[word], output_view, 8 * word)
    required
