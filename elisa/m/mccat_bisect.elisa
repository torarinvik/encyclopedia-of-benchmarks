extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

const MCCAT_BISECT_MAX_N: usize = 32
const MCCAT_BISECT_MAX_OUTPUT_BYTES: usize = (MCCAT_BISECT_MAX_N + 1) * 8
const MCCAT_BISECT_EPSILON: f64 = 2.2204460492503131e-16

def mccat_bisect_abs(value: f64) -> f64:
    if value < 0.0: return -value
    value

def mccat_bisect_sturm(diagonal: f64&, off_diagonal: f64&, beta: f64&,
        n: usize, x: f64) -> usize:
    negative_count: mutable usize = 0
    q: mutable f64 = 1.0
    index: mutable usize = 0
    while index < n:
        if q != 0.0:
            q <- (diagonal[index] - x) - beta[index] / q
        else:
            q <- (diagonal[index] - x) - mccat_bisect_abs(off_diagonal[index]) / MCCAT_BISECT_EPSILON
        if q < 0.0: negative_count <- negative_count + 1
        index <- index + 1
    negative_count

def mccat_bisect_store_f64(output: mutable u8&, offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    index: mutable usize = 0
    while index < 8:
        output[offset + index] <- ((bits >> (8 * index)) & 255).u8()
        index <- index + 1

def mccat_bisect_solve(n: usize, output: mutable u8&) -> usize:
    diagonal: mutable f64[MCCAT_BISECT_MAX_N] = zeroed
    off_diagonal: mutable f64[MCCAT_BISECT_MAX_N] = zeroed
    beta: mutable f64[MCCAT_BISECT_MAX_N] = zeroed
    eigenvalues: mutable f64[MCCAT_BISECT_MAX_N + 1] = zeroed
    lower_bounds: mutable f64[MCCAT_BISECT_MAX_N + 1] = zeroed
    index: mutable usize = 0
    while index < n:
        value: f64 = (index + 1).f64()
        diagonal[index] <- value * value
        diagonal[index] <- diagonal[index] * diagonal[index]
        off_diagonal[index] <- index.f64()
        beta[index] <- off_diagonal[index] * off_diagonal[index]
        index <- index + 1
    beta[0] <- 0.0
    off_diagonal[0] <- 0.0

    fudge: f64 = 1.01
    xmin: mutable f64 = diagonal[n - 1] - fudge * mccat_bisect_abs(off_diagonal[n - 1])
    xmax: mutable f64 = diagonal[n - 1] + fudge * mccat_bisect_abs(off_diagonal[n - 1])
    index <- n - 1
    while index > 0:
        index <- index - 1
        h: f64 = fudge * (mccat_bisect_abs(off_diagonal[index]) + mccat_bisect_abs(off_diagonal[index + 1]))
        if diagonal[index] + h > xmax: xmax <- diagonal[index] + h
        if diagonal[index] - h < xmin: xmin <- diagonal[index] - h

    eps2: mutable f64 = MCCAT_BISECT_EPSILON * (if xmin + xmax > 0.0: xmax else: -xmin)
    eps1: mutable f64 = MCCAT_BISECT_EPSILON
    if eps1 <= 0.0: eps1 <- eps2
    eps2 <- 0.5 * eps1 + 7.0 * eps2

    x0: mutable f64 = xmax
    index <- n
    while index > 0:
        eigenvalues[index] <- xmax
        lower_bounds[index] <- xmin
        index <- index - 1
    iterations: mutable usize = 0
    k: mutable usize = n
    while k > 0:
        xu: mutable f64 = xmin
        index <- k
        while index > 0:
            if xu < lower_bounds[index]:
                xu <- lower_bounds[index]
                break
            index <- index - 1
        if x0 > eigenvalues[k]: x0 <- eigenvalues[k]
        x1: mutable f64 = (xu + x0) / 2.0
        while x0 - xu > 2.0 * MCCAT_BISECT_EPSILON * (mccat_bisect_abs(xu) + mccat_bisect_abs(x0)) + eps1:
            iterations <- iterations + 1
            count: usize = mccat_bisect_sturm(&diagonal[0], &off_diagonal[0], &beta[0], n, x1)
            if count < k:
                if count < 1:
                    xu <- x1
                    lower_bounds[1] <- x1
                else:
                    xu <- x1
                    lower_bounds[count + 1] <- x1
                    if eigenvalues[count] > x1: eigenvalues[count] <- x1
            else:
                x0 <- x1
            x1 <- (xu + x0) / 2.0
        eigenvalues[k] <- (xu + x0) / 2.0
        k <- k - 1

    used: mutable usize = 0
    index <- 2
    while index <= n:
        mccat_bisect_store_f64(output, used, eigenvalues[index])
        used <- used + 8
        index <- index + 1
    mccat_bisect_store_f64(output, used, eps2)
    used <- used + 8
    mccat_bisect_store_f64(output, used, iterations.f64())
    used + 8

def mccat_bisect_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if values.is_null() or length != 1 or values[0] < 2 or values[0] > MCCAT_BISECT_MAX_N.i64():
        return -1
    n: usize = values[0].usize()
    required: usize = (n + 1) * 8
    if output.is_null() or output_capacity < required: return -2
    staged: mutable u8[MCCAT_BISECT_MAX_OUTPUT_BYTES] = zeroed
    used: usize = mccat_bisect_solve(n, staged)
    for index in 0..<used: output[index] <- staged[index]
    used.i64()

export fn mccat_bisect(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = mccat_bisect_impl
