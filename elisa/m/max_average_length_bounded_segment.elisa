const MAX_N: usize=32
const MAX_INPUT: usize=35
def put64(x:i64,o:mutable view[u8],p:usize)->void:
    b:u64=x.u64();j:mutable usize=0
    while j<8:
        o[p+j]<-((b>>(8*j))&255).u8()
        b<-b>>8
        j<-j+1
def max_average_length_bounded_segment(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("max_average_length_bounded_segment"):
    if input.is_null() or length<4 or length>MAX_INPUT:return -1
    n64:i64=input[0];lower64:i64=input[1];upper64:i64=input[2]
    if n64<1 or n64>32 or lower64<1 or upper64<lower64 or upper64>n64 or length!=3+n64.usize():return -1
    n:usize=n64.usize();lower:usize=lower64.usize();upper:usize=upper64.usize();i:mutable usize=0
    while i<n:
        if input[3+i]<-10000 or input[3+i]>10000:return -1
        i<-i+1
    if output.is_null() or capacity<32:return -2
    output_view:mutable view[u8]=output[0:32]
    best_sum:mutable i64=0;best_length:mutable i64=1;best_start:mutable i64=0;best_end:mutable i64=0;have:mutable bool=false
    start:mutable usize=0
    while start<n:
        sum:mutable i64=0;limit:usize=if start+upper<n:start+upper else:n;end:mutable usize=start+1
        while end<=limit:
            sum<-sum+input[3+end-1];length_now:usize=end-start
            if length_now>=lower:
                left:i64=sum*best_length;right:i64=best_sum*length_now.i64()
                tie:bool=length_now<best_length.usize() or (length_now==best_length.usize() and (start<best_start.usize() or (start==best_start.usize() and end<best_end.usize())))
                if not have or left>right or (left==right and tie):
                    best_sum<-sum;best_length<-length_now.i64();best_start<-start.i64();best_end<-end.i64();have<-true
            end<-end+1
        start<-start+1
    put64(best_sum,output_view,0);put64(best_length,output_view,8);put64(best_start,output_view,16);put64(best_end,output_view,24);32.i64()
