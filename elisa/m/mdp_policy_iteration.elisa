const MAX_STATES: usize = 4
const MAX_ACTIONS: usize = 3
const MAX_RECORDS: usize = 12
const MAX_OUTPUT_WORDS: usize = 13

struct MdpFraction:
    numerator: i64
    denominator: i64

struct MdpPolicyContext:
    rewards: i64[12]
    successors: i64[12]
    policy: usize[4]
    values: MdpFraction[4]

def mdp_gcd_u64(a_value: u64, b_value: u64) -> u64:
    a: mutable u64 = a_value
    b: mutable u64 = b_value
    while b != 0:
        remainder: u64 = a % b
        a <- b
        b <- remainder
    a

def mdp_reduce_fraction(numerator: i64, denominator: i64) -> MdpFraction:
    magnitude: mutable u64 = numerator.u64()
    if numerator < 0:
        magnitude <- (-numerator).u64()
    divisor: u64 = mdp_gcd_u64(magnitude, denominator.u64())
    if divisor == 0:
        divisor <- 1
    MdpFraction(numerator / divisor.i64(), denominator / divisor.i64())

def mdp_power_i64(base_value: i64, exponent_value: usize) -> i64:
    result: mutable i64 = 1
    exponent: mutable usize = exponent_value
    while exponent > 0:
        result <- result * base_value
        exponent <- exponent - 1
    result

def mdp_extend_value(reward: i64, successor: MdpFraction, p: i64, q: i64) -> MdpFraction:
    numerator: i64 = reward * successor.denominator * q + p * successor.numerator
    denominator: i64 = successor.denominator * q
    mdp_reduce_fraction(numerator, denominator)

def mdp_evaluate_policy(context: mutable MdpPolicyContext&, states: usize,
        actions: usize, p: i64, q: i64) -> void:
    start: mutable usize = 0
    while start < states:
        first_seen: mutable i64[4] = [-1, -1, -1, -1]
        path: mutable usize[4] = zeroed
        path_length: mutable usize = 0
        current: mutable usize = start
        while first_seen[current] < 0:
            first_seen[current] <- path_length.i64()
            path[path_length] <- current
            path_length <- path_length + 1
            record: usize = path[path_length - 1] * actions + context.policy[path[path_length - 1]]
            current <- context.successors[record].usize()
        cycle_start: usize = first_seen[current].usize()
        cycle_length: usize = path_length - cycle_start
        cycle_numerator: mutable i64 = 0
        j: mutable usize = 0
        while j < cycle_length:
            state: usize = path[cycle_start + j]
            record: usize = state * actions + context.policy[state]
            cycle_numerator <- cycle_numerator + context.rewards[record] * mdp_power_i64(p, j) * mdp_power_i64(q, cycle_length - j)
            j <- j + 1
        cycle_denominator: i64 = mdp_power_i64(q, cycle_length) - mdp_power_i64(p, cycle_length)
        context.values[path[cycle_start]] <- mdp_reduce_fraction(cycle_numerator, cycle_denominator)

        j <- path_length
        while j > cycle_start + 1:
            index: usize = j - 1
            state: usize = path[index]
            next_state: usize = path[cycle_start]
            if index + 1 < path_length:
                next_state <- path[index + 1]
            record: usize = state * actions + context.policy[state]
            context.values[state] <- mdp_extend_value(context.rewards[record], context.values[next_state], p, q)
            j <- j - 1
        j <- cycle_start
        while j > 0:
            index: usize = j - 1
            state: usize = path[index]
            next_state: usize = path[index + 1]
            record: usize = state * actions + context.policy[state]
            context.values[state] <- mdp_extend_value(context.rewards[record], context.values[next_state], p, q)
            j <- j - 1
        start <- start + 1

def mdp_improve_policy(context: mutable MdpPolicyContext&, states: usize,
        actions: usize, p: i64, q: i64) -> usize:
    changed: mutable usize = 0
    state: mutable usize = 0
    while state < states:
        best_action: mutable usize = 0
        best_record: usize = state * actions
        best_next: usize = context.successors[best_record].usize()
        best: mutable MdpFraction = mdp_extend_value(context.rewards[best_record], context.values[best_next], p, q)
        action: mutable usize = 1
        while action < actions:
            record: usize = state * actions + action
            candidate: MdpFraction = mdp_extend_value(context.rewards[record], context.values[context.successors[record].usize()], p, q)
            if candidate.numerator * best.denominator > best.numerator * candidate.denominator:
                best_action <- action
                best <- candidate
            action <- action + 1
        if context.policy[state] != best_action:
            context.policy[state] <- best_action
            changed <- changed + 1
        state <- state + 1
    changed

def mdp_write_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255.u64()).u8()
        byte <- byte + 1

def mdp_policy_iteration_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > 28:
        return -1
    values: view[i64] = input[0:length]
    if values[0] < 1 or values[0] > MAX_STATES.i64() or values[1] < 1 or values[1] > MAX_ACTIONS.i64():
        return -1
    if values[3] < 1 or values[3] > 4 or values[2] < 0 or values[2] >= values[3]:
        return -1
    states: usize = values[0].usize()
    actions: usize = values[1].usize()
    p: i64 = values[2]
    q: i64 = values[3]
    if length != 4 + 2 * states * actions:
        return -1
    context: mutable MdpPolicyContext = zeroed
    state_action: mutable usize = 0
    while state_action < states * actions:
        reward: i64 = values[4 + 2 * state_action]
        successor: i64 = values[5 + 2 * state_action]
        if reward < -20 or reward > 20 or successor < 0 or successor >= values[0]:
            return -1
        context.rewards[state_action] <- reward
        context.successors[state_action] <- successor
        state_action <- state_action + 1
    state: mutable usize = 0
    while state < MAX_STATES:
        context.values[state] <- MdpFraction(0, 1)
        state <- state + 1
    policy_count: mutable usize = 1
    state <- 0
    while state < states:
        policy_count <- policy_count * actions
        state <- state + 1
    stable: mutable bool = false
    iteration: mutable usize = 0
    while iteration <= policy_count:
        mdp_evaluate_policy(context&, states, actions, p, q)
        if mdp_improve_policy(context&, states, actions, p, q) == 0:
            stable <- true
            break
        iteration <- iteration + 1
    if not stable:
        return -1

    words: mutable i64[MAX_OUTPUT_WORDS] = zeroed
    words[0] <- states.i64()
    state <- 0
    while state < states:
        words[1 + state] <- context.policy[state].i64()
        words[1 + states + 2 * state] <- context.values[state].numerator
        words[2 + states + 2 * state] <- context.values[state].denominator
        state <- state + 1
    output_bytes: usize = (1 + 3 * states) * 8
    if output.is_null() or output_capacity < output_bytes:
        return -2
    output_view: mutable view[u8] = output[0:output_bytes]
    i: mutable usize = 0
    while i < 1 + 3 * states:
        mdp_write_i64_le(output_view, i * 8, words[i])
        i <- i + 1
    output_bytes.i64()

export fn mdp_policy_iteration(input: i64&, length: usize, output: mutable u8&,
    output_capacity: usize) -> i64 = mdp_policy_iteration_impl
