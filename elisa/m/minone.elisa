const MAX_LENGTH: usize = 64
const MIN_VALUE: i64 = -1000000
const MAX_VALUE: i64 = 1000000

def minone_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_LENGTH: return -1
    total: mutable i64 = 0
    for index in 0..<length |input, total|:
        value: i64 = input[index]
        if value < MIN_VALUE or value > MAX_VALUE: return -1
        total <- total + value * value
    total

export fn minone(input: i64&, length: usize) -> i64 = minone_impl
