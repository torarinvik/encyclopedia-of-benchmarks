def min_heap_bulk_extract_sorted_sift_down(heap: mutable i64&, count: usize, start: usize) -> void:
    index: mutable usize = start
    while true:
        smallest: mutable usize = index
        left: usize = index * 2 + 1
        right: usize = left + 1
        if left < count and heap[left] < heap[smallest]:
            smallest <- left
        if right < count and heap[right] < heap[smallest]:
            smallest <- right
        if smallest == index:
            return
        temporary: mutable i64 = heap[index]
        heap[index] <- heap[smallest]
        heap[smallest] <- temporary
        index <- smallest

def min_heap_bulk_extract_sorted_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def min_heap_bulk_extract_sorted_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values.is_null() or length < 2 or length > 4096:
        return -1
    raw_count: i64 = values[0]
    if raw_count < 1 or raw_count > 4095 or length != raw_count.usize() + 1:
        return -1
    count: usize = raw_count.usize()
    heap: mutable i64[4095] = zeroed
    index: usize = 0
    while index < count:
        value: i64 = values[index + 1]
        if value < -2147483648 or value > 2147483647:
            return -1
        position: mutable usize = index
        heap[position] <- value
        while position > 0:
            parent: usize = (position - 1) / 2
            if heap[parent] <= heap[position]:
                break
            temporary: mutable i64 = heap[parent]
            heap[parent] <- heap[position]
            heap[position] <- temporary
            position <- parent
        index <- index + 1
    output_bytes: usize = 8 * count
    if output.is_null() or capacity < output_bytes:
        return -2
    remaining: mutable usize = count
    index <- 0
    while index < count:
        min_heap_bulk_extract_sorted_store(heap[0], output, 8 * index)
        remaining <- remaining - 1
        if remaining > 0:
            heap[0] <- heap[remaining]
            min_heap_bulk_extract_sorted_sift_down(heap[0], remaining, 0)
        index <- index + 1
    output_bytes.i64()

export fn min_heap_bulk_extract_sorted(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = min_heap_bulk_extract_sorted_impl
