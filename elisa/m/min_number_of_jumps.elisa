const MAX_LENGTH: usize = 64
const UNREACHABLE: i64 = 1000000000000

def min_number_of_jumps_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 1 or length > MAX_LENGTH:
        return -1
    for index in 0..<length:
        if values[index] < 0 or values[index] > 64:
            return -1
    jumps: mutable i64[MAX_LENGTH]
    for index in 0..<MAX_LENGTH:
        jumps[index] <- UNREACHABLE
    jumps[0] <- 0
    for destination in 1..<length:
        for previous in 0..<destination:
            if values[previous] + previous.i64() >= destination.i64() and jumps[previous] + 1 < jumps[destination]:
                jumps[destination] <- jumps[previous] + 1
    jumps[length - 1]

export fn min_number_of_jumps(values: i64&, length: usize) -> i64 = min_number_of_jumps_impl
