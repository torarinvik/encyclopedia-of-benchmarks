const MN_MAX_N: i64 = 30
const MN_MAX_PARSEABLE_LENGTH: usize = 2

def motzkin_number_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 1 or input_length > MN_MAX_PARSEABLE_LENGTH: return -1
    if input_length != 1: return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > MN_MAX_N: return -1
    n: usize = n_value.usize()
    values: mutable i64[31] = zeroed
    values[0] <- 1
    if n >= 1: values[1] <- 1
    size: mutable usize = 2
    while size <= n:
        total: mutable i64 = values[size - 1]
        left: mutable usize = 0
        while left + 2 <= size:
            total <- total + values[left] * values[size - 2 - left]
            left <- left + 1
        values[size] <- total
        size <- size + 1
    values[n]

def motzkin_number_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MN_MAX_PARSEABLE_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    motzkin_number_impl(input_view, input_view_length)

export fn motzkin_number(input: i64&, length: usize) -> i64 = motzkin_number_entry
