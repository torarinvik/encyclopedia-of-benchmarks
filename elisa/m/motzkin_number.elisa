const MN_MAX_N: i64 = 30
const MN_MAX_PARSEABLE_LENGTH: usize = 2

def motzkin_number_impl(input: view[i64]) -> i64:
    if input.length < 1 or input.length > MN_MAX_PARSEABLE_LENGTH: return -1
    if input.length != 1: return -1
    n_value: i64 = input[0]
    if n_value < 0 or n_value > MN_MAX_N: return -1
    n: usize = n_value.usize()
    values: mutable i64[31] = zeroed
    values[0] <- 1
    if n >= 1: values[1] <- 1
    size: mutable usize = 2
    while size <= n:
        total: mutable i64 = values[size - 1]
        left: mutable usize = 0
        while left + 2 <= size:
            total <- total + values[left] * values[size - 2 - left]
            left <- left + 1
        values[size] <- total
        size <- size + 1
    values[n]

export fn motzkin_number(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MN_MAX_PARSEABLE_LENGTH: return -1
    input_view: view[i64] = input[0:length]
    motzkin_number_impl(input_view)
