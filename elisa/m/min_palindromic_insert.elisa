# Build the minimum-insertion palindrome using the source's interval DP.
# Equal-cost reconstruction choices take the right-character branch.
const MPI_MAX_N: usize = 256
const MPI_MAX_OUTPUT: usize = 527

def mpi_write_i64(output: mutable u8&, position_value: usize, value: i64) -> usize:
    position: mutable usize = position_value
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[position] <- ((bits >> (8 * byte)) & 255).u8()
        position <- position + 1
    position

def min_palindromic_insert_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 1 or length > MPI_MAX_N + 1:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > MPI_MAX_N.i64() or length != n_value.usize() + 1:
        return -1
    n: usize = n_value.usize()
    chars: mutable u8[MPI_MAX_N] = zeroed
    for index in 0..<n:
        value: i64 = input[index + 1]
        if value < 32 or value > 126:
            return -1
        chars[index] <- value.u8()

    dp: mutable u16[MPI_MAX_N][MPI_MAX_N] = zeroed
    # Spans of length one are the zero-cost base case, including n == 1.
    for span in 2..<(n + 1):
        for left in 0..<(n - span + 1):
            right: usize = left + span - 1
            if chars[left] == chars[right]:
                dp[left][right] <- if span > 2: dp[left + 1][right - 1] else: 0
            else:
                left_cost: u16 = dp[left + 1][right]
                right_cost: u16 = dp[left][right - 1]
                dp[left][right] <- (if left_cost < right_cost: left_cost else: right_cost) + 1

    insertions: usize = dp[0][n - 1].usize()
    palindrome_length: usize = n + insertions
    palindrome: mutable u8[2 * MPI_MAX_N - 1] = zeroed
    left: mutable usize = 0
    right: mutable usize = n - 1
    out_left: mutable usize = 0
    out_right: mutable usize = palindrome_length - 1
    while left <= right:
        if chars[left] == chars[right]:
            palindrome[out_left] <- chars[left]
            palindrome[out_right] <- chars[right]
            left <- left + 1
            if right == 0:
                break
            right <- right - 1
        else if dp[left + 1][right] < dp[left][right - 1]:
            palindrome[out_left] <- chars[left]
            palindrome[out_right] <- chars[left]
            left <- left + 1
        else:
            palindrome[out_left] <- chars[right]
            palindrome[out_right] <- chars[right]
            if right == 0:
                break
            right <- right - 1
        out_left <- out_left + 1
        if out_right == 0:
            break
        out_right <- out_right - 1

    payload: mutable u8[MPI_MAX_OUTPUT] = zeroed
    written: mutable usize = 0
    written <- mpi_write_i64(payload[0], written, insertions.i64())
    written <- mpi_write_i64(payload[0], written, palindrome_length.i64())
    for index in 0..<palindrome_length:
        payload[written] <- palindrome[index]
        written <- written + 1
    if output == null or output_capacity < written:
        return -2
    for index in 0..<written:
        output[index] <- payload[index]
    written.i64()

export fn min_palindromic_insert(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = min_palindromic_insert_impl
