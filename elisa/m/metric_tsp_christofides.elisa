def metric_tsp_christofides_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255.u64()).u8()
        byte <- byte + 1

def metric_tsp_christofides(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("metric_tsp_christofides"):
    if input.is_null() or length < 2 or length > 65: return -1
    n64: i64 = input[0]
    if n64 < 1 or n64 > 8 or length != 1 + n64.usize() * n64.usize(): return -1
    n: usize = n64.usize()
    d: mutable i64[8][8] = zeroed
    u: mutable usize = 0
    while u < n:
        v: mutable usize = 0
        while v < n:
            w: i64 = input[1 + u * n + v]
            if w < 0 or w > 10000 or (u == v and w != 0): return -1
            d[u][v] <- w
            v <- v + 1
        u <- u + 1
    u <- 0
    while u < n:
        v: mutable usize = 0
        while v < n:
            if d[u][v] != d[v][u]: return -1
            k: mutable usize = 0
            while k < n:
                if d[u][v] > d[u][k] + d[k][v]: return -1
                k <- k + 1
            v <- v + 1
        u <- u + 1
    output_bytes: usize = 8 * (n + 2)
    if output.is_null() or capacity < output_bytes: return -2
    used: mutable bool[8][8] = zeroed
    tree: mutable bool[8][8] = zeroed
    parent: mutable usize[8] = zeroed
    u <- 0
    while u < n: parent[u] <- u; u <- u + 1
    accepted: mutable usize = 0
    while accepted + 1 < n:
        bu: mutable usize = 0; bv: mutable usize = 0
        bw: mutable i64 = 9223372036854775807
        u <- 0
        while u < n:
            v <- u + 1
            while v < n:
                if not used[u][v] and (d[u][v] < bw or (d[u][v] == bw and (u < bu or (u == bu and v < bv)))):
                    bu <- u; bv <- v; bw <- d[u][v]
                v <- v + 1
            u <- u + 1
        used[bu][bv] <- true
        ru: mutable usize = bu; rv: mutable usize = bv
        while parent[ru] != ru: ru <- parent[ru]
        while parent[rv] != rv: rv <- parent[rv]
        if ru != rv:
            parent[rv] <- ru
            tree[bu][bv] <- true; tree[bv][bu] <- true
            accepted <- accepted + 1
    odd: mutable usize[8] = zeroed
    odd_count: mutable usize = 0
    u <- 0
    while u < n:
        deg: mutable usize = 0; v <- 0
        while v < n:
            if tree[u][v]: deg <- deg + 1
            v <- v + 1
        if deg % 2 == 1: odd[odd_count] <- u; odd_count <- odd_count + 1
        u <- u + 1
    full: usize = (1 << odd_count) - 1
    dp: mutable i64[256] = zeroed; pick: mutable usize[256] = zeroed
    mask: mutable usize = 0
    while mask < 256: dp[mask] <- 9223372036854775807 / 4; pick[mask] <- 8; mask <- mask + 1
    dp[0] <- 0
    mask <- 1
    while mask <= full:
        i: mutable usize = 0
        while (mask & (1 << i)) == 0: i <- i + 1
        rest: usize = mask ^ (1 << i)
        j: mutable usize = i + 1
        while j < odd_count:
            if (rest & (1 << j)) != 0:
                tail: usize = rest ^ (1 << j)
                value: i64 = dp[tail] + d[odd[i]][odd[j]]
                if value < dp[mask]: dp[mask] <- value; pick[mask] <- j
            j <- j + 1
        mask <- mask + 1
    multi: mutable usize[8][8] = zeroed
    u <- 0
    while u < n:
        v <- 0
        while v < n:
            if tree[u][v]: multi[u][v] <- 1
            v <- v + 1
        u <- u + 1
    mask <- full
    while mask != 0:
        i <- 0
        while (mask & (1 << i)) == 0: i <- i + 1
        j <- pick[mask]; ru <- odd[i]; rv <- odd[j]
        multi[ru][rv] <- multi[ru][rv] + 1; multi[rv][ru] <- multi[rv][ru] + 1
        mask <- mask ^ (1 << i) ^ (1 << j)
    stack: mutable usize[32] = zeroed; reverse: mutable usize[32] = zeroed
    top: mutable usize = 1; rc: mutable usize = 0; stack[0] <- 0
    while top > 0:
        vertex: usize = stack[top - 1]
        neighbor: mutable usize = 8; v <- 0
        while v < n and neighbor == 8:
            if multi[vertex][v] > 0: neighbor <- v
            v <- v + 1
        if neighbor == 8:
            top <- top - 1; reverse[rc] <- stack[top]; rc <- rc + 1
        else:
            multi[vertex][neighbor] <- multi[vertex][neighbor] - 1
            multi[neighbor][vertex] <- multi[neighbor][vertex] - 1
            stack[top] <- neighbor; top <- top + 1
    seen: mutable bool[8] = zeroed; order: mutable usize[8] = zeroed
    count: mutable usize = 0
    while rc > 0:
        rc <- rc - 1; vertex <- reverse[rc]
        if not seen[vertex]: seen[vertex] <- true; order[count] <- vertex; count <- count + 1
    cost: mutable i64 = 0; u <- 0
    while u + 1 < n: cost <- cost + d[order[u]][order[u + 1]]; u <- u + 1
    cost <- cost + d[order[n - 1]][0]
    metric_tsp_christofides_store(cost, output, 0)
    u <- 0
    while u < n: metric_tsp_christofides_store(order[u].i64(), output, 8 * (u + 1)); u <- u + 1
    metric_tsp_christofides_store(0, output, 8 * (n + 1))
    output_bytes.i64()
