# Exact minimum directed cycle mean using Karp's exact-length path DP.
const MMC_MAX_N: usize = 8
const MMC_MAX_M: usize = 16
const MMC_MAX_INPUT: usize = 51
const MMC_OUTPUT_BYTES: usize = 16

def mmc_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def mmc_all_reachable(n: usize, adjacency: view[bool], reverse: bool) -> bool:
    seen: mutable bool[8] = zeroed
    queue: mutable usize[8] = zeroed
    head: mutable usize = 0
    tail: mutable usize = 1
    seen[0] <- true
    queue[0] <- 0
    while head < tail:
        u: usize = queue[head]
        head <- head + 1
        for v in 0..<n:
            edge_index: usize = if reverse then v * 8 + u else u * 8 + v
            if adjacency[edge_index] and not seen[v]:
                seen[v] <- true
                queue[tail] <- v
                tail <- tail + 1
    for v in 0..<n:
        if not seen[v]: return false
    true

def mmc_ratio_less(a_num: i64, a_den: i64, b_num: i64, b_den: i64) -> bool:
    a_num * b_den < b_num * a_den

def mmc_gcd(a_value: i64, b_value: i64) -> i64:
    a: mutable i64 = a_value
    b: mutable i64 = b_value
    while b != 0:
        remainder: i64 = a % b
        a <- b
        b <- remainder
    a

def mmc_compute(input: view[i64], length: usize) -> (i64, i64, i64):
    if length < 2 or length > MMC_MAX_INPUT: return (-1, 0, 1)
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 8 or m_value < 1 or m_value > 16: return (-1, 0, 1)
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if m > n * n or length != 2 + 3 * m: return (-1, 0, 1)

    edge_from: mutable usize[16] = zeroed
    edge_to: mutable usize[16] = zeroed
    edge_weight: mutable i64[16] = zeroed
    adjacency: mutable bool[64] = zeroed
    for edge in 0..<m:
        u_value: i64 = input[2 + 3 * edge]
        v_value: i64 = input[3 + 3 * edge]
        weight: i64 = input[4 + 3 * edge]
        if u_value < 0 or u_value >= n_value or v_value < 0 or v_value >= n_value or weight < -1000 or weight > 1000:
            return (-1, 0, 1)
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        edge_index: usize = u * 8 + v
        if adjacency[edge_index]: return (-1, 0, 1)
        adjacency[edge_index] <- true
        edge_from[edge] <- u
        edge_to[edge] <- v
        edge_weight[edge] <- weight
    if not mmc_all_reachable(n, adjacency[0:64], false) or not mmc_all_reachable(n, adjacency[0:64], true):
        return (-1, 0, 1)

    cost: mutable i64[72] = zeroed
    reachable: mutable bool[72] = zeroed
    reachable[0] <- true
    for k in 1..<(n + 1):
        for edge in 0..<m:
            u: usize = edge_from[edge]
            v: usize = edge_to[edge]
            previous: usize = (k - 1) * 8 + u
            current: usize = k * 8 + v
            if not reachable[previous]: continue
            candidate: i64 = cost[previous] + edge_weight[edge]
            if not reachable[current] or candidate < cost[current]:
                reachable[current] <- true
                cost[current] <- candidate

    have_answer: mutable bool = false
    answer_num: mutable i64 = 0
    answer_den: mutable i64 = 1
    for v in 0..<n:
        if not reachable[n * 8 + v]: continue
        have_local: mutable bool = false
        local_num: mutable i64 = 0
        local_den: mutable i64 = 1
        for k in 0..<n:
            slot: usize = k * 8 + v
            if not reachable[slot]: continue
            numerator: i64 = cost[n * 8 + v] - cost[slot]
            denominator: i64 = (n - k).i64()
            if not have_local or mmc_ratio_less(local_num, local_den, numerator, denominator):
                local_num <- numerator
                local_den <- denominator
                have_local <- true
        if have_local and (not have_answer or mmc_ratio_less(local_num, local_den, answer_num, answer_den)):
            answer_num <- local_num
            answer_den <- local_den
            have_answer <- true
    if not have_answer: return (-1, 0, 1)
    absolute_num: i64 = if answer_num < 0 then -answer_num else answer_num
    divisor: i64 = mmc_gcd(absolute_num, answer_den)
    (16, answer_num / divisor, answer_den / divisor)

export fn minimum_mean_cycle_karp(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MMC_MAX_INPUT: return -1
    result, numerator, denominator = mmc_compute(input[0:length], length)
    if result < 0: return result
    if output.is_null() or capacity < MMC_OUTPUT_BYTES: return -2
    staged: mutable u8[16] = zeroed
    staged_view: mutable view[u8] = staged[0:16]
    output_view: mutable view[u8] = output[0:capacity]
    mmc_store_i64_le(numerator, staged_view, 0)
    mmc_store_i64_le(denominator, staged_view, 8)
    for byte in 0..<16:
        output_view[byte] <- staged_view[byte]
    16
