# Simple iterative modular inverse for bounded coprime positive inputs.
def gcd_u64(left_input: u64, right_input: u64) -> u64:
    left: mutable u64 = left_input
    right: mutable u64 = right_input
    while right != 0:
        remainder: u64 = left % right
        left <- right
        right <- remainder
    left

def modular_inverse_simple_impl(x_input: i64, y_input: i64) -> i64:
    if x_input < 1 or x_input > 999 or y_input < 2 or y_input > 1000:
        return -1
    x: u64 = x_input.u64()
    y: u64 = y_input.u64()
    if gcd_u64(x, y) != 1:
        return -1
    # Coprimality guarantees a hit before iteration reaches x.
    auxiliary: mutable u64 = 0
    iteration: mutable u64 = 0
    while true:
        auxiliary <- y * iteration + 1
        iteration <- iteration + 1
        if auxiliary % x == 0:
            break
    (auxiliary / x).i64()

export fn modular_inverse_simple(x: i64, y: i64) -> i64 = modular_inverse_simple_impl
