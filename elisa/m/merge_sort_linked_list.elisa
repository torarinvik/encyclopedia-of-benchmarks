def merge_sort_linked_list_merge(values: mutable view[i32], links: mutable view[i32], left: i32, right: i32) -> i32:
    if left < 0: return right
    if right < 0: return left
    if values[left.usize()] <= values[right.usize()]:
        links[left.usize()] <- merge_sort_linked_list_merge(values, links, links[left.usize()], right)
        return left
    links[right.usize()] <- merge_sort_linked_list_merge(values, links, left, links[right.usize()])
    return right

def merge_sort_linked_list_sort(values: mutable view[i32], links: mutable view[i32], head: i32) -> i32:
    if head < 0: return head
    if links[head.usize()] < 0: return head
    slow: mutable i32 = head
    fast: mutable i32 = links[head.usize()]
    while fast >= 0:
        fast_next: i32 = links[fast.usize()]
        if fast_next < 0: break
        slow <- links[slow.usize()]
        fast <- links[fast_next.usize()]
    right_head: i32 = links[slow.usize()]
    links[slow.usize()] <- -1
    left: i32 = merge_sort_linked_list_sort(values, links, head)
    right: i32 = merge_sort_linked_list_sort(values, links, right_head)
    return merge_sort_linked_list_merge(values, links, left, right)

def merge_sort_linked_list_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 129: return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > 128: return -1
    count: usize = count_value.usize()
    if length != 1 + count: return -1
    values: mutable i32[128] = zeroed
    links: mutable i32[128] = zeroed
    i: usize = 0
    while i < count:
        value: i64 = input[1 + i]
        if value < -2147483648 or value > 2147483647: return -1
        values[i] <- value.i32()
        j: usize = 0
        while j < i:
            if values[j] == values[i]: return -1
            j <- j + 1
        if i + 1 < count: links[i] <- (i + 1).i32()
        else: links[i] <- -1
        i <- i + 1
    head: mutable i32 = -1
    if count > 0: head <- merge_sort_linked_list_sort(values[0:count], links[0:count], 0)
    required: usize = 4 * count
    if output.is_null() or output_capacity < required: return -2
    node: mutable i32 = head
    i <- 0
    while i < count:
        bits: mutable u32 = values[node.usize()].u32()
        byte: usize = 0
        while byte < 4:
            output[4 * i + byte] <- (bits & 255).u8()
            bits <- bits >> 8
            byte <- byte + 1
        node <- links[node.usize()]
        i <- i + 1
    return required.i64()

export fn merge_sort_linked_list(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = merge_sort_linked_list_impl
