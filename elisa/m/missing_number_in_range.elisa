# XOR a consecutive signed 32-bit range using portable 32-bit bit patterns.
def encode_i32(value: i64) -> u64:
    value.u64() & 0xffffffff

def missing_number_in_range_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 1024:
        return -2147483649
    low: mutable i64 = values[0]
    high: mutable i64 = values[0]
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < -2147483648 or value > 2147483647:
            return -2147483649
        if value < low:
            low <- value
        if value > high:
            high <- value
        index <- index + 1
    # Modular subtraction gives the exact nonnegative distance between the validated endpoints.
    low_bits: u64 = low.u64()
    if high.u64() - low_bits != length.u64():
        return -2147483649
    seen: mutable bool[1025] = zeroed
    actual: mutable u64 = 0
    index <- 0
    while index < length:
        value: i64 = values[index]
        slot: usize = (value.u64() - low_bits).usize()
        if seen[slot]:
            return -2147483649
        seen[slot] <- true
        actual <- actual ^ encode_i32(value)
        index <- index + 1
    expected: mutable u64 = 0
    index <- 0
    while index <= length:
        expected <- expected ^ ((low_bits + index.u64()) & 0xffffffff)
        index <- index + 1
    result: mutable i64 = (expected ^ actual).i64()
    if result > 2147483647:
        result <- result - 4294967296
    result

export fn missing_number_in_range(values: i64&, length: usize) -> i64 = missing_number_in_range_impl
