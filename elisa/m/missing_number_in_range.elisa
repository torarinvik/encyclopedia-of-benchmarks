# XOR a consecutive signed 32-bit range using portable zero-extended bit patterns.
const MAX_VALUES: usize = 1024
const INVALID_RESULT: i64 = -2147483649

def encode_i32(value: i64) -> u64:
    (value + 4294967296).u64() if value < 0 else value.u64()

def missing_number_in_range_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 2 or length > MAX_VALUES:
        return INVALID_RESULT
    low: mutable i64 = values[0]
    high: mutable i64 = values[0]
    i: mutable usize = 0
    while i < length:
        if values[i] < -2147483648 or values[i] > 2147483647:
            return INVALID_RESULT
        if values[i] < low:
            low <- values[i]
        if values[i] > high:
            high <- values[i]
        i <- i + 1
    if high - low != length.i64():
        return INVALID_RESULT
    seen: mutable bool[1025] = zeroed
    actual: mutable u64 = 0
    i <- 0
    while i < length:
        slot: usize = (values[i] - low).usize()
        if seen[slot]:
            return INVALID_RESULT
        seen[slot] <- true
        actual <- actual ^ encode_i32(values[i])
        i <- i + 1
    expected: mutable u64 = 0
    value: mutable i64 = low
    while value <= high:
        expected <- expected ^ encode_i32(value)
        value <- value + 1
    result: u64 = expected ^ actual
    result.i64() if result <= 2147483647 else result.i64() - 4294967296

export fn missing_number_in_range(values: i64&, length: usize) -> i64 = missing_number_in_range_impl
