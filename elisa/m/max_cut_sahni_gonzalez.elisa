const MAX_N: usize = 16
const MAX_M: usize = 120
const MAX_INPUT: usize = 362

def max_cut_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def max_cut_sahni_gonzalez(input: i64&, length: usize,
                           output: mutable u8&, capacity: usize) -> i64 @export("max_cut_sahni_gonzalez"):
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 120 or length != 2 + 3 * m64.usize(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    weights: mutable i64[16][16] = zeroed
    seen: mutable bool[16][16] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u64: i64 = input[2 + 3 * edge]
        v64: i64 = input[3 + 3 * edge]
        weight: i64 = input[4 + 3 * edge]
        if u64 < 0 or v64 <= u64 or v64 >= n64 or weight < 0 or weight > 10000: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if seen[u][v]: return -1
        seen[u][v] <- true
        weights[u][v] <- weight
        weights[v][u] <- weight
        edge <- edge + 1
    output_bytes: usize = 8 * (n + 1)
    if output.is_null() or capacity < output_bytes: return -2
    side: mutable i64[16] = zeroed
    vertex: mutable usize = 0
    while vertex < n:
        put_zero: mutable i64 = 0
        put_one: mutable i64 = 0
        prior: mutable usize = 0
        while prior < vertex:
            if side[prior] == 1: put_zero <- put_zero + weights[prior][vertex]
            else: put_one <- put_one + weights[prior][vertex]
            prior <- prior + 1
        if put_one > put_zero: side[vertex] <- 1
        vertex <- vertex + 1
    cut: mutable i64 = 0
    u: mutable usize = 0
    while u < n:
        v: mutable usize = u + 1
        while v < n:
            if side[u] != side[v]: cut <- cut + weights[u][v]
            v <- v + 1
        u <- u + 1
    max_cut_store_i64_le(cut, output, 0)
    vertex <- 0
    while vertex < n:
        max_cut_store_i64_le(side[vertex], output, 8 * (vertex + 1))
        vertex <- vertex + 1
    output_bytes.i64()
