const MAX_OPERATIONS: usize = 128
const MAX_CAPACITY: usize = 16
const MAX_INPUT_LENGTH: usize = 387
const FNV_OFFSET: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211

def mrucache_hash_byte(hash: u64, byte: u64) -> u64:
    (hash ^ byte) * FNV_PRIME

def mrucache_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    capacity64: i64 = input[0]
    operation_count64: i64 = input[1]
    if capacity64 < 1 or capacity64 > MAX_CAPACITY.i64() or operation_count64 < 0 or operation_count64 > MAX_OPERATIONS.i64():
        return -1
    if length != (2 + 3 * operation_count64).usize():
        return -1

    capacity: usize = capacity64.usize()
    operation_count: usize = operation_count64.usize()
    keys: mutable i32[MAX_CAPACITY] = zeroed
    values: mutable i32[MAX_CAPACITY] = zeroed
    responses: mutable i32[MAX_OPERATIONS] = zeroed
    cache_count: mutable usize = 0
    response_count: mutable usize = 0
    step: mutable usize = 0

    while step < operation_count:
        operation: i64 = input[2 + 3 * step]
        key64: i64 = input[3 + 3 * step]
        value64: i64 = input[4 + 3 * step]
        if operation < 0 or operation > 1 or key64 < -2147483648 or key64 > 2147483647 or value64 < -2147483648 or value64 > 2147483647:
            return -1
        key: i32 = key64.i32()
        value: i32 = value64.i32()
        position: mutable usize = 0
        while position < cache_count:
            if keys[position] == key:
                break
            position <- position + 1

        if operation == 0:
            if value < 0 or value > 1000000:
                return -1
            if position < cache_count:
                index: mutable usize = position
                while index + 1 < cache_count:
                    keys[index] <- keys[index + 1]
                    values[index] <- values[index + 1]
                    index <- index + 1
                keys[cache_count - 1] <- key
                values[cache_count - 1] <- value
            else:
                if cache_count == capacity:
                    cache_count <- cache_count - 1
                keys[cache_count] <- key
                values[cache_count] <- value
                cache_count <- cache_count + 1
        else if position == cache_count:
            responses[response_count] <- -1
            response_count <- response_count + 1
        else:
            response: i32 = values[position]
            index: mutable usize = position
            while index + 1 < cache_count:
                keys[index] <- keys[index + 1]
                values[index] <- values[index + 1]
                index <- index + 1
            keys[cache_count - 1] <- key
            values[cache_count - 1] <- response
            responses[response_count] <- response
            response_count <- response_count + 1
        step <- step + 1

    hash: mutable u64 = FNV_OFFSET
    hash <- mrucache_hash_byte(hash, (response_count & 255).u64())
    hash <- mrucache_hash_byte(hash, ((response_count >> 8) & 255).u64())
    index: mutable usize = 0
    while index < response_count:
        bits: u32 = responses[index].u32()
        shift: mutable usize = 0
        while shift < 32:
            hash <- mrucache_hash_byte(hash, ((bits >> shift) & 255).u64())
            shift <- shift + 8
        index <- index + 1
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn mrucache(input: i64&, length: usize) -> i64 = mrucache_impl
