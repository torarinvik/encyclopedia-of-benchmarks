def mwm_query_before(a_left: i64, a_right: i64, a_time: i64, a_index: i64,
                     lefts: view[i64], rights: view[i64], times: view[i64],
                     indices: view[i64], b_index: usize, block_size: i64) -> bool:
    b_left: i64 = lefts[b_index]
    b_right: i64 = rights[b_index]
    b_time: i64 = times[b_index]
    b_original_index: i64 = indices[b_index]
    a_left_block: i64 = a_left / block_size
    b_left_block: i64 = b_left / block_size
    if a_left_block != b_left_block:
        return a_left_block < b_left_block
    a_right_block: i64 = a_right / block_size
    b_right_block: i64 = b_right / block_size
    if a_right_block != b_right_block:
        if a_left_block % 2 != 0:
            return a_right_block > b_right_block
        return a_right_block < b_right_block
    if a_time != b_time:
        if (a_left_block + a_right_block) % 2 != 0:
            return a_time > b_time
        return a_time < b_time
    if a_right != b_right:
        if a_left_block % 2 != 0:
            return a_right > b_right
        return a_right < b_right
    a_index < b_original_index

def mwm_apply_update(position: i64, old_value: i64, new_value: i64, forward: bool,
                     values: mutable view[i64], window_left: i64, window_right: i64,
                     frequency: mutable view[i64], distinct: mutable view[i64]) -> void:
    from_value: i64 = old_value
    to_value: i64 = new_value
    if not forward:
        from_value <- new_value
        to_value <- old_value
    if window_left <= position and position <= window_right:
        frequency[from_value.usize()] <- frequency[from_value.usize()] - 1
        if frequency[from_value.usize()] == 0:
            distinct[0] <- distinct[0] - 1
        if frequency[to_value.usize()] == 0:
            distinct[0] <- distinct[0] + 1
        frequency[to_value.usize()] <- frequency[to_value.usize()] + 1
    values[position.usize()] <- to_value

def mo_with_modifications_impl(input: view[i64], length: usize) -> i64:
    if length < 2 or length > 258:
        return -1
    raw_n: i64 = input[0]
    raw_q: i64 = input[1]
    if raw_n < 1 or raw_n > 64 or raw_q < 0 or raw_q > 64:
        return -1
    n: usize = raw_n.usize()
    operation_count: usize = raw_q.usize()
    if length != 2 + n + 3 * operation_count:
        return -1

    values: mutable i64[64] = zeroed
    simulated: mutable i64[64] = zeroed
    i: mutable usize = 0
    while i < n:
        value: i64 = input[2 + i]
        if value < 0 or value > 15:
            return -1
        values[i] <- value
        simulated[i] <- value
        i <- i + 1

    update_positions: mutable i64[64] = zeroed
    update_old_values: mutable i64[64] = zeroed
    update_new_values: mutable i64[64] = zeroed
    query_lefts: mutable i64[64] = zeroed
    query_rights: mutable i64[64] = zeroed
    query_times: mutable i64[64] = zeroed
    query_indices: mutable i64[64] = zeroed
    update_count: mutable usize = 0
    query_count: mutable usize = 0
    cursor: mutable usize = 2 + n
    i <- 0
    while i < operation_count:
        operation: i64 = input[cursor]
        first: i64 = input[cursor + 1]
        second: i64 = input[cursor + 2]
        cursor <- cursor + 3
        if operation == 0:
            if first < 0 or first >= raw_n or second < 0 or second > 15:
                return -1
            position: usize = first.usize()
            update_positions[update_count] <- first
            update_old_values[update_count] <- simulated[position]
            update_new_values[update_count] <- second
            simulated[position] <- second
            update_count <- update_count + 1
        else if operation == 1:
            if first < 0 or second < first or second >= raw_n:
                return -1
            query_lefts[query_count] <- first
            query_rights[query_count] <- second
            query_times[query_count] <- update_count.i64()
            query_indices[query_count] <- query_count.i64()
            query_count <- query_count + 1
        else:
            return -1
        i <- i + 1

    block_size: mutable i64 = 1
    while block_size * block_size * block_size < raw_n * raw_n:
        block_size <- block_size + 1
    i <- 1
    while i < query_count:
        item_left: i64 = query_lefts[i]
        item_right: i64 = query_rights[i]
        item_time: i64 = query_times[i]
        item_index: i64 = query_indices[i]
        j: mutable usize = i
        while j > 0 and mwm_query_before(item_left, item_right, item_time, item_index,
                                          query_lefts[0:64], query_rights[0:64],
                                          query_times[0:64], query_indices[0:64],
                                          j - 1, block_size):
            query_lefts[j] <- query_lefts[j - 1]
            query_rights[j] <- query_rights[j - 1]
            query_times[j] <- query_times[j - 1]
            query_indices[j] <- query_indices[j - 1]
            j <- j - 1
        query_lefts[j] <- item_left
        query_rights[j] <- item_right
        query_times[j] <- item_time
        query_indices[j] <- item_index
        i <- i + 1

    answers: mutable i64[64] = zeroed
    frequency: mutable i64[16] = zeroed
    distinct: mutable i64[1] = zeroed
    current_left: mutable i64 = 0
    current_right: mutable i64 = -1
    current_time: mutable i64 = 0
    i <- 0
    while i < query_count:
        target_left: i64 = query_lefts[i]
        target_right: i64 = query_rights[i]
        target_time: i64 = query_times[i]
        while current_time < target_time:
            update_index: usize = current_time.usize()
            update_position: i64 = update_positions[update_index]
            update_old: i64 = update_old_values[update_index]
            update_new: i64 = update_new_values[update_index]
            mwm_apply_update(update_position, update_old, update_new, true,
                             values[0:64], current_left, current_right,
                             frequency[0:16], distinct[0:1])
            current_time <- current_time + 1
        while current_time > target_time:
            current_time <- current_time - 1
            update_index: usize = current_time.usize()
            update_position: i64 = update_positions[update_index]
            update_old: i64 = update_old_values[update_index]
            update_new: i64 = update_new_values[update_index]
            mwm_apply_update(update_position, update_old, update_new, false,
                             values[0:64], current_left, current_right,
                             frequency[0:16], distinct[0:1])
        while current_left > target_left:
            current_left <- current_left - 1
            value: usize = values[current_left.usize()].usize()
            if frequency[value] == 0:
                distinct[0] <- distinct[0] + 1
            frequency[value] <- frequency[value] + 1
        while current_right < target_right:
            current_right <- current_right + 1
            value: usize = values[current_right.usize()].usize()
            if frequency[value] == 0:
                distinct[0] <- distinct[0] + 1
            frequency[value] <- frequency[value] + 1
        while current_left < target_left:
            value: usize = values[current_left.usize()].usize()
            frequency[value] <- frequency[value] - 1
            if frequency[value] == 0:
                distinct[0] <- distinct[0] - 1
            current_left <- current_left + 1
        while current_right > target_right:
            value: usize = values[current_right.usize()].usize()
            frequency[value] <- frequency[value] - 1
            if frequency[value] == 0:
                distinct[0] <- distinct[0] - 1
            current_right <- current_right - 1
        answer_index: usize = query_indices[i].usize()
        answers[answer_index] <- distinct[0]
        i <- i + 1

    checksum: mutable i64 = 0
    i <- 0
    while i < query_count:
        checksum <- checksum + (i.i64() + 1) * (answers[i] + 1)
        i <- i + 1
    checksum

export fn mo_with_modifications(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > 258:
        return -1
    input_view: view[i64] = input[0:length]
    mo_with_modifications_impl(input_view, length)
