const MAX_BLOCK_COUNT: usize = 16
const MAX_PROCESS_COUNT: usize = 32
const MAX_INPUT_LENGTH: usize = 52
const MAX_OUTPUT_BYTES: usize = 256
const NO_ALLOCATION: i64 = -255

def memory_management_algorithms_put_i64_le(output: mutable u8&, offset: usize, value: i64):
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def memory_management_algorithms_impl(input: i64&, input_length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or input_length < 3 or input_length > MAX_INPUT_LENGTH: return -1
    policy: i64 = input[0]
    if policy < 0 or policy > 3 or input[1] < 1 or input[1] > MAX_BLOCK_COUNT.i64() or
        input[2] < 0 or input[2] > MAX_PROCESS_COUNT.i64(): return -1
    block_count: usize = input[1].usize()
    process_count: usize = input[2].usize()
    if input_length != 3 + block_count + process_count: return -1

    blocks: mutable i64[MAX_BLOCK_COUNT] = zeroed
    processes: mutable i64[MAX_PROCESS_COUNT] = zeroed
    index: mutable usize = 0
    while index < block_count:
        size: i64 = input[3 + index]
        if size < 1 or size > 10000: return -1
        blocks[index] <- size
        index <- index + 1
    index <- 0
    while index < process_count:
        size: i64 = input[3 + block_count + index]
        if size < 1 or size > 10000: return -1
        processes[index] <- size
        index <- index + 1

    allocations: mutable i64[MAX_PROCESS_COUNT] = zeroed
    next_fit_counter: mutable i64 = 0
    process_index: mutable usize = 0
    while process_index < process_count:
        process: i64 = processes[process_index]
        selected: mutable i64 = NO_ALLOCATION
        if policy == 0:
            index <- 0
            while index < block_count:
                if blocks[index] >= process:
                    selected <- index.i64()
                    break
                index <- index + 1
        else if policy == 1:
            min_diff: mutable i64 = blocks[0]
            index <- 1
            while index < block_count:
                if blocks[index] > min_diff: min_diff <- blocks[index]
                index <- index + 1
            index <- 0
            while index < block_count:
                difference: i64 = blocks[index] - process
                if difference < min_diff and difference >= 0:
                    min_diff <- difference
                    selected <- index.i64()
                index <- index + 1
        else if policy == 2:
            best: mutable usize = 0
            index <- 1
            while index < block_count:
                if blocks[index] > blocks[best]: best <- index
                index <- index + 1
            if blocks[best] >= process: selected <- best.i64()
        else:
            found: mutable bool = false
            offset: mutable usize = 0
            while offset < block_count:
                if next_fit_counter + offset.i64() >= block_count.i64():
                    next_fit_counter <- -offset.i64()
                index <- (offset.i64() + next_fit_counter).usize()
                if blocks[index] >= process:
                    next_fit_counter <- next_fit_counter + offset.i64()
                    selected <- next_fit_counter
                    found <- true
                    break
                offset <- offset + 1
            if not found: next_fit_counter <- next_fit_counter + block_count.i64()
        allocations[process_index] <- selected
        if selected != NO_ALLOCATION:
            blocks[selected.usize()] <- blocks[selected.usize()] - process
        process_index <- process_index + 1

    output_bytes: usize = process_count * 8
    if output_bytes > MAX_OUTPUT_BYTES: return -1
    if output.is_null() or capacity < output_bytes: return -2
    index <- 0
    while index < process_count:
        memory_management_algorithms_put_i64_le(output, index * 8, allocations[index])
        index <- index + 1
    output_bytes.i64()

export fn memory_management_algorithms(input: i64&, input_length: usize,
        output: mutable u8&, capacity: usize) -> i64 = memory_management_algorithms_impl
