const MAX_LENGTH: usize = 1024

def maximum_subarray_allow_empty_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH or (length > 0 and values.is_null()):
        return -1
    index: mutable usize = 0
    while index < length:
        if values[index] < -2147483648 or values[index] > 2147483647:
            return -1
        index <- index + 1
    current: mutable i64 = 0
    best: mutable i64 = 0
    index <- 0
    while index < length:
        current <- current + values[index]
        if current < 0:
            current <- 0
        if current > best:
            best <- current
        index <- index + 1
    best

export fn maximum_subarray_allow_empty(values: i64&, length: usize) -> i64 = maximum_subarray_allow_empty_impl
