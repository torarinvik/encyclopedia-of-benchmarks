extern sqrt(value: f64) -> f64

const MAX_PHYSICAL: i64 = 1000000000000000
const MAX_FLUX_RATE: i64 = 1000000000000000000
const MIN_CONSTANT: i64 = 1000000
const MAX_CONSTANT: i64 = 1000000000000000
const EPSILON_DEFAULT: f64 = 8.8541878128e-12
const PI_VALUE: f64 = 3.14159265358979323846264338327950288
const MU_DEFAULT: f64 = 4.0 * PI_VALUE * 1e-7
const INVALID_RESULT: f64 = -1e300

def maxwells_in_range(value: i64, limit: i64) -> bool:
    value >= -limit and value <= limit

def maxwells_decode_constant(raw: i64, fallback: f64, value: mutable f64&) -> bool:
    if raw == 0:
        value <- fallback
        return true
    if raw < MIN_CONSTANT or raw > MAX_CONSTANT:
        return false
    value <- raw.f64() / 1e18
    true

def maxwells_law_result(actual: f64, expected: f64) -> f64:
    difference: f64 = actual - expected
    if difference < 0.0: difference <- -difference
    tolerance: f64 = if expected != 0.0: 0.01 * (if expected < 0.0: -expected else: expected) else: 1e-10
    if difference <= tolerance: 1.0 else: 0.0

def maxwells_equations_impl(input: i64&, length: usize) -> f64:
    if input == null or length < 1 or length > 7:
        return INVALID_RESULT
    operation: i64 = input[0]
    if operation == 0:
        if length != 5: return INVALID_RESULT
        field: i64 = input[1]; area: i64 = input[2]; charge: i64 = input[3]; epsilon_raw: i64 = input[4]
        if not maxwells_in_range(field, MAX_PHYSICAL) or area < 0 or area > MAX_PHYSICAL or not maxwells_in_range(charge, MAX_PHYSICAL): return INVALID_RESULT
        epsilon: mutable f64 = 0.0
        if not maxwells_decode_constant(epsilon_raw, EPSILON_DEFAULT, &epsilon): return INVALID_RESULT
        electric_flux: f64 = (field.f64() / 1e12) * (area.f64() / 1e12)
        expected_flux: f64 = (charge.f64() / 1e12) / epsilon
        return maxwells_law_result(electric_flux, expected_flux)
    if operation == 1:
        if length != 3 or not maxwells_in_range(input[1], MAX_PHYSICAL) or not maxwells_in_range(input[2], MAX_PHYSICAL): return INVALID_RESULT
        circulation: f64 = input[1].f64() / 1e12
        expected: f64 = -(input[2].f64() / 1e12)
        return maxwells_law_result(circulation, expected)
    if operation == 2:
        if length != 6 or not maxwells_in_range(input[1], MAX_PHYSICAL) or not maxwells_in_range(input[2], MAX_PHYSICAL) or not maxwells_in_range(input[3], MAX_FLUX_RATE): return INVALID_RESULT
        mu: mutable f64 = 0.0; epsilon: mutable f64 = 0.0
        if not maxwells_decode_constant(input[4], MU_DEFAULT, &mu) or not maxwells_decode_constant(input[5], EPSILON_DEFAULT, &epsilon): return INVALID_RESULT
        displacement_current: f64 = epsilon * (input[3].f64() / 1e6)
        total_current: f64 = (input[2].f64() / 1e12) + displacement_current
        expected: f64 = mu * total_current
        return maxwells_law_result(input[1].f64() / 1e12, expected)
    if operation == 3 or operation == 4:
        if length != 3: return INVALID_RESULT
        mu: mutable f64 = 0.0; epsilon: mutable f64 = 0.0
        if not maxwells_decode_constant(input[1], MU_DEFAULT, &mu) or not maxwells_decode_constant(input[2], EPSILON_DEFAULT, &epsilon): return INVALID_RESULT
        if operation == 3: return 1.0 / sqrt(mu * epsilon)
        return sqrt(mu / epsilon)
    if operation == 5:
        if length != 4 or not maxwells_in_range(input[1], MAX_PHYSICAL) or not maxwells_in_range(input[2], MAX_PHYSICAL): return INVALID_RESULT
        mu: mutable f64 = 0.0
        if not maxwells_decode_constant(input[3], MU_DEFAULT, &mu): return INVALID_RESULT
        return ((input[1].f64() / 1e12) * (input[2].f64() / 1e12)) / mu
    if operation == 6:
        if length != 5 or not maxwells_in_range(input[1], MAX_PHYSICAL) or not maxwells_in_range(input[2], MAX_PHYSICAL): return INVALID_RESULT
        epsilon: mutable f64 = 0.0; mu: mutable f64 = 0.0
        if not maxwells_decode_constant(input[3], EPSILON_DEFAULT, &epsilon) or not maxwells_decode_constant(input[4], MU_DEFAULT, &mu): return INVALID_RESULT
        electric_field: f64 = input[1].f64() / 1e12
        magnetic_field: f64 = input[2].f64() / 1e12
        electric_energy: f64 = 0.5 * epsilon * (electric_field * electric_field)
        magnetic_energy: f64 = 0.5 * (magnetic_field * magnetic_field) / mu
        return electric_energy + magnetic_energy
    INVALID_RESULT

export fn maxwells_equations(input: i64&, length: usize) -> f64 = maxwells_equations_impl
