# Recursively carry the minimum and maximum ancestor values down each path.
def max_ancestor_diff_visit(nodes: view[i64], node_count: usize, node: i64,
        path_min: i64, path_max: i64) -> i64:
    if node == -1:
        return 0
    if node < 0 or node.u64() >= node_count.u64():
        return -1
    index: usize = node.usize()
    value: i64 = nodes[3 * index]
    if value < -100000 or value > 100000:
        return -1
    left: i64 = nodes[3 * index + 1]
    right: i64 = nodes[3 * index + 2]
    invalid_left: bool = left < -1 or (left >= 0 and left.u64() >= node_count.u64())
    invalid_right: bool = right < -1 or (right >= 0 and right.u64() >= node_count.u64())
    if invalid_left or invalid_right:
        return -1
    low_difference: i64 = path_min - value if path_min >= value else value - path_min
    high_difference: i64 = path_max - value if path_max >= value else value - path_max
    best: mutable i64 = low_difference
    best <- high_difference if high_difference > best
    low: i64 = value if value < path_min else path_min
    high: i64 = value if value > path_max else path_max
    left_best: i64 = max_ancestor_diff_visit(nodes, node_count, left, low, high)
    if left_best < 0:
        return -1
    right_best: i64 = max_ancestor_diff_visit(nodes, node_count, right, low, high)
    if right_best < 0:
        return -1
    best <- left_best if left_best > best
    best <- right_best if right_best > best
    best

def max_ancestor_diff_impl(nodes: i64&, node_count: usize, root_index: i64) -> i64:
    if node_count == 0 or node_count > 1023 or root_index < 0 or root_index.u64() >= node_count.u64():
        return -1
    root_value: i64 = nodes[3 * root_index.usize()]
    if root_value < -100000 or root_value > 100000:
        return -1
    max_ancestor_diff_visit(nodes[0:node_count * 3], node_count, root_index, root_value, root_value)

export fn max_ancestor_diff(nodes: i64&, node_count: usize, root_index: i64) -> i64 = max_ancestor_diff_impl
