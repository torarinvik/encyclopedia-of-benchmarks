def maximum_frequency_stack_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def maximum_frequency_stack_impl(input: view[i64], output: mutable view[u8],
        output_is_null: bool) -> i64:
    if input.length < 1 or input.length > 130: return -1
    words: view[i64] = input
    raw_count: i64 = words[0]
    if raw_count < 0 or raw_count > 64 or length != 1 + 2 * raw_count.usize(): return -1
    frequency: mutable i32[17] = zeroed
    bucket_top: mutable i32[65] = zeroed
    node_value: mutable i64[64] = zeroed
    node_next: mutable i32[64] = zeroed
    popped: mutable i64[64] = zeroed
    frequency_view: mutable view[i32] = frequency[0:17]
    bucket_view: mutable view[i32] = bucket_top[0:65]
    value_view: mutable view[i64] = node_value[0:64]
    next_view: mutable view[i32] = node_next[0:64]
    for index in 0..<65: bucket_view[index] <- -1
    nodes: mutable usize = 0
    pop_count: mutable usize = 0
    position: mutable usize = 1
    maximum_frequency: mutable usize = 0
    while position < length:
        opcode: i64 = words[position]
        argument: i64 = words[position + 1]
        position <- position + 2
        if opcode == 0:
            if argument < -8 or argument > 8: return -1
            value_index: usize = (argument + 8).usize()
            frequency_view[value_index] <- frequency_view[value_index] + 1
            level: usize = frequency_view[value_index].usize()
            value_view[nodes] <- argument
            next_view[nodes] <- bucket_view[level]
            bucket_view[level] <- nodes.i32()
            nodes <- nodes + 1
            if level > maximum_frequency: maximum_frequency <- level
        else if opcode == 1 and argument == 0:
            if maximum_frequency == 0 or bucket_view[maximum_frequency] < 0: return -1
            node: usize = bucket_view[maximum_frequency].usize()
            bucket_view[maximum_frequency] <- next_view[node]
            value: i64 = value_view[node]
            popped[pop_count] <- value
            pop_count <- pop_count + 1
            value_index: usize = (value + 8).usize()
            frequency_view[value_index] <- frequency_view[value_index] - 1
            if bucket_view[maximum_frequency] < 0: maximum_frequency <- maximum_frequency - 1
        else: return -1
    needed: usize = pop_count * 8
    if needed > 0 and (output_is_null or output.length < needed): return -2
    if needed > 0:
        for index in 0..<pop_count: maximum_frequency_stack_store(popped[index], output, index * 8)
    needed.i64()

export fn maximum_frequency_stack(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > 130:
        return -1
    input_view: view[i64] = input[0:length]
    if output == null:
        empty_storage: mutable u8[1] = zeroed
        empty_view: mutable view[u8] = empty_storage[0:0]
        return maximum_frequency_stack_impl(input_view, empty_view, true)
    output_view: mutable view[u8] = output[0:capacity]
    maximum_frequency_stack_impl(input_view, output_view, false)
