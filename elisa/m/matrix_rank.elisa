def matrix_rank_is_zero(value: f64) -> bool:
    magnitude: f64 = if value < 0.0: -value else value
    magnitude < 1e-10

def matrix_rank_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 2 or length > 66:
        return -1
    rows_value: i64 = values[0]
    cols_value: i64 = values[1]
    if rows_value < 1 or rows_value > 8 or cols_value < 1 or cols_value > 8:
        return -1

    rows: usize = rows_value.usize()
    cols: usize = cols_value.usize()
    cells: usize = rows * cols
    if length != 2 + cells:
        return -1

    matrix: mutable f64[64] = zeroed
    row_marked: mutable bool[8] = zeroed
    for index in 0..<cells:
        cell: i64 = values[2 + index]
        if cell != 0 and cell != 1:
            return -1
        matrix[index] <- cell.f64()

    rank: mutable i64 = 0
    for col in 0..<cols:
        pivot_row: mutable usize = rows
        for row in 0..<rows:
            if not row_marked[row] and not matrix_rank_is_zero(matrix[row * cols + col]):
                pivot_row <- row
                break
        if pivot_row == rows:
            continue

        rank <- rank + 1
        row_marked[pivot_row] <- true
        pivot_value: f64 = matrix[pivot_row * cols + col]
        for next_col in (col + 1)..<cols:
            matrix[pivot_row * cols + next_col] <- matrix[pivot_row * cols + next_col] / pivot_value
        for other_row in 0..<rows:
            if other_row == pivot_row:
                continue
            factor: f64 = matrix[other_row * cols + col]
            if not matrix_rank_is_zero(factor):
                for next_col in (col + 1)..<cols:
                    matrix[other_row * cols + next_col] <-
                        matrix[other_row * cols + next_col] - matrix[pivot_row * cols + next_col] * factor
    rank

export fn matrix_rank(values: i64&, length: usize) -> i64 = matrix_rank_impl
