const MAX_LENGTH: usize = 100000
const MAX_VALUE: i64 = 100000
const MAX_I64: i64 = 9223372036854775807

def minimum_average_difference_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > MAX_LENGTH:
        return -1
    valid_values: bool =
        while index < length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = values[index]
            if value < 0 or value > MAX_VALUE:
                break false
            index <- index + 1
            valid
    if not valid_values:
        return -1
    total_sum: i64 =
        while index < length |index: mutable usize = 0, total: mutable i64 = 0| -> total:
            total <- total + values[index]
            index <- index + 1
            total
    best_index: i64 =
        while index < length |index: mutable usize = 0, prefix_sum: mutable i64 = 0, best_difference: mutable i64 = MAX_I64, best_index: mutable i64 = 0| -> best_index:
            prefix_sum <- prefix_sum + values[index]
            left_average: i64 = prefix_sum / (index + 1).i64()
            suffix_length: usize = length - index - 1
            right_average: mutable i64 = 0
            if suffix_length > 0:
                right_average <- (total_sum - prefix_sum) / suffix_length.i64()
            difference: mutable i64 = left_average - right_average
            if difference < 0:
                difference <- -difference
            if difference < best_difference:
                best_difference <- difference
                best_index <- index.i64()
            index <- index + 1
            best_index
    best_index

export fn minimum_average_difference(values: i64&, length: usize) -> i64 = minimum_average_difference_impl
