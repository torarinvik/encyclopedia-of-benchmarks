const MAX_ARRAYS: usize = 16
const MAX_TOTAL_VALUES: usize = 128
const MAX_PARSEABLE_LENGTH: usize = 146
const MIN_VALUE: i64 = -1_000_000
const MAX_VALUE: i64 = 1_000_000
const CHECKSUM_OFFSET: i64 = 1_000_001

struct MergeKHeapNode:
    value: i64
    array_index: usize
    element_index: usize

def merge_ksorted_node_less(left: MergeKHeapNode, right: MergeKHeapNode) -> bool:
    if left.value != right.value: return left.value < right.value
    if left.array_index != right.array_index: return left.array_index < right.array_index
    left.element_index < right.element_index

def merge_ksorted_heap_push(heap: mutable MergeKHeapNode[MAX_ARRAYS], size: mutable usize&, node: MergeKHeapNode) -> void:
    index: mutable usize = size
    size <- size + 1
    while index > 0:
        parent: usize = (index - 1) / 2
        if not merge_ksorted_node_less(node, heap[parent]): break
        heap[index] <- heap[parent]
        index <- parent
    heap[index] <- node

def merge_ksorted_heap_pop(heap: mutable MergeKHeapNode[MAX_ARRAYS], size: mutable usize&) -> MergeKHeapNode:
    result: MergeKHeapNode = heap[0]
    size <- size - 1
    last: MergeKHeapNode = heap[size]
    if size > 0:
        index: mutable usize = 0
        while index < size / 2:
            child: mutable usize = 2 * index + 1
            if child + 1 < size and merge_ksorted_node_less(heap[child + 1], heap[child]):
                child <- child + 1
            if not merge_ksorted_node_less(heap[child], last): break
            heap[index] <- heap[child]
            index <- child
        heap[index] <- last
    result

def merge_ksorted_arrays_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_PARSEABLE_LENGTH: return -1
    if input[0] < 1 or input[0] > MAX_ARRAYS.i64(): return -1
    array_count: usize = input[0].usize()
    starts: mutable usize[MAX_ARRAYS] = zeroed
    lengths: mutable usize[MAX_ARRAYS] = zeroed
    position: mutable usize = 1
    total_values: mutable usize = 0
    array_index: mutable usize = 0
    while array_index < array_count:
        if position >= length: return -1
        declared: i64 = input[position]
        position <- position + 1
        if declared < 0 or declared > (MAX_TOTAL_VALUES - total_values).i64(): return -1
        array_length: usize = declared.usize()
        if array_length > length - position: return -1
        starts[array_index] <- position
        lengths[array_index] <- array_length
        index: mutable usize = 0
        while index < array_length:
            value: i64 = input[position + index]
            if value < MIN_VALUE or value > MAX_VALUE or
               (index > 0 and input[position + index - 1] > value): return -1
            index <- index + 1
        position <- position + array_length
        total_values <- total_values + array_length
        array_index <- array_index + 1
    if position != length: return -1

    heap: mutable MergeKHeapNode[MAX_ARRAYS]
    heap_size: mutable usize = 0
    array_index <- 0
    while array_index < array_count:
        if lengths[array_index] > 0:
            node: MergeKHeapNode
            node.value <- input[starts[array_index]]
            node.array_index <- array_index
            node.element_index <- 0
            merge_ksorted_heap_push(heap, heap_size, node)
        array_index <- array_index + 1
    checksum: mutable i64 = 0
    merged_index: mutable i64 = 0
    while heap_size > 0:
        node: MergeKHeapNode = merge_ksorted_heap_pop(heap, heap_size)
        checksum <- checksum + (merged_index + 1) * (node.value + CHECKSUM_OFFSET)
        merged_index <- merged_index + 1
        next_index: usize = node.element_index + 1
        if next_index < lengths[node.array_index]:
            next_node: MergeKHeapNode
            next_node.value <- input[starts[node.array_index] + next_index]
            next_node.array_index <- node.array_index
            next_node.element_index <- next_index
            merge_ksorted_heap_push(heap, heap_size, next_node)
    checksum

export fn merge_ksorted_arrays(input: i64&, length: usize) -> i64 = merge_ksorted_arrays_impl
