const MAX_VALID_INPUT_LENGTH: usize = 64
const MAX_TOTAL_SUM: usize = 4096
const MAX_TOTAL_SUM_I64: i64 = 4096

def minimum_sum_partition_impl(input: i64&, length: usize) -> i64:
    if length > MAX_VALID_INPUT_LENGTH or (input == null and length != 0):
        return -1

    total: mutable i64 = 0
    for index in 0..<length |input, total|:
        value: i64 = input[index]
        if value < 0 or value > MAX_TOTAL_SUM_I64 or total > MAX_TOTAL_SUM_I64 - value:
            return -1
        total <- total + value

    target: usize = (total / 2).usize()
    reachable: mutable u8[MAX_TOTAL_SUM / 2 + 1] = zeroed
    reachable[0] <- 1
    # Zero and above-target items cannot add a reachable sum below the target.
    for index in 0..<length |input, target, reachable|:
        value: usize = input[index].usize()
        if value == 0 or value > target:
            continue
        sum: mutable usize = target
        while sum >= value |sum, value, reachable|:
            if reachable[sum - value] != 0:
                reachable[sum] <- 1
            sum <- sum - 1

    # Only the final reachable set determines the closest partition.
    closest: mutable usize = target
    while closest > 0 and reachable[closest] == 0:
        closest <- closest - 1
    return total - 2 * closest.i64()

export fn minimum_sum_partition(input: i64&, length: usize) -> i64 = minimum_sum_partition_impl
