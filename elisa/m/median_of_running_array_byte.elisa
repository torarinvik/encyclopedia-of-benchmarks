const MAX_COUNT: usize = 64
const MAX_INPUT_LENGTH: usize = 66

def push_max(heap: mutable i64&, count: mutable usize&, value: i64) -> void:
    position: mutable usize = count
    count <- count + 1
    while position > 0 and heap[(position - 1) / 2] < value:
        parent: usize = (position - 1) / 2
        heap[position] <- heap[parent]
        position <- parent
    heap[position] <- value

def pop_max(heap: mutable i64&, count: mutable usize&) -> i64:
    result: i64 = heap[0]
    count <- count - 1
    value: i64 = heap[count]
    if count == 0:
        return result
    position: mutable usize = 0
    while 2 * position + 1 < count:
        child: mutable usize = 2 * position + 1
        if child + 1 < count and heap[child + 1] > heap[child]: child <- child + 1
        if heap[child] <= value: break
        heap[position] <- heap[child]
        position <- child
    heap[position] <- value
    result

def push_min(heap: mutable i64&, count: mutable usize&, value: i64) -> void:
    position: mutable usize = count
    count <- count + 1
    while position > 0 and heap[(position - 1) / 2] > value:
        parent: usize = (position - 1) / 2
        heap[position] <- heap[parent]
        position <- parent
    heap[position] <- value

def pop_min(heap: mutable i64&, count: mutable usize&) -> i64:
    result: i64 = heap[0]
    count <- count - 1
    value: i64 = heap[count]
    if count == 0:
        return result
    position: mutable usize = 0
    while 2 * position + 1 < count:
        child: mutable usize = 2 * position + 1
        if child + 1 < count and heap[child + 1] < heap[child]: child <- child + 1
        if heap[child] >= value: break
        heap[position] <- heap[child]
        position <- child
    heap[position] <- value
    result

def median_of_running_array_byte_impl(input: i32&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    count_value: i64 = input[0].i64()
    if count_value < 1 or count_value > 64 or length != 1 + count_value.usize():
        return -1
    count: usize = count_value.usize()
    lower: mutable i64[64] = zeroed
    upper: mutable i64[64] = zeroed
    medians: mutable u8[64] = zeroed
    lower_count: mutable usize = 0
    upper_count: mutable usize = 0
    for i in 0..<count:
        sample: i64 = input[i + 1].i64()
        if sample < -128 or sample > 127:
            return -1
        if upper_count > 0 and sample < upper[0]:
            push_max(&lower[0], &lower_count, sample)
        else:
            push_min(&upper[0], &upper_count, sample)
        if lower_count > upper_count + 1:
            push_min(&upper[0], &upper_count, pop_max(&lower[0], &lower_count))
        else if upper_count > lower_count + 1:
            push_max(&lower[0], &lower_count, pop_min(&upper[0], &upper_count))
        median: mutable i64 = 0
        if lower_count > upper_count:
            median <- lower[0]
        else if upper_count > lower_count:
            median <- upper[0]
        else:
            sum: i64 = lower[0] + upper[0]
            if sum < 0:
                median <- -((-sum) / 2)
            else:
                median <- sum / 2
        medians[i] <- (median & 255).u8()
    if output == null or capacity < count:
        return -2
    for i in 0..<count:
        output[i] <- medians[i]
    count.i64()

export fn median_of_running_array_byte(input: i32&, length: usize, output: mutable u8&, capacity: usize) -> i64 = median_of_running_array_byte_impl
