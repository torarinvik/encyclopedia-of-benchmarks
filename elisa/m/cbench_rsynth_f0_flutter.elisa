extern sin(value: f64) -> f64

def fn i64 cbench_rsynth_f0_flutter(i64* input, i64 input_length):
    if input == null or input_length < 1 or input_length > 4: return -1
    if input_length != 3: return -1
    if input[0] < 0 or input[0] > 20000 or input[1] < 0 or input[1] > 100 or input[2] < 0 or input[2] > 1000000: return -1
    f0: i64 = input[0]
    flutter: i64 = input[1]
    time_count: i64 = input[2]
    original_f0: i64 = f0 / 10
    pi: f64 = 3.1415927
    fla: f64 = flutter.f64() / 50.0
    flb: f64 = original_f0.f64() / 100.0
    flc: f64 = sin(2.0 * pi * 12.7 * time_count.f64())
    fld: f64 = sin(2.0 * pi * 7.1 * time_count.f64())
    fle: f64 = sin(2.0 * pi * 4.7 * time_count.f64())
    delta: f64 = fla * flb * (flc + fld + fle) * 10.0
    return f0 + delta.i64()

export fn cbench_rsynth_f0_flutter
