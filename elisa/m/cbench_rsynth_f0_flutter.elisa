extern sin(value: f64) -> f64

def cbench_rsynth_f0_flutter_impl(input: i64&, input_length: usize) -> i64:
    if input.is_null() or input_length != 3:
        return -1
    values: view[i64] = input[0:3]
    if values[0] < 0 or values[0] > 20000 or values[1] < 0 or values[1] > 100 or values[2] < 0 or values[2] > 1000000:
        return -1
    f0: i64 = values[0]
    flutter: i64 = values[1]
    time_count: i64 = values[2]
    original_f0: i64 = f0 / 10
    pi: f64 = 3.1415927
    fla: f64 = flutter.f64() / 50.0
    flb: f64 = original_f0.f64() / 100.0
    flc: f64 = sin(2.0 * pi * 12.7 * time_count.f64())
    fld: f64 = sin(2.0 * pi * 7.1 * time_count.f64())
    fle: f64 = sin(2.0 * pi * 4.7 * time_count.f64())
    delta: f64 = fla * flb * (flc + fld + fle) * 10.0
    return f0 + delta.i64()

export fn cbench_rsynth_f0_flutter(input: i64&, input_length: usize) -> i64 = cbench_rsynth_f0_flutter_impl
