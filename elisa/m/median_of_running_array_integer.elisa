def heap_push(heap_value: mutable view[i64], count: mutable usize&, is_max: bool, value: i64) -> void:
    index: mutable usize = count
    heap_value[index] <- value
    count <- count + 1
    while index > 0:
        parent: usize = (index - 1) / 2
        ordered: bool = heap_value[parent] >= heap_value[index] if is_max else heap_value[parent] <= heap_value[index]
        if ordered: break
        temp: i64 = heap_value[parent]
        heap_value[parent] <- heap_value[index]
        heap_value[index] <- temp
        index <- parent

def heap_pop(heap_value: mutable view[i64], count: mutable usize&, is_max: bool) -> i64:
    result: i64 = heap_value[0]
    count <- count - 1
    heap_value[0] <- heap_value[count]
    index: mutable usize = 0
    while true:
        left: usize = index * 2 + 1
        right: usize = left + 1
        best: mutable usize = index
        if left < count:
            better: bool = heap_value[left] > heap_value[best] if is_max else heap_value[left] < heap_value[best]
            if better: best <- left
        if right < count:
            better: bool = heap_value[right] > heap_value[best] if is_max else heap_value[right] < heap_value[best]
            if better: best <- right
        if best == index: break
        temp: i64 = heap_value[index]
        heap_value[index] <- heap_value[best]
        heap_value[best] <- temp
        index <- best
    result

def store_i64_le(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def median_of_running_array_integer_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 2: return -1
    n: i64 = input[0]
    if n < 1 or n > 256 or length != n.usize() + 1: return -1
    index: mutable usize = 0
    while index < n.usize():
        if input[index + 1] < -1000000 or input[index + 1] > 1000000: return -1
        index <- index + 1
    if output_capacity < n.usize() * 8: return -2
    lower: mutable i64[256] = zeroed
    upper: mutable i64[256] = zeroed
    lower_view: mutable view[i64] = lower[0:256]
    upper_view: mutable view[i64] = upper[0:256]
    lower_count: mutable usize = 0
    upper_count: mutable usize = 0
    index <- 0
    while index < n.usize():
        value: i64 = input[index + 1]
        if upper_count > 0 and value < upper[0]: heap_push(lower_view, lower_count, true, value)
        else: heap_push(upper_view, upper_count, false, value)
        if lower_count > upper_count + 1: heap_push(upper_view, upper_count, false, heap_pop(lower_view, lower_count, true))
        elif upper_count > lower_count + 1: heap_push(lower_view, lower_count, true, heap_pop(upper_view, upper_count, false))
        median: i64 = (lower[0] + upper[0]) / 2 if lower_count == upper_count else (lower[0] if lower_count > upper_count else upper[0])
        store_i64_le(median, output, index * 8)
        index <- index + 1
    n.i64() * 8

export fn median_of_running_array_integer(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = median_of_running_array_integer_impl
