const MAX_DIMENSION: usize = 64
const MAX_INPUT_VALUES: usize = 3 + 2 * MAX_DIMENSION * MAX_DIMENSION
const MAX_OUTPUT_VALUES: usize = MAX_DIMENSION * MAX_DIMENSION

def matrix_product_mod_2_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def matrix_product_mod_2_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_INPUT_VALUES: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    k_value: i64 = input[2]
    if n_value < 1 or n_value > MAX_DIMENSION.i64() or m_value < 1 or
        m_value > MAX_DIMENSION.i64() or k_value < 1 or k_value > MAX_DIMENSION.i64(): return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    k: usize = k_value.usize()
    a_length: usize = n * m
    b_length: usize = m * k
    if length != 3 + a_length + b_length: return -1

    packed_b: mutable u64[MAX_DIMENSION] = zeroed
    b_start: usize = 3 + a_length
    inner: mutable usize = 0
    while inner < m:
        column: mutable usize = 0
        while column < k:
            bit: i64 = input[b_start + inner * k + column]
            if bit != 0 and bit != 1: return -1
            packed_b[inner] <- packed_b[inner] | (bit.u64() << column)
            column <- column + 1
        inner <- inner + 1

    staged: mutable i64[MAX_OUTPUT_VALUES] = zeroed
    row: mutable usize = 0
    while row < n:
        accumulator: mutable u64 = 0
        inner <- 0
        while inner < m:
            bit: i64 = input[3 + row * m + inner]
            if bit != 0 and bit != 1: return -1
            if bit == 1: accumulator <- accumulator ^ packed_b[inner]
            inner <- inner + 1
        column <- 0
        while column < k:
            staged[row * k + column] <- ((accumulator >> column) & 1).i64()
            column <- column + 1
        row <- row + 1

    required: usize = 8 * n * k
    if output.is_null() or capacity < required: return -2
    index: mutable usize = 0
    while index < n * k:
        matrix_product_mod_2_store(staged[index], output[0:required], 8 * index)
        index <- index + 1
    required.i64()

export fn matrix_product_mod_2(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = matrix_product_mod_2_impl
