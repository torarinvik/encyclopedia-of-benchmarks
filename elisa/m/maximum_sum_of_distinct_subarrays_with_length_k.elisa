def maximum_sum_of_distinct_subarrays_with_length_k_impl(values: i64&, length: usize) -> i64:
    invalid: i64 = -9223372036854775807 - 1
    if length < 3 or length > 8194:
        return invalid
    n_value: i64 = values[0]
    k_value: i64 = values[1]
    if n_value < 1 or n_value > 8192 or k_value < 1 or k_value > n_value:
        return invalid
    n: usize = n_value as usize
    k: usize = k_value as usize
    if length != n + 2:
        return invalid
    keys: mutable i32[16384] = zeroed
    last_plus_one: mutable i32[16384] = zeroed
    current_sum: mutable i64 = 0
    maximum_sum: mutable i64 = 0
    distinct_start: mutable usize = 0
    i: mutable usize = 0
    while i < n:
        input: i64 = values[i + 2]
        if input < -2147483648 or input > 2147483647:
            return invalid
        value: i32 = input as i32
        if i < k:
            current_sum <- current_sum + value
        else:
            current_sum <- current_sum - values[i - k + 2]
            current_sum <- current_sum + value
        slot: mutable usize = ((input + 2147483648) % 16384) as usize
        while last_plus_one[slot] != 0 and keys[slot] != value:
            slot <- (slot + 1) & 16383
        if last_plus_one[slot] != 0:
            previous: usize = (last_plus_one[slot] - 1) as usize
            if previous >= distinct_start:
                distinct_start <- previous + 1
        else:
            keys[slot] <- value
        last_plus_one[slot] <- (i + 1) as i32
        if i + 1 >= k:
            start: usize = i + 1 - k
            if start >= distinct_start and current_sum > maximum_sum:
                maximum_sum <- current_sum
        i <- i + 1
    maximum_sum

export fn maximum_sum_of_distinct_subarrays_with_length_k(values: i64&, length: usize) -> i64 = maximum_sum_of_distinct_subarrays_with_length_k_impl
