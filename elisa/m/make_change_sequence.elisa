def make_change_sequence_impl(amount: i64) -> i64:
    if amount < 0 or amount > 128:
        return -1
    values: mutable i64[129] = zeroed
    values[0] <- 1
    values[1] <- 1
    values[2] <- 2
    values[3] <- 2
    values[4] <- 3
    values[5] <- 4
    values[6] <- 5
    values[7] <- 6
    values[8] <- 7
    values[9] <- 8
    values[10] <- 11
    values[11] <- 12
    values[12] <- 15
    values[13] <- 16
    values[14] <- 19
    values[15] <- 22
    values[16] <- 25
    table: i64[129] = while n <= amount |n: mutable i64 = 17, state: mutable i64[129] = values| -> state:
        state[n.usize()] <- state[(n - 2).usize()] + state[(n - 5).usize()] - state[(n - 7).usize()]
                        + state[(n - 10).usize()] - state[(n - 12).usize()] - state[(n - 15).usize()]
                        + state[(n - 17).usize()] + 1
        n <- n + 1
    table[amount.usize()]

export fn make_change_sequence(amount: i64) -> i64 = make_change_sequence_impl
