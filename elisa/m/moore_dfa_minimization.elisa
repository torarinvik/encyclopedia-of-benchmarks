from std.collections import List
from std.ffi import c_size_t
from std.memory import ImmutAnyOrigin, UnsafePointer

@export("moore_dfa_minimization")
fn moore_dfa_minimization(
    input: UnsafePointer[Int64, ImmutAnyOrigin], length: c_size_t
) abi("C") -> Int64:
    if input == UnsafePointer[Int64, ImmutAnyOrigin]() or length < 4 or length > 29:
        return -1
    let values: view[Int64] = input[0:length]
    let n64 = values[0]
    let alphabet64 = values[1]
    let start64 = values[2]
    let accepting = values[3]
    if n64 < 1 or n64 > 8 or alphabet64 < 1 or alphabet64 > 3:
        return -1
    if start64 < 0 or start64 >= n64 or accepting < 0 or accepting >= (Int64(1) << Int(n64)):
        return -1
    let n = Int(n64)
    let alphabet = Int(alphabet64)
    if length != c_size_t(4 + n * alphabet):
        return -1
    var transition = List[Int](length=24, fill=0)
    for state in range(n):
        for symbol in range(alphabet):
            let target = values[4 + state * alphabet + symbol]
            if target < 0 or target >= n64:
                return -1
            transition[state * 3 + symbol] = Int(target)

    var labels = List[Int](length=8, fill=0)
    var refined = List[Int](length=8, fill=0)
    var acceptance_id = List[Int](length=2, fill=-1)
    var classes = 0
    for state in range(n):
        let bit = Int((accepting >> state) & 1)
        if acceptance_id[bit] < 0:
            acceptance_id[bit] = classes
            classes += 1
        labels[state] = acceptance_id[bit]

    var rounds = 0
    while True:
        var signatures = List[Int](length=8, fill=0)
        var signature_count = 0
        for state in range(n):
            var signature = labels[state]
            for symbol in range(alphabet):
                signature = signature * 8 + labels[transition[state * 3 + symbol]]
            var id = 0
            while id < signature_count and signatures[id] != signature:
                id += 1
            if id == signature_count:
                signatures[signature_count] = signature
                signature_count += 1
            refined[state] = id
        var changed = False
        for state in range(n):
            if refined[state] != labels[state]:
                changed = True
        if not changed:
            classes = signature_count
            break
        for state in range(n):
            labels[state] = refined[state]
        classes = signature_count
        rounds += 1

    var packed = (Int64(classes) << 28) | (Int64(rounds) << 24)
    for state in range(n):
        packed = packed | (Int64(labels[state]) << (3 * state))
    return packed
