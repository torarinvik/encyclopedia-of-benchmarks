def meter_to_feet_conversion_impl(v: i64&, n: usize) -> f64:
    if n != 2: return -1.0e300
    op: i64=v[0]; units: i64=v[1]
    if (op != 0 and op != 1) or units < -1000000000 or units > 1000000000: return -1.0e300
    value: f64=units.f64()/1000.0
    if op == 0: return value*0.3048
    value/0.3048
export fn meter_to_feet_conversion(v: i64&, n: usize) -> f64 = meter_to_feet_conversion_impl
