# Deterministic tape replay for the a=1/2 Morris counter variant.
const MAX_UPDATES: usize = 30
const MAX_VALID_INPUT_VALUES: usize = 1 + MAX_UPDATES
const MAX_PARSEABLE_INPUT_VALUES: usize = MAX_VALID_INPUT_VALUES + 1
const DRAW_SPACE: u64 = 205891132094649.u64()

def morris_approximate_counter_base_three_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def morris_approximate_counter_base_three(input: i64&, input_length: usize,
    output: mutable u8&, output_capacity: usize) -> i64
        @export("morris_approximate_counter_base_three"):
    if input.is_null() or input_length < 1 or input_length > MAX_PARSEABLE_INPUT_VALUES:
        return -1
    updates_value: i64 = input[0]
    if updates_value < 0 or updates_value > MAX_UPDATES.i64(): return -1
    updates: usize = updates_value.usize()
    if input_length != 1 + updates: return -1

    state: mutable usize = 0
    threshold: mutable u64 = DRAW_SPACE
    estimate: mutable u64 = 0
    for event in 0..updates:
        draw_value: i64 = input[1 + event]
        if draw_value < 0 or draw_value.u64() >= DRAW_SPACE: return -1
        if draw_value.u64() < threshold:
            state <- state + 1
            threshold <- threshold / 3
            estimate <- 3 * estimate + 1

    if output.is_null() or output_capacity < 16: return -2
    morris_approximate_counter_base_three_store_i64(output, 0, state.i64())
    morris_approximate_counter_base_three_store_i64(output, 8, estimate.i64())
    16
