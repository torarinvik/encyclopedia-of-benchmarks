const GRID_ROWS: usize = 8
const GRID_COLS: usize = 7
const GRID_CELLS: usize = 56
const INPUT_WORDS: usize = 57
const OUTPUT_BYTES: usize = 228
const START_INDEX: usize = 8
const TARGET_INDEX: usize = 47

def maze_recursion_solve(grid: mutable view[u8], row: usize, col: usize, strategy: i64) -> bool:
    if grid[TARGET_INDEX] == 2:
        return true
    index: usize = row * GRID_COLS + col
    if grid[index] != 0:
        return false
    grid[index] <- 2

    if strategy == 0:
        if maze_recursion_solve(grid, row + 1, col, strategy): return true
        if maze_recursion_solve(grid, row, col + 1, strategy): return true
        if maze_recursion_solve(grid, row - 1, col, strategy): return true
        if maze_recursion_solve(grid, row, col - 1, strategy): return true
    else:
        if maze_recursion_solve(grid, row - 1, col, strategy): return true
        if maze_recursion_solve(grid, row, col + 1, strategy): return true
        if maze_recursion_solve(grid, row + 1, col, strategy): return true
        if maze_recursion_solve(grid, row, col - 1, strategy): return true

    grid[index] <- 3
    return false

def maze_recursion_put_i32_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 4:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def maze_recursion_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length != INPUT_WORDS:
        return -1
    if input[0] < 0 or input[0] > 1:
        return -1
    strategy: i64 = input[0]

    grid: mutable u8[GRID_CELLS] = zeroed
    index: mutable usize = 0
    while index < GRID_CELLS:
        cell: i64 = input[index + 1]
        if cell != 0 and cell != 1:
            return -1
        grid[index] <- cell.u8()
        index <- index + 1
    row: mutable usize = 0
    while row < GRID_ROWS:
        col: mutable usize = 0
        while col < GRID_COLS:
            if (row == 0 or row == GRID_ROWS - 1 or col == 0 or col == GRID_COLS - 1) and
               grid[row * GRID_COLS + col] != 1:
                return -1
            col <- col + 1
        row <- row + 1
    if grid[START_INDEX] != 0 or grid[TARGET_INDEX] != 0:
        return -1
    if output.is_null() or capacity < OUTPUT_BYTES:
        return -2

    found: bool = maze_recursion_solve(grid[0:GRID_CELLS], 1, 1, strategy)
    buffer: mutable u8[OUTPUT_BYTES] = zeroed
    buffer_view: mutable view[u8] = buffer[0:OUTPUT_BYTES]
    maze_recursion_put_i32_le(if found then 1 else 0, buffer_view, 0)
    index <- 0
    while index < GRID_CELLS:
        maze_recursion_put_i32_le(grid[index].i64(), buffer_view, 4 * (index + 1))
        index <- index + 1
    index <- 0
    while index < OUTPUT_BYTES:
        output[index] <- buffer[index]
        index <- index + 1
    OUTPUT_BYTES.i64()

export fn maze_recursion(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = maze_recursion_impl
