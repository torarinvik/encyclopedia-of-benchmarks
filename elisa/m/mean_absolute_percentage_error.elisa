extern fn double log(double value);
extern fn double log1p(double value);
extern fn double fabs(double value);
const INVALID_RESULT: f64 = -1.0e300
fn mean_absolute_percentage_error_impl(values: i64&, length: usize) -> f64:
    if values == null || length < 1: return INVALID_RESULT
    n0: i64 = values[0]
    if n0 < 1 || n0 > 64: return INVALID_RESULT
    n: usize = n0.usize()
    if length != 1+2*n: return INVALID_RESULT
    for i: usize = 0; i < 2*n; i = i+1:
        x: i64 = values[1+i]
        if x < -1000000 || x > 1000000: return INVALID_RESULT
    total: f64 = 0.0
    for i: usize = 0; i < n; i = i+1:
        t: f64 = values[1+i].f64()/1000000.0
        p: f64 = values[1+n+i].f64()/1000000.0
        d: f64 = if t == 0.0: 1e-15 else: t; total = total+abs((d-p)/d)
    return total/n.f64()
export fn mean_absolute_percentage_error(values: i64&, length: usize) -> f64 = mean_absolute_percentage_error_impl
