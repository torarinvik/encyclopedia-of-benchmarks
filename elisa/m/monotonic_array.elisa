def is_monotonic_impl(values: i64&, length: usize) -> i64:
    if length > 256 or (values.is_null() and length > 0): return -1

    i: mutable usize = 1
    while i < length:
        if values[i - 1] > values[i]:
            i <- 1
            while i < length:
                if values[i - 1] < values[i]: return 0
                i <- i + 1
            return 1
        i <- i + 1
    1

export fn is_monotonic(values: i64&, length: usize) -> i64 = is_monotonic_impl
