def monotonic_array_impl(v: i64&, n: usize) -> i64:
    if n > 256 or (v.is_null() and n > 0): return -1
    inc: mutable bool = true; dec: mutable bool = true
    i: mutable usize = 0
    while i < n:
        if v[i] < -1000000000 or v[i] > 1000000000: return -1
        i <- i + 1
    i <- 1
    while i < n:
        if v[i - 1] > v[i]: inc <- false
        if v[i - 1] < v[i]: dec <- false
        i <- i + 1
    if inc or dec: return 1
    0
export fn monotonic_array(v: i64&, n: usize) -> i64 = monotonic_array_impl
