def multilayer_perceptron_classifier_impl(input: f64&, input_length: usize,
        output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or input_length != 15: return -1
    i: mutable usize = 0
    while i < 15:
        if input[i] != input[i]: return -1
        i <- i + 1
    if input[0] < 1.0 or input[0] > 12.0 or input[0] != input[0].usize().f64(): return -1
    if input[1] != 0.05 and input[1] != 0.1 and input[1] != 0.2: return -1
    if input[2] != 0.5 and input[2] != 0.75 and input[2] != 1.0: return -1
    epochs: usize = input[0].usize()
    i <- 0
    while i < 8:
        value: f64 = input[3 + i]
        scaled: f64 = value * 4.0
        if value < -2.0 or value > 2.0: return -1
        if scaled >= 0.0:
            if scaled != scaled.usize().f64(): return -1
        else:
            if -scaled != (-scaled).usize().f64(): return -1
        i <- i + 1
    labels: mutable usize[4] = zeroed
    i <- 0
    while i < 4:
        value: f64 = input[11 + i]
        if value < 0.0 or value > 2.0 or value != value.usize().f64(): return -1
        labels[i] <- value.usize()
        i <- i + 1
    w1: mutable f64[6] = [0.30471707975443135, -1.0399841062404955, 0.7504511958064572, 0.9405647163912139, -1.9510351886538364, -1.302179506862318]
    w2: mutable f64[6] = [0.12784040316728537, -0.3162425923435822, -0.016801157504288795, -0.85304392757358, 0.8793979748628286, 0.7777919354289483]
    accuracies: mutable f64[12] = zeroed
    losses: mutable f64[12] = zeroed
    rate: mutable f64 = input[1]
    epoch: mutable usize = 0
    while epoch < epochs:
        row_index: mutable usize = 0
        while row_index < 3:
            row: mutable f64[3] = zeroed
            row[0] <- input[3 + row_index * 2]
            row[1] <- input[4 + row_index * 2]
            row[2] <- 1.0
            z1: mutable f64[2] = zeroed
            j: mutable usize = 0
            while j < 2:
                total: mutable f64 = 0.0
                i <- 0
                while i < 3:
                    total <- total + row[i] * w1[i * 2 + j]
                    i <- i + 1
                z1[j] <- total
                j <- j + 1
            hidden: mutable f64[2] = zeroed
            j <- 0
            while j < 2:
                if z1[j] > 0.0: hidden[j] <- z1[j]
                j <- j + 1
            z2: mutable f64[3] = zeroed
            k: mutable usize = 0
            while k < 3:
                total: mutable f64 = 0.0
                j <- 0
                while j < 2:
                    total <- total + hidden[j] * w2[j * 3 + k]
                    j <- j + 1
                z2[k] <- total
                k <- k + 1
            delta_out: mutable f64[3] = zeroed
            k <- 0
            while k < 3:
                delta_out[k] <- z2[k]
                if labels[row_index] == k: delta_out[k] <- delta_out[k] - 0.99
                k <- k + 1
            delta_hidden: mutable f64[2] = zeroed
            j <- 0
            while j < 2:
                total: mutable f64 = 0.0
                k <- 0
                while k < 3:
                    total <- total + delta_out[k] * w2[j * 3 + k]
                    k <- k + 1
                if z1[j] > 0.0: delta_hidden[j] <- total
                j <- j + 1
            grad_w2: mutable f64[6] = zeroed
            j <- 0
            while j < 2:
                k <- 0
                while k < 3:
                    grad_w2[j * 3 + k] <- hidden[j] * delta_out[k]
                    k <- k + 1
                j <- j + 1
            grad_w1: mutable f64[6] = zeroed
            i <- 0
            while i < 3:
                j <- 0
                while j < 2:
                    grad_w1[i * 2 + j] <- row[i] * delta_hidden[j]
                    j <- j + 1
                i <- i + 1
            i <- 0
            while i < 3:
                j <- 0
                while j < 2:
                    w1[i * 2 + j] <- w1[i * 2 + j] - rate * grad_w1[i * 2 + j]
                    j <- j + 1
                i <- i + 1
            j <- 0
            while j < 2:
                k <- 0
                while k < 3:
                    w2[j * 3 + k] <- w2[j * 3 + k] - rate * grad_w2[j * 3 + k]
                    k <- k + 1
                j <- j + 1
            row_index <- row_index + 1
        row: mutable f64[3] = [input[9], input[10], 1.0]
        z1: mutable f64[2] = zeroed
        j <- 0
        while j < 2:
            total: mutable f64 = 0.0
            i <- 0
            while i < 3:
                total <- total + row[i] * w1[i * 2 + j]
                i <- i + 1
            z1[j] <- total
            j <- j + 1
        hidden: mutable f64[2] = zeroed
        j <- 0
        while j < 2:
            if z1[j] > 0.0: hidden[j] <- z1[j]
            j <- j + 1
        predicted: mutable f64[3] = zeroed
        k <- 0
        while k < 3:
            total: mutable f64 = 0.0
            j <- 0
            while j < 2:
                total <- total + hidden[j] * w2[j * 3 + k]
                j <- j + 1
            predicted[k] <- total
            k <- k + 1
        best: mutable usize = 0
        k <- 1
        while k < 3:
            if predicted[k] > predicted[best]: best <- k
            k <- k + 1
        if best == labels[3]: accuracies[epoch] <- 1.0
        loss: mutable f64 = 0.0
        k <- 0
        while k < 3:
            difference: mutable f64 = predicted[k]
            if labels[3] == k: difference <- difference - 0.99
            loss <- loss + difference * difference
            k <- k + 1
        losses[epoch] <- loss / 2.0
        rate <- rate * input[2]
        epoch <- epoch + 1
    staged: mutable f64[26] = zeroed
    staged[0] <- epochs.f64()
    mean: mutable f64 = 0.0
    epoch <- 0
    while epoch < epochs:
        staged[1 + epoch] <- accuracies[epoch]
        staged[1 + epochs + epoch] <- losses[epoch]
        mean <- mean + accuracies[epoch]
        epoch <- epoch + 1
    mean <- mean / epochs.f64()
    staged[1 + 2 * epochs] <- mean
    output_size: usize = 2 + 2 * epochs
    if output.is_null() or capacity < output_size: return -2
    i <- 0
    while i < output_size:
        output[i] <- staged[i]
        i <- i + 1
    return output_size.i64()

export fn multilayer_perceptron_classifier(input: f64&, input_length: usize, output: mutable f64&, capacity: usize) -> i64 = multilayer_perceptron_classifier_impl
