const MAX_STATES: usize = 8
const MAX_STEPS: usize = 64
const MAX_INPUT: usize = 267
const MAX_OUTPUT: usize = 65

def metropolis_hastings_asymmetric_proposal_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3 or length > MAX_INPUT: return -1
    values: i64& = input
    n_value: i64 = values[0]
    steps_value: i64 = values[1]
    initial_value: i64 = values[2]
    if n_value < 2 or n_value > MAX_STATES.i64() or steps_value < 0 or steps_value > MAX_STEPS.i64() or initial_value < 0 or initial_value >= n_value:
        return -1
    n: usize = n_value.usize()
    steps: usize = steps_value.usize()
    weights_start: usize = 3
    matrix_start: usize = weights_start + n
    proposals_start: usize = matrix_start + n*n
    draws_start: usize = proposals_start + steps
    if length != draws_start + 2*steps: return -1
    state: mutable usize = 0
    while state < n:
        weight: i64 = values[weights_start + state]
        if weight < 1 or weight > 1024: return -1
        state <- state + 1
    row: mutable usize = 0
    while row < n:
        row_sum: mutable i64 = 0
        column: mutable usize = 0
        while column < n:
            q: i64 = values[matrix_start + row*n + column]
            if q < 0 or q > 1024: return -1
            row_sum <- row_sum + q
            column <- column + 1
        if row_sum != 1024: return -1
        row <- row + 1

    staged: mutable u8[MAX_OUTPUT] = zeroed
    current: mutable usize = initial_value.usize()
    staged[0] <- current.u8()
    step: mutable usize = 0
    while step < steps:
        proposal_value: i64 = values[proposals_start + step]
        draw_num: i64 = values[draws_start + 2*step]
        draw_den: i64 = values[draws_start + 2*step + 1]
        if proposal_value < 0 or proposal_value >= n_value or draw_den < 1 or draw_den > 1024 or draw_num < 0 or draw_num >= draw_den: return -1
        proposal: usize = proposal_value.usize()
        forward: i64 = values[matrix_start + current*n + proposal]
        if forward == 0: return -1
        reverse: i64 = values[matrix_start + proposal*n + current]
        numerator: i64 = values[weights_start + proposal] * reverse
        denominator: i64 = values[weights_start + current] * forward
        if numerator >= denominator or draw_num*denominator < draw_den*numerator:
            current <- proposal
        staged[step + 1] <- current.u8()
        step <- step + 1

    needed: usize = steps + 1
    if output == null or capacity < needed: return -2
    destination: mutable u8& = output
    index: mutable usize = 0
    while index < needed:
        destination[index] <- staged[index]
        index <- index + 1
    needed.i64()

export fn metropolis_hastings_asymmetric_proposal(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = metropolis_hastings_asymmetric_proposal_impl
