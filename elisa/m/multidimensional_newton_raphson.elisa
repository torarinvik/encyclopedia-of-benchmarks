extern floor(value: f64) -> f64

const MNR_MIN_COORDINATE: i64 = 900
const MNR_MAX_COORDINATE: i64 = 1500
const MNR_MAX_UPDATES: i64 = 8

def mnr_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    let bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def mnr_round_nano(value: f64) -> i64:
    let magnitude: f64 = if value < 0.0: 0.0 - value else: value
    let rounded: i64 = floor(magnitude * 1000000000.0 + 0.5).i64()
    if value < 0.0: 0.i64() - rounded else: rounded

def mnr_impl(input: view[i64], output: mutable u8&, capacity: usize) -> i64:
    if input.len() != 3: return -1
    let x_milli: i64 = input[0]
    let y_milli: i64 = input[1]
    let updates: i64 = input[2]
    if x_milli < MNR_MIN_COORDINATE or x_milli > MNR_MAX_COORDINATE: return -1
    if y_milli < MNR_MIN_COORDINATE or y_milli > MNR_MAX_COORDINATE: return -1
    if updates < 1 or updates > MNR_MAX_UPDATES: return -1
    if output.is_null() or capacity < 16: return -2
    let result: mutable view[u8] = output[0:16]

    let x_start: f64 = x_milli.f64() / 1000.0
    let y_start: f64 = y_milli.f64() / 1000.0
    let x: mutable f64 = x_start
    let y: mutable f64 = y_start
    let step: mutable i64 = 0
    while step < updates:
        let f1: f64 = x * x + y - 3.0
        let f2: f64 = x + y * y - 3.0
        let determinant: f64 = 4.0 * x * y - 1.0
        let dx: f64 = (2.0 * y * f1 - f2) / determinant
        let dy: f64 = (2.0 * x * f2 - f1) / determinant
        x <- x - dx
        y <- y - dy
        step <- step + 1
    }
    mnr_store_i64_le(mnr_round_nano(x), result, 0)
    mnr_store_i64_le(mnr_round_nano(y), result, 8)
    16

export fn multidimensional_newton_raphson(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 4: return -1
    let values: view[i64] = input[0:length]
    mnr_impl(values, output, capacity)
