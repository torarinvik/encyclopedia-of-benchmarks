const MAX_ROWS: usize = 32
const MAX_COLUMNS: usize = 32
# A path has at most 32 cells of value 1023 and 31 moves of cost 100.
const INF_COST: u32 = 65536

def minimum_path_cost_in_grid_impl(input: i64&, length: usize) -> i64:
    if length < 2:
        return -1
    if input[0] < 1 or input[0] > i64(MAX_ROWS) or input[1] < 1 or input[1] > i64(MAX_COLUMNS):
        return -1
    rows: usize = usize(input[0])
    columns: usize = usize(input[1])
    cells: usize = rows * columns
    move_offset: usize = 2 + cells
    if length != move_offset + cells * columns:
        return -1
    for index in 0..<cells:
        if input[2 + index] < 0 or input[2 + index] >= i64(cells):
            return -1
    for index in 0..<(cells * columns):
        if input[move_offset + index] < 1 or input[move_offset + index] > 100:
            return -1
    costs: mutable u32[32] = zeroed
    next_costs: mutable u32[32] = zeroed
    for row in 0..<(rows - 1) |costs, next_costs, input|:
        for target in 0..<columns |next_costs|:
            next_costs[target] <- INF_COST
        for column in 0..<columns |costs, next_costs, input|:
            value: usize = usize(input[2 + row * columns + column])
            base: u32 = costs[column] + value.u32()
            for target in 0..<columns |next_costs|:
                candidate: u32 = base + input[move_offset + value * columns + target].u32()
                previous: u32 = next_costs[target]
                next_costs[target] <- candidate if candidate < previous else previous
        for column in 0..<columns |costs, next_costs|:
            costs[column] <- next_costs[column]
    minimum: mutable u32 = INF_COST
    last_row: usize = 2 + (rows - 1) * columns
    for column in 0..<columns |costs, input, minimum|:
        candidate: u32 = costs[column] + input[last_row + column].u32()
        if candidate < minimum:
            minimum <- candidate
    minimum.i64()

export fn minimum_path_cost_in_grid(input: i64&, length: usize) -> i64 = minimum_path_cost_in_grid_impl
