def magicdiamondpattern_impl(n: i64, output: mutable u8&, capacity: usize) -> i64:
    message: sview = "       ...       ....        nothing printing :("
    if n > 45: return -1
    if n <= 0:
        if output == null or capacity < message.len: return -2
        i: mutable usize = 0
        while i < message.len:
            output[i] <- message[i]
            i <- i + 1
        return message.len.i64()
    side: usize = n.usize()
    required: usize = 3 * side * side + 4 * side
    if output == null or capacity < required: return -2
    position: mutable usize = 0
    i: mutable usize = 0
    while i < side:
        j: mutable usize = 0
        while j < side - i - 1:
            output[position] <- 32
            position <- position + 1
            j <- j + 1
        j <- 0
        while j < i + 1:
            output[position] <- 42
            position <- position + 1
            output[position] <- 32
            position <- position + 1
            j <- j + 1
        output[position] <- 10
        position <- position + 1
        i <- i + 1
    i <- side
    while i > 0:
        j: mutable usize = 0
        while j < i:
            output[position] <- 42
            position <- position + 1
            output[position] <- 32
            position <- position + 1
            j <- j + 1
        output[position] <- 10
        position <- position + 1
        j <- 0
        while j < side - i + 1:
            output[position] <- 32
            position <- position + 1
            j <- j + 1
        i <- i - 1
    position.i64()

export fn magicdiamondpattern(n: i64, output: mutable u8&, capacity: usize) -> i64 = magicdiamondpattern_impl
