const MAX_N: usize = 8
const MAX_INPUT_VALUES: usize = 2 + MAX_N * MAX_N + 1
const MAX_MODULUS: i64 = 1_000_000_000

def matrix_det_arbitrary_mod_normalize(value: i64, modulus: i64) -> i64:
    residue: mutable i64 = value % modulus
    if residue < 0: residue <- residue + modulus
    return residue

def matrix_det_arbitrary_mod_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def matrix_det_arbitrary_mod_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_VALUES: return -1
    n_value: i64 = input[0]
    modulus: i64 = input[1]
    if n_value < 0 or n_value > MAX_N.i64() or modulus < 2 or modulus > MAX_MODULUS: return -1
    n: usize = n_value.usize()
    if length != 2 + n * n: return -1

    matrix: mutable i64[MAX_N * MAX_N] = zeroed
    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            value: i64 = input[2 + row * n + column]
            if value < 0 or value >= modulus: return -1
            matrix[row * n + column] <- value
            column <- column + 1
        row <- row + 1

    determinant: mutable i64 = 1
    sign: mutable bool = false
    column <- 0
    while column < n:
        pivot: mutable usize = column
        while pivot < n and matrix[pivot * n + column] == 0: pivot <- pivot + 1
        if pivot == n:
            determinant <- 0
            break
        if pivot != column:
            k: mutable usize = 0
            while k < n:
                temporary: i64 = matrix[column * n + k]
                matrix[column * n + k] <- matrix[pivot * n + k]
                matrix[pivot * n + k] <- temporary
                k <- k + 1
            sign <- not sign
        row <- column + 1
        while row < n:
            left: mutable i64 = matrix[column * n + column]
            right: mutable i64 = matrix[row * n + column]
            if right != 0:
                a0: mutable i64 = 1
                a1: mutable i64 = 0
                b0: mutable i64 = 0
                b1: mutable i64 = 1
                while left != 0 and right != 0:
                    if left < right:
                        quotient: i64 = right / left
                        right <- right - quotient * left
                        b0 <- matrix_det_arbitrary_mod_normalize(b0 - a0 * quotient, modulus)
                        b1 <- matrix_det_arbitrary_mod_normalize(b1 - a1 * quotient, modulus)
                    else:
                        quotient: i64 = left / right
                        left <- left - quotient * right
                        a0 <- matrix_det_arbitrary_mod_normalize(a0 - b0 * quotient, modulus)
                        a1 <- matrix_det_arbitrary_mod_normalize(a1 - b1 * quotient, modulus)
                k <- column
                while k < n:
                    old_top: i64 = matrix[column * n + k]
                    old_bottom: i64 = matrix[row * n + k]
                    matrix[column * n + k] <- matrix_det_arbitrary_mod_normalize(old_top * a0 + old_bottom * a1, modulus)
                    matrix[row * n + k] <- matrix_det_arbitrary_mod_normalize(old_top * b0 + old_bottom * b1, modulus)
                    k <- k + 1
                if left == 0:
                    k <- 0
                    while k < n:
                        temporary: i64 = matrix[column * n + k]
                        matrix[column * n + k] <- matrix[row * n + k]
                        matrix[row * n + k] <- temporary
                        k <- k + 1
                    sign <- not sign
            row <- row + 1
        determinant <- (determinant * matrix[column * n + column]) % modulus
        if determinant == 0: break
        column <- column + 1
    if sign and determinant != 0: determinant <- modulus - determinant
    if output.is_null() or capacity < 8: return -2
    matrix_det_arbitrary_mod_store(determinant, output[0:8], 0)
    return 8

export fn matrix_det_arbitrary_mod(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = matrix_det_arbitrary_mod_impl
