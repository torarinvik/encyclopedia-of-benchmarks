# Modified derivative of MiBench bmhsrch.c; public domain by Raymond Gardner (7/92).
const MAX_TEXT: usize = 128
const MAX_PATTERN: usize = 32
const MAX_INPUT: usize = 162

def mibench_office_stringsearch_bmh_impl(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT:
        return -1
    text_len_value: i64 = input[0]
    pattern_len_value: i64 = input[1]
    if text_len_value < 0 or text_len_value > 128 or pattern_len_value < 1 or pattern_len_value > 32:
        return -1
    text_len: usize = text_len_value.usize()
    pattern_len: usize = pattern_len_value.usize()
    if length != 2 + text_len + pattern_len:
        return -1
    text: mutable u8[128] = zeroed
    pattern: mutable u8[32] = zeroed
    for i in 0..<(text_len + pattern_len):
        value: i64 = input[2 + i]
        if value < 32 or value > 126:
            return -1
        if i < text_len:
            text[i] <- value.u8()
        else:
            pattern[i - text_len] <- value.u8()
    shift: mutable usize[256] = zeroed
    for i in 0..<256: shift[i] <- pattern_len
    for i in 0..<(pattern_len - 1): shift[pattern[i].usize()] <- pattern_len - i - 1
    match: mutable i64 = -1
    if pattern_len <= text_len:
        start: mutable usize = 0
        while start <= text_len - pattern_len:
            j: mutable usize = pattern_len
            while j > 0 and text[start + j - 1] == pattern[j - 1]:
                j <- j - 1
            if j == 0:
                match <- start.i64()
                break
            start <- start + shift[text[start + pattern_len - 1].usize()]
    if output.is_null() or output_capacity < 8:
        return -2
    bits: u64 = if match < 0: (match + 18_446_744_073_709_551_616).u64() else: match.u64()
    for i in 0..<8:
        output[i] <- ((bits >> (8 * i)) & 255).u8()
    return 8

export fn mibench_office_stringsearch_bmh(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) -> i64 = mibench_office_stringsearch_bmh_impl
