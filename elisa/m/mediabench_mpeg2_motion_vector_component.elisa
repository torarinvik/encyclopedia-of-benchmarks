def put_motion_component(output: u8&, value: i64) -> void:
    bits: u64 = value.u64()
    for b in 0..<8: output[b] <- ((bits >> (8*b)) & 255).u8()

def mediabench_mpeg2_motion_vector_component_impl(values: i64&, length: usize, output: u8&, capacity: usize) -> i64:
    if values.is_null() or length != 4: return -1
    pred: i64 = values[0]
    r_size: i64 = values[1]
    motion_code: i64 = values[2]
    residual: i64 = values[3]
    if r_size < 0 or r_size > 6 or motion_code < -16 or motion_code > 16: return -1
    lim: i64 = 16 << r_size
    if pred < -lim or pred >= lim: return -1
    if motion_code == 0 or r_size == 0:
        if residual != 0: return -1
    else:
        if residual < 0 or residual >= (1 << r_size): return -1
    vec: mutable i64 = pred
    if motion_code > 0:
        vec <- vec + ((motion_code-1) << r_size) + residual + 1
        if vec >= lim: vec <- vec - 2*lim
    else if motion_code < 0:
        vec <- vec - ((-motion_code-1) << r_size) - residual - 1
        if vec < -lim: vec <- vec + 2*lim
    if output.is_null() or capacity < 8: return -2
    put_motion_component(output,vec)
    8
export fn mediabench_mpeg2_motion_vector_component(values: i64&, length: usize, output: u8&, capacity: usize) -> i64 = mediabench_mpeg2_motion_vector_component_impl
