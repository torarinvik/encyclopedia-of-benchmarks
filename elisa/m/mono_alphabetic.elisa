const MAX_TEXT_LENGTH: usize = 256
const MAX_PARSEABLE_INPUT_LENGTH: usize = 285
const FNV_OFFSET_BASIS: u64 = 14695981039346656037.u64()
const FNV_PRIME: u64 = 1099511628211.u64()
const MASK_63: u64 = 0x7fffffffffffffff.u64()

def mono_alphabetic_impl(input: i64&, input_length: usize) -> i64:
    if input.is_null() or input_length < 2 or input_length > MAX_PARSEABLE_INPUT_LENGTH:
        return -1
    operation: i64 = input[0]
    raw_text_length: i64 = input[1]
    if (operation != 0 and operation != 1) or raw_text_length < 1 or raw_text_length > 256:
        return -1
    text_length: usize = raw_text_length.usize()
    if input_length != 28 + text_length:
        return -1

    seen: mutable bool[26] = zeroed
    inverse: mutable usize[26] = zeroed
    index: mutable usize = 0
    while index < 26:
        value: i64 = input[2 + index]
        if value < 65 or value > 90:
            return -1
        letter_index: usize = (value - 65).usize()
        if seen[letter_index]:
            return -1
        seen[letter_index] <- true
        inverse[letter_index] <- index
        index <- index + 1
    index <- 0
    while index < text_length:
        value: i64 = input[28 + index]
        if value < 65 or value > 90:
            return -1
        index <- index + 1

    hash: mutable u64 = FNV_OFFSET_BASIS
    length_word: mutable u64 = text_length.u64()
    index <- 0
    while index < 8:
        hash <- (hash ^ (length_word & 255.u64())) * FNV_PRIME
        length_word <- length_word >> 8
        index <- index + 1
    index <- 0
    while index < text_length:
        letter_index: usize = (input[28 + index] - 65).usize()
        mapped: i64 = if operation == 0: input[2 + letter_index] else: 65.i64() + inverse[letter_index].i64()
        hash <- (hash ^ mapped.u64()) * FNV_PRIME
        index <- index + 1
    (hash & MASK_63).i64()

export fn mono_alphabetic(input: i64&, input_length: usize) -> i64 = mono_alphabetic_impl
