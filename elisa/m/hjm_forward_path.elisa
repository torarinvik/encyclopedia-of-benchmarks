extern sqrt(value: f64) -> f64

def hjm_forward_path_impl(input: f64&, input_length: usize,
        output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or input_length < 7 or input_length > 54: return -1
    steps_value: f64 = input[0]
    factors_value: f64 = input[1]
    if not (steps_value >= 2.0 and steps_value <= 8.0): return -1
    if not (factors_value >= 1.0 and factors_value <= 3.0): return -1
    steps: usize = steps_value.usize()
    factors: usize = factors_value.usize()
    if steps_value != steps.f64() or factors_value != factors.f64(): return -1
    years: f64 = input[2]
    if not (years == 1.0 or years == 2.0 or years == 3.0): return -1
    expected: usize = 3 + steps + 2 * factors * (steps - 1)
    if input_length != expected: return -1

    yields: mutable f64[8] = zeroed
    vols: mutable f64[21] = zeroed
    shocks: mutable f64[21] = zeroed
    forwards: mutable f64[8] = zeroed
    factor_drifts: mutable f64[21] = zeroed
    total_drifts: mutable f64[7] = zeroed
    path: mutable f64[64] = zeroed

    cursor: mutable usize = 3
    maturity: mutable usize = 0
    while maturity < steps:
        value: f64 = input[cursor]
        cursor <- cursor + 1
        if not (value >= -0.05 and value <= 0.20): return -1
        yields[maturity] <- value
        maturity <- maturity + 1
    factor: mutable usize = 0
    while factor < factors:
        maturity <- 0
        while maturity < steps - 1:
            value: f64 = input[cursor]
            cursor <- cursor + 1
            if not (value >= 0.0 and value <= 0.30): return -1
            vols[factor * 7 + maturity] <- value
            maturity <- maturity + 1
        factor <- factor + 1
    time: mutable usize = 0
    while time < steps - 1:
        factor <- 0
        while factor < factors:
            value: f64 = input[cursor]
            cursor <- cursor + 1
            if not (value >= -3.0 and value <= 3.0): return -1
            shocks[time * 3 + factor] <- value
            factor <- factor + 1
        time <- time + 1

    dt: f64 = years / steps.f64()
    forwards[0] <- yields[0]
    maturity <- 1
    while maturity < steps:
        forwards[maturity] <- (maturity + 1).f64() * yields[maturity] - maturity.f64() * yields[maturity - 1]
        maturity <- maturity + 1
    factor <- 0
    while factor < factors:
        base: usize = factor * 7
        first_vol: f64 = vols[base]
        factor_drifts[base] <- 0.5 * dt * first_vol * first_vol
        maturity <- 1
        while maturity < steps - 1:
            drift: mutable f64 = 0.0
            prior: mutable usize = 0
            while prior < maturity:
                drift <- drift - factor_drifts[base + prior]
                prior <- prior + 1
            prefix_volatility: mutable f64 = 0.0
            prior <- 0
            while prior <= maturity:
                prefix_volatility <- prefix_volatility + vols[base + prior]
                prior <- prior + 1
            drift <- drift + 0.5 * dt * prefix_volatility * prefix_volatility
            factor_drifts[base + maturity] <- drift
            maturity <- maturity + 1
        factor <- factor + 1
    maturity <- 0
    while maturity < steps - 1:
        factor <- 0
        while factor < factors:
            total_drifts[maturity] <- total_drifts[maturity] + factor_drifts[factor * 7 + maturity]
            factor <- factor + 1
        maturity <- maturity + 1
    maturity <- 0
    while maturity < steps:
        path[maturity] <- forwards[maturity]
        maturity <- maturity + 1
    root_dt: f64 = sqrt(dt)
    time <- 1
    while time < steps:
        maturity <- 0
        while maturity < steps - time:
            total_shock: mutable f64 = 0.0
            factor <- 0
            while factor < factors:
                total_shock <- total_shock + vols[factor * 7 + maturity] * shocks[(time - 1) * 3 + factor]
                factor <- factor + 1
            path[time * steps + maturity] <- path[(time - 1) * steps + maturity + 1] + total_drifts[maturity] * dt + root_dt * total_shock
            maturity <- maturity + 1
        time <- time + 1

    needed: usize = steps * steps
    if output.is_null() or capacity < needed: return -2
    cursor <- 0
    while cursor < needed:
        output[cursor] <- path[cursor]
        cursor <- cursor + 1
    return needed.i64()

export fn hjm_forward_path(input: f64&, input_length: usize,
        output: mutable f64&, capacity: usize) -> i64 = hjm_forward_path_impl
