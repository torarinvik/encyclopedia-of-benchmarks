# Mersenne-prime predicate for the bounded positive signed-32-bit domain.
def mersenne_prime_impl(n: i64) -> i64:
    if n == 0:
        return 0
    if n < 0 or n > 2147483647:
        return -1
    remaining: i64 = n + 1
    while remaining % 2 == 0 |remaining: i64 = remaining| -> remaining:
        remaining <- remaining / 2
    if remaining != 1:
        return 0
    if n == 2:
        return 1
    if n % 2 == 0:
        return 0
    composite: bool =
        while factor <= n / factor |factor: i64 = 3, found: bool = false| -> found:
            if n % factor == 0:
                break true
            factor <- factor + 2
    if composite:
        return 0
    1

export fn mersenne_prime(n: i64) -> i64 = mersenne_prime_impl
