# Stable recursive top-down merge sort with reusable scratch storage.
const MAX_VALUES: usize = 1024

def merge_sorter_range(values: mutable view[i64], scratch: mutable view[i64], low: usize, high: usize) -> void:
    if high - low <= 1:
        return
    middle: usize = low + (high - low) / 2
    merge_sorter_range(values, scratch, low, middle)
    merge_sorter_range(values, scratch, middle, high)
    left: mutable usize = low
    right: mutable usize = middle
    output: mutable usize = low
    while left < middle and right < high:
        if values[left] <= values[right]:
            scratch[output] <- values[left]
            left <- left + 1
        else:
            scratch[output] <- values[right]
            right <- right + 1
        output <- output + 1
    while left < middle:
        scratch[output] <- values[left]
        left <- left + 1
        output <- output + 1
    while right < high:
        scratch[output] <- values[right]
        right <- right + 1
        output <- output + 1
    index: mutable usize = low
    while index < high:
        values[index] <- scratch[index]
        index <- index + 1

def merge_sorter_impl(values: mutable view[i64], length: usize) -> void:
    if length > MAX_VALUES:
        return
    scratch: mutable i64[1024] = zeroed
    merge_sorter_range(values, scratch[0:length], 0, length)

export fn merge_sorter(values: mutable i64&, length: usize) -> void =
    merge_sorter_impl(values[0:length], length)
