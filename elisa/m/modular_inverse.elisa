def normalized_mod(value: i64, modulus: i64) -> i64:
    remainder: i64 = value % modulus
    if remainder < 0:
        remainder = remainder + modulus
    remainder

def modular_inverse_impl(a: i64, modulus: i64) -> i64:
    if a < 0 or a > 1000000 or modulus < 2 or modulus > 1000000:
        return -1

    old_remainder: mutable i64 = normalized_mod(a, modulus)
    remainder: mutable i64 = modulus
    old_coefficient: mutable i64 = 1
    coefficient: mutable i64 = 0
    while remainder != 0:
        quotient: i64 = old_remainder / remainder
        next_remainder: i64 = old_remainder - quotient * remainder
        next_coefficient: i64 = old_coefficient - quotient * coefficient
        old_remainder <- remainder
        remainder <- next_remainder
        old_coefficient <- coefficient
        coefficient <- next_coefficient
    if old_remainder != 1:
        return -1
    normalized_mod(old_coefficient, modulus)

export fn modular_inverse(a: i64, modulus: i64) -> i64 = modular_inverse_impl
