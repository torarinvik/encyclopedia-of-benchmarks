extern trunc(value: f64) -> f64
extern sqrt(value: f64) -> f64
extern log(value: f64) -> f64

const MAX_DRAWS: usize = 128
const MAX_ATTEMPTS: usize = 64
const DRAW_SCALE: f64 = 2147483648.0

def marsaglia_is_bounded_integer(value: f64, minimum: f64, maximum: f64) -> bool:
    value == value and trunc(value) == value and value >= minimum and value <= maximum

def marsaglia_polar_normal_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > 2 + MAX_DRAWS: return -1
    if not marsaglia_is_bounded_integer(input[0], 2.0, MAX_DRAWS.f64()) or
            not marsaglia_is_bounded_integer(input[1], 1.0, MAX_ATTEMPTS.f64()): return -1
    draw_count: usize = input[0].usize()
    attempt_cap: usize = input[1].usize()
    if draw_count % 2 != 0 or length != 2 + draw_count or draw_count < 2 * attempt_cap: return -1
    index: mutable usize = 0
    while index < draw_count:
        if not marsaglia_is_bounded_integer(input[2 + index], 0.0, 4294967295.0): return -1
        index <- index + 1

    first: mutable f64 = 0.0
    second: mutable f64 = 0.0
    accepted: mutable bool = false
    attempt: mutable usize = 0
    while attempt < attempt_cap:
        u1: f64 = input[2 + 2 * attempt] / DRAW_SCALE - 1.0
        u2: f64 = input[3 + 2 * attempt] / DRAW_SCALE - 1.0
        radius_squared: f64 = u1 * u1 + u2 * u2
        if radius_squared > 0.0 and radius_squared < 1.0:
            scale: f64 = sqrt(-2.0 * log(radius_squared) / radius_squared)
            first <- u1 * scale
            second <- u2 * scale
            accepted <- true
            break
        attempt <- attempt + 1
    if not accepted: return -1
    if output.is_null() or capacity < 2: return -2
    output[0] <- first
    output[1] <- second
    2

export fn marsaglia_polar_normal(input: f64&, length: usize,
    output: mutable f64&, capacity: usize) -> i64 = marsaglia_polar_normal_impl
