const MPCC_MAX_INPUT: usize = 259
const MPCC_MAX_OUTPUT: usize = 2040
const MPCC_MAX_N: usize = 128
const MPCC_MAX_M: usize = 128

def mpcc_store_i64(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def min_plus_convolution_convex_convex_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > MPCC_MAX_INPUT: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 128 or m_value < 1 or m_value > 128: return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + n + m: return -1
    a: mutable i64[MPCC_MAX_N] = zeroed
    b: mutable i64[MPCC_MAX_M] = zeroed
    index: mutable usize = 0
    while index < n + m:
        value: i64 = input[2 + index]
        if value < 0 or value > 1000000000: return -1
        if index < n: a[index] <- value
        else: b[index - n] <- value
        index <- index + 1

    index <- 0
    while index + 2 < n:
        if a[index + 1] - a[index] > a[index + 2] - a[index + 1]: return -1
        index <- index + 1
    index <- 0
    while index + 2 < m:
        if b[index + 1] - b[index] > b[index + 2] - b[index + 1]: return -1
        index <- index + 1

    count: usize = n + m - 1
    bytes: usize = 8 * count
    if bytes > MPCC_MAX_OUTPUT: return -1
    if output.is_null() or capacity < bytes: return -2

    result: mutable i64[MPCC_MAX_N + MPCC_MAX_M - 1] = zeroed
    result[0] <- a[0] + b[0]
    ai: mutable usize = 0
    bi: mutable usize = 0
    out: mutable usize = 1
    while ai + 1 < n or bi + 1 < m:
        slope: mutable i64 = 0
        if bi + 1 == m or (ai + 1 < n and a[ai + 1] - a[ai] <= b[bi + 1] - b[bi]):
            slope <- a[ai + 1] - a[ai]
            ai <- ai + 1
        else:
            slope <- b[bi + 1] - b[bi]
            bi <- bi + 1
        result[out] <- result[out - 1] + slope
        out <- out + 1

    output_view: mutable view[u8] = output[0:bytes]
    index <- 0
    while index < count:
        mpcc_store_i64(result[index], output_view, index * 8)
        index <- index + 1
    bytes.i64()

export fn min_plus_convolution_convex_convex(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = min_plus_convolution_convex_convex_impl
