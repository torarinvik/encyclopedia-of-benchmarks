# Binary exponentiation under a positive signed 32-bit modulus.
def modular_exponentiation_impl(values: i64&, length: usize) -> i64:
    if length != 3:
        return -1
    base_input: i64 = values[0]
    exponent_input: i64 = values[1]
    modulus: i64 = values[2]
    if base_input < -2147483648 or base_input > 2147483647 or exponent_input < 0 or exponent_input > 2147483647 or modulus < 1 or modulus > 2147483647:
        return -1
    base: mutable i64 = base_input % modulus
    if base < 0:
        base <- base + modulus
    exponent: mutable u64 = exponent_input.u64()
    result: mutable i64 = 1 % modulus
    while exponent != 0:
        if (exponent & 1.u64()) != 0.u64():
            result <- (result * base) % modulus
        base <- (base * base) % modulus
        exponent <- exponent >> 1
    result

export fn modular_exponentiation(values: i64&, length: usize) -> i64 = modular_exponentiation_impl
