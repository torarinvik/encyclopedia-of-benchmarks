def matchdimensions_impl(values: i64&, length: usize) -> i64:
    if values == null or length != 4:
        return -1
    for index in 0..<4:
        if values[index] < 0 or values[index] > 65535:
            return -1
    if values[0] == values[2] and values[1] == values[3]:
        return 1
    0

export fn matchdimensions(values: i64&, length: usize) -> i64 = matchdimensions_impl
