const MAX_INPUT: usize = 130
const MAX_OUTPUT: usize = 512
const MAX_DIM: usize = 8
const INF: i64 = 1000000

def store_i64(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def min_plus_distance_product_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 4 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 8 or m64 < 1 or m64 > 8: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * n * m: return -1
    i: mutable usize = 2
    while i < length:
        if input[i] < 0 or (input[i] > 1000 and input[i] != INF): return -1
        i <- i + 1
    bytes: usize = 8 * n * n
    if bytes > MAX_OUTPUT: return -1
    if output == null or capacity < bytes: return -2
    # Like the C reference, a = input + 2 and b = input + 2 + n * m are read in place.
    a_start: usize = 2
    b_start: usize = 2 + n * m
    result: mutable i64[MAX_DIM * MAX_DIM] = zeroed
    i <- 0
    while i < n:
        j: mutable usize = 0
        while j < n:
            best: mutable i64 = INF
            k: mutable usize = 0
            while k < m:
                x: i64 = input[a_start + i * m + k]
                y: i64 = input[b_start + k * n + j]
                if x != INF and y != INF and x + y < best: best <- x + y
                k <- k + 1
            result[i * n + j] <- best
            j <- j + 1
        i <- i + 1
    output_view: mutable u8& = output
    i <- 0
    while i < n * n:
        store_i64(result[i], output_view, 8 * i)
        i <- i + 1
    bytes.i64()

export fn min_plus_distance_product(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = min_plus_distance_product_impl
