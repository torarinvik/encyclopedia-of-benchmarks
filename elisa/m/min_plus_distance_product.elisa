const MAX_INPUT: usize = 130
const MAX_OUTPUT: usize = 512
const INF: i64 = 1000000

def store_i64(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def min_plus_distance_product(input: i64&, length: usize,
                              output: mutable u8&, capacity: usize) -> i64
    @export("min_plus_distance_product"):
    if input.is_null() or length < 4 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 8 or m64 < 1 or m64 > 8 or length != 2 + 2 * n64.usize() * m64.usize(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    i: mutable usize = 2
    while i < length:
        if input[i] < 0 or (input[i] > 1000 and input[i] != INF): return -1
        i <- i + 1
    bytes: usize = 8 * n * n
    if bytes > MAX_OUTPUT: return -1
    if output.is_null() or capacity < bytes: return -2
    result: mutable i64[64] = zeroed
    i <- 0
    while i < n:
        j: mutable usize = 0
        while j < n:
            best: mutable i64 = INF
            k: mutable usize = 0
            while k < m:
                x: i64 = input[2 + i * m + k]
                y: i64 = input[2 + n * m + k * n + j]
                if x != INF and y != INF and x + y < best: best <- x + y
                k <- k + 1
            result[i * n + j] <- best
            j <- j + 1
        i <- i + 1
    i <- 0
    while i < n * n:
        store_i64(result[i], output, 8 * i)
        i <- i + 1
    bytes.i64()
