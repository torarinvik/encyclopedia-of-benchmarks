const MAX_INPUT: usize = 34

def minimum_coin_change_combinations_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    target: i64 = input[0]
    count_value: i64 = input[1]
    if target < -64 or target > 64 or count_value < 0 or count_value > 32: return -1
    count: usize = count_value.usize()
    if length != count + 2: return -1

    previous: i64 = 0
    index: mutable usize = 0
    while index < count:
        coin: i64 = input[2 + index]
        if coin < 1 or coin > 64 or coin <= previous: return -1
        previous <- coin
        index <- index + 1

    if target < 0: return 0
    ways: mutable i64[65] = zeroed
    ways[0] <- 1
    coin_index: mutable usize = 0
    while coin_index < count:
        coin: usize = input[2 + coin_index].usize()
        amount: mutable usize = coin
        target_size: usize = target.usize()
        while amount <= target_size:
            ways[amount] <- ways[amount] + ways[amount - coin]
            amount <- amount + 1
        coin_index <- coin_index + 1
    ways[target.usize()]

export fn minimum_coin_change_combinations(input: i64&, length: usize) -> i64 = minimum_coin_change_combinations_impl
