const MAX_OPERATIONS: usize = 256
const MAX_INPUT_LENGTH: usize = 514
const MAX_LIVE_VALUES: usize = 64
const NIL_SENTINEL: i64 = -9223372036854775807 - 1

def median_heap_store_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255.u64()).u8()
        bits <- bits >> 8

def median_heap_push_max(heap: mutable view[i32], count: mutable usize&, value: i32) -> void:
    position: mutable usize = count
    count <- count + 1
    while position > 0 and heap[(position - 1) / 2] < value:
        parent: usize = (position - 1) / 2
        heap[position] <- heap[parent]
        position <- parent
    heap[position] <- value

def median_heap_pop_max(heap: mutable view[i32], count: mutable usize&) -> i32:
    result: i32 = heap[0]
    count <- count - 1
    value: i32 = heap[count]
    if count == 0: return result
    position: mutable usize = 0
    while 2 * position + 1 < count:
        child: mutable usize = 2 * position + 1
        if child + 1 < count and heap[child + 1] > heap[child]: child <- child + 1
        if heap[child] <= value: break
        heap[position] <- heap[child]
        position <- child
    heap[position] <- value
    result

def median_heap_push_min(heap: mutable view[i32], count: mutable usize&, value: i32) -> void:
    position: mutable usize = count
    count <- count + 1
    while position > 0 and heap[(position - 1) / 2] > value:
        parent: usize = (position - 1) / 2
        heap[position] <- heap[parent]
        position <- parent
    heap[position] <- value

def median_heap_pop_min(heap: mutable view[i32], count: mutable usize&) -> i32:
    result: i32 = heap[0]
    count <- count - 1
    value: i32 = heap[count]
    if count == 0: return result
    position: mutable usize = 0
    while 2 * position + 1 < count:
        child: mutable usize = 2 * position + 1
        if child + 1 < count and heap[child + 1] < heap[child]: child <- child + 1
        if heap[child] >= value: break
        heap[position] <- heap[child]
        position <- child
    heap[position] <- value
    result

def median_heap_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH: return -1
    operation_count_value: i64 = input[0]
    if operation_count_value < 0 or operation_count_value > 256 or length != 1 + 2 * operation_count_value.usize(): return -1
    operation_count: usize = operation_count_value.usize()
    lower: mutable i32[64] = zeroed
    upper: mutable i32[64] = zeroed
    lower_count: mutable usize = 0
    upper_count: mutable usize = 0
    results: mutable i64[256] = zeroed
    for index in 0..<operation_count:
        opcode: i64 = input[1 + 2 * index]
        argument: i64 = input[2 + 2 * index]
        if opcode == 0:
            if argument < -2147483648 or argument > 2147483647 or lower_count + upper_count >= MAX_LIVE_VALUES: return -1
            value: i32 = argument.i32()
            if lower_count == 0:
                median_heap_push_max(lower[0:64], &lower_count, value)
            else if value < lower[0]:
                median_heap_push_max(lower[0:64], &lower_count, value)
                if lower_count > upper_count + 1:
                    median_heap_push_min(upper[0:64], &upper_count, median_heap_pop_max(lower[0:64], &lower_count))
            else:
                median_heap_push_min(upper[0:64], &upper_count, value)
                if lower_count < upper_count:
                    median_heap_push_max(lower[0:64], &lower_count, median_heap_pop_min(upper[0:64], &upper_count))
            results[index] <- NIL_SENTINEL
        else if opcode >= 1 and opcode <= 4:
            if argument != 0: return -1
            if opcode == 1:
                results[index] <- if lower_count > 0: lower[0].i64() else: NIL_SENTINEL
            else if opcode == 2:
                if lower_count == 0:
                    results[index] <- NIL_SENTINEL
                else:
                    results[index] <- median_heap_pop_max(lower[0:64], &lower_count).i64()
                    if lower_count < upper_count:
                        median_heap_push_max(lower[0:64], &lower_count, median_heap_pop_min(upper[0:64], &upper_count))
            else if opcode == 3:
                results[index] <- (lower_count + upper_count).i64()
            else:
                results[index] <- if lower_count == 0: 1 else: 0
        else:
            return -1
    output_bytes: usize = operation_count * 8
    if output == null or capacity < output_bytes: return -2
    for index in 0..<operation_count:
        median_heap_store_i64(output[0:output_bytes], index * 8, results[index])
    output_bytes.i64()

export fn median_heap(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = median_heap_impl
