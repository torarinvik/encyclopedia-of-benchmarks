# Sort values and grow the longest affordable window.
def maximum_frequency_after_increments_impl(input: i64&, length: usize) -> i64:
    if length < 1 or length > 257:
        return -1
    budget: i64 = input[0]
    count: usize = length - 1
    if budget < 0 or budget > 1000000:
        return -1
    values: mutable i64[256] = zeroed
    for index in 0..<count |input, values|:
        value: i64 = input[index + 1]
        if value < 1 or value > 10000:
            return -1
        position: mutable usize = index
        while position > 0 and values[position - 1] > value |position, values|:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- value
    left: mutable usize = 0
    # At most 256 validated values contribute 10,000 each. The sorted
    # window sum cannot exceed the rightmost value times its width.
    window_sum: mutable u32 = 0
    best: mutable usize = 0
    available: u32 = budget.u32()
    for right in 0..<count |values, left, window_sum, best|:
        target: u32 = values[right].u32()
        window_sum <- window_sum + target
        while target * (right - left + 1).u32() - window_sum > available |values, left, window_sum|:
            window_sum <- window_sum - values[left].u32()
            left <- left + 1
        window_length: usize = right - left + 1
        if window_length > best:
            best <- window_length
    best.i64()

export fn maximum_frequency_after_increments(input: i64&, length: usize) -> i64 = maximum_frequency_after_increments_impl
