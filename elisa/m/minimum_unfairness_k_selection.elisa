const MUKS_MAX_N: usize = 64
const MUKS_MIN_VALUE: i64 = -1000000000
const MUKS_MAX_VALUE: i64 = 1000000000

def muks_sift_down(values: mutable view[i64], root_start: usize, end: usize) -> void:
    root: mutable usize = root_start
    while root < end / 2:
        child: mutable usize = root * 2 + 1
        if child + 1 < end and values[child] < values[child + 1]:
            child <- child + 1
        if values[root] >= values[child]:
            break
        temporary: i64 = values[root]
        values[root] <- values[child]
        values[child] <- temporary
        root <- child

def muks_heap_sort(values: mutable view[i64], length: usize) -> void:
    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        muks_sift_down(values, start, length)
    ending: mutable usize = length
    while ending > 1:
        ending <- ending - 1
        temporary: i64 = values[0]
        values[0] <- values[ending]
        values[ending] <- temporary
        muks_sift_down(values, 0, ending)

def minimum_unfairness_k_selection_impl(packed: i64&, length: usize) -> i64:
    if packed == null or length < 4 or length > MUKS_MAX_N + 2:
        return -1
    n_value: i64 = packed[0]
    k_value: i64 = packed[1]
    if n_value < 2 or n_value > MUKS_MAX_N.i64() or k_value < 2 or k_value > n_value or length != n_value.usize() + 2:
        return -1
    n: usize = n_value.usize()
    k: usize = k_value.usize()
    sorted: mutable i64[MUKS_MAX_N] = zeroed
    index: mutable usize = 0
    while index < n:
        value: i64 = packed[index + 2]
        if value < MUKS_MIN_VALUE or value > MUKS_MAX_VALUE:
            return -1
        sorted[index] <- value
        index <- index + 1
    muks_heap_sort(sorted[0:n], n)
    best: mutable i64 = 2000000001
    first: mutable usize = 0
    while first + k <= n:
        width: i64 = sorted[first + k - 1] - sorted[first]
        if width < best:
            best <- width
        first <- first + 1
    best

export fn minimum_unfairness_k_selection(packed: i64&, length: usize) -> i64 = minimum_unfairness_k_selection_impl
