const MAX_K: usize = 8
const MAX_N: usize = 32
const EMPTY_RANK: i64 = 1001

def min_hash_partition_put(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def min_hash_k_partition(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("min_hash_k_partition"):
    if input.is_null() or length < 2 or length > 66: return -1
    k_value: i64 = input[0]
    n_value: i64 = input[1]
    if k_value < 1 or k_value > 8 or n_value < 0 or n_value > 32 or length != (2 + 2 * n_value).usize(): return -1
    k: usize = k_value.usize()
    n: usize = n_value.usize()
    ids: mutable i64[8] = zeroed
    ranks: mutable i64[8] = zeroed
    bucket: mutable usize = 0
    while bucket < k:
        ids[bucket] <- -1
        ranks[bucket] <- EMPTY_RANK
        bucket <- bucket + 1
    item: mutable usize = 0
    while item < n:
        b: i64 = input[2 + 2 * item]
        rank: i64 = input[3 + 2 * item]
        if b < 0 or b >= k_value or rank < 0 or rank > 1000: return -1
        bi: usize = b.usize()
        if ids[bi] < 0 or rank < ranks[bi] or (rank == ranks[bi] and item.i64() < ids[bi]):
            ids[bi] <- item.i64()
            ranks[bi] <- rank
        item <- item + 1
    staged: mutable i64[16] = zeroed
    bucket <- 0
    while bucket < k:
        staged[2 * bucket] <- ids[bucket]
        staged[2 * bucket + 1] <- ranks[bucket]
        bucket <- bucket + 1
    required: usize = 2 * k * 8
    if output.is_null() or capacity < required: return -2
    item <- 0
    while item < 2 * k:
        min_hash_partition_put(output, item * 8, staged[item])
        item <- item + 1
    return required.i64()
