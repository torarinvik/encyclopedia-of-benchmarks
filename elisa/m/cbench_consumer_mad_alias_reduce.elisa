const CS: i64[8] = [0x0db84a81, 0x0e1b9d7f, 0x0f31adcf, 0x0fbba815, 0x0feda417, 0x0ffc8fc8, 0x0fff964c, 0x0ffff8d3]
const CA: i64[8] = [-0x083b5fe7, -0x078c36d2, -0x05039814, -0x02e91dd1, -0x0183603a, -0x00a7cb87, -0x003a2847, -0x000f27b4]

def floor_div(value: i64, divisor: i64) -> i64:
    quotient: i64 = value / divisor
    if value % divisor < 0: return quotient - 1
    return quotient

def mad_mul(left: i64, right: i64) -> i64:
    return floor_div(left + 2048, 4096) * floor_div(right + 32768, 65536)

def write_i32_le(output: mutable view[u8], offset: usize, value: i64):
    byte: mutable usize = 0
    while byte < 4:
        shifted: i64 = floor_div(value, (1 << (8 * byte)).i64())
        part: mutable i64 = shifted % 256
        if part < 0: part <- part + 256
        output[offset + byte] <- part.u8()
        byte <- byte + 1

def cbench_consumer_mad_alias_reduce_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > 65: return -1
    if input[0] < 1 or input[0] > 4: return -1
    boundaries: usize = input[0].usize()
    if length != 1 + 16 * boundaries: return -1
    i: mutable usize = 1
    while i < length:
        if input[i] < -100000000 or input[i] > 100000000: return -1
        i <- i + 1
    output_size: usize = 64 * boundaries
    staged: mutable i64[64] = zeroed
    boundary: mutable usize = 0
    while boundary < boundaries:
        base: usize = 1 + 16 * boundary
        i <- 0
        while i < 8:
            a: i64 = input[base + 2 * i]
            b: i64 = input[base + 2 * i + 1]
            staged[16 * boundary + 2 * i] <- mad_mul(a, CS[i]) + mad_mul(-b, CA[i])
            staged[16 * boundary + 2 * i + 1] <- mad_mul(b, CS[i]) + mad_mul(a, CA[i])
            i <- i + 1
        boundary <- boundary + 1
    if output == null or capacity < output_size: return -2
    output_view: mutable view[u8] = output[0:output_size]
    i <- 0
    while i < 16 * boundaries:
        write_i32_le(output_view, 4 * i, staged[i])
        i <- i + 1
    return output_size.i64()

export fn cbench_consumer_mad_alias_reduce(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = cbench_consumer_mad_alias_reduce_impl
