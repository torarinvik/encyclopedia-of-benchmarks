def max_69_number_impl(value: i64) -> i64:
    if value < 1 or value > 999999999999999999:
        return -1
    place: mutable i64 = 1
    while place <= value / 10:
        place <- place * 10
    while place > 0:
        digit: i64 = (value / place) % 10
        if digit == 6:
            return value + 3 * place
        if digit != 9:
            return -1
        place <- place / 10
    -1

export fn max_69_number(value: i64) -> i64 = max_69_number_impl
