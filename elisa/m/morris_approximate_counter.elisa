# Deterministic tape replay for the original base-2 Morris counter.
const MAX_UPDATES: usize = 53
const DRAW_BITS: usize = 53
const MAX_INPUT_VALUES: usize = 1 + MAX_UPDATES
const DRAW_LIMIT: u64 = 1.u64() << DRAW_BITS

def morris_approximate_counter_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def morris_approximate_counter(input: i64&, input_length: usize,
                               output: mutable u8&, output_capacity: usize) -> i64
        @export("morris_approximate_counter"):
    if input.is_null() or input_length < 1 or input_length > MAX_INPUT_VALUES:
        return -1
    updates_value: i64 = input[0]
    if updates_value < 1 or updates_value > 53: return -1
    updates: usize = updates_value.usize()
    if input_length != 1 + updates: return -1

    state: mutable usize = 0
    for event in 0..updates:
        draw_value: i64 = input[1 + event]
        if draw_value < 0 or draw_value.u64() >= DRAW_LIMIT: return -1
        threshold: u64 = 1.u64() << (DRAW_BITS - state)
        if draw_value.u64() < threshold: state <- state + 1

    if output.is_null() or output_capacity < 16: return -2
    estimate: i64 = ((1.u64() << state) - 1.u64()).i64()
    morris_approximate_counter_store_i64(output, 0, state.i64())
    morris_approximate_counter_store_i64(output, 8, estimate)
    16
