const MAX_TEXT: usize = 128

def minimum_window_substring_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > 258 or input[0] < 0 or input[0] > MAX_TEXT.i64(): return -1
    s: usize = input[0].usize()
    if length < s + 2: return -1
    if input[s + 1] < 1 or input[s + 1] > MAX_TEXT.i64(): return -1
    t: usize = input[s + 1].usize()
    if length != s + t + 2: return -1
    need: mutable i64[128]
    i: usize = 0
    while i < s:
        if input[i + 1] < 0 or input[i + 1] > 127: return -1
        i <- i + 1
    i <- 0
    while i < t:
        c: i64 = input[s + 2 + i]
        if c < 0 or c > 127: return -1
        need[c.usize()] <- need[c.usize()] + 1
        i <- i + 1
    left: mutable usize = 0
    best: mutable usize = s + 1
    start: mutable usize = 0
    missing: mutable i64 = t.i64()
    right: usize = 0
    while right < s:
        c: usize = input[right + 1].usize()
        if need[c] > 0: missing <- missing - 1
        need[c] <- need[c] - 1
        while missing == 0:
            size: usize = right - left + 1
            if size < best:
                best <- size
                start <- left
            x: usize = input[left + 1].usize()
            need[x] <- need[x] + 1
            left <- left + 1
            if need[x] > 0: missing <- missing + 1
        right <- right + 1
    if best == s + 1: return 0
    if best > capacity or (best > 0 and output.is_null()): return -2
    i <- 0
    while i < best:
        output[i] <- input[start + 1 + i].u8()
        i <- i + 1
    best.i64()

export fn minimum_window_substring(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = minimum_window_substring_impl
