def max_character_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 256:
        return -1
    counts: mutable i64[26] = zeroed
    for index in 0..<length:
        value: i64 = values[index]
        if value < 97 or value > 122:
            return -1
        counts[value - 97] += 1
    best: i64 = 0
    code: i64 = -1
    tied: bool = false
    for index in 0..<26:
        if counts[index] > best:
            best = counts[index]
            code = 97 + index
            tied = false
        elif counts[index] == best and best != 0:
            tied = true
    if tied:
        return -1
    code

export fn max_character(values: i64&, length: usize) -> i64 = max_character_impl
