def modular_power(a: i64, exponent: i64, modulus: i64) -> i64:
    if exponent == 0: return 1
    if exponent % 2 == 1: return (modular_power(a, exponent - 1, modulus) * a) % modulus
    half: i64 = modular_power(a, exponent / 2, modulus)
    (half * half) % modulus

def modular_binary_exponentiation_recursive_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 3: return -1
    a: i64 = input[0]
    exponent: i64 = input[1]
    modulus: i64 = input[2]
    if a < 0 or a > 1000000 or exponent < 0 or exponent > 60 or modulus < 2 or modulus > 1000000: return -1
    modular_power(a, exponent, modulus)

export fn modular_binary_exponentiation_recursive(input: i64&, length: usize) -> i64 = modular_binary_exponentiation_recursive_impl
