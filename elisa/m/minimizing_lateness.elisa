# Stable earliest-deadline-first schedule with bounded int32 records.
const ML_MAX_JOBS: usize = 64
const ML_MAX_OUTPUT: usize = 4 + 12 * ML_MAX_JOBS

def ml_write_i32(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u32 = value.u32()
    output[offset] <- (bits & 255).u8()
    output[offset + 1] <- ((bits >> 8) & 255).u8()
    output[offset + 2] <- ((bits >> 16) & 255).u8()
    output[offset + 3] <- ((bits >> 24) & 255).u8()

def minimizing_lateness_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 1 or length > 1 + 2 * ML_MAX_JOBS:
        return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > ML_MAX_JOBS.i64():
        return -1
    count: usize = count_value.usize()
    if length != 1 + 2 * count:
        return -1

    processing: mutable i64[ML_MAX_JOBS] = zeroed
    deadlines: mutable i64[ML_MAX_JOBS] = zeroed
    original: mutable i64[ML_MAX_JOBS] = zeroed
    start_times: mutable i64[ML_MAX_JOBS] = zeroed
    lateness: mutable i64[ML_MAX_JOBS] = zeroed
    total_processing: mutable i64 = 0
    for index in 0..<count:
        p: i64 = input[1 + 2 * index]
        d: i64 = input[2 + 2 * index]
        if p < 0 or p > 2147483647 or d < 0 or d > 2147483647:
            return -1
        total_processing <- total_processing + p
        if total_processing > 2147483647:
            return -1
        processing[index] <- p
        deadlines[index] <- d
        original[index] <- index.i64()

    # Stable insertion sort leaves equal-deadline jobs in source order.
    index: mutable usize = 1
    while index < count:
        item_processing: i64 = processing[index]
        item_deadline: i64 = deadlines[index]
        item_original: i64 = original[index]
        position: mutable usize = index
        while position > 0 and deadlines[position - 1] > item_deadline:
            processing[position] <- processing[position - 1]
            deadlines[position] <- deadlines[position - 1]
            original[position] <- original[position - 1]
            position <- position - 1
        processing[position] <- item_processing
        deadlines[position] <- item_deadline
        original[position] <- item_original
        index <- index + 1

    start_time: mutable i64 = 0
    for index in 0..<count:
        start_times[index] <- start_time
        finish_time: i64 = start_time + processing[index]
        difference: i64 = finish_time - deadlines[index]
        lateness[index] <- if difference > 0: difference else: 0
        start_time <- finish_time

    needed: usize = 4 + 12 * count
    if output == null or output_capacity < needed:
        return -2
    payload: mutable u8[ML_MAX_OUTPUT] = zeroed
    ml_write_i32(payload[0], 0, count.i64())
    for index in 0..<count:
        offset: usize = 4 + 12 * index
        ml_write_i32(payload[0], offset, original[index])
        ml_write_i32(payload[0], offset + 4, start_times[index])
        ml_write_i32(payload[0], offset + 8, lateness[index])
    for index in 0..<needed:
        output[index] <- payload[index]
    needed.i64()

export fn minimizing_lateness(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = minimizing_lateness_impl
