# Buy the largest affordable prefix after sorting the prices.
def maximum_ice_cream_bars_impl(input: i64&, length: usize) -> i64:
    if length < 1 or length > 257:
        return -1
    coins: mutable i64 = input[0]
    count: usize = length - 1
    if coins < 0 or coins > 1000000:
        return -1
    costs: mutable i64[256] = zeroed
    for index in 0..<count |input, costs|:
        cost: i64 = input[index + 1]
        if cost < 1 or cost > 10000:
            return -1
        position: mutable usize = index
        while position > 0 and costs[position - 1] > cost |position, costs|:
            costs[position] <- costs[position - 1]
            position <- position - 1
        costs[position] <- cost
    bought: mutable i64 = 0
    for index in 0..<count |coins, bought, costs|:
        if costs[index] > coins:
            break
        coins <- coins - costs[index]
        bought <- bought + 1
    bought

export fn maximum_ice_cream_bars(input: i64&, length: usize) -> i64 = maximum_ice_cream_bars_impl
