# Recursive maximum-difference pair with the pinned Python tie order.
def solve(values: view[i64], start: usize, n: usize, small_out: mutable i64&, big_out: mutable i64&) -> void:
    if n == 1:
        small_out <- values[start]
        big_out <- values[start]
        return
    left_n: usize = n / 2
    left_small: mutable i64 = 0
    left_big: mutable i64 = 0
    right_small: mutable i64 = 0
    right_big: mutable i64 = 0
    solve(values, start, left_n, left_small, left_big)
    solve(values, start + left_n, n - left_n, right_small, right_big)
    min_left: mutable i64 = values[start]
    max_right: mutable i64 = values[start + left_n]
    i: mutable usize = start + 1
    while i < start + left_n:
        if values[i] < min_left: min_left <- values[i]
        i <- i + 1
    i <- start + left_n + 1
    while i < start + n:
        if values[i] > max_right: max_right <- values[i]
        i <- i + 1
    cross: i64 = max_right - min_left
    right_diff: i64 = right_big - right_small
    left_diff: i64 = left_big - left_small
    if right_diff > cross and right_diff > left_diff:
        small_out <- right_small
        big_out <- right_big
    elif left_diff > cross:
        small_out <- left_small
        big_out <- left_big
    else:
        small_out <- min_left
        big_out <- max_right

def put_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    b: mutable usize = 0
    while b < 8:
        output[offset + b] <- (bits & 255).u8()
        bits <- bits >> 8
        b <- b + 1

def max_difference_pair_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2 or input[0] < 1 or input[0] > 128: return -1
    n: usize = input[0].usize()
    if length != n + 1: return -1
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < -1000000 or input[i + 1] > 1000000: return -1
        i <- i + 1
    if capacity < 16: return -2
    output_view: mutable view[u8] = output[0:16]
    small: mutable i64 = 0
    big: mutable i64 = 0
    solve(input[0:length], 1, n, small, big)
    put_i64_le(small, output_view, 0)
    put_i64_le(big, output_view, 8)
    16

export fn max_difference_pair(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = max_difference_pair_impl
