const MAX_N: usize = 128
def majority_element_sort_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_N: return -1
    values: mutable i32[MAX_N]
    i: usize = 0
    while i < length:
        if input[i] < -2147483648 or input[i] > 2147483647: return -1
        values[i] <- input[i].i32()
        i <- i + 1
    i <- 1
    while i < length:
        value: i32 = values[i]
        j: mutable usize = i
        while j > 0 and values[j - 1] > value:
            values[j] <- values[j - 1]
            j <- j - 1
        values[j] <- value
        i <- i + 1
    run: mutable usize = 1
    i <- 1
    while i < length:
        if values[i] == values[i - 1]: run <- run + 1
        else: run <- 1
        if run > length / 2: return values[i].i64()
        i <- i + 1
    -1
export fn majority_element_sort(input: i64&, length: usize) -> i64 = majority_element_sort_impl
