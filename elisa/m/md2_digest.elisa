const MD2_MAX_INPUT_LENGTH: usize = 63
const MD2_DIGEST_LENGTH: usize = 16

def md2_digest_impl(input: f64&, length: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if length > MD2_MAX_INPUT_LENGTH or (length > 0 and input.is_null()):
        return -1
    table: u8[256] = [
        41,46,67,201,162,216,124,1,61,54,84,161,236,240,6,19,98,167,5,243,192,199,115,140,152,147,43,217,188,76,130,202,
        30,155,87,60,253,212,224,22,103,66,111,24,138,23,229,18,190,78,196,214,218,158,222,73,160,251,245,142,187,47,238,122,
        169,104,121,145,21,178,7,63,148,194,16,137,11,34,95,33,128,127,93,154,90,144,50,39,53,62,204,231,191,247,151,3,
        255,25,48,179,72,165,181,209,215,94,146,42,172,86,170,198,79,184,56,210,150,164,125,182,118,252,107,226,156,116,4,241,
        69,157,112,89,100,113,135,32,134,91,207,101,230,45,168,2,27,96,37,173,174,176,185,246,28,70,97,105,52,64,126,15,
        85,71,163,35,221,81,175,58,195,92,249,206,186,197,234,38,44,83,13,110,133,40,132,9,211,223,205,244,65,129,77,82,
        106,220,55,200,108,193,171,250,36,225,123,8,12,189,177,74,120,136,149,139,227,99,232,109,233,203,213,254,59,0,29,57,
        242,239,183,14,102,88,208,228,166,119,114,248,235,117,75,10,49,68,80,180,143,237,31,26,219,153,141,51,159,17,131,20]
    bytes: mutable u8[64] = zeroed
    for index in 0..<length:
        value: f64 = input[index]
        if value != value or value < 0.0 or value > 255.0 or value != value.i64().f64():
            return -1
        bytes[index] <- value.u8()
    if output.is_null() or output_capacity < MD2_DIGEST_LENGTH:
        return -2

    padding_length: usize = MD2_DIGEST_LENGTH - length % MD2_DIGEST_LENGTH
    padded_length: usize = length + padding_length
    for index in length..<padded_length:
        bytes[index] <- padding_length.u8()
    checksum: mutable u8[16] = zeroed
    last: mutable u8 = 0
    offset: mutable usize = 0
    while offset < padded_length |bytes, checksum, last, offset|:
        for index in 0..<MD2_DIGEST_LENGTH:
            checksum[index] <- checksum[index] ^ table[(bytes[offset + index] ^ last).usize()]
            last <- checksum[index]
        offset <- offset + MD2_DIGEST_LENGTH

    state: mutable u8[48] = zeroed
    offset <- 0
    while offset <= padded_length |bytes, checksum, state, offset|:
        for index in 0..<MD2_DIGEST_LENGTH:
            value: u8 = checksum[index]
            if offset < padded_length:
                value = bytes[offset + index]
            state[index + 16] <- value
            state[index + 32] <- state[index] ^ value
        temporary: mutable u8 = 0
        for round in 0..<18:
            for index in 0..<48:
                state[index] <- state[index] ^ table[temporary.usize()]
                temporary <- state[index]
            temporary <- ((temporary.u16() + round.u16()) % 256).u8()
        offset <- offset + MD2_DIGEST_LENGTH
    for index in 0..<MD2_DIGEST_LENGTH:
        output[index] <- state[index].f64()
    MD2_DIGEST_LENGTH.i64()

export fn md2_digest(input: f64&, length: usize, output: mutable f64&, output_capacity: usize) -> i64 = md2_digest_impl
