const MMWS_MAX_TEXT: usize = 64
const MMWS_MAX_WORDS: usize = 16
const MMWS_MAX_WORD_LENGTH: usize = 8
const MMWS_MAX_PARSEABLE_LENGTH: usize = 211
const MMWS_MAX_OUTPUT_BYTES: usize = 65

def maximum_matching_word_segmentation_impl(
    input: view[i64], length: usize, output: mutable view[u8], output_capacity: usize,
    output_is_null: bool) -> i64:
    if length < 2 or length > MMWS_MAX_PARSEABLE_LENGTH:
        return -1
    text_length_value: i64 = input[0]
    word_count_value: i64 = input[1]
    if text_length_value < 0 or text_length_value > MMWS_MAX_TEXT.i64() or
        word_count_value < 0 or word_count_value > MMWS_MAX_WORDS.i64():
        return -1
    text_length: usize = text_length_value.usize()
    word_count: usize = word_count_value.usize()
    if length < 2 + text_length:
        return -1
    position: mutable usize = 0
    while position < text_length:
        if input[2 + position] < 97 or input[2 + position] > 122:
            return -1
        position <- position + 1

    word_offsets: mutable usize[MMWS_MAX_WORDS] = zeroed
    word_lengths: mutable usize[MMWS_MAX_WORDS] = zeroed
    cursor: mutable usize = 2 + text_length
    word: mutable usize = 0
    while word < word_count:
        if cursor >= length:
            return -1
        word_length_value: i64 = input[cursor]
        cursor <- cursor + 1
        if word_length_value < 1 or word_length_value > MMWS_MAX_WORD_LENGTH.i64():
            return -1
        word_length: usize = word_length_value.usize()
        if word_length > length - cursor:
            return -1
        word_offsets[word] <- cursor
        word_lengths[word] <- word_length
        offset: mutable usize = 0
        while offset < word_length:
            if input[cursor + offset] < 97 or input[cursor + offset] > 122:
                return -1
            offset <- offset + 1
        cursor <- cursor + word_length
        word <- word + 1
    if cursor != length:
        return -1

    token_ids: mutable u8[MMWS_MAX_TEXT] = zeroed
    token_count: mutable usize = 0
    position <- 0
    while position < text_length:
        best_length: mutable usize = 0
        best_id: mutable u8 = 0.u8()
        word <- 0
        while word < word_count:
            candidate_length: usize = word_lengths[word]
            if candidate_length > best_length and candidate_length <= text_length - position:
                offset <- 0
                while offset < candidate_length and input[word_offsets[word] + offset] == input[2 + position + offset]:
                    offset <- offset + 1
                if offset == candidate_length:
                    best_length <- candidate_length
                    best_id <- (word + 1).u8()
            word <- word + 1
        token_ids[token_count] <- best_id
        token_count <- token_count + 1
        if best_length == 0:
            position <- position + 1
        else:
            position <- position + best_length

    output_length: usize = token_count + 1
    if output_is_null or output_capacity < output_length:
        return -2
    output[0] <- token_count.u8()
    index: mutable usize = 0
    while index < token_count:
        output[index + 1] <- token_ids[index]
        index <- index + 1
    output_length.i64()

export fn maximum_matching_word_segmentation(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MMWS_MAX_PARSEABLE_LENGTH:
        return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        empty_output: mutable u8[1] = zeroed
        return maximum_matching_word_segmentation_impl(input_view, length,
            empty_output[0:0], capacity, true)
    output_view_length: usize = capacity
    if output_view_length > MMWS_MAX_OUTPUT_BYTES:
        output_view_length <- MMWS_MAX_OUTPUT_BYTES
    output_view: mutable view[u8] = output[0:output_view_length]
    maximum_matching_word_segmentation_impl(input_view, length, output_view, capacity, false)
