# Independently authored draft; not compiled or run.
def mec_distance(circle: view[i64], x: i64, y: i64) -> i64:
    dx: i64 = x*circle[2]-circle[0]
    dy: i64 = y*circle[2]-circle[1]
    dx*dx + dy*dy

def mec_point(circle: mutable view[i64], x: i64, y: i64) -> void:
    circle[0] <- x
    circle[1] <- y
    circle[2] <- 1
    circle[3] <- 0

def mec_pair(circle: mutable view[i64], ax: i64, ay: i64, bx: i64, by: i64) -> void:
    circle[0] <- ax+bx
    circle[1] <- ay+by
    circle[2] <- 2
    circle[3] <- mec_distance(circle, ax, ay)

def mec_triple(circle: mutable view[i64], ax: i64, ay: i64, bx: i64, by: i64, cx: i64, cy: i64) -> void:
    den: mutable i64 = 2*(ax*(by-cy)+bx*(cy-ay)+cx*(ay-by))
    if den == 0:
        dab: i64 = (ax-bx)*(ax-bx)+(ay-by)*(ay-by)
        dac: i64 = (ax-cx)*(ax-cx)+(ay-cy)*(ay-cy)
        dbc: i64 = (bx-cx)*(bx-cx)+(by-cy)*(by-cy)
        if dab >= dac and dab >= dbc: mec_pair(circle, ax, ay, bx, by)
        elif dac >= dbc: mec_pair(circle, ax, ay, cx, cy)
        else: mec_pair(circle, bx, by, cx, cy)
        return
    aa: i64 = ax*ax+ay*ay
    bb: i64 = bx*bx+by*by
    cc: i64 = cx*cx+cy*cy
    x: mutable i64 = aa*(by-cy)+bb*(cy-ay)+cc*(ay-by)
    y: mutable i64 = aa*(cx-bx)+bb*(ax-cx)+cc*(bx-ax)
    if den < 0:
        den <- -den
        x <- -x
        y <- -y
    circle[0] <- x
    circle[1] <- y
    circle[2] <- den
    circle[3] <- mec_distance(circle, ax, ay)

def mec_compute(values: i64&, output: mutable u8&, n: usize) -> i64:
    xs: mutable i64[64] = zeroed
    ys: mutable i64[64] = zeroed
    order: mutable usize[64] = zeroed
    for i in 0..<n:
        xs[i] <- values[1+2*i]
        ys[i] <- values[2+2*i]
        order[i] <- values[1+2*n+i].usize()
    circle: mutable i64[4] = zeroed
    first: usize = order[0]
    mec_point(circle[0:4], xs[first], ys[first])
    for i in 1..<n:
        a: usize = order[i]
        if mec_distance(circle[0:4], xs[a], ys[a]) <= circle[3]: continue
        mec_point(circle[0:4], xs[a], ys[a])
        for j in 0..<i:
            b: usize = order[j]
            if mec_distance(circle[0:4], xs[b], ys[b]) <= circle[3]: continue
            mec_pair(circle[0:4], xs[a], ys[a], xs[b], ys[b])
            for k in 0..<j:
                c: usize = order[k]
                if mec_distance(circle[0:4], xs[c], ys[c]) > circle[3]:
                    mec_triple(circle[0:4], xs[a], ys[a], xs[b], ys[b], xs[c], ys[c])
    for i in 0..<n:
        if mec_distance(circle[0:4], xs[i], ys[i]) == circle[3]: output[i] <- 1.u8()
        else: output[i] <- 0.u8()
    n.i64()

def minimum_enclosing_circle_incremental_boundary_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 4 or length > 194: return -1
    values: i64& = input
    if values[0] < 1 or values[0] > 64: return -1
    n: usize = values[0].usize()
    if length != 1+3*n: return -1
    for i in 1..<(1+2*n):
        if values[i] < -100 or values[i] > 100: return -1
    seen: mutable u8[64] = zeroed
    for i in 0..<n:
        v: i64 = values[1+2*n+i]
        if v < 0 or v >= n.i64(): return -1
        if seen[v.usize()] != 0: return -1
        seen[v.usize()] <- 1.u8()
    if output == null or capacity < n: return -2
    mec_compute(values, output, n)

export fn minimum_enclosing_circle_incremental_boundary(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = minimum_enclosing_circle_incremental_boundary_impl
