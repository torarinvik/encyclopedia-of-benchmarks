# Return the total allowable increase while preserving row and column skylines.
def max_increase_keeping_skyline_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 2501:
        return -1
    if values[0] < 2 or values[0] > 50:
        return -1
    size: usize = values[0].usize()
    if length != 1 + size * size:
        return -1

    row_max: mutable u8[50] = zeroed
    column_max: mutable u8[50] = zeroed
    tallest: mutable u64 = 0
    height_sum: mutable u32 = 0
    for row in 0..<size |row_max, column_max, tallest, height_sum, values|:
        row_tallest: mutable u8 = 0
        start: usize = 1 + row * size
        for column in 0..<size |column_max, tallest, height_sum, values, row_tallest|:
            value: u64 = values[start + column].u64()
            tallest <- value if value > tallest else tallest
            height_sum <- height_sum + value.u32()
            height: u8 = value.u8()
            row_tallest <- height if height > row_tallest else row_tallest
            column_tallest: u8 = column_max[column]
            column_max[column] <- height if height > column_tallest else column_tallest
        row_max[row] <- row_tallest
    return -1 if tallest > 100

    skyline_sum: mutable u32 = 0
    if size <= 10:
        for row in 0..<size |row_max, column_max, skyline_sum|:
            row_height: u8 = row_max[row]
            for column in 0..<size |column_max, skyline_sum|:
                column_height: u8 = column_max[column]
                skyline_sum <- skyline_sum + (row_height if row_height < column_height else column_height).u32()
    else:
        row_counts: mutable u8[101] = zeroed
        column_counts: mutable u8[101] = zeroed
        lowest: mutable usize = 100
        for index in 0..<size |row_counts, column_counts, row_max, column_max, lowest|:
            row_height: usize = row_max[index].usize()
            column_height: usize = column_max[index].usize()
            lowest <- row_height if row_height < lowest else lowest
            lowest <- column_height if column_height < lowest else lowest
            row_counts[row_height] <- row_counts[row_height] + 1
            column_counts[column_height] <- column_counts[column_height] + 1
        rows_above: mutable u32 = size.u32()
        columns_above: mutable u32 = size.u32()
        skyline_sum <- rows_above * columns_above * lowest.u32()
        for height in lowest..<tallest.usize() |row_counts, column_counts, rows_above, columns_above, skyline_sum|:
            rows_above <- rows_above - row_counts[height].u32()
            columns_above <- columns_above - column_counts[height].u32()
            skyline_sum <- skyline_sum + rows_above * columns_above
    (skyline_sum - height_sum).i64()

export fn max_increase_keeping_skyline(values: i64&, length: usize) -> i64 = max_increase_keeping_skyline_impl
