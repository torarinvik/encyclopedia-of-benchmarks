# Return twice the statistical median using a local insertion-sorted copy.
def median_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 1024:
        return 0
    ordered: mutable i64[1024] = zeroed
    index: mutable usize = 0
    while index < length:
        ordered[index] <- values[index]
        index <- index + 1
    index <- 1
    while index < length:
        value: i64 = ordered[index]
        cursor: mutable usize = index
        while cursor > 0 and ordered[cursor - 1] > value:
            ordered[cursor] <- ordered[cursor - 1]
            cursor <- cursor - 1
        ordered[cursor] <- value
        index <- index + 1
    if length % 2 != 0:
        return ordered[length / 2] * 2
    ordered[length / 2 - 1] + ordered[length / 2]

export fn median(values: i64&, length: usize) -> i64 = median_impl
