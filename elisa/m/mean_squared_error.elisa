def mean_squared_error_impl(values: i64&, length: usize) -> f64:
    if values.is_null() or length < 1 or length > 515:
        return -1.0e300
    count: i64 = values[0]
    if count < 0 or count > 257 or length != (1 + 2 * count).usize() or count == 0 or count > 256:
        return -1.0e300
    count_usize: usize = count.usize()
    index: mutable usize = 0
    while index < count_usize * 2:
        if values[1 + index] < -1000000 or values[1 + index] > 1000000:
            return -1.0e300
        index <- index + 1
    total: mutable f64 = 0.0
    index <- 0
    while index < count_usize:
        difference: f64 = values[1 + index].f64() / 1000000.0 -
                          values[1 + count_usize + index].f64() / 1000000.0
        total <- total + difference * difference
        index <- index + 1
    total / count.f64()

export fn mean_squared_error(values: i64&, length: usize) -> f64 = mean_squared_error_impl
