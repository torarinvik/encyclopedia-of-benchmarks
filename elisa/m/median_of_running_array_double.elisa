const MAX_COUNT: usize = 64
const MAX_INPUT_LENGTH: usize = 66

def median_double_less(left: f64, right: f64) -> bool:
    if left < right:
        return true
    if left == 0.0 and right == 0.0:
        return (1.0 / left < 0.0) and (1.0 / right >= 0.0)
    false

def median_double_push_max(heap: mutable f64&, count: mutable usize&, value: f64) -> void:
    position: mutable usize = count
    count <- count + 1
    while position > 0 and median_double_less(heap[(position - 1) / 2], value):
        parent: usize = (position - 1) / 2
        heap[position] <- heap[parent]
        position <- parent
    heap[position] <- value

def median_double_pop_max(heap: mutable f64&, count: mutable usize&) -> f64:
    result: f64 = heap[0]
    count <- count - 1
    value: f64 = heap[count]
    if count == 0:
        return result
    position: mutable usize = 0
    while 2 * position + 1 < count:
        child: mutable usize = 2 * position + 1
        if child + 1 < count and median_double_less(heap[child], heap[child + 1]): child <- child + 1
        if not median_double_less(value, heap[child]): break
        heap[position] <- heap[child]
        position <- child
    heap[position] <- value
    result

def median_double_push_min(heap: mutable f64&, count: mutable usize&, value: f64) -> void:
    position: mutable usize = count
    count <- count + 1
    while position > 0 and median_double_less(value, heap[(position - 1) / 2]):
        parent: usize = (position - 1) / 2
        heap[position] <- heap[parent]
        position <- parent
    heap[position] <- value

def median_double_pop_min(heap: mutable f64&, count: mutable usize&) -> f64:
    result: f64 = heap[0]
    count <- count - 1
    value: f64 = heap[count]
    if count == 0:
        return result
    position: mutable usize = 0
    while 2 * position + 1 < count:
        child: mutable usize = 2 * position + 1
        if child + 1 < count and median_double_less(heap[child + 1], heap[child]): child <- child + 1
        if not median_double_less(heap[child], value): break
        heap[position] <- heap[child]
        position <- child
    heap[position] <- value
    result

def median_of_running_array_double_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH:
        return -1
    count_value: f64 = input[0]
    if count_value != count_value or count_value < 1.0 or count_value > 64.0:
        return -1
    count: usize = count_value.usize()
    if count.f64() != count_value or length != 1 + count:
        return -1
    lower: mutable f64[64] = zeroed
    upper: mutable f64[64] = zeroed
    medians: mutable f64[64] = zeroed
    lower_count: mutable usize = 0
    upper_count: mutable usize = 0
    for index in 0..<count:
        sample: f64 = input[index + 1]
        if sample != sample or sample < -1000000.0 or sample > 1000000.0:
            return -1
        if upper_count > 0 and median_double_less(sample, upper[0]):
            median_double_push_max(&lower[0], &lower_count, sample)
        else:
            median_double_push_min(&upper[0], &upper_count, sample)
        if lower_count > upper_count + 1:
            median_double_push_min(&upper[0], &upper_count, median_double_pop_max(&lower[0], &lower_count))
        else if upper_count > lower_count + 1:
            median_double_push_max(&lower[0], &lower_count, median_double_pop_min(&upper[0], &upper_count))
        if lower_count > upper_count:
            medians[index] <- lower[0]
        else if upper_count > lower_count:
            medians[index] <- upper[0]
        else:
            medians[index] <- (lower[0] + upper[0]) / 2.0
    if output == null or capacity < count:
        return -2
    for index in 0..<count:
        output[index] <- medians[index]
    count.i64()

export fn median_of_running_array_double(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = median_of_running_array_double_impl
