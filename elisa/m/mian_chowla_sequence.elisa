const MAX_N: i64 = 30
const MAX_PARSEABLE_LENGTH: usize = 2

def mian_chowla_sequence_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 1 or input_length > MAX_PARSEABLE_LENGTH: return -1
    requested:  i64 = input[0]
    if input_length != 1 or requested < 1 or requested > MAX_N: return -1

    terms: mutable i64[30] = zeroed
    used_sums: mutable i64[465] = zeroed
    terms_view: mutable view[i64] = terms[0:30]
    sums_view: mutable view[i64] = used_sums[0:465]
    term_count: mutable usize = 1
    sum_count: mutable usize = 1
    terms_view[0] <- 1
    sums_view[0] <- 2

    while term_count < requested.usize():
        candidate: mutable i64 = terms_view[term_count - 1] + 1
        valid: mutable bool = false
        while true:
            valid <- true
            term: mutable usize = 0
            while term < term_count and valid:
                sum: i64 = candidate + terms_view[term]
                old: mutable usize = 0
                while old < sum_count:
                    if sums_view[old] == sum:
                        valid <- false
                        break
                    old <- old + 1
                term <- term + 1
            if valid:
                doubled: i64 = 2 * candidate
                old: mutable usize = 0
                while old < sum_count:
                    if sums_view[old] == doubled:
                        valid <- false
                        break
                    old <- old + 1
            if valid: break
            candidate <- candidate + 1

        term: mutable usize = 0
        while term < term_count:
            sums_view[sum_count] <- candidate + terms_view[term]
            sum_count <- sum_count + 1
            term <- term + 1
        sums_view[sum_count] <- 2 * candidate
        sum_count <- sum_count + 1
        terms_view[term_count] <- candidate
        term_count <- term_count + 1
    terms_view[requested.usize() - 1]

def mian_chowla_sequence_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_PARSEABLE_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    mian_chowla_sequence_impl(input_view, input_view_length)

export fn mian_chowla_sequence(input: i64&, length: usize) -> i64 = mian_chowla_sequence_entry
