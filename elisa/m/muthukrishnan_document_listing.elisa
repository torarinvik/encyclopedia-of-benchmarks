const MDL_MAX_N: usize = 32
const MDL_MAX_DOCS: usize = 8
const MDL_MAX_Q: usize = 16
const MDL_MAX_INPUT: usize = 68
const MDL_MAX_OUTPUT: usize = 144
const MDL_LEVELS: usize = 6

def mdl_range_min(previous: view[i64], table: view[i32], logs: view[i32],
        lo: usize, hi: usize) -> usize:
    length: usize = hi - lo + 1
    level: usize = logs[length].usize()
    width: usize = 1 << level
    left: usize = table[level * MDL_MAX_N + lo].usize()
    right: usize = table[level * MDL_MAX_N + hi - width + 1].usize()
    if previous[left] < previous[right] or (previous[left] == previous[right] and left < right):
        left
    else:
        right

def mdl_report(lo: usize, hi: usize, query_lo: usize, previous: view[i64],
        documents: view[i64], table: view[i32], logs: view[i32],
        ranks: mutable view[usize], found_docs: mutable view[u8], count: mutable usize&) -> void:
    if lo > hi:
        return
    index: usize = mdl_range_min(previous, table, logs, lo, hi)
    if previous[index] >= query_lo.i64():
        return
    ranks[count] <- index
    found_docs[count] <- documents[index].u8()
    count <- count + 1
    if index > lo:
        mdl_report(lo, index - 1, query_lo, previous, documents, table, logs, ranks, found_docs, count)
    if index < hi:
        mdl_report(index + 1, hi, query_lo, previous, documents, table, logs, ranks, found_docs, count)

def mdl_impl(input: view[i64], output: mutable view[u8], output_capacity: usize) -> i64:
    input_length: usize = input.length()
    if input_length < 3 or input_length > MDL_MAX_INPUT:
        return -1
    n64: i64 = input[0]
    docs64: i64 = input[1]
    q64: i64 = input[2]
    if n64 < 1 or n64 > MDL_MAX_N.i64() or docs64 < 1 or docs64 > MDL_MAX_DOCS.i64() or
        q64 < 1 or q64 > MDL_MAX_Q.i64():
        return -1
    n: usize = n64.usize()
    docs: usize = docs64.usize()
    q: usize = q64.usize()
    if input_length != 3 + n + 2 * q:
        return -1

    documents: mutable i64[MDL_MAX_N] = zeroed
    previous: mutable i64[MDL_MAX_N] = zeroed
    last: mutable i64[MDL_MAX_DOCS] = zeroed
    doc: mutable usize = 0
    while doc < docs:
        last[doc] <- -1
        doc <- doc + 1
    index: mutable usize = 0
    while index < n:
        document: i64 = input[3 + index]
        if document < 0 or document >= docs64:
            return -1
        documents[index] <- document
        previous[index] <- last[document.usize()]
        last[document.usize()] <- index.i64()
        index <- index + 1
    query: mutable usize = 0
    while query < q:
        lo: i64 = input[3 + n + 2 * query]
        hi: i64 = input[4 + n + 2 * query]
        if lo < 0 or hi < lo or hi >= n64:
            return -1
        query <- query + 1

    logs: mutable i32[MDL_MAX_N + 1] = zeroed
    size: mutable usize = 2
    while size <= n:
        logs[size] <- logs[size / 2] + 1
        size <- size + 1
    table: mutable i32[MDL_LEVELS * MDL_MAX_N] = zeroed
    index <- 0
    while index < n:
        table[index] <- index.i32()
        index <- index + 1
    level_count: usize = logs[n].usize() + 1
    level: mutable usize = 1
    while level < level_count:
        width: usize = 1 << level
        half: usize = width / 2
        start: mutable usize = 0
        while start + width <= n:
            left: usize = table[(level - 1) * MDL_MAX_N + start].usize()
            right: usize = table[(level - 1) * MDL_MAX_N + start + half].usize()
            if previous[left] < previous[right] or (previous[left] == previous[right] and left < right):
                table[level * MDL_MAX_N + start] <- left.i32()
            else:
                table[level * MDL_MAX_N + start] <- right.i32()
            start <- start + 1
        level <- level + 1

    staged: mutable u8[MDL_MAX_OUTPUT] = zeroed
    written: mutable usize = 0
    query <- 0
    while query < q:
        lo: usize = input[3 + n + 2 * query].usize()
        hi: usize = input[4 + n + 2 * query].usize()
        count_at: usize = written
        written <- written + 1
        ranks: mutable usize[MDL_MAX_DOCS] = zeroed
        found_docs: mutable u8[MDL_MAX_DOCS] = zeroed
        count: mutable usize = 0
        mdl_report(lo, hi, lo, previous[0:n], documents[0:n], table[0:MDL_LEVELS * MDL_MAX_N],
            logs[0:MDL_MAX_N + 1], ranks[0:MDL_MAX_DOCS], found_docs[0:MDL_MAX_DOCS], count)
        i: mutable usize = 1
        while i < count:
            rank: usize = ranks[i]
            document: u8 = found_docs[i]
            j: mutable usize = i
            while j > 0 and ranks[j - 1] > rank:
                ranks[j] <- ranks[j - 1]
                found_docs[j] <- found_docs[j - 1]
                j <- j - 1
            ranks[j] <- rank
            found_docs[j] <- document
            i <- i + 1
        staged[count_at] <- count.u8()
        i <- 0
        while i < count:
            staged[written] <- found_docs[i]
            written <- written + 1
            i <- i + 1
        query <- query + 1
    if written > MDL_MAX_OUTPUT:
        return -1
    if output_capacity < written or output.length() < written:
        return -2
    index <- 0
    while index < written:
        output[index] <- staged[index]
        index <- index + 1
    written.i64()

export fn muthukrishnan_document_listing(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > MDL_MAX_INPUT:
        return -1
    frame: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return mdl_impl(frame, scratch[0:0], 0)
    writable_length: usize = output_capacity
    if writable_length > MDL_MAX_OUTPUT:
        writable_length <- MDL_MAX_OUTPUT
    mdl_impl(frame, output[0:writable_length], output_capacity)
