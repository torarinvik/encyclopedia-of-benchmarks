def mibench_jpeg_ycbcr_arshift16(value: i64) -> i64:
    if value >= 0:
        return value / 65536
    -(((-value) + 65535) / 65536)

def mibench_jpeg_ycbcr_clamp(value: i64) -> u8:
    if value < 0:
        return 0u8
    if value > 255:
        return 255u8
    value.u8()

def mibench_jpeg_ycbcr_impl(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 4 or input_length > 49:
        return -1
    values: view[i64] = input[0:input_length]
    if values[0] < 1 or values[0] > 16 or input_length != (1 + 3 * values[0]).usize():
        return -1
    index: mutable usize = 1
    while index < input_length:
        if values[index] < 0 or values[index] > 255:
            return -1
        index <- index + 1

    staged: mutable u8[48] = zeroed
    out_index: mutable usize = 0
    index <- 1
    while index < input_length:
        y: i64 = values[index]
        cb: i64 = values[index + 1] - 128
        cr: i64 = values[index + 2] - 128
        staged[out_index] <- mibench_jpeg_ycbcr_clamp(y + mibench_jpeg_ycbcr_arshift16(91881 * cr + 32768))
        staged[out_index + 1] <- mibench_jpeg_ycbcr_clamp(y + mibench_jpeg_ycbcr_arshift16(-22554 * cb + 32768 - 46802 * cr))
        staged[out_index + 2] <- mibench_jpeg_ycbcr_clamp(y + mibench_jpeg_ycbcr_arshift16(116130 * cb + 32768))
        out_index <- out_index + 3
        index <- index + 3
    if output.is_null() or output_capacity < out_index:
        return -2
    bytes: mutable view[u8] = output[0:out_index]
    index <- 0
    while index < out_index:
        bytes[index] <- staged[index]
        index <- index + 1
    out_index.i64()

export fn mibench_jpeg_ycbcr_to_rgb(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = mibench_jpeg_ycbcr_impl
