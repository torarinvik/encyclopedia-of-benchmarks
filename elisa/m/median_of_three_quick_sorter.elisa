def median_of_three(a: i64, b: i64, c: i64) -> i64:
    if a <= b:
        if b <= c: return b
        if a <= c: return c
        return a
    if b >= c: return b
    if a >= c: return c
    a

def partition_range(values: mutable view[i64], left: usize, right: usize) -> usize:
    middle: usize = left + (right - left) / 2
    pivot: i64 = median_of_three(values[left], values[middle], values[right])
    nleft: mutable usize = left
    nright: mutable usize = right
    while true:
        while values[nleft] < pivot:
            nleft <- nleft + 1
        while values[nright] > pivot:
            nright <- nright - 1
        if nleft >= nright:
            return nright
        temporary: i64 = values[nleft]
        values[nleft] <- values[nright]
        values[nright] <- temporary
        nleft <- nleft + 1
        nright <- nright - 1
    nright

def sort_range(values: mutable view[i64], left: usize, right: usize) -> void:
    if left >= right:
        return
    pivot: usize = partition_range(values, left, right)
    sort_range(values, left, pivot)
    sort_range(values, pivot + 1, right)

def median_of_three_quick_sorter_impl(values: mutable i64&, length: usize) -> void:
    if length > 1:
        sort_range(values[0:length], 0, length - 1)

export fn median_of_three_quick_sorter(values: mutable i64&, length: usize) -> void = median_of_three_quick_sorter_impl
