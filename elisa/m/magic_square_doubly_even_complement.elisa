const MIN_ORDER: i64 = 4
const MAX_ORDER: i64 = 64
const FNV_OFFSET: u64 = 0xcbf29ce484222325
const FNV_PRIME: u64 = 0x100000001b3

def magic_square_doubly_even_hash_byte(hash: u64, byte: u8) -> u64:
    return (hash ^ byte.u64()) * FNV_PRIME

def magic_square_doubly_even_hash_i32(hash: u64, value: i32) -> u64:
    bits: u32 = value.u32()
    result: mutable u64 = hash
    for byte_index in 0..<4:
        byte: u8 = ((bits >> (byte_index * 8)) & 255).u8()
        result <- magic_square_doubly_even_hash_byte(result, byte)
    result

def magic_square_doubly_even_complement_impl(n: i64) -> i64:
    if n < MIN_ORDER or n > MAX_ORDER or n % 4 != 0:
        return -1
    order: i64 = n
    ceiling: i64 = order * order + 1
    hash: mutable u64 = magic_square_doubly_even_hash_byte(FNV_OFFSET, order.u8())

    for row in 0..<order:
        for column in 0..<order:
            value: mutable i64 = row * order + column + 1
            local_row: i64 = row % 4
            local_column: i64 = column % 4
            if local_row == local_column or local_row + local_column == 3:
                value <- ceiling - value
            hash <- magic_square_doubly_even_hash_i32(hash, value.i32())
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn magic_square_doubly_even_complement(n: i64) -> i64 = magic_square_doubly_even_complement_impl
