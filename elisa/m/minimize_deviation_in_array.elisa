const MAX_N: usize = 64
def minimize_deviation_in_array_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_N + 1 or input[0] < 1 or input[0] > MAX_N.i64(): return -1
    count: usize = input[0].usize()
    if length != count + 1: return -1
    heap: mutable i64[MAX_N]
    size: mutable usize = 0
    low: mutable i64 = 9223372036854775807
    i: usize = 0
    while i < count:
        x: mutable i64 = input[i + 1]
        if x < 1 or x > 1000000: return -1
        if x % 2 == 1: x <- x * 2
        if x < low: low <- x
        j: mutable usize = size
        size <- size + 1
        while j > 0 and heap[(j - 1) / 2] < x:
            heap[j] <- heap[(j - 1) / 2]
            j <- (j - 1) / 2
        heap[j] <- x
        i <- i + 1
    best: mutable i64 = heap[0] - low
    while heap[0] % 2 == 0:
        top: i64 = heap[0]
        size <- size - 1
        x: mutable i64 = heap[size]
        j <- 0
        while 2 * j + 1 < size:
            child: mutable usize = 2 * j + 1
            if child + 1 < size and heap[child + 1] > heap[child]: child <- child + 1
            if heap[child] <= x: break
            heap[j] <- heap[child]
            j <- child
        if size > 0: heap[j] <- x
        x <- top / 2
        if x < low: low <- x
        j <- size
        size <- size + 1
        while j > 0 and heap[(j - 1) / 2] < x:
            heap[j] <- heap[(j - 1) / 2]
            j <- (j - 1) / 2
        heap[j] <- x
        deviation: i64 = heap[0] - low
        if deviation < best: best <- deviation
    best
export fn minimize_deviation_in_array(input: i64&, length: usize) -> i64 = minimize_deviation_in_array_impl
