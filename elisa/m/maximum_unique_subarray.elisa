# Maximize the sum of a contiguous window with distinct values.
def maximum_unique_subarray_impl(values: i64&, length: usize) -> i64:
    if length > 256:
        return -1
    if length == 0:
        return 0
    keys: mutable i64[512] = zeroed
    last_seen: mutable usize[512] = zeroed
    occupied: mutable bool[512] = zeroed
    index: mutable usize = 0
    left: mutable usize = 0
    window_sum: mutable i64 = 0
    best: mutable i64 = 0
    while index < length:
        value: i64 = values[index]
        if value < 1 or value > 10000:
            return -1
        slot: mutable usize = (value % 512).usize()
        while occupied[slot] and keys[slot] != value:
            slot <- (slot + 1) % 512
        previous: usize = last_seen[slot]
        while left < previous:
            window_sum <- window_sum - values[left]
            left <- left + 1
        window_sum <- window_sum + value
        index <- index + 1
        keys[slot] <- value
        last_seen[slot] <- index
        occupied[slot] <- true
        if window_sum > best:
            best <- window_sum
    best

export fn maximum_unique_subarray(values: i64&, length: usize) -> i64 = maximum_unique_subarray_impl
