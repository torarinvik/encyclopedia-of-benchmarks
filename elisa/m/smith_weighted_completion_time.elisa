const MAX_N: usize=12
const MAX_INPUT: usize=25
def put64(x:i64,o:mutable view[u8],p:usize)->void:
    b:u64=x.u64();j:mutable usize=0
    while j<8:
        o[p+j]<-((b>>(8*j))&255).u8()
        b<-b>>8
        j<-j+1
def smith_weighted_completion_time(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("smith_weighted_completion_time"):
    if input.is_null() or length<3 or length>MAX_INPUT:return -1
    n64:i64=input[0]
    if n64<1 or n64>12 or length!=1+2*n64.usize():return -1
    n:usize=n64.usize()
    p:mutable i64[12]=zeroed
    w:mutable i64[12]=zeroed
    order:mutable i64[12]=zeroed
    i:mutable usize=0
    while i<n:
        p[i]<-input[1+2*i];w[i]<-input[2+2*i]
        if p[i]<1 or p[i]>10000 or w[i]<1 or w[i]>10000:return -1
        order[i]<-i.i64();i<-i+1
    bytes:usize=8*(n+1);if output.is_null() or capacity<bytes:return -2
    output_view:mutable view[u8]=output[0:bytes]
    i<-1
    while i<n:
        key:i64=order[i];j:mutable usize=i
        while j>0:
            prev:usize=order[j-1].usize()
            lhs:i64=w[key.usize()]*p[prev];rhs:i64=w[prev]*p[key.usize()]
            if lhs<rhs or (lhs==rhs and key>=prev.i64()):break
            order[j]<-order[j-1];j<-j-1
        order[j]<-key;i<-i+1
    time:mutable i64=0;total:mutable i64=0;i<-0
    while i<n:
        job:usize=order[i].usize();time<-time+p[job];total<-total+w[job]*time;i<-i+1
    put64(total,output_view,0);i<-0
    while i<n:put64(order[i],output_view,8*(i+1));i<-i+1
    bytes.i64()
