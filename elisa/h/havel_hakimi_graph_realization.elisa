from std.collections import InlineArray

const MAX_N = 8
const MAX_EDGES = 28
const MAX_INPUT = 10

fn store_i64(output: mutable view[u8], offset: Int, value: Int64) -> void:
    var bits = value.bitcast[UInt64]()
    for byte in range(8):
        output[offset + byte] <- UInt8(bits & UInt64(255))
        bits = bits >> 8

fn implementation(input: view[Int64], output_words: mutable view[Int64]) -> Int64:
    if input.len() < 1 or input.len() > MAX_INPUT: return -1
    let n64 = input[0]
    if n64 < 0 or n64 > MAX_N: return -1
    let n = Int(n64)
    if input.len() != n + 1: return -1
    var residual = InlineArray[Int64, 8]()
    var active = InlineArray[Bool, 8]()
    for vertex in range(n):
        let degree = input[vertex + 1]
        if degree < 0 or degree >= n64: return -1
        residual[vertex] <- degree
        active[vertex] <- true
    var edge_left = InlineArray[Int64, 28]()
    var edge_right = InlineArray[Int64, 28]()
    var edge_count = 0
    var graphical = true
    while graphical:
        var hub = -1
        for vertex in range(n):
            if active[vertex] and residual[vertex] > 0:
                if hub < 0 or residual[vertex] > residual[hub] or (residual[vertex] == residual[hub] and vertex < hub):
                    hub <- vertex
        if hub < 0: break
        let degree = Int(residual[hub])
        residual[hub] <- 0
        active[hub] <- false
        var candidates = InlineArray[Int, 8]()
        var candidate_count = 0
        for vertex in range(n):
            if active[vertex]:
                candidates[candidate_count] <- vertex
                candidate_count <- candidate_count + 1
        for index in range(1, candidate_count):
            let value = candidates[index]
            var j = index
            while j > 0 and (residual[candidates[j - 1]] < residual[value] or (residual[candidates[j - 1]] == residual[value] and candidates[j - 1] > value)):
                candidates[j] <- candidates[j - 1]
                j <- j - 1
            candidates[j] <- value
        if degree > candidate_count:
            graphical <- false
            break
        for index in range(degree):
            let neighbor = candidates[index]
            if residual[neighbor] == 0:
                graphical <- false
                break
            residual[neighbor] <- residual[neighbor] - 1
            edge_left[edge_count] <- Int64(if hub < neighbor then hub else neighbor)
            edge_right[edge_count] <- Int64(if hub < neighbor then neighbor else hub)
            edge_count <- edge_count + 1
    if graphical:
        output_words[0] <- 1
        output_words[1] <- Int64(edge_count)
        for index in range(edge_count):
            output_words[2 + 2 * index] <- edge_left[index]
            output_words[3 + 2 * index] <- edge_right[index]
        Int64(2 + 2 * edge_count)
    else:
        output_words[0] <- 0
        Int64(1)

@export("havel_hakimi_graph_realization")
fn havel_hakimi_graph_realization(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> Int64:
    if input.is_null() or length < 1 or length > MAX_INPUT: return -1
    var words = InlineArray[Int64, 58]()
    let word_count = implementation(input[0:length], words[0:58])
    if word_count < 0: return word_count
    let byte_count = Int(word_count) * 8
    if output.is_null() or capacity < byte_count.usize(): return -2
    let output_view: mutable view[UInt8] = output[0:byte_count.usize()]
    for i in range(Int(word_count)): store_i64(output_view, i * 8, words[i])
    Int64(byte_count)
