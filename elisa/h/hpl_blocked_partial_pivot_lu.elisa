const HPL_MAX_N: usize = 8
const HPL_MAX_INPUT: usize = 66
const HPL_MAX_OUTPUT: usize = 72

def hpl_finite(x: f64) -> bool:
    x == x and x < 1.7976931348623157e308 and x > -1.7976931348623157e308

def hpl_exact_integer(x: f64, lo: i64, hi: i64) -> bool:
    if not hpl_finite(x) or x < lo.f64() or x > hi.f64(): return false
    x.i64().f64() == x

def hpl_compute(input: view[f64], staged: mutable view[f64], input_length: usize) -> i64:
    if input_length < 1 or input_length > HPL_MAX_INPUT: return -1
    if not hpl_exact_integer(input[0], 2, 8): return -1
    n: usize = input[0].usize()
    if input_length != 1 + n * n: return -1

    a: mutable f64[64] = zeroed
    for index in 0..<n*n:
        if not hpl_exact_integer(input[index+1], -16, 16): return -1
        a[index] <- input[index+1]
    pivots: mutable usize[8] = zeroed
    panel: mutable usize = 0
    while panel < n:
        panel_end: usize = panel + 2
        if panel_end > n: panel_end <- n
        col: mutable usize = panel
        while col < panel_end:
            pivot_row: mutable usize = col
            pivot_magnitude: mutable f64 = a[col*n+col]
            if pivot_magnitude < 0.0: pivot_magnitude <- -pivot_magnitude
            row: mutable usize = col + 1
            while row < n:
                magnitude: f64 = a[row*n+col]
                if magnitude < 0.0: magnitude = -magnitude
                if magnitude > pivot_magnitude:
                    pivot_magnitude <- magnitude
                    pivot_row <- row
                row <- row + 1
            if not hpl_finite(pivot_magnitude) or pivot_magnitude == 0.0: return -1
            pivots[col] <- pivot_row
            if pivot_row != col:
                for j in 0..<n:
                    temporary: f64 = a[col*n+j]
                    a[col*n+j] <- a[pivot_row*n+j]
                    a[pivot_row*n+j] <- temporary
            diagonal: f64 = a[col*n+col]
            if not hpl_finite(diagonal) or diagonal == 0.0: return -1
            row <- col + 1
            while row < n:
                a[row*n+col] <- a[row*n+col] / diagonal
                if not hpl_finite(a[row*n+col]): return -1
                multiplier: f64 = a[row*n+col]
                j: mutable usize = col + 1
                while j < panel_end:
                    a[row*n+j] <- a[row*n+j] - multiplier * a[col*n+j]
                    if not hpl_finite(a[row*n+j]): return -1
                    j <- j + 1
                row <- row + 1
            col <- col + 1

        row <- panel
        while row < panel_end:
            col <- panel_end
            while col < n:
                value: mutable f64 = a[row*n+col]
                inner: mutable usize = panel
                while inner < row:
                    value <- value - a[row*n+inner] * a[inner*n+col]
                    inner <- inner + 1
                if not hpl_finite(value): return -1
                a[row*n+col] <- value
                col <- col + 1
            row <- row + 1
        row <- panel_end
        while row < n:
            col <- panel_end
            while col < n:
                update: mutable f64 = 0.0
                inner: mutable usize = panel
                while inner < panel_end:
                    update <- update + a[row*n+inner] * a[inner*n+col]
                    inner <- inner + 1
                a[row*n+col] <- a[row*n+col] - update
                if not hpl_finite(a[row*n+col]): return -1
                col <- col + 1
            row <- row + 1
        panel <- panel_end

    for index in 0..<n: staged[index] <- pivots[index].f64()
    for index in 0..<n*n:
        if not hpl_finite(a[index]): return -1
        staged[n+index] <- a[index]
    (n + n*n).i64()

export fn hpl_blocked_partial_pivot_lu(input: f64&, input_length: usize,
        output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or input_length < 1 or input_length > HPL_MAX_INPUT: return -1
    input_view: view[f64] = input[0:input_length]
    staged: mutable f64[HPL_MAX_OUTPUT] = zeroed
    staged_view: mutable view[f64] = staged[0:HPL_MAX_OUTPUT]
    result: i64 = hpl_compute(input_view, staged_view, input_length)
    if result < 0: return result
    output_length: usize = result.usize()
    if output.is_null() or capacity < output_length: return -2
    output_view: mutable view[f64] = output[0:output_length]
    for index in 0..<output_length: output_view[index] <- staged_view[index]
    result
