const MHI_MAX_LINES: usize = 16
const MHI_MAX_INPUT: usize = 37
const MHI_BOX: i64 = 256

def fn mhi_abs(value: i64) -> i64:
    if value < 0: -value else: value

def fn mhi_gcd(first: i64, second: i64) -> i64:
    a: mutable i64 = mhi_abs(first)
    b: mutable i64 = mhi_abs(second)
    while b != 0:
        rem: i64 = a % b
        a <- b
        b <- rem
    a

def fn mhi_half(a: i64, b: i64) -> usize:
    if b > 0 or (b == 0 and a >= 0): 0 else: 1

def fn mhi_compare(a1: i64, b1: i64, c1: i64, a2: i64, b2: i64, c2: i64) -> i64:
    h1: usize = mhi_half(a1, b1)
    h2: usize = mhi_half(a2, b2)
    if h1 != h2: return if h1 < h2: -1 else: 1
    turn: i64 = a1 * b2 - b1 * a2
    if turn != 0: return if turn > 0: -1 else: 1
    if c1 < c2: -1 else: if c1 > c2: 1 else: 0

def fn mhi_intersect(a1: i64, b1: i64, c1: i64, a2: i64, b2: i64, c2: i64,
        point: mutable view[i64]) -> bool:
    mut det: i64 = a1 * b2 - a2 * b1
    if det == 0: return false
    mut xn: i64 = c1 * b2 - b1 * c2
    mut yn: i64 = a1 * c2 - c1 * a2
    if det < 0:
        det <- -det
        xn <- -xn
        yn <- -yn
    g: i64 = mhi_gcd(mhi_gcd(xn, yn), det)
    point[0] <- xn / g
    point[1] <- yn / g
    point[2] <- det / g
    true

def fn mhi_outside(a: i64, b: i64, c: i64, x: i64, y: i64, den: i64) -> bool:
    a * x + b * y > c * den

def fn mhi_same(x1: i64, y1: i64, d1: i64, x2: i64, y2: i64, d2: i64) -> bool:
    x1 * d2 == x2 * d1 and y1 * d2 == y2 * d1

def fn mhi_orient(ax: i64, ay: i64, ad: i64, bx: i64, by: i64, bd: i64,
        cx: i64, cy: i64, cd: i64) -> i64:
    dx1: i64 = bx * ad - ax * bd
    dy1: i64 = by * ad - ay * bd
    dx2: i64 = cx * bd - bx * cd
    dy2: i64 = cy * bd - by * cd
    dx1 * dy2 - dy1 * dx2

def fn mhi_less_yx(x1: i64, y1: i64, d1: i64, x2: i64, y2: i64, d2: i64) -> bool:
    lhs_y: i64 = y1 * d2
    rhs_y: i64 = y2 * d1
    if lhs_y != rhs_y: return lhs_y < rhs_y
    x1 * d2 < x2 * d1

def fn mhi_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def fn half_plane_intersection_impl(input: view[i64], output: mutable view[u8], capacity: usize,
        output_is_null: bool) -> i64:
    length: usize = input.len()
    if length < 1 or length > MHI_MAX_INPUT: return -1
    if input[0] < 0 or input[0] > 12: return -1
    count: usize = input[0].usize()
    if length != 1 + 3 * count: return -1
    a: mutable i64[MHI_MAX_LINES] = zeroed
    b: mutable i64[MHI_MAX_LINES] = zeroed
    c: mutable i64[MHI_MAX_LINES] = zeroed
    qa: mutable i64[MHI_MAX_LINES] = zeroed
    qb: mutable i64[MHI_MAX_LINES] = zeroed
    qc: mutable i64[MHI_MAX_LINES] = zeroed
    px: mutable i64[MHI_MAX_LINES] = zeroed
    py: mutable i64[MHI_MAX_LINES] = zeroed
    pd: mutable i64[MHI_MAX_LINES] = zeroed
    cx: mutable i64[MHI_MAX_LINES] = zeroed
    cy: mutable i64[MHI_MAX_LINES] = zeroed
    cd: mutable i64[MHI_MAX_LINES] = zeroed
    line_count: mutable usize = 0
    for i in 0..<count:
        ai: i64 = input[1 + 3 * i]
        bi: i64 = input[2 + 3 * i]
        ci: i64 = input[3 + 3 * i]
        if ai < -16 or ai > 16 or bi < -16 or bi > 16 or ci < -128 or ci > 128: return -1
        if (ai == 0 and bi == 0) or mhi_gcd(ai, bi) != 1: return -1
        a[line_count] <- ai; b[line_count] <- bi; c[line_count] <- ci
        line_count <- line_count + 1
    a[line_count] <- 1; b[line_count] <- 0; c[line_count] <- MHI_BOX; line_count <- line_count + 1
    a[line_count] <- 0; b[line_count] <- 1; c[line_count] <- MHI_BOX; line_count <- line_count + 1
    a[line_count] <- -1; b[line_count] <- 0; c[line_count] <- MHI_BOX; line_count <- line_count + 1
    a[line_count] <- 0; b[line_count] <- -1; c[line_count] <- MHI_BOX; line_count <- line_count + 1
    for i in 1..<line_count:
        ka: i64 = a[i]; kb: i64 = b[i]; kc: i64 = c[i]
        j: mutable usize = i
        while j > 0 and mhi_compare(ka, kb, kc, a[j - 1], b[j - 1], c[j - 1]) < 0:
            a[j] <- a[j - 1]; b[j] <- b[j - 1]; c[j] <- c[j - 1]
            j <- j - 1
        a[j] <- ka; b[j] <- kb; c[j] <- kc
    reduced: mutable usize = 0
    for i in 0..<line_count:
        if reduced > 0 and a[i] == a[reduced - 1] and b[i] == b[reduced - 1]: continue
        a[reduced] <- a[i]; b[reduced] <- b[i]; c[reduced] <- c[i]
        reduced <- reduced + 1
    head: mutable usize = 0
    tail: mutable usize = 0
    empty: mutable bool = false
    point: mutable i64[3] = zeroed
    for i in 0..<reduced:
        ha: i64 = a[i]; hb: i64 = b[i]; hc: i64 = c[i]
        while tail - head > 1:
            if not mhi_intersect(qa[tail - 2], qb[tail - 2], qc[tail - 2], qa[tail - 1], qb[tail - 1], qc[tail - 1], point[0:3]): break
            if not mhi_outside(ha, hb, hc, point[0], point[1], point[2]): break
            tail <- tail - 1
        while tail - head > 1:
            if not mhi_intersect(qa[head], qb[head], qc[head], qa[head + 1], qb[head + 1], qc[head + 1], point[0:3]): break
            if not mhi_outside(ha, hb, hc, point[0], point[1], point[2]): break
            head <- head + 1
        if tail > head:
            if qa[tail - 1] * hb - qb[tail - 1] * ha == 0:
                if qa[tail - 1] * ha + qb[tail - 1] * hb < 0:
                    head <- 0; tail <- 0; empty <- true; break
                if hc < qc[tail - 1]: qa[tail - 1] <- ha; qb[tail - 1] <- hb; qc[tail - 1] <- hc
                continue
        qa[tail] <- ha; qb[tail] <- hb; qc[tail] <- hc
        tail <- tail + 1
    if empty: head <- 0; tail <- 0
    if tail - head >= 3:
        while tail - head > 2:
            if not mhi_intersect(qa[tail - 2], qb[tail - 2], qc[tail - 2], qa[tail - 1], qb[tail - 1], qc[tail - 1], point[0:3]): break
            if not mhi_outside(qa[head], qb[head], qc[head], point[0], point[1], point[2]): break
            tail <- tail - 1
        while tail - head > 2:
            if not mhi_intersect(qa[head], qb[head], qc[head], qa[head + 1], qb[head + 1], qc[head + 1], point[0:3]): break
            if not mhi_outside(qa[tail - 1], qb[tail - 1], qc[tail - 1], point[0], point[1], point[2]): break
            head <- head + 1
    point_count: mutable usize = 0
    if tail - head >= 3:
        for i in head..<tail:
            next: usize = if i + 1 == tail: head else: i + 1
            if not mhi_intersect(qa[i], qb[i], qc[i], qa[next], qb[next], qc[next], point[0:3]):
                point_count <- 0
                break
            px[point_count] <- point[0]; py[point_count] <- point[1]; pd[point_count] <- point[2]
            point_count <- point_count + 1
    clean_count: mutable usize = 0
    for i in 0..<point_count:
        if clean_count == 0 or not mhi_same(cx[clean_count - 1], cy[clean_count - 1], cd[clean_count - 1], px[i], py[i], pd[i]):
            cx[clean_count] <- px[i]; cy[clean_count] <- py[i]; cd[clean_count] <- pd[i]
            clean_count <- clean_count + 1
    if clean_count > 1 and mhi_same(cx[0], cy[0], cd[0], cx[clean_count - 1], cy[clean_count - 1], cd[clean_count - 1]): clean_count <- clean_count - 1
    changed: mutable bool = true
    while changed and clean_count >= 3:
        changed <- false
        for i in 0..<clean_count:
            prev: usize = (i + clean_count - 1) % clean_count
            next: usize = (i + 1) % clean_count
            if mhi_orient(cx[prev], cy[prev], cd[prev], cx[i], cy[i], cd[i], cx[next], cy[next], cd[next]) == 0:
                for j in i..<clean_count - 1:
                    cx[j] <- cx[j + 1]; cy[j] <- cy[j + 1]; cd[j] <- cd[j + 1]
                clean_count <- clean_count - 1
                changed <- true
                break
    if clean_count < 3: clean_count <- 0
    if clean_count > 0:
        first: mutable usize = 0
        for i in 1..<clean_count:
            if mhi_less_yx(cx[i], cy[i], cd[i], cx[first], cy[first], cd[first]): first <- i
        tx: mutable i64[MHI_MAX_LINES] = zeroed
        ty: mutable i64[MHI_MAX_LINES] = zeroed
        td: mutable i64[MHI_MAX_LINES] = zeroed
        for i in 0..<clean_count:
            tx[i] <- cx[(first + i) % clean_count]; ty[i] <- cy[(first + i) % clean_count]; td[i] <- cd[(first + i) % clean_count]
        for i in 0..<clean_count: cx[i] <- tx[i]; cy[i] <- ty[i]; cd[i] <- td[i]
    needed: usize = (1 + 4 * clean_count) * 8
    if output_is_null or needed > capacity or output.len() < needed: return -2
    mhi_put_i64(output, 0, clean_count.i64())
    for i in 0..<clean_count:
        gx: i64 = mhi_gcd(cx[i], cd[i]); gy: i64 = mhi_gcd(cy[i], cd[i])
        base: usize = 8 + 32 * i
        mhi_put_i64(output, base, cx[i] / gx)
        mhi_put_i64(output, base + 8, cd[i] / gx)
        mhi_put_i64(output, base + 16, cy[i] / gy)
        mhi_put_i64(output, base + 24, cd[i] / gy)
    needed.i64()

export fn half_plane_intersection(values: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if values.is_null() or length > MHI_MAX_INPUT: return -1
    if output.is_null():
        staged: mutable u8[1] = zeroed
        return half_plane_intersection_impl(values[0:length], staged[0:1], capacity, true)
    half_plane_intersection_impl(values[0:length], output[0:capacity], capacity, false)
