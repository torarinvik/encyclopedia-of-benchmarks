const HIGE_MAX_N: usize = 8
const HIGE_MAX_M: usize = 12
const HIGE_MAX_INPUT: usize = 111

def fn hige_put_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

@export("hypergraph_incidence_graph_encoding")
def hypergraph_incidence_graph_encoding(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > HIGE_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    n64: i64 = input_view[0]
    m64: i64 = input_view[1]
    if n64 < 1 or n64 > 8 or m64 < 0 or m64 > 12: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    incidence: mutable bool[96] = zeroed
    offset: mutable usize = 2
    edge: mutable usize = 0
    while edge < m:
        if offset >= length: return -1
        size64: i64 = input_view[offset]
        offset <- offset + 1
        if size64 < 0 or size64 > n64 or size64.usize() > length - offset: return -1
        item: mutable usize = 0
        while item < size64.usize():
            vertex64: i64 = input_view[offset]
            offset <- offset + 1
            if vertex64 < 0 or vertex64 >= n64: return -1
            vertex: usize = vertex64.usize()
            index: usize = vertex * HIGE_MAX_M + edge
            if incidence[index]: return -1
            incidence[index] <- true
            item <- item + 1
        edge <- edge + 1
    if offset != length: return -1

    count: mutable usize = 0
    vertex: mutable usize = 0
    while vertex < n:
        edge <- 0
        while edge < m:
            if incidence[vertex * HIGE_MAX_M + edge]: count <- count + 1
            edge <- edge + 1
        vertex <- vertex + 1
    nodes: usize = n + m
    bytes: usize = 8 * (2 + nodes + 2 * count)
    if output.is_null() or capacity < bytes: return -2
    output_view: mutable view[u8] = output[0:bytes]
    hige_put_le(nodes.i64(), output_view, 0)
    hige_put_le(count.i64(), output_view, 8)
    word: mutable usize = 2
    vertex <- 0
    while vertex < n:
        hige_put_le(0, output_view, 8 * word)
        word <- word + 1
        vertex <- vertex + 1
    edge <- 0
    while edge < m:
        hige_put_le(1, output_view, 8 * word)
        word <- word + 1
        edge <- edge + 1
    vertex <- 0
    while vertex < n:
        edge <- 0
        while edge < m:
            if incidence[vertex * HIGE_MAX_M + edge]:
                hige_put_le(vertex.i64(), output_view, 8 * word)
                word <- word + 1
                hige_put_le((n + edge).i64(), output_view, 8 * word)
                word <- word + 1
            edge <- edge + 1
        vertex <- vertex + 1
    return bytes.i64()
