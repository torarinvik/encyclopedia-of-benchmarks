# Bounded Park-Miller data generation, source-style Huffman coding, and round-trip decode.
const HUFFBENCH_DATA_BYTES: usize = 4096
const HUFFBENCH_MIN_PASSES: i64 = 1
const HUFFBENCH_MAX_PASSES: i64 = 30

def huffbench_heap_adjust(frequency: usize&, heap: mutable usize&, active: usize, one_based: usize) -> void:
    value: usize = heap[one_based - 1]
    index: mutable usize = one_based
    while index <= active / 2:
        child: mutable usize = index * 2
        if child < active and frequency[heap[child - 1]] > frequency[heap[child]]:
            child <- child + 1
        if frequency[value] < frequency[heap[child - 1]]:
            break
        heap[index - 1] <- heap[child - 1]
        index <- child
    heap[index - 1] <- value

def huffbench_random4(seed: mutable i64&) -> usize:
    seed <- seed ^ 123459876
    quotient: i64 = seed / 127773
    seed <- 16807 * (seed - quotient * 127773) - 2836 * quotient
    if seed < 0:
        seed <- seed + 2147483647
    result: usize = (seed % 32).usize()
    seed <- seed ^ 123459876
    result

def huffbench_compdecomp(data: mutable u8&, compressed: mutable u8&,
        compressed_length: mutable usize&, checksum: mutable u32&) -> bool:
    frequency: mutable usize[512] = zeroed
    heap: mutable usize[256] = zeroed
    link: mutable i64[512] = zeroed
    code: mutable u32[256] = zeroed
    code_length: mutable usize[256] = zeroed
    for index in 0..<HUFFBENCH_DATA_BYTES:
        frequency[data[index].usize()] <- frequency[data[index].usize()] + 1

    active: mutable usize = 0
    for symbol in 0..<256:
        if frequency[symbol] != 0:
            heap[active] <- symbol
            active <- active + 1
    index: mutable usize = active
    while index > 0:
        huffbench_heap_adjust(frequency, &heap[0], active, index)
        index <- index - 1
    while active > 1:
        active <- active - 1
        first: usize = heap[0]
        heap[0] <- heap[active]
        huffbench_heap_adjust(frequency, &heap[0], active, 1)
        parent: usize = 256 + active
        frequency[parent] <- frequency[heap[0]] + frequency[first]
        link[first] <- parent.i64()
        link[heap[0]] <- -parent.i64()
        heap[0] <- parent
        huffbench_heap_adjust(frequency, &heap[0], active, 1)
    link[256 + active] <- 0

    for symbol in 0..<256:
        if frequency[symbol] == 0:
            continue
        depth: mutable usize = 0
        bit: mutable u32 = 1
        value: mutable u32 = 0
        parent: mutable i64 = link[symbol]
        while parent != 0:
            if parent < 0:
                value <- value + bit
                parent <- -parent
            parent <- link[parent.usize()]
            bit <- bit << 1
            depth <- depth + 1
        code[symbol] <- value
        code_length[symbol] <- depth

    compressed_used: mutable usize = 0
    bout: mutable u8 = 0
    bit_index: mutable i64 = -1
    for index in 0..<HUFFBENCH_DATA_BYTES:
        symbol: usize = data[index].usize()
        mask: mutable u32 = 1.u32() << (code_length[symbol] - 1)
        bit: mutable usize = 0
        while bit < code_length[symbol]:
            if bit_index == 7:
                compressed[compressed_used] <- bout
                compressed_used <- compressed_used + 1
                bit_index <- 0
                bout <- 0
            else:
                bit_index <- bit_index + 1
                bout <- bout << 1
            if (code[symbol] & mask) != 0:
                bout <- bout | 1
            mask <- mask >> 1
            bit <- bit + 1
    bout <- bout << (7 - bit_index).u8()
    compressed[compressed_used] <- bout
    compressed_used <- compressed_used + 1

    child_zero: mutable i64[512] = zeroed
    child_one: mutable i64[512] = zeroed
    decoded_symbol: mutable i64[512] = zeroed
    for node in 0..<512:
        child_zero[node] <- -1
        child_one[node] <- -1
        decoded_symbol[node] <- -1
    node_count: mutable usize = 1
    for symbol in 0..<256:
        if frequency[symbol] == 0:
            continue
        node: mutable usize = 0
        bit: mutable i64 = code_length[symbol].i64() - 1
        while bit >= 0:
            direction: usize = ((code[symbol] >> bit.usize()) & 1).usize()
            next_node: i64 = if direction == 0 then child_zero[node] else child_one[node]
            if next_node < 0:
                next_node <- node_count.i64()
                if direction == 0:
                    child_zero[node] <- next_node
                else:
                    child_one[node] <- next_node
                node_count <- node_count + 1
            node <- next_node.usize()
            bit <- bit - 1
        decoded_symbol[node] <- symbol.i64()

    decoded: mutable usize = 0
    sum: mutable u64 = 0
    node: mutable usize = 0
    index <- 0
    while index < compressed_used and decoded < HUFFBENCH_DATA_BYTES:
        bit <- 7
        while bit >= 0 and decoded < HUFFBENCH_DATA_BYTES:
            direction: usize = ((compressed[index] >> bit.usize()) & 1).usize()
            node_value: i64 = if direction == 0 then child_zero[node] else child_one[node]
            if node_value < 0:
                return false
            node <- node_value.usize()
            if decoded_symbol[node] >= 0:
                data[decoded] <- decoded_symbol[node].u8()
                sum <- sum + decoded_symbol[node].u64()
                decoded <- decoded + 1
                node <- 0
            bit <- bit - 1
        index <- index + 1
    if decoded != HUFFBENCH_DATA_BYTES:
        return false
    compressed_length <- compressed_used
    checksum <- sum.u32()
    true

def huffbench_append_decimal(value_input: u32, output: mutable u8&, position_input: usize) -> usize:
    digits: mutable u8[10]
    digit_count: mutable usize = 0
    value: mutable u32 = value_input
    while true:
        digits[digit_count] <- (48.u32() + value % 10).u8()
        digit_count <- digit_count + 1
        value <- value / 10
        if value == 0:
            break
    position: mutable usize = position_input
    while digit_count > 0:
        digit_count <- digit_count - 1
        output[position] <- digits[digit_count]
        position <- position + 1
    position

def coyote_huffbench_impl(passes: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if passes < HUFFBENCH_MIN_PASSES or passes > HUFFBENCH_MAX_PASSES:
        return -1
    if output == null:
        return -2

    data: mutable u8[HUFFBENCH_DATA_BYTES] = zeroed
    seed: mutable i64 = 1325
    for index in 0..<HUFFBENCH_DATA_BYTES:
        random_index: usize = huffbench_random4(seed)
        if random_index < 26:
            data[index] <- (65 + random_index).u8()
        else:
            data[index] <- (48 + random_index - 26).u8()

    compressed: mutable u8[HUFFBENCH_DATA_BYTES + 1] = zeroed
    compressed_length: mutable usize = 0
    checksum: mutable u32 = 0
    pass: mutable i64 = 0
    while pass < passes:
        if not huffbench_compdecomp(&data[0], &compressed[0], &compressed_length, &checksum):
            return -1
        pass <- pass + 1

    staged: mutable u8[52] = zeroed
    position: mutable usize = 0
    staged[position] <- 72; position <- position + 1
    staged[position] <- 117; position <- position + 1
    staged[position] <- 102; position <- position + 1
    staged[position] <- 102; position <- position + 1
    staged[position] <- 98; position <- position + 1
    staged[position] <- 101; position <- position + 1
    staged[position] <- 110; position <- position + 1
    staged[position] <- 99; position <- position + 1
    staged[position] <- 104; position <- position + 1
    staged[position] <- 32; position <- position + 1
    staged[position] <- 112; position <- position + 1
    staged[position] <- 97; position <- position + 1
    staged[position] <- 115; position <- position + 1
    staged[position] <- 115; position <- position + 1
    staged[position] <- 101; position <- position + 1
    staged[position] <- 115; position <- position + 1
    staged[position] <- 61; position <- position + 1
    position <- huffbench_append_decimal(passes.u32(), staged, position)
    staged[position] <- 32; position <- position + 1
    staged[position] <- 99; position <- position + 1
    staged[position] <- 111; position <- position + 1
    staged[position] <- 109; position <- position + 1
    staged[position] <- 112; position <- position + 1
    staged[position] <- 114; position <- position + 1
    staged[position] <- 101; position <- position + 1
    staged[position] <- 115; position <- position + 1
    staged[position] <- 115; position <- position + 1
    staged[position] <- 101; position <- position + 1
    staged[position] <- 100; position <- position + 1
    staged[position] <- 61; position <- position + 1
    position <- huffbench_append_decimal(compressed_length.u32(), staged, position)
    staged[position] <- 32; position <- position + 1
    staged[position] <- 99; position <- position + 1
    staged[position] <- 104; position <- position + 1
    staged[position] <- 101; position <- position + 1
    staged[position] <- 99; position <- position + 1
    staged[position] <- 107; position <- position + 1
    staged[position] <- 115; position <- position + 1
    staged[position] <- 117; position <- position + 1
    staged[position] <- 109; position <- position + 1
    staged[position] <- 61; position <- position + 1
    position <- huffbench_append_decimal(checksum, staged, position)
    staged[position] <- 10
    position <- position + 1
    if output_capacity < position:
        return -2
    for index in 0..<position:
        output[index] <- staged[index]
    position.i64()

export fn coyote_huffbench(passes: i64, output: mutable u8&, output_capacity: usize) -> i64 = coyote_huffbench_impl
