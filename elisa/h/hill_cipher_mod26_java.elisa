def hill_cipher_mod26_java_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 257: return -1
    if input[0] != 0 and input[0] != 1: return -1
    key: mutable i64[4] = zeroed
    if input[0] == 0:
        key[0] <- 3
        key[1] <- 3
        key[2] <- 2
        key[3] <- 5
    else:
        key[0] <- 15
        key[1] <- 17
        key[2] <- 20
        key[3] <- 9
    text: mutable u8[256] = zeroed
    text_length: mutable usize = 0
    index: mutable usize = 1
    while index < length:
        raw: i64 = input[index]
        if raw < 0 or raw > 127: return -1
        character: mutable i64 = raw
        if character >= 97 and character <= 122: character <- character - 32
        if character >= 65 and character <= 90:
            text[text_length] <- character.u8()
            text_length <- text_length + 1
        index <- index + 1
    if text_length % 2 == 1:
        text[text_length] <- 88
        text_length <- text_length + 1
    if text_length > capacity or (text_length > 0 and output.is_null()): return -2
    if text_length == 0: return 0
    index <- 0
    while index < text_length:
        a: i64 = (text[index] - 65).i64()
        b: i64 = (text[index + 1] - 65).i64()
        output[index] <- (65 + (key[0] * a + key[1] * b) % 26).u8()
        output[index + 1] <- (65 + (key[2] * a + key[3] * b) % 26).u8()
        index <- index + 2
    text_length.i64()

export fn hill_cipher_mod26_java(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = hill_cipher_mod26_java_impl
