const MAX_OPERATIONS: usize = 512
const MAX_ITEMS: usize = 128
const ID_CAPACITY: usize = 4096
const MAX_INPUT_LENGTH: usize = 1537
const FNV_OFFSET: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211

def heap_generic_hash_byte(hash: u64, byte: u64) -> u64:
    ((hash ^ (byte & 255)) * FNV_PRIME)

def heap_generic_hash_i32(hash_value: u64, value: i64) -> u64:
    hash: mutable u64 = hash_value
    bits: u64 = if value < 0: (value + 4294967296).u64() else: value.u64()
    byte: mutable usize = 0
    while byte < 4:
        hash <- heap_generic_hash_byte(hash, (bits >> (byte * 8)) & 255)
        byte <- byte + 1
    hash

def heap_generic_swap(ids: mutable i64[128], priorities: mutable i64[128],
                      positions: mutable i64[4096], first: usize, second: usize) -> void:
    temp_id: i64 = ids[first]
    ids[first] <- ids[second]
    ids[second] <- temp_id
    temp_priority: i64 = priorities[first]
    priorities[first] <- priorities[second]
    priorities[second] <- temp_priority
    positions[ids[first].usize()] <- first.i64()
    positions[ids[second].usize()] <- second.i64()

def heap_generic_up(ids: mutable i64[128], priorities: mutable i64[128],
                    positions: mutable i64[4096], start: usize) -> void:
    index: mutable usize = start
    while index > 0:
        parent: usize = (index - 1) / 2
        if priorities[index] <= priorities[parent]: break
        heap_generic_swap(ids, priorities, positions, index, parent)
        index <- parent

def heap_generic_down(ids: mutable i64[128], priorities: mutable i64[128],
                      positions: mutable i64[4096], heap_size: usize, start: usize) -> void:
    index: mutable usize = start
    while true:
        best: mutable usize = index
        left: usize = 2 * index + 1
        right: usize = left + 1
        if left < heap_size and priorities[left] > priorities[best]: best <- left
        if right < heap_size and priorities[right] > priorities[best]: best <- right
        if best == index: break
        heap_generic_swap(ids, priorities, positions, index, best)
        index <- best

def heap_generic_erase(ids: mutable i64[128], priorities: mutable i64[128],
                       positions: mutable i64[4096], heap_size: mutable usize&,
                       item_id: usize) -> void:
    index: usize = positions[item_id].usize()
    last: usize = heap_size - 1
    positions[item_id] <- -1
    if index != last:
        ids[index] <- ids[last]
        priorities[index] <- priorities[last]
        positions[ids[index].usize()] <- index.i64()
    heap_size <- last
    if index < heap_size:
        heap_generic_up(ids, priorities, positions, index)
        heap_generic_down(ids, priorities, positions, heap_size, index)

def heap_generic_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 1 or length > MAX_INPUT_LENGTH: return -1
    operation_count_value: i64 = values[0]
    if operation_count_value < 0 or operation_count_value > MAX_OPERATIONS.i64() or
        length != 1 + 3 * operation_count_value.usize(): return -1

    ids: mutable i64[128] = zeroed
    priorities: mutable i64[128] = zeroed
    positions: mutable i64[4096] = zeroed
    used_ids: mutable bool[4096] = zeroed
    index: mutable usize = 0
    while index < ID_CAPACITY:
        positions[index] <- -1
        index <- index + 1
    heap_size: mutable usize = 0
    hash: mutable u64 = FNV_OFFSET

    operation: mutable usize = 0
    while operation < operation_count_value.usize():
        position: usize = 1 + 3 * operation
        opcode: i64 = values[position]
        item_id: i64 = values[position + 1]
        priority: i64 = values[position + 2]
        present: mutable bool = false
        returned_id: mutable i64 = 0
        returned_priority: mutable i64 = 0

        if opcode == 0:
            if item_id < 0 or item_id >= ID_CAPACITY.i64() or priority < -2147483648 or priority > 2147483647 or
                used_ids[item_id.usize()] or heap_size >= MAX_ITEMS: return -1
            index <- 0
            while index < heap_size:
                if priorities[index] == priority: return -1
                index <- index + 1
            used_ids[item_id.usize()] <- true
            ids[heap_size] <- item_id
            priorities[heap_size] <- priority
            positions[item_id.usize()] <- heap_size.i64()
            heap_size <- heap_size + 1
            heap_generic_up(ids, priorities, positions, heap_size - 1)
        elif opcode == 1 or opcode == 2:
            if item_id != 0 or priority != 0: return -1
            if heap_size > 0:
                present <- true
                returned_id <- ids[0]
                returned_priority <- priorities[0]
                if opcode == 2:
                    heap_generic_erase(ids, priorities, positions, &heap_size, returned_id.usize())
        elif opcode == 3:
            if item_id < 0 or item_id >= ID_CAPACITY.i64() or priority < -2147483648 or priority > 2147483647 or
                positions[item_id.usize()] < 0: return -1
            heap_index: usize = positions[item_id.usize()].usize()
            index <- 0
            while index < heap_size:
                if index != heap_index and priorities[index] == priority: return -1
                index <- index + 1
            priorities[heap_index] <- priority
            heap_generic_up(ids, priorities, positions, heap_index)
            heap_generic_down(ids, priorities, positions, heap_size, heap_index)
        elif opcode == 4:
            if item_id < 0 or item_id >= ID_CAPACITY.i64() or priority != 0 or positions[item_id.usize()] < 0: return -1
            heap_generic_erase(ids, priorities, positions, &heap_size, item_id.usize())
        else: return -1

        hash <- heap_generic_hash_byte(hash, opcode.u64())
        hash <- heap_generic_hash_byte(hash, if present: 1 else: 0)
        if present:
            hash <- heap_generic_hash_i32(hash, returned_id)
            hash <- heap_generic_hash_i32(hash, returned_priority)
        operation <- operation + 1
    hash.i64()

export fn heap_generic(values: i64&, length: usize) -> i64 = heap_generic_impl
