const MAX_N: usize = 32
const MAX_INPUT: usize = 33
const CAPACITY: i64 = 10000

def harmonic_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def harmonic_4_bin_packing(input: i64&, length: usize,
                           output: mutable u8&, capacity: usize) -> i64 @export("harmonic_4_bin_packing"):
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    if n64 < 1 or n64 > 32 or length != 1 + n64.usize(): return -1
    n: usize = n64.usize()
    i: mutable usize = 0
    while i < n:
        if input[1 + i] < 1 or input[1 + i] > CAPACITY: return -1
        i <- i + 1
    output_bytes: usize = 8 * (n + 1)
    if output.is_null() or capacity < output_bytes: return -2
    current: mutable i64[4] = [-1, -1, -1, -1]
    remaining: mutable i64[4] = zeroed
    assignment: mutable i64[32] = zeroed
    bins: mutable i64 = 0
    i <- 0
    while i < n:
        size: i64 = input[1 + i]
        kind: usize = if size * 2 > CAPACITY: 0 else if size * 3 > CAPACITY: 1 else if size * 4 > CAPACITY: 2 else: 3
        if current[kind] < 0 or size > remaining[kind]:
            current[kind] <- bins
            bins <- bins + 1
            remaining[kind] <- CAPACITY
        assignment[i] <- current[kind]
        remaining[kind] <- remaining[kind] - size
        i <- i + 1
    harmonic_store_i64_le(bins, output, 0)
    i <- 0
    while i < n:
        harmonic_store_i64_le(assignment[i], output, 8 * (i + 1))
        i <- i + 1
    output_bytes.i64()
