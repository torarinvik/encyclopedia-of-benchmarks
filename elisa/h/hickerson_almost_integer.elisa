extern log(value: f64) -> f64

const INVALID_RESULT: f64 = -1.0e300

def hickerson_impl(values: i64&, values_length: usize) -> f64:
    if values_length != 1 or values[0] < 1 or values[0] > 17: return INVALID_RESULT
    log_two:  f64 = log(2.0)
    value: mutable f64 = 1.0 / (2.0 * log_two * log_two)
    n: mutable i64 = 2
    while n <= values[0]:
        value <- (n.f64() / log_two) * value
        n <- n + 1
    value

def hickerson_almost_integer_impl(values: i64&, length: usize) -> f64:
    if values == null or length != 1: return INVALID_RESULT
    hickerson_impl(values, length)

export fn hickerson_almost_integer(values: i64&, length: usize) -> f64 = hickerson_almost_integer_impl
