def horspool_search_impl(input_values: i64&, length: usize) -> i64:
    if length < 2:
        return -2
    text_length_value: i64 = input_values[0]
    pattern_length_value: i64 = input_values[1]
    if text_length_value < 0 or text_length_value > 512 or pattern_length_value < 0 or pattern_length_value > 64:
        return -2
    text_length: usize = text_length_value.usize()
    pattern_length: usize = pattern_length_value.usize()
    if length != text_length + pattern_length + 2:
        return -2
    pattern_start: usize = 2 + text_length
    for index in 0..<text_length:
        byte: i64 = input_values[2 + index]
        if byte < 0 or byte > 127:
            return -2
    for index in 0..<pattern_length:
        byte: i64 = input_values[pattern_start + index]
        if byte < 0 or byte > 127:
            return -2
    if pattern_length == 0 or pattern_length > text_length:
        return -1
    shifts: mutable usize[128] = zeroed
    for ch in 0..<128:
        shifts[ch] <- pattern_length
    index: mutable usize = pattern_length - 1
    while index > 0:
        byte: usize = input_values[pattern_start + index - 1].usize()
        if shifts[byte] == pattern_length:
            shifts[byte] <- pattern_length - index
        index <- index - 1
    result: i64 =
        while end_index < text_length |end_index: mutable usize = pattern_length - 1, result: mutable i64 = -1| -> result:
            matched: bool =
                while offset < pattern_length |offset: mutable usize = 0, matched: mutable bool = true| -> matched:
                    pattern_index: usize = pattern_length - 1 - offset
                    if input_values[pattern_start + pattern_index] != input_values[2 + end_index - offset]:
                        break false
                    offset <- offset + 1
                    matched
            if matched:
                break (end_index - pattern_length + 1).i64()
            byte: usize = input_values[2 + end_index].usize()
            end_index <- end_index + shifts[byte]
            result
    result

export fn horspool_search(input_values: i64&, length: usize) -> i64 = horspool_search_impl
