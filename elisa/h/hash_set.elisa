# Bounded port of the pinned C hash set's ASCII-key insertion and lookup.
const MAX_IDS: i64 = 64
const MAX_INPUT_LENGTH: usize = 130
const CAPACITY: usize = 1024
const FNV_OFFSET_BASIS: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211

def hash_set_adler_key(id: i64) -> u64:
    a: mutable u64 = 1.u64()
    b: mutable u64 = 0.u64()
    a <- (a + 107.u64()) % 65521.u64()
    b <- (b + a) % 65521.u64()
    a <- (a + 101.u64()) % 65521.u64()
    b <- (b + a) % 65521.u64()
    a <- (a + 121.u64()) % 65521.u64()
    b <- (b + a) % 65521.u64()
    if id >= 10:
        a <- (a + (id / 10 + 48).u64()) % 65521.u64()
        b <- (b + a) % 65521.u64()
    a <- (a + (id % 10 + 48).u64()) % 65521.u64()
    b <- (b + a) % 65521.u64()
    (b << 16) | a

def hash_set_bucket_for_id(id: i64) -> usize:
    hash: u64 = hash_set_adler_key(id)
    ((1023.u64() & (hash ^ (hash >> 12))).usize())

def hash_set_fnv_word(hash: u64, value: i64) -> u64:
    bits: u64 = value.u64()
    result: mutable u64 = hash
    for byte in 0..<8:
        octet: u64 = (bits >> (byte * 8)) & 255.u64()
        result <- (result ^ octet) * FNV_PRIME
    result

def hash_set_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH: return -1
    add_count_value: i64 = input[0]
    if add_count_value < 0 or add_count_value > MAX_IDS: return -1
    add_count: usize = add_count_value.usize()
    query_count_index: usize = 1 + add_count
    if query_count_index >= length: return -1
    query_count_value: i64 = input[query_count_index]
    if query_count_value < 0 or query_count_value > MAX_IDS: return -1
    query_count: usize = query_count_value.usize()
    if length != 2 + add_count + query_count: return -1

    for index in 0..<add_count:
        if input[1 + index] < 0 or input[1 + index] >= MAX_IDS: return -1
    for index in 0..<query_count:
        if input[query_count_index + 1 + index] < 0 or input[query_count_index + 1 + index] >= MAX_IDS: return -1

    occupied: mutable bool[1024] = zeroed
    slot_ids: mutable i64[1024] = zeroed
    set_length: mutable i64 = 0
    for index in 0..<add_count:
        id: i64 = input[1 + index]
        bucket: usize = hash_set_bucket_for_id(id)
        if not occupied[bucket]:
            occupied[bucket] <- true
            slot_ids[bucket] <- id
            set_length <- set_length + 1
        else if slot_ids[bucket] != id:
            return -1

    result: mutable u64 = hash_set_fnv_word(FNV_OFFSET_BASIS, set_length)
    for index in 0..<query_count:
        id: i64 = input[query_count_index + 1 + index]
        bucket: usize = hash_set_bucket_for_id(id)
        contains: i64 = if occupied[bucket] and slot_ids[bucket] == id: 1 else: 0
        result <- hash_set_fnv_word(result, contains)
    (result & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn hash_set(input: i64&, length: usize) -> i64 = hash_set_impl
