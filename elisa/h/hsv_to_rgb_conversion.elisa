# Convert bounded HSV inputs to RGB bytes using JavaScript Math.round tie behavior.
def hsv_to_rgb_conversion_section_remainder_two(section: f64) -> f64:
    if section < 2.0:
        return section
    if section < 4.0:
        return section - 2.0
    if section < 6.0:
        return section - 4.0
    return section - 6.0

def hsv_to_rgb_conversion_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length != 3:
        return -1
    if input[0] < 0 or input[0] > 360000 or input[1] < 0 or input[1] > 255000000 or input[2] < 0 or input[2] > 255000000:
        return -1
    if output.is_null() or capacity < 3:
        return -2

    hue: f64 = input[0].f64() / 1000.0
    saturation: f64 = input[1].f64() / 255000000.0
    value: f64 = input[2].f64() / 255000000.0
    chroma: f64 = value * saturation
    hue_section: f64 = hue / 60.0
    remainder: f64 = hsv_to_rgb_conversion_section_remainder_two(hue_section)
    delta: f64 = remainder - 1.0
    if delta < 0.0: delta <- -delta
    second: f64 = chroma * (1.0 - delta)
    matched: f64 = value - chroma
    red: mutable f64 = 0.0
    green: mutable f64 = 0.0
    blue: mutable f64 = 0.0
    if hue_section >= 0.0 and hue_section <= 1.0:
        red <- chroma + matched
        green <- second + matched
        blue <- matched
    else if hue_section > 1.0 and hue_section <= 2.0:
        red <- second + matched
        green <- chroma + matched
        blue <- matched
    else if hue_section > 2.0 and hue_section <= 3.0:
        red <- matched
        green <- chroma + matched
        blue <- second + matched
    else if hue_section > 3.0 and hue_section <= 4.0:
        red <- matched
        green <- second + matched
        blue <- chroma + matched
    else if hue_section > 4.0 and hue_section <= 5.0:
        red <- second + matched
        green <- matched
        blue <- chroma + matched
    else:
        red <- chroma + matched
        green <- matched
        blue <- second + matched
    output[0] <- (255.0 * red + 0.5).i64().u8()
    output[1] <- (255.0 * green + 0.5).i64().u8()
    output[2] <- (255.0 * blue + 0.5).i64().u8()
    return 3

export fn hsv_to_rgb_conversion(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = hsv_to_rgb_conversion_impl
