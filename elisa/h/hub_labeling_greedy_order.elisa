const HUB_MAX_N: usize = 8
const HUB_MAX_M: usize = 28
const HUB_MAX_OUT: usize = 81

def hub_labeling_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def hub_labeling_greedy_order(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("hub_labeling_greedy_order"):
    if input.is_null() or length < 2 or length > 58: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 8 or m_value < 0 or m_value > n_value * (n_value - 1) / 2 or length != 2 + 2 * m_value.usize(): return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    adjacent: mutable bool[8][8] = zeroed
    previous_u: mutable i64 = -1
    previous_v: mutable i64 = -1
    edge: mutable usize = 0
    while edge < m:
        u: i64 = input[2 + 2 * edge]
        v: i64 = input[3 + 2 * edge]
        if u < 0 or v <= u or v >= n_value or (edge > 0 and (u < previous_u or (u == previous_u and v <= previous_v))): return -1
        adjacent[u.usize()][v.usize()] <- true
        adjacent[v.usize()][u.usize()] <- true
        previous_u <- u
        previous_v <- v
        edge <- edge + 1

    parent: mutable i64[8][8] = zeroed
    depth: mutable i64[8][8] = zeroed
    ways: mutable i64[8][8] = zeroed
    source: mutable usize = 0
    while source < n:
        v: mutable usize = 0
        while v < n:
            parent[source][v] <- -1
            depth[source][v] <- -1
            ways[source][v] <- 0
            v <- v + 1
        queue: mutable usize[8] = zeroed
        head: mutable usize = 0
        tail: mutable usize = 0
        queue[tail] <- source
        tail <- tail + 1
        depth[source][source] <- 0
        ways[source][source] <- 1
        while head < tail:
            u: usize = queue[head]
            head <- head + 1
            neighbor: mutable usize = 0
            while neighbor < n:
                if adjacent[u][neighbor]:
                    if depth[source][neighbor] < 0:
                        depth[source][neighbor] <- depth[source][u] + 1
                        parent[source][neighbor] <- u.i64()
                        ways[source][neighbor] <- ways[source][u]
                        queue[tail] <- neighbor
                        tail <- tail + 1
                    else if depth[source][neighbor] == depth[source][u] + 1:
                        ways[source][neighbor] <- (ways[source][neighbor] + ways[source][u])
                        if ways[source][neighbor] > 2: ways[source][neighbor] <- 2
                neighbor <- neighbor + 1
        v <- 0
        while v < n:
            if depth[source][v] < 0 or ways[source][v] != 1: return -1
            v <- v + 1
        source <- source + 1

    active: mutable bool[8][8] = zeroed
    for_source: mutable usize = 0
    while for_source < n:
        target: mutable usize = 0
        while target < n:
            active[for_source][target] <- true
            target <- target + 1
        for_source <- for_source + 1
    order: mutable usize[8] = zeroed
    rank: mutable usize[8] = zeroed
    turn: mutable usize = 0
    while turn < n:
        counts: mutable usize[8] = zeroed
        source <- 0
        while source < n:
            target <- 0
            while target < n:
                if active[source][target]:
                    walk: mutable usize = target
                    while true:
                        counts[walk] <- counts[walk] + 1
                        if walk == source: break
                        walk <- parent[source][walk].usize()
                target <- target + 1
            source <- source + 1
        best: mutable usize = 0
        candidate: mutable usize = 1
        while candidate < n:
            if counts[candidate] > counts[best]: best <- candidate
            candidate <- candidate + 1
        order[turn] <- best
        rank[best] <- turn
        source <- 0
        while source < n:
            target <- 0
            while target < n:
                if active[source][target]:
                    walk: mutable usize = target
                    while true:
                        if walk == best:
                            active[source][target] <- false
                            break
                        if walk == source: break
                        walk <- parent[source][walk].usize()
                target <- target + 1
            source <- source + 1
        turn <- turn + 1

    has: mutable bool[8][8] = zeroed
    label_dist: mutable i64[8][8] = zeroed
    u: mutable usize = 0
    while u < n:
        v: mutable usize = u
        while v < n:
            path: mutable usize[8] = zeroed
            path_length: mutable usize = 0
            walk: mutable usize = v
            while true:
                path[path_length] <- walk
                path_length <- path_length + 1
                if walk == u: break
                if parent[u][walk] < 0: return -1
                walk <- parent[u][walk].usize()
            hub: mutable usize = path[0]
            position: mutable usize = 1
            while position < path_length:
                if rank[path[position]] < rank[hub]: hub <- path[position]
                position <- position + 1
            has[u][hub] <- true
            has[v][hub] <- true
            label_dist[u][hub] <- depth[u][hub]
            label_dist[v][hub] <- depth[v][hub]
            v <- v + 1
        u <- u + 1

    staged: mutable i64[81] = zeroed
    used: mutable usize = 0
    staged[used] <- n.i64(); used <- used + 1
    turn <- 0
    while turn < n:
        staged[used] <- order[turn].i64(); used <- used + 1; turn <- turn + 1
    v <- 0
    while v < n:
        count: mutable usize = 0
        candidate <- 0
        while candidate < n:
            if has[v][candidate]: count <- count + 1
            candidate <- candidate + 1
        staged[used] <- count.i64(); used <- used + 1
        candidate <- 0
        while candidate < n:
            if has[v][candidate]:
                staged[used] <- (candidate.i64() | (label_dist[v][candidate] << 8))
                used <- used + 1
            candidate <- candidate + 1
        v <- v + 1
    required: usize = used * 8
    if output.is_null() or capacity < required: return -2
    index: mutable usize = 0
    while index < used:
        hub_labeling_put_i64(output[0:required], index * 8, staged[index])
        index <- index + 1
    return required.i64()
