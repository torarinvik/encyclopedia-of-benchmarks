def hash_xor8_impl(values: i64&, length: usize) -> i64:
    if length > 100001:
        return -1
    i: mutable usize = 0
    while i < length:
        if values[i] == 0:
            break
        if values[i] < 0 or values[i] > 127:
            return -1
        i <- i + 1
    hash: mutable u64 = 0
    i <- 0
    while i < length and values[i] != 0:
        hash <- (hash + (values[i] as u64)) & 255
        i <- i + 1
    (((hash ^ 255) + 1) & 255) as i64

export fn hash_xor8(values: i64&, length: usize) -> i64 = hash_xor8_impl
