# Fixed 16-slot, H=4 hopscotch table. The exported boundary is converted to bounded views.
const HS_SLOTS: usize = 16
const HS_H: usize = 4
const HS_MAX_OPS: usize = 32

def hs_distance(from: usize, to: usize) -> usize:
    (to + HS_SLOTS - from) % HS_SLOTS

def hs_contains(keys: view[i16], hops: view[u8], key: usize, home: usize) -> bool:
    offset: mutable usize = 0
    while offset < HS_H:
        if (hops[home] & (1.u8() << offset)) != 0:
            slot: usize = (home + offset) % HS_SLOTS
            if keys[slot] == key.i16(): return true
        offset <- offset + 1
    false

def hs_insert(keys: mutable view[i16], homes: mutable view[u8], hops: mutable view[u8],
              key: usize, home: usize) -> u8:
    if hs_contains(keys, hops, key, home): return 2
    hole: mutable usize = HS_SLOTS
    step: mutable usize = 0
    while step < HS_SLOTS:
        slot: usize = (home + step) % HS_SLOTS
        if keys[slot] < 0:
            hole <- slot
            break
        step <- step + 1
    if hole == HS_SLOTS: return 0

    reach: mutable usize = hs_distance(home, hole)
    while reach >= HS_H:
        shifted: mutable bool = false
        back: mutable usize = HS_H - 1
        while back > 0 and not shifted:
            bucket: usize = (hole + HS_SLOTS - back) % HS_SLOTS
            new_offset: usize = hs_distance(bucket, hole)
            if hs_distance(home, bucket) < reach:
                old_offset: mutable usize = 0
                while old_offset < new_offset:
                    if (hops[bucket] & (1.u8() << old_offset)) != 0:
                        old_slot: usize = (bucket + old_offset) % HS_SLOTS
                        if keys[old_slot] >= 0 and homes[old_slot].usize() == bucket and
                           hs_distance(home, old_slot) < reach:
                            keys[hole] <- keys[old_slot]
                            homes[hole] <- homes[old_slot]
                            keys[old_slot] <- -1
                            homes[old_slot] <- 0
                            hops[bucket] <- hops[bucket] ^ (1.u8() << old_offset)
                            hops[bucket] <- hops[bucket] | (1.u8() << new_offset)
                            hole <- old_slot
                            reach <- hs_distance(home, hole)
                            shifted <- true
                            break
                    old_offset <- old_offset + 1
            back <- back - 1
        if not shifted: return 0

    keys[hole] <- key.i16()
    homes[hole] <- home.u8()
    hops[home] <- hops[home] | (1.u8() << reach)
    1

def hash_map_hopscotch_hashing_impl(input: view[i64], output: mutable u8&, capacity: usize) -> i64:
    length: usize = input.len()
    if length < 1 or length > 1 + 3 * HS_MAX_OPS: return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > HS_MAX_OPS.i64(): return -1
    count: usize = count_value.usize()
    if length != 1 + 3 * count: return -1

    known_home: mutable i8[64] = zeroed
    key: mutable usize = 0
    while key < 64:
        known_home[key] <- -1
        key <- key + 1
    op: mutable usize = 0
    while op < count:
        opcode: i64 = input[1 + 3 * op]
        raw_key: i64 = input[2 + 3 * op]
        raw_home: i64 = input[3 + 3 * op]
        if (opcode != 1 and opcode != 2) or raw_key < 0 or raw_key >= 64 or
           raw_home < 0 or raw_home >= HS_SLOTS.i64(): return -1
        key <- raw_key.usize()
        if known_home[key] >= 0 and known_home[key].i64() != raw_home: return -1
        known_home[key] <- raw_home.i8()
        op <- op + 1

    required: usize = count + 2 * HS_SLOTS
    if output.is_null() or capacity < required: return -2
    keys: mutable i16[HS_SLOTS] = zeroed
    homes: mutable u8[HS_SLOTS] = zeroed
    hops: mutable u8[HS_SLOTS] = zeroed
    statuses: mutable u8[HS_MAX_OPS] = zeroed
    slot: mutable usize = 0
    while slot < HS_SLOTS:
        keys[slot] <- -1
        slot <- slot + 1

    op <- 0
    while op < count:
        opcode: i64 = input[1 + 3 * op]
        key_value: usize = input[2 + 3 * op].usize()
        home_value: usize = input[3 + 3 * op].usize()
        if opcode == 1:
            statuses[op] <- hs_insert(keys[0:HS_SLOTS], homes[0:HS_SLOTS],
                                      hops[0:HS_SLOTS], key_value, home_value)
        else:
            if hs_contains(keys[0:HS_SLOTS], hops[0:HS_SLOTS], key_value, home_value):
                statuses[op] <- 1
        op <- op + 1

    result: mutable view[u8] = output[0:required]
    cursor: mutable usize = 0
    op <- 0
    while op < count:
        result[cursor] <- statuses[op]
        cursor <- cursor + 1
        op <- op + 1
    slot <- 0
    while slot < HS_SLOTS:
        result[cursor] <- if keys[slot] < 0: 0.u8() else: (keys[slot] + 1).u8()
        cursor <- cursor + 1
        slot <- slot + 1
    slot <- 0
    while slot < HS_SLOTS:
        result[cursor] <- hops[slot]
        cursor <- cursor + 1
        slot <- slot + 1
    required.i64()

export fn hash_map_hopscotch_hashing(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 1 + 3 * HS_MAX_OPS: return -1
    hash_map_hopscotch_hashing_impl(input[0:length], output, capacity)
