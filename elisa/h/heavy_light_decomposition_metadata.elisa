def put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def heavy_light_decomposition_metadata_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 128 or m_value != n_value - 1: return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + 2 * m: return -1

    adjacency: mutable i64[16384] = zeroed
    degree: mutable usize[128] = zeroed
    for edge in 0..<m:
        u_value: i64 = input[2 + 2 * edge]
        v_value: i64 = input[3 + 2 * edge]
        if u_value < 0 or u_value >= n_value or v_value < 0 or v_value >= n_value or u_value == v_value: return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        for i in 0..<degree[u]:
            if adjacency[u * 128 + i] == v_value: return -1
        adjacency[u * 128 + degree[u]] <- v_value
        degree[u] <- degree[u] + 1
        adjacency[v * 128 + degree[v]] <- u_value
        degree[v] <- degree[v] + 1

    parent: mutable i64[128] = zeroed
    order: mutable usize[128] = zeroed
    stack: mutable usize[128] = zeroed
    for vertex in 0..<n: parent[vertex] <- -2
    parent[0] <- -1
    top: mutable usize = 1
    order_count: mutable usize = 0
    stack[0] <- 0
    while top > 0:
        top <- top - 1
        vertex: usize = stack[top]
        order[order_count] <- vertex
        order_count <- order_count + 1
        i: mutable usize = degree[vertex]
        while i > 0:
            i <- i - 1
            child: usize = adjacency[vertex * 128 + i].usize()
            if parent[child] == -2:
                parent[child] <- vertex.i64()
                stack[top] <- child
                top <- top + 1
    if order_count != n: return -1

    subtree_size: mutable usize[128] = zeroed
    big_child: mutable i64[128] = zeroed
    index: mutable usize = n
    while index > 0:
        index <- index - 1
        vertex: usize = order[index]
        best_size: mutable usize = 0
        subtree_size[vertex] <- 1
        big_child[vertex] <- -1
        for i in 0..<degree[vertex]:
            child: usize = adjacency[vertex * 128 + i].usize()
            if parent[child] != vertex.i64(): continue
            subtree_size[vertex] <- subtree_size[vertex] + subtree_size[child]
            if subtree_size[child] > best_size:
                best_size <- subtree_size[child]
                big_child[vertex] <- child.i64()

    position: mutable i64[128] = zeroed
    head: mutable i64[128] = zeroed
    stack_head: mutable usize[128] = zeroed
    top <- 1
    next_position: mutable i64 = 0
    stack[0] <- 0
    stack_head[0] <- 0
    while top > 0:
        top <- top - 1
        vertex: usize = stack[top]
        chain_head: usize = stack_head[top]
        position[vertex] <- next_position
        head[vertex] <- chain_head.i64()
        next_position <- next_position + 1
        i: mutable usize = degree[vertex]
        while i > 0:
            i <- i - 1
            child: usize = adjacency[vertex * 128 + i].usize()
            if parent[child] == vertex.i64() and big_child[vertex] != child.i64():
                stack[top] <- child
                stack_head[top] <- child
                top <- top + 1
        if big_child[vertex] >= 0:
            child: usize = big_child[vertex].usize()
            stack[top] <- child
            stack_head[top] <- chain_head
            top <- top + 1

    required: usize = (1 + 3 * n) * 8
    if output.is_null() or capacity < required: return -2
    cursor: mutable usize = 0
    put_i64(output[0:required], cursor * 8, n_value)
    cursor <- cursor + 1
    for vertex in 0..<n:
        put_i64(output[0:required], cursor * 8, position[vertex])
        cursor <- cursor + 1
        put_i64(output[0:required], cursor * 8, head[vertex])
        cursor <- cursor + 1
        put_i64(output[0:required], cursor * 8, big_child[vertex])
        cursor <- cursor + 1
    required.i64()

export fn heavy_light_decomposition_metadata(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = heavy_light_decomposition_metadata_impl
