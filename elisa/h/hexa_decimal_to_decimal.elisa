const MAX_INPUT_LENGTH: usize = 64
const MAX_PARSEABLE_INPUT_LENGTH: usize = 65
const INVALID_RESULT: i64 = -2147483649
const UINT32_MODULUS: u64 = 4294967296

def hexa_decimal_to_decimal_impl(input: i64&, length: usize) -> i64:
    if length > MAX_PARSEABLE_INPUT_LENGTH:
        return INVALID_RESULT
    if length == 0:
        return 0
    if length > MAX_INPUT_LENGTH or input.is_null():
        return INVALID_RESULT

    accumulator: mutable u64 = 0
    index: mutable usize = 0
    while index < length:
        code: i64 = input[index]
        digit: mutable i64 = -1
        if code >= 48 and code <= 57:
            digit <- code - 48
        else if code >= 65 and code <= 70:
            digit <- code - 55
        else if code >= 97 and code <= 102:
            digit <- code - 87
        if digit < 0:
            return INVALID_RESULT
        accumulator <- (accumulator * 16 + digit.u64()) % UINT32_MODULUS
        index <- index + 1
    if accumulator <= 2147483647.u64():
        return accumulator.i64()
    accumulator.i64() - 4294967296

export fn hexa_decimal_to_decimal(input: i64&, length: usize) -> i64 = hexa_decimal_to_decimal_impl
