const MAX_OPERATIONS: usize = 512
const MAX_ENTRIES: usize = 128
const MAX_KEY: i64 = 99999
const BUCKET_COUNT: usize = 16
const MAX_INPUT_LENGTH: usize = 1537
const FNV_OFFSET: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211
const RESULT_MASK: u64 = 9223372036854775807

def hash_map_sc_hash_byte(hash: u64, byte: u64) -> u64:
    ((hash ^ (byte & 255)) * FNV_PRIME)

def hash_map_sc_hash_i32(hash_value: u64, value: i64) -> u64:
    hash: mutable u64 = hash_value
    bits: u64 = if value < 0: (value + 4294967296).u64() else: value.u64()
    byte: mutable usize = 0
    while byte < 4:
        hash <- hash_map_sc_hash_byte(hash, (bits >> (byte * 8)) & 255)
        byte <- byte + 1
    hash

def hash_map_separate_chaining_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH: return -1
    operation_count_value: i64 = input[0]
    if operation_count_value < 0 or operation_count_value > MAX_OPERATIONS.i64() or
        length != 1 + 3 * operation_count_value.usize(): return -1

    keys: mutable i64[128] = zeroed
    mapped_values: mutable i64[128] = zeroed
    next: mutable i64[128] = zeroed
    buckets: mutable i64[16] = zeroed
    free_slots: mutable i64[128] = zeroed
    index: mutable usize = 0
    while index < MAX_ENTRIES:
        next[index] <- -1
        free_slots[index] <- index.i64()
        index <- index + 1
    index <- 0
    while index < BUCKET_COUNT:
        buckets[index] <- -1
        index <- index + 1
    free_count: mutable usize = MAX_ENTRIES
    size: mutable usize = 0
    hash: mutable u64 = FNV_OFFSET

    operation: mutable usize = 0
    while operation < operation_count_value.usize():
        position: usize = 1 + 3 * operation
        opcode: i64 = input[position]
        key: i64 = input[position + 1]
        value: i64 = input[position + 2]
        result_code: mutable u64 = 0
        returned_value: mutable i64 = 0

        if opcode == 0:
            if key < 0 or key > MAX_KEY or value < -2147483648 or value > 2147483647: return -1
            bucket: usize = (key % BUCKET_COUNT.i64()).usize()
            entry: mutable i64 = buckets[bucket]
            while entry >= 0 and keys[entry.usize()] != key:
                entry <- next[entry.usize()]
            if entry >= 0:
                mapped_values[entry.usize()] <- value
            else:
                if size >= MAX_ENTRIES: return -1
                free_count <- free_count - 1
                entry <- free_slots[free_count]
                keys[entry.usize()] <- key
                mapped_values[entry.usize()] <- value
                next[entry.usize()] <- buckets[bucket]
                buckets[bucket] <- entry
                size <- size + 1
        elif opcode == 1:
            if key < 0 or key > MAX_KEY or value != 0: return -1
            bucket: usize = (key % BUCKET_COUNT.i64()).usize()
            entry: mutable i64 = buckets[bucket]
            while entry >= 0 and keys[entry.usize()] != key:
                entry <- next[entry.usize()]
            if entry >= 0:
                result_code <- 1
                returned_value <- mapped_values[entry.usize()]
        elif opcode == 2:
            if key < 0 or key > MAX_KEY or value != 0: return -1
            bucket: usize = (key % BUCKET_COUNT.i64()).usize()
            previous: mutable i64 = -1
            entry: mutable i64 = buckets[bucket]
            while entry >= 0:
                following: i64 = next[entry.usize()]
                if keys[entry.usize()] == key:
                    if previous < 0: buckets[bucket] <- following
                    else: next[previous.usize()] <- following
                    free_slots[free_count] <- entry
                    free_count <- free_count + 1
                    size <- size - 1
                    break
                previous <- entry
                entry <- following
        elif opcode == 3:
            if key < 0 or key > MAX_KEY or value != 0: return -1
            bucket: usize = (key % BUCKET_COUNT.i64()).usize()
            entry: mutable i64 = buckets[bucket]
            while entry >= 0 and keys[entry.usize()] != key:
                entry <- next[entry.usize()]
            result_code <- if entry >= 0: 1 else: 0
        elif opcode == 4:
            if key != 0 or value != 0: return -1
            index <- 0
            while index < BUCKET_COUNT:
                buckets[index] <- -1
                index <- index + 1
            index <- 0
            while index < MAX_ENTRIES:
                next[index] <- -1
                free_slots[index] <- index.i64()
                index <- index + 1
            free_count <- MAX_ENTRIES
            size <- 0
        else:
            return -1

        hash <- hash_map_sc_hash_byte(hash, opcode.u64())
        hash <- hash_map_sc_hash_byte(hash, result_code)
        if opcode == 1 and result_code == 1:
            hash <- hash_map_sc_hash_i32(hash, returned_value)
        operation <- operation + 1
    (hash & RESULT_MASK).i64()

export fn hash_map_separate_chaining(input: i64&, length: usize) -> i64 = hash_map_separate_chaining_impl
