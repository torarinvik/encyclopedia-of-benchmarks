# Three-sample Hampel filter using the Java default threshold 3.0.
def insert_sorted(a: mutable view[f64], size: mutable usize&, value: f64) -> void:
    p: mutable usize = 0
    while p < size and a[p] < value:
        p <- p + 1
    j: mutable usize = size
    while j > p:
        a[j] <- a[j - 1]
        j <- j - 1
    a[p] <- value
    size <- size + 1

def remove_sorted(a: mutable view[f64], size: mutable usize&, value: f64) -> void:
    p: mutable usize = 0
    while p < size and a[p] != value:
        p <- p + 1
    if p == size: return
    j: mutable usize = p + 1
    while j < size:
        a[j - 1] <- a[j]
        j <- j + 1
    size <- size - 1

def median(a: f64[3], size: usize) -> f64:
    middle: usize = size / 2
    if size % 2 == 1: return a[middle]
    0.5 * (a[middle - 1] + a[middle])

def mad(a: f64[3], size: usize, med: f64) -> f64:
    split: mutable usize = 0
    while split < size and a[split] <= med:
        split <- split + 1
    left: mutable i64 = split.i64() - 1
    right: mutable usize = split
    deviations: mutable f64[3] = zeroed
    i: mutable usize = 0
    while i < size:
        take_left: mutable bool = false
        if right >= size:
            take_left <- true
        elif left >= 0 and med - a[left.usize()] <= a[right] - med:
            take_left <- true
        if take_left:
            deviations[i] <- med - a[left.usize()]
            left <- left - 1
        else:
            deviations[i] <- a[right] - med
            right <- right + 1
        i <- i + 1
    middle: usize = size / 2
    if size % 2 == 1: return deviations[middle]
    0.5 * (deviations[middle - 1] + deviations[middle])

def put_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    b: mutable usize = 0
    while b < 8:
        output[offset + b] <- (bits & 255).u8()
        bits <- bits >> 8
        b <- b + 1

def hampel_filter_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or input[0] < 0 or input[0] > 128 or length != input[0].usize() + 1: return -1
    n: usize = input[0].usize()
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < -1000 or input[i + 1] > 1000: return -1
        i <- i + 1
    if capacity < n * 8 or (n > 0 and output == null): return -2
    arrival: mutable f64[3] = zeroed
    sorted: mutable f64[3] = zeroed
    size: mutable usize = 0
    oldest: mutable usize = 0
    i <- 0
    while i < n:
        value: f64 = input[i + 1].f64()
        if size == 3: remove_sorted(sorted[0:3], &size, arrival[oldest])
        insert_sorted(sorted[0:3], &size, value)
        arrival[oldest] <- value
        oldest <- (oldest + 1) % 3
        med: f64 = median(sorted, size)
        mdev: f64 = mad(sorted, size, med)
        distance: mutable f64 = value - med
        if distance < 0.0: distance <- med - value
        filtered: mutable f64 = value
        if distance > 3.0 * 1.4826 * mdev: filtered <- med
        put_i64_le(filtered.i64(), output[0:n * 8], i * 8)
        i <- i + 1
    (n * 8).i64()

export fn hampel_filter(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = hampel_filter_impl
