# Count differing bits with a fixed-width population count that LLVM recognizes.
def hamming_distance_impl(left: u64, right: u64) -> i64:
    differing: u64 = left ^ right
    pairs: u64 = differing - ((differing >> 1) & 0x5555555555555555.u64())
    nibbles: u64 = (pairs & 0x3333333333333333.u64()) + ((pairs >> 2) & 0x3333333333333333.u64())
    bytes: u64 = (nibbles + (nibbles >> 4)) & 0x0f0f0f0f0f0f0f0f.u64()
    ((bytes * 0x0101010101010101.u64()) >> 56).i64()

export fn hamming_distance(left: u64, right: u64) -> i64 = hamming_distance_impl
