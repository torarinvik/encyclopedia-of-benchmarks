# Count differing bits with a population count, like __builtin_popcountll.
@intrinsic("llvm.ctpop.i64")
extern popcount(value: u64) -> u64

def hamming_distance_impl(left: u64, right: u64) -> i64:
    popcount(left ^ right).i64()

export fn hamming_distance(left: u64, right: u64) -> i64 = hamming_distance_impl
