# Return the minimum element index in a distinct rotated ascending array.
const MAX_ARRAY_LENGTH: usize = 256
const MAX_INPUT_LENGTH: usize = MAX_ARRAY_LENGTH + 1

def how_many_times_rotated_impl(input: i64&, length: usize) -> i64:
    if length > MAX_INPUT_LENGTH:
        return -1
    if length > MAX_ARRAY_LENGTH:
        return -1
    if length == 0:
        return 0
    if input.is_null():
        return -1
    index: mutable usize = 0
    while index < length:
        if input[index] < -2147483648 or input[index] > 2147483647:
            return -1
        index <- index + 1

    low: mutable usize = 0
    high: mutable usize = 0
    if length > 0:
        high <- length - 1
    while low < high:
        middle: usize = low + (high - low) / 2
        if input[middle] > input[high]:
            low <- middle + 1
        else:
            high <- middle
    low.i64()

export fn how_many_times_rotated(input: i64&, length: usize) -> i64 = how_many_times_rotated_impl
