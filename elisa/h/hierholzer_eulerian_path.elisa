const MAX_VERTICES: usize = 16
const MAX_EDGES: usize = 48
const MAX_INPUT_LENGTH: usize = 98
const MAX_ROUTE: usize = 49

def write_i64_le(output: mutable view[u8], offset: usize, value: i64):
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def hierholzer_eulerian_path_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null || length < 2 || length > MAX_INPUT_LENGTH: return -1
    vertex_count_value: i64 = input[0]
    edge_count_value: i64 = input[1]
    if vertex_count_value < 0 || vertex_count_value > 16 || edge_count_value < 0 || edge_count_value > 48: return -1
    vertex_count: usize = vertex_count_value.usize()
    edge_count: usize = edge_count_value.usize()
    if length != 2 + 2 * edge_count: return -1

    adjacency: mutable i64[768] = zeroed
    in_degree: mutable usize[16] = zeroed
    out_degree: mutable usize[16] = zeroed
    edge: mutable usize = 0
    while edge < edge_count:
        source_value: i64 = input[2 + 2 * edge]
        destination_value: i64 = input[3 + 2 * edge]
        if source_value < 0 || source_value >= vertex_count_value || destination_value < 0 || destination_value >= vertex_count_value: return -1
        source: usize = source_value.usize()
        destination: usize = destination_value.usize()
        adjacency[source * MAX_EDGES + out_degree[source]] <- destination.i64()
        out_degree[source] <- out_degree[source] + 1
        in_degree[destination] <- in_degree[destination] + 1
        edge <- edge + 1

    path: mutable usize[49] = zeroed
    path_length: mutable usize = 0
    if vertex_count == 0:
        path_length <- 0
    else if edge_count == 0:
        path[0] <- 0
        path_length <- 1
    else:
        start: mutable i64 = -1
        start_count: mutable usize = 0
        end_count: mutable usize = 0
        degrees_valid: mutable bool = true
        vertex: mutable usize = 0
        while vertex < vertex_count:
            difference: i64 = out_degree[vertex].i64() - in_degree[vertex].i64()
            if difference == 1:
                start <- vertex.i64()
                start_count <- start_count + 1
            else if difference == -1:
                end_count <- end_count + 1
            else if difference < -1 || difference > 1:
                degrees_valid <- false
            vertex <- vertex + 1
        if !((start_count == 1 && end_count == 1) || (start_count == 0 && end_count == 0)):
            degrees_valid <- false
        if degrees_valid && start < 0:
            vertex <- 0
            while vertex < vertex_count:
                if out_degree[vertex] > 0:
                    start <- vertex.i64()
                    break
                vertex <- vertex + 1

        connected: mutable bool = degrees_valid
        if connected:
            visited: mutable bool[16] = zeroed
            pending: mutable usize[16] = zeroed
            pending_head: mutable usize = 0
            pending_tail: mutable usize = 1
            pending[0] <- start.usize()
            visited[start.usize()] <- true
            while pending_head < pending_tail:
                current: usize = pending[pending_head]
                pending_head <- pending_head + 1
                edge <- 0
                while edge < out_degree[current]:
                    next: usize = adjacency[current * MAX_EDGES + edge].usize()
                    if !visited[next]:
                        visited[next] <- true
                        pending[pending_tail] <- next
                        pending_tail <- pending_tail + 1
                    edge <- edge + 1
                source: mutable usize = 0
                while source < vertex_count:
                    if !visited[source]:
                        edge <- 0
                        while edge < out_degree[source]:
                            if adjacency[source * MAX_EDGES + edge] == current.i64():
                                visited[source] <- true
                                pending[pending_tail] <- source
                                pending_tail <- pending_tail + 1
                                break
                            edge <- edge + 1
                    source <- source + 1
            vertex <- 0
            while vertex < vertex_count:
                if in_degree[vertex] + out_degree[vertex] > 0 && !visited[vertex]: connected <- false
                vertex <- vertex + 1

        if connected:
            next_position: mutable usize[16] = zeroed
            stack: mutable usize[49] = zeroed
            reverse_path: mutable usize[49] = zeroed
            stack_size: mutable usize = 1
            reverse_length: mutable usize = 0
            stack[0] <- start.usize()
            while stack_size > 0:
                current: usize = stack[stack_size - 1]
                if next_position[current] < out_degree[current]:
                    next: usize = adjacency[current * MAX_EDGES + next_position[current]].usize()
                    next_position[current] <- next_position[current] + 1
                    stack[stack_size] <- next
                    stack_size <- stack_size + 1
                else:
                    stack_size <- stack_size - 1
                    reverse_path[reverse_length] <- stack[stack_size]
                    reverse_length <- reverse_length + 1
            if reverse_length == edge_count + 1:
                path_length <- reverse_length
                i: mutable usize = 0
                while i < path_length:
                    path[i] <- reverse_path[path_length - 1 - i]
                    i <- i + 1

    output_bytes: usize = 8 * (path_length + 1)
    if output == null || capacity < output_bytes: return -2
    write_i64_le(output[0:output_bytes], 0, path_length.i64())
    i: mutable usize = 0
    while i < path_length:
        write_i64_le(output[0:output_bytes], 8 * (i + 1), path[i].i64())
        i <- i + 1
    output_bytes.i64()

export fn hierholzer_eulerian_path(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = hierholzer_eulerian_path_impl
