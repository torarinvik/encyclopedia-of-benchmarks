def hexa_decimal_to_binary_hex_digit(code: i64) -> i64:
    if code >= 48 and code <= 57: return code - 48
    if code >= 65 and code <= 70: return code - 55
    if code >= 97 and code <= 102: return code - 87
    return -1

def hexa_decimal_to_binary_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length == 0 or length > 65:
        return -1
    first_digit: mutable usize = 0
    negative: mutable bool = false
    if input[0] == 45:
        negative <- true
        first_digit <- 1
    else if input[0] == 43:
        first_digit <- 1
    if first_digit == length: return -1
    limit: i64 = if negative: 2147483648 else: 2147483647
    value: mutable i64 = 0
    index: usize = first_digit
    while index < length:
        digit: i64 = hexa_decimal_to_binary_hex_digit(input[index])
        if digit < 0 or value > (limit - digit) / 16:
            return -1
        value <- value * 16 + digit
        index <- index + 1
    bits: i64 = value
    if negative and value != 0: bits <- 4294967296 - value
    width: mutable usize = 0
    remaining: mutable i64 = bits
    while remaining > 0:
        width <- width + 1
        remaining <- remaining / 2
    if negative and value != 0: width <- 32
    else if width < 8: width <- 8
    buffer: mutable u8[32] = zeroed
    remaining <- bits
    index <- width
    while index > 0:
        index <- index - 1
        buffer[index] <- (48 + remaining % 2).u8()
        remaining <- remaining / 2
    if width > output_capacity or output == null:
        return -2
    index <- 0
    while index < width:
        output[index] <- buffer[index]
        index <- index + 1
    width.i64()

export fn hexa_decimal_to_binary(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = hexa_decimal_to_binary_impl
