@intrinsic("llvm.ctpop.i64")
extern population_count(value: u64) -> u64

# Count set bits in an unsigned 32-bit integer.
def hamming_weight_impl(value: i64) -> i64:
    if value.u64() > 4294967295:
        return -1
    # The validated upper bits are zero, so count in the original register width.
    population_count(value.u64()).i64()

export fn hamming_weight(value: i64) -> i64 = hamming_weight_impl
