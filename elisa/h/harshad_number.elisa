# Return 1 when n is divisible by its base-10 digit sum, else 0.
def harshad_number_impl(n: i64) -> i64:
    if n <= 0 or n > 2147483647:
        return -1
    remaining: mutable i64 = n
    digit_sum: mutable i64 = 0
    while remaining > 0:
        digit_sum <- digit_sum + remaining % 10
        remaining <- remaining / 10
    if n % digit_sum == 0:
        return 1
    0

export fn harshad_number(n: i64) -> i64 = harshad_number_impl
