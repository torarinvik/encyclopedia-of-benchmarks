# Emit the pinned source's harmonic-series list as newline-delimited ASCII.
def harmonic_series_append_decimal(output: mutable view[u8], position_input: usize, value_input: usize) -> usize:
    value: mutable usize = value_input
    digits: mutable u8[4] = zeroed
    count: mutable usize = 0
    while true:
        digits[count] <- (value % 10).u8()
        count <- count + 1
        value <- value / 10
        if value == 0: break
    position: mutable usize = position_input
    while count > 0:
        count <- count - 1
        output[position] <- 48u8 + digits[count]
        position <- position + 1
    position

def harmonic_series_impl(n: i64, output: mutable u8&, capacity: usize) -> i64:
    if n < -512 or n > 512: return -1
    if n <= 0: return 0
    needed: mutable usize = 2
    term: mutable usize = 2
    while term <= n.usize():
        value: mutable usize = term
        digits: mutable usize = 0
        while true:
            digits <- digits + 1
            value <- value / 10
            if value == 0: break
        needed <- needed + digits + 3
        term <- term + 1
    if capacity < needed: return -2
    position: mutable usize = 0
    output[position] <- 49u8
    position <- position + 1
    output[position] <- 10u8
    position <- position + 1
    term <- 2
    while term <= n.usize():
        output[position] <- 49u8
        position <- position + 1
        output[position] <- 47u8
        position <- position + 1
        position <- harmonic_series_append_decimal(output[0:needed], position, term)
        output[position] <- 10u8
        position <- position + 1
        term <- term + 1
    position.i64()

export fn harmonic_series(n: i64, output: mutable u8&, capacity: usize) -> i64 = harmonic_series_impl
