# Find the greatest h for which at least h citations are >= h.
def h_index_impl(citations: i64&, length: usize) -> i64:
    if length > 5000:
        return -1
    index: mutable usize = 0
    while index < length:
        if citations[index] < 0 or citations[index] > 1000:
            return -1
        index <- index + 1

    low: mutable usize = 0
    high: mutable usize = length
    if high > 1000:
        high <- 1000
    while low < high:
        middle: usize = low + (high - low + 1) / 2
        qualifying: mutable usize = 0
        index <- 0
        while index < length:
            if citations[index].usize() >= middle:
                qualifying <- qualifying + 1
                if qualifying >= middle:
                    break
            index <- index + 1
        if qualifying >= middle:
            low <- middle
        else:
            high <- middle - 1
    low.i64()

export fn h_index(citations: i64&, length: usize) -> i64 = h_index_impl
