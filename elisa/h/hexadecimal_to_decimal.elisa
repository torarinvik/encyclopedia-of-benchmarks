# Convert most-significant-first hexadecimal digits to a signed 64-bit value.
def hexadecimal_to_decimal_impl(digits: i64&, length: usize) -> i64:
    if length == 0 or length > 16:
        return -1
    if length == 16 and digits[0] > 7:
        return -1
    while index < length |index: mutable usize = 0, value: mutable i64 = 0| -> value:
        digit: i64 = digits[index]
        if digit < 0 or digit > 15:
            break -1
        value <- value * 16 + digit
        index <- index + 1

export fn hexadecimal_to_decimal(digits: i64&, length: usize) -> i64 = hexadecimal_to_decimal_impl
