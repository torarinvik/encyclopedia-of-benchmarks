# In-place max-heap sort with a zero-based heap.
def sift_down(values: mutable view[i64], root: usize, end: usize) -> void:
    current: mutable usize = root
    while current < end / 2:
        child: mutable usize = current * 2 + 1
        if child + 1 < end and values[child] < values[child + 1]:
            child <- child + 1
        if values[current] >= values[child]:
            break
        temporary: i64 = values[current]
        values[current] <- values[child]
        values[child] <- temporary
        current <- child

def heap_sort_impl(values: mutable i64&, length: usize) -> void:
    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        sift_down(values[0:length], start, length)
    end: mutable usize = length
    while end > 1:
        end <- end - 1
        temporary: i64 = values[0]
        values[0] <- values[end]
        values[end] <- temporary
        sift_down(values[0:length], 0, end)

export fn heap_sort(values: mutable i64&, length: usize) -> void = heap_sort_impl
