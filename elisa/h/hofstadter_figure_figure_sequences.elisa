from std.collections import InlineArray

comptime MAX_TERMS = 64
comptime MAX_WORDS = 129

fn hffs_write_i64_le(output: mutable view[UInt8], offset: Int, value: Int64) -> Void:
    let bits = bitcast[UInt64](value)
    for byte in range(8): output[offset + byte] <- UInt8((bits >> (byte * 8)) & UInt64(255))

@export("hofstadter_figure_figure_sequences")
fn hofstadter_figure_figure_sequences(
    input: i64&, length: usize,
    output: mutable u8&, capacity: usize,
) abi("C") -> Int64:
    if input.is_null() or length == 0 or length > 2: return -1
    let input_view: view[Int64] = input[0:Int(length)]
    let n_value = input_view[0]
    if n_value < 1 or n_value > MAX_TERMS.i64() or length != 1: return -1
    let n = Int(n_value)
    var figure = InlineArray[Int64, MAX_TERMS](fill=0)
    var space = InlineArray[Int64, MAX_TERMS](fill=0)
    figure[0] <- 1
    space[0] <- 2
    var candidate = Int64(3)
    for i in range(1, n):
        figure[i] <- figure[i - 1] + space[i - 1]
        var used = True
        while used:
            used <- False
            for j in range(i + 1):
                if figure[j] == candidate: used <- True
            if used: candidate <- candidate + 1
        space[i] <- candidate
        candidate <- candidate + 1
    let word_count = 1 + 2 * n
    let output_bytes = word_count * 8
    if output.is_null() or capacity < output_bytes: return -2
    var words = InlineArray[Int64, MAX_WORDS](fill=0)
    words[0] <- n_value
    for i in range(n):
        words[1 + i] <- figure[i]
        words[1 + n + i] <- space[i]
    var output_view: mutable view[UInt8] = output[0:output_bytes]
    for i in range(word_count): hffs_write_i64_le(output_view&, i * 8, words[i])
    return Int64(output_bytes)
