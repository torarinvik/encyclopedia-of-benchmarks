# Standard happy-number test using the decimal digit-square cycle.
def digit_square_sum(n: u64) -> u64:
    total: mutable u64 = 0
    value: mutable u64 = n
    while value > 0:
        digit: u64 = value % 10
        total <- total + digit * digit
        value <- value / 10
    total

def happy_number_impl(n: i64) -> i64:
    if n <= 0:
        return -1
    # Decimal digit-square iteration reaches either 1 or the cycle containing 4.
    value: mutable u64 = n.u64()
    while value != 1 and value != 4:
        value <- digit_square_sum(value)
    return 1 if value == 1 else 0

export fn happy_number(n: i64) -> i64 = happy_number_impl
