# Clean-room adaptation of Ispell lookup.c; license in package docs.
def cbench_ispell_lookup_hash(a: i64&, start: i64, size: i64, modulus: i64) -> i64:
    h: mutable u32 = 0
    first: i64 = if size < 4: size else: 4
    i: mutable i64 = 0
    while i < first:
        h <- (h << 8) | (a[start + i] - 32).u32()
        i <- i + 1
    while i < size:
        h <- ((h << 5) | (h >> 27)) ^ (a[start + i] - 32).u32()
        i <- i + 1
    return (h % modulus.u32()).i64()

def cbench_ispell_lookup_chain_impl(a: i64&, length: i64) -> i64:
    if a.is_null() or length < 3 or length > 108: return -1
    if a[0] < 1 or a[0] > 8 or a[1] < 1 or a[1] > 8 or a[2] < 0 or a[2] > 8: return -1
    m: i64 = a[0]
    q: i64 = a[1]
    n: i64 = a[2]
    if length < 3 + q + m + 2 * n: return -1
    h0: i64 = 3 + q
    nx0: i64 = h0 + m
    l0: i64 = nx0 + n
    p: mutable i64 = l0 + n
    for j in 0..<q:
        if a[3 + j] < 97 or a[3 + j] > 122: return -1
    heads: mutable i64[8] = zeroed
    links: mutable i64[8] = zeroed
    lens: mutable i64[8] = zeroed
    offs: mutable i64[8] = zeroed
    for b in 0..<m:
        heads[b] <- a[h0 + b]
        if heads[b] < -1 or heads[b] >= n: return -1
    for entry in 0..<n:
        links[entry] <- a[nx0 + entry]
        if links[entry] < -1 or links[entry] >= n or a[l0 + entry] < 1 or a[l0 + entry] > 8: return -1
        lens[entry] <- a[l0 + entry]
        if p + lens[entry] > length: return -1
        offs[entry] <- p
        for j in 0..<lens[entry]:
            if a[p + j] < 97 or a[p + j] > 122: return -1
        p <- p + lens[entry]
    if p != length: return -1
    seen: mutable bool[8] = zeroed
    count: mutable i64 = 0
    for b in 0..<m:
        node: mutable i64 = heads[b]
        while node != -1:
            entry: i64 = node
            if seen[entry]: return -1
            seen[entry] <- true
            count <- count + 1
            if cbench_ispell_lookup_hash(a, offs[entry], lens[entry], m) != b: return -1
            node <- links[entry]
    if count != n: return -1
    bucket: i64 = cbench_ispell_lookup_hash(a, 3, q, m)
    node <- heads[bucket]
    while node != -1:
        entry: i64 = node
        if lens[entry] == q:
            j: mutable i64 = 0
            while j < q and a[offs[entry] + j] == a[3 + j]: j <- j + 1
            if j == q: return entry + 1
        node <- links[entry]
    return 0

export fn cbench_ispell_lookup_chain(a: i64&, length: i64) -> i64 = cbench_ispell_lookup_chain_impl
