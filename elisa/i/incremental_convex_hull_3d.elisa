def side_of_face(points: view[i64], a: usize, b: usize, c: usize, point: usize) -> i64:
    abx: i64 = points[3*b] - points[3*a]
    aby: i64 = points[3*b+1] - points[3*a+1]
    abz: i64 = points[3*b+2] - points[3*a+2]
    acx: i64 = points[3*c] - points[3*a]
    acy: i64 = points[3*c+1] - points[3*a+1]
    acz: i64 = points[3*c+2] - points[3*a+2]
    apx: i64 = points[3*point] - points[3*a]
    apy: i64 = points[3*point+1] - points[3*a+1]
    apz: i64 = points[3*point+2] - points[3*a+2]
    (aby*acz-abz*acy)*apx + (abz*acx-abx*acz)*apy + (abx*acy-aby*acx)*apz

def center_side(points: view[i64], a: usize, b: usize, c: usize, center_sum: view[i64]) -> i64:
    abx: i64 = points[3*b] - points[3*a]
    aby: i64 = points[3*b+1] - points[3*a+1]
    abz: i64 = points[3*b+2] - points[3*a+2]
    acx: i64 = points[3*c] - points[3*a]
    acy: i64 = points[3*c+1] - points[3*a+1]
    acz: i64 = points[3*c+2] - points[3*a+2]
    dx: i64 = center_sum[0] - 4*points[3*a]
    dy: i64 = center_sum[1] - 4*points[3*a+1]
    dz: i64 = center_sum[2] - 4*points[3*a+2]
    (aby*acz-abz*acy)*dx + (abz*acx-abx*acz)*dy + (abx*acy-aby*acx)*dz

def origin_determinant(points: view[i64], a: usize, b: usize, c: usize) -> i64:
    ax: i64=points[3*a]; ay: i64=points[3*a+1]; az: i64=points[3*a+2]
    bx: i64=points[3*b]; by: i64=points[3*b+1]; bz: i64=points[3*b+2]
    cx: i64=points[3*c]; cy: i64=points[3*c+1]; cz: i64=points[3*c+2]
    ax*(by*cz-bz*cy) + ay*(bz*cx-bx*cz) + az*(bx*cy-by*cx)

def incremental_convex_hull_3d_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 1 or length > 20:
        return -1
    n_value: i64 = input[0]
    if n_value < 4 or n_value > 6:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 3*n:
        return -1
    points: mutable i64[18] = zeroed
    for i in 0..<3*n:
        if input[i+1] < -10 or input[i+1] > 10:
            return -1
        points[i] <- input[i+1]
    for i in 0..<n:
        for j in i+1..<n:
            if points[3*i] == points[3*j] and points[3*i+1] == points[3*j+1] and points[3*i+2] == points[3*j+2]:
                return -1
    for i in 0..<n:
        for j in i+1..<n:
            for k in j+1..<n:
                for ell in k+1..<n:
                    if side_of_face(points, i, j, k, ell) == 0:
                        return -1

    center_sum: mutable i64[3] = zeroed
    for i in 0..<4:
        for axis in 0..<3:
            center_sum[axis] <- center_sum[axis] + points[3*i+axis]
    face_a: mutable usize[64] = zeroed
    face_b: mutable usize[64] = zeroed
    face_c: mutable usize[64] = zeroed
    face_a[0] <- 0; face_a[1] <- 0; face_a[2] <- 0; face_a[3] <- 1
    face_b[0] <- 1; face_b[1] <- 3; face_b[2] <- 2; face_b[3] <- 3
    face_c[0] <- 2; face_c[1] <- 1; face_c[2] <- 3; face_c[3] <- 2
    face_count: mutable usize = 4
    for f in 0..<face_count:
        if center_side(points, face_a[f], face_b[f], face_c[f], center_sum) > 0:
            temporary: usize = face_b[f]
            face_b[f] <- face_c[f]
            face_c[f] <- temporary

    for point in 4..<n:
        visible: mutable bool[64] = zeroed
        visible_count: mutable usize = 0
        for f in 0..<face_count:
            visible[f] <- side_of_face(points, face_a[f], face_b[f], face_c[f], point) > 0
            if visible[f]:
                visible_count <- visible_count + 1
        if visible_count == 0:
            continue
        edge_a: mutable usize[192] = zeroed
        edge_b: mutable usize[192] = zeroed
        edge_count: mutable usize = 0
        for f in 0..<face_count:
            if visible[f]:
                edge_a[edge_count] <- face_a[f]; edge_b[edge_count] <- face_b[f]; edge_count <- edge_count + 1
                edge_a[edge_count] <- face_b[f]; edge_b[edge_count] <- face_c[f]; edge_count <- edge_count + 1
                edge_a[edge_count] <- face_c[f]; edge_b[edge_count] <- face_a[f]; edge_count <- edge_count + 1
        next_a: mutable usize[64] = zeroed
        next_b: mutable usize[64] = zeroed
        next_c: mutable usize[64] = zeroed
        next_count: mutable usize = 0
        for f in 0..<face_count:
            if not visible[f]:
                next_a[next_count] <- face_a[f]; next_b[next_count] <- face_b[f]; next_c[next_count] <- face_c[f]
                next_count <- next_count + 1
        for e in 0..<edge_count:
            copies: mutable usize = 0
            for other in 0..<edge_count:
                if (edge_a[e] == edge_a[other] and edge_b[e] == edge_b[other]) or (edge_a[e] == edge_b[other] and edge_b[e] == edge_a[other]):
                    copies <- copies + 1
            if copies == 1:
                if next_count >= 64:
                    return -1
                a: usize = edge_a[e]
                b: mutable usize = edge_b[e]
                c: mutable usize = point
                if center_side(points, a, b, c, center_sum) > 0:
                    temporary: usize = b
                    b <- c
                    c <- temporary
                next_a[next_count] <- a; next_b[next_count] <- b; next_c[next_count] <- c
                next_count <- next_count + 1
        for f in 0..<next_count:
            face_a[f] <- next_a[f]; face_b[f] <- next_b[f]; face_c[f] <- next_c[f]
        face_count <- next_count
    volume_six: mutable i64 = 0
    for f in 0..<face_count:
        volume_six <- volume_six + origin_determinant(points, face_a[f], face_b[f], face_c[f])
    volume_six

export fn incremental_convex_hull_3d(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > 20:
        return -1
    incremental_convex_hull_3d_impl(input[0:length])
