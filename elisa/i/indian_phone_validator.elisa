def is_ascii_whitespace(value: i64) -> bool:
    value == 9 or value == 10 or value == 11 or value == 12 or value == 13 or value == 32

def mobile_tail(phone: i64&, end: usize, position: usize) -> bool:
    if position > end or end - position != 10:
        return false
    if phone[position] < 55 or phone[position] > 57:
        return false
    i: mutable usize = 1
    while i < 10:
        if phone[position + i] < 48 or phone[position + i] > 57:
            return false
        i <- i + 1
    true

def indian_phone_validator_impl(phone: i64&, length: usize) -> i64:
    if length == 0 or length > 18:
        return -1
    i: mutable usize = 0
    while i < length:
        if phone[i] < 0 or phone[i] > 127:
            return -1
        i <- i + 1

    end: mutable usize = length
    if phone[end - 1] == 10:
        end <- end - 1
    prefix: mutable usize = 0
    if end >= 3 and phone[0] == 43 and phone[1] == 57 and phone[2] == 49:
        prefix <- 3
        if prefix < end and (phone[prefix] == 45 or is_ascii_whitespace(phone[prefix])):
            prefix <- prefix + 1

    zero: mutable usize = 0
    while zero <= 1:
        after_zero: mutable usize = prefix
        if zero == 1:
            if after_zero >= end or phone[after_zero] != 48:
                zero <- zero + 1
                continue
            after_zero <- after_zero + 1
        country: mutable usize = 0
        while country <= 1:
            position: mutable usize = after_zero
            if country == 1:
                if position + 2 > end or phone[position] != 57 or phone[position + 1] != 49:
                    country <- country + 1
                    continue
                position <- position + 2
            if mobile_tail(phone, end, position):
                return 1
            country <- country + 1
        zero <- zero + 1
    0

export fn indian_phone_validator(phone: i64&, length: usize) -> i64 = indian_phone_validator_impl
