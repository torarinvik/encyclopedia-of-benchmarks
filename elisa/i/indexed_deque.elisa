def indexed_deque_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > 513: return -1
    values: view[i64] = input[0:length]
    if values[0] < 1 or values[0] > 256: return -1
    let q: usize = values[0].usize()
    if length != 1 + 2*q: return -1
    items: mutable i64[256] = zeroed
    answers: mutable i64[256] = zeroed
    head: mutable usize = 0
    size: mutable usize = 0
    count: mutable usize = 0
    for i in 0..<q:
        let op: i64 = values[1+2*i]
        let arg: i64 = values[2+2*i]
        if op == 0 or op == 1:
            if arg < -1000000 or arg > 1000000 or size == 256: return -1
            if op == 0:
                head <- (head+255) % 256
                items[head] <- arg
            else: items[(head+size) % 256] <- arg
            size <- size+1
        else if op == 2 or op == 3:
            if arg != 0 or size == 0: return -1
            if op == 2: head <- (head+1) % 256
            size <- size-1
        else if op == 4:
            if arg < 0 or arg >= size.i64(): return -1
            answers[count] <- items[(head+arg.usize()) % 256]
            count <- count+1
        else: return -1
    if count == 0: return -1
    if output == null or capacity < 8*count: return -2
    bytes: mutable view[u8] = output[0:8*count]
    for i in 0..<count:
        let bits: u64 = answers[i].u64()
        for byte in 0..<8:
            bytes[8*i+byte] <- ((bits >> (8*byte)) & 255.u64()).u8()
    (8*count).i64()

export fn indexed_deque(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = indexed_deque_impl
