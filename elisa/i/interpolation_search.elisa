# Interpolation search in an ascending sequence for the shared benchmark contract.
def interpolation_order_key(value: i64) -> u64:
    sign_bit: u64 = 1.u64() << 63
    if value < 0:
        return sign_bit - 1.u64() - (-(value + 1)).u64()
    sign_bit + value.u64()

def interpolation_search_impl(values: i64&, length: usize, target: i64) -> i64:
    if length == 0:
        return -1
    low: mutable usize = 0
    high: mutable usize = length - 1
    while low <= high:
        low_value: i64 = values[low]
        high_value: i64 = values[high]
        if target < low_value or target > high_value:
            return -1
        if low_value == high_value:
            if low_value == target:
                return low.i64()
            return -1
        index_span: usize = high - low
        value_span: u64 = interpolation_order_key(high_value) - interpolation_order_key(low_value)
        target_offset: u64 = interpolation_order_key(target) - interpolation_order_key(low_value)
        max_u64: u64 = (1.u64() << 63) + ((1.u64() << 63) - 1.u64())
        position: mutable usize = low
        if index_span == 0:
            position <- low
        elif target_offset <= max_u64 / index_span.u64():
            position <- low + ((target_offset * index_span.u64()) / value_span).usize()
        else:
            position <- low + index_span / 2
        value: i64 = values[position]
        if value == target:
            return position.i64()
        if value < target:
            low <- position + 1
        else:
            if position == 0:
                return -1
            high <- position - 1
    -1

export fn interpolation_search(values: i64&, length: usize, target: i64) -> i64 = interpolation_search_impl
