# Retrieve one row-major flattened index from a rectangular matrix.
const MAX_DIMENSION: i64 = 32
const MAX_VALUE: i64 = 1000000

def index_2d_array_in_1d_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4: return -1
    rows: i64 = input[0]
    cols: i64 = input[1]
    index: i64 = input[2]
    if rows < 1 or rows > MAX_DIMENSION or cols < 1 or cols > MAX_DIMENSION: return -1
    cells: usize = (rows * cols).usize()
    if length != cells + 3 or index < 0 or index >= rows * cols: return -1
    i: mutable usize = 0
    while i < cells:
        if input[3+i] < 0 or input[3+i] > MAX_VALUE: return -1
        i <- i + 1
    row: usize = (index / cols).usize()
    col: usize = (index % cols).usize()
    input[3 + row * cols.usize() + col]

export fn index_2d_array_in_1d(input: i64&, length: usize) -> i64 = index_2d_array_in_1d_impl
