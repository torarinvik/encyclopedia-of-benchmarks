# Solve one ideal-gas-law variable using a portable operation selector.
def ideal_gas_law_impl(values: i64&, length: usize) -> f64:
    if length != 4:
        return -1.0e300
    operation: i64 = values[0]
    a: i64 = values[1]
    b: i64 = values[2]
    c: i64 = values[3]
    if operation < 0 or operation > 3 or a < 0 or a > 1000 or b < 0 or b > 1000 or c < 0 or c > 1000:
        return -1.0e300
    if operation == 0 or operation == 1:
        if c == 0:
            return -1.0e300
        (a.f64() * b.f64() * 8.314462) / c.f64()
    else:
        if a == 0:
            return -1.0e300
        (c.f64() * b.f64()) / (a.f64() * 8.314462)

export fn ideal_gas_law(values: i64&, length: usize) -> f64 = ideal_gas_law_impl
