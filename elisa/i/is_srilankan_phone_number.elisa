def is_srilankan_phone_number_impl(phone: i64&, length: usize) -> i64:
    if length == 0 or length > 15:
        return -1
    i: mutable usize = 0
    while i < length:
        if phone[i] < 0 or phone[i] > 127:
            return -1
        i <- i + 1

    prefix_length: usize = 0
    if phone[0] == 48:
        if length >= 4 and phone[1] == 48 and phone[2] == 57 and phone[3] == 52:
            prefix_length = 4
        else:
            prefix_length = 1
    elif length >= 2 and phone[0] == 57 and phone[1] == 52:
        prefix_length = 2
    elif length >= 3 and phone[0] == 43 and phone[1] == 57 and phone[2] == 52:
        prefix_length = 3
    else:
        return 0

    cursor: mutable usize = prefix_length
    if cursor + 2 > length or phone[cursor] != 55:
        return 0
    cursor <- cursor + 1
    provider: i64 = phone[cursor]
    cursor <- cursor + 1
    if provider != 48 and provider != 49 and provider != 50 and provider != 52 and provider != 53 and provider != 54 and provider != 55 and provider != 56:
        return 0

    end_index: mutable usize = length
    if phone[end_index - 1] == 10:
        end_index <- end_index - 1
    remaining: usize = end_index - cursor
    if remaining == 8 and (phone[cursor] == 45 or phone[cursor] == 32):
        cursor <- cursor + 1
    elif remaining != 7:
        return 0
    i <- 0
    while i < 7:
        digit: i64 = phone[cursor + i]
        if digit < 48 or digit > 57:
            return 0
        i <- i + 1
    1

export fn is_srilankan_phone_number(phone: i64&, length: usize) -> i64 = is_srilankan_phone_number_impl
