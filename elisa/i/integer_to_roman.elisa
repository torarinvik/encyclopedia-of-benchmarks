# Encode an integer in canonical uppercase Roman numerals.
def roman_digit_length(digit: i64) -> usize:
    if digit == 4 or digit == 9:
        return 2
    if digit >= 5:
        return (digit - 4).usize()
    return digit.usize()

def append_roman_digit(digit_value: i64, one: u8, five: u8, ten: u8,
    output: mutable u8&, position_value: usize) -> usize:
    digit: mutable i64 = digit_value
    position: mutable usize = position_value
    if digit == 9:
        output[position] <- one
        output[position + 1] <- ten
        return position + 2
    if digit >= 5:
        output[position] <- five
        position <- position + 1
        digit <- digit - 5
    if digit == 4:
        output[position] <- one
        output[position + 1] <- five
        return position + 2
    while digit > 0:
        output[position] <- one
        position <- position + 1
        digit <- digit - 1
    position

def integer_to_roman_impl(value: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if value < 1 or value > 3999:
        return -1
    width: usize = (value / 1000).usize() + roman_digit_length((value / 100) % 10) + roman_digit_length((value / 10) % 10) + roman_digit_length(value % 10)
    if output_capacity < width:
        return -2
    position: mutable usize = 0
    thousands: mutable i64 = value / 1000
    while thousands > 0:
        output[position] <- 77.u8()
        position <- position + 1
        thousands <- thousands - 1
    position <- append_roman_digit((value / 100) % 10, 67.u8(), 68.u8(), 77.u8(), output, position)
    position <- append_roman_digit((value / 10) % 10, 88.u8(), 76.u8(), 67.u8(), output, position)
    position <- append_roman_digit(value % 10, 73.u8(), 86.u8(), 88.u8(), output, position)
    position.i64()

export fn integer_to_roman(value: i64, output: mutable u8&, output_capacity: usize) -> i64 = integer_to_roman_impl
