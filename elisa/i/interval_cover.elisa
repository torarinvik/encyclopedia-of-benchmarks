def interval_cover_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 3 or length > 36:
        return -2
    target_left: i64 = input[0]
    target_right: i64 = input[1]
    count_value: i64 = input[2]
    if target_left < 0 or target_left > target_right or target_right > 32 or count_value < 0 or count_value > 16:
        return -2
    count: usize = count_value.usize()
    if length != 3 + 2 * count:
        return -2
    for i in 0..<count:
        left: i64 = input[3 + 2 * i]
        right: i64 = input[4 + 2 * i]
        if left < 0 or left >= right or right > 32:
            return -2
    if target_left == target_right:
        return 0

    frontier: mutable i64 = target_left
    selected: mutable i64 = 0
    while frontier < target_right:
        farthest: mutable i64 = frontier
        for i in 0..<count:
            left: i64 = input[3 + 2 * i]
            right: i64 = input[4 + 2 * i]
            if left <= frontier and right > farthest:
                farthest <- right
        if farthest == frontier:
            return -1
        frontier <- farthest
        selected <- selected + 1
    selected

export fn interval_cover(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 3 or length > 36:
        return -2
    interval_cover_impl(input[0:length])
