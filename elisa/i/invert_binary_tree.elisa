const MAX_NODE_COUNT: usize = 1023
const MAX_TREE_HEIGHT: usize = 512

def invert_tree_validate(values: i64&, node_count: usize, index: i64, depth: usize,
        visited: mutable u8&) -> bool:
    if index == -1:
        return true
    if index < 0 or index.u64() >= node_count.u64() or depth > MAX_TREE_HEIGHT:
        return false
    node: usize = index.usize()
    if visited[node] != 0:
        return false
    visited[node] <- 1.u8()
    offset: usize = 1 + 3 * node
    value: i64 = values[offset]
    left: i64 = values[offset + 1]
    right: i64 = values[offset + 2]
    if (value < -2147483648 or value > 2147483647 or left < -1 or right < -1 or
            (left >= 0 and left.u64() >= node_count.u64()) or
            (right >= 0 and right.u64() >= node_count.u64())):
        return false
    (invert_tree_validate(values, node_count, left, depth + 1, visited) and
        invert_tree_validate(values, node_count, right, depth + 1, visited))

def invert_tree_store_i64(value: i64, output: mutable u8&, position: usize) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- (bits % 256.u64()).u8()
        bits <- bits / 256.u64()
        byte <- byte + 1

def invert_tree_emit(values: i64&, index: i64, output: mutable u8&) -> void:
    if index == -1:
        return
    input_offset: usize = 1 + 3 * index.usize()
    output_offset: usize = 24 * index.usize()
    left: i64 = values[input_offset + 1]
    right: i64 = values[input_offset + 2]
    invert_tree_store_i64(values[input_offset], output, output_offset)
    invert_tree_store_i64(right, output, output_offset + 8)
    invert_tree_store_i64(left, output, output_offset + 16)
    invert_tree_emit(values, right, output)
    invert_tree_emit(values, left, output)

def invert_binary_tree_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or (length - 1) % 3 != 0 or length > 1 + 3 * MAX_NODE_COUNT:
        return -1
    node_count: usize = (length - 1) / 3
    root: i64 = values[0]
    if node_count == 0:
        if root == -1:
            return 0
        return -1
    if root < 0 or root.u64() >= node_count.u64():
        return -1
    visited: mutable u8[MAX_NODE_COUNT] = zeroed
    if not invert_tree_validate(values, node_count, root, 1, &visited[0]):
        return -1
    index: mutable usize = 0
    while index < node_count:
        if visited[index] == 0:
            return -1
        index <- index + 1
    required: usize = 24 * node_count
    if output_capacity < required:
        return -2
    invert_tree_emit(values, root, output)
    node_count.i64()

export fn invert_binary_tree(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = invert_binary_tree_impl
