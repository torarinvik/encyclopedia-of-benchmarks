extern floor(value: f64) -> f64

const PERMUTATION: i64[256] = [
    151,160,137,91,90,15,131,13,201,95,96,53,194,233,7,225,
    140,36,103,30,69,142,8,99,37,240,21,10,23,190,6,148,
    247,120,234,75,0,26,197,62,94,252,219,203,117,35,11,32,
    57,177,33,88,237,149,56,87,174,20,125,136,171,168,68,175,
    74,165,71,134,139,48,27,166,77,146,158,231,83,111,229,122,
    60,211,133,230,220,105,92,41,55,46,245,40,244,102,143,54,
    65,25,63,161,1,216,80,73,209,76,132,187,208,89,18,169,
    200,196,135,130,116,188,159,86,164,100,109,198,173,186,3,64,
    52,217,226,250,124,123,5,202,38,147,118,126,255,82,85,212,
    207,206,59,227,47,16,58,17,182,189,28,42,223,183,170,213,
    119,248,152,2,44,154,163,70,221,153,101,155,167,43,172,9,
    129,22,39,253,19,98,108,110,79,113,224,232,178,185,112,104,
    218,246,97,228,251,34,242,193,238,210,144,12,191,179,162,241,
    81,51,145,235,249,14,239,107,49,192,214,31,181,199,106,157,
    184,84,204,176,115,121,50,45,127,4,150,254,138,236,205,93,
    222,114,67,29,24,72,243,141,128,195,78,66,215,61,156,180
]

def pn_lookup(index: i64) -> i64:
    PERMUTATION[index & 255]

def pn_fade(t: f64) -> f64:
    t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

def pn_mix(t: f64, a: f64, b: f64) -> f64:
    a + t * (b - a)

def pn_gradient(hash: i64, x: f64, y: f64, z: f64) -> f64:
    k: i64 = hash & 15
    u: f64 = if k < 8: x else: y
    v: f64 = if k < 4: y else: (if k == 12 or k == 14: x else: z)
    (if (k & 1) == 0: u else: -u) + (if (k & 2) == 0: v else: -v)

def improved_perlin_noise_3d_impl(x_input: f64, y_input: f64, z_input: f64) -> f64:
    if x_input != x_input or y_input != y_input or z_input != z_input: return -1.0
    if x_input < -1000000.0 or x_input > 1000000.0 or y_input < -1000000.0 or y_input > 1000000.0 or z_input < -1000000.0 or z_input > 1000000.0: return -1.0
    fx: f64 = floor(x_input)
    fy: f64 = floor(y_input)
    fz: f64 = floor(z_input)
    ix: i64 = fx.i64() & 255
    iy: i64 = fy.i64() & 255
    iz: i64 = fz.i64() & 255
    x: f64 = x_input - fx
    y: f64 = y_input - fy
    z: f64 = z_input - fz
    u: f64 = pn_fade(x)
    v: f64 = pn_fade(y)
    w: f64 = pn_fade(z)
    a: i64 = pn_lookup(ix) + iy
    aa: i64 = pn_lookup(a) + iz
    ab: i64 = pn_lookup(a + 1) + iz
    b: i64 = pn_lookup(ix + 1) + iy
    ba: i64 = pn_lookup(b) + iz
    bb: i64 = pn_lookup(b + 1) + iz
    pn_mix(w,
        pn_mix(v, pn_mix(u, pn_gradient(pn_lookup(aa), x, y, z), pn_gradient(pn_lookup(ba), x - 1.0, y, z)),
                  pn_mix(u, pn_gradient(pn_lookup(ab), x, y - 1.0, z), pn_gradient(pn_lookup(bb), x - 1.0, y - 1.0, z))),
        pn_mix(v, pn_mix(u, pn_gradient(pn_lookup(aa + 1), x, y, z - 1.0), pn_gradient(pn_lookup(ba + 1), x - 1.0, y, z - 1.0)),
                  pn_mix(u, pn_gradient(pn_lookup(ab + 1), x, y - 1.0, z - 1.0), pn_gradient(pn_lookup(bb + 1), x - 1.0, y - 1.0, z - 1.0))))

export fn improved_perlin_noise_3d(x: f64, y: f64, z: f64) -> f64 = improved_perlin_noise_3d_impl
