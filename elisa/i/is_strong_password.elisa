const MAX_INPUT: usize = 258

def is_strong_password_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT: return -1
    minimum_length: i64 = input[0]
    text_length_value: i64 = input[1]
    if minimum_length < 0 or minimum_length > 256 or text_length_value < 0 or text_length_value > 256: return -1
    text_length: usize = text_length_value.usize()
    if length != text_length + 2: return -1

    has_uppercase: mutable bool = false
    has_lowercase: mutable bool = false
    has_digit: mutable bool = false
    has_punctuation: mutable bool = false
    index: mutable usize = 0
    while index < text_length:
        value: i64 = input[index + 2]
        if value < 0 or value > 127: return -1
        if value >= 65 and value <= 90: has_uppercase <- true
        if value >= 97 and value <= 122: has_lowercase <- true
        if value >= 48 and value <= 57: has_digit <- true
        if (value >= 33 and value <= 47) or (value >= 58 and value <= 64) or
            (value >= 91 and value <= 96) or (value >= 123 and value <= 126): has_punctuation <- true
        index <- index + 1

    if text_length_value < minimum_length: return 0
    if has_uppercase and has_lowercase and has_digit and has_punctuation: return 1
    0

export fn is_strong_password(input: i64&, length: usize) -> i64 = is_strong_password_impl
