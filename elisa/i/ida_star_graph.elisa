const IDA_INVALID: i64 = -9223372036854775807 - 1
const UNREACHED: i32 = 1000

struct Search:
    n: mutable i32
    goal: mutable i32
    threshold: mutable i32
    next_threshold: mutable i32
    h: i32[12]
    adjacency: u32[12]

def visit(search: mutable Search&, vertex: usize, distance: i32, path: u32) -> i32:
    estimate: i32 = distance + search.h[vertex]
    if estimate > search.threshold:
        if estimate < search.next_threshold:
            search.next_threshold <- estimate
        return -1
    if vertex.i32() == search.goal:
        return distance
    for next in 0..<search.n.usize():
        bit: u32 = 1.u32() << next.u32()
        if (search.adjacency[vertex] & bit) != 0 and (path & bit) == 0:
            result: i32 = visit(search, next, distance + 1, path | bit)
            if result >= 0:
                return result
    -1

def ida_star_graph_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 5 or length > 112:
        return IDA_INVALID
    nv: i64 = input[0]
    mv: i64 = input[1]
    sv: i64 = input[2]
    gv: i64 = input[3]
    if nv < 1 or nv > 12 or mv < 0 or mv > 48 or sv < 0 or sv >= nv or gv < 0 or gv >= nv or
            length != (4 + nv + 2 * mv).usize():
        return IDA_INVALID
    search: mutable Search = zeroed
    search.n <- nv.i32()
    search.goal <- gv.i32()
    for i in 0..<nv.usize():
        value: i64 = input[4 + i]
        if value < 0 or value >= nv:
            return IDA_INVALID
        search.h[i] <- value.i32()
    if search.h[gv.usize()] != 0:
        return IDA_INVALID
    for i in 0..<mv.usize():
        u: i64 = input[4 + nv.usize() + 2 * i]
        v: i64 = input[5 + nv.usize() + 2 * i]
        if u < 0 or u >= nv or v < 0 or v >= nv or u == v or
                (search.adjacency[u.usize()] & (1.u32() << v.u32())) != 0 or
                search.h[u.usize()] > search.h[v.usize()] + 1:
            return IDA_INVALID
        search.adjacency[u.usize()] <- search.adjacency[u.usize()] | (1.u32() << v.u32())
    search.threshold <- search.h[sv.usize()]
    while true:
        search.next_threshold <- UNREACHED
        distance: i32 = visit(search, sv.usize(), 0, 1.u32() << sv.u32())
        if distance >= 0:
            return distance.i64()
        if search.next_threshold == UNREACHED:
            return -1
        search.threshold <- search.next_threshold
    -1

export fn ida_star_graph(input: i64&, length: usize) -> i64 = ida_star_graph_impl
