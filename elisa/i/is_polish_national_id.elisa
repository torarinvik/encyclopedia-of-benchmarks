def is_polish_national_id_impl(input: i64&, length: usize) -> i64:
    if length != 11:
        return -1
    number: mutable i64 = 0
    index: mutable usize = 0
    while index < length:
        if input[index] < 48 or input[index] > 57:
            return -1
        number <- number * 10 + input[index] - 48
        index <- index + 1
    if number < 10100000 or number > 99923199999:
        return 0
    month: i64 = (input[2] - 48) * 10 + input[3] - 48
    valid_month: bool = (month >= 1 and month <= 12) or (month >= 21 and month <= 32) or (month >= 41 and month <= 52) or (month >= 61 and month <= 72) or (month >= 81 and month <= 92)
    if not valid_month:
        return 0
    day: i64 = (input[4] - 48) * 10 + input[5] - 48
    if day < 1 or day > 31:
        return 0
    subtotal: mutable i64 = 0
    index <- 0
    while index < 10:
        weight: i64 = if index % 4 == 0: 1 else if index % 4 == 1: 3 else if index % 4 == 2: 7 else: 9
        subtotal <- subtotal + ((input[index] - 48) * weight) % 10
        index <- index + 1
    checksum: i64 = 10 - subtotal % 10
    if checksum == number % 10: 1 else: 0

export fn is_polish_national_id(input: i64&, length: usize) -> i64 = is_polish_national_id_impl
