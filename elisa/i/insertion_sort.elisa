# Stable insertion sort for the shared mutable in-place sorting contract.
def insertion_sort_impl(values: mutable i64&, length: usize) -> void:
    index: mutable usize = 1
    while index < length:
        key: i64 = values[index]
        position: mutable usize = index
        while position > 0 and values[position - 1] > key:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- key
        index <- index + 1

export fn insertion_sort(values: mutable i64&, length: usize) -> void = insertion_sort_impl
