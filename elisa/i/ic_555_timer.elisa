def ic_555_timer_impl(v: i64&, length: usize) -> f64:
    if length != 4: return -1e300
    mode: i64 = v[0]
    r1: i64 = v[1]
    r2: i64 = v[2]
    c: i64 = v[3]
    if (mode != 0 and mode != 1) or r1 < 1 or r1 > 1000000 or r2 < 1 or r2 > 1000000 or (mode == 0 and (c < 1 or c > 1000000)) or (mode == 1 and (c < 0 or c > 1000000)): return -1e300
    if mode == 0: return (1.44 / ((r1 + 2 * r2).f64() * c.f64())) * 1e6
    ((r1 + r2).f64() / (r1 + 2 * r2).f64()) * 100.0
export fn ic_555_timer(v: i64&, length: usize) -> f64 = ic_555_timer_impl
