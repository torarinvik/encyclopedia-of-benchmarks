const MAX_LENGTH: usize = 4096

def is_uppercase_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < 32 or value > 126:
            return -1
        if value >= 97 and value <= 122:
            return 0
        index <- index + 1
    1

export fn is_uppercase(values: i64&, length: usize) -> i64 = is_uppercase_impl
