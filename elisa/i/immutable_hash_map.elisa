const MAX_OPS: usize = 256
const MAX_INPUT: usize = 769
const FNV_OFFSET: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211

def immutable_hash_i64(hash: u64, value: i64) -> u64:
    bits: u64 = value.u64()
    result: mutable u64 = hash
    shift: mutable usize = 0
    while shift < 64:
        result <- (result ^ ((bits >> shift) & 255.u64())) * FNV_PRIME
        shift <- shift + 8
    result

def immutable_hash_map_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT:
        return -1
    count64: i64 = input[0]
    if count64 < 0 or count64 > MAX_OPS.i64() or length != (1 + 3 * count64).usize():
        return -1
    count: usize = count64.usize()
    keys: mutable i32[MAX_OPS] = zeroed
    values: mutable i32[MAX_OPS] = zeroed
    trace: mutable i64[MAX_OPS] = zeroed
    map_size: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        operation: i64 = input[1 + 3 * index]
        key64: i64 = input[2 + 3 * index]
        value64: i64 = input[3 + 3 * index]
        if operation < 0 or operation > 3 or key64 < -2147483648 or key64 > 2147483647 or value64 < -2147483648 or value64 > 2147483647:
            return -1
        key: i32 = key64.i32()
        value: i32 = value64.i32()
        if operation == 0:
            if value == 0:
                return -1
            keys[map_size] <- key
            values[map_size] <- value
            map_size <- map_size + 1
            trace[index] <- map_size.i64()
        else if operation == 1 or operation == 2:
            found_value: mutable i32 = 0
            cursor: mutable usize = map_size
            while cursor > 0:
                cursor <- cursor - 1
                if keys[cursor] == key:
                    found_value <- values[cursor]
                    break
            if operation == 1:
                trace[index] <- found_value.i64()
            else:
                trace[index] <- if found_value != 0 then 1 else 0
        else:
            trace[index] <- map_size.i64()
        index <- index + 1

    hash: mutable u64 = immutable_hash_i64(FNV_OFFSET, count64)
    index <- 0
    while index < count:
        hash <- immutable_hash_i64(hash, trace[index])
        index <- index + 1
    (hash & 0x7fff_ffff_ffff_ffff.u64()).i64()

export fn immutable_hash_map(input: i64&, length: usize) -> i64 = immutable_hash_map_impl
