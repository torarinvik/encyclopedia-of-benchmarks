# Stable recursive insertion sort over signed 64-bit values.
def insertion_sort_prefix(values: mutable i64&, length: usize) -> void:
    if length <= 1:
        return
    insertion_sort_prefix(values, length - 1)
    key: i64 = values[length - 1]
    position: mutable usize = length - 1
    while position > 0:
        if values[position - 1] <= key:
            break
        values[position] <- values[position - 1]
        position <- position - 1
    values[position] <- key

def insertion_sort_recursive_impl(values: mutable i64&, length: usize) -> void:
    insertion_sort_prefix(values, length)

export fn insertion_sort_recursive(values: mutable i64&, length: usize) -> void = insertion_sort_recursive_impl
