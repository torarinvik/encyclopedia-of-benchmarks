const MAX_LENGTH: usize = 100000
const MAX_SAFE_INTEGER: i64 = 9007199254740991

def is_sorted_array_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < -MAX_SAFE_INTEGER or value > MAX_SAFE_INTEGER:
            return -1
        index <- index + 1
    index <- 0
    while index + 1 < length:
        if values[index] >= values[index + 1]:
            return 0
        index <- index + 1
    1

export fn is_sorted_array(values: i64&, length: usize) -> i64 = is_sorted_array_impl
