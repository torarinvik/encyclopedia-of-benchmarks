# Preserve the Go source's direct square-and-last-digit loop.
def isautomorphic_impl(n: i64) -> i64:
    max_safe: i64 = 3037000499
    if n < -max_safe or n > max_safe:
        return -1
    if n < 0:
        return 0

    square: mutable i64 = n * n
    remaining: mutable i64 = n
    while remaining > 0:
        if remaining % 10 != square % 10:
            return 0
        remaining <- remaining / 10
        square <- square / 10
    return 1

export fn isautomorphic(n: i64) -> i64 = isautomorphic_impl
