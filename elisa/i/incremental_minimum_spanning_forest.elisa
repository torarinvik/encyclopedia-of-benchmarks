def incremental_minimum_spanning_forest(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("incremental_minimum_spanning_forest"):
    if input.is_null() or length < 2 or length > 98: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 1 or m64 > 32 or length != 2 + 3*m64.usize(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    i: mutable usize = 0
    while i < m:
        u: i64 = input[2+3*i]
        v: i64 = input[3+3*i]
        w: i64 = input[4+3*i]
        if u < 0 or u >= n64 or v < 0 or v >= n64 or w < 1 or w > 1000000: return -1
        j: mutable usize = 0
        while j < i:
            if input[4+3*j] == w: return -1
            j <- j+1
        i <- i+1
    active: mutable u8[32] = zeroed
    answers: mutable i64[32] = zeroed
    edge: mutable usize = 0
    while edge < m:
        start: usize = input[2+3*edge].usize()
        target: usize = input[3+3*edge].usize()
        if start == target:
            answers[edge] <- edge.i64()
            edge <- edge+1
            continue
        parent: mutable i64[16] = zeroed
        parent_edge: mutable usize[16] = zeroed
        queue: mutable usize[16] = zeroed
        i <- 0
        while i < n:
            parent[i] <- -1
            i <- i+1
        parent[start] <- start.i64()
        queue[0] <- start
        head: mutable usize = 0
        tail: mutable usize = 1
        while head < tail:
            vertex: usize = queue[head]
            head <- head+1
            i <- 0
            while i < edge:
                if active[i] != 0:
                    u: usize = input[2+3*i].usize()
                    v: usize = input[3+3*i].usize()
                    neighbor: mutable i64 = -1
                    if u == vertex: neighbor <- v.i64()
                    else if v == vertex: neighbor <- u.i64()
                    if neighbor >= 0 and parent[neighbor.usize()] < 0:
                        parent[neighbor.usize()] <- vertex.i64()
                        parent_edge[neighbor.usize()] <- i
                        queue[tail] <- neighbor.usize()
                        tail <- tail+1
                i <- i+1
        if parent[target] < 0:
            active[edge] <- 1
            answers[edge] <- -1
            edge <- edge+1
            continue
        node: mutable usize = target
        heaviest: mutable usize = parent_edge[node]
        while node != start:
            item: usize = parent_edge[node]
            if input[4+3*item] > input[4+3*heaviest]: heaviest <- item
            node <- parent[node].usize()
        if input[4+3*edge] < input[4+3*heaviest]:
            active[heaviest] <- 0
            active[edge] <- 1
            answers[edge] <- heaviest.i64()
        else: answers[edge] <- edge.i64()
        edge <- edge+1
    bytes: usize = 8*m
    if output.is_null() or capacity < bytes: return -2
    i <- 0
    while i < m:
        bits: u64 = answers[i].u64()
        b: mutable usize = 0
        while b < 8:
            output[8*i+b] <- ((bits >> (8*b)) & 255).u8()
            b <- b+1
        i <- i+1
    bytes.i64()
