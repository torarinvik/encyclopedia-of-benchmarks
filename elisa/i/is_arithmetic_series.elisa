const MAX_LENGTH: usize = 64
const MAX_ABS_VALUE: i64 = 1000000
def is_arithmetic_series_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > MAX_LENGTH: return -1
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < -MAX_ABS_VALUE or value > MAX_ABS_VALUE: return -1
        index <- index + 1
    if length == 1: return 1
    difference: i64 = values[1] - values[0]
    index <- 1
    while index + 1 < length:
        if values[index + 1] - values[index] != difference: return 0
        index <- index + 1
    1
export fn is_arithmetic_series(values: i64&, length: usize) -> i64 = is_arithmetic_series_impl
