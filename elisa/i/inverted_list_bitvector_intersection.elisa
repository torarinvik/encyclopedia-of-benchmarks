const MAX_DOMAIN: usize = 1024
const MAX_LISTS: usize = 16
const MAX_WORDS: usize = 16

def write_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255.u64()).u8()
        byte <- byte + 1

def inverted_list_bitvector_intersection_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > 258:
        return -1
    domain_value: i64 = input[0]
    list_count_value: i64 = input[1]
    if domain_value < 1 or domain_value > MAX_DOMAIN.i64() or list_count_value < 1 or list_count_value > MAX_LISTS.i64():
        return -1

    domain: usize = domain_value.usize()
    list_count: usize = list_count_value.usize()
    words_per_list: usize = (domain + 63) / 64
    if length != 2 + list_count * words_per_list:
        return -1

    remainder: usize = domain % 64
    if remainder != 0:
        valid_mask: u64 = (1.u64() << remainder) - 1.u64()
        list: mutable usize = 0
        while list < list_count:
            final_index: usize = 2 + list * words_per_list + words_per_list - 1
            final_word: u64 = input[final_index].u64()
            if (final_word & ~valid_mask) != 0.u64():
                return -1
            list <- list + 1

    intersection: mutable u64[MAX_WORDS] = zeroed
    word: mutable usize = 0
    while word < words_per_list:
        combined: mutable u64 = ~0.u64()
        list: mutable usize = 0
        while list < list_count:
            input_index: usize = 2 + list * words_per_list + word
            combined <- combined & input[input_index].u64()
            list <- list + 1
        intersection[word] <- combined
        word <- word + 1

    results: mutable i64[MAX_DOMAIN] = zeroed
    result_count: mutable usize = 0
    document_id: mutable usize = 0
    while document_id < domain:
        bit: u64 = 1.u64() << (document_id % 64)
        if (intersection[document_id / 64] & bit) != 0.u64():
            results[result_count] <- document_id.i64()
            result_count <- result_count + 1
        document_id <- document_id + 1

    output_bytes: usize = (result_count + 1) * 8
    if output == null or output_capacity < output_bytes:
        return -2
    output_view: mutable u8& = output
    write_i64_le(output_view, 0, result_count.i64())
    index: mutable usize = 0
    while index < result_count:
        write_i64_le(output_view, (index + 1) * 8, results[index])
        index <- index + 1
    output_bytes.i64()

export fn inverted_list_bitvector_intersection(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) -> i64 = inverted_list_bitvector_intersection_impl
