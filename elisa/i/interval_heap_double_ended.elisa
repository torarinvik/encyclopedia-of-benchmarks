# Clean-room bounded interval-heap trace; endpoint state uses bounded views behind FFI.
from std.collections import InlineArray

const IH_MAX_INITIAL: usize = 64
const IH_MAX_OPERATIONS: usize = 128
const IH_MAX_KEYS: usize = IH_MAX_INITIAL + IH_MAX_OPERATIONS
const IH_MAX_INPUT: usize = IH_MAX_INITIAL + 2 + 2 * IH_MAX_OPERATIONS

def ih_high(keys: view[i32], count: usize, node: usize) -> usize:
    high: usize = 2 * node + 1
    if high < count:
        return high
    2 * node

def ih_sift_up_low(keys: mutable view[i32], start: usize) -> void:
    node: mutable usize = start
    while node > 0:
        parent: usize = (node - 1) / 2
        low: usize = 2 * node
        parent_low: usize = 2 * parent
        if keys[low] >= keys[parent_low]:
            return
        temporary: i32 = keys[low]
        keys[low] <- keys[parent_low]
        keys[parent_low] <- temporary
        node <- parent

def ih_sift_up_high(keys: mutable view[i32], count: usize, start: usize) -> void:
    node: mutable usize = start
    while node > 0:
        parent: usize = (node - 1) / 2
        high: usize = ih_high(keys, count, node)
        parent_high: usize = ih_high(keys, count, parent)
        if keys[high] <= keys[parent_high]:
            return
        temporary: i32 = keys[high]
        keys[high] <- keys[parent_high]
        keys[parent_high] <- temporary
        node <- parent

def ih_insert(keys: mutable view[i32], count: mutable usize&, value: i32) -> void:
    key_index: usize = count
    keys[key_index] <- value
    count <- count + 1
    node: usize = key_index / 2
    if key_index % 2 == 1 and keys[key_index] < keys[key_index - 1]:
        temporary: i32 = keys[key_index]
        keys[key_index] <- keys[key_index - 1]
        keys[key_index - 1] <- temporary
    ih_sift_up_low(keys, node)
    ih_sift_up_high(keys, count, node)

def ih_extract_min(keys: mutable view[i32], count: mutable usize&) -> i32:
    result: i32 = keys[0]
    count <- count - 1
    last: i32 = keys[count]
    if count == 0:
        return result
    keys[0] <- last
    node: mutable usize = 0
    while true:
        left: usize = 2 * node + 1
        if 2 * left >= count:
            return result
        right: usize = left + 1
        child: mutable usize = left
        if 2 * right < count and keys[2 * right] < keys[2 * left]:
            child <- right
        node_low: usize = 2 * node
        child_low: usize = 2 * child
        if keys[child_low] >= keys[node_low]:
            return result
        temporary: i32 = keys[node_low]
        keys[node_low] <- keys[child_low]
        keys[child_low] <- temporary
        child_high: usize = ih_high(keys, count, child)
        if keys[child_high] < keys[child_low]:
            pair_temporary: i32 = keys[child_high]
            keys[child_high] <- keys[child_low]
            keys[child_low] <- pair_temporary
        node <- child
    result

def ih_extract_max(keys: mutable view[i32], count: mutable usize&) -> i32:
    if count <= 2:
        count <- count - 1
        return keys[count]
    result: i32 = keys[1]
    count <- count - 1
    keys[1] <- keys[count]
    node: mutable usize = 0
    while true:
        left: usize = 2 * node + 1
        if 2 * left >= count:
            return result
        right: usize = left + 1
        child: mutable usize = left
        if 2 * right < count and keys[ih_high(keys, count, left)] < keys[ih_high(keys, count, right)]:
            child <- right
        node_high: usize = ih_high(keys, count, node)
        child_high: usize = ih_high(keys, count, child)
        if keys[node_high] >= keys[child_high]:
            return result
        temporary: i32 = keys[node_high]
        keys[node_high] <- keys[child_high]
        keys[child_high] <- temporary
        child_low: usize = 2 * child
        if keys[child_high] < keys[child_low]:
            pair_temporary: i32 = keys[child_high]
            keys[child_high] <- keys[child_low]
            keys[child_low] <- pair_temporary
        node <- child
    result

def ih_sort(values: mutable view[i32], count: usize) -> void:
    index: mutable usize = 1
    while index < count:
        value: i32 = values[index]
        position: mutable usize = index
        while position > 0 and values[position - 1] > value:
            values[position] <- values[position - 1]
            position <- position - 1
        values[position] <- value
        index <- index + 1

def ih_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

@export("interval_heap_double_ended")
def interval_heap_double_ended(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 abi("C"):
    if input.is_null() or length < 2 or length > IH_MAX_INPUT:
        return -1
    let input_view: view[i64] = input[0:Int(length)]
    if input_view[0] < 0 or input_view[0] > 64:
        return -1
    initial_count: usize = input_view[0].usize()
    if length < initial_count + 2 or input_view[initial_count + 1] < 0 or input_view[initial_count + 1] > 128:
        return -1
    operation_count: usize = input_view[initial_count + 1].usize()
    if length != initial_count + 2 + 2 * operation_count:
        return -1
    for index in 0..<initial_count:
        if input_view[index + 1] < -2147483648 or input_view[index + 1] > 2147483647:
            return -1
    for op in 0..<operation_count:
        opcode: i64 = input_view[initial_count + 2 + 2 * op]
        argument: i64 = input_view[initial_count + 3 + 2 * op]
        if opcode < 0 or opcode > 5:
            return -1
        if opcode == 0:
            if argument < -2147483648 or argument > 2147483647:
                return -1
        else if argument != 0:
            return -1

    var keys = InlineArray[Int32, 192](fill=0)
    var key_view: mutable view[i32] = keys[0:192]
    var count: usize = 0
    for index in 0..<initial_count:
        ih_insert(key_view&, count&, input_view[index + 1].i32())
    var events = InlineArray[Int64, 128](fill=0)
    var event_count: usize = 0
    for op in 0..<operation_count:
        let opcode = input_view[initial_count + 2 + 2 * op]
        let argument = input_view[initial_count + 3 + 2 * op]
        if opcode == 0:
            ih_insert(key_view&, count&, argument.i32())
        else if opcode == 1:
            if count == 0: return -1
            events[event_count] <- key_view[0].i64()
            event_count <- event_count + 1
        else if opcode == 2:
            if count == 0: return -1
            events[event_count] <- key_view[ih_high(key_view, count, 0)].i64()
            event_count <- event_count + 1
        else if opcode == 3:
            if count == 0: return -1
            events[event_count] <- ih_extract_min(key_view&, count&).i64()
            event_count <- event_count + 1
        else if opcode == 4:
            if count == 0: return -1
            events[event_count] <- ih_extract_max(key_view&, count&).i64()
            event_count <- event_count + 1
        else:
            events[event_count] <- count.i64()
            event_count <- event_count + 1

    ih_sort(key_view&, count)
    required: usize = (2 + event_count + count) * 8
    if output.is_null() or capacity < required:
        return -2
    var output_view: mutable view[u8] = output[0:Int(required)]
    ih_store(event_count.i64(), output_view&, 0)
    offset: mutable usize = 8
    for index in 0..<event_count:
        ih_store(events[index], output_view&, offset)
        offset <- offset + 8
    ih_store(count.i64(), output_view&, offset)
    offset <- offset + 8
    for index in 0..<count:
        ih_store(key_view[index].i64(), output_view&, offset)
        offset <- offset + 8
    required.i64()
