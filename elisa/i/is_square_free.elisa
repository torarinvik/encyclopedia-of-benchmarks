# Return whether positive n has no repeated prime factor.
def is_square_free_impl(n: i64) -> i64:
    if n < 1 or n > 1000000:
        return -1
    remaining: mutable i64 = n
    factor: mutable i64 = 2
    while factor <= remaining / factor:
        if remaining % factor == 0:
            remaining <- remaining / factor
            if remaining % factor == 0:
                return 0
        factor <- factor + 1
    1

export fn is_square_free(n: i64) -> i64 = is_square_free_impl
