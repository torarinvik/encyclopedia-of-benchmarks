# Shunting-yard conversion with right-associative exponentiation.
const MAX_EXPRESSION: usize = 256
const MAX_OUTPUT: usize = 512

def infix_to_postfix_conversion_is_operand(ch: i64) -> bool:
    (ch >= 48 and ch <= 57) or (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122)

def infix_to_postfix_conversion_is_operator(ch: i64) -> bool:
    ch == 43 or ch == 45 or ch == 42 or ch == 47 or ch == 94

def infix_to_postfix_conversion_precedence(ch: i64) -> i64:
    if ch == 43 or ch == 45:
        return 1
    if ch == 42 or ch == 47:
        return 2
    3

def emit_token(result: mutable u8&, count_input: usize, token: u8) -> usize:
    position: mutable usize = count_input
    if position > 0:
        result[position] <- 32u8
        position <- position + 1
    result[position] <- token
    position + 1

def infix_to_postfix_conversion_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1:
        return -1
    expression_length: i64 = input[0]
    if expression_length < 0 or expression_length > 256 or length != 1 + expression_length.usize():
        return -1
    stack: mutable u8[256] = zeroed
    result: mutable u8[512] = zeroed
    top: mutable usize = 0
    count: mutable usize = 0
    expect_operand: mutable bool = true
    index: mutable usize = 0
    while index < expression_length.usize():
        ch: i64 = input[1 + index]
        if infix_to_postfix_conversion_is_operand(ch):
            if not expect_operand:
                return -1
            count <- emit_token(result, count, ch.u8())
            expect_operand <- false
        elif ch == 40:
            if not expect_operand or top == MAX_EXPRESSION:
                return -1
            stack[top] <- 40u8
            top <- top + 1
        elif ch == 41:
            if expect_operand:
                return -1
            while top > 0 and stack[top - 1] != 40u8:
                top <- top - 1
                count <- emit_token(result, count, stack[top])
            if top == 0:
                return -1
            top <- top - 1
            expect_operand <- false
        elif infix_to_postfix_conversion_is_operator(ch):
            if expect_operand:
                return -1
            while top > 0 and stack[top - 1] != 40u8 and
                  (infix_to_postfix_conversion_precedence(ch) < infix_to_postfix_conversion_precedence(stack[top - 1].i64()) or
                   (infix_to_postfix_conversion_precedence(ch) == infix_to_postfix_conversion_precedence(stack[top - 1].i64()) and ch != 94)):
                top <- top - 1
                count <- emit_token(result, count, stack[top])
            if top == MAX_EXPRESSION:
                return -1
            stack[top] <- ch.u8()
            top <- top + 1
            expect_operand <- true
        else:
            return -1
        index <- index + 1
    if expression_length != 0 and expect_operand:
        return -1
    while top > 0:
        if stack[top - 1] == 40u8:
            return -1
        top <- top - 1
        count <- emit_token(result, count, stack[top])
    result[count] <- 0u8
    count <- count + 1
    if output_capacity < count:
        return -2
    index <- 0
    while index < count:
        output[index] <- result[index]
        index <- index + 1
    count.i64()

export fn infix_to_postfix_conversion(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = infix_to_postfix_conversion_impl
