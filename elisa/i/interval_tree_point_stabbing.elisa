from std.collections import InlineArray

const IT_MAX_N: usize = 16
const IT_MAX_Q: usize = 8
const IT_TREE_CAP: usize = 32
const IT_MAX_INPUT: usize = 43
const IT_MAX_OUTPUT: usize = 72

struct ItInterval:
    low: i64
    high: i64
    id: usize

fn it_write_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    let bits: u64 = value.bitcast[u64]()
    for byte in 0..<8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

fn it_solve(input: view[i64], output_words: mutable view[i64]) -> i64:
    let length: usize = input.len()
    if length < 2 or length > IT_MAX_INPUT: return -1
    let n64 = input[0]
    let q64 = input[1]
    if n64 < 0 or n64 > IT_MAX_N.i64() or q64 < 0 or q64 > IT_MAX_Q.i64(): return -1
    let n: usize = n64.usize()
    let q: usize = q64.usize()
    if length != 2 + 2 * n + q: return -1
    var sorted = InlineArray[ItInterval, IT_MAX_N]()
    var at: usize = 2
    for id in 0..<n:
        let low = input[at]
        let high = input[at + 1]
        at <- at + 2
        if low < -32 or low > 32 or high < -32 or high > 32 or low > high: return -1
        sorted[id] <- ItInterval(low=low, high=high, id=id)
    var points = InlineArray[i64, IT_MAX_Q]()
    for i in 0..<q:
        points[i] <- input[at]
        at <- at + 1
        if points[i] < -32 or points[i] > 32: return -1
    for i in 1..<n:
        let value = sorted[i]
        var j = i
        while j > 0:
            let previous = sorted[j - 1]
            let greater = previous.low > value.low or
                (previous.low == value.low and previous.high > value.high) or
                (previous.low == value.low and previous.high == value.high and previous.id > value.id)
            if not greater: break
            sorted[j] <- previous
            j <- j - 1
        sorted[j] <- value
    var tree = InlineArray[ItInterval, IT_TREE_CAP]()
    var used = InlineArray[Bool, IT_TREE_CAP]()
    var maximum = InlineArray[i64, IT_TREE_CAP]()
    var firsts = InlineArray[i64, IT_MAX_N]()
    var lasts = InlineArray[i64, IT_MAX_N]()
    var nodes = InlineArray[usize, IT_MAX_N]()
    for node in 0..<IT_TREE_CAP:
        maximum[node] <- -9223372036854775807 - 1
        used[node] <- false
    if n > 0:
        var top: usize = 1
        firsts[0] <- 0
        lasts[0] <- (n - 1).i64()
        nodes[0] <- 0
        while top > 0:
            top <- top - 1
            let first: i64 = firsts[top]
            let last: i64 = lasts[top]
            let node: usize = nodes[top]
            if first > last or node >= IT_TREE_CAP: continue
            let middle: usize = (first + (last - first) / 2).usize()
            tree[node] <- sorted[middle]
            used[node] <- true
            if middle.i64() + 1 <= last:
                firsts[top] <- middle.i64() + 1
                lasts[top] <- last
                nodes[top] <- 2 * node + 2
                top <- top + 1
            if first <= middle.i64() - 1:
                firsts[top] <- first
                lasts[top] <- middle.i64() - 1
                nodes[top] <- 2 * node + 1
                top <- top + 1
    var node: i64 = (IT_TREE_CAP - 1).i64()
    while node >= 0:
        let index: usize = node.usize()
        if used[index]:
            maximum[index] <- tree[index].high
            let left: usize = 2 * index + 1
            let right: usize = left + 1
            if left < IT_TREE_CAP and used[left] and maximum[left] > maximum[index]: maximum[index] <- maximum[left]
            if right < IT_TREE_CAP and used[right] and maximum[right] > maximum[index]: maximum[index] <- maximum[right]
        node <- node - 1
    output_words[0] <- q.i64()
    var qi: usize = 0
    while qi < q:
        var stack = InlineArray[usize, IT_TREE_CAP]()
        var top: usize = 0
        if n > 0:
            stack[0] <- 0
            top <- 1
        var mask: i64 = 0
        while top > 0:
            top <- top - 1
            let current: usize = stack[top]
            if not used[current] or maximum[current] < points[qi]: continue
            let left: usize = 2 * current + 1
            let right: usize = left + 1
            if left < IT_TREE_CAP and used[left] and maximum[left] >= points[qi]:
                stack[top] <- left
                top <- top + 1
            if tree[current].low <= points[qi] and points[qi] <= tree[current].high:
                mask <- mask | (1.i64 << tree[current].id)
            if tree[current].low <= points[qi] and right < IT_TREE_CAP and used[right] and maximum[right] >= points[qi]:
                stack[top] <- right
                top <- top + 1
        output_words[qi + 1] <- mask
        qi <- qi + 1
    (q + 1).i64()

export fn interval_tree_point_stabbing(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > IT_MAX_INPUT: return -1
    let frame: view[i64] = input[0:length]
    var words = InlineArray[i64, IT_MAX_Q + 1]()
    let count = it_solve(frame, words[0:IT_MAX_Q + 1])
    if count < 0: return count
    let bytes: usize = count.usize() * 8
    if output.is_null() or output_capacity < bytes: return -2
    let staged: mutable view[u8] = output[0:bytes]
    for i in 0..<count.usize(): it_write_i64(staged, i * 8, words[i])
    bytes.i64()
