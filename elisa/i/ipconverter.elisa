def ipconverter_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2 or length > 38 or input.is_null():
        return -1
    mode: i64 = input[0]
    payload_length_value: i64 = input[1]
    if (mode != 0 and mode != 1) or payload_length_value < 0 or payload_length_value > 35:
        return -1
    payload_length: usize = payload_length_value.usize()
    if length != payload_length + 2:
        return -1

    octets: mutable i64[4] = zeroed
    position: mutable usize = 0
    if mode == 0:
        if payload_length < 7 or payload_length > 15:
            return -1
        octet: mutable usize = 0
        while octet < 4:
            digits: mutable usize = 0
            value: mutable i64 = 0
            while position < payload_length and input[2 + position] != 46:
                byte: i64 = input[2 + position]
                if digits == 3 or byte < 48 or byte > 57:
                    return -1
                value <- value * 10 + byte - 48
                if value > 255:
                    return -1
                digits <- digits + 1
                position <- position + 1
            if digits == 0:
                return -1
            octets[octet] <- value
            if octet < 3:
                if position >= payload_length or input[2 + position] != 46:
                    return -1
                position <- position + 1
            else if position != payload_length:
                return -1
            octet <- octet + 1
    else:
        if payload_length != 35:
            return -1
        octet <- 0
        while octet < 4:
            value: mutable i64 = 0
            bit: mutable usize = 0
            while bit < 8:
                byte: i64 = input[2 + position]
                position <- position + 1
                if byte != 48 and byte != 49:
                    return -1
                value <- value * 2 + byte - 48
                bit <- bit + 1
            octets[octet] <- value
            if octet < 3:
                if input[2 + position] != 46:
                    return -1
                position <- position + 1
            octet <- octet + 1
        if position != payload_length:
            return -1

    output_length: mutable usize = 3
    if mode == 0:
        output_length <- 35
    else:
        octet <- 0
        while octet < 4:
            value: i64 = octets[octet]
            if value >= 100:
                output_length <- output_length + 2
            else if value >= 10:
                output_length <- output_length + 1
            octet <- octet + 1
    if capacity < output_length or output.is_null():
        return -2

    position <- 0
    octet <- 0
    while octet < 4:
        if mode == 0:
            bit: mutable i64 = 7
            while bit >= 0:
                output[position] <- (48 + ((octets[octet] >> bit) & 1)).u8()
                position <- position + 1
                bit <- bit - 1
        else:
            value: mutable i64 = octets[octet]
            if value >= 100:
                output[position] <- (48 + value / 100).u8()
                position <- position + 1
                value <- value % 100
            if value >= 10:
                output[position] <- (48 + value / 10).u8()
                position <- position + 1
                value <- value % 10
            output[position] <- (48 + value).u8()
            position <- position + 1
        if octet < 3:
            output[position] <- 46
            position <- position + 1
        octet <- octet + 1
    position.i64()

export fn ipconverter(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = ipconverter_impl
