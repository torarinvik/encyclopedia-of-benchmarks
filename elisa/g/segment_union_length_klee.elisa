const MAX_INPUT_LENGTH = 130

def segment_union_length_klee_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 1 or input_length > MAX_INPUT_LENGTH: return -1
    n_value:  i64 = input[0]
    if n_value < 0 or n_value > 64: return -1
    n:  usize = n_value.usize()
    if input_length != 1 + 2 * n: return -1
    events: mutable i64[128] = zeroed
    index: mutable usize = 0
    while index < n:
        left:  i64 = input[1 + 2 * index]
        right:  i64 = input[2 + 2 * index]
        if left < -1000 or left > right or right > 1000: return -1
        events[2 * index] <- 2 * (left + 1000)
        events[2 * index + 1] <- 2 * (right + 1000) + 1
        index <- index + 1
    event_count:  usize = 2 * n
    if event_count == 0: return 0

    start: mutable usize = event_count / 2
    root: mutable usize = 0
    child: mutable usize = 0
    while start > 0:
        start <- start - 1
        root <- start
        while root < event_count / 2:
            child <- 2 * root + 1
            if child + 1 < event_count and events[child] < events[child + 1]: child <- child + 1
            if events[root] >= events[child]: break
            temporary:  i64 = events[root]
            events[root] <- events[child]
            events[child] <- temporary
            root <- child
    heap_end: mutable usize = event_count
    while heap_end > 1:
        heap_end <- heap_end - 1
        temporary:  i64 = events[0]
        events[0] <- events[heap_end]
        events[heap_end] <- temporary
        root <- 0
        while root < heap_end / 2:
            child <- 2 * root + 1
            if child + 1 < heap_end and events[child] < events[child + 1]: child <- child + 1
            if events[root] >= events[child]: break
            swap_value:  i64 = events[root]
            events[root] <- events[child]
            events[child] <- swap_value
            root <- child

    active: mutable i64 = 0
    total: mutable i64 = 0
    previous: mutable i64 = 0
    index <- 0
    while index < event_count:
        coordinate_code:  i64 = events[index] / 2
        coordinate:  i64 = coordinate_code - 1000
        if index > 0 and active > 0: total <- total + coordinate - previous
        delta: mutable i64 = 0
        while index < event_count and events[index] / 2 == coordinate_code:
            if events[index] % 2 == 0: delta <- delta + 1
            else: delta <- delta - 1
            index <- index + 1
        active <- active + delta
        previous <- coordinate
    total

def segment_union_length_klee_entry(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH: return -1
    input_view: i64& = input
    input_view_length: usize = length
    segment_union_length_klee_impl(input_view, input_view_length)

export fn segment_union_length_klee(input: i64&, length: usize) -> i64 = segment_union_length_klee_entry
