const MAX_N: usize = 16
const MAX_M: usize = 64
const MAX_INPUT: usize = 132
const INVALID_RESULT: f64 = -1.0e300

def gbbs_greedy_plus_plus_densest_subgraph(input: i64&, length: usize) -> f64:
    if input.is_null() or length < 2 or length > MAX_INPUT: return INVALID_RESULT
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 10 or n64 > 16 or m64 < 0 or m64 > 64 or length != 2 + 2 * m64.usize(): return INVALID_RESULT
    n: usize = n64.usize()
    m: usize = m64.usize()
    adjacent: mutable u8[MAX_N * MAX_N] = zeroed
    load: mutable i64[MAX_N] = zeroed
    edge: usize = 0
    while edge < m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or u64 >= v64 or v64 >= n64: return INVALID_RESULT
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * MAX_N + v] != 0: return INVALID_RESULT
        adjacent[u * MAX_N + v] <- 1
        adjacent[v * MAX_N + u] <- 1
        load[u] <- load[u] + 1
        load[v] <- load[v] + 1
        edge <- edge + 1
    best: mutable f64 = 0.0
    round: usize = 0
    while round < 20:
        degree: mutable i64[MAX_N] = zeroed
        alive: mutable bool[MAX_N] = zeroed
        order: mutable usize[MAX_N] = zeroed
        position: mutable usize[MAX_N] = zeroed
        vertex: usize = 0
        while vertex < n:
            degree[vertex] <- load[vertex]
            alive[vertex] <- true
            vertex <- vertex + 1
        used: mutable usize = 0
        while used < n:
            level: mutable i64 = 9223372036854775807
            vertex <- 0
            while vertex < n:
                if alive[vertex] and degree[vertex] < level: level <- degree[vertex]
                vertex <- vertex + 1
            shell: mutable usize[MAX_N] = zeroed
            count: mutable usize = 0
            vertex <- 0
            while vertex < n:
                if alive[vertex] and degree[vertex] == level:
                    shell[count] <- vertex
                    count <- count + 1
                vertex <- vertex + 1
            index: usize = 0
            while index < count:
                alive[shell[index]] <- false
                order[used] <- shell[index]
                used <- used + 1
                index <- index + 1
            vertex <- 0
            while vertex < n:
                if alive[vertex]:
                    removed: mutable i64 = 0
                    index <- 0
                    while index < count:
                        if adjacent[vertex * MAX_N + shell[index]] != 0: removed <- removed + 1
                        index <- index + 1
                    next_degree: i64 = degree[vertex] - removed
                    degree[vertex] <- if next_degree < level then level else next_degree
                vertex <- vertex + 1
        index <- 0
        while index < n:
            position[order[index]] <- index
            index <- index + 1
        density_above: mutable i64[MAX_N] = zeroed
        vertex <- 0
        while vertex < n:
            later: mutable i64 = 0
            other: usize = 0
            while other < n:
                if adjacent[vertex * MAX_N + other] != 0 and position[other] > position[vertex]: later <- later + 1
                other <- other + 1
            density_above[position[vertex]] <- 2 * later
            load[vertex] <- load[vertex] + later
            vertex <- vertex + 1
        suffix_sum: mutable i64 = 0
        index <- n
        while index > 0:
            index <- index - 1
            suffix_sum <- suffix_sum + density_above[index]
            score: f64 = suffix_sum.f64() / (n - index).f64()
            if score > best: best <- score
        round <- round + 1
    best

export fn gbbs_greedy_plus_plus_densest_subgraph(input: i64&, length: usize) -> f64
    @export("gbbs_greedy_plus_plus_densest_subgraph") = gbbs_greedy_plus_plus_densest_subgraph
