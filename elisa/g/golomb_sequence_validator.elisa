# Check whether the packed values match the generated Golomb prefix.
const MAX_N: usize = 1024

def golomb_sequence_validator_impl(input: i64&, length: usize) -> i64:
    if length < 1 or length > MAX_N:
        return -1
    if input[0] < 1 or input[0] > 1024:
        return -1
    n: usize = input[0].usize()
    if length != n:
        return -1
    index: mutable usize = 1
    while index < n:
        if input[index] < -2147483648 or input[index] > 2147483647:
            return -1
        index <- index + 1

    dp: mutable i64[1024] = zeroed
    dp[0] <- 1
    i: mutable usize = 1
    while i < n:
        previous: usize = dp[i - 1].usize()
        nested: usize = dp[previous].usize()
        source: usize = i - nested
        dp[i] <- 1 + dp[source]
        i <- i + 1
    index <- 1
    while index < n:
        if input[index] != dp[index]:
            return 0
        index <- index + 1
    1

export fn golomb_sequence_validator(input: i64&, length: usize) -> i64 = golomb_sequence_validator_impl
