# Independent bounded ROP3 profile; full AFPL v5 terms are in package LICENSE.txt.
export fn cbench_ghostscript_rop3(values: i64&, length: usize) -> i64 = cbench_ghostscript_rop3_impl

def cbench_ghostscript_rop3_impl(values: i64&, length: usize) -> i64:
    if length > 5: return -1
    if length > 0 and values == null: return -1
    if length != 4: return -1
    i: mutable usize = 0
    while i < 3:
        if values[i] < 0 or values[i] > 4294967295: return -1
        i <- i + 1
    if values[3] < 0 or values[3] > 255: return -1
    d: u64 = values[0].u64()
    s: u64 = values[1].u64()
    t: u64 = values[2].u64()
    code: u64 = values[3].u64()
    result: mutable u64 = 0
    bit: mutable usize = 0
    while bit < 32:
        index: u64 = ((t >> bit) & 1) << 2 | ((s >> bit) & 1) << 1 | ((d >> bit) & 1)
        if ((code >> index) & 1) != 0: result <- result | (1.u64() << bit)
        bit <- bit + 1
    return result.i64()
