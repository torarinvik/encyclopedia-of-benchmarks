def matching_greedy_put_i64(output: mutable view[u8], word: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[word * 8 + byte] <- (bits >> (byte * 8)).u8()

def approximate_matching_greedy_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 98:
        return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    if n0 < 1 or n0 > 12 or m0 < 0 or m0 > 32 or length != (2 + 3 * m0).usize():
        return -1
    m: usize = m0.usize()
    seen: mutable bool[144] = zeroed
    matched: mutable bool[12] = zeroed
    used: mutable bool[32] = zeroed
    for i in 0..<m:
        u0: i64 = input[2 + 3 * i]
        v0: i64 = input[3 + 3 * i]
        weight: i64 = input[4 + 3 * i]
        if u0 < 0 or u0 >= n0 or v0 < 0 or v0 >= n0 or u0 == v0 or weight < 1 or weight > 100:
            return -1
        u: usize = u0.usize()
        v: usize = v0.usize()
        lo: usize = u
        hi: usize = v
        if lo > hi:
            lo <- v
            hi <- u
        key: usize = lo * 12 + hi
        if seen[key]:
            return -1
        seen[key] <- true
    if output == null or capacity < 16:
        return -2
    total: mutable i64 = 0
    selected: mutable u64 = 0
    for step in 0..<m:
        best: mutable usize = m
        for i in 0..<m:
            if not used[i] and (best == m or input[4 + 3 * i] > input[4 + 3 * best]):
                best <- i
        used[best] <- true
        u: usize = input[2 + 3 * best].usize()
        v: usize = input[3 + 3 * best].usize()
        weight: i64 = input[4 + 3 * best]
        if not matched[u] and not matched[v]:
            matched[u] <- true
            matched[v] <- true
            selected <- selected | (1.u64() << best)
            total <- total + weight
    matching_greedy_put_i64(output[0:16], 0, total)
    matching_greedy_put_i64(output[0:16], 1, selected.i64())
    16

export fn approximate_matching_greedy(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = approximate_matching_greedy_impl
