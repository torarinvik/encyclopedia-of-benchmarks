const GBBS_MM_MAX_N: usize = 16
const GBBS_MM_MAX_M: usize = 64
const GBBS_MM_MAX_INPUT: usize = 194

def gbbs_mm_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def gbbs_maximal_matching(input: i64&, length: usize,
                          output: mutable u8&, capacity: usize) -> i64 @export("gbbs_maximal_matching"):
    if input.is_null() or length < 2 or length > GBBS_MM_MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 64 or length != 2 + 3 * m64.usize(): return -1
    m: usize = m64.usize()
    edge_start: usize = 2 + m
    rank_seen: mutable bool[64] = zeroed
    order: mutable usize[64] = zeroed
    edge: mutable usize = 0
    while edge < m:
        rank64: i64 = input[2 + edge]
        if rank64 < 0 or rank64 >= m64: return -1
        rank: usize = rank64.usize()
        if rank_seen[rank]: return -1
        rank_seen[rank] <- true
        order[rank] <- edge
        u64: i64 = input[edge_start + 2 * edge]
        v64: i64 = input[edge_start + 2 * edge + 1]
        if u64 < 0 or v64 <= u64 or v64 >= n64: return -1
        prior: mutable usize = 0
        while prior < edge:
            if input[edge_start + 2 * prior] == u64 and input[edge_start + 2 * prior + 1] == v64: return -1
            prior <- prior + 1
        edge <- edge + 1
    output_bytes: usize = 8 * m
    if output.is_null() or capacity < output_bytes: return -2
    matched: mutable bool[16] = zeroed
    selected: mutable i64[64] = zeroed
    rank: mutable usize = 0
    while rank < m:
        edge <- order[rank]
        u: usize = input[edge_start + 2 * edge].usize()
        v: usize = input[edge_start + 2 * edge + 1].usize()
        if not matched[u] and not matched[v]:
            selected[edge] <- 1
            matched[u] <- true
            matched[v] <- true
        rank <- rank + 1
    edge <- 0
    while edge < m:
        gbbs_mm_store_i64_le(selected[edge], output, 8 * edge)
        edge <- edge + 1
    output_bytes.i64()
