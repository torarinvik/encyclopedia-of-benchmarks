const MAX_VERTICES: usize = 64
const MAX_EDGES: i64 = 2016

def graph_coloring_backtracking_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255.u64()).u8()
        bits <- bits >> 8

def graph_coloring_backtracking_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2:
        return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 0 or n_value > 64 or m_value < 0 or m_value > MAX_EDGES:
        return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + 2 * m:
        return -1
    edge_valid: bool =
        while edge < m |edge: mutable usize = 0, valid: mutable bool = true| -> valid:
            u_value: i64 = input[2 + 2 * edge]
            v_value: i64 = input[3 + 2 * edge]
            if u_value < 0 or u_value >= n_value or v_value < 0 or v_value >= n_value or u_value == v_value:
                break false
            edge <- edge + 1
    if not edge_valid:
        return -1

    adjacency: bool[4096] =
        while edge < m |edge: mutable usize = 0, state: mutable bool[4096] = zeroed| -> state:
            u: usize = input[2 + 2 * edge].usize()
            v: usize = input[3 + 2 * edge].usize()
            state[u * MAX_VERTICES + v] <- true
            state[v * MAX_VERTICES + u] <- true
            edge <- edge + 1
            state

    colors: i64[64] =
        while vertex < n |vertex: mutable usize = 0, state: mutable i64[64] = zeroed| -> state:
            color: usize =
                while candidate <= n |candidate: mutable usize = 1, selected: mutable usize = 0| -> selected:
                    conflict: bool =
                        while neighbor < vertex |neighbor: mutable usize = 0, found: mutable bool = false| -> found:
                            if adjacency[vertex * MAX_VERTICES + neighbor] and state[neighbor] == candidate.i64():
                                break true
                            neighbor <- neighbor + 1
                    if not conflict:
                        break candidate
                    candidate <- candidate + 1
                    0
            state[vertex] <- color.i64()
            vertex <- vertex + 1
            state

    colors_used: i64 =
        for vertex in 0..<n |maximum: mutable i64 = 0| -> maximum:
            if colors[vertex] > maximum:
                maximum <- colors[vertex]
            maximum
    used: usize = n + 2
    required: usize = used * 8
    if capacity < required:
        return -2
    graph_coloring_backtracking_put_i64(output[0:required], 0, n_value)
    for vertex in 0..<n:
        graph_coloring_backtracking_put_i64(output[0:required], (vertex + 1) * 8, colors[vertex])
    graph_coloring_backtracking_put_i64(output[0:required], (n + 1) * 8, colors_used)
    required.i64()

export fn graph_coloring_backtracking(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = graph_coloring_backtracking_impl
