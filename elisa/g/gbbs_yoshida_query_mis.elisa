# Clean-room GBBS Yoshida recursive MIS query; see package LICENSE.txt.
const MAX_N: usize = 12
const MAX_M: usize = 24
const MAX_INPUT: usize = 52
const MAX_CUTOFF: usize = 128

def gbbs_yoshida_query_mis_hash64(value: u64) -> u64:
    mixed: mutable u64 = value * 3935559000370003845.u64() + 2691343689449507681.u64()
    mixed <- mixed ^ (mixed >> 21)
    mixed <- mixed ^ (mixed << 37)
    mixed <- mixed ^ (mixed >> 4)
    mixed <- mixed * 4768777513237032717.u64()
    mixed <- mixed ^ (mixed << 20)
    mixed <- mixed ^ (mixed >> 41)
    mixed <- mixed ^ (mixed << 5)
    mixed

def gbbs_yoshida_query_mis_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255.u64()).u8()
        bits <- bits >> 8

def gbbs_yoshida_query_mis_query(vertex: usize, degree: usize[12]&,
        neighbors: usize[144]&, priority: u64[12]&,
        work: mutable usize&, cutoff: usize) -> i64:
    index: mutable usize = 0
    while index < degree[vertex]:
        if work == cutoff: return -1
        neighbor: usize = neighbors[vertex * MAX_N + index]
        work <- work + 1
        if priority[vertex] < priority[neighbor] or
            (priority[vertex] == priority[neighbor] and vertex <= neighbor):
            break
        status: i64 = gbbs_yoshida_query_mis_query(neighbor, degree, neighbors, priority, work&, cutoff)
        if status == 1: return 0
        if status == -1: return -1
        index <- index + 1
    1

export fn gbbs_yoshida_query_mis(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    root64: i64 = input[2]
    cutoff64: i64 = input[3]
    if n64 < 1 or n64 > 12 or m64 < 0 or m64 > 24 or
        root64 < 0 or root64 >= n64 or cutoff64 < 0 or cutoff64 > 128 or
        length != 4 + 2 * m64.usize(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    adjacent: mutable bool[144] = zeroed
    degree: mutable usize[12] = zeroed
    for edge in 0..<m:
        u64: i64 = input[4 + 2 * edge]
        v64: i64 = input[5 + 2 * edge]
        if u64 < 0 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * MAX_N + v]: return -1
        adjacent[u * MAX_N + v] <- true
        adjacent[v * MAX_N + u] <- true
        degree[u] <- degree[u] + 1
        degree[v] <- degree[v] + 1
    if output.is_null() or capacity < 16: return -2
    priority: mutable u64[12] = zeroed
    neighbors: mutable usize[144] = zeroed
    for vertex in 0..<n: priority[vertex] <- gbbs_yoshida_query_mis_hash64(vertex.u64())
    for vertex in 0..<n:
        inserted: mutable usize = 0
        for other in 0..<n:
            if adjacent[vertex * MAX_N + other]:
                position: mutable usize = inserted
                while position > 0:
                    previous: usize = neighbors[vertex * MAX_N + position - 1]
                    if priority[previous] < priority[other] or
                        (priority[previous] == priority[other] and previous < other):
                        break
                    neighbors[vertex * MAX_N + position] <- previous
                    position <- position - 1
                neighbors[vertex * MAX_N + position] <- other
                inserted <- inserted + 1
    work: mutable usize = 0
    status: i64 = gbbs_yoshida_query_mis_query(root64.usize(), degree&, neighbors&, priority&, work&, cutoff64.usize())
    gbbs_yoshida_query_mis_store(status, output&, 0)
    gbbs_yoshida_query_mis_store(work.i64(), output&, 8)
    16
