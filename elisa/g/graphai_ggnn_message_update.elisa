extern trunc(value: f64) -> f64
extern exp(value: f64) -> f64

const MAX_N: usize = 8
const MAX_M: usize = 24
const MAX_D: usize = 4
const MAX_PARSEABLE: usize = 453

def graphai_ggnn_message_update_impl(input: f64&, length: usize,
                                     output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_PARSEABLE: return -1
    for q in 0..<length:
        value: f64 = input[q]
        if value != value or value > 1.7976931348623157e308 or value < -1.7976931348623157e308: return -1
    nv: f64 = input[0]
    mv: f64 = input[1]
    dv: f64 = input[2]
    if trunc(nv) != nv or trunc(mv) != mv or trunc(dv) != dv: return -1
    if nv < 1.0 or nv > 8.0 or mv < 0.0 or mv > 24.0 or dv < 1.0 or dv > 4.0: return -1
    n: usize = nv.usize()
    m: usize = mv.usize()
    d: usize = dv.usize()
    if length != 4 + n + m + n*d + 6*n*n: return -1
    row_at: usize = 3
    col_at: usize = row_at + n + 1
    h_at: usize = col_at + m
    wz_at: usize = h_at + n*d
    wr_at: usize = wz_at + n*n
    wc_at: usize = wr_at + n*n
    uz_at: usize = wc_at + n*n
    ur_at: usize = uz_at + n*n
    uc_at: usize = ur_at + n*n
    if input[row_at] != 0.0 or input[col_at-1] != m.f64(): return -1
    rows: mutable usize[9] = zeroed
    cols: mutable usize[24] = zeroed
    for i in 0..=n:
        value: f64 = input[row_at+i]
        if trunc(value) != value or value < 0.0 or value > m.f64(): return -1
        rows[i] <- value.usize()
        if i > 0 and rows[i] < rows[i-1]: return -1
    for e in 0..<m:
        value: f64 = input[col_at+e]
        if trunc(value) != value or value < 0.0 or value >= n.f64(): return -1
        cols[e] <- value.usize()
    for q in h_at..<wz_at:
        if input[q] < -1.0 or input[q] > 1.0: return -1
    for q in wz_at..<length:
        if input[q] < -0.25 or input[q] > 0.25: return -1
    required: usize = n*d
    if output.is_null() or capacity < required: return -2
    aggregate: mutable f64[32] = zeroed
    update: mutable f64[32] = zeroed
    reset: mutable f64[32] = zeroed
    candidate: mutable f64[32] = zeroed
    staged: mutable f64[32] = zeroed
    for v in 0..<n:
        for e in rows[v]..<rows[v+1]:
            for f in 0..<d:
                aggregate[v*d+f] <- aggregate[v*d+f] + input[h_at+cols[e]*d+f]
    for v in 0..<n:
        for f in 0..<d:
            wz: f64 = 0.0
            wr: f64 = 0.0
            uz: f64 = 0.0
            ur: f64 = 0.0
            for k in 0..<n:
                a: usize = v*n+k
                b: usize = k*d+f
                wz <- wz + input[wz_at+a]*aggregate[b]
                wr <- wr + input[wr_at+a]*aggregate[b]
                uz <- uz + input[uz_at+a]*input[h_at+b]
                ur <- ur + input[ur_at+a]*input[h_at+b]
            at: usize = v*d+f
            update[at] <- 1.0/(1.0+exp(-(wz+uz)))
            reset[at] <- 1.0/(1.0+exp(-(wr+ur)))
    for v in 0..<n:
        for f in 0..<d:
            from_graph: f64 = 0.0
            from_state: f64 = 0.0
            for k in 0..<n:
                a: usize = v*n+k
                b: usize = k*d+f
                from_graph <- from_graph + input[wc_at+a]*aggregate[b]
                from_state <- from_state + input[uc_at+a]*(reset[b]*input[h_at+b])
            at: usize = v*d+f
            x: f64 = from_graph+from_state
            candidate[at] <- 2.0/(1.0+exp(-2.0*x))-1.0
            staged[at] <- (1.0-update[at])*input[h_at+at]+update[at]*candidate[at]
    for q in 0..<required: output[q] <- staged[q]
    required.i64()

export fn graphai_ggnn_message_update(input: f64&, length: usize,
    output: mutable f64&, capacity: usize) -> i64 = graphai_ggnn_message_update_impl
