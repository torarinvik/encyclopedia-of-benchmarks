# Clean-room bounded GBBS Shiloach-Vishkin spanning-forest profile.
const GBBS_SV_FOREST_N: usize = 12
const GBBS_SV_FOREST_M: usize = 24
const GBBS_SV_FOREST_INPUT: usize = 50

def gbbs_sv_forest_find_root(parent: mutable view[usize], vertex_in: usize) -> usize:
    vertex: mutable usize = vertex_in
    while parent[vertex] != vertex:
        parent[vertex] <- parent[parent[vertex]]
        vertex <- parent[vertex]
    vertex

def gbbs_shiloach_vishkin_spanning_forest_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > GBBS_SV_FOREST_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > GBBS_SV_FOREST_N.i64() or
        m64 < 0 or m64 > GBBS_SV_FOREST_M.i64(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    seen: mutable bool[144] = zeroed
    edge_u: mutable usize[24] = zeroed
    edge_v: mutable usize[24] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or u64 >= n64 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if seen[u * GBBS_SV_FOREST_N + v]: return -1
        seen[u * GBBS_SV_FOREST_N + v] <- true
        edge_u[edge] <- u
        edge_v[edge] <- v
        edge <- edge + 1
    if output.is_null() or capacity < m: return -2

    parent: mutable usize[12] = zeroed
    previous: mutable usize[12] = zeroed
    next_parent: mutable usize[12] = zeroed
    best_lower: mutable usize[12] = zeroed
    selected: mutable u8[24] = zeroed
    vertex: mutable usize = 0
    while vertex < n:
        parent[vertex] <- vertex
        vertex <- vertex + 1

    round: mutable usize = 0
    while round < n:
        vertex <- 0
        while vertex < n:
            previous[vertex] <- gbbs_sv_forest_find_root(parent[0:n], vertex)
            next_parent[vertex] <- previous[vertex]
            best_lower[vertex] <- n
            vertex <- vertex + 1
        edge <- 0
        while edge < m:
            root_u: usize = previous[edge_u[edge]]
            root_v: usize = previous[edge_v[edge]]
            if root_u != root_v:
                lower: usize = if root_u < root_v then root_u else root_v
                higher: usize = if root_u < root_v then root_v else root_u
                if previous[higher] == higher and lower < best_lower[higher]:
                    best_lower[higher] <- lower
            edge <- edge + 1
        changed: mutable bool = false
        higher <- 0
        while higher < n:
            lower: usize = best_lower[higher]
            if lower != n:
                next_parent[higher] <- lower
                changed <- true
                edge <- 0
                while edge < m:
                    root_u <- previous[edge_u[edge]]
                    root_v <- previous[edge_v[edge]]
                    if (root_u == higher and root_v == lower) or
                        (root_u == lower and root_v == higher):
                        selected[edge] <- 1
                        break
                    edge <- edge + 1
            higher <- higher + 1
        vertex <- 0
        while vertex < n:
            parent[vertex] <- gbbs_sv_forest_find_root(next_parent[0:n], vertex)
            vertex <- vertex + 1
        if not changed: break
        round <- round + 1

    edge <- 0
    while edge < m:
        output[edge] <- selected[edge]
        edge <- edge + 1
    m.i64()

export fn gbbs_shiloach_vishkin_spanning_forest(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 @export("gbbs_shiloach_vishkin_spanning_forest") =
    gbbs_shiloach_vishkin_spanning_forest_impl
