# BEST theorem combined with a directed Matrix-Tree cofactor.
const MAX_VERTICES: usize = 7
const MAX_EDGES: usize = 9
const MAX_INPUT_LENGTH: usize = 20
const MODULUS: i64 = 998244353

def counting_eulerian_circuits_modular_power(base_value: i64, exponent_value: i64) -> i64:
    result: mutable i64 = 1
    base: mutable i64 = base_value
    exponent: mutable i64 = exponent_value
    while exponent > 0 |exponent, base, result| -> exponent, base, result:
        if exponent % 2 == 1:
            result <- (result * base) % MODULUS
        base <- (base * base) % MODULUS
        exponent <- exponent / 2
        exponent, base, result
    result

def counting_eulerian_circuits_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 7 or m_value < 1 or m_value > 9:
        return -1
    n: usize = n_value.usize()
    edge_count: usize = m_value.usize()
    if length != 2 + 2 * edge_count:
        return -1

    indegree: mutable usize[7] = zeroed
    outdegree: mutable usize[7] = zeroed
    start: mutable usize = 0
    edge: mutable usize = 0
    while edge < edge_count |edge, input, indegree, outdegree, start| -> edge, indegree, outdegree, start:
        u_value: i64 = input[2 + 2 * edge]
        v_value: i64 = input[3 + 2 * edge]
        if u_value < 0 or u_value >= n_value or v_value < 0 or v_value >= n_value:
            return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        if edge == 0:
            start <- u
        outdegree[u] <- outdegree[u] + 1
        indegree[v] <- indegree[v] + 1
        edge <- edge + 1
        edge, indegree, outdegree, start

    balanced: mutable bool = true
    vertex: mutable usize = 0
    while vertex < n |vertex, indegree, outdegree, balanced|:
        if indegree[vertex] != outdegree[vertex]:
            balanced <- false
        vertex <- vertex + 1
        vertex, balanced

    answer: mutable i64 = 0
    if balanced:
        active_id: mutable usize[7] = zeroed
        active_count: mutable usize = 0
        vertex <- 0
        while vertex < n |vertex, indegree, active_id, active_count|:
            active_id[vertex] <- MAX_VERTICES
            if indegree[vertex] != 0:
                active_id[vertex] <- active_count
                active_count <- active_count + 1
            vertex <- vertex + 1
            vertex, active_id, active_count
        root_id: usize = active_id[start]
        dimension: usize = active_count - 1
        matrix: mutable i64[7][7] = zeroed
        edge <- 0
        while edge < edge_count |edge, input, matrix, active_id, root_id, start| -> edge, matrix:
            u: usize = input[2 + 2 * edge].usize()
            v: usize = input[3 + 2 * edge].usize()
            if u != start:
                row: usize = active_id[u]
                if row > root_id:
                    row <- row - 1
                matrix[row][row] <- (matrix[row][row] + 1) % MODULUS
                if v != start:
                    column: usize = active_id[v]
                    if column > root_id:
                        column <- column - 1
                    matrix[row][column] <- (matrix[row][column] + MODULUS - 1) % MODULUS
            edge <- edge + 1
            edge, matrix

        determinant: mutable i64 = 1
        column: mutable usize = 0
        while column < dimension |column, matrix, determinant|:
            pivot: mutable usize = column
            pivot_found: mutable bool = false
            while pivot < dimension and not pivot_found |pivot, pivot_found, column, matrix|:
                if matrix[pivot][column] != 0:
                    pivot_found <- true
                else:
                    pivot <- pivot + 1
                pivot, pivot_found
            if not pivot_found:
                determinant <- 0
                column <- dimension
                column, determinant
            else:
                if pivot != column:
                    j: mutable usize = 0
                    while j < dimension |j, matrix, column, pivot|:
                        temporary: i64 = matrix[column][j]
                        matrix[column][j] <- matrix[pivot][j]
                        matrix[pivot][j] <- temporary
                        j <- j + 1
                        j, matrix
                    determinant <- (MODULUS - determinant) % MODULUS
                pivot_value: i64 = matrix[column][column]
                determinant <- (determinant * pivot_value) % MODULUS
                inverse: i64 = counting_eulerian_circuits_modular_power(pivot_value, MODULUS - 2)
                row: mutable usize = column + 1
                while row < dimension |row, matrix, column, inverse| -> row, matrix:
                    factor: i64 = (matrix[row][column] * inverse) % MODULUS
                    j <- column
                    while j < dimension |j, matrix, row, column, factor|:
                        matrix[row][j] <- (matrix[row][j] - factor * matrix[column][j] % MODULUS + MODULUS) % MODULUS
                        j <- j + 1
                        j, matrix
                    row <- row + 1
                    row, matrix
                column <- column + 1
                column, matrix, determinant
        answer <- determinant
        vertex <- 0
        while vertex < n |vertex, outdegree, answer|:
            factor: mutable usize = 2
            while factor < outdegree[vertex] |factor, outdegree, vertex, answer|:
                answer <- (answer * factor.i64()) % MODULUS
                factor <- factor + 1
                factor, answer
            vertex <- vertex + 1
            vertex, answer

    if output.is_null() or output_capacity < 8:
        return -2
    encoded: u64 = answer.u64()
    for byte in 0..<8 |byte, output, encoded|:
        output[byte] <- ((encoded >> (byte * 8)) & 255.u64()).u8()
    8

export fn counting_eulerian_circuits(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = counting_eulerian_circuits_impl
