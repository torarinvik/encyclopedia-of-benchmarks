const MAX_TEXT: usize = 24
const MAX_PATTERN: usize = 32
const MAX_POSITIONS: usize = 8
const MAX_STATES: usize = 9
const MAX_NODES: usize = 64

struct GlushkovNode:
    kind: u8
    left: usize
    right: usize
    position: usize

struct GlushkovParser:
    pattern: i64[32]
    length: usize
    cursor: usize
    node_count: usize
    position_count: usize
    nodes: GlushkovNode[64]
    symbols: u8[9]
    failed: bool

def glushkov_add_node(parser: mutable GlushkovParser&, kind: u8,
        left: usize, right: usize, position: usize) -> usize:
    if parser.node_count >= MAX_NODES:
        parser.failed <- true
        return 0
    result: usize = parser.node_count
    parser.nodes[result] <- GlushkovNode(kind, left, right, position)
    parser.node_count <- parser.node_count + 1
    result

def glushkov_parse_expression(parser: mutable GlushkovParser&) -> usize:
    result: mutable usize = glushkov_parse_concatenation(parser&)
    while not parser.failed and parser.cursor < parser.length and parser.pattern[parser.cursor] == 124:
        parser.cursor <- parser.cursor + 1
        right: usize = glushkov_parse_concatenation(parser&)
        result <- glushkov_add_node(parser&, 3, result, right, 0)
    result

def glushkov_parse_concatenation(parser: mutable GlushkovParser&) -> usize:
    if parser.cursor >= parser.length or parser.pattern[parser.cursor] == 124 or parser.pattern[parser.cursor] == 41:
        parser.failed <- true
        return 0
    result: mutable usize = glushkov_parse_repetition(parser&)
    while not parser.failed and parser.cursor < parser.length and parser.pattern[parser.cursor] != 124 and parser.pattern[parser.cursor] != 41:
        right: usize = glushkov_parse_repetition(parser&)
        result <- glushkov_add_node(parser&, 2, result, right, 0)
    result

def glushkov_parse_repetition(parser: mutable GlushkovParser&) -> usize:
    result: mutable usize = glushkov_parse_atom(parser&)
    if not parser.failed and parser.cursor < parser.length and parser.pattern[parser.cursor] == 42:
        parser.cursor <- parser.cursor + 1
        result <- glushkov_add_node(parser&, 4, result, 0, 0)
    result

def glushkov_parse_atom(parser: mutable GlushkovParser&) -> usize:
    if parser.cursor >= parser.length:
        parser.failed <- true
        return 0
    token: i64 = parser.pattern[parser.cursor]
    parser.cursor <- parser.cursor + 1
    if token == 40:
        result: usize = glushkov_parse_expression(parser&)
        if parser.failed or parser.cursor >= parser.length or parser.pattern[parser.cursor] != 41:
            parser.failed <- true
            return 0
        parser.cursor <- parser.cursor + 1
        return result
    if token != 97 and token != 98 and token != 99 and token != 46:
        parser.failed <- true
        return 0
    if parser.position_count >= MAX_POSITIONS:
        parser.failed <- true
        return 0
    parser.position_count <- parser.position_count + 1
    position: usize = parser.position_count
    parser.symbols[position] <- token.u8()
    glushkov_add_node(parser&, 1, 0, 0, position)

def glushkov_bit_parallel_regex_search_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 58:
        return -1
    values: view[i64] = input[0:length]
    if values[0] < 0 or values[0] > MAX_TEXT.i64() or values[1] < 1 or values[1] > MAX_PATTERN.i64():
        return -1
    text_length: usize = values[0].usize()
    pattern_length: usize = values[1].usize()
    if length != 2 + text_length + pattern_length:
        return -1
    i: mutable usize = 0
    while i < text_length + pattern_length:
        if values[2 + i] < 1 or values[2 + i] > 127:
            return -1
        i <- i + 1

    parser: mutable GlushkovParser = zeroed
    parser.length <- pattern_length
    i <- 0
    while i < pattern_length:
        parser.pattern[i] <- values[2 + text_length + i]
        i <- i + 1
    root: usize = glushkov_parse_expression(parser&)
    if parser.failed or parser.cursor != pattern_length or parser.node_count == 0:
        return -1

    nullable: mutable bool[MAX_NODES] = zeroed
    first: mutable u16[MAX_NODES] = zeroed
    last: mutable u16[MAX_NODES] = zeroed
    follow: mutable u16[MAX_STATES] = zeroed
    i <- 0
    while i < parser.node_count:
        node: GlushkovNode = parser.nodes[i]
        if node.kind == 1:
            bit: u16 = 1.u16() << node.position
            first[i] <- bit
            last[i] <- bit
        else if node.kind == 4:
            nullable[i] <- true
            first[i] <- first[node.left]
            last[i] <- last[node.left]
            pos: mutable usize = 1
            while pos <= parser.position_count:
                if (last[node.left] & (1.u16() << pos)) != 0.u16():
                    follow[pos] <- follow[pos] | first[node.left]
                pos <- pos + 1
        else if node.kind == 3:
            nullable[i] <- nullable[node.left] or nullable[node.right]
            first[i] <- first[node.left] | first[node.right]
            last[i] <- last[node.left] | last[node.right]
        else:
            nullable[i] <- nullable[node.left] and nullable[node.right]
            if nullable[node.left]:
                first[i] <- first[node.left] | first[node.right]
            else:
                first[i] <- first[node.left]
            if nullable[node.right]:
                last[i] <- last[node.right] | last[node.left]
            else:
                last[i] <- last[node.right]
            pos <- 1
            while pos <= parser.position_count:
                if (last[node.left] & (1.u16() << pos)) != 0.u16():
                    follow[pos] <- follow[pos] | first[node.right]
                pos <- pos + 1
        i <- i + 1
    follow[0] <- first[root] | 1.u16()

    transitions: mutable u16[512] = zeroed
    subset_count: usize = 1 << (parser.position_count + 1)
    subset: mutable usize = 1
    while subset < subset_count:
        state: mutable usize = 0
        while ((subset >> state) & 1) == 0:
            state <- state + 1
        transitions[subset] <- transitions[subset & (subset - 1)] | follow[state]
        subset <- subset + 1
    byte_masks: mutable u16[128] = zeroed
    i <- 0
    while i < 128:
        byte_masks[i] <- 1.u16()
        i <- i + 1
    pos <- 1
    while pos <= parser.position_count:
        i <- 1
        while i < 128:
            if parser.symbols[pos] == 46 or parser.symbols[pos].usize() == i:
                byte_masks[i] <- byte_masks[i] | (1.u16() << pos)
            i <- i + 1
        pos <- pos + 1

    staged: mutable u8[MAX_TEXT] = zeroed
    active: mutable u16 = 1.u16()
    i <- 0
    while i < text_length:
        active <- transitions[active.usize()] & byte_masks[values[2 + i].usize()]
        if (active & last[root]) != 0.u16():
            staged[i] <- 1
        i <- i + 1
    if text_length > 0 and (output.is_null() or output_capacity < text_length):
        return -2
    if text_length > 0:
        output_view: mutable view[u8] = output[0:text_length]
        i <- 0
        while i < text_length:
            output_view[i] <- staged[i]
            i <- i + 1
    text_length.i64()

export fn glushkov_bit_parallel_regex_search(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) -> i64 = glushkov_bit_parallel_regex_search_impl
