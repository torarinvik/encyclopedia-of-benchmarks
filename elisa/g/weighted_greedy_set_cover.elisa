const MAX_M: usize = 16
const MAX_INPUT: usize = 34
const MAX_OUTPUT: usize = 136

def put64(value: i64, output: mutable u8&, position: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def bit_count(value: u64) -> usize:
    bits: mutable u64 = value
    count: mutable usize = 0
    while bits != 0:
        bits <- bits & (bits - 1)
        count <- count + 1
    count

def weighted_greedy_set_cover(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 @export("weighted_greedy_set_cover"):
    if input.is_null() or length < 4 or length > MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 1 or m64 > 16 or length != 2 + 2 * m64.usize(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    full: u64 = (1.u64() << n) - 1
    weight: mutable i64[MAX_M] = zeroed
    mask: mutable u64[MAX_M] = zeroed
    union_mask: mutable u64 = 0
    set: mutable usize = 0
    while set < m:
        weight[set] <- input[2 + set]
        mask_value: i64 = input[2 + m + set]
        if weight[set] < 0 or weight[set] > 10000 or mask_value < 0 or
                (mask_value.u64() & ~full) != 0: return -1
        mask[set] <- mask_value.u64()
        union_mask <- union_mask | mask[set]
        set <- set + 1
    if union_mask != full: return -1

    covered: mutable u64 = 0
    selected: mutable usize[MAX_M] = zeroed
    selected_count: mutable usize = 0
    while covered != full:
        best: mutable usize = MAX_M
        best_gain: mutable usize = 0
        set <- 0
        while set < m:
            gain: usize = bit_count(mask[set] & ~covered)
            if gain > 0 and (best == MAX_M or weight[set] * best_gain.i64() < weight[best] * gain.i64()):
                best <- set
                best_gain <- gain
            set <- set + 1
        if best == MAX_M: return -1
        selected[selected_count] <- best
        selected_count <- selected_count + 1
        covered <- covered | mask[best]

    output_bytes: usize = 8 * (selected_count + 1)
    if output.is_null() or capacity < output_bytes: return -2
    staged: mutable u8[MAX_OUTPUT] = zeroed
    put64(selected_count.i64(), staged&, 0)
    set <- 0
    while set < selected_count:
        put64(selected[set].i64(), staged&, 8 * (set + 1))
        set <- set + 1
    set <- 0
    while set < output_bytes:
        output[set] <- staged[set]
        set <- set + 1
    output_bytes.i64()
