const GBBS_FIVE_CYCLE_MAX_N: usize = 16
const GBBS_FIVE_CYCLE_MAX_M: usize = 64
const GBBS_FIVE_CYCLE_MAX_INPUT: usize = 130

def gbbs_five_cycle_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

// Clean-room bounded GBBS five-cycle profile; see package LICENSE.txt.
def gbbs_five_cycle_count(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("gbbs_five_cycle_count"):
    if input.is_null() or length < 2 or length > GBBS_FIVE_CYCLE_MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 64: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    adjacent: mutable bool[256] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * 16 + v]: return -1
        adjacent[u * 16 + v] <- true
        adjacent[v * 16 + u] <- true
        edge <- edge + 1
    if output.is_null() or capacity < 8: return -2

    count: mutable i64 = 0
    start: mutable usize = 0
    while start < n:
        first: mutable usize = start + 1
        while first < n:
            second: mutable usize = start + 1
            while second < n:
                if second != first:
                    third: mutable usize = start + 1
                    while third < n:
                        if third != first and third != second:
                            last: mutable usize = first + 1
                            while last < n:
                                if last != second and last != third and
                                   adjacent[start * 16 + first] and adjacent[first * 16 + second] and
                                   adjacent[second * 16 + third] and adjacent[third * 16 + last] and
                                   adjacent[last * 16 + start]:
                                    count <- count + 1
                                last <- last + 1
                        third <- third + 1
                second <- second + 1
            first <- first + 1
        start <- start + 1
    gbbs_five_cycle_store_i64_le(count, output, 0)
    return 8
