def gray_to_decimal_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 64:
        return -1
    bit_length: i64 = values[0]
    if bit_length < 1 or bit_length > 63 or length != (bit_length + 1).usize():
        return -1

    prefix: mutable i64 = 0
    binary: mutable i64 = 0
    index: mutable usize = 1
    while index < length:
        character: i64 = values[index]
        if character != 48 and character != 49:
            return -1
        prefix <- prefix ^ (character - 48)
        binary <- binary * 2 + prefix
        index <- index + 1
    binary

export fn gray_to_decimal(values: i64&, length: usize) -> i64 = gray_to_decimal_impl
