const MAX_NUMBER: i64 = 1000000

def germain_prime_and_safe_prime_is_prime(value: i64) -> bool:
    if value == 2:
        return true
    if value < 2 or value % 2 == 0:
        return false
    divisor: mutable i64 = 3
    while divisor <= value / divisor:
        if value % divisor == 0:
            return false
        divisor <- divisor + 2
    true

def germain_prime_and_safe_prime_impl(values: i64&, length: usize) -> i64:
    if length != 2:
        return -1
    number: i64 = values[0]
    selector: i64 = values[1]
    if number < 1 or number > MAX_NUMBER or selector < 0 or selector > 1:
        return -1
    if selector == 0:
        if germain_prime_and_safe_prime_is_prime(number) and germain_prime_and_safe_prime_is_prime(2 * number + 1):
            return 1
        return 0
    if ((number - 1) % 2 == 0 and germain_prime_and_safe_prime_is_prime(number) and
        germain_prime_and_safe_prime_is_prime((number - 1) / 2)):
        return 1
    0

export fn germain_prime_and_safe_prime(values: i64&, length: usize) -> i64 = germain_prime_and_safe_prime_impl
