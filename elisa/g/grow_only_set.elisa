# Two-replica grow-only set trace with idempotent add, subset, merge, and lookup.
def grow_only_set_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 1 or length > 25:
        return -1
    count_value: i64 = values[0]
    if count_value < 0 or count_value > 12 or length != 1 + 2 * count_value.usize():
        return -1
    left: mutable u64 = 0
    right: mutable u64 = 0
    answers: mutable u64 = 0
    query_count: mutable usize = 0
    index: mutable usize = 0
    while index < count_value.usize():
        opcode: i64 = values[1 + 2 * index]
        argument: i64 = values[2 + 2 * index]
        if opcode < 0 or opcode > 7:
            return -1
        if opcode <= 3:
            if argument < 0 or argument > 15:
                return -1
        elif argument != 0:
            return -1
        bit: mutable u64 = 0
        if opcode <= 3:
            bit <- 1.u64() << argument.usize()
        if opcode == 0:
            left <- left | bit
        elif opcode == 1:
            right <- right | bit
        elif opcode == 2:
            if (left & bit) != 0:
                answers <- answers | (1.u64() << query_count)
            query_count <- query_count + 1
        elif opcode == 3:
            if (right & bit) != 0:
                answers <- answers | (1.u64() << query_count)
            query_count <- query_count + 1
        elif opcode == 4:
            if (left & right) == left:
                answers <- answers | (1.u64() << query_count)
            query_count <- query_count + 1
        elif opcode == 5:
            if (left & right) == right:
                answers <- answers | (1.u64() << query_count)
            query_count <- query_count + 1
        elif opcode == 6:
            left <- left | right
        else:
            right <- right | left
        index <- index + 1
    ((answers | (left << 12) | (right << 28) | (query_count.u64() << 44)).i64())

export fn grow_only_set(values: i64&, length: usize) -> i64 = grow_only_set_impl
