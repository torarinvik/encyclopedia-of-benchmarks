const GBBS_LABEL_MAX_N: usize = 16
const GBBS_LABEL_MAX_M: usize = 64
const GBBS_LABEL_MAX_INPUT: usize = 130

def gbbs_label_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

// Clean-room bounded GBBS label-propagation profile; see package LICENSE.txt.
def gbbs_label_propagation_clustering(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 @export("gbbs_label_propagation_clustering"):
    if input.is_null() or length < 2 or length > GBBS_LABEL_MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 64: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    adjacent: mutable bool[256] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * 16 + v]: return -1
        adjacent[u * 16 + v] <- true
        adjacent[v * 16 + u] <- true
        edge <- edge + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes: return -2

    labels: mutable i64[16] = zeroed
    vertex: mutable usize = 0
    while vertex < n:
        labels[vertex] <- vertex.i64()
        vertex <- vertex + 1
    vertex <- 0
    while vertex < n:
        frequency: mutable usize[16] = zeroed
        degree: mutable usize = 0
        neighbor: mutable usize = 0
        while neighbor < n:
            if adjacent[vertex * 16 + neighbor]:
                frequency[labels[neighbor].usize()] <- frequency[labels[neighbor].usize()] + 1
                degree <- degree + 1
            neighbor <- neighbor + 1
        if degree > 0:
            best_label: mutable usize = 0
            best_frequency: mutable usize = 0
            label: mutable usize = 0
            while label < n:
                if frequency[label] > best_frequency or
                   (frequency[label] == best_frequency and frequency[label] > 0 and label > best_label):
                    best_label <- label
                    best_frequency <- frequency[label]
                label <- label + 1
            labels[vertex] <- best_label.i64()
        vertex <- vertex + 1
    vertex <- 0
    while vertex < n:
        gbbs_label_store_i64_le(labels[vertex], output[0:output_bytes], 8 * vertex)
        vertex <- vertex + 1
    return output_bytes.i64()
