# Greatest prime factor over the bounded primelib input domain.
def is_prime_trial(value: i64) -> bool:
    if value < 2:
        return false
    divisor: i64 = 2
    while divisor <= value / divisor:
        if value % divisor == 0:
            return false
        divisor <- divisor + 1
    true

def greatest_prime_factor_impl(n: i64) -> i64:
    if n < 0 or n > 1000000:
        return -1
    if n < 2:
        return n
    if is_prime_trial(n):
        return n

    quotient: i64 = n
    largest: i64 = 0
    factor: i64 = 2
    while quotient != 1:
        if is_prime_trial(factor) and quotient % factor == 0:
            largest <- factor
            quotient <- quotient / factor
        else:
            factor <- factor + 1
    largest

export fn greatest_prime_factor(n: i64) -> i64 = greatest_prime_factor_impl
