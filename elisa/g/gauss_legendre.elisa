const MAX_ITERATIONS: i64 = 8
const INVALID_RESULT: f64 = -1.0e300

# The iteration averages and takes geometric means of positive values.
@link_name("llvm.sqrt.f64")
extern sqrt(value: f64) -> f64

struct GaussLegendreState:
    a: f64
    b: f64
    t: f64

@inline(always)
def gauss_legendre_step(state: GaussLegendreState, weight: f64) -> GaussLegendreState:
    next_a: f64 = (state.a + state.b) / 2.0
    difference: f64 = state.a - next_a
    return GaussLegendreState{a: next_a, b: sqrt(state.a * state.b), t: state.t - weight * difference * difference}

def gauss_legendre_result(state: GaussLegendreState) -> f64:
    sum: f64 = state.a + state.b
    return sum * sum / (4.0 * state.t)

def gauss_legendre_pi(iterations: i64) -> f64:
    # The eight bounded steps expose each constant state to the optimizer.
    state: mutable GaussLegendreState = GaussLegendreState{a: 1.0, b: sqrt(0.5), t: 0.25}
    if iterations == 0: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 1.0)
    if iterations == 1: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 2.0)
    if iterations == 2: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 4.0)
    if iterations == 3: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 8.0)
    if iterations == 4: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 16.0)
    if iterations == 5: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 32.0)
    if iterations == 6: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 64.0)
    if iterations == 7: return gauss_legendre_result(state)
    state <- gauss_legendre_step(state, 128.0)
    return gauss_legendre_result(state)

def gauss_legendre_impl(iterations_value: f64) -> f64:
    if not (iterations_value >= 0.0 and iterations_value <= MAX_ITERATIONS.f64()):
        return INVALID_RESULT
    if iterations_value != iterations_value.i64().f64():
        return INVALID_RESULT
    gauss_legendre_pi(iterations_value.i64())

export fn gauss_legendre(iterations_value: f64) -> f64 = gauss_legendre_impl
