def gray_code_k_combinations_impl(values: i64&, values_length: usize, output: mutable u8&,
        output_is_null: bool, capacity: usize) -> i64:
    if values_length != 2: return -1
    n_value:  i64 = values[0]
    k_value:  i64 = values[1]
    if n_value < 0 or n_value > 12 or k_value < 0 or k_value > n_value: return -1
    n:  usize = n_value.usize()
    k:  usize = k_value.usize()
    smaller:  mutable usize = k
    if smaller > n - k: smaller <- n - k
    count:  mutable usize = 1
    factor:  mutable usize = 1
    while factor <= smaller:
        count <- count * (n - smaller + factor) / factor
        factor <- factor + 1
    required:  usize = 2 + 2 * count
    if output_is_null or capacity < required: return -2
    bytes: mutable u8& = output
    bytes[0] <- (count & 255).u8()
    bytes[1] <- ((count >> 8) & 255).u8()

    limit:  usize = 1.usize() << n
    emitted:  mutable usize = 0
    for index in 0..<limit:
        mask:  usize = index ^ (index >> 1)
        population:  mutable usize = 0
        remaining:  mutable usize = mask
        while remaining > 0:
            remaining <- remaining & (remaining - 1)
            population <- population + 1
        if population == k:
            bytes[2 + 2 * emitted] <- (mask & 255).u8()
            bytes[3 + 2 * emitted] <- ((mask >> 8) & 255).u8()
            emitted <- emitted + 1
    count.i64()

def gray_code_k_combinations_entry(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input == null or length > 3: return -1
    values: i64& = input
    values_length: usize = length
    if output == null:
        empty:  mutable u8[1] = zeroed
        return gray_code_k_combinations_impl(values, values_length, &empty[0], true, capacity)
    gray_code_k_combinations_impl(values, values_length, output, false, capacity)

export fn gray_code_k_combinations(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = gray_code_k_combinations_entry
