# Clean-room bounded GBBS Tarjan-Vishkin biconnectivity profile.
const GBBS_BC_N: usize = 12
const GBBS_BC_M: usize = 24
const GBBS_BC_INPUT: usize = 50

def gbbs_bc_tree_edge(u: usize, v: usize, parent: usize[12]&): bool:
    parent[u] == v or parent[v] == u

def gbbs_bc_critical_edge(u: usize, v: usize, parent: usize[12]&,
        critical: bool[12]&): bool:
    if parent[u] == v: return critical[u]
    if parent[v] == u: return critical[v]
    false

def gbbs_bc_parents_bfs(n: usize, adjacent: bool[144]&,
        parent: mutable usize[12]&, seen: mutable bool[12]&): void:
    frontier: mutable usize[12] = zeroed
    following: mutable usize[12] = zeroed
    candidate: mutable usize[12] = zeroed
    for root in 0..<n:
        if seen[root]: continue
        count: mutable usize = 1
        frontier[0] <- root
        parent[root] <- root
        seen[root] <- true
        while count != 0:
            has: mutable bool[12] = zeroed
            for i in 0..<count:
                vertex: usize = frontier[i]
                for other in 0..<n:
                    if adjacent[vertex * GBBS_BC_N + other] and not seen[other]:
                        if not has[other] or vertex < candidate[other]:
                            candidate[other] <- vertex
                        has[other] <- true
            next_count: mutable usize = 0
            for other in 0..<n:
                if has[other]:
                    parent[other] <- candidate[other]
                    seen[other] <- true
                    following[next_count] <- other
                    next_count <- next_count + 1
            for i in 0..<next_count: frontier[i] <- following[i]
            count <- next_count

def gbbs_bc_preorder(n: usize, parent: usize[12]&,
        pn: mutable usize[12]&, order: mutable usize[12]&,
        size: mutable usize[12]&): void:
    stack: mutable usize[12] = zeroed
    global: mutable usize = 0
    for root in 0..<n:
        if parent[root] != root: continue
        top: mutable usize = 0
        count: mutable usize = 0
        begin: usize = global
        stack[top] <- root
        top <- top + 1
        while top != 0:
            top <- top - 1
            vertex: usize = stack[top]
            pn[vertex] <- count
            count <- count + 1
            order[global] <- vertex
            global <- global + 1
            child: mutable usize = n
            while child > 0:
                child <- child - 1
                if child != vertex and parent[child] == vertex:
                    stack[top] <- child
                    top <- top + 1
        i: mutable usize = global
        while i > begin:
            i <- i - 1
            vertex: usize = order[i]
            if parent[vertex] != vertex:
                size[parent[vertex]] <- size[parent[vertex]] + size[vertex]

export fn gbbs_biconnectivity(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > GBBS_BC_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 12 or m64 < 0 or m64 > 24: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    adjacent: mutable bool[144] = zeroed
    for edge in 0..<m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * GBBS_BC_N + v]: return -1
        adjacent[u * GBBS_BC_N + v] <- true
        adjacent[v * GBBS_BC_N + u] <- true
    if output.is_null() or capacity < m: return -2
    parent: mutable usize[12] = zeroed
    pn: mutable usize[12] = zeroed
    order: mutable usize[12] = zeroed
    size: mutable usize[12] = zeroed
    seen: mutable bool[12] = zeroed
    critical: mutable bool[12] = zeroed
    for v in 0..<n:
        parent[v] <- v
        size[v] <- 1
    gbbs_bc_parents_bfs(n, adjacent&, parent&, seen&)
    gbbs_bc_preorder(n, parent&, pn&, order&, size&)
    low: mutable usize[12] = zeroed
    high: mutable usize[12] = zeroed
    for v in 0..<n:
        low[v] <- pn[v]
        high[v] <- pn[v] + size[v] - 1
    for edge in 0..<m:
        u: usize = input[2 + 2 * edge].usize()
        v: usize = input[3 + 2 * edge].usize()
        if not gbbs_bc_tree_edge(u, v, parent&):
            if pn[u] < low[v]: low[v] <- pn[u]
            else if pn[u] > high[v]: high[v] <- pn[u]
            if pn[v] < low[u]: low[u] <- pn[v]
            else if pn[v] > high[u]: high[u] <- pn[v]
    i: mutable usize = n
    while i > 0:
        i <- i - 1
        vertex: usize = order[i]
        if parent[vertex] != vertex:
            p: usize = parent[vertex]
            if low[vertex] < low[p]: low[p] <- low[vertex]
            if high[vertex] > high[p]: high[p] <- high[vertex]
    for v in 0..<n:
        p: usize = parent[v]
        if v != p and low[v] >= pn[p] and high[v] < pn[p] + size[p]:
            critical[v] <- true
    component: mutable usize[12] = zeroed
    queue: mutable usize[12] = zeroed
    for v in 0..<n: component[v] <- GBBS_BC_N
    for root in 0..<n:
        if component[root] != GBBS_BC_N: continue
        head: mutable usize = 0
        tail: mutable usize = 0
        component[root] <- root
        queue[tail] <- root
        tail <- tail + 1
        while head < tail:
            vertex: usize = queue[head]
            head <- head + 1
            for other in 0..<n:
                if adjacent[vertex * GBBS_BC_N + other] and
                    not gbbs_bc_critical_edge(vertex, other, parent&, critical&) and
                    component[other] == GBBS_BC_N:
                    component[other] <- root
                    queue[tail] <- other
                    tail <- tail + 1
    raw: mutable usize[24] = zeroed
    for edge in 0..<m:
        u: usize = input[2 + 2 * edge].usize()
        v: usize = input[3 + 2 * edge].usize()
        if parent[u] == v and critical[u]: raw[edge] <- component[u]
        else if parent[v] == u and critical[v]: raw[edge] <- component[v]
        else: raw[edge] <- component[u]
    for edge in 0..<m:
        label: mutable usize = m
        for other in 0..<m:
            if raw[other] == raw[edge] and other < label: label <- other
        output[edge] <- label.u8()
    m.i64()
