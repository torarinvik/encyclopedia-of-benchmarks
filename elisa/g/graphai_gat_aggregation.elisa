extern trunc(value: f64) -> f64
extern exp(value: f64) -> f64
const MAX_INPUT: usize = 76

def graphai_gat_aggregation_impl(input: f64&, length: usize,
                                 output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_INPUT: return -1
    for q in 0..<length:
        value: f64 = input[q]
        if value != value or value > 1.7976931348623157e308 or value < -1.7976931348623157e308: return -1
    nv: f64 = input[0]
    mv: f64 = input[1]
    dv: f64 = input[2]
    if trunc(nv) != nv or trunc(mv) != mv or trunc(dv) != dv: return -1
    if nv < 1.0 or nv > 8.0 or mv < 0.0 or mv > 24.0 or dv < 1.0 or dv > 4.0: return -1
    n: usize = nv.usize()
    m: usize = mv.usize()
    d: usize = dv.usize()
    if length != 4 + n + m + 2*d + n*d: return -1
    rowptr_at: usize = 3
    colind_at: usize = rowptr_at + n + 1
    left_at: usize = colind_at + m
    right_at: usize = left_at + d
    feature_at: usize = right_at + d
    if input[rowptr_at] != 0.0 or input[colind_at-1] != m.f64(): return -1
    rowptr: mutable usize[9] = zeroed
    colind: mutable usize[24] = zeroed
    for i in 0..=n:
        value: f64 = input[rowptr_at+i]
        if trunc(value) != value or value < 0.0 or value > m.f64(): return -1
        rowptr[i] <- value.usize()
        if i > 0 and rowptr[i] < rowptr[i-1]: return -1
    for e in 0..<m:
        value: f64 = input[colind_at+e]
        if trunc(value) != value or value < 0.0 or value >= n.f64(): return -1
        colind[e] <- value.usize()
    for q in left_at..<length:
        value: f64 = input[q]
        if value < -8.0 or value > 8.0: return -1
    required: usize = n*d
    if output.is_null() or capacity < required: return -2
    staged: mutable f64[32] = zeroed
    scores: mutable f64[24] = zeroed
    weights: mutable f64[24] = zeroed
    for src in 0..<n:
        begin: usize = rowptr[src]
        finish: usize = rowptr[src+1]
        if begin < finish:
            maximum: f64 = -1.0e300
            for e in begin..<finish:
                dst: usize = colind[e]
                score: f64 = 0.0
                for k in 0..<d: score <- score + input[left_at+k]*input[feature_at+src*d+k]
                for k in 0..<d: score <- score + input[right_at+k]*input[feature_at+dst*d+k]
                scores[e] <- if score > 0.0 then score else 0.2*score
                if scores[e] > maximum: maximum <- scores[e]
            total: f64 = 0.0
            for e in begin..<finish:
                weights[e] <- exp(scores[e]-maximum)
                total <- total + weights[e]
            for e in begin..<finish:
                dst: usize = colind[e]
                scale: f64 = weights[e]/total
                for k in 0..<d: staged[src*d+k] <- staged[src*d+k]+scale*input[feature_at+dst*d+k]
    for q in 0..<required: output[q] <- staged[q]
    required.i64()

export fn graphai_gat_aggregation(input: f64&, length: usize,
                                  output: mutable f64&, capacity: usize) -> i64 = graphai_gat_aggregation_impl
