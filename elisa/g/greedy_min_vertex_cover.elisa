# Maximum-current-degree greedy vertex cover; ties choose the smallest ID.
def greedy_min_vertex_cover_impl(values: i64&, length: usize) -> i64:
    if values == null or length < 2 or length > 17:
        return -1
    count_value: i64 = values[0]
    if count_value < 1 or count_value > 16 or length != count_value.usize() + 1:
        return -1
    count: usize = count_value.usize()
    limit: u64 = (u64(1) << count) - 1
    neighbors: mutable u64[16] = zeroed
    edge_count: mutable usize = 0
    vertex: mutable usize = 0
    bit_index: mutable usize = 0
    while vertex < count:
        mask_value: i64 = values[vertex + 1]
        if mask_value < 0 or mask_value.u64() > limit:
            return -1
        mask: u64 = mask_value.u64()
        if (mask & (u64(1) << vertex)) != 0:
            return -1
        neighbors[vertex] <- mask
        degree: mutable usize = 0
        bit_index <- 0
        while bit_index < count:
            if (mask & (u64(1) << bit_index)) != 0:
                degree <- degree + 1
            bit_index <- bit_index + 1
        edge_count <- edge_count + degree
        vertex <- vertex + 1
    vertex <- 0
    while vertex < count:
        other: mutable usize = vertex + 1
        while other < count:
            if ((neighbors[vertex] >> other) & u64(1)) != ((neighbors[other] >> vertex) & u64(1)):
                return -1
            other <- other + 1
        vertex <- vertex + 1

    chosen: mutable u64 = 0
    while edge_count > 0:
        best_vertex: mutable i64 = -1
        best_degree: mutable usize = 0
        vertex <- 0
        while vertex < count:
            degree: mutable usize = 0
            bit_index <- 0
            while bit_index < count:
                if (neighbors[vertex] & (u64(1) << bit_index)) != 0:
                    degree <- degree + 1
                bit_index <- bit_index + 1
            if degree > best_degree:
                best_vertex <- vertex.i64()
                best_degree <- degree
            vertex <- vertex + 1
        if best_vertex < 0:
            return -1
        bit: u64 = u64(1) << best_vertex.usize()
        chosen <- chosen | bit
        edge_count <- edge_count - 2 * best_degree
        vertex <- 0
        while vertex < count:
            neighbors[vertex] <- neighbors[vertex] & ~bit
            vertex <- vertex + 1
        neighbors[best_vertex.usize()] <- 0
    chosen.i64()

export fn greedy_min_vertex_cover(values: i64&, length: usize) -> i64 = greedy_min_vertex_cover_impl
