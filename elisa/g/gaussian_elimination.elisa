# Gaussian elimination for bounded, symmetric, strictly diagonally dominant systems.
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def put_f64_le(output: mutable u8&, offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    b: mutable usize = 0
    while b < 8:
        output[offset + b] <- (bits & 255).u8()
        bits <- bits >> 8
        b <- b + 1

def gaussian_elimination_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1: return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 8: return -1
    n: usize = n_value.usize()
    if length != 1 + n*n + n: return -1
    matrix: f64[8][9] = [[0.0; 9]; 8]
    row: mutable usize = 0
    while row < n:
        col: mutable usize = 0
        while col < n:
            value: i64 = input[1 + row*n + col]
            if row == col:
                if value != 32: return -1
            else:
                if value != 0 and value != -1: return -1
                if (row + 1 < col or col + 1 < row) and value != 0: return -1
                if value != input[1 + col*n + row]: return -1
            matrix[row][col] <- value.f64()
            col <- col + 1
        rhs: i64 = input[1 + n*n + row]
        if rhs < -100 or rhs > 100: return -1
        matrix[row][n] <- rhs.f64()
        row <- row + 1
    if output.is_null() or capacity < n*8: return -2
    step: mutable usize = 0
    while step + 1 < n:
        row <- step + 1
        while row < n:
            factor: f64 = matrix[row][step] / matrix[step][step]
            col <- step
            while col <= n:
                matrix[row][col] <- matrix[row][col] - factor * matrix[step][col]
                col <- col + 1
            row <- row + 1
        step <- step + 1
    solution: f64[8] = [0.0; 8]
    row <- n
    while row > 0:
        row <- row - 1
        sum: mutable f64 = 0.0
        col: mutable usize = row + 1
        while col < n:
            sum <- sum + matrix[row][col] * solution[col]
            col <- col + 1
        solution[row] <- (matrix[row][n] - sum) / matrix[row][row]
    row <- 0
    while row < n:
        put_f64_le(output, row*8, solution[row])
        row <- row + 1
    (n*8).i64()

export fn gaussian_elimination(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = gaussian_elimination_impl
