# Divisor zeta transforms, pointwise products, and reverse Möbius inversion.
const MAX_N: usize = 128
const MAX_INPUT_LENGTH: usize = 1 + 2 * MAX_N + 1
const MODULUS: i64 = 998244353

def gcd_convolution_store_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    output[offset + 0] <- (value.u64() >> 0).u8()
    output[offset + 1] <- (value.u64() >> 8).u8()
    output[offset + 2] <- (value.u64() >> 16).u8()
    output[offset + 3] <- (value.u64() >> 24).u8()
    output[offset + 4] <- (value.u64() >> 32).u8()
    output[offset + 5] <- (value.u64() >> 40).u8()
    output[offset + 6] <- (value.u64() >> 48).u8()
    output[offset + 7] <- (value.u64() >> 56).u8()

def gcd_convolution_impl(input: i64&, input_length: usize,
                    output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or input_length < 1 or input_length > MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > MAX_N.i64():
        return -1
    n: usize = n_value.usize()
    if input_length != 1 + 2 * n:
        return -1
    for index in 0..<(2 * n):
        value: i64 = input[1 + index]
        if value.u64() >= MODULUS.u64():
            return -1
    output_bytes: usize = 8 * n
    if output == null or output_capacity < output_bytes:
        return -2

    # Retain the full result until all input reads are complete.
    coefficients: mutable u64[MAX_N + 1] = zeroed
    for divisor in 1..<(n + 1):
        left_sum: mutable u64 = 0
        right_sum: mutable u64 = 0
        multiple: mutable u32 = divisor.u32()
        while multiple <= n.u32():
            left_sum <- left_sum + input[multiple].u64()
            right_sum <- right_sum + input[n + multiple.usize()].u64()
            multiple <- multiple + divisor.u32()
        coefficients[divisor] <- ((left_sum % MODULUS.u64()) * (right_sum % MODULUS.u64())) % MODULUS.u64()

    # Every multiple is at most n, and n was checked against MAX_N.
    results: mutable u64& = &coefficients[0]
    divisor: mutable usize = n >> 1
    while divisor != 0:
        removed: mutable u64 = 0
        multiple: mutable u32 = 2 * divisor.u32()
        while multiple <= n.u32():
            removed <- removed + results[multiple]
            multiple <- multiple + divisor.u32()
        remainder: u64 = removed % MODULUS.u64()
        current: u64 = coefficients[divisor]
        coefficients[divisor] <- current + MODULUS.u64() - remainder if current < remainder else current - remainder
        divisor <- divisor - 1

    for index in 1..<(n + 1):
        gcd_convolution_store_i64(output, 8 * (index - 1), coefficients[index].i64())
    output_bytes.i64()

export fn gcd_convolution(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64 = gcd_convolution_impl
