const GBBS_CLIQUE_MAX_N: usize = 24
const GBBS_CLIQUE_MAX_M: usize = 64
const GBBS_CLIQUE_MAX_INPUT: usize = 130

def gbbs_clique_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

// Clean-room GBBS fixed-k clique profile; see package LICENSE.txt.
def gbbs_k_clique_count(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("gbbs_k_clique_count"):
    if input.is_null() or length < 2 or length > GBBS_CLIQUE_MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 24 or m64 < 0 or m64 > 64: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    adjacent: mutable bool[576] = zeroed
    degree: mutable usize[24] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * 24 + v]: return -1
        adjacent[u * 24 + v] <- true
        adjacent[v * 24 + u] <- true
        degree[u] <- degree[u] + 1
        degree[v] <- degree[v] + 1
        edge <- edge + 1
    if output.is_null() or capacity < 8: return -2

    directed: mutable bool[576] = zeroed
    u: mutable usize = 0
    while u < n:
        if degree[u] >= 3:
            v: mutable usize = u + 1
            while v < n:
                if degree[v] >= 3 and adjacent[u * 24 + v]: directed[u * 24 + v] <- true
                v <- v + 1
        u <- u + 1
    count: mutable i64 = 0
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a + 1
        while b < n:
            if directed[a * 24 + b]:
                c: mutable usize = b + 1
                while c < n:
                    if directed[a * 24 + c] and directed[b * 24 + c]:
                        d: mutable usize = c + 1
                        while d < n:
                            if directed[a * 24 + d] and directed[b * 24 + d] and directed[c * 24 + d]:
                                count <- count + 1
                            d <- d + 1
                    c <- c + 1
            b <- b + 1
        a <- a + 1
    gbbs_clique_store_i64_le(count, output[0:8], 0)
    return 8
