extern trunc(value: f64) -> f64
const MAX_INPUT: usize = 68

def graphai_sage_aggregation_impl(input: f64&, length: usize,
                                  output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > MAX_INPUT: return -1
    n_value: f64 = input[0]
    m_value: f64 = input[1]
    d_value: f64 = input[2]
    if n_value != n_value or m_value != m_value or d_value != d_value: return -1
    if trunc(n_value) != n_value or trunc(m_value) != m_value or trunc(d_value) != d_value: return -1
    if n_value < 1.0 or n_value > 8.0 or m_value < 0.0 or m_value > 24.0 or d_value < 1.0 or d_value > 4.0: return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    d: usize = d_value.usize()
    if length != 4 + n + m + n*d: return -1
    rowptr_at: usize = 3
    colind_at: usize = rowptr_at + n + 1
    feature_at: usize = colind_at + m
    if input[rowptr_at] != 0.0 or input[colind_at - 1] != m.f64(): return -1
    rowptr: mutable usize[9] = zeroed
    colind: mutable usize[24] = zeroed
    for i in 0..=n:
        value: f64 = input[rowptr_at + i]
        if trunc(value) != value or value < 0.0 or value > m.f64(): return -1
        rowptr[i] <- value.usize()
        if i > 0 and rowptr[i] < rowptr[i-1]: return -1
    for e in 0..<m:
        value: f64 = input[colind_at + e]
        if trunc(value) != value or value < 0.0 or value >= n.f64(): return -1
        colind[e] <- value.usize()
    for q in 0..<(n*d):
        value: f64 = input[feature_at + q]
        if value != value or value < -8.0 or value > 8.0: return -1
    required: usize = n*d
    if output.is_null() or capacity < required: return -2
    staged: mutable f64[32] = zeroed
    for src in 0..<n:
        degree: usize = rowptr[src+1] - rowptr[src]
        if degree > 0:
            scale: f64 = 1.0 / degree.f64()
            for e in rowptr[src]..<rowptr[src+1]:
                dst: usize = colind[e]
                for k in 0..<d:
                    staged[src*d+k] <- staged[src*d+k] + scale * input[feature_at+dst*d+k]
    for q in 0..<required: output[q] <- staged[q]
    required.i64()

export fn graphai_sage_aggregation(input: f64&, length: usize,
                                   output: mutable f64&, capacity: usize) -> i64 = graphai_sage_aggregation_impl
