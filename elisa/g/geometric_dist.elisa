extern pow(base: f64, exponent: f64) -> f64
extern sqrt(value: f64) -> f64
extern log(value: f64) -> f64

def pow_f32(base: f32, exponent: f32) -> f32:
    pow(base.f64(), exponent.f64()).f32()

def log_f32(value: f32) -> f32:
    log(value.f64()).f32()

def geometric_cdf(p: f32, k: i64) -> f32:
    power: f32 = pow_f32(1.0.f32() - p, k.f32())
    1.0.f32() - power

def geometric_dist_impl(values: i64&, length: usize) -> f64:
    if length < 2:
        return -1.0e300
    operation: i64 = values[0]
    p_code: i64 = values[1]
    if p_code < 0 or p_code > 2:
        return -1.0e300
    p: f32 = if p_code == 0: 0.25.f32() else: if p_code == 1: 0.5.f32() else: 0.75.f32()
    if operation >= 0 and operation <= 2:
        if length != 2:
            return -1.0e300
        if operation == 0:
            return (1.0.f32() / p).f64()
        variance: f32 = (1.0.f32() - p) / (p * p)
        if operation == 1:
            return variance.f64()
        return sqrt(variance.f64()).f32().f64()
    if operation == 3 or operation == 4:
        if length != 3:
            return -1.0e300
        k: i64 = values[2]
        if operation == 3 and (k < 1 or k > 16):
            return -1.0e300
        if operation == 4 and (k < 0 or k > 16):
            return -1.0e300
        if operation == 3:
            return (pow_f32(1.0.f32() - p, (k - 1).f32()) * p).f64()
        return geometric_cdf(p, k).f64()
    if operation == 5:
        if length != 3 or values[2] < 0 or values[2] > 2:
            return -1.0e300
        cdf: f32 = if values[2] == 0: 0.25.f32() else: if values[2] == 1: 0.5.f32() else: 0.75.f32()
        numerator: f32 = log_f32(1.0.f32() - cdf)
        denominator: f32 = log_f32(1.0.f32() - p)
        return (numerator / denominator).f64()
    if operation == 6:
        if length != 4:
            return -1.0e300
        minimum: i64 = values[2]
        maximum: i64 = values[3]
        if minimum < 1 or maximum < minimum or maximum > 16:
            return -1.0e300
        lower: f32 = geometric_cdf(p, minimum - 1)
        upper: f32 = geometric_cdf(p, maximum)
        return (upper - lower).f64()
    -1.0e300

export fn geometric_dist(values: i64&, length: usize) -> f64 = geometric_dist_impl
