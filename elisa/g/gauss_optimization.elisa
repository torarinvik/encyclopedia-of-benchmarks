def gauss_optimization_objective(x1: f64, x2: f64, target1: f64, target2: f64) -> f64:
    dx: f64 = x1 - target1
    dy: f64 = x2 - target2
    -(dx * dx + dy * dy)

def gauss_optimization_abs(value: f64) -> f64:
    if value < 0.0:
        return -value
    value

def gauss_optimization_impl(values: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if values == null or length != 7: return -1
    index: mutable usize = 0
    while index < length:
        value: f64 = values[index]
        if value != value or value > 1.0e100 or value < -1.0e100: return -1
        index <- index + 1
    if values[0] != 2.0 and values[0] != 3.0 and values[0] != 4.0: return -1
    if values[1] < 0.25 or values[1] > 4.0 or values[2] < 1.0e-6 or values[2] > 2.0: return -1
    index <- 3
    while index < 7:
        if values[index] < -8.0 or values[index] > 8.0: return -1
        index <- index + 1
    if output == null or capacity < 2: return -2

    factor: f64 = values[0]
    step: mutable f64 = values[1]
    epsilon: f64 = values[2]
    x1: mutable f64 = values[3]
    x2: mutable f64 = values[4]
    target1: f64 = values[5]
    target2: f64 = values[6]
    state: mutable f64[5] = zeroed
    state[0] <- x1
    state[1] <- x2
    state[2] <- step
    state[3] <- 1.0
    state[4] <- 0.0
    state <- while gauss_optimization_abs(state[3]) > epsilon and state[4] < 256.0 |state: mutable f64[5] = state| -> state:
        sx1: f64 = state[0]
        sx2: f64 = state[1]
        ss: f64 = state[2]
        current: f64 = gauss_optimization_objective(sx1, sx2, target1, target2)
        bottom: f64 = gauss_optimization_objective(sx1, sx2 - ss, target1, target2)
        top: f64 = gauss_optimization_objective(sx1, sx2 + ss, target1, target2)
        left: f64 = gauss_optimization_objective(sx1 - ss, sx2, target1, target2)
        right: f64 = gauss_optimization_objective(sx1 + ss, sx2, target1, target2)
        best: mutable f64 = bottom
        choice: mutable usize = 0
        if top > best:
            best <- top
            choice <- 1
        if left > best:
            best <- left
            choice <- 2
        if right > best:
            best <- right
            choice <- 3
        if choice == 0:
            state[1] <- sx2 - ss
        elif choice == 1:
            state[1] <- sx2 + ss
        elif choice == 2:
            state[0] <- sx1 - ss
        else:
            state[0] <- sx1 + ss
        state[2] <- ss / factor
        state[3] <- best - current
        state[4] <- state[4] + 1.0
    if gauss_optimization_abs(state[3]) > epsilon: return -1
    output[0] <- state[0]
    output[1] <- state[1]
    2

export fn gauss_optimization(values: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = gauss_optimization_impl
