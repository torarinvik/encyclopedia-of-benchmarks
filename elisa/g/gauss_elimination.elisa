extern nearbyint(value: f64) -> f64

def put_f64_le(output: mutable view[u8], offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    b: mutable usize = 0
    while b < 8:
        output[offset+b] <- (bits & 255).u8()
        bits <- bits >> 8
        b <- b + 1

extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def gauss_elimination_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or input[0] < 2 or input[0] > 8: return -1
    n: usize = input[0].usize()
    if length != 1+n*n+n: return -1
    i: usize = 1
    while i < length:
        if input[i] < -100 or input[i] > 100: return -1
        i <- i+1
    m: mutable f32[72] = zeroed
    row: usize = 0
    while row < n:
        col: usize = 0
        while col < n:
            m[row*9+col] <- input[1+row*n+col].f32()
            col <- col+1
        m[row*9+n] <- input[1+n*n+row].f32()
        row <- row+1
    i <- 0
    while i+1 < n:
        pivot: mutable usize = i
        row <- i
        while row < n:
            if abs(m[row*9+i]) > abs(m[pivot*9+i]): pivot <- row
            row <- row+1
        if m[pivot*9+i] == 0.0: return -1
        if pivot != i:
            col <- 0
            while col <= n:
                temp: f32 = m[i*9+col]
                m[i*9+col] <- m[pivot*9+col]
                m[pivot*9+col] <- temp
                col <- col+1
        row <- i
        row <- i+1
        while row < n:
            tmp: f32 = -(m[row*9+i]/m[i*9+i])
            col <- 0
            while col <= n:
                m[row*9+col] <- m[row*9+col]+m[i*9+col]*tmp
                col <- col+1
            row <- row+1
        i <- i+1
    if m[(n-1)*9+n-1] == 0.0: return -1
    if output.is_null() or capacity < n*8: return -2
    ans: mutable f32[8] = zeroed
    row <- n
    while row > 0:
        row <- row-1
        mul: mutable f32 = 0.0
        col: usize = n
        while col > row+1:
            col <- col-1
            mul <- mul+m[row*9+col]*ans[col]
        ans[row] <- (m[row*9+n]-mul)/m[row*9+row]
    row <- 0
    while row < n:
        put_f64_le(output[0:n*8], row*8, nearbyint(ans[row].f64()*100.0)/100.0)
        row <- row+1
    (n*8).i64()

export fn gauss_elimination(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = gauss_elimination_impl
