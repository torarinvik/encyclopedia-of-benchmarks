extern sqrt(value: f64) -> f64
const G: f64 = 6.67430e-11

def gravitational_force_impl(v: f64&, n: usize, output: mutable f64&, capacity: usize) -> i64:
    if v == null or n != 6: return -1
    for index in 0..<6:
        value: f64 = v[index]
        if value != value or value > 1.0e100 or value < -1.0e100: return -1
    m1: f64 = v[0]
    x1: f64 = v[1]
    y1: f64 = v[2]
    m2: f64 = v[3]
    x2: f64 = v[4]
    y2: f64 = v[5]
    if m1 > 1.0e12 or m1 < -1.0e12 or m2 > 1.0e12 or m2 < -1.0e12: return -1
    if m1 != 0.0 and m1 > -1.0e-12 and m1 < 1.0e-12: return -1
    if m2 != 0.0 and m2 > -1.0e-12 and m2 < 1.0e-12: return -1
    if x1 > 1.0e6 or x1 < -1.0e6 or y1 > 1.0e6 or y1 < -1.0e6 or x2 > 1.0e6 or x2 < -1.0e6 or y2 > 1.0e6 or y2 < -1.0e6: return -1
    dx: f64 = x1 - x2
    dy: f64 = y1 - y2
    distance_squared: f64 = dx * dx + dy * dy
    if distance_squared != 0.0 and distance_squared < 1.0e-12: return -1
    if output == null or capacity < 2: return -2
    if distance_squared == 0.0:
        output[0] <- 0.0
        output[1] <- 0.0
        return 2
    distance: f64 = sqrt(distance_squared)
    magnitude: f64 = G * m1 * m2 / distance_squared
    output[0] <- magnitude * (dx / distance)
    output[1] <- magnitude * (dy / distance)
    2

export fn gravitational_force(v: f64&, n: usize, output: mutable f64&, capacity: usize) -> i64 = gravitational_force_impl
