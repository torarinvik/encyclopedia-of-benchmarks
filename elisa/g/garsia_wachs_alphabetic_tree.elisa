const MAX_N: usize = 64
const MAX_NODE: usize = 2 * MAX_N - 1
const MAX_INPUT: usize = MAX_N + 2
const MAX_WEIGHT: i64 = 1000000
const GW_INFINITY: i64 = 4611686018427387904

def garsia_wachs_put_i64(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def garsia_wachs_alphabetic_tree(input: i64&, input_length: usize,
    output: mutable u8&, capacity: usize) -> i64 @export("garsia_wachs_alphabetic_tree"):
    if input.is_null() or input_length < 2 or input_length > MAX_INPUT: return -1
    n64: i64 = input[0]
    if n64 < 1 or n64 > MAX_N.i64(): return -1
    n: usize = n64.usize()
    if input_length != n + 1: return -1
    node_weight: mutable i64[MAX_NODE] = zeroed
    left: mutable usize[MAX_NODE] = zeroed
    right: mutable usize[MAX_NODE] = zeroed
    active: mutable usize[MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        if input[i + 1] < 0 or input[i + 1] > MAX_WEIGHT: return -1
        node_weight[i] <- input[i + 1]
        active[i] <- i
        i <- i + 1
    active_count: mutable usize = n
    next_node: mutable usize = n
    while active_count > 1:
        pair: mutable usize = 0
        while pair + 1 < active_count:
            following: i64 = GW_INFINITY
            if pair + 2 < active_count: following <- node_weight[active[pair + 2]]
            if node_weight[active[pair]] <= following: break
            pair <- pair + 1
        if pair + 1 >= active_count: return -1
        first: usize = active[pair]
        second: usize = active[pair + 1]
        combined: i64 = node_weight[first] + node_weight[second]
        node_weight[next_node] <- combined
        left[next_node] <- first
        right[next_node] <- second
        earlier: mutable usize = pair
        while earlier > 0 and node_weight[active[earlier - 1]] < combined:
            earlier <- earlier - 1
        insert_at: usize = earlier
        i <- pair
        while i + 2 < active_count:
            active[i] <- active[i + 2]
            i <- i + 1
        active_count <- active_count - 2
        i <- active_count
        while i > insert_at:
            active[i] <- active[i - 1]
            i <- i - 1
        active[insert_at] <- next_node
        active_count <- active_count + 1
        next_node <- next_node + 1

    depths: mutable usize[MAX_N] = zeroed
    stack_node: mutable usize[2 * MAX_N] = zeroed
    stack_depth: mutable usize[2 * MAX_N] = zeroed
    top: mutable usize = 1
    stack_node[0] <- active[0]
    while top > 0:
        top <- top - 1
        node: usize = stack_node[top]
        depth: usize = stack_depth[top]
        if node < n:
            depths[node] <- depth
        else:
            stack_node[top] <- right[node]
            stack_depth[top] <- depth + 1
            top <- top + 1
            stack_node[top] <- left[node]
            stack_depth[top] <- depth + 1
            top <- top + 1

    ordered_left: mutable usize[MAX_NODE] = zeroed
    ordered_right: mutable usize[MAX_NODE] = zeroed
    code_node: mutable usize[2 * MAX_N] = zeroed
    code_depth: mutable usize[2 * MAX_N] = zeroed
    code_top: mutable usize = 0
    next_ordered: mutable usize = n
    leaf: mutable usize = 0
    while leaf < n:
        code_node[code_top] <- leaf
        code_depth[code_top] <- depths[leaf]
        code_top <- code_top + 1
        while code_top >= 2 and code_depth[code_top - 1] == code_depth[code_top - 2]:
            level: usize = code_depth[code_top - 1]
            if level == 0 or next_ordered >= 2 * n - 1: return -1
            ordered_left[next_ordered] <- code_node[code_top - 2]
            ordered_right[next_ordered] <- code_node[code_top - 1]
            code_top <- code_top - 2
            code_node[code_top] <- next_ordered
            code_depth[code_top] <- level - 1
            code_top <- code_top + 1
            next_ordered <- next_ordered + 1
        leaf <- leaf + 1
    if code_top != 1 or code_depth[0] != 0 or next_ordered != 2 * n - 1: return -1

    cost: mutable i64 = 0
    i <- 0
    while i < n:
        cost <- cost + input[i + 1] * depths[i].i64()
        i <- i + 1
    output_bytes: usize = 8 * (n + 1)
    if output.is_null() or capacity < output_bytes: return -2
    garsia_wachs_put_i64(cost, output[0:output_bytes], 0)
    i <- 0
    while i < n:
        garsia_wachs_put_i64(depths[i].i64(), output[0:output_bytes], 8 * (i + 1))
        i <- i + 1
    output_bytes.i64()
