# Clean-room bounded GBBS MPX low-diameter decomposition profile.
const GBBS_LDD_N: usize = 12
const GBBS_LDD_M: usize = 24
const GBBS_LDD_INPUT: usize = 50
const GBBS_LDD_ROUNDS: usize = 13
const GBBS_LDD_BATCH: usize[13] = [1, 1, 1, 1, 2, 2, 3, 4, 4, 6, 7, 9, 11]

def gbbs_low_diameter_decomposition_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > GBBS_LDD_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > GBBS_LDD_N.i64() or m64 < 0 or m64 > GBBS_LDD_M.i64(): return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    adjacent: mutable bool[144] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or u64 >= n64 or v64 <= u64 or v64 >= n64: return -1
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * GBBS_LDD_N + v]: return -1
        adjacent[u * GBBS_LDD_N + v] <- true
        adjacent[v * GBBS_LDD_N + u] <- true
        edge <- edge + 1
    if output.is_null() or capacity < n: return -2

    label: mutable i64[12] = zeroed
    vertex: mutable usize = 0
    while vertex < n:
        label[vertex] <- -1
        vertex <- vertex + 1
    frontier: mutable usize[12] = zeroed
    frontier_count: mutable usize = 0
    cursor: mutable usize = 0
    assigned: mutable usize = 0
    round_index: mutable usize = 0
    while assigned < n:
        end: mutable usize = cursor + GBBS_LDD_BATCH[round_index]
        if end > n: end <- n
        candidate: mutable usize = cursor
        while candidate < end:
            if label[candidate] < 0:
                label[candidate] <- candidate.i64()
                frontier[frontier_count] <- candidate
                frontier_count <- frontier_count + 1
                assigned <- assigned + 1
            candidate <- candidate + 1
        cursor <- end
        if assigned == n: break

        reached: mutable i64[12] = zeroed
        vertex <- 0
        while vertex < n:
            reached[vertex] <- -1
            vertex <- vertex + 1
        i: mutable usize = 0
        while i < frontier_count:
            vertex <- frontier[i]
            neighbor: mutable usize = 0
            while neighbor < n:
                if adjacent[vertex * GBBS_LDD_N + neighbor] and label[neighbor] < 0 and
                    (reached[neighbor] < 0 or label[vertex] < reached[neighbor]):
                    reached[neighbor] <- label[vertex]
                neighbor <- neighbor + 1
            i <- i + 1
        frontier_count <- 0
        vertex <- 0
        while vertex < n:
            if reached[vertex] >= 0:
                label[vertex] <- reached[vertex]
                frontier[frontier_count] <- vertex
                frontier_count <- frontier_count + 1
                assigned <- assigned + 1
            vertex <- vertex + 1
        round_index <- round_index + 1

    vertex <- 0
    while vertex < n:
        output[vertex] <- label[vertex].u8()
        vertex <- vertex + 1
    n.i64()

export fn gbbs_low_diameter_decomposition(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 @export("gbbs_low_diameter_decomposition") =
    gbbs_low_diameter_decomposition_impl
