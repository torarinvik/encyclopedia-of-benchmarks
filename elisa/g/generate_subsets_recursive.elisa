const GENERATE_SUBSETS_RECURSIVE_MAX_ITEMS: usize = 12

def generate_subsets_recursive_put32(output: mutable u8&, position: mutable usize&, value: u32) -> void:
    bits: mutable u32 = value
    index: mutable usize = 0
    while index < 4:
        output[position] <- (bits & 255).u8()
        position <- position + 1
        bits <- bits >> 8
        index <- index + 1

def generate_subsets_recursive_emit(input: i64&, n: usize, index: usize, mask: usize,
                                    selected: u32, output: mutable u8&, position: mutable usize&) -> void:
    if index == n:
        generate_subsets_recursive_put32(output, position&, selected)
        item: mutable usize = 0
        while item < n:
            if (mask & (1.usize() << item)) != 0:
                output[position] <- input[item + 1].u8()
                position <- position + 1
            item <- item + 1
        return
    generate_subsets_recursive_emit(input, n, index + 1, mask | (1.usize() << index), selected + 1, output, position&)
    generate_subsets_recursive_emit(input, n, index + 1, mask, selected, output, position&)

def generate_subsets_recursive_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > GENERATE_SUBSETS_RECURSIVE_MAX_ITEMS + 1: return -1
    n_arg: i64 = input[0]
    if n_arg < 0 or n_arg > 12: return -1
    n: usize = n_arg.usize()
    if length != n + 1: return -1
    item: mutable usize = 0
    while item < n:
        if input[item + 1] < 0 or input[item + 1] > 127: return -1
        item <- item + 1
    subsets: usize = 1.usize() << n
    needed: usize = 4 + 4 * subsets + n * (subsets / 2)
    if output == null or capacity < needed: return -2
    position: mutable usize = 0
    generate_subsets_recursive_put32(output, position&, subsets.u32())
    generate_subsets_recursive_emit(input, n, 0, 0, 0, output, position&)
    position.i64()

export fn generate_subsets_recursive(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = generate_subsets_recursive_impl
