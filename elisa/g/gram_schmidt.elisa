extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&
def put_f64(output: mutable u8&, offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    for i in 0..8:
        output[offset+i] <- (bits & 255).u8()
        bits <- bits >> 8
def gram_schmidt_impl(v: i64&, length: usize, out: mutable u8&, capacity: usize) -> i64:
    if v.is_null() or length < 2 or length > 18: return -1
    rows: i64 = v[0]
    dimension: i64 = v[1]
    if rows < 1 or rows > 4 or dimension < rows or dimension > 4 or length != (2+rows*dimension).usize(): return -1
    a: mutable f64[16]
    q: mutable f64[16]
    for i in 0..rows:
        for j in 0..dimension:
            value: i64 = v[2+i*dimension+j]
            if value < -1000 or value > 1000 or (j < i and value != 0) or (j == i and (value < 100 or value > 1000)): return -1
            a[i*dimension+j] <- value.f64()/1000.0
    bytes: usize = (rows*dimension*8).usize()
    if out.is_null() or capacity < bytes: return -2
    for k in 0..rows:
        projections: mutable f64[4]
        for i in 0..k:
            dot: mutable f64 = 0.0
            norm: mutable f64 = 0.0
            for j in 0..dimension:
                dot <- dot+a[k*dimension+j]*q[i*dimension+j]
                norm <- norm+q[i*dimension+j]*q[i*dimension+j]
            factor: f64 = dot/norm
            for j in 0..dimension: projections[j] <- projections[j]+q[i*dimension+j]*factor
        for j in 0..dimension: q[k*dimension+j] <- a[k*dimension+j]-projections[j]
    for i in 0..rows:
        for j in 0..dimension: put_f64(out, (i*dimension+j).usize()*8, q[i*dimension+j])
    bytes.i64()
export gram_schmidt(v: i64&, length: usize, out: mutable u8&, capacity: usize) -> i64 = gram_schmidt_impl
