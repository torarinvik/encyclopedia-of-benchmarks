const MAX_N: usize = 16
const MAX_M: usize = 64
const MAX_INPUT: usize = 132
const INVALID_RESULT: f64 = -1.0e300

def gbbs_bkv12_densest_subgraph(input: i64&, length: usize) -> f64:
    if input.is_null() or length < 2 or length > MAX_INPUT: return INVALID_RESULT
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 64 or length != 2 + 2 * m64.usize(): return INVALID_RESULT
    n: usize = n64.usize()
    m: usize = m64.usize()
    adjacent: mutable u8[MAX_N * MAX_N] = zeroed
    degree: mutable i64[MAX_N] = zeroed
    edge_u: mutable usize[MAX_M] = zeroed
    edge_v: mutable usize[MAX_M] = zeroed
    edge: usize = 0
    while edge < m:
        u64: i64 = input[2 + 2 * edge]
        v64: i64 = input[3 + 2 * edge]
        if u64 < 0 or u64 >= v64 or v64 >= n64: return INVALID_RESULT
        u: usize = u64.usize()
        v: usize = v64.usize()
        if adjacent[u * MAX_N + v] != 0: return INVALID_RESULT
        adjacent[u * MAX_N + v] <- 1
        adjacent[v * MAX_N + u] <- 1
        degree[u] <- degree[u] + 1
        degree[v] <- degree[v] + 1
        edge_u[edge] <- u
        edge_v[edge] <- v
        edge <- edge + 1
    alive: mutable bool[MAX_N] = zeroed
    vertex: usize = 0
    while vertex < n:
        alive[vertex] <- true
        vertex <- vertex + 1
    remaining: mutable usize = n
    best: mutable f64 = 0.0
    while remaining > 0:
        total: mutable i64 = 0
        vertex <- 0
        while vertex < n:
            if alive[vertex]: total <- total + degree[vertex]
            vertex <- vertex + 1
        density: f64 = total.f64() / remaining.f64()
        if density > best: best <- density
        removed: mutable bool[MAX_N] = zeroed
        count: mutable usize = 0
        vertex <- 0
        while vertex < n:
            if alive[vertex] and 1000 * degree[vertex] * remaining.i64() <= 1001 * total:
                removed[vertex] <- true
                count <- count + 1
            vertex <- vertex + 1
        if count == 0: return INVALID_RESULT
        vertex <- 0
        while vertex < n:
            if removed[vertex]: alive[vertex] <- false
            vertex <- vertex + 1
        remaining <- remaining - count
        edge <- 0
        while edge < m:
            u: usize = edge_u[edge]
            v: usize = edge_v[edge]
            if removed[u] and alive[v]: degree[v] <- degree[v] - 1
            if removed[v] and alive[u]: degree[u] <- degree[u] - 1
            edge <- edge + 1
    best

export fn gbbs_bkv12_densest_subgraph(input: i64&, length: usize) -> f64
    @export("gbbs_bkv12_densest_subgraph") = gbbs_bkv12_densest_subgraph
