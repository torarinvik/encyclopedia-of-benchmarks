const MAX_TEXT: usize = 128
const MAX_PATTERN: usize = 32
const MAX_INPUT: usize = 162
const K: usize = 4

def galil_seiferas_search_impl(values: view[i64], length: usize) -> i64:
    if length < 2 or length > MAX_INPUT: return -2
    let raw_n, raw_m = values[0], values[1]
    if raw_n < 0 or raw_n > MAX_TEXT.i64() or raw_m < 1 or raw_m > MAX_PATTERN.i64(): return -2
    let n, m = raw_n.usize(), raw_m.usize()
    if length != 2 + n + m: return -2
    for i in 0..<(n + m):
        if values[2 + i] < 0 or values[2 + i] > 15: return -2
    if m > n: return 0
    let text: view[i64] = values[2..<(2 + n)]
    let pattern: view[i64] = values[(2 + n)..<(2 + n + m)]

    var s: usize = 0
    var p1: usize = 1
    var q1: usize = 0
    var factorized = false
    while true:
        while s + p1 + q1 < m and pattern[s + q1] == pattern[s + p1 + q1]: q1 += 1
        if p1 + q1 >= K * p1:
            var p2: usize = q1
            var q2: usize = 0
            while true:
                while p2 + q2 < K * p2 and s + p2 + q2 < m and pattern[s + q2] == pattern[s + p2 + q2]:
                    q2 += 1
                if p2 + q2 == K * p2:
                    while true:
                        while s + p1 + q1 < m and pattern[s + q1] == pattern[s + p1 + q1]: q1 += 1
                        while p1 + q1 >= K * p1:
                            s += p1
                            q1 -= p1
                        if s + p1 + q1 == m: break
                        p1 += q1 / K + 1
                        q1 = 0
                        if p1 >= p2: break
                    break
                if s + p2 + q2 == m:
                    factorized = true
                    break
                if q2 == p1 + q1:
                    p2 += p1
                    q2 -= p1
                else:
                    p2 += q2 / K + 1
                    q2 = 0
            if factorized or s + p1 + q1 == m: break
        else:
            if s + p1 + q1 == m: break
            p1 += q1 / K + 1
            q1 = 0

    var p: usize = 0
    var q: usize = 0
    var matches: i64 = 0
    while p <= n - m:
        while s + q < m and pattern[s + q] == text[p + s + q]: q += 1
        if q == m - s:
            var i: usize = 0
            while i < s and pattern[i] == text[p + i]: i += 1
            if i == s: matches += 1
        if q == p1 + q1:
            p += p1
            q -= p1
        else:
            p += q / K + 1
            q = 0
    matches

export fn galil_seiferas_search(values: i64&, length: usize) -> i64:
    if values.is_null(): return -2
    galil_seiferas_search_impl(values[0:length], length)
