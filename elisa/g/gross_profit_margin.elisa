# Cross-platform scalar implementation of gross_profit_margin.
const INVALID_RESULT: f64 = -1.0e300

export fn gross_profit_margin(input: i64&, length: usize) -> f64:
    if input.is_null() or length != 2:
        return INVALID_RESULT
    revenue: i64 = input[0]
    cost: i64 = input[1]
    if revenue < 1 or revenue > 1000000 or cost < 0 or cost > 1000000:
        return INVALID_RESULT
    return (revenue.f64() - cost.f64()) / revenue.f64()
