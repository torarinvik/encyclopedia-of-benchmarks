# Return the greatest absolute coordinate difference from packed points.
def chebyshev_distance_impl(values: i64&, length: usize) -> i64:
    if length < 3:
        return -1
    dimension_value: i64 = values[0]
    if dimension_value < 1 or dimension_value > 128:
        return -1
    dimension: usize = dimension_value.usize()
    if length != 1 + 2 * dimension:
        return -1
    result: i64 =
        while i < dimension |i: mutable usize = 0, maximum: mutable i64 = 0| -> maximum:
            a: i64 = values[1 + i]
            b: i64 = values[1 + dimension + i]
            if a < -1000000000 or a > 1000000000 or b < -1000000000 or b > 1000000000:
                return -1
            difference: mutable i64 = a - b
            if difference < 0:
                difference <- -difference
            if difference > maximum:
                maximum <- difference
            i <- i + 1
    result

export fn chebyshev_distance(values: i64&, length: usize) -> i64 = chebyshev_distance_impl
