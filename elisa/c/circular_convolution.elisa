def circular_convolution_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if values == null or length < 4:
        return -1
    raw_a_length: i64 = values[0]
    raw_b_length: i64 = values[1]
    if raw_a_length < 1 or raw_a_length > 8 or raw_b_length < 1 or raw_b_length > 8:
        return -1
    a_length: usize = raw_a_length.usize()
    b_length: usize = raw_b_length.usize()
    if length != 2 + a_length + b_length:
        return -1
    index: mutable usize = 0
    while index < a_length + b_length:
        sample: i64 = values[2 + index]
        if sample < -2 or sample > 2:
            return -1
        index <- index + 1
    n: usize = a_length if a_length > b_length else b_length
    if output == null or output_capacity < n:
        return -2

    coefficients: mutable u32[16] = zeroed
    first: i64& = &values[2]
    second: i64& = &values[2 + a_length]
    # First form the linear convolution, then fold the tail into the prefix.
    for left_index in 0..<a_length:
        left: u32 = first[left_index].u32()
        for right_index in 0..<b_length:
            position: usize = left_index + right_index
            coefficients[position] <- coefficients[position] + left * second[right_index].u32()
    for position in 0..<n:
        output[position] <- (coefficients[position] + coefficients[position + n]).u8()
    n.i64()

export fn circular_convolution(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = circular_convolution_impl
