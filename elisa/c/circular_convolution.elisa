def circular_convolution_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 4:
        return -1
    raw_a_length: i64 = values[0]
    raw_b_length: i64 = values[1]
    if raw_a_length < 1 or raw_a_length > 8 or raw_b_length < 1 or raw_b_length > 8:
        return -1
    a_length: usize = raw_a_length.usize()
    b_length: usize = raw_b_length.usize()
    if length != 2 + a_length + b_length:
        return -1
    index: usize = 0
    while index < a_length + b_length:
        sample: i64 = values[2 + index]
        if sample < -2 or sample > 2:
            return -1
        index <- index + 1
    n: usize = if a_length > b_length: a_length else: b_length
    if output_capacity < n:
        return -2

    k: usize = 0
    while k < n:
        sum: mutable i64 = 0
        i: usize = 0
        while i < n:
            b_index: usize = (k + n - i) % n
            a_value: i64 = if i < a_length: values[2 + i] else: 0
            b_value: i64 = if b_index < b_length: values[2 + a_length + b_index] else: 0
            sum <- sum + a_value * b_value
            i <- i + 1
        encoded: i64 = if sum < 0: sum + 256 else: sum
        output[k] <- encoded.u8()
        k <- k + 1
    n.i64()

export fn circular_convolution(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = circular_convolution_impl
