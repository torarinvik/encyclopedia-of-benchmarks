def circular_convolution_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if values == null or length < 4:
        return -1
    raw_a_length: i64 = values[0]
    raw_b_length: i64 = values[1]
    if raw_a_length < 1 or raw_a_length > 8 or raw_b_length < 1 or raw_b_length > 8:
        return -1
    a_length: usize = raw_a_length.usize()
    b_length: usize = raw_b_length.usize()
    if length != 2 + a_length + b_length:
        return -1
    # The output stores coefficients modulo 256, so byte arithmetic preserves each result.
    if a_length == 1 and b_length == 1:
        left: i64 = values[2]
        right: i64 = values[3]
        if left < -2 or left > 2 or right < -2 or right > 2:
            return -1
        if output == null or output_capacity == 0:
            return -2
        output[0] <- left.u8() * right.u8()
        return 1
    index: mutable usize = 2
    while index + 3 < length:
        sample_a: i64 = values[index]
        sample_b: i64 = values[index + 1]
        sample_c: i64 = values[index + 2]
        sample_d: i64 = values[index + 3]
        if sample_a < -2 or sample_a > 2 or sample_b < -2 or sample_b > 2 or sample_c < -2 or sample_c > 2 or sample_d < -2 or sample_d > 2:
            return -1
        index <- index + 4
    while index + 1 < length:
        first_sample: i64 = values[index]
        second_sample: i64 = values[index + 1]
        if first_sample < -2 or first_sample > 2 or second_sample < -2 or second_sample > 2:
            return -1
        index <- index + 2
    if index < length:
        last_sample: i64 = values[index]
        if last_sample < -2 or last_sample > 2:
            return -1
    n: usize = a_length if a_length > b_length else b_length
    if output == null or output_capacity < n:
        return -2

    coefficients: mutable u8[16] = zeroed
    results: mutable u8& = &coefficients[0]
    first: i64& = &values[2]
    second: i64& = &values[2 + a_length]
    # Zero padding makes each eight-lane multiply-add safe for all signal lengths.
    packed_second: mutable u8[8] = zeroed
    second_bytes: mutable u8& = &packed_second[0]
    for right_index in 0..<b_length:
        second_bytes[right_index] <- second[right_index].u8()
    # First form the linear convolution, then fold the tail into the prefix.
    for left_index in 0..<a_length:
        left: u8 = first[left_index].u8()
        for right_index in 0..<8:
            position: usize = left_index + right_index
            results[position] <- results[position] + left * second_bytes[right_index]
    for position in 0..<n:
        output[position] <- (results[position] + results[position + n]).u8()
    n.i64()

export fn circular_convolution(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = circular_convolution_impl
