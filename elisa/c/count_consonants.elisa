const MAX_LENGTH: usize = 4096

def count_consonants_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > MAX_LENGTH:
        return -1
    if length == 1 and values[0] == 48:
        return -1
    count: mutable i64 = 0
    index: mutable usize = 0
    while index < length:
        value: mutable i64 = values[index]
        if value < 32 or value > 126:
            return -1
        if value >= 65 and value <= 90:
            value <- value + 32
        if value >= 97 and value <= 122 and value != 97 and value != 101 and value != 105 and value != 111 and value != 117:
            count <- count + 1
        index <- index + 1
    count

export fn count_consonants(values: i64&, length: usize) -> i64 = count_consonants_impl
