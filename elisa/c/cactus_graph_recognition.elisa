# Iterative DFS cycle ownership for edge- and vertex-cactus recognition.
const CACTUS_MAX_N: usize = 32
const CACTUS_MAX_M: usize = 128
const CACTUS_MAX_INPUT: usize = 259
const CACTUS_MAX_ARCS: usize = 256

def cactus_graph_recognition_impl(input: view[i64], length: usize) -> i64:
    if length < 2 or length > CACTUS_MAX_INPUT: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 1 or n_value > 32 or m_value < 0 or m_value > 128: return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + 2 * m: return -1

    edge_seen: mutable bool[1024] = zeroed
    head: mutable usize[32] = zeroed
    u: mutable usize = 0
    while u < n:
        head[u] <- CACTUS_MAX_ARCS
        u <- u + 1
    arc_to: mutable usize[256]
    arc_edge: mutable usize[256]
    next_arc: mutable usize[256]
    arc_count: mutable usize = 0
    e: mutable usize = 0
    while e < m:
        u_value: i64 = input[2 + 2 * e]
        v_value: i64 = input[3 + 2 * e]
        if u_value < 0 or u_value >= n_value or v_value < 0 or v_value >= n_value or u_value == v_value: return -1
        u <- u_value.usize()
        v: usize = v_value.usize()
        if edge_seen[u * 32 + v]: return -1
        edge_seen[u * 32 + v] <- true
        edge_seen[v * 32 + u] <- true
        arc_to[arc_count] <- v
        arc_edge[arc_count] <- e
        next_arc[arc_count] <- head[u]
        head[u] <- arc_count
        arc_count <- arc_count + 1
        arc_to[arc_count] <- u
        arc_edge[arc_count] <- e
        next_arc[arc_count] <- head[v]
        head[v] <- arc_count
        arc_count <- arc_count + 1
        e <- e + 1

    state: mutable u8[32] = zeroed
    parent: mutable usize[32]
    parent_edge: mutable usize[32]
    depth: mutable usize[32] = zeroed
    cursor: mutable usize[32]
    stack: mutable usize[32]
    cycle_of: mutable usize[128]
    used: mutable bool[128] = zeroed
    cycle_vertices: mutable usize[32] = zeroed
    u <- 0
    while u < n:
        parent[u] <- CACTUS_MAX_ARCS
        parent_edge[u] <- CACTUS_MAX_ARCS
        cursor[u] <- CACTUS_MAX_ARCS
        u <- u + 1
    e <- 0
    while e < m:
        cycle_of[e] <- CACTUS_MAX_ARCS
        e <- e + 1

    cycles: mutable usize = 0
    edge_cactus: mutable bool = true
    vertex_cactus: mutable bool = true
    root: mutable usize = 0
    while root < n and edge_cactus:
        if state[root] != 0:
            root <- root + 1
            continue
        top: mutable usize = 1
        state[root] <- 1
        cursor[root] <- head[root]
        stack[0] <- root
        while top > 0 and edge_cactus:
            current: usize = stack[top - 1]
            arc: usize = cursor[current]
            if arc == CACTUS_MAX_ARCS:
                state[current] <- 2
                top <- top - 1
                continue
            cursor[current] <- next_arc[arc]
            edge: usize = arc_edge[arc]
            if used[edge]: continue
            used[edge] <- true
            neighbor: usize = arc_to[arc]
            if state[neighbor] == 0:
                parent[neighbor] <- current
                parent_edge[neighbor] <- edge
                depth[neighbor] <- depth[current] + 1
                state[neighbor] <- 1
                cursor[neighbor] <- head[neighbor]
                stack[top] <- neighbor
                top <- top + 1
            elif state[neighbor] == 1 and depth[neighbor] < depth[current]:
                x: mutable usize = current
                while x != neighbor:
                    tree_edge: usize = parent_edge[x]
                    if tree_edge == CACTUS_MAX_ARCS or cycle_of[tree_edge] != CACTUS_MAX_ARCS:
                        edge_cactus <- false
                        break
                    x <- parent[x]
                if not edge_cactus: break
                x <- current
                cycle_vertices[x] <- cycle_vertices[x] + 1
                if cycle_vertices[x] > 1: vertex_cactus <- false
                while x != neighbor:
                    tree_edge: usize = parent_edge[x]
                    cycle_of[tree_edge] <- cycles
                    x <- parent[x]
                    cycle_vertices[x] <- cycle_vertices[x] + 1
                    if cycle_vertices[x] > 1: vertex_cactus <- false
                cycle_of[edge] <- cycles
                cycles <- cycles + 1
        root <- root + 1
    if not edge_cactus: return 0
    (4 * cycles + (if vertex_cactus then 2 else 0) + 1).i64()

export fn cactus_graph_recognition(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > CACTUS_MAX_INPUT: return -1
    cactus_graph_recognition_impl(input[0:length], length)
