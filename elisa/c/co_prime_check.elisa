# Return whether two nonnegative int32 values have greatest common divisor one.
def co_prime_check_impl(first: u64, second: u64) -> i64:
    if first > 2147483647 or second > 2147483647:
        return -1
    left: mutable u64 = first
    right: mutable u64 = second
    while right != 0:
        remainder: u64 = left % right
        left <- right
        right <- remainder
    if left == 1:
        return 1
    return 0

export fn co_prime_check(first: u64, second: u64) -> i64 = co_prime_check_impl
