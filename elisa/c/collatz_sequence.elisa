def collatz_sequence_next_term(value: u64) -> u64:
    if value & 1 == 0:
        return value >> 1
    3 * value + 1

def collatz_sequence_store_i64_le(output: mutable u8&, offset_value: usize, value: u64) -> usize:
    bits: u64 = value
    output[offset_value + 0] <- (bits >> 0).u8()
    output[offset_value + 1] <- (bits >> 8).u8()
    output[offset_value + 2] <- (bits >> 16).u8()
    output[offset_value + 3] <- (bits >> 24).u8()
    output[offset_value + 4] <- (bits >> 32).u8()
    output[offset_value + 5] <- (bits >> 40).u8()
    output[offset_value + 6] <- (bits >> 48).u8()
    output[offset_value + 7] <- (bits >> 56).u8()
    offset_value + 8

def collatz_sequence_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length != 1 or input[0] < 1 or input[0] > 1000000:
        return -1
    start: u64 = input[0].u64()
    current: mutable u64 = start
    term_count: mutable usize = 1
    while current != 1:
        current <- collatz_sequence_next_term(current)
        term_count <- term_count + 1
    required: usize = term_count * 8
    if output_capacity < required or output == null:
        return -2
    # Capacity has been checked for every byte written by the loop.
    current <- start
    written: mutable usize = 0
    while true:
        written <- collatz_sequence_store_i64_le(output, written, current)
        if current == 1:
            break
        current <- collatz_sequence_next_term(current)
    written.i64()

export fn collatz_sequence(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = collatz_sequence_impl
