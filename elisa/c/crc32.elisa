const MAX_LENGTH: usize = 100001
const POLYNOMIAL: i64 = 3988292384
const INITIAL: i64 = 4294967295

def crc32_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    crc: mutable i64 = INITIAL
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < 0 or value > 255:
            return -1
        crc <- crc ^ value
        bit: mutable usize = 0
        while bit < 8:
            if (crc & 1) != 0:
                crc <- (crc >> 1) ^ POLYNOMIAL
            else:
                crc <- crc >> 1
            bit <- bit + 1
        index <- index + 1
    crc ^ INITIAL

export fn crc32(values: i64&, length: usize) -> i64 = crc32_impl
