const CBENCH_CONSUMER_TIFF2BW_MAX_PIXELS: i64 = 64
const CBENCH_CONSUMER_TIFF2BW_MAX_INPUT_LENGTH: usize = 193

def cbench_consumer_tiff2bw_impl(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 4 or input_length > CBENCH_CONSUMER_TIFF2BW_MAX_INPUT_LENGTH:
        return -1
    pixel_count_value: i64 = input[0]
    if pixel_count_value < 1 or pixel_count_value > CBENCH_CONSUMER_TIFF2BW_MAX_PIXELS:
        return -1
    pixel_count: usize = pixel_count_value.usize()
    if input_length != 1 + 3 * pixel_count:
        return -1
    for index in 1..<input_length:
        channel: i64 = input[index]
        if channel < 0 or channel > 255:
            return -1
    if output.is_null() or output_capacity < pixel_count:
        return -2

    for pixel in 0..<pixel_count:
        at: usize = 1 + 3 * pixel
        value: mutable i64 = 71 * input[at]
        value <- value + 150 * input[at + 1]
        value <- value + 28 * input[at + 2]
        output[pixel] <- (value >> 8).u8()
    pixel_count.i64()

export fn cbench_consumer_tiff2bw(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = cbench_consumer_tiff2bw_impl
