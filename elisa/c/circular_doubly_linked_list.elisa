# Bounded circular doubly linked list using a circular sentinel ring.
def circular_doubly_linked_list_impl(values: i64&, length: usize) -> i64:
    if length > 1024 or length % 2 != 0:
        return -1
    operation_count: usize = length / 2
    initialized_next: usize[257] =
        for index in 0..<256 |links: mutable usize[257] = zeroed| -> links:
            links[index] <- index + 1
    checksum: i64 =
        while operation < operation_count |operation: mutable usize = 0, node_value: mutable i64[256] = zeroed, next_node: mutable usize[257] = initialized_next, prev_node: mutable usize[257] = zeroed, free_head: mutable usize = 0, count: mutable usize = 0, checksum: mutable i64 = 0| -> checksum:
            if operation == 0:
                next_node[256] <- 256
                prev_node[256] <- 256
            opcode: i64 = values[2 * operation]
            payload: i64 = values[2 * operation + 1]
            observed: mutable i64 = 0
            returns_value: mutable bool = true
            if opcode == 0 or opcode == 1:
                if payload < -1000000 or payload > 1000000 or count == 256 or free_head == 256:
                    break -1
                node: mutable usize = free_head
                free_head <- next_node[node]
                node_value[node] <- payload
                before: mutable usize = 256
                after: mutable usize = 256
                if opcode == 0:
                    before <- prev_node[256]
                else:
                    after <- next_node[256]
                next_node[node] <- after
                prev_node[node] <- before
                next_node[before] <- node
                prev_node[after] <- node
                count <- count + 1
                returns_value <- false
            elif opcode == 2 or opcode == 3:
                if payload != 0 or count == 0:
                    break -1
                node: usize = next_node[256]
                if opcode == 3:
                    node <- prev_node[256]
                observed <- node_value[node]
                next_node[prev_node[node]] <- next_node[node]
                prev_node[next_node[node]] <- prev_node[node]
                next_node[node] <- free_head
                free_head <- node
                count <- count - 1
            elif opcode == 4 or opcode == 5:
                if payload < -1000000 or payload > 1000000:
                    break -1
                node: usize =
                    while current != 256 and node_value[current] != payload |current: mutable usize = next_node[256]| -> current:
                        current <- next_node[current]
                if node != 256:
                    observed <- 1
                if opcode == 4 and node != 256:
                    next_node[prev_node[node]] <- next_node[node]
                    prev_node[next_node[node]] <- prev_node[node]
                    next_node[node] <- free_head
                    free_head <- node
                    count <- count - 1
            elif opcode == 6:
                if payload != 0:
                    break -1
                observed <- count.i64()
            elif opcode == 7 or opcode == 8:
                if payload < 0 or payload > 1000000 or count == 0 or (opcode == 8 and payload >= count.i64()):
                    break -1
                index: mutable usize = payload.usize()
                if opcode == 7:
                    index <- index % count
                node: usize =
                    while step < index |step: mutable usize = 0, current: mutable usize = next_node[256]| -> current:
                        current <- next_node[current]
                        step <- step + 1
                observed <- node_value[node]
                if opcode == 8:
                    next_node[prev_node[node]] <- next_node[node]
                    prev_node[next_node[node]] <- prev_node[node]
                    next_node[node] <- free_head
                    free_head <- node
                    count <- count - 1
            else:
                break -1
            if returns_value:
                checksum <- checksum + (operation + 1).i64() * (observed + 1000000)
            if operation + 1 == operation_count:
                checksum <- while current != 256 |current: mutable usize = next_node[256], index: mutable usize = 0, total: mutable i64 = checksum| -> total:
                    total <- total + (operation_count + index + 1).i64() * (node_value[current] + 1000000)
                    current <- next_node[current]
                    index <- index + 1
                checksum <- while current != 256 |current: mutable usize = prev_node[256], index: mutable usize = 0, total: mutable i64 = checksum| -> total:
                    total <- total + (operation_count + count + index + 1).i64() * (node_value[current] + 1000000)
                    current <- prev_node[current]
                    index <- index + 1
            operation <- operation + 1
    checksum

export fn circular_doubly_linked_list_benchmark(values: i64&, length: usize) -> i64 = circular_doubly_linked_list_impl
