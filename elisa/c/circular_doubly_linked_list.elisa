# Bounded circular doubly linked-list operation trace with a sentinel ring.
const CAPACITY: usize = 256
const SENTINEL: usize = 256
const VALUE_OFFSET: i64 = 1000000
const MAX_INDEX: i64 = 1000000

# Unlink node from the ring; the caller pushes it onto the free list.
def circular_unlink(next_node: mutable view[usize], prev_node: mutable view[usize], node: usize, free_head: usize) -> void:
    next_node[prev_node[node]] <- next_node[node]
    prev_node[next_node[node]] <- prev_node[node]
    next_node[node] <- free_head

def circular_doubly_linked_list_impl(values: i64&, length: usize) -> i64:
    if length > 1024 or length % 2 != 0:
        return -1
    operation_count: usize = length / 2
    node_value: mutable i64[256] = zeroed
    next_node: mutable usize[257] = zeroed
    prev_node: mutable usize[257] = zeroed
    i: mutable usize = 0
    while i < CAPACITY:
        next_node[i] <- i + 1
        i <- i + 1
    free_head: mutable usize = 0
    next_node[SENTINEL] <- SENTINEL
    prev_node[SENTINEL] <- SENTINEL
    count: mutable usize = 0
    checksum: mutable i64 = 0

    operation: mutable usize = 0
    while operation < operation_count:
        opcode: i64 = values[2 * operation]
        payload: i64 = values[2 * operation + 1]
        observed: mutable i64 = 0
        returns_value: mutable bool = true
        if opcode == 0 or opcode == 1:
            if payload < -VALUE_OFFSET or payload > VALUE_OFFSET or count == CAPACITY or free_head == SENTINEL:
                return -1
            node: usize = free_head
            free_head <- next_node[node]
            node_value[node] <- payload
            before: usize = prev_node[SENTINEL] if opcode == 0 else SENTINEL
            after: usize = SENTINEL if opcode == 0 else next_node[SENTINEL]
            next_node[node] <- after
            prev_node[node] <- before
            next_node[before] <- node
            prev_node[after] <- node
            count <- count + 1
            returns_value <- false
        elif opcode == 2 or opcode == 3:
            if payload != 0 or count == 0:
                return -1
            node: usize = next_node[SENTINEL] if opcode == 2 else prev_node[SENTINEL]
            observed <- node_value[node]
            circular_unlink(next_node[0:257], prev_node[0:257], node, free_head)
            free_head <- node
            count <- count - 1
        elif opcode == 4 or opcode == 5:
            if payload < -VALUE_OFFSET or payload > VALUE_OFFSET:
                return -1
            node: mutable usize = next_node[SENTINEL]
            while node != SENTINEL and node_value[node] != payload:
                node <- next_node[node]
            observed <- 1 if node != SENTINEL else 0
            if opcode == 4 and node != SENTINEL:
                circular_unlink(next_node[0:257], prev_node[0:257], node, free_head)
                free_head <- node
                count <- count - 1
        elif opcode == 6:
            if payload != 0:
                return -1
            observed <- count.i64()
        elif opcode == 7 or opcode == 8:
            if payload < 0 or payload > MAX_INDEX or count == 0:
                return -1
            if opcode == 8 and payload.u64() >= count.u64():
                return -1
            index: usize = (payload % count.i64()).usize() if opcode == 7 else payload.usize()
            node: mutable usize = 0
            if index <= count / 2:
                node <- next_node[SENTINEL]
                step: mutable usize = 0
                while step < index:
                    node <- next_node[node]
                    step <- step + 1
            else:
                node <- prev_node[SENTINEL]
                step: mutable usize = count - 1
                while step > index:
                    node <- prev_node[node]
                    step <- step - 1
            observed <- node_value[node]
            if opcode == 8:
                circular_unlink(next_node[0:257], prev_node[0:257], node, free_head)
                free_head <- node
                count <- count - 1
        else:
            return -1
        if returns_value:
            checksum <- checksum + (operation.i64() + 1) * (observed + VALUE_OFFSET)
        operation <- operation + 1

    node: mutable usize = next_node[SENTINEL]
    index: mutable usize = 0
    while node != SENTINEL:
        checksum <- checksum + (operation_count.i64() + index.i64() + 1) * (node_value[node] + VALUE_OFFSET)
        node <- next_node[node]
        index <- index + 1
    node <- prev_node[SENTINEL]
    index <- 0
    while node != SENTINEL:
        checksum <- checksum + (operation_count.i64() + count.i64() + index.i64() + 1) * (node_value[node] + VALUE_OFFSET)
        node <- prev_node[node]
        index <- index + 1
    checksum

export fn circular_doubly_linked_list_benchmark(values: i64&, length: usize) -> i64 = circular_doubly_linked_list_impl
