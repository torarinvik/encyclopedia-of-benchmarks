def circular_list_trace(values: i64&, operation_count: usize, sentinel: usize, node_value: mutable i32&, next_node: mutable u16&, prev_node: mutable u16&) -> i64:
    checksum: i64 =
        while operation < operation_count |node_value_pointer: mutable i32& = node_value, next_node_pointer: mutable u16& = next_node, prev_node_pointer: mutable u16& = prev_node, operation: mutable usize = 0, free_head: mutable usize = sentinel, next_unused: mutable usize = 0, count: mutable usize = 0, checksum: mutable i64 = 0| -> checksum:
            if operation == 0:
                next_node_pointer[sentinel] <- sentinel.u16()
                prev_node_pointer[sentinel] <- sentinel.u16()
            opcode: i64 = values[2 * operation]
            payload: i64 = values[2 * operation + 1]
            observed: mutable i64 = 0
            returns_value: mutable bool = true
            if opcode == 0 or opcode == 1:
                if payload < -1000000 or payload > 1000000 or count == 256:
                    break -1
                node: usize = next_unused if free_head == sentinel else free_head
                if free_head == sentinel:
                    next_unused <- next_unused + 1
                else:
                    free_head <- next_node_pointer[node].usize()
                node_value_pointer[node] <- payload.i32()
                before: mutable usize = sentinel
                after: mutable usize = sentinel
                if opcode == 0:
                    before <- prev_node_pointer[sentinel].usize()
                else:
                    after <- next_node_pointer[sentinel].usize()
                next_node_pointer[node] <- after.u16()
                prev_node_pointer[node] <- before.u16()
                next_node_pointer[before] <- node.u16()
                prev_node_pointer[after] <- node.u16()
                count <- count + 1
                returns_value <- false
            elif opcode == 2 or opcode == 3:
                if payload != 0 or count == 0:
                    break -1
                node: usize = next_node_pointer[sentinel].usize() if opcode == 2 else prev_node_pointer[sentinel].usize()
                observed <- node_value_pointer[node].i64()
                next_node_pointer[prev_node_pointer[node].usize()] <- next_node_pointer[node]
                prev_node_pointer[next_node_pointer[node].usize()] <- prev_node_pointer[node]
                next_node_pointer[node] <- free_head.u16()
                free_head <- node
                count <- count - 1
            elif opcode == 4 or opcode == 5:
                if payload < -1000000 or payload > 1000000:
                    break -1
                node: usize =
                    while current != sentinel and node_value_pointer[current].i64() != payload |current: mutable usize = next_node_pointer[sentinel].usize()| -> current:
                        current <- next_node_pointer[current].usize()
                if node != sentinel:
                    observed <- 1
                if opcode == 4 and node != sentinel:
                    next_node_pointer[prev_node_pointer[node].usize()] <- next_node_pointer[node]
                    prev_node_pointer[next_node_pointer[node].usize()] <- prev_node_pointer[node]
                    next_node_pointer[node] <- free_head.u16()
                    free_head <- node
                    count <- count - 1
            elif opcode == 6:
                if payload != 0:
                    break -1
                observed <- count.i64()
            elif opcode == 7 or opcode == 8:
                if payload < 0 or payload > 1000000 or count == 0 or (opcode == 8 and payload >= count.i64()):
                    break -1
                index: mutable usize = payload.usize()
                if opcode == 7:
                    index <- index % count
                node: usize =
                    while step < index |step: mutable usize = 0, current: mutable usize = next_node_pointer[sentinel].usize()| -> current:
                        current <- next_node_pointer[current].usize()
                        step <- step + 1
                observed <- node_value_pointer[node].i64()
                if opcode == 8:
                    next_node_pointer[prev_node_pointer[node].usize()] <- next_node_pointer[node]
                    prev_node_pointer[next_node_pointer[node].usize()] <- prev_node_pointer[node]
                    next_node_pointer[node] <- free_head.u16()
                    free_head <- node
                    count <- count - 1
            else:
                break -1
            if returns_value:
                checksum <- checksum + (operation + 1).i64() * (observed + 1000000)
            if operation + 1 == operation_count:
                checksum <- while current != sentinel |current: mutable usize = next_node_pointer[sentinel].usize(), index: mutable usize = 0, total: mutable i64 = checksum| -> total:
                    total <- total + (operation_count + index + 1).i64() * (node_value_pointer[current].i64() + 1000000)
                    current <- next_node_pointer[current].usize()
                    index <- index + 1
                checksum <- while current != sentinel |current: mutable usize = prev_node_pointer[sentinel].usize(), index: mutable usize = 0, total: mutable i64 = checksum| -> total:
                    total <- total + (operation_count + count + index + 1).i64() * (node_value_pointer[current].i64() + 1000000)
                    current <- prev_node_pointer[current].usize()
                    index <- index + 1
            operation <- operation + 1
    checksum

# Bounded circular doubly linked list using a circular sentinel ring.
def circular_doubly_linked_list_impl(values: i64&, length: usize) -> i64:
    if length > 1024 or length % 2 != 0:
        return -1
    operation_count: usize = length / 2
    if operation_count == 0:
        return 0
    if operation_count <= 16:
        small_values: mutable i32[16] = zeroed
        small_next: mutable u16[17] = zeroed
        small_previous: mutable u16[17] = zeroed
        return circular_list_trace(values, operation_count, 16, &small_values[0], &small_next[0], &small_previous[0])
    node_values: mutable i32[256] = zeroed
    next_nodes: mutable u16[257] = zeroed
    previous_nodes: mutable u16[257] = zeroed
    circular_list_trace(values, operation_count, 256, &node_values[0], &next_nodes[0], &previous_nodes[0])

export fn circular_doubly_linked_list_benchmark(values: i64&, length: usize) -> i64 = circular_doubly_linked_list_impl
