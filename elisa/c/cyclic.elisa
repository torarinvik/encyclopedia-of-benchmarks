def cyclic_rotate(next: i64&, previous: i64&, head: mutable i64&, size: i64, places: i64) -> void:
    if size == 0:
        return
    steps: mutable i64 = places % size
    if steps < 0:
        steps <- steps + size
    i: mutable i64 = 0
    if steps > size / 2:
        steps <- size - steps
        while i < steps:
            head <- previous[head.usize()]
            i <- i + 1
    else:
        while i < steps:
            head <- next[head.usize()]
            i <- i + 1

def cyclic_delete_head(node_values: mutable i64&, next: mutable i64&, previous: mutable i64&,
                       head: mutable i64&, size: mutable i64&) -> bool:
    if size == 0:
        return false
    current: usize = head.usize()
    if size == 1:
        head <- -1
    else:
        successor: i64 = next[current]
        predecessor: i64 = previous[current]
        next[predecessor.usize()] <- successor
        previous[successor.usize()] <- predecessor
        head <- successor
    node_values[current] <- 0
    size <- size - 1
    true

def cyclic_append_record(records: mutable i64&, field_count: mutable usize&, value: i64) -> void:
    records[field_count] <- value
    field_count <- field_count + 1

def cyclic_put_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def cyclic_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1:
        return -1
    if input[0] < 0 or input[0] > 64:
        return -1
    operation_count: usize = input[0].usize()
    if length != 1 + 2 * operation_count:
        return -1

    node_values: mutable i64[64] = zeroed
    next: mutable i64[64] = zeroed
    previous: mutable i64[64] = zeroed
    head: mutable i64 = -1
    size: mutable i64 = 0
    allocated: mutable usize = 0
    records: mutable i64[5000] = zeroed
    record_fields: mutable usize = 0
    query_count: mutable usize = 0

    index: mutable usize = 0
    while index < operation_count:
        operation: i64 = input[1 + 2 * index]
        argument: i64 = input[2 + 2 * index]
        if operation < 0 or operation > 5:
            return -1
        if operation == 0:
            if argument < -2147483648 or argument > 2147483647 or allocated >= 64:
                return -1
            node: usize = allocated
            allocated <- allocated + 1
            node_values[node] <- argument
            if size == 0:
                head <- node.i64()
                next[node] <- head
                previous[node] <- head
            else:
                tail: i64 = previous[head.usize()]
                previous[node] <- tail
                next[node] <- head
                next[tail.usize()] <- node.i64()
                previous[head.usize()] <- node.i64()
            size <- size + 1
        else if operation == 1:
            if argument < -1000000 or argument > 1000000:
                return -1
            cyclic_rotate(&next[0], &previous[0], &head, size, argument)
        else if operation == 2:
            if argument != 0:
                return -1
            deleted: bool = cyclic_delete_head(&node_values[0], &next[0], &previous[0], &head, &size)
            cyclic_append_record(&records[0], &record_fields, index.i64())
            cyclic_append_record(&records[0], &record_fields, operation)
            cyclic_append_record(&records[0], &record_fields, 1)
            cyclic_append_record(&records[0], &record_fields, if deleted: 1 else: 0)
            query_count <- query_count + 1
        else if operation == 3:
            if argument != 0:
                return -1
            cyclic_append_record(&records[0], &record_fields, index.i64())
            cyclic_append_record(&records[0], &record_fields, operation)
            cyclic_append_record(&records[0], &record_fields, size)
            cursor: mutable i64 = head
            item: mutable i64 = 0
            while item < size:
                cyclic_append_record(&records[0], &record_fields, node_values[cursor.usize()])
                cursor <- next[cursor.usize()]
                item <- item + 1
            query_count <- query_count + 1
        else if operation == 4:
            if argument < -1000000 or argument > 1000000 or size == 0:
                return -1
            while size > 1:
                cyclic_rotate(&next[0], &previous[0], &head, size, argument)
                cyclic_delete_head(&node_values[0], &next[0], &previous[0], &head, &size)
                cyclic_rotate(&next[0], &previous[0], &head, size, -1)
            winner: i64 = node_values[head.usize()]
            while cyclic_delete_head(&node_values[0], &next[0], &previous[0], &head, &size):
                continue
            cyclic_append_record(&records[0], &record_fields, index.i64())
            cyclic_append_record(&records[0], &record_fields, operation)
            cyclic_append_record(&records[0], &record_fields, 1)
            cyclic_append_record(&records[0], &record_fields, winner)
            query_count <- query_count + 1
        else:
            if argument != 0:
                return -1
            while cyclic_delete_head(&node_values[0], &next[0], &previous[0], &head, &size):
                continue
        index <- index + 1

    required: usize = (1 + record_fields + 1 + size.usize()) * 8
    if output.is_null() or capacity < required:
        return -2
    field: mutable usize = 0
    cyclic_put_i64(&output[0], field * 8, query_count.i64())
    field <- field + 1
    index <- 0
    while index < record_fields:
        cyclic_put_i64(&output[0], field * 8, records[index])
        field <- field + 1
        index <- index + 1
    cyclic_put_i64(&output[0], field * 8, size)
    field <- field + 1
    cursor: mutable i64 = head
    item: mutable i64 = 0
    while item < size:
        cyclic_put_i64(&output[0], field * 8, node_values[cursor.usize()])
        field <- field + 1
        cursor <- next[cursor.usize()]
        item <- item + 1
    required.i64()

export fn cyclic(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = cyclic_impl
