alias CLGC_MAX_N = 512
alias CLGC_MODULUS = 998244353

def clgc_mod_pow(base: i64, exponent: usize) -> i64:
    result: mutable i64 = 1
    factor: mutable i64 = base
    power: mutable usize = exponent
    while power > 0:
        if power % 2 == 1:
            result <- result * factor % CLGC_MODULUS
        factor <- factor * factor % CLGC_MODULUS
        power <- power / 2
    result

def clgc_impl(values: view[i64]) -> i64:
    if values.len() != 1 or values[0] < 1 or values[0] > i64(CLGC_MAX_N):
        return -1
    n: usize = values[0].usize()
    factorial: mutable i64[CLGC_MAX_N + 1] = zeroed
    inverse_factorial: mutable i64[CLGC_MAX_N + 1] = zeroed
    all_graphs: mutable i64[CLGC_MAX_N + 1] = zeroed
    connected: mutable i64[CLGC_MAX_N + 1] = zeroed
    factorial[0] <- 1
    i: mutable usize = 1
    while i <= n:
        factorial[i] <- factorial[i - 1] * i.i64() % CLGC_MODULUS
        i <- i + 1
    inverse_factorial[n] <- clgc_mod_pow(factorial[n], 998244351.usize())
    i <- n
    while i > 0:
        inverse_factorial[i - 1] <- inverse_factorial[i] * i.i64() % CLGC_MODULUS
        i <- i - 1

    all_graphs[0] <- 1
    edge_choices: mutable i64 = 1
    size: mutable usize = 1
    while size <= n:
        all_graphs[size] <- all_graphs[size - 1] * edge_choices % CLGC_MODULUS
        edge_choices <- edge_choices * 2 % CLGC_MODULUS
        size <- size + 1
    connected[1] <- 1
    size <- 2
    while size <= n:
        disconnected: mutable i64 = 0
        component_size: mutable usize = 1
        while component_size < size:
            choose: i64 = factorial[size - 1] * inverse_factorial[component_size - 1] % CLGC_MODULUS
            choose <- choose * inverse_factorial[size - component_size] % CLGC_MODULUS
            term: i64 = choose * connected[component_size] % CLGC_MODULUS
            term <- term * all_graphs[size - component_size] % CLGC_MODULUS
            disconnected <- (disconnected + term) % CLGC_MODULUS
            component_size <- component_size + 1
        connected[size] <- (all_graphs[size] - disconnected + CLGC_MODULUS) % CLGC_MODULUS
        size <- size + 1
    connected[n]

export fn connected_labeled_graph_count(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 1:
        return -1
    clgc_impl(input[0:length])
