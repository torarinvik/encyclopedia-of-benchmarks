# Count A/C/G/T and return all four counts as an ASCII string.
const MAX_SEQUENCE_LENGTH: usize = 1000

def count_nucleotide_decimal_length(value: i64) -> usize:
    length: mutable usize = 1
    while value >= 10:
        value <- value / 10
        length <- length + 1
    length

def count_nucleotide_write_decimal(output: mutable u8&, offset: usize, value: i64) -> usize:
    divisor: mutable i64 = 1
    while value / divisor >= 10:
        divisor <- divisor * 10
    current: mutable i64 = value
    position: mutable usize = offset
    while divisor > 0:
        output[position] <- (48 + current / divisor).u8()
        position <- position + 1
        current <- current % divisor
        divisor <- divisor / 10
    position

def count_nucleotide_impl(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if values == null or length < 1 or length > 1001:
        return -1
    count_value: i64 = values[0]
    if count_value < 0 or count_value > MAX_SEQUENCE_LENGTH.i64() or length != count_value.usize() + 1:
        return -1
    count_a: mutable i64 = 0
    count_c: mutable i64 = 0
    count_g: mutable i64 = 0
    count_t: mutable i64 = 0
    for i in 0..<count_value.usize():
        codepoint: i64 = values[1 + i]
        if codepoint < 0 or codepoint > 127:
            return -1
        if codepoint == 65: count_a <- count_a + 1
        else if codepoint == 67: count_c <- count_c + 1
        else if codepoint == 71: count_g <- count_g + 1
        else if codepoint == 84: count_t <- count_t + 1
    output_length: usize = count_nucleotide_decimal_length(count_a) + count_nucleotide_decimal_length(count_c) + count_nucleotide_decimal_length(count_g) + count_nucleotide_decimal_length(count_t) + 3
    if output.is_null() or capacity < output_length:
        return -2
    offset: mutable usize = count_nucleotide_write_decimal(output, 0, count_a)
    output[offset] <- 32
    offset <- offset + 1
    offset <- count_nucleotide_write_decimal(output, offset, count_c)
    output[offset] <- 32
    offset <- offset + 1
    offset <- count_nucleotide_write_decimal(output, offset, count_g)
    output[offset] <- 32
    offset <- offset + 1
    offset <- count_nucleotide_write_decimal(output, offset, count_t)
    offset.i64()

export fn count_nucleotide(values: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = count_nucleotide_impl
