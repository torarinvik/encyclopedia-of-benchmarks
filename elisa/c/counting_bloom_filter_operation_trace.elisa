const MAX_OPERATIONS: usize = 64
const MAX_PARSEABLE_LENGTH: usize = 130
const COUNTER_COUNT: usize = 67
const HASH_COUNT: usize = 4

def counting_bloom_filter_operation_trace_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_PARSEABLE_LENGTH:
        return -1
    var values: view[i64] = input[0:length]
    q_value: i64 = values[0]
    if q_value < 0 or q_value > MAX_OPERATIONS.i64(): return -1
    count: usize = q_value.usize()
    if length != 1 + 2 * count: return -1

    operation: mutable usize = 0
    while operation < count:
        opcode: i64 = values[1 + 2 * operation]
        key: i64 = values[2 + 2 * operation]
        if opcode < 0 or opcode > 2 or key < 0 or key > 65535:
            return -1
        operation <- operation + 1

    if output.is_null() or output_capacity < count: return -2
    var bytes: mutable view[u8] = output[0:count]
    var counters: mutable u8[COUNTER_COUNT] = zeroed
    operation <- 0
    while operation < count:
        opcode: i64 = values[1 + 2 * operation]
        key: i64 = values[2 + 2 * operation]
        base: usize = ((17 * key + 3) % COUNTER_COUNT.i64()).usize()
        stride: usize = (1 + ((5 * key + 3) % (COUNTER_COUNT.i64() - 1))).usize()

        if opcode == 0:
            for hash in 0..<HASH_COUNT:
                position: usize = (base + hash * stride) % COUNTER_COUNT
                counters[position] <- counters[position] + 1
            bytes[operation] <- 1
        else if opcode == 1:
            # The input contract guarantees that the deleted key is live.
            for hash in 0..<HASH_COUNT:
                position: usize = (base + hash * stride) % COUNTER_COUNT
                counters[position] <- counters[position] - 1
            bytes[operation] <- 1
        else:
            present: mutable u8 = 1
            for hash in 0..<HASH_COUNT:
                position: usize = (base + hash * stride) % COUNTER_COUNT
                if counters[position] == 0: present <- 0
            bytes[operation] <- present
        operation <- operation + 1
    count.i64()

export fn counting_bloom_filter_operation_trace(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = counting_bloom_filter_operation_trace_impl
