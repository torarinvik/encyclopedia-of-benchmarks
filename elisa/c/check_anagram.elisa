# Case-insensitive anagram check for distinct ASCII alphabetic strings.
def check_anagram_impl(input: i64&, length: usize) -> i64:
    if length < 2 or length > 2050:
        return -1
    first_length_value: i64 = input[0]
    second_length_value: i64 = input[1]
    if first_length_value < 0 or first_length_value > 1024 or second_length_value < 0 or second_length_value > 1024:
        return -1
    first_length: usize = first_length_value.usize()
    second_length: usize = second_length_value.usize()
    if length != 2 + first_length + second_length:
        return -1
    first_counts: mutable usize[26] = zeroed
    second_counts: mutable usize[26] = zeroed
    index: mutable usize = 0
    while index < first_length:
        value: i64 = input[2 + index]
        letter: mutable i64 = 0
        if value >= 97 and value <= 122:
            letter <- value - 97
        else:
            if value >= 65 and value <= 90:
                letter <- value - 65
            else:
                return -1
        first_counts[letter.usize()] <- first_counts[letter.usize()] + 1
        index <- index + 1
    index <- 0
    while index < second_length:
        value: i64 = input[2 + first_length + index]
        letter: mutable i64 = 0
        if value >= 97 and value <= 122:
            letter <- value - 97
        else:
            if value >= 65 and value <= 90:
                letter <- value - 65
            else:
                return -1
        second_counts[letter.usize()] <- second_counts[letter.usize()] + 1
        index <- index + 1
    if first_length != second_length:
        return 0
    different_after_normalization: mutable bool = false
    index <- 0
    while index < first_length:
        left: mutable i64 = input[2 + index]
        right: mutable i64 = input[2 + first_length + index]
        if left >= 65 and left <= 90:
            left <- left + 32
        if right >= 65 and right <= 90:
            right <- right + 32
        if left != right:
            different_after_normalization <- true
        index <- index + 1
    if not different_after_normalization:
        return 0
    letter_index: mutable usize = 0
    while letter_index < 26:
        if first_counts[letter_index] != second_counts[letter_index]:
            return 0
        letter_index <- letter_index + 1
    1

export fn check_anagram(input: i64&, length: usize) -> i64 = check_anagram_impl
