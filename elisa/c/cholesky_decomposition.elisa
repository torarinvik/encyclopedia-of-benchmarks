const MAX_DIMENSION: usize = 6
const MAX_ENTRY_MICRO: i64 = 1000000000
extern sqrt(value: f64) -> f64
extern fabs(value: f64) -> f64
extern memcpy(destination: mutable u64&, source: f64&, length: usize) -> mutable u64&

def cholesky_decomposition_write_f64(output: mutable u8&, offset: usize, value: f64) -> void:
    bits: mutable u64 = 0
    memcpy(&bits, &value, 8)
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def cholesky_decomposition_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 1 or input[0] < 1 or input[0] > MAX_DIMENSION.i64():
        return -1
    n: usize = input[0].usize()
    if length != 1 + n * n:
        return -1

    matrix: mutable f64[MAX_DIMENSION * MAX_DIMENSION] = zeroed
    lower: mutable f64[MAX_DIMENSION * MAX_DIMENSION] = zeroed
    index: mutable usize = 0
    while index < n * n:
        scaled: i64 = input[index + 1]
        if scaled < -MAX_ENTRY_MICRO or scaled > MAX_ENTRY_MICRO:
            return -1
        matrix[index] <- scaled.f64() / 1000000.0
        index <- index + 1

    row: mutable usize = 0
    while row < n:
        column: mutable usize = 0
        while column < n:
            left: f64 = matrix[row * n + column]
            right: f64 = matrix[column * n + row]
            if fabs(left - right) > 1.0e-8 + 1.0e-5 * fabs(right):
                return -1
            column <- column + 1
        row <- row + 1

    row <- 0
    while row < n:
        column <- 0
        while column <= row:
            sum: mutable f64 = 0.0
            index <- 0
            while index < column:
                sum <- sum + lower[row * n + index] * lower[column * n + index]
                index <- index + 1
            residual: f64 = matrix[row * n + column] - sum
            if row == column:
                if residual <= 0.0:
                    return -1
                lower[row * n + column] <- sqrt(residual)
            else:
                lower[row * n + column] <- residual / lower[column * n + column]
            column <- column + 1
        row <- row + 1

    output_bytes: usize = n * n * 8
    if output_bytes > output_capacity or output.is_null():
        return -2
    index <- 0
    while index < n * n:
        cholesky_decomposition_write_f64(output, index * 8, lower[index])
        index <- index + 1
    output_bytes.i64()

export fn cholesky_decomposition(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = cholesky_decomposition_impl
