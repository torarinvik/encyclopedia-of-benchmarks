const MAX_LENGTH: usize = 4096

def is_ascii_word(value: i64) -> bool:
    (value >= 97 and value <= 122) or (value >= 65 and value <= 90) or (value >= 48 and value <= 57)

def check_kebab_case_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -2
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < 32 or value > 126:
            return -2
        index <- index + 1
    index <- 0
    while index < length:
        if values[index] == 95:
            return 0
        index <- index + 1
    index <- 1
    while index + 1 < length:
        if values[index] == 45 and is_ascii_word(values[index - 1]) and is_ascii_word(values[index + 1]):
            return 1
        index <- index + 1
    0

export fn check_kebab_case(values: i64&, length: usize) -> i64 = check_kebab_case_impl
