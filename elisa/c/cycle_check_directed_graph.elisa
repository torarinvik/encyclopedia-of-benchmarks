# Directed cycle detection with iterative depth-first search and three colors.
def cycle_check_directed_graph_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 65 or (length - 1) % 2 != 0:
        return -1
    vertices_value: i64 = values[0]
    if vertices_value < 0 or vertices_value > 64:
        return -1
    vertices: usize = vertices_value.usize()
    edge_count: usize = (length - 1) / 2
    if edge_count > 32:
        return -1
    adjacency: mutable u64[64] = zeroed
    state: mutable u8[64] = zeroed
    dfs_stack: mutable usize[64] = zeroed
    next_neighbor: mutable usize[64] = zeroed
    edge: mutable usize = 0
    while edge < edge_count:
        source_value: i64 = values[1 + 2 * edge]
        destination_value: i64 = values[2 + 2 * edge]
        if source_value < 0 or destination_value < 0:
            return -1
        if source_value.u64() >= vertices.u64() or destination_value.u64() >= vertices.u64():
            return -1
        source: usize = source_value.usize()
        destination: usize = destination_value.usize()
        adjacency[source] <- adjacency[source] | (1.u64() << destination)
        edge <- edge + 1

    root: mutable usize = 0
    while root < vertices:
        if state[root] == 0:
            top: mutable usize = 0
            dfs_stack[top] <- root
            next_neighbor[top] <- 0
            state[root] <- 1
            while true:
                node: usize = dfs_stack[top]
                destination: mutable usize = next_neighbor[top]
                while (destination < vertices and (adjacency[node] & (1.u64() << destination)) == 0):
                    destination <- destination + 1
                if destination == vertices:
                    state[node] <- 2
                    if top == 0:
                        break
                    top <- top - 1
                    continue
                next_neighbor[top] <- destination + 1
                if state[destination] == 1:
                    return 1
                if state[destination] == 0:
                    top <- top + 1
                    dfs_stack[top] <- destination
                    next_neighbor[top] <- 0
                    state[destination] <- 1
        root <- root + 1
    0

export fn cycle_check_directed_graph(values: i64&, length: usize) -> i64 = cycle_check_directed_graph_impl
