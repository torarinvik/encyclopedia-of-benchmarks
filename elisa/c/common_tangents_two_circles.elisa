alias CTTC_MAX_COORDINATE = 100000
alias CTTC_MAX_RADIUS = 100000

def cttc_count(x1: i64, y1: i64, r1: i64, x2: i64, y2: i64, r2: i64) -> i64:
    dx: i64 = x2 - x1
    dy: i64 = y2 - y1
    distance_squared: i64 = dx * dx + dy * dy
    signs: i64[2] = [-1, 1]
    candidates: mutable i64 = 0
    i: mutable usize = 0
    while i < 2:
        j: mutable usize = 0
        while j < 2:
            difference: i64 = signs[j] * r2 - signs[i] * r1
            if distance_squared >= difference * difference:
                candidates <- candidates + 1
            j <- j + 1
        i <- i + 1
    if r1 == 0 and r2 == 0: return 1
    if r1 == 0 or r2 == 0:
        radius: i64 = r1 + r2
        if distance_squared == radius * radius: return 1
        return candidates / 2
    radius_sum: i64 = r1 + r2
    radius_difference: i64 = r1 - r2
    if distance_squared == radius_sum * radius_sum or distance_squared == radius_difference * radius_difference:
        candidates <- candidates - 1
    candidates

def cttc_impl(values: view[i64]) -> i64:
    if values.len() != 6: return -1
    x1: i64 = values[0]
    y1: i64 = values[1]
    r1: i64 = values[2]
    x2: i64 = values[3]
    y2: i64 = values[4]
    r2: i64 = values[5]
    if x1 < -CTTC_MAX_COORDINATE or x1 > CTTC_MAX_COORDINATE or
       y1 < -CTTC_MAX_COORDINATE or y1 > CTTC_MAX_COORDINATE or
       x2 < -CTTC_MAX_COORDINATE or x2 > CTTC_MAX_COORDINATE or
       y2 < -CTTC_MAX_COORDINATE or y2 > CTTC_MAX_COORDINATE or
       r1 < 0 or r1 > CTTC_MAX_RADIUS or r2 < 0 or r2 > CTTC_MAX_RADIUS or
       (x1 == x2 and y1 == y2):
        return -1
    cttc_count(x1, y1, r1, x2, y2, r2)

export fn common_tangents_two_circles(input: i64&, length: usize) -> i64:
    if input.is_null() or length != 6: return -1
    cttc_impl(input[0:length])
