def store_i64_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: u64 = value.u64()
    byte: usize = 0
    while byte < 8:
        output[position + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def cross_correlation_impl(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 4 or length > 66 or values.is_null():
        return -1
    raw_x_count: i64 = values[0]
    raw_y_count: i64 = values[1]
    if raw_x_count < 1 or raw_x_count > 32 or raw_y_count < 1 or raw_y_count > 32:
        return -1
    x_count: usize = raw_x_count.usize()
    y_count: usize = raw_y_count.usize()
    if length != x_count + y_count + 2:
        return -1
    input_index: usize = 0
    while input_index < x_count + y_count:
        sample: i64 = values[input_index + 2]
        if sample < -1000000 or sample > 1000000:
            return -1
        input_index <- input_index + 1
    result_count: usize = x_count + y_count - 1
    byte_count: usize = 8 * result_count
    if output_capacity < byte_count or output.is_null():
        return -2

    y_start: mutable usize = y_count
    result_index: usize = 0
    while result_index < result_count:
        if result_index < y_count:
            y_start <- y_start - 1
        k_min: usize = if result_index >= y_count - 1: result_index - (y_count - 1) else: 0
        k_max: usize = if result_index < x_count: result_index else: x_count - 1
        sum: mutable i64 = 0
        k: usize = k_min
        while k <= k_max:
            y_index: usize = y_start + (k - k_min)
            sum <- sum + values[k + 2] * values[x_count + y_index + 2]
            k <- k + 1
        store_i64_le(sum, output[0:byte_count], result_index * 8)
        result_index <- result_index + 1
    byte_count.i64()

export fn cross_correlation(values: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = cross_correlation_impl
