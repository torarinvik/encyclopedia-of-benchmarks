# Two-pointer maximum area between vertical lines.
def container_with_most_water_impl(heights: i64&, length: usize) -> i64:
    if length > 4096:
        return -1
    index: mutable usize = 0
    while index < length:
        if heights[index] < 0 or heights[index] > 2147483647:
            return -1
        index <- index + 1
    if length < 2:
        return 0

    left: mutable usize = 0
    right: mutable usize = length - 1
    best: mutable i64 = 0
    while left < right:
        left_height: i64 = heights[left]
        right_height: i64 = heights[right]
        height: mutable i64 = left_height
        if right_height < height:
            height <- right_height
        area: i64 = height * (right - left).i64()
        if area > best:
            best <- area
        if left_height <= right_height:
            left <- left + 1
        else:
            right <- right - 1
    best

export fn container_with_most_water(heights: i64&, length: usize) -> i64 = container_with_most_water_impl
