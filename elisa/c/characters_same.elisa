def characters_same_impl(values: i64&, length: usize) -> i64:
    if length > 256:
        return -1
    for index in 0..<length:
        if values[index] < 0 or values[index] > 127:
            return -1
    if length == 0:
        return 1
    first: i64 = values[0]
    for index in 1..<length:
        if values[index] != first:
            return 0
    1

export fn characters_same(values: i64&, length: usize) -> i64 = characters_same_impl
