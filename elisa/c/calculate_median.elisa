def calculate_median_impl(values: i64&, length: usize) -> i64:
    if length < 1 or length > 1024:
        return -9223372036854775808
    middle: usize = length / 2
    if length % 2 != 0:
        return values[middle] * 2
    values[middle - 1] + values[middle]

export fn calculate_median(values: i64&, length: usize) -> i64 = calculate_median_impl
