# Selected coordinate or acceptance flag from Cohen-Sutherland clipping.
const SCALE: f64 = 1000000.0
const MAX_COORDINATE_MICRO: i64 = 1000000000
const INVALID_RESULT: f64 = -1.0e300

def cohen_sutherland_impl(values: i64&, length: usize) -> f64:
    if values == null or length != 9:
        return INVALID_RESULT
    selector: i64 = values[0]
    if selector < 0 or selector > 4:
        return INVALID_RESULT
    for index in 1..<9:
        value: i64 = values[index]
        if value < -MAX_COORDINATE_MICRO or value > MAX_COORDINATE_MICRO:
            return INVALID_RESULT

    x_min: f64 = values[1].f64() / SCALE
    y_min: f64 = values[2].f64() / SCALE
    x_max: f64 = values[3].f64() / SCALE
    y_max: f64 = values[4].f64() / SCALE
    if x_min >= x_max or y_min >= y_max:
        return INVALID_RESULT
    x1: mutable f64 = values[5].f64() / SCALE
    y1: mutable f64 = values[6].f64() / SCALE
    x2: mutable f64 = values[7].f64() / SCALE
    y2: mutable f64 = values[8].f64() / SCALE

    code1: mutable i64 = 0
    if x1 < x_min:
        code1 <- code1 | 1
    else if x1 > x_max:
        code1 <- code1 | 2
    if y1 < y_min:
        code1 <- code1 | 4
    else if y1 > y_max:
        code1 <- code1 | 8
    code2: mutable i64 = 0
    if x2 < x_min:
        code2 <- code2 | 1
    else if x2 > x_max:
        code2 <- code2 | 2
    if y2 < y_min:
        code2 <- code2 | 4
    else if y2 > y_max:
        code2 <- code2 | 8

    accepted: mutable bool = false
    while true:
        if code1 == 0 and code2 == 0:
            accepted <- true
            break
        if (code1 & code2) != 0:
            break
        code_out: i64 = if code1 != 0 then code1 else code2
        x: f64 = 0.0
        y: f64 = 0.0
        if (code_out & 8) != 0:
            x = x1 + (x2 - x1) * (y_max - y1) / (y2 - y1)
            y = y_max
        else if (code_out & 4) != 0:
            x = x1 + (x2 - x1) * (y_min - y1) / (y2 - y1)
            y = y_min
        else if (code_out & 2) != 0:
            y = y1 + (y2 - y1) * (x_max - x1) / (x2 - x1)
            x = x_max
        else:
            y = y1 + (y2 - y1) * (x_min - x1) / (x2 - x1)
            x = x_min

        if code_out == code1:
            x1 <- x
            y1 <- y
            code1 <- 0
            if x1 < x_min:
                code1 <- code1 | 1
            else if x1 > x_max:
                code1 <- code1 | 2
            if y1 < y_min:
                code1 <- code1 | 4
            else if y1 > y_max:
                code1 <- code1 | 8
        else:
            x2 <- x
            y2 <- y
            code2 <- 0
            if x2 < x_min:
                code2 <- code2 | 1
            else if x2 > x_max:
                code2 <- code2 | 2
            if y2 < y_min:
                code2 <- code2 | 4
            else if y2 > y_max:
                code2 <- code2 | 8

    if selector == 4:
        return if accepted then 1.0 else 0.0
    if not accepted:
        return INVALID_RESULT
    if selector == 0:
        return x1
    if selector == 1:
        return y1
    if selector == 2:
        return x2
    y2

export fn cohen_sutherland(values: i64&, length: usize) -> f64 = cohen_sutherland_impl
