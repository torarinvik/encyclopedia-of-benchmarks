const MAX_LENGTH: usize = 4096

# Return whether any lowercase ASCII vowel appears in the input.
def check_vowels_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    i: mutable usize = 0
    while i < length:
        if values[i] < 97 or values[i] > 122:
            return -1
        i <- i + 1
    i <- 0
    while i < length:
        value: i64 = values[i]
        if value == 97 or value == 101 or value == 105 or value == 111 or value == 117:
            return 1
        i <- i + 1
    0

export fn check_vowels(values: i64&, length: usize) -> i64 = check_vowels_impl
