const MAX_INPUT: usize = 1024
const MAX_ENTRIES: usize = 1025

def word_ws(c: u8) -> bool: (c >= 9 and c <= 13) or c == 32
def word_lower(c: u8) -> u8: if c >= 65 and c <= 90: (c + 32).u8() else: c
def word_forbidden(text: view[u8], start: usize, length: usize) -> bool:
    names: [&str; 7] = ["constructor", "tostring", "tolocalestring", "valueof", "hasownproperty", "isprototypeof", "propertyisenumerable"]
    x: mutable usize = 0
    while x < 7:
        if length == names[x].len():
            i: mutable usize = 0
            while i < length and word_lower(text[start+i]) == names[x].byte(i): i <- i+1
            if i == length: return true
        x <- x+1
    false
def word_put32(output: mutable view[u8], position: mutable usize&, value: u32) -> void:
    bits: mutable u32 = value
    i: mutable usize = 0
    while i < 4: output[position] <- (bits & 255).u8(); position <- position+1; bits <- bits >> 8; i <- i+1

def check_word_occurrence_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if length < 2 or input[0] < 0 or input[0] > 1 or input[1] < 0 or input[1] > MAX_INPUT.i64() or length != input[1].usize()+2: return -1
    n: usize = input[1].usize()
    text: mutable u8[1024] = zeroed
    i: mutable usize = 0
    while i<n:
        value: i64 = input[i+2]
        if value < 0 or value > 127: return -1
        c: u8 = value.u8()
        if not ((c>=65 and c<=90) or (c>=97 and c<=122) or word_ws(c)): return -1
        text[i] <- if input[0] == 1: word_lower(c) else: c
        i <- i+1
    starts: mutable usize[1025] = zeroed
    lens: mutable usize[1025] = zeroed
    counts: mutable u32[1025] = zeroed
    entries: mutable usize = 0
    i <- 0
    start: mutable usize = 0
    loop:
        if i == n or word_ws(text[i]):
            len: usize = i-start
            if word_forbidden(text[0:MAX_INPUT],start,len): return -1
            j: mutable usize = 0
            while j<entries:
                if lens[j] == len:
                    q: mutable usize = 0
                    while q<len and text[starts[j]+q] == text[start+q]: q <- q+1
                    if q==len: break
                j <- j+1
            if j==entries: starts[j] <- start; lens[j] <- len; entries <- entries+1
            counts[j] <- counts[j]+1
            if i==n: break
            while i<n and word_ws(text[i]): i <- i+1
            start <- i
        else: i <- i+1
    need: mutable usize = 4
    j: mutable usize = 0
    while j<entries: need <- need+8+lens[j]; j <- j+1
    if capacity<need: return -2
    position: mutable usize = 0
    word_put32(output[0:need],position,entries.u32())
    j <- 0
    while j<entries:
        word_put32(output[0:need],position,lens[j].u32())
        i <- 0
        while i<lens[j]: output[position] <- text[starts[j]+i]; position <- position+1; i <- i+1
        word_put32(output[0:need],position,counts[j])
        j <- j+1
    position.i64()

export fn check_word_occurrence(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = check_word_occurrence_impl
