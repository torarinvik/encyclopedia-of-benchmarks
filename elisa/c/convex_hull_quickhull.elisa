const MAX_POINTS: usize = 1024

def convex_hull_quickhull_cross(a: usize, b: usize, c: usize, values: i64&) -> i64:
    dx1: i64 = values[2 * b] - values[2 * a]
    dy1: i64 = values[2 * b + 1] - values[2 * a + 1]
    dx2: i64 = values[2 * c] - values[2 * a]
    dy2: i64 = values[2 * c + 1] - values[2 * a + 1]
    dx1 * dy2 - dy1 * dx2

def convex_hull_quickhull_before(left: usize, right: usize,
        values: i64&) -> bool:
    if values[2 * left] != values[2 * right]:
        return values[2 * left] < values[2 * right]
    if values[2 * left + 1] != values[2 * right + 1]:
        return values[2 * left + 1] < values[2 * right + 1]
    left < right

def convex_hull_quickhull_sort(points: mutable usize&, scratch: mutable usize&,
        begin: usize, end: usize, values: i64&) -> void:
    if end - begin < 2:
        return
    middle: usize = begin + (end - begin) / 2
    convex_hull_quickhull_sort(points, scratch, begin, middle, values)
    convex_hull_quickhull_sort(points, scratch, middle, end, values)
    left: mutable usize = begin
    right: mutable usize = middle
    out: mutable usize = begin
    while left < middle and right < end:
        if convex_hull_quickhull_before(points[right], points[left], values):
            scratch[out] <- points[right]
            right <- right + 1
        else:
            scratch[out] <- points[left]
            left <- left + 1
        out <- out + 1
    while left < middle:
        scratch[out] <- points[left]
        left <- left + 1
        out <- out + 1
    while right < end:
        scratch[out] <- points[right]
        right <- right + 1
        out <- out + 1
    index: mutable usize = begin
    while index < end:
        points[index] <- scratch[index]
        index <- index + 1

def convex_hull_quickhull_visit(points: usize&, count: usize,
        left: usize, right: usize, on_hull: mutable u8&, values: i64&) -> void:
    farthest: mutable usize = MAX_POINTS
    greatest_area: mutable i64 = 0
    index: mutable usize = 0
    while index < count:
        area: i64 = convex_hull_quickhull_cross(
            points[left], points[right], points[index], values)
        if area > greatest_area:
            greatest_area <- area
            farthest <- index
        index <- index + 1
    if farthest == MAX_POINTS:
        return
    on_hull[farthest] <- 1.u8()
    convex_hull_quickhull_visit(points, count, left, farthest, on_hull, values)
    convex_hull_quickhull_visit(points, count, farthest, right, on_hull, values)

def convex_hull_quickhull_write_index(output: mutable u8&,
        position: usize, id: usize) -> void:
    value: u32 = id.u32()
    byte: mutable usize = 0
    while byte < 4:
        output[4 * position + byte] <- ((value >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def convex_hull_quickhull_impl(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length > 2 * MAX_POINTS or length % 2 != 0:
        return -1
    point_count: usize = length / 2
    order: mutable usize[MAX_POINTS] = zeroed
    scratch: mutable usize[MAX_POINTS] = zeroed
    points: mutable usize[MAX_POINTS] = zeroed
    index: mutable usize = 0
    while index < point_count:
        x: i64 = values[2 * index]
        y: i64 = values[2 * index + 1]
        if x < -1000000000 or x > 1000000000 or y < -1000000000 or y > 1000000000:
            return -1
        order[index] <- index
        index <- index + 1
    if point_count == 0:
        return 0

    convex_hull_quickhull_sort(&order[0], &scratch[0], 0, point_count, values)
    unique_count: mutable usize = 0
    index <- 0
    while index < point_count:
        id: usize = order[index]
        if (unique_count == 0 or values[2 * points[unique_count - 1]] != values[2 * id] or
                values[2 * points[unique_count - 1] + 1] != values[2 * id + 1]):
            points[unique_count] <- id
            unique_count <- unique_count + 1
        index <- index + 1

    on_hull: mutable u8[MAX_POINTS] = zeroed
    if unique_count == 1:
        on_hull[0] <- 1.u8()
    else:
        on_hull[0] <- 1.u8()
        on_hull[unique_count - 1] <- 1.u8()
        convex_hull_quickhull_visit(&points[0], unique_count, 0,
                unique_count - 1, &on_hull[0], values)
        convex_hull_quickhull_visit(&points[0], unique_count,
                unique_count - 1, 0, &on_hull[0], values)

    hull_count: mutable usize = 0
    index <- 0
    while index < unique_count:
        if on_hull[index] != 0:
            hull_count <- hull_count + 1
        index <- index + 1
    if output_capacity < 4 * hull_count:
        return -2
    position: mutable usize = 0
    index <- 0
    while index < unique_count:
        if on_hull[index] != 0:
            convex_hull_quickhull_write_index(output, position, points[index])
            position <- position + 1
        index <- index + 1
    hull_count.i64()

export fn convex_hull_quickhull(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = convex_hull_quickhull_impl
