def compress_store_i32(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: u32 = value.u32()
    output[position] <- (bits & 255).u8()
    output[position + 1] <- ((bits >> 8) & 255).u8()
    output[position + 2] <- ((bits >> 16) & 255).u8()
    output[position + 3] <- ((bits >> 24) & 255).u8()

def compress_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length < 1 or length > 65:
        return -1
    count_value: i64 = input[0]
    if count_value < 0 or count_value > 64 or length != 1 + count_value.usize():
        return -1
    count: usize = count_value.usize()
    index: mutable usize = 0
    while index < count:
        value: i64 = input[1 + index]
        if value < -2147483648 or value > 2147483647:
            return -1
        index <- index + 1

    maximum_bytes: usize = count * 4
    if output_capacity < maximum_bytes:
        return -2
    result_count: mutable usize = 0
    previous: mutable i64 = 0
    index <- 0
    while index < count:
        value: i64 = input[1 + index]
        if index == 0 or value != previous:
            compress_store_i32(value, output[0:maximum_bytes], result_count * 4)
            result_count <- result_count + 1
        previous <- value
        index <- index + 1
    result_count.i64()

export fn compress(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = compress_impl
