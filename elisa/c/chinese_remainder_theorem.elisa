# Incremental Chinese remainder theorem using extended Euclid modular inverses.
const MAX_INPUTS: usize = 8
const MAX_MODULUS: i64 = 1000

def crt_modular_inverse(value: i64, modulus: i64) -> i64:
    old_remainder: mutable i64 = value % modulus
    remainder: mutable i64 = modulus
    old_coefficient: mutable i64 = 1
    coefficient: mutable i64 = 0
    while remainder != 0:
        quotient: i64 = old_remainder / remainder
        next_remainder: i64 = old_remainder - quotient * remainder
        old_remainder <- remainder
        remainder <- next_remainder
        next_coefficient: i64 = old_coefficient - quotient * coefficient
        old_coefficient <- coefficient
        coefficient <- next_coefficient
    if old_remainder != 1:
        return -1
    old_coefficient <- old_coefficient % modulus
    if old_coefficient < 0:
        old_coefficient <- old_coefficient + modulus
    old_coefficient

def chinese_remainder_theorem_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_INPUTS or length % 2 != 0:
        return -1
    result: mutable i64 = 0
    product: mutable i64 = 1
    index: mutable usize = 0
    while index < length:
        residue: i64 = values[index]
        modulus: i64 = values[index + 1]
        if modulus < 2 or modulus > MAX_MODULUS or residue < 0 or residue >= modulus:
            return -1
        inverse: i64 = crt_modular_inverse(product % modulus, modulus)
        if inverse < 0:
            return -1
        difference: mutable i64 = residue - result % modulus
        if difference < 0:
            difference <- difference + modulus
        factor: i64 = difference * inverse % modulus
        result <- result + product * factor
        product <- product * modulus
        index <- index + 2
    result

export fn chinese_remainder_theorem(values: i64&, length: usize) -> i64 = chinese_remainder_theorem_impl
