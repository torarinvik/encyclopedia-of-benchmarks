const CMN_MAX_SOURCE: usize = 6
const CMN_MAX_INPUT: usize = 16
const CMN_MAX_OUTPUT: usize = 12

def cmn_subsequence(source: view[i64], requested: usize,
                    selected: mutable view[u8]) -> usize:
    stack: mutable u8[CMN_MAX_SOURCE] = zeroed
    stack_length: mutable usize = 0
    deletions: mutable usize = source.length() - requested
    i: mutable usize = 0
    while i < source.length():
        digit: u8 = source[i].u8()
        while deletions > 0 and stack_length > 0 and stack[stack_length - 1] < digit:
            stack_length <- stack_length - 1
            deletions <- deletions - 1
        stack[stack_length] <- digit
        stack_length <- stack_length + 1
        i <- i + 1
    stack_length <- stack_length - deletions
    i <- 0
    while i < stack_length:
        selected[i] <- stack[i]
        i <- i + 1
    stack_length

def cmn_compare_suffix(first: view[u8], first_at: usize,
                       second: view[u8], second_at: usize) -> i64:
    i: mutable usize = first_at
    j: mutable usize = second_at
    while i < first.length() and j < second.length():
        if first[i] != second[j]:
            if first[i] > second[j]: return 1
            return -1
        i <- i + 1
        j <- j + 1
    if i == first.length() and j == second.length(): return 0
    if i == first.length(): return -1
    1

def cmn_merge(first: view[u8], first_length: usize,
              second: view[u8], second_length: usize,
              merged: mutable view[u8]) -> usize:
    i: mutable usize = 0
    j: mutable usize = 0
    written: mutable usize = 0
    while i < first_length or j < second_length:
        order: i64 = cmn_compare_suffix(first[0:first_length], i,
                                        second[0:second_length], j)
        if j == second_length or (i < first_length and order >= 0):
            merged[written] <- first[i]
            i <- i + 1
        else:
            merged[written] <- second[j]
            j <- j + 1
        written <- written + 1
    written

def cmn_greater(candidate: view[u8], best: view[u8], length: usize) -> bool:
    i: mutable usize = 0
    while i < length:
        if candidate[i] != best[i]: return candidate[i] > best[i]
        i <- i + 1
    False

def cmn_impl(input: view[i64], length: usize,
             staged: mutable view[u8]) -> i64:
    if length < 3 or length > CMN_MAX_INPUT: return -1
    first_value: i64 = input[0]
    second_value: i64 = input[1]
    if first_value < 0 or first_value > CMN_MAX_SOURCE.i64() or
        second_value < 0 or second_value > CMN_MAX_SOURCE.i64(): return -1
    first_length: usize = first_value.usize()
    second_length: usize = second_value.usize()
    requested_value: i64 = input[2]
    if requested_value < 0 or requested_value > (first_length + second_length).i64(): return -1
    requested: usize = requested_value.usize()
    if length != 3 + first_length + second_length: return -1
    i: mutable usize = 0
    while i < first_length + second_length:
        if input[3 + i] < 0 or input[3 + i] > 9: return -1
        i <- i + 1

    minimum_first: usize = if requested > second_length: requested - second_length else: 0
    maximum_first: usize = if requested < first_length: requested else: first_length
    best: mutable u8[CMN_MAX_OUTPUT] = zeroed
    candidate: mutable u8[CMN_MAX_OUTPUT] = zeroed
    selected_a: mutable u8[CMN_MAX_SOURCE] = zeroed
    selected_b: mutable u8[CMN_MAX_SOURCE] = zeroed
    have_best: mutable bool = False
    take_first: mutable usize = minimum_first
    while take_first <= maximum_first:
        first_length_selected: usize = cmn_subsequence(
            input[3:3 + first_length], take_first, selected_a[0:CMN_MAX_SOURCE])
        second_length_selected: usize = cmn_subsequence(
            input[3 + first_length:3 + first_length + second_length],
            requested - take_first, selected_b[0:CMN_MAX_SOURCE])
        candidate_length: usize = cmn_merge(
            selected_a[0:first_length_selected], first_length_selected,
            selected_b[0:second_length_selected], second_length_selected,
            candidate[0:CMN_MAX_OUTPUT])
        if not have_best or cmn_greater(candidate[0:candidate_length], best[0:candidate_length], candidate_length):
            i <- 0
            while i < candidate_length:
                best[i] <- candidate[i]
                i <- i + 1
            have_best <- True
        take_first <- take_first + 1
    i <- 0
    while i < requested:
        staged[i] <- best[i]
        i <- i + 1
    requested.i64()

export fn create_maximum_number(input: i64&, length: usize,
                                output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > CMN_MAX_INPUT: return -1
    values: view[i64] = input[0:length]
    staged: mutable u8[CMN_MAX_OUTPUT] = zeroed
    answer: i64 = cmn_impl(values, length, staged[0:CMN_MAX_OUTPUT])
    if answer < 0: return answer
    if output.is_null() or capacity < answer.usize(): return -2
    output_view: mutable view[u8] = output[0:answer.usize()]
    i: mutable usize = 0
    while i < answer.usize():
        output_view[i] <- staged[i]
        i <- i + 1
    answer
