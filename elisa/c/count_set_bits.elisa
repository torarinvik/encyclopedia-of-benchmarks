@intrinsic("llvm.ctlz.i32")
extern leading_zeros(value: u32, zero_undefined: bool) -> u32

# Count set bits across every integer from 1 through value, inclusive.
def count_set_bits_impl(value: i64) -> i64:
    if value.u64() > 67108863:
        return -1
    remaining: mutable u32 = value.u32()
    return 0 if remaining == 0
    # In a complete power-of-two block, each bit is set in half the values.
    if (remaining & (remaining + 1)) == 0:
        width: u32 = 31 - leading_zeros(remaining + 1, true)
        return (width * ((remaining + 1) >> 1)).i64()
    total: mutable u32 = 0
    while remaining != 0:
        # The lower full block contributes position * power / 2 set bits.
        position: u32 = 31 - leading_zeros(remaining, true)
        power: u32 = 1.u32() << position
        remaining <- remaining - power
        total <- total + position * (power >> 1) + remaining + 1
    total.i64()

export fn count_set_bits(value: i64) -> i64 = count_set_bits_impl
