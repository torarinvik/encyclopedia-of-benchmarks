# Sort a private copy, then scan neighbors for duplicates.
def contains_duplicate_impl(input: i64&, length: usize) -> i64:
    if length > 1024:
        return -1
    values: mutable i64[1024] = zeroed
    index: mutable usize = 0
    while index < length:
        value: i64 = input[index]
        if value < -2147483648 or value > 2147483647:
            return -1
        values[index] <- value
        index <- index + 1

    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        root: mutable usize = start
        while root < length / 2:
            child: mutable usize = root * 2 + 1
            if child + 1 < length and values[child] < values[child + 1]:
                child <- child + 1
            if values[root] >= values[child]:
                break
            temporary: i64 = values[root]
            values[root] <- values[child]
            values[child] <- temporary
            root <- child

    ending: mutable usize = length
    while ending > 1:
        ending <- ending - 1
        temporary: i64 = values[0]
        values[0] <- values[ending]
        values[ending] <- temporary
        root: mutable usize = 0
        while root < ending / 2:
            child: mutable usize = root * 2 + 1
            if child + 1 < ending and values[child] < values[child + 1]:
                child <- child + 1
            if values[root] >= values[child]:
                break
            temporary <- values[root]
            values[root] <- values[child]
            values[child] <- temporary
            root <- child

    index <- 1
    while index < length:
        if values[index - 1] == values[index]:
            return 1
        index <- index + 1
    0

export fn contains_duplicate(input: i64&, length: usize) -> i64 = contains_duplicate_impl
