const CCEC_N: usize = 8
const CCEC_M: usize = 18
const CCEC_F: usize = 12
const CCEC_INPUT_MAX: usize = 55
const CCEC_WORKSPACE_BYTES: usize = 8192

def ccec_find_root(parent: mutable view[i64], start: usize) -> usize:
    x: mutable usize = start
    while parent[x].usize() != x:
        parent[x] <- parent[parent[x].usize()]
        x <- parent[x].usize()
    x

def ccec_connected(adjacent: view[i64], n: usize, mask: usize) -> bool:
    start: mutable i64 = -1
    expected: mutable usize = 0
    for v in 0..<n:
        if ((mask >> v) & 1) != 0:
            if start < 0: start <- v.i64()
            expected <- expected + 1
    if expected <= 1: return true
    seen: mutable bool[8] = zeroed
    queue: mutable usize[8] = zeroed
    head: mutable usize = 0
    tail: mutable usize = 1
    seen[start.usize()] <- true
    queue[0] <- start.usize()
    while head < tail:
        u: usize = queue[head]
        head <- head + 1
        for v in 0..<n:
            if ((mask >> v) & 1) != 0 and adjacent[u * 8 + v] != 0 and not seen[v]:
                seen[v] <- true
                queue[tail] <- v
                tail <- tail + 1
    tail == expected

def ccec_solve(values: view[i64]) -> i64:
    length: usize = values.len()
    if length < 4 or length > CCEC_INPUT_MAX: return -1
    n0: i64 = values[0]
    c0: i64 = values[1]
    if n0 < 3 or n0 > 8 or c0 < 0 or c0 > n0 - 2: return -1
    n: usize = n0.usize()
    c: usize = c0.usize()
    if values[2] < 0 or values[2] >= n0 or values[3] < 0 or values[3] >= n0 or values[2] == values[3]: return -1
    outer_u: usize = values[2].usize()
    outer_v: usize = values[3].usize()
    offset: mutable usize = 4
    degree: mutable i64[8] = zeroed
    rotation: mutable i64[64] = zeroed
    adjacent: mutable i64[64] = zeroed
    degree_sum: mutable usize = 0
    for u in 0..<n:
        if offset >= length: return -1
        d0: i64 = values[offset]
        offset <- offset + 1
        if d0 < 1 or d0 >= n0 or offset + d0.usize() > length: return -1
        d: usize = d0.usize()
        degree[u] <- d0
        degree_sum <- degree_sum + d
        row_seen: mutable bool[8] = zeroed
        for i in 0..<d:
            raw: i64 = values[offset]
            offset <- offset + 1
            if raw < 0 or raw >= n0 or raw == u.i64() or row_seen[raw.usize()]: return -1
            row_seen[raw.usize()] <- true
            rotation[u * 8 + i] <- raw
            adjacent[u * 8 + raw.usize()] <- 1
    if degree_sum % 2 != 0 or offset + c != length: return -1
    m: usize = degree_sum / 2
    if m < n - 1 or m > CCEC_M or adjacent[outer_u * 8 + outer_v] == 0: return -1
    edge_u: mutable i64[18] = zeroed
    edge_v: mutable i64[18] = zeroed
    edge_count: mutable usize = 0
    for u in 0..<n:
        for v in 0..<n:
            if adjacent[u * 8 + v] != adjacent[v * 8 + u]: return -1
            if u < v and adjacent[u * 8 + v] != 0:
                edge_u[edge_count] <- u.i64()
                edge_v[edge_count] <- v.i64()
                edge_count <- edge_count + 1
    if edge_count != m: return -1
    full: usize = (1 << n) - 1
    masks: mutable i64[8] = zeroed
    for i in 0..<c:
        raw: i64 = values[offset + i]
        if raw <= 0 or raw >= full.i64(): return -1
        mask: usize = raw.usize()
        bits: mutable usize = 0
        for v in 0..<n: bits <- bits + ((mask >> v) & 1)
        if bits < 2: return -1
        for j in 0..<i:
            prior: usize = masks[j].usize()
            if prior == mask: return -1
            common: usize = prior & mask
            if common != 0 and common != prior and common != mask: return -1
        masks[i] <- raw
        if not ccec_connected(adjacent[0:64], n, mask): return -1
    if not ccec_connected(adjacent[0:64], n, full): return -1

    face_of: mutable i64[64] = zeroed
    for i in 0..<64: face_of[i] <- -1
    face_count: mutable usize = 0
    for e in 0..<m:
        for side in 0..<2:
            su: usize = if side == 0: edge_u[e].usize() else: edge_v[e].usize()
            sv: usize = if side == 0: edge_v[e].usize() else: edge_u[e].usize()
            if face_of[su * 8 + sv] >= 0: continue
            if face_count >= CCEC_F: return -1
            local: mutable bool[64] = zeroed
            u: mutable usize = su
            v: mutable usize = sv
            steps: mutable usize = 0
            while true:
                if local[u * 8 + v] or face_of[u * 8 + v] >= 0: return -1
                local[u * 8 + v] <- true
                face_of[u * 8 + v] <- face_count.i64()
                at: mutable i64 = -1
                for i in 0..<degree[v].usize():
                    if rotation[v * 8 + i] == u.i64(): at <- i.i64()
                if at < 0: return -1
                next: usize = rotation[v * 8 + ((at.usize() + 1) % degree[v].usize())].usize()
                u <- v
                v <- next
                if u == su and v == sv: break
                steps <- steps + 1
                if steps > 2 * m: return -1
            face_count <- face_count + 1
    if face_count != m - n + 2: return -1
    for u in 0..<n:
        for v in 0..<n:
            if adjacent[u * 8 + v] != 0 and face_of[u * 8 + v] < 0: return -1
    outer_face: usize = face_of[outer_u * 8 + outer_v].usize()

    for ci in 0..<c:
        mask: usize = masks[ci].usize()
        parent: mutable i64[12] = zeroed
        for f in 0..<face_count: parent[f] <- f.i64()
        for e in 0..<m:
            u: usize = edge_u[e].usize()
            v: usize = edge_v[e].usize()
            if ((mask >> u) & 1) != 0 and ((mask >> v) & 1) != 0: continue
            a: usize = ccec_find_root(parent[0:12], face_of[u * 8 + v].usize())
            b: usize = ccec_find_root(parent[0:12], face_of[v * 8 + u].usize())
            parent[a] <- b.i64()
        outside: usize = ccec_find_root(parent[0:12], outer_face)
        for v in 0..<n:
            if ((mask >> v) & 1) != 0: continue
            incident: mutable bool = false
            for u in 0..<n:
                if adjacent[v * 8 + u] != 0:
                    incident <- true
                    if ccec_find_root(parent[0:12], face_of[v * 8 + u].usize()) != outside: return 0
            if not incident: return -1
        for e in 0..<m:
            u: usize = edge_u[e].usize()
            v: usize = edge_v[e].usize()
            if ((mask >> u) & 1) != 0 and ((mask >> v) & 1) != 0: continue
            if ccec_find_root(parent[0:12], face_of[u * 8 + v].usize()) != outside: return 0
    1

export fn c_connected_clustered_embedding_condition(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4 or length > CCEC_INPUT_MAX: return -1
    let values: view[i64] = input[0:length]
    ccec_solve(values)
