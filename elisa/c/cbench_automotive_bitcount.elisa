const AUTOMOTIVE_BITCOUNT_MAX_ITERATIONS: i64 = 1_125_000
const AUTOMOTIVE_BITCOUNT_NIBBLE_BITS: i32[16] = [0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4]
const AUTOMOTIVE_BITCOUNT_INITIAL_SEEDS: i64[7] = [1, 1, 1, 1, 1, 1, 1]

def cbench_automotive_bitcount_kernighan(value: u32) -> i32:
    count: mutable i32 = 0
    while value != 0:
        value <- value & (value - 1)
        count <- count + 1
    count

def cbench_automotive_bitcount_parallel(value_input: u32) -> i32:
    value: mutable u32 = value_input
    value <- ((value & 0xAAAAAAAA) >> 1) + (value & 0x55555555)
    value <- ((value & 0xCCCCCCCC) >> 2) + (value & 0x33333333)
    value <- ((value & 0xF0F0F0F0) >> 4) + (value & 0x0F0F0F0F)
    value <- ((value & 0xFF00FF00) >> 8) + (value & 0x00FF00FF)
    value <- ((value & 0xFFFF0000) >> 16) + (value & 0x0000FFFF)
    value.i32()

def cbench_automotive_bitcount_recursive_nybbles(value: u32) -> i32:
    count: i32 = AUTOMOTIVE_BITCOUNT_NIBBLE_BITS[(value & 0xF).usize()]
    if value >> 4 == 0:
        return count
    count + cbench_automotive_bitcount_recursive_nybbles(value >> 4)

def cbench_automotive_bitcount_fixed_nybbles(value: u32) -> i32:
    count: mutable i32 = 0
    shift: mutable u32 = 0
    while shift < 32:
        count <- count + AUTOMOTIVE_BITCOUNT_NIBBLE_BITS[((value >> shift) & 0xF).usize()]
        shift <- shift + 4
    count

def cbench_automotive_bitcount_byte(value: u32) -> i32:
    AUTOMOTIVE_BITCOUNT_NIBBLE_BITS[(value & 0xF).usize()] + AUTOMOTIVE_BITCOUNT_NIBBLE_BITS[((value >> 4) & 0xF).usize()]

def cbench_automotive_bitcount_bw_bytes(value: u32) -> i32:
    cbench_automotive_bitcount_byte(value) + cbench_automotive_bitcount_byte(value >> 8) +
    cbench_automotive_bitcount_byte(value >> 24) + cbench_automotive_bitcount_byte(value >> 16)

def cbench_automotive_bitcount_ar_bytes(value: u32) -> i32:
    count: mutable i32 = 0
    index: mutable u32 = 0
    while index < 4:
        count <- count + cbench_automotive_bitcount_byte(value >> (index * 8))
        index <- index + 1
    count

def cbench_automotive_bitcount_shift_test(value_input: u32) -> i32:
    value: mutable u32 = value_input
    count: mutable i32 = 0
    bit: mutable u32 = 0
    while bit < 64 and value != 0:
        count <- count + (value & 1).i32()
        value <- value >> 1
        bit <- bit + 1
    count

def cbench_automotive_bitcount_selected(algorithm: usize, value: u32) -> i32:
    if algorithm == 0:
        return cbench_automotive_bitcount_kernighan(value)
    if algorithm == 1:
        return cbench_automotive_bitcount_parallel(value)
    if algorithm == 2:
        return cbench_automotive_bitcount_recursive_nybbles(value)
    if algorithm == 3:
        return cbench_automotive_bitcount_fixed_nybbles(value)
    if algorithm == 4:
        return cbench_automotive_bitcount_bw_bytes(value)
    if algorithm == 5:
        return cbench_automotive_bitcount_ar_bytes(value)
    cbench_automotive_bitcount_shift_test(value)

def cbench_automotive_bitcount_impl(iterations: i64) -> i64:
    if iterations < 0 or iterations > AUTOMOTIVE_BITCOUNT_MAX_ITERATIONS:
        return -1
    result: mutable i64 = 0
    algorithm: mutable usize = 0
    while algorithm < 7:
        seed: mutable i64 = AUTOMOTIVE_BITCOUNT_INITIAL_SEEDS[algorithm]
        total: mutable i64 = 0
        iteration: mutable i64 = 0
        while iteration < iterations:
            total <- total + cbench_automotive_bitcount_selected(algorithm, seed.u32()).i64()
            seed <- seed + 13
            iteration <- iteration + 1
        result <- result + (algorithm + 1).i64() * total
        algorithm <- algorithm + 1
    result

export fn cbench_automotive_bitcount(iterations: i64) -> i64 = cbench_automotive_bitcount_impl
