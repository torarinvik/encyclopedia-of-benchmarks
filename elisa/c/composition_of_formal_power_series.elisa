const FPS_MODULUS: i64 = 998_244_353
const FPS_MAX_N: usize = 16
const FPS_MAX_INPUT: usize = 34

def fps_store_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def composition_of_formal_power_series_impl(input: view[i64], length: usize,
    output: mutable view[u8], capacity: usize, output_is_null: bool) -> i64:
    if length < 3 or length > FPS_MAX_INPUT: return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > FPS_MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n: return -1
    for i in 0..<(2 * n):
        coefficient: i64 = input[i + 1]
        if coefficient < 0 or coefficient >= FPS_MODULUS: return -1
    if input[1 + n] != 0: return -1
    bytes: usize = 8 * n
    if output_is_null or capacity < bytes: return -2

    composed: mutable [FPS_MAX_N]i64 = [0; FPS_MAX_N]
    outer: mutable usize = n
    while outer > 0:
        bound: mutable usize = n
        while bound > 1:
            degree: usize = bound - 1
            sum: mutable i64 = 0
            for inner_degree in 1..<(degree + 1):
                sum <- (sum + composed[degree - inner_degree] * input[1 + n + inner_degree]) % FPS_MODULUS
            composed[degree] <- sum
            bound <- bound - 1
        composed[0] <- input[outer]
        outer <- outer - 1
    for i in 0..<n: fps_store_le(composed[i], output, 8 * i)
    bytes.i64()

export fn composition_of_formal_power_series(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > FPS_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return composition_of_formal_power_series_impl(input_view, length, scratch[0:1], 0, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > 8 * FPS_MAX_N: safe_capacity <- 8 * FPS_MAX_N
    output_view: mutable view[u8] = output[0:safe_capacity]
    composition_of_formal_power_series_impl(input_view, length, output_view, capacity, false)
