const MAX_N: usize = 256
const HASH_CAPACITY: usize = 512

def hash_slot(value: i32) -> usize:
    bits: u32 = value.u32()
    mixed: u64 = bits.u64() * 2654435761.u64()
    (mixed.u32() >> 23).usize()

def find_slot(keys: view[i32], occupied: view[bool], value: i32) -> usize:
    for probes in 0..<HASH_CAPACITY|slot: usize = hash_slot(value)|:
        if not occupied[slot] or keys[slot] == value:
            return slot
        slot <- (slot + 1) % HASH_CAPACITY
    0

def store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    for byte in 0..<8|output, bits:u64 = value.u64()|:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def count_distinct_elements_in_window_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if true in {input == null,length < 3, input[0] < 1, input[0] > MAX_N.i64()}:
        return -1
    n: usize = input[0].usize()
    if true in {input[1] < 1, input[1] > n.i64(), length != n + 2}:
        return -1
    k: usize = input[1].usize()
    out_n: usize = n - k + 1
    for i in 0..<n:
        underflow = input[i + 2] < -2147483648
        overflow = input[i + 2] > 2147483647
        return -1 if underflow or overflow
        return -2 if output == null or capacity < out_n * 8

    keys: mutable i32[HASH_CAPACITY]
    counts: mutable i32[HASH_CAPACITY]
    occupied: mutable bool[HASH_CAPACITY]
    for i in 0..<HASH_CAPACITY:
        counts[i] <- 0
        occupied[i] <- false
    distinct: mutable i64 = 0
    for i in 0..<k:
        value: i32 = input[i + 2].i32()
        slot: usize = find_slot(keys[0:HASH_CAPACITY], occupied[0:HASH_CAPACITY], value)
        if not occupied[slot]:
            keys[slot] <- value
            occupied[slot] <- true
            counts[slot] <- 0
        if counts[slot] == 0:
            distinct <- distinct + 1
        counts[slot] <- counts[slot] + 1
    store_i64_le(distinct, output[0:capacity], 0)
    for i in k..<n:
        incoming: i32 = input[i + 2].i32()
        slot: usize = find_slot(keys[0:HASH_CAPACITY], occupied[0:HASH_CAPACITY], incoming)
        if not occupied[slot]:
            keys[slot] <- incoming
            occupied[slot] <- true
            counts[slot] <- 0
        if counts[slot] == 0:
            distinct <- distinct + 1
        counts[slot] <- counts[slot] + 1
        outgoing: i32 = input[i - k + 2].i32()
        slot <- find_slot(keys[0:HASH_CAPACITY], occupied[0:HASH_CAPACITY], outgoing)
        counts[slot] <- counts[slot] - 1
        if counts[slot] == 0:
            distinct <- distinct - 1
        store_i64_le(distinct, output[0:capacity], (i - k + 1) * 8)
    (out_n * 8).i64()

export fn count_distinct_elements_in_window(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = count_distinct_elements_in_window_impl
