const MAX_BUCKETS: usize = 127
const MAX_OPERATIONS: usize = 128
const MAX_INPUT_LENGTH: usize = 260
const MAX_KEY: i64 = 2147483647

def chaining_impl(input: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_INPUT_LENGTH: return -1
    bucket_count_value: i64 = input[0]
    operation_count_value: i64 = input[1]
    if bucket_count_value < 1 or bucket_count_value > MAX_BUCKETS.i64() or operation_count_value < 0 or operation_count_value > MAX_OPERATIONS.i64():
        return -1
    bucket_count: usize = bucket_count_value.usize()
    operation_count: usize = operation_count_value.usize()
    if length != 2 + 2 * operation_count: return -1

    heads: mutable i64[MAX_BUCKETS] = zeroed
    keys: mutable i64[MAX_OPERATIONS] = zeroed
    next: mutable i64[MAX_OPERATIONS] = zeroed
    bucket: mutable usize = 0
    while bucket < bucket_count |bucket, bucket_count, heads|:
        heads[bucket] <- -1
        bucket <- bucket + 1

    inserted: mutable usize = 0
    query_count: mutable usize = 0
    result: mutable i64 = 0
    operation_index: mutable usize = 0
    while operation_index < operation_count |operation_index, operation_count, input, bucket_count, keys, next, heads, inserted, query_count, result|:
        offset: usize = 2 + 2 * operation_index
        operation: i64 = input[offset]
        key: i64 = input[offset + 1]
        if (operation != 0 and operation != 1) or key < 0 or key > MAX_KEY: return -1
        key_bucket: usize = key.usize() % bucket_count
        if operation == 0:
            if inserted >= MAX_OPERATIONS: return -1
            keys[inserted] <- key
            next[inserted] <- -1
            if heads[key_bucket] < 0:
                heads[key_bucket] <- inserted.i64()
            else:
                node: mutable i64 = heads[key_bucket]
                while next[node.usize()] >= 0 |node, next|:
                    node <- next[node.usize()]
                next[node.usize()] <- inserted.i64()
            inserted <- inserted + 1
        else:
            if query_count >= 63: return -1
            node: mutable i64 = heads[key_bucket]
            while node >= 0 |node, key, keys, next|:
                if keys[node.usize()] == key:
                    break
                node <- next[node.usize()]
            if node >= 0:
                result <- result + (1 << query_count)
            query_count <- query_count + 1
        operation_index <- operation_index + 1
    result

export fn chaining(input: i64&, length: usize) -> i64 = chaining_impl
