# Cross-entropy loss with source-ordered intermediate terms and summation.
extern log(value: f64) -> f64
const MAX_COUNT: i64 = 64
const SCALE: f64 = 1000000.0

def cross_entropy_loss_impl(values: i64&, length: usize) -> f64:
    if length < 1:
        return -1.0e300
    count: i64 = values[0]
    if count < 1 or count > MAX_COUNT or length != 1 + (2 * count).usize():
        return -1.0e300
    terms: mutable f64[64] = zeroed
    index: mutable usize = 0
    while index < count.usize():
        actual_scaled: i64 = values[1 + index]
        predicted_scaled: i64 = values[1 + count.usize() + index]
        if actual_scaled < 0 or actual_scaled > 1000000 or predicted_scaled < 1 or predicted_scaled > 1000000:
            return -1.0e300
        actual: f64 = actual_scaled.f64() / SCALE
        predicted: f64 = predicted_scaled.f64() / SCALE
        terms[index] <- -actual * log(predicted)
        index <- index + 1
    total: mutable f64 = 0.0
    index <- 0
    while index < count.usize():
        total <- total + terms[index]
        index <- index + 1
    total

export fn cross_entropy_loss(values: i64&, length: usize) -> f64 = cross_entropy_loss_impl
