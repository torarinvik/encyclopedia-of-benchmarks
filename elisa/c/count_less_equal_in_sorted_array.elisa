def count_less_equal_in_sorted_array_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > 513:
        return -1
    key: i64 = input[0]
    if key < -2147483648 or key > 2147483647:
        return -1
    for index in 1..<length |input|:
        value: i64 = input[index]
        if value < -2147483648 or value > 2147483647:
            return -1
        if index > 1 and input[index - 1] > value:
            return -1

    left: mutable usize = 1
    right: mutable usize = length - 1
    count: mutable usize = 0
    while left <= right |left, right, count, input, key|:
        middle: usize = left + (right - left) / 2
        if input[middle] > key:
            right <- middle - 1
        else:
            count <- middle
            left <- middle + 1
    count.i64()

export fn count_less_equal_in_sorted_array(input: i64&, length: usize) -> i64 = count_less_equal_in_sorted_array_impl
