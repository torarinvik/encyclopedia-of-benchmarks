const MAX_POINTS: usize = 1024

def closest_pair_before(left: usize, right: usize, points: view[i64], by_y: bool) -> bool:
    if by_y:
        if points[2 * left + 1] != points[2 * right + 1]:
            return points[2 * left + 1] < points[2 * right + 1]
        if points[2 * left] != points[2 * right]:
            return points[2 * left] < points[2 * right]
    else:
        if points[2 * left] != points[2 * right]:
            return points[2 * left] < points[2 * right]
        if points[2 * left + 1] != points[2 * right + 1]:
            return points[2 * left + 1] < points[2 * right + 1]
    left < right

def closest_pair_sort_indices(indices: mutable view[usize], scratch: mutable view[usize],
        begin: usize, end: usize, points: view[i64], by_y: bool) -> void:
    if end - begin < 2:
        return
    middle: usize = begin + (end - begin) / 2
    closest_pair_sort_indices(indices, scratch, begin, middle, points, by_y)
    closest_pair_sort_indices(indices, scratch, middle, end, points, by_y)
    left: mutable usize = begin
    right: mutable usize = middle
    out: mutable usize = begin
    while left < middle and right < end:
        if closest_pair_before(indices[right], indices[left], points, by_y):
            scratch[out] <- indices[right]
            right <- right + 1
        else:
            scratch[out] <- indices[left]
            left <- left + 1
        out <- out + 1
    while left < middle:
        scratch[out] <- indices[left]
        left <- left + 1
        out <- out + 1
    while right < end:
        scratch[out] <- indices[right]
        right <- right + 1
        out <- out + 1
    index: mutable usize = begin
    while index < end:
        indices[index] <- scratch[index]
        index <- index + 1

def closest_pair_squared_distance(left: usize, right: usize, points: view[i64]) -> i64:
    dx: i64 = points[2 * left] - points[2 * right]
    dy: i64 = points[2 * left + 1] - points[2 * right + 1]
    dx * dx + dy * dy

def closest_pair_copy_result(source: view[i64], destination: mutable view[i64]) -> void:
    index: mutable usize = 0
    while index < 4:
        destination[index] <- source[index]
        index <- index + 1

def closest_pair_choose(left: view[i64], right: view[i64], result: mutable view[i64]) -> void:
    if left[0] == 0:
        closest_pair_copy_result(right, result)
        return
    if right[0] == 0:
        closest_pair_copy_result(left, result)
        return
    take_left: bool = (left[1] < right[1] or
        (left[1] == right[1] and (left[2] < right[2] or (left[2] == right[2] and left[3] <= right[3]))))
    if take_left:
        closest_pair_copy_result(left, result)
    else:
        closest_pair_copy_result(right, result)

def closest_pair_make_candidate(left_value: usize, right_value: usize, points: view[i64],
        result: mutable view[i64]) -> void:
    left: mutable usize = left_value
    right: mutable usize = right_value
    if left > right:
        temporary: usize = left
        left <- right
        right <- temporary
    result[0] <- 1
    result[1] <- closest_pair_squared_distance(left, right, points)
    result[2] <- left.i64()
    result[3] <- right.i64()

def closest_pair_search(x_order: view[usize], begin: usize, end: usize,
        y_order: view[usize], y_count: usize, rank: view[usize], points: view[i64],
        result: mutable view[i64]) -> void:
    count: usize = end - begin
    if count <= 3:
        result[0] <- 0
        result[1] <- 0
        result[2] <- 0
        result[3] <- 0
        i: mutable usize = begin
        while i < end:
            j: mutable usize = i + 1
            while j < end:
                current: mutable i64[4] = zeroed
                chosen: mutable i64[4] = zeroed
                closest_pair_make_candidate(x_order[i], x_order[j], points, current[0:4])
                closest_pair_choose(result, current[0:4], chosen[0:4])
                closest_pair_copy_result(chosen[0:4], result)
                j <- j + 1
            i <- i + 1
        return

    middle: usize = begin + count / 2
    y_left: mutable usize[MAX_POINTS] = zeroed
    y_right: mutable usize[MAX_POINTS] = zeroed
    left_count: mutable usize = 0
    right_count: mutable usize = 0
    index: mutable usize = 0
    while index < y_count:
        point: usize = y_order[index]
        if rank[point] < middle:
            y_left[left_count] <- point
            left_count <- left_count + 1
        else:
            y_right[right_count] <- point
            right_count <- right_count + 1
        index <- index + 1

    left_result: mutable i64[4] = zeroed
    right_result: mutable i64[4] = zeroed
    best: mutable i64[4] = zeroed
    closest_pair_search(x_order, begin, middle, y_left[0:left_count], left_count, rank, points, left_result[0:4])
    closest_pair_search(x_order, middle, end, y_right[0:right_count], right_count, rank, points, right_result[0:4])
    closest_pair_choose(left_result[0:4], right_result[0:4], best[0:4])

    strip: mutable usize[MAX_POINTS] = zeroed
    strip_count: mutable usize = 0
    middle_x: i64 = points[2 * x_order[middle]]
    index <- 0
    while index < y_count:
        point: usize = y_order[index]
        dx: i64 = points[2 * point] - middle_x
        if dx * dx <= best[1]:
            strip[strip_count] <- point
            strip_count <- strip_count + 1
        index <- index + 1
    i: mutable usize = 0
    while i < strip_count:
        j: mutable usize = i + 1
        while j < strip_count:
            dy: i64 = points[2 * strip[j] + 1] - points[2 * strip[i] + 1]
            if dy * dy > best[1]:
                break
            current: mutable i64[4] = zeroed
            chosen: mutable i64[4] = zeroed
            closest_pair_make_candidate(strip[i], strip[j], points, current[0:4])
            closest_pair_choose(best[0:4], current[0:4], chosen[0:4])
            closest_pair_copy_result(chosen[0:4], best[0:4])
            j <- j + 1
        i <- i + 1
    closest_pair_copy_result(best[0:4], result)

def closest_pair_write_index(output: mutable view[u8], start: usize, value: i64) -> void:
    byte: mutable usize = 0
    while byte < 4:
        output[start + byte] <- ((value >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def closest_pair_divide_and_conquer_impl(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if length > 2 * MAX_POINTS or length % 2 != 0:
        return -1
    point_count: usize = length / 2

    x_order: mutable usize[MAX_POINTS] = zeroed
    y_order: mutable usize[MAX_POINTS] = zeroed
    rank: mutable usize[MAX_POINTS] = zeroed
    scratch: mutable usize[MAX_POINTS] = zeroed
    index: mutable usize = 0
    while index < point_count:
        x: i64 = values[2 * index]
        y: i64 = values[2 * index + 1]
        if x < -1000000000 or x > 1000000000 or y < -1000000000 or y > 1000000000:
            return -1
        x_order[index] <- index
        y_order[index] <- index
        index <- index + 1
    if point_count < 2:
        return 0
    closest_pair_sort_indices(x_order[0:point_count], scratch[0:point_count], 0, point_count, values[0:length], false)
    index <- 0
    while index < point_count:
        rank[x_order[index]] <- index
        index <- index + 1

    duplicate: mutable i64[4] = zeroed
    begin: mutable usize = 0
    while begin < point_count:
        end: mutable usize = begin + 1
        anchor: usize = x_order[begin]
        while (end < point_count and values[2 * x_order[end]] == values[2 * anchor] and
                values[2 * x_order[end] + 1] == values[2 * anchor + 1]):
            end <- end + 1
        if end - begin > 1:
            first: mutable usize = MAX_POINTS
            second: mutable usize = MAX_POINTS
            group_index: mutable usize = begin
            while group_index < end:
                id: usize = x_order[group_index]
                if id < first:
                    second <- first
                    first <- id
                elif id < second:
                    second <- id
                group_index <- group_index + 1
            current: mutable i64[4] = zeroed
            chosen: mutable i64[4] = zeroed
            current[0] <- 1
            current[2] <- first.i64()
            current[3] <- second.i64()
            closest_pair_choose(duplicate[0:4], current[0:4], chosen[0:4])
            closest_pair_copy_result(chosen[0:4], duplicate[0:4])
        begin <- end

    best: mutable i64[4] = zeroed
    if duplicate[0] != 0:
        closest_pair_copy_result(duplicate[0:4], best[0:4])
    else:
        closest_pair_sort_indices(y_order[0:point_count], scratch[0:point_count], 0, point_count, values[0:length], true)
        closest_pair_search(x_order[0:point_count], 0, point_count, y_order[0:point_count], point_count,
            rank[0:point_count], values[0:length], best[0:4])
    if best[0] == 0:
        return -1
    if output_capacity < 8:
        return -2
    closest_pair_write_index(output[0:8], 0, best[2])
    closest_pair_write_index(output[0:8], 4, best[3])
    2

export fn closest_pair_divide_and_conquer(values: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = closest_pair_divide_and_conquer_impl
