const ECC_MIN_N: usize = 3
const ECC_MAX_N: usize = 6
const ECC_MAX_LENGTH: usize = 14
const ECC_MAX_TRI: usize = 4
const ECC_MAX_ALL: usize = 14
const ECC_MAX_DIAG: usize = 9
const ECC_MAX_TRIPLES: usize = 20

struct EccPoint:
    x: i64
    y: i64

struct EccTriangle:
    a: usize
    b: usize
    c: usize

struct EccTriangulation:
    triangles: EccTriangle[ECC_MAX_TRI]
    count: mutable usize
    edges: mutable i64

struct EccFraction:
    num: i64
    den: i64

struct EccMetrics:
    maximum: mutable EccFraction
    worst: mutable i64

def ecc_orient(points: view[EccPoint], a: usize, b: usize, c: usize) -> i64:
    (points[b].x-points[a].x)*(points[c].y-points[a].y)-(points[b].y-points[a].y)*(points[c].x-points[a].x)

def ecc_abs(value: i64) -> i64:
    -value if value < 0 else value

def ecc_gcd(a_value: i64, b_value: i64) -> i64:
    a: mutable i64 = a_value
    b: mutable i64 = b_value
    while b != 0:
        remainder: i64 = a % b
        a <- b
        b <- remainder
    a

def ecc_fraction(numerator: i64, denominator: i64) -> EccFraction:
    divisor: i64 = ecc_gcd(numerator, denominator)
    EccFraction{num: numerator/divisor, den: denominator/divisor}

def ecc_compare(a: EccFraction, b: EccFraction) -> i64:
    left: i64 = a.num*b.den
    right: i64 = b.num*a.den
    if left < right: return -1
    if left > right: return 1
    0

def ecc_edge_bit(a: usize, b: usize) -> i64:
    low: usize = a if a < b else b
    high: usize = b if a < b else a
    1.i64() << (low*ECC_MAX_N+high).u32()

def ecc_crosses(points: view[EccPoint], a: usize, b: usize, c: usize, d: usize) -> bool:
    ecc_orient(points,a,b,c)*ecc_orient(points,a,b,d)<0 and ecc_orient(points,c,d,a)*ecc_orient(points,c,d,b)<0

def ecc_inside(points: view[EccPoint], triangle: EccTriangle, vertex: usize) -> bool:
    direction: i64 = ecc_orient(points,triangle.a,triangle.b,triangle.c)
    ecc_orient(points,triangle.a,triangle.b,vertex)*direction>0 and ecc_orient(points,triangle.b,triangle.c,vertex)*direction>0 and ecc_orient(points,triangle.c,triangle.a,vertex)*direction>0

def ecc_triangle_score(points: view[EccPoint], triangle: EccTriangle,
                       sides: mutable view[i64]) -> EccFraction:
    a: EccPoint = points[triangle.a]
    b: EccPoint = points[triangle.b]
    c: EccPoint = points[triangle.c]
    sides[0] <- (b.x-c.x)*(b.x-c.x)+(b.y-c.y)*(b.y-c.y)
    sides[1] <- (c.x-a.x)*(c.x-a.x)+(c.y-a.y)*(c.y-a.y)
    sides[2] <- (a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y)
    largest: mutable usize = 0
    if sides[1] > sides[largest]: largest <- 1
    if sides[2] > sides[largest]: largest <- 2
    other: i64 = sides[0]+sides[1]+sides[2]-sides[largest]
    if sides[largest] <= other: return EccFraction{num:0,den:1}
    area: i64 = ecc_abs(ecc_orient(points,triangle.a,triangle.b,triangle.c))
    difference: i64 = sides[largest]-other
    ecc_fraction(sides[largest]*difference*difference,16*area*area)

def ecc_triangle_id(a: usize, b: usize, c: usize, n: usize) -> usize:
    id: mutable usize = 0
    x: mutable usize = 0
    while x < n:
        y: mutable usize = x+1
        while y < n:
            z: mutable usize = y+1
            while z < n:
                if x==a and y==b and z==c: return id
                id <- id+1
                z <- z+1
            y <- y+1
        x <- x+1
    0

def ecc_evaluate(points: view[EccPoint], n: usize, triangulation: EccTriangulation) -> EccMetrics:
    result: mutable EccMetrics = EccMetrics{maximum:EccFraction{num:0,den:1},worst:0}
    i: mutable usize = 0
    while i < triangulation.count:
        triangle: EccTriangle = triangulation.triangles[i]
        sides: mutable i64[3] = zeroed
        score: EccFraction = ecc_triangle_score(points,triangle,sides[0:3])
        comparison: i64 = ecc_compare(score,result.maximum)
        bit: i64 = 1.i64() << ecc_triangle_id(triangle.a,triangle.b,triangle.c,n).u32()
        if comparison > 0:
            result.maximum <- score
            result.worst <- bit
        elif comparison == 0:
            result.worst <- result.worst | bit
        i <- i+1
    result

def ecc_improves(candidate: EccMetrics, current: EccMetrics) -> bool:
    comparison: i64 = ecc_compare(candidate.maximum,current.maximum)
    comparison < 0 or (comparison == 0 and candidate.worst != current.worst and (candidate.worst & current.worst) == candidate.worst)

def ecc_popcount(value: i64) -> usize:
    bits: mutable i64 = value
    count: mutable usize = 0
    while bits != 0:
        bits <- bits & (bits-1)
        count <- count+1
    count

def ecc_preferable(a: EccMetrics, b: EccMetrics) -> bool:
    comparison: i64 = ecc_compare(a.maximum,b.maximum)
    if comparison != 0: return comparison < 0
    a_count: usize = ecc_popcount(a.worst)
    b_count: usize = ecc_popcount(b.worst)
    a_count < b_count or (a_count == b_count and a.worst < b.worst)

def ecc_enumerate(points: view[EccPoint], n: usize,
                  output: mutable view[EccTriangulation], total: mutable usize&) -> void:
    b: mutable usize = zeroed
    diagonals_a: mutable usize[ECC_MAX_DIAG] = zeroed
    diagonals_b: mutable usize[ECC_MAX_DIAG] = zeroed
    diagonal_count: mutable usize = 0
    a: mutable usize = 0
    while a < n:
        b <- a+2
        while b < n:
            if not (a==0 and b==n-1):
                diagonals_a[diagonal_count] <- a
                diagonals_b[diagonal_count] <- b
                diagonal_count <- diagonal_count+1
            b <- b+1
        a <- a+1
    boundary: mutable i64 = 0
    a <- 0
    while a < n:
        boundary <- boundary | ecc_edge_bit(a,(a+1)%n)
        a <- a+1
    total <- 0
    mask: mutable usize = 0
    while mask < (1 << diagonal_count):
        chosen: mutable usize = 0
        i: mutable usize = 0
        while i < diagonal_count:
            if ((mask >> i) & 1) != 0: chosen <- chosen+1
            i <- i+1
        if chosen == n-3:
            crossing: mutable bool = false
            i <- 0
            while i < diagonal_count and not crossing:
                if ((mask >> i) & 1) != 0:
                    j: mutable usize = i+1
                    while j < diagonal_count:
                        if ((mask >> j) & 1) != 0 and ecc_crosses(points,diagonals_a[i],diagonals_b[i],diagonals_a[j],diagonals_b[j]):
                            crossing <- true
                            break
                        j <- j+1
                i <- i+1
            if not crossing:
                edges: mutable i64 = boundary
                i <- 0
                while i < diagonal_count:
                    if ((mask >> i) & 1) != 0: edges <- edges | ecc_edge_bit(diagonals_a[i],diagonals_b[i])
                    i <- i+1
                faces: mutable EccTriangle[ECC_MAX_TRI] = zeroed
                face_count: mutable usize = 0
                a <- 0
                while a < n:
                    b <- a+1
                    while b < n:
                        c: mutable usize = b+1
                        while c < n:
                            if (edges & ecc_edge_bit(a,b)) != 0 and (edges & ecc_edge_bit(b,c)) != 0 and (edges & ecc_edge_bit(c,a)) != 0:
                                contains: mutable bool = false
                                v: mutable usize = 0
                                while v < n:
                                    if v!=a and v!=b and v!=c and ecc_inside(points,EccTriangle{a:a,b:b,c:c},v):
                                        contains <- true
                                        break
                                    v <- v+1
                                if not contains and face_count<ECC_MAX_TRI:
                                    faces[face_count] <- EccTriangle{a:a,b:b,c:c}
                                    face_count <- face_count+1
                            c <- c+1
                        b <- b+1
                    a <- a+1
                if face_count == n-2 and total < ECC_MAX_ALL:
                    output[total] <- EccTriangulation{triangles:faces,count:face_count,edges:edges}
                    total <- total+1
        mask <- mask+1

def ecc_rank(points: view[EccPoint], n: usize, target: EccFraction) -> i64:
    seen: mutable EccFraction[ECC_MAX_TRIPLES] = zeroed
    distinct: mutable usize = 0
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a+1
        while b < n:
            c: mutable usize = b+1
            while c < n:
                triangle: EccTriangle = EccTriangle{a:a,b:b,c:c}
                sides: mutable i64[3] = zeroed
                score: EccFraction = ecc_triangle_score(points,triangle,sides[0:3])
                if ecc_compare(score,target) < 0:
                    duplicate: mutable bool = false
                    i: mutable usize = 0
                    while i < distinct:
                        if ecc_compare(score,seen[i]) == 0: duplicate <- true
                        i <- i+1
                    if not duplicate:
                        seen[distinct] <- score
                        distinct <- distinct+1
                c <- c+1
            b <- b+1
        a <- a+1
    (distinct+1).i64()

def ecc_solve(points: view[EccPoint], n: usize) -> i64:
    all: mutable EccTriangulation[ECC_MAX_ALL] = zeroed
    total: mutable usize = 0
    ecc_enumerate(points,n,all[0:ECC_MAX_ALL],total)
    fan: mutable EccTriangulation = zeroed
    k: mutable usize = 1
    while k+1 < n:
        fan.triangles[fan.count] <- EccTriangle{a:0,b:k,c:k+1}
        fan.count <- fan.count+1
        k <- k+1
    a: mutable usize = 0
    while a < n:
        fan.edges <- fan.edges | ecc_edge_bit(a,(a+1)%n)
        a <- a+1
    k <- 2
    while k+1 < n:
        fan.edges <- fan.edges | ecc_edge_bit(0,k)
        k <- k+1
    current_index: mutable i64 = -1
    i: mutable usize = 0
    while i < total:
        if all[i].edges == fan.edges:
            current_index <- i.i64()
            break
        i <- i+1
    if current_index < 0: return -1
    current: mutable EccTriangulation = all[current_index.usize()]
    current_metrics: mutable EccMetrics = ecc_evaluate(points,n,current)
    step: mutable usize = 0
    while step < ECC_MAX_ALL:
        changed: mutable bool = false
        ti: mutable usize = 0
        while ti < current.count and not changed:
            triangle: EccTriangle = current.triangles[ti]
            sides: mutable i64[3] = zeroed
            score: EccFraction = ecc_triangle_score(points,triangle,sides[0:3])
            if ecc_compare(score,current_metrics.maximum) == 0 and score.num != 0:
                largest: mutable usize = 0
                if sides[1] > sides[largest]: largest <- 1
                if sides[2] > sides[largest]: largest <- 2
                vertices: usize[3] = [triangle.a,triangle.b,triangle.c]
                anchor_pos: mutable usize = 0
                while anchor_pos < 3 and not changed:
                    if sides[anchor_pos] == sides[largest]:
                        q: usize = vertices[anchor_pos]
                        opposite: mutable usize[2] = zeroed
                        used: mutable usize = 0
                        j: mutable usize = 0
                        while j < 3:
                            if j != anchor_pos:
                                opposite[used] <- vertices[j]
                                used <- used+1
                            j <- j+1
                        s: mutable usize = 0
                        while s < n and not changed:
                            added: i64 = ecc_edge_bit(q,s)
                            if s != q and (current.edges & added) == 0 and ecc_crosses(points,q,s,opposite[0],opposite[1]):
                                retained: mutable i64 = current.edges
                                u: mutable usize = 0
                                while u < n:
                                    v: mutable usize = u+1
                                    while v < n:
                                        bit: i64 = ecc_edge_bit(u,v)
                                        if (retained & bit) != 0 and ecc_crosses(points,q,s,u,v):
                                            retained <- retained & ~bit
                                        v <- v+1
                                    u <- u+1
                                selected: mutable i64 = -1
                                selected_metrics: mutable EccMetrics = EccMetrics{maximum:EccFraction{num:0,den:1},worst:0}
                                ci: mutable usize = 0
                                while ci < total:
                                    if (all[ci].edges & added) != 0 and (all[ci].edges & retained) == retained:
                                        candidate: EccMetrics = ecc_evaluate(points,n,all[ci])
                                        if ecc_improves(candidate,current_metrics) and (selected < 0 or ecc_preferable(candidate,selected_metrics)):
                                            selected <- ci.i64()
                                            selected_metrics <- candidate
                                    ci <- ci+1
                                if selected >= 0:
                                    current <- all[selected.usize()]
                                    current_metrics <- selected_metrics
                                    changed <- true
                            s <- s+1
                    anchor_pos <- anchor_pos+1
            ti <- ti+1
        if not changed: break
        step <- step+1
    ecc_rank(points,n,current_metrics.maximum)

def ecc_impl(input: i64&, length: usize) -> i64:
    if length < 1 or length > ECC_MAX_LENGTH: return -1
    if input[0] < ECC_MIN_N.i64() or input[0] > ECC_MAX_N.i64(): return -1
    n: usize = input[0].usize()
    if length != 1+2*n: return -1
    points: mutable EccPoint[ECC_MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        points[i] <- EccPoint{x:input[1+2*i],y:input[2+2*i]}
        if points[i].x < -4 or points[i].x > 4 or points[i].y < -4 or points[i].y > 4: return -1
        j: mutable usize = 0
        while j < i:
            if points[j].x == points[i].x and points[j].y == points[i].y: return -1
            j <- j+1
        i <- i+1
    area: mutable i64 = 0
    i <- 0
    while i < n:
        next: usize = (i+1)%n
        area <- area+points[i].x*points[next].y-points[i].y*points[next].x
        i <- i+1
    if area == 0: return -1
    direction: i64 = 1 if area > 0 else -1
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a+1
        while b < n:
            c: mutable usize = b+1
            while c < n:
                if ecc_orient(points[0:n],a,b,c)==0: return -1
                c <- c+1
            b <- b+1
        a <- a+1
    edge: mutable usize = 0
    while edge < n:
        next: usize = (edge+1)%n
        vertex: mutable usize = 0
        while vertex < n:
            if vertex != edge and vertex != next and direction*ecc_orient(points[0:n],edge,next,vertex)<=0: return -1
            vertex <- vertex+1
        edge <- edge+1
    ecc_solve(points[0:n],n)

def convex_polygon_minimax_eccentricity_edge_insertion_impl(input:i64&,length:usize)->i64:
    if input == null or length>ECC_MAX_LENGTH:return -1
    ecc_impl(input,length)

export fn convex_polygon_minimax_eccentricity_edge_insertion(input:i64&,length:usize) -> i64 = convex_polygon_minimax_eccentricity_edge_insertion_impl
