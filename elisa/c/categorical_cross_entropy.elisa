extern fn double log(double value);
const INVALID_RESULT: f64 = -1.0e300
def categorical_cross_entropy_impl(values: i64&, length: usize) -> f64:
    if values.is_null() || length < 2 || length > 2050:
        return INVALID_RESULT
    batch: i64 = values[0]
    classes: i64 = values[1]
    if batch < 1 || batch > 64 || classes < 2 || classes > 16:
        return INVALID_RESULT
    b: usize = batch.usize()
    c: usize = classes.usize()
    cells: usize = b * c
    if length != 2 + 2 * cells:
        return INVALID_RESULT
    row: mutable usize = 0
    while row < b:
        label_sum: mutable i64 = 0
        probability_sum: mutable i64 = 0
        column: mutable usize = 0
        while column < c:
            index: usize = row * c + column
            label: i64 = values[2 + index]
            probability: i64 = values[2 + cells + index]
            if label != 0 && label != 1: return INVALID_RESULT
            if probability < 0 || probability > 1000000: return INVALID_RESULT
            label_sum <- label_sum + label
            probability_sum <- probability_sum + probability
            column <- column + 1
        if label_sum != 1 || probability_sum != 1000000: return INVALID_RESULT
        row <- row + 1
    total: mutable f64 = 0.0
    row <- 0
    while row < b:
        row_loss: mutable f64 = 0.0
        column: mutable usize = 0
        while column < c:
            index: usize = row * c + column
            label: f64 = values[2 + index].f64()
            probability: mutable f64 = values[2 + cells + index].f64() / 1000000.0
            if probability < 1e-15: probability <- 1e-15
            if probability > 1.0: probability <- 1.0
            row_loss <- row_loss - label * log(probability)
            column <- column + 1
        total <- total + row_loss
        row <- row + 1
    total
export fn categorical_cross_entropy(values: i64&, length: usize) -> f64 = categorical_cross_entropy_impl
