def count_letters_lowercase(value: i64) -> i64:
    if value >= 65 and value <= 90: value + 32 else: value

def count_letters_impl(input: i64&, length: usize) -> i64:
    if length < 2 or input[1] < 0 or input[1] > 256:
        return -1
    text_length: usize = input[1].usize()
    if length != text_length + 2:
        return -1
    query: i64 = count_letters_lowercase(input[0])
    if query < 97 or query > 122:
        return -1
    count: mutable i64 = 0
    index: mutable usize = 0
    while index < text_length:
        value: i64 = input[index + 2]
        if not ((value >= 97 and value <= 122) or (value >= 65 and value <= 90)):
            return -1
        if count_letters_lowercase(value) == query:
            count <- count + 1
        index <- index + 1
    count

export fn count_letters(input: i64&, length: usize) -> i64 = count_letters_impl
