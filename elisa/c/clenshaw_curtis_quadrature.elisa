extern cos(value: f64) -> f64

const MAX_PARSEABLE_INPUT_LENGTH: usize = 19
const PI_PINNED: f64 = 3.14159265358979323846264338327950288

def exact_integer(value: f64, low: i64, high: i64) -> bool:
    if value != value or value < low.f64() or value > high.f64(): return false
    value.i64().f64() == value

def valid_input(input: f64&, input_length: usize) -> bool:
    if input_length < 4 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return false
    if not exact_integer(input[0], 2, 16): return false
    n: i64 = input[0].i64()
    if n % 2 != 0 or input_length != (n + 2).usize(): return false
    for i in 1..<input_length:
        if input[i] != input[i] or input[i] > 1000.0 or input[i] < -1000.0: return false
    true

def compute(input: f64&, output: mutable view[f64]) -> i64:
    n: i64 = input[0].i64()
    result: mutable f64 = 0.0
    k: mutable i64 = 0
    while k <= n:
        inner: mutable f64 = 0.0
        j: mutable i64 = 1
        while j <= n / 2:
            bj: f64 = 1.0 if j == n / 2 else 2.0
            denominator: f64 = (4 * j * j - 1).f64()
            angle: f64 = (((2.0 * j.f64()) * k.f64()) * PI_PINNED) / n.f64()
            term: f64 = (bj / denominator) * cos(angle)
            inner <- inner + term
            j <- j + 1
        gk: f64 = 1.0 if k == 0 or k == n else 2.0
        weight: f64 = (gk / n.f64()) * (1.0 - inner)
        result <- result + weight * input[(k + 1).usize()]
        k <- k + 1
    if result != result or result > 1.0e308 or result < -1.0e308: return -1
    output[0] <- result
    1

def clenshaw_curtis_quadrature_impl(input: f64&, input_length: usize,
                                     output: mutable f64&, output_capacity: usize) -> i64:
    if input == null: return -1
    if input_length < 4 or input_length > MAX_PARSEABLE_INPUT_LENGTH: return -1
    input_view: f64& = input
    if not valid_input(input_view,input_length): return -1
    if output == null or output_capacity < 1: return -2
    staged: mutable f64[1] = zeroed
    staged_view: mutable view[f64] = staged[0:1]
    status: i64 = compute(input_view,staged_view)
    if status < 0: return status
    output_view: mutable f64& = output
    output_view[0] <- staged_view[0]
    1

export fn clenshaw_curtis_quadrature(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64 = clenshaw_curtis_quadrature_impl
