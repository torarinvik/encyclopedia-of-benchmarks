# Return radius for component 0 and the atan2 angle for component 1.
extern sqrt(value: f64) -> f64
extern atan2(y: f64, x: f64) -> f64

def cartesian_to_polar_impl(x: f64, y: f64, component: f64) -> f64:
    if x != x or y != y or (component != 0.0 and component != 1.0):
        return -1.0e300
    if x < -1000000.0 or x > 1000000.0 or y < -1000000.0 or y > 1000000.0:
        return -1.0e300
    if component == 0.0:
        return sqrt(x * x + y * y)
    if x == 0.0 and y == 0.0:
        return 0.0
    return atan2(y, x)

export fn cartesian_to_polar(x: f64, y: f64, component: f64) -> f64 = cartesian_to_polar_impl
