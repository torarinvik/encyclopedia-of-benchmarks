const MAX_LENGTH: usize = 4096

def count_nice_subarrays_impl(values: i64&, length: usize) -> i64:
    if length < 2 or values[0] < 0 or values[0] > 4096 or values[1] < 1 or values[1] > 4096:
        return -1
    n: usize = usize(values[0])
    k: i64 = values[1]
    if length != n + 2:
        return -1
    i: mutable usize = 0
    while i < n:
        if values[i + 2] < -2147483648 or values[i + 2] > 2147483647:
            return -1
        i <- i + 1
    memo: mutable i64[MAX_LENGTH] = zeroed
    left: mutable usize = 0
    odd_count: mutable i64 = 0
    result: mutable i64 = 0
    right: mutable usize = 0
    while right < n:
        if values[right + 2] % 2 != 0:
            odd_count <- odd_count + 1
        if odd_count > k:
            left <- left + usize(memo[left])
            odd_count <- odd_count - 1
        if odd_count == k:
            if memo[left] == 0:
                even_count: mutable usize = 0
                temp: mutable usize = left
                while values[temp + 2] % 2 == 0:
                    even_count <- even_count + 1
                    temp <- temp + 1
                memo[left] <- i64(even_count + 1)
            result <- result + memo[left]
        right <- right + 1
    result

export fn count_nice_subarrays(values: i64&, length: usize) -> i64 = count_nice_subarrays_impl
