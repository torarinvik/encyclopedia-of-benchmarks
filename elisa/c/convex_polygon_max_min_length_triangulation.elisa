const MML_MIN_N: usize = 3
const MML_MAX_N: usize = 6
const MML_MAX_LENGTH: usize = 14

struct MmlPoint:
    x: i64
    y: i64

def mml_cross(points: view[MmlPoint], a: usize, b: usize, c: usize) -> i64:
    (points[b].x-points[a].x)*(points[c].y-points[a].y) - (points[b].y-points[a].y)*(points[c].x-points[a].x)

def mml_distance_squared(a: MmlPoint, b: MmlPoint) -> i64:
    dx: i64 = a.x-b.x
    dy: i64 = a.y-b.y
    dx*dx+dy*dy

def mml_diagonal_bit(n: usize, a_value: usize, b_value: usize) -> usize:
    left: usize = if a_value < b_value: a_value else: b_value
    right: usize = if a_value < b_value: b_value else: a_value
    bit: mutable usize = 0
    first: mutable usize = 0
    while first < n:
        second: mutable usize = first+2
        while second < n:
            if not (first == 0 and second == n-1):
                if first == left and second == right: return bit
                bit <- bit+1
            second <- second+1
        first <- first+1
    MML_MAX_N*MML_MAX_N

def mml_angle_at_least_sixty(p: MmlPoint, q: MmlPoint, r: MmlPoint) -> bool:
    ux: i64 = p.x-q.x
    uy: i64 = p.y-q.y
    vx: i64 = r.x-q.x
    vy: i64 = r.y-q.y
    dot: i64 = ux*vx+uy*vy
    if dot <= 0: return true
    norm_u: i64 = ux*ux+uy*uy
    norm_v: i64 = vx*vx+vy*vy
    4*dot*dot <= norm_u*norm_v

def mml_greedy(points: view[MmlPoint], n: usize) -> i64:
    next_vertex: mutable usize[MML_MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        next_vertex[i] <- (i+1)%n
        i <- i+1
    shortest: mutable i64 = 513
    i <- 0
    while i < n:
        following: usize = (i+1)%n
        edge: i64 = mml_distance_squared(points[i], points[following])
        if edge < shortest: shortest <- edge
        i <- i+1
    active_count: mutable usize = n
    p: mutable usize = 0
    q: mutable usize = next_vertex[p]
    r: mutable usize = next_vertex[q]
    steps: mutable usize = 0
    diagonal_mask: mutable i64 = 0
    while active_count > 3:
        steps <- steps+1
        if steps > 4*n: return -1
        if mml_angle_at_least_sixty(points[p], points[q], points[r]):
            chord: i64 = mml_distance_squared(points[p], points[r])
            if chord < shortest: shortest <- chord
            bit: usize = mml_diagonal_bit(n, p, r)
            if bit >= MML_MAX_N*MML_MAX_N: return -1
            diagonal_mask <- diagonal_mask | (1.i64 << bit)
            next_vertex[p] <- r
            active_count <- active_count-1
            q <- r
            r <- next_vertex[r]
        else:
            p <- q
            q <- r
            r <- next_vertex[r]
    shortest*512+diagonal_mask

def mml_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 1 or length > MML_MAX_LENGTH: return -1
    if input[0] < MML_MIN_N.i64() or input[0] > MML_MAX_N.i64(): return -1
    n: usize = input[0].usize()
    if length != 1+2*n: return -1
    points: mutable MmlPoint[MML_MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        x: i64 = input[1+2*i]
        y: i64 = input[2+2*i]
        if x < -8 or x > 8 or y < -8 or y > 8: return -1
        j: mutable usize = 0
        while j < i:
            if points[j].x == x and points[j].y == y: return -1
            j <- j+1
        points[i] <- MmlPoint{x: x, y: y}
        i <- i+1
    area2: mutable i64 = 0
    i <- 0
    while i < n:
        following: usize = (i+1)%n
        area2 <- area2+points[i].x*points[following].y-points[i].y*points[following].x
        i <- i+1
    if area2 <= 0: return -1
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a+1
        while b < n:
            c: mutable usize = b+1
            while c < n:
                if mml_cross(points[0:n], a, b, c) == 0: return -1
                c <- c+1
            b <- b+1
        a <- a+1
    edge: mutable usize = 0
    while edge < n:
        following: usize = (edge+1)%n
        vertex: mutable usize = 0
        while vertex < n:
            if vertex != edge and vertex != following and mml_cross(points[0:n], edge, following, vertex) <= 0:
                return -1
            vertex <- vertex+1
        edge <- edge+1
    mml_greedy(points[0:n], n)

export fn convex_polygon_max_min_length_triangulation(input: i64&, length: usize) -> i64:
    if input.is_null() or length > MML_MAX_LENGTH: return -1
    mml_impl(input[0:length])
