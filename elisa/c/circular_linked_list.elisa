def circular_linked_list_trace(values: i64&, operation_count: usize, node_value: mutable u32&, next_node: mutable u16&) -> i64:
    free_head: mutable usize = 0
    next_unused: mutable usize = 1
    tail_index: mutable usize = 0
    count: mutable usize = 0
    checksum: mutable u64 = 0
    for operation in 0..<operation_count:
        opcode: u64 = values[2 * operation].u64()
        payload: i64 = values[2 * operation + 1]
        observed: mutable u64 = 1000000
        biased_payload: u64 = payload.u64() + 1000000
        removed: mutable usize = 0
        predecessor: mutable usize = 0
        if opcode < 2:
            if biased_payload > 2000000 or count == 256:
                return -1
            node: usize = next_unused if free_head == 0 else free_head
            if free_head == 0:
                next_unused <- next_unused + 1
            else:
                free_head <- next_node[node].usize()
            node_value[node] <- biased_payload.u32()
            if opcode == 0:
                next_node[node] <- 0
                next_node[tail_index] <- node.u16()
                tail_index <- node
            else:
                next_node[node] <- next_node[0]
                next_node[0] <- node.u16()
                if count == 0:
                    tail_index <- node
            count <- count + 1
            continue
        elif opcode < 4:
            if payload != 0 or count == 0:
                return -1
            previous: mutable usize = 0
            if opcode == 3:
                while next_node[previous].usize() != tail_index:
                    previous <- next_node[previous].usize()
            node: usize = next_node[previous].usize()
            observed <- node_value[node].u64()
            removed <- node
            predecessor <- previous
        elif opcode < 6:
            if biased_payload > 2000000:
                return -1
            previous: mutable usize = 0
            node: mutable usize = next_node[0].usize()
            while node != 0 and node_value[node] != biased_payload.u32():
                previous <- node
                node <- next_node[node].usize()
            observed <- 1000001 if node != 0 else 1000000
            if opcode == 4:
                removed <- node
                predecessor <- previous
        elif opcode == 6:
            if payload != 0:
                return -1
            observed <- count.u64() + 1000000
        elif opcode < 9:
            if payload.u64() >= count.u64():
                return -1
            previous: mutable usize = 0
            for index in 0..<payload.usize():
                previous <- next_node[previous].usize()
            node: usize = next_node[previous].usize()
            observed <- node_value[node].u64()
            if opcode == 8:
                removed <- node
                predecessor <- previous
        else:
            return -1
        if removed != 0:
            next_node[predecessor] <- next_node[removed]
            if removed == tail_index:
                tail_index <- predecessor
            next_node[removed] <- free_head.u16()
            free_head <- removed
            count <- count - 1
        checksum <- checksum + (operation + 1).u64() * observed
    checksum <- while node != 0 |node: mutable usize = next_node[0].usize(), index: mutable usize = 0, total: mutable u64 = checksum| -> total:
        total <- total + (operation_count + index + 1).u64() * node_value[node].u64()
        node <- next_node[node].usize()
        index <- index + 1
    checksum.i64()

# Bounded singly circular linked list with a sentinel and reusable node pool.
def circular_linked_list_impl(values: i64&, length: usize) -> i64:
    if length > 1024 or length % 2 != 0:
        return -1
    operation_count: usize = length / 2
    if operation_count == 0:
        return 0
    if operation_count < 16:
        small_values: mutable u32[16] = zeroed
        small_links: mutable u16[16] = zeroed
        return circular_linked_list_trace(values, operation_count, &small_values[0], &small_links[0])
    node_values: mutable u32[257] = zeroed
    links: mutable u16[257] = zeroed
    circular_linked_list_trace(values, operation_count, &node_values[0], &links[0])

export fn circular_linked_list_benchmark(values: i64&, length: usize) -> i64 = circular_linked_list_impl
