const MAX_PRECISION: i64 = 12

def chudnovsky_algorithm_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length != 1 or input[0] < 1 or input[0] > MAX_PRECISION:
        return -1
    precision: usize = input[0].usize()
    output_length: mutable usize = precision
    if precision == 1:
        output_length <- 0
    if capacity < output_length or (output_length > 0 and output == null):
        return -2
    if precision == 1:
        return 0

    root: mutable f64 = 100.0
    for iteration in 0..<8:
        root <- 0.5 * (root + 10005.0 / root)
    pi: f64 = (426880.0 * root) / 13591409.0
    fraction: mutable f64 = pi - 3.0
    output[0] <- 51
    output[1] <- 46
    for digit in 0..<(precision - 2):
        fraction <- fraction * 10.0
        next_digit: i64 = fraction.i64()
        output[2 + digit] <- (48 + next_digit).u8()
        fraction <- fraction - next_digit.f64()
    output_length.i64()

export fn chudnovsky_algorithm(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = chudnovsky_algorithm_impl
