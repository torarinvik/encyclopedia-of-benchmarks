const CMAI_MIN_N: usize = 3
const CMAI_MAX_N: usize = 4
const CMAI_MAX_LENGTH: usize = 10
const CMAI_MAX_ANGLES: usize = 12

struct CmaiPoint:
    x: i64
    y: i64

struct CmaiAngle:
    a: usize
    b: usize
    c: usize
    vertex: usize

struct CmaiTriangle:
    a: usize
    b: usize
    c: usize

def cmai_orient(points: view[CmaiPoint], a: usize, b: usize, c: usize) -> i64:
    (points[b].x - points[a].x) * (points[c].y - points[a].y) - (points[b].y - points[a].y) * (points[c].x - points[a].x)

def cmai_angle_dot(points: view[CmaiPoint], angle: CmaiAngle) -> i64:
    va: usize = angle.a
    vb: usize = angle.b
    vc: usize = angle.c
    center: usize = if angle.vertex == 0: va else: (if angle.vertex == 1: vb else: vc)
    first: usize = if center != va: va else: vb
    second: usize = if center != vc: vc else: (if center != vb: vb else: va)
    ux: i64 = points[first].x - points[center].x
    uy: i64 = points[first].y - points[center].y
    vx: i64 = points[second].x - points[center].x
    vy: i64 = points[second].y - points[center].y
    ux * vx + uy * vy

def cmai_angle_den(points: view[CmaiPoint], angle: CmaiAngle) -> i64:
    va: usize = angle.a
    vb: usize = angle.b
    vc: usize = angle.c
    center: usize = if angle.vertex == 0: va else: (if angle.vertex == 1: vb else: vc)
    first: usize = if center != va: va else: vb
    second: usize = if center != vc: vc else: (if center != vb: vb else: va)
    ux: i64 = points[first].x - points[center].x
    uy: i64 = points[first].y - points[center].y
    vx: i64 = points[second].x - points[center].x
    vy: i64 = points[second].y - points[center].y
    (ux * ux + uy * uy) * (vx * vx + vy * vy)

def cmai_angle_cmp(points: view[CmaiPoint], left: CmaiAngle, right: CmaiAngle) -> i64:
    d1: i64 = cmai_angle_dot(points, left)
    z1: i64 = cmai_angle_den(points, left)
    d2: i64 = cmai_angle_dot(points, right)
    z2: i64 = cmai_angle_den(points, right)
    if d1 == 0 or d2 == 0:
        if d1 == d2:
            return 0
        if d1 == 0:
            return if d2 > 0: 1 else: -1
        return if d1 > 0: -1 else: 1
    if (d1 < 0) != (d2 < 0):
        return if d1 < 0: 1 else: -1
    lhs: i64 = d1 * d1 * z2
    rhs: i64 = d2 * d2 * z1
    if lhs == rhs:
        return 0
    if d1 > 0:
        return if lhs > rhs: -1 else: 1
    return if lhs > rhs: 1 else: -1

def cmai_triangle_max(points: view[CmaiPoint], triangle: CmaiTriangle) -> CmaiAngle:
    a: usize = triangle.a
    b: usize = triangle.b
    c: usize = triangle.c
    if a > b:
        temp: usize = a
        a = b
        b = temp
    if b > c:
        temp: usize = b
        b = c
        c = temp
    if a > b:
        temp: usize = a
        a = b
        b = temp
    best: mutable CmaiAngle = CmaiAngle{a: a, b: b, c: c, vertex: 0}
    vertex: mutable usize = 1
    while vertex < 3:
        candidate: CmaiAngle = CmaiAngle{a: a, b: b, c: c, vertex: vertex}
        if cmai_angle_cmp(points, candidate, best) > 0:
            best <- candidate
        vertex <- vertex + 1
    best

def cmai_triangulation_max(points: view[CmaiPoint], triangles: view[CmaiTriangle], count: usize) -> CmaiAngle:
    best: mutable CmaiAngle = cmai_triangle_max(points, triangles[0])
    i: mutable usize = 1
    while i < count:
        candidate: CmaiAngle = cmai_triangle_max(points, triangles[i])
        if cmai_angle_cmp(points, candidate, best) > 0:
            best <- candidate
        i <- i + 1
    best

def cmai_angle_rank(points: view[CmaiPoint], n: usize, target: CmaiAngle) -> i64:
    distinct_lower: mutable CmaiAngle[CMAI_MAX_ANGLES] = zeroed
    distinct_count: mutable usize = 0
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a + 1
        while b < n:
            c: mutable usize = b + 1
            while c < n:
                vertex: mutable usize = 0
                while vertex < 3:
                    candidate: CmaiAngle = CmaiAngle{a: a, b: b, c: c, vertex: vertex}
                    if cmai_angle_cmp(points, candidate, target) < 0:
                        seen: mutable bool = false
                        i: mutable usize = 0
                        while i < distinct_count:
                            if cmai_angle_cmp(points, candidate, distinct_lower[i]) == 0:
                                seen <- true
                            i <- i + 1
                        if not seen:
                            distinct_lower[distinct_count] <- candidate
                            distinct_count <- distinct_count + 1
                    vertex <- vertex + 1
                c <- c + 1
            b <- b + 1
        a <- a + 1
    (distinct_count + 1).i64()

def cmai_proper_crossing(points: view[CmaiPoint], a: usize, b: usize, c: usize, d: usize) -> bool:
    cmai_orient(points, a, b, c) * cmai_orient(points, a, b, d) < 0 and cmai_orient(points, c, d, a) * cmai_orient(points, c, d, b) < 0

def cmai_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 1 or length > CMAI_MAX_LENGTH:
        return -1
    if input[0] < CMAI_MIN_N.i64() or input[0] > CMAI_MAX_N.i64():
        return -1
    n: usize = input[0].usize()
    if length != 1 + 2 * n:
        return -1
    points: mutable CmaiPoint[CMAI_MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        x: i64 = input[1 + 2 * i]
        y: i64 = input[2 + 2 * i]
        if x < -16 or x > 16 or y < -16 or y > 16:
            return -1
        j: mutable usize = 0
        while j < i:
            if points[j].x == x and points[j].y == y:
                return -1
            j <- j + 1
        points[i] <- CmaiPoint{x: x, y: y}
        i <- i + 1
    area2: mutable i64 = 0
    i <- 0
    while i < n:
        next: usize = (i + 1) % n
        area2 <- area2 + points[i].x * points[next].y - points[i].y * points[next].x
        i <- i + 1
    if area2 == 0:
        return -1
    orientation: i64 = if area2 > 0: 1 else: -1
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a + 1
        while b < n:
            c: mutable usize = b + 1
            while c < n:
                if cmai_orient(points[0:n], a, b, c) == 0:
                    return -1
                c <- c + 1
            b <- b + 1
        a <- a + 1
    edge: mutable usize = 0
    while edge < n:
        next: usize = (edge + 1) % n
        vertex: mutable usize = 0
        while vertex < n:
            if vertex != edge and vertex != next and orientation * cmai_orient(points[0:n], edge, next, vertex) <= 0:
                return -1
            vertex <- vertex + 1
        edge <- edge + 1

    fan: mutable CmaiTriangle[2] = zeroed
    fan[0] <- CmaiTriangle{a: 0, b: 1, c: 2}
    fan[1] <- CmaiTriangle{a: 0, b: 2, c: 3}
    worst: mutable CmaiAngle = if n == 3: cmai_triangle_max(points[0:n], CmaiTriangle{a: 0, b: 1, c: 2}) else: cmai_triangulation_max(points[0:n], fan[0:2], 2)
    if n == 4:
        accepted: mutable bool = false
        ti: mutable usize = 0
        while ti < 2 and not accepted:
            vertices: usize[3] = [fan[ti].a, fan[ti].b, fan[ti].c]
            vertex: mutable usize = 0
            while vertex < 3 and not accepted:
                candidate: CmaiAngle = CmaiAngle{a: vertices[0], b: vertices[1], c: vertices[2], vertex: vertex}
                if cmai_angle_cmp(points[0:n], candidate, worst) == 0:
                    q: usize = vertices[vertex]
                    opposite: mutable usize[2] = zeroed
                    used: mutable usize = 0
                    s: mutable usize = 4
                    j: mutable usize = 0
                    while j < 3:
                        if j != vertex:
                            opposite[used] <- vertices[j]
                            used <- used + 1
                        j <- j + 1
                    j <- 0
                    while j < 4:
                        if j != vertices[0] and j != vertices[1] and j != vertices[2]:
                            s <- j
                        j <- j + 1
                    if cmai_proper_crossing(points[0:n], q, s, opposite[0], opposite[1]):
                        inserted: mutable CmaiTriangle[2] = zeroed
                        inserted[0] <- CmaiTriangle{a: q, b: s, c: opposite[0]}
                        inserted[1] <- CmaiTriangle{a: q, b: s, c: opposite[1]}
                        replacement: CmaiAngle = cmai_triangulation_max(points[0:n], inserted[0:2], 2)
                        if cmai_angle_cmp(points[0:n], replacement, worst) < 0:
                            worst <- replacement
                            accepted <- true
                vertex <- vertex + 1
            ti <- ti + 1
    cmai_angle_rank(points[0:n], n, worst)

export fn convex_polygon_minimax_angle_edge_insertion(input: i64&, length: usize) -> i64:
    if input.is_null() or length > CMAI_MAX_LENGTH:
        return -1
    cmai_impl(input[0:length])
