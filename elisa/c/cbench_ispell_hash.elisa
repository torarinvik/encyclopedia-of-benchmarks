const MAX_WORD_BYTES: usize = 64

def upper_ascii(c: u32) -> u32:
    if c >= 97 and c <= 122:
        return c - 32
    c

def cbench_ispell_hash_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > MAX_WORD_BYTES + 1:
        return -1
    table_size: i64 = values[0]
    if table_size < 1 or table_size > 2147483647:
        return -1
    count: usize = length - 1
    i: mutable usize = 0
    while i < count:
        if values[i + 1] < 1 or values[i + 1] > 127:
            return -1
        i <- i + 1
    h: mutable u32 = 0
    initial: usize = if count < 4: count else: 4
    i <- 0
    while i < initial:
        h <- (h << 8) | upper_ascii(values[i + 1] as u32)
        i <- i + 1
    while i < count:
        h <- (h << 5) | (h >> 27)
        h <- h ^ upper_ascii(values[i + 1] as u32)
        i <- i + 1
    (h as u64 % table_size as u64) as i64

export fn cbench_ispell_hash(values: i64&, length: usize) -> i64 = cbench_ispell_hash_impl
