extern fabs(value: f64) -> f64

const MAX_USERS: usize = 65
const MAX_INPUT_LENGTH: usize = 1 + 4 * MAX_USERS
const MAX_SIMILARITY_TICKS: i64 = 1000000000000
const MAX_RATING_MILLI: i64 = 1000000000
const INVALID_RESULT: f64 = -1.0e300

def collaborative_filtering_impl(values: i64&, length: usize) -> f64:
    if values.is_null() or length < 1 or length > MAX_INPUT_LENGTH:
        return INVALID_RESULT
    count_value: i64 = values[0]
    if count_value < 1 or count_value > MAX_USERS.i64():
        return INVALID_RESULT
    count: usize = count_value.usize()
    if length != 1 + 4 * count:
        return INVALID_RESULT

    total_similarity: mutable f64 = 0.0
    weighted_sum: mutable f64 = 0.0
    target_user_count: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        offset: usize = 1 + 4 * index
        is_target_user: i64 = values[offset]
        has_target_rating: i64 = values[offset + 1]
        similarity_ticks: i64 = values[offset + 2]
        rating_milli: i64 = values[offset + 3]
        if (is_target_user != 0 and is_target_user != 1) or (has_target_rating != 0 and has_target_rating != 1) or similarity_ticks < -MAX_SIMILARITY_TICKS or similarity_ticks > MAX_SIMILARITY_TICKS or rating_milli < -MAX_RATING_MILLI or rating_milli > MAX_RATING_MILLI:
            return INVALID_RESULT
        if is_target_user == 1:
            target_user_count <- target_user_count + 1
        elif has_target_rating == 1:
            similarity: f64 = similarity_ticks.f64() / 1000000000000.0
            rating: f64 = rating_milli.f64() / 1000.0
            total_similarity <- total_similarity + fabs(similarity)
            weighted_sum <- weighted_sum + similarity * rating
        index <- index + 1
    if target_user_count != 1:
        return INVALID_RESULT
    if fabs(total_similarity) < 1.0e-10:
        return 0.0
    weighted_sum / total_similarity

export fn collaborative_filtering(values: i64&, length: usize) -> f64 = collaborative_filtering_impl
