const MAX_N: usize = 128

def cartesian_tree_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def cartesian_tree_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > 1 + MAX_N: return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != n + 1: return -1

    parent: mutable i64[MAX_N] = zeroed
    stack: mutable usize[MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        key: i64 = input[1 + i]
        if key < 0 or key > 1_000_000_000: return -1
        parent[i] <- i.i64()
        i <- i + 1

    stack_size: mutable usize = 0
    i <- 0
    while i < n:
        last: mutable usize = MAX_N
        while stack_size > 0 and input[1 + stack[stack_size - 1]] > input[1 + i]:
            stack_size <- stack_size - 1
            last <- stack[stack_size]
        if stack_size > 0: parent[i] <- stack[stack_size - 1].i64()
        if last < MAX_N: parent[last] <- i.i64()
        stack[stack_size] <- i
        stack_size <- stack_size + 1
        i <- i + 1

    output_bytes: usize = n * 8
    if output.is_null() or capacity < output_bytes: return -2
    i <- 0
    while i < n:
        cartesian_tree_store(parent[i], output[0:output_bytes], i * 8)
        i <- i + 1
    output_bytes.i64()

export fn cartesian_tree(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = cartesian_tree_impl
