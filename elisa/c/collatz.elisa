# Count transitions in the classic Collatz sequence for a bounded input.
def collatz_impl(n: i64) -> i64:
    if n < 1 or n > 1000000:
        return -1
    current: mutable i64 = n
    steps: mutable i64 = 0
    while current != 1:
        if current % 2 == 0:
            current <- current / 2
        else:
            current <- 3 * current + 1
        steps <- steps + 1
    steps

export fn collatz(n: i64) -> i64 = collatz_impl
