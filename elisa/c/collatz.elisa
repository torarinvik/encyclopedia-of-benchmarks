# Count transitions in the classic Collatz sequence for a bounded input.
def collatz_impl(n: i64) -> i64:
    if n < 1 or n > 1000000:
        return -1
    current: mutable u64 = n.u64()
    steps: mutable i64 = 0
    while current != 1:
        if current % 2 == 0:
            current <- current / 2
            steps <- steps + 1
        else:
            # An odd value above one is followed by an even value above two.
            current <- (3 * current + 1) / 2
            steps <- steps + 2
    steps

export fn collatz(n: i64) -> i64 = collatz_impl
