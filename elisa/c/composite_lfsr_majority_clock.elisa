# One majority-clock step for the three source-configured A5 LFSRs.
def composite_lfsr_majority_clock_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length != 3:
        return -1
    if input[0] < 0 or input[0] > 524287 or input[1] < 0 or input[1] > 4194303 or input[2] < 0 or input[2] > 8388607:
        return -1
    if output == null or output_capacity < 32:
        return -2
    s1: mutable i64 = input[0]
    s2: mutable i64 = input[1]
    s3: mutable i64 = input[2]
    c1: i64 = (s1 >> 8) & 1
    c2: i64 = (s2 >> 10) & 1
    c3: i64 = (s3 >> 10) & 1
    majority: mutable i64 = 0
    if c1 + c2 + c3 >= 2:
        majority <- 1
    emitted: i64 = ((s1 >> 18) ^ (s2 >> 21) ^ (s3 >> 22)) & 1
    if c1 == majority:
        s1 <- ((s1 << 1) & 524287) | (((s1 >> 13) ^ (s1 >> 16) ^ (s1 >> 17) ^ (s1 >> 18)) & 1)
    if c2 == majority:
        s2 <- ((s2 << 1) & 4194303) | (((s2 >> 20) ^ (s2 >> 21)) & 1)
    if c3 == majority:
        s3 <- ((s3 << 1) & 8388607) | (((s3 >> 7) ^ (s3 >> 20) ^ (s3 >> 21) ^ (s3 >> 22)) & 1)
    bits: mutable u64 = emitted.u64()
    byte: mutable usize = 0
    while byte < 8 |bits, byte, output|:
        output[byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1
    bits <- s1.u64()
    byte <- 0
    while byte < 8 |bits, byte, output|:
        output[8 + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1
    bits <- s2.u64()
    byte <- 0
    while byte < 8 |bits, byte, output|:
        output[16 + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1
    bits <- s3.u64()
    byte <- 0
    while byte < 8 |bits, byte, output|:
        output[24 + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1
    32

export fn composite_lfsr_majority_clock(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = composite_lfsr_majority_clock_impl
