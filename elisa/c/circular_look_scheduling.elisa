const MAX_REQUESTS: usize = 64
const MAX_CYLINDER_COUNT: i64 = 128

def circular_look_scheduling_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 4 or length > 4 + MAX_REQUESTS:
        return -1
    max_cylinder: i64 = input[0]
    start: i64 = input[1]
    moving_up: i64 = input[2]
    request_count: i64 = input[3]
    if max_cylinder < 1 or max_cylinder > MAX_CYLINDER_COUNT or start < 0 or start >= max_cylinder:
        return -1
    if (moving_up != 0 and moving_up != 1) or request_count < 0 or request_count > MAX_REQUESTS.i64():
        return -1
    if length != 4 + request_count.usize():
        return -1

    up: mutable i64[MAX_REQUESTS] = zeroed
    down: mutable i64[MAX_REQUESTS] = zeroed
    up_count: mutable usize = 0
    down_count: mutable usize = 0
    index: mutable usize = 0
    while index < request_count.usize():
        request: i64 = input[4 + index]
        if request < -128 or request > 255:
            return -1
        if request >= 0 and request < max_cylinder and request != start:
            if request > start:
                up[up_count] <- request
                up_count <- up_count + 1
            else:
                down[down_count] <- request
                down_count <- down_count + 1
        index <- index + 1

    index <- 1
    while index < up_count:
        value: i64 = up[index]
        position: mutable usize = index
        while position > 0 and up[position - 1] > value:
            up[position] <- up[position - 1]
            position <- position - 1
        up[position] <- value
        index <- index + 1
    index <- 1
    while index < down_count:
        value: i64 = down[index]
        position: mutable usize = index
        while position > 0 and down[position - 1] > value:
            down[position] <- down[position - 1]
            position <- position - 1
        down[position] <- value
        index <- index + 1

    output_count: usize = up_count + down_count
    if output_capacity < output_count or (output_count > 0 and output == null):
        return -2
    index <- 0
    position: mutable usize = 0
    if moving_up == 1:
        while index < up_count:
            output[position] <- up[index].u8()
            index <- index + 1
            position <- position + 1
        index <- 0
        while index < down_count:
            output[position] <- down[index].u8()
            index <- index + 1
            position <- position + 1
    else:
        index <- down_count
        while index > 0:
            index <- index - 1
            output[position] <- down[index].u8()
            position <- position + 1
        index <- up_count
        while index > 0:
            index <- index - 1
            output[position] <- up[index].u8()
            position <- position + 1
    output_count.i64()

export fn circular_look_scheduling(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = circular_look_scheduling_impl
