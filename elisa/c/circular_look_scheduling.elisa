@inline(never)
def circular_look_large(input: i64&, request_count: usize, max_cylinder: i64, start: i64, moving_up: i64, output: mutable u8&, output_capacity: usize) -> i64:
    up: mutable u8[MAX_REQUESTS] = zeroed
    down: mutable u8[MAX_REQUESTS] = zeroed
    up_count: mutable usize = 0
    down_count: mutable usize = 0
    index: mutable usize = 0
    while index < request_count:
        request: i64 = input[4 + index]
        if request < -128 or request > 255:
            return -1
        if request.u64() < max_cylinder.u64() and request != start:
            if request > start:
                up[up_count] <- request.u8()
                up_count <- up_count + 1
            else:
                down[down_count] <- request.u8()
                down_count <- down_count + 1
        index <- index + 1

    output_count: usize = up_count + down_count
    if output_capacity < output_count or (output_count > 0 and output == null):
        return -2
    if output_count == 0:
        return 0
    index <- 1
    while index < up_count:
        value: u8 = up[index]
        if up[index - 1] > value:
            position: mutable usize = index
            while position > 0 and up[position - 1] > value:
                up[position] <- up[position - 1]
                position <- position - 1
            up[position] <- value
        index <- index + 1
    index <- 1
    while index < down_count:
        value: u8 = down[index]
        if down[index - 1] > value:
            position: mutable usize = index
            while position > 0 and down[position - 1] > value:
                down[position] <- down[position - 1]
                position <- position - 1
            down[position] <- value
        index <- index + 1

    index <- 0
    position: mutable usize = 0
    if moving_up == 1:
        while index < up_count:
            output[position] <- up[index].u8()
            index <- index + 1
            position <- position + 1
        index <- 0
        while index < down_count:
            output[position] <- down[index].u8()
            index <- index + 1
            position <- position + 1
    else:
        index <- down_count
        while index > 0:
            index <- index - 1
            output[position] <- down[index].u8()
            position <- position + 1
        index <- up_count
        while index > 0:
            index <- index - 1
            output[position] <- up[index].u8()
            position <- position + 1
    output_count.i64()

const MAX_REQUESTS: usize = 64
const MAX_CYLINDER_COUNT: i64 = 128

def circular_look_scheduling_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 4 or length > 4 + MAX_REQUESTS:
        return -1
    max_cylinder: i64 = input[0]
    start: i64 = input[1]
    moving_up: i64 = input[2]
    request_count: usize = length - 4
    if max_cylinder.u64() - 1.u64() >= MAX_CYLINDER_COUNT.u64() or start.u64() >= max_cylinder.u64():
        return -1
    if moving_up.u64() > 1 or input[3].u64() != request_count.u64():
        return -1

    if request_count > 16:
        return circular_look_large(input, request_count, max_cylinder, start, moving_up, output, output_capacity)
    if request_count == 0:
        return 0
    ordered: mutable u8[16] = zeroed
    count: mutable usize = 0
    for index in 0..<request_count:
        request: i64 = input[4 + index]
        if request < -128 or request > 255:
            return -1
        if request.u64() < max_cylinder.u64() and request != start:
            first_segment: bool = (request > start) == (moving_up == 1)
            cylinder: u8 = request.u8() if moving_up == 1 else 127.u8() - request.u8()
            ordered[count] <- cylinder if first_segment else cylinder + 128.u8()
            count <- count + 1
    if count == 0:
        return 0
    if output_capacity < count or output == null:
        return -2
    for index in 1..<count:
        value: u8 = ordered[index]
        position: mutable usize = index
        while position > 0 and ordered[position - 1] > value:
            ordered[position] <- ordered[position - 1]
            position <- position - 1
        ordered[position] <- value
    for index in 0..<count:
        cylinder: u8 = ordered[index] & 127
        output[index] <- cylinder if moving_up == 1 else 127.u8() - cylinder
    count.i64()

export fn circular_look_scheduling(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = circular_look_scheduling_impl
