const MAX_DIMENSION: i64 = 32
const MAX_INPUT_LENGTH: usize = 2053

def checkequal_impl(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 4 or length > MAX_INPUT_LENGTH:
        return -1

    rows_a: i64 = values[0]
    columns_a: i64 = values[1]
    rows_b: i64 = values[2]
    columns_b: i64 = values[3]
    if rows_a < 0 or rows_a > MAX_DIMENSION or columns_a < 0 or columns_a > MAX_DIMENSION:
        return -1
    if rows_b < 0 or rows_b > MAX_DIMENSION or columns_b < 0 or columns_b > MAX_DIMENSION:
        return -1

    count_a: usize = rows_a.usize() * columns_a.usize()
    count_b: usize = rows_b.usize() * columns_b.usize()
    if length != 4 + count_a + count_b:
        return -1
    if rows_a != rows_b or columns_a != columns_b:
        return 0

    index: mutable usize = 0
    while index < count_a:
        if values[4 + index] != values[4 + count_a + index]:
            return 0
        index <- index + 1
    1

export fn checkequal(values: i64&, length: usize) -> i64 = checkequal_impl
