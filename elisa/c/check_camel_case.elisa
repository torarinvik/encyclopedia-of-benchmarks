# Check the bounded ASCII camel-case predicate.
def check_camel_case_impl(values: i64&, length: usize) -> i64:
    if length > 4096:
        return -2
    if length == 0:
        return 0
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < 32 or value > 126:
            return -2
        index <- index + 1
    if values[0] < 97 or values[0] > 122:
        return 0
    index <- 0
    while index < length:
        value: i64 = values[index]
        if not ((value >= 97 and value <= 122) or (value >= 65 and value <= 90)):
            return 0
        index <- index + 1
    1

export fn check_camel_case(values: i64&, length: usize) -> i64 = check_camel_case_impl
