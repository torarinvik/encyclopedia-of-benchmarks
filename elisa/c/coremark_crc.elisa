# Original Author: Shay Gal-on. Derived algorithm port; no source blocks copied.
def crcu8(data: u8, starting_crc: u16) -> u16:
    crc: mutable u16 = starting_crc
    value: mutable u8 = data
    for _ in 0..<8:
        feedback: u8 = (value & 1) ^ (crc & 1).u8()
        value <- value >> 1
        carry: mutable u16 = 0
        if feedback != 0:
            crc <- crc ^ 0x4002
            carry <- 1
        crc <- crc >> 1
        if carry != 0:
            crc <- crc | 0x8000
        else:
            crc <- crc & 0x7fff
    crc

def crcu16(value: u16, starting_crc: u16) -> u16:
    crc: mutable u16 = crcu8(value.u8(), starting_crc)
    crcu8((value >> 8).u8(), crc)

def crc16(value: i16, starting_crc: u16) -> u16 = crcu16(value.u16(), starting_crc)

def crcu32(value: u32, starting_crc: u16) -> u16:
    crc: mutable u16 = crc16(value.i16(), starting_crc)
    crc16((value >> 16).i16(), crc)

def coremark_crc_impl(values: i64&, length: usize) -> i64:
    if length < 4 or length > 49:
        return -1
    count: i64 = values[0]
    if count < 1 or count > 16 or length != 1 + 3 * count.usize():
        return -1
    total: mutable i64 = 0
    for i in 0..<count.usize():
        tag: i64 = values[1 + 3 * i]
        seed: i64 = values[2 + 3 * i]
        value: i64 = values[3 + 3 * i]
        if seed < 0 or seed > 65535:
            return -1
        crc: mutable u16 = 0
        if tag == 0 and value >= 0 and value <= 255:
            crc <- crcu8(value.u8(), seed.u16())
        elif tag == 1 and value >= 0 and value <= 65535:
            crc <- crcu16(value.u16(), seed.u16())
        elif tag == 2 and value >= 0 and value <= 4294967295:
            crc <- crcu32(value.u32(), seed.u16())
        elif tag == 3 and value >= -32768 and value <= 32767:
            crc <- crc16(value.i16(), seed.u16())
        else:
            return -1
        total <- total + (i.i64() + 1) * crc.i64()
    total

export fn coremark_crc(values: i64&, length: usize) -> i64 = coremark_crc_impl
