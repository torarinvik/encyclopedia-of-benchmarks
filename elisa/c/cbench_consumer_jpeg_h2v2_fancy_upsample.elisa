# Independently written bounded IJG h2v2 adaptation; see package README/LICENSE.
const CBENCH_JPEG_MAX_WIDTH: i64 = 16
const CBENCH_JPEG_MAX_HEIGHT: i64 = 8
const CBENCH_JPEG_MAX_OUTPUT: usize = 512

def cbench_consumer_jpeg_h2v2_fancy_upsample_impl(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or input_length < 5 or input_length > 131:
        return -1
    width_value: i64 = input[0]
    height_value: i64 = input[1]
    if width_value < 3 or width_value > CBENCH_JPEG_MAX_WIDTH or height_value < 1 or height_value > CBENCH_JPEG_MAX_HEIGHT:
        return -1
    width: usize = width_value.usize()
    height: usize = height_value.usize()
    pixels: usize = width * height
    if input_length != 2 + pixels:
        return -1
    for i in 0..<pixels:
        value: i64 = input[i + 2]
        if value < 0 or value > 255:
            return -1
    output_size: usize = 4 * pixels
    if output.is_null() or output_capacity < output_size:
        return -2
    staged: mutable u8[512] = zeroed
    p: mutable usize = 0
    for y in 0..<height:
        for v in 0..<2:
            far_y: usize = y
            if v == 0:
                if y > 0: far_y <- y - 1
            else:
                if y + 1 < height: far_y <- y + 1
            sums: mutable i64[16] = zeroed
            for x in 0..<width:
                sums[x] <- 3 * input[2 + y * width + x] + input[2 + far_y * width + x]
            staged[p] <- ((sums[0] * 4 + 8) >> 4).u8(); p <- p + 1
            staged[p] <- ((sums[0] * 3 + sums[1] + 7) >> 4).u8(); p <- p + 1
            for x in 1..<width - 1:
                staged[p] <- ((sums[x] * 3 + sums[x - 1] + 8) >> 4).u8(); p <- p + 1
                staged[p] <- ((sums[x] * 3 + sums[x + 1] + 7) >> 4).u8(); p <- p + 1
            staged[p] <- ((sums[width - 1] * 3 + sums[width - 2] + 8) >> 4).u8(); p <- p + 1
            staged[p] <- ((sums[width - 1] * 4 + 7) >> 4).u8(); p <- p + 1
    for i in 0..<output_size:
        output[i] <- staged[i]
    output_size.i64()

export fn cbench_consumer_jpeg_h2v2_fancy_upsample(input: i64&, input_length: usize, output: mutable u8&, output_capacity: usize) -> i64 = cbench_consumer_jpeg_h2v2_fancy_upsample_impl
