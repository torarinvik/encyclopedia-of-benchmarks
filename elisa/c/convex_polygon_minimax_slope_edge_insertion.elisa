const CMSE_MAX_N: usize = 4
const CMSE_MAX_LENGTH: usize = 14

struct CmsePoint:
    x: i64
    y: i64
    z: i64

struct CmseTriangle:
    a: usize
    b: usize
    c: usize

struct CmseSlope:
    num: i64
    den: i64

def cmse_orient(points: view[CmsePoint], a: usize, b: usize, c: usize) -> i64:
    (points[b].x-points[a].x)*(points[c].y-points[a].y)-(points[b].y-points[a].y)*(points[c].x-points[a].x)

def cmse_slope(points: view[CmsePoint], triangle: CmseTriangle) -> CmseSlope:
    a: CmsePoint = points[triangle.a]
    b: CmsePoint = points[triangle.b]
    c: CmsePoint = points[triangle.c]
    dx1: i64 = b.x-a.x
    dy1: i64 = b.y-a.y
    dz1: i64 = b.z-a.z
    dx2: i64 = c.x-a.x
    dy2: i64 = c.y-a.y
    dz2: i64 = c.z-a.z
    det: i64 = dx1*dy2-dx2*dy1
    gx: i64 = dz1*dy2-dz2*dy1
    gy: i64 = dx1*dz2-dz1*dx2
    CmseSlope{num: gx*gx+gy*gy, den: det*det}

def cmse_cmp(a: CmseSlope, b: CmseSlope) -> i64:
    left: i64 = a.num*b.den
    right: i64 = b.num*a.den
    if left > right: 1
    else: if left < right: -1
    else: 0

def cmse_max(points: view[CmsePoint], a: CmseTriangle, b: CmseTriangle) -> CmseSlope:
    left: CmseSlope = cmse_slope(points, a)
    right: CmseSlope = cmse_slope(points, b)
    left if cmse_cmp(left, right) >= 0 else right

def cmse_anchor(points: view[CmsePoint], triangle: CmseTriangle, q: usize) -> bool:
    a: CmsePoint = points[triangle.a]
    b: CmsePoint = points[triangle.b]
    c: CmsePoint = points[triangle.c]
    dx1: i64 = b.x-a.x
    dy1: i64 = b.y-a.y
    dz1: i64 = b.z-a.z
    dx2: i64 = c.x-a.x
    dy2: i64 = c.y-a.y
    dz2: i64 = c.z-a.z
    det: i64 = dx1*dy2-dx2*dy1
    gx: i64 = dz1*dy2-dz2*dy1
    gy: i64 = dx1*dz2-dz1*dx2
    if gx == 0 and gy == 0: return false
    other: mutable usize[2] = zeroed
    used: mutable usize = 0
    for vertex in [triangle.a, triangle.b, triangle.c]:
        if vertex != q:
            other[used] <- vertex
            used <- used + 1
    sign: i64 = 1 if det > 0 else -1
    dx: i64 = -gx*sign
    dy: i64 = -gy*sign
    ux: i64 = points[other[0]].x-points[q].x
    uy: i64 = points[other[0]].y-points[q].y
    vx: i64 = points[other[1]].x-points[q].x
    vy: i64 = points[other[1]].y-points[q].y
    turn: i64 = ux*vy-uy*vx
    side: i64 = 1 if turn > 0 else -1
    side*(ux*dy-uy*dx) >= 0 and side*(dx*vy-dy*vx) >= 0

def cmse_crosses(points: view[CmsePoint], a: usize, b: usize, c: usize, d: usize) -> bool:
    cmse_orient(points,a,b,c)*cmse_orient(points,a,b,d) < 0 and cmse_orient(points,c,d,a)*cmse_orient(points,c,d,b) < 0

def cmse_volume(points: view[CmsePoint]) -> i64:
    ax: i64=points[1].x-points[0].x
    ay: i64=points[1].y-points[0].y
    az: i64=points[1].z-points[0].z
    bx: i64=points[2].x-points[0].x
    by: i64=points[2].y-points[0].y
    bz: i64=points[2].z-points[0].z
    cx: i64=points[3].x-points[0].x
    cy: i64=points[3].y-points[0].y
    cz: i64=points[3].z-points[0].z
    ax*(by*cz-bz*cy)-ay*(bx*cz-bz*cx)+az*(bx*cy-by*cx)

def cmse_rank(points: view[CmsePoint], n: usize, target: CmseSlope) -> i64:
    all: mutable CmseSlope[4] = zeroed
    count: mutable usize = 0
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a+1
        while b < n:
            c: mutable usize = b+1
            while c < n:
                all[count] <- cmse_slope(points,CmseTriangle{a:a,b:b,c:c})
                count <- count+1
                c <- c+1
            b <- b+1
        a <- a+1
    distinct: mutable i64 = 0
    i: mutable usize = 0
    while i < count:
        if cmse_cmp(all[i],target) < 0:
            seen: mutable bool = false
            j: mutable usize = 0
            while j < i:
                if cmse_cmp(all[j],all[i]) == 0: seen <- true
                j <- j+1
            if not seen: distinct <- distinct+1
        i <- i+1
    distinct+1

def cmse_impl(input: i64&, input_length: usize) -> i64:
    length: usize = input_length
    if length < 1 or length > CMSE_MAX_LENGTH: return -1
    if input[0] < 3 or input[0] > 4: return -1
    n: usize = input[0].usize()
    if length != 1+3*n: return -1
    points: mutable CmsePoint[4] = zeroed
    i: mutable usize = 0
    while i < n:
        points[i] <- CmsePoint{x:input[1+3*i],y:input[2+3*i],z:input[3+3*i]}
        if points[i].x < -8 or points[i].x > 8 or points[i].y < -8 or points[i].y > 8 or points[i].z < -8 or points[i].z > 8: return -1
        i <- i+1
    area: mutable i64 = 0
    i <- 0
    while i < n:
        j: usize = (i+1)%n
        area <- area+points[i].x*points[j].y-points[i].y*points[j].x
        i <- i+1
    if area == 0: return -1
    sign: i64 = 1 if area > 0 else -1
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a+1
        while b < n:
            c: mutable usize = b+1
            while c < n:
                if cmse_orient(points[0:n],a,b,c) == 0: return -1
                c <- c+1
            b <- b+1
        a <- a+1
    e: mutable usize = 0
    while e < n:
        j: usize=(e+1)%n
        k: mutable usize=0
        while k < n:
            if k != e and k != j and sign*cmse_orient(points[0:n],e,j,k) <= 0: return -1
            k <- k+1
        e <- e+1
    if n == 4 and cmse_volume(points[0:n]) == 0: return -1
    fan: CmseTriangle[2] = [CmseTriangle{a:0,b:1,c:2},CmseTriangle{a:0,b:2,c:3}]
    worst: mutable CmseSlope = cmse_slope(points[0:n],fan[0]) if n == 3 else cmse_max(points[0:n],fan[0],fan[1])
    if n == 4:
        done: mutable bool = false
        ti: mutable usize = 0
        while ti < 2 and not done:
            t: CmseTriangle = fan[ti]
            if cmse_cmp(cmse_slope(points[0:n],t),worst) == 0:
                vertices: usize[3] = [t.a,t.b,t.c]
                k: mutable usize = 0
                while k < 3 and not done:
                    q: usize=vertices[k]
                    if cmse_anchor(points[0:n],t,q):
                        opposite: mutable usize[2] = zeroed
                        used: mutable usize=0
                        s: mutable usize=4
                        j: mutable usize=0
                        while j < 3:
                            if j != k:
                                opposite[used] <- vertices[j]
                                used <- used+1
                            j <- j+1
                        j <- 0
                        while j < 4:
                            if j != vertices[0] and j != vertices[1] and j != vertices[2]: s <- j
                            j <- j+1
                        if cmse_crosses(points[0:n],q,s,opposite[0],opposite[1]):
                            candidate: CmseSlope=cmse_max(points[0:n],CmseTriangle{a:q,b:s,c:opposite[0]},CmseTriangle{a:q,b:s,c:opposite[1]})
                            if cmse_cmp(candidate,worst)<0:
                                worst <- candidate
                                done <- true
                    k <- k+1
            ti <- ti+1
    cmse_rank(points[0:n],n,worst)

def convex_polygon_minimax_slope_edge_insertion_impl(input: i64&, length: usize) -> i64:
    if input == null or length > CMSE_MAX_LENGTH: return -1
    cmse_impl(input, length)

export fn convex_polygon_minimax_slope_edge_insertion(input: i64&, length: usize) -> i64 = convex_polygon_minimax_slope_edge_insertion_impl
