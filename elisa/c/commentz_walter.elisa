const CW_P: usize = 6
const CW_L: usize = 8
const CW_T: usize = 64
const CW_NODES: usize = 33
const CW_INPUT: usize = 105

def cw_is_suffix(v: usize, u: usize, depth: view[usize], path: view[i64]) -> bool:
    if depth[v] >= depth[u]: return false
    offset: usize = depth[u] - depth[v]
    for i in 0..<depth[v]:
        if path[v * CW_L + i] != path[u * CW_L + offset + i]: return false
    return true

def cw_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 2 or length > CW_INPUT: return -1
    raw_p, raw_n := input[0], input[1]
    if raw_p < 1 or raw_p > CW_P.i64() or raw_n < 0 or raw_n > CW_T.i64(): return -1
    p, n := raw_p.usize(), raw_n.usize()
    if length < 2 + p: return -1
    lens: mutable usize[CW_P] = zeroed
    total: mutable usize = 0
    shortest: mutable usize = CW_L + 1
    for i in 0..<p:
        raw := input[2 + i]
        if raw < 1 or raw > CW_L.i64(): return -1
        lens[i] <- raw.usize()
        total <- total + lens[i]
        if lens[i] < shortest: shortest <- lens[i]
    if total > 32 or length != 2 + p + total + n: return -1

    patterns: mutable i64[CW_P * CW_L] = zeroed
    text: mutable i64[CW_T] = zeroed
    at: mutable usize = 2 + p
    for i in 0..<p:
        for j in 0..<lens[i]:
            symbol := input[at]
            at <- at + 1
            if symbol < 1 or symbol > 4: return -1
            patterns[i * CW_L + j] <- symbol
        for prior in 0..<i:
            if lens[prior] != lens[i]: continue
            same: mutable bool = true
            for j in 0..<lens[i]:
                if patterns[prior * CW_L + j] != patterns[i * CW_L + j]: same <- false
            if same: return -1
    for i in 0..<n:
        symbol := input[at]
        at <- at + 1
        if symbol < 1 or symbol > 4: return -1
        text[i] <- symbol

    child: mutable usize[CW_NODES * 5] = zeroed
    parent: mutable usize[CW_NODES] = zeroed
    label: mutable usize[CW_NODES] = zeroed
    depth: mutable usize[CW_NODES] = zeroed
    path: mutable i64[CW_NODES * CW_L] = zeroed
    terminal: mutable bool[CW_NODES] = zeroed
    nodes: mutable usize = 1
    for i in 0..<p:
        v: mutable usize = 0
        for step in 0..<lens[i]:
            symbol: usize = patterns[i * CW_L + lens[i] - 1 - step].usize()
            var encoded: usize = child[v * 5 + symbol]
            if encoded == 0:
                u := nodes
                nodes <- nodes + 1
                child[v * 5 + symbol] <- u + 1
                parent[u] <- v
                label[u] <- symbol
                depth[u] <- depth[v] + 1
                for k in 0..<depth[v]: path[u * CW_L + k] <- path[v * CW_L + k]
                path[u * CW_L + depth[v]] <- symbol.i64()
                encoded <- u + 1
            v <- encoded - 1
        terminal[v] <- true

    shift1: mutable usize[CW_NODES] = zeroed
    shift2: mutable usize[CW_NODES] = zeroed
    bad: mutable usize[5] = zeroed
    for v in 0..<nodes:
        shift1[v] <- shortest
        shift2[v] <- shortest
    shift1[0] <- 1
    for a in 0..<5: bad[a] <- shortest + 1
    for v in 1..<nodes:
        if depth[v] < bad[label[v]]: bad[label[v]] <- depth[v]
        shift2[v] <- shift2[parent[v]]
        for u in 1..<nodes:
            if cw_is_suffix(v, u, depth[0:CW_NODES], path[0:CW_NODES * CW_L]):
                delta: usize = depth[u] - depth[v]
                if delta < shift1[v]: shift1[v] <- delta
                if terminal[u] and delta < shift2[v]: shift2[v] <- delta

    matches: mutable i64 = 0
    position: mutable usize = shortest - 1
    while position < n:
        v: mutable usize = 0
        i: mutable isize = position.isize()
        while i >= 0:
            encoded: usize = child[v * 5 + text[i.usize()].usize()]
            if encoded == 0: break
            v <- encoded - 1
            i <- i - 1
            if terminal[v]: matches <- matches + 1
        symbol: usize = 0
        if i >= 0: symbol <- text[i.usize()].usize()
        char_shift: isize = (shortest + 1).isize()
        if symbol != 0: char_shift <- bad[symbol].isize()
        delta: isize = char_shift - depth[v].isize() - 1
        if delta < shift1[v].isize(): delta <- shift1[v].isize()
        if delta > shift2[v].isize(): delta <- shift2[v].isize()
        position <- position + delta.usize()
    matches

export fn commentz_walter(values: i64&, length: usize) -> i64:
    if values.is_null() or length < 2 or length > CW_INPUT: return -1
    cw_impl(values[0:length])
