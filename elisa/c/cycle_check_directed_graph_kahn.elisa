# Directed cycle detection with Kahn's zero-indegree queue.
def cycle_check_directed_graph_kahn_impl(values: i64&, length: usize) -> i64:
    if length == 0 or length > 65 or (length - 1) % 2 != 0:
        return -1
    vertices_value: i64 = values[0]
    if vertices_value < 0 or vertices_value > 64:
        return -1
    vertices: usize = vertices_value.usize()
    edge_count: usize = (length - 1) / 2
    if edge_count > 32:
        return -1
    adjacency: mutable u64[64] = zeroed
    indegree: mutable usize[64] = zeroed
    edge: mutable usize = 0
    while edge < edge_count:
        source_value: i64 = values[1 + 2 * edge]
        destination_value: i64 = values[2 + 2 * edge]
        if source_value < 0 or destination_value < 0:
            return -1
        if source_value.u64() >= vertices.u64() or destination_value.u64() >= vertices.u64():
            return -1
        source: usize = source_value.usize()
        destination: usize = destination_value.usize()
        mask: u64 = 1.u64() << destination
        if (adjacency[source] & mask) == 0:
            adjacency[source] <- adjacency[source] | mask
            indegree[destination] <- indegree[destination] + 1
        edge <- edge + 1

    queue: mutable usize[64] = zeroed
    head: mutable usize = 0
    tail: mutable usize = 0
    vertex: mutable usize = 0
    while vertex < vertices:
        if indegree[vertex] == 0:
            queue[tail] <- vertex
            tail <- tail + 1
        vertex <- vertex + 1
    removed: mutable usize = 0
    while head < tail:
        source: usize = queue[head]
        head <- head + 1
        removed <- removed + 1
        destination: mutable usize = 0
        while destination < vertices:
            if (adjacency[source] & (1.u64() << destination)) != 0:
                indegree[destination] <- indegree[destination] - 1
                if indegree[destination] == 0:
                    queue[tail] <- destination
                    tail <- tail + 1
            destination <- destination + 1
    if removed != vertices:
        return 1
    0

export fn cycle_check_directed_graph_kahn(values: i64&, length: usize) -> i64 = cycle_check_directed_graph_kahn_impl
