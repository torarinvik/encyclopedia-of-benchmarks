# Lucas digit product for a binomial coefficient modulo three.
def triangle_binomial_mod_three(n: i64, k: i64) -> i64:
    coefficient: mutable i64 = 1
    remaining_n: mutable i64 = n
    remaining_k: mutable i64 = k
    while remaining_n > 0 or remaining_k > 0:
        n_digit: i64 = remaining_n % 3
        k_digit: i64 = remaining_k % 3
        if k_digit > n_digit: return 0
        if n_digit == 2 and k_digit == 1:
            coefficient <- (2 * coefficient) % 3
        remaining_n <- remaining_n / 3
        remaining_k <- remaining_k / 3
    coefficient

def coloured_triangle_reduction_impl(input: i64&, input_length: usize) -> i64:
    if input_length < 2 or input_length > 258: return -1
    n: i64 = input[0]
    if n < 1 or n > 256 or input_length != (n + 1).usize(): return -1
    for index in 0..<n:
        color: i64 = input[1 + index.usize()]
        if color < 0 or color > 2: return -1

    rounds: i64 = n - 1
    total: mutable i64 = 0
    for index in 0..<n:
        color: i64 = input[1 + index.usize()]
        total <- (total + triangle_binomial_mod_three(rounds, index) * color) % 3
    total if rounds % 2 == 0 else (3 - total) % 3

def coloured_triangle_reduction_entry(input: i64&, length: usize) -> i64:
    if input == null or length > 258: return -1
    coloured_triangle_reduction_impl(input, length)

export fn coloured_triangle_reduction(input: i64&, length: usize) -> i64 = coloured_triangle_reduction_entry
