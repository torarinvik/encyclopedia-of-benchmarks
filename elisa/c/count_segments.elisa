const MAX_LENGTH: usize = 4096

# Count transitions from ASCII space to a non-space byte.
def count_segments_impl(input: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -1
    valid_input: bool =
        while index < length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = input[index]
            if value < 1 or value > 127:
                break false
            index <- index + 1
            valid
    if not valid_input:
        return -1
    for index in 0..<length |count: mutable i64 = 0, previous_was_space: mutable bool = true| -> count:
        value: i64 = input[index]
        if value != 32 and previous_was_space:
            count <- count + 1
        previous_was_space <- value == 32
        count

export fn count_segments(input: i64&, length: usize) -> i64 = count_segments_impl
