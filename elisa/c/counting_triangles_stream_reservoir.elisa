def counting_triangles_stream_reservoir_put_i64(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8: output[offset + byte] <- (bits >> (byte * 8)).u8()

def counting_triangles_stream_reservoir_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 6 or length > 114: return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    if n0 < 2 or n0 > 8 or m0 < 1 or m0 > 28 or length != (2 + 4 * m0).usize(): return -1
    m: usize = m0.usize()
    seen: mutable bool[64] = zeroed
    edge_u: mutable i64[28] = zeroed
    edge_v: mutable i64[28] = zeroed
    for i in 0..<m:
        u: i64 = input[2 + 2 * i]
        v: i64 = input[3 + 2 * i]
        if u < 0 or v <= u or v >= n0 or seen[(u * 8 + v).usize()]: return -1
        seen[(u * 8 + v).usize()] <- true
        seen[(v * 8 + u).usize()] <- true
        edge_u[i] <- u
        edge_v[i] <- v
    base: usize = 2 + 2 * m
    for t in 1..=m:
        for slot in 0..<2:
            draw: i64 = input[base + 2 * (t - 1) + slot]
            if draw < 0 or draw >= t.i64(): return -1
    slots_u: mutable i64[2] = zeroed
    slots_v: mutable i64[2] = zeroed
    slots_u[0] <- -1
    slots_u[1] <- -1
    slots_v[0] <- -1
    slots_v[1] <- -1
    staged: mutable i64[112] = zeroed
    at: mutable usize = 0
    for t in 1..=m:
        for slot in 0..<2:
            if input[base + 2 * (t - 1) + slot] == 0:
                slots_u[slot] <- edge_u[t - 1]
                slots_v[slot] <- edge_v[t - 1]
        for slot in 0..<2:
            staged[at] <- slots_u[slot]
            at <- at + 1
            staged[at] <- slots_v[slot]
            at <- at + 1
    bytes: usize = 16 * m
    if output == null or capacity < bytes: return -2
    for i in 0..<at: counting_triangles_stream_reservoir_put_i64(output[0:bytes], i * 8, staged[i])
    bytes.i64()

export fn counting_triangles_stream_reservoir(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = counting_triangles_stream_reservoir_impl
