# Encode phi(1) through phi(n) as comma-separated decimal bytes.
def decimal_length(value: i64) -> usize:
    length: mutable usize = 1
    remaining: mutable i64 = value
    while remaining >= 10:
        remaining <- remaining / 10
        length <- length + 1
    length

def append_decimal(value_input: i64, output: mutable view[u8], position_input: usize) -> usize:
    digits: mutable u8[3] = zeroed
    count: mutable usize = 0
    value: mutable i64 = value_input
    while true:
        digits[count] <- (48 + (value % 10).u8()).u8()
        count <- count + 1
        value <- value / 10
        if value == 0:
            break
    position: mutable usize = position_input
    while count > 0:
        count <- count - 1
        output[position] <- digits[count]
        position <- position + 1
    position

def compute_totient_impl(n: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if n < 1 or n > 80:
        return -1
    phi: mutable i64[80] = zeroed
    i: mutable i64 = 1
    while i <= n:
        phi[(i - 1).usize()] <- i
        i <- i + 1
    p: mutable i64 = 2
    while p <= n:
        if phi[(p - 1).usize()] == p:
            phi[(p - 1).usize()] <- p - 1
            i <- 2 * p
            while i <= n:
                phi[(i - 1).usize()] <- (phi[(i - 1).usize()] / p) * (p - 1)
                i <- i + p
        p <- p + 1
    required: mutable usize = (n - 1).usize()
    i <- 0
    while i < n:
        required <- required + decimal_length(phi[i.usize()])
        i <- i + 1
    if output_capacity < required:
        return -2
    position: mutable usize = 0
    i <- 0
    while i < n:
        if i > 0:
            output[position] <- 44
            position <- position + 1
        position <- append_decimal(phi[i.usize()], output[0:required], position)
        i <- i + 1
    position.i64()

export fn compute_totient(n: i64, output: mutable u8&, output_capacity: usize) -> i64 = compute_totient_impl
