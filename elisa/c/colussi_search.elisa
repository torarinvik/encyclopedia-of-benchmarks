const COLUSSI_MAX_TEXT_LENGTH: usize = 4096
const COLUSSI_MAX_PATTERN_LENGTH: usize = 128
const COLUSSI_MAX_PARSEABLE_LENGTH: usize = 4227
const COLUSSI_TABLE_SIZE: usize = COLUSSI_MAX_PATTERN_LENGTH + 1

def colussi_preprocess(pattern: view[i64], m: usize,
        h: mutable view[i64], next_positions: mutable view[i64],
        shift: mutable view[i64]) -> i64:
    hmax: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    kmin: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    nhd0: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    rmin: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    i: mutable i64 = 1
    k: mutable i64 = 1

    while k.usize() <= m:
        while pattern[i.usize()] == pattern[(i - k).usize()]:
            i <- i + 1
        hmax[k.usize()] <- i
        q: mutable i64 = k + 1
        while hmax[(q - k).usize()] + k < i:
            hmax[q.usize()] <- hmax[(q - k).usize()] + k
            q <- q + 1
        k <- q
        if k == i + 1:
            i <- k

    index: mutable usize = 0
    while index <= m:
        kmin[index] <- 0
        index <- index + 1

    i <- m.i64()
    while i >= 1:
        if hmax[i.usize()].usize() < m:
            kmin[hmax[i.usize()].usize()] <- i
        i <- i - 1

    r: mutable i64 = m.i64()
    i <- m.i64() - 1
    while i >= 0:
        if hmax[(i + 1).usize()].usize() == m:
            r <- i + 1
        rmin[i.usize()] <- r if kmin[i.usize()] == 0 else 0
        i <- i - 1

    s: mutable i64 = -1
    r <- m.i64()
    i <- 0
    while i.usize() < m:
        if kmin[i.usize()] == 0:
            r <- r - 1
            h[r.usize()] <- i
        else:
            s <- s + 1
            h[s.usize()] <- i
        i <- i + 1
    nd: i64 = s

    i <- 0
    while i <= nd:
        shift[i.usize()] <- kmin[h[i.usize()].usize()]
        i <- i + 1
    i <- nd + 1
    while i.usize() < m:
        shift[i.usize()] <- rmin[h[i.usize()].usize()]
        i <- i + 1
    shift[m] <- rmin[0]

    s <- 0
    i <- 0
    while i.usize() < m:
        nhd0[i.usize()] <- s
        if kmin[i.usize()] > 0:
            s <- s + 1
        i <- i + 1

    pos: mutable usize = 0
    i <- 0
    while i <= nd:
        pos <- h[i.usize()].usize()
        next_positions[i.usize()] <- nhd0[(pos.i64() - kmin[pos]).usize()]
        i <- i + 1
    i <- nd + 1
    while i.usize() < m:
        pos <- h[i.usize()].usize()
        next_positions[i.usize()] <- nhd0[(m.i64() - rmin[pos]).usize()]
        i <- i + 1
    pos <- h[m - 1].usize()
    next_positions[m] <- nhd0[(m.i64() - rmin[pos]).usize()]
    nd

def colussi_search_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > COLUSSI_MAX_PARSEABLE_LENGTH:
        return -1
    text_length_value: i64 = input[0]
    pattern_length_value: i64 = input[1]
    if text_length_value < 0 or text_length_value > COLUSSI_MAX_TEXT_LENGTH.i64() or
            pattern_length_value < 1 or pattern_length_value > COLUSSI_MAX_PATTERN_LENGTH.i64():
        return -1
    n: usize = text_length_value.usize()
    m: usize = pattern_length_value.usize()
    if length != 2 + n + m:
        return -1

    pattern_start: usize = 2 + n
    pattern: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    for index in 0..<n:
        if input[2 + index] < 0 or input[2 + index] > 3:
            return -1
    for index in 0..<m:
        symbol: i64 = input[pattern_start + index]
        if symbol < 0 or symbol > 3:
            return -1
        pattern[index] <- symbol
    pattern[m] <- 4

    h: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    next_positions: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    shift: mutable i64[COLUSSI_TABLE_SIZE] = zeroed
    nd: i64 = colussi_preprocess(pattern[0:COLUSSI_TABLE_SIZE], m,
        h[0:COLUSSI_TABLE_SIZE], next_positions[0:COLUSSI_TABLE_SIZE],
        shift[0:COLUSSI_TABLE_SIZE])

    match_count: mutable i64 = 0
    sum_offsets: mutable i64 = 0
    xor_offsets: mutable i64 = 0
    if n >= m:
        i: mutable usize = 0
        j: mutable usize = 0
        last: mutable i64 = -1
        while j <= n - m:
            while i < m and last < j.i64() + h[i].i64() and
                    pattern[h[i].usize()] == input[2 + j + h[i].usize()]:
                i <- i + 1
            matched: mutable bool = i >= m
            if not matched:
                matched <- last >= j.i64() + h[i].i64()
            if matched:
                match_count <- match_count + 1
                sum_offsets <- sum_offsets + j.i64()
                xor_offsets <- xor_offsets ^ j.i64()
                i <- m
            if i.i64() > nd:
                last <- j.i64() + m.i64() - 1
            j <- j + shift[i].usize()
            i <- next_positions[i].usize()

    (match_count << 36) | (sum_offsets << 12) | xor_offsets

export fn colussi_search(input: i64&, length: usize) -> i64 = colussi_search_impl
