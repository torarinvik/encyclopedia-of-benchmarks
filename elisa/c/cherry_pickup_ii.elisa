const CPII_MAX_DIM: usize = 6
const CPII_MAX_INPUT: usize = 39
const CPII_STATES: usize = 36

def cherry_pickup_ii_impl(values: i64&, values_length: usize, length: usize) -> i64:
    left: mutable usize = 0
    if length < 6 or length > CPII_MAX_INPUT or values_length != length: return -1
    rows_value:  i64 = values[0]
    columns_value:  i64 = values[1]
    if rows_value < 2 or rows_value > CPII_MAX_DIM.i64() or columns_value < 2 or columns_value > CPII_MAX_DIM.i64(): return -1
    rows:  usize = rows_value.usize()
    columns:  usize = columns_value.usize()
    if length != 2 + rows * columns: return -1
    index: mutable usize = 0
    while index < rows * columns:
        cell:  i64 = values[2 + index]
        if cell < 0 or cell > 100: return -1
        index <- index + 1
    previous: mutable i64[36] = zeroed
    current: mutable i64[36] = zeroed
    index <- 0
    while index < CPII_STATES:
        previous[index] <- -1
        index <- index + 1
    previous[columns - 1] <- values[2] + values[2 + columns - 1]
    row: mutable usize = 1
    while row < rows:
        index <- 0
        while index < CPII_STATES:
            current[index] <- -1
            index <- index + 1
        left <- 0
        while left < columns:
            right: mutable usize = 0
            while right < columns:
                score:  i64 = previous[left * columns + right]
                if score >= 0:
                    left_delta: mutable i64 = -1
                    while left_delta <= 1:
                        next_left_value:  i64 = left.i64() + left_delta
                        if next_left_value >= 0 and next_left_value < columns.i64():
                            next_left:  usize = next_left_value.usize()
                            right_delta: mutable i64 = -1
                            while right_delta <= 1:
                                next_right_value:  i64 = right.i64() + right_delta
                                if next_right_value >= 0 and next_right_value < columns.i64():
                                    next_right:  usize = next_right_value.usize()
                                    candidate: mutable i64 = score + values[2 + row * columns + next_left]
                                    if next_left != next_right:
                                        candidate <- candidate + values[2 + row * columns + next_right]
                                    slot:  usize = next_left * columns + next_right
                                    if candidate > current[slot]: current[slot] <- candidate
                                right_delta <- right_delta + 1
                        left_delta <- left_delta + 1
                right <- right + 1
            left <- left + 1
        row <- row + 1
        index <- 0
        while index < CPII_STATES:
            previous[index] <- current[index]
            index <- index + 1
    answer: mutable i64 = -1
    left <- 0
    while left < columns:
        right: mutable usize = 0
        while right < columns:
            score:  i64 = previous[left * columns + right]
            if score > answer: answer <- score
            right <- right + 1
        left <- left + 1
    answer

def cherry_pickup_ii_entry(input: i64&, length: usize) -> i64:
    if input == null or length > CPII_MAX_INPUT: return -1
    values: i64& = input
    values_length: usize = length
    cherry_pickup_ii_impl(values, values_length, length)

export fn cherry_pickup_ii(input: i64&, length: usize) -> i64 = cherry_pickup_ii_entry
