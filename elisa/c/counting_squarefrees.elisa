const MAX_N: i64 = 1000000000000
const MAX_ROOT: usize = 1000000

def counting_squarefrees_integer_sqrt(value: i64) -> i64:
    low: mutable i64 = 1
    high: mutable i64 = MAX_ROOT.i64()
    while low < high:
        middle: i64 = low + (high - low + 1) / 2
        if middle <= value / middle: low <- middle
        else: high <- middle - 1
    low

def counting_squarefrees_impl(n: i64) -> i64:
    if n < 1 or n > MAX_N: return -1
    limit: usize = counting_squarefrees_integer_sqrt(n).usize()
    mobius: mutable u8[MAX_ROOT + 1] = zeroed
    composite: mutable bool[MAX_ROOT + 1] = zeroed
    value: mutable usize = 1
    while value <= limit:
        mobius[value] <- 1
        value <- value + 1

    multiple: mutable usize = 0
    prime: mutable usize = 2
    while prime <= limit:
        if not composite[prime]:
            if prime <= limit / prime:
                multiple <- prime * prime
                while multiple <= limit:
                    composite[multiple] <- true
                    multiple <- multiple + prime
            multiple <- prime
            while multiple <= limit:
                if mobius[multiple] == 1: mobius[multiple] <- 2
                else if mobius[multiple] == 2: mobius[multiple] <- 1
                multiple <- multiple + prime
            if prime <= limit / prime:
                square: usize = prime * prime
                multiple <- square
                while multiple <= limit:
                    mobius[multiple] <- 0
                    multiple <- multiple + square
        prime <- prime + 1

    count: mutable i64 = 0
    divisor: mutable usize = 1
    while divisor <= limit:
        quotient: i64 = n / (divisor.i64() * divisor.i64())
        if mobius[divisor] == 1: count <- count + quotient
        else if mobius[divisor] == 2: count <- count - quotient
        divisor <- divisor + 1
    count

export fn counting_squarefrees(n: i64) -> i64 = counting_squarefrees_impl
