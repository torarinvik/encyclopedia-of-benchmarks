# Return the exact zero-based Catalan number through the signed 64-bit range.
def catalan_number_impl(n: i64) -> i64:
    if n < 0 or n > 35:
        return -1
    value: i64 =
        while index <= n |index: i64 = 1, current: i64 = 1| -> current:
            numerator: i64 = 4 * index - 2
            denominator: i64 = index + 1
            # gcd(4*index-2, index+1) = gcd(6, index+1).
            factor_three: i64 = 3 if denominator % 3 == 0 else 1
            factor_two: i64 = 2 if denominator % 2 == 0 else 1
            common: i64 = factor_three * factor_two
            reduced_numerator: i64 = numerator / common
            reduced_denominator: i64 = denominator / common
            current <- (current / reduced_denominator) * reduced_numerator
            index <- index + 1
    value

export fn catalan_number(n: i64) -> i64 = catalan_number_impl
