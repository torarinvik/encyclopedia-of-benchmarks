const CBENCH_BZIP2_MTF_RLE_MAX_BLOCK: usize = 32
const CBENCH_BZIP2_MTF_RLE_MAX_TOKENS: usize = 33
const CBENCH_BZIP2_MTF_RLE_MAX_INPUT: usize = 68

def cbench_bzip2_mtf_rle_emit_run(tokens: mutable view[u8], used: mutable usize&, count: usize) -> void:
    if count == 0:
        return
    value: mutable usize = count - 1
    while true:
        tokens[used] <- if (value & 1) != 0: 1.u8() else: 0.u8()
        used <- used + 1
        if value < 2:
            break
        value <- (value - 2) / 2

def cbench_bzip2_mtf_rle_impl(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or input_length < 3 or input_length > CBENCH_BZIP2_MTF_RLE_MAX_INPUT:
        return -1
    staged: mutable u8[CBENCH_BZIP2_MTF_RLE_MAX_TOKENS] = zeroed
    staged_count: mutable usize = 0

    if input[0] == 0:
        if input[1] != 0 or input[2] < 1 or input[2] > 32:
            return -1
        block_length: usize = input[2].usize()
        if input_length != 3 + block_length:
            return -1
        alphabet: mutable u8[CBENCH_BZIP2_MTF_RLE_MAX_BLOCK] = zeroed
        alphabet_length: mutable usize = 0
        for i in 0..<block_length |input, alphabet|:
            value: i64 = input[3 + i]
            if value < 0 or value > 255:
                return -1
            at: mutable usize = 0
            while at < alphabet_length and alphabet[at] < value.u8():
                at <- at + 1
            if at < alphabet_length and alphabet[at] == value.u8():
                continue
            j: mutable usize = alphabet_length
            while j > at:
                alphabet[j] <- alphabet[j - 1]
                j <- j - 1
            alphabet[at] <- value.u8()
            alphabet_length <- alphabet_length + 1
        order: mutable u8[CBENCH_BZIP2_MTF_RLE_MAX_BLOCK] = zeroed
        for i in 0..<alphabet_length |order|:
            order[i] <- i.u8()
        pending_zeros: mutable usize = 0
        for i in 0..<block_length |input, alphabet, order, staged|:
            value: u8 = input[3 + i].u8()
            symbol: mutable usize = 0
            while alphabet[symbol] != value:
                symbol <- symbol + 1
            rank: mutable usize = 0
            while order[rank].usize() != symbol:
                rank <- rank + 1
            if rank == 0:
                pending_zeros <- pending_zeros + 1
                continue
            cbench_bzip2_mtf_rle_emit_run(staged[0:CBENCH_BZIP2_MTF_RLE_MAX_TOKENS], &staged_count, pending_zeros)
            pending_zeros <- 0
            staged[staged_count] <- (rank + 1).u8()
            staged_count <- staged_count + 1
            moved: u8 = order[rank]
            j: mutable usize = rank
            while j > 0:
                order[j] <- order[j - 1]
                j <- j - 1
            order[0] <- moved
        cbench_bzip2_mtf_rle_emit_run(staged[0:CBENCH_BZIP2_MTF_RLE_MAX_TOKENS], &staged_count, pending_zeros)
        staged[staged_count] <- (alphabet_length + 1).u8()
        staged_count <- staged_count + 1
    else if input[0] == 1:
        if input[1] < 1 or input[1] > 32 or input[2] < 2 or input[2] > 33:
            return -1
        alphabet_length: usize = input[1].usize()
        token_count: usize = input[2].usize()
        if input_length != 3 + alphabet_length + token_count:
            return -1
        order: mutable u8[CBENCH_BZIP2_MTF_RLE_MAX_BLOCK] = zeroed
        for i in 0..<alphabet_length |input, order|:
            symbol: i64 = input[3 + i]
            if symbol < 0 or symbol > 255 or (i > 0 and input[2 + i] >= symbol):
                return -1
            order[i] <- symbol.u8()
        token_start: usize = 3 + alphabet_length
        eob: i64 = i64(alphabet_length + 1)
        for i in 0..<token_count |input|:
            token: i64 = input[token_start + i]
            if token < 0 or token > eob or (i + 1 < token_count and token == eob):
                return -1
        if input[token_start + token_count - 1] != eob:
            return -1
        index: mutable usize = 0
        while index + 1 < token_count:
            token: i64 = input[token_start + index]
            if token == 0 or token == 1:
                run_count: mutable usize = 0
                weight: mutable usize = 1
                while index + 1 < token_count:
                    run_token: i64 = input[token_start + index]
                    if run_token != 0 and run_token != 1:
                        break
                    if weight > CBENCH_BZIP2_MTF_RLE_MAX_BLOCK:
                        return -1
                    add: usize = (run_token + 1).usize() * weight
                    if run_count + add > CBENCH_BZIP2_MTF_RLE_MAX_BLOCK:
                        return -1
                    run_count <- run_count + add
                    weight <- weight * 2
                    index <- index + 1
                if staged_count + run_count > CBENCH_BZIP2_MTF_RLE_MAX_BLOCK:
                    return -1
                for j in 0..<run_count |staged, order|:
                    staged[staged_count] <- order[0]
                    staged_count <- staged_count + 1
                continue
            if token < 2 or token >= eob:
                return -1
            rank: usize = (token - 1).usize()
            if rank >= alphabet_length or staged_count >= CBENCH_BZIP2_MTF_RLE_MAX_BLOCK:
                return -1
            moved: u8 = order[rank]
            staged[staged_count] <- moved
            staged_count <- staged_count + 1
            j: mutable usize = rank
            while j > 0:
                order[j] <- order[j - 1]
                j <- j - 1
            order[0] <- moved
            index <- index + 1
        if staged_count == 0:
            return -1
    else:
        return -1

    if output == null or output_capacity < staged_count:
        return -2
    for i in 0..<staged_count |staged, output|:
        output[i] <- staged[i]
    staged_count.i64()

export fn cbench_bzip2_mtf_rle(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = cbench_bzip2_mtf_rle_impl
