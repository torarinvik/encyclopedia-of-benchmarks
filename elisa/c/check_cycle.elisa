# Detect directed cycles with iterative three-color depth-first search.
const MAX_VERTICES: usize = 32
const MAX_EDGES: usize = 256
const MAX_MATRIX: usize = MAX_VERTICES * MAX_VERTICES

def check_cycle_impl(input: i64&, length: usize) -> i64:
    if length < 2 or input[0] < 0 or input[0] > MAX_VERTICES.i64() or input[1] < 0 or input[1] > MAX_EDGES.i64():
        return -1
    vertices: usize = input[0].usize()
    edges: usize = input[1].usize()
    if length != 2 + 2 * edges:
        return -1

    adjacency: mutable bool[MAX_MATRIX] = zeroed
    edge: mutable usize = 0
    while edge < edges:
        origin: i64 = input[2 + 2 * edge]
        destination: i64 = input[3 + 2 * edge]
        if origin < 0 or origin >= vertices.i64() or destination < 0 or destination >= vertices.i64():
            return -1
        adjacency[origin.usize() * MAX_VERTICES + destination.usize()] <- true
        edge <- edge + 1

    color: mutable i64[MAX_VERTICES] = zeroed
    stack: mutable usize[MAX_VERTICES] = zeroed
    next_neighbor: mutable usize[MAX_VERTICES] = zeroed
    start: mutable usize = 0
    while start < vertices:
        if color[start] == 0:
            top: mutable usize = 1
            stack[0] <- start
            next_neighbor[0] <- 0
            color[start] <- 1
            while top > 0:
                frame: usize = top - 1
                current: usize = stack[frame]
                while next_neighbor[frame] < vertices and not adjacency[current * MAX_VERTICES + next_neighbor[frame]]:
                    next_neighbor[frame] <- next_neighbor[frame] + 1
                if next_neighbor[frame] == vertices:
                    color[current] <- 2
                    top <- top - 1
                else:
                    neighbor: usize = next_neighbor[frame]
                    next_neighbor[frame] <- next_neighbor[frame] + 1
                    if color[neighbor] == 1:
                        return 1
                    if color[neighbor] == 0:
                        color[neighbor] <- 1
                        stack[top] <- neighbor
                        next_neighbor[top] <- 0
                        top <- top + 1
        start <- start + 1
    0

export fn check_cycle(input: i64&, length: usize) -> i64 = check_cycle_impl
