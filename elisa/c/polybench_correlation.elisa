# PolyBench/C correlation bounded port. See benchmarks/c/polybench_correlation/LICENSE.txt.
extern trunc(value: f64) -> f64
extern sqrt(value: f64) -> f64
const MAX_N: usize = 6
const MAX_M: usize = 6

def polybench_correlation_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length != 2: return -1
    nv: f64 = input[0]
    mv: f64 = input[1]
    if nv != nv or mv != mv or trunc(nv) != nv or trunc(mv) != mv: return -1
    if nv < 1.0 or nv > MAX_N.f64() or mv < 1.0 or mv > MAX_M.f64(): return -1
    n: usize = nv.usize()
    m: usize = mv.usize()
    required: usize = m * m
    if output.is_null() or capacity < required: return -2
    data: mutable f64[36] = zeroed
    corr: mutable f64[36] = zeroed
    mean: mutable f64[6] = zeroed
    stddev: mutable f64[6] = zeroed
    staged: mutable f64[36] = zeroed
    float_n: f64 = n.f64()
    for i in 0..<n:
        for j in 0..<m: data[i * m + j] <- (i * j).f64() / m.f64() + i.f64()
    for j in 0..<m:
        mean[j] <- 0.0
        for i in 0..<n: mean[j] <- mean[j] + data[i * m + j]
        mean[j] <- mean[j] / float_n
    for j in 0..<m:
        stddev[j] <- 0.0
        for i in 0..<n:
            delta: f64 = data[i * m + j] - mean[j]
            stddev[j] <- stddev[j] + delta * delta
        stddev[j] <- stddev[j] / float_n
        stddev[j] <- sqrt(stddev[j])
        if stddev[j] <= 0.1: stddev[j] <- 1.0
    root_n: f64 = sqrt(float_n)
    for i in 0..<n:
        for j in 0..<m:
            data[i * m + j] <- data[i * m + j] - mean[j]
            data[i * m + j] <- data[i * m + j] / (root_n * stddev[j])
    if m > 1:
        for i in 0..<(m - 1):
            corr[i * m + i] <- 1.0
            for j in (i + 1)..<m:
                corr[i * m + j] <- 0.0
                for k in 0..<n: corr[i * m + j] <- corr[i * m + j] + data[k * m + i] * data[k * m + j]
                corr[j * m + i] <- corr[i * m + j]
    corr[(m - 1) * m + m - 1] <- 1.0
    for q in 0..<required: staged[q] <- corr[q]
    for q in 0..<required: output[q] <- staged[q]
    required.i64()

export fn polybench_correlation(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = polybench_correlation_impl
