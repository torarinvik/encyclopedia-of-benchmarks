from std.collections import InlineArray

const BUCKETS: usize = 8
const WIDTH: usize = 4
const MAX_OPERATIONS: usize = 32
const MAX_KICKS: usize = 8

def cf_delta(fingerprint: i64) -> usize:
    1 + ((5 * fingerprint.usize() + 3) % 7)

def cf_write(output: mutable view[u8], index: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[index * 8 + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def cf_impl(values: view[i64], output: mutable view[u8], count: usize) -> i64:
    var table = InlineArray[i64, BUCKETS * WIDTH](fill=0)
    var statuses = InlineArray[i64, MAX_OPERATIONS](fill=0)
    operation: mutable usize = 0
    while operation < count:
        opcode: i64 = values[1 + 3 * operation]
        primary: usize = values[2 + 3 * operation].usize()
        fingerprint: i64 = values[3 + 3 * operation]
        alternate: usize = primary ^ cf_delta(fingerprint)
        if opcode == 0:
            empty: mutable usize = WIDTH
            slot: mutable usize = 0
            while slot < WIDTH:
                if table[primary * WIDTH + slot] == 0: empty <- slot; break
                slot <- slot + 1
            if empty < WIDTH:
                table[primary * WIDTH + empty] <- fingerprint
            else:
                slot <- 0
                while slot < WIDTH:
                    if table[alternate * WIDTH + slot] == 0: empty <- slot; break
                    slot <- slot + 1
                if empty < WIDTH:
                    table[alternate * WIDTH + empty] <- fingerprint
                else:
                    current: mutable usize = primary
                    pending: mutable i64 = fingerprint
                    kick: mutable usize = 0
                    placed: mutable Bool = False
                    while kick < MAX_KICKS:
                        position: usize = current * WIDTH
                        evicted: i64 = table[position]
                        table[position] <- pending
                        pending <- evicted
                        current <- current ^ cf_delta(pending)
                        slot <- 0
                        while slot < WIDTH:
                            if table[current * WIDTH + slot] == 0: empty <- slot; break
                            slot <- slot + 1
                        if empty < WIDTH:
                            table[current * WIDTH + empty] <- pending
                            placed <- True
                            break
                        kick <- kick + 1
                    if not placed: return -3
            statuses[operation] <- 1
        else if opcode == 1:
            found: mutable Bool = False
            order: mutable usize = 0
            while order < 2:
                bucket: usize = if order == 0: primary else: alternate
                slot <- 0
                while slot < WIDTH:
                    if table[bucket * WIDTH + slot] == fingerprint: found <- True
                    slot <- slot + 1
                order <- order + 1
            statuses[operation] <- if found: 1 else: 0
        else:
            removed: mutable Bool = False
            order: mutable usize = 0
            while order < 2 and not removed:
                bucket: usize = if order == 0: primary else: alternate
                slot <- 0
                while slot < WIDTH:
                    position: usize = bucket * WIDTH + slot
                    if table[position] == fingerprint:
                        table[position] <- 0
                        removed <- True
                        break
                    slot <- slot + 1
                order <- order + 1
            statuses[operation] <- if removed: 1 else: 0
        operation <- operation + 1
    operation <- 0
    while operation < count:
        cf_write(output, operation, statuses[operation])
        operation <- operation + 1
    (count * 8).i64()

@export("cuckoo_filter_operation_trace")
def cuckoo_filter_operation_trace(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > 98: return -1
    var values: view[i64] = input[0:length]
    raw_count: i64 = values[0]
    if raw_count < 1 or raw_count > MAX_OPERATIONS.i64(): return -1
    count: usize = raw_count.usize()
    if length != 1 + 3 * count: return -1
    operation: mutable usize = 0
    while operation < count:
        opcode: i64 = values[1 + 3 * operation]
        primary: i64 = values[2 + 3 * operation]
        fingerprint: i64 = values[3 + 3 * operation]
        if opcode < 0 or opcode > 2 or primary < 0 or primary >= BUCKETS.i64() or
                fingerprint < 1 or fingerprint > 15: return -1
        operation <- operation + 1
    required: usize = count * 8
    if output.is_null() or capacity < required: return -2
    var bytes: mutable view[u8] = output[0:required]
    cf_impl(values, bytes, count)
