def count_min_sketch_width_one_collision_put_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def count_min_sketch_width_one_collision_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 513 or input[0] < 0 or input[0] > 256: return -1
    count: usize = input[0].usize()
    if length != 1 + count * 2: return -1
    queries: mutable usize = 0
    index: mutable usize = 0
    while index < count:
        operation: i64 = input[1 + 2 * index]
        key: i64 = input[2 + 2 * index]
        if (operation != 0 and operation != 1) or key < -1000000 or key > 1000000: return -1
        if operation == 1: queries <- queries + 1
        index <- index + 1
    required: usize = queries * 8
    if capacity < required or (required > 0 and output.is_null()): return -2
    inserts: mutable i64 = 0
    output_offset: mutable usize = 0
    index <- 0
    while index < count:
        if input[1 + 2 * index] == 0: inserts <- inserts + 1
        else:
            count_min_sketch_width_one_collision_put_i64_le(output, output_offset, inserts)
            output_offset <- output_offset + 8
        index <- index + 1
    required.i64()

export fn count_min_sketch_width_one_collision(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = count_min_sketch_width_one_collision_impl
