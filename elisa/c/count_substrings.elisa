const MAX_LENGTH: usize = 4096

def count_substrings_find(values: i64&, text_length: usize, pattern_length: usize,
                          pattern_start: usize, start: usize) -> i64:
    if start > text_length or pattern_length > text_length - start:
        return -1
    last: usize = text_length - pattern_length
    position: mutable usize = start
    while position <= last:
        offset: mutable usize = 0
        while offset < pattern_length and values[2 + position + offset] == values[pattern_start + offset]:
            offset <- offset + 1
        if offset == pattern_length:
            return i64(position)
        position <- position + 1
    -1

def count_substrings_impl(values: i64&, length: usize) -> i64:
    if length < 2 or values[0] < 0 or values[0] > i64(MAX_LENGTH) or values[1] < 0 or values[1] > i64(MAX_LENGTH):
        return -1
    text_length: usize = usize(values[0])
    pattern_length: usize = usize(values[1])
    if length != 2 + text_length + pattern_length:
        return -1
    i: mutable usize = 2
    while i < length:
        if values[i] < 0 or values[i] > 127:
            return -1
        i <- i + 1
    if pattern_length == 0:
        return i64(text_length) + 1
    pattern_start: usize = 2 + text_length
    count: mutable i64 = 0
    position: mutable i64 = count_substrings_find(values, text_length, pattern_length, pattern_start, 0)
    while position >= 0:
        count <- count + 1
        position <- count_substrings_find(values, text_length, pattern_length, pattern_start, usize(position) + 1)
    count

export fn count_substrings(values: i64&, length: usize) -> i64 = count_substrings_impl
