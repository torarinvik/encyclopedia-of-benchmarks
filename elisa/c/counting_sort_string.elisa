# Portable byte counting sort for printable non-space ASCII characters.
def counting_sort_string_impl(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if values == null or length < 1 or length > 4096:
        return -1
    count: i64 = values[0]
    if count < 0 or count > 4095 or length != count.usize() + 1:
        return -1

    frequencies: mutable i64[256] = zeroed
    index: mutable usize = 0
    while index < count.usize():
        value: i64 = values[index + 1]
        if value < 33 or value > 126:
            return -1
        frequencies[value.usize()] <- frequencies[value.usize()] + 1
        index <- index + 1
    if output == null or output_capacity < count.usize():
        return -2

    key: mutable usize = 1
    while key < 256:
        frequencies[key] <- frequencies[key] + frequencies[key - 1]
        key <- key + 1
    index <- count.usize()
    while index > 0:
        value: usize = values[index].usize()
        frequencies[value] <- frequencies[value] - 1
        output[frequencies[value].usize()] <- value.u8()
        index <- index - 1
    count

export fn counting_sort_string(values: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = counting_sort_string_impl
