# Can lowercase ASCII letters be rearranged into a palindrome?
def can_string_be_rearranged_as_palindrome_impl(text: i64&, length: usize) -> i64:
    if length == 0 or length > 4096:
        return -1
    result: i64 =
        while index < length |index: mutable usize = 0, counts: mutable usize[26] = zeroed, odd_count: mutable usize = 0, result: mutable i64 = 0| -> result:
            value: i64 = text[index]
            if value < 97 or value > 122:
                break -1
            letter: usize = (value - 97).usize()
            if counts[letter] % 2 == 0:
                odd_count <- odd_count + 1
            else:
                odd_count <- odd_count - 1
            counts[letter] <- counts[letter] + 1
            index <- index + 1
            if index == length:
                if odd_count <= 1:
                    result <- 1
                else:
                    result <- 0
    result

export fn can_string_be_rearranged_as_palindrome(text: i64&, length: usize) -> i64 = can_string_be_rearranged_as_palindrome_impl
