# Selected entry in the Haskell complementary-filter scan trace.
const MAX_SAMPLES: usize = 32
const SCALE: i64 = 1000000
const MAX_SIGNAL_MICRO: i64 = 1000000
const INVALID_RESULT: f64 = -1.0e300

def comp_filt_impl(values: i64&, length: usize) -> f64:
    if values == null or length < 6 or length > 68:
        return INVALID_RESULT
    alpha_ppm: i64 = values[0]
    delta_t_micro: i64 = values[1]
    count_value: i64 = values[2]
    output_index_value: i64 = values[3]
    if alpha_ppm < 0 or alpha_ppm > SCALE or delta_t_micro < 0 or delta_t_micro > SCALE or count_value < 1 or count_value > MAX_SAMPLES.i64() or output_index_value < 0 or output_index_value > count_value:
        return INVALID_RESULT
    count: usize = count_value.usize()
    output_index: usize = output_index_value.usize()
    if length != 4 + 2 * count:
        return INVALID_RESULT
    for i in 0..<count:
        rate: i64 = values[4 + i]
        reference: i64 = values[4 + count + i]
        if rate < -MAX_SIGNAL_MICRO or rate > MAX_SIGNAL_MICRO or reference < -MAX_SIGNAL_MICRO or reference > MAX_SIGNAL_MICRO:
            return INVALID_RESULT
    alpha: f64 = alpha_ppm.f64() / SCALE.f64()
    delta_t: f64 = delta_t_micro.f64() / SCALE.f64()
    theta: mutable f64 = values[4 + count].f64() / SCALE.f64()
    for i in 0..<output_index:
        rate: f64 = values[4 + i].f64() / SCALE.f64()
        reference: f64 = values[4 + count + i].f64() / SCALE.f64()
        theta <- alpha * (theta + rate * delta_t) + (1.0 - alpha) * reference
    theta

export fn comp_filt(values: i64&, length: usize) -> f64 = comp_filt_impl
