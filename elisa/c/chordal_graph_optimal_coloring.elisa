# Uncompiled chordal-graph optimal coloring draft.
def cgoc_solve(values: i64&, values_length: usize) -> i64:
    if values_length < 2 or values_length > 18: return -1
    nv: i64 = values[0]
    if nv < 1 or nv > 16: return -1
    n: usize = nv.usize()
    if values_length != n + 1: return -1
    rows: mutable i64[16] = zeroed
    weights: mutable i64[16] = zeroed
    colors: mutable i64[16] = zeroed
    order: mutable usize[16] = zeroed
    for v in 0..<n:
        if values[v + 1] < 0 or values[v + 1] >= (1 << n) or (values[v + 1] & (1 << v)) != 0: return -1
        rows[v] <- values[v + 1]
        colors[v] <- -1
    for v in 0..<n:
        for u in 0..<v:
            if ((rows[v] >> u) & 1) != ((rows[u] >> v) & 1): return -1
    selected: mutable i64 = 0
    for i in 0..<n:
        vertex: mutable usize = n
        for u in 0..<n:
            if (selected & (1 << u)) == 0:
                if vertex == n: vertex <- u
                elif weights[u] > weights[vertex]: vertex <- u
        earlier: i64 = rows[vertex] & selected
        for j in 0..<i:
            u: usize = order[j]
            if (earlier & (1 << u)) != 0 and (earlier & ~(rows[u] | (1 << u))) != 0: return -2
        order[i] <- vertex
        selected <- selected | (1 << vertex)
        for u in 0..<n:
            if (selected & (1 << u)) == 0 and (rows[vertex] & (1 << u)) != 0:
                weights[u] <- weights[u] + 1
    maximum: mutable i64 = 0
    for i in 0..<n:
        v: usize = order[i]
        used: mutable i64 = 0
        for u in 0..<n:
            if (rows[v] & (1 << u)) != 0 and colors[u] >= 0:
                used <- used | (1 << colors[u].usize())
        color: mutable i64 = 0
        while (used & (1 << color.usize())) != 0:
            color <- color + 1
        colors[v] <- color
        if color + 1 > maximum: maximum <- color + 1
    maximum

def chordal_graph_optimal_coloring_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > 18: return -1
    cgoc_solve(input, length)

export fn chordal_graph_optimal_coloring(input: i64&, length: usize) -> i64 = chordal_graph_optimal_coloring_impl
