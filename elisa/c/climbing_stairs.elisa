# Count ways to climb n stairs using one or two steps per move.
def climbing_stairs_impl(steps: i64) -> i64:
    if steps < 1 or steps > 45:
        return -1
    previous: mutable i64 = 1
    current: mutable i64 = 1
    index: mutable i64 = 2
    while index <= steps:
        next: i64 = previous + current
        previous <- current
        current <- next
        index <- index + 1
    current

export fn climbing_stairs(steps: i64) -> i64 = climbing_stairs_impl
