@intrinsic("llvm.sin.f64")
extern sin(value: f64) -> f64
@intrinsic("llvm.cos.f64")
extern cos(value: f64) -> f64
extern atan2(y: f64, x: f64) -> f64
@intrinsic("llvm.floor.f64")
extern floor(value: f64) -> f64
@intrinsic("llvm.sqrt.f64")
extern sqrt(value: f64) -> f64
@intrinsic("llvm.fabs.f64")
extern fabs(value: f64) -> f64

const CMD_PI: f64 = 3.14159265358979323846264338327950288
const CMD_TAU: f64 = 6.28318530717958647692528676655900576

# Two binary64 steps below pi keep angle + pi strictly below tau after rounding.
const CMD_ZERO_QUOTIENT_LIMIT: f64 = 3.1415926535897922

def cmd_wrap(angle: f64) -> f64:
    value: f64 = angle - floor((angle + CMD_PI) / CMD_TAU) * CMD_TAU
    if fabs(value) < CMD_PI: return value
    if value < -CMD_PI: return value + CMD_TAU
    if value >= CMD_PI: return value - CMD_TAU
    value

def circular_mean_direction_impl(values: f64&, length: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if values == null or length < 2 or length > 65: return -1
    if length == 2:
        if values[0] != 1.0: return -1
        raw: f64 = values[1]
        magnitude: f64 = fabs(raw)
        angle: mutable f64 = raw
        # The reduction quotient is zero throughout this interval.
        if not (magnitude <= CMD_ZERO_QUOTIENT_LIMIT):
            if not (magnitude <= 8.0 * CMD_PI): return -1
            angle <- cmd_wrap(raw)
        if output == null or output_capacity < 1: return -2
        direction: f64 = atan2(0.0 + sin(angle), 0.0 + cos(angle))
        output[0] <- -direction if direction >= CMD_PI else direction
        return 1

    count: usize = length - 1
    if values[0] != count.f64(): return -1
    circular_mean_multiple(values, count, output, output_capacity)

@inline(never)
def circular_mean_multiple(values: f64&, count: usize, output: mutable f64&, output_capacity: usize) -> i64:
    first: f64 = values[1]
    if not (fabs(first) <= 8.0 * CMD_PI): return -1
    first_angle: f64 = first if fabs(first) <= CMD_ZERO_QUOTIENT_LIMIT else cmd_wrap(first)
    # With zero initial sums the first Kahan correction is exactly zero.
    sum_cos: mutable f64 = 0.0 + cos(first_angle)
    sum_sin: mutable f64 = 0.0 + sin(first_angle)
    correction_cos: mutable f64 = 0.0
    correction_sin: mutable f64 = 0.0
    for index in 1..<count:
        raw: f64 = values[index + 1]
        if not (fabs(raw) <= 8.0 * CMD_PI): return -1
        angle: f64 = raw if fabs(raw) <= CMD_ZERO_QUOTIENT_LIMIT else cmd_wrap(raw)
        adjusted_cos: f64 = cos(angle) - correction_cos
        next_cos: f64 = sum_cos + adjusted_cos
        correction_cos <- (next_cos - sum_cos) - adjusted_cos
        sum_cos <- next_cos
        adjusted_sin: f64 = sin(angle) - correction_sin
        next_sin: f64 = sum_sin + adjusted_sin
        correction_sin <- (next_sin - sum_sin) - adjusted_sin
        sum_sin <- next_sin
    resultant: f64 = sqrt(sum_cos * sum_cos + sum_sin * sum_sin)
    if not (resultant > count.f64() * 0.0000000037252902984619140625):
        return -1
    if output == null or output_capacity < 1: return -2
    # atan2 already returns an angle in [-pi, pi].
    direction: f64 = atan2(sum_sin, sum_cos)
    output[0] <- -direction if direction >= CMD_PI else direction
    1

export fn circular_mean_direction(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64 = circular_mean_direction_impl
