# Circular mean of wrapped angles with Kahan-compensated cosine and sine sums.
@intrinsic("llvm.sin.f64")
extern sin(value: f64) -> f64
@intrinsic("llvm.cos.f64")
extern cos(value: f64) -> f64
extern atan2(y: f64, x: f64) -> f64
@intrinsic("llvm.floor.f64")
extern floor(value: f64) -> f64
@intrinsic("llvm.trunc.f64")
extern trunc(value: f64) -> f64
@intrinsic("llvm.sqrt.f64")
extern sqrt(value: f64) -> f64
@intrinsic("llvm.fabs.f64")
extern fabs(value: f64) -> f64

const CMD_PI: f64 = 3.14159265358979323846264338327950288
const CMD_TAU: f64 = 6.28318530717958647692528676655900576

const CMD_MAX_FINITE: f64 = 1.7976931348623157e308

# False for NaN and both infinities, like C's isfinite.
def cmd_finite(value: f64) -> bool:
    fabs(value) <= CMD_MAX_FINITE

def cmd_wrap(angle: f64) -> f64:
    value: mutable f64 = angle - floor((angle + CMD_PI) / CMD_TAU) * CMD_TAU
    if value >= CMD_PI:
        value <- value - CMD_TAU
    if value < -CMD_PI:
        value <- value + CMD_TAU
    value

def circular_mean_direction_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 66:
        return -1
    count_value: f64 = input[0]
    if not cmd_finite(count_value) or trunc(count_value) != count_value or count_value < 1.0 or count_value > 64.0:
        return -1
    count: usize = count_value.usize()
    if length != count + 1:
        return -1

    sum_cos: mutable f64 = 0.0
    sum_sin: mutable f64 = 0.0
    correction_cos: mutable f64 = 0.0
    correction_sin: mutable f64 = 0.0
    angle_bound: f64 = 8.0 * CMD_PI
    index: mutable usize = 0
    while index < count:
        raw: f64 = input[index + 1]
        if not cmd_finite(raw) or fabs(raw) > angle_bound:
            return -1
        angle: f64 = cmd_wrap(raw)
        adjusted_cos: f64 = cos(angle) - correction_cos
        next_cos: f64 = sum_cos + adjusted_cos
        correction_cos <- (next_cos - sum_cos) - adjusted_cos
        sum_cos <- next_cos
        adjusted_sin: f64 = sin(angle) - correction_sin
        next_sin: f64 = sum_sin + adjusted_sin
        correction_sin <- (next_sin - sum_sin) - adjusted_sin
        sum_sin <- next_sin
        index <- index + 1
    resultant: f64 = sqrt(sum_cos * sum_cos + sum_sin * sum_sin)
    # 2^-28 per sample: below this the direction is numerically undefined.
    if not cmd_finite(resultant) or resultant <= count.f64() * 0.0000000037252902984619140625:
        return -1
    if output == null or capacity < 1:
        return -2
    output[0] <- cmd_wrap(atan2(sum_sin, sum_cos))
    1

export fn circular_mean_direction(input: f64&, input_length: usize, output: mutable f64&, output_capacity: usize) -> i64 = circular_mean_direction_impl
