# Compute the central polygonal number n(n+1)/2 + 1 safely.
def central_polygonal_numbers_sequence_impl(input: i64) -> i64:
    if input < 0 or input > 4294967295:
        return -1
    left: i64 = input / 2 if input % 2 == 0 else input
    right: i64 = input + 1 if input % 2 == 0 else (input + 1) / 2
    left * right + 1

export fn central_polygonal_numbers_sequence(input: i64) -> i64 = central_polygonal_numbers_sequence_impl
