const FPS_MODULUS: i64 = 998_244_353
const FPS_MIN_N: usize = 2
const FPS_MAX_N: usize = 16
const FPS_MAX_INPUT: usize = 18

def fps_mod_pow(base_value: i64, exponent_value: i64) -> i64:
    base: mutable i64 = base_value % FPS_MODULUS
    exponent: mutable i64 = exponent_value
    result: mutable i64 = 1
    while exponent > 0:
        if exponent % 2 == 1: result <- result * base % FPS_MODULUS
        base <- base * base % FPS_MODULUS
        exponent <- exponent / 2
    result

def fps_store_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[position + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def compositional_inverse_of_formal_power_series_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < FPS_MIN_N + 1 or length > FPS_MAX_INPUT: return -1
    n_value: i64 = input[0]
    if n_value < FPS_MIN_N.i64() or n_value > FPS_MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != n + 1: return -1
    for i in 0..<n:
        coefficient: i64 = input[i + 1]
        if coefficient < 0 or coefficient >= FPS_MODULUS: return -1
    if input[1] != 0 or input[2] == 0: return -1
    bytes: usize = 8 * n
    if output.is_null() or capacity < bytes: return -2

    powers: mutable [FPS_MAX_N * FPS_MAX_N]i64 = [0; FPS_MAX_N * FPS_MAX_N]
    inverse_series: mutable [FPS_MAX_N]i64 = [0; FPS_MAX_N]
    inverse_linear: i64 = fps_mod_pow(input[2], FPS_MODULUS - 2)
    inverse_series[1] <- inverse_linear
    powers[FPS_MAX_N + 1] <- inverse_linear
    for degree in 2..<n:
        for power in 2..<(degree + 1):
            coefficient: mutable i64 = 0
            for split in 1..<degree:
                coefficient <- (coefficient + powers[(power - 1) * FPS_MAX_N + degree - split] *
                    inverse_series[split]) % FPS_MODULUS
            powers[power * FPS_MAX_N + degree] <- coefficient
        composed_coefficient: mutable i64 = 0
        for power in 2..<(degree + 1):
            composed_coefficient <- (composed_coefficient + input[power + 1] *
                powers[power * FPS_MAX_N + degree]) % FPS_MODULUS
        inverse_series[degree] <- (FPS_MODULUS - composed_coefficient) * inverse_linear % FPS_MODULUS
        powers[FPS_MAX_N + degree] <- inverse_series[degree]
    for i in 0..<n: fps_store_le(inverse_series[i], output[0:bytes], 8 * i)
    bytes.i64()

export fn compositional_inverse_of_formal_power_series(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = compositional_inverse_of_formal_power_series_impl
