# Bounded circular buffer with overwrite-oldest behavior when full.
def circular_buffer_benchmark_impl(values: i64&, length: usize) -> i64:
    if length < 1 or length > 1025 or (length - 1) % 2 != 0:
        return -1
    capacity_value: i64 = values[0]
    if capacity_value < 1 or capacity_value > 256:
        return -1
    capacity: usize = capacity_value.usize()
    operation_count: usize = (length - 1) / 2
    checksum: i64 =
        while operation < operation_count |operation: mutable usize = 0, buffer: mutable i64[256] = zeroed, head: mutable usize = 0, tail_index: mutable usize = 0, count: mutable usize = 0, checksum: mutable i64 = 0| -> checksum:
            opcode: i64 = values[1 + 2 * operation]
            payload: i64 = values[2 + 2 * operation]
            observed: mutable i64 = 0
            if opcode == 0:
                if payload < 0 or payload > 1000000:
                    break -1
                if count == 0:
                    observed <- 1
                if count == capacity:
                    head <- (head + 1) % capacity
                else:
                    count <- count + 1
                buffer[tail_index] <- payload
                tail_index <- (tail_index + 1) % capacity
            elif opcode == 1:
                if payload != 0:
                    break -1
                if count == 0:
                    observed <- -1
                else:
                    observed <- buffer[head]
                    head <- (head + 1) % capacity
                    count <- count - 1
            elif opcode == 2:
                if payload != 0:
                    break -1
                if count == 0:
                    observed <- 1
            elif opcode == 3:
                if payload != 0:
                    break -1
                if count == capacity:
                    observed <- 1
            elif opcode == 4:
                if payload != 0:
                    break -1
                observed <- count.i64()
            else:
                break -1
            checksum <- checksum + (operation + 1).i64() * (observed + 1000000)
            if operation + 1 == operation_count:
                checksum <- for index in 0..<count |index: mutable usize = 0, total: mutable i64 = checksum| -> total:
                    total <- total + (operation_count + index + 1).i64() * (buffer[(head + index) % capacity] + 1000000)
            operation <- operation + 1
    checksum

export fn circular_buffer_benchmark(values: i64&, length: usize) -> i64 = circular_buffer_benchmark_impl
