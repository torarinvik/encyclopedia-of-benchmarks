const MAX_LENGTH: usize = 4096

def check_snake_case_impl(values: i64&, length: usize) -> i64:
    if length > MAX_LENGTH:
        return -2
    found: mutable i64 = 0
    index: mutable usize = 0
    while index < length:
        value: i64 = values[index]
        if value < 32 or value > 126:
            return -2
        if value == 95:
            found <- 1
        index <- index + 1
    found

export fn check_snake_case(values: i64&, length: usize) -> i64 = check_snake_case_impl
