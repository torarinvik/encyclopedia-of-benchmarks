@intrinsic("llvm.ctlz.i32")
extern leading_zeros(value: u32, zero_undefined: bool) -> u32

def count_leading_zeros_impl(value: i64) -> i64:
    return -1 if value < -2147483648 or value > 2147483647
    leading_zeros(value.u32(), false).i64()

export fn count_leading_zeros(value: i64) -> i64 = count_leading_zeros_impl
