# Circle sort compares mirrored pairs, recurses into both halves, and repeats
# until a complete pass makes no swaps.
def circle_sort_range(values: mutable view[i64], left_value: usize, right_value: usize) -> bool:
    if left_value >= right_value:
        return false

    low: mutable usize = left_value
    high: mutable usize = right_value
    swapped: mutable bool = false
    while low < high:
        if values[low] > values[high]:
            temporary: i64 = values[low]
            values[low] <- values[high]
            values[high] <- temporary
            swapped <- true
        low <- low + 1
        high <- high - 1
    if low == high and values[low] > values[high + 1]:
        temporary: i64 = values[low]
        values[low] <- values[high + 1]
        values[high + 1] <- temporary
        swapped <- true

    middle: usize = left_value + (right_value - left_value) / 2
    left_swapped: bool = circle_sort_range(values, left_value, middle)
    right_swapped: bool = circle_sort_range(values, middle + 1, right_value)
    swapped or left_swapped or right_swapped

def circle_sort_impl(values: mutable i64&, length: usize) -> void:
    if length > 1:
        while circle_sort_range(values[0:length], 0, length - 1):
            pass

export fn circle_sort(values: mutable i64&, length: usize) -> void = circle_sort_impl
