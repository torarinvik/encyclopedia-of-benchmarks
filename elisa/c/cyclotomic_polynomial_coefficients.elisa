alias CYCLOTOMIC_MAX_N = 32
alias CYCLOTOMIC_MAX_INPUT = 2

fn cyclotomic_store_i64_le(value: Int64, output: mutable view[u8], offset: Int) -> void:
    let bits: mutable UInt64 = value.bitcast[UInt64]()
    for byte in range(8):
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

fn cyclotomic_compute(input: view[i64], coefficients: mutable view[i64]) -> Int64:
    if input.len() != 1: return -1
    let n_value: Int64 = input[0]
    if n_value < 1 or n_value > CYCLOTOMIC_MAX_N.i64(): return -1
    let n: Int = n_value.int()

    let polynomials: mutable [33][33]i64 = [[0; 33]; 33]
    let degrees: mutable [33]Int = [0; 33]
    polynomials[1][0] <- -1
    polynomials[1][1] <- 1
    degrees[1] <- 1
    for k in range(2, n + 1):
        let divisor: mutable [33]i64 = [0; 33]
        divisor[0] <- 1
        let divisor_degree: mutable Int = 0
        for d in range(1, k):
            if k % d != 0: continue
            let product: mutable [33]i64 = [0; 33]
            for i in range(divisor_degree + 1):
                for j in range(degrees[d] + 1):
                    product[i + j] <- product[i + j] + divisor[i] * polynomials[d][j]
            divisor_degree <- divisor_degree + degrees[d]
            for i in range(divisor_degree + 1): divisor[i] <- product[i]

        let remainder: mutable [33]i64 = [0; 33]
        remainder[0] <- -1
        remainder[k] <- 1
        let quotient_degree: Int = k - divisor_degree
        degrees[k] <- quotient_degree
        for offset in range(quotient_degree + 1):
            let q: Int = quotient_degree - offset
            let leading: Int64 = remainder[divisor_degree + q]
            polynomials[k][q] <- leading
            for j in range(divisor_degree + 1):
                remainder[q + j] <- remainder[q + j] - leading * divisor[j]

    let coefficient_count: Int = degrees[n] + 1
    for index in range(coefficient_count):
        coefficients[index] <- polynomials[n][index]
    8 * coefficient_count

@export("cyclotomic_polynomial_coefficients")
fn cyclotomic_polynomial_coefficients(
    input: i64&, length: usize,
    output: mutable u8&, capacity: usize
) abi("C") -> Int64:
    if input.is_null() or length == 0 or length > CYCLOTOMIC_MAX_INPUT: return -1
    let input_view: view[i64] = input[0:length]
    let coefficient_words: mutable [33]i64 = [0; 33]
    let coefficient_view: mutable view[i64] = coefficient_words[0:33]
    let required: Int64 = cyclotomic_compute(input_view, coefficient_view)
    if required < 0: return required
    if output.is_null() or capacity < required.usize(): return -2
    let output_view: mutable view[u8] = output[0:required.usize()]
    for index in range(required.int() / 8):
        cyclotomic_store_i64_le(coefficient_words[index], output_view, 8 * index)
    required
