const NEWTON_MODULUS: i64 = 998_244_353
const NEWTON_MAX_N: usize = 12
const NEWTON_MAX_INPUT: usize = 25
const NEWTON_MAX_OUTPUT_BYTES: usize = 96

def newton_store_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def newton_convert_impl(input: view[i64], length: usize,
    output: mutable view[u8], capacity: usize, output_is_null: bool) -> i64:
    if length < 3 or length > NEWTON_MAX_INPUT: return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > NEWTON_MAX_N.i64(): return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n: return -1
    for i in 0..<(2 * n):
        if input[i + 1] < 0 or input[i + 1] >= NEWTON_MODULUS: return -1

    output_bytes: usize = 8 * n
    if output_is_null or capacity < output_bytes: return -2
    residual: mutable i64[NEWTON_MAX_N] = zeroed
    answer: mutable i64[NEWTON_MAX_N] = zeroed
    for i in 0..<n: residual[i] <- input[i + 1]

    active: mutable usize = n
    for i in 0..<n:
        node: i64 = input[n + 1 + i]
        value: mutable i64 = 0
        degree: mutable usize = active
        while degree > 0:
            degree <- degree - 1
            value <- (value * node + residual[degree]) % NEWTON_MODULUS
        answer[i] <- value
        if active == 1: continue

        quotient: mutable i64[NEWTON_MAX_N] = zeroed
        quotient[active - 2] <- residual[active - 1]
        degree <- active - 2
        while degree > 0:
            quotient[degree - 1] <- (residual[degree] + node * quotient[degree]) % NEWTON_MODULUS
            degree <- degree - 1
        for degree in 0..<(active - 1): residual[degree] <- quotient[degree]
        active <- active - 1
    for i in 0..<n: newton_store_le(answer[i], output, 8 * i)
    output_bytes.i64()

export fn conversion_from_monomial_basis_to_newton_basis(input: i64&,
    length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > NEWTON_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    if output.is_null():
        scratch: mutable u8[1] = zeroed
        return newton_convert_impl(input_view, length, scratch[0:1], 0, true)
    safe_capacity: mutable usize = capacity
    if safe_capacity > NEWTON_MAX_OUTPUT_BYTES: safe_capacity <- NEWTON_MAX_OUTPUT_BYTES
    output_view: mutable view[u8] = output[0:safe_capacity]
    newton_convert_impl(input_view, length, output_view, capacity, false)
