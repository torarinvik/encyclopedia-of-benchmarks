# Bottom-up count of ordered denomination sequences.
def combination_sum_iv_impl(input_values: i64&, length: usize) -> i64:
    if length < 2 or length > 18:
        return -9223372036854775807 - 1
    count_value: i64 = input_values[0]
    target_value: i64 = input_values[1]
    if count_value < 0 or count_value > 16 or target_value < 0 or target_value > 63:
        return -9223372036854775807 - 1
    count: usize = count_value.usize()
    target: usize = target_value.usize()
    if length != count + 2:
        return -9223372036854775807 - 1

    i: mutable usize = 0
    while i < count:
        denomination: i64 = input_values[i + 2]
        if denomination < 1 or denomination > 63:
            return -9223372036854775807 - 1
        j: mutable usize = 0
        while j < i:
            if input_values[i + 2] == input_values[j + 2]:
                return -9223372036854775807 - 1
            j <- j + 1
        i <- i + 1

    initial_dp: i64[64] =
        for index in 0..<1 |dp: mutable i64[64] = zeroed| -> dp:
            dp[0] <- 1
    result: i64 =
        while sum <= target |sum: mutable usize = 1, dp: mutable i64[64] = initial_dp| -> dp[target]:
            inner: mutable usize = 0
            while inner < count:
                denomination: usize = input_values[inner + 2].usize()
                if denomination <= sum:
                    dp[sum] <- dp[sum] + dp[sum - denomination]
                inner <- inner + 1
            sum <- sum + 1
    result

export fn combination_sum_iv(input_values: i64&, length: usize) -> i64 = combination_sum_iv_impl
