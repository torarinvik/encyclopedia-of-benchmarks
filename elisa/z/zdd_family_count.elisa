def zdd_put_i64(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits >> (byte * 8)).u8()

def zdd_family_count_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > 34:
        return -1
    n0: i64 = input[0]
    m0: i64 = input[1]
    if n0 < 1 or n0 > 6 or m0 < 0 or m0 > 32 or length != m0.usize() + 2:
        return -1
    n: usize = n0.usize()
    m: usize = m0.usize()
    limit: usize = 1 << n
    ids: mutable i64[64] = zeroed
    next: mutable i64[64] = zeroed
    vars: mutable i64[63] = zeroed
    lows: mutable i64[63] = zeroed
    highs: mutable i64[63] = zeroed
    counts: mutable i64[65] = zeroed
    seen: mutable bool[64] = zeroed
    counts[1] <- 1
    for i in 0..<m:
        mask: i64 = input[2 + i]
        if mask < 0 or mask.usize() >= limit or seen[mask.usize()]:
            return -1
        seen[mask.usize()] <- true
        ids[mask.usize()] <- 1
    nodes: mutable usize = 0
    current_count: mutable usize = limit
    for variable in 0..<n:
        next_count: usize = current_count / 2
        for p in 0..<next_count:
            low: i64 = ids[2 * p]
            high: i64 = ids[2 * p + 1]
            if high == 0:
                next[p] <- low
            else:
                found: mutable usize = nodes
                j: mutable usize = nodes
                while j > 0:
                    j <- j - 1
                    if vars[j].usize() != variable:
                        break
                    if lows[j] == low and highs[j] == high:
                        found <- j
                        break
                if found == nodes:
                    vars[nodes] <- variable.i64()
                    lows[nodes] <- low
                    highs[nodes] <- high
                    counts[2 + nodes] <- counts[low.usize()] + counts[high.usize()]
                    next[p] <- (2 + nodes).i64()
                    nodes <- nodes + 1
                else:
                    next[p] <- (2 + found).i64()
        for p in 0..<next_count:
            ids[p] <- next[p]
        current_count <- next_count
    output_length: usize = 8 * (3 + 3 * nodes)
    if output == null or capacity < output_length:
        return -2
    zdd_put_i64(output, 0, ids[0])
    zdd_put_i64(output, 8, nodes.i64())
    zdd_put_i64(output, 16, counts[ids[0].usize()])
    for i in 0..<nodes:
        zdd_put_i64(output, (3 + 3 * i) * 8, vars[i])
        zdd_put_i64(output, (4 + 3 * i) * 8, lows[i])
        zdd_put_i64(output, (5 + 3 * i) * 8, highs[i])
    output_length.i64()

export fn zdd_family_count(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = zdd_family_count_impl
