from std.collections import InlineArray

const MAX_BITS: Int64 = 64
const MAX_PARSEABLE: usize = 131
const MAX_OUTPUT: usize = 66

def za_canonical(bits: view[i64]) -> bool:
    if bits.length == 1 and bits[0] == 0: return true
    if bits.length == 0 or bits[0] != 1: return false
    i: mutable usize = 0
    while i < bits.length:
        if bits[i] != 0 and bits[i] != 1: return false
        if i + 1 < bits.length and bits[i] == 1 and bits[i + 1] == 1: return false
        i <- i + 1
    true

def za_stage_one(d: mutable view[u8], n: usize) -> None:
    i: mutable usize = 0
    while i + 3 < n:
        if d[i] == 0 and d[i + 1] == 2 and d[i + 2] == 0:
            d[i] <- 1; d[i + 1] <- 0; d[i + 2] <- 0; d[i + 3] <- d[i + 3] + 1
        elif d[i] == 0 and d[i + 1] == 3 and d[i + 2] == 0:
            d[i] <- 1; d[i + 1] <- 1; d[i + 2] <- 0; d[i + 3] <- d[i + 3] + 1
        elif d[i] == 0 and d[i + 1] == 2 and d[i + 2] == 1:
            d[i] <- 1; d[i + 1] <- 1; d[i + 2] <- 0
        elif d[i] == 0 and d[i + 1] == 1 and d[i + 2] == 2:
            d[i] <- 1; d[i + 1] <- 0; d[i + 2] <- 1
        i <- i + 1
    if n >= 3 and d[n - 3] == 0 and d[n - 2] == 3 and d[n - 1] == 0:
        d[n - 3] <- 1; d[n - 2] <- 1; d[n - 1] <- 1
    elif n >= 3 and d[n - 3] == 0 and d[n - 2] == 2 and d[n - 1] == 0:
        d[n - 3] <- 1; d[n - 2] <- 0; d[n - 1] <- 1
    elif n >= 4 and d[n - 4] == 0 and d[n - 3] == 1 and d[n - 2] == 2 and d[n - 1] == 0:
        d[n - 4] <- 1; d[n - 3] <- 0; d[n - 2] <- 1; d[n - 1] <- 0
    elif n >= 3 and d[n - 3] == 0 and d[n - 2] == 2 and d[n - 1] == 1:
        d[n - 3] <- 1; d[n - 2] <- 1; d[n - 1] <- 0
    if n >= 2 and d[n - 2] == 0 and d[n - 1] == 3:
        d[n - 2] <- 1; d[n - 1] <- 1
    elif n >= 2 and d[n - 2] == 0 and d[n - 1] == 2:
        d[n - 2] <- 1; d[n - 1] <- 0
    elif n >= 3 and d[n - 3] == 0 and d[n - 2] == 1 and d[n - 1] == 2:
        d[n - 3] <- 1; d[n - 2] <- 0; d[n - 1] <- 1

def za_normalize(input: view[i64], staged: mutable view[u8]) -> i64:
    if input.length < 4 or input.length > MAX_PARSEABLE: return -1
    first_n_value: i64 = input[0]
    if first_n_value < 1 or first_n_value > MAX_BITS: return -1
    first_n: usize = first_n_value.usize()
    second_n_index: usize = first_n + 1
    if second_n_index >= input.length: return -1
    second_n_value: i64 = input[second_n_index]
    if second_n_value < 1 or second_n_value > MAX_BITS: return -1
    second_n: usize = second_n_value.usize()
    if input.length != second_n_index + second_n + 1: return -1
    first: view[i64] = input[1:second_n_index]
    second: view[i64] = input[second_n_index + 1:input.length]
    if not za_canonical(first) or not za_canonical(second): return -1

    width: usize = if first_n > second_n: first_n else: second_n
    first_offset: usize = width - first_n
    second_offset: usize = width - second_n
    digit_count: mutable usize = width + 1
    i: mutable usize = 0
    staged[0] <- 0
    while i < width:
        a: i64 = if i < first_offset: 0 else: first[i - first_offset]
        b: i64 = if i < second_offset: 0 else: second[i - second_offset]
        staged[i + 1] <- (a + b).u8()
        i <- i + 1
    za_stage_one(staged, digit_count)

    i <- digit_count
    while i > 0:
        staged[i] <- staged[i - 1]
        i <- i - 1
    staged[0] <- 0
    digit_count <- digit_count + 1
    i <- digit_count - 2
    while i > 0:
        start: usize = i - 1
        if staged[start] == 0 and staged[start + 1] == 1 and staged[start + 2] == 1:
            staged[start] <- 1; staged[start + 1] <- 0; staged[start + 2] <- 0
        i <- i - 1
    i <- 0
    while i + 2 < digit_count:
        if staged[i] == 0 and staged[i + 1] == 1 and staged[i + 2] == 1:
            staged[i] <- 1; staged[i + 1] <- 0; staged[i + 2] <- 0
        i <- i + 1

    first_output: mutable usize = 0
    while first_output + 1 < digit_count and staged[first_output] == 0:
        first_output <- first_output + 1
    required: usize = digit_count - first_output
    i <- 0
    while i < required:
        staged[i] <- staged[first_output + i] + 48.u8()
        i <- i + 1
    required.i64()

@export("zeckendorf_addition")
fn zeckendorf_addition(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) abi("C") -> Int64:
    if input.is_null() or length < 4 or length > MAX_PARSEABLE: return -1
    input_view: view[i64] = input[0:length]
    var staged = InlineArray[UInt8, 66](fill=0)
    required: i64 = za_normalize(input_view, staged[0:66])
    if required < 0: return required
    if output.is_null() or output_capacity < required.usize(): return -2
    output_view: mutable view[u8] = output[0:required.usize()]
    i: mutable usize = 0
    while i < required.usize():
        output_view[i] <- staged[i]
        i <- i + 1
    required
