from std.collections import InlineArray

const MAX_TEXT: usize = 256
const MAX_PATTERN: usize = 16
const ALPHABET: usize = 16

def zhu_takaoka_search_impl(values: view[i64], length: usize) -> i64:
    if length < 2 or length > 274: return -2
    let raw_n, raw_m = values[0], values[1]
    if raw_n < 0 or raw_n > MAX_TEXT.i64() or raw_m < 2 or raw_m > MAX_PATTERN.i64(): return -2
    let n, m = raw_n.usize(), raw_m.usize()
    if length != 2 + n + m: return -2
    for i in 0..<(n + m):
        if values[2 + i] < 0 or values[2 + i] >= ALPHABET.i64(): return -2
    if m > n: return -1

    let p: usize = 2 + n
    var pair_shift = InlineArray[usize, 256](fill=m)
    for a in 0..<ALPHABET:
        pair_shift[a * ALPHABET + values[p].usize()] = m - 1
    for i in 1..<(m - 1):
        pair_shift[values[p + i - 1].usize() * ALPHABET + values[p + i].usize()] = m - 1 - i

    var good_suffix = InlineArray[usize, 16](fill=m)
    for mismatch in 0..<m:
        for shift in 1..<(m + 1):
            let after_mismatch = mismatch + 1
            let first_known = if after_mismatch > shift: after_mismatch else: shift
            var position = first_known
            while position < m and values[p + position] == values[p + position - shift]:
                position += 1
            if position < m: continue
            if mismatch + 1 < m and shift <= mismatch and values[p + mismatch - shift] == values[p + mismatch]: continue
            good_suffix[mismatch] = shift
            break

    var start: usize = 0
    while start <= n - m:
        var mismatch = m
        while mismatch > 0 and values[p + mismatch - 1] == values[2 + start + mismatch - 1]:
            mismatch -= 1
        if mismatch == 0: return start.i64()
        mismatch -= 1
        let first = values[2 + start + m - 2].usize()
        let second = values[2 + start + m - 1].usize()
        let pair = pair_shift[first * ALPHABET + second]
        start += if good_suffix[mismatch] > pair: good_suffix[mismatch] else: pair
    -1

export fn zhu_takaoka_search(values: i64&, length: usize) -> i64:
    if values.is_null(): return -2
    zhu_takaoka_search_impl(values[0:length], length)
