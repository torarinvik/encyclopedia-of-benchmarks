# Validate a strict BST encoded as [value, left index, right index] node triples.
def trim_bst_valid(nodes: i64&, node_count: usize, root_index: i64) -> bool:
    parents: mutable usize[100] = zeroed
    index: mutable usize = 0
    while index < node_count:
        value: i64 = nodes[3 * index]
        left: i64 = nodes[3 * index + 1]
        right: i64 = nodes[3 * index + 2]
        if value < 1 or value > 10000 or left < -1 or right < -1:
            return false
        if ((left >= 0 and left.u64() >= node_count.u64()) or
           (right >= 0 and right.u64() >= node_count.u64())):
            return false
        if left >= 0:
            child: usize = left.usize()
            parents[child] <- parents[child] + 1
            if parents[child] > 1:
                return false
        if right >= 0:
            child: usize = right.usize()
            parents[child] <- parents[child] + 1
            if parents[child] > 1:
                return false
        index <- index + 1
    if parents[root_index.usize()] != 0:
        return false
    index <- 0
    while index < node_count:
        if index != root_index.usize() and parents[index] != 1:
            return false
        index <- index + 1

    stack_node: mutable i64[100] = zeroed
    stack_low: mutable i64[100] = zeroed
    stack_high: mutable i64[100] = zeroed
    seen: mutable bool[100] = zeroed
    stack_node[0] <- root_index
    stack_low[0] <- 0
    stack_high[0] <- 10001
    top: mutable usize = 1
    visited: mutable usize = 0
    while top > 0:
        top <- top - 1
        node: i64 = stack_node[top]
        node_index: usize = node.usize()
        if seen[node_index]:
            return false
        seen[node_index] <- true
        visited <- visited + 1
        value: i64 = nodes[3 * node_index]
        lower: i64 = stack_low[top]
        upper: i64 = stack_high[top]
        if value <= lower or value >= upper:
            return false
        left: i64 = nodes[3 * node_index + 1]
        right: i64 = nodes[3 * node_index + 2]
        if right >= 0:
            stack_node[top] <- right
            stack_low[top] <- value
            stack_high[top] <- upper
            top <- top + 1
        if left >= 0:
            stack_node[top] <- left
            stack_low[top] <- lower
            stack_high[top] <- value
            top <- top + 1
    visited == node_count

# Recursively remove values outside the requested range and compact retained nodes.
def trim_bst_visit(nodes: i64&, node: i64, low: i64, high: i64,
                   output: mutable i64&, output_count: mutable usize&) -> i64:
    if node == -1:
        return -1
    index: usize = node.usize()
    value: i64 = nodes[3 * index]
    left: i64 = nodes[3 * index + 1]
    right: i64 = nodes[3 * index + 2]
    if value < low:
        return trim_bst_visit(nodes, right, low, high, output, output_count)
    if value > high:
        return trim_bst_visit(nodes, left, low, high, output, output_count)
    trimmed_index: usize = output_count
    output_count <- output_count + 1
    offset: usize = 1 + 3 * trimmed_index
    output[offset] <- value
    output[offset + 1] <- -1
    output[offset + 2] <- -1
    output[offset + 1] <- trim_bst_visit(nodes, left, low, high, output, output_count)
    output[offset + 2] <- trim_bst_visit(nodes, right, low, high, output, output_count)
    trimmed_index.i64()

def trim_bst_impl(nodes: i64&, node_count: usize, root_index: i64,
                  low: i64, high: i64, output: mutable i64&, output_capacity: usize) -> i64:
    if node_count > 100 or low < 1 or high > 10000 or low > high:
        return -1
    if node_count == 0:
        if root_index != -1:
            return -1
        if output_capacity < 1:
            return -2
        output[0] <- -1
        return 1
    if root_index < 0 or root_index.u64() >= node_count.u64():
        return -1
    if not trim_bst_valid(nodes, node_count, root_index):
        return -1
    if output_capacity < 1 + 3 * node_count:
        return -2
    output_count: mutable usize = 0
    trimmed_root: i64 = trim_bst_visit(nodes, root_index, low, high, output, output_count)
    output[0] <- trimmed_root
    1 + 3 * output_count.usize().i64()

export fn trim_bst(nodes: i64&, node_count: usize, root_index: i64, low: i64,
                   high: i64, output: mutable i64&, output_capacity: usize) -> i64 = trim_bst_impl
