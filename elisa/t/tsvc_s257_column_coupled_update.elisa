const MAX_N: usize = 8
const MAX_PASSES: i64 = 4

def tsvc_s257_column_coupled_update_impl(values: i64&, length: usize) -> i64:
    if length < 12 or length > 2 + MAX_N + 2 * MAX_N * MAX_N:
        return -1
    n_value: i64 = values[0]
    passes_value: i64 = values[1]
    if n_value < 2 or n_value > MAX_N.i64() or passes_value < 1 or passes_value > MAX_PASSES:
        return -1
    n: usize = n_value.usize()
    passes: usize = passes_value.usize()
    if length != 2 + n + 2 * n * n:
        return -1
    valid: bool =
        while index < length |index: mutable usize = 2| -> valid:
            if values[index] < -1 or values[index] > 1:
                break false
            index <- index + 1
            true
    if not valid:
        return -1

    a: mutable i64[MAX_N] = zeroed
    aa: mutable i64[MAX_N * MAX_N] = zeroed
    bb: mutable i64[MAX_N * MAX_N] = zeroed
    for i in 0..n:
        a[i] <- values[2 + i]
    aa_start: usize = 2 + n
    bb_start: usize = aa_start + n * n
    for i in 0..n * n:
        aa[i] <- values[aa_start + i]
        bb[i] <- values[bb_start + i]
    for iteration in 0..passes:
        for i in 1..n:
            for j in 0..n:
                cell: usize = j * n + i
                a[i] <- aa[cell] - a[i - 1]
                aa[cell] <- a[i] + bb[cell]

    sum_a: i64 =
        while i < n |i: mutable usize = 0, total: mutable i64 = 0| -> total:
            total <- total + a[i]
            i <- i + 1
            total
    sum_aa: i64 =
        while i < n * n |i: mutable usize = 0, total: mutable i64 = 0| -> total:
            total <- total + aa[i]
            i <- i + 1
            total
    sum_a + sum_aa

export fn tsvc_s257_column_coupled_update(values: i64&, length: usize) -> i64 = tsvc_s257_column_coupled_update_impl
