# Bounded clean-room RFC 6238 TOTP profile with package-local SHA-1/HMAC.
const MAX_KEY: usize = 64
const MAX_WORDS: usize = 67

def totp_rol(value: u32, amount: usize) -> u32:
    (value << amount) | (value >> (32 - amount))

def totp_add32(left: u32, right: u32) -> u32:
    ((left.u64() + right.u64()) & 0xffffffff).u32()

def totp_initial() -> u32[5]:
    [0x67452301.u32(), 0xefcdab89.u32(), 0x98badcfe.u32(), 0x10325476.u32(), 0xc3d2e1f0.u32()]

def totp_compress(state: mutable view[u32], block: view[u8]):
    schedule: mutable u32[80] = zeroed
    index: usize = 0
    while index < 16:
        place: usize = index * 4
        schedule[index] <- (block[place].u32() << 24) | (block[place + 1].u32() << 16) | (block[place + 2].u32() << 8) | block[place + 3].u32()
        index <- index + 1
    while index < 80:
        schedule[index] <- totp_rol(schedule[index - 3] ^ schedule[index - 8] ^ schedule[index - 14] ^ schedule[index - 16], 1)
        index <- index + 1
    a: mutable u32 = state[0]
    b: mutable u32 = state[1]
    c: mutable u32 = state[2]
    d: mutable u32 = state[3]
    e: mutable u32 = state[4]
    index <- 0
    while index < 80:
        f: u32 = 0
        k: u32 = 0
        if index < 20:
            f = (b & c) | ((~b) & d)
            k = 0x5a827999.u32()
        elif index < 40:
            f = b ^ c ^ d
            k = 0x6ed9eba1.u32()
        elif index < 60:
            f = (b & c) | (b & d) | (c & d)
            k = 0x8f1bbcdc.u32()
        else:
            f = b ^ c ^ d
            k = 0xca62c1d6.u32()
        temp: u32 = totp_add32(totp_add32(totp_add32(totp_add32(totp_rol(a, 5), f), e), k), schedule[index])
        e <- d
        d <- c
        c <- totp_rol(b, 30)
        b <- a
        a <- temp
        index <- index + 1
    state[0] <- totp_add32(state[0], a)
    state[1] <- totp_add32(state[1], b)
    state[2] <- totp_add32(state[2], c)
    state[3] <- totp_add32(state[3], d)
    state[4] <- totp_add32(state[4], e)

def totp_serialize(state: view[u32], output: mutable view[u8]):
    index: usize = 0
    while index < 5:
        output[index * 4] <- (state[index] >> 24).u8()
        output[index * 4 + 1] <- (state[index] >> 16).u8()
        output[index * 4 + 2] <- (state[index] >> 8).u8()
        output[index * 4 + 3] <- state[index].u8()
        index <- index + 1

def totp_compute(input: view[i64], key_length: usize, output: mutable view[u8]):
    key: mutable u8[64] = zeroed
    block: mutable u8[64] = zeroed
    inner: mutable u8[20] = zeroed
    state: mutable u32[5] = totp_initial()
    index: usize = 0
    while index < key_length:
        key[index] <- input[index + 1].u8()
        index <- index + 1
    index <- 0
    while index < 64:
        block[index] <- key[index] ^ 0x36.u8()
        index <- index + 1
    state_view: mutable view[u32] = state[0:5]
    block_view: mutable view[u8] = block[0:64]
    totp_compress(state_view, block_view)
    index <- 0
    while index < 64:
        block[index] <- 0
        index <- index + 1
    counter: u64 = input[key_length + 1].u64() / 30
    index <- 0
    while index < 8:
        block[index] <- (counter >> (56 - 8 * index)).u8()
        index <- index + 1
    block[8] <- 0x80.u8()
    block[62] <- 2.u8()
    block[63] <- 0x40.u8()
    totp_compress(state_view, block_view)
    inner_view: mutable view[u8] = inner[0:20]
    totp_serialize(state_view, inner_view)
    index <- 0
    while index < 64:
        block[index] <- key[index] ^ 0x5c.u8()
        index <- index + 1
    state <- totp_initial()
    totp_compress(state_view, block_view)
    index <- 0
    while index < 64:
        block[index] <- 0
        index <- index + 1
    index <- 0
    while index < 20:
        block[index] <- inner[index]
        index <- index + 1
    block[20] <- 0x80.u8()
    block[62] <- 2.u8()
    block[63] <- 0xa0.u8()
    totp_compress(state_view, block_view)
    totp_serialize(state_view, inner_view)
    offset: usize = inner[19].usize() & 15
    binary: u32 = (inner[offset].u32() << 24) | (inner[offset + 1].u32() << 16) | (inner[offset + 2].u32() << 8) | inner[offset + 3].u32()
    binary = binary & 0x7fffffff.u32()
    value: mutable u32 = binary % 1000000
    index = 6
    while index > 0:
        index <- index - 1
        output[index] <- (48 + value % 10).u8()
        value <- value / 10

export fn time_based_one_time_password_algorithm(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > MAX_WORDS:
        return -1
    input_view: view[i64] = input[0:length]
    key_word: i64 = input_view[0]
    if key_word < 16 or key_word > MAX_KEY.i64() or length != key_word.usize() + 2:
        return -1
    key_length: usize = key_word.usize()
    index: usize = 0
    while index < key_length:
        if input_view[index + 1] < 0 or input_view[index + 1] > 255:
            return -1
        index <- index + 1
    if input_view[key_length + 1] < 0:
        return -1
    staged: mutable u8[6] = zeroed
    staged_view: mutable view[u8] = staged[0:6]
    totp_compute(input_view, key_length, staged_view)
    if output.is_null() or capacity < 6:
        return -2
    output_view: mutable view[u8] = output[0:6]
    index = 0
    while index < 6:
        output_view[index] <- staged[index]
        index <- index + 1
    return 6
