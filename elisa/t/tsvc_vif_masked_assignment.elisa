# Clean-room bounded profile of TSVC vif; see package README.

const TSVC_VIF_MAX_N: usize = 64
const TSVC_VIF_MAX_INPUT_LENGTH: usize = 129
const TSVC_VIF_MAX_VALUE: i64 = 2

def tsvc_vif_bounded(value: i64) -> bool:
    value >= -TSVC_VIF_MAX_VALUE and value <= TSVC_VIF_MAX_VALUE

def tsvc_vif_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_vif_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > TSVC_VIF_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n:
        return -1

    a_start: usize = 1
    b_start: usize = a_start + n
    a: mutable i64[64] = zeroed
    for i in 0..n:
        a[i] <- input[a_start + i]
        if not tsvc_vif_bounded(a[i]) or not tsvc_vif_bounded(input[b_start + i]):
            return -1
    if output.is_null() or capacity < 8 * n:
        return -2

    for i in 0..n:
        value: i64 = input[b_start + i]
        if value > 0:
            a[i] <- value
    for i in 0..n:
        tsvc_vif_store(a[i], output, 8 * i)
    n.i64()

export fn tsvc_vif_masked_assignment(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_vif_impl
