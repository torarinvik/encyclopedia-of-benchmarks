extern trunc(value:f64)->f64
extern fabs(value:f64)->f64
def tsvc_s242_fused_prefix_update_impl(x:f64&,l:usize,mutable y:f64&,cap:usize)->i64:
    if x.is_null() or l<7 or l>259:return -1
    r:f64=x[0]
    if trunc(r)!=r or r<1.0 or r>64.0:return -1
    n:usize=r.usize()
    if l!=3+4*n:return -1
    for i in 1..l:
        if trunc(x[i])!=x[i] or fabs(x[i])>1.0:return -1
    if y.is_null() or cap<n:return -2
    a:array[64]f64
    for i in 0..n:a[i]=x[3+i]
    for i in 1..n:
        v:f64=a[i-1]+x[1]
        v=v+x[2]
        v=v+x[3+2*n+i]
        v=v+x[3+3*n+i]
        v=v+x[3+4*n+i]
        a[i]=v
    for i in 0..n:y[i]<-a[i]
    return n.i64()
export fn tsvc_s242_fused_prefix_update(x:f64&,l:usize,y:mutable f64&,cap:usize)->i64=tsvc_s242_fused_prefix_update_impl
