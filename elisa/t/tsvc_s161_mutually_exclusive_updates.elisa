# Clean-room bounded profile of TSVC s161; see package README.

const TSVC_S161_MAX_N: usize = 64
const TSVC_S161_MAX_INPUT_LENGTH: usize = 321
const TSVC_S161_MAX_VALUE: i64 = 2

def tsvc_s161_bounded(value: i64) -> bool:
    value >= -TSVC_S161_MAX_VALUE and value <= TSVC_S161_MAX_VALUE

def tsvc_s161_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s161_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 11 or length > TSVC_S161_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 5 * n:
        return -1

    a_start: usize = 1
    b_start: usize = a_start + n
    c_start: usize = b_start + n
    d_start: usize = c_start + n
    e_start: usize = d_start + n
    a: mutable i64[64] = zeroed
    c: mutable i64[64] = zeroed
    for i in 0..n:
        a[i] <- input[a_start + i]
        c[i] <- input[c_start + i]
        if not tsvc_s161_bounded(a[i]) or not tsvc_s161_bounded(input[b_start + i]) or
            not tsvc_s161_bounded(c[i]) or not tsvc_s161_bounded(input[d_start + i]) or
            not tsvc_s161_bounded(input[e_start + i]):
            return -1
    if output.is_null() or capacity < 16 * n:
        return -2

    for i in 0..n - 1:
        if input[b_start + i] < 0:
            d: i64 = input[d_start + i]
            c[i + 1] <- a[i] + d * d
        else:
            a[i] <- c[i] + input[d_start + i] * input[e_start + i]
    for i in 0..n:
        tsvc_s161_store(a[i], output, 8 * i)
        tsvc_s161_store(c[i], output, 8 * (n + i))
    (2 * n).i64()

export fn tsvc_s161_mutually_exclusive_updates(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s161_impl
