# Encode phi(1) through phi(n) as comma-separated decimal bytes.
def decimal_length(value: i64) -> usize:
    length: mutable usize = 1
    remaining: mutable i64 = value
    while remaining >= 10:
        remaining <- remaining / 10
        length <- length + 1
    length

def append_decimal(value_input: i64, output: mutable u8&, position_input: usize) -> usize:
    digits: mutable u8[3] = zeroed
    count: mutable usize = 0
    value: mutable i64 = value_input
    while true:
        digits[count] <- (48 + (value % 10).u8()).u8()
        count <- count + 1
        value <- value / 10
        if value == 0:
            break
    position: mutable usize = position_input
    while count > 0:
        count <- count - 1
        output[position] <- digits[count]
        position <- position + 1
    position

def totients_linear_sieve_impl(n: i64, output: mutable u8&, output_capacity: usize) -> i64:
    if n < 1 or n > 80:
        return -1
    phi: mutable i64[81] = zeroed
    composite: mutable i64[81] = zeroed
    primes: mutable i64[80] = zeroed
    prime_count: mutable usize = 0
    phi[1] <- 1
    i: mutable i64 = 2
    while i <= n:
        if composite[i.usize()] == 0:
            primes[prime_count] <- i
            prime_count <- prime_count + 1
            phi[i.usize()] <- i - 1
        j: mutable usize = 0
        while j < prime_count:
            p: mutable i64 = primes[j]
            if i * p > n:
                break
            composite[(i * p).usize()] <- 1
            if i % p == 0:
                phi[(i * p).usize()] <- phi[i.usize()] * p
                break
            phi[(i * p).usize()] <- phi[i.usize()] * (p - 1)
            j <- j + 1
        i <- i + 1
    required: mutable usize = (n - 1).usize()
    i <- 1
    while i <= n:
        required <- required + decimal_length(phi[i.usize()])
        i <- i + 1
    if output_capacity < required:
        return -2
    position: mutable usize = 0
    i <- 1
    while i <= n:
        if i > 1:
            output[position] <- 44
            position <- position + 1
        position <- append_decimal(phi[i.usize()], output, position)
        i <- i + 1
    position.i64()

export fn totients_linear_sieve(n: i64, output: mutable u8&, output_capacity: usize) -> i64 = totients_linear_sieve_impl
