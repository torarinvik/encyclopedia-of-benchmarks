# Clean-room bounded port of TSVC s1244; see package README for provenance.

const TSVC_S1244_MAX_N: usize = 32
const TSVC_S1244_MAX_INPUT_LENGTH: usize = 129

def tsvc_s1244_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s1244_polynomial_neighbor_sum_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 9 or length > TSVC_S1244_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 32:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 4 * n:
        return -1
    a: mutable i64[32] = zeroed
    b: mutable i64[32] = zeroed
    c: mutable i64[32] = zeroed
    d: mutable i64[32] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[1 + i]
        b[i] <- input[1 + n + i]
        c[i] <- input[1 + 2 * n + i]
        d[i] <- input[1 + 3 * n + i]
        if a[i] < -2 or a[i] > 2 or b[i] < -2 or b[i] > 2 or
                c[i] < -2 or c[i] > 2 or d[i] < -2 or d[i] > 2:
            return -1
        i <- i + 1
    if output.is_null() or capacity < 16 * n:
        return -2
    i <- 0
    while i < n - 1:
        old_next_a: i64 = a[i + 1]
        a[i] <- b[i] + c[i] * c[i] + b[i] * b[i] + c[i]
        d[i] <- a[i] + old_next_a
        i <- i + 1
    i <- 0
    while i < n:
        tsvc_s1244_store_i64_le(a[i], output[0:capacity], 8 * i)
        tsvc_s1244_store_i64_le(d[i], output[0:capacity], 8 * (n + i))
        i <- i + 1
    (2 * n).i64()

export fn tsvc_s1244_polynomial_neighbor_sum(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s1244_polynomial_neighbor_sum_impl
