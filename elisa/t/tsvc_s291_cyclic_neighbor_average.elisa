# Clean-room bounded profile of TSVC s291; see package README.

const TSVC_S291_MAX_N: usize = 64
const TSVC_S291_MAX_INPUT_LENGTH: usize = 1 + TSVC_S291_MAX_N
const TSVC_S291_MAX_VALUE: i64 = 1000000

def tsvc_s291_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s291_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > TSVC_S291_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + n:
        return -1
    for i in 0..n:
        value: i64 = input[i + 1]
        if value < -TSVC_S291_MAX_VALUE or value > TSVC_S291_MAX_VALUE:
            return -1
    if output.is_null() or capacity < 8 * n:
        return -2

    for i in 0..n:
        previous: usize = if i == 0 then n - 1 else i - 1
        tsvc_s291_store(input[i + 1] + input[previous + 1], output, 8 * i)
    n.i64()

export fn tsvc_s291_cyclic_neighbor_average(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s291_impl
