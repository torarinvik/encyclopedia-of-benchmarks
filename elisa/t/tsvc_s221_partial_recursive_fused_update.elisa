extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_s221_partial_recursive_fused_update_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > 257: return -1
    raw_n: f64 = input[0]
    if trunc(raw_n) != raw_n or raw_n < 1.0 or raw_n > 64.0: return -1
    n: usize = raw_n.usize()
    if length != 1 + 4*n: return -1
    for i in 1..length:
        if input[i] != input[i] or trunc(input[i]) != input[i] or fabs(input[i]) > 2.0: return -1
    required: usize = 2*n
    if output.is_null() or capacity < required: return -2
    for i in 0..n:
        output[i] <- input[1+i]
        output[n+i] <- input[1+n+i]
    for i in 1..n:
        output[i] <- output[i] + input[1+2*n+i] * input[1+3*n+i]
        output[n+i] <- (output[n+i-1] + output[i]) + input[1+3*n+i]
    required.i64()

export fn tsvc_s221_partial_recursive_fused_update(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = tsvc_s221_partial_recursive_fused_update_impl
