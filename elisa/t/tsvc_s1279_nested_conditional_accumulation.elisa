extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_s1279_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 7 or length > 322:
        return -1
    count: f64 = input[0]
    repetitions: f64 = input[1]
    if count != count or trunc(count) != count or count < 1 or count > 64 or
            repetitions != repetitions or trunc(repetitions) != repetitions or repetitions < 1 or repetitions > 8:
        return -1
    n: usize = count.usize()
    passes: usize = repetitions.usize()
    if length != 2 + 5 * n:
        return -1
    for i in 2..length:
        value: f64 = input[i]
        if value != value or trunc(value) != value or fabs(value) > 1:
            return -1
    if output.is_null() or capacity < n:
        return -2

    c: mutable f64[64] = zeroed
    for i in 0..n:
        c[i] <- input[2 + 2 * n + i]
    for pass in 0..passes:
        for i in 0..n:
            a: f64 = input[2 + i]
            b: f64 = input[2 + n + i]
            if a < 0 and b > a:
                c[i] <- c[i] + input[2 + 3 * n + i] * input[2 + 4 * n + i]
    for i in 0..n:
        output[i] <- c[i]
    return n.i64()

export fn tsvc_s1279_nested_conditional_accumulation(input: f64&, length: usize,
        output: mutable f64&, capacity: usize) -> i64 = tsvc_s1279_impl
