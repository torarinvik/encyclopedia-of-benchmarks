// Clean-room longest precedence chain of 2-intervals.
const MAX_N: usize = 16
def interval_before(input: i64&, a: usize, b: usize) -> bool:
    field: mutable usize = 0
    while field < 4:
        x: i64 = input[1+4*a+field]
        y: i64 = input[1+4*b+field]
        if x != y: return x < y
        field <- field+1
    a < b
def interval_precedes(input: i64&, a: usize, b: usize) -> bool:
    input[1+4*a+1] < input[1+4*b] and input[1+4*a+3] < input[1+4*b+2]
def path_lex_less(a: usize[MAX_N], an: usize, b: usize[MAX_N], bn: usize) -> bool:
    limit: usize = if an < bn: an else: bn
    i: mutable usize = 0
    while i < limit:
        if a[i] != b[i]: return a[i] < b[i]
        i <- i+1
    an < bn
def two_interval_precedence_chain(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("two_interval_precedence_chain"):
    if input.is_null() or length < 5 or length > 65 or input[0] < 1 or input[0] > MAX_N.i64(): return -1
    n: usize = input[0].usize()
    if length != 1+4*n: return -1
    i: mutable usize = 0
    while i < n:
        p: usize = 1+4*i
        q: mutable usize = 0
        while q < 4:
            if input[p+q] < 0 or input[p+q] > 63: return -1
            q <- q+1
        if input[p] >= input[p+1] or input[p+2] >= input[p+3] or input[p+1] >= input[p+2]: return -1
        i <- i+1
    order: mutable usize[MAX_N] = zeroed
    i <- 0
    while i < n: order[i] <- i; i <- i+1
    i <- 1
    while i < n:
        value: usize = order[i]
        j: mutable usize = i
        while j > 0 and interval_before(input&, value, order[j-1]): order[j] <- order[j-1]; j <- j-1
        order[j] <- value
        i <- i+1
    paths: mutable usize[MAX_N*MAX_N] = zeroed
    lengths: mutable usize[MAX_N] = zeroed
    i <- 0
    while i < n:
        paths[i*MAX_N] <- order[i]
        lengths[i] <- 1
        j: mutable usize = 0
        while j < i:
            if interval_precedes(input&, order[j], order[i]):
                candidate: mutable usize[MAX_N] = zeroed
                q <- 0
                while q < lengths[j]: candidate[q] <- paths[j*MAX_N+q]; q <- q+1
                candidate[lengths[j]] <- order[i]
                m: usize = lengths[j]+1
                current: mutable usize[MAX_N] = zeroed
                q <- 0
                while q < lengths[i]: current[q] <- paths[i*MAX_N+q]; q <- q+1
                if m > lengths[i] or (m == lengths[i] and path_lex_less(candidate, m, current, lengths[i])):
                    q <- 0
                    while q < m: paths[i*MAX_N+q] <- candidate[q]; q <- q+1
                    lengths[i] <- m
            j <- j+1
        i <- i+1
    best: mutable usize = 0
    i <- 1
    while i < n:
        current: mutable usize[MAX_N] = zeroed
        previous: mutable usize[MAX_N] = zeroed
        j <- 0
        while j < lengths[i]: current[j] <- paths[i*MAX_N+j]; j <- j+1
        j <- 0
        while j < lengths[best]: previous[j] <- paths[best*MAX_N+j]; j <- j+1
        if lengths[i] > lengths[best] or (lengths[i] == lengths[best] and path_lex_less(current, lengths[i], previous, lengths[best])): best <- i
        i <- i+1
    fields: mutable i64[MAX_N+1] = zeroed
    fields[0] <- lengths[best].i64()
    i <- 0
    while i < lengths[best]: fields[i+1] <- paths[best*MAX_N+i].i64(); i <- i+1
    bytes: usize = 8*(lengths[best]+1)
    if output.is_null() or capacity < bytes: return -2
    i <- 0
    while i < lengths[best]+1:
        bits: u64 = fields[i].u64()
        q <- 0
        while q < 8: output[8*i+q] <- ((bits >> (8*q)) & 255).u8(); q <- q+1
        i <- i+1
    bytes.i64()
