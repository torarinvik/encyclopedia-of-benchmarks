const MAX_ITEMS: usize = 1024

def sift_down(source: i64[1024], root_start: usize, end: usize) -> i64[1024]:
    updated: i64[1024] =
        while root < end / 2 |root: mutable usize = root_start, values: mutable i64[1024] = source| -> values:
            child: mutable usize = root * 2 + 1
            if child + 1 < end and values[child] < values[child + 1]:
                child <- child + 1
            if values[root] >= values[child]:
                break values
            temporary: i64 = values[root]
            values[root] <- values[child]
            values[child] <- temporary
            root <- child
            values
    updated

def heap_sort(source: i64[1024], length: usize) -> i64[1024]:
    heapified: i64[1024] =
        while start > 0 |start: mutable usize = length / 2, values: mutable i64[1024] = source| -> values:
            start <- start - 1
            values <- sift_down(values, start, length)
            values
    sorted: i64[1024] =
        while ending > 1 |ending: mutable usize = length, values: mutable i64[1024] = heapified| -> values:
            ending <- ending - 1
            temporary: i64 = values[0]
            values[0] <- values[ending]
            values[ending] <- temporary
            values <- sift_down(values, 0, ending)
            values
    sorted

def write_triplet(result: i64[4], output: mutable view[u8]) -> void:
    for position in 0..<24 |written: mutable usize = 0, output|:
        value: i64 = result[position / 8 + 1]
        bits: u64 = value.u64()
        byte: usize = position % 8
        output[written] <- ((bits >> (byte * 8)) & 255.u64()).u8()
        written <- written + 1

def triplet_sum_two_pointer_impl(values: i64&, length: usize, output: mutable u8&,
                                 output_capacity: usize) -> i64:
    if length < 1 or length > MAX_ITEMS + 1:
        return -1
    target: i64 = values[0]
    if target < -3000000 or target > 3000000:
        return -1
    item_count: usize = length - 1
    valid: bool =
        while index < item_count |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = values[index + 1]
            if value < -1000000 or value > 1000000:
                break false
            index <- index + 1
            valid
    if not valid:
        return -1
    if output_capacity < 24:
        return -2

    copied: i64[1024] =
        while index < item_count |index: mutable usize = 0, copied: mutable i64[1024] = zeroed| -> copied:
            copied[index] <- values[index + 1]
            index <- index + 1
            copied
    sorted: i64[1024] = heap_sort(copied, item_count)

    result: i64[4] =
        while first + 2 < item_count |first: mutable usize = 0, result: mutable i64[4] = zeroed| -> result:
            pair_result: i64[4] =
                while left < right |left: mutable usize = first + 1, right: mutable usize = item_count - 1, pair_result: mutable i64[4] = zeroed| -> pair_result:
                    sum: i64 = sorted[first] + sorted[left] + sorted[right]
                    if sum == target:
                        pair_result[0] <- 1
                        pair_result[1] <- sorted[first]
                        pair_result[2] <- sorted[left]
                        pair_result[3] <- sorted[right]
                        break pair_result
                    if sum < target:
                        left <- left + 1
                    else:
                        right <- right - 1
                    pair_result
            if pair_result[0] == 1:
                result <- pair_result
                break result
            first <- first + 1
            result
    write_triplet(result, output[0:24])
    3

export fn triplet_sum_two_pointer(values: i64&, length: usize, output: mutable u8&,
                                  output_capacity: usize) -> i64 = triplet_sum_two_pointer_impl
