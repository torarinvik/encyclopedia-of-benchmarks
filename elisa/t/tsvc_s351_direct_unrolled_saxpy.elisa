extern trunc(value:f64)->f64
extern fabs(value:f64)->f64
def tsvc_s351_direct_unrolled_saxpy_impl(x:f64&,l:usize,mutable y:f64&,cap:usize)->i64:
    if x.is_null() or l<12 or l>82:return -1
    rd:f64=x[0]
    if trunc(rd)!=rd or rd<5.0 or rd>40.0:return -1
    n:usize=rd.usize()
    if n%5!=0 or l!=2+2*n:return -1
    for i in 1..l:
        if trunc(x[i])!=x[i] or fabs(x[i])>1.0:return -1
    if y.is_null() or cap<n:return -2
    a:array[40]f64
    for i in 0..n:a[i]=x[2+i]
    alpha:f64=x[1]
    for base in 0..<n step 5:
        p0:f64=alpha*x[2+n+base]
        a[base]=a[base]+p0
        p1:f64=alpha*x[2+n+base+1]
        a[base+1]=a[base+1]+p1
        p2:f64=alpha*x[2+n+base+2]
        a[base+2]=a[base+2]+p2
        p3:f64=alpha*x[2+n+base+3]
        a[base+3]=a[base+3]+p3
        p4:f64=alpha*x[2+n+base+4]
        a[base+4]=a[base+4]+p4
    for i in 0..n:y[i]<-a[i]
    return n.i64()
export fn tsvc_s351_direct_unrolled_saxpy(x:f64&,l:usize,y:mutable f64&,cap:usize)->i64=tsvc_s351_direct_unrolled_saxpy_impl
