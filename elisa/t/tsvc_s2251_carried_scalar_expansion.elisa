extern trunc(value:f64)->f64
extern fabs(value:f64)->f64
def tsvc_s2251_carried_scalar_expansion_impl(x:f64&,l:usize,mutable y:f64&,cap:usize)->i64:
    if x.is_null() or l<6 or l>321:return -1
    r:f64=x[0]
    if trunc(r)!=r or r<1.0 or r>64.0:return -1
    n:usize=r.usize()
    if l!=1+5*n:return -1
    for i in 1..l:
        if trunc(x[i])!=x[i] or fabs(x[i])>1.0:return -1
    if y.is_null() or cap<2*n:return -2
    a:array[64]f64
    b:array[64]f64
    s:f64=0.0
    for i in 0..n:
        a[i]=s*x[1+4*n+i]
        s=x[1+n+i]+x[1+2*n+i]
        b[i]=a[i]+x[1+3*n+i]
    for i in 0..n:
        y[i]<-a[i]
        y[n+i]<-b[i]
    return (2*n).i64()
export fn tsvc_s2251_carried_scalar_expansion(x:f64&,l:usize,y:mutable f64&,cap:usize)->i64=tsvc_s2251_carried_scalar_expansion_impl
