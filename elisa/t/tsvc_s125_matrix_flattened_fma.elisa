# Clean-room port of TSVC s125; see package README for provenance and rights.

const TSVC_S125_MAX_N: usize = 8
const TSVC_S125_MAX_CELLS: usize = 64
const TSVC_S125_MAX_INPUT_LENGTH: usize = 193

def tsvc_s125_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s125_matrix_flattened_fma_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > TSVC_S125_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 8:
        return -1
    n: usize = n_value.usize()
    cells: usize = n * n
    if length != 1 + 3 * cells:
        return -1
    aa: mutable i64[64] = zeroed
    bb: mutable i64[64] = zeroed
    cc: mutable i64[64] = zeroed
    result: mutable i64[64] = zeroed
    i: mutable usize = 0
    while i < cells:
        aa[i] <- input[1 + i]
        bb[i] <- input[1 + cells + i]
        cc[i] <- input[1 + 2 * cells + i]
        if aa[i] < -100 or aa[i] > 100 or bb[i] < -100 or bb[i] > 100 or cc[i] < -100 or cc[i] > 100:
            return -1
        i <- i + 1
    output_bytes: usize = 8 * cells
    if output.is_null() or capacity < output_bytes:
        return -2
    k: mutable usize = 0
    i <- 0
    while i < n:
        j: mutable usize = 0
        while j < n:
            result[k] <- aa[k] + bb[k] * cc[k]
            k <- k + 1
            j <- j + 1
        i <- i + 1
    i <- 0
    while i < cells:
        tsvc_s125_store_i64_le(result[i], output, 8 * i)
        i <- i + 1
    cells.i64()

export fn tsvc_s125_matrix_flattened_fma(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s125_matrix_flattened_fma_impl
