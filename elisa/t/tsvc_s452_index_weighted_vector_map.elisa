# Clean-room bounded profile of TSVC s452; see package README.

const TSVC_S452_MAX_N: usize = 64
const TSVC_S452_MAX_INPUT_LENGTH: usize = 129
const TSVC_S452_MAX_VALUE: i64 = 2

def tsvc_s452_bounded(value: i64) -> bool:
    value >= -TSVC_S452_MAX_VALUE and value <= TSVC_S452_MAX_VALUE

def tsvc_s452_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s452_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > TSVC_S452_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n:
        return -1

    b_start: usize = 1
    c_start: usize = b_start + n
    for i in 0..n:
        if not tsvc_s452_bounded(input[b_start + i]) or not tsvc_s452_bounded(input[c_start + i]):
            return -1
    if output.is_null() or capacity < 8 * n:
        return -2

    for i in 0..n:
        index_weight: i64 = (i + 1).i64()
        value: i64 = input[b_start + i] + input[c_start + i] * index_weight
        tsvc_s452_store(value, output, 8 * i)
    n.i64()

export fn tsvc_s452_index_weighted_vector_map(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s452_impl
