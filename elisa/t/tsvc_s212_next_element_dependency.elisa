# Clean-room bounded profile of TSVC s212; see package README.

const TSVC_S212_MAX_N: usize = 64
const TSVC_S212_MAX_INPUT_LENGTH: usize = 258
const TSVC_S212_MAX_VALUE: i64 = 2
const TSVC_S212_MAX_PASSES: i64 = 16

def tsvc_s212_bounded(value: i64) -> bool:
    value >= -TSVC_S212_MAX_VALUE and value <= TSVC_S212_MAX_VALUE

def tsvc_s212_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s212_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 10 or length > TSVC_S212_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    passes: i64 = input[1]
    if n_value < 2 or n_value > 64 or passes < 1 or passes > TSVC_S212_MAX_PASSES:
        return -1
    n: usize = n_value.usize()
    if length != 2 + 4 * n:
        return -1

    a_start: usize = 2
    b_start: usize = a_start + n
    c_start: usize = b_start + n
    d_start: usize = c_start + n
    a: mutable i64[64] = zeroed
    b: mutable i64[64] = zeroed
    for i in 0..n:
        a[i] <- input[a_start + i]
        b[i] <- input[b_start + i]
        if not tsvc_s212_bounded(a[i]) or not tsvc_s212_bounded(b[i]) or
            not tsvc_s212_bounded(input[c_start + i]) or not tsvc_s212_bounded(input[d_start + i]):
            return -1
    if output.is_null() or capacity < 16 * n:
        return -2

    for pass in 0..passes.usize():
        for i in 0..(n - 1):
            a[i] <- a[i] * input[c_start + i]
            b[i] <- b[i] + a[i + 1] * input[d_start + i]
    for i in 0..n:
        tsvc_s212_store(a[i], output[0:capacity], 8 * i)
        tsvc_s212_store(b[i], output[0:capacity], 8 * (n + i))
    (2 * n).i64()

export fn tsvc_s212_next_element_dependency(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s212_impl
