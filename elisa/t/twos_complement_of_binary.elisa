def twos_complement_of_binary_impl(value: i64) -> i64:
    if value < 0 or value > 1111111111111111:
        return -1
    if value == 0:
        return 0

    remaining: mutable i64 = value
    while remaining > 0:
        digit: i64 = remaining % 10
        if digit != 0 and digit != 1:
            return -1
        remaining <- remaining / 10

    remaining <- value
    reversed: mutable i64 = 0
    width: mutable i64 = 0
    while remaining > 0 and remaining % 10 == 0:
        reversed <- reversed * 10 + remaining % 10
        remaining <- remaining / 10
        width <- width + 1
    if remaining > 0:
        reversed <- reversed * 10 + remaining % 10
        remaining <- remaining / 10
        width <- width + 1
    while remaining > 0:
        digit: i64 = remaining % 10
        reversed <- reversed * 10 + (if digit == 1: 0 else: 1)
        remaining <- remaining / 10
        width <- width + 1

    result: mutable i64 = 0
    while width > 0:
        result <- result * 10 + reversed % 10
        reversed <- reversed / 10
        width <- width - 1
    result

export fn twos_complement_of_binary(value: i64) -> i64 = twos_complement_of_binary_impl
