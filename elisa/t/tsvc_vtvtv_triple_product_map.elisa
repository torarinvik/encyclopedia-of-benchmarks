extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_vtvtv_triple_product_map_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > 193: return -1
    raw_n: f64 = input[0]
    if trunc(raw_n) != raw_n or raw_n < 1.0 or raw_n > 64.0: return -1
    n: usize = raw_n.usize()
    if length != 1 + 3 * n: return -1
    for i in 1..length:
        if trunc(input[i]) != input[i] or fabs(input[i]) > 2.0: return -1
    if output.is_null() or capacity < n: return -2
    for i in 0..n: output[i] <- (input[1+i] * input[1+n+i]) * input[1+2*n+i]
    n.i64()

export fn tsvc_vtvtv_triple_product_map(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = tsvc_vtvtv_triple_product_map_impl
