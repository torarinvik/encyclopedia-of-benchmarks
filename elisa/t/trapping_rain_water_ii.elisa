const TRW_MAX_ROWS: usize = 8
const TRW_MAX_COLS: usize = 8
const TRW_MAX_CELLS: usize = 64
const TRW_MAX_INPUT: usize = 66

def fn trw_heap_push(heap: mutable view[i64], size: usize, key: i64) -> usize:
    position: mutable usize = size
    next_size: usize = size + 1
    while position > 0:
        parent: usize = (position - 1) / 2
        if heap[parent] <= key: break
        heap[position] <- heap[parent]
        position <- parent
    heap[position] <- key
    next_size

def fn trw_heap_pop(heap: mutable view[i64], size: usize) -> i64:
    minimum: i64 = heap[0]
    reduced_size: usize = size - 1
    if reduced_size > 0:
        last: i64 = heap[reduced_size]
        position: mutable usize = 0
        while 2 * position + 1 < reduced_size:
            child: mutable usize = 2 * position + 1
            if child + 1 < reduced_size and heap[child + 1] < heap[child]: child <- child + 1
            if heap[child] >= last: break
            heap[position] <- heap[child]
            position <- child
        heap[position] <- last
    minimum

def fn trw_impl(input: view[i64]) -> i64:
    length: usize = input.len()
    if length < 2 or length > TRW_MAX_INPUT: return -1
    if input[0] < 1 or input[0] > 8 or input[1] < 1 or input[1] > 8: return -1
    rows: usize = input[0].usize()
    cols: usize = input[1].usize()
    if length != 2 + rows * cols: return -1
    heights: mutable i64[TRW_MAX_CELLS] = zeroed
    for cell in 0..<rows * cols:
        height: i64 = input[2 + cell]
        if height < 0 or height > 1000: return -1
        heights[cell] <- height

    visited: mutable bool[TRW_MAX_CELLS] = zeroed
    heap: mutable i64[TRW_MAX_CELLS] = zeroed
    heap_size: mutable usize = 0
    for row in 0..<rows:
        for col in 0..<cols:
            if row == 0 or row + 1 == rows or col == 0 or col + 1 == cols:
                cell: usize = row * cols + col
                if not visited[cell]:
                    visited[cell] <- true
                    heap_size <- trw_heap_push(heap, heap_size, heights[cell] * 64 + cell.i64())

    retained: mutable i64 = 0
    while heap_size > 0:
        key: i64 = trw_heap_pop(heap, heap_size)
        heap_size <- heap_size - 1
        level: i64 = key / 64
        cell: usize = (key % 64).usize()
        row: usize = cell / cols
        col: usize = cell % cols
        for direction in 0..<4:
            nr: i64 = row.i64() + (if direction == 0: -1 else: if direction == 1: 1 else: 0)
            nc: i64 = col.i64() + (if direction == 2: -1 else: if direction == 3: 1 else: 0)
            if nr < 0 or nr >= rows.i64() or nc < 0 or nc >= cols.i64(): continue
            neighbor: usize = nr.usize() * cols + nc.usize()
            if visited[neighbor]: continue
            visited[neighbor] <- true
            height: i64 = heights[neighbor]
            if height < level: retained <- retained + level - height
            next_level: i64 = if height > level: height else: level
            heap_size <- trw_heap_push(heap, heap_size, next_level * 64 + neighbor.i64())
    retained

export fn trapping_rain_water_ii(values: i64&, length: usize) -> i64:
    if values.is_null() or length > TRW_MAX_INPUT: return -1
    trw_impl(values[0:length])
