def tsvc_s423_antidependence_offset64_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 130 or length > 193: return -1
    rn: i64 = input[0]
    if rn < 65 or rn > 128: return -1
    n: usize = rn.usize()
    if length != n + 65: return -1
    a: mutable i64[128] = zeroed
    x: mutable i64[192] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[1+i]
        if a[i] < 0 or a[i] > 2: return -1
        i <- i + 1
    i <- 0
    while i < 64:
        x[i] <- input[1+n+i]
        if x[i] < 0 or x[i] > 2: return -1
        i <- i + 1
    i <- 64
    while i < n + 64:
        x[i] <- 1
        i <- i + 1
    i <- 0
    while i < n - 1:
        x[i+1] <- x[i+64] + a[i]
        i <- i + 1
    sum: i64 = 0
    i <- 0
    while i < n:
        sum <- sum + x[i]
        i <- i + 1
    sum

export fn tsvc_s423_antidependence_offset64(input: i64&, length: usize) -> i64 = tsvc_s423_antidependence_offset64_impl
