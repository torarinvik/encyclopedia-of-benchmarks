# Uncompiled weighted independent tree domination draft.
def twid_min(a:i64,b:i64) -> i64:
    if a < b: return a
    b
def twid_add(a:i64,b:i64) -> i64:
    twid_min(1000000000000,a+b)
def twid_solve(values:view[i64]) -> i64:
    if values.len() < 2 or values.len() > 129: return -1
    nv:i64 = values[0]
    if nv < 1 or nv > 64: return -1
    n:usize = nv.usize()
    if values.len() != 2*n: return -1
    for v in 1..<n:
        if values[v] < 0 or values[v] >= v.i64(): return -1
    selected:mutable i64[64] = zeroed
    covered:mutable i64[64] = zeroed
    waiting:mutable i64[64] = zeroed
    for v in 0..<n:
        weight:i64 = values[n+v]
        if weight < 0 or weight > 1000000: return -1
        selected[v] <- weight
        covered[v] <- 1000000000000
    v:mutable usize = n
    while v > 1:
        v <- v - 1
        p:usize = values[v].usize()
        a:i64 = selected[v]
        b:i64 = covered[v]
        c:i64 = waiting[v]
        next:i64 = twid_min(twid_add(covered[p],twid_min(a,b)),twid_add(waiting[p],a))
        selected[p] <- twid_add(selected[p],twid_min(b,c))
        waiting[p] <- twid_add(waiting[p],b)
        covered[p] <- next
    twid_min(selected[0],covered[0])
export fn tree_weighted_independent_dominating_set(input:i64&,length:usize) -> i64:
    if input == null or length < 2 or length > 129: return -1
    twid_solve(input[0:length])
