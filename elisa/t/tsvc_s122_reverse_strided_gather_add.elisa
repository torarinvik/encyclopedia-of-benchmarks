# Clean-room port of TSVC s122; see package README for provenance and rights.

const TSVC_S122_MAX_N: usize = 32
const TSVC_S122_MAX_INPUT_LENGTH: usize = 67

def tsvc_s122_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s122_reverse_strided_gather_add_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > TSVC_S122_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 32:
        return -1
    n: usize = n_value.usize()
    start_value: i64 = input[1]
    stride_value: i64 = input[2]
    if start_value < 1 or start_value > n_value or stride_value < 1 or stride_value > n_value:
        return -1
    if length != 3 + 2 * n:
        return -1
    start: usize = start_value.usize()
    stride: usize = stride_value.usize()
    a: mutable i64[32] = zeroed
    b: mutable i64[32] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[3 + i]
        b[i] <- input[3 + n + i]
        if a[i] < -100 or a[i] > 100 or b[i] < -100 or b[i] > 100:
            return -1
        i <- i + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes:
        return -2
    j: mutable usize = 1
    k: mutable usize = 0
    i <- start - 1
    while i < n:
        k <- k + j
        a[i] <- a[i] + b[n - k]
        i <- i + stride
    i <- 0
    while i < n:
        tsvc_s122_store_i64_le(a[i], output, 8 * i)
        i <- i + 1
    n.i64()

export fn tsvc_s122_reverse_strided_gather_add(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s122_reverse_strided_gather_add_impl
