const PI: f64 = 3.14159265358979323846
const MAX_FINITE: f64 = 1.7976931348623157e308

def trig_functions_finite(value: f64) -> bool:
    value == value and value <= MAX_FINITE and value >= -MAX_FINITE

def trig_functions_nan() -> f64:
    zero: f64 = 0.0
    zero / zero

def trig_functions_abs(value: f64) -> f64:
    if value < 0.0: -value else: value

def trig_functions_round_six(value: f64) -> f64:
    scaled: f64 = trig_functions_abs(value) * 1000000.0
    rounded: i64 = (scaled + 0.5).i64()
    if value < 0.0: -rounded.f64() / 1000000.0 else: rounded.f64() / 1000000.0

def trig_functions_power(value: f64, exponent: usize) -> f64:
    result: mutable f64 = 1.0
    index: mutable usize = 0
    while index < exponent:
        result <- result * value
        index <- index + 1
    result

def trig_functions_factorial(n: usize) -> f64:
    result: mutable f64 = 1.0
    index: mutable usize = 2
    while index <= n:
        result <- result * index.f64()
        index <- index + 1
    result

def trig_functions_series(input_value: f64, tolerance: f64, kind: usize) -> f64:
    value: mutable f64 = input_value
    period: f64 = 2.0 * PI
    while value >= period: value <- value - period
    while value <= -period: value <- value + period
    result: mutable f64 = 0.0
    previous: mutable f64 = 1.0
    step: mutable usize = 0
    while trig_functions_abs(previous - result) > tolerance:
        previous <- result
        power: usize = 2 * step + kind
        term: f64 = trig_functions_power(value, power) / trig_functions_factorial(power)
        if step % 2 == 0: result <- result + term else: result <- result - term
        step <- step + 1
    trig_functions_round_six(result)

def trig_functions_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input == null or length != 3: return -1
    selector_value: f64 = input[0]
    x: mutable f64 = input[1]
    tolerance: f64 = input[2]
    if not trig_functions_finite(selector_value) or selector_value < 0.0 or selector_value > 7.0: return -1
    selector: i64 = selector_value.i64()
    if selector_value != selector.f64(): return -1
    if not trig_functions_finite(tolerance) or tolerance < 1e-9 or tolerance > 1e-2: return -1
    if trig_functions_finite(x) and (x < -10000.0 or x > 10000.0): return -1
    if output == null or capacity < 1: return -2
    if not trig_functions_finite(x):
        output[0] <- trig_functions_nan()
        return 1
    if selector == 2 or selector == 3 or selector == 6 or selector == 7: x <- x * PI / 180.0

    result: mutable f64 = 0.0
    if selector == 0 or selector == 2:
        result <- trig_functions_series(x, tolerance, 1)
    else if selector == 1 or selector == 3:
        result <- trig_functions_series(x, tolerance, 0)
    else if selector == 4 or selector == 6:
        denominator: f64 = trig_functions_series(x, tolerance, 0)
        if denominator == 0.0: result <- trig_functions_nan()
        else: result <- trig_functions_series(x, tolerance, 1) / denominator
    else:
        denominator: f64 = trig_functions_series(x, tolerance, 1)
        if denominator == 0.0: result <- trig_functions_nan()
        else: result <- trig_functions_series(x, tolerance, 0) / denominator
    output[0] <- result
    1

export fn trig_functions(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = trig_functions_impl
