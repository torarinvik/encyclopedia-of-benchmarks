extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_s1251_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 6 or length > 321:
        return -1
    count: f64 = input[0]
    if count != count or trunc(count) != count or count < 1 or count > 64:
        return -1
    n: usize = count.usize()
    if length != 1 + 5 * n:
        return -1
    for i in 1..length:
        value: f64 = input[i]
        if value != value or trunc(value) != value or fabs(value) > 1:
            return -1
    if output.is_null() or capacity < 2 * n:
        return -2

    a: mutable f64[64] = zeroed
    b: mutable f64[64] = zeroed
    for i in 0..n:
        saved: f64 = input[1 + n + i] + input[1 + 2 * n + i]
        b[i] <- input[1 + i] + input[1 + 3 * n + i]
        a[i] <- saved * input[1 + 4 * n + i]
    for i in 0..n:
        output[i] <- a[i]
        output[n + i] <- b[i]
    return (2 * n).i64()

export fn tsvc_s1251_per_element_dual_update(input: f64&, length: usize,
        output: mutable f64&, capacity: usize) -> i64 = tsvc_s1251_impl
