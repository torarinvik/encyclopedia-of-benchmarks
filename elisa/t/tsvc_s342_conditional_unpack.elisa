# Clean-room one-sweep profile of TSVC s342; see package README.

const TSVC_S342_MAX_N: usize = 64
const TSVC_S342_MAX_INPUT_LENGTH: usize = 129
const TSVC_S342_MAX_VALUE: i64 = 2

def tsvc_s342_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s342_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > TSVC_S342_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n:
        return -1

    a_start: usize = 1
    b_start: usize = a_start + n
    a: mutable i64[64] = zeroed
    for i in 0..n:
        a[i] <- input[a_start + i]
        if a[i] < -TSVC_S342_MAX_VALUE or a[i] > TSVC_S342_MAX_VALUE or
            input[b_start + i] < -TSVC_S342_MAX_VALUE or input[b_start + i] > TSVC_S342_MAX_VALUE:
            return -1
    if output.is_null() or capacity < 8 * n:
        return -2

    packed_index: mutable usize = 0
    for i in 0..n:
        if a[i] > 0:
            a[i] <- input[b_start + packed_index]
            packed_index <- packed_index + 1
    for i in 0..n:
        tsvc_s342_store(a[i], output, 8 * i)
    n.i64()

export fn tsvc_s342_conditional_unpack(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s342_impl
