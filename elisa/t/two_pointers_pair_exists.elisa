const MAX_INPUT: usize = 258

def two_pointers_pair_exists_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT: return -1
    target: i64 = input[0]
    n: i64 = input[1]
    if n < 0 or n > 256 or length != 2 + n.usize(): return -1
    if target < -2000000 or target > 2000000: return -1
    for i in 0..<n.usize():
        value: i64 = input[2 + i]
        if value < -1000000 or value > 1000000: return -1
        if i > 0 and input[1 + i] > value: return -1
    if n < 2: return 0
    left: mutable usize = 0
    right: mutable usize = n.usize() - 1
    while left < right:
        sum: i64 = input[2 + left] + input[2 + right]
        if sum == target: return 1
        if sum < target: left <- left + 1
        else: right <- right - 1
    return 0

export fn two_pointers_pair_exists(input: i64&, length: usize) -> i64 = two_pointers_pair_exists_impl
