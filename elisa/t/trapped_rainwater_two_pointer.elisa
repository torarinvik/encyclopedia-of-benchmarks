# Process the smaller endpoint and validate each bar when it enters the window.
def trapped_rainwater_two_pointer_impl(heights: i64&, length: usize) -> i64:
    return -1 if length > 4096
    return 0 if length == 0

    left: mutable usize = 0
    right: mutable usize = length - 1
    left_height: mutable u64 = heights[left].u64()
    right_height: mutable u64 = heights[right].u64()
    return -1 if left_height > 1000000 or right_height > 1000000

    left_max: mutable u32 = 0
    right_max: mutable u32 = 0
    trapped: mutable u32 = 0
    while left < right:
        if left_height < right_height:
            height: u32 = left_height.u32()
            left_max <- height if height > left_max else left_max
            trapped <- trapped + (left_max - height)
            left <- left + 1
            left_height <- heights[left].u64()
            return -1 if left_height > 1000000
        else:
            height: u32 = right_height.u32()
            right_max <- height if height > right_max else right_max
            trapped <- trapped + (right_max - height)
            right <- right - 1
            right_height <- heights[right].u64()
            return -1 if right_height > 1000000
    trapped.i64()

export fn trapped_rainwater_two_pointer(heights: i64&, length: usize) -> i64 = trapped_rainwater_two_pointer_impl
