const MP_A: usize = 4
const MP_P: usize = 4
const MP_R: usize = 8
const MP_NODES: usize = 12
const MP_INPUT: usize = 52

def mp_augment(a: usize, right_count: usize, edges: view[bool],
               left: mutable view[i64], right: mutable view[i64],
               seen: mutable view[bool]) -> bool:
    p: mutable usize = 0
    while p < right_count:
        if edges[a * MP_R + p] and not seen[p]:
            seen[p] <- true
            previous: i64 = right[p]
            if previous < 0 or mp_augment(previous.usize(), right_count, edges, left, right, seen):
                right[p] <- a.i64()
                left[a] <- p.i64()
                return true
        p <- p + 1
    false

def mp_maximum(applicants: usize, right_count: usize, edges: view[bool],
               initial: view[i64], left: mutable view[i64],
               right: mutable view[i64]) -> bool:
    a:mutable  mutable usize = 0
    while a < MP_A:
        left[a] <- initial[a]
        a <- a + 1
    p: mutable usize = 0
    while p < MP_R:
        right[p] <- -1
        p <- p + 1
    a <- 0
    while a < applicants:
        if left[a] >= 0:
            post: usize = left[a].usize()
            if post >= right_count or right[post] >= 0 or not edges[a * MP_R + post]: return false
            right[post] <- a.i64()
        a <- a + 1
    while true:
        changed: mutable bool = false
        a <- 0
        while a < applicants:
            if left[a] < 0:
                seen_data: mutable bool[MP_R] = zeroed
                seen: mutable view[bool] = seen_data[0:MP_R]
                if mp_augment(a, right_count, edges, left, right, seen): changed <- true
            a <- a + 1
        if not changed: return true

def mp_solve(applicants: usize, posts: usize, ranks: view[usize],
             max_rank: view[usize]) -> i64:
    rank: mutable usize = zeroed
    p: mutable usize = 0
    right_count: usize = posts + applicants
    first_edges_data: mutable bool[MP_A * MP_R] = zeroed
    first_edges: mutable view[bool] = first_edges_data[0:MP_A * MP_R]
    a:mutable  mutable usize = 0
    while a < applicants:
        p <- 0
        while p < posts:
            first_edges[a * MP_R + p] <- ranks[a * MP_P + p] == 1
            p <- p + 1
        a <- a + 1
    initial_data: mutable i64[MP_A] = zeroed
    initial: mutable view[i64] = initial_data[0:MP_A]
    a <- 0
    while a < MP_A:
        initial[a] <- -1
        a <- a + 1
    first_left_data: mutable i64[MP_A] = zeroed
    first_right_data: mutable i64[MP_R] = zeroed
    first_left: mutable view[i64] = first_left_data[0:MP_A]
    first_right: mutable view[i64] = first_right_data[0:MP_R]
    if not mp_maximum(applicants, right_count, first_edges, initial, first_left, first_right): return 0
    first_size: mutable usize = 0
    a <- 0
    while a < applicants:
        if first_left[a] >= 0: first_size <- first_size + 1
        a <- a + 1

    state_data: mutable i64[MP_NODES] = zeroed
    queue_data: mutable usize[MP_NODES] = zeroed
    state: mutable view[i64] = state_data[0:MP_NODES]
    queue: mutable view[usize] = queue_data[0:MP_NODES]
    i:mutable  mutable usize = 0
    while i < applicants + right_count:
        state[i] <- -1
        i <- i + 1
    tail_value: mutable usize = 0
    a <- 0
    while a < applicants:
        if first_left[a] < 0:
            state[a] <- 0
            queue[tail_value] <- a
            tail_value <- tail_value + 1
        a <- a + 1
    p <- 0
    while p < posts:
        if first_right[p] < 0:
            node: usize = applicants + p
            state[node] <- 0
            queue[tail_value] <- node
            tail_value <- tail_value + 1
        p <- p + 1
    a <- 0
    while a < applicants:
        node: usize = applicants + posts + a
        state[node] <- 0
        queue[tail_value] <- node
        tail_value <- tail_value + 1
        a <- a + 1
    head: mutable usize = 0
    while head < tail_value:
        node: usize = queue[head]
        head <- head + 1
        if node < applicants:
            a <- node
            if state[node] == 0:
                p <- 0
                while p < posts:
                    if ranks[a * MP_P + p] == 1 and first_left[a] != p.i64():
                        target: usize = applicants + p
                        if state[target] < 0:
                            state[target] <- 1
                            queue[tail_value] <- target
                            tail_value <- tail_value + 1
                    p <- p + 1
            elif first_left[a] >= 0:
                target: usize = applicants + first_left[a].usize()
                if state[target] < 0:
                    state[target] <- 0
                    queue[tail_value] <- target
                    tail_value <- tail_value + 1
        else:
            p <- node - applicants
            if p < posts:
                if state[node] == 0:
                    a <- 0
                    while a < applicants:
                        if ranks[a * MP_P + p] == 1 and first_left[a] != p.i64() and state[a] < 0:
                            state[a] <- 1
                            queue[tail_value] <- a
                            tail_value <- tail_value + 1
                        a <- a + 1
                elif first_right[p] >= 0:
                    target: usize = first_right[p].usize()
                    if state[target] < 0:
                        state[target] <- 0
                        queue[tail_value] <- target
                        tail_value <- tail_value + 1

    classes_data: mutable i64[MP_NODES] = zeroed
    classes: mutable view[i64] = classes_data[0:MP_NODES]
    i <- 0
    while i < applicants + right_count:
        classes[i] <- 2 if state[i] < 0 else state[i]
        i <- i + 1
    allowed_data: mutable bool[MP_A * MP_R] = zeroed
    allowed: mutable view[bool] = allowed_data[0:MP_A * MP_R]
    a <- 0
    while a < applicants:
        best_even: mutable usize = posts + 1
        p <- 0
        while p < posts:
            rank <- ranks[a * MP_P + p]
            if rank > 0 and classes[applicants + p] == 0 and rank < best_even: best_even <- rank
            p <- p + 1
        last_rank: usize = max_rank[a] + 1
        if classes[applicants + posts + a] == 0 and last_rank < best_even: best_even <- last_rank
        p <- 0
        while p < posts:
            rank <- ranks[a * MP_P + p]
            reduced: bool = rank == 1 or (rank > 0 and rank == best_even and classes[applicants + p] == 0)
            if reduced:
                ac: i64 = classes[a]
                pc: i64 = classes[applicants + p]
                if not ((ac == 1 and (pc == 1 or pc == 2)) or (ac == 2 and pc == 1)):
                    allowed[a * MP_R + p] <- true
            p <- p + 1
        if last_rank == best_even and classes[applicants + posts + a] == 0:
            p <- posts + a
            ac: i64 = classes[a]
            pc: i64 = classes[applicants + p]
            if not ((ac == 1 and (pc == 1 or pc == 2)) or (ac == 2 and pc == 1)):
                allowed[a * MP_R + p] <- true
        a <- a + 1
    a <- 0
    while a < applicants:
        if first_left[a] >= 0 and not allowed[a * MP_R + first_left[a].usize()]: return 0
        a <- a + 1

    popular_left_data: mutable i64[MP_A] = zeroed
    temp_right_data: mutable i64[MP_R] = zeroed
    popular_left: mutable view[i64] = popular_left_data[0:MP_A]
    temp_right: mutable view[i64] = temp_right_data[0:MP_R]
    if not mp_maximum(applicants, right_count, allowed, first_left, popular_left, temp_right): return 0
    rank_one: mutable usize = 0
    a <- 0
    while a < applicants:
        if popular_left[a] < 0: return 0
        p <- popular_left[a].usize()
        if p < posts and ranks[a * MP_P + p] == 1: rank_one <- rank_one + 1
        a <- a + 1
    if rank_one != first_size: return 0

    real_edges_data: mutable bool[MP_A * MP_R] = zeroed
    real_edges: mutable view[bool] = real_edges_data[0:MP_A * MP_R]
    initial_real_data: mutable i64[MP_A] = zeroed
    initial_real: mutable view[i64] = initial_real_data[0:MP_A]
    a <- 0
    while a < MP_A:
        initial_real[a] <- -1
        a <- a + 1
    a <- 0
    while a < applicants:
        if popular_left[a] < posts.i64(): initial_real[a] <- popular_left[a]
        p <- 0
        while p < posts:
            real_edges[a * MP_R + p] <- allowed[a * MP_R + p]
            p <- p + 1
        a <- a + 1
    real_left_data: mutable i64[MP_A] = zeroed
    real_left: mutable view[i64] = real_left_data[0:MP_A]
    if not mp_maximum(applicants, right_count, real_edges, initial_real, real_left, temp_right): return 0
    rank_one <- 0
    a <- 0
    while a < applicants:
        if real_left[a] >= 0 and real_left[a] < posts.i64():
            p <- real_left[a].usize()
            if ranks[a * MP_P + p] == 1: rank_one <- rank_one + 1
        a <- a + 1
    if rank_one != first_size: return 0
    final_left_data: mutable i64[MP_A] = zeroed
    final_left: mutable view[i64] = final_left_data[0:MP_A]
    if not mp_maximum(applicants, right_count, allowed, real_left, final_left, temp_right): return 0
    result: mutable i64 = 0
    rank_one <- 0
    a <- 0
    while a < applicants:
        if final_left[a] < 0: return 0
        p <- final_left[a].usize()
        if p < posts:
            result <- result + 1
            if ranks[a * MP_P + p] == 1: rank_one <- rank_one + 1
        a <- a + 1
    if rank_one != first_size: return 0
    result

def ties_maximum_cardinality_popular_matching_impl(input: i64&, length: usize) -> i64:
    rank: mutable usize = zeroed
    p: mutable usize = zeroed
    a: mutable usize = zeroed
    if input == null or length < 3 or length > MP_INPUT: return -1
    values: i64& = input
    a64: i64 = values[0]
    p64: i64 = values[1]
    e64: i64 = values[2]
    if a64 < 1 or a64 > MP_A.i64() or p64 < 1 or p64 > MP_P.i64() or e64 < a64 or e64 > a64 * p64: return -1
    applicants: usize = a64.usize()
    posts: usize = p64.usize()
    edge_count: usize = e64.usize()
    if length != 3 + 3 * edge_count: return -1
    ranks_data: mutable usize[MP_A * MP_P] = zeroed
    max_rank_data: mutable usize[MP_A] = zeroed
    ranks: mutable view[usize] = ranks_data[0:MP_A * MP_P]
    max_rank: mutable view[usize] = max_rank_data[0:MP_A]
    cursor: mutable usize = 3
    i: mutable usize = 0
    while i < edge_count:
        av: i64 = values[cursor]
        pv: i64 = values[cursor + 1]
        rv: i64 = values[cursor + 2]
        cursor <- cursor + 3
        if av < 0 or av >= a64 or pv < 0 or pv >= p64 or rv < 1 or rv > p64: return -1
        a <- av.usize()
        p <- pv.usize()
        rank <- rv.usize()
        if ranks[a * MP_P + p] != 0: return -1
        ranks[a * MP_P + p] <- rank
        if rank > max_rank[a]: max_rank[a] <- rank
        i <- i + 1
    has_tie: mutable bool = false
    a <- 0
    while a < applicants:
        if max_rank[a] == 0: return -1
        counts_data: mutable usize[MP_P + 1] = zeroed
        counts: mutable view[usize] = counts_data[0:MP_P + 1]
        p <- 0
        while p < posts:
            rank <- ranks[a * MP_P + p]
            if rank > 0: counts[rank] <- counts[rank] + 1
            p <- p + 1
        rank <- 1
        while rank <= max_rank[a]:
            if counts[rank] == 0: return -1
            if counts[rank] > 1: has_tie <- true
            rank <- rank + 1
        a <- a + 1
    if not has_tie: return -1
    mp_solve(applicants, posts, ranks, max_rank)

export fn ties_maximum_cardinality_popular_matching(input: i64&, length: usize) -> i64 = ties_maximum_cardinality_popular_matching_impl
