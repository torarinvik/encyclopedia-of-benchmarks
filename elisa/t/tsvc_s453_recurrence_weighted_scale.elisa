# Clean-room port of TSVC s453; see package README for provenance and rights.

const TSVC_S453_MAX_N: usize = 32
const TSVC_S453_MAX_INPUT_LENGTH: usize = 33

def tsvc_s453_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s453_recurrence_weighted_scale_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > TSVC_S453_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 32:
        return -1
    n: usize = n_value.usize()
    if length != 1 + n:
        return -1
    b: mutable i64[32] = zeroed
    a: mutable i64[32] = zeroed
    i: mutable usize = 0
    while i < n:
        b[i] <- input[1 + i]
        if b[i] < -100 or b[i] > 100:
            return -1
        i <- i + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes:
        return -2
    s: mutable i64 = 0
    i <- 0
    while i < n:
        s <- s + 2
        a[i] <- s * b[i]
        i <- i + 1
    i <- 0
    while i < n:
        tsvc_s453_store_i64_le(a[i], output[0:capacity], 8 * i)
        i <- i + 1
    n.i64()

export fn tsvc_s453_recurrence_weighted_scale(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s453_recurrence_weighted_scale_impl
