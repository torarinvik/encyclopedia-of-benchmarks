# PolyBench/C trmm kernel, bounded port. Ohio State license: see benchmarks/t/trmm/LICENSE.txt.
extern trunc(value: f64) -> f64

const MAX_M: usize = 8
const MAX_N: usize = 8

def trmm_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length != 2: return -1
    m_value: f64 = input[0]
    n_value: f64 = input[1]
    if m_value != m_value or n_value != n_value or trunc(m_value) != m_value or trunc(n_value) != n_value:
        return -1
    if m_value < 1.0 or m_value > MAX_M.f64() or n_value < 1.0 or n_value > MAX_N.f64(): return -1
    m: usize = m_value.usize()
    n: usize = n_value.usize()
    required: usize = m*n
    if output.is_null() or capacity < required: return -2
    a: mutable f64[64] = zeroed
    b: mutable f64[64] = zeroed
    for i in 0..<m:
        for j in 0..<i: a[i*m+j] <- ((i+j)%m).f64()/m.f64()
        a[i*m+i] <- 1.0
        for j in 0..<n: b[i*n+j] <- ((n+i-j)%n).f64()/n.f64()
    for i in 0..<m:
        for j in 0..<n:
            for k in i+1..<m: b[i*n+j] <- b[i*n+j] + a[k*m+i]*b[k*n+j]
            b[i*n+j] <- 1.5*b[i*n+j]
    staged: mutable f64[64] = zeroed
    for i in 0..<required: staged[i] <- b[i]
    for i in 0..<required: output[i] <- staged[i]
    required.i64()

export fn trmm(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = trmm_impl
