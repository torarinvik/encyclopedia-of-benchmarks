# Clean-room bounded port of TSVC s4114; see package README for provenance.

const TSVC_S4114_MAX_N: usize = 64
const TSVC_S4114_MAX_INPUT_LENGTH: usize = 257

def tsvc_s4114_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s4114_reverse_index_gather_fma_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > TSVC_S4114_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 4 * n:
        return -1
    ip_offset: usize = 1
    b_offset: usize = 1 + n
    c_offset: usize = 1 + 2 * n
    d_offset: usize = 1 + 3 * n
    i: mutable usize = 0
    while i < n:
        index: i64 = input[ip_offset + i]
        if index < 0 or index >= n_value:
            return -1
        b_value: i64 = input[b_offset + i]
        c_value: i64 = input[c_offset + i]
        d_value: i64 = input[d_offset + i]
        if b_value < -2 or b_value > 2 or c_value < -2 or c_value > 2 or d_value < -2 or d_value > 2:
            return -1
        i <- i + 1
    if output.is_null() or capacity < 8 * n:
        return -2
    i <- 0
    while i < n:
        gathered: usize = n - 1 - input[ip_offset + i].usize()
        value: i64 = input[b_offset + i] + input[c_offset + gathered] * input[d_offset + i]
        tsvc_s4114_store_i64_le(value, output, 8 * i)
        i <- i + 1
    n.i64()

export fn tsvc_s4114_reverse_index_gather_fma(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s4114_reverse_index_gather_fma_impl
