const KR_MAX_N: usize = 8
const KR_MAX_M: usize = 28
const KR_MAX_INPUT: usize = 59

def fn kr_put_i64(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

@export("khuller_raghavachari_three_edge_connected_spanning_subgraph")
def khuller_raghavachari_three_edge_connected_spanning_subgraph(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > KR_MAX_INPUT: return -1
    input_view: view[i64] = input[0:length]
    n64: i64 = input_view[0]
    m64: i64 = input_view[1]
    if n64 < 4 or n64 > 8 or m64 < 6 or m64 > 28: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1

    u: mutable usize[28] = zeroed
    v: mutable usize[28] = zeroed
    edge: mutable usize = 0
    while edge < m:
        a: i64 = input_view[2 + 2 * edge]
        b: i64 = input_view[3 + 2 * edge]
        if a < 0 or a >= b or b >= n64: return -1
        u[edge] <- a.usize()
        v[edge] <- b.usize()
        prior: mutable usize = 0
        while prior < edge:
            if u[prior] == u[edge] and v[prior] == v[edge]: return -1
            prior <- prior + 1
        edge <- edge + 1
    u_view: view[usize] = u[0:m]
    v_view: view[usize] = v[0:m]

    full: usize = (1 << n) - 1
    side: mutable usize = 1
    while side < full:
        if (side & 1) != 0:
            cut: mutable usize = 0
            edge <- 0
            while edge < m:
                if ((side >> u_view[edge]) & 1) != ((side >> v_view[edge]) & 1): cut <- cut + 1
                edge <- edge + 1
            if cut < 3: return -1
        side <- side + 1

    selected: mutable bool[28] = zeroed
    state: mutable usize[8] = zeroed
    discovery: mutable usize[8] = zeroed
    finish: mutable usize[8] = zeroed
    parent: mutable usize[8] = zeroed
    parent_edge: mutable usize[8] = zeroed
    postorder: mutable usize[8] = zeroed
    stack_vertex: mutable usize[8] = zeroed
    stack_slot: mutable usize[8] = zeroed
    post_count: mutable usize = 0
    clock: mutable usize = 1
    top: mutable usize = 1
    state[0] <- 1
    discovery[0] <- 0
    parent[0] <- n
    parent_edge[0] <- m
    stack_vertex[0] <- 0
    while top > 0:
        frame: usize = top - 1
        x: usize = stack_vertex[frame]
        if stack_slot[frame] < m:
            edge <- stack_slot[frame]
            stack_slot[frame] <- stack_slot[frame] + 1
            y: usize = n
            if u_view[edge] == x: y <- v_view[edge]
            elif v_view[edge] == x: y <- u_view[edge]
            if y == n or state[y] != 0: continue
            selected[edge] <- true
            state[y] <- 1
            parent[y] <- x
            parent_edge[y] <- edge
            discovery[y] <- clock
            clock <- clock + 1
            stack_vertex[top] <- y
            stack_slot[top] <- 0
            top <- top + 1
            continue
        state[x] <- 2
        finish[x] <- clock
        if parent_edge[x] < m:
            postorder[post_count] <- parent_edge[x]
            post_count <- post_count + 1
        top <- top - 1

    p: mutable usize = 0
    while p < post_count:
        tree_edge: usize = postorder[p]
        p <- p + 1
        child: usize = u_view[tree_edge]
        if parent_edge[child] != tree_edge: child <- v_view[tree_edge]
        upper: usize = parent[child]
        separated: mutable bool = false
        removed: mutable usize = 0
        while removed < m and not separated:
            if selected[removed]:
                seen: mutable bool[8] = zeroed
                queue: mutable usize[8] = zeroed
                head: mutable usize = 0
                tail: mutable usize = 1
                seen[upper] <- true
                queue[0] <- upper
                while head < tail:
                    current: usize = queue[head]
                    head <- head + 1
                    edge <- 0
                    while edge < m:
                        if selected[edge] and edge != removed:
                            next: usize = n
                            if u_view[edge] == current: next <- v_view[edge]
                            elif v_view[edge] == current: next <- u_view[edge]
                            if next < n and not seen[next]:
                                seen[next] <- true
                                queue[tail] <- next
                                tail <- tail + 1
                        edge <- edge + 1
                separated <- not seen[child]
            removed <- removed + 1
        if not separated: continue
        candidate: mutable usize = m
        earliest: mutable usize = n
        edge <- 0
        while edge < m:
            if not selected[edge]:
                u_inside: bool = discovery[child] <= discovery[u_view[edge]] and discovery[u_view[edge]] < finish[child]
                v_inside: bool = discovery[child] <= discovery[v_view[edge]] and discovery[v_view[edge]] < finish[child]
                if u_inside != v_inside:
                    ancestor: usize = u_view[edge]
                    if u_inside: ancestor <- v_view[edge]
                    if discovery[ancestor] < earliest:
                        earliest <- discovery[ancestor]
                        candidate <- edge
            edge <- edge + 1
        if candidate == m: return -1
        selected[candidate] <- true

    leader: mutable usize[8] = zeroed
    vertex: mutable usize = 0
    while vertex < n:
        leader[vertex] <- vertex
        vertex <- vertex + 1
    edge <- 0
    while edge < m:
        if not selected[edge]:
            a: mutable usize = u_view[edge]
            b: mutable usize = v_view[edge]
            while leader[a] != a:
                leader[a] <- leader[leader[a]]
                a <- leader[a]
            while leader[b] != b:
                leader[b] <- leader[leader[b]]
                b <- leader[b]
            if a != b:
                leader[b] <- a
                selected[edge] <- true
        edge <- edge + 1

    count: mutable usize = 0
    edge <- 0
    while edge < m:
        if selected[edge]: count <- count + 1
        edge <- edge + 1
    bytes: usize = 8 * (1 + 2 * count)
    if output.is_null() or capacity < bytes: return -2
    output_view: mutable view[u8] = output[0:bytes]
    kr_put_i64(count.i64(), output_view, 0)
    slot: mutable usize = 0
    edge <- 0
    while edge < m:
        if selected[edge]:
            kr_put_i64(u_view[edge].i64(), output_view, 8 * (1 + 2 * slot))
            kr_put_i64(v_view[edge].i64(), output_view, 8 * (2 + 2 * slot))
            slot <- slot + 1
        edge <- edge + 1
    return bytes.i64()
