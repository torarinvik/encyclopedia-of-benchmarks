const KV_MAX_N: usize = 8
const KV_MAX_M: usize = 28
const KV_MAX_INPUT: usize = 59

def kv_put_i64(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def kv_connected_without_vertex(n: usize, m: usize, u: view[usize], v: view[usize], removed: usize) -> bool:
    seen: mutable bool[8] = zeroed
    queue: mutable usize[8] = zeroed
    head: mutable usize = 0
    tail_value: mutable usize = 1
    start: usize = 1 if removed == 0 else 0
    queue[0] <- start
    seen[start] <- true
    while head < tail_value:
        x: usize = queue[head]
        head <- head + 1
        edge: mutable usize = 0
        while edge < m:
            if u[edge] != removed and v[edge] != removed:
                next: mutable usize = KV_MAX_N
                if u[edge] == x: next <- v[edge]
                elif v[edge] == x: next <- u[edge]
                if next < n and not seen[next]:
                    seen[next] <- true
                    queue[tail_value] <- next
                    tail_value <- tail_value + 1
            edge <- edge + 1
    vertex: mutable usize = 0
    while vertex < n:
        if vertex != removed and not seen[vertex]: return false
        vertex <- vertex + 1
    true

def kv_earlier(a: usize, b: usize, disc: view[usize]) -> bool:
    disc[a] < disc[b]

def two_vertex_connected_spanning_subgraph_khuller_vishkin_dfs_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 2 or length > KV_MAX_INPUT: return -1
    input_view: i64& = input
    n64: i64 = input_view[0]
    m64: i64 = input_view[1]
    if n64 < 3 or n64 > 8 or m64 < 3 or m64 > 28: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    u: mutable usize[28] = zeroed
    v: mutable usize[28] = zeroed
    edge: mutable usize = 0
    while edge < m:
        a: i64 = input_view[2 + 2 * edge]
        b: i64 = input_view[3 + 2 * edge]
        if a < 0 or a >= b or b >= n64: return -1
        u[edge] <- a.usize()
        v[edge] <- b.usize()
        prior: mutable usize = 0
        while prior < edge:
            if u[prior] == u[edge] and v[prior] == v[edge]: return -1
            prior <- prior + 1
        edge <- edge + 1
    removed: mutable usize = 0
    while removed < n:
        if not kv_connected_without_vertex(n, m, u[0:m], v[0:m], removed): return -1
        removed <- removed + 1

    state: mutable usize[8] = zeroed
    disc: mutable usize[8] = zeroed
    low: mutable usize[8] = zeroed
    low_h: mutable usize[8] = zeroed
    savior: mutable usize[8] = zeroed
    selected: mutable bool[28] = zeroed
    parent_edge: mutable usize[8] = zeroed
    stack_v: mutable usize[8] = zeroed
    stack_parent: mutable usize[8] = zeroed
    stack_cursor: mutable usize[8] = zeroed
    tick: mutable usize = 1
    top: mutable usize = 1
    state[0] <- 1
    disc[0] <- 0
    low[0] <- 0
    low_h[0] <- 0
    savior[0] <- 0
    stack_v[0] <- 0
    stack_parent[0] <- KV_MAX_N
    stack_cursor[0] <- 0
    while top > 0:
        frame: usize = top - 1
        x: usize = stack_v[frame]
        parent: usize = stack_parent[frame]
        if stack_cursor[frame] < m:
            current_edge: usize = stack_cursor[frame]
            stack_cursor[frame] <- current_edge + 1
            y: mutable usize = KV_MAX_N
            if u[current_edge] == x: y <- v[current_edge]
            elif v[current_edge] == x: y <- u[current_edge]
            if y == KV_MAX_N: continue
            if state[y] == 0:
                selected[current_edge] <- true
                parent_edge[y] <- current_edge
                state[y] <- 1
                disc[y] <- tick
                tick <- tick + 1
                low[y] <- y
                low_h[y] <- y
                savior[y] <- y
                stack_v[top] <- y
                stack_parent[top] <- x
                stack_cursor[top] <- 0
                top <- top + 1
            elif state[y] == 1 and y != parent and kv_earlier(y, low[x], disc[0:KV_MAX_N]):
                low[x] <- y
                savior[x] <- x
            continue
        state[x] <- 2
        if parent < n and low_h[x] == x:
            a: usize = savior[x]
            b: usize = low[x]
            lo: mutable usize = a
            hi: mutable usize = b
            if a > b: lo <- b
            if a > b: hi <- a
            edge <- 0
            while edge < m:
                if u[edge] == lo and v[edge] == hi:
                    selected[edge] <- true
                    break
                edge <- edge + 1
            low_h[x] <- low[x]
        top <- top - 1
        if parent < n and low_h[x] == parent:
            a: usize = savior[x]
            b: usize = low[x]
            lo: mutable usize = a
            hi: mutable usize = b
            if a > b: lo <- b
            if a > b: hi <- a
            edge <- 0
            while edge < m:
                if u[edge] == lo and v[edge] == hi:
                    selected[edge] <- true
                    break
                edge <- edge + 1
            low_h[x] <- low[x]
            if savior[x] == x: selected[parent_edge[x]] <- false
        if parent < n:
            if kv_earlier(low[x], low[parent], disc[0:KV_MAX_N]):
                low[parent] <- low[x]
                savior[parent] <- savior[x]
            if kv_earlier(low_h[x], low_h[parent], disc[0:KV_MAX_N]): low_h[parent] <- low_h[x]

    count: mutable usize = 0
    edge <- 0
    while edge < m:
        if selected[edge]: count <- count + 1
        edge <- edge + 1
    bytes: usize = 8 * (1 + 2 * count)
    if output == null or capacity < bytes: return -2
    result: mutable u8& = output
    kv_put_i64(count.i64(), result, 0)
    offset: mutable usize = 8
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a + 1
        while b < n:
            edge <- 0
            while edge < m:
                if selected[edge] and u[edge] == a and v[edge] == b:
                    kv_put_i64(a.i64(), result, offset)
                    kv_put_i64(b.i64(), result, offset + 8)
                    offset <- offset + 16
                edge <- edge + 1
            b <- b + 1
        a <- a + 1
    bytes.i64()

export fn two_vertex_connected_spanning_subgraph_khuller_vishkin_dfs(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = two_vertex_connected_spanning_subgraph_khuller_vishkin_dfs_impl
