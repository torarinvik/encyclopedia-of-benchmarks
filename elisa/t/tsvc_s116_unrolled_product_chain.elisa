# Clean-room TSVC s116 profile; see package rights note.
const MAX_INPUT_LENGTH:usize=23
def put64(v:i64,out:mutable u8&,off:usize)->void:
 bits:u64=v.u64();j:mutable usize=0
 while j<8:out[off+j]<-((bits>>(8*j))&255).u8();j<-j+1
def tsvc_s116_unrolled_product_chain_impl(input:i64&,length:usize,out:mutable u8&,cap:usize)->i64:
 if input.is_null() or length<8 or length>MAX_INPUT_LENGTH:return -1
 nr:i64=input[0];passes:i64=input[1]
 if nr<6 or nr>21 or (nr-1)%5!=0 or passes<1 or passes>4:return -1
 n:usize=nr.usize();if length!=2+n:return -1
 a:mutable i64[21]=zeroed;k:mutable usize=0
 while k<n:x:i64=input[2+k];if x != -1 and x != 1:return -1;a[k]<-x;k<-k+1
 if out.is_null() or cap<8*n:return -2
 p:mutable usize=0
 while p<passes.usize():
  i:mutable usize=0
  while i<n-5:
   a[i]<-a[i+1]*a[i]
   a[i+1]<-a[i+2]*a[i+1]
   a[i+2]<-a[i+3]*a[i+2]
   a[i+3]<-a[i+4]*a[i+3]
   a[i+4]<-a[i+5]*a[i+4]
   i<-i+5
  p<-p+1
 k<-0;while k<n:put64(a[k],out,8*k);k<-k+1
 n.i64()
export fn tsvc_s116_unrolled_product_chain(input:i64&,length:usize,out:mutable u8&,cap:usize)->i64=tsvc_s116_unrolled_product_chain_impl
