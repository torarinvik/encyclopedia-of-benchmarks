# Clean-room port of TSVC s1221; see package README for provenance and rights.

const TSVC_S1221_MIN_N: usize = 5
const TSVC_S1221_MAX_N: usize = 32
const TSVC_S1221_MAX_INPUT_LENGTH: usize = 65

def tsvc_s1221_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s1221_lag4_add_recurrence_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 11 or length > TSVC_S1221_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 5 or n_value > 32:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n:
        return -1
    a: mutable i64[32] = zeroed
    b: mutable i64[32] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[1 + i]
        b[i] <- input[1 + n + i]
        if a[i] < -10 or a[i] > 10 or b[i] < -10 or b[i] > 10:
            return -1
        i <- i + 1
    if output.is_null() or capacity < 8 * n:
        return -2
    i <- 4
    while i < n:
        b[i] <- b[i - 4] + a[i]
        i <- i + 1
    i <- 0
    while i < n:
        tsvc_s1221_store_i64_le(b[i], output[0:capacity], 8 * i)
        i <- i + 1
    n.i64()

export fn tsvc_s1221_lag4_add_recurrence(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s1221_lag4_add_recurrence_impl
