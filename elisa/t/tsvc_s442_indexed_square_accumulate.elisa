# Clean-room bounded port of TSVC s442; see package README for provenance.

const TSVC_S442_MAX_N: usize = 64
const TSVC_S442_MAX_PASSES: usize = 16
const TSVC_S442_MAX_INPUT_LENGTH: usize = 386

def tsvc_s442_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s442_indexed_square_accumulate_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 8 or length > TSVC_S442_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    passes_value: i64 = input[1]
    if n_value < 1 or n_value > 64 or passes_value < 1 or passes_value > 16:
        return -1
    n: usize = n_value.usize()
    passes: usize = passes_value.usize()
    if length != 2 + 6 * n:
        return -1
    a: mutable i64[64] = zeroed
    b: mutable i64[64] = zeroed
    c: mutable i64[64] = zeroed
    d: mutable i64[64] = zeroed
    e: mutable i64[64] = zeroed
    selector: mutable i64[64] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[2 + i]
        b[i] <- input[2 + n + i]
        c[i] <- input[2 + 2 * n + i]
        d[i] <- input[2 + 3 * n + i]
        e[i] <- input[2 + 4 * n + i]
        selector[i] <- input[2 + 5 * n + i]
        if a[i] < -2 or a[i] > 2 or b[i] < -2 or b[i] > 2 or
                c[i] < -2 or c[i] > 2 or d[i] < -2 or d[i] > 2 or
                e[i] < -2 or e[i] > 2 or selector[i] < 1 or selector[i] > 4:
            return -1
        i <- i + 1
    if output.is_null() or capacity < 8 * n:
        return -2
    round: mutable usize = 0
    while round < passes:
        i <- 0
        while i < n:
            selected: i64 = b[i]
            if selector[i] == 2: selected <- c[i]
            if selector[i] == 3: selected <- d[i]
            if selector[i] == 4: selected <- e[i]
            a[i] <- a[i] + selected * selected
            i <- i + 1
        round <- round + 1
    i <- 0
    while i < n:
        tsvc_s442_store_i64_le(a[i], output, 8 * i)
        i <- i + 1
    n.i64()

export fn tsvc_s442_indexed_square_accumulate(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s442_indexed_square_accumulate_impl
