# ARC4 port from Trimaran/enc-rc4, Copyright (C) 2001-2003 Christophe Devine.
# Distributed under GPL-2.0-or-later; see the package license notice.
const OUTPUT_BYTES: usize = 82
const MAX_PASSES: i64 = 2000

def rc4_crypt_one(keys: u8[48]&, key_base: usize, key_length: usize,
                  staged: mutable u8[82]&, data_base: usize, data_length: usize) -> void:
    state: mutable i32[256] = zeroed
    for index in 0..<256:
        state[index] <- index.i32()
    j: mutable usize = 0
    for index in 0..<256:
        j <- (j + state[index].usize() + keys[key_base + index % key_length].usize()) % 256
        temporary: i32 = state[index]
        state[index] <- state[j]
        state[j] <- temporary
    x: mutable usize = 0
    j <- 0
    for offset in 0..<data_length:
        x <- (x + 1) % 256
        a: usize = state[x].usize()
        j <- (j + a) % 256
        b: usize = state[j].usize()
        state[x] <- b.i32()
        state[j] <- a.i32()
        staged[data_base + offset] <- staged[data_base + offset] ^ state[(a + b) % 256].u8()

def trimaran_enc_rc4_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length != 1:
        return -1
    passes: i64 = input[0]
    if passes < 1 or passes > MAX_PASSES:
        return -1
    if output.is_null() or output_capacity < OUTPUT_BYTES:
        return -2

    keys: mutable u8[48] = zeroed
    key_a: u8[8] = [0x01,0x23,0x45,0x67,0x89,0xab,0xcd,0xef]
    key_b: u8[4] = [0xef,0x01,0x23,0x45]
    for index in 0..<8:
        keys[index] <- key_a[index]
        keys[8 + index] <- key_a[index]
        keys[32 + index] <- key_a[index]
    for index in 0..<4:
        keys[24 + index] <- key_b[index]
        keys[40 + index] <- key_b[index]
    plaintexts: mutable u8[168] = zeroed
    data_a: u8[8] = [0x01,0x23,0x45,0x67,0x89,0xab,0xcd,0xef]
    for index in 0..<8:
        plaintexts[index] <- data_a[index]
    data_b: u8[28] = [0x12,0x34,0x56,0x78,0x9a,0xbc,0xde,0xf0,
                       0x12,0x34,0x56,0x78,0x9a,0xbc,0xde,0xf0,
                       0x12,0x34,0x56,0x78,0x9a,0xbc,0xde,0xf0,
                       0x12,0x34,0x56,0x78]
    for index in 0..<28:
        plaintexts[112 + index] <- data_b[index]

    key_lengths: usize[6] = [8,8,8,4,8,4]
    data_lengths: usize[6] = [8,8,8,20,28,10]
    offsets: usize[6] = [0,8,16,24,44,72]
    staged: mutable u8[82] = zeroed
    for vector in 0..<6:
        output_base: usize = offsets[vector]
        input_base: usize = vector * 28
        for pass in 0..<passes.usize():
            for byte in 0..<data_lengths[vector]:
                staged[output_base + byte] <- plaintexts[input_base + byte]
            rc4_crypt_one(keys&, vector * 8, key_lengths[vector], staged&, output_base, data_lengths[vector])
    for index in 0..<OUTPUT_BYTES:
        output[index] <- staged[index]
    OUTPUT_BYTES.i64()

export fn trimaran_enc_rc4(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = trimaran_enc_rc4_impl
