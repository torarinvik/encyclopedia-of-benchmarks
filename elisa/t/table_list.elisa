def append_record(records: mutable view[i64], count: mutable usize&, value: i64) -> void:
    records[count] <- value
    count <- count + 1

def write_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def table_list_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 98: return -1
    operation_count: i64 = input[0]
    if operation_count < 0 or operation_count > 32 or length != 1 + 3 * operation_count.usize(): return -1
    items: mutable i64[64] = zeroed
    records: mutable i64[594] = zeroed
    head: mutable usize = 32
    item_count: mutable usize = 0
    record_count: mutable usize = 0
    cursor: mutable usize = 1
    step: mutable i64 = 0
    while step < operation_count:
        opcode: i64 = input[cursor]
        arg1: i64 = input[cursor + 1]
        arg2: i64 = input[cursor + 2]
        cursor <- cursor + 3
        if opcode == 0:
            if arg1 < -1000000 or arg1 > 1000000 or arg2 != 0 or item_count >= 32: return -1
            head <- head - 1
            items[head] <- arg1
            item_count <- item_count + 1
            append_record(records[0:594], record_count, opcode)
            append_record(records[0:594], record_count, 0)
        elif opcode == 1:
            if arg1 < -1000000 or arg1 > 1000000 or arg2 != 0 or item_count >= 32: return -1
            items[head + item_count] <- arg1
            item_count <- item_count + 1
            append_record(records[0:594], record_count, opcode)
            append_record(records[0:594], record_count, 0)
        elif opcode == 2:
            if arg1 != 0 or arg2 != 0: return -1
            append_record(records[0:594], record_count, opcode)
            if item_count == 0: append_record(records[0:594], record_count, 0)
            else:
                append_record(records[0:594], record_count, 1)
                append_record(records[0:594], record_count, items[head])
                head <- head + 1
                item_count <- item_count - 1
        elif opcode == 3:
            if arg1 != 0 or arg2 != 0: return -1
            append_record(records[0:594], record_count, opcode)
            if item_count == 0: append_record(records[0:594], record_count, 0)
            else:
                append_record(records[0:594], record_count, 1)
                item_count <- item_count - 1
                append_record(records[0:594], record_count, items[head + item_count])
        elif opcode == 4 or opcode == 5:
            if arg1 != 0 or arg2 != 0: return -1
            append_record(records[0:594], record_count, opcode)
            if item_count == 0: append_record(records[0:594], record_count, 0)
            else:
                append_record(records[0:594], record_count, 1)
                if opcode == 4: append_record(records[0:594], record_count, items[head])
                else: append_record(records[0:594], record_count, items[head + item_count - 1])
        elif opcode == 6:
            if arg2 != 0 or arg1 < 1 or arg1 > item_count.i64(): return -1
            append_record(records[0:594], record_count, opcode)
            append_record(records[0:594], record_count, 1)
            append_record(records[0:594], record_count, items[head + arg1.usize() - 1])
        elif opcode == 7:
            if arg1 < 1 or arg1 > item_count.i64() or arg2 < -1000000 or arg2 > 1000000: return -1
            items[head + arg1.usize() - 1] <- arg2
            append_record(records[0:594], record_count, opcode)
            append_record(records[0:594], record_count, 0)
        elif opcode == 8:
            if arg1 < -1 or arg1 > 33 or arg2 != 0: return -1
            append_record(records[0:594], record_count, opcode)
            append_record(records[0:594], record_count, 1)
            result: i64 = 0
            if arg1 >= 1 and arg1 <= item_count.i64(): result <- 1
            append_record(records[0:594], record_count, result)
        elif opcode == 9:
            if arg1 != 0 or arg2 != 0: return -1
            append_record(records[0:594], record_count, opcode)
            append_record(records[0:594], record_count, 1)
            append_record(records[0:594], record_count, item_count.i64())
        elif opcode == 10 or opcode == 11:
            if arg1 != 0 or arg2 != 0: return -1
            append_record(records[0:594], record_count, opcode)
            append_record(records[0:594], record_count, item_count.i64())
            offset: mutable usize = 0
            while offset < item_count:
                logical: usize = offset + 1
                if opcode == 11: logical <- item_count - offset
                append_record(records[0:594], record_count, logical.i64())
                append_record(records[0:594], record_count, items[head + logical - 1])
                offset <- offset + 1
        else: return -1
        step <- step + 1
    append_record(records[0:594], record_count, 12)
    append_record(records[0:594], record_count, item_count.i64())
    index: mutable usize = 0
    while index < item_count:
        append_record(records[0:594], record_count, items[head + index])
        index <- index + 1
    output_bytes: usize = record_count * 8
    if output.is_null() or capacity < output_bytes: return -2
    index <- 0
    while index < record_count:
        write_i64_le(output[0:capacity], index * 8, records[index])
        index <- index + 1
    return output_bytes.i64()

export fn table_list(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = table_list_impl
