# Uncompiled weighted tree vertex-cover draft.
def twvc_solve(values: view[i64]) -> i64:
    if values.len() < 2 or values.len() > 129: return -1
    nv: i64 = values[0]
    if nv < 1 or nv > 64: return -1
    n: usize = nv.usize()
    if values.len() != 2 * n: return -1
    for vertex in 1..<n:
        if values[vertex] < 0 or values[vertex] >= vertex.i64(): return -1
    included: mutable i64[64] = zeroed
    excluded: mutable i64[64] = zeroed
    for vertex in 0..<n:
        weight: i64 = values[n + vertex]
        if weight < 0 or weight > 1000000: return -1
        included[vertex] <- weight
    vertex: mutable usize = n
    while vertex > 1:
        vertex <- vertex - 1
        parent: usize = values[vertex].usize()
        best: mutable i64 = included[vertex]
        if excluded[vertex] < best: best <- excluded[vertex]
        included[parent] <- included[parent] + best
        excluded[parent] <- excluded[parent] + included[vertex]
    if included[0] < excluded[0]: return included[0]
    excluded[0]

export fn tree_weighted_vertex_cover(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > 129: return -1
    twvc_solve(input[0:length])
