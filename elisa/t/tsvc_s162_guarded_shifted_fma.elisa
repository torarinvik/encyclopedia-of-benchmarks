# Clean-room bounded port of TSVC s162; see package README for provenance.

const TSVC_S162_MAX_N: usize = 64
const TSVC_S162_MAX_INPUT_LENGTH: usize = 194

def tsvc_s162_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s162_guarded_shifted_fma_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > TSVC_S162_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    k: i64 = input[1]
    if n_value < 1 or n_value > 64 or k < 0 or k > 1:
        return -1
    n: usize = n_value.usize()
    if length != 2 + 3 * n:
        return -1
    i: mutable usize = 2
    while i < length:
        value: i64 = input[i]
        if value < -2 or value > 2:
            return -1
        i <- i + 1
    if output.is_null() or capacity < 8 * n:
        return -2
    a_offset: usize = 2
    b_offset: usize = a_offset + n
    c_offset: usize = b_offset + n
    i <- 0
    while i < n:
        tsvc_s162_store_i64_le(input[a_offset + i], output, 8 * i)
        i <- i + 1
    if k > 0:
        i <- 0
        while i + 1 < n:
            value: i64 = input[a_offset + i + 1] + input[b_offset + i] * input[c_offset + i]
            tsvc_s162_store_i64_le(value, output, 8 * i)
            i <- i + 1
    n.i64()

export fn tsvc_s162_guarded_shifted_fma(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s162_guarded_shifted_fma_impl
