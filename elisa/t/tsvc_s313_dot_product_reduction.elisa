const MAX_N: usize = 64
extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_s313_dot_product_reduction_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > 129: return -1
    raw_n: f64 = input[0]
    if trunc(raw_n) != raw_n or raw_n < 1.0 or raw_n > 64.0: return -1
    n: usize = raw_n.usize()
    if length != 1 + 2 * n: return -1
    for i in 1..length:
        if trunc(input[i]) != input[i] or fabs(input[i]) > 1000.0: return -1
    if output.is_null() or capacity < 1: return -2
    sum: f64 = 0.0
    for i in 0..n: sum = sum + input[1 + i] * input[1 + n + i]
    output[0] <- sum
    1

export fn tsvc_s313_dot_product_reduction(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = tsvc_s313_dot_product_reduction_impl
