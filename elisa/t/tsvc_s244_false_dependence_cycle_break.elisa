# Clean-room port of TSVC s244; see package README for provenance and rights.

const TSVC_S244_MAX_N: usize = 32
const TSVC_S244_MAX_INPUT_LENGTH: usize = 129

def tsvc_s244_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s244_false_dependence_cycle_break_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 9 or length > TSVC_S244_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 32:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 4 * n:
        return -1
    a: mutable i64[32] = zeroed
    b: mutable i64[32] = zeroed
    c: mutable i64[32] = zeroed
    d: mutable i64[32] = zeroed
    trace: mutable i64[31] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[1 + i]
        b[i] <- input[1 + n + i]
        c[i] <- input[1 + 2 * n + i]
        d[i] <- input[1 + 3 * n + i]
        if a[i] < -2 or a[i] > 2 or b[i] < -2 or b[i] > 2 or
                c[i] < -2 or c[i] > 2 or d[i] < -2 or d[i] > 2:
            return -1
        i <- i + 1
    output_values: usize = 3 * n - 1
    output_bytes: usize = 8 * output_values
    if output.is_null() or capacity < output_bytes:
        return -2
    i <- 0
    while i < n - 1:
        a[i] <- b[i] + c[i] * d[i]
        b[i] <- c[i] + b[i]
        a[i + 1] <- b[i] + a[i + 1] * d[i]
        trace[i] <- a[i + 1]
        i <- i + 1
    offset: mutable usize = 0
    i <- 0
    while i < n:
        tsvc_s244_store_i64_le(a[i], output, 8 * offset)
        offset <- offset + 1
        i <- i + 1
    i <- 0
    while i < n:
        tsvc_s244_store_i64_le(b[i], output, 8 * offset)
        offset <- offset + 1
        i <- i + 1
    i <- 0
    while i < n - 1:
        tsvc_s244_store_i64_le(trace[i], output, 8 * offset)
        offset <- offset + 1
        i <- i + 1
    output_values.i64()

export fn tsvc_s244_false_dependence_cycle_break(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s244_false_dependence_cycle_break_impl
