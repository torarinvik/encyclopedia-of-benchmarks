const MAX_N: usize = 128

def tsvc_vbor_impl(values: i64&, length: usize) -> i64:
    if length < 7 or length > 1 + 6 * MAX_N:
        return -1
    n_value: i64 = values[0]
    if n_value < 1 or n_value > MAX_N.i64():
        return -1
    n: usize = n_value.usize()
    if length != 1 + 6 * n:
        return -1
    valid: bool =
        while index < length |index: mutable usize = 1| -> valid:
            if values[index] < 0 or values[index] > 2:
                break false
            index <- index + 1
            true
    if not valid:
        return -1

    checksum: i64 =
        while i < n |i: mutable usize = 0, total: mutable i64 = 0| -> total:
            a: i64 = values[1 + i]
            b: i64 = values[1 + n + i]
            c: i64 = values[1 + 2 * n + i]
            d: i64 = values[1 + 3 * n + i]
            e: i64 = values[1 + 4 * n + i]
            f: i64 = values[1 + 5 * n + i]
            a1: i64 = a*b*c + a*b*d + a*b*e + a*b*f + a*c*d + a*c*e + a*c*f + a*d*e + a*d*f + a*e*f
            b1: i64 = b*c*d + b*c*e + b*c*f + b*d*e + b*d*f + b*e*f
            c1: i64 = c*d*e + c*d*f + c*e*f
            d1: i64 = d*e*f
            total <- total + a1*b1*c1*d1
            i <- i + 1
            total
    checksum

export fn tsvc_vbor(values: i64&, length: usize) -> i64 = tsvc_vbor_impl
