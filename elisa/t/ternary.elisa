extern fabs(value: f64) -> f64

const MAX_INPUT_LENGTH: usize = 6
const INVALID_RESULT: f64 = -1.0e300

def objective(operation: i64, x: f64) -> f64:
    delta: f64 = if operation == 0: x - 1.0 else: x + 1.0
    square: f64 = delta * delta
    if operation == 0: -square else: square

def ternary_search(operation: i64, a: f64, b: f64, epsilon: f64,
                   frame: i64, max_calls: i64) -> f64:
    if fabs(a - b) <= epsilon: return objective(operation, (a + b) / 2.0)

    left: f64 = (2.0 * a + b) / 3.0
    right: f64 = (a + 2.0 * b) / 3.0
    left_value: f64 = objective(operation, left)
    right_value: f64 = objective(operation, right)
    take_left: bool = if operation == 0: left_value < right_value else: left_value > right_value
    if frame >= max_calls: return INVALID_RESULT
    if take_left: return ternary_search(operation, left, b, epsilon, frame + 1, max_calls)
    ternary_search(operation, a, right, epsilon, frame + 1, max_calls)

def ternary_impl(input: i64&, length: usize) -> f64:
    if input.is_null() or length < 5 or length > MAX_INPUT_LENGTH: return INVALID_RESULT
    operation: i64 = input[0]
    a_milli: i64 = input[1]
    b_milli: i64 = input[2]
    epsilon_micro: i64 = input[3]
    max_calls: i64 = input[4]
    if length != 5 or (operation != 0 and operation != 1) or
        a_milli < -1000000 or a_milli > b_milli or b_milli > 1000000 or
        epsilon_micro < 1 or epsilon_micro > 1000000 or max_calls < 1 or max_calls > 64:
        return INVALID_RESULT

    a: f64 = a_milli.f64() / 1000.0
    b: f64 = b_milli.f64() / 1000.0
    epsilon: f64 = epsilon_micro.f64() / 1000000.0
    ternary_search(operation, a, b, epsilon, 1, max_calls)

export fn ternary(input: i64&, length: usize) -> f64 = ternary_impl
