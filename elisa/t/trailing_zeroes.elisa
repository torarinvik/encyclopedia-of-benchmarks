# Count decimal zero digits at the end of a nonnegative integer.
def trailing_zeroes_impl(n: i64) -> i64:
    if n < 0:
        return -1
    if n == 0:
        return 1
    return 0 if (n & 1) != 0
    remaining: mutable u64 = n.u64()
    count: mutable u64 = 0
    while true:
        # Multiplication by the inverse of five and a rotate undo 10*q
        # modulo 2^64. The bound on q rules out wraparound.
        product: u64 = remaining * 0xcccccccccccccccd.u64()
        quotient: u64 = (product >> 1) | (product << 63)
        if quotient > 1844674407370955161:
            break
        remaining <- quotient
        count <- count + 1
    count.i64()

export fn trailing_zeroes(n: i64) -> i64 = trailing_zeroes_impl
