const TEA_DELTA: u32 = 0x9E3779B9u32
const TEA_DECRYPT_SUM: u32 = 0xC6EF3720u32

def tea_combine_words(low: u32, high: u32) -> u64:
    (high.u64() << 32) | low.u64()

def tea_encrypt(block: u64, key0: u64, key1: u64) -> u64:
    b0: mutable u32 = block.u32()
    b1: mutable u32 = (block >> 32).u32()
    k0: u32 = key0.u32()
    k1: u32 = (key0 >> 32).u32()
    k2: u32 = key1.u32()
    k3: u32 = (key1 >> 32).u32()
    total: mutable u32 = 0u32
    round: mutable usize = 0
    while round < 32:
        total <- total + TEA_DELTA
        mix0: u32 = ((b1 << 4) + k0) ^ (b1 + total) ^ ((b1 >> 5) + k1)
        b0 <- b0 + mix0
        mix1: u32 = ((b0 << 4) + k2) ^ (b0 + total) ^ ((b0 >> 5) + k3)
        b1 <- b1 + mix1
        round <- round + 1
    (b1.u64() << 32) | b0.u64()

def tea_decrypt(block: u64, key0: u64, key1: u64) -> u64:
    b0: mutable u32 = block.u32()
    b1: mutable u32 = (block >> 32).u32()
    k0: u32 = key0.u32()
    k1: u32 = (key0 >> 32).u32()
    k2: u32 = key1.u32()
    k3: u32 = (key1 >> 32).u32()
    total: mutable u32 = TEA_DECRYPT_SUM
    round: mutable usize = 0
    while round < 32:
        mix1: u32 = ((b0 << 4) + k2) ^ (b0 + total) ^ ((b0 >> 5) + k3)
        b1 <- b1 - mix1
        mix0: u32 = ((b1 << 4) + k0) ^ (b1 + total) ^ ((b1 >> 5) + k1)
        b0 <- b0 - mix0
        total <- total - TEA_DELTA
        round <- round + 1
    (b1.u64() << 32) | b0.u64()

def tea_store_u64_le(value: u64, output: mutable view[u8], offset: usize) -> void:
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((value >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tea_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length != 6:
        return -1
    index: mutable usize = 0
    while index < 6:
        if input[index] < -2147483648 or input[index] > 2147483647:
            return -1
        index <- index + 1
    if output.is_null() or output_capacity < 16:
        return -2

    block: u64 = tea_combine_words(input[0].i32().u32(), input[1].i32().u32())
    key0: u64 = tea_combine_words(input[2].i32().u32(), input[3].i32().u32())
    key1: u64 = tea_combine_words(input[4].i32().u32(), input[5].i32().u32())
    ciphertext: u64 = tea_encrypt(block, key0, key1)
    recovered: u64 = tea_decrypt(ciphertext, key0, key1)
    tea_store_u64_le(ciphertext, output[0:output_capacity], 0)
    tea_store_u64_le(recovered, output[0:output_capacity], 8)
    16

export fn tea(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = tea_impl
