const TE_MAX_N: usize = 8
const TE_MAX_M: usize = 28
const TE_MAX_INPUT: usize = 59

def te_put(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def te_connected(n: usize, m: usize, u: usize&, v: usize&, active: bool&, skip: i64) -> bool:
    seen: mutable bool[8] = zeroed
    queue: mutable usize[8] = zeroed
    head: mutable usize = 0
    tail: mutable usize = 1
    queue[0] <- 0
    seen[0] <- true
    while head < tail:
        a: usize = queue[head]
        head <- head + 1
        edge: mutable usize = 0
        while edge < m:
            if active[edge] and edge.i64() != skip:
                b: mutable usize = TE_MAX_N
                if u[edge] == a: b <- v[edge]
                else if v[edge] == a: b <- u[edge]
                if b < TE_MAX_N and not seen[b]:
                    seen[b] <- true
                    queue[tail] <- b
                    tail <- tail + 1
            edge <- edge + 1
    vertex: mutable usize = 0
    while vertex < n:
        if not seen[vertex]: return false
        vertex <- vertex + 1
    true

def te_edge_connected(n: usize, m: usize, u: usize&, v: usize&, active: bool&) -> bool:
    if not te_connected(n, m, u, v, active, -1): return false
    edge: mutable usize = 0
    while edge < m:
        if active[edge] and not te_connected(n, m, u, v, active, edge.i64()): return false
        edge <- edge + 1
    true

def two_edge_connected_spanning_subgraph_greedy(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 @export("two_edge_connected_spanning_subgraph_greedy"):
    if input.is_null() or length < 2 or length > TE_MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 3 or n64 > 8 or m64 < 3 or m64 > 28: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    u: mutable usize[28] = zeroed
    v: mutable usize[28] = zeroed
    active: mutable bool[28] = zeroed
    edge: mutable usize = 0
    while edge < m:
        a: i64 = input[2 + 2 * edge]
        b: i64 = input[3 + 2 * edge]
        if a < 0 or a >= b or b >= n64: return -1
        u[edge] <- a.usize()
        v[edge] <- b.usize()
        active[edge] <- true
        prior: mutable usize = 0
        while prior < edge:
            if u[prior] == u[edge] and v[prior] == v[edge]: return -1
            prior <- prior + 1
        edge <- edge + 1
    if not te_edge_connected(n, m, u, v, active): return -1
    edge <- 0
    while edge < m:
        active[edge] <- false
        if not te_edge_connected(n, m, u, v, active): active[edge] <- true
        edge <- edge + 1
    count: mutable usize = 0
    edge <- 0
    while edge < m:
        if active[edge]: count <- count + 1
        edge <- edge + 1
    bytes: usize = 8 * (1 + 2 * count)
    if output.is_null() or capacity < bytes: return -2
    te_put(count.i64(), output, 0)
    at: mutable usize = 8
    a: mutable usize = 0
    while a < n:
        b: mutable usize = a + 1
        while b < n:
            edge <- 0
            while edge < m:
                if active[edge] and u[edge] == a and v[edge] == b:
                    te_put(a.i64(), output, at)
                    te_put(b.i64(), output, at + 8)
                    at <- at + 16
                edge <- edge + 1
            b <- b + 1
        a <- a + 1
    bytes.i64()
