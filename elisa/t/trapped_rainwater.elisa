# Store the suffix maxima, then compute the prefix maxima as they are used.
def trapped_water_with_suffix(heights: i64&, length: usize, suffix: mutable u32&) -> i64:
    boundary: mutable u32 = 0
    index: mutable usize = length
    while index > 0:
        index <- index - 1
        raw: u64 = heights[index].u64()
        return -1 if raw > 1000000
        height: u32 = raw.u32()
        boundary <- height if height > boundary else boundary
        suffix[index] <- boundary

    # Only interior bars hold water, so the result is at most 4,094,000,000.
    water: mutable u32 = 0
    boundary <- 0
    index <- 0
    while index < length:
        height: u32 = heights[index].u32()
        boundary <- height if height > boundary else boundary
        right_max: u32 = suffix[index]
        wall: u32 = right_max if right_max < boundary else boundary
        water <- water + (wall - height)
        index <- index + 1
    water.i64()

def trapped_rainwater_impl(heights: i64&, length: usize) -> i64:
    if length > 4096:
        return -1
    if length <= 16:
        short_suffix: mutable u32[16] = zeroed
        return trapped_water_with_suffix(heights, length, &short_suffix[0])
    suffix: mutable u32[4096] = zeroed
    trapped_water_with_suffix(heights, length, &suffix[0])

export fn trapped_rainwater(heights: i64&, length: usize) -> i64 = trapped_rainwater_impl
