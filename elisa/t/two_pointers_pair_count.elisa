const MAX_VALUES: usize = 256
const MAX_INPUT: usize = 258

def sift_down(values: mutable i64&, root_start: usize, end: usize) -> void:
    root: mutable usize = root_start
    while root < end / 2:
        child: mutable usize = root * 2 + 1
        if child + 1 < end and values[child] < values[child + 1]:
            child <- child + 1
        if values[root] >= values[child]:
            break
        temporary: i64 = values[root]
        values[root] <- values[child]
        values[child] <- temporary
        root <- child

def heap_sort(values: mutable i64&, length: usize) -> void:
    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        sift_down(values, start, length)
    ending: mutable usize = length
    while ending > 1:
        ending <- ending - 1
        temporary: i64 = values[0]
        values[0] <- values[ending]
        values[ending] <- temporary
        sift_down(values, 0, ending)

def two_pointers_pair_count_impl(input: i64&, length: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT: return -1
    target: i64 = input[0]
    count_value: i64 = input[1]
    if count_value < 0 or count_value > MAX_VALUES.i64(): return -1
    count: usize = count_value.usize()
    if length != 2 + count: return -1
    if target < -2000000 or target > 2000000: return -1

    values: mutable i64[MAX_VALUES] = zeroed
    for index in 0..<count:
        value: i64 = input[2 + index]
        if value < -1000000 or value > 1000000: return -1
        values[index] <- value
    heap_sort(&values[0], count)
    if count < 2: return 0
    index: mutable usize = 1
    while index < count:
        if values[index - 1] == values[index]: return -1
        index <- index + 1

    left: mutable usize = 0
    right: mutable usize = count - 1
    pairs: mutable i64 = 0
    while left < right:
        sum: i64 = values[left] + values[right]
        if sum < target:
            left <- left + 1
        elif sum > target:
            right <- right - 1
        else:
            pairs <- pairs + 1
            left <- left + 1
    pairs

export fn two_pointers_pair_count(input: i64&, length: usize) -> i64 = two_pointers_pair_count_impl

