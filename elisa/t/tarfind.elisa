# Bounded clean-room TAR-header filename search benchmark.
# Embench-IoT source declares MIT; see the package attribution.
# SPDX-License-Identifier: MIT
const MAX_RECORDS: usize = 35
const MAX_QUERIES: usize = 5
const MIN_NAME_LENGTH: usize = 5
const MAX_NAME_LENGTH: usize = 39
const MAX_INPUT_LENGTH: usize = 2 + MAX_RECORDS * (1 + MAX_NAME_LENGTH) + MAX_QUERIES * (1 + MAX_NAME_LENGTH)

def tarfind_impl(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or input_length < 2 or input_length > MAX_INPUT_LENGTH:
        return -1
    if input[0] < 1 or input[0] > MAX_RECORDS.i64() or input[1] < 1 or input[1] > MAX_QUERIES.i64():
        return -1
    record_count: usize = input[0].usize()
    query_count: usize = input[1].usize()
    record_offsets: mutable usize[MAX_RECORDS] = zeroed
    record_lengths: mutable usize[MAX_RECORDS] = zeroed
    query_offsets: mutable usize[MAX_QUERIES] = zeroed
    query_lengths: mutable usize[MAX_QUERIES] = zeroed
    staged: mutable u8[MAX_QUERIES] = zeroed
    position: mutable usize = 2

    index: mutable usize = 0
    while index < record_count:
        if position >= input_length:
            return -1
        raw_length: i64 = input[position]
        position <- position + 1
        if raw_length < MIN_NAME_LENGTH.i64() or raw_length > MAX_NAME_LENGTH.i64():
            return -1
        name_length: usize = raw_length.usize()
        if name_length > input_length - position:
            return -1
        record_offsets[index] <- position
        record_lengths[index] <- name_length
        offset: mutable usize = 0
        while offset < name_length:
            value: i64 = input[position + offset]
            if value < 65 or value > 90:
                return -1
            offset <- offset + 1
        position <- position + name_length
        index <- index + 1

    index <- 0
    while index < query_count:
        if position >= input_length:
            return -1
        raw_length: i64 = input[position]
        position <- position + 1
        if raw_length < MIN_NAME_LENGTH.i64() or raw_length > MAX_NAME_LENGTH.i64():
            return -1
        name_length: usize = raw_length.usize()
        if name_length > input_length - position:
            return -1
        query_offsets[index] <- position
        query_lengths[index] <- name_length
        offset <- 0
        while offset < name_length:
            value: i64 = input[position + offset]
            if value < 65 or value > 90:
                return -1
            offset <- offset + 1
        position <- position + name_length
        index <- index + 1
    if position != input_length:
        return -1
    if output == null or output_capacity < query_count:
        return -2

    query: mutable usize = 0
    while query < query_count:
        found: mutable i64 = -1
        record: mutable usize = 0
        while record < record_count:
            if record_lengths[record] == query_lengths[query]:
                offset: mutable usize = 0
                while offset < query_lengths[query] and input[record_offsets[record] + offset] == input[query_offsets[query] + offset]:
                    offset <- offset + 1
                if offset == query_lengths[query]:
                    found <- record.i64()
                    break
            record <- record + 1
        if found < 0:
            staged[query] <- 255.u8()
        else:
            staged[query] <- found.u8()
        query <- query + 1
    query <- 0
    while query < query_count:
        output[query] <- staged[query]
        query <- query + 1
    query_count.i64()

export fn tarfind(input: i64&, input_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = tarfind_impl
