# Clean-room bounded profile of TSVC s323; see package README.

const TSVC_S323_MAX_N: usize = 64
const TSVC_S323_MAX_INPUT_LENGTH: usize = 321

def tsvc_s323_bounded(value: i64) -> bool:
    value >= -1 and value <= 1

def tsvc_s323_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s323_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 11 or length > TSVC_S323_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 5 * n:
        return -1

    a_start: usize = 1
    b_start: usize = a_start + n
    c_start: usize = b_start + n
    d_start: usize = c_start + n
    e_start: usize = d_start + n
    a: i64[64]
    b: i64[64]
    for i in 0..n:
        a[i] <- input[a_start + i]
        b[i] <- input[b_start + i]
        if not tsvc_s323_bounded(a[i]) or not tsvc_s323_bounded(b[i]) or not tsvc_s323_bounded(input[c_start + i]) or not tsvc_s323_bounded(input[d_start + i]) or not tsvc_s323_bounded(input[e_start + i]):
            return -1
    if output.is_null() or capacity < 16 * n:
        return -2

    for i in 1..n:
        a[i] <- b[i - 1] + input[c_start + i] * input[d_start + i]
        b[i] <- a[i] + input[c_start + i] * input[e_start + i]
    for i in 0..n:
        tsvc_s323_store(a[i], output[0:capacity], 8 * i)
        tsvc_s323_store(b[i], output[0:capacity], 8 * (n + i))
    (2 * n).i64()

export fn tsvc_s323_coupled_recurrence(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s323_impl
