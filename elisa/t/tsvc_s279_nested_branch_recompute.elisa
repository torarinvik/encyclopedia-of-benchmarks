# Clean-room bounded port of TSVC s279; see package README for provenance.

const TSVC_S279_MAX_N: usize = 64
const TSVC_S279_MAX_PASSES: usize = 8
const TSVC_S279_MAX_INPUT_LENGTH: usize = 322

def tsvc_s279_nested_branch_recompute_store_i64(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s279_nested_branch_recompute_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 7 or length > TSVC_S279_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    passes_value: i64 = input[1]
    if n_value < 1 or n_value > 64 or passes_value < 1 or passes_value > 8:
        return -1
    n: usize = n_value.usize()
    passes: usize = passes_value.usize()
    if length != 2 + 5 * n:
        return -1
    i: mutable usize = 2
    while i < length:
        if input[i] < -2 or input[i] > 2:
            return -1
        i <- i + 1
    if output.is_null() or output_capacity < 24 * n:
        return -2

    a_start: usize = 2
    b_start: usize = a_start + n
    c_start: usize = b_start + n
    d_start: usize = c_start + n
    e_start: usize = d_start + n
    a: mutable i64[64] = zeroed
    b: mutable i64[64] = zeroed
    c: mutable i64[64] = zeroed
    i <- 0
    while i < n:
        a[i] <- input[a_start + i]
        b[i] <- input[b_start + i]
        c[i] <- input[c_start + i]
        i <- i + 1
    pass: mutable usize = 0
    while pass < passes:
        i <- 0
        while i < n:
            if a[i] > 0:
                c[i] <- -c[i] + input[e_start + i] * input[e_start + i]
            else:
                b[i] <- -b[i] + input[d_start + i] * input[d_start + i]
                if b[i] > a[i]:
                    c[i] <- c[i] + input[d_start + i] * input[e_start + i]
            a[i] <- b[i] + c[i] * input[d_start + i]
            i <- i + 1
        pass <- pass + 1
    i <- 0
    while i < n:
        tsvc_s279_nested_branch_recompute_store_i64(a[i], output, 8 * i)
        tsvc_s279_nested_branch_recompute_store_i64(b[i], output, 8 * (n + i))
        tsvc_s279_nested_branch_recompute_store_i64(c[i], output, 8 * (2 * n + i))
        i <- i + 1
    (3 * n).i64()

export fn tsvc_s279_nested_branch_recompute(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = tsvc_s279_nested_branch_recompute_impl
