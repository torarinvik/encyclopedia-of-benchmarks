extern floor(value: f64) -> f64
extern sqrt(value: f64) -> f64

const MAX_CITIES: usize = 8
const COORDINATE_LIMIT: f64 = 16.0

def travelling_salesman_python_bruteforce_impl(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64:
    if input.is_null() or input_len < 3 or input_len > 17: return -1
    raw_count: f64 = input[0]
    if raw_count != raw_count or raw_count < 2.0 or raw_count > 8.0 or raw_count != floor(raw_count): return -1
    city_count: usize = raw_count.usize()
    if input_len != 1 + 2 * city_count: return -1

    x: mutable f64[MAX_CITIES] = zeroed
    y: mutable f64[MAX_CITIES] = zeroed
    city: mutable usize = 0
    while city < city_count:
        x[city] <- input[1 + 2 * city]
        y[city] <- input[2 + 2 * city]
        if x[city] != x[city] or y[city] != y[city] or
            x[city] < -COORDINATE_LIMIT or x[city] > COORDINATE_LIMIT or
            y[city] < -COORDINATE_LIMIT or y[city] > COORDINATE_LIMIT or
            x[city] != floor(x[city]) or y[city] != floor(y[city]): return -1
        city <- city + 1
    
    permutation_len: usize = city_count - 1
    order: mutable usize[7] = zeroed
    best_order: mutable usize[7] = zeroed
    i: mutable usize = 0
    while i < permutation_len:
        order[i] <- i + 1
        i <- i + 1
    best_distance: mutable f64 = 1.0e300
    done: mutable usize = 0
    while done == 0:
        total: mutable f64 = 0.0
        previous: mutable usize = 0
        i <- 0
        while i <= permutation_len:
            next: usize = if i == permutation_len: 0 else: order[i]
            dx: f64 = x[next] - x[previous]
            dy: f64 = y[next] - y[previous]
            total <- total + sqrt(dx * dx + dy * dy)
            previous <- next
            i <- i + 1
        if total < best_distance:
            best_distance <- total
            i <- 0
            while i < permutation_len:
                best_order[i] <- order[i]
                i <- i + 1

        i <- permutation_len
        while i > 1 and order[i - 2] >= order[i - 1]: i <- i - 1
        if i <= 1:
            done <- 1
        else:
            pivot: usize = i - 2
            j: mutable usize = permutation_len - 1
            while order[j] <= order[pivot]: j <- j - 1
            temp: mutable usize = order[pivot]
            order[pivot] <- order[j]
            order[j] <- temp
            left: mutable usize = i - 1
            right: mutable usize = permutation_len - 1
            while left < right:
                temp <- order[left]
                order[left] <- order[right]
                order[right] <- temp
                left <- left + 1
                right <- right - 1

    result: mutable f64[11] = zeroed
    path_len: usize = city_count + 1
    result[0] <- path_len.f64()
    result[1] <- 0.0
    i <- 0
    while i < permutation_len:
        result[2 + i] <- best_order[i].f64()
        i <- i + 1
    result[path_len] <- 0.0
    result[path_len + 1] <- best_distance
    required: usize = city_count + 3
    if output.is_null() or output_capacity < required: return -2
    i <- 0
    while i < required:
        output[i] <- result[i]
        i <- i + 1
    required.i64()

export fn travelling_salesman_python_bruteforce(input: f64&, input_len: usize, output: mutable f64&, output_capacity: usize) -> i64 = travelling_salesman_python_bruteforce_impl
