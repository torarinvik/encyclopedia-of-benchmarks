extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_s222_interleaved_square_recurrence_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > 257: return -1
    rn: f64 = input[0]
    if rn != rn or trunc(rn) != rn or rn < 1.0 or rn > 64.0: return -1
    n: usize = rn.usize()
    if length != 1 + 4*n: return -1
    for i in 1..1+3*n:
        if input[i] != input[i] or trunc(input[i]) != input[i] or fabs(input[i]) > 2.0: return -1
    for i in 1+3*n..length:
        if input[i] != input[i] or not (input[i] == -1.0 or input[i] == -0.5 or input[i] == 0.0 or input[i] == 0.5 or input[i] == 1.0): return -1
    required: usize = 2*n
    if output.is_null() or capacity < required: return -2
    a: mutable f64[64] = zeroed
    e: mutable f64[64] = zeroed
    for i in 0..n:
        a[i] <- input[1+i]
        e[i] <- input[1+3*n+i]
    for i in 1..n:
        product: f64 = input[1+n+i] * input[1+2*n+i]
        a[i] <- a[i] + product
        e[i] <- e[i-1] * e[i-1]
        a[i] <- a[i] - product
    for i in 0..n:
        output[i] <- a[i]
        output[n+i] <- e[i]
    required.i64()

export fn tsvc_s222_interleaved_square_recurrence(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = tsvc_s222_interleaved_square_recurrence_impl
