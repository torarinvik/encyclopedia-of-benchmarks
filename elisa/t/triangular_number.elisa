# Compute T(n) = n(n+1)/2 without an overflowing intermediate product.
def triangular_number_impl(input: i64) -> i64:
    if input < 0 or input > 4294967295:
        return -1
    left: i64 = input / 2 if input % 2 == 0 else input
    right: i64 = input + 1 if input % 2 == 0 else (input + 1) / 2
    left * right

export fn triangular_number(input: i64) -> i64 = triangular_number_impl
