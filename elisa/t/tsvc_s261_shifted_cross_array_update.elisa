# Clean-room bounded port of TSVC s261; see package README for provenance.

const TSVC_S261_MAX_N: usize = 64
const TSVC_S261_MAX_INPUT_LENGTH: usize = 257

def tsvc_s261_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s261_shifted_cross_array_update_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 9 or length > TSVC_S261_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 4 * n:
        return -1
    a: mutable i64[64] = zeroed
    b: mutable i64[64] = zeroed
    c: mutable i64[64] = zeroed
    d: mutable i64[64] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[1 + i]
        b[i] <- input[1 + n + i]
        c[i] <- input[1 + 2 * n + i]
        d[i] <- input[1 + 3 * n + i]
        if a[i] < -2 or a[i] > 2 or b[i] < -2 or b[i] > 2 or
                c[i] < -2 or c[i] > 2 or d[i] < -2 or d[i] > 2:
            return -1
        i <- i + 1
    if output.is_null() or capacity < 16 * n:
        return -2
    i <- 1
    while i < n:
        temporary: i64 = a[i] + b[i]
        a[i] <- temporary + c[i - 1]
        product: i64 = c[i] * d[i]
        c[i] <- product
        i <- i + 1
    i <- 0
    while i < n:
        tsvc_s261_store_i64_le(a[i], output, 8 * i)
        tsvc_s261_store_i64_le(c[i], output, 8 * (n + i))
        i <- i + 1
    (2 * n).i64()

export fn tsvc_s261_shifted_cross_array_update(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s261_shifted_cross_array_update_impl
