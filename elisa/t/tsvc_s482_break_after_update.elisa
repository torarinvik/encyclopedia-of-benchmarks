extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_s482_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > 194:
        return -1
    count: f64 = input[0]
    repetitions: f64 = input[1]
    if count != count or trunc(count) != count or count < 1 or count > 64 or
            repetitions != repetitions or trunc(repetitions) != repetitions or repetitions < 1 or repetitions > 8:
        return -1
    n: usize = count.usize()
    passes: usize = repetitions.usize()
    if length != 2 + 3 * n:
        return -1
    for i in 2..length:
        value: f64 = input[i]
        if value != value or trunc(value) != value or fabs(value) > 1:
            return -1
    if output.is_null() or capacity < n:
        return -2

    a: mutable f64[64] = zeroed
    b_start: usize = 2 + n
    c_start: usize = 2 + 2 * n
    for i in 0..n:
        a[i] <- input[2 + i]
    for pass in 0..passes:
        for i in 0..n:
            b: f64 = input[b_start + i]
            c: f64 = input[c_start + i]
            a[i] <- a[i] + b * c
            if c > b:
                break
    for i in 0..n:
        output[i] <- a[i]
    return n.i64()

export fn tsvc_s482_break_after_update(input: f64&, length: usize,
        output: mutable f64&, capacity: usize) -> i64 = tsvc_s482_impl
