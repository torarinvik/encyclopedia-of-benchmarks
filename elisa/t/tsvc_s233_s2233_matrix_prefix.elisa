# Clean-room TSVC s233/s2233 profiles; see package rights note.
const MAX_INPUT_LENGTH:usize=194
def put64(v:i64,out:mutable view[u8],off:usize)->void:
 bits:u64=v.u64();k:mutable usize=0
 while k<8:out[off+k]<-((bits>>(8*k))&255).u8();k<-k+1
def tsvc_s233_s2233_matrix_prefix_impl(input:i64&,length:usize,out:mutable u8&,cap:usize)->i64:
 if input.is_null() or length<14 or length>MAX_INPUT_LENGTH:return -1
 nr:i64=input[0];mode:i64=input[1];if nr<2 or nr>8 or (mode!=0 and mode!=1):return -1
 n:usize=nr.usize();nn:usize=n*n;if length!=2+3*nn:return -1
 a:mutable i64[64]=zeroed;b:mutable i64[64]=zeroed;c:mutable i64[64]=zeroed;k:mutable usize=0
 while k<nn:x:i64=input[2+k];y:i64=input[2+nn+k];z:i64=input[2+2*nn+k];if x< -1 or x>1 or y< -1 or y>1 or z< -1 or z>1:return -1;a[k]<-x;b[k]<-y;c[k]<-z;k<-k+1
 if out.is_null() or cap<16*nn:return -2
 i:mutable usize=1
 while i<n:
  j:mutable usize=1
  while j<n:
   a[j*n+i]<-a[(j-1)*n+i]+c[j*n+i]
   j<-j+1
  i<-i+1
 if mode==0:
  i<-1
  while i<n:
   j:mutable usize=1
   while j<n:
    b[j*n+i]<-b[j*n+i-1]+c[j*n+i]
    j<-j+1
   i<-i+1
 else:
  i<-1
  while i<n:
   j:mutable usize=1
   while j<n:
    b[i*n+j]<-b[(i-1)*n+j]+c[i*n+j]
    j<-j+1
   i<-i+1
 k<-0;while k<nn:put64(a[k],out[0:cap],8*k);put64(b[k],out[0:cap],8*(nn+k));k<-k+1
 (2*nn).i64()
export fn tsvc_s233_s2233_matrix_prefix(input:i64&,length:usize,out:mutable u8&,cap:usize)->i64=tsvc_s233_s2233_matrix_prefix_impl
