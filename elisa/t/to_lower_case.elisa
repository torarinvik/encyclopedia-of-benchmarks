# Lowercase ASCII bytes without locale-dependent character handling.
def to_lower_case_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length > 4096:
        return -1
    valid_input: bool =
        while index < length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            value: i64 = input[index]
            if value < 1 or value > 127:
                break false
            index <- index + 1
            valid
    if not valid_input:
        return -1
    if output_capacity < length:
        return -2
    while index < length |index: mutable usize = 0, output|:
        value: i64 = input[index]
        mapped: mutable i64 = value
        if value >= 65 and value <= 90:
            mapped <- value + 32
        output[index] <- mapped.u8()
        index <- index + 1
        output
    length.i64()

export fn to_lower_case(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = to_lower_case_impl
