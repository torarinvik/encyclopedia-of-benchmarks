# Clean-room bounded port of TSVC s256; see package README for provenance.

const TSVC_S256_MAX_N: usize = 16
const TSVC_S256_MAX_CELLS: usize = 256
const TSVC_S256_MAX_INPUT_LENGTH: usize = 530
const TSVC_S256_MAX_OUTPUT_BYTES: usize = 2176

def tsvc_s256_array_expansion_store_i64(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s256_array_expansion_impl(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if input.is_null() or length < 5 or length > TSVC_S256_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    a0: i64 = input[1]
    if n_value < 1 or n_value > 16 or a0 < -1000 or a0 > 1000:
        return -1
    n: usize = n_value.usize()
    cells: usize = n * n
    if length != 2 + n + 2 * cells:
        return -1
    d_start: usize = 2
    b_start: usize = d_start + n
    c_start: usize = b_start + cells
    i: mutable usize = 0
    while i < n:
        if input[d_start + i] < -1000 or input[d_start + i] > 1000:
            return -1
        i <- i + 1
    i <- 0
    while i < cells:
        if input[b_start + i] < -1000 or input[b_start + i] > 1000 or
                input[c_start + i] < -1000000 or input[c_start + i] > 1000000:
            return -1
        i <- i + 1
    output_values: usize = n + cells
    if output.is_null() or output_capacity < output_values * 8:
        return -2

    a: mutable i64[16] = zeroed
    c: mutable i64[TSVC_S256_MAX_CELLS] = zeroed
    a[0] <- a0
    i <- 0
    while i < cells:
        c[i] <- input[c_start + i]
        i <- i + 1
    column: mutable usize = 0
    while column < n:
        row: mutable usize = 1
        while row < n:
            a[row] <- 1 - a[row - 1]
            cell: usize = row * n + column
            c[cell] <- a[row] + input[b_start + cell] * input[d_start + row]
            row <- row + 1
        column <- column + 1
    row: mutable usize = 0
    while row < n:
        tsvc_s256_array_expansion_store_i64(a[row], output, row * 8)
        row <- row + 1
    cell: mutable usize = 0
    while cell < cells:
        tsvc_s256_array_expansion_store_i64(c[cell], output, (n + cell) * 8)
        cell <- cell + 1
    output_values.i64()

export fn tsvc_s256_array_expansion(input: i64&, length: usize,
        output: mutable u8&, output_capacity: usize) -> i64 = tsvc_s256_array_expansion_impl
