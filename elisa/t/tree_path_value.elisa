# Port of Go Problem18's chunked search over its triangle-shaped DAG.
def tree_path_value_impl(packed: i64&, length: usize) -> i64:
    if length < 1 or length > 121 or packed[0] < 1 or packed[0] > 14:
        return -1
    depth: usize = packed[0].usize()
    count: usize = length - 1
    if count == 0:
        return 0

    values: mutable i64[120] = zeroed
    left_children: mutable i64[120] = zeroed
    right_children: mutable i64[120] = zeroed
    for index in 0..<count:
        values[index] <- packed[index + 1]
        left_children[index] <- -1
        right_children[index] <- -1
        if index == 0 and (values[index] < -1000 or values[index] > 1000):
            return -1
        if index > 0 and (values[index] < 1 or values[index] > 1000):
            return -1

    row_start: mutable usize = 0
    width: mutable usize = 1
    while row_start < count:
        for column in 0..<width:
            if row_start + column >= count:
                break
            parent: usize = row_start + column
            left_index: usize = row_start + width + column
            right_index: usize = left_index + 1
            if left_index < count:
                left_children[parent] <- i64(left_index)
            if right_index < count:
                right_children[parent] <- i64(right_index)
        row_start <- row_start + width
        width <- width + 1

    pivot: mutable usize = 0
    maximum: mutable i64 = values[0]
    while left_children[pivot] >= 0:
        stack_node: mutable usize[16] = zeroed
        stack_steps: mutable usize[16] = zeroed
        stack_sum: mutable i64[16] = zeroed
        stack_size: mutable usize = 1
        stack_node[0] <- pivot
        stack_steps[0] <- depth
        stack_sum[0] <- maximum
        while stack_size > 0:
            stack_size <- stack_size - 1
            node: usize = stack_node[stack_size]
            steps: usize = stack_steps[stack_size]
            sum: i64 = stack_sum[stack_size]
            if steps == 0:
                if sum > maximum:
                    maximum <- sum
                    pivot <- node
                continue
            if right_children[node] >= 0:
                child: usize = right_children[node].usize()
                stack_node[stack_size] <- child
                stack_steps[stack_size] <- steps - 1
                stack_sum[stack_size] <- sum + values[child]
                stack_size <- stack_size + 1
            if left_children[node] >= 0:
                child: usize = left_children[node].usize()
                stack_node[stack_size] <- child
                stack_steps[stack_size] <- steps - 1
                stack_sum[stack_size] <- sum + values[child]
                stack_size <- stack_size + 1
            else if sum > maximum:
                maximum <- sum
                pivot <- node
    maximum

export fn tree_path_value(packed: i64&, length: usize) -> i64 = tree_path_value_impl
