# Clean-room TSVC s118 profile; see package rights note.
const MAX_INPUT_LENGTH:usize=74
def put64(v:i64,out:mutable view[u8],off:usize)->void:
 bits:u64=v.u64();k:mutable usize=0
 while k<8:out[off+k]<-((bits>>(8*k))&255).u8();k<-k+1
def tsvc_s118_triangular_convolution_recurrence_impl(input:i64&,length:usize,out:mutable u8&,cap:usize)->i64:
 if input.is_null() or length<8 or length>MAX_INPUT_LENGTH:return -1
 nr:i64=input[0];passes:i64=input[1];if nr<2 or nr>8 or passes<1 or passes>4:return -1
 n:usize=nr.usize();if length!=2+n+n*n:return -1
 a:mutable i64[8]=zeroed;b:mutable i64[64]=zeroed;i:mutable usize=0
 while i<n:x:i64=input[2+i];if x< -1 or x>1:return -1;a[i]<-x;i<-i+1
 i<-0;while i<n*n:x:i64=input[2+n+i];if x< -1 or x>1:return -1;b[i]<-x;i<-i+1
 if out.is_null() or cap<8*n:return -2
 p:mutable usize=0
 while p<passes.usize():
  i<-1
  while i<n:
   j:mutable usize=0
   while j<i:
    a[i]<-a[i]+b[j*n+i]*a[i-j-1]
    j<-j+1
   i<-i+1
  p<-p+1
 i<-0;while i<n:put64(a[i],out[0:cap],8*i);i<-i+1
 n.i64()
export fn tsvc_s118_triangular_convolution_recurrence(input:i64&,length:usize,out:mutable u8&,cap:usize)->i64=tsvc_s118_triangular_convolution_recurrence_impl
