# Clean-room port of TSVC s424; see package README for provenance and rights.

const TSVC_S424_MIN_N: usize = 66
const TSVC_S424_MAX_N: usize = 192
const TSVC_S424_X_LENGTH: usize = 255
const TSVC_S424_MAX_INPUT_LENGTH: usize = 256

def tsvc_s424_alias_overlap_feedback_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 130 or length > TSVC_S424_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 66 or n_value > 192:
        return -1
    n: usize = n_value.usize()
    if length != n + 64:
        return -1
    a: mutable i64[192] = zeroed
    x: mutable i64[255] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[1 + i]
        if a[i] < 0 or a[i] > 10:
            return -1
        i <- i + 1
    i <- 0
    while i < 63:
        x[i] <- input[1 + n + i]
        if x[i] < 0 or x[i] > 10:
            return -1
        i <- i + 1
    # The source zero-fills the aliased xx view beginning at backing index 63.
    i <- 0
    while i < n - 1:
        x[i + 64] <- x[i] + a[i]
        i <- i + 1
    checksum: mutable i64 = 0
    i <- 0
    while i < n:
        checksum <- checksum + x[63 + i]
        i <- i + 1
    checksum

export fn tsvc_s424_alias_overlap_feedback(input: i64&, length: usize) -> i64 = tsvc_s424_alias_overlap_feedback_impl
