# Clean-room bounded profile of TSVC s152; see package README.

const TSVC_S152_MAX_N: usize = 64
const TSVC_S152_MAX_INPUT_LENGTH: usize = 258
const TSVC_S152_MAX_VALUE: i64 = 2
const TSVC_S152_MAX_PASSES: i64 = 32

def tsvc_s152_bounded(value: i64) -> bool:
    value >= -TSVC_S152_MAX_VALUE and value <= TSVC_S152_MAX_VALUE

def tsvc_s152_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s152_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 6 or length > TSVC_S152_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    passes: i64 = input[1]
    if n_value < 1 or n_value > 64 or passes < 1 or passes > TSVC_S152_MAX_PASSES:
        return -1
    n: usize = n_value.usize()
    if length != 2 + 4 * n:
        return -1

    a_start: usize = 2
    c_start: usize = a_start + n
    d_start: usize = c_start + n
    e_start: usize = d_start + n
    a: mutable i64[64] = zeroed
    for i in 0..n:
        a[i] <- input[a_start + i]
        if not tsvc_s152_bounded(a[i]) or not tsvc_s152_bounded(input[c_start + i]) or
            not tsvc_s152_bounded(input[d_start + i]) or not tsvc_s152_bounded(input[e_start + i]):
            return -1
    if output.is_null() or capacity < 8 * n:
        return -2

    for pass in 0..passes.usize():
        for i in 0..n:
            temporary: i64 = input[d_start + i] * input[e_start + i]
            a[i] <- a[i] + temporary * input[c_start + i]
    for i in 0..n:
        tsvc_s152_store(a[i], output, 8 * i)
    n.i64()

export fn tsvc_s152_three_factor_accumulate(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s152_impl
