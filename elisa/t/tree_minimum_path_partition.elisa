# Uncompiled minimum tree path-partition draft.
def tmpp_solve(values: view[i64]) -> i64:
    if values.len() < 1 or values.len() > 65: return -1
    nv: i64 = values[0]
    if nv < 1 or nv > 64: return -1
    n: usize = nv.usize()
    if values.len() != n: return -1
    for vertex in 1..<n:
        if values[vertex] < 0 or values[vertex] >= vertex.i64(): return -1
    base: mutable i64[64] = zeroed
    first: mutable i64[64] = zeroed
    second: mutable i64[64] = zeroed
    vertex: mutable usize = n
    while vertex > 1:
        vertex <- vertex - 1
        parent: usize = values[vertex].usize()
        best: i64 = base[vertex] + first[vertex] + second[vertex]
        gain: i64 = 1 + base[vertex] + first[vertex] - best
        base[parent] <- base[parent] + best
        if gain > first[parent]:
            second[parent] <- first[parent]
            first[parent] <- gain
        else if gain > second[parent]:
            second[parent] <- gain
    nv - base[0] - first[0] - second[0]

export fn tree_minimum_path_partition(input: i64&, length: usize) -> i64:
    if input == null or length < 1 or length > 65: return -1
    tmpp_solve(input[0:length])
