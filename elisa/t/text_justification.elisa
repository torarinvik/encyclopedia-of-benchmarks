const MAX_WIDTH: usize = 64
const MAX_TEXT_BYTES: usize = 512
const MAX_WORDS: usize = 64
const MAX_INPUT_LENGTH: usize = 2 + MAX_TEXT_BYTES + 1
const MAX_OUTPUT_BYTES: usize = MAX_WORDS * MAX_WIDTH + MAX_WORDS

def text_justification_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    width_value: i64 = input[0]
    text_length_value: i64 = input[1]
    if width_value < 1 or width_value > 64 or text_length_value < 0 or text_length_value > 512:
        return -1
    width: usize = width_value.usize()
    text_length: usize = text_length_value.usize()
    if length != 2 + text_length:
        return -1

    text: mutable u8[MAX_TEXT_BYTES] = zeroed
    for i in 0..<text_length:
        value: i64 = input[i + 2]
        if value != 32 and (value < 33 or value > 126):
            return -1
        text[i] <- value.u8()

    starts: mutable usize[MAX_WORDS] = zeroed
    lengths: mutable usize[MAX_WORDS] = zeroed
    word_count: mutable usize = 0
    pos: mutable usize = 0
    while pos < text_length:
        while pos < text_length and text[pos] == 32:
            pos <- pos + 1
        if pos == text_length:
            break
        start: usize = pos
        while pos < text_length and text[pos] != 32:
            pos <- pos + 1
        word_length: usize = pos - start
        if word_count == MAX_WORDS or word_length > width:
            return -1
        starts[word_count] <- start
        lengths[word_count] <- word_length
        word_count <- word_count + 1

    result: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    result_length: mutable usize = 0
    line_start: mutable usize = 0
    line_end: mutable usize = 0
    letters: mutable usize = 0
    first_line: mutable bool = true
    for word in 0..<word_count:
        if letters + lengths[word] + (line_end - line_start) <= width:
            letters <- letters + lengths[word]
            line_end <- line_end + 1
        else:
            if not first_line:
                result[result_length] <- 10
                result_length <- result_length + 1
            first_line <- false
            count: usize = line_end - line_start
            if count == 1:
                for i in 0..<lengths[line_start]:
                    result[result_length] <- text[starts[line_start] + i]
                    result_length <- result_length + 1
                for i in lengths[line_start]..<width:
                    result[result_length] <- 32
                    result_length <- result_length + 1
            else:
                gaps: usize = count - 1
                spaces: usize = width - letters
                base: usize = spaces / gaps
                extra: usize = spaces % gaps
                for item in 0..<count:
                    current: usize = line_start + item
                    for i in 0..<lengths[current]:
                        result[result_length] <- text[starts[current] + i]
                        result_length <- result_length + 1
                    if item + 1 < count:
                        gap_spaces: mutable usize = base
                        if item < extra:
                            gap_spaces <- gap_spaces + 1
                        for i in 0..<gap_spaces:
                            result[result_length] <- 32
                            result_length <- result_length + 1
            line_start <- word
            line_end <- word + 1
            letters <- lengths[word]

    if not first_line:
        result[result_length] <- 10
        result_length <- result_length + 1
    for item in line_start..<line_end:
        if item != line_start:
            result[result_length] <- 32
            result_length <- result_length + 1
        for i in 0..<lengths[item]:
            result[result_length] <- text[starts[item] + i]
            result_length <- result_length + 1
    trailing: usize = width - letters - (line_end - line_start) + 1
    for i in 0..<trailing:
        result[result_length] <- 32
        result_length <- result_length + 1

    if output.is_null() or capacity < result_length:
        return -2
    for i in 0..<result_length:
        output[i] <- result[i]
    result_length.i64()

export fn text_justification(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = text_justification_impl
