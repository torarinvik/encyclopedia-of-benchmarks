# Clean-room bounded profile of TSVC s141; see package README.

const TSVC_S141_MAX_N: usize = 16
const TSVC_S141_MAX_TRIANGLE: usize = 136
const TSVC_S141_MAX_INPUT_LENGTH: usize = 394
const TSVC_S141_MAX_VALUE: i64 = 1000000
const TSVC_S141_MAX_ROUNDS: i64 = 32

def tsvc_s141_bounded(value: i64) -> bool:
    value >= -TSVC_S141_MAX_VALUE and value <= TSVC_S141_MAX_VALUE

def tsvc_s141_store(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s141_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > TSVC_S141_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    rounds: i64 = input[1]
    if n_value < 1 or n_value > 16 or rounds < 1 or rounds > TSVC_S141_MAX_ROUNDS:
        return -1
    n: usize = n_value.usize()
    triangle: usize = n * (n + 1) / 2
    matrix_start: usize = 2 + triangle
    if length != matrix_start + n * n:
        return -1

    packed: mutable i64[136] = zeroed
    for p in 0..triangle:
        packed[p] <- input[2 + p]
        if not tsvc_s141_bounded(packed[p]):
            return -1
    for p in 0..n * n:
        if not tsvc_s141_bounded(input[matrix_start + p]):
            return -1
    if output.is_null() or capacity < 8 * triangle:
        return -2

    for round in 0..rounds.usize():
        for i in 0..n:
            for j in i..n:
                k: usize = j * (j + 1) / 2 + i
                packed[k] <- packed[k] + input[matrix_start + j * n + i]
    for p in 0..triangle:
        tsvc_s141_store(packed[p], output[0:capacity], 8 * p)
    triangle.i64()

export fn tsvc_s141_packed_symmetric_update(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s141_impl
