# Clean-room bounded port of TSVC s4115; see package README for provenance.

const TSVC_S4115_MAX_N: usize = 64
const TSVC_S4115_MAX_INPUT_LENGTH: usize = 193
const TSVC_S4115_MAX_VALUE: i64 = 1000000

def tsvc_s4115_indexed_gather_product_sum_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 4 or length > TSVC_S4115_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 3 * n:
        return -1
    i: mutable usize = 0
    while i < n:
        index: i64 = input[1 + i]
        a_value: i64 = input[1 + n + i]
        b_value: i64 = input[1 + 2 * n + i]
        if index < 0 or index >= n_value:
            return -1
        if a_value < 0 or a_value > TSVC_S4115_MAX_VALUE or b_value < 0 or b_value > TSVC_S4115_MAX_VALUE:
            return -1
        i <- i + 1
    sum: mutable i64 = 0
    i <- 0
    while i < n:
        index: usize = input[1 + i].usize()
        sum <- sum + input[1 + n + i] * input[1 + 2 * n + index]
        i <- i + 1
    sum

export fn tsvc_s4115_indexed_gather_product_sum(input: i64&, length: usize) -> i64 = tsvc_s4115_indexed_gather_product_sum_impl
