# Clean-room port of TSVC s258; see package README for provenance and rights.

const TSVC_S258_MAX_N: usize = 64
const TSVC_S258_MAX_INPUT_LENGTH: usize = 257

def tsvc_s258_wrapped_scalar_expansion_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 5 or length > TSVC_S258_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 1 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 4 * n:
        return -1
    a: mutable i64[64] = zeroed
    c: mutable i64[64] = zeroed
    d: mutable i64[64] = zeroed
    aa0: mutable i64[64] = zeroed
    b: mutable i64[64] = zeroed
    e: mutable i64[64] = zeroed
    i: mutable usize = 0
    while i < n:
        a[i] <- input[1 + i]
        c[i] <- input[1 + n + i]
        d[i] <- input[1 + 2 * n + i]
        aa0[i] <- input[1 + 3 * n + i]
        if a[i] < 0 or a[i] > 2 or c[i] < 0 or c[i] > 2 or
                d[i] < 0 or d[i] > 2 or aa0[i] < 0 or aa0[i] > 2:
            return -1
        i <- i + 1
    s: mutable i64 = 0
    i <- 0
    while i < n:
        if a[i] > 0:
            s <- d[i] * d[i]
        b[i] <- s * c[i] + d[i]
        e[i] <- (s + 1) * aa0[i]
        i <- i + 1
    sum_b: mutable i64 = 0
    sum_e: mutable i64 = 0
    i <- 0
    while i < n:
        sum_b <- sum_b + b[i]
        sum_e <- sum_e + e[i]
        i <- i + 1
    sum_b + sum_e

export fn tsvc_s258_wrapped_scalar_expansion(input: i64&, length: usize) -> i64 = tsvc_s258_wrapped_scalar_expansion_impl
