# Check whether n cubed ends with the decimal digits of n.
def trimorphic_number_impl(number: i64) -> i64:
    if number < 0 or number > 2000000:
        return -1
    modulus: mutable i64 = 10
    digits: mutable i64 = number
    while digits >= 10:
        digits <- digits / 10
        modulus <- modulus * 10
    cube: i64 = number * number * number
    if cube % modulus == number:
        return 1
    return 0

export fn trimorphic_number(number: i64) -> i64 = trimorphic_number_impl
