# Clean-room one-sweep profile of TSVC s241; see package README.

const TSVC_S241_MAX_N: usize = 64
const TSVC_S241_MAX_INPUT_LENGTH: usize = 257
const TSVC_S241_MAX_VALUE: i64 = 2

def tsvc_s241_store(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0..8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()

def tsvc_s241_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 9 or length > TSVC_S241_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    if n_value < 2 or n_value > 64:
        return -1
    n: usize = n_value.usize()
    if length != 1 + 4 * n:
        return -1

    a_start: usize = 1
    b_start: usize = a_start + n
    c_start: usize = b_start + n
    d_start: usize = c_start + n
    a: mutable i64[64] = zeroed
    b: mutable i64[64] = zeroed
    for i in 0..n:
        a[i] <- input[a_start + i]
        b[i] <- input[b_start + i]
        if a[i] < -TSVC_S241_MAX_VALUE or a[i] > TSVC_S241_MAX_VALUE or
            b[i] < -TSVC_S241_MAX_VALUE or b[i] > TSVC_S241_MAX_VALUE or
            input[c_start + i] < -TSVC_S241_MAX_VALUE or input[c_start + i] > TSVC_S241_MAX_VALUE or
            input[d_start + i] < -TSVC_S241_MAX_VALUE or input[d_start + i] > TSVC_S241_MAX_VALUE:
            return -1
    if output.is_null() or capacity < 16 * n:
        return -2

    for i in 0..(n - 1):
        next_a: i64 = a[i + 1]
        a[i] <- b[i] * input[c_start + i] * input[d_start + i]
        b[i] <- a[i] * next_a * input[d_start + i]
    for i in 0..n:
        tsvc_s241_store(a[i], output, 8 * i)
        tsvc_s241_store(b[i], output, 8 * (n + i))
    (2 * n).i64()

export fn tsvc_s241_cross_coupled_product_map(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s241_impl
