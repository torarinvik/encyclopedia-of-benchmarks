const TREEADD_MAX_LEVEL: i64 = 12
const TREEADD_MAX_NODES: usize = 4095
const TREEADD_PASSES: usize = 100

struct TreeaddNode:
    value: i32
    left: i32
    right: i32

struct TreeaddTree:
    nodes: TreeaddNode[TREEADD_MAX_NODES]
    used: usize

def treeadd_allocate(tree: mutable TreeaddTree&, level: i32, lo: i32, proc: i32) -> i32:
    if level == 0 or tree.used >= TREEADD_MAX_NODES:
        return -1
    index: usize = tree.used
    tree.used <- tree.used + 1
    tree.nodes[index].value <- 1
    left: i32 = treeadd_allocate(tree, level - 1, lo + proc / 2, proc / 2)
    right: i32 = treeadd_allocate(tree, level - 1, lo, proc / 2)
    tree.nodes[index].left <- left
    tree.nodes[index].right <- right
    index.i32()

def treeadd_sum(nodes: TreeaddNode&, index: i32) -> i64:
    if index < 0:
        return 0
    node: TreeaddNode = nodes[index.usize()]
    node.value.i64() + treeadd_sum(nodes, node.left) + treeadd_sum(nodes, node.right)

def treeadd_impl(level: i64) -> i64:
    if level < 0 or level > TREEADD_MAX_LEVEL:
        return -1
    tree: mutable TreeaddTree = zeroed
    root: i32 = treeadd_allocate(tree, level.i32(), 0, 4)
    result: mutable i64 = 0
    pass: mutable usize = 0
    while pass < TREEADD_PASSES:
        result <- treeadd_sum(tree.nodes, root)
        pass <- pass + 1
    result

export fn treeadd(level: i64) -> i64 = treeadd_impl
