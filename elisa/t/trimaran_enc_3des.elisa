const SHIFTS: i64[16] = [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1]
const SBOX: i64[512] = [14, 4, 13, 1, 2, 15, 11, 8, 3, 10, 6, 12, 5, 9, 0, 7, 0, 15, 7, 4, 14, 2, 13, 1, 10, 6, 12, 11, 9, 5, 3, 8, 4, 1, 14, 8, 13, 6, 2, 11, 15, 12, 9, 7, 3, 10, 5, 0, 15, 12, 8, 2, 4, 9, 1, 7, 5, 11, 3, 14, 10, 0, 6, 13, 15, 1, 8, 14, 6, 11, 3, 4, 9, 7, 2, 13, 12, 0, 5, 10, 3, 13, 4, 7, 15, 2, 8, 14, 12, 0, 1, 10, 6, 9, 11, 5, 0, 14, 7, 11, 10, 4, 13, 1, 5, 8, 12, 6, 9, 3, 2, 15, 13, 8, 10, 1, 3, 15, 4, 2, 11, 6, 7, 12, 0, 5, 14, 9, 10, 0, 9, 14, 6, 3, 15, 5, 1, 13, 12, 7, 11, 4, 2, 8, 13, 7, 0, 9, 3, 4, 6, 10, 2, 8, 5, 14, 12, 11, 15, 1, 13, 6, 4, 9, 8, 15, 3, 0, 11, 1, 2, 12, 5, 10, 14, 7, 1, 10, 13, 0, 6, 9, 8, 7, 4, 15, 14, 3, 11, 5, 2, 12, 7, 13, 14, 3, 0, 6, 9, 10, 1, 2, 8, 5, 11, 12, 4, 15, 13, 8, 11, 5, 6, 15, 0, 3, 4, 7, 2, 12, 1, 10, 14, 9, 10, 6, 9, 0, 12, 11, 7, 13, 15, 1, 3, 14, 5, 2, 8, 4, 3, 15, 0, 6, 10, 1, 13, 8, 9, 4, 5, 11, 12, 7, 2, 14, 2, 12, 4, 1, 7, 10, 11, 6, 8, 5, 3, 15, 13, 0, 14, 9, 14, 11, 2, 12, 4, 7, 13, 1, 5, 0, 15, 10, 3, 9, 8, 6, 4, 2, 1, 11, 10, 13, 7, 8, 15, 9, 12, 5, 6, 3, 0, 14, 11, 8, 12, 7, 1, 14, 2, 13, 6, 15, 0, 9, 10, 4, 5, 3, 12, 1, 10, 15, 9, 2, 6, 8, 0, 13, 3, 4, 14, 7, 5, 11, 10, 15, 4, 2, 7, 12, 9, 5, 6, 1, 13, 14, 0, 11, 3, 8, 9, 14, 15, 5, 2, 8, 12, 3, 7, 0, 4, 10, 1, 13, 11, 6, 4, 3, 2, 12, 9, 5, 15, 10, 11, 14, 1, 7, 6, 0, 8, 13, 4, 11, 2, 14, 15, 0, 8, 13, 3, 12, 9, 7, 5, 10, 6, 1, 13, 0, 11, 7, 4, 9, 1, 10, 14, 3, 5, 12, 2, 15, 8, 6, 1, 4, 11, 13, 12, 3, 7, 14, 10, 15, 6, 8, 0, 5, 9, 2, 6, 11, 13, 8, 1, 4, 10, 7, 9, 5, 0, 15, 14, 2, 3, 12, 13, 2, 8, 4, 6, 15, 11, 1, 10, 9, 3, 14, 5, 0, 12, 7, 1, 15, 13, 8, 10, 3, 7, 4, 12, 5, 6, 11, 0, 14, 9, 2, 7, 11, 4, 1, 9, 12, 14, 2, 0, 6, 10, 13, 15, 3, 5, 8, 2, 1, 14, 7, 4, 10, 8, 13, 15, 12, 9, 0, 3, 5, 6, 11]

def des_ecb_table(which: usize, index: usize) -> i64:
    if which == 0: return IP[index]
    if which == 1: return IP_INV[index]
    if which == 2: return E[index]
    if which == 3: return P[index]
    if which == 4: return PC1[index]
    if which == 5: return PC2[index]
    if which == 6: return SHIFTS[index]
    SBOX[index]

def des_ecb_permute(value: u64, which: usize, count: usize, width: u32) -> u64:
    result: mutable u64 = 0
    index: mutable usize = 0
    while index < count:
        result <- (result << 1) | ((value >> (width - des_ecb_table(which, index).u32())) & 1)
        index <- index + 1
    result

def trimaran_des_subkey(key: u64, round_index: usize) -> u64:
    selected: u64 = des_ecb_permute(key, 4, 56, 64)
    mask: u64 = (1.u64() << 28) - 1
    key_left: mutable u64 = selected >> 28
    key_right: mutable u64 = selected & mask
    round: mutable usize = 0
    while round <= round_index:
        shift: u32 = SHIFTS[round].u32()
        key_left <- ((key_left << shift) | (key_left >> (28 - shift))) & mask
        key_right <- ((key_right << shift) | (key_right >> (28 - shift))) & mask
        round <- round + 1
    des_ecb_permute((key_left << 28) | key_right, 5, 48, 56)

def trimaran_des_apply(block: u64, key: u64, decrypt: bool) -> u64:
    state: u64 = des_ecb_permute(block, 0, 64, 64)
    left: mutable u32 = (state >> 32).u32()
    right: mutable u32 = state.u32()
    round: mutable usize = 0
    while round < 16:
        schedule_round: usize = if decrypt: 15 - round else: round
        subkey: u64 = trimaran_des_subkey(key, schedule_round)
        mixed: u64 = des_ecb_permute(right.u64(), 2, 48, 32) ^ subkey
        substituted: mutable u32 = 0
        box: mutable usize = 0
        while box < 8:
            six: usize = ((mixed >> (42 - 6 * box)) & 63).usize()
            row: usize = ((six & 32) >> 4) | (six & 1)
            col: usize = (six >> 1) & 15
            substituted <- (substituted << 4) | des_ecb_table(7, box * 64 + row * 16 + col).u32()
            box <- box + 1
        f: u32 = des_ecb_permute(substituted.u64(), 3, 32, 32).u32()
        next: u32 = left ^ f
        left <- right
        right <- next
        round <- round + 1
    des_ecb_permute((right.u64() << 32) | left.u64(), 1, 64, 64)

def trimaran_enc_3des_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length != 9:
        return -1
    if input[0] < 0 or input[0] > 1:
        return -1
    index: mutable usize = 1
    while index < 9:
        if input[index] < 0 or input[index] > 255:
            return -1
        index <- index + 1
    if output == null or capacity < 8:
        return -2
    block: mutable u64 = 0
    index <- 1
    while index < 9:
        block <- (block << 8) | input[index].u64()
        index <- index + 1
    k1: u64 = 0x0123456789abcdef
    k2: u64 = 0x23456789abcdef01
    k3: u64 = 0x456789abcdef0123
    result: u64
    if input[0] == 0:
        result <- trimaran_des_apply(trimaran_des_apply(trimaran_des_apply(block, k1, false), k2, true), k3, false)
    else:
        result <- trimaran_des_apply(trimaran_des_apply(trimaran_des_apply(block, k3, true), k2, false), k1, true)
    index <- 0
    while index < 8:
        output[index] <- ((result >> (56 - 8 * index)) & 255).u8()
        index <- index + 1
    8

export fn trimaran_enc_3des(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = trimaran_enc_3des_impl
