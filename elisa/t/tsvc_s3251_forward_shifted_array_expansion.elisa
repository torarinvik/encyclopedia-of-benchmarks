extern trunc(value: f64) -> f64
extern fabs(value: f64) -> f64

def tsvc_s3251_impl(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length < 6 or length > 321:
        return -1
    count: f64 = input[0]
    if count != count or trunc(count) != count or count < 1 or count > 64:
        return -1
    n: usize = count.usize()
    if length != 1 + 5 * n:
        return -1
    for i in 1..length:
        value: f64 = input[i]
        if value != value or trunc(value) != value or fabs(value) > 1:
            return -1
    if output.is_null() or capacity < 3 * n:
        return -2

    a: mutable f64[64] = zeroed
    b: mutable f64[64] = zeroed
    d: mutable f64[64] = zeroed
    for i in 0..n:
        a[i] <- input[1 + i]
        b[i] <- input[1 + n + i]
        d[i] <- input[1 + 3 * n + i]
    for i in 0..(n - 1):
        c: f64 = input[1 + 2 * n + i]
        e: f64 = input[1 + 4 * n + i]
        a[i + 1] <- b[i] + c
        b[i] <- c * e
        d[i] <- a[i] * e
    for i in 0..n:
        output[i] <- a[i]
        output[n + i] <- b[i]
        output[2 * n + i] <- d[i]
    return (3 * n).i64()

export fn tsvc_s3251_forward_shifted_array_expansion(input: f64&, length: usize,
        output: mutable f64&, capacity: usize) -> i64 = tsvc_s3251_impl
