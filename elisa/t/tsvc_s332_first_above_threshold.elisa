# Clean-room bounded port of TSVC s332; see package README for provenance.

const TSVC_S332_MAX_N: usize = 256
const TSVC_S332_MAX_INPUT_LENGTH: usize = 258

def tsvc_s332_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def tsvc_s332_first_above_threshold_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > TSVC_S332_MAX_INPUT_LENGTH:
        return -1
    n_value: i64 = input[0]
    threshold: i64 = input[1]
    if n_value < 1 or n_value > 256 or threshold < -1000000 or threshold > 1000000:
        return -1
    n: usize = n_value.usize()
    if length != 2 + n:
        return -1
    values: mutable i64[256] = zeroed
    i: mutable usize = 0
    while i < n:
        values[i] <- input[2 + i]
        if values[i] < -1000000 or values[i] > 1000000:
            return -1
        i <- i + 1
    if output.is_null() or capacity < 16:
        return -2
    index: mutable i64 = -2
    value: mutable i64 = -1
    i <- 0
    while i < n:
        if values[i] > threshold:
            index <- i.i64()
            value <- values[i]
            break
        i <- i + 1
    tsvc_s332_store_i64_le(index, output, 0)
    tsvc_s332_store_i64_le(value, output, 8)
    2

export fn tsvc_s332_first_above_threshold(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = tsvc_s332_first_above_threshold_impl
