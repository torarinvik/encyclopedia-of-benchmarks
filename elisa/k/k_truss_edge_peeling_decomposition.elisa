const MAX_N: usize = 16
const MAX_M: usize = 120
const MAX_PARSEABLE_INPUT: usize = 243

def kt_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (8 * byte)) & 255).u8()
        byte <- byte + 1

def k_truss_edge_peeling_decomposition_impl(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 2 or length > MAX_PARSEABLE_INPUT:
        return -1
    input_view: view[i64] = input[0:length]
    if input_view[0] < 1 or input_view[0] > MAX_N.i64() or
        input_view[1] < 0 or input_view[1] > MAX_M.i64():
        return -1
    vertex_count: usize = input_view[0].usize()
    edge_count: usize = input_view[1].usize()
    if length != 2 + 2 * edge_count or length > 242:
        return -1

    adjacent: mutable bool[MAX_N * MAX_N] = zeroed
    edge_index: mutable i64[MAX_N * MAX_N] = zeroed
    edge_u: mutable usize[MAX_M] = zeroed
    edge_v: mutable usize[MAX_M] = zeroed
    support: mutable usize[MAX_M] = zeroed
    alive: mutable bool[MAX_M] = zeroed
    trussness: mutable i64[MAX_M] = zeroed
    cell: mutable usize = 0
    while cell < MAX_N * MAX_N:
        edge_index[cell] <- -1
        cell <- cell + 1
    edge: mutable usize = 0
    while edge < edge_count:
        u_value: i64 = input_view[2 + 2 * edge]
        v_value: i64 = input_view[3 + 2 * edge]
        if u_value < 0 or v_value <= u_value or v_value >= vertex_count.i64():
            return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        if adjacent[u * MAX_N + v]:
            return -1
        adjacent[u * MAX_N + v] <- true
        adjacent[v * MAX_N + u] <- true
        edge_index[u * MAX_N + v] <- edge.i64()
        edge_index[v * MAX_N + u] <- edge.i64()
        edge_u[edge] <- u
        edge_v[edge] <- v
        alive[edge] <- true
        edge <- edge + 1
    u: mutable usize = 0
    while u < vertex_count:
        v: mutable usize = u + 1
        while v < vertex_count:
            w: mutable usize = v + 1
            while w < vertex_count:
                if adjacent[u * MAX_N + v] and adjacent[u * MAX_N + w] and adjacent[v * MAX_N + w]:
                    support[edge_index[u * MAX_N + v].usize()] <- support[edge_index[u * MAX_N + v].usize()] + 1
                    support[edge_index[u * MAX_N + w].usize()] <- support[edge_index[u * MAX_N + w].usize()] + 1
                    support[edge_index[v * MAX_N + w].usize()] <- support[edge_index[v * MAX_N + w].usize()] + 1
                w <- w + 1
            v <- v + 1
        u <- u + 1
    output_bytes: usize = 8 * edge_count
    if output.is_null() or capacity < output_bytes:
        return -2
    remaining: mutable usize = edge_count
    level: mutable usize = 0
    while remaining > 0:
        selected: mutable usize = MAX_M
        edge <- 0
        while edge < edge_count:
            if alive[edge] and (selected == MAX_M or support[edge] < support[selected]):
                selected <- edge
            edge <- edge + 1
        if support[selected] > level:
            level <- support[selected]
        trussness[selected] <- (level + 2).i64()
        alive[selected] <- false
        remaining <- remaining - 1
        u <- edge_u[selected]
        v <- edge_v[selected]
        w: mutable usize = 0
        while w < vertex_count:
            if w != u and w != v and adjacent[u * MAX_N + w] and adjacent[v * MAX_N + w]:
                first: usize = edge_index[u * MAX_N + w].usize()
                second: usize = edge_index[v * MAX_N + w].usize()
                if alive[first] and alive[second]:
                    if support[first] > level:
                        support[first] <- support[first] - 1
                    if support[second] > level:
                        support[second] <- support[second] - 1
            w <- w + 1
    output_view: mutable view[u8] = output[0:output_bytes]
    edge <- 0
    while edge < edge_count:
        kt_store_i64_le(trussness[edge], output_view, 8 * edge)
        edge <- edge + 1
    output_bytes.i64()

export fn k_truss_edge_peeling_decomposition(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64 = k_truss_edge_peeling_decomposition_impl
