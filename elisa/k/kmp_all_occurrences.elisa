const MAX_TEXT_LENGTH: usize = 256
const MAX_PATTERN_LENGTH: usize = 64
const MAX_INPUT_LENGTH: usize = 322

def kmp_all_occurrences_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    text_length_value: i64 = input[0]
    pattern_length_value: i64 = input[1]
    if text_length_value < 0 or text_length_value > MAX_TEXT_LENGTH.i64() or
       pattern_length_value < 1 or pattern_length_value > MAX_PATTERN_LENGTH.i64():
        return -1
    text_length: usize = text_length_value.usize()
    pattern_length: usize = pattern_length_value.usize()
    if length != 2 + text_length + pattern_length:
        return -1
    pattern_offset: usize = 2 + text_length
    index: usize = 0
    while index < text_length + pattern_length:
        if input[2 + index] < 0 or input[2 + index] > 127:
            return -1
        index <- index + 1

    prefix: mutable usize[MAX_PATTERN_LENGTH] = zeroed
    index <- 1
    while index < pattern_length:
        matched: mutable usize = prefix[index - 1]
        while matched > 0 and input[pattern_offset + index] != input[pattern_offset + matched]:
            matched <- prefix[matched - 1]
        if input[pattern_offset + index] == input[pattern_offset + matched]:
            matched <- matched + 1
        prefix[index] <- matched
        index <- index + 1

    matches: mutable usize[MAX_TEXT_LENGTH] = zeroed
    match_count: mutable usize = 0
    matched: mutable usize = 0
    index <- 0
    while index < text_length:
        while matched > 0 and input[2 + index] != input[pattern_offset + matched]:
            matched <- prefix[matched - 1]
        if input[2 + index] == input[pattern_offset + matched]:
            matched <- matched + 1
        if matched == pattern_length:
            matches[match_count] <- index + 1 - pattern_length
            match_count <- match_count + 1
            matched <- prefix[matched - 1]
        index <- index + 1

    output_bytes: usize = match_count * 8
    if output == null or output_capacity < output_bytes:
        return -2
    match_index: usize = 0
    while match_index < match_count:
        bits: u64 = matches[match_index].u64()
        byte: usize = 0
        while byte < 8:
            output[match_index * 8 + byte] <- ((bits >> (8 * byte)) & 255).u8()
            byte <- byte + 1
        match_index <- match_index + 1
    output_bytes.i64()

export fn kmp_all_occurrences(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = kmp_all_occurrences_impl
