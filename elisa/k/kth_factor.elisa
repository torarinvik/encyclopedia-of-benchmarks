def kth_factor_impl(n_value: i64, k_value: i64) -> i64:
    if n_value < 1 or n_value > 10000 or k_value < 1 or k_value > n_value:
        return -1
    n: i32 = n_value.i32()
    k: i32 = k_value.i32()
    factors_found: mutable i32 = 0
    i: mutable i32 = 1
    while i <= n:
        if n % i == 0:
            factors_found <- factors_found + 1
            if factors_found == k:
                return i.i64()
        i <- i + 1
    -1

export fn kth_factor(n_value: i64, k_value: i64) -> i64 = kth_factor_impl
