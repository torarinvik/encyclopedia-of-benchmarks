# Check whether a square can be split into two parts that sum to n.
def kaprekar_number_impl(number: i64) -> i64:
    if number < 1:
        return 0
    if number > 2000000000:
        return -1
    if number == 1:
        return 1
    square: i64 = number * number
    split: mutable i64 = 10
    while split <= square:
        right: i64 = square % split
        if right > 0 and square / split + right == number:
            return 1
        if split > square / 10:
            break
        split <- split * 10
    return 0

export fn kaprekar_number(number: i64) -> i64 = kaprekar_number_impl
