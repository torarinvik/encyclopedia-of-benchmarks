# Two-pass Kosaraju search for directed-graph strongly connected components.
const MAX_VERTEX_COUNT: usize = 40
const MAX_EDGE_COUNT: usize = 2047
const MAX_INPUT_LENGTH: usize = 2 + 2 * MAX_EDGE_COUNT

def kosaraju_fill_order(adjacency: view[u64], visited: mutable view[u8], order: mutable view[usize],
        order_length: mutable usize&, vertex_count: usize, vertex: usize) -> void:
    visited[vertex] <- 1.u8()
    neighbor: mutable usize = 0
    while neighbor < vertex_count |neighbor, adjacency, visited, order, order_length|:
        if (adjacency[vertex] & (1.u64() << neighbor)) != 0 and visited[neighbor] == 0:
            kosaraju_fill_order(adjacency, visited, order, order_length, vertex_count, neighbor)
        neighbor <- neighbor + 1
    order[order_length] <- vertex
    order_length <- order_length + 1

def kosaraju_collect(transpose: view[u64], visited: mutable view[u8], component_id: mutable view[i64],
        vertex_count: usize, vertex: usize, id: i64) -> void:
    visited[vertex] <- 1.u8()
    component_id[vertex] <- id
    neighbor: mutable usize = 0
    while neighbor < vertex_count |neighbor, transpose, visited, component_id|:
        if (transpose[vertex] & (1.u64() << neighbor)) != 0 and visited[neighbor] == 0:
            kosaraju_collect(transpose, visited, component_id, vertex_count, neighbor, id)
        neighbor <- neighbor + 1

def kosaraju_impl(input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64:
    if length < 2 or length > MAX_INPUT_LENGTH:
        return -1
    if input[0] < 0 or input[0] > i64(MAX_VERTEX_COUNT) or input[1] < 0 or input[1] > i64(MAX_EDGE_COUNT):
        return -1
    vertex_count: usize = input[0].usize()
    edge_count: usize = input[1].usize()
    if length != 2 + 2 * edge_count:
        return -1
    adjacency: mutable u64[MAX_VERTEX_COUNT] = zeroed
    transpose: mutable u64[MAX_VERTEX_COUNT] = zeroed
    for edge in 0..<edge_count |input, adjacency, transpose|:
        from_value: i64 = input[2 + 2 * edge]
        to_value: i64 = input[3 + 2 * edge]
        if from_value < 0 or to_value < 0 or from_value >= vertex_count.i64() or to_value >= vertex_count.i64():
            return -1
        from: usize = from_value.usize()
        destination: usize = to_value.usize()
        adjacency[from] <- adjacency[from] | (1.u64() << destination)
        transpose[destination] <- transpose[destination] | (1.u64() << from)
    visited: mutable u8[MAX_VERTEX_COUNT] = zeroed
    order: mutable usize[MAX_VERTEX_COUNT] = zeroed
    order_length: mutable usize = 0
    for vertex in 0..<vertex_count |vertex, adjacency, visited, order, order_length|:
        if visited[vertex] == 0:
            kosaraju_fill_order(adjacency[0:vertex_count], visited[0:vertex_count], order[0:vertex_count], &order_length,
                vertex_count, vertex)
    vertex: mutable usize = 0
    while vertex < MAX_VERTEX_COUNT |vertex, visited|:
        visited[vertex] <- 0.u8()
        vertex <- vertex + 1
    component_id: mutable i64[MAX_VERTEX_COUNT] = zeroed
    vertex <- 0
    while vertex < MAX_VERTEX_COUNT |vertex, component_id|:
        component_id[vertex] <- -1
        vertex <- vertex + 1
    component_count: mutable usize = 0
    step: mutable usize = 0
    while step < order_length |step, order, visited, transpose, component_id, component_count|:
        current: usize = order[order_length - 1 - step]
        if visited[current] == 0:
            kosaraju_collect(transpose[0:vertex_count], visited[0:vertex_count], component_id[0:vertex_count],
                vertex_count, current, component_count.i64())
            component_count <- component_count + 1
        step <- step + 1
    output_length: usize = 1 + vertex_count + component_count
    if output_capacity < output_length:
        return -2
    output[0] <- component_count.u8()
    position: mutable usize = 1
    for first in 0..<vertex_count |first, component_id, position, output|:
        id: i64 = component_id[first]
        emitted: mutable bool = false
        for earlier in 0..<first |earlier, component_id, emitted|:
            if component_id[earlier] == id:
                emitted <- true
        if emitted:
            continue
        component_size: mutable usize = 0
        for member in first..<vertex_count |member, component_id, component_size|:
            if component_id[member] == id:
                component_size <- component_size + 1
        output[position] <- component_size.u8()
        position <- position + 1
        for member in first..<vertex_count |member, component_id, position, output|:
            if component_id[member] == id:
                output[position] <- member.u8()
                position <- position + 1
    output_length.i64()

export fn kosaraju(input: i64&, length: usize, output: mutable u8&,
        output_capacity: usize) -> i64 = kosaraju_impl
