const MAX_POINTS: usize = 8
const MAX_INPUT_LENGTH: usize = 18
const MAX_MOVES: usize = 64
const CENTER_SCALE: f64 = 256.0
const CENTER_BIAS: i64 = 4097
const CENTER_BASE: i64 = 8194

def k_means_clustering_c_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_INPUT_LENGTH: return -1
    n_value: i64 = input[0]
    if n_value < 3 or n_value > MAX_POINTS.i64(): return -1
    n: usize = n_value.usize()
    if length != 1 + 2 * n: return -1

    labels: mutable i64[8] = zeroed
    has_zero: mutable bool = false
    has_one: mutable bool = false
    for index in 0..<n:
        label: i64 = input[index + 1]
        coordinate: i64 = input[1 + n + index]
        if label != 0 and label != 1: return -1
        labels[index] <- label
        if label == 0: has_zero <- true
        if label == 1: has_one <- true
        if coordinate < -16 or coordinate > 16 or
            (index > 0 and input[n + index] >= coordinate): return -1
    if not has_zero or not has_one: return -1

    for move in 0..<MAX_MOVES:
        sums: mutable f64[2] = zeroed
        counts: mutable usize[2] = zeroed
        for index in 0..<n:
            cluster: usize = labels[index].usize()
            sums[cluster] <- sums[cluster] + input[1 + n + index].f64()
            counts[cluster] <- counts[cluster] + 1
        if counts[0] == 0 or counts[1] == 0: return -1
        centers: f64[2] = {
            sums[0] / counts[0].f64(),
            sums[1] / counts[1].f64(),
        }

        changed: mutable usize = 0
        next_labels: mutable i64[8] = zeroed
        for index in 0..<n:
            point: f64 = input[1 + n + index].f64()
            d0: f64 = point - centers[0]
            d1: f64 = point - centers[1]
            cluster: usize = 0
            if d1 * d1 < d0 * d0: cluster <- 1
            next_labels[index] <- cluster.i64()
            if next_labels[index] != labels[index]: changed <- changed + 1
        for index in 0..<n: labels[index] <- next_labels[index]
        if changed == 0:
            code0: i64 = (centers[0] * CENTER_SCALE).i64() + CENTER_BIAS
            code1: i64 = (centers[1] * CENTER_SCALE).i64() + CENTER_BIAS
            if code0 < 1 or code0 > 8193 or code1 < 1 or code1 > 8193: return -1
            return code0 * CENTER_BASE + code1
    return -2

export fn k_means_clustering_c(input: i64&, length: usize) -> i64 = k_means_clustering_c_impl
