const MAX_POINTS: usize = 32
const MAX_DIMENSION: usize = 4
const MAX_CENTERS: usize = 8
const MAX_INPUT_LENGTH: usize = 140

def squared_distance(coordinates: view[i64], dimension: usize,
        row: usize, center: usize) -> i64:
    distance: mutable i64 = 0
    axis: mutable usize = 0
    while axis < dimension:
        point_value: i64 = coordinates[row * dimension + axis]
        center_value: i64 = coordinates[center * dimension + axis]
        difference: i64 = point_value - center_value
        distance <- distance + difference * difference
        axis <- axis + 1
    distance

def row_is_selected(centers: view[i64], count: usize, row: i64) -> bool:
    index: mutable usize = 0
    while index < count:
        if centers[index] == row:
            return true
        index <- index + 1
    false

def store_i64_le(output: mutable u8&, offset: usize, value: i64) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def kmeans_plus_plus_seeding_impl(values: i64&, values_length: usize,
        output: mutable u8&, output_capacity: usize) -> i64:
    if values_length < 4 or values_length > MAX_INPUT_LENGTH:
        return -1
    point_count_value: i64 = values[0]
    dimension_value: i64 = values[1]
    center_count_value: i64 = values[2]
    first_row: i64 = values[3]
    if point_count_value < 1 or point_count_value > MAX_POINTS.i64():
        return -1
    if dimension_value < 1 or dimension_value > MAX_DIMENSION.i64():
        return -1
    if center_count_value < 1 or center_count_value > MAX_CENTERS.i64():
        return -1
    if center_count_value > point_count_value:
        return -1
    if first_row < 0 or first_row >= point_count_value:
        return -1

    point_count: usize = point_count_value.usize()
    dimension: usize = dimension_value.usize()
    center_count: usize = center_count_value.usize()
    coordinate_count: usize = point_count * dimension
    draw_offset: usize = 4 + coordinate_count
    if values_length != draw_offset + center_count - 1:
        return -1

    coordinates: mutable i64[128] = zeroed
    index: mutable usize = 0
    while index < coordinate_count:
        coordinate: i64 = values[4 + index]
        if coordinate < -16 or coordinate > 16:
            return -1
        coordinates[index] <- coordinate
        index <- index + 1

    centers: mutable i64[8] = zeroed
    nearest: mutable i64[32] = zeroed
    centers[0] <- first_row
    row: mutable usize = 0
    while row < point_count:
        nearest[row] <- squared_distance(coordinates[0:coordinate_count], dimension,
                row, first_row.usize())
        row <- row + 1

    step: mutable usize = 0
    while step + 1 < center_count:
        draw: i64 = values[draw_offset + step]
        total_weight: mutable i64 = 0
        row <- 0
        while row < point_count:
            total_weight <- total_weight + nearest[row]
            row <- row + 1

        chosen: mutable i64 = -1
        if total_weight == 0:
            if draw != 0:
                return -1
            row <- 0
            while row < point_count:
                if not row_is_selected(centers[0:step + 1], step + 1, row.i64()):
                    chosen <- row.i64()
                    break
                row <- row + 1
        else:
            if draw < 0 or draw >= total_weight:
                return -1
            cumulative: mutable i64 = 0
            row <- 0
            while row < point_count:
                cumulative <- cumulative + nearest[row]
                if cumulative > draw:
                    chosen <- row.i64()
                    break
                row <- row + 1
        if chosen < 0:
            return -1

        centers[step + 1] <- chosen
        row <- 0
        while row < point_count:
            distance: i64 = squared_distance(coordinates[0:coordinate_count], dimension,
                    row, chosen.usize())
            if distance < nearest[row]:
                nearest[row] <- distance
            row <- row + 1
        step <- step + 1

    output_bytes: usize = center_count * 8
    if output == null or output_capacity < output_bytes:
        return -2
    bytes: mutable u8& = output
    index <- 0
    while index < center_count:
        store_i64_le(bytes, index * 8, centers[index])
        index <- index + 1
    output_bytes.i64()

def kmeans_plus_plus_seeding_entry(input: i64&, length: usize,
    output: mutable u8&, output_capacity: usize) -> i64:
    if input == null or length < 4 or length > MAX_INPUT_LENGTH:
        return -1
    kmeans_plus_plus_seeding_impl(input, length, output, output_capacity)

export fn kmeans_plus_plus_seeding(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = kmeans_plus_plus_seeding_entry
