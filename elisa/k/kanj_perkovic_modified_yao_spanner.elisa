const KPY_N: usize = 16
const KPY_M: usize = 42
const KPY_K: usize = 14
const KPY_D: usize = 84
const KPY_VALID: usize = 312
const KPY_PARSEABLE: usize = 313

def kpy_impl(input: view[i64], length: usize) -> i64:
    if length < 2 or length > KPY_PARSEABLE: return -1
    n_value: i64 = input[0]
    m_value: i64 = input[1]
    if n_value < 3 or n_value > KPY_N.i64() or m_value < n_value - 1 or
        m_value > KPY_M.i64() or m_value > 3 * n_value - 6:
        return -1
    n: usize = n_value.usize()
    m: usize = m_value.usize()
    if length != 2 + n + 7 * m or length > KPY_VALID: return -1

    edge_u: mutable usize[KPY_M] = zeroed
    edge_v: mutable usize[KPY_M] = zeroed
    edge_weight: mutable i64[KPY_M] = zeroed
    edge_cone_u: mutable usize[KPY_M] = zeroed
    edge_cone_v: mutable usize[KPY_M] = zeroed
    adjacent: mutable bool[KPY_N * KPY_N] = zeroed
    expected_degree: mutable usize[KPY_N] = zeroed
    source: mutable usize[KPY_D] = zeroed
    cone: mutable usize[KPY_D] = zeroed
    edge: mutable usize = 0
    while edge < m:
        at: usize = 2 + 5 * edge
        u_value: i64 = input[at]
        v_value: i64 = input[at + 1]
        weight: i64 = input[at + 2]
        cu_value: i64 = input[at + 3]
        cv_value: i64 = input[at + 4]
        if u_value < 0 or u_value >= v_value or v_value >= n_value or
            weight < 1 or weight > 1000000000000 or cu_value < 0 or
            cu_value >= KPY_K.i64() or cv_value < 0 or cv_value >= KPY_K.i64():
            return -1
        if edge > 0 and (u_value < edge_u[edge - 1].i64() or
            (u_value == edge_u[edge - 1].i64() and v_value <= edge_v[edge - 1].i64())):
            return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        cu: usize = cu_value.usize()
        cv: usize = cv_value.usize()
        edge_u[edge] <- u
        edge_v[edge] <- v
        edge_weight[edge] <- weight
        edge_cone_u[edge] <- cu
        edge_cone_v[edge] <- cv
        adjacent[u * KPY_N + v] <- true
        adjacent[v * KPY_N + u] <- true
        expected_degree[u] <- expected_degree[u] + 1
        expected_degree[v] <- expected_degree[v] + 1
        source[2 * edge] <- u
        source[2 * edge + 1] <- v
        cone[2 * edge] <- cu
        cone[2 * edge + 1] <- cv
        edge <- edge + 1

    rotation: mutable usize[KPY_D] = zeroed
    position: mutable usize[KPY_D] = zeroed
    row_start: mutable usize[KPY_N] = zeroed
    degree: mutable usize[KPY_N] = zeroed
    first: mutable i64[KPY_N * KPY_K] = zeroed
    after: mutable i64[KPY_N * KPY_K] = zeroed
    seen: mutable bool[KPY_D] = zeroed
    cell: mutable usize = 0
    while cell < KPY_N * KPY_K:
        first[cell] <- -1
        after[cell] <- -1
        cell <- cell + 1
    cursor: mutable usize = 2 + 5 * m
    used: mutable usize = 0
    vertex: mutable usize = 0
    while vertex < n:
        degree_value: i64 = input[cursor]
        cursor <- cursor + 1
        if degree_value < 1 or degree_value > KPY_D.i64() or
            degree_value.usize() != expected_degree[vertex]: return -1
        row_start[vertex] <- used
        degree[vertex] <- degree_value.usize()
        previous_cone: mutable i64 = -1
        local: mutable usize = 0
        while local < degree[vertex]:
            raw: i64 = input[cursor]
            cursor <- cursor + 1
            if raw < 0 or raw >= (2 * m).i64(): return -1
            dart: usize = raw.usize()
            cone_id: usize = cone[dart]
            if seen[dart] or source[dart] != vertex or cone_id.i64() < previous_cone:
                return -1
            seen[dart] <- true
            previous_cone <- cone_id.i64()
            rotation[used] <- dart
            position[dart] <- used
            bucket: usize = vertex * KPY_K + cone_id
            if first[bucket] < 0: first[bucket] <- used.i64()
            after[bucket] <- (used + 1).i64()
            used <- used + 1
            local <- local + 1
        vertex <- vertex + 1
    if cursor != length or used != 2 * m: return -1
    dart: mutable usize = 0
    while dart < 2 * m:
        if not seen[dart]: return -1
        dart <- dart + 1

    reached: mutable bool[KPY_N] = zeroed
    queue: mutable usize[KPY_N] = zeroed
    head: mutable usize = 0
    tail: mutable usize = 1
    queue[0] <- 0
    reached[0] <- true
    while head < tail:
        u: usize = queue[head]
        head <- head + 1
        v: mutable usize = 0
        while v < n:
            if adjacent[u * KPY_N + v] and not reached[v]:
                reached[v] <- true
                queue[tail] <- v
                tail <- tail + 1
            v <- v + 1
    if tail != n: return -1

    next_face: mutable usize[KPY_D] = zeroed
    face_seen: mutable bool[KPY_D] = zeroed
    faces: mutable usize = 0
    dart <- 0
    while dart < 2 * m:
        twin: usize = dart ^ 1
        destination: usize = source[twin]
        local_position: usize = position[twin] - row_start[destination]
        before: usize = (local_position + degree[destination] - 1) % degree[destination]
        next_face[dart] <- rotation[row_start[destination] + before]
        dart <- dart + 1
    dart <- 0
    while dart < 2 * m:
        if not face_seen[dart]:
            faces <- faces + 1
            current: mutable usize = dart
            while not face_seen[current]:
                face_seen[current] <- true
                current <- next_face[current]
            if current != dart: return -1
        dart <- dart + 1
    if n.i64() - m.i64() + faces.i64() != 2: return -1

    selected: mutable bool[KPY_D] = zeroed
    vertex <- 0
    while vertex < n:
        cone_id: mutable usize = 0
        while cone_id < KPY_K:
            bucket: usize = vertex * KPY_K + cone_id
            if first[bucket] >= 0:
                best: mutable usize = KPY_D
                p: mutable usize = first[bucket].usize()
                while p < after[bucket].usize():
                    candidate: usize = rotation[p]
                    candidate_edge: usize = candidate / 2
                    if best == KPY_D or edge_weight[candidate_edge] < edge_weight[best / 2] or
                        (edge_weight[candidate_edge] == edge_weight[best / 2] and candidate_edge < best / 2):
                        best <- candidate
                    p <- p + 1
                selected[best] <- true
            cone_id <- cone_id + 1
        vertex <- vertex + 1

    vertex <- 0
    while vertex < n:
        occupied: mutable bool = false
        cone_id <- 0
        while cone_id < KPY_K:
            if first[vertex * KPY_K + cone_id] >= 0: occupied <- true
            cone_id <- cone_id + 1
        if occupied:
            start: mutable usize = 0
            while start < KPY_K:
                if first[vertex * KPY_K + start] < 0 and
                    first[vertex * KPY_K + (start + KPY_K - 1) % KPY_K] >= 0:
                    run_length: mutable usize = 0
                    while run_length < KPY_K and first[vertex * KPY_K + (start + run_length) % KPY_K] < 0:
                        run_length <- run_length + 1
                    if run_length == 1:
                        cw_cone: usize = (start + KPY_K - 1) % KPY_K
                        ccw_cone: usize = (start + 1) % KPY_K
                        cw: usize = rotation[after[vertex * KPY_K + cw_cone].usize() - 1]
                        ccw: usize = rotation[first[vertex * KPY_K + ccw_cone].usize()]
                        if selected[cw]: selected[ccw] <- true
                        elif selected[ccw]: selected[cw] <- true
                        else:
                            a: usize = cw / 2
                            b: usize = ccw / 2
                            if edge_weight[a] < edge_weight[b] or
                                (edge_weight[a] == edge_weight[b] and a < b): selected[cw] <- true
                            else: selected[ccw] <- true
                    else:
                        cw_left: mutable usize = run_length / 2
                        ccw_left: mutable usize = (run_length + 1) / 2
                        step: mutable usize = 1
                        while step <= KPY_K and cw_left > 0:
                            c: usize = (start + KPY_K - step) % KPY_K
                            bucket: usize = vertex * KPY_K + c
                            if first[bucket] >= 0:
                                p: mutable usize = after[bucket].usize()
                                while p > first[bucket].usize() and cw_left > 0:
                                    p <- p - 1
                                    candidate: usize = rotation[p]
                                    if not selected[candidate]:
                                        selected[candidate] <- true
                                        cw_left <- cw_left - 1
                            step <- step + 1
                        step <- run_length
                        while step < run_length + KPY_K and ccw_left > 0:
                            c <- (start + step) % KPY_K
                            bucket <- vertex * KPY_K + c
                            if first[bucket] >= 0:
                                p: mutable usize = first[bucket].usize()
                                while p < after[bucket].usize() and ccw_left > 0:
                                    candidate: usize = rotation[p]
                                    if not selected[candidate]:
                                        selected[candidate] <- true
                                        ccw_left <- ccw_left - 1
                                    p <- p + 1
                            step <- step + 1
                start <- start + 1
        vertex <- vertex + 1

    mask: mutable i64 = 0
    edge <- 0
    while edge < m:
        if selected[2 * edge] and selected[2 * edge + 1]: mask <- mask | (1.i64() << edge)
        edge <- edge + 1
    mask

export fn kanj_perkovic_modified_yao_spanner(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 2 or length > KPY_PARSEABLE: return -1
    input_view: view[i64] = input[0:length]
    kpy_impl(input_view, length)
