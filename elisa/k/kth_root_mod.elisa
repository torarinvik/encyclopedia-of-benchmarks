const MAX_T: usize = 8
const MAX_K: i64 = 1000000000
const MAX_P: i64 = 1000

def modular_power(base_input: i64, exponent_input: i64, modulus: i64) -> i64:
    base: mutable i64 = base_input % modulus
    exponent: mutable i64 = exponent_input
    result: mutable i64 = 1 % modulus
    while exponent > 0:
        if exponent % 2 == 1: result <- result * base % modulus
        base <- base * base % modulus
        exponent <- exponent / 2
    result

def is_prime(value: i64) -> bool:
    if value < 2: return false
    divisor: mutable i64 = 2
    while divisor * divisor <= value:
        if value % divisor == 0: return false
        divisor <- divisor + 1
    true

def factor_distinct(value_input: i64, factors: mutable view[i64]) -> usize:
    value: mutable i64 = value_input
    count: mutable usize = 0
    divisor: mutable i64 = 2
    while divisor * divisor <= value:
        if value % divisor == 0:
            factors[count] <- divisor
            count <- count + 1
            while value % divisor == 0: value <- value / divisor
        divisor <- divisor + 1
    if value > 1:
        factors[count] <- value
        count <- count + 1
    count

def primitive_root(prime: i64) -> i64:
    if prime == 2: return 1
    order: i64 = prime - 1
    factors: mutable i64[16] = zeroed
    count: usize = factor_distinct(order, factors[0:16])
    candidate: mutable i64 = 2
    while candidate < prime:
        index: mutable usize = 0
        while index < count and modular_power(candidate, order / factors[index], prime) != 1:
            index <- index + 1
        if index == count: return candidate
        candidate <- candidate + 1
    -1

def gcd_i64(a_input: i64, b_input: i64) -> i64:
    a: mutable i64 = a_input
    b: mutable i64 = b_input
    while b != 0:
        remainder: i64 = a % b
        a <- b
        b <- remainder
    a

def modular_inverse(value: i64, modulus: i64) -> i64:
    old_t: mutable i64 = 0
    new_t: mutable i64 = 1
    old_r: mutable i64 = modulus
    new_r: mutable i64 = value % modulus
    while new_r != 0:
        quotient: i64 = old_r / new_r
        next_t: i64 = old_t - quotient * new_t
        next_r: i64 = old_r - quotient * new_r
        old_t <- new_t
        new_t <- next_t
        old_r <- new_r
        new_r <- next_r
    if old_t < 0: old_t <- old_t + modulus
    old_t

def kth_root(exponent: i64, residue: i64, prime: i64) -> i64:
    if exponent == 0:
        if residue == 1: return 0
        return -1
    if residue == 0: return 0
    order: i64 = prime - 1
    generator: i64 = primitive_root(prime)
    power: mutable i64 = 1
    discrete_log: mutable i64 = -1
    candidate: mutable i64 = 0
    while candidate < order:
        if power == residue:
            discrete_log <- candidate
            break
        power <- power * generator % prime
        candidate <- candidate + 1
    if discrete_log < 0: return -1
    common: i64 = gcd_i64(exponent, order)
    if discrete_log % common != 0: return -1
    reduced_order: i64 = order / common
    root_exponent: mutable i64 = 0
    if reduced_order > 1:
        inverse: i64 = modular_inverse((exponent / common) % reduced_order, reduced_order)
        root_exponent <- (discrete_log / common) * inverse % reduced_order
    root: i64 = modular_power(generator, root_exponent, prime)
    if modular_power(root, exponent, prime) == residue: return root
    -1

def put_i64_le(output: mutable view[u8], offset: usize, value: i64) -> void:
    bits: mutable u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
        byte <- byte + 1

def kth_root_mod_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 4 or length > 1 + 3 * MAX_T: return -1
    test_count: i64 = input[0]
    if test_count < 1 or test_count > MAX_T.i64(): return -1
    count: usize = test_count.usize()
    if length != 1 + 3 * count: return -1
    triples: mutable i64[24] = zeroed
    index: mutable usize = 0
    while index < 3 * count:
        exponent: i64 = input[index + 1]
        residue: i64 = input[index + 2]
        prime: i64 = input[index + 3]
        if exponent < 0 or exponent > MAX_K or prime < 2 or prime > MAX_P or residue < 0 or residue >= prime or not is_prime(prime): return -1
        triples[index] <- exponent
        triples[index + 1] <- residue
        triples[index + 2] <- prime
        index <- index + 3
    required: usize = 8 * count
    if capacity < required or output.is_null(): return -2
    for test in 0..count:
        root: i64 = kth_root(triples[3 * test], triples[3 * test + 1], triples[3 * test + 2])
        put_i64_le(output[0:capacity], 8 * test, root)
    required.i64()

export fn kth_root_mod(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = kth_root_mod_impl
