# Clean-room bounded GBBS k-core profile; see package LICENSE.txt.
const GBBS_KCORE_MAX_N: usize = 16
const GBBS_KCORE_MAX_M: usize = 64
const GBBS_KCORE_MAX_INPUT: usize = 130

def gbbs_kcore_store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: u64 = value.u64()
    byte: mutable usize = 0
    while byte < 8:
        output[offset + byte] <- ((bits >> (byte * 8)) & 255).u8()
        byte <- byte + 1

def gbbs_k_core_decomposition(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("gbbs_k_core_decomposition"):
    if input.is_null() or length < 2 or length > GBBS_KCORE_MAX_INPUT: return -1
    n64: i64 = input[0]
    m64: i64 = input[1]
    if n64 < 1 or n64 > 16 or m64 < 0 or m64 > 64: return -1
    n: usize = n64.usize()
    m: usize = m64.usize()
    if length != 2 + 2 * m: return -1
    adjacent: mutable u8[256] = zeroed
    edge: mutable usize = 0
    while edge < m:
        u_value: i64 = input[2 + 2 * edge]
        v_value: i64 = input[3 + 2 * edge]
        if u_value < 0 or v_value <= u_value or v_value >= n64: return -1
        u: usize = u_value.usize()
        v: usize = v_value.usize()
        if adjacent[u * 16 + v] != 0: return -1
        adjacent[u * 16 + v] <- 1
        adjacent[v * 16 + u] <- 1
        edge <- edge + 1
    output_bytes: usize = 8 * n
    if output.is_null() or capacity < output_bytes: return -2

    degree: mutable usize[16] = zeroed
    core: mutable i64[16] = zeroed
    alive: mutable bool[16] = zeroed
    shell: mutable bool[16] = zeroed
    u: mutable usize = 0
    while u < n:
        alive[u] <- true
        v: mutable usize = 0
        while v < n:
            if adjacent[u * 16 + v] != 0: degree[u] <- degree[u] + 1
            v <- v + 1
        u <- u + 1
    remaining: mutable usize = n
    while remaining > 0:
        k: mutable usize = n
        u <- 0
        while u < n:
            if alive[u] and degree[u] < k: k <- degree[u]
            u <- u + 1
        u <- 0
        while u < n:
            shell[u] <- alive[u] and degree[u] == k
            if shell[u]:
                alive[u] <- false
                core[u] <- k.i64()
                remaining <- remaining - 1
            u <- u + 1
        v <- 0
        while v < n:
            if alive[v]:
                removed: mutable usize = 0
                u <- 0
                while u < n:
                    if shell[u] and adjacent[u * 16 + v] != 0: removed <- removed + 1
                    u <- u + 1
                if removed > 0:
                    next: usize = if degree[v] > removed: degree[v] - removed else: 0
                    degree[v] <- if next < k: k else: next
            v <- v + 1
    u <- 0
    while u < n:
        gbbs_kcore_store_i64_le(core[u], output, 8 * u)
        u <- u + 1
    output_bytes.i64()
