def kelvin_to_celsius_impl(temperature_in_k: f64) -> f64:
    if not (temperature_in_k >= 0.0 and temperature_in_k <= 1000000.0):
        return -1.0
    absolute_zero_in_c: f64 = -273.15
    temperature_in_k + absolute_zero_in_c

export fn kelvin_to_celsius(temperature_in_k: f64) -> f64 = kelvin_to_celsius_impl
