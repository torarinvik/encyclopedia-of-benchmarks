# Clean-room Chapter 585 sampled compressed point-subdivision profile.
const KQ_MAX_N: usize = 32
const KQ_MAX_INPUT: usize = 68
const KQ_MAX_DEPTH: usize = 8

def kq_put(output: mutable view[u8], at: usize, value: i64) -> void:
    bits: u64 = value.u64()
    b: mutable usize = 0
    while b < 8:
        output[at+b] <- (bits >> (8*b)).u8()
        b <- b + 1

def kq_impl(input: view[i64], output: mutable view[u8], capacity: usize,
            output_is_null: bool) -> i64:
    if input.length < 3 or input.length > KQ_MAX_INPUT: return -1
    n64: i64 = input[0]
    k64: i64 = input[1]
    d64: i64 = input[2]
    if n64 < 1 or n64 > 32 or k64 < 1 or k64 > n64 or d64 < 1 or d64 > 8: return -1
    n: usize = n64.usize()
    stride: usize = k64.usize()
    depth: usize = d64.usize()
    if input.length != 3 + 2*n: return -1
    side: i64 = 1.i64() << depth
    var keys = InlineArray[u64, 32](fill=0)
    var key_view: mutable view[u64] = keys[0:32]
    var i: mutable usize = 0
    while i < n:
        x: i64 = input[3+2*i]
        y: i64 = input[4+2*i]
        if x < 0 or y < 0 or x >= side or y >= side: return -1
        key: mutable u64 = 0
        bit: mutable i64 = depth.i64() - 1
        while bit >= 0:
            key <- (key << 2) | ((((x.u64() >> bit.usize()) & 1) << 1) | ((y.u64() >> bit.usize()) & 1))
            bit <- bit - 1
        key_view[i] <- key
        i <- i + 1
    i <- 1
    while i < n:
        value: u64 = key_view[i]
        j: mutable usize = i
        while j > 0 and key_view[j-1] > value:
            key_view[j] <- key_view[j-1]
            j <- j - 1
        key_view[j] <- value
        i <- i + 1
    i <- 1
    while i < n:
        if key_view[i] == key_view[i-1]: return -1
        i <- i + 1

    samples: usize = (n-1)/stride + 1
    var split_depths = InlineArray[i64, 31](fill=0)
    var split_prefixes = InlineArray[u64, 31](fill=0)
    var depths_view: mutable view[i64] = split_depths[0:31]
    var prefixes_view: mutable view[u64] = split_prefixes[0:31]
    var count: mutable usize = 0
    i <- 0
    while i + 1 < samples:
        left: u64 = key_view[i*stride]
        right: u64 = key_view[(i+1)*stride]
        common: mutable usize = 0
        while common < depth:
            shift: usize = 2*(depth-common-1)
            if ((left >> shift) & 3) != ((right >> shift) & 3): break
            common <- common + 1
        prefix: u64 = 0
        if common > 0: prefix = left >> (2*(depth-common))
        found: mutable usize = 0
        while found < count and (depths_view[found] != common.i64() or prefixes_view[found] != prefix):
            found <- found + 1
        if found == count:
            depths_view[count] <- common.i64()
            prefixes_view[count] <- prefix
            count <- count + 1
        i <- i + 1

    i <- 1
    while i < count:
        d: i64 = depths_view[i]
        p: u64 = prefixes_view[i]
        start: u64 = p << (2*(depth-d.usize()))
        j: mutable usize = i
        while j > 0:
            prior_depth: usize = depths_view[j-1].usize()
            prior_start: u64 = prefixes_view[j-1] << (2*(depth-prior_depth))
            if prior_start < start or (prior_start == start and prior_depth <= d.usize()): break
            depths_view[j] <- depths_view[j-1]
            prefixes_view[j] <- prefixes_view[j-1]
            j <- j - 1
        depths_view[j] <- d
        prefixes_view[j] <- p
        i <- i + 1

    output_bytes: usize = 8*(1+2*count)
    if output_is_null or output.length < output_bytes or capacity < output_bytes: return -2
    kq_put(output, 0, count.i64())
    i <- 0
    while i < count:
        kq_put(output, 8*(1+2*i), depths_view[i])
        kq_put(output, 8*(2+2*i), prefixes_view[i].i64())
        i <- i + 1
    output_bytes.i64()

export fn k_quadtree_sampled_point_subdivision(input: i64&, length: usize,
    output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > KQ_MAX_INPUT: return -1
    if output.is_null():
        var empty_output = InlineArray[u8, 1](fill=0)
        return kq_impl(input[0:length], empty_output[0:0], capacity, true)
    kq_impl(input[0:length], output[0:capacity], capacity, false)
