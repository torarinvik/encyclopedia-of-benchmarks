const MAX_LENGTH: usize = 256
const MAX_ABS_VALUE: f64 = 1.0e100

def kahan_summation_impl(values: f64&, values_length: usize, output: mutable f64&) -> i64:
    sum: mutable f64 = 0.0
    correction: mutable f64 = 0.0
    for index in 0..<values_length:
        adjusted: f64 = values[index] - correction
        next: f64 = sum + adjusted
        correction <- (next - sum) - adjusted
        sum <- next
    output[0] <- sum
    1

def kahan_summation_entry(input: f64&, length: usize,
                          output: mutable f64&, capacity: usize) -> i64:
    if input == null or length > MAX_LENGTH:
        return -1
    for index in 0..<length:
        value: f64 = input[index]
        if value != value or value < -MAX_ABS_VALUE or value > MAX_ABS_VALUE:
            return -1
    if output == null or capacity < 1:
        return -2
    kahan_summation_impl(input, length, output)

export fn kahan_summation(input: f64&, length: usize, output: mutable f64&, capacity: usize) -> i64 = kahan_summation_entry
