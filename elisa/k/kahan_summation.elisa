const MAX_LENGTH: usize = 256
const MAX_ABS_VALUE: f64 = 1.0e100

def kahan_summation_impl(values: view[f64], output: mutable view[f64]) -> i64:
    sum: mutable f64 = 0.0
    correction: mutable f64 = 0.0
    for index in 0..<values.len():
        adjusted: f64 = values[index] - correction
        next: f64 = sum + adjusted
        correction <- (next - sum) - adjusted
        sum <- next
    output[0] <- sum
    1

export fn kahan_summation(input: f64&, length: usize,
                          output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or length > MAX_LENGTH:
        return -1
    for index in 0..<length:
        value: f64 = input[index]
        if value != value or value < -MAX_ABS_VALUE or value > MAX_ABS_VALUE:
            return -1
    if output.is_null() or capacity < 1:
        return -2
    kahan_summation_impl(input[0:length], output[0:1])
