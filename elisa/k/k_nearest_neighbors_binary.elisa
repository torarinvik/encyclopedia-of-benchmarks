const MAX_DIM: usize = 8
const MAX_POINTS: usize = 128

def k_nearest_neighbors_binary_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 3:
        return -1
    dimension_value: i64 = input[0]
    point_count_value: i64 = input[1]
    k_value: i64 = input[2]
    if dimension_value < 1 or dimension_value > MAX_DIM.i64() or point_count_value < 1 or point_count_value > MAX_POINTS.i64() or k_value < 1 or k_value > point_count_value or k_value % 2 == 0:
        return -1
    dimension: usize = dimension_value.usize()
    point_count: usize = point_count_value.usize()
    k: usize = k_value.usize()
    if length != 3 + dimension + point_count * (dimension + 1):
        return -1
    for axis in 0..<dimension:
        if input[3 + axis] < -1000 or input[3 + axis] > 1000:
            return -1
    distances: mutable i64[MAX_POINTS] = zeroed
    labels: mutable i64[MAX_POINTS] = zeroed
    for point in 0..<point_count:
        base: usize = 3 + dimension + point * (dimension + 1)
        distance: mutable i64 = 0
        for axis in 0..<dimension:
            coordinate: i64 = input[base + axis]
            if coordinate < -1000 or coordinate > 1000:
                return -1
            delta: i64 = coordinate - input[3 + axis]
            distance <- distance + delta * delta
        label: i64 = input[base + dimension]
        if label != 0 and label != 1:
            return -1
        for previous in 0..<point:
            if distances[previous] == distance:
                return -1
        distances[point] <- distance
        labels[point] <- label
    for index in 1..<point_count:
        distance: i64 = distances[index]
        label: i64 = labels[index]
        previous: mutable usize = index
        while previous > 0 and distances[previous - 1] > distance:
            distances[previous] <- distances[previous - 1]
            labels[previous] <- labels[previous - 1]
            previous <- previous - 1
        distances[previous] <- distance
        labels[previous] <- label
    ones: mutable i64 = 0
    for index in 0..<k:
        ones <- ones + labels[index]
    prediction: i64 = 0
    if ones > (k / 2).i64():
        prediction <- 1
    if output == null or capacity < 8:
        return -2
    bits: mutable u64 = prediction.u64()
    for byte in 0..<8:
        output[byte] <- (bits & 255).u8()
        bits <- bits >> 8
    8

export fn k_nearest_neighbors_binary(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = k_nearest_neighbors_binary_impl
