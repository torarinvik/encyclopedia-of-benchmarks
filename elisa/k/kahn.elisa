def kahn_impl(v: i64&, length: usize) -> i64:
    if length < 2 or length > 258: return -2
    nv: i64 = v[0]; ne: i64 = v[1]
    if nv < 0 or nv > 32 or ne < 0 or ne > 128 or length != 2 + 2 * ne.usize(): return -2
    adj: mutable bool[32 * 32] = zeroed; indegree: mutable i64[32] = zeroed
    i: mutable usize = 0
    while i < ne.usize():
        a: i64 = v[2 + 2 * i]; b: i64 = v[3 + 2 * i]
        if a < 0 or a >= nv or b < 0 or b >= nv: return -2
        pos: usize = a.usize() * 32 + b.usize()
        if not adj[pos]: adj[pos] <- true; indegree[b.usize()] <- indegree[b.usize()] + 1
        i <- i + 1
    q: mutable usize[32] = zeroed; head: mutable usize = 0; tail: mutable usize = 0
    i <- 0
    while i < nv.usize():
        if indegree[i] == 0:
            q[tail] <- i
            tail <- tail + 1
        i <- i + 1
    while head < tail:
        x: usize = q[head]; head <- head + 1; i <- 0
        while i < nv.usize():
            pos: usize = x * 32 + i
            if adj[pos]:
                indegree[i] <- indegree[i] - 1
                if indegree[i] == 0:
                    q[tail] <- i
                    tail <- tail + 1
            i <- i + 1
    if tail == nv.usize(): return nv
    -1
export fn kahn(v: i64&, length: usize) -> i64 = kahn_impl
