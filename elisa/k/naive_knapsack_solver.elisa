def naive_knapsack_solver_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > 32: return -1
    capacity: i64 = values[0]
    count: i64 = values[1]
    if capacity < 0 or capacity > 1000000 or count < 0 or count > 30 or length != count.usize() + 2: return -1
    weight: mutable i64 = 0
    mask: mutable i64 = 0
    index: mutable usize = 0
    while index < count.usize():
        item: i64 = values[index + 2]
        if item < 0 or item > 1000000: return -1
        if weight + item <= capacity:
            weight <- weight + item
            mask <- mask | (1 << index).i64()
        index <- index + 1
    return mask

export fn naive_knapsack_solver(values: i64&, length: usize) -> i64 = naive_knapsack_solver_impl
