def kth_element_in_a_list_impl(v: i64&, n: usize) -> i64:
    if n < 3 or n > 34: return -1
    k = v[0]; pos = v[1]
    if k < 1 or k > 16 or n != k+2 or pos < 1 or pos > k: return -1
    for i in 0..k:
        if v[i+2] < -10000 or v[i+2] > 10000: return -1
    v[pos+1]
export fn kth_element_in_a_list(v: i64&, n: usize) -> i64 = kth_element_in_a_list_impl
