extern sqrt(value: f64) -> f64
extern exp(value: f64) -> f64

const MAX_INPUT_LENGTH: usize = 56
const MAX_MAP_SIZE: usize = 4
const MAX_FEATURE_COUNT: usize = 3
const MAX_WEIGHT_COUNT: usize = 48

def kohonen_topology_exact_integer(value: f64, minimum: i64, maximum: i64) -> bool:
    if value != value or value >= 1.7976931348623157e308 or value <= -1.7976931348623157e308:
        return false
    if value < minimum.f64() or value > maximum.f64(): return false
    value.i64().f64() == value

def kohonen_som_topology_impl(input: f64&, input_length: usize,
                              output: mutable f64&, capacity: usize) -> i64:
    if input.is_null() or input_length < 4 or input_length > MAX_INPUT_LENGTH: return -1
    if not kohonen_topology_exact_integer(input[0], 1, MAX_MAP_SIZE.i64()) or
        not kohonen_topology_exact_integer(input[1], 1, MAX_FEATURE_COUNT.i64()) or
        not kohonen_topology_exact_integer(input[2], 0, 8) or
        not kohonen_topology_exact_integer(input[3], 1, 16): return -1
    map_size: usize = input[0].usize()
    feature_count: usize = input[1].usize()
    radius: usize = input[2].usize()
    alpha_code: usize = input[3].usize()
    cell_count: usize = map_size * map_size
    weight_count: usize = cell_count * feature_count
    if input_length != 4 + feature_count + weight_count: return -1

    sample: mutable f64[MAX_FEATURE_COUNT] = zeroed
    feature: mutable usize = 0
    while feature < feature_count:
        if not kohonen_topology_exact_integer(input[4 + feature], -8, 8): return -1
        sample[feature] <- input[4 + feature]
        feature <- feature + 1

    weights: mutable f64[MAX_WEIGHT_COUNT] = zeroed
    index: mutable usize = 0
    while index < weight_count:
        if not kohonen_topology_exact_integer(input[4 + feature_count + index], -8, 8): return -1
        weights[index] <- input[4 + feature_count + index]
        index <- index + 1

    best_matching_unit: mutable usize = 0
    best_distance: mutable f64 = 0.0
    feature <- 0
    while feature < feature_count:
        difference: f64 = weights[feature] - sample[feature]
        best_distance <- best_distance + difference * difference
        feature <- feature + 1
    best_distance <- sqrt(best_distance)

    cell: mutable usize = 1
    while cell < cell_count:
        distance_squared: mutable f64 = 0.0
        feature <- 0
        while feature < feature_count:
            difference: f64 = weights[cell * feature_count + feature] - sample[feature]
            distance_squared <- distance_squared + difference * difference
            feature <- feature + 1
        distance: f64 = sqrt(distance_squared)
        if distance < best_distance:
            best_distance <- distance
            best_matching_unit <- cell
        cell <- cell + 1

    best_x: usize = best_matching_unit / map_size
    best_y: usize = best_matching_unit % map_size
    first_x: usize = if best_x > radius then best_x - radius else 0
    after_x: usize = if best_x + radius + 1 < map_size then best_x + radius + 1 else map_size
    first_y: usize = if best_y > radius then best_y - radius else 0
    after_y: usize = if best_y + radius + 1 < map_size then best_y + radius + 1 else map_size
    alpha: f64 = alpha_code.f64() / 16.0

    x: mutable usize = first_x
    while x < after_x:
        y: mutable usize = first_y
        while y < after_y:
            dx: usize = if best_x > x then best_x - x else x - best_x
            dy: usize = if best_y > y then best_y - y else y - best_y
            grid_distance_squared: f64 = (dx * dx + dy * dy).f64()
            scale: f64 = exp(-grid_distance_squared / (2.0 * alpha * alpha))
            feature <- 0
            while feature < feature_count:
                index <- (x * map_size + y) * feature_count + feature
                difference: f64 = sample[feature] - weights[index]
                weights[index] <- weights[index] + alpha * scale * difference
                value: f64 = weights[index]
                if value != value or value >= 1.7976931348623157e308 or value <= -1.7976931348623157e308: return -1
                feature <- feature + 1
            y <- y + 1
        x <- x + 1

    output_length: usize = 1 + weight_count
    if output.is_null() or capacity < output_length: return -2
    output[0] <- best_distance
    index <- 0
    while index < weight_count:
        output[1 + index] <- weights[index]
        index <- index + 1
    output_length.i64()

export fn kohonen_som_topology(input: f64&, input_length: usize,
                               output: mutable f64&, capacity: usize) -> i64 = kohonen_som_topology_impl
