def find_key(keys: view[i64], count: usize, key: i64) -> usize:
    index: usize = 0
    while index < count:
        if keys[index] == key: return index
        index <- index + 1
    count

def swap_items(keys: mutable view[i64], priorities: mutable view[i64], a: usize, b: usize):
    key: i64 = keys[a]
    keys[a] <- keys[b]
    keys[b] <- key
    priority: i64 = priorities[a]
    priorities[a] <- priorities[b]
    priorities[b] <- priority

def shift_up(keys: mutable view[i64], priorities: mutable view[i64], start: usize):
    index: mutable usize = start
    while index > 0:
        parent: usize = (index - 1) / 2
        if priorities[parent] <= priorities[index]: break
        swap_items(keys, priorities, parent, index)
        index <- parent

def shift_down(keys: mutable view[i64], priorities: mutable view[i64], count: usize, start: usize):
    index: mutable usize = start
    while 2 * index + 1 < count:
        left: usize = 2 * index + 1
        right: usize = left + 1
        child: mutable usize = count
        if priorities[left] < priorities[index] and (right >= count or priorities[left] < priorities[right]):
            child <- left
        elif right < count and priorities[right] < priorities[index]:
            child <- right
        else:
            break
        swap_items(keys, priorities, index, child)
        index <- child

def key_priority_queue_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > 98: return -1
    if input[0] < 0 or input[0] > 32: return -1
    keys: mutable i64[32] = zeroed
    priorities: mutable i64[32] = zeroed
    answers: mutable i64[32] = zeroed
    heap_size: mutable usize = 0
    answer_count: mutable usize = 0
    position: mutable usize = 1
    operation_index: mutable usize = 0
    while operation_index < input[0].usize():
        if position >= length: return -1
        operation: i64 = input[position]
        if operation == 0 or operation == 1:
            if position + 2 >= length: return -1
            key: i64 = input[position + 1]
            priority: i64 = input[position + 2]
            if key < -1000000000 or key > 1000000000 or priority < -1000000000 or priority > 1000000000: return -1
            position <- position + 3
            found: usize = find_key(keys[0:32], heap_size, key)
            if operation == 0:
                if found != heap_size: return -1
                keys[heap_size] <- key
                priorities[heap_size] <- priority
                shift_up(keys[0:32], priorities[0:32], heap_size)
                heap_size <- heap_size + 1
            elif found == heap_size:
                keys[heap_size] <- key
                priorities[heap_size] <- priority
                shift_up(keys[0:32], priorities[0:32], heap_size)
                heap_size <- heap_size + 1
            else:
                priorities[found] <- priority
                if found > 0 and priorities[(found - 1) / 2] > priority:
                    shift_up(keys[0:32], priorities[0:32], found)
                else:
                    left: usize = 2 * found + 1
                    right: usize = left + 1
                    if (left < heap_size and priorities[left] < priority) or (right < heap_size and priorities[right] < priority):
                        shift_down(keys[0:32], priorities[0:32], heap_size, found)
        elif operation == 2:
            position <- position + 1
            if heap_size == 0: return -1
            swap_items(keys[0:32], priorities[0:32], 0, heap_size - 1)
            heap_size <- heap_size - 1
            answers[answer_count] <- keys[heap_size]
            answer_count <- answer_count + 1
            if heap_size > 0: shift_down(keys[0:32], priorities[0:32], heap_size, 0)
        elif operation == 3:
            if position + 1 >= length: return -1
            key: i64 = input[position + 1]
            if key < -1000000000 or key > 1000000000: return -1
            position <- position + 2
            answers[answer_count] <- if find_key(keys[0:32], heap_size, key) < heap_size then 1 else 0
            answer_count <- answer_count + 1
        elif operation == 4:
            position <- position + 1
            answers[answer_count] <- if heap_size == 0 then 1 else 0
            answer_count <- answer_count + 1
        else:
            return -1
        operation_index <- operation_index + 1
    if position != length: return -1
    output_length: usize = answer_count * 8
    if output.is_null() or capacity < output_length: return -2
    index: usize = 0
    while index < answer_count:
        bits: u64 = answers[index].u64()
        byte: usize = 0
        while byte < 8:
            output[index * 8 + byte] <- ((bits >> (byte * 8)) & 255).u8()
            byte <- byte + 1
        index <- index + 1
    output_length.i64()

export fn key_priority_queue(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = key_priority_queue_impl(input, length, output, capacity)
