const MAX_TEXT_LENGTH: i64 = 256
const MAX_INPUT_LENGTH: usize = 258
const WORD_BYTES: u8[96] = [
    73, 32, 89, 111, 117, 32, 87, 101, 32, 84, 104, 101, 121, 32,
    72, 101, 32, 83, 104, 101, 32, 73, 116, 32, 32, 116, 104, 101, 32,
    84, 104, 101, 32, 32, 111, 102, 32, 32, 105, 115, 32, 73, 115, 32,
    32, 97, 109, 32, 65, 109, 32, 32, 97, 114, 101, 32, 65, 114, 101, 32,
    32, 104, 97, 118, 101, 32, 72, 97, 118, 101, 32, 32, 104, 97, 115, 32,
    72, 97, 115, 32, 32, 109, 97, 121, 32, 77, 97, 121, 32, 32, 98, 101, 32,
    66, 101, 32
]
const WORD_STARTS: usize[24] = [
    0, 2, 6, 9, 14, 17, 21, 24, 29, 33, 37, 41,
    44, 48, 51, 56, 60, 66, 71, 76, 80, 85, 89, 93
]
const WORD_LENGTHS: usize[24] = [
    2, 4, 3, 5, 3, 4, 3, 5, 4, 4, 4, 3,
    4, 3, 5, 4, 6, 5, 5, 4, 5, 4, 4, 3
]

def shift_ascii_letter(code: i64, key: i64) -> i64:
    if code >= 65 and code <= 90: return 65 + (code - 65 + key) % 26
    if code >= 97 and code <= 122: return 97 + (code - 97 + key) % 26
    code

def key_finder_impl(input: i64&, length: usize) -> i64:
    if input.is_null() or length < 1 or length > MAX_INPUT_LENGTH: return -1
    text_length_value: i64 = input[0]
    if text_length_value < 0 or text_length_value > MAX_TEXT_LENGTH: return -1
    text_length: usize = text_length_value.usize()
    if length != text_length + 1: return -1
    index: usize = 0
    while index < text_length:
        code: i64 = input[index + 1]
        if code < 32 or code > 126 or (code >= 48 and code <= 57): return -1
        index <- index + 1

    key: mutable usize = 0
    while key < 26:
        start: mutable usize = 0
        while start < text_length:
            word: mutable usize = 0
            while word < 24:
                word_length: usize = WORD_LENGTHS[word]
                if start + word_length <= text_length:
                    offset: mutable usize = 0
                    while offset < word_length:
                        key_value: i64 = key.i64()
                        shifted: i64 = shift_ascii_letter(input[start + offset + 1], key_value)
                        expected: i64 = WORD_BYTES[WORD_STARTS[word] + offset].i64()
                        if shifted != expected: break
                        offset <- offset + 1
                    if offset == word_length: return key.i64()
                word <- word + 1
            start <- start + 1
        key <- key + 1
    0

export fn key_finder(input: i64&, length: usize) -> i64 = key_finder_impl
