# Check whether n equals the sum of factorials of its decimal digits.
def krishnamurthy_number_checker_impl(n: i64) -> i64:
    if n < -2147483648 or n > 2147483647:
        return -1
    if n <= 0:
        return 0
    original: i64 = n
    remaining: mutable i64 = n
    sum: mutable i64 = 0
    while remaining != 0:
        digit: i64 = remaining % 10
        factorial: i64 = 1
        factor: i64 = 2
        while factor <= digit:
            factorial <- factorial * factor
            factor <- factor + 1
        sum <- sum + factorial
        remaining <- remaining / 10
    if sum == original:
        return 1
    0

export fn krishnamurthy_number_checker(n: i64) -> i64 = krishnamurthy_number_checker_impl
