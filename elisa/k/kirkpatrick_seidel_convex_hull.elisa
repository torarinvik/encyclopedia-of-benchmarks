const KS_MAX_POINTS: usize = 32
const KS_MAX_INPUT_VALUES: usize = 66
const KS_MAX_COORDINATE: i64 = 1000

struct KsPoint:
    x: i64
    y: i64

struct KsSlope:
    dy: i64
    dx: i64

def ks_compare_slope(a: KsSlope, b: KsSlope) -> i64:
    left: i64 = a.dy * b.dx
    right: i64 = b.dy * a.dx
    if left < right: return -1
    if left > right: return 1
    0

def ks_sort_ids_by_x(ids: mutable view[usize], points: view[KsPoint]) -> void:
    i: mutable usize = 1
    while i < ids.length:
        value: usize = ids[i]
        j: mutable usize = i
        while j > 0 and points[ids[j - 1]].x > points[value].x:
            ids[j] <- ids[j - 1]
            j <- j - 1
        ids[j] <- value
        i <- i + 1

def ks_select_id_by_x(ids: mutable view[usize], rank: usize,
                      points: view[KsPoint]) -> usize:
    if ids.length <= 5:
        ks_sort_ids_by_x(ids, points)
        return ids[rank]
    medians: mutable usize[KS_MAX_POINTS] = zeroed
    median_count: mutable usize = 0
    start: mutable usize = 0
    while start < ids.length:
        group: usize = if ids.length - start < 5: ids.length - start else: 5
        group_view: mutable view[usize] = ids[start:start + group]
        ks_sort_ids_by_x(group_view, points)
        medians[median_count] <- ids[start + (group - 1) / 2]
        median_count <- median_count + 1
        start <- start + group
    pivot: usize = ks_select_id_by_x(medians[0:median_count], (median_count - 1) / 2, points)
    lower: mutable usize = 0
    cursor: mutable usize = 0
    upper: mutable usize = ids.length
    while cursor < upper:
        if points[ids[cursor]].x < points[pivot].x:
            temporary: usize = ids[lower]
            ids[lower] <- ids[cursor]
            ids[cursor] <- temporary
            lower <- lower + 1
            cursor <- cursor + 1
        else if points[ids[cursor]].x > points[pivot].x:
            upper <- upper - 1
            temporary: usize = ids[upper]
            ids[upper] <- ids[cursor]
            ids[cursor] <- temporary
        else:
            cursor <- cursor + 1
    if rank < lower: return ks_select_id_by_x(ids[0:lower], rank, points)
    if rank < upper: return pivot
    ks_select_id_by_x(ids[upper:ids.length], rank - upper, points)

def ks_sort_slopes(values: mutable view[KsSlope]) -> void:
    i: mutable usize = 1
    while i < values.length:
        value: KsSlope = values[i]
        j: mutable usize = i
        while j > 0 and ks_compare_slope(values[j - 1], value) > 0:
            values[j] <- values[j - 1]
            j <- j - 1
        values[j] <- value
        i <- i + 1

def ks_select_slope(values: mutable view[KsSlope], rank: usize) -> KsSlope:
    if values.length <= 5:
        ks_sort_slopes(values)
        return values[rank]
    medians: mutable KsSlope[KS_MAX_POINTS] = zeroed
    median_count: mutable usize = 0
    start: mutable usize = 0
    while start < values.length:
        group: usize = if values.length - start < 5: values.length - start else: 5
        group_view: mutable view[KsSlope] = values[start:start + group]
        ks_sort_slopes(group_view)
        medians[median_count] <- values[start + (group - 1) / 2]
        median_count <- median_count + 1
        start <- start + group
    pivot: KsSlope = ks_select_slope(medians[0:median_count], (median_count - 1) / 2)
    lower: mutable usize = 0
    cursor: mutable usize = 0
    upper: mutable usize = values.length
    while cursor < upper:
        order: i64 = ks_compare_slope(values[cursor], pivot)
        if order < 0:
            temporary: KsSlope = values[lower]
            values[lower] <- values[cursor]
            values[cursor] <- temporary
            lower <- lower + 1
            cursor <- cursor + 1
        else if order > 0:
            upper <- upper - 1
            temporary: KsSlope = values[upper]
            values[upper] <- values[cursor]
            values[cursor] <- temporary
        else:
            cursor <- cursor + 1
    if rank < lower: return ks_select_slope(values[0:lower], rank)
    if rank < upper: return pivot
    ks_select_slope(values[upper:values.length], rank - upper)

def ks_pair_slope(first: usize, second: usize, points: view[KsPoint]) -> KsSlope:
    left: usize = first
    right: usize = second
    if points[left].x > points[right].x:
        left <- second
        right <- first
    KsSlope(dy: points[right].y - points[left].y,
            dx: points[right].x - points[left].x)

def ks_upper_bridge(points: view[KsPoint], candidates: mutable view[usize],
                    separator: i64, left_out: mutable usize&,
                    right_out: mutable usize&) -> void:
    count: mutable usize = candidates.length
    while count > 2:
        pair_count: usize = count / 2
        slopes: mutable KsSlope[KS_MAX_POINTS] = zeroed
        pair: mutable usize = 0
        while pair < pair_count:
            slopes[pair] <- ks_pair_slope(candidates[2 * pair], candidates[2 * pair + 1], points)
            pair <- pair + 1
        median: KsSlope = ks_select_slope(slopes[0:pair_count], (pair_count - 1) / 2)
        maximum: mutable i64 = -5000000
        i: mutable usize = 0
        while i < count:
            p: KsPoint = points[candidates[i]]
            score: i64 = p.y * median.dx - median.dy * p.x
            if score > maximum: maximum <- score
            i <- i + 1
        left: mutable usize = KS_MAX_POINTS
        right: mutable usize = KS_MAX_POINTS
        i <- 0
        while i < count:
            id: usize = candidates[i]
            p: KsPoint = points[id]
            if p.y * median.dx - median.dy * p.x == maximum:
                if left == KS_MAX_POINTS or p.x < points[left].x: left <- id
                if right == KS_MAX_POINTS or p.x > points[right].x: right <- id
            i <- i + 1
        if points[left].x <= separator and separator < points[right].x:
            left_out <- left
            right_out <- right
            return
        support_is_left: bool = points[right].x <= separator
        next: mutable usize[KS_MAX_POINTS] = zeroed
        next_count: mutable usize = 0
        pair <- 0
        while pair < pair_count:
            first: usize = candidates[2 * pair]
            second: usize = candidates[2 * pair + 1]
            order: i64 = ks_compare_slope(ks_pair_slope(first, second, points), median)
            keep_first: mutable bool = false
            keep_second: mutable bool = false
            if support_is_left:
                keep_first <- order < 0
                keep_second <- order < 0
                if order >= 0:
                    keep_first <- points[first].x > points[second].x
                    keep_second <- points[second].x > points[first].x
            else:
                keep_first <- order > 0
                keep_second <- order > 0
                if order <= 0:
                    keep_first <- points[first].x < points[second].x
                    keep_second <- points[second].x < points[first].x
            if keep_first:
                next[next_count] <- first
                next_count <- next_count + 1
            if keep_second:
                next[next_count] <- second
                next_count <- next_count + 1
            pair <- pair + 1
        if count % 2 != 0:
            next[next_count] <- candidates[count - 1]
            next_count <- next_count + 1
        i <- 0
        while i < next_count:
            candidates[i] <- next[i]
            i <- i + 1
        count <- next_count
    if points[candidates[0]].x < points[candidates[1]].x:
        left_out <- candidates[0]
        right_out <- candidates[1]
    else:
        left_out <- candidates[1]
        right_out <- candidates[0]

def ks_append_unique(chain: mutable view[usize], chain_count: mutable usize&,
                     point: usize) -> void:
    if chain_count == 0 or chain[chain_count - 1] != point:
        chain[chain_count] <- point
        chain_count <- chain_count + 1

def ks_connect_upper(points: view[KsPoint], candidates: view[usize],
                     left_endpoint: usize, right_endpoint: usize,
                     chain: mutable view[usize], chain_count: mutable usize&) -> void:
    if left_endpoint == right_endpoint:
        ks_append_unique(chain, chain_count, left_endpoint)
        return
    median_ids: mutable usize[KS_MAX_POINTS] = zeroed
    mutable_candidates: mutable usize[KS_MAX_POINTS] = zeroed
    i: mutable usize = 0
    while i < candidates.length:
        median_ids[i] <- candidates[i]
        mutable_candidates[i] <- candidates[i]
        i <- i + 1
    median_point: usize = ks_select_id_by_x(median_ids[0:candidates.length],
                                            (candidates.length - 1) / 2, points)
    separator: i64 = points[median_point].x
    bridge_left: mutable usize = 0
    bridge_right: mutable usize = 0
    ks_upper_bridge(points, mutable_candidates[0:candidates.length], separator,
                    bridge_left, bridge_right)
    left_set: mutable usize[KS_MAX_POINTS] = zeroed
    right_set: mutable usize[KS_MAX_POINTS] = zeroed
    left_count: mutable usize = 0
    right_count: mutable usize = 0
    i <- 0
    while i < candidates.length:
        id: usize = candidates[i]
        if points[id].x <= points[bridge_left].x:
            left_set[left_count] <- id
            left_count <- left_count + 1
        if points[id].x >= points[bridge_right].x:
            right_set[right_count] <- id
            right_count <- right_count + 1
        i <- i + 1
    ks_connect_upper(points, left_set[0:left_count], left_endpoint, bridge_left,
                     chain, chain_count)
    ks_append_unique(chain, chain_count, bridge_right)
    ks_connect_upper(points, right_set[0:right_count], bridge_right, right_endpoint,
                     chain, chain_count)

def ks_store_i64_le(value: i64, output: mutable view[u8], offset: usize) -> void:
    bits: u64 = value.u64()
    for byte in 0 .. 8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def kirkpatrick_seidel_convex_hull_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 1 or length > KS_MAX_INPUT_VALUES: return -1
    input_view: view[i64] = input[0:length]
    if input_view[0] < 3 or input_view[0] > KS_MAX_POINTS.i64(): return -1
    count: usize = input_view[0].usize()
    if length != 1 + 2 * count: return -1
    original: mutable KsPoint[KS_MAX_POINTS] = zeroed
    upper_points: mutable KsPoint[KS_MAX_POINTS] = zeroed
    lower_points: mutable KsPoint[KS_MAX_POINTS] = zeroed
    seen_x: mutable bool[2001] = zeroed
    i: mutable usize = 0
    while i < count:
        x: i64 = input_view[1 + 2 * i]
        y: i64 = input_view[2 + 2 * i]
        if x < -KS_MAX_COORDINATE or x > KS_MAX_COORDINATE or
           y < -KS_MAX_COORDINATE or y > KS_MAX_COORDINATE: return -1
        slot: usize = (x + KS_MAX_COORDINATE).usize()
        if seen_x[slot]: return -1
        seen_x[slot] <- true
        original[i].x <- x
        original[i].y <- y
        upper_points[i].x <- x
        upper_points[i].y <- y
        lower_points[i].x <- x
        lower_points[i].y <- -y
        i <- i + 1
    non_collinear: mutable bool = false
    i <- 2
    while i < count:
        cross: i64 = (original[1].x - original[0].x) * (original[i].y - original[0].y) -
                     (original[1].y - original[0].y) * (original[i].x - original[0].x)
        if cross != 0:
            non_collinear <- true
            break
        i <- i + 1
    if not non_collinear: return -1
    ids: mutable usize[KS_MAX_POINTS] = zeroed
    upper: mutable usize[KS_MAX_POINTS] = zeroed
    lower: mutable usize[KS_MAX_POINTS] = zeroed
    hull: mutable usize[KS_MAX_POINTS] = zeroed
    left_index: mutable usize = 0
    right_index: mutable usize = 0
    i <- 0
    while i < count:
        ids[i] <- i
        if original[i].x < original[left_index].x: left_index <- i
        if original[i].x > original[right_index].x: right_index <- i
        i <- i + 1
    upper_count: mutable usize = 0
    lower_count: mutable usize = 0
    ks_connect_upper(upper_points[0:count], ids[0:count], left_index, right_index,
                     upper[0:KS_MAX_POINTS], upper_count)
    ks_connect_upper(lower_points[0:count], ids[0:count], left_index, right_index,
                     lower[0:KS_MAX_POINTS], lower_count)
    hull_count: mutable usize = 0
    i <- 0
    while i < lower_count:
        ks_append_unique(hull[0:KS_MAX_POINTS], hull_count, lower[i])
        i <- i + 1
    i <- upper_count
    while i > 2:
        i <- i - 1
        ks_append_unique(hull[0:KS_MAX_POINTS], hull_count, upper[i - 1])
    byte_count: usize = hull_count * 16
    if output.is_null() or capacity < byte_count: return -2
    output_view: mutable view[u8] = output[0:byte_count]
    i <- 0
    while i < hull_count:
        ks_store_i64_le(original[hull[i]].x, output_view, 16 * i)
        ks_store_i64_le(original[hull[i]].y, output_view, 16 * i + 8)
        i <- i + 1
    byte_count.i64()

export fn kirkpatrick_seidel_convex_hull(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = kirkpatrick_seidel_convex_hull_impl
