def walker_vose_alias_sampling_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64:
    if input.is_null() or length < 3 or length > 83: return -1
    values: view[i64] = input[0:length]
    nr: i64 = values[0]
    qr: i64 = values[1]
    if nr < 1 or nr > 16 or qr < 0 or qr > 32: return -1
    n: usize = nr.usize()
    q: usize = qr.usize()
    if length != 2 + n + 2 * q: return -1
    total: mutable i64 = 0
    for i in 0..<n:
        weight: i64 = values[2 + i]
        if weight < 0 or weight > 100: return -1
        total <- total + weight
    if total == 0: return -1
    for i in 0..<q:
        column: i64 = values[2 + n + 2 * i]
        ticket: i64 = values[3 + n + 2 * i]
        if column < 0 or column >= nr or ticket < 0 or ticket >= total: return -1
    if q == 0: return 0
    output_bytes: usize = 8 * q
    if output.is_null() or capacity < output_bytes: return -2
    output_view: mutable view[u8] = output[0:output_bytes]
    mass: mutable i64[16] = zeroed
    threshold: mutable i64[16] = zeroed
    aliases: mutable usize[16] = zeroed
    small: mutable usize[16] = zeroed
    large: mutable usize[16] = zeroed
    ns: mutable usize = 0
    nl: mutable usize = 0
    for i in 0..<n:
        mass[i] <- nr * values[2 + i]
        threshold[i] <- total
        aliases[i] <- i
        if mass[i] < total:
            small[ns] <- i
            ns <- ns + 1
        else:
            large[nl] <- i
            nl <- nl + 1
    while ns > 0 and nl > 0:
        ns <- ns - 1
        nl <- nl - 1
        low: usize = small[ns]
        high: usize = large[nl]
        threshold[low] <- mass[low]
        aliases[low] <- high
        mass[high] <- mass[high] - (total - mass[low])
        if mass[high] < total:
            small[ns] <- high
            ns <- ns + 1
        else:
            large[nl] <- high
            nl <- nl + 1
    staged: mutable u8[256] = zeroed
    for i in 0..<q:
        column: usize = values[2 + n + 2 * i].usize()
        chosen: mutable usize = aliases[column]
        if values[3 + n + 2 * i] < threshold[column]: chosen <- column
        bits: mutable u64 = chosen.u64()
        for b in 0..<8:
            staged[8 * i + b] <- (bits & 255).u8()
            bits <- bits >> 8
    for i in 0..<output_bytes: output_view[i] <- staged[i]
    output_bytes.i64()

export fn walker_vose_alias_sampling(input: i64&, length: usize,
        output: mutable u8&, capacity: usize) -> i64 = walker_vose_alias_sampling_impl
