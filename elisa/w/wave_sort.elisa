# Sort values, then swap adjacent pairs to form a <= >= <= wave.
const MAX_ARRAY_LENGTH: usize = 4096

def sift_down(values: mutable view[i64], root_start: usize, end: usize) -> void:
    root: mutable usize = root_start
    while root < end / 2:
        child: mutable usize = root * 2 + 1
        if child + 1 < end and values[child] < values[child + 1]:
            child <- child + 1
        if values[root] >= values[child]:
            break
        temporary: i64 = values[root]
        values[root] <- values[child]
        values[child] <- temporary
        root <- child

def heap_sort(values: mutable view[i64], length: usize) -> void:
    start: mutable usize = length / 2
    while start > 0:
        start <- start - 1
        sift_down(values, start, length)
    ending: mutable usize = length
    while ending > 1:
        ending <- ending - 1
        temporary: i64 = values[0]
        values[0] <- values[ending]
        values[ending] <- temporary
        sift_down(values, 0, ending)

def store_i32_le(value: i64, output: mutable view[u8], position: usize) -> void:
    bits: u32 = value.u32()
    output[position] <- (bits & 255).u8()
    output[position + 1] <- ((bits >> 8) & 255).u8()
    output[position + 2] <- ((bits >> 16) & 255).u8()
    output[position + 3] <- ((bits >> 24) & 255).u8()

def wave_sort_impl(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64:
    if length > MAX_ARRAY_LENGTH:
        return -1
    values: mutable i64[MAX_ARRAY_LENGTH] = zeroed
    index: mutable usize = 0
    while index < length:
        if input[index] < -2147483648 or input[index] > 2147483647:
            return -1
        values[index] <- input[index]
        index <- index + 1
    byte_count: usize = length * 4
    if output_capacity < byte_count:
        return -2
    heap_sort(values[0:length], length)
    index <- 0
    while index + 1 < length:
        temporary: i64 = values[index]
        values[index] <- values[index + 1]
        values[index + 1] <- temporary
        index <- index + 2
    index <- 0
    while index < length:
        store_i32_le(values[index], output[0:output_capacity], index * 4)
        index <- index + 1
    length.i64()

export fn wave_sort(input: i64&, length: usize, output: mutable u8&, output_capacity: usize) -> i64 = wave_sort_impl
