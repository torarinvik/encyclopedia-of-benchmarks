const MAX_INPUT_BYTES: usize = 256
const MAX_TOKEN_BYTES: usize = 45
const MAX_UNIQUE_WORDS: usize = 128
const MAX_OUTPUT_BYTES: usize = 896

struct WordNode:
    word: u8[46]
    word_length: usize
    frequency: u64
    left: i64
    right: i64

fn ascii_alpha(value: i64) -> bool:
    (value >= 65 && value <= 90) || (value >= 97 && value <= 122)

fn word_frequency_bst_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null || length < 1 || length > MAX_INPUT_BYTES + 2: return -1
    n_value: i64 = input[0]
    if n_value < 0 || n_value > 256: return -1
    text_length: usize = n_value.usize()
    if length != text_length + 1: return -1
    i: mutable usize = 0
    while i < text_length:
        if input[i + 1] < 0 || input[i + 1] > 127: return -1
        i <- i + 1

    nodes: mutable WordNode[128] = zeroed
    i <- 0
    while i < MAX_UNIQUE_WORDS:
        nodes[i].left <- -1
        nodes[i].right <- -1
        i <- i + 1
    used: mutable usize = 0
    root: mutable i64 = -1
    token: mutable u8[46] = zeroed
    token_length: mutable usize = 0
    position: mutable usize = 0
    while position <= text_length:
        byte: mutable i64 = -1
        if position < text_length: byte <- input[position + 1]
        if ascii_alpha(byte):
            if token_length >= MAX_TOKEN_BYTES: return -1
            if byte >= 65 && byte <= 90: byte <- byte + 32
            token[token_length] <- byte.u8()
            token_length <- token_length + 1
        else if (byte == 39 || byte == 45) && token_length > 0 && ascii_alpha(token[token_length - 1].i64()):
            if token_length >= MAX_TOKEN_BYTES: return -1
            token[token_length] <- byte.u8()
            token_length <- token_length + 1
        else:
            if token_length > 0:
                if token[token_length - 1] == 45: token_length <- token_length - 1
                if token_length > 0:
                    if root < 0:
                        if used >= MAX_UNIQUE_WORDS: return -1
                        root <- used.i64()
                        i <- 0
                        while i < token_length:
                            nodes[used].word[i] <- token[i]
                            i <- i + 1
                        nodes[used].word[token_length] <- 0
                        nodes[used].word_length <- token_length
                        nodes[used].frequency <- 1
                        used <- used + 1
                    else:
                        current: mutable i64 = root
                        inserted: mutable bool = false
                        while !inserted:
                            common: usize = token_length
                            if nodes[current.usize()].word_length < common: common <- nodes[current.usize()].word_length
                            order: mutable i64 = 0
                            j: mutable usize = 0
                            while j < common && order == 0:
                                if token[j] < nodes[current.usize()].word[j]: order <- -1
                                else if token[j] > nodes[current.usize()].word[j]: order <- 1
                                j <- j + 1
                            if order == 0:
                                if token_length < nodes[current.usize()].word_length: order <- -1
                                else if token_length > nodes[current.usize()].word_length: order <- 1
                            if order == 0:
                                nodes[current.usize()].frequency <- nodes[current.usize()].frequency + 1
                                inserted <- true
                            else:
                                child: i64 = if order < 0: nodes[current.usize()].left else: nodes[current.usize()].right
                                if child < 0:
                                    if used >= MAX_UNIQUE_WORDS: return -1
                                    child <- used.i64()
                                    j <- 0
                                    while j < token_length:
                                        nodes[used].word[j] <- token[j]
                                        j <- j + 1
                                    nodes[used].word[token_length] <- 0
                                    nodes[used].word_length <- token_length
                                    nodes[used].frequency <- 1
                                    nodes[used].left <- -1
                                    nodes[used].right <- -1
                                    used <- used + 1
                                    if order < 0: nodes[current.usize()].left <- child
                                    else: nodes[current.usize()].right <- child
                                    inserted <- true
                                else: current <- child
                token_length <- 0
        position <- position + 1

    result: mutable u8[896] = zeroed
    stack: mutable i64[128] = zeroed
    top: mutable usize = 0
    written: mutable usize = 0
    current: mutable i64 = root
    while current >= 0 || top > 0:
        while current >= 0:
            if top >= MAX_UNIQUE_WORDS: return -1
            stack[top] <- current
            top <- top + 1
            current <- nodes[current.usize()].left
        top <- top - 1
        current <- stack[top]
        i <- 0
        while i < nodes[current.usize()].word_length:
            if written >= MAX_OUTPUT_BYTES: return -1
            result[written] <- nodes[current.usize()].word[i]
            written <- written + 1
            i <- i + 1
        if written + 1 >= MAX_OUTPUT_BYTES: return -1
        result[written] <- 9
        written <- written + 1
        digits: mutable u8[20] = zeroed
        digit_count: mutable usize = 0
        frequency: mutable u64 = nodes[current.usize()].frequency
        repeat:
            digits[digit_count] <- (48 + (frequency % 10)).u8()
            digit_count <- digit_count + 1
            frequency <- frequency / 10
        while frequency > 0
        while digit_count > 0:
            digit_count <- digit_count - 1
            if written >= MAX_OUTPUT_BYTES: return -1
            result[written] <- digits[digit_count]
            written <- written + 1
        if written >= MAX_OUTPUT_BYTES: return -1
        result[written] <- 10
        written <- written + 1
        current <- nodes[current.usize()].right

    if output == null || capacity < written: return -2
    i <- 0
    while i < written:
        output[i] <- result[i]
        i <- i + 1
    written.i64()

export fn word_frequency_bst(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = word_frequency_bst_impl
