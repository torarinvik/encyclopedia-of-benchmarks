const MAX_INTERVALS: usize = 64
const MAX_INPUT_LENGTH: usize = 193

def start_at(input: i64&, index: usize) -> i64:
    input[1 + index * 3]
def end_at(input: i64&, index: usize) -> i64:
    input[2 + index * 3]
def weight_at(input: i64&, index: usize) -> i64:
    input[3 + index * 3]

def store_i64_le(value: i64, output: mutable u8&, offset: usize) -> void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8
def store_i32_le(value: i32, output: mutable u8&, offset: usize) -> void:
    bits: mutable u32 = value.u32()
    for byte in 0..<4:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def weighted_interval_scheduling_impl(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64:
    if input == null or length < 1 or length > MAX_INPUT_LENGTH or input[0] < 0 or input[0] > MAX_INTERVALS.i64():
        return -1
    n: usize = input[0].usize()
    if length != 1 + 3 * n:
        return -1
    for i in 0..<n:
        start: i64 = start_at(input, i)
        finish: i64 = end_at(input, i)
        weight: i64 = weight_at(input, i)
        if start < -100000 or start > 100000 or finish < -100000 or finish > 100000 or start >= finish or weight < 0 or weight > 1000000:
            return -1
    order: mutable usize[64]
    predecessors: mutable usize[64]
    selected: mutable usize[64]
    dp: mutable i64[65] = zeroed
    for i in 0..<n:
        order[i] <- i
    for i in 1..<n:
        key: usize = order[i]
        j: mutable usize = i
        while j > 0 and end_at(input, order[j - 1]) > end_at(input, key):
            order[j] <- order[j - 1]
            j <- j - 1
        order[j] <- key
    for j in 0..<n:
        low: mutable usize = 0
        high: mutable usize = n
        while low < high:
            mid: usize = low + (high - low) / 2
            if end_at(input, order[mid]) <= start_at(input, order[j]):
                low <- mid + 1
            else:
                high <- mid
        predecessors[j] <- low
        include: i64 = weight_at(input, order[j]) + dp[low]
        dp[j + 1] <- if include > dp[j] then include else dp[j]
    selected_count: mutable usize = 0
    current: mutable usize = n
    while current > 0:
        j: usize = current - 1
        include: i64 = weight_at(input, order[j]) + dp[predecessors[j]]
        if include > dp[current - 1]:
            selected[selected_count] <- order[j]
            selected_count <- selected_count + 1
            current <- predecessors[j]
        else:
            current <- current - 1
    for i in 0..<selected_count / 2:
        temp: usize = selected[i]
        selected[i] <- selected[selected_count - 1 - i]
        selected[selected_count - 1 - i] <- temp
    needed: usize = 16 + 4 * selected_count
    if output == null or capacity < needed:
        return -2
    store_i64_le(dp[n], output, 0)
    store_i64_le(selected_count.i64(), output, 8)
    for i in 0..<selected_count:
        store_i32_le(selected[i].i32(), output, 16 + 4 * i)
    needed.i64()

export fn weighted_interval_scheduling(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 = weighted_interval_scheduling_impl
