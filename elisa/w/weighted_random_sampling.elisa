const MAX_N: usize=16
const MAX_INPUT: usize=50

def pow_small(base:i64,exponent:i64)->i64:
    result:mutable i64=1
    i:mutable i64=0
    while i<exponent:
        result<-result*base
        i<-i+1
    result

def before(weights: mutable i64&,nums: mutable i64&,dens: mutable i64&,left:usize,right:usize)->bool:
    lhs:i64=pow_small(nums[left],weights[right])*pow_small(dens[right],weights[left])
    rhs:i64=pow_small(nums[right],weights[left])*pow_small(dens[left],weights[right])
    lhs>rhs or (lhs==rhs and left<right)

def put64(value:i64,output:mutable u8&,pos:usize)->void:
    bits:u64=value.u64()
    j:mutable usize=0
    while j<8:
        output[pos+j]<-((bits>>(8*j))&255).u8()
        j<-j+1

def weighted_random_sampling(input:i64&,length:usize,output:mutable u8&,capacity:usize)->i64 @export("weighted_random_sampling"):
    if input.is_null() or length<5 or length>MAX_INPUT:return -1
    n64:i64=input[0]
    m64:i64=input[1]
    if n64<1 or n64>16 or m64<1 or m64>n64 or length!=2+3*n64.usize():return -1
    n:usize=n64.usize()
    m:usize=m64.usize()
    weights:mutable i64[16]=zeroed
    nums:mutable i64[16]=zeroed
    dens:mutable i64[16]=zeroed
    i:mutable usize=0
    while i<n:
        weights[i]<-input[2+3*i]
        nums[i]<-input[3+3*i]
        dens[i]<-input[4+3*i]
        if weights[i]<1 or weights[i]>3 or nums[i]<1 or nums[i]>=dens[i] or dens[i]>100:return -1
        i<-i+1
    bytes:usize=8*m
    if output.is_null() or capacity<bytes:return -2
    available:mutable i64[16]=zeroed
    chosen:mutable i64[16]=zeroed
    i<-0
    while i<n:
        available[i]<-i.i64()
        i<-i+1
    rank:mutable usize=0
    while rank<m:
        best:mutable usize=0
        i<-1
        while i<n-rank:
            if before(weights&,nums&,dens&,available[i].usize(),available[best].usize()):best<-i
            i<-i+1
        chosen[rank]<-available[best]
        i<-best
        while i+1<n-rank:
            available[i]<-available[i+1]
            i<-i+1
        rank<-rank+1
    rank<-0
    while rank<m:
        put64(chosen[rank],output&,8*rank)
        rank<-rank+1
    bytes.i64()
