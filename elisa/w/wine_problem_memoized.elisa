const MAX_ITEMS: usize = 64
const MAX_PRICE: i64 = 1000000

def wine_problem_memoized_solve(prices: view[i64], count: usize, first: usize, last: usize,
                                memo: mutable view[i64]) -> i64:
    slot: usize = first * MAX_ITEMS + last
    year: i64 = (count - (last - first + 1) + 1).i64()
    if first == last:
        memo[slot] <- prices[first] * year
        return memo[slot]
    if memo[slot] != 0: return memo[slot]
    sell_first: i64 = prices[first] * year + wine_problem_memoized_solve(prices, count, first + 1, last, memo)
    sell_last: i64 = prices[last] * year + wine_problem_memoized_solve(prices, count, first, last - 1, memo)
    if sell_first > sell_last: memo[slot] <- sell_first
    else: memo[slot] <- sell_last
    return memo[slot]

def wine_problem_memoized_impl(prices: i64&, length: usize) -> i64:
    if prices.is_null() or length == 0 or length > MAX_ITEMS: return -1
    index: mutable usize = 0
    while index < length:
        if prices[index] < 1 or prices[index] > MAX_PRICE: return -1
        index <- index + 1
    memo: mutable i64[MAX_ITEMS * MAX_ITEMS] = zeroed
    wine_problem_memoized_solve(prices[0:length], length, 0, length - 1,
            memo[0:MAX_ITEMS * MAX_ITEMS])

export fn wine_problem_memoized(prices: i64&, length: usize) -> i64 = wine_problem_memoized_impl
