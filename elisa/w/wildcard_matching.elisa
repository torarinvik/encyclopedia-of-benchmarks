# Full-string wildcard matching for lowercase ASCII text.
def wildcard_matching_impl(input: i64&, length: usize) -> i64:
    if length < 2 or length > 35:
        return -1
    text_length_value: i64 = input[0]
    pattern_length_value: i64 = input[1]
    if text_length_value < 0 or text_length_value > 12 or pattern_length_value < 0 or pattern_length_value > 20:
        return -1
    text_length: usize = text_length_value.usize()
    pattern_length: usize = pattern_length_value.usize()
    if length != 2 + text_length + pattern_length:
        return -1
    text_valid: bool =
        while index < text_length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            code: i64 = input[2 + index]
            if code < 97 or code > 122:
                break false
            index <- index + 1
    if not text_valid:
        return -1
    pattern_start: usize = 2 + text_length
    pattern_valid: bool =
        while index < pattern_length |index: mutable usize = 0, valid: mutable bool = true| -> valid:
            token: i64 = input[pattern_start + index]
            if not ((token >= 97 and token <= 122) or token == 42 or token == 63):
                break false
            index <- index + 1
    if not pattern_valid:
        return -1

    initial: mutable bool[273] = zeroed
    initial[0] <- true
    initial <- while column < pattern_length |column: mutable usize = 0, state: mutable bool[273] = initial| -> state:
        column <- column + 1
        if input[pattern_start + column - 1] == 42:
            state[column] <- state[column - 1]
    result: bool[273] =
        while row < text_length |row: mutable usize = 0, state: mutable bool[273] = initial| -> state:
            row <- row + 1
            state <- while column < pattern_length |column: mutable usize = 0, inner: mutable bool[273] = state| -> inner:
                column <- column + 1
                token: i64 = input[pattern_start + column - 1]
                cell: usize = row * 21 + column
                if token == input[1 + row] or token == 63:
                    inner[cell] <- inner[cell - 22]
                else:
                    if token == 42:
                        inner[cell] <- inner[cell - 21] or inner[cell - 1]
    if result[text_length * 21 + pattern_length]:
        return 1
    0

export fn wildcard_matching(input: i64&, length: usize) -> i64 = wildcard_matching_impl
