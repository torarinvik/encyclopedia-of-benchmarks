const MAX_N: usize = 6
const MAX_INPUT: usize = 73
const MAX_OUTPUT_BYTES: usize = 104

def wsmt_store(output: mutable u8&, offset: usize, value: i64): void:
    bits: mutable u64 = value.u64()
    for byte in 0..<8:
        output[offset + byte] <- (bits & 255).u8()
        bits <- bits >> 8

def weak_stable_matching_ties_incomplete_impl(input: i64&, length: usize,
        output: mutable u8&, capacity: usize): i64:
    if input.is_null() or length < 1 or length > MAX_INPUT: return -1
    n_raw: i64 = input[0]
    if n_raw < 1 or n_raw > MAX_N.i64(): return -1
    n: usize = n_raw.usize()
    side_size: usize = n * n
    if length != 1 + 2 * side_size: return -1
    men_rank: mutable i64[MAX_N][MAX_N] = zeroed
    women_rank: mutable i64[MAX_N][MAX_N] = zeroed
    choices: mutable usize[MAX_N][MAX_N] = zeroed
    choice_count: mutable usize[MAX_N] = zeroed
    for man in 0..<n:
        for woman in 0..<n:
            rank: i64 = input[1 + man * n + woman]
            if rank < 0 or rank > n_raw: return -1
            men_rank[man][woman] <- rank
    for woman in 0..<n:
        for man in 0..<n:
            rank: i64 = input[1 + side_size + woman * n + man]
            if rank < 0 or rank > n_raw or ((rank > 0) != (men_rank[man][woman] > 0)): return -1
            women_rank[woman][man] <- rank
    for man in 0..<n:
        for woman in 0..<n:
            if men_rank[man][woman] == 0: continue
            at: mutable usize = choice_count[man]
            while at > 0:
                prior: usize = choices[man][at - 1]
                if men_rank[man][prior] < men_rank[man][woman] or (men_rank[man][prior] == men_rank[man][woman] and prior < woman): break
                choices[man][at] <- prior
                at <- at - 1
            choices[man][at] <- woman
            choice_count[man] <- choice_count[man] + 1
    man_partner: mutable i64[MAX_N] = zeroed
    woman_partner: mutable i64[MAX_N] = zeroed
    next_choice: mutable usize[MAX_N] = zeroed
    for i in 0..<n:
        man_partner[i] <- -1
        woman_partner[i] <- -1
    while true:
        man: mutable usize = MAX_N
        for candidate in 0..<n:
            if man_partner[candidate] < 0 and next_choice[candidate] < choice_count[candidate]:
                man <- candidate
                break
        if man == MAX_N: break
        woman: usize = choices[man][next_choice[man]]
        next_choice[man] <- next_choice[man] + 1
        incumbent: i64 = woman_partner[woman]
        if incumbent < 0 or women_rank[woman][man] < women_rank[woman][incumbent.usize()] or
                (women_rank[woman][man] == women_rank[woman][incumbent.usize()] and man.i64() < incumbent):
            woman_partner[woman] <- man.i64()
            man_partner[man] <- woman.i64()
            if incumbent >= 0: man_partner[incumbent.usize()] <- -1
    words: mutable i64[1 + 2 * MAX_N] = zeroed
    pairs: mutable usize = 0
    for man in 0..<n:
        if man_partner[man] >= 0:
            words[1 + 2 * pairs] <- man.i64()
            words[2 + 2 * pairs] <- man_partner[man]
            pairs <- pairs + 1
    words[0] <- pairs.i64()
    output_bytes: usize = 8 * (1 + 2 * pairs)
    if output.is_null() or capacity < output_bytes: return -2
    staged: mutable u8[MAX_OUTPUT_BYTES] = zeroed
    for word in 0..<(1 + 2 * pairs): wsmt_store(staged&, 8 * word, words[word])
    for byte in 0..<output_bytes: output[byte] <- staged[byte]
    output_bytes.i64()

export fn weak_stable_matching_ties_incomplete(input: i64&, length: usize,
        output: mutable u8&, capacity: usize): i64 = weak_stable_matching_ties_incomplete_impl
