const MAX_LENGTH: usize = 100000
const MAX_VALUE: u64 = 100000

def ways_to_split_array_impl(values: i64&, length: usize) -> i64:
    if length < 2 or length > MAX_LENGTH:
        return -1

    # Unsigned sums wrap. Valid inputs keep their signed interpretations within ±10^10.
    total: mutable u64 = 0
    largest_biased_value: mutable u64 = 0
    index: mutable usize = 0
    while index < length:
        value: u64 = values[index].u64()
        biased: u64 = value + MAX_VALUE
        largest_biased_value <- biased if biased > largest_biased_value else largest_biased_value
        total <- total + value
        index <- index + 1

    if largest_biased_value > 2 * MAX_VALUE:
        return -1

    # A split qualifies exactly when its prefix reaches the ceiling of half the total.
    threshold: i64 = ((total + 1).i64() >> 1)
    prefix: mutable u64 = 0
    ways: mutable u64 = 0
    index <- 0
    while index < length - 1:
        prefix <- prefix + values[index].u64()
        ways <- ways + (1 if prefix.i64() >= threshold else 0)
        index <- index + 1
    ways.i64()

export fn ways_to_split_array(values: i64&, length: usize) -> i64 = ways_to_split_array_impl
