// Clean-room exact bounded minimum weighted connected dominating set.
const MAX_N: usize = 16
def weighted_connected_dominating_set(input: i64&, length: usize, output: mutable u8&, capacity: usize) -> i64 @export("weighted_connected_dominating_set"):
    if input.is_null() or length < 3 or length > 33 or input[0] < 1 or input[0] > MAX_N.i64(): return -1
    n: usize = input[0].usize()
    if length != 1+2*n: return -1
    all: u64 = (1.u64() << n)-1
    adjacency: mutable u64[MAX_N] = zeroed
    i: mutable usize = 0
    while i < n:
        mask: i64 = input[1+i]
        weight: i64 = input[1+n+i]
        if mask < 0 or mask.u64() > all or (mask.u64() & (1.u64() << i)) != 0 or weight < 1 or weight > 1000: return -1
        adjacency[i] <- mask.u64()
        i <- i+1
    i <- 0
    while i < n:
        j: mutable usize = 0
        while j < n:
            if ((adjacency[i] >> j) & 1) != ((adjacency[j] >> i) & 1): return -1
            j <- j+1
        i <- i+1
    best_cost: mutable i64 = -1
    best_mask: mutable u64 = 0
    subset: mutable u64 = 1
    while subset <= all:
        dominated: mutable u64 = subset
        cost: mutable i64 = 0
        i <- 0
        while i < n:
            if ((subset >> i) & 1) != 0:
                dominated <- dominated | adjacency[i]
                cost <- cost + input[1+n+i]
            i <- i+1
        if dominated == all:
            seen: mutable u64 = 0
            i <- 0
            while i < n:
                if ((subset >> i) & 1) != 0: seen <- 1.u64() << i; break
                i <- i+1
            while true:
                previous: u64 = seen
                i <- 0
                while i < n:
                    if ((seen >> i) & 1) != 0: seen <- seen | (adjacency[i] & subset)
                    i <- i+1
                if previous == seen: break
            if seen == subset and (best_cost < 0 or cost < best_cost or (cost == best_cost and subset < best_mask)):
                best_cost <- cost
                best_mask <- subset
        subset <- subset+1
    if output.is_null() or capacity < 16: return -2
    bits: u64 = best_cost.u64()
    i <- 0
    while i < 8: output[i] <- ((bits>>(8*i))&255).u8(); i <- i+1
    bits <- best_mask
    i <- 0
    while i < 8: output[8+i] <- ((bits>>(8*i))&255).u8(); i <- i+1
    16
