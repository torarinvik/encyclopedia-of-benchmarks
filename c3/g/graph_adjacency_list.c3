module graph_adjacency_list;
fn void put(long value, char* out, usz word) { ulong bits = (ulong)value; for (usz b=0;b<8;b++){out[word*8+b]=(char)(bits&255);bits>>=8;} }
fn int findv(int* order, int n, int v) { for(int i=0;i<n;i++) if(order[i]==v)return i; return -1; }
fn int findn(int* rows, int* deg, int u, int v) { for(int i=0;i<deg[u];i++)if(rows[u*34+i]==v)return i;return -1; }
fn void deln(int* rows, int* deg, int u, int at) { for(int i=at;i+1<deg[u];i++)rows[u*34+i]=rows[u*34+i+1];deg[u]--; }
fn long graph_adjacency_list(long* in, usz len, char* out, usz cap) @export("graph_adjacency_list") {
 if(in==null||len<4)return -1;long d=in[0];long nn=in[1];if((d!=0&&d!=1)||nn<0||nn>32||len<(usz)(4+nn))return -1;int n=(int)nn;int dir=(int)d;int[32] order;int[1088] rows;int[32] deg;usz k=2;
 for(int i=0;i<n;i++){long v=in[k++];if(v<0||v>=32)return -1;for(int j=0;j<i;j++)if(order[j]==(int)v)return -1;order[i]=(int)v;}
 long ec=in[k++];if(ec<0||ec>1024||len<k+2*(usz)ec+1)return -1;for(long i=0;i<ec;i++){long aa=in[k++];long bb=in[k++];if(aa<0||aa>=32||bb<0||bb>=32)return -1;int a=(int)aa;int b=(int)bb;if(findv(&order[0],n,a)<0||findv(&order[0],n,b)<0||findn(&rows[0],&deg[0],a,b)>=0)return -1;rows[a*34+deg[a]++]=b;if(dir==0)rows[b*34+deg[b]++]=a;}
 long oo=in[k++];if(oo<0||oo>64||len!=k+3*(usz)oo)return -1;int ops=(int)oo;int[64] res;
 for(int z=0;z<ops;z++){long op=in[k++];long aa=in[k++];long bb=in[k++];if(op==0){if(aa<0||aa>=32||bb!=0||findv(&order[0],n,(int)aa)>=0||n>=32)return -1;order[n++]=(int)aa;deg[(int)aa]=0;res[z]=1;}else if(op==1){if(aa<0||aa>=32||bb!=0)return -1;int at=findv(&order[0],n,(int)aa);if(at<0)return -1;if(dir==1){for(int u=0;u<n;u++){int x;while((x=findn(&rows[0],&deg[0],order[u],(int)aa))>=0)deln(&rows[0],&deg[0],order[u],x);}}else{int u=(int)aa;while(deg[u]>0){int v=rows[u*34+deg[u]-1];deg[u]--;if(v!=u){int x=findn(&rows[0],&deg[0],v,u);if(x>=0)deln(&rows[0],&deg[0],v,x);}}}for(int j=at;j+1<n;j++)order[j]=order[j+1];deg[(int)aa]=0;n--;res[z]=1;}else if(op==2||op==3||op==5){if(aa<0||aa>=32||bb<0||bb>=32)return -1;int a=(int)aa;int b=(int)bb;if(findv(&order[0],n,a)<0||findv(&order[0],n,b)<0)return -1;int x=findn(&rows[0],&deg[0],a,b);if(op==5){res[z]=(x>=0)?1:0;}else if(op==2){if(x>=0||deg[a]>=34||(dir==0&&deg[b]>=34))return -1;rows[a*34+deg[a]++]=b;if(dir==0)rows[b*34+deg[b]++]=a;res[z]=1;}else{if(x<0)return -1;deln(&rows[0],&deg[0],a,x);if(dir==0){int y=findn(&rows[0],&deg[0],b,a);if(y<0)return -1;deln(&rows[0],&deg[0],b,y);}res[z]=1;}}else if(op==4){if(aa<0||aa>=32||bb!=0)return -1;res[z]=(findv(&order[0],n,(int)aa)>=0)?1:0;}else if(op==6){if(aa!=0||bb!=0)return -1;n=0;for(int u=0;u<32;u++)deg[u]=0;res[z]=1;}else {return -1;}}
 usz words=2+(usz)ops;for(int i=0;i<n;i++)words+=2+(usz)deg[order[i]];if(out==null||cap<words*8)return -2;usz w=0;put(oo,out,w++);for(int i=0;i<ops;i++)put((long)res[i],out,w++);put((long)n,out,w++);for(int i=0;i<n;i++){int u=order[i];put((long)u,out,w++);put((long)deg[u],out,w++);for(int j=0;j<deg[u];j++)put((long)rows[u*34+j],out,w++);}return (long)(words*8);
}
