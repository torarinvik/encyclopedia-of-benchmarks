module gauss_jordan;
fn void put(uint8 *o,usz p,double x){ulong bits=@bitcast(ulong,x);for(usz k=0;k<8;k++)o[p+k]=(uint8)(bits>>(8*k));}
fn double absd(double x){return x<0?-x:x;}
fn long gauss_jordan(long *v,usz n,uint8 *out,usz cap) @export("gauss_jordan"){if(v==null||n<2||n>22)return -1;long r=v[0],c=v[1];if(r<1||r>4||c<1||c>4||n!=2+(usz)(r*c+r))return -1;double a[4][4]={{0}},b[4]={0};for(long i=0;i<r;i++)for(long j=0;j<c;j++){long z=v[2+i*c+j];if(z < -5000||z>5000)return -1;a[i][j]=(double)z/1000.0;}for(long i=0;i<r;i++){long z=v[2+r*c+i];if(z < -5000||z>5000)return -1;b[i]=(double)z/1000.0;}usz count=(usz)(r*c+r),bytes=count*8;if(out==null||cap<bytes)return -2;for(long col=0;col<c;col++){long pivot=-1;for(long row=col;row<r;row++)if(absd(a[row][col])>1e-8){pivot=row;break;}if(pivot<0)continue;if(pivot!=col){for(long j=0;j<c;j++){double t=a[col][j];a[col][j]=a[pivot][j];a[pivot][j]=t;}double t=b[col];b[col]=b[pivot];b[pivot]=t;}double pv=a[col][col];for(long j=0;j<c;j++)a[col][j]/=pv;b[col]/=pv;for(long row=0;row<r;row++){if(row==col)continue;double f=a[row][col];for(long j=0;j<c;j++)a[row][j]-=f*a[col][j];b[row]-=f*b[col];}}usz at=0;for(long i=0;i<r;i++)for(long j=0;j<c;j++)put(out,at++*8,a[i][j]);for(long i=0;i<r;i++)put(out,at++*8,b[i]);return (long)bytes;}
