module gram_schmidt;
fn void put_f64(char *o,usz p,double x){ulong u=bitcast(x,ulong);for(usz i=0;i<8;i++)o[p+i]=(char)(u>>(8*i));}
fn long gram_schmidt(long *v,usz n,char *out,usz cap) @export("gram_schmidt"){if(v==null||n<2||n>18)return -1;long r=v[0];long d=v[1];if(r<1||r>4||d<r||d>4||n!=2+(usz)(r*d))return -1;double[4][4] a={};double[4][4] q={};for(long i=0;i<r;i++)for(long j=0;j<d;j++){long z=v[2+i*d+j];if(z < -1000||z>1000||(j<i&&z!=0)||(j==i&&(z<100||z>1000)))return -1;a[i][j]=(double)z/1000.0;}usz bytes=(usz)(r*d)*8;if(out==null||cap<bytes)return -2;for(long k=0;k<r;k++){double[4] p={};for(long i=0;i<k;i++){double dot=0;double norm=0;for(long j=0;j<d;j++){dot+=a[k][j]*q[i][j];norm+=q[i][j]*q[i][j];}double f=dot/norm;for(long j=0;j<d;j++)p[j]+=q[i][j]*f;}for(long j=0;j<d;j++)q[k][j]=a[k][j]-p[j];}for(long i=0;i<r;i++)for(long j=0;j<d;j++)put_f64(out,(usz)(i*d+j)*8,q[i][j]);return (long)bytes;}
