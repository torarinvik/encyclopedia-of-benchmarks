module general_graph_maximum_matching;
fn void put_i64(char*o,long x){ulong b=(ulong)x;for(usz i=0;i<8;i++)o[i]=(char)(b>>(8*i));}
fn int lca(int n,int*match,int*parent,int*base,int a,int b){bool[12] seen=zeroed;while(true){a=base[a];seen[a]=true;if(match[a]<0)break;a=parent[match[a]];}while(true){b=base[b];if(seen[b])return b;b=parent[match[b]];}}
fn void mark_path(int*match,int*parent,int*base,bool*blossom,int v,int b,int child){while(base[v]!=b){blossom[base[v]]=true;blossom[base[match[v]]]=true;parent[v]=child;child=match[v];v=parent[match[v]];}}
fn bool find_path(int n,bool*adj,int*match,int*parent,int*base,int root){bool[12] used=zeroed;int[12] queue=zeroed;int head=0,tail=0;for(int i=0;i<n;i++){parent[i]=-1;base[i]=i;}queue[tail++]=root;used[root]=true;while(head<tail){int v=queue[head++];for(int u=0;u<n;u++){if(!adj[v*12+u]||base[v]==base[u]||match[v]==u)continue;if(u==root||(match[u]>=0&&parent[match[u]]>=0)){int cur=lca(n,match,parent,base,v,u);bool[12] blossom=zeroed;mark_path(match,parent,base,&blossom[0],v,cur,u);mark_path(match,parent,base,&blossom[0],u,cur,v);for(int i=0;i<n;i++)if(blossom[base[i]]){base[i]=cur;if(!used[i]){used[i]=true;queue[tail++]=i;}}}else if(parent[u]<0){parent[u]=v;if(match[u]<0){int x=u;while(x>=0){int pv=parent[x],next=pv>=0?match[pv]:-1;if(pv>=0){match[x]=pv;match[pv]=x;}x=next;}return true;}int mate=match[u];used[mate]=true;queue[tail++]=mate;}}}return false;}
long general_graph_maximum_matching(long*input,usz length,char*output,usz capacity) @export("general_graph_maximum_matching"){
 if(input==null||length<2||length>134)return -1;long n0=input[0],m0=input[1];if(n0<2||n0>12||m0<0||m0>n0*(n0-1)/2||length!=2+2*(usz)m0)return -1;int n=(int)n0,m=(int)m0;bool[144] adj=zeroed;
 for(int e=0;e<m;e++){long u0=input[2+2*e],v0=input[3+2*e];if(u0<0||v0<=u0||v0>=n0)return -1;int u=(int)u0,v=(int)v0;if(adj[u*12+v])return -1;adj[u*12+v]=true;adj[v*12+u]=true;}
 int[12] match,parent,base;for(int i=0;i<n;i++)match[i]=-1;for(int i=0;i<n;i++)if(match[i]<0)find_path(n,&adj[0],&match[0],&parent[0],&base[0],i);long count=0;for(int i=0;i<n;i++)if(match[i]>i)count++;if(output==null||capacity<8)return -2;put_i64(output,count);return 8;
}
