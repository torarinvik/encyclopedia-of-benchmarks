module gaussian_elimination_pivoting;
fn void put(uint8 *o,usz p,double x){ulong b=@bitcast(ulong,x);for(usz k=0;k<8;k++)o[p+k]=(uint8)(b>>(8*k));}
fn double absd(double x){return x<0?-x:x;}
fn long gaussian_elimination_pivoting(long *v,usz n,uint8 *out,usz cap) @export("gaussian_elimination_pivoting"){if(v==null||n<1||n>21)return -1;long d=v[0];if(d<2||d>4||n!=1+(usz)(d*(d+1)))return -1;double a[4][5]={{0}};for(long i=0;i<d;i++)for(long j=0;j<=d;j++){long z=v[1+i*(d+1)+j];if(z < -10000||z>10000)return -1;a[i][j]=(double)z/1000.0;}usz bytes=(usz)d*8;for(long col=0;col<d;col++){for(long i=col;i<d;i++)if(absd(a[i][col])>absd(a[col][col]))for(long j=0;j<=d;j++){double t=a[col][j];a[col][j]=a[i][j];a[i][j]=t;}if(absd(a[col][col])<1e-8)return -1;if(col!=0){long prior=col-1;for(long i=col;i<d;i++){double f=a[i][prior]/a[prior][prior];for(long j=0;j<=d;j++)a[i][j]-=f*a[prior][j];}}}double x[4]={0};for(long col=d;col-->0;){x[col]=a[col][d]/a[col][col];for(long i=col;i-->0;)a[i][d]-=a[i][col]*x[col];}if(out==null||cap<bytes)return -2;for(long i=0;i<d;i++)put(out,(usz)i*8,x[i]);return (long)bytes;}
