module stack_tracking_min_max;
fn void put64(char*out,usz*pos,long x){ulong b=(ulong)x;for(usz j=0;j<8;j++){out[*pos]=(char)(b&255);*pos+=1;b>>=8;}}
fn long stack_tracking_min_max(long*input,usz length,char*output,usz capacity) @export("stack_tracking_min_max") {if(input==null||length<2||length>130)return -1;long max_size=input[0],op_count=input[1];if(max_size<0||max_size>64||op_count<0||op_count>64)return -1;usz p=2;for(long i=0;i<op_count;i++){if(p>=length)return -1;long op=input[p++];if(op==1){if(p>=length||input[p]< -2147483648||input[p]>2147483647)return -1;p++;}else if(op<2||op>5)return -1;}if(p!=length)return -1;long vals[64],mins[64],maxs[64],records[64][3];usz top=0,rc=0;p=2;for(long i=0;i<op_count;i++){long op=input[p++],tag=0,result=0;if(op==1){long x=input[p++];if(top==(usz)max_size){records[rc][0]=1;records[rc][1]=4;records[rc][2]=1;rc++;break;}vals[top]=x;mins[top]=top? (mins[top-1]<x?mins[top-1]:x):x;maxs[top]=top?(maxs[top-1]>x?maxs[top-1]:x):x;top++;tag=1;result=1;}else if(op==2){if(top)result=vals[--top];else tag=3;}else if(op==3){if(top)result=mins[top-1];else tag=3;}else if(op==4){if(top)result=maxs[top-1];else tag=3;}else{tag=1;result=top?1:0;}records[rc][0]=op;records[rc][1]=tag;records[rc][2]=result;rc++;}usz need=rc*24;if(output==null||capacity<need)return -2;usz pos=0;for(usz i=0;i<rc;i++)for(usz j=0;j<3;j++)put64(output,&pos,records[i][j]);return (long)pos;}
