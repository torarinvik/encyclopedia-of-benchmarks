module shortest_word_distance;
const usz MAX_WORDS=32;const usz MAX_WORD_LEN=8;const usz MAX_INPUT=307;
fn bool eq(long* v,usz s,usz n,usz t,usz m){if(n!=m)return false;for(usz i=0;i<n;i++)if(v[s+i]!=v[t+i])return false;return true;}
fn long shortest_word_distance(long* v,usz length) @export("shortest_word_distance"){if(v==null||length<1||length>MAX_INPUT+1||v[0]<2||v[0]>32)return -1;usz n=(usz)v[0];usz[32] starts;usz[32] sizes;usz p=1;for(usz i=0;i<n;i++){if(p>=length)return -1;long z=v[p++];if(z<1||z>8||p+(usz)z>length)return -1;starts[i]=p;sizes[i]=(usz)z;for(usz j=0;j<(usz)z;j++)if(!((v[p+j]>=65&&v[p+j]<=90)||(v[p+j]>=97&&v[p+j]<=122)))return -1;p+=(usz)z;}usz[2] ts;usz[2] tn;for(usz t=0;t<2;t++){if(p>=length)return -1;long z=v[p++];if(z<1||z>8||p+(usz)z>length)return -1;ts[t]=p;tn[t]=(usz)z;for(usz j=0;j<(usz)z;j++)if(!((v[p+j]>=65&&v[p+j]<=90)||(v[p+j]>=97&&v[p+j]<=122)))return -1;p+=(usz)z;}if(p!=length||eq(v,ts[0],tn[0],ts[1],tn[1]))return -1;bool h0=false,h1=false;usz best=n;for(usz i=0;i<n;i++){bool a=eq(v,starts[i],sizes[i],ts[0],tn[0]),b=eq(v,starts[i],sizes[i],ts[1],tn[1]);h0|=a;h1|=b;for(usz j=0;j<n;j++){bool c=eq(v,starts[j],sizes[j],ts[0],tn[0]),d=eq(v,starts[j],sizes[j],ts[1],tn[1]);if((a&&d)||(b&&c)){usz delta=i>j?i-j:j-i;if(delta<best)best=delta;}}}return h0&&h1?(long)best:-1;}
