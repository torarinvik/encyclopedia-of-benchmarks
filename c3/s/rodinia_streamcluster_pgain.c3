module rodinia_streamcluster_pgain;
fn void put64(uint8* out, usz i, long x){ulong u=(ulong)x;for(usz b=0;b<8;b++)out[i*8+b]=(uint8)(u>>(b*8));}
fn long rodinia_streamcluster_pgain(long* v,usz n,uint8* out,usz cap) @export("rodinia_streamcluster_pgain") {
 if(v==null||n<5||n>53)return -1;long pn=v[0],dd=v[1],xx=v[2],z=v[3],mask=v[4];if(pn<2||pn>8||dd<1||dd>3||n!=5+(usz)pn*(3+(usz)dd)||xx<0||xx>=pn||z<1||z>64||mask<=0||(ulong)mask>=(1ul<<(uint)pn)||(mask&(1l<<xx))!=0)return -1;
 usz p=(usz)pn,d=(usz)dd,x=(usz)xx,q=5;usz a[8]={},w[8]={};long cost[8]={};int pt[8][3]={{0}};for(usz i=0;i<p;i++){if(v[q]<0||v[q]>=pn)return -1;a[i]=(usz)v[q++];if((mask&(1l<<a[i]))==0)return -1;}for(usz i=0;i<p;i++){if(v[q]<1||v[q]>4)return -1;w[i]=(usz)v[q++];}for(usz i=0;i<p;i++)cost[i]=v[q++];for(usz i=0;i<p;i++)for(usz k=0;k<d;k++){if(v[q]<-8||v[q]>8)return -1;pt[i][k]=(int)v[q++];}
 for(usz i=0;i<p;i++){long ds=0;for(usz k=0;k<d;k++){long t=pt[i][k]-pt[a[i]][k];ds+=t*t;}if(cost[i]!=(long)w[i]*ds||((mask&(1l<<i))!=0&&(a[i]!=i||cost[i]!=0)))return -1;}
 bool sw[8]={},cl[8]={};long low[8]={},opening=z;for(usz i=0;i<p;i++){long ds=0;for(usz k=0;k<d;k++){long t=pt[i][k]-pt[x][k];ds+=t*t;}long xc=(long)w[i]*ds;if(xc<cost[i]){sw[i]=true;opening+=xc-cost[i];}else low[a[i]]+=cost[i]-xc;}for(usz j=0;j<p;j++)if((mask&(1l<<j))!=0){long lo=z+low[j];if(lo>0){cl[j]=true;opening-=lo;}}
 bool yes=opening<0;long om=mask,oa[8]={},oc[8]={};for(usz i=0;i<p;i++){oa[i]=(long)a[i];oc[i]=cost[i];}if(yes){for(usz i=0;i<p;i++)if(sw[i]||cl[a[i]]){long ds=0;for(usz k=0;k<d;k++){long t=pt[i][k]-pt[x][k];ds+=t*t;}oa[i]=(long)x;oc[i]=(long)w[i]*ds;}for(usz j=0;j<p;j++)if(cl[j])om&=~(1l<<j);om|=1l<<x;}long count=0,obj=0;for(usz j=0;j<p;j++)if((om&(1l<<j))!=0)count++;obj=count*z;for(usz i=0;i<p;i++)obj+=oc[i];if(out==null||cap<8*(5+2*p))return -2;long r[21]={};r[0]=yes?1:0;r[1]=yes?-opening:0;r[2]=count;r[3]=om;r[4]=obj;for(usz i=0;i<p;i++){r[5+i]=oa[i];r[5+p+i]=oc[i];}for(usz i=0;i<5+2*p;i++)put64(out,i,r[i]);return (long)(5+2*p);
}
