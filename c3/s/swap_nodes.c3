module swap_nodes;
fn void put64(char* out,usz* pos,long x){ulong v=(ulong)x;for(usz j=0;j<8;j++){out[*pos]=(char)(v&255);*pos+=1;v>>=8;}}
fn long swap_nodes(long* input,usz length,char* output,usz capacity) @export("swap_nodes") {if(input==null||length<3)return -1;long n0=input[0];if(n0<0||n0>64||length!=(usz)n0+3)return -1;usz n=(usz)n0;for(usz i=0;i<n;i++)if(input[1+i]< -2147483648||input[1+i]>2147483647)return -1;long a=input[1+n],b=input[2+n];if(a< -2147483648||a>2147483647||b< -2147483648||b>2147483647)return -1;usz need=8+8*n;if(output==null||capacity<need)return -2;usz ia=n,ib=n;if(a!=b)for(usz i=0;i<n;i++){if(ia==n&&input[1+i]==a)ia=i;if(ib==n&&input[1+i]==b)ib=i;}usz pos=0;put64(output,&pos,n0);for(usz i=0;i<n;i++){long x=input[1+i];if(ia<n&&ib<n){if(i==ia)x=b;else if(i==ib)x=a;}put64(output,&pos,x);}return (long)pos;}
