module phonetic_alphabet_converter;
extern fn ulong strlen(char* s);
char*[36] words={"Alpha","Bravo","Charlie","Delta","Echo","Foxtrot","Golf","Hotel","India","Juliett","Kilo","Lima","Mike","November","Oscar","Papa","Quebec","Romeo","Sierra","Tango","Uniform","Victor","Whiskey","X-ray","Yankee","Zulu","Zero","One","Two","Three","Four","Five","Six","Seven","Eight","Nine"};
fn long phonetic_alphabet_converter(long* v, ulong n, u8* out, ulong cap) @export("phonetic_alphabet_converter") {if(v==null||n<1||n>65||v[0]<0||v[0]>64||n!=(ulong)v[0]+1)return -1;if(out==null||cap<576)return -2;ulong at=0;bool emitted=false;for(ulong i=0;i<(ulong)v[0];i++){long z=v[i+1];if(!((z==9||z==10||z==11||z==12||z==13||z==32)||(z>=33&&z<=126)))return -1;int c=(int)z;if(c==9||c==10||c==11||c==12||c==13||c==32)continue;if(c>=97&&c<=122)c-=32;if(emitted){out[at]=32;at++;}emitted=true;char*w=null;if(c>=65&&c<=90)w=words[c-65];else if(c>=48&&c<=57)w=words[26+c-48];if(w!=null){ulong m=strlen(w);for(ulong j=0;j<m;j++)out[at+j]=(u8)w[j];at+=m;}else{out[at]=(u8)c;at++;}}return (long)at;}
