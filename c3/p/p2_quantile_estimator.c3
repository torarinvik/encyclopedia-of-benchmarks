module p2_quantile_estimator;
fn sort5(double* q, ulong n){for(ulong i=1;i<n;i++){double x=q[i];ulong j=i;while(j>0&&q[j-1]>x){q[j]=q[j-1];j--;}q[j]=x;}}
fn double p2_quantile_estimator(long* v, ulong n) @export("p2_quantile_estimator"){if(v==null||n<2||n>65||v[0]<1||v[0]>64||n!=(ulong)v[0]+1)return -1e300;ulong count=(ulong)v[0];double q[5],p[5],d[5],inc[5]={0,.25,.5,.75,1};ulong seen=0;for(ulong z=0;z<count;z++){if(v[z+1]<-2147483648||v[z+1]>2147483647)return -1e300;double x=(double)v[z+1];if(seen<5){q[seen++]=x;if(seen==5){sort5(q,5);for(ulong i=0;i<5;i++){p[i]=(double)(i+1);d[i]=(double)(i+1);}}continue;}ulong k;if(x<q[0]){q[0]=x;k=0;}else{k=3;for(ulong i=1;i<4;i++)if(x<q[i]){k=i-1;break;}if(x>q[4])q[4]=x;}for(ulong i=k+1;i<5;i++)p[i]+=1;for(ulong i=0;i<5;i++)d[i]+=inc[i];for(ulong i=1;i<4;i++){double drift=d[i]-p[i];bool sr=drift>=1&&p[i+1]-p[i]>1,sl=drift<=-1&&p[i-1]-p[i]<-1;if(!sr&&!sl)continue;double dir=sr?1:-1,l=p[i]-p[i-1],r=p[i+1]-p[i];double cand=q[i]+dir/(l+r)*((l+dir)*(q[i+1]-q[i])/r+(r-dir)*(q[i]-q[i-1])/l);if(q[i-1]<cand&&cand<q[i+1])q[i]=cand;else{ulong nb=(ulong)((long)i+(long)dir);q[i]+=dir*(q[nb]-q[i])/(p[nb]-p[i]);}p[i]+=dir;}}if(seen<5){sort5(q,count);double rank=.5*(double)(count-1);ulong lo=(ulong)rank,hi=lo+1<count?lo+1:lo;return q[lo]+(rank-(double)lo)*(q[hi]-q[lo]);}return q[2];}
