module persistent_range_affine_range_sum;
const long MOD = 998244353; const usz MAX_Q = 16; const usz CAP = 4096;
struct Node { long sum; long mul; long add; int left; int right; }
fn long norm(long x) { x %= MOD; return x < 0 ? x + MOD : x; }
fn int clone(Node[CAP]* a, usz* used, int s) { if(s<0||*used>=CAP)return -1;int d=(int)*used;(*a)[*used]=(*a)[(usz)s];*used+=1;return d; }
fn int make(Node[CAP]* a, usz* used,long sum,int l,int r){if(*used>=CAP)return -1;int d=(int)*used;(*a)[*used]={sum,1,0,l,r};*used+=1;return d;}
fn void apply(Node[CAP]* a,int x,long m,long b,usz len){m=norm(m);b=norm(b);(*a)[(usz)x].sum=norm(m*(*a)[(usz)x].sum+b*(long)len);(*a)[(usz)x].mul=norm(m*(*a)[(usz)x].mul);(*a)[(usz)x].add=norm(m*(*a)[(usz)x].add+b);}
fn bool push(Node[CAP]* a,usz* used,int x,usz l,usz r){long m=(*a)[(usz)x].mul,b=(*a)[(usz)x].add;if(m==1&&b==0)return true;if(l<r){usz mid=l+(r-l)/2;int lc=clone(a,used,(*a)[(usz)x].left),rc=clone(a,used,(*a)[(usz)x].right);if(lc<0||rc<0)return false;(*a)[(usz)x].left=lc;(*a)[(usz)x].right=rc;apply(a,lc,m,b,mid-l+1);apply(a,rc,m,b,r-mid);}(*a)[(usz)x].mul=1;(*a)[(usz)x].add=0;return true;}
fn int build(Node[CAP]* a,usz* used,long* v,usz l,usz r){if(l==r)return make(a,used,v[l],-1,-1);usz mid=l+(r-l)/2;int x=build(a,used,v,l,mid),y=build(a,used,v,mid+1,r);if(x<0||y<0)return -1;return make(a,used,norm((*a)[(usz)x].sum+(*a)[(usz)y].sum),x,y);}
fn int update(Node[CAP]* a,usz* used,int root,usz l,usz r,usz ql,usz qr,long m,long b){if(ql<=l&&r<=qr){int x=clone(a,used,root);if(x<0)return -1;apply(a,x,m,b,r-l+1);return x;}int x=clone(a,used,root);if(x<0||!push(a,used,x,l,r))return -1;usz mid=l+(r-l)/2;if(ql<=mid){int y=update(a,used,(*a)[(usz)x].left,l,mid,ql,qr,m,b);if(y<0)return -1;(*a)[(usz)x].left=y;}if(qr>mid){int y=update(a,used,(*a)[(usz)x].right,mid+1,r,ql,qr,m,b);if(y<0)return -1;(*a)[(usz)x].right=y;}(*a)[(usz)x].sum=norm((*a)[(usz)(*a)[(usz)x].left].sum+(*a)[(usz)(*a)[(usz)x].right].sum);return x;}
fn int logical_child(Node[CAP]* a,usz* used,int s,bool right,usz l,usz r){int c=clone(a,used,right?(*a)[(usz)s].right:(*a)[(usz)s].left);if(c<0)return -1;long m=(*a)[(usz)s].mul,b=(*a)[(usz)s].add;if(m!=1||b!=0){usz mid=l+(r-l)/2;apply(a,c,m,b,right?r-mid:mid-l+1);}return c;}
fn int copy_range(Node[CAP]* a,usz* used,int dst,int src,usz l,usz r,usz ql,usz qr){if(ql<=l&&r<=qr)return src;int x=clone(a,used,dst);if(x<0||!push(a,used,x,l,r))return -1;usz mid=l+(r-l)/2;if(ql<=mid){int s=logical_child(a,used,src,false,l,r);if(s<0)return -1;int y=copy_range(a,used,(*a)[(usz)x].left,s,l,mid,ql,qr);if(y<0)return -1;(*a)[(usz)x].left=y;}if(qr>mid){int s=logical_child(a,used,src,true,l,r);if(s<0)return -1;int y=copy_range(a,used,(*a)[(usz)x].right,s,mid+1,r,ql,qr);if(y<0)return -1;(*a)[(usz)x].right=y;}(*a)[(usz)x].sum=norm((*a)[(usz)(*a)[(usz)x].left].sum+(*a)[(usz)(*a)[(usz)x].right].sum);return x;}
fn long query(Node[CAP]* a,int x,usz l,usz r,usz ql,usz qr,long cm,long ca){if(ql<=l&&r<=qr)return norm(cm*(*a)[(usz)x].sum+ca*(long)(r-l+1));usz mid=l+(r-l)/2;long nm=norm(cm*(*a)[(usz)x].mul),na=norm(cm*(*a)[(usz)x].add+ca),z=0;if(ql<=mid)z=query(a,(*a)[(usz)x].left,l,mid,ql,qr,nm,na);if(qr>mid)z=norm(z+query(a,(*a)[(usz)x].right,mid+1,r,ql,qr,nm,na));return z;}
fn bool valid_ref(long k,usz i,long[MAX_Q]* kinds){return k==-1||(k>=0&&(usz)k<i&&((*kinds)[(usz)k]==0||(*kinds)[(usz)k]==1));}
fn void put(char* out,usz at,long value){ulong bits=(ulong)value;for(usz j=0;j<8;j+=1)out[at+j]=(char)((bits>>(8*j))&255);}
fn long persistent_range_affine_range_sum(long* input,usz length,char* output,usz capacity) @export("persistent_range_affine_range_sum") {
 if(input==null||length<2||length>115)return -1;long n0=input[0],q0=input[1];if(n0<1||n0>16||q0<1||q0>16)return -1;usz n=(usz)n0,q=(usz)q0,off=2+n;if(length<off)return -1;for(usz j=0;j<n;j+=1)if(input[2+j]<0||input[2+j]>=MOD)return -1;
 long[MAX_Q] kind=zeroed,refs=zeroed,src=zeroed,ls=zeroed,rs=zeroed,mul=zeroed,add=zeroed;
 for(usz i=0;i<q;i+=1){if(off>=length)return -1;long op=input[off];usz w=op==0?6:op==1?5:op==2?4:0;if(w==0||length-off<w)return -1;long k=input[off+1];if(!valid_ref(k,i,&kind))return -1;kind[i]=op;refs[i]=k;mul[i]=1;if(op==0||op==2){ls[i]=input[off+2];rs[i]=input[off+3];if(ls[i]<0||rs[i]<=ls[i]||rs[i]>n0)return -1;}if(op==0){mul[i]=input[off+4];add[i]=input[off+5];if(mul[i]<1||mul[i]>=MOD||add[i]<0||add[i]>=MOD)return -1;}if(op==1){src[i]=input[off+2];ls[i]=input[off+3];rs[i]=input[off+4];if(!valid_ref(src[i],i,&kind)||ls[i]<0||rs[i]<=ls[i]||rs[i]>n0)return -1;}off+=w;}
 if(off!=length)return -1;Node[CAP] nodes=zeroed;usz used=0;int initial=build(&nodes,&used,input+2,0,n-1);if(initial<0)return -1;int[MAX_Q] roots=zeroed;long[MAX_Q] ans=zeroed;usz na=0;
 for(usz i=0;i<q;i+=1){int base=refs[i]<0?initial:roots[(usz)refs[i]];if(kind[i]==0){roots[i]=update(&nodes,&used,base,0,n-1,(usz)ls[i],(usz)rs[i]-1,mul[i],add[i]);if(roots[i]<0)return -1;}else if(kind[i]==1){int s=src[i]<0?initial:roots[(usz)src[i]];roots[i]=copy_range(&nodes,&used,base,s,0,n-1,(usz)ls[i],(usz)rs[i]-1);if(roots[i]<0)return -1;}else{ans[na]=query(&nodes,base,0,n-1,(usz)ls[i],(usz)rs[i]-1,1,0);na+=1;}}
 usz bytes=8*na;if(output==null||capacity<bytes)return -2;for(usz i=0;i<na;i+=1)put(output,8*i,ans[i]);return (long)bytes;
}
