module permutate_string;
fn uint mix(uint h, uint8 b){return (h^b)*16777619;}
fn bool next_perm(uint8* a,usz n){usz i=n-1;while(i>0&&a[i-1]>=a[i])i--;if(i==0)return false;usz j=n-1;while(a[j]<=a[i-1])j--;uint8 t=a[i-1];a[i-1]=a[j];a[j]=t;usz l=i;usz r=n-1;while(l<r){t=a[l];a[l]=a[r];a[r]=t;l++;r--;}return true;}
fn long permutate_string(long* v,usz n) @export("permutate_string"){if(v==null||n<2||n>8||v[0]<1||v[0]>7||n!=(usz)v[0]+1)return -1;usz len=(usz)v[0];uint8[7] a;for(usz i=0;i<len;i++){if(v[i+1]<33||v[i+1]>126)return -1;a[i]=(uint8)v[i+1];for(usz j=0;j<i;j++)if(a[j]==a[i])return -1;}for(usz i=1;i<len;i++){usz j=i;while(j>0&&a[j-1]>a[j]){uint8 t=a[j-1];a[j-1]=a[j];a[j]=t;j--;}}uint h=2166136261;while(true){for(usz i=0;i<len;i++)h=mix(h,a[i]);h=mix(h,0);if(!next_perm(&a[0],len))break;}return (long)h;}
