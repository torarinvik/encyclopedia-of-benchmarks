module idea_cfb64;
fn u16 mul16(u16 a,u16 b){ulong x=a==0?65536:a;ulong y=b==0?65536:b;ulong z=(x*y)%65537;return z==65536?0:(u16)z;}
fn void expand(u8*key,u16*z){u16[8] s;for(usz i=0;i<8;i++)s[i]=(u16)(((u16)key[2*i]<<8)|key[2*i+1]);for(usz off=0;off<52;off+=8){usz n=52-off<8?52-off:8;for(usz i=0;i<n;i++)z[off+i]=s[i];u16[8] r;for(usz i=0;i<8;i++)r[i]=(u16)((s[(i+1)&7]<<9)|(s[(i+2)&7]>>7));for(usz i=0;i<8;i++)s[i]=r[i];}}
fn void encrypt(u16*z,u8*in,u8*out){u16 x1=(u16)(((u16)in[0]<<8)|in[1]);u16 x2=(u16)(((u16)in[2]<<8)|in[3]);u16 x3=(u16)(((u16)in[4]<<8)|in[5]);u16 x4=(u16)(((u16)in[6]<<8)|in[7]);for(usz r=0;r<8;r++){u16*k=z+r*6;u16 a=mul16(x1,k[0]);u16 b=(u16)(x2+k[1]);u16 c=(u16)(x3+k[2]);u16 d=mul16(x4,k[3]);u16 p=mul16((u16)(a^c),k[4]);u16 q=mul16((u16)((b^d)+p),k[5]);u16 t=(u16)(p+q);x1=(u16)(a^q);x2=(u16)(c^q);x3=(u16)(b^t);x4=(u16)(d^t);}u16[4] y={mul16(x1,z[48]),(u16)(x3+z[49]),(u16)(x2+z[50]),mul16(x4,z[51])};for(usz i=0;i<4;i++){out[2*i]=(u8)(y[i]>>8);out[2*i+1]=(u8)y[i];}}
fn void put(u8*out,u8*src,usz n){for(usz i=0;i<n;i++)out[i]=src[i];}
fn long idea_cfb64(long*v,usz n,u8*out,usz cap) @export("idea_cfb64") {if(v==null||n<27||n>51)return -1;long mode=v[0],lv=v[1];if(mode<0||mode>1||lv<1||lv>24||n!=26+(usz)lv)return -1;u8[16] key;u8[8] state;u8[24] text;u8[24] result;for(usz i=0;i<16;i++){if(v[2+i]<0||v[2+i]>255)return -1;key[i]=(u8)v[2+i];}for(usz i=0;i<8;i++){if(v[18+i]<0||v[18+i]>255)return -1;state[i]=(u8)v[18+i];}for(usz i=0;i<(usz)lv;i++){if(v[26+i]<0||v[26+i]>255)return -1;text[i]=(u8)v[26+i];}u16[52] z;expand(&key[0],&z[0]);for(usz p=0;p<(usz)lv;p+=8){u8[8] stream;encrypt(&z[0],&state[0],&stream[0]);usz take=(usz)lv-p<8?(usz)lv-p:8;for(usz j=0;j<take;j++){result[p+j]=text[p+j]^stream[j];state[j]=mode==0?result[p+j]:text[p+j];}}if(out==null||cap<(usz)lv)return -2;put(out,&result[0],(usz)lv);return lv;}
