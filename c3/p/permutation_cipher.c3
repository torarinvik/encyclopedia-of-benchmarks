module permutation_cipher;
fn long permutation_cipher(long* v,usz n) @export("permutation_cipher"){if(v==null||n<2||n>74||v[0]<0||v[0]>64)return -1;usz len=(usz)v[0];if(n<len+2)return -1;usz kp=len+1;if(v[kp]<1||v[kp]>8)return -1;usz k=(usz)v[kp];if(n!=kp+k+1)return -1;bool[8] seen={false};for(usz i=0;i<k;i++){long x=v[kp+1+i];if(x<1||x>(long)k||seen[(usz)(x-1)])return -1;seen[(usz)(x-1)]=true;}char[128] text;usz m=0;for(usz i=0;i<len;i++){long x=v[i+1];if(x<0||x>127)return -1;int c=(int)x;if(c==32||(c>=9&&c<=13))continue;if(c>=97&&c<=122)c-=32;text[m++]=(char)c;}while(m%k!=0)text[m++]='X';ulong h=0;for(usz b=0;b<m;b+=k)for(usz j=0;j<k;j++)h=(h*257+(ulong)(uchar)text[b+(usz)(v[kp+1+j]-1)])%1000000007;return (long)h;}
