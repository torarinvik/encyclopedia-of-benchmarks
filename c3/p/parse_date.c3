module parse_date;
fn long parse_date(long* v,usz n) @export("parse_date"){if(v==null||n<9||n>11||v[0]<8||v[0]>10||n!=(usz)v[0]+1)return -1;usz len=(usz)v[0],s1=0,s2=0;for(usz i=1;i<=len;i++){long x=v[i];if(x<0||x>127)return -1;if(x==47){if(s1==0)s1=i;else if(s2==0)s2=i;else return -1;}}if(s1<2||s1>3||s2<=s1+1||s2-s1<2||s2-s1>3||len-s2!=4)return -1;long d=0,m=0,y=0;for(usz i=1;i<s1;i++){long x=v[i];if(x<48||x>57)return -1;d=d*10+x-48;}for(usz i=s1+1;i<s2;i++){long x=v[i];if(x<48||x>57)return -1;m=m*10+x-48;}for(usz i=s2+1;i<=len;i++){long x=v[i];if(x<48||x>57)return -1;y=y*10+x-48;}if(m<1||m>12)return -1;long[12] days={31,28,31,30,31,30,31,31,30,31,30,31};if(m==2&&y%4==0&&(y%100!=0||y%400==0))days[1]=29;if(d<1||d>days[(usz)(m-1)])return -1;return y*10000+m*100+d;}
