module batch_dynamic_kd_tree;
// Bounded ParGeo-style logarithmic batch-dynamic point forest; see package README/LICENSE.
struct BdkNode { int id; int left; int right; long minx; long maxx; long miny; long maxy; }
fn bool bdk_less(int a,int b,int axis,long* x,long* y){long av=axis==0?x[a]:y[a],bv=axis==0?x[b]:y[b];if(av!=bv)return av<bv;long aw=axis==0?y[a]:x[a],bw=axis==0?y[b]:x[b];return aw!=bw?aw<bw:a<b;}
fn long bdk_box(BdkNode* n,long qx,long qy){long dx=qx<n.minx?n.minx-qx:qx>n.maxx?qx-n.maxx:0,dy=qy<n.miny?n.miny-qy:qy>n.maxy?qy-n.maxy:0;return dx*dx+dy*dy;}
fn int bdk_build(int* ids,int lo,int hi,int depth,long* x,long* y,BdkNode* nodes,int* used){if(lo>=hi)return -1;int axis=depth%2;for(int i=lo+1;i<hi;i++){int v=ids[i],j=i;while(j>lo&&bdk_less(v,ids[j-1],axis,x,y)){ids[j]=ids[j-1];j--;}ids[j]=v;}int mid=lo+(hi-lo)/2,at=*used;*used=*used+1;nodes[at].id=ids[mid];int left=bdk_build(ids,lo,mid,depth+1,x,y,nodes,used),right=bdk_build(ids,mid+1,hi,depth+1,x,y,nodes,used);nodes[at].left=left;nodes[at].right=right;nodes[at].minx=x[ids[mid]];nodes[at].maxx=x[ids[mid]];nodes[at].miny=y[ids[mid]];nodes[at].maxy=y[ids[mid]];for(int k=0;k<2;k++){int child=k==0?left:right;if(child>=0){if(nodes[child].minx<nodes[at].minx)nodes[at].minx=nodes[child].minx;if(nodes[child].maxx>nodes[at].maxx)nodes[at].maxx=nodes[child].maxx;if(nodes[child].miny<nodes[at].miny)nodes[at].miny=nodes[child].miny;if(nodes[child].maxy>nodes[at].maxy)nodes[at].maxy=nodes[child].maxy;}}return at;}
fn void bdk_query(int at,BdkNode* nodes,long* x,long* y,uint8* active,long qx,long qy,bool* found,int* best_id,long* best){if(at<0||(*found&&bdk_box(&nodes[at],qx,qy)>*best))return;int id=nodes[at].id;if(active[id]!=0){long dx=x[id]-qx,dy=y[id]-qy,d=dx*dx+dy*dy;if(!*found||d<*best||(d==*best&&id<*best_id)){*found=true;*best=d;*best_id=id;}}int a=nodes[at].left,b=nodes[at].right;if(a>=0&&b>=0&&bdk_box(&nodes[b],qx,qy)<bdk_box(&nodes[a],qx,qy)){int t=a;a=b;b=t;}bdk_query(a,nodes,x,y,active,qx,qy,found,best_id,best);bdk_query(b,nodes,x,y,active,qx,qy,found,best_id,best);}
fn long batch_dynamic_kd_tree(long* input,usz length,uint8* output,usz capacity) @export("batch_dynamic_kd_tree") {
    if(input==null||length<2||length>250)return -1;long initial=input[0];if(initial<0||initial>8||length<2+3*(usz)initial)return -1;
    long[32] x,y,answers;uint8[32] ever,active;int[6][32] levels;int[6] sizes;usz pos=1;int inserted=0;
    for(int i=0;i<(int)initial;i++){long id=input[pos++],px=input[pos++],py=input[pos++];if(id<0||id>=32||ever[(int)id]!=0||px<-1000||px>1000||py<-1000||py>1000)return -1;for(int j=0;j<32;j++)if(active[j]!=0&&x[j]==px&&y[j]==py)return -1;x[(int)id]=px;y[(int)id]=py;ever[(int)id]=1;active[(int)id]=1;inserted++;
        int[32] carry;carry[0]=(int)id;int carry_count=1;for(int level=0;level<6;level++){if(sizes[level]==0){for(int j=0;j<carry_count;j++)levels[level][j]=carry[j];sizes[level]=carry_count;break;}int[32] next;int next_count=0;for(int j=0;j<sizes[level];j++)next[next_count++]=levels[level][j];for(int j=0;j<carry_count;j++)next[next_count++]=carry[j];sizes[level]=0;for(int j=0;j<next_count;j++)carry[j]=next[j];carry_count=next_count;}
    }
    if(pos>=length)return -1;long batch_value=input[pos++];if(batch_value<1||batch_value>8)return -1;int batch_count=(int)batch_value;
    for(int batch=0;batch<batch_count;batch++){
        if(pos+2>length)return -1;long kind=input[pos++],count_value=input[pos++];if((kind!=0&&kind!=1)||count_value<1||count_value>8)return -1;int count=(int)count_value;
        if(kind==0){if(inserted+count>32||pos+3*(usz)count+2>length)return -1;usz records_start=pos;
            for(int j=0;j<count;j++){long id=input[pos++],px=input[pos++],py=input[pos++];if(id<0||id>=32||ever[(int)id]!=0||px<-1000||px>1000||py<-1000||py>1000)return -1;for(int t=0;t<32;t++)if(active[t]!=0&&x[t]==px&&y[t]==py)return -1;for(int t=0;t<j;t++)if(input[records_start+3*(usz)t+1]==px&&input[records_start+3*(usz)t+2]==py)return -1;x[(int)id]=px;y[(int)id]=py;ever[(int)id]=1;active[(int)id]=1;inserted++;
                int[32] carry;carry[0]=(int)id;int carry_count=1;for(int level=0;level<6;level++){if(sizes[level]==0){for(int z=0;z<carry_count;z++)levels[level][z]=carry[z];sizes[level]=carry_count;break;}int[32] next;int next_count=0;for(int z=0;z<sizes[level];z++)next[next_count++]=levels[level][z];for(int z=0;z<carry_count;z++)next[next_count++]=carry[z];sizes[level]=0;for(int z=0;z<next_count;z++)carry[z]=next[z];carry_count=next_count;}
            }
        }else{if(pos+(usz)count+2>length)return -1;for(int j=0;j<count;j++){long id=input[pos++];if(id<0||id>=32||active[(int)id]==0)return -1;active[(int)id]=0;}}
        long qx=input[pos++],qy=input[pos++];if(qx<-1000||qx>1000||qy<-1000||qy>1000)return -1;bool found=false;long best=0;int best_id=0;for(int level=0;level<6;level++)if(sizes[level]>0){int[32] ids;for(int j=0;j<sizes[level];j++)ids[j]=levels[level][j];BdkNode[32] nodes;int used=0;int root=bdk_build(ids,0,sizes[level],0,x,y,nodes,&used);bdk_query(root,nodes,x,y,active,qx,qy,&found,&best_id,&best);}if(!found)return -1;answers[batch]=best;
    }
    if(pos!=length)return -1;usz needed=8*(usz)batch_count;if(output==null||capacity<needed)return -2;for(usz i=0;i<needed;i++)output[i]=(uint8)((ulong)answers[i/8]>>(8*(i%8)));return (long)needed;
}
