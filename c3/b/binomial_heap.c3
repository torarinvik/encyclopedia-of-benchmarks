module binomial_heap;
const int M=128,R=9,E=-1;
fn int link_tree(long* v,int* ch,int* sib,int* deg,int a,int b){int p,c;if(v[a]<v[b]){p=a;c=b;}else{p=b;c=a;}sib[c]=ch[p];ch[p]=c;deg[p]++;return p;}
fn void add_tree(long* v,int* ch,int* sib,int* deg,int* roots,int initial){int r=initial,d=deg[initial];while(roots[d]!=E){r=link_tree(v,ch,sib,deg,r,roots[d]);roots[d++]=E;}roots[d]=r;}
fn void insert(long* v,int* ch,int* sib,int* deg,int* roots,int* used,int* size,long value){int r=*used;*used+=1;v[r]=value;ch[r]=E;sib[r]=E;deg[r]=0;*size+=1;add_tree(v,ch,sib,deg,roots,r);}
fn int min_root(long* v,int* roots){int best=E;for(int d=0;d<R;d++){int r=roots[d];if(r!=E&&(best==E||v[r]<v[best]))best=r;}return best;}
fn long extract_min(long* v,int* ch,int* sib,int* deg,int* roots,int* size){int b=min_root(v,roots),d=deg[b];long value=v[b];roots[d]=E;int c=ch[b];while(c!=E){int next=sib[c];sib[c]=E;add_tree(v,ch,sib,deg,roots,c);c=next;}*size-=1;return value;}
fn void put(char* output,usz i,long value){ulong bits=(ulong)value;for(usz b=0;b<8;b++){output[i*8+b]=(char)((bits>>(8*b))&255);}}
fn long binomial_heap(long* in,usz length,char* out,usz cap) @export("binomial_heap"){if(in==null||length<1||in[0]<0||in[0]>M||length!=1+2*(usz)in[0])return -1;int n=(int)in[0],size=0;usz q=0;for(int i=0;i<n;i++){long op=in[1+2*i],v=in[2+2*i];if(op==0){if(v< -2147483648||v>2147483647)return -1;size++;}else if(op>=1&&op<=3){if(v!=0||((op==1||op==2)&&size==0))return -1;if(op==2)size--;q++;}else return -1;}usz need=q*8;if(cap<need||(need>0&&out==null))return -2;long[M] values;int[M] child,sibling,degree;int[R] roots;for(int i=0;i<R;i++)roots[i]=E;int used=0;size=0;usz w=0;for(int i=0;i<n;i++){long op=in[1+2*i],v=in[2+2*i],result;if(op==0){insert(&values[0],&child[0],&sibling[0],&degree[0],&roots[0],&used,&size,v);continue;}if(op==1)result=values[min_root(&values[0],&roots[0])];else if(op==2)result=extract_min(&values[0],&child[0],&sibling[0],&degree[0],&roots[0],&size);else result=size==0?1:0;put(out,w++,result);}return (long)w;}
