module jacobi_iteration_method;
fn void put(uint8 *o,usz p,double x){ulong bits=@bitcast(ulong,x);for(usz i=0;i<8;i++)o[p+i]=(uint8)(bits>>(8*i));}
fn long jacobi_iteration_method(long *v,usz n,uint8 *out,usz cap) @export("jacobi_iteration_method"){if(v==null||n<2||n>26)return -1;long d=v[0],it=v[1];if(d<2||d>4||it<1||it>8||n!=2+(usz)(d*d+2*d))return -1;double a[4][4]={{0}},b[4]={0},x[4]={0},y[4]={0};usz rhs=2+(usz)(d*d),ini=rhs+(usz)d;for(long i=0;i<d;i++){double off=0;for(long j=0;j<d;j++){long z=v[2+i*d+j];if(z<0||z>4000)return -1;a[i][j]=(double)z/1000.0;if(i!=j)off+=a[i][j];}if(a[i][i]<=off)return -1;if(v[rhs+i] < -2000||v[rhs+i]>2000||v[ini+i] < -2000||v[ini+i]>2000)return -1;b[i]=(double)v[rhs+i]/1000.0;x[i]=(double)v[ini+i]/1000.0;}usz bytes=(usz)d*8;if(out==null||cap<bytes)return -2;for(long k=0;k<it;k++){for(long i=0;i<d;i++){double sum=0;for(long j=0;j<d;j++)if(i!=j)sum+=-a[i][j]*x[j];y[i]=(sum+b[i])/a[i][i];}for(long i=0;i<d;i++)x[i]=y[i];}for(long i=0;i<d;i++)put(out,(usz)i*8,x[i]);return (long)bytes;}
