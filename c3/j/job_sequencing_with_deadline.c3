module job_sequencing_with_deadline;
fn long job_sequencing_with_deadline(long*v,usz n) @export("job_sequencing_with_deadline"){if(v==null||n<1||n>65)return -1;long count=v[0];if(count<1||count>32||n!=1+2*(usz)count)return -1;long[32] d;long[32] p;usz[32] order;for(usz i=0;i<(usz)count;i++){d[i]=v[1+2*i];p[i]=v[2+2*i];if(d[i]<0||d[i]>32||p[i]<0||p[i]>1000000)return -1;order[i]=i;}for(usz i=1;i<(usz)count;i++){usz key=order[i];usz j=i;while(j>0&&p[order[j-1]]<p[key]){order[j]=order[j-1];j--;}order[j]=key;}bool[33] slots=zeroed;long chosen=0;long profit=0;for(usz k=0;k<(usz)count;k++){long s=d[order[k]];while(s>0){if(!slots[(usz)s]){slots[(usz)s]=true;chosen++;profit+=p[order[k]];break;}s--;}}return chosen*32000001+profit;}
