module job_sequence_with_deadline;
fn long job_sequence_with_deadline(long*v,usz n) @export("job_sequence_with_deadline"){if(v==null||n<1||n>129)return -1;long count=v[0];if(count<0||count>64||n!=1+2*(usz)count)return -1;long[64] d;long[64] r;usz[64] order;for(usz i=0;i<(usz)count;i++){d[i]=v[1+2*i];r[i]=v[2+2*i];if(d[i]<-1||d[i]>64||r[i]<-1000000||r[i]>1000000)return -1;order[i]=i;}for(usz i=1;i<(usz)count;i++){usz key=order[i];usz j=i;while(j>0&&r[order[j-1]]<r[key]){order[j]=order[j-1];j--;}order[j]=key;}long kept=0;for(usz i=0;i<(usz)count;i++)if(d[order[i]]>=(long)(i+1))kept++;return kept;}
