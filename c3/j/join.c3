module join;
const usz MAX_OUTPUT=3040;
fn long join(long* v,usz n,char* output,usz capacity) @export("join"){if(v==null||n<2||n>2115)return -1;long sl=v[0],count=v[1];if(sl<0||sl>32||count<0||count>32)return -1;usz cursor=2;if((usz)sl>n-cursor)return -1;char[32] sep;char[MAX_OUTPUT] result;for(usz i=0;i<(usz)sl;i++){long x=v[cursor];cursor++;if(x<0||x>127)return -1;sep[i]=(char)x;}usz written=0;for(usz item=0;item<(usz)count;item++){if(cursor>=n)return -1;long len=v[cursor];cursor++;if(len<0||len>64||(usz)len>n-cursor)return -1;if(item>0)for(usz j=0;j<(usz)sl;j++){result[written]=sep[j];written++;}for(usz j=0;j<(usz)len;j++){long x=v[cursor];cursor++;if(x<0||x>127)return -1;result[written]=(char)x;written++;}}if(cursor!=n)return -1;if(output==null||capacity<written)return -2;for(usz i=0;i<written;i++)output[i]=result[i];return (long)written;}
