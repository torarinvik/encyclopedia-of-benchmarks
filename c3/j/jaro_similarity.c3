module jaro_similarity;
const double BAD=-1.0e300;
fn double jaro_similarity(long *v,usz n) @export("jaro_similarity"){if(v==null||n<2||n>66)return BAD;if(v[0]<0||v[0]>32)return BAD;usz n1=(usz)v[0],p=1+n1;if(p>=n)return BAD;if(v[p]<0||v[p]>32||n1>(usz)v[p]||n!=p+1+(usz)v[p])return BAD;usz n2=(usz)v[p];for(usz i=0;i<n1;i++)if(v[1+i]<0||v[1+i]>127)return BAD;for(usz i=0;i<n2;i++)if(v[p+1+i]<0||v[p+1+i]>127)return BAD;bool equal=n1==n2;for(usz i=0;i<n1;i++)if(v[1+i]!=v[p+1+i])equal=false;if(equal)return 1.0;if(n2==0)return 0.0;int radius=(int)(n1/2)-1;if(radius<0)radius=0;bool[32] m1;bool[32] m2;for(usz z=0;z<32;z++){m1[z]=false;m2[z]=false;}int matches=0;for(int i=0;i<(int)n1;i++){int start=i-radius;if(start<0)start=0;int finish=i+radius;if(finish>=(int)n2)finish=(int)n2-1;for(int j=start;j<=finish;j++)if(v[1+i]==v[p+1+(usz)j]&&!m2[j]){matches++;m1[i]=true;m2[j]=true;break;}}if(matches==0)return 0.0;int trans=0,j=0;for(int i=0;i<(int)n1;i++)if(m1[i]){while(!m2[j])j++;if(v[1+i]!=v[p+1+(usz)j])trans++;j++;}trans/=2;return ((double)matches/(double)n1+(double)matches/(double)n2+(double)(matches-trans)/(double)matches)/3.0;}
