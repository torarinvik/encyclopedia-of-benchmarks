module depthconv;
const usz MAX_CHANNELS=8;
fn long rounded_shift(long value,int shift){long divisor=(long)1<<shift;if(value>=0)return value/divisor;return -((-value+divisor-1)/divisor);}
fn long depthconv(long* values,usz length,uint8* output,usz capacity) @export("depthconv"){if(values==null||length<1||length>1+11*MAX_CHANNELS)return -1;long channels=values[0];if(channels<1||channels>8||length!=1+11*(usz)channels)return -1;usz c=(usz)channels;for(usz i=1;i<1+8*c;i++)if(values[i] < -128||values[i]>127)return -1;for(usz i=1+8*c;i<1+9*c;i++)if(values[i]< -1000000||values[i]>1000000)return -1;for(usz i=1+9*c;i<1+10*c;i++)if(values[i]<0||values[i]>2147483647)return -1;for(usz i=1+10*c;i<length;i++)if(values[i]< -8||values[i]>0)return -1;if(output==null||capacity<c)return -2;for(usz ch=0;ch<c;ch++){int acc=0;for(usz y=0;y<4;y++)acc+=(int)values[1+4*c+y*c+ch]*((int)values[1+y*c+ch]+128);acc+=(int)values[1+8*c+ch];int shift=(int)(31-values[1+10*c+ch]);long round=(long)1<<(shift-1);long scaled=rounded_shift((long)acc*values[1+9*c+ch]+round,shift);if(scaled>127)scaled=127;if(scaled< -128)scaled=-128;output[ch]=(uint8)(int8)scaled;}return channels;}
