module non_preemptive_priority_scheduling;
void put(char*out,usz i,int x){uint bits=(uint)x;for(usz k=0;k<4;k++){out[i*4+k]=(char)(bits&255);bits>>=8;}}
fn long non_preemptive_priority_scheduling(long*v,usz n,char*out,usz cap)@export("non_preemptive_priority_scheduling"){if(v==null||n<4||v[0]<1||v[0]>10||n!=1+(usz)(3*v[0]))return -1;int count=(int)v[0],a[10],b[10],p[10],done[10]={0};for(int i=0;i<count;i++){long av=v[1+3*i],bv=v[2+3*i],pv=v[3+3*i];if(av<0||av>20||bv<1||bv>10||pv<0||pv>10)return -1;for(int j=0;j<i;j++)if(p[j]==(int)pv)return -1;a[i]=(int)av;b[i]=(int)bv;p[i]=(int)pv;}if(out==null||cap<(usz)(count*4))return -2;int now=0,z=0;while(z<count){int pick=-1;for(int i=0;i<count;i++)if(!done[i]&&a[i]<=now&&(pick<0||p[i]<p[pick]||(p[i]==p[pick]&&a[i]<a[pick])))pick=i;if(pick<0){int next=100000;for(int i=0;i<count;i++)if(!done[i]&&a[i]<next)next=a[i];now=next;continue;}done[pick]=1;put(out,(usz)z,pick);z++;now+=b[pick];}return (long)(count*4);}
