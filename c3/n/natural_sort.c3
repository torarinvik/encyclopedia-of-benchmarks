module natural_sort;
const usz MAX_COUNT=64;
fn int lower_ascii(int c){return c>=65&&c<=90?c+32:c;}
fn bool less(long*v,usz*o,usz*l,usz*p,usz a,usz b){usz lim=p[a]<p[b]?p[a]:p[b];for(usz i=0;i<lim;i++){int x=lower_ascii((int)v[o[a]+i]);int y=lower_ascii((int)v[o[b]+i]);if(x!=y)return x<y;}if(p[a]!=p[b])return p[a]<p[b];usz sa=l[a]-p[a],sb=l[b]-p[b];if(sa==0||sb==0)return sa<sb;usz za=0,zb=0;while(za<sa&&v[o[a]+p[a]+za]==48)za++;while(zb<sb&&v[o[b]+p[b]+zb]==48)zb++;usz na=sa-za,nb=sb-zb;if(na!=nb)return na<nb;for(usz i=0;i<na;i++){long x=v[o[a]+p[a]+za+i],y=v[o[b]+p[b]+zb+i];if(x!=y)return x<y;}return false;}
fn long natural_sort(long*v,usz n,char*out,usz cap) @export("natural_sort"){if(v==null||n<1||n>4161||v[0]<0||v[0]>64)return -1;usz count=(usz)v[0];usz[64] o;usz[64] l;usz[64] p;usz[64] order;usz cursor=1,total=0;for(usz i=0;i<count;i++){if(cursor>=n||v[cursor]<0||v[cursor]>64)return -1;l[i]=(usz)v[cursor++];o[i]=cursor;p[i]=l[i];bool digit=false;for(usz j=0;j<l[i];j++){long c=v[cursor+j];if(c>=48&&c<=57){if(j==0)return -1;if(!digit){p[i]=j;digit=true;}}else if(!((c>=65&&c<=90)||(c>=97&&c<=122))||digit)return -1;}cursor+=l[i];total+=l[i];order[i]=i;}if(cursor!=n)return -1;for(usz i=1;i<count;i++){usz item=order[i],j=i;while(j>0&&less(v,&o[0],&l[0],&p[0],item,order[j-1])){order[j]=order[j-1];j--;}order[j]=item;}usz bytes=total+(count>0?count-1:0);if(bytes>cap||(bytes>0&&out==null))return -2;usz w=0;for(usz i=0;i<count;i++){if(i>0)out[w++]=10;usz k=order[i];for(usz j=0;j<l[k];j++)out[w++]=(char)v[o[k]+j];}return (long)w;}
