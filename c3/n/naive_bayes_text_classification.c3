module naive_bayes_text_classification;
import "libc";
import "math";
void putd(char *o,usz p,double x){ulong b=@bitcast(ulong,x);for(usz k=0;k<8;k++){o[p+k]=(char)(b&255);b>>=8;}}
bool token(long *v,int n,ulong *key){*key=0;for(int i=0;i<n;i++){int x=(int)v[i];if(x>=65&&x<=90)x+=32;if(!((x>=97&&x<=122)||(x>=48&&x<=57)||x==39))return false;*key=*key*128+(ulong)x;}return true;}
fn long naive_bayes_text_classification(long *v,usz n,char *out,usz cap) @export("naive_bayes_text_classification") {if(v==null||n<7)return -1;int d=(int)v[0];long alpha=v[1];if(d<2||d>6||alpha<1||alpha>10000)return -1;ulong w[6]={0},q=0;int labs[6]={0},seen[2]={0},total[2]={0},p=2;for(int i=0;i<d;i++){if((usz)(p+2)>n)return -1;long c=v[p++],l=v[p++];if((c!=0&&c!=1)||l<0||l>8||(usz)(p+l)>n||!token(v+p,(int)l,&w[i]))return -1;labs[i]=(int)c;seen[c]=1;if(l>0)total[c]++;p+=(int)l;}if((usz)p>=n)return -1;long ql=v[p++];if(ql<0||ql>8||(usz)(p+ql)!=n||!token(v+p,(int)ql,&q)||seen[0]==0||seen[1]==0)return -1;int vocab=0;for(int i=0;i<d;i++)if(w[i]!=0){bool fresh=true;for(int j=0;j<i;j++)if(w[i]==w[j])fresh=false;if(fresh)vocab++;}if(vocab==0&&ql>0)return -1;if(out==null||cap<16)return -2;double s[2];for(int c=0;c<2;c++){int docs=0,count=0;for(int i=0;i<d;i++)if(labs[i]==c){docs++;if(ql>0&&w[i]==q)count++;}s[c]=math.log((double)docs/(double)d);if(ql>0){double a=(double)alpha/1000.0;s[c]+=math.log(((double)count+a)/((double)total[c]+a*(double)vocab));}}double h=s[0]>s[1]?s[0]:s[1],a=math.exp(s[0]-h),b=math.exp(s[1]-h);putd(out,0,a/(a+b));putd(out,8,b/(a+b));return 16;}
