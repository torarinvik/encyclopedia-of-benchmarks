module naive_bayes;
import "math";
void puti(char *o,long x){ulong b=@bitcast(ulong,x);for(usz k=0;k<8;k++){o[k]=(char)(b&255);b>>=8;}}
fn long naive_bayes(long *v,usz n,char *o,usz cap) @export("naive_bayes"){if(v==null||n<6)return -1;int nr=(int)v[0],f=(int)v[1];if(nr<2||nr>8||f<1||f>3||n!=2+(usz)nr*((usz)f+1)+(usz)f)return -1;int labs[8],order[3],counts[3]={0},cc=0;double x[8][3]={0};usz p=2;for(int r=0;r<nr;r++){long lab=v[p++];if(lab<0||lab>2)return -1;int c=0;while(c<cc&&order[c]!=lab)c++;if(c==cc)order[cc++]=(int)lab;labs[r]=c;counts[c]++;for(int j=0;j<f;j++){long z=v[p++];if(z < -10000||z>10000)return -1;x[r][j]=(double)z/1000.0;}}if(cc<2)return -1;double best=-1.0e300;long ans=order[0];for(int c=0;c<cc;c++){double score=math.log((double)counts[c]/(double)nr);for(int j=0;j<f;j++){double mean=0;for(int r=0;r<nr;r++)if(labs[r]==c)mean+=x[r][j];mean/=(double)counts[c];double var=0;for(int r=0;r<nr;r++)if(labs[r]==c){double d=x[r][j]-mean;var+=d*d;}var=math.max(var/(double)counts[c],1e-9);long raw=v[p+(usz)j];if(raw < -10000||raw>10000)return -1;double q=(double)raw/1000.0;score+=-0.5*math.log(6.283185307179586*var)-(q-mean)*(q-mean)/(2*var);}if(score>best){best=score;ans=order[c];}}if(o==null||cap<8)return -2;puti(o,ans);return 8;}
