module nysiis_encoder;
const usz MAX_INPUT=64;
fn bool vowel(char c){return c=='A'||c=='E'||c=='I'||c=='O'||c=='U';}
fn bool match(char*s,usz n,usz at,char*p,usz m){if(at+m>n)return false;for(usz i=0;i<m;i++)if(s[at+i]!=p[i])return false;return true;}
fn void rep(char*s,usz*n,usz at,usz old,char*p,usz repl){if(repl>old){for(usz i=*n;i>at+old;i--)s[i-old+repl-1]=s[i-1];}else{for(usz i=at+old;i<*n;i++)s[i-old+repl]=s[i];}for(usz i=0;i<repl;i++)s[at+i]=p[i];*n=*n-old+repl;s[*n]=0;}
fn void start(char*s,usz*n){char*[6] f={"MAC","KN","K","PH","PF","SCH"};char*[6] t={"MCC","NN","C","FF","FF","SSS"};usz[6] fl={3,2,1,2,2,3};usz[6] tl={3,2,1,2,2,3};for(usz i=0;i<6;i++)if(match(s,*n,0,f[i],fl[i])){rep(s,n,0,fl[i],t[i],tl[i]);return;}}
fn void end(char*s,usz*n){char*[6] f={"EE","IE","DT","RT","NT","ND"};char*[6] t={"Y","Y","D","D","D","D"};for(usz i=0;i<6;i++){usz m=2;if(*n>=m&&match(s,*n,*n-m,f[i],m)){rep(s,n,*n-m,m,t[i],1);return;}}}
fn void step(char*s,usz*n,usz at){char*[12] f={"EV","E","I","O","U","Q","Z","M","KN","K","SCH","PH"};char*[12] t={"AF","A","A","A","A","G","S","N","NN","C","SSS","FF"};usz[12] fl={2,1,1,1,1,1,1,1,2,1,3,2};usz[12] tl={2,1,1,1,1,1,1,1,2,1,3,2};for(usz j=0;j<12;j++)if(match(s,*n,at,f[j],fl[j])){rep(s,n,at,fl[j],t[j],tl[j]);return;}if(s[at]=='H'&&(!vowel(s[at-1])||(at+1<*n&&!vowel(s[at+1])))){s[at]=s[at-1];return;}if(s[at]=='W'&&vowel(s[at-1]))s[at]=s[at-1];}
fn long nysiis_encoder(long*v,usz n,char*out,usz cap) @export("nysiis_encoder") {if(v==null||n<2||n>65||v[0]<1||v[0]>64||n!=(usz)v[0]+1)return -1;char[256] s;usz len=0;for(usz i=0;i<(usz)v[0];i++){long c=v[i+1];if(c==32)continue;if(c>=97&&c<=122)c-=32;if(c<65||c>90)return -1;s[len++]=(char)c;}if(len==0)return -1;s[len]=0;start(&s[0],&len);end(&s[0],&len);for(usz i=1;i<len;i++)step(&s[0],&len,i);usz w=0;for(usz i=0;i<len;i++)if(i==0||s[i]!=s[i-1])s[w++]=s[i];len=w;s[len]=0;if(len>0&&s[len-1]=='S')len--;else if(len>=2&&s[len-2]=='A'&&s[len-1]=='Y'){s[len-2]='Y';len--;}else if(len>0&&s[len-1]=='A')len--;if(len>cap||(len>0&&out==null))return -2;for(usz i=0;i<len;i++)out[i]=s[i];return (long)len;}
