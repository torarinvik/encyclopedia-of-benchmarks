module ipv6_converter;
fn long ipv6_converter(long* a,usz n,char* output,usz capacity) @export("ipv6_converter"){if(a==null||n<2)return -1;long op=a[0],len=a[1];if(!((op==0&&len==4)||(op==1&&len==16))||n!=(usz)(2+len))return -1;for(usz i=0;i<(usz)len;i++)if(a[i+2]<0||a[i+2]>255)return -1;if(op==1){for(int i=0;i<10;i++)if(a[i+2]!=0)return -1;if(a[12]!=255||a[13]!=255)return -1;}usz needed=op==0?16:4;if(output==null||capacity<needed)return -2;if(op==0){for(int i=0;i<10;i++)output[i]=0;output[10]=255;output[11]=255;for(int i=0;i<4;i++)output[12+i]=(char)a[2+i];}else for(int i=0;i<4;i++)output[i]=(char)a[14+i];return (long)needed;}
