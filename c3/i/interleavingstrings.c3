module interleavingstrings;
fn long interleavingstrings(long* a,usz n) @export("interleavingstrings"){if(a==null||n<3)return -1;long m=a[0],k=a[1],q=a[2];if(m<0||m>32||k<0||k>32||q!=m+k||n!=(usz)(3+m+k+q))return -1;for(usz i=3;i<n;i++)if(a[i]<0||a[i]>127)return -1;usz ml=(usz)m;usz kl=(usz)k;usz s2=3+ml;usz s3=s2+kl;bool dp[33][33];for(usz i=0;i<=ml;i++)for(usz j=0;j<=kl;j++)dp[i][j]=false;dp[0][0]=true;for(usz i=0;i<=ml;i++)for(usz j=0;j<=kl;j++){if(i>0&&dp[i-1][j]&&a[3+i-1]==a[s3+i+j-1])dp[i][j]=true;if(j>0&&dp[i][j-1]&&a[s2+j-1]==a[s3+i+j-1])dp[i][j]=true;}return dp[ml][kl]?1:0;}
