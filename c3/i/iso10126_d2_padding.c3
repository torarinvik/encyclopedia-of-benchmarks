module iso10126_d2_padding;
fn long iso10126_d2_padding(long *v,usz n,uint8 *out,usz cap) @export("iso10126_d2_padding"){if(v==null||n<2||n>66)return -1;long mode=v[0];if(mode==0){if(n<3)return -1;long off=v[1],len=v[2];if(len<1||len>64||off<0||off>=len||n!=3+(usz)off+(usz)(len-off-1))return -1;for(usz i=3;i<n;i++)if(v[i]<0||v[i]>255)return -1;for(usz i=3+(usz)off;i<n;i++)if(v[i]>=255)return -1;usz bytes=(usz)len+1;if(out==null||cap<bytes)return -2;uint8 count=(uint8)(len-off);out[0]=count;usz at=1;for(long i=0;i<off;i++){out[at]=(uint8)v[3+(usz)i];at++;}for(usz i=3+(usz)off;i<n;i++){out[at]=(uint8)v[i];at++;}out[at]=count;return (long)bytes;}if((mode!=1&&mode!=2)||n<3)return -1;long len=v[1];if(len<1||len>64||n!=2+(usz)len)return -1;for(usz i=2;i<n;i++)if(v[i]<0||v[i]>255)return -1;long count=v[n-1];if(count<1||count>len)return -1;usz bytes=mode==1?(usz)(len-count):1;if(out==null||cap<bytes)return -2;if(mode==1){for(usz i=0;i<bytes;i++)out[i]=(uint8)v[2+i];}else out[0]=(uint8)count;return (long)bytes;}
