module iso7816_d4_padding;
fn long iso7816_d4_padding(long*v,usz n) @export("iso7816_d4_padding"){if(n<3||n>27)return -1;long mode=v[0],block=v[1],len=v[2];if((mode<0||mode>2)||(mode==0&&(block<1||block>8))||(mode!=0&&block!=0)||len<0||len>24||n!=usz(len+3))return -1;ubyte b[32];for(long i=0;i<len;i++){if(v[i+3]<0||v[i+3]>255)return -1;b[i]=ubyte(v[i+3]);}if(mode==0){long out=(len/block+1)*block;if(out>32)return -1;b[len]=128;for(long i=len+1;i<out;i++)b[i]=0;return out-len;}if(mode==1){long i=len-1;while(i>=0&&b[i]==0)i--;return i>=0&&b[i]==128?i:-1;}long marker=-1;bool zero_suffix=true;for(long j=len-1;j>=0;j--){if(zero_suffix&&b[j]==128)marker=j;if(b[j]!=0)zero_suffix=false;}return marker>=0?len-marker:-1;}
