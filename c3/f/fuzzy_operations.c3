module fuzzy_operations;
import "math";
void putd(char *o,usz p,double x){ulong b=@bitcast(ulong,x);for(usz k=0;k<8;k++){o[p+k]=(char)(b&255);b>>=8;}}
fn long fuzzy_operations(long *v,usz n,char *o,usz cap) @export("fuzzy_operations"){if(v==null||n!=8)return -1;int op=(int)v[0];if(op<0||op>3)return -1;for(usz i=1;i<8;i++)if(v[i]<0||v[i]>1000)return -1;if(op==0){for(usz i=4;i<8;i++)if(v[i]!=0)return -1;}else if(op==1||op==2){if(v[7]!=0)return -1;}else if(v[4]!=0||v[5]!=0||v[6]!=0||!(v[1]<v[2]&&v[2]<v[3]))return -1;usz size=op==3?8:24;if(o==null||cap<size)return -2;double a=(double)v[1]/1000.0,b=(double)v[2]/1000.0,c=(double)v[3]/1000.0;if(op==0){putd(o,0,1.0-c);putd(o,8,1.0-a);putd(o,16,1.0-b);}else if(op==1){putd(o,0,math.max(a,(double)v[4]/1000.0));putd(o,8,math.min(c,(double)v[6]/1000.0));putd(o,16,(b+(double)v[5]/1000.0)/2.0);}else if(op==2){putd(o,0,math.min(a,(double)v[4]/1000.0));putd(o,8,(b+(double)v[5]/1000.0)/2.0);putd(o,16,math.max(c,(double)v[6]/1000.0));}else{double x=(double)v[7]/1000.0;double y=x<=a||x>=c?0.0:x<=b?(x-a)/(b-a):(c-x)/(c-b);putd(o,0,y);}return (long)size;}
