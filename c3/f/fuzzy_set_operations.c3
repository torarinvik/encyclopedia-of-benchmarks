module fuzzy_set_operations;
import "math";
void putd(char *o,usz p,double x){ulong b=@bitcast(ulong,x);for(usz k=0;k<8;k++){o[p+k]=(char)(b&255);b>>=8;}}
fn long fuzzy_set_operations(long *v,usz n,char *o,usz cap) @export("fuzzy_set_operations"){if(v==null||n<8)return -1;int op=(int)v[0],m=(int)v[1];if(op<0||op>8||m<1||m>8||n!=5+(usz)m*3)return -1;for(usz i=5;i<n;i++)if(v[i]<0||v[i]>1000)return -1;long l=v[2],p=v[3],r=v[4];if(op==0){if(l<0||p<l||r<p||r>1000)return -1;for(int i=0;i<m;i++)if(v[5+m+i]!=0||v[5+2*m+i]!=0)return -1;}else{if(l!=0||p!=0||r!=0)return -1;for(int i=0;i<m;i++)if(v[5+i]!=0)return -1;}if(o==null||cap<(usz)m*8)return -2;for(int i=0;i<m;i++){double z;if(op==0){double x=(double)v[5+i]/1000.0,a=(double)l/1000.0,b=(double)p/1000.0,c=(double)r/1000.0;double u=b>a?(x-a)/(b-a):(x<b?0:1),w=c>b?(c-x)/(c-b):(x>c?0:1);z=math.max(0,math.min(1,math.min(u,w)));}else{double a=(double)v[5+m+i]/1000.0,b=(double)v[5+2*m+i]/1000.0;switch(op){case 1:z=math.max(a,b);break;case 2:z=math.min(a,b);break;case 3:z=1-a;break;case 4:z=math.min(a,1-b);break;case 5:z=a+b-a*b;break;case 6:z=a*b;break;case 7:z=math.min(1,a+b);break;default:z=math.max(0,a+b-1);}}putd(o,(usz)i*8,z);}return (long)m*8;}
