module fft_bluestein;
extern fn double cos(double x);
extern fn double sin(double x);
fn long quant(double x){double z=x*1000000.0;return (long)(z>=0?z+0.5:z-0.5);}
fn void put(char* out,usz p,long x){ulong b=(ulong)x;for(usz i=0;i<8;i++){out[p+i]=(char)(b&255);b>>=8;}}
fn void fft(double* r,double* im,usz n,bool inverse){usz j=0;for(usz i=1;i<n;i++){usz bit=n>>1;while((j&bit)!=0){j^=bit;bit>>=1;}j^=bit;if(i<j){double t=r[i];r[i]=r[j];r[j]=t;t=im[i];im[i]=im[j];im[j]=t;}}for(usz len=2;len<=n;len*=2){double a=(inverse?1.0:-1.0)*6.2831853071795864769/(double)len;double cr=cos(a);double ci=sin(a);for(usz s=0;s<n;s+=len){double wr=1.0;double wi=0.0;for(usz k=0;k<len/2;k++){usz u=s+k;usz v=u+len/2;double pr=wr*r[v]-wi*im[v];double pi=wr*im[v]+wi*r[v];double ur=r[u];double ui=im[u];r[u]=ur+pr;im[u]=ui+pi;r[v]=ur-pr;im[v]=ui-pi;double nr=wr*cr-wi*ci;wi=wr*ci+wi*cr;wr=nr;}}}if(inverse)for(usz i=0;i<n;i++){r[i]/=(double)n;im[i]/=(double)n;}}
fn long fft_bluestein(long* v,usz n,char* out,usz cap) @export("fft_bluestein"){if(v==null||n<2||n>9)return -1;long m=v[0];if(m<1||m>8||n!=(usz)m+1)return -1;for(usz i=0;i<(usz)m;i++)if(v[i+1]<-8||v[i+1]>8)return -1;usz z=1;usz need=(usz)(3*m-2);while(z<need)z*=2;usz bytes=(usz)m*16;if(out==null||cap<bytes)return -2;double[32] ar;double[32] ai;double[32] br;double[32] bi;for(usz q=0;q<32;q++){ar[q]=0;ai[q]=0;br[q]=0;bi[q]=0;}for(usz j=0;j<(usz)m;j++){double a=-3.14159265358979323846*(double)j*(double)j/(double)m;ar[j]=(double)v[j+1]*cos(a);ai[j]=(double)v[j+1]*sin(a);}for(long k=-(m-1);k<=m-1;k++){double a=3.14159265358979323846*(double)k*(double)k/(double)m;usz ix=(usz)(k+m-1);br[ix]=cos(a);bi[ix]=sin(a);}fft(&ar[0],&ai[0],z,false);fft(&br[0],&bi[0],z,false);for(usz i=0;i<z;i++){double x=ar[i]*br[i]-ai[i]*bi[i];ai[i]=ar[i]*bi[i]+ai[i]*br[i];ar[i]=x;}fft(&ar[0],&ai[0],z,true);for(usz k=0;k<(usz)m;k++){double a=-3.14159265358979323846*(double)k*(double)k/(double)m;double cr=cos(a);double ci=sin(a);double re=ar[k+(usz)m-1]*cr-ai[k+(usz)m-1]*ci;double im=ar[k+(usz)m-1]*ci+ai[k+(usz)m-1]*cr;put(out,16*k,quant(re));put(out,16*k+8,quant(im));}return (long)bytes;}
