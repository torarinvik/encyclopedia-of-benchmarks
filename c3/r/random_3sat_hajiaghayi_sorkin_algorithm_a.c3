module random_3sat_hajiaghayi_sorkin_algorithm_a;
const int MAX_VARS=12;const int MAX_CLAUSES=32;const int MAX_INPUT=98;const int MAX_OUTPUT=104;
fn void put_i64(char*out,usz at,long value){ulong bits=(ulong)value;for(usz byte=0;byte<8;byte++){out[at+byte]=(char)(bits&255);bits>>=8;}}
fn bool reduce_by_literal(int* clauses,int* lengths,bool* active,int count,int literal){for(int c=0;c<count;c++){if(!active[c])continue;bool satisfied=false;for(int j=0;j<lengths[c];j++)if(clauses[3*c+j]==literal)satisfied=true;if(satisfied){active[c]=false;continue;}int write=0;for(int j=0;j<lengths[c];j++)if(clauses[3*c+j]!=-literal){clauses[3*c+write]=clauses[3*c+j];write++;}lengths[c]=write;if(write==0)return false;}return true;}
fn int choose_free_literal(int n,int[3][MAX_CLAUSES] clauses,int[MAX_CLAUSES] lengths,bool[MAX_CLAUSES] active,int[MAX_VARS] assigned){int[MAX_VARS] positive=zeroed;int[MAX_VARS] negative=zeroed;for(int c=0;c<MAX_CLAUSES;c++)if(active[c])for(int j=0;j<lengths[c];j++){int literal=clauses[c][j],v=(literal>0?literal:-literal)-1;if(literal>0)positive[v]++;else negative[v]++;}int variable=-1;for(int v=0;v<n;v++)if(assigned[v]==0&&(positive[v]==0||negative[v]==0)){variable=v;break;}if(variable<0){int best_difference=-1,best_total=-1;for(int v=0;v<n;v++)if(assigned[v]==0){int difference=positive[v]-negative[v];if(difference<0)difference=-difference;int total=positive[v]+negative[v];if(difference>best_difference||(difference==best_difference&&total>best_total)){best_difference=difference;best_total=total;variable=v;}}}if(variable<0)return 0;return positive[variable]<negative[variable]?variable+1:-(variable+1);}
fn long random_3sat_hajiaghayi_sorkin_algorithm_a(long*input,usz length,char*output,usz capacity) @export("random_3sat_hajiaghayi_sorkin_algorithm_a"){
 if(input==null||length<(usz)2||length>(usz)MAX_INPUT||input[0]<3||input[0]>MAX_VARS||input[1]<0||input[1]>MAX_CLAUSES)return -1;int n=(int)input[0],m=(int)input[1];if(length!=(usz)(2+3*m))return -1;
 int[3][MAX_CLAUSES] clauses=zeroed;int[MAX_CLAUSES] lengths=zeroed;bool[MAX_CLAUSES] active=zeroed;
 for(int c=0;c<m;c++){bool[MAX_VARS] seen=zeroed;for(int j=0;j<3;j++){long raw=input[2+3*c+j];if(raw==0||raw< -n||raw>n)return -1;int v=(int)(raw>0?raw:-raw)-1;if(seen[v])return -1;seen[v]=true;clauses[c][j]=(int)raw;}lengths[c]=3;active[c]=true;}
 int[MAX_VARS] assigned=zeroed;int assigned_count=0;bool failed=false;
 while(assigned_count<n&&!failed){int chosen=choose_free_literal(n,clauses,lengths,active,assigned);if(chosen==0){failed=true;break;}int v=(chosen>0?chosen:-chosen)-1;assigned[v]=chosen>0?1:-1;assigned_count++;if(!reduce_by_literal(&clauses[0][0],&lengths[0],&active[0],m,chosen)){failed=true;break;}while(!failed){int unit=0;for(int c=0;c<m;c++)if(active[c]&&lengths[c]==1){unit=clauses[c][0];break;}if(unit==0)break;v=(unit>0?unit:-unit)-1;assigned[v]=unit>0?1:-1;assigned_count++;if(!reduce_by_literal(&clauses[0][0],&lengths[0],&active[0],m,unit))failed=true;}}
 usz bytes=(usz)(8*(n+1));if(output==null||capacity<bytes)return -2;char[MAX_OUTPUT] staged=zeroed;put_i64(&staged[0],0,failed?0:1);for(int v=0;v<n;v++)put_i64(&staged[0],(usz)(8*(v+1)),(long)assigned[v]);for(usz b=0;b<bytes;b++)output[b]=staged[b];return (long)bytes;
}
