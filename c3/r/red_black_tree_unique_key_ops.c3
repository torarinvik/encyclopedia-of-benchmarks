module red_black_tree_unique_key_ops;
const usz MAX_OPS = 128;
struct Node { long key; int left; int right; int parent; bool red; }
fn void left_rotate(Node* t, int* root, int x) { int y=t[x].right; t[x].right=t[y].left; if(t[y].left!=0)t[t[y].left].parent=x; t[y].parent=t[x].parent; if(t[x].parent==0)*root=y; else if(x==t[t[x].parent].left)t[t[x].parent].left=y; else t[t[x].parent].right=y; t[y].left=x;t[x].parent=y; }
fn void right_rotate(Node* t, int* root, int y) { int x=t[y].left;t[y].left=t[x].right;if(t[x].right!=0)t[t[x].right].parent=y;t[x].parent=t[y].parent;if(t[y].parent==0)*root=x;else if(y==t[t[y].parent].right)t[t[y].parent].right=x;else t[t[y].parent].left=x;t[x].right=y;t[y].parent=x; }
fn int find_node(Node* t,int root,long key){while(root!=0&&t[root].key!=key)root=key<t[root].key?t[root].left:t[root].right;return root;}
fn void insert_node(Node* t,int* root,int z){int y=0,x=*root;while(x!=0){y=x;x=t[z].key<t[x].key?t[x].left:t[x].right;}t[z].parent=y;if(y==0)*root=z;else if(t[z].key<t[y].key)t[y].left=z;else t[y].right=z;t[z].left=0;t[z].right=0;t[z].red=true;while(t[t[z].parent].red){int p=t[z].parent,g=t[p].parent;if(p==t[g].left){y=t[g].right;if(t[y].red){t[p].red=false;t[y].red=false;t[g].red=true;z=g;}else{if(z==t[p].right){z=p;left_rotate(t,root,z);}p=t[z].parent;g=t[p].parent;t[p].red=false;t[g].red=true;right_rotate(t,root,g);}}else{y=t[g].left;if(t[y].red){t[p].red=false;t[y].red=false;t[g].red=true;z=g;}else{if(z==t[p].left){z=p;right_rotate(t,root,z);}p=t[z].parent;g=t[p].parent;t[p].red=false;t[g].red=true;left_rotate(t,root,g);}}}t[*root].red=false;}
fn int minimum(Node* t,int x){while(t[x].left!=0)x=t[x].left;return x;}
fn void transplant(Node* t,int* root,int u,int v){if(t[u].parent==0)*root=v;else if(u==t[t[u].parent].left)t[t[u].parent].left=v;else t[t[u].parent].right=v;t[v].parent=t[u].parent;}
fn void delete_fix(Node* t,int* root,int x){while(x!=*root&&!t[x].red){int p=t[x].parent;if(x==t[p].left){int w=t[p].right;if(t[w].red){t[w].red=false;t[p].red=true;left_rotate(t,root,p);w=t[t[x].parent].right;}if(!t[t[w].left].red&&!t[t[w].right].red){t[w].red=true;x=t[x].parent;}else{if(!t[t[w].right].red){t[t[w].left].red=false;t[w].red=true;right_rotate(t,root,w);w=t[t[x].parent].right;}p=t[x].parent;t[w].red=t[p].red;t[p].red=false;t[t[w].right].red=false;left_rotate(t,root,p);x=*root;}}else{int w=t[p].left;if(t[w].red){t[w].red=false;t[p].red=true;right_rotate(t,root,p);w=t[t[x].parent].left;}if(!t[t[w].right].red&&!t[t[w].left].red){t[w].red=true;x=t[x].parent;}else{if(!t[t[w].left].red){t[t[w].right].red=false;t[w].red=true;left_rotate(t,root,w);w=t[t[x].parent].left;}p=t[x].parent;t[w].red=t[p].red;t[p].red=false;t[t[w].left].red=false;right_rotate(t,root,p);x=*root;}}}t[x].red=false;}
fn void delete_node(Node* t,int* root,int z){int y=z,x=0;bool was_red=t[y].red;if(t[z].left==0){x=t[z].right;transplant(t,root,z,t[z].right);}else if(t[z].right==0){x=t[z].left;transplant(t,root,z,t[z].left);}else{y=minimum(t,t[z].right);was_red=t[y].red;x=t[y].right;if(t[y].parent==z)t[x].parent=y;else{transplant(t,root,y,t[y].right);t[y].right=t[z].right;t[t[y].right].parent=y;}transplant(t,root,z,y);t[y].left=t[z].left;t[t[y].left].parent=y;t[y].red=t[z].red;}if(!was_red)delete_fix(t,root,x);}
fn void put_i64(char* output,usz offset,long value){ulong bits=(ulong)value;for(usz i=0;i<8;i++){output[offset+i]=(char)(bits&255);bits>>=8;}}
fn long red_black_tree_unique_key_ops(long* input,usz length,char* output,usz capacity) @export("red_black_tree_unique_key_ops") {
if(input==null||length<1)return -1;long n64=input[0];if(n64<0||n64>(long)MAX_OPS||length!=(usz)(1+2*n64))return -1;usz n=(usz)n64,ac=0,sc=0;long[MAX_OPS] active;
for(usz i=0;i<n;i++){long op=input[1+2*i],key=input[2+2*i];if(op<0||op>2||key<(-2147483647-1)||key>2147483647)return -1;usz f=ac;for(usz j=0;j<ac;j++)if(active[j]==key){f=j;break;}if(op==0){if(f!=ac||ac>=MAX_OPS)return -1;active[ac++]=key;}else if(op==1)sc++;else{if(f==ac)return -1;for(usz j=f+1;j<ac;j++)active[j-1]=active[j];ac--;}}
Node[MAX_OPS+1] t;for(usz i=0;i<MAX_OPS+1;i++){t[i].key=0;t[i].left=0;t[i].right=0;t[i].parent=0;t[i].red=false;}int root=0,next=1;long[MAX_OPS] results;usz rc=0;for(usz i=0;i<n;i++){long op=input[1+2*i],key=input[2+2*i];if(op==0){t[next].key=key;t[next].red=false;insert_node(&t,&root,next++);}else if(op==1)results[rc++]=find_node(&t,root,key)!=0?1:0;else delete_node(&t,&root,find_node(&t,root,key));}
usz bytes=(2+ac+sc)*8;if(output==null||capacity<bytes)return -2;put_i64(output,0,(long)ac);int[MAX_OPS] stack;usz top=0,out=1;int current=root;while(current!=0||top>0){while(current!=0){stack[top++]=current;current=t[current].left;}current=stack[--top];put_i64(output,out++*8,t[current].key);current=t[current].right;}put_i64(output,out++*8,(long)sc);for(usz i=0;i<sc;i++)put_i64(output,out++*8,results[i]);return (long)bytes;
}
