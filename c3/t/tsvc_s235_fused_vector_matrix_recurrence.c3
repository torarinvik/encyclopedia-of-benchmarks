// Clean-room TSVC s235 profile; see package rights note.
module tsvc_s235_fused_vector_matrix_recurrence;
fn void put64(&usz o,usz p,long v){usz b=(usz)v;for(usz k=0;k<8;k++){o[k]=(u8)(b&255);b>>=8;}}
fn long tsvc_s235_fused_vector_matrix_recurrence(&long in,usz len,&u8 out,usz cap){if(in==null||len<15||len>153)return -1;long nr=in[0];if(nr<2||nr>8)return -1;usz n=(usz)nr,nn=n*n;if(len!=1+3*n+2*nn)return -1;long a[8],b[8],c[8],aa[64],bb[64];usz p=1;for(usz i=0;i<n;i++){long x=in[p++];if(x< -1||x>1)return -1;a[i]=x;}for(usz i=0;i<n;i++){long x=in[p++];if(x< -1||x>1)return -1;b[i]=x;}for(usz i=0;i<n;i++){long x=in[p++];if(x< -1||x>1)return -1;c[i]=x;}for(usz i=0;i<nn;i++){long x=in[p++];if(x< -1||x>1)return -1;aa[i]=x;}for(usz i=0;i<nn;i++){long x=in[p++];if(x< -1||x>1)return -1;bb[i]=x;}if(out==null||cap<8*(n+nn))return -2;for(usz col=0;col<n;col++){a[col]+=b[col]*c[col];for(usz row=1;row<n;row++){usz k=row*n+col;aa[k]=aa[k-n]+bb[k]*a[col];}}for(usz i=0;i<n;i++)put64(out+8*i,a[i]);for(usz i=0;i<nn;i++)put64(out+8*(n+i),aa[i]);return (n+nn).long();}
