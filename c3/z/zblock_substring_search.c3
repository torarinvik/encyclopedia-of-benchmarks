module zblock_substring_search;
fn long zblock_substring_search(long* a,usz length) @export("zblock_substring_search"){if(a==null||length<3)return -1;long tn=a[0];long pn=a[1];if(tn<0||tn>256||pn<1||pn>64||length!=(usz)(tn+pn+2))return -1;for(usz i=2;i<length;i++)if(a[i]<0||a[i]>127||a[i]==36)return -1;usz tl=(usz)tn;usz pl=(usz)pn;usz n=tl+pl+1;long s[321];usz z[321];for(usz i=0;i<pl;i++)s[i]=a[(usz)(2+tn)+i];s[pl]=-1;for(usz i=0;i<tl;i++)s[pl+1+i]=a[2+i];usz left=0;usz right=0;for(usz i=1;i<n;i++){z[i]=i<=right?(right-i+1<z[i-left]?right-i+1:z[i-left]):0;while(i+z[i]<n&&s[z[i]]==s[i+z[i]])z[i]++;if(i+z[i]>0&&i+z[i]-1>right){left=i;right=i+z[i]-1;}}long found=0;for(usz i=pl+1;i<n;i++)if(z[i]>=pl)found++;return found;}
