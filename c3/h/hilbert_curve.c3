module hilbert_curve;
fn void reverse_points(long *o,usz start,usz count){for(usz i=0;i<count/2;i++){usz a=start+2*i,b=start+2*(count-1-i);long x=o[a],y=o[a+1];o[a]=o[b];o[a+1]=o[b+1];o[b]=x;o[b+1]=y;}}
fn usz curve(long x,long y,long side,int level,int angle,long *o,usz off){long q=side/4;long[8] p={x+q,y+q,x-q,y+q,x-q,y-q,x+q,y-q};angle=((angle%4)+4)%4;long[8] r;for(int i=0;i<4;i++){r[2*i]=p[2*((i+angle)%4)];r[2*i+1]=p[2*((i+angle)%4)+1];}if(level==1){for(int i=0;i<4;i++){o[off+2*i]=r[2*i];o[off+2*i+1]=r[2*i+1];}return 4;}long h=side/2;usz n=curve(r[0],r[1],h,level-1,angle+1,o,off);reverse_points(o,off,n);usz n1=curve(r[2],r[3],h,level-1,angle,o,off+2*n);usz n2=curve(r[4],r[5],h,level-1,angle,o,off+2*(n+n1));usz n3=curve(r[6],r[7],h,level-1,angle-1,o,off+2*(n+n1+n2));reverse_points(o,off+2*(n+n1+n2),n3);return n+n1+n2+n3;}
fn long hilbert_curve(long *v,usz n,char *out,usz cap) @export("hilbert_curve"){if(v==null||n!=2||v[0]<1||v[0]>6||v[1]<0||v[1]>3)return -1;usz level=(usz)v[0],points=(usz)1<<(2*level),bytes=points*16;if(out==null||cap<bytes)return -2;long[8192] coords;curve(0,0,(long)1<<(level+1),(int)level,(int)v[1],&coords[0],0);for(usz i=0;i<points*2;i++){ulong b=@bitcast(ulong,coords[i]);for(usz k=0;k<8;k++){out[i*8+k]=(char)(b&255);b>>=8;}}return (long)bytes;}
