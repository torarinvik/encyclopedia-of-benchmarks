module highest_response_ratio_next;
fn void put64(char*o,usz i,long x){ulong v=(ulong)x;for(usz b=0;b<8;b++)o[i*8+b]=(char)(v>>(b*8));}
fn long highest_response_ratio_next(long*v,usz n,char*out,usz cap) @export("highest_response_ratio_next"){if(v==null||n<3||n>129)return -1;long count=v[0];if(count<1||count>64||n!=(usz)(1+2*count))return -1;long[64] a;long[64] b;long[64] tat;bool[64] done;for(usz i=0;i<64;i++)done[i]=false;for(usz i=0;i<(usz)count;i++){a[i]=v[1+2*i];b[i]=v[2+2*i];if(a[i]<0||a[i]>100000||b[i]<1||b[i]>1000)return -1;}for(usz i=1;i<(usz)count;i++)for(usz j=i;j>0&&a[j]<a[j-1];j--){long t=a[j];a[j]=a[j-1];a[j-1]=t;t=b[j];b[j]=b[j-1];b[j-1]=t;}if((usz)count*8>cap||out==null)return -2;long now=0;usz step=0;while(step<(usz)count){long best=-1;long num=0;for(usz i=0;i<(usz)count;i++)if(!done[i]&&a[i]<=now){long cand=now-a[i]+b[i];if(best<0||cand*b[(usz)best]>num*b[i]){best=(long)i;num=cand;}}if(best<0){for(usz i=0;i<(usz)count;i++)if(!done[i]&&(best<0||a[i]<a[(usz)best]))best=(long)i;now=a[(usz)best];continue;}usz k=(usz)best;tat[k]=now+b[k]-a[k];now+=b[k];done[k]=true;step++;}for(usz i=0;i<(usz)count;i++)put64(out,i,tat[i]);return count*8;}
