module hamming_code;
fn long hamming_code(long* a,usz n,char* output,usz cap) @export("hamming_code"){if(a==null||n<3)return -1;long r=a[0],m=a[1];if(r<1||r>5||m<1||m>32||n!=(usz)(2+m)||r+m<=((1L<<r)-(m-1)))return -1;for(usz i=0;i<(usz)m;i++)if(a[2+i]!=48&&a[2+i]!=49)return -1;usz total=(usz)(r+m);if(total<((usz)1<<(r-1)))return -1;if(output==null||cap<total+1)return -2;char code[40];usz data=0;for(usz p=1;p<=total;p++){if((p&(p-1))!=0||p>(((usz)1)<<(r-1)))code[p-1]=(char)a[2+data++];else code[p-1]='0';}for(int bit=0;bit<(int)r;bit++){usz parity=(usz)1<<bit;int value=0;for(usz p=1;p<=total;p++)if((p&parity)!=0&&code[p-1]=='1')value^=1;code[parity-1]=(char)('0'+value);}for(usz i=0;i<total;i++)output[i]=code[i];output[total]=0;return (long)total;}
