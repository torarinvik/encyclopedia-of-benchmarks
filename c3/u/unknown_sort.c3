module unknown_sort;
const usz MAX_INPUT=256;
fn void store_le(char* out,usz off,long x){ulong u=(ulong)x;for(usz b=0;b<8;b++)out[off+b]=(char)((u>>(8*b))&255);}
fn long unknown_sort(long* v,usz n,char* output,usz capacity) @export("unknown_sort"){if(v==null||n>257)return -1;if(n>MAX_INPUT)return -1;long[MAX_INPUT] work;long[MAX_INPUT] starts;long[MAX_INPUT] ends;long[MAX_INPUT] result;for(usz i=0;i<n;i++)work[i]=v[i];usz count=n,used=0,end_count=0;while(count>1){usz min_i=0,max_i=0;for(usz i=1;i<count;i++){if(work[i]<work[min_i])min_i=i;if(work[i]>work[max_i])max_i=i;}long min_v=work[min_i],max_v=work[max_i];starts[used]=min_v;used++;ends[end_count]=max_v;end_count++;for(usz i=min_i;i+1<count;i++)work[i]=work[i+1];count--;usz max_pos=0;while(max_pos<count&&work[max_pos]!=max_v)max_pos++;if(max_pos==count)return -1;for(usz i=max_pos;i+1<count;i++)work[i]=work[i+1];count--;}usz out_n=0;for(usz i=0;i<used;i++){result[out_n]=starts[i];out_n++;}for(usz i=0;i<count;i++){result[out_n]=work[i];out_n++;}usz i=end_count;while(i>0){i--;result[out_n]=ends[i];out_n++;}usz bytes=8*out_n;if(output==null||capacity<bytes)return -2;for(usz j=0;j<out_n;j++)store_le(output,8*j,result[j]);return (long)bytes;}
