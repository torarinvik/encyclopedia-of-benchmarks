module kahn;
fn long kahn(long*v,usz n) @export("kahn"){if(v==null||n<2||n>258)return -2;long nv=v[0],ne=v[1];if(nv<0||nv>32||ne<0||ne>128||n!=2+2*(usz)ne)return -2;bool[32][32] adj=zeroed;long[32] ind=zeroed;long[32] q;for(usz i=0;i<(usz)ne;i++){long a=v[2+2*i],b=v[3+2*i];if(a<0||a>=nv||b<0||b>=nv)return -2;if(!adj[(usz)a][(usz)b]){adj[(usz)a][(usz)b]=true;ind[(usz)b]++;}}usz head=0,tail=0;for(usz i=0;i<(usz)nv;i++)if(ind[i]==0){q[tail]=i;tail++;}while(head<tail){usz x=q[head];head++;for(usz y=0;y<(usz)nv;y++)if(adj[x][y]){ind[y]--;if(ind[y]==0){q[tail]=y;tail++;}}}if(tail==(usz)nv)return nv;return -1;}
