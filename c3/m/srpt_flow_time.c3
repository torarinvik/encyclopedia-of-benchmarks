module srpt_flow_time;
const usz MAX_N=12;const usz MAX_INPUT=26;
fn void put64(char*o,usz p,long x){ulong b=(ulong)x;for(usz j=0;j<8;j+=1){o[p+j]=(char)(b&255);b>>=8;}}
long srpt_flow_time(long*in,usz len,char*out,usz cap) @export("srpt_flow_time"){
 if(in==null||len<4||len>MAX_INPUT)return -1;long mr=in[0],nr=in[1];if(mr<1||mr>4||nr<1||nr>12||len!=2+2*(usz)nr)return -1;usz machines=(usz)mr,n=(usz)nr;long release[12],remaining[12],completion[12];for(usz i=0;i<n;i+=1){release[i]=in[2+2*i];remaining[i]=in[3+2*i];if(release[i]<0||release[i]>50||remaining[i]<1||remaining[i]>10)return -1;}usz bytes=8*(1+n);if(out==null||cap<bytes)return -2;long time=0;usz finished=0;while(finished<n){usz selected[12],selected_count=0;bool[12] chosen=zeroed;for(usz machine=0;machine<machines;machine+=1){usz best=n;for(usz i=0;i<n;i+=1)if(!chosen[i]&&remaining[i]>0&&release[i]<=time&&(best==n||remaining[i]<remaining[best]||(remaining[i]==remaining[best]&&i<best)))best=i;if(best==n)break;chosen[best]=true;selected[selected_count]=best;selected_count+=1;}if(selected_count==0){long next=51;for(usz i=0;i<n;i+=1)if(remaining[i]>0&&release[i]<next)next=release[i];time=next;continue;}time+=1;for(usz j=0;j<selected_count;j+=1){usz i=selected[j];remaining[i]-=1;if(remaining[i]==0){completion[i]=time;finished+=1;}}}long total=0;for(usz i=0;i<n;i+=1)total+=completion[i]-release[i];put64(out,0,total);for(usz i=0;i<n;i+=1)put64(out,8*(1+i),completion[i]);return (long)bytes;
}
