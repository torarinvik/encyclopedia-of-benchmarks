module cbench_security_rijndael_decrypt;
const usz INPUT_BYTES=48; const usz BLOCK_BYTES=16;
fn uint8 gm(uint8 aa,uint8 bb){uint8 a=aa,b=bb,r=0;while(b!=0){if((b&1)!=0)r^=a;uint16 d=(uint16(a)<<1)^((a&0x80)!=0?0x1b:0);a=(uint8)d;b>>=1;}return r;}
fn uint8 gp(uint8 aa,uint32 nn){uint8 a=aa,r=1;uint32 n=nn;while(n!=0){if((n&1)!=0)r=gm(r,a);a=gm(a,a);n>>=1;}return r;}
fn uint8 rot8(uint8 a,usz n){return (uint8)((uint16(a)<<n)|(uint16(a)>>(8-n)));}
fn void dec(uint8* key,uint8* input,uint8* output){uint8[256] s,iv;uint8[240] rk;uint8[7] rc={1,2,4,8,16,32,64};for(usz x=0;x<256;x++){uint8 q=x==0?0:gp((uint8)x,254);s[x]=q^rot8(q,1)^rot8(q,2)^rot8(q,3)^rot8(q,4)^0x63;}for(usz x=0;x<256;x++)iv[s[x]]=(uint8)x;for(usz i=0;i<32;i++)rk[i]=key[i];usz w=32;while(w<240){usz wi=w/4;uint8[4] t;for(usz j=0;j<4;j++)t[j]=rk[w-4+j];if(wi%8==0){uint8 a=t[0];t[0]=s[t[1]]^rc[wi/8-1];t[1]=s[t[2]];t[2]=s[t[3]];t[3]=s[a];}else if(wi%8==4){for(usz j=0;j<4;j++)t[j]=s[t[j]];}for(usz j=0;j<4;j++){rk[w]=rk[w-32]^t[j];w++;}}
 uint8[16] st;for(usz i=0;i<16;i++)st[i]=input[i]^rk[224+i];for(int round=13;round>0;round--){uint8[16] p;for(usz i=0;i<16;i++)p[i]=st[i];for(usz c=0;c<4;c++)for(usz r=0;r<4;r++)st[r+4*c]=iv[p[r+4*((c+4-r)%4)]];for(usz i=0;i<16;i++)st[i]^=rk[round*16+i];for(usz c=0;c<4;c++){usz o=4*c;uint8 a=st[o],b=st[o+1],d=st[o+2],e=st[o+3];st[o]=gm(a,14)^gm(b,11)^gm(d,13)^gm(e,9);st[o+1]=gm(a,9)^gm(b,14)^gm(d,11)^gm(e,13);st[o+2]=gm(a,13)^gm(b,9)^gm(d,14)^gm(e,11);st[o+3]=gm(a,11)^gm(b,13)^gm(d,9)^gm(e,14);}}
 uint8[16] p;for(usz i=0;i<16;i++)p[i]=st[i];for(usz c=0;c<4;c++)for(usz r=0;r<4;r++)st[r+4*c]=iv[p[r+4*((c+4-r)%4)]];for(usz i=0;i<16;i++)output[i]=st[i]^rk[i];}
fn long cbench_security_rijndael_decrypt(long* values,usz length,uint8* output,usz capacity) @export("cbench_security_rijndael_decrypt"){if(values==null||length!=48)return -1;for(usz i=0;i<48;i++)if(values[i]<0||values[i]>255)return -1;if(output==null||capacity<16)return -2;uint8[32] key;uint8[16] input,plain;for(usz i=0;i<32;i++)key[i]=(uint8)values[i];for(usz i=0;i<16;i++)input[i]=(uint8)values[32+i];dec(&key[0],&input[0],&plain[0]);for(usz i=0;i<16;i++)output[i]=plain[i];return 16;}
