module minimum_tickets_cost;
fn long minimum_tickets_cost(long* v,usz n) @export("minimum_tickets_cost"){if(v==null||n<4||n>369||v[0]<0||v[0]>365)return -1;usz d=(usz)v[0];if(n!=d+4)return -1;bool travel[366]={};for(usz i=0;i<d;i++){long x=v[i+1];if(x<1||x>365||travel[(usz)x])return -1;travel[(usz)x]=true;}long c[3];for(usz i=0;i<3;i++){c[i]=v[d+1+i];if(c[i]<0||c[i]>1000000)return -1;}long dp[397]={};for(long day=365;day>=1;day--){dp[(usz)day]=dp[(usz)day+1];if(travel[(usz)day]){long a=c[0]+dp[(usz)day+1],b=c[1]+dp[(usz)day+7],z=c[2]+dp[(usz)day+30];if(b<a)a=b;if(z<a)a=z;dp[(usz)day]=a;}}return dp[1];}
