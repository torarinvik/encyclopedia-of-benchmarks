module median_two_array;
fn double median_two_array(long* a, usz len) @export("median_two_array") { if(a==null||len<2||len>259||a[0]<0||a[1]<0||a[0]+a[1]<1||a[0]+a[1]>256||(usz)(a[0]+a[1])+2!=len)return -1.0e300;usz n=(usz)(a[0]+a[1]),n1=(usz)a[0];long v[256];for(usz i=0;i<n;i++){v[i]=a[i+2];if(v[i]<-1000000||v[i]>1000000)return -1.0e300;if(i<n1&&i>0&&v[i]<v[i-1])return -1.0e300;if(i>=n1&&i>n1&&v[i]<v[i-1])return -1.0e300;}for(usz i=1;i<n;i++){long x=v[i];usz j=i;while(j>0&&v[j-1]>x){v[j]=v[j-1];j--;}v[j]=x;}usz m=n/2;return n%2==1?(double)v[m]:((double)v[m-1]+(double)v[m])/2.0;}
