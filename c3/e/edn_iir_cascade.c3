module edn_iir_cascade;
fn void put64(uint8* out,usz pos,long value){ulong u=(ulong)value;for(usz j=0;j<8;j++)out[pos+j]=(uint8)(u>>(8*j));}
fn long edn_iir_cascade(long* v,usz n,uint8* out,usz cap) @export("edn_iir_cascade"){if(v==null||n<2||n>50)return -1;long count=v[0],x=v[1];if(count<1||count>8||x< -1024||x>1023||n!=2+6*(usz)count)return -1;usz q=(usz)count;long[32] c;long[16] s;for(usz i=0;i<4*q;i++){c[i]=v[2+i];if(c[i]< -1024||c[i]>1023)return -1;}for(usz i=0;i<2*q;i++){s[i]=v[2+4*q+i];if(s[i]< -1024||s[i]>1023)return -1;}usz bytes=8*(1+2*q);if(out==null||cap<bytes)return -2;for(usz i=0;i<q;i++){long t=x+((c[4*i+2]*s[2*i]+c[4*i+3]*s[2*i+1])>>15);x=t+((c[4*i]*s[2*i]+c[4*i+1]*s[2*i+1])>>15);s[2*i+1]=s[2*i];s[2*i]=t;}put64(out,0,x);for(usz i=0;i<2*q;i++)put64(out,8*(i+1),s[i]);return (long)bytes;}
