module edn_jpeg_dct;
fn void put64(uint8* o,usz p,long x){ulong u=(ulong)x;for(usz j=0;j<8;j++)o[p+j]=(uint8)(u>>(8*j));}
fn short narrow(long x){return (short)x;}
fn void line(short* d,usz base,usz k,int m,int n,short* r){long[12] t;for(usz j=0;j<4;j++){t[j]=(long)d[base+k*j]+d[base+k*(7-j)];t[7-j]=(long)d[base+k*j]-d[base+k*(7-j)];}t[8]=t[0]+t[3];t[9]=t[0]-t[3];t[10]=t[1]+t[2];t[11]=t[1]-t[2];d[base]=narrow((t[8]+t[10])>>m);d[base+4*k]=narrow((t[8]-t[10])>>m);t[8]=(short)(t[11]+t[9])*r[10];d[base+2*k]=narrow(t[8]+(short)((t[9]*r[9])>>n));d[base+6*k]=narrow(t[8]+(short)((t[11]*r[11])>>n));t[0]=(short)(t[4]+t[7])*r[2];t[1]=(short)(t[5]+t[6])*r[0];t[2]=t[4]+t[6];t[3]=t[5]+t[7];t[8]=(short)(t[2]+t[3])*r[8];t[2]=(short)t[2]*r[1]+t[8];t[3]=(short)t[3]*r[3]+t[8];d[base+7*k]=narrow((short)(t[4]*r[4]+t[0]+t[2])>>n);d[base+5*k]=narrow((short)(t[5]*r[6]+t[1]+t[3])>>n);d[base+3*k]=narrow((short)(t[6]*r[5]+t[1]+t[2])>>n);d[base+k]=narrow((short)(t[7]*r[7]+t[0]+t[3])>>n);}
fn long edn_jpeg_dct(long* v,usz n,uint8* out,usz cap) @export("edn_jpeg_dct"){if(v==null||n!=76)return -1;short[64] d;short[12] r;for(usz i=0;i<64;i++){if(v[i]<-8||v[i]>8)return -1;d[i]=(short)v[i];}for(usz i=0;i<12;i++){if(v[64+i]<-32||v[64+i]>31)return -1;r[i]=(short)v[64+i];}if(out==null||cap<512)return -2;for(usz row=0;row<8;row++)line(&d[0],row*8,1,0,13,&r[0]);for(usz col=0;col<8;col++)line(&d[0],col,8,3,16,&r[0]);for(usz i=0;i<64;i++)put64(out,8*i,d[i]);return 512;}
