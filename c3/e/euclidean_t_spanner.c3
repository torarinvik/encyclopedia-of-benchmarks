module euclidean_t_spanner;
extern fn double sqrt(double); extern fn double hypot(double,double); extern fn double fabs(double); extern fn double floor(double); extern fn double fmax(double,double); extern fn double fmin(double,double);
struct Node{int left;int right;int rep;uint64 mask;double cx;double cy;double rx;double ry;double radius;double span;}
struct Ctx{double[8] x;double[8] y;Node[15] nodes;int used;int n;int edge_count;double separation;double[56] edges;}
bool less(Ctx* c,int a,int b,int axis){double a0=axis==0?c.x[a]:c.y[a],b0=axis==0?c.x[b]:c.y[b],a1=axis==0?c.y[a]:c.x[a],b1=axis==0?c.y[b]:c.x[b];return a0<b0||(a0==b0&&(a1<b1||(a1==b1&&a<b)));}
int build(Ctx* c,uint64 mask){int at=c.used++;int[8] members;int n=0,rep=8;double xmin=0,xmax=0,ymin=0,ymax=0;for(int i=0;i<c.n;i++)if(mask&(1u64<<i)){if(n==0){xmin=xmax=c.x[i];ymin=ymax=c.y[i];}else{xmin=fmin(xmin,c.x[i]);xmax=fmax(xmax,c.x[i]);ymin=fmin(ymin,c.y[i]);ymax=fmax(ymax,c.y[i]);}members[n++]=i;if(i<rep)rep=i;}c.nodes[at].left=-1;c.nodes[at].right=-1;c.nodes[at].rep=rep;c.nodes[at].mask=mask;c.nodes[at].cx=(xmin+xmax)/2;c.nodes[at].cy=(ymin+ymax)/2;c.nodes[at].rx=(xmax-xmin)/2;c.nodes[at].ry=(ymax-ymin)/2;c.nodes[at].radius=hypot(c.nodes[at].rx,c.nodes[at].ry);c.nodes[at].span=fmax(xmax-xmin,ymax-ymin);if(n==1)return at;int axis=xmax-xmin>=ymax-ymin?0:1;for(int i=1;i<n;i++){int v=members[i],j=i;while(j>0&&less(c,v,members[j-1],axis)){members[j]=members[j-1];j--;}members[j]=v;}uint64 lm=0,rm=0;int mid=n/2;for(int i=0;i<n;i++)if(i<mid)lm|=1u64<<members[i];else rm|=1u64<<members[i];int l=build(c,lm),r=build(c,rm);c.nodes[at].left=l;c.nodes[at].right=r;return at;}
bool separated(Ctx* c,int a,int b){Node* u=&c.nodes[a],*v=&c.nodes[b];return hypot(u.cx-v.cx,u.cy-v.cy)-u.radius-v.radius>=c.separation*fmax(u.radius,v.radius);}
void cross(Ctx* c,int a,int b){if(separated(c,a,b)){int u=c.nodes[a].rep,v=c.nodes[b].rep;if(u>v){int t=u;u=v;v=t;}c.edges[2*c.edge_count]=u;c.edges[2*c.edge_count+1]=v;c.edge_count++;return;}Node* u=&c.nodes[a],*v=&c.nodes[b];if(u.left<0){cross(c,v.left,a);cross(c,v.right,a);}else if(v.left<0){cross(c,u.left,b);cross(c,u.right,b);}else if(u.span>v.span){cross(c,u.left,b);cross(c,u.right,b);}else{cross(c,a,v.left);cross(c,a,v.right);}}
void visit(Ctx* c,int at){int l=c.nodes[at].left,r=c.nodes[at].right;if(l<0)return;visit(c,l);visit(c,r);cross(c,l,r);}
fn long euclidean_t_spanner(double* input,usz length,double* output,usz capacity) @export("euclidean_t_spanner"){if(input==null||length<6||length>18)return -1;double raw=input[0],t=input[1];if(raw<2||raw>8||raw!=(double)(int)raw||t<1.5||t>4||t!=t)return -1;int n=(int)raw;if(length!=(usz)(2+2*n))return -1;Ctx c={0};c.n=n;c.separation=4*(t+1)/(t-1);for(int i=0;i<n;i++){double x=input[2+2*i],y=input[3+2*i];if(x!=x||y!=y||fabs(x)>1000||fabs(y)>1000||x!=floor(x)||y!=floor(y))return -1;for(int j=0;j<i;j++)if(c.x[j]==x&&c.y[j]==y)return -1;c.x[i]=x;c.y[i]=y;}int root=build(&c,(1u64<<n)-1);visit(&c,root);usz need=(usz)(1+2*c.edge_count);if(output==null||capacity<need)return -2;output[0]=c.edge_count;for(int i=0;i<2*c.edge_count;i++)output[i+1]=c.edges[i];return (long)need;}
