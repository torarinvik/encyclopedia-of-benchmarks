module leftist_heap;
struct Node { long key; int left; int right; int npl; }
fn int merge_nodes(Node*a,int x,int y){if(x<0)return y;if(y<0)return x;if(a[x].key>a[y].key){int t=x;x=y;y=t;}a[x].right=merge_nodes(a,a[x].right,y);if(a[x].left<0){a[x].left=a[x].right;a[x].right=-1;}else{if(a[a[x].left].npl<a[a[x].right].npl){int t=a[x].left;a[x].left=a[x].right;a[x].right=t;}a[x].npl=a[a[x].right].npl+1;}return x;}
fn double leftist_heap(long*v,usz n) @export("leftist_heap"){if(n<1||n>43)return -1e300;long m=v[0];if(m<0||m>14||n!=usz(1+3*m))return -1e300;Node a[14];int roots[2]={-1,-1},used=0,ex=0;long result=0;for(long i=0;i<m;i++){long k=v[1+3*i],h=v[2+3*i],z=v[3+3*i];if(k<0||k>3)return -1e300;if(k==0){if(h<0||h>1||z<0||z>9)return -1e300;a[used].key=z;a[used].left=-1;a[used].right=-1;a[used].npl=0;roots[h]=merge_nodes(a,used++,roots[h]);}else if(k==1){if(h<0||h>1||z!=0||ex>=10)return -1e300;ex++;int r=roots[h],got=-1;if(r>=0){got=(int)a[r].key;int l=a[r].left,rr=a[r].right;roots[h]=merge_nodes(a,l,rr);}result=result*13+got+2;}else if(k==2){if(h!=0||z!=0)return -1e300;roots[0]=merge_nodes(a,roots[0],roots[1]);roots[1]=-1;}else{if(h<0||h>1||z!=0)return -1e300;roots[h]=-1;}}return (double)result;}
