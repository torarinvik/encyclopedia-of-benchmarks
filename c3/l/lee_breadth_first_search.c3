module lee_breadth_first_search;
fn long lee_breadth_first_search(long*v,usz n) @export("lee_breadth_first_search"){if(v==null||n<6||n>70)return -2;long r=v[0];long c=v[1];long sr=v[2];long sc=v[3];long dr=v[4];long dc=v[5];if(r<1||r>8||c<1||c>8||n!=6+usz(r*c)||sr<0||sr>=r||dr<0||dr>=r||sc<0||sc>=c||dc<0||dc>=c)return -2;long a[64];long d[64];long q[64];for(usz i=0;i<usz(r*c);i++){a[i]=v[6+i];if(a[i]!=0&&a[i]!=1)return -2;d[i]=-1;}long s=sr*c+sc;long t=dr*c+dc;if(a[s]==0||a[t]==0)return -1;usz h=0;usz z=1;q[0]=s;d[s]=0;while(h<z){long u=q[h];h++;if(u==t)return d[u];long y=u/c;long x=u%c;long ys[4]={y-1,y,y,y+1};long xs[4]={x,x-1,x+1,x};for(usz k=0;k<4;k++)if(ys[k]>=0&&ys[k]<r&&xs[k]>=0&&xs[k]<c){long w=ys[k]*c+xs[k];if(a[w]==1&&d[w]<0){d[w]=d[u]+1;q[z]=w;z++;}}}return -1;}
