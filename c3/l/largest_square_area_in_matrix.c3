module largest_square_area_in_matrix;
fn long largest_square_area_in_matrix(long*v,usz n) @export("largest_square_area_in_matrix"){if(v==null||n<2||n>66)return -2;long r=v[0];long c=v[1];if(r<1||r>8||c<1||c>8||n!=2+usz(r*c))return -2;long a[64];long dp[9][9];for(usz i=0;i<9;i++)for(usz j=0;j<9;j++)dp[i][j]=0;for(long i=0;i<r*c;i++){a[i]=v[2+i];if(a[i]!=0&&a[i]!=1)return -2;}long best=0;for(long i=r;i>0;){i--;for(long j=c;j>0;){j--;if(a[i*c+j]==1){long m=dp[i+1][j];if(dp[i][j+1]<m)m=dp[i][j+1];if(dp[i+1][j+1]<m)m=dp[i+1][j+1];dp[i][j]=1+m;if(dp[i][j]>best)best=dp[i][j];}}}return best;}
