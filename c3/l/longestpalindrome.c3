module longestpalindrome;
fn long longestpalindrome(long*v,usz n) @export("longestpalindrome"){if(v==null||n<1||n>65)return -1;long count=v[0];if(count<0||count>64||n!=(usz)count+1)return -1;long[64] a;usz m=0;for(usz i=0;i<(usz)count;i++){long x=v[i+1];if(x<32||x>126||x==35)return -1;if(x!=32){a[m]=x;m++;}}long[129] t;usz z=2*m+1;for(usz i=0;i<z;i++){if(i%2==0)t[i]=-1;else t[i]=a[i/2];}usz[129] p = zeroed;usz center=0;usz right=0;usz best=0;for(usz i=0;i<z;i++){if(i<right){usz mirror=2*center-i;p[i]=p[mirror]<(right-i)?p[mirror]:(right-i);}while(i>=p[i]+1&&i+p[i]+1<z&&t[i-p[i]-1]==t[i+p[i]+1])p[i]++;if(p[i]>best)best=p[i];if(i+p[i]>right){center=i;right=i+p[i];}}return (long)best;}
