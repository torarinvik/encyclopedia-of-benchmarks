module largest_divisible_subset;
fn long largest_divisible_subset(long*v,usz n) @export("largest_divisible_subset"){if((v==null&&n!=0)||n>64)return -1;long a[64];long d[64];for(usz i=0;i<n;i++){if(v[i]<1||v[i]>50000)return -1;a[i]=v[i];}for(usz i=1;i<n;i++){long x=a[i];usz j=i;while(j>0&&a[j-1]>x){a[j]=a[j-1];j--;}a[j]=x;}long best=0;for(usz i=0;i<n;i++){d[i]=1;for(usz j=0;j<i;j++)if(a[i]%a[j]==0&&d[j]+1>d[i])d[i]=d[j]+1;if(d[i]>best)best=d[i];}return best;}
