module lamberts_ellipsoidal_distance;
const double INV=-1.0e300;const double PI=3.14159265358979323846264338327950288;
extern fn double sin(double);extern fn double cos(double);extern fn double sqrt(double);extern fn double asin(double);extern fn double atan(double);extern fn double tan(double);
fn double lamberts_ellipsoidal_distance(long*v,usz n) @export("lamberts_ellipsoidal_distance"){if(n!=4)return INV;if(v[0]<-90000000||v[0]>90000000||v[2]<-90000000||v[2]>90000000||v[1]<-180000000||v[1]>180000000||v[3]<-180000000||v[3]>180000000)return INV;if(v[0]==v[2]&&v[1]==v[3])return INV;double lat1=(double)v[0]/1e6,lon1=(double)v[1]/1e6,lat2=(double)v[2]/1e6,lon2=(double)v[3]/1e6;double p1=lat1*PI/180,p2=lat2*PI/180,l1=lon1*PI/180,l2=lon2*PI/180;double h=sqrt(sin((p2-p1)/2)*sin((p2-p1)/2)+cos(p1)*cos(p2)*sin((l2-l1)/2)*sin((l2-l1)/2));if(h==0)return INV;double sigma=2*asin(h),f=(6378137.0-6356752.314245)/6378137.0,b1=atan((1-f)*tan(lat1*PI/180)),b2=atan((1-f)*tan(lat2*PI/180)),p=(b1+b2)/2,q=(b2-b1)/2;double x=(sigma-sin(sigma))*((sin(p)*sin(p)*cos(q)*cos(q))/(cos(sigma/2)*cos(sigma/2)));double y=(sigma+sin(sigma))*((cos(p)*cos(p)*sin(q)*sin(q))/(sin(sigma/2)*sin(sigma/2)));return 6378137.0*(sigma-(f/2)*(x+y));}
