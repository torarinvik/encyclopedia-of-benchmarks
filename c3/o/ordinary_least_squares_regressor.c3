module ordinary_least_squares_regressor;
import "math";
void putd(char *o,usz p,double x){ulong b=@bitcast(ulong,x);for(usz k=0;k<8;k++){o[p+k]=(char)(b&255);b>>=8;}}
fn long ordinary_least_squares_regressor(long *v,usz n,char *o,usz cap) @export("ordinary_least_squares_regressor"){if(v==null||n<6)return -1;int nr=(int)v[0],f=(int)v[1],t=(int)v[2];if(nr<2||nr>8||f!=2||t<1||t>3||n!=3+(usz)nr*3+(usz)t*2)return -1;double g[3][3]={0},b[3]={0};usz p=3;for(int r=0;r<nr;r++){long x=v[p],y=v[p+1],zv=v[p+2];p+=3;if(x < -100||x>100||y < -100||y>100||zv < -1000||zv>1000)return -1;double row[3]={(double)x,(double)y,1};for(int i=0;i<3;i++){b[i]+=row[i]*(double)zv;for(int j=0;j<3;j++)g[i][j]+=row[i]*row[j];}}for(int c=0;c<3;c++){int q=c;for(int r=c+1;r<3;r++)if(math.abs(g[r][c])>math.abs(g[q][c]))q=r;if(math.abs(g[q][c])<1e-12)return -1;for(int j=0;j<3;j++){double z=g[c][j];g[c][j]=g[q][j];g[q][j]=z;}double z=b[c];b[c]=b[q];b[q]=z;double s=g[c][c];for(int j=c;j<3;j++)g[c][j]/=s;b[c]/=s;for(int r=0;r<3;r++)if(r!=c){double k=g[r][c];for(int j=c;j<3;j++)g[r][j]-=k*g[c][j];b[r]-=k*b[c];}}if(o==null||cap<(usz)t*8)return -2;for(int r=0;r<t;r++){long x=v[p],y=v[p+1];p+=2;if(x < -100||x>100||y < -100||y>100)return -1;putd(o,(usz)r*8,(double)x*b[0]+(double)y*b[1]+b[2]);}return (long)t*8;}
