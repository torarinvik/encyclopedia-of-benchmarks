{
  "schema_version": 1,
  "id": "charoccurrence-ascii-canonical-map-v1",
  "algorithm": "charoccurrence",
  "function_symbol": "charoccurrence",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "minimum_length": 0,
    "maximum_length": 128,
    "value_range": [
      0,
      127
    ],
    "meaning": "ASCII Unicode codepoints from the input string"
  },
  "output": {
    "kind": "byte_string",
    "encoding": "ascending decimal codepoint=count pairs joined by commas; empty map is zero bytes",
    "return_value": "number of output bytes written",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "maximum canonical map output buffer"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 3,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
