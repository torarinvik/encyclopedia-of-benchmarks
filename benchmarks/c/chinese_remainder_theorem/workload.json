{
  "schema_version": 1,
  "id": "chinese-remainder-theorem-v1",
  "algorithm": "chinese_remainder_theorem",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "flattened remainder, modulus pairs",
    "minimum_length": 2,
    "maximum_length": 8,
    "equation_count_range": [
      1,
      4
    ],
    "modulus_range": [
      2,
      1000
    ],
    "precondition": "moduli are pairwise coprime and each remainder is in [0, modulus)",
    "result": "least nonnegative solution to all congruences",
    "invalid_result": -1
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": -1
    },
    {
      "id": "one_congruence",
      "input_values": [
        3,
        5
      ],
      "input_length": 2,
      "expected_result": 3
    },
    {
      "id": "python_example",
      "input_values": [
        1,
        5,
        3,
        7
      ],
      "input_length": 4,
      "expected_result": 31
    },
    {
      "id": "three_congruences",
      "input_values": [
        1,
        3,
        2,
        5,
        3,
        7
      ],
      "input_length": 6,
      "expected_result": 52
    },
    {
      "id": "two_congruences",
      "input_values": [
        1,
        6,
        3,
        5
      ],
      "input_length": 4,
      "expected_result": 13
    },
    {
      "id": "four_congruences",
      "input_values": [
        96,
        97,
        100,
        101,
        102,
        103,
        106,
        107
      ],
      "input_length": 8,
      "expected_result": 107972736
    },
    {
      "id": "odd_input_length",
      "input_values": [
        1,
        5,
        3
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "non_coprime_moduli",
      "input_values": [
        1,
        6,
        3,
        4
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "zero_modulus",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "negative_residue",
      "input_values": [
        -1,
        5
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "residue_out_of_range",
      "input_values": [
        5,
        5
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "too_many_congruences",
      "input_values": [
        0,
        2,
        0,
        3,
        0,
        5,
        0,
        7,
        0,
        11
      ],
      "input_length": 10,
      "expected_result": -1
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
}
