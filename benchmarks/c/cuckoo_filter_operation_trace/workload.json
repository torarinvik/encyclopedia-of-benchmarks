{
  "schema_version": 1,
  "id": "cuckoo-filter-operation-trace-i64-array-bytes-output-v1",
  "algorithm": "cuckoo_filter_operation_trace",
  "function_symbol": "cuckoo_filter_operation_trace",
  "abi": "i64_array_bytes_output",
  "description": "Replay deterministic fingerprint-only cuckoo-filter insert, lookup, delete, and bounded kick operations.",
  "source": {
    "title": "Cuckoo Filter: Practically Better Than Bloom",
    "authors": [
      "Bin Fan",
      "David G. Andersen",
      "Michael Kaminsky",
      "Michael Mitzenmacher"
    ],
    "venue": "CoNEXT 2014",
    "url": "https://www.cs.cmu.edu/~dga/papers/cuckoo-conext2014.pdf",
    "nist_cuckoo_hashing_url": "https://xlinux.nist.gov/dads/HTML/cuckooHashing.html",
    "implementation_status": "clean-room deterministic fingerprint-only operation trace"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[Q,(opcode,primary_bucket,fingerprint)*Q]",
    "operation_count_range": [
      1,
      32
    ],
    "opcode_map": {
      "0": "insert",
      "1": "lookup",
      "2": "delete"
    },
    "primary_bucket_range": [
      0,
      7
    ],
    "fingerprint_range": [
      1,
      15
    ],
    "table_buckets": 8,
    "slots_per_bucket": 4,
    "alternate_bucket": "primary_bucket XOR (1 + ((5*fingerprint + 3) mod 7))",
    "maximum_valid_length": 97,
    "maximum_parseable_length": 98,
    "input_modified": false,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "One status per operation: insert success 1, lookup/delete 1 on success and 0 otherwise.",
    "maximum_bytes": 256,
    "success_result": "8*Q bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "kick_limit_result": -3,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Fixed 8-by-4 fingerprint table, at most 32 operation statuses, and scalar state."
  },
  "contract": {
    "insert_order": "Use the lowest empty slot in the primary bucket, then the alternate bucket. If both are full, start at the primary bucket and for at most eight kicks evict the lowest-numbered slot; move the evicted fingerprint to the bucket obtained by XOR with its delta, placing it in the lowest empty slot if available.",
    "kick_failure": "If eight kicks complete without finding an empty slot, abort the whole trace with -3 and write no output.",
    "lookup_order": "Scan primary bucket then alternate bucket, each from lowest slot to highest.",
    "delete_order": "Delete one matching fingerprint from primary then alternate, scanning each from lowest slot to highest; return zero if none is present.",
    "duplicate_policy": "Store duplicate fingerprints as separate copies until the fixed table is full.",
    "fingerprint_only_semantics": "The original item is not retained; the caller supplies a primary bucket and fingerprint. The trace pins tie choices and does not claim a random success probability.",
    "invalid_cases": "Malformed frame, opcode, bucket, or fingerprint returns -1. After input validation, null output or insufficient output capacity returns -2 without writes."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary mutates one flat 32-slot array; the independent reference reconstructs immutable bucket tuples after each local insertion or deletion.",
