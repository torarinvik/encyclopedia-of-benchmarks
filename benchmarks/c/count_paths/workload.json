{
  "schema_version": 1,
  "id": "count-paths-python-grid-simple-dfs-v1",
  "algorithm": "count_paths",
  "function_symbol": "count_paths",
  "input": {
    "encoding": "signed_i64_array",
    "layout": ["rows", "columns", "row_major_cells"],
    "rows_range": [1, 5],
    "columns_range": [1, 5],
    "maximum_cell_count": 25,
