{
  "schema_version": "1.0.0",
  "id": "cpu-scheduling-algorithms-python-bounded-processes-v1",
  "algorithm": "cpu_scheduling_algorithms",
  "function_symbol": "cpu_scheduling_algorithms",
  "description": "Run one of the six scheduling modes from the pinned Python scheduler and report per-process completion, turnaround, waiting, and response times.",
  "input": {
    "kind": "i64_array",
    "encoding": "[mode, process_count, quantum, (process_id, arrival_time, burst_time, priority)*]",
    "mode_values": {
      "0": "FCFS",
      "1": "SJF non-preemptive",
      "2": "SJF preemptive",
      "3": "priority non-preemptive",
      "4": "priority preemptive",
      "5": "round robin"
    },
    "maximum_processes": 32,
    "process_id_range": [
      0,
      31
    ],
    "process_ids": "unique",
    "arrival_range": [
      0,
      256
    ],
    "burst_range": [
      1,
      32
    ],
    "priority_range": [
      -32,
      32
    ],
    "quantum_range": [
      1,
      32
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_sequence",
    "encoding": "For each process in input order, seven little-endian signed 64-bit fields: process ID, arrival time, burst time, completion time, turnaround time, waiting time, response time.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 1792
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
