  "schema_version": 1,
  "id": "cosine-similarity-printable-ascii-frequency-v1",
  "algorithm": "cosine_similarity",
  "function_symbol": "cosine_similarity",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
