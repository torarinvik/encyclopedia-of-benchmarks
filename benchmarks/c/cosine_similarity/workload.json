      64
    ],
    "character_code_range": [
      32,
      126
    ],
    "case_folding": "ASCII A-Z maps to a-z before character-frequency counting",
    "exact_shape": "2+left_length+right_length values",
    "invalid_input_result": -1e+300,
    "maximum_parseable_length": 132
