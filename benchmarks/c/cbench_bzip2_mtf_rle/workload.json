  "contract": {
    "mode_0_input": "[0, 0, length, BWT_last_column_bytes...]; derive the ascending in-use byte alphabet, MTF encode, encode consecutive rank-zero runs as RUNA/RUNB, append EOB.",
    "mode_1_input": "[1, alphabet_length, token_count, ascending alphabet bytes..., RUNA/RUNB/nonzero-rank tokens..., EOB]; expand zero runs and inverse-MTF to the BWT last column.",
    "block_length_range": [1, 32],
    "alphabet_length_range": [1, 32],
    "token_count_range": [2, 33],
    "token_values": "RUNA=0, RUNB=1, nonzero MTF rank j is j+1, EOB=alphabet_length+1.",
    "output_encoding": "Mode 0 emits one byte per MTF/RUNA/RUNB/EOB token; mode 1 emits the decoded BWT last-column bytes.",
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "Mode 0 [0, 0, block_length, BWT_last_column_bytes...]; mode 1 [1, alphabet_length, token_count, ascending alphabet..., tokens...].",
    "maximum_valid_length": 68,
    "maximum_parseable_length": 68,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "Mode 0 bzip2 MTF/RUNA/RUNB/EOB token bytes; mode 1 reconstructed BWT last-column bytes.",
    "maximum_bytes": 33,
    "success_result": "number of bytes written",
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 33,
    "meaning": "Maximum output buffer for 32 data symbols plus EOB."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "encode_single_symbol_zero_run",
      "input_values": [0, 0, 1, 7],
      "input_length": 4,
      "expected_result": 2,
      "expected_output_hex": "0002"
    },
    {
      "id": "encode_runb_runa_zero_run",
      "input_values": [0, 0, 4, 7, 7, 7, 7],
      "input_length": 7,
      "expected_result": 3,
      "expected_output_hex": "010002"
    },
    {
      "id": "encode_nonzero_mtf_ranks",
      "input_values": [0, 0, 4, 9, 7, 9, 7],
      "input_length": 7,
      "expected_result": 5,
      "expected_output_hex": "0202020203"
    },
    {
      "id": "decode_runa_runb_to_four_symbols",
      "input_values": [1, 1, 3, 7, 1, 0, 2],
      "input_length": 7,
      "expected_result": 4,
      "expected_output_hex": "07070707"
    },
    {
      "id": "decode_nonzero_mtf_ranks",
      "input_values": [1, 2, 4, 7, 9, 2, 2, 2, 3],
      "input_length": 9,
      "expected_result": 3,
      "expected_output_hex": "090709"
    },
    {
      "id": "invalid_unsorted_decoder_alphabet",
      "input_values": [1, 2, 2, 9, 7, 2, 3],
      "input_length": 7,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_missing_eob",
      "input_values": [1, 1, 2, 7, 0, 1],
      "input_length": 6,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "output_capacity_too_small",
      "input_values": [0, 0, 1, 7],
      "input_length": 4,
      "output_capacity": 1,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null_input",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null_output",
      "input_values": [1, 1, 2, 7, 0, 2],
      "input_length": 6,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
