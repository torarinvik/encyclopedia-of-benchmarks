  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "1 iff this supplied embedding satisfies the c-connected clustered-planarity outer-face criterion for every cluster; 0 iff this embedding fails the criterion; -1 for malformed, nonplanar, or non-c-connected input.",
    "embedding_specific": true,
    "does_not_claim_no_other_embedding": true
  },
  "workspace": {"bytes": 8192},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
