    "oddness": "source int32 low bit: (value & 1) == 1",
    "malformed_input_result": -1,
    "k_zero_excluded": "source even-prefix scan may read beyond the input when k=0"
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "number of contiguous subarrays containing exactly k odd values",
    "maximum_result_bound": 8390656
  },
  "cases": [
    {"id":"empty-array","input_values":[0,1],"expected_result":0},
    {"id":"single-odd","input_values":[1,1,7],"expected_result":1},
    {"id":"single-even","input_values":[1,1,8],"expected_result":0},
    {"id":"one-odd-with-even-prefix-and-suffix","input_values":[3,1,2,1,4],"expected_result":4},
    {"id":"two-odd-values","input_values":[3,2,1,2,3],"expected_result":1},
    {"id":"consecutive-odd-values","input_values":[3,1,3,5],"expected_result":3},
    {"id":"negative-odd-values","input_values":[3,2,-3,2,-1],"expected_result":1},
    {"id":"even-prefix-and-suffix-count","input_values":[5,1,2,4,1,6,8],"expected_result":9},
    {"id":"k-greater-than-odd-count","input_values":[2,3,1,3],"expected_result":0},
    {"id":"invalid-k-zero","input_values":[2,0,2,4],"expected_result":-1},
    {"id":"invalid-packed-length","input_values":[2,1,5],"expected_result":-1},
    {"id":"invalid-k-negative","input_values":[1,-1,3],"expected_result":-1},
    {"id":"invalid-element-outside-int32","input_values":[1,1,2147483648],"expected_result":-1}
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
