{
  "schema_version": 1,
  "id": "count-nice-subarrays-java-memoized-window-v1",
  "algorithm": "count_nice_subarrays",
  "function_symbol": "count_nice_subarrays",
  "input": {
    "encoding": "signed_i64_array",
    "layout": ["n", "k", "signed_i32_values"],
    "n_range": [0, 4096],
    "k_range": [1, 4096],
