    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 128,
    "accounting": "Scalar height, key, count, path, node, depth, and output-index state; no tree nodes or per-leaf array are stored by the language ports. The output buffer is separately supplied by the caller."
  },
  "measurement": {
