  "abi": "i64_array_bytes_output",
  "description": "Deterministic parallel Clarke-Wright savings for a bounded symmetric homogeneous-capacity vehicle-routing instance.",
  "source": {
    "title": "Scheduling of Vehicles from a Central Depot to a Number of Delivery Points",
    "authors": ["G. Clarke", "J. W. Wright"],
    "year": 1964,
    "journal": "Operations Research 12(4), 568-581",
    "doi": "10.1287/opre.12.4.568",
    "url": "https://doi.org/10.1287/opre.12.4.568",
    "algorithm_attribution": "Parallel savings: singleton routes, one-time descending pair savings, and capacity-feasible merges at route ends; local profile choices pin positive-only merges and deterministic ties.",
    "implementation_status": "Clean-room bounded algorithm ports; no paper code, prose, figures, or test data copied."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,capacity,demands for customer IDs 1..n,row-major symmetric distances for vertex IDs 0..n with depot 0]",
    "customer_count_range": [0, 7],
    "capacity_range": [1, 100],
    "demand_range": "1..capacity",
    "distance_range": [0, 1000],
    "distance_constraints": "Complete matrix, zero diagonal, symmetric integer distances; triangle inequality is not required.",
    "exact_length": "2+n+(n+1)^2",
    "maximum_valid_length": 73,
    "maximum_parseable_length": 74,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "layout": "[route_count, route_length, customer IDs, ...]; depot visits are implicit",
    "route_order": "Each route is oriented as the lexicographically smaller of itself and its reversal; routes are sorted lexicographically.",
    "success_result": "8 times the number of output words",
    "maximum_bytes": 120,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed distance matrix, customer route chains, pair savings, and staged output words."
  },
  "algorithm_contract": {
    "saving": "s(i,j)=d(0,i)+d(0,j)-d(i,j) for 1<=i<j<=n.",
    "pair_order": "Descending saving, then ascending customer pair (i,j). Each pair is considered at most once.",
    "merge_rule": "Only strictly positive savings are considered. Merge distinct routes only if i and j are route ends and combined demand is within capacity.",
    "merge_orientation": "Orient the first route so i is its last customer and the second so j is its first customer; join in i-to-j order.",
    "nonpositive_savings": "Zero and negative savings are skipped.",
    "heuristic_claim": "Deterministic feasible heuristic; no optimality guarantee is claimed."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 20
  },
