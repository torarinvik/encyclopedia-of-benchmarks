{
  "schema_version": 1,
  "id": "check-polygon-v1",
  "algorithm": "check_polygon",
  "function_symbol": "check_polygon",
  "input": {
    "kind": "i64_array",
    "encoding": "Positive side lengths.",
    "minimum_values": 3,
    "maximum_values": 256,
    "side_length_range": [1, 1000000000],
    "result": "Return 1 if the largest side is strictly less than the sum of the others, otherwise 0. Output bytes are empty.",
    "invalid_result": -1
  },
  "cases": [
    {
      "id": "valid_triangle",
      "input_values": [3, 4, 5],
      "input_length": 3,
      "expected_result": 1,
      "expected_output_hex": ""
    },
    {
      "id": "valid_unsorted_triangle",
      "input_values": [6, 10, 5],
      "input_length": 3,
      "expected_result": 1,
      "expected_output_hex": ""
    },
    {
      "id": "triangle_equality_is_degenerate",
      "input_values": [1, 2, 3],
      "input_length": 3,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "impossible_triangle",
      "input_values": [1, 2, 4],
      "input_length": 3,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "valid_quadrilateral",
      "input_values": [1, 1, 1, 1],
      "input_length": 4,
      "expected_result": 1,
      "expected_output_hex": ""
    },
    {
      "id": "quadrilateral_equality_is_degenerate",
      "input_values": [1, 1, 1, 3],
      "input_length": 4,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "maximum_side_not_largest_in_input",
      "input_values": [200, 90, 75, 50],
      "input_length": 4,
      "expected_result": 1,
      "expected_output_hex": ""
    },
    {
      "id": "large_valid_sides",
      "input_values": [1000000000, 1000000000, 1000000000],
      "input_length": 3,
      "expected_result": 1,
      "expected_output_hex": ""
    },
    {
      "id": "large_equality",
      "input_values": [1, 999999999, 1000000000],
      "input_length": 3,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "too_few_sides",
      "input_values": [4, 5],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "zero_side",
      "input_values": [3, 0, 4],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_side",
      "input_values": [3, -1, 4],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "side_out_of_range",
      "input_values": [3, 4, 1000000001],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  }
}
