  "abi": "i64_array_bytes_output",
  "description": "Find connected components in an implicit graph complement by neighbor marking and unvisited-list traversal.",
  "source": {
    "title": "Connected Components of Complement Graph",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/graph/connected_components_of_complement_graph/task.md",
    "algorithm_attribution": "BFS on complement using original-neighbor marks and an unvisited vertex list",
    "implementation_status": "clean-room bounded implicit-complement traversal"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,(u,v)...]",
    "N_range": [1, 64],
    "M_range": "0 <= M <= N*(N-1)/2",
    "graph_constraint": "simple undirected graph; no loops or duplicate edges",
    "maximum_valid_length": 4034,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "canonical partition: K, then for each component its size followed by ascending vertex IDs",
    "maximum_bytes": 1032,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 1032,
    "meaning": "Maximum output-buffer capacity; local adjacency rows, unvisited vertices, queue, and component labels use separate bounded arrays."
  },
  "contract": {
    "graph": "decompose the complement of the supplied simple undirected graph into connected components",
    "canonicalization": "sort each component's vertex IDs and order components by their minimum vertex ID",
    "official_N_range": [1, 500000],
    "official_M_range": [0, 500000]
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
