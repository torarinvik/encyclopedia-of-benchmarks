{
  "schema_version": 1,
  "id": "collaborative-filtering-pearson-similarity-v1",
  "algorithm": "collaborative_filtering_pearson_similarity",
  "function_symbol": "collaborative_filtering_pearson_similarity",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[first_count, item_id, rating_milli..., second_count, item_id, rating_milli...]",
    "profile_item_count_range": [
      0,
      32
    ],
    "item_id_range": [
      0,
      127
    ],
    "rating_encoding": "rating_milli / 1000.0",
    "rating_milli_range": [
      -1000000000,
      1000000000
    ],
    "item_ids_must_be_unique_within_each_profile": true,
    "maximum_packed_values": 130,
    "invalid_input_result": -2.0
  },
  "output": {
    "kind": "binary64",
    "meaning": "Pearson correlation over common item IDs, in first-profile insertion order; zero for no common IDs or denominator magnitude below 1e-10",
    "valid_range": [
      -1.0,
      1.0
    ],
    "invalid_input_result": -2.0,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
