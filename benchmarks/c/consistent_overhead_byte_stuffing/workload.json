  "algorithm": "consistent_overhead_byte_stuffing",
  "function_symbol": "consistent_overhead_byte_stuffing",
  "abi": "i64_array_bytes_output",
  "description": "Encode a bounded payload with basic consistent overhead byte stuffing (COBS).",
  "source": {
    "title": "Consistent overhead byte stuffing",
    "discovery_index_url": "https://github.com/acmeism/RosettaCodeData/blob/1d475861d7141ef2fafff293d9339f56e4b0f5db/popular-tasks",
    "discovery_index_revision": "1d475861d7141ef2fafff293d9339f56e4b0f5db",
    "primary_method_reference": "https://doi.org/10.1109/90.769765",
    "definition_pdf": "https://stuartcheshire.org/papers/COBSforToN.pdf",
    "discovery_scope": "RosettaCodeData supplies title discovery only. The benchmark follows basic COBS from Cheshire and Baker; no task text, code, examples, or tests are copied. COBS/ZPE is excluded."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[payload_byte_count, payload_bytes...]",
    "payload_byte_range": [0, 255],
    "maximum_payload_bytes": 255,
    "maximum_valid_input_values": 256,
    "maximum_parseable_input_values": 257,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "cobs_encoded_bytes",
    "maximum_output_bytes": 257,
    "result": "number of encoded bytes",
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "errors_write_nothing": true,
    "framing_delimiter_included": false
  },
  "contract": {
    "variant": "basic COBS, not COBS/ZPE",
    "reserved_value": 0,
    "code_block_rule": "Code 1..254 is followed by code-1 nonzero payload bytes and implies a zero when another block follows. Code 255 is followed by exactly 254 nonzero bytes and implies no zero.",
    "terminal_rule": "The payload is logically zero-terminated for encoding. If it ends in a complete 254-byte nonzero block, omit the otherwise-empty terminal code block; this canonical optimization preserves the decoded payload and the tight overhead bound.",
    "output_delimiter": "No zero frame delimiter is emitted; framing is outside this kernel.",
    "validation_precedes_capacity": true,
    "no_write_on_error": true,
    "output_bound": "For payload length n=0, output length is 1. For 1<=n<=255, output length is at most n+ceil(n/254), hence at most 257 bytes."
  },
  "workspace": {
    "bytes": 384,
    "meaning": "Includes a fixed 257-byte staged output and scalar/index state; caller-owned input and output are excluded."
  },
  "complexity": {
    "primary_time": "O(n) streaming code-slot pass, n<=255",
    "primary_auxiliary_space": "O(n) fixed staging, at most 257 bytes",
    "independent_reference_time": "O(n) zero-delimited run decomposition and block emission",
    "independent_reference_auxiliary_space": "O(n) encoded result"
  },
  "primary_oracle": "benchmarks/c/consistent_overhead_byte_stuffing/primary_oracle.py",
  "independent_oracle": "benchmarks/c/consistent_overhead_byte_stuffing/independent_oracle.py",
  "suite_status": "integrated in i64_array_bytes_output runner and verifier",
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
