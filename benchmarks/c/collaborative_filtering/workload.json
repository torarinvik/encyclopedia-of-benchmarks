{
  "schema_version": 1,
  "id": "collaborative-filtering-prediction-v1",
  "algorithm": "collaborative_filtering",
  "function_symbol": "collaborative_filtering",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[user_count, is_target_user, has_target_rating, similarity_ticks, rating_milli, ...]",
    "has_target_rating_values": [
      0,
      1
    ],
    "similarity_encoding": "similarity_ticks / 1000000000000.0",
    "similarity_ticks_range": [
      -1000000000000,
      1000000000000
    ],
    "rating_encoding": "rating_milli / 1000.0",
    "rating_milli_range": [
      -1000000000,
      1000000000
    ],
    "maximum_packed_values": 261,
    "invalid_input_result": -1e+300,
    "user_count_range": [
      1,
      65
    ],
    "maximum_other_users": 64,
    "is_target_user_values": [
      0,
      1
    ],
    "exactly_one_target_user": true
  },
  "output": {
    "kind": "binary64",
    "meaning": "weighted_sum(similarity * target-item rating) / sum(abs(similarity)) over other users who rated the target item; zero when abs(total similarity) is below 1e-10",
    "valid_range": [
      -1000000.0,
      1000000.0
    ],
    "invalid_input_result": -1e+300,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
