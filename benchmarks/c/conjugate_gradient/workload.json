{
  "schema_version": 1,
  "id": "conjugate-gradient-bounded-spd-f64-vector-v1",
  "algorithm": "conjugate_gradient",
  "function_symbol": "conjugate_gradient",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[n, row-major n*n matrix entries in micro-units, n right-hand-side values in micro-units]",
    "dimension_range": [
      1,
      8
    ],
    "entry_scale": 1000000,
    "matrix_domain": "exactly symmetric integer matrix with positive diagonal and each diagonal strictly greater than the sum of absolute off-diagonal entries; this guarantees positive definiteness",
    "entry_range_micro_units": [
      -1000000000,
      1000000000
    ],
    "maximum_input_length": 73,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_vector",
    "meaning": "solution vector x of A*x=b, compared against the exact rational solution rounded to binary64",
    "encoding": "n little-endian IEEE-754 binary64 values",
    "return_value": "output byte length (8*n)",
    "max_length": 8,
    "max_output_bytes": 64,
    "absolute_tolerance": 1e-08,
    "relative_tolerance": 1e-08,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "source_semantics": {
    "initial_state": "x=0, residual=b, search direction=b",
    "recurrence": "standard conjugate-gradient alpha and beta updates for symmetric positive-definite A",
    "convergence": "bounded ports stop when the Euclidean residual norm is at most 1e-10 or after 1000 iterations",
    "source_correction": "the upstream implementation stops on changes in x and residual and can continue into a zero-denominator step after exact convergence; this benchmark uses residual norm stopping and returns the current solution for a zero right-hand side"
  },
  "workspace": {
    "bytes": 64,
    "meaning": "maximum n-element binary64 output capacity"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
