{
  "schema_version": 1,
  "id": "count-numbers-divisible-positive-int32-v1",
  "algorithm": "count_numbers_divisible",
  "function_symbol": "count_numbers_divisible",
  "input": {
    "kind": "positive_integer_interval_and_divisor_as_binary64",
    "endpoint_range": [
      1,
      2147483647
    ],
    "divisor_range": [
      1,
      2147483647
    ],
    "interval": "inclusive [first, last], with first <= last",
    "formula": "floor(last / divisor) - floor((first - 1) / divisor)",
    "input_scaled_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "input_scaled_tolerance": 1e-12,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
  "cases": [
    {
      "id": "one_to_ten_divisible_by_three",
      "input_values": [
        1.0,
        10.0,
        3.0
      ],
      "expected_result": 3.0
    },
    {
      "id": "interval_starts_on_multiple",
      "input_values": [
        3.0,
        10.0,
        3.0
      ],
      "expected_result": 3.0
    },
    {
      "id": "interval_starts_between_multiples",
      "input_values": [
        4.0,
        10.0,
        3.0
      ],
      "expected_result": 2.0
    },
    {
      "id": "single_value_is_multiple",
      "input_values": [
        6.0,
        6.0,
        3.0
      ],
      "expected_result": 1.0
    },
    {
      "id": "single_value_not_multiple",
      "input_values": [
        7.0,
        7.0,
        3.0
      ],
      "expected_result": 0.0
    },
    {
      "id": "divisor_above_interval",
      "input_values": [
        2.0,
        9.0,
        10.0
      ],
      "expected_result": 0.0
    },
    {
      "id": "divisor_equals_endpoint",
      "input_values": [
        2.0,
        10.0,
        10.0
      ],
      "expected_result": 1.0
    },
    {
      "id": "divisor_one",
      "input_values": [
        1.0,
        20.0,
        1.0
      ],
      "expected_result": 20.0
    },
    {
      "id": "same_endpoint_and_divisor",
      "input_values": [
        7.0,
        7.0,
        7.0
      ],
      "expected_result": 1.0
    },
    {
      "id": "larger_interval",
      "input_values": [
        1000000.0,
        2147483647.0,
        1000.0
      ],
      "expected_result": 2146484.0
    },
    {
      "id": "int32_endpoint",
      "input_values": [
        2147483640.0,
        2147483647.0,
        7.0
      ],
      "expected_result": 1.0
    },
    {
      "id": "wide_divisor_no_multiple",
      "input_values": [
        1.0,
        2147483647.0,
        2147483647.0
      ],
      "expected_result": 1.0
    }
  ]
}
