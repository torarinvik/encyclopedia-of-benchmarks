{
  "schema_version": 1,
  "id": "check-word-occurrence-javascript-ascii-map-v1",
  "algorithm": "check_word_occurrence",
  "function_symbol": "check_word_occurrence",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[lowercase_flag, n, ascii_bytes...]",
    "lowercase_flag_range": [
      0,
      1
    ],
    "n_range": [
      0,
      1024
    ],
    "valid_bytes": "ASCII letters A-Z/a-z and JS ASCII whitespace bytes 9..13 or 32",
    "exact_packed_length": "n + 2",
    "case_flag_semantics": "1 lowercases ASCII before splitting; 0 preserves case, matching the pinned source even though the parameter is named isCaseSensitive",
    "split_semantics": "split on runs of ASCII whitespace while preserving leading/trailing empty fields; empty input has one empty token",
    "forbidden_token_keys": [
      "constructor",
      "hasownproperty",
      "isprototypeof",
      "propertyisenumerable",
      "tolocalestring",
      "tostring",
      "valueof"
    ],
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "binary_word_count_map",
    "encoding": "u32le entry count, then first-occurrence-ordered entries of u32le key length, ASCII key bytes, u32le count",
    "success_result": "encoded byte length",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_input",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": 12,
      "expected_output_hex": "010000000000000001000000"
    },
    {
      "id": "whitespace_only",
      "input_values": [
        0,
        3,
        32,
        9,
        10
      ],
      "input_length": 5,
      "expected_result": 12,
      "expected_output_hex": "010000000000000002000000"
    },
