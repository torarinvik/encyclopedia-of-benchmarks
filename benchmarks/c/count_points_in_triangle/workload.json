  "oracle": "benchmarks/c/count_points_in_triangle/primary_oracle.py",
  "independent_oracle": "benchmarks/c/count_points_in_triangle/independent_oracle.py",
  "contract": {
    "operation": "For each indexed triple from A, count the B points strictly inside the triple's convex hull.",
    "input_layout": "[N,M,Q, A coordinate pairs, B coordinate pairs, Q zero-based index triples]",
    "algorithm": "For each A anchor, exact-angle-sort nonzero vectors to B and build a Fenwick tree over angular ranks. Count exterior closed half-planes and adjacent-pair wedges by circular angular range queries, then apply inclusion-exclusion.",
    "independent_algorithm": "For every query, test every B point against the three oriented triangle edges using direct signed cross products.",
    "degenerate_behavior": "Repeated or collinear query vertices have empty two-dimensional interior and return zero.",
    "boundary_behavior": "Points on any triangle edge or vertex are excluded.",
    "output_layout": "Q consecutive little-endian signed 64-bit counts.",
    "maximum_point_count_a": 24,
    "maximum_point_count_b": 24,
    "maximum_query_count": 128,
    "workspace_bytes": 65536,
    "error_precedence": "Malformed framing, indices, or coordinates return -1 before output checks. Valid input with null output or capacity below 8*Q returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,Q, then N A pairs, M B pairs, Q index triples]",
    "n_range": [1, 24],
    "m_range": [1, 24],
    "q_range": [1, 128],
    "coordinate_range": [-1000000000, 1000000000],
    "index_range": "0..N-1",
    "maximum_valid_length": 483,
    "maximum_parseable_input_length": 483,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 128,
    "maximum_bytes": 1024,
    "success_result": "8*Q bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 65536,
    "storage": "Fixed A/B/query arrays, per-anchor displacement vectors and Fenwick trees, and staged query answers."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
