{
  "schema_version": 1,
  "id": "count-distinct-elements-in-window-java-i64-array-bytes-output-v1",
  "algorithm": "count_distinct_elements_in_window",
  "function_symbol": "count_distinct_elements_in_window",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[n, k, values...]",
    "n_range": [
      1,
      256
    ],
    "window_size_range": "1..n",
    "value_range": [
      -2147483648,
      2147483647
    ],
    "exact_packed_length": "n + 2",
    "operation": "emit the number of distinct values in each complete length-k window, from left to right",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "elements": "n - k + 1",
    "byte_length": "8 * (n - k + 1)",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "java_example",
      "input_values": [
        7,
        3,
        1,
        2,
        1,
        3,
        4,
        3,
        5
      ],
      "input_length": 9,
      "expected_result": 40,
      "expected_output_hex": "02000000000000000300000000000000030000000000000002000000000000000300000000000000"
    },
    {
      "id": "all_values_equal",
      "input_values": [
        5,
        3,
        7,
        7,
        7,
        7,
        7
      ],
      "input_length": 7,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000100000000000000"
    },
    {
      "id": "all_distinct",
      "input_values": [
        5,
        2,
        9,
        8,
        7,
        6,
        5
      ],
      "input_length": 7,
      "expected_result": 32,
      "expected_output_hex": "0200000000000000020000000000000002000000000000000200000000000000"
    },
    {
      "id": "window_covers_array",
      "input_values": [
        4,
        4,
        4,
        -1,
        4,
        2
      ],
      "input_length": 6,
      "expected_result": 8,
      "expected_output_hex": "0300000000000000"
    },
    {
      "id": "negative_and_zero_values",
      "input_values": [
        6,
        3,
        -3,
        0,
        -3,
        2,
        0,
        -1
      ],
      "input_length": 8,
      "expected_result": 32,
      "expected_output_hex": "0200000000000000030000000000000003000000000000000300000000000000"
    },
    {
      "id": "window_length_one",
      "input_values": [
        5,
        1,
        5,
        5,
        -2,
        0,
        5
      ],
      "input_length": 7,
      "expected_result": 40,
      "expected_output_hex": "01000000000000000100000000000000010000000000000001000000000000000100000000000000"
    },
    {
      "id": "duplicate_enters_and_leaves",
      "input_values": [
        7,
        3,
        1,
        2,
        1,
        2,
        3,
        1,
        4
      ],
      "input_length": 9,
      "expected_result": 40,
      "expected_output_hex": "02000000000000000200000000000000030000000000000003000000000000000300000000000000"
    },
    {
      "id": "int32_boundaries",
      "input_values": [
        3,
        2,
        -2147483648,
        2147483647,
        -2147483648
      ],
      "input_length": 5,
      "expected_result": 16,
      "expected_output_hex": "02000000000000000200000000000000"
    },
    {
      "id": "invalid_zero_window",
      "input_values": [
        3,
        0,
        1,
        2,
        3
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_window_too_large",
      "input_values": [
        2,
        3,
        1,
        2
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "packed_length_mismatch",
      "input_values": [
        3,
        2,
        1,
        2
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "value_outside_int32",
      "input_values": [
        1,
        1,
        2147483648
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
