{
  "schema_version": 1,
  "id": "collatz-sequence-full-terms-v1",
  "algorithm": "collatz_sequence",
  "function_symbol": "collatz_sequence",
  "input": {
    "kind": "one_element_signed_64_bit_array_containing_start_value",
    "input_length": 1,
    "start_range": [
      1,
      1000000
    ],
    "out_of_range_result": -1,
    "termination": "include the start value and every next term through the terminal 1"
  },
  "output": {
    "encoding": "little-endian signed 64-bit integer sequence, without a terminator",
    "result": "number of bytes written",
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "one",
      "input_values": [
        1
      ],
      "input_length": 1,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "two",
      "input_values": [
        2
      ],
      "input_length": 1,
      "expected_result": 16,
      "expected_output_hex": "02000000000000000100000000000000"
    },
    {
      "id": "odd_start",
      "input_values": [
        3
      ],
      "input_length": 1,
      "expected_result": 64,
      "expected_output_hex": "03000000000000000a00000000000000050000000000000010000000000000000800000000000000040000000000000002000000000000000100000000000000"
    },
    {
      "id": "source_example",
      "input_values": [
        20
      ],
      "input_length": 1,
      "expected_result": 64,
      "expected_output_hex": "14000000000000000a00000000000000050000000000000010000000000000000800000000000000040000000000000002000000000000000100000000000000"
    },
    {
      "id": "long_trajectory_27",
      "input_values": [
        27
      ],
      "input_length": 1,
      "expected_result": 896,
      "expected_output_hex": ""
    },
    {
      "id": "long_trajectory_837799",
      "input_values": [
        837799
      ],
      "input_length": 1,
      "expected_result": 4200,
      "expected_output_hex": ""
    },
    {
      "id": "near_maximum_input",
      "input_values": [
        999999
      ],
      "input_length": 1,
      "expected_result": 2072,
      "expected_output_hex": ""
    },
    {
      "id": "maximum_supported_input",
      "input_values": [
        1000000
      ],
      "input_length": 1,
      "expected_result": 1224,
      "expected_output_hex": ""
    },
    {
      "id": "missing_start",
      "input_values": [],
      "input_length": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "extra_input_values",
      "input_values": [
        1,
        2
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "zero",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative",
      "input_values": [
        -1
      ],
      "input_length": 1,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "first_out_of_range",
      "input_values": [
        1000001
      ],
      "input_length": 1,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "signed_maximum",
      "input_values": [
        9223372036854775807
      ],
      "input_length": 1,
