{
  "schema_version": 1,
  "id": "thealgorithms-python-crossword-puzzle-solver-v1",
  "algorithm": "crossword_puzzle_solver",
  "function_symbol": "crossword_puzzle_solver",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[rows, columns, word_count, row-major cells..., (word_length, uppercase ASCII letters...)...]",
    "rows_range": [
      1,
      8
    ],
    "columns_range": [
      1,
      8
    ],
    "word_count_range": [
      0,
      8
    ],
    "cell_values": "0 is empty; -1 is blocked; 65 through 90 are preset uppercase letters. Words may overlap where letters match.",
    "word_length_range": [
      1,
      8
    ],
    "duplicate_words": "allowed",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[solved (0 or 1), row-major cells...]",
    "search_order": "Stable sort words by descending length; for each word try every start cell in row-major order, vertical then horizontal. A cell may be empty or match the placed letter. Restore only cells newly filled by a failed placement. Return true once all words are placed; with no words, leave the grid unchanged and return true."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
