{
  "schema_version": 1,
  "id": "crochemore-perrin-two-way-byte-search-v1",
  "algorithm": "crochemore_perrin_two_way",
  "function_symbol": "crochemore_perrin_two_way",
  "abi": "i64_array_bytes_output",
  "description": "Report every exact pattern occurrence using critical factorization and the Crochemore-Perrin Two-Way scan.",
  "source": {
    "title": "Two-way string-matching",
    "authors": ["Maxime Crochemore", "Dominique Perrin"],
    "year": 1991,
    "reference": "Journal of the ACM 38(3), pp. 651-675, DOI 10.1145/116825.116845",
    "url": "https://doi.org/10.1145/116825.116845",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, pattern_length, text_bytes..., pattern_bytes...]",
    "text_length_range": [0, 64],
    "pattern_length_range": [0, 32],
    "symbol_range": [0, 255],
    "exact_length": "2 + text_length + pattern_length",
    "maximum_valid_length": 98,
    "maximum_parseable_length": 99,
    "includes_nul": true,
    "empty_pattern_result": "all boundaries 0 through text_length",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "all zero-based occurrence start positions in increasing order",
    "maximum_output_bytes": 520,
    "success_result": "8 * match_count bytes",
    "no_matches_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Constant-size critical-factorization state and bounded staged match indices."
  },
  "complexity": {
    "preprocessing": "O(m) time and O(1) auxiliary space",
    "search": "O(n + m) time and O(1) auxiliary space, excluding returned positions",
    "output": "O(k) space for k reported matches"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Primary oracle computes maximal suffixes in both alphabet orders and scans across a critical factorization with period memory; the independent verifier compares every candidate start directly.",
