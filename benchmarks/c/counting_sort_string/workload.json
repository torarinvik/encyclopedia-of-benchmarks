    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "signed_64_bit_byte_count_and_byte_buffer",
    "encoding": "the input bytes sorted in ascending ASCII order",
    "empty_input": "return zero and write zero bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
    {"id":"empty-token","input_values":[0],"expected_result":0,"expected_output_hex":""},
