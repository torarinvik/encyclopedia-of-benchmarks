    {"id":"mixed-case-and-punctuation","input_values":[3,65,33,122],"expected_result":3,"expected_output_hex":"21417a"},
    {"id":"reverse-order","input_values":[3,122,121,120],"expected_result":3,"expected_output_hex":"78797a"},
    {"id":"duplicate-characters","input_values":[5,65,65,33,33,33],"expected_result":5,"expected_output_hex":"2121214141"},
    {"id":"single-character","input_values":[1,126],"expected_result":1,"expected_output_hex":"7e"},
    {"id":"undersized-output-buffer","input_values":[3,99,97,98],"workspace_bytes":2,"expected_result":-2,"expected_output_hex":""},
    {"id":"space-not-in-token-domain","input_values":[1,32],"expected_result":-1,"expected_output_hex":""},
    {"id":"nul-terminator-not-in-token-domain","input_values":[1,0],"expected_result":-1,"expected_output_hex":""},
    {"id":"input-length-mismatch","input_values":[2,97],"expected_result":-1,"expected_output_hex":""},
    {"id":"length-over-limit","input_values":[4096],"expected_result":-1,"expected_output_hex":""}
  ]
