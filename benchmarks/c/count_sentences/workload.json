{
  "schema_version": 1,
  "id": "php-count-sentences-ascii-regex-v1",
  "algorithm": "count_sentences",
  "function_symbol": "count_sentences",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[text_length, ASCII_bytes...]",
    "text_length_range": [0, 4096],
    "byte_range": [0, 127],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "count non-overlapping matches of the pinned PHP sentence regex after PHP default trim"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty","input_values":[0],"expected_result":0},
    {"id":"one_sentence","input_values":[12,72,101,108,108,111,32,119,111,114,108,100,46],"expected_result":1},
    {"id":"two_sentences","input_values":[10,72,105,46,32,84,104,101,114,101,33],"expected_result":2},
    {"id":"terminator_followed_by_word","input_values":[10,87,104,97,116,63,78,101,120,116,46],"expected_result":1},
    {"id":"consecutive_terminators","input_values":[3,65,33,63],"expected_result":1},
    {"id":"space_before_terminator","input_values":[6,97,32,46,32,98,33],"expected_result":1},
    {"id":"pipe_excluded_as_predecessor","input_values":[3,97,124,33],"expected_result":0},
    {"id":"caret_excluded_as_predecessor","input_values":[3,97,94,33],"expected_result":0},
    {"id":"period_excluded_as_predecessor","input_values":[4,97,46,46,33],"expected_result":1},
    {"id":"underscore_word_lookahead","input_values":[3,97,46,95],"expected_result":0},
    {"id":"trimmed_whitespace","input_values":[10,9,72,101,108,108,111,46,32,13,10],"expected_result":1},
    {"id":"trimmed_to_empty","input_values":[3,0,32,9],"expected_result":0},
    {"id":"form_feed_is_regex_space","input_values":[3,97,12,33],"expected_result":0},
    {"id":"malformed_length","input_values":[3,72,105],"expected_result":-1},
    {"id":"negative_byte","input_values":[1,-1],"expected_result":-1},
    {"id":"non_ascii_byte","input_values":[1,233],"expected_result":-1}
  ]
}
