{
  "schema_version": "1.0.0",
  "id": "count-min-sketch-affine-v1",
  "algorithm": "count_min_sketch_affine",
  "function_symbol": "count_min_sketch_affine",
  "comparison_model": "i64_array_bytes_output_call",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[depth,width,operation_count,(a,b)*depth,(kind,key,weight)*operation_count]",
    "depth_range": [1, 4],
    "width_range": [1, 8],
    "operation_count_range": [0, 16],
    "hash_prime": 2147483647,
    "hash": "((a[j]*key+b[j]) mod hash_prime) mod width",
    "a_range": [1, 2147483646],
    "b_range": [0, 2147483646],
    "kind_0": "positive weighted update of every selected row counter",
    "kind_1": "point query; weight field must be zero",
    "key_range": [0, 1000000],
    "update_weight_range": [1, 1000000],
    "maximum_valid_length": 59,
    "maximum_parseable_length": 60,
    "maximum_input_length": 59,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_i64_array",
    "description": "Minimum selected counter for each point query, in operation order.",
    "maximum_output_bytes": 128,
    "maximum_output_elements": 16,
    "success_result": "8 * query_count",
    "return_value": "8 * query_count",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_when_nonempty_result": -2,
    "zero_query_null_output": "success with 0 bytes"
  },
  "workspace": {
    "bytes": 384,
    "meaning": "Fixed 4x8 signed-i64 counter table plus 16 staged signed-i64 query results."
  },
  "measurement": {
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "weighted-updates-and-point-queries",
      "input_values": [2,4,6,1,0,1,1,0,1,3,0,2,2,0,1,4,1,1,0,1,3,0,1,2,0],
      "input_length": 25,
      "expected_result": 24,
      "expected_output_hex": "070000000000000000000000000000000200000000000000"
    },
    {
      "id": "collisions-remain-an-upper-estimate",
      "input_values": [2,2,3,1,0,1,1,0,0,2,1,2,0,1,3,0],
      "input_length": 16,
      "expected_result": 16,
      "expected_output_hex": "02000000000000000000000000000000"
    },
    {
      "id": "zero-operations-zero-byte-output",
      "input_values": [1,1,0,1,0],
      "input_length": 5,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "truncated-operation-frame",
      "input_values": [1,2,1,1,0,0,0],
      "input_length": 7,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-zero-hash-multiplier",
      "input_values": [1,2,0,0,0],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "query-weight-must-be-zero",
      "input_values": [1,2,1,1,0,1,4,1],
      "input_length": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [1,2,1,1,0,1,4,0],
      "input_length": 8,
      "expected_result": -2,
      "expected_output_hex": "",
      "workspace_bytes": 7,
      "capacity_error_result": -2
    }
  ]
}
