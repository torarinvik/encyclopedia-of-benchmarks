    {"id": "absolute_zero_reference", "input_values": [-273.15], "expected_result": -459.66999999999996},
    {"id": "small_positive", "input_values": [1e-12], "expected_result": 32.0000000000018},
    {"id": "small_negative", "input_values": [-1e-12], "expected_result": 31.9999999999982},
    {"id": "large_positive", "input_values": [1e100], "expected_result": 1.8e100},
