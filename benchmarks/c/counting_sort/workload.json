{
  "schema_version": 1,
  "id": "counting_sort-v1",
  "algorithm": "counting_sort",
  "abi": "mutable_i64_with_scratch",
  "input": {
    "lengths": [
      0,
      16,
      256,
      1024
    ],
    "generation": {
      "kind": "modular_affine",
      "multiplier": 73,
      "modulus": 257,
      "offset": 128,
      "formula": "values[index] = ((index * 73) mod 257) - 128"
