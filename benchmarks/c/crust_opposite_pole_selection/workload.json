  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,(sx,sy,sz,k,(vx,vy,vz)*k)*n]",
    "sample_count_range": [1, 8],
    "vertices_per_cell_range": [1, 8],
    "coordinate_range": [-16, 16],
    "maximum_valid_length": 225,
    "maximum_parseable_length": 226,
    "invalid_result": -1,
    "row_semantics": "Each row supplies one non-convex-hull sample and the finite Voronoi-cell vertex candidates for that sample; cell construction and completeness are caller preconditions."
  },
  "contract": {
    "algorithm": "For each row, choose the candidate with maximum squared distance from the sample as positive pole; choose the maximum-distance candidate with strictly negative dot product against the positive displacement as negative pole.",
    "tie_rule": "Equal squared distances choose the lowest row-local candidate ordinal. Dot product zero is not opposite and is excluded.",
    "no_opposite_rule": "When no candidate has negative dot product, emit -1 as the negative ordinal. This totalizes the bounded selector outside the source sampling promise.",
    "output": "[n,(positive_ordinal,negative_ordinal)*n] as little-endian signed i64 values.",
    "scope": "Pole selection only for the non-convex-hull branch; Voronoi construction, convex-hull normal estimation, augmented Delaunay construction, facet filtering, and reconstruction guarantees are excluded."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[n,(positive_ordinal,negative_ordinal)*n]",
    "maximum_bytes": 136,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Bounded row parsing, sample/candidate validation, and staged ordinal output; caller-owned input and output buffers are excluded."
  },
