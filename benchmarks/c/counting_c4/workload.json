  },
  "contract": {
    "operation": "For every edge ID, count three-edge-ID selections that form a C4 with it.",
    "input_layout": "[n, m, (u, v)*m]",
    "official_limits": {"vertex_count": [2, 300000], "edge_count": [1, 300000]},
    "vertex_count_range": [2, 8],
    "edge_count_range": [1, 12],
    "vertex_ids": "zero-based",
    "graph_semantics": "Undirected multigraph; parallel edge IDs are distinct.",
    "self_loops": "Invalid.",
    "cycle_semantics": "The four selected edges must form a subgraph isomorphic to C4; other graph edges are ignored.",
    "algorithm": "For each edge (u,v), sum mult[u][a]*mult[a][b]*mult[b][v] over ordered, pairwise-distinct a,b,u,v.",
    "output_encoding": "one unsigned 64-bit little-endian count per edge, in input edge order",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Input framing, ranges, and endpoint validation precede output pointer and capacity checks."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 26,
    "maximum_parseable_length": 26,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_unsigned_64_bit_array",
    "element_width_bytes": 8,
    "maximum_elements": 12,
    "maximum_bytes": 96,
    "success_result": "8*m",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded multiplicity matrix, per-edge answer vector, and output staging buffer."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
