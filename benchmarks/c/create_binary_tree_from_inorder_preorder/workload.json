{
  "schema_version": 1,
  "id": "create-binary-tree-from-inorder-preorder-v1",
  "algorithm": "create_binary_tree_from_inorder_preorder",
  "function_symbol": "create_binary_tree_from_inorder_preorder",
  "input": {
    "kind": "packed_preorder_inorder_i32_values",
    "layout": "[n, preorder values..., inorder values...]",
    "minimum_nodes": 0,
    "maximum_nodes": 63,
    "value_range": [
      -2147483648,
      2147483647
    ],
    "tree_requirement": "Both traversals contain exactly the same unique values.",
    "output": "Preorder node serialization: marker 1, signed i32 little-endian value, left subtree, right subtree; marker 0 for null.",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "empty_tree",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": 0,
      "expected_output_hex": "00"
    },
    {
      "id": "general_tree_not_bst",
      "input_values": [
        3,
        10,
        40,
        5,
        40,
        10,
        5
      ],
      "input_length": 7,
      "expected_result": 3,
      "expected_output_hex": "010a0000000128000000000001050000000000"
    },
    {
      "id": "balanced_tree",
      "input_values": [
        5,
        1,
        2,
        4,
        5,
        3,
        4,
        2,
        5,
        1,
        3
      ],
      "input_length": 11,
      "expected_result": 5,
      "expected_output_hex": "01010000000102000000010400000000000105000000000001030000000000"
    },
    {
      "id": "left_chain",
      "input_values": [
        3,
        3,
        2,
        1,
        1,
        2,
        3
      ],
      "input_length": 7,
      "expected_result": 3,
      "expected_output_hex": "01030000000102000000010100000000000000"
    },
    {
      "id": "right_chain",
      "input_values": [
        3,
        1,
        2,
        3,
        1,
        2,
        3
      ],
      "input_length": 7,
      "expected_result": 3,
      "expected_output_hex": "01010000000001020000000001030000000000"
    },
    {
      "id": "signed_boundary_values",
      "input_values": [
        3,
        0,
        -2147483648,
        2147483647,
        -2147483648,
        0,
        2147483647
      ],
      "input_length": 7,
      "expected_result": 3,
      "expected_output_hex": "01000000000100000080000001ffffff7f0000"
    },
    {
      "id": "duplicate_value",
      "input_values": [
        3,
        1,
        1,
        2,
        1,
        1,
        2
      ],
      "input_length": 7,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "inconsistent_traversals",
      "input_values": [
        3,
        1,
        2,
        3,
        3,
        1,
        2
      ],
      "input_length": 7,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "wrong_packed_length",
      "input_values": [
        2,
        1,
        2,
        1
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
