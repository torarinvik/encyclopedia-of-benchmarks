{
  "schema_version": "1.0.0",
  "id": "count-min-sketch-width-one-collision-v1",
  "algorithm": "count_min_sketch_width_one_collision",
  "function_symbol": "count_min_sketch_width_one_collision",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation_count, (operation, key)...]",
    "operation_count_range": [
      0,
      256
    ],
    "operations": {
      "0": "insert one occurrence of key",
      "1": "query key frequency estimate"
    },
    "key_range": [
      -1000000,
      1000000
    ],
    "sketch_width": 1,
    "sketch_depth": 3,
    "all_keys_collide": true,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "maximum_input_length": 513
  },
  "output": {
    "kind": "little_endian_i64_array",
    "description": "One estimate per query, in operation order; with width one and unit increments each estimate equals the number of inserts so far.",
    "return_value": "output byte length (8 * query_count)",
    "maximum_output_bytes": 2048,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
