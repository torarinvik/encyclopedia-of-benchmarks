{
  "schema_version": 1,
  "id": "comp-filt-haskell-i64-array-float64-v1",
  "algorithm": "comp_filt",
  "function_symbol": "comp_filt",
  "input": {
    "kind": "bounded_signed_i64_array",
    "layout": [
      "alpha_ppm",
      "delta_t_micro",
      "sample_count",
      "output_index",
      "rates[0..n-1]",
      "accelerometer_angles[0..n-1]"
