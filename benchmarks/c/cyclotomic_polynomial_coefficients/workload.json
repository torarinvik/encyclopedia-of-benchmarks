    "success_result": "8*(phi(n)+1)",
    "invalid_result": -1,
    "null_or_insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "Fixed cache for Phi_1 through Phi_32, degree table, three polynomial work arrays, scalar state, and conservative alignment allowance; caller input and output are excluded."
