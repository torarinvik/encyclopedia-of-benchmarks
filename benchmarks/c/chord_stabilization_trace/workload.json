  "abi": "i64_array_bytes_output",
  "description": "Atomic replay of Chord successor stabilization and predecessor notifications.",
  "input": {"kind": "signed_64_bit_integer_array", "encoding": "[bits,n,q,ids[n],successor_indices[n],predecessor_indices[n],schedule[q]]", "maximum_valid_length": 115, "maximum_parseable_length": 115, "invalid_input_result": -1},
  "output": {"kind": "byte_vector", "encoding": "successor indices then predecessor indices; 255 means absent", "maximum_bytes": 32, "null_output_result": -2, "insufficient_capacity_result": -2, "no_write_on_error": true},
  "workspace": {"bytes": 1024, "meaning": "Node IDs, successor and predecessor arrays, and staged output."},
