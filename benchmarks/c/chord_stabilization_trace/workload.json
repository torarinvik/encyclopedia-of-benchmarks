  "cases": [
    {"id": "discover_intermediate_successor", "input_values": [3,3,1,1,3,6,2,2,0,-1,-1,1,0], "input_length": 13, "output_capacity": 6, "expected_result": 6, "expected_output_hex": "010200ff0001"},
    {"id": "sequential_notifications", "input_values": [3,3,3,1,3,6,2,2,0,-1,-1,1,0,1,2], "input_length": 15, "output_capacity": 6, "expected_result": 6, "expected_output_hex": "010200020001"},
    {"id": "wraparound_intermediate_successor", "input_values": [3,3,1,1,3,6,1,2,1,-1,0,0,2], "input_length": 13, "output_capacity": 6, "expected_result": 6, "expected_output_hex": "010200020000"},
    {"id": "single_node_notify_self", "input_values": [1,1,1,0,0,-1,0], "input_length": 7, "output_capacity": 2, "expected_result": 2, "expected_output_hex": "0000"},
    {"id": "short_output", "input_values": [1,1,0,0,0,-1], "input_length": 6, "output_capacity": 1, "expected_result": -2, "expected_output_hex": ""},
    {"id": "bad_pointer", "input_values": [1,1,0,0,1,-1], "input_length": 6, "output_capacity": 2, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_before_null_output", "input_values": [1,1,0,0,1,-1], "input_length": 6, "output_capacity": 0, "output_is_null": true, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null_output", "input_values": [1,1,0,0,0,-1], "input_length": 6, "output_capacity": 0, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
