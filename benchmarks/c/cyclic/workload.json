{
  "schema_version": 1,
  "id": "thealgorithms-go-cyclic-linked-list-v1",
  "algorithm": "cyclic",
  "function_symbol": "cyclic",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation_count, (opcode, argument)...]",
    "operation_count_range": [
      0,
      64
    ],
    "operations": {
      "0": "Add(value)",
      "1": "Rotate(places)",
      "2": "Delete()",
      "3": "Walk()",
      "4": "JosephusProblem(k)",
      "5": "Destroy()"
    },
    "bounds": "Values are signed int32. Rotate and Josephus steps are from -1,000,000 through 1,000,000. Delete, Walk, and Destroy require argument 0. JosephusProblem requires a nonempty list. The maximum number of operations bounds node allocation to 64.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[query_count, for each recorded operation: (operation_index, opcode, value_count, values...), final_size, final_values...]",
    "semantics": "Delete records its bool result as 0 or 1. Walk records the values in the order printed from Head. JosephusProblem records the winner, then leaves the list empty because the Go method calls Destroy. Rotate moves Head by the mathematical step modulo list size and follows the source choice to traverse the shorter direction."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
