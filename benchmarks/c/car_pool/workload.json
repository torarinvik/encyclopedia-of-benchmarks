{
  "schema_version": 1,
  "id": "car-pool-difference-timeline-v1",
  "algorithm": "car_pool",
  "function_symbol": "car_pool",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[capacity, trip_count, passengers, origin, destination, ...]",
    "maximum_trips": 64,
    "capacity_domain": [
      0,
      1000
    ],
    "passengers_domain": [
      1,
      1000
    ],
    "stop_domain": [
      0,
      1000
    ],
    "invalid_input_result": -1,
    "output": "1 when no passenger timeline exceeds capacity, otherwise 0. A trip occupies [origin,destination)."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [
        0,
        0
      ],
      "expected_result": 1
    },
    {
      "id": "capacity_exceeded",
      "input_values": [
        4,
        2,
        2,
        1,
        5,
        3,
        3,
        7
      ],
      "expected_result": 0
    },
    {
      "id": "capacity_exact",
      "input_values": [
        5,
        2,
        2,
        1,
        5,
        3,
        5,
        7
      ],
      "expected_result": 1
    },
    {
      "id": "pickup_at_dropoff",
      "input_values": [
        3,
        2,
        2,
        1,
        5,
        3,
        5,
        7
      ],
      "expected_result": 1
    },
    {
      "id": "overlap_from_zero",
      "input_values": [
        3,
        2,
        2,
        0,
        1,
        2,
        0,
        1
      ],
      "expected_result": 0
    },
    {
      "id": "last_stop_boundary",
      "input_values": [
        1,
        1,
        1,
        999,
        1000
      ],
      "expected_result": 1
    },
    {
      "id": "missing_trip_fields",
      "input_values": [
        10,
        1,
        2,
        1
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_capacity",
      "input_values": [
        -1,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_trip_count",
      "input_values": [
        10,
        65
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_passengers",
      "input_values": [
        10,
        1,
        0,
        0,
        1
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_stops",
      "input_values": [
        10,
        1,
        1,
        2,
        2
      ],
      "expected_result": -1
    }
  ]
}
