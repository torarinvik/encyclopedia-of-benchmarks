  "function_symbol": "convex_polygon_minimax_length_triangulation",
  "abi": "i64_array_scalar",
  "description": "Minimum possible squared length of the longest edge in a triangulation of a strictly convex polygon.",
  "source": {
    "title": "Optimal Triangulation",
    "author": "Tiow-Seng Tan",
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_715",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_715",
    "copyright": "Springer; use the problem objective and high-level description only."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[vertex_count, x0, y0, ..., x(vertex_count-1), y(vertex_count-1)]",
    "vertex_count_range": [3, 12],
    "coordinate_range": [-1000, 1000],
    "vertex_order": "strictly convex boundary order, clockwise or counterclockwise",
    "exact_length": "1 + 2*vertex_count",
    "maximum_valid_length": 25,
    "maximum_parseable_length": 26,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "minimum possible maximum squared Euclidean edge length, including polygon boundary edges",
    "invalid_input_result": -1
  },
  "algorithm_details": {
    "primary": "Interval minimax dynamic programming over vertex intervals; each split combines the two subinterval optima and the interval closing edge.",
    "independent_oracle": "Recursively enumerate every triangulation of the convex polygon, collect its boundary and diagonal edges, and directly minimize each triangulation's maximum squared edge length.",
    "primary_complexity": "O(N^3) time and O(N^2) space.",
    "oracle_complexity": "O(Catalan(N-2)*N) time and output-sized space."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
