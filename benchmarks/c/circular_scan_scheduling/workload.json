{
  "schema_version": 1,
  "id": "circular-scan-java-service-order-v1",
  "algorithm": "circular_scan_scheduling",
  "function_symbol": "circular_scan_scheduling",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[disk_size, start_position, moving_up, request_count, requests...]",
    "disk_size_range": [
      1,
      128
    ],
    "start_position_range": "0..disk_size-1",
    "moving_up_values": [
      0,
      1
    ],
    "request_count_range": [
      0,
      64
    ],
    "request_value_range": [
      -128,
      127
    ],
    "maximum_input_values": 68,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "unsigned_byte_vector",
    "encoding": "one byte per visited request in source order; signed requests use two's-complement bytes",
    "successful_result": "number of visited requests",
    "maximum_length": 64
  },
  "workspace": {
    "bytes": 64,
    "meaning": "Maximum number of visited requests"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "upward_includes_start_and_filters_past_disk",
