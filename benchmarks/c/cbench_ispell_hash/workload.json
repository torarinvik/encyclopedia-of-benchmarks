    "scope_note": "Profiles only hash.c::hash under a documented ASCII conversion profile; dictionary, spellchecking, input/output and launcher are excluded."
  },
  "contract": {
    "operation": "Compute the source-derived 32-bit Ispell hash bucket for an ASCII word.",
    "input_layout": "[table_size, word_byte_0, ...]",
    "word_byte_range": [
      1,
      127
    ],
    "max_word_bytes": 64,
    "table_size_range": [
      1,
      2147483647
    ],
    "algorithm": "Pack the first up to four uppercase-converted ASCII bytes into a 32-bit state; for each remaining byte rotate state left by 5 bits and XOR the uppercase-converted byte; return unsigned state modulo table_size.",
    "invalid_result": -1
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[table_size, ASCII word bytes...]",
    "maximum_valid_array_length": 65,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "Hash table bucket index",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
