  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,k,trial_count,edge_pairs[2*m],colors[trial_count*n]]",
    "vertex_count_range": [1, 12],
    "edge_count_range": [0, 66],
    "k_range": [1, 6],
    "trial_count_range": [1, 8],
    "maximum_valid_length": 232,
    "invalid_result": -1
  },
  "contract": {
    "graph": "Simple undirected graph with zero-based vertices and no duplicate edges or loops.",
    "colorings": "Each consecutive n-word row supplies one coloring in trial order; every color is in [0,k).",
    "trial": "Run subset/endpoint dynamic programming to find a simple path with exactly k vertices and pairwise distinct colors.",
    "selection": "Return the first successful trial. Within that trial choose the lexicographically smallest path vertex sequence.",
    "output": "Success is [1,one_based_trial_index,path_vertices...]. If no trial succeeds, return [0,0].",
    "profile_scope": "Supplied colorings replay the random choices. The package omits random-number generation and makes no probabilistic success or expected-time claim."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[found,trial_index,path...] or [0,0]",
    "maximum_bytes": 64,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 32768,
    "meaning": "Adjacency masks, at most eight colorings, subset/endpoint reachability and lexicographic witness paths for 12 vertices and k<=6."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 3,
    "warmup_rounds": 1,
    "repetitions_per_sample": 3
  },
