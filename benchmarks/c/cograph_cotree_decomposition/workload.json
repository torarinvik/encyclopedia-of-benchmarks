{
  "schema_version": 1,
  "id": "cograph-cotree-decomposition-i64-array-bytes-output-v1",
  "algorithm": "cograph_cotree_decomposition",
  "function_symbol": "cograph_cotree_decomposition",
  "abi": "i64_array_bytes_output",
  "description": "Recognize a bounded cograph and serialize its reduced union/join cotree.",
  "source": {
    "title": "Complement Reducible Graphs; A Linear Recognition Algorithm for Cographs",
    "authors": ["D. G. Corneil", "H. Lerchs", "L. Stewart Burlingham", "Y. Perl"],
    "urls": [
      "https://doi.org/10.1016/0166-218X(81)90013-5",
      "https://doi.org/10.1137/0214065"
    ],
    "reuse": "Algorithmic characterization only; contract, fixtures, references, and ports are clean-room."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,(u,v)*M]",
    "vertex_count_range": [1, 12],
    "edge_count_range": [0, 66],
    "graph": "Undirected simple graph; 0<=M<=N*(N-1)/2, unordered distinct endpoint pairs, zero-based IDs; either endpoint order accepted; duplicate unordered edges rejected.",
    "exact_length": "2+2*M",
    "maximum_valid_input_length": 134,
    "maximum_parseable_input_length": 135,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "00 for a valid non-cograph; 01 followed by preorder two-byte cotree records for a cograph. Record (00,v) is leaf v, (01,k) is disjoint union with k children, and (02,k) is complete join with k children.",
    "child_order": "Ascending minimum vertex ID in each child's leaf set.",
    "maximum_output_bytes": 47,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "input_validation_precedes_output_errors": true,
    "output_untouched_on_error": true
  },
  "algorithm_profile": {
    "primary": "Recursively split each induced graph into connected components for union nodes; if connected, split its complement into components for join nodes; if both are connected, reject as not a cograph.",
    "independent": "First check the induced-P4 characterization directly; enumerate all nonempty subsets as graph modules, retain strong modules, build their inclusion tree, and require every internal quotient to be a complete join or disjoint union.",
    "tie_policy": "Connected components and cotree children are ordered by increasing minimum vertex ID. The reduced cotree has alternating internal labels and at least two children per internal node.",
    "non_cograph_result": "A valid graph that is not a cograph writes byte 00 and returns 1."
  },
  "complexity": {
    "primary_time": "O(N^2) bounded adjacency-mask work across recursively partitioned induced graphs; N<=12",
    "primary_auxiliary_space": "O(N) recursion and component state, plus at most 47 staged output bytes",
    "independent_time": "O(4^N+N^2*2^N) worst-case module and overlap enumeration; N<=12",
    "independent_auxiliary_space": "O(2^N+N)"
  },
  "workspace": {
    "bytes": 47,
    "meaning": "Maximum caller-owned output capacity, equal to the declared maximum serialized cotree length."
  },
  "memory": {
    "internal_scratch_bytes": 2048,
    "meaning": "Fixed adjacency masks, recursive component masks, traversal queues, and staged cotree tokens."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "primary_oracle": "benchmarks/c/cograph_cotree_decomposition/primary_oracle.py",
  "independent_oracle": "benchmarks/c/cograph_cotree_decomposition/independent_oracle.py",
