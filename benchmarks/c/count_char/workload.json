{
  "id": "count-char-java-ascii-v1",
  "algorithm": "count_char",
  "function_symbol": "count_char",
  "contract": {
    "input": "A sequence of 0 through 4,096 ASCII code values in 0..127.",
    "output": "Number of code values other than Java default-regex whitespace 9, 10, 11, 12, 13, and 32.",
    "invalid_input_result": -1,
    "empty_sequence_result": 0,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty","input_values":[],"input_length":0,"expected_result":0},
    {"id":"plain-ascii","input_values":[65,66,67,32,68],"input_length":5,"expected_result":4},
    {"id":"all-six-java-whitespace","input_values":[9,10,11,12,13,32],"input_length":6,"expected_result":0},
    {"id":"repeated-non-whitespace","input_values":[97,97,97,97],"input_length":4,"expected_result":4},
    {"id":"embedded-nul","input_values":[65,0,66],"input_length":3,"expected_result":3},
    {"id":"other-control-codes-count","input_values":[1,8,14,31,127],"input_length":5,"expected_result":5},
    {"id":"invalid-negative-code","input_values":[65,-1],"input_length":2,"expected_result":-1},
    {"id":"invalid-code-above-ascii","input_values":[128],"input_length":1,"expected_result":-1},
    {"id":"oversized-length","input_values":[],"input_length":4097,"expected_result":-1}
  ]
}
