{
  "schema_version": 1,
  "id": "circle-polygon-intersection-area-i64-array-float64-v1",
  "algorithm": "circle_polygon_intersection_area",
  "function_symbol": "circle_polygon_intersection_area",
  "abi": "i64_array_float64",
  "description": "Area common to a circle and a strictly convex CCW polygon containing the circle center.",
  "source": {
    "title": "KACTL CirclePolygonIntersection.h",
    "authors": ["KACTL contributors"],
    "reference": "KACTL geometry chapter index and CirclePolygonIntersection.h description",
    "url": "https://github.com/kth-competitive-programming/kactl/blob/main/content/geometry/CirclePolygonIntersection.h",
    "index_url": "https://raw.githubusercontent.com/kth-competitive-programming/kactl/main/content/geometry/chapter.tex",
    "license": "CC0",
    "algorithm_attribution": "Oriented circular-sector and triangle contributions along polygon edges",
    "implementation_status": "clean-room implementations from the algorithm description"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, cx, cy, r, x0, y0, ..., x(N-1), y(N-1)]",
    "vertex_count_range": [3, 16],
    "coordinate_range": [-32, 32],
    "radius_range": [1, 32],
    "requirements": [
      "exact length is 4 + 2*N",
      "vertices are distinct and strictly convex",
      "vertices appear in counterclockwise order",
      "circle center lies strictly inside the polygon"
    ],
    "maximum_valid_input_length": 36,
    "maximum_parseable_input_length": 37,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "Nonnegative area of the intersection between the circle and polygon.",
    "result_range": [0, 3216.991],
    "result_range_upper_bound": 3216.991,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "complexity": {
    "primary_time": "O(N) edge contributions after O(N^2) strict-convexity and center validation",
    "primary_auxiliary_space": "O(N) fixed point storage",
    "independent_oracle_time": "Adaptive angular integration over O(N) event intervals; each integrand evaluation scans O(N) edges"
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12,
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
