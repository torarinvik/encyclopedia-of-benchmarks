{
  "schema_version": 1,
  "id": "circular-arc-length-sector-area-v1",
  "algorithm": "circular_arc",
  "function_symbol": "circular_arc",
  "input": {
    "kind": "signed_64_bit_mode_and_integer_parameters",
    "layout": "[mode, radius, degrees]",
    "mode": {"0":"arc length","1":"sector area"},
    "radius_range": [-1000000, 1000000],
    "degrees_range": [-360000, 360000],
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "float64",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "formula": {
      "0": "radius * (degrees * (pi / 180))",
      "1": "(radius * radius * (degrees * (pi / 180))) / 2"
    },
    "invalid_input_result": -1e300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
