    {"id":"multiple_turns","input_values":[0,1,720],"expected_result":12.566370614359172},
    {"id":"maximum_radius_and_degrees_length","input_values":[0,1000000,360000],"expected_result":6283185307.179586},
    {"id":"maximum_radius_and_degrees_area","input_values":[1,1000000,360000],"expected_result":3141592653589793.0},
