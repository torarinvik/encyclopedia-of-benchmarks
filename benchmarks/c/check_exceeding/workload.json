{
  "id": "check-exceeding-v1",
  "algorithm": "check_exceeding",
  "contract": {
    "input": "A sequence of zero through 4,096 printable ASCII code values in 32..126.",
    "output": "1 when the source's normalized, filtered-letter adjacent gaps are nondecreasing; otherwise 0. Equal adjacent letters produce no gap.",
    "invalid_input_result": -2,
    "empty_sequence_result": 1,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "pinned-delete-example",
      "input_values": [100, 101, 108, 101, 116, 101],
      "input_length": 6,
      "expected_result": 1
    },
    {
      "id": "pinned-update-example",
      "input_values": [117, 112, 100, 97, 116, 101],
      "input_length": 6,
      "expected_result": 0
    },
    {
      "id": "case-normalization",
      "input_values": [97, 66, 99],
      "input_length": 3,
      "expected_result": 1
    },
    {
      "id": "ignore-nonletters",
      "input_values": [65, 49, 33, 66],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "equal-adjacent-letters-omitted",
      "input_values": [65, 65, 66, 66, 67],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "decreasing-gap",
      "input_values": [65, 90, 66, 89],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": 1
    },
    {
      "id": "invalid-control-value",
      "input_values": [65, 10, 66],
      "input_length": 3,
      "expected_result": -2
    },
    {
      "id": "invalid-non-ascii-value",
      "input_values": [65, 233, 66],
      "input_length": 3,
      "expected_result": -2
    }
  ]
}
