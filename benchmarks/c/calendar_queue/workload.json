{
  "schema_version": 1,
  "algorithm": "calendar_queue",
  "function_symbol": "calendar_queue",
  "abi": "i64_array_bytes_output",
  "description": "Brown calendar queue over a bounded stream of integer-tick enqueue and dequeue operations.",
  "source": {
    "title": "Calendar Queues: A Fast O(1) Priority Queue Implementation for the Simulation Event Set Problem",
    "author": "Randy Brown",
    "doi": "10.1145/63039.63045",
    "url": "https://doi.org/10.1145/63039.63045",
    "publication": "Communications of the ACM 31(10), 1220-1227 (1988)",
    "sections": "2-4",
    "discovery_url": "https://xlinux.nist.gov/dads/HTML/calendarQueue.html"
  },
  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation_count,(opcode,priority_or_zero)*operation_count]",
    "operation_count_range": [0, 128],
    "maximum_valid_length": 257,
    "maximum_parseable_length": 258,
    "enqueue_opcode": 1,
    "dequeue_opcode": 2,
    "priority_tick_range": [0, 1000000],
    "dequeue_second_word": 0,
    "maximum_live_events": 64,
    "priority_order_constraint": "An enqueued priority must be at least the last dequeued priority.",
    "invalid_result": -1,
    "validation_order": "Validate input pointer and outer frame length; operation count and exact length; then execute operations in order, validating opcode, operation argument, priority range/order, queue underflow, and live-event capacity; compute trace; then validate output pointer and capacity."
  },
  "profile": {
    "initial_calendar": "2 buckets, width 1 tick, last priority 0",
    "bucket_index": "floor(priority / width) modulo bucket_count",
    "bucket_width": "Exact positive rational; recalculated by Brown's bounded sample/filter rule on resize. Width falls back to 1 tick if sampled gaps are all zero.",
    "grow_threshold": "Resize to twice the bucket count when live size exceeds twice the current bucket count.",
    "shrink_threshold": "Resize to half the bucket count when live size is below bucket_count/2 - 2; never shrink below two buckets.",
    "width_sample": "If qsize<2, width=1. Otherwise sample all qsize events for qsize<=5, else min(25,5+floor(qsize/10)) earliest events. Compute adjacent-gap mean, retain gaps no greater than twice the first mean, then use three times the retained-gap mean.",
    "dequeue_scan": "Circular scan from lastbucket; a bucket head is eligible below buckettop, which starts 1.5 widths above the current virtual bucket and advances by one width per bucket. After a full empty calendar, directly scan bucket heads for the global minimum, reset the cursor, and resume.",
    "tie_rule": "Equal priorities are ordered by increasing zero-based enqueue ordinal.",
    "empty_dequeue": "Invalid input; returns -1.",
    "output": "[dequeue_count,(event_id,priority)*dequeue_count], little-endian signed 64-bit words."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "layout": "[dequeue_count,(event_id,priority)*dequeue_count]",
    "maximum_bytes": 1032,
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Conservative cap for 64 event records, circular bucket heads, resize-width ordering scratch, up to 128 trace words, rational-width state, and language-specific alignment during a resize; caller-owned buffers are excluded."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
