  "contract": {
    "operation": "Given f(x)=sum(a_i*x^i) and g(x)=sum(b_i*x^i), with b_0=0, return f(g(x)) modulo x^N over F_998244353.",
    "input_layout": "[N, a_0, ..., a_(N-1), b_0, ..., b_(N-1)]",
    "n_range": [1, 16],
    "coefficient_range": [0, 998244352],
    "inner_constant_condition": "b_0 = 0",
    "algorithm": "Direct descending Horner composition with truncated coefficient products; O(N^3) worst case.",
    "modulus": 998244353,
    "output_layout": "N little-endian signed 64-bit coefficients c_0 through c_(N-1).",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, a_0, ..., a_(N-1), b_0, ..., b_(N-1)]",
    "maximum_valid_length": 33,
    "maximum_parseable_length": 34,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 16,
    "maximum_bytes": 128,
    "success_result": "8*N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 128,
    "meaning": "One bounded 16-coefficient Horner accumulator."
