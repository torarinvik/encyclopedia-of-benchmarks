    "discovery_scope": "Algorithm description and navigation taxonomy only; no source code, prose, tests, or examples copied."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[cx,cy,r,Q,(a,b,c)*Q]",
    "center_coordinate_range": [-1000, 1000],
    "radius_range": [0, 1000],
    "query_count_range": [0, 32],
    "normal_coefficient_range": [-100, 100],
    "line_constant_range": [-200000, 200000],
    "line_rule": "a and b may not both be zero",
    "exact_length": "4+3*Q",
    "maximum_valid_length": 100,
    "maximum_parseable_length": 101,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
