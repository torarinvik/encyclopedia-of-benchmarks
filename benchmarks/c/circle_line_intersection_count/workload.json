    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "zero_query_result": 0
  },
  "workspace": {
    "bytes": 256,
    "meaning": "Maximum external output-buffer capacity; line coefficients and staged counts use bounded fixed storage."
  },
  "algorithm_details": {
    "primary": "Translate each line to the circle center and compare D=r^2*(a^2+b^2)-k^2 against zero, where k=a*cx+b*cy+c.",
    "independent_oracle": "Substitute a line parameter into the circle equation and classify the quadratic discriminant, with a direct vertical-line branch.",
    "primary_complexity": "O(Q) time and O(Q) output staging space.",
    "oracle_complexity": "O(Q) time and O(Q) space."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
