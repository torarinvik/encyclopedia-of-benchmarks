{
  "schema_version": 1,
  "id": "polybench-covariance-i64-array-f64-v1",
  "algorithm": "covariance",
  "function_symbol": "covariance",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[n, m] where n is observation count and m is variable count",
    "input_length": 2,
    "observation_range": [2, 64],
    "variable_range": [1, 64],
    "maximum_input_length": 2
  },
  "output": {
    "kind": "binary64",
    "meaning": "sum of the final covariance matrix in row-major order",
    "invalid_input_result": -1e300
  },
  "source_bound": {
    "description": "PolyBench/C defaults to binary64. It initializes float_n=n and data[i][j]=(double(i)*j)/m. For each variable j, mean[j] starts at zero, accumulates data[i][j] for observations i ascending, then divides by n. It centers data in row-major order. It computes the upper triangle with i ascending, j from i upward, and k observations ascending, divides each sum by n-1, then mirrors cov[i][j] into cov[j][i]. The scalar suite output reduces the finished covariance matrix row-major. The launcher selects no dataset flag, so the header defaults to LARGE (m=1200,n=1400); suite dimensions are bounded to n=2..64 and m=1..64.",
    "repository": "https://github.com/lac-dcc/Benchmarks",
    "commit": "5d7b75df749241efa7a6e6f5be613d3fcc5cce38",
    "path": "PolyBench/datamining/covariance/covariance.c",
    "launcher_path": "PolyBench/datamining/covariance/info.sh",
    "launcher": {
      "benchmark_name": "covariance",
      "source_selection": "*.c",
      "compile_flags": ["-I.", "-DPOLYBENCH_DUMP_ARRAYS"],
      "run_options": []
    },
    "original_contributor": "PolyBench/C (Louis-Noel Pouchet and Tomofumi Yuki)",
    "license_note": "The source file has no explicit license notice; this package contains independently written ports of the published kernel."
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {"id": "one_variable_two_observations", "input_values": [2, 1], "input_length": 2, "expected_result": 0.0},
    {"id": "two_variables_two_observations", "input_values": [2, 2], "input_length": 2, "expected_result": 0.125},
    {"id": "three_variables_two_observations", "input_values": [2, 3], "input_length": 2, "expected_result": 0.5},
    {"id": "two_variables_three_observations", "input_values": [3, 2], "input_length": 2, "expected_result": 0.25},
    {"id": "three_variables_three_observations", "input_values": [3, 3], "input_length": 2, "expected_result": 1.0},
    {"id": "empty_invalid", "input_values": [], "input_length": 0, "expected_result": -1e300},
    {"id": "short_input_invalid", "input_values": [3], "input_length": 1, "expected_result": -1e300},
    {"id": "one_observation_invalid", "input_values": [1, 3], "input_length": 2, "expected_result": -1e300},
    {"id": "zero_variables_invalid", "input_values": [3, 0], "input_length": 2, "expected_result": -1e300},
    {"id": "first_unsupported_observation_count_invalid", "input_values": [65, 3], "input_length": 2, "expected_result": -1e300}
  ]
}
