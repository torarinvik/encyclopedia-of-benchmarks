      1,
      8
    ],
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[solved (0 or 1), row-major cells...]",
    "search_order": "Find first blank row-major; try remaining words in current list order, vertical then horizontal. Place only if every covered cell is blank. After a failed branch, append the word to the end of the remaining list, matching the pinned Java implementation. No blank cells means solved, even with unused words."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
