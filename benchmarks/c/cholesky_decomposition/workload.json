{
  "schema_version": 1,
  "id": "cholesky-decomposition-bounded-f64-vector-v1",
  "algorithm": "cholesky_decomposition",
  "function_symbol": "cholesky_decomposition",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[n, row-major n*n matrix entries in micro-units]",
    "dimension_range": [
      1,
      6
    ],
    "entry_scale": 1000000,
    "entry_range_micro_units": [
      -1000000000,
      1000000000
    ],
    "maximum_input_length": 37,
    "matrix_domain": "finite real-valued matrix after division by 1,000,000; source allclose symmetry check; every Cholesky pivot must be positive",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_vector",
    "meaning": "full n-by-n lower-triangular factor L in row-major order; entries above the diagonal are zero",
    "encoding": "n*n little-endian IEEE-754 binary64 values",
    "return_value": "output byte length (8*n*n)",
    "max_length": 36,
    "max_output_bytes": 288,
    "absolute_tolerance": 1e-09,
    "relative_tolerance": 1e-09,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "source_semantics": {
    "symmetry_check": "NumPy allclose defaults: abs(a-b) <= 1e-8 + 1e-5*abs(b), applied to matrix and transpose.",
    "failure_behavior": "The source asserts square/symmetric input and raises ValueError for a nonpositive pivot; this bounded ABI maps malformed, nonsymmetric, or non-positive-definite inputs to -1 with empty output.",
    "factorization": "Use the source lower-triangle recurrence and return the entire lower-triangular matrix, including zeros above the diagonal."
  },
  "workspace": {
    "bytes": 288,
    "meaning": "maximum output capacity"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
