  "input": {
    "kind": "packed_opcode_payload_pairs",
    "encoding": "[opcode,payload] repeated for each operation",
    "opcodes": {
      "0": "append value",
      "1": "prepend value",
      "2": "remove first with payload 0",
      "3": "remove last with payload 0",
      "4": "remove first matching value",
      "5": "contains value",
      "6": "length with payload 0",
      "7": "get at strict zero-based index",
      "8": "remove at strict zero-based index"
    },
    "value_range": [
      -1000000,
      1000000
    ],
    "index_payload_range": [
      0,
      1000000
    ],
    "capacity": 256,
    "maximum_operations": 512,
    "invalid_result": -1,
    "checksum": "weighted operation observations plus one forward traversal of the remaining circular list"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
