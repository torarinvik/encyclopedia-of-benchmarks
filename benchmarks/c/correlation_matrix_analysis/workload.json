{
  "schema_version": 1,
  "id": "r-correlation-matrix-analysis-pearson-fixed-four-v1",
  "algorithm": "correlation_matrix_analysis",
  "function_symbol": "correlation_matrix_analysis",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[observation_count=4, variable_count=p, row_major_values...]",
    "observation_count": 4,
    "variable_count_range": [
      2,
      5
    ],
    "value_range": [
      -1000,
      1000
    ],
    "reject_constant_columns": true,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "four_little_endian_binary64_matrices_followed_by_six_little_endian_i64_summary_values",
    "matrix_order": [
      "correlation",
      "raw_p_values",
      "bonferroni_adjusted_p_values",
      "fdr_adjusted_p_values"
    ],
    "matrix_shape": "p by p row-major",
    "summary_order": [
      "sample_size",
      "variables",
      "missing_rows",
      "significant_uncorrected",
      "significant_bonferroni",
      "significant_fdr"
    ],
    "byte_count": "32*p*p + 48",
    "maximum_output_bytes": 848
  },
  "workspace": {
    "bytes": 848,
    "meaning": "Output buffer capacity for the largest supported five-variable result, including four 5-by-5 binary64 matrices and six i64 summary values."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
