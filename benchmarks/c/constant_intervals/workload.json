    "author": "Simon Lindholm",
    "license": "CC0 (as marked on the cited header)",
    "algorithm_attribution": "Recursive endpoint-pruned partition of a monotone function into maximal constant half-open intervals.",
    "implementation_status": "bounded clean-room profile; algorithm description only"
  },
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[n, step, offset, divisor]",
    "n_range": [0, 256],
    "step_range": [0, 65535],
    "offset_range": [0, 65535],
    "divisor_range": [1, 65535],
    "function": "f(i)=floor((step*i+offset)/divisor) for 0<=i<n",
    "maximum_valid_length": 4,
    "maximum_parseable_length": 5,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_32_bit_integer_array",
    "encoding": "For each maximal constant interval in order, emit lo, hi, f(lo) as three signed i32 values.",
    "successful_result": "Number of interval records; output length is 12 times this count.",
    "maximum_records": 256,
    "maximum_bytes": 3072,
    "capacity_requirement": "At least 12*n bytes, the maximum possible output size.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "contract": {
    "monotonicity": "step, offset, and divisor are nonnegative with divisor positive, so f is nondecreasing; no arbitrary array is accepted.",
    "interval_semantics": "The emitted records are disjoint, adjacent, cover [0,n), and adjacent records have different values.",
    "primary_method": "Recursively split a half-open index range when endpoint values differ; equal endpoints prune the entire range by monotonicity. Merge adjacent equal pieces produced across a split.",
    "independent_reference": "Find the next run endpoint from ceil(((f(lo)+1)*divisor-offset)/step); step=0 means the range is constant.",
    "validation_order": "Validate pointer, exact frame length, and all scalar ranges before checking output capacity; errors write no output.",
    "integer_safety": "The largest numerator is 65535*255+65535=16776960 and every emitted value fits signed i32."
  },
  "workspace": {
    "bytes": 3072,
    "meaning": "Maximum byte-output buffer for 256 interval records."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 3
  },
