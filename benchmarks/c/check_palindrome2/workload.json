      "expected_result": 29,
      "expected_output_hex": "3132333231202d20612070616c696e64726f6d6520737472696e672e0a"
    },
    {
      "id": "punctuation-remains-significant",
      "input_values": [
        65,
        32,
        109,
        97,
        110,
        44,
        32,
        97,
        32,
        112,
        108,
        97,
        110
      ],
      "input_length": 13,
      "expected_result": 41,
      "expected_output_hex": "61206d616e2c206120706c616e202d206e6f7420612070616c696e64726f6d6520737472696e672e0a"
    },
    {
      "id": "internal-spaces-remain-significant",
      "input_values": [
        32,
        97,
        32,
        98,
        32,
        97,
        32
      ],
      "input_length": 7,
      "expected_result": 29,
      "expected_output_hex": "6120622061202d20612070616c696e64726f6d6520737472696e672e0a"
    },
    {
      "id": "zero-with-another-character",
      "input_values": [
        48,
        97
      ],
      "input_length": 2,
