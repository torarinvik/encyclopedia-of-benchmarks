{
  "schema_version": 1,
  "id": "case-insensitive-palindrome-ascii-v1",
  "algorithm": "case_insensitive_palindrome",
  "input": {
    "kind": "ascii_codepoint_array",
    "encoding": "one signed 64-bit ASCII value per code point",
    "maximum_length": 4096,
    "valid_values": [
      0,
      127
    ],
    "result": "1 when the sequence is symmetric after ASCII A-Z folding, 0 otherwise, -1 for invalid input",
    "case_sensitive": false,
    "case_folding": "ASCII uppercase A-Z map to lowercase a-z; all other code points are unchanged",
    "punctuation_and_spaces_are_significant": true
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": 1
    },
    {
      "id": "single_uppercase",
      "input_values": [
        90
      ],
      "input_length": 1,
      "expected_result": 1
    },
    {
      "id": "lowercase_palindrome",
      "input_values": [
        114,
        97,
        99,
        101,
        99,
        97,
        114
      ],
      "input_length": 7,
      "expected_result": 1
    },
    {
      "id": "mixed_case_palindrome",
      "input_values": [
        82,
        97,
        99,
        101,
        67,
        97,
        114
      ],
      "input_length": 7,
      "expected_result": 1
    },
    {
      "id": "case_folded_not_palindrome",
      "input_values": [
        65,
        98,
        67
      ],
      "input_length": 3,
      "expected_result": 0
    },
    {
      "id": "punctuation_is_significant",
      "input_values": [
        65,
        33,
        97,
        63
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "punctuation_preserved_in_palindrome",
      "input_values": [
        65,
        33,
        98,
        33,
        97
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "digits_and_letters",
      "input_values": [
        65,
        49,
        98,
        49,
        97
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "embedded_control_character",
      "input_values": [
        65,
        0,
        97
      ],
      "input_length": 3,
      "expected_result": 1
    },
    {
      "id": "mismatch_near_center",
      "input_values": [
        97,
        98,
        88,
        99,
        97
      ],
      "input_length": 5,
      "expected_result": 0
    },
    {
      "id": "negative_codepoint",
      "input_values": [
        -1
      ],
      "input_length": 1,
      "expected_result": -1
    },
    {
      "id": "value_above_ascii",
      "input_values": [
        128
      ],
      "input_length": 1,
      "expected_result": -1
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  }
}
