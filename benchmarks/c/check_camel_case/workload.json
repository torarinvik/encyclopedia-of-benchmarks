{
  "id": "check-camel-case-v1",
  "algorithm": "check_camel_case",
  "contract": {
    "input": "A sequence of zero through 4,096 printable ASCII code values in 32..126.",
    "output": "1 if nonempty and matching ^[a-z][A-Za-z]*$; otherwise 0.",
    "invalid_input_result": -2,
    "empty_sequence_result": 0,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": 0
    },
    {
      "id": "lowercase-name",
      "input_values": [104, 101, 108, 108, 111],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "camel-case-name",
      "input_values": [104, 101, 108, 108, 111, 87, 111, 114, 108, 100],
      "input_length": 10,
      "expected_result": 1
    },
    {
      "id": "single-lowercase-letter",
      "input_values": [120],
      "input_length": 1,
      "expected_result": 1
    },
    {
      "id": "uppercase-initial",
      "input_values": [72, 101, 108, 108, 111],
      "input_length": 5,
      "expected_result": 0
    },
    {
      "id": "digit-after-initial",
      "input_values": [104, 101, 108, 108, 111, 50],
      "input_length": 6,
      "expected_result": 0
    },
    {
      "id": "underscore",
      "input_values": [104, 101, 108, 108, 111, 95, 119, 111, 114, 108, 100],
      "input_length": 11,
      "expected_result": 0
    },
    {
      "id": "leading-space",
      "input_values": [32, 104, 101, 108, 108, 111],
      "input_length": 6,
      "expected_result": 0
    },
    {
      "id": "invalid-control-value",
      "input_values": [104, 101, 10],
      "input_length": 3,
      "expected_result": -2
    },
    {
      "id": "invalid-non-ascii-value",
      "input_values": [104, 233],
      "input_length": 2,
      "expected_result": -2
    }
  ]
}
