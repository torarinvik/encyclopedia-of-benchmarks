{
  "schema_version": 1,
  "id": "thealgorithms-java-cursor-linked-list-v1",
  "algorithm": "cursor_linked_list",
  "function_symbol": "cursor_linked_list",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation_count, (opcode, int32_argument)...]",
    "operation_count_range": [
      0,
      64
    ],
    "operations": {
      "0": "append(value)",
      "1": "remove first matching value",
      "2": "removeByIndex(logical_index)",
      "3": "get(logical_index)",
      "4": "indexOf(value)"
    },
    "validity": "Arguments are signed 32-bit integers. Remove requires a nonempty list containing the value; removeByIndex requires a valid logical index. Get and indexOf may miss. At most 64 operations are accepted, so the 99 allocatable cursor nodes cannot be exhausted.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[query_count, (found, query_value)..., head_index, count, for each cursor slot 0..99: (occupied, element_or_zero, next_index)]",
    "semantics": "Append allocates from the front of the free-list at slot 0. Free inserts a released slot at the front of that free-list. removeByIndex follows the Java implementation: it reads the indexed value and removes the first equal value, so duplicate values can cause a different occurrence to be removed. Get reports (0,0) when out of range; indexOf reports (0,0) when absent."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
  "cases": [
    {
      "id": "append_queries_remove_and_reuse",
      "input_values": [
        9,
        0,
        10,
        0,
        20,
        0,
        30,
        3,
        1,
        4,
        30,
        2,
        1,
        0,
        40,
        4,
        20,
        3,
        1
      ],
      "input_length": 19,
      "expected_result": 2488,
      "expected_output_hex": ""
    },
    {
      "id": "remove_by_index_with_duplicates",
      "input_values": [
        3,
        0,
        7,
        0,
        7,
        2,
        1
      ],
      "input_length": 7,
      "expected_result": 2424,
      "expected_output_hex": ""
    },
    {
      "id": "head_removal_reuses_freed_slot",
      "input_values": [
        4,
        0,
        1,
        0,
        2,
        1,
        1,
        0,
        3
      ],
      "input_length": 9,
      "expected_result": 2424,
      "expected_output_hex": ""
    },
    {
      "id": "empty_queries",
      "input_values": [
        2,
        4,
        55,
        3,
        0
      ],
      "input_length": 5,
      "expected_result": 2456,
      "expected_output_hex": ""
    },
    {
      "id": "remove_missing_is_invalid",
      "input_values": [
        2,
        0,
        9,
        1,
        10
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ],
  "workspace": {
    "bytes": 3500
  }
}
