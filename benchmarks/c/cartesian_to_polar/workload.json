{
  "schema_version": 1,
  "id": "cartesian-to-polar-components-v1",
  "algorithm": "cartesian_to_polar",
  "function_symbol": "cartesian_to_polar",
  "input": {
    "kind": "bounded_binary64_triple",
    "argument_order": ["x", "y", "component"],
    "coordinate_bounds": [-1000000.0, 1000000.0],
    "component_mapping": {
      "0": "radius = sqrt(x * x + y * y)",
      "1": "angle = atan2(y, x), in radians"
    },
    "invalid_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "The selected radius or angle from the Cartesian-to-polar transformation",
    "invalid_result": -1e+300
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "input_scaled_tolerance": 1e-12,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
  "cases": [
    {"id":"source-radius-3-4","input_values":[3.0,4.0,0.0],"expected_result":5.0},
    {"id":"source-angle-3-4","input_values":[3.0,4.0,1.0],"expected_result":0.9272952180016122},
    {"id":"quadrant-one-radius","input_values":[1.0,1.0,0.0],"expected_result":1.4142135623730951},
    {"id":"quadrant-one-angle","input_values":[1.0,1.0,1.0],"expected_result":0.7853981633974483},
    {"id":"quadrant-two-radius","input_values":[-1.0,1.0,0.0],"expected_result":1.4142135623730951},
    {"id":"quadrant-two-angle","input_values":[-1.0,1.0,1.0],"expected_result":2.356194490192345},
    {"id":"quadrant-three-radius","input_values":[-1.0,-1.0,0.0],"expected_result":1.4142135623730951},
    {"id":"quadrant-three-angle","input_values":[-1.0,-1.0,1.0],"expected_result":-2.356194490192345},
    {"id":"quadrant-four-radius","input_values":[1.0,-1.0,0.0],"expected_result":1.4142135623730951},
    {"id":"quadrant-four-angle","input_values":[1.0,-1.0,1.0],"expected_result":-0.7853981633974483},
    {"id":"positive-x-axis-angle","input_values":[1.0,0.0,1.0],"expected_result":0.0},
    {"id":"negative-x-axis-angle","input_values":[-1.0,0.0,1.0],"expected_result":3.141592653589793},
    {"id":"positive-y-axis-angle","input_values":[0.0,1.0,1.0],"expected_result":1.5707963267948966},
    {"id":"negative-y-axis-angle","input_values":[0.0,-1.0,1.0],"expected_result":-1.5707963267948966},
    {"id":"origin-radius","input_values":[0.0,0.0,0.0],"expected_result":0.0},
    {"id":"origin-angle","input_values":[0.0,0.0,1.0],"expected_result":0.0},
    {"id":"maximum-bounded-radius","input_values":[1000000.0,-1000000.0,0.0],"expected_result":1414213.5623730951},
    {"id":"invalid-component-selector","input_values":[1.0,1.0,2.0],"expected_result":-1e+300},
    {"id":"invalid-fractional-selector","input_values":[1.0,1.0,0.5],"expected_result":-1e+300},
    {"id":"invalid-x-below-bound","input_values":[-1000001.0,0.0,0.0],"expected_result":-1e+300},
    {"id":"invalid-y-above-bound","input_values":[0.0,1000001.0,1.0],"expected_result":-1e+300}
  ]
}
