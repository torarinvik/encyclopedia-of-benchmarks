  },
  "workspace": {
    "bytes": 256,
    "meaning": "maximum encoded coefficient output capacity"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
