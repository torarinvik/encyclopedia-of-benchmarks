{
  "schema_version": 1,
  "id": "circular-look-java-service-order-v1",
  "algorithm": "circular_look_scheduling",
  "function_symbol": "circular_look_scheduling",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[max_cylinder, start_position, moving_up, request_count, requests...]",
    "max_cylinder_range": [
      1,
      128
    ],
    "start_position_range": "0..max_cylinder-1",
    "moving_up_values": [
      0,
      1
    ],
    "request_count_range": [
      0,
      64
    ],
    "request_value_range": [
      -128,
      255
    ],
    "maximum_input_values": 68,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "unsigned_byte_vector",
    "encoding": "one byte per serviced cylinder in source order",
    "successful_result": "number of serviced requests",
    "maximum_length": 64
  },
  "workspace": {
    "bytes": 64,
    "meaning": "Maximum number of serviced cylinder requests"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "upward_then_low_requests_ascending",
      "input_length": 10,
      "input_values": [
        200,
        50,
        1,
        6,
        10,
        90,
        70,
        50,
        199,
        200
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "downward_source_wrap_segment_descending",
      "input_length": 9,
      "input_values": [
        100,
        50,
        0,
        5,
        10,
        90,
        20,
        80,
        50
      ],
      "expected_result": 4,
      "expected_output_hex": "140a5a50"
    },
    {
      "id": "duplicates_are_preserved",
      "input_length": 9,
      "input_values": [
        20,
        10,
        1,
        5,
        12,
        12,
        9,
        0,
        20
      ],
      "expected_result": 4,
      "expected_output_hex": "0c0c0009"
    },
    {
      "id": "filters_out_of_range_requests",
      "input_length": 10,
      "input_values": [
        8,
        4,
        1,
        6,
        -1,
        8,
        7,
        3,
        4,
        0
      ],
      "expected_result": 3,
      "expected_output_hex": "070003"
    },
    {
