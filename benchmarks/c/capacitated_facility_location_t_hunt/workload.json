  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,F,Q,target,metric[(n+F)^2 row-major],opening_cost[F],capacity[F],copy_type[Q],assignment[n]]",
    "client_count_range": [1, 4],
    "facility_type_count_range": [1, 3],
    "open_copy_count_range": [1, 4],
    "metric_distance_range": [0, 1000],
    "opening_cost_range": [0, 1000],
    "capacity_range": [1, 4],
    "maximum_valid_length": 67,
    "maximum_parseable_length": 68,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[improved,l,dropped_copy_mask,current_cost,modeled_neighbor_cost]",
    "maximum_bytes": 40,
    "success_result": 40,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 40,
    "meaning": "Maximum caller output-buffer capacity; internal scratch is separately bounded."
  },
  "memory": {
    "internal_scratch_bytes": 8192,
    "meaning": "Fixed metric, assignment, and bounded exact-weight knapsack tables."
  },
  "contract": {
    "knapsack_item_weight": "number of currently assigned clients on that open facility copy",
    "knapsack_item_profit": "copy opening cost minus the sum of added client distance when its assigned clients move to target",
    "search_order": "for l=1 through n, maximize knapsack profit at capacity l*target_capacity and return the first subset with profit greater than l*target_opening_cost",
    "tie_rule": "among equal maximum profits choose the numerically smallest open-copy bitmask",
    "modeled_neighbor_cost": "current assigned-service and opening cost plus l*target_opening_cost minus selected subset profit",
    "bounded_profile_scope": "one supplied feasible state and one target facility type; evaluates T-Hunt's drop-subset/add-l-copies move only, not the outer local-search loop",
    "copy_assignment": "the supplied assignment defines N_S(copy); it must respect each copy's facility capacity",
    "metric_rule": "the full matrix is symmetric, has zero diagonal, strictly positive off-diagonal entries, and satisfies triangle inequalities",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
