{
  "schema_version":"1.0.0",
  "id":"closest-string-center-exhaustive-v1",
  "algorithm":"closest_string_center",
  "function_symbol":"closest_string_center",
  "comparison_model":"i64_array_bytes_output_call",
  "input":{"kind":"signed_i64_array","layout":"[n,m,q,strings[n*m]]","string_count_range":[1,6],"string_length_range":[1,8],"alphabet_size_values":[2,3],"symbol_range":"[0,q)","maximum_valid_length":51,"maximum_parseable_length":52,"invalid_result":-1},
  "output":{"kind":"little_endian_i64_array","description":"[minimum maximum Hamming radius, lexicographically smallest optimal center symbols...]","maximum_output_bytes":72,"maximum_output_elements":9,"success_result":"8*(m+1) bytes","invalid_result":-1,"insufficient_output_capacity_result":-2,"null_output_when_nonempty_result":-2},
  "workspace":{"bytes":128,"meaning":"Candidate center and best center buffers, each at most eight symbols."},
  "measurement":{"sample_count":7,"warmup_rounds":2,"repetitions_per_sample":1000},
  "cases":[
    {"id":"binary-opposite-strings","input_values":[2,3,2,0,0,0,1,1,1],"input_length":9,"expected_result":32,"expected_output_hex":"0200000000000000000000000000000000000000000000000100000000000000"},
    {"id":"three-string-center","input_values":[3,2,2,0,0,0,1,1,0],"input_length":9,"expected_result":24,"expected_output_hex":"010000000000000000000000000000000000000000000000"},
    {"id":"single-string-center","input_values":[1,4,3,2,1,0,2],"input_length":7,"expected_result":40,"expected_output_hex":"00000000000000000200000000000000010000000000000000000000000000000200000000000000"},
    {"id":"symbol-out-of-range-invalid","input_values":[2,2,2,0,2,1,0],"input_length":7,"expected_result":-1,"expected_output_hex":""},
    {"id":"shape-mismatch-invalid","input_values":[2,2,2,0,1,1],"input_length":6,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[1,1,2,1],"input_length":4,"expected_result":-2,"expected_output_hex":"","workspace_bytes":15,"capacity_error_result":-2}
  ]
}
