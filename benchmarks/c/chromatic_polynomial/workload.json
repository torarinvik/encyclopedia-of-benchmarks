    ],
    "reuse": "Mathematical recurrence and independent edge-subset identity only; all code and fixtures are independently authored."
  },
  "contract": {
    "operation": "Return all integer coefficients of the chromatic polynomial for a simple undirected graph.",
    "input_layout": "[n,m,(u,v)*m]",
    "n_range": [0, 8],
    "m_range": [0, 16],
    "graph_rule": "No self-loops or duplicate undirected edges; endpoints satisfy 0 <= u,v < n.",
    "polynomial_rule": "P_G(x) = P_(G-e)(x) - P_(G/e)(x), with P_G(x)=x^n for an edgeless graph.",
    "output_order": "Ascending degree coefficients [c_0,...,c_n] for P_G(x)=sum(c_i*x^i).",
    "output_encoding": "One little-endian signed i64 coefficient per degree.",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 34,
    "maximum_parseable_length": 34,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_bytes": 72,
    "success_result": "8*(n+1) bytes",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 72,
    "meaning": "Capacity of the maximum output coefficient buffer; bounded recursion state uses local stack storage."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
