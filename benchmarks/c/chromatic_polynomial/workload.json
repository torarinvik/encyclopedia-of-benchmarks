  "source": {
    "name": "Chromatic polynomial deletion-contraction recurrence",
    "references": [
      "https://users.math.msu.edu/users/bsagan/Books/Aoc/GSM210.pdf",
      "https://mathworld.wolfram.com/ChromaticPolynomial.html",
