{
  "schema_version": 1,
  "id": "conway-look-and-say-ascii-v1",
  "algorithm": "conway",
  "function_symbol": "conway",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, ASCII_codepoint_0, ...]",
    "text_length_range": [
      1,
      128
    ],
    "array_length": "text_length + 1",
    "character_range": [
      0,
      127
    ],
    "invalid_result": -1
  },
  "output": {
    "kind": "ascii_bytes",
    "definition": "Split before each character whose predecessor is neither CR nor LF and differs from it; encode each resulting segment as its decimal length followed by its first ASCII byte, matching Java regex split behavior.",
    "maximum_output_bytes": 256,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
