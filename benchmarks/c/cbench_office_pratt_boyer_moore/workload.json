  "contract": {
    "operation": "Return the first pattern occurrence using the source endpoint skip table and its zero-shift full comparison.",
    "input_layout": "[text_length, pattern_length, text_bytes..., pattern_bytes...]",
    "text_length_range": [
      0,
      255
    ],
    "pattern_length_range": [
      1,
      64
    ],
    "byte_range": [
      1,
      127
    ],
    "exact_length": "2 + text_length + pattern_length",
    "maximum_input_length": 321,
    "output": "Signed i64 scalar: first zero-based offset, or -1 if absent; -2 means malformed input.",
    "algorithm_detail": "Initialize each byte shift to pattern_length, then set the shift for each pattern byte to pattern_length-index-1, including zero for the terminal pattern byte. Scan text endpoints; positive shifts skip ahead. At zero, compare the whole pattern at the implied window start; a false endpoint match advances one position.",
    "source_hazards": "The source helper uses NUL-terminated C strings and returns only the first match. The bounded contract excludes embedded NUL and empty patterns (which would underflow the source's size_t endpoint), while preserving its endpoint/false-positive shift behavior.",
    "invalid_result": -2,
    "not_found_result": -1
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[text_length, pattern_length, text bytes, pattern bytes]",
    "text_length_range": [
