{
  "id": "count-consonants-php-ascii-v1",
  "algorithm": "count_consonants",
  "function_symbol": "count_consonants",
  "contract": {
    "input": "A sequence of 1 through 4,096 printable ASCII code values in 32..126.",
    "excluded_input": "The exact one-character string [48].",
    "output": "Count ASCII letters a..z excluding a, e, i, o, u, after ASCII lowercase folding.",
    "invalid_input_result": -1,
    "empty_sequence_result": -1,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"all-vowels","input_values":[97,101,105,111,117],"input_length":5,"expected_result":0},
    {"id":"lowercase-consonants","input_values":[99,111,110,115,111,110,97,110,116,115],"input_length":10,"expected_result":7},
    {"id":"uppercase-and-lowercase","input_values":[66,98,67,99,68,100,69,101],"input_length":8,"expected_result":6},
    {"id":"letters-with-digits-and-punctuation","input_values":[97,49,98,33,101,95,122],"input_length":7,"expected_result":2},
    {"id":"spaces-and-punctuation-only","input_values":[32,33,95,126],"input_length":4,"expected_result":0},
    {"id":"digit-zero-in-longer-string","input_values":[48,48],"input_length":2,"expected_result":0},
    {"id":"exact-zero-string-source-error","input_values":[48],"input_length":1,"expected_result":-1},
    {"id":"empty-source-error","input_values":[],"input_length":0,"expected_result":-1},
    {"id":"invalid-code-below-range","input_values":[31],"input_length":1,"expected_result":-1},
    {"id":"invalid-code-above-range","input_values":[127],"input_length":1,"expected_result":-1},
    {"id":"oversized-length","input_values":[],"input_length":4097,"expected_result":-1}
  ]
}
