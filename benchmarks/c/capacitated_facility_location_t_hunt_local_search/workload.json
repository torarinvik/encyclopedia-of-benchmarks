  "algorithm_profile": {
    "starting_state": "The initial multiset is sorted by facility type; a minimum-cost feasible assignment is computed, with type-vector lexicographic ties and ascending-client copy packing.",
    "target_scan": "Scan target facility types in ascending ID. For each, test a single-copy add first, then T-Hunt.",
    "t_hunt": "For l=1..n in ascending order, maximize copy profit subject to assigned-client weight <= l*capacity[target]; accept the first l with profit > l*opening_fee[target].",
    "outer_loop": "Apply the first strictly improving move, recompute the minimum-cost assignment, and restart the target scan; terminate after a full pass finds no move.",
    "knapsack_ties": "On an equal exact-weight profit, retain the state excluding the latest copy; among equal final profits choose the smallest used weight.",
    "assignment_ties": "Choose the lexicographically smallest facility-type assignment vector, then assign clients in ascending ID to earliest available copy IDs of that type.",
    "termination_note": "No move found by the deterministic add/T-Hunt scan; T-Hunt is not a complete oracle for every improving neighbor in the full mathematical neighborhood.",
    "cost_bound": "Initial cost <= 160; every accepted move strictly lowers the integer objective, so accepted steps <= 160 and final copies <= 4 + 4*160 = 644."
  },
  "memory": {
    "internal_scratch_bytes": 65536,
    "meaning": "Fixed metric, assignment, copy, knapsack, and output storage for the declared maxima."
  },
