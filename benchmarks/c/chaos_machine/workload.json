{
  "schema_version": 1,
  "id": "chaos-machine-seeded-state-v1",
  "algorithm": "chaos_machine",
  "function_symbol": "chaos_machine",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[seed_count, seed_0, ..., seed_(n-1), pull_count]",
    "maximum_seed_count": 64,
    "maximum_seed": 1000000,
    "maximum_pull_count": 64,
    "invalid_input_result": -1,
    "zero_state_division_result": -1
  },
  "output": {
    "kind": "little_endian_u32_bytes",
    "encoding": "One 32-bit PRNG result per pull, encoded as four little-endian bytes.",
    "successful_result": "Number of output bytes.",
    "insufficient_output_capacity_result": -2,
    "maximum_output_bytes": 256
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "workspace": {
    "bytes": 256
  },
