{
  "schema_version": "1.0.0",
  "id": "conditional_probability-v1",
  "algorithm": "conditional_probability",
  "function_symbol": "conditional_probability",
  "description": "Return P(A | B) from the joint probability P(A intersection B) and the conditioning probability P(B).",
  "measurement": {
    "comparison_model": "float64_pair_call",
    "sample_count": 25,
    "warmup_rounds": 5,
    "repetitions_per_sample": 100000,
    "input_scaled_tolerance": 1e-12
  },
  "cases": [
    {"id": "source-example", "input_values": [0.2, 0.5], "expected_result": 0.4},
    {"id": "joint-equals-conditioning", "input_values": [0.5, 0.5], "expected_result": 1.0},
    {"id": "mutually-exclusive-events", "input_values": [0.0, 0.3], "expected_result": 0.0},
    {"id": "die-example", "input_values": [0.16666666666666666, 0.5], "expected_result": 0.3333333333333333},
    {"id": "conditioning-certain", "input_values": [0.25, 1.0], "expected_result": 0.25},
    {"id": "rare-events", "input_values": [0.001, 0.01], "expected_result": 0.1},
    {"id": "tiny-equal-probabilities", "input_values": [1e-200, 1e-200], "expected_result": 1.0},
    {"id": "tiny-ratio", "input_values": [1e-200, 2e-200], "expected_result": 0.5},
    {"id": "zero-evidence", "input_values": [0.0, 0.0], "expected_result": -1.0},
    {"id": "negative-joint", "input_values": [-0.1, 0.5], "expected_result": -1.0},
    {"id": "joint-exceeds-conditioning", "input_values": [0.6, 0.5], "expected_result": -1.0},
    {"id": "negative-conditioning", "input_values": [0.0, -0.2], "expected_result": -1.0},
    {"id": "conditioning-above-one", "input_values": [0.2, 1.5], "expected_result": -1.0},
    {"id": "joint-above-one", "input_values": [1.1, 1.0], "expected_result": -1.0}
  ]
}
