      1
    ],
    "generator_polynomial": "first and last bits must be 1",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_sequence",
    "encoding": "Encoding mode returns message bits followed by the significant remainder bits, with leading zero remainder bits omitted. Check mode returns one byte containing 0 or 1.",
