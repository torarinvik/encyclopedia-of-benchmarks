    "role": "Chebyshev orthogonality and series integration identities"
  },
  "contract": {
    "operation": "Integrate the degree-n interpolating polynomial through supplied values at descending Chebyshev-Lobatto nodes on [-1,1] using Clenshaw–Curtis weights.",
    "input_encoding": "[n,f0,...,fn]",
    "n_range": "even n from 2 through 16",
    "node_order": "x_k=cos(k*pi/n), k=0..n; x_0=1 and x_n=-1",
    "sample_domain": "finite binary64 values with absolute value at most 1000",
    "weight_formula": "w_k=(g_k/n)*(1-sum_{j=1}^{n/2} (b_j/(4*j*j-1))*cos((2*j*k*pi)/n)); g_k=1 at endpoints else 2; b_j=1 at j=n/2 else 2",
    "operation_order": "For each k ascending, accumulate j terms ascending and left-to-right; angle is (((2*j)*k)*pi)/n; form w in displayed order; accumulate weighted samples k ascending. No fast-math reassociation.",
    "output_encoding": "One float64 integral estimate over [-1,1]",
    "error_precedence": "Malformed/null input returns -1 before output validation; valid input with null output or capacity below one returns -2 without writes.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[n,f0,...,fn]",
    "n_even_range": [2, 16],
    "sample_absolute_bound": 1000,
    "maximum_valid_input_length": 18,
    "maximum_parseable_input_length": 19,
    "null_input_result": -1,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "[integral_estimate]",
    "maximum_elements": 1,
    "maximum_bytes": 8,
    "success_result": 1,
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "null_output_result": -2,
    "no_write_on_error": true,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12
  },
  "workspace": {
    "elements": 1,
    "bytes": 8,
    "meaning": "Caller output buffer; primary internal scratch is O(1), independent DCT-I reference scratch is O(n)."
  },
  "complexity": {
    "primary_time": "O(n^2) from n+1 weights each summing n/2 cosine terms",
    "primary_space": "O(1) internal scratch",
    "independent_time": "O(n^2) DCT-I coefficient transform",
    "independent_space": "O(n) coefficient array"
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12
  },
  "oracle_method": "Primary: explicit DLMF nodal weights. Independent: DCT-I Chebyshev coefficients followed by exact Chebyshev-mode integral factors.",
