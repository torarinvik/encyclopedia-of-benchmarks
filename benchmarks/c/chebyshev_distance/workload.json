    {"id": "one_dimension", "input_values": [1, -5, 8], "expected_result": 13},
    {"id": "two_dimensions", "input_values": [2, 1, 1, 2, 2], "expected_result": 1},
    {"id": "axis_maximum_not_sum", "input_values": [2, 0, 0, 3, 4], "expected_result": 4},
    {"id": "coordinate_bound_endpoints", "input_values": [1, -1000000000, 1000000000], "expected_result": 2000000000},
    {"id": "negative_coordinates", "input_values": [3, -10, 4, 2, 10, -4, -3], "expected_result": 20},
