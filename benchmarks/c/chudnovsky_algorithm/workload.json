{
  "schema_version": 1,
  "id": "chudnovsky-pi-bounded-precision-v1",
  "algorithm": "chudnovsky_algorithm",
  "function_symbol": "chudnovsky_algorithm",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[precision]",
    "length": 1,
    "precision_range": [
      1,
      12
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "ascii_bytes",
    "meaning": "pinned Decimal pi string after the source removes its final character",
    "encoding": "ASCII",
    "return_value": "output byte length",
    "max_length": 12,
    "max_output_bytes": 12,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 12,
    "meaning": "maximum output string capacity"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 50
  },
