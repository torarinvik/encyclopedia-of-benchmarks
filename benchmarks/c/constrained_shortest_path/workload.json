{
  "schema_version": 1,
  "id": "constrained-shortest-path-v1",
  "algorithm": "constrained_shortest_path",
  "function_symbol": "constrained_shortest_path",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[n, m, start, target, R, (from, to, cost, resource)*m]",
    "node_count_range": [1, 16],
    "edge_count_range": [0, 64],
    "resource_limit_range": [0, 32],
    "node_indices": "zero-based, each in 0..n-1",
    "cost_range": [0, 1000],
    "edge_resource_range": [1, 32],
    "exact_shape": "5+4*m values",
    "operation": "Resource-indexed dynamic programming. Start dp[0][start]=0; scan resource totals ascending, nodes ascending, and input edges in order; relax to the destination when cumulative resource is at most R. Return the minimum target cost over resource totals.",
    "unreachable_result": -1,
    "invalid_input_result": -2
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "minimum path cost within the resource limit, or -1 if unreachable",
    "invalid_input_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {"id":"start_is_target","input_values":[1,0,0,0,0],"input_length":5,"expected_result":0},
    {"id":"cheapest_route_under_limit","input_values":[4,3,0,3,4,0,1,2,1,1,3,3,2,0,3,10,1],"input_length":17,"expected_result":5},
    {"id":"resource_limit_excludes_cheaper_route","input_values":[3,3,0,2,4,0,1,5,3,1,2,5,3,0,2,9,4],"input_length":17,"expected_result":9},
    {"id":"resource_layers_find_lower_cost_route","input_values":[4,4,0,3,3,0,1,4,1,0,2,1,2,2,1,1,1,1,3,3,1],"input_length":21,"expected_result":7},
    {"id":"unreachable_target","input_values":[3,1,0,2,3,0,1,1,1],"input_length":9,"expected_result":-1},
    {"id":"edge_exceeds_resource_limit","input_values":[2,1,0,1,0,0,1,1,1],"input_length":9,"expected_result":-1},
    {"id":"invalid_edge_endpoint","input_values":[2,1,0,1,2,0,2,1,1],"input_length":9,"expected_result":-2},
    {"id":"invalid_zero_edge_resource","input_values":[2,1,0,1,2,0,1,1,0],"input_length":9,"expected_result":-2},
    {"id":"invalid_packed_length","input_values":[2,1,0,1,1,0,1,1],"input_length":8,"expected_result":-2}
  ]
}
