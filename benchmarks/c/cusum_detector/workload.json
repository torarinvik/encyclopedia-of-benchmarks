{
  "schema_version": 1,
  "id": "cusum-detector-v1",
  "algorithm": "cusum_detector",
  "function_symbol": "cusum_detector",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[n, target, sigma, allowance, threshold, samples...]",
    "n_range": [
      0,
      128
    ],
    "target_and_sample_range": [
      -1000,
      1000
    ],
    "sigma_range": [
      1,
      1000
    ],
    "allowance_range": [
      0,
      1000
    ],
    "threshold_range": [
      1,
      1000
    ],
    "operation": "for each sample, update upper=max(0,upper+(sample-target)/sigma-allowance) and lower=max(0,lower-(sample-target)/sigma-allowance); emit upward if upper>threshold else downward if lower>threshold else none, then clear both sums after an alarm",
    "signal_codes": {
      "none": 0,
      "upward": 1,
      "downward": -1
    },
    "output_encoding": "one little-endian signed 64-bit signal code per sample",
    "empty_output_byte_length": 0,
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "exact_shape": "5+n values"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "upward_and_downward_with_reset",
      "input_values": [
        6,
        0,
        1,
        0,
        2,
        1,
        1,
        1,
        -1,
        -1,
        -1
      ],
      "input_length": 11,
      "expected_result": 48,
      "expected_output_hex": "00000000000000000000000000000000010000000000000000000000000000000000000000000000ffffffffffffffff"
    },
    {
      "id": "two_upward_alarms_show_reset",
      "input_values": [
        6,
        0,
        1,
        0,
        2,
        1,
        1,
        1,
        1,
        1,
        1
      ],
      "input_length": 11,
      "expected_result": 48,
      "expected_output_hex": "000000000000000000000000000000000100000000000000000000000000000000000000000000000100000000000000"
    },
    {
      "id": "strict_threshold_is_not_alarm",
