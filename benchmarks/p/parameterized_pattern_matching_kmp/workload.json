      "input_values": [9, 3, 6, 2, 3, 2, 4, 5, 4, 1, 1, 1, 0, 1, 0],
      "input_length": 15,
      "output_capacity": 520,
      "expected_result": 24,
      "expected_output_hex": "020000000000000000000000000000000300000000000000"
    },
    {
      "id": "failure-link-fallback-and-overlapping-matches",
      "input_values": [6, 3, 2, 0, 1, 1, 0, 1, 0, 0, 1, 0],
