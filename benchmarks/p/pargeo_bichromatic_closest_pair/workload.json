  "contract": {
    "operation": "Build one bounded KD-tree per point set, then recursively search pairs of nodes using squared AABB distance lower bounds and prune node pairs whose lower bound exceeds the best cross-set point distance.",
    "input_layout": "[nA, nB, ax0, ay0, ..., bx0, by0, ...]",
    "point_count_range_per_set": [2, 8],
    "coordinate_range": [-1000000, 1000000],
    "leaf_capacity": 2,
    "tree_build": "Choose the widest bounding-box axis (x only when its span is strictly greater; y wins ties), partition at the coordinate-range midpoint with lower coordinates on the left, and use a balanced ceil-half split when the midpoint partition is empty.",
    "search_order": "At a leaf/internal pair, visit the closer child first and visit the right child first on a tie. For two internal nodes, sort their four child pairs by squared AABB distance using stable insertion order for equal distances.",
    "distance": "Exact integer squared Euclidean distance; coordinate bounds keep all calculations within signed 64-bit range.",
    "output_encoding": "One signed 64-bit little-endian minimum squared distance across A x B.",
    "output_bytes": 8,
    "maximum_valid_input_length": 34,
    "success_result": 8,
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
