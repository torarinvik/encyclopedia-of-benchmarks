{
  "schema_version": 1,
  "id": "dynamic-predecessor-problem-packed-bitset-v1",
  "algorithm": "predecessor_problem",
  "function_symbol": "predecessor_problem",
  "input": {
    "kind": "packed_dynamic_set_operation_trace",
    "encoding": "[N, Q, ceil(N/64) signed-i64 packed words, (operation, key)...]",
    "N_range": [1, 4096],
    "Q_range": [0, 512],
    "key_range": "0 <= key < N",
    "operations": {
      "0": "insert key",
      "1": "delete key",
      "2": "membership query",
      "3": "successor query: smallest present key >= k, or -1",
      "4": "predecessor query: largest present key <= k, or -1"
    },
    "word_bits": "least-significant bit is the smallest key in each 64-key block",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one little-endian signed-i64 result per query operation",
    "result": "number of bytes written",
    "maximum_bytes": 4096
  },
  "workspace": {"bytes": 4096},
  "cases": [
    {"id": "empty_trace", "input_values": [1, 0, 0], "expected_result": 0, "expected_output_hex": ""},
    {"id": "single_member", "input_values": [1, 3, 1, 2, 0, 0, 3, 0, 4, 0], "expected_result": 24, "expected_output_hex": "010000000000000000000000000000000000000000000000"},
    {"id": "mixed_updates_and_neighbors", "input_values": [5, 8, 22, 2, 3, 3, 1, 3, 3, 3, 4, 3, 4, 0, 4, -1, 2, 1, 0, 0, 2, 0], "expected_result": 48, "expected_output_hex": "0000000000000000010000000000000004000000000000000200000000000000ffffffffffffffff0100000000000000"},
    {"id": "empty_set_queries", "input_values": [8, 3, 0, 3, 0, 4, 7, 2, 0], "expected_result": 24, "expected_output_hex": "ffffffffffffffffffffffffffffffff0000000000000000"},
    {"id": "insufficient_capacity", "input_values": [1, 3, 1, 2, 0, 0, 3, 0, 4, 0], "workspace_bytes": 23, "expected_result": -2, "expected_output_hex": ""},
    {"id": "invalid_zero_universe", "input_values": [0, 0, 0], "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_unused_tail_bit", "input_values": [5, 0, 32], "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_operation", "input_values": [1, 1, 0, 5, 0], "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_key", "input_values": [1, 1, 0, 2, 1], "expected_result": -1, "expected_output_hex": ""}
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  }
}
