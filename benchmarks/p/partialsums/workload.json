  "contract": {
    "operation": "Accumulate and return all nine partial sums in the source order.",
    "sum_order": [
      "(2/3)^k",
      "k^-0.5",
      "1/k(k+1)",
      "Flint Hills",
      "Cookson Hills",
      "Harmonic",
      "Riemann Zeta",
      "Alternating Harmonic",
      "Gregory"
    ],
    "vector_lane_order": "The five source vector sums accumulate odd k values in lane 0 and even k values in lane 1, then add lane 0 followed by lane 1. The loop condition checks only lane 0, so an odd n also accumulates k=n+1 in lane 1. Scalar ports preserve this order; any different valid floating-point reduction order is compared under the shared tolerance.",
    "flint_hills_term": "1 / (k^3 * sin(k)^2), with k in radians.",
    "cookson_hills_term": "1 / (k^3 * cos(k)^2), with k in radians.",
    "geometric_sum": "Sum (2/3)^(k-1) for k from 1 through n.",
