    {"id":"labeled-middle-vertex","input_values":[3,0,1,2,1,0,1,2,1,0],"input_length":10,"output_capacity":152,"expected_result":40,"expected_output_hex":"02000000000000000100000000000000020000000000000003000000000000000200000000000000"},
    {"id":"maximum-six-taxon-star","input_values":[6,0,3,4,5,6,7,3,0,5,6,7,8,4,5,0,7,8,9,5,6,7,0,9,10,6,7,8,9,0,11,7,8,9,10,11,0],"input_length":37,"output_capacity":152,"expected_result":104,"expected_output_hex":"0600000000000000010000000000000002000000000000001f000000000000000c000000000000002f000000000000000a00000000000000370000000000000008000000000000003b0000000000000006000000000000003d000000000000000400000000000000"},
    {"id":"non-additive-triangle","input_values":[3,0,1,1,1,0,3,1,3,0],"input_length":10,"output_capacity":152,"expected_result":0,"expected_output_hex":""},
    {"id":"asymmetric-matrix","input_values":[2,0,3,4,0],"input_length":5,"output_capacity":152,"expected_result":-1,"expected_output_hex":""},
    {"id":"off-diagonal-zero","input_values":[2,0,0,0,0],"input_length":5,"output_capacity":152,"expected_result":-1,"expected_output_hex":""},
    {"id":"trailing-input","input_values":[2,0,3,3,0,1],"input_length":6,"output_capacity":152,"expected_result":-1,"expected_output_hex":""},
