{
  "schema_version": 1,
  "id": "encyclopedia-phylogenetic-tree-from-distance-matrix-i64-array-bytes-output-v1",
  "algorithm": "phylogenetic_tree_from_distance_matrix",
  "function_symbol": "phylogenetic_tree_from_distance_matrix",
  "abi": "i64_array_bytes_output",
  "description": "Reconstruct the minimum additive tree from a bounded integral distance matrix, or emit a null tree.",
  "source": {
    "title": "Phylogenetic Tree Construction from a Distance Matrix",
    "authors": ["Jesper Jansson"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_292",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_292",
    "algorithm_attribution": "Exact additive distance-matrix reconstruction by recursive leaf removal and path attachment.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,D row-major n-by-n]",
    "n_range": [2, 6],
    "diagonal": 0,
    "off_diagonal_range": [1, 32],
    "matrix_must_be_symmetric": true,
    "maximum_valid_length": 37,
    "maximum_parseable_length": 38,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_vector",
    "encoding": "[edge_count,side_mask_1,twice_edge_length_1,...]",
    "edge_mask_rule": "The mask contains taxa on the side of the edge containing taxon 0.",
    "maximum_bytes": 152,
    "success_result": "8 * (1 + 2 * edge_count); zero bytes means null tree",
    "non_additive_matrix_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded distance matrix, at most 10 tree vertices, 9 edges, traversal queues, and staged output."
  },
  "contract": {
    "recursive_reduction": "Remove the highest-index leaf, compute its limb, recurse on the remaining matrix, then attach it back to the selected path.",
    "limb_twice": "min over i<j<v of D[i,v]+D[j,v]-D[i,j].",
    "witness_tie": "Choose the lexicographically first pair (i,j) satisfying the limb-adjusted path equality.",
    "path_tie": "The tree path is unique; when zero-length edges create equal metric positions, choose the first vertex from i along that path.",
    "weights": "All emitted weights are doubled integers, exactly representing half-integral edge lengths.",
    "null_tree": "Return zero bytes for a well-formed but non-additive matrix.",
    "error_results": "Malformed input returns -1. Null output or insufficient capacity for a non-null tree returns -2 without writes."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary oracle inserts leaves in ascending prefix order using an edge list. The independent verifier removes leaves recursively and uses an adjacency-map tree.",
  "cases": [
