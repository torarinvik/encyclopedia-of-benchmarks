{
  "schema_version": 1,
  "id": "proof-of-work-frozen-genesis-bounded-v1",
  "algorithm": "proof_of_work",
  "function_symbol": "proof_of_work",
  "input": {
    "kind": "signed_i64_array",
    "length": 2,
    "layout": [
      "difficulty",
      "max_nonce"
    ],
    "difficulty_range_inclusive": [
      0,
      8
    ],
    "max_nonce_range_inclusive": [
      0,
      65535
    ],
    "invalid_input_result": -1
  },
  "block_fields": {
    "index": 0,
    "previous_hash": "0",
    "transactions": "Genesis Block",
    "timestamp_python_string": "0.0",
    "nonce_start": 0,
    "preimage_template_ascii": "00Genesis Block0.0{nonce}"
  },
  "output": {
    "kind": "nonce_i64le_followed_by_raw_sha256",
    "length_bytes": 40,
    "result": "40 on found, 0 on bounded exhaustion",
    "invalid_input_result": -1,
    "insufficient_or_null_output_result_on_found": -2,
    "no_write_on_error_or_exhaustion": true
  },
  "workspace": {
    "bytes": 40,
    "meaning": "Maximum found-result capacity: signed i64 little-endian nonce followed by 32 raw SHA-256 digest bytes."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 3,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  },
  "cases": [
