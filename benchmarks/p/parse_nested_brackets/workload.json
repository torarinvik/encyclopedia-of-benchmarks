{
  "schema_version": 1,
  "id": "typescript-nested-angle-bracket-depth-first-v1",
  "algorithm": "parse_nested_brackets",
  "function_symbol": "parse_nested_brackets",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[ASCII text length, ASCII bytes...]",
    "text_length_range": [
      0,
      128
    ],
    "byte_range": [
      0,
      127
    ],
    "brackets": "fixed < and > delimiters; all brackets must be properly nested and matched",
    "maximum_input_length": 129
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "polynomial hash modulo 1,000,000,007 over emitted tags in source traversal order; for each tag, h=(257*h+byte+1) mod modulus, initial h=0",
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "Follows parseNestedBrackets defaults and depth-first order: emit each matched outer tag, then recursively emit tags inside its content. Text outside tags is ignored."
  },
  "measurement": {
    "comparison_model": "scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
