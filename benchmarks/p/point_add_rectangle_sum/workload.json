{
  "schema_version": 1,
  "id": "library-checker-point-add-rectangle-sum-bounded-i64-array-bytes-output-v1",
  "algorithm": "point_add_rectangle_sum",
  "function_symbol": "point_add_rectangle_sum",
  "abi": "i64_array_bytes_output",
  "description": "Dynamic sparse weighted points with half-open rectangle sums using an offline compressed 2D Fenwick tree.",
  "source": {
    "title": "Point Add Rectangle Sum",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/point_add_rectangle_sum/task.md",
    "algorithm_attribution": "Offline coordinate-compressed Fenwick tree of Fenwick trees",
    "implementation_status": "clean-room bounded sparse point-add profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,(x,y,w)*N,variable-length operations]",
    "N_range": [1, 32],
    "Q_range": [0, 32],
    "coordinate_range": [0, 1000000],
    "weight_range": [0, 1000000],
    "operation_0": "opcode 0 followed by x,y,w",
    "operation_1": "opcode 1 followed by left,down,right,up",
    "rectangle_rule": "0 <= left < right <= 1000000 and 0 <= down < up <= 1000000",
    "maximum_valid_length": 258,
    "maximum_parseable_length": 259,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian half-open rectangle sum per query, in operation order",
    "maximum_bytes": 256,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 256,
    "meaning": "Maximum output-buffer capacity; compressed coordinate and nested Fenwick tables are separate fixed arrays."
  },
  "contract": {
    "initial_point_semantics": "each initial weighted point is a separate point, including duplicate coordinates",
    "operation_0": "append a point with weight w at coordinate (x,y)",
    "operation_1": "sum weights with left <= x < right and down <= y < up",
    "official_N_and_Q_range": [1, 100000],
    "official_coordinate_and_weight_maximum": 1000000000
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "empty-query-stream",
      "input_values": [1, 0, 0, 0, 0],
      "input_length": 5,
      "output_capacity": 0,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "duplicate-points-addition-and-half-open-queries",
      "input_values": [2, 4, 1, 2, 5, 1, 2, 7, 1, 0, 0, 3, 4, 0, 2, 3, 4, 1, 1, 2, 3, 4, 1, 2, 3, 4, 4],
      "input_length": 27,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "0c0000000000000010000000000000000400000000000000"
    },
    {
      "id": "upper-bound-is-exclusive",
      "input_values": [1, 1, 1000000, 1000000, 1, 1, 999999, 999999, 1000000, 1000000],
      "input_length": 10,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "invalid-empty-rectangle",
      "input_values": [1, 1, 0, 0, 5, 1, 2, 0, 2, 1],
      "input_length": 10,
      "output_capacity": 256,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated-point-add-record",
      "input_values": [1, 1, 0, 0, 5, 0, 3, 4],
      "input_length": 8,
      "output_capacity": 256,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient-output-capacity",
      "input_values": [1, 1, 0, 0, 5, 1, 0, 0, 1, 1],
      "input_length": 10,
      "output_capacity": 7,
