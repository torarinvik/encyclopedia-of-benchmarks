    "no_write_on_error": true,
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-10
  },
  "source_bound": {
    "description": "The pinned launcher selects EXTRALARGE_DATASET (N=2000, TSTEPS=1000). This suite profile bounds n to 1..32 and tsteps to 1..20, including the MINI_DATASET pair 20/20. The implementation returns every final u cell rather than formatting the source dump.",
    "repository": "https://github.com/lac-dcc/Benchmarks",
    "commit": "5d7b75df749241efa7a6e6f5be613d3fcc5cce38",
    "path": "PolyBench/stencils/adi/adi.c",
    "launcher_path": "PolyBench/stencils/adi/info.sh",
    "header_path": "PolyBench/stencils/adi/adi.h",
    "symbols": [
      "init_array",
      "kernel_adi"
    ],
    "license_path": "PolyBench/LICENSE.txt",
    "license_note": "The Ohio State University Software Distribution License permits source and binary redistribution, with or without modification, subject to its conditions. The complete upstream text is bundled in benchmarks/p/polybench_adi/LICENSE.txt."
  },
  "source_semantics": {
    "data_type": "binary64 (the pinned header default)",
    "initialization": "u[i][j] = (double)(i + n - j) / n",
    "coefficient_order": [
      "dx=1/n",
      "dy=1/n",
      "dt=1/tsteps",
      "mul1=2*dt/(dx*dx)",
      "mul2=dt/(dy*dy)",
      "a=-mul1/2",
      "b=1+mul1",
      "c=a",
      "d=-mul2/2",
      "e=1+mul2",
      "f=d"
    ],
    "time_step_order": [
      "column sweep",
      "row sweep"
    ],
    "forward_sweep_order": "i increasing from 1 to n-2, then j increasing from 1 to n-2",
    "back_substitution_order": "j decreasing from n-2 to 1",
    "source_dump": "The launcher prints the full live-out u matrix to stderr with two fractional digits; the suite returns its numerical cells as float64 values."
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Maximum output buffer; kernel arrays are fixed at 32*32 double values each."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10,
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-10
  },
