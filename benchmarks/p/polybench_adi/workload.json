  "output": {
    "kind": "float64_vector",
    "meaning": "full final u matrix in row-major order after tsteps source-ordered column and row sweeps",
    "encoding": "n*n little-endian IEEE-754 binary64 values",
    "return_value": "output byte length (8*n*n)",
    "max_length": 8192,
    "max_output_bytes": 8192,
    "maximum_elements": 1024,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
