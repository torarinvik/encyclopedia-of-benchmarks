{
  "schema_version": 1,
  "id": "python-prefix-evaluation-i64-array-f64-v1",
  "algorithm": "prefix_evaluation",
  "function_symbol": "prefix_evaluation",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[ASCII byte length, expression bytes...]",
    "expression_grammar": "single-digit operands and + - * / separated by exactly one ASCII space",
    "maximum_tokens": 31,
    "maximum_input_length": 63
  },
  "output": {
    "kind": "binary64",
    "meaning": "result of source-order prefix evaluation",
    "invalid_input_result": -1e+300
  },
  "source_bound": {
    "description": "The pinned Python evaluate scans reversed whitespace-separated tokens, pushes single-digit operands, and pops first then second operands for each operator. This benchmark preserves that stack order and excludes malformed expressions and division by zero."
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "addition_and_multiplication",
      "input_values": [
        9,
