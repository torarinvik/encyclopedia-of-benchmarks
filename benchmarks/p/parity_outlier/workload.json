{
  "schema_version": 1,
  "id": "parity-outlier-single-pass-count-v1",
  "algorithm": "parity_outlier",
  "function_symbol": "parity_outlier",
  "input": {
    "encoding": "signed_i64_array",
    "layout": ["length", "values"],
    "length_range": [3, 65],
    "length_must_be_odd": true,
    "value_range": [0, 2147483647],
    "value_semantics": "nonnegative_integer",
    "validity": "exactly_one_value_has_a_parity_different_from_at_least_two_other_values",
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "the unique value whose parity differs from every other array value",
    "result_range": [0, 2147483647]
  },
  "cases": [
    {"id": "odd-outlier", "input_values": [5, 1, 3, 5, 8, 9], "expected_result": 8},
    {"id": "even-outlier", "input_values": [3, 2, 1, 3], "expected_result": 2},
    {"id": "odd-outlier-with-zero", "input_values": [5, 0, 2, 4, 6, 9], "expected_result": 9},
    {"id": "even-outlier-zero", "input_values": [3, 1, 3, 0], "expected_result": 0},
    {"id": "largest-value-outlier", "input_values": [3, 1, 3, 2147483647], "expected_result": 2147483647},
    {"id": "all-odd", "input_values": [3, 1, 3, 5], "expected_result": -1},
    {"id": "all-even", "input_values": [3, 2, 4, 6], "expected_result": -1},
    {"id": "no-unique-parity-class", "input_values": [5, 1, 2, 3, 4, 5], "expected_result": -1},
    {"id": "even-length-array", "input_values": [4, 1, 2, 3, 4], "expected_result": -1},
    {"id": "length-mismatch", "input_values": [3, 1, 2], "expected_result": -1},
    {"id": "negative-value", "input_values": [3, 1, -1, 3], "expected_result": -1},
    {"id": "value-above-js-int32-bound", "input_values": [3, 1, 3, 2147483648], "expected_result": -1}
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 2000
  }
}
