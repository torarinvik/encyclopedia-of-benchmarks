    "official_n_max": 200000,
    "official_q_max": 200000,
    "modulus": 998244353,
    "repository_license": "Apache-2.0",
    "reuse_scope": "Task operation and constraints only; implementations, bounded profile, workload, and oracles are clean-room."
  },
  "oracle": "benchmarks/p/point_set_tree_path_composite_sum/primary_oracle.py",
  "independent_oracle": "benchmarks/p/point_set_tree_path_composite_sum/independent_oracle.py",
  "contract": {
    "operation": "For each query root r, sum P(r,v) over all vertices v modulo 998244353 after applying the query's vertex-value or edge-map update.",
    "input_layout": "[N,Q,A_0,...,A_(N-1), then N-1 records (u,v,b,c), then Q tagged queries]",
    "query_layout": "Type 0 is [0,w,x,r]. Type 1 is [1,e,y,z,r]. Each query produces one residue.",
    "n_range": [1, 16],
    "q_range": [1, 32],
    "vertex_and_addend_range": [0, 998244352],
    "multiplier_range": [1, 998244352],
    "modulus": 998244353,
    "edge_direction": "The same map is used in either traversal direction; reverse paths reverse composition order and do not invert edge maps.",
    "algorithm": "Build a balanced rake/compress cluster hierarchy over vertex payload leaves and edge-map path leaves. Each cluster stores boundary-rooted (sum,count) values and forward/reverse affine path maps. Point updates recalculate the changed leaf's ancestor clusters. An arbitrary-root query descends the hierarchy while propagating sibling and parent outside contexts through directed path maps.",
    "independent_algorithm": "After each update, traverse the tree from the query root and directly compose the affine maps along every root-to-vertex path before summing the transformed vertex values.",
    "complexity": "O(N^2 log N) hierarchy construction, O(log^2 N) worst-case cluster-summary work per update and arbitrary-root query, and O(N^2) fixed storage.",
    "maximum_cluster_nodes": 75,
    "error_precedence": "Validate framing, topology, fields, and output capacity before building summaries or processing updates; stage all answers before writing."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,A_0,...,A_(N-1),edge records,tagged update-and-root queries]",
    "maximum_valid_length": 238,
    "maximum_parseable_length": 238,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 32,
    "maximum_bytes": 256,
    "success_result": "8*Q bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 16384,
    "storage": "Fixed cluster arena, adjacency and edge-cluster matrices, operation staging, and outside-context traversal arrays for N<=16 and Q<=32."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
