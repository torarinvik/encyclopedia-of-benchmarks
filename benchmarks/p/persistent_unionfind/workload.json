{
  "schema_version": 1,
  "id": "library-checker-persistent-unionfind-bounded-i64-array-bytes-output-v1",
  "algorithm": "persistent_unionfind",
  "function_symbol": "persistent_unionfind",
  "abi": "i64_array_bytes_output",
  "description": "Branching graph versions with rollback-DSU connectivity queries.",
  "source": {
    "title": "Persistent Unionfind",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/persistent_unionfind/task.md",
    "algorithm_attribution": "Version-tree traversal with rollback disjoint-set union",
    "implementation_status": "clean-room bounded rollback DSU"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,(t,k,u,v)...]",
    "N_range": [1, 64],
    "Q_range": [1, 64],
    "record_range": "t in {0,1}; -1 <= k < i; k=-1 or t_k=0; 0 <= u,v < N",
    "maximum_valid_length": 258,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian connectivity result per type-1 record",
    "maximum_bytes": 512,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Maximum output-buffer capacity; rollback DSU, update-version tree, and answers use bounded local storage."
  },
  "contract": {
    "update": "type 0 creates graph version i from G_k by adding undirected edge (u,v)",
    "query": "type 1 reports whether u and v are connected in G_k without creating a new graph version",
    "official_N_range": [1, 200000],
    "official_Q_range": [1, 200000]
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "queries-across-empty-and-updated-versions",
      "input_values": [3,6,0,-1,0,1,1,-1,0,1,1,0,0,1,0,0,1,2,1,3,0,2,1,0,0,2],
      "input_length": 26,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0000000000000000010000000000000001000000000000000000000000000000"
    },
    {
      "id": "independent-branches-and-descendant-update",
      "input_values": [4,6,0,-1,0,1,0,-1,2,3,1,0,0,3,1,1,2,3,0,0,1,2,1,4,0,2],
      "input_length": 26,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "000000000000000001000000000000000100000000000000"
    },
    {
      "id": "redundant-edge-in-descendant-version",
      "input_values": [2,3,0,-1,0,1,0,0,0,1,1,2,0,1],
      "input_length": 14,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "query-record-cannot-be-a-version-parent",
      "input_values": [2,2,1,-1,0,1,0,0,0,1],
      "input_length": 10,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-record-kind",
      "input_values": [1,1,2,-1,0,0],
      "input_length": 6,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [2,1,1,-1,0,1],
