{
  "schema_version": 1,
  "id": "present-value-exact-binary-domain-i64-array-float64-v1",
  "algorithm": "present_value",
  "function_symbol": "present_value",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[count, discount_rate_ppm, cash_flow_0_milli, ...]",
    "discount_rate_scale": 1000000,
    "cash_flow_scale": 1000,
    "cash_flow_count_range": [
      1,
      8
    ],
    "discount_rate_ppm_allowed": [
      0,
      1000000
    ],
    "cash_flow_milli_range": [
      -1000000,
      1000000
    ],
    "cash_flow_milli_multiple": 125,
    "exact_length": "count + 2",
    "maximum_valid_length": 10,
    "maximum_parseable_length": 11,
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "meaning": "present value rounded to two decimals with ties-to-even",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
