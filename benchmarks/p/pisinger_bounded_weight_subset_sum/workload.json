  "algorithm": "pisinger_bounded_weight_subset_sum",
  "function_symbol": "pisinger_bounded_weight_subset_sum",
  "abi": "i64_array_scalar",
  "description": "Maximize a nonnegative subset sum not exceeding a target with Pisinger's balanced bounded-weight state update.",
  "source": {
    "title": "Linear Time Algorithms for Knapsack Problems with Bounded Weights",
    "authors": ["David Pisinger"],
    "url": "https://doi.org/10.1006/jagm.1999.1034",
    "secondary_url": "https://github.com/kth-competitive-programming/kactl/blob/main/content/various/FastKnapsack.h",
    "license": "No paper license is asserted; KACTL's reference header is CC0",
    "algorithm_attribution": "The paper's balancing argument restricts subset-sum states to masses within one maximum weight of the target and updates a boundary index as items are inserted or removed.",
    "implementation_status": "bounded clean-room BALSUB state-update profile"
  },
  "contract": {
    "operation": "Return the largest sum of a subset of the supplied positive integer weights that is at most target.",
    "input_encoding": "[n,target,weight_0,...,weight_(n-1)]",
    "item_semantics": "Every weight is a distinct 0/1 item, including duplicate-valued weights.",
    "primary_method": "Pisinger's BALSUB recurrence: start from the greedy break filling, store a -1-or-item-boundary value in each of 2W slots for masses target-W+1 through target+W, index mass by mass+W-target-1, insert each later item into lower-side states, then remove eligible earlier items from over-capacity states in descending mass order.",
    "independent_method": "Descending capacity-indexed Boolean subset-sum dynamic programming.",
    "invalid_input_result": -1
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,target,weight_0,...,weight_(n-1)]",
    "item_count_range": [0, 32],
    "target_range": [0, 256],
    "weight_range": [1, 12],
    "maximum_valid_length": 34,
    "maximum_parseable_length": 35,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "greatest reachable subset mass not exceeding target",
    "result_range": [0, 256],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Two fixed rolling boundary arrays sized for twice the maximum item weight, plus scalar state; input is read directly and is not copied."
  },
