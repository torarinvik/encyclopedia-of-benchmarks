  "id": "embench-picojpeg-grayscale-baseline-one-block-v1",
  "algorithm": "picojpeg",
  "function_symbol": "picojpeg",
  "description": "Bounded baseline grayscale JPEG block parsing, Huffman decoding, dequantization, and IDCT reconstruction.",
  "pinned_source": {
    "repository": "embench/embench-iot",
    "commit": "09c2ed8c3b7008c95d08b038de4a3f6dc103ed70",
    "path": "src/picojpeg/libpicojpeg.c",
    "related_paths": [
      "src/picojpeg/picojpeg.h",
      "src/picojpeg/picojpeg_test.c"
    ],
