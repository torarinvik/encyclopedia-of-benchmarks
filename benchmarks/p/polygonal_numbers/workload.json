    {"id":"source_square_example","input_values":[5,4],"expected_result":25},
    {"id":"source_pentagonal_example","input_values":[2,5],"expected_result":5},
    {"id":"heptagonal_term","input_values":[3,7],"expected_result":18},
    {"id":"minimum_side_count","input_values":[100,3],"expected_result":5050},
    {"id":"maximum_side_count","input_values":[10,64],"expected_result":2800},
    {"id":"maximum_index_and_sides","input_values":[100000000,64],"expected_result":309999997000000000},
    {"id":"negative_index","input_values":[-1,5],"expected_result":-1},
