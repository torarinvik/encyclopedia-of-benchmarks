  "contract": {"operation":"Compute the source-initialized modified Gram-Schmidt QR profile; return R followed by Q.","source_order":["initialize A row-major and zero Q,R","for k ascending accumulate squared current A column in i order","write R[k,k]=sqrt(norm_squared)","normalize Q[i,k] in ascending i","for j from k+1 ascending, accumulate R[k,j] in ascending i","update A[i,j] = A[i,j] - Q[i,k]*R[k,j] in ascending i"],"invalid_input_result":-1,"null_output_result":-2,"insufficient_capacity_result":-2,"no_write_on_error":true},
