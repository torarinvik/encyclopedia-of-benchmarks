    "operation": "For m=0..M-1, return sum_mask w[mask] times the coefficient of mask in s^m modulo x_i^2=0 over F_998244353.",
    "input_layout": "[N, M, a_0, ..., a_(2^N-1), w_0, ..., w_(2^N-1)] in increasing mask order.",
    "n_range": [0, 4],
    "power_count_range": [0, 8],
    "coefficient_and_weight_range": [0, 998244352],
    "modulus": 998244353,
    "algorithm": "Iterate powers from the unit using naive square-zero subset convolution and compute a weighted dot product after each power; O(M*3^N + M*2^N) time and O(2^N) storage.",
    "output_layout": "M little-endian signed 64-bit residues, one weighted projection for each exponent m=0 through M-1.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below 8*M returns -2 without writes; M=0 has an empty successful output when a non-null output is supplied."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, M, series_coefficients..., weights...]",
    "maximum_valid_length": 34,
