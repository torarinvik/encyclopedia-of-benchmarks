    "implementation_status": "bounded clean-room stochastic visibility-walk profile"
  },
  "contract": {
    "operation": "Walk from a supplied initial face to the strict-interior query face using exact oriented edge-line predicates.",
    "input_encoding": "[V,B,T,start_face,px,py,step_cap,K,(x,y)*V,boundary_vertex_ids*B,(a,b,c)*T,choice_bits*K]",
    "transition_rule": "For each CCW face, collect separating local edges in order (v0,v1),(v1,v2),(v2,v0). Cross the sole eligible edge deterministically; when two qualify, consume one supplied bit and choose the first or second eligible edge in that order.",
    "choice_tape": "Bits are consumed only at two-successor branches and unused trailing bits are ignored.",
    "status_codes": {"located": 0, "choice_tape_exhausted": 1, "step_cap_reached": 2},
    "output_encoding": "Append face_id+1 digits in base 9, beginning with start_face; return ((trace_code*40 + edge_predicate_count)*3 + status). The trace includes every visited face.",
    "invalid_input_result": -1
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "vertex_count_range": [3, 6],
    "boundary_count_range": [3, 6],
    "face_count": "2*V-B-2, at most 7",
    "coordinate_range": [-200, 200],
    "step_cap_range": [0, 12],
    "choice_count_range": [0, 12],
    "choice_bit_range": [0, 1],
    "geometry": "Boundary vertices are strictly convex and CCW; every other vertex is strictly interior; nondegenerate CCW triangles exactly tile the convex hull, with boundary edges used once and all other edges twice.",
    "query": "Strictly inside the hull and exactly one face; no boundary tie is accepted.",
    "maximum_valid_length": 56,
    "maximum_parseable_length": 57,
    "invalid_input_result": -1
  },
  "output": {
