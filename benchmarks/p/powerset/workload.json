{
  "schema_version": 1,
  "id": "haskell-powerset-exclude-include-order-v1",
  "algorithm": "powerset",
  "function_symbol": "powerset",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[count, signed 32-bit values...]",
    "count_range": [
      0,
      6
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "maximum_input_length": 7
  },
  "output": {
    "kind": "bytes",
    "meaning": "u16 subset count, then each subset as u8 length plus little-endian signed i64 values",
    "maximum_output_bytes": 1602,
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "The Haskell recurrence emits powerset(tail) followed by each tail subset with the current head prepended."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty-set",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": 3,
      "expected_output_hex": "010000"
    },
    {
      "id": "two-elements",
      "input_values": [
        2,
        10,
        20
      ],
      "input_length": 3,
      "expected_result": 38,
      "expected_output_hex": "040000011400000000000000010a00000000000000020a000000000000001400000000000000"
    },
    {
      "id": "duplicates",
      "input_values": [
        3,
        5,
        5,
        -1
      ],
      "input_length": 4,
      "expected_result": 106,
      "expected_output_hex": "08000001ffffffffffffffff010500000000000000020500000000000000ffffffffffffffff010500000000000000020500000000000000ffffffffffffffff02050000000000000005000000000000000305000000000000000500000000000000ffffffffffffffff"
    },
    {
      "id": "maximum-count",
      "input_values": [
        6,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "input_length": 7,
      "expected_result": 1602,
      "expected_output_hex": ""
    }
  ]
}
