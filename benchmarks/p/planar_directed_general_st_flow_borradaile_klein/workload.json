  "input": {
    "kind": "signed_i64_array",
    "layout": "[n,m,s,t,(tail,head,capacity)*m,(degree,edge_id...)*n]",
    "n": [2, 6],
    "m": [1, 10],
    "capacity": [1, 5],
    "maximum_valid_length": 60,
    "maximum_parseable_length": 61,
    "embedding_promise": "Connected simple undirected support with one orientation per edge; supplied counterclockwise cyclic incidence rows form a sphere embedding, checked by dart-face orbits and F=m-n+2.",
    "face_convention": "Number face orbits by first unseen dart in increasing dart ID; choose the right face of the local dart that starts at t along its first listed incident edge, regardless of the input arc direction.",
    "right_first_convention": "Scan the counterclockwise-next incidence after the incoming incidence; start at t with the first row incidence, whose right face defines infinity.",
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "layout": "[maximum_flow_value]",
    "maximum_bytes": 8,
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed arrays for at most six vertices, ten edges, twenty darts, six faces, dual adjacency/distances, residual capacities, DFS state, and bounded recursion/output staging."
  },
  "profile": {
    "operation": "Reverse-dual Dijkstra potentials, capacity split over the two dart directions, then repeated right-first residual DFS from t and bottleneck saturation of the corresponding leftmost s-to-t path.",
    "maxflow_scope": "Return the flow value only; no arc assignment or dynamic-tree state is serialized.",
    "implementation_note": "Uses direct bounded Dijkstra and recomputes each right-first tree; does not claim the paper's O(n log n) time bound.",
    "duplicate_rationale": "Extends the local st_planar_leftmost_augmenting_flow special case by adding dual preprocessing and non-cofacial terminal placements."
  },
  "measurement": {
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
