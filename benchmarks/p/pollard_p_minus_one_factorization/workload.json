  },
  "contract": {
    "operation": "Return the first proper gcd produced by staged modular exponentiation, or zero if the chosen base and smoothness bound expose no proper factor.",
    "input_encoding": "[N,B,A]",
    "primary_method": "After any initial gcd, apply each maximal prime power q^floor(log_q B) in increasing prime order, then gcd the residue minus one with N.",
    "independent_method": "Accumulate the same exponent as a Python big integer and recompute each stage with a direct modular power.",
    "invalid_input_result": -1
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,B,A]",
    "number_range": [2, 1000000000],
    "smoothness_bound_range": [2, 64],
    "base_range": "1..N-1",
    "maximum_valid_length": 3,
    "maximum_parseable_length": 4,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "a proper positive divisor of N, or zero when no proper factor is exposed",
    "success_result_range": [0, 500000000],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Fixed small-prime sequence, modular exponentiation state, and gcd temporaries."
  },
