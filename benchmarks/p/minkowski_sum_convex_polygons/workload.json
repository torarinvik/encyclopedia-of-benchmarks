{
  "schema_version": 1,
  "id": "minkowski-sum-convex-polygons-i64-edge-merge-v1",
  "algorithm": "minkowski_sum_convex_polygons",
  "function_symbol": "minkowski_sum_convex_polygons",
  "abi": "i64_array_bytes_output",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[n,m,x0,y0,...,x(n-1),y(n-1),u0,v0,...,u(m-1),v(m-1)]",
    "polygon_count_range": [3, 32],
    "coordinate_range": [-1000000, 1000000],
    "polygon_precondition": "Each sequence is a strictly convex polygon in counterclockwise order; the first vertex may be anywhere in its cycle.",
    "maximum_valid_input_length": 130,
    "maximum_parseable_input_length": 131
  },
  "output": {
    "kind": "little_endian_i64_sequence",
    "encoding": "[vertex_count,x0,y0,...] with counterclockwise vertices starting at the lowest y then lowest x",
    "return_value": "bytes written",
    "maximum_output_bytes": 1032,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "error_precedence": "Malformed input returns -1 before output checks; valid input with null output or capacity below the actual encoded size returns -2 without writes."
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded point arrays for both 32-vertex inputs, up to 64 summed vertices, and temporary rotations."
  },
  "source_bound": {
    "description": "The result is the set of all pairwise point sums of two convex polygons. The primary kernel cyclically reorders each polygon to its lowest vertex and merges the two polar-sorted edge sequences, advancing both on co-directed edges. Coordinates and cross-products are exact signed integers."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "translated-triangle-sum",
      "input_values": [3, 3, 0, 0, 2, 0, 0, 2, 1, 1, 3, 1, 1, 3],
      "expected_result": 56,
      "expected_output_hex": "0300000000000000010000000000000001000000000000000500000000000000010000000000000001000000000000000500000000000000"
    },
    {
      "id": "square-plus-triangle-parallel-edge-merge",
      "input_values": [4, 3, 0, 0, 2, 0, 2, 2, 0, 2, 0, 0, 1, 0, 0, 1],
      "expected_result": 88,
      "expected_output_hex": "05000000000000000000000000000000000000000000000003000000000000000000000000000000030000000000000002000000000000000200000000000000030000000000000000000000000000000300000000000000"
    },
    {
      "id": "rotated-cycle-starts",
      "input_values": [3, 3, 0, 2, 0, 0, 2, 0, 3, 1, 1, 3, 1, 1],
      "expected_result": 56,
      "expected_output_hex": "0300000000000000010000000000000001000000000000000500000000000000010000000000000001000000000000000500000000000000"
    },
    {
      "id": "clockwise-polygon-rejected",
      "input_values": [3, 3, 0, 0, 0, 2, 2, 0, 0, 0, 1, 0, 0, 1],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "collinear-vertex-rejected",
      "input_values": [4, 3, 0, 0, 1, 0, 2, 0, 2, 2, 0, 0, 1, 0, 0, 1],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "trailing-input-word-rejected",
      "input_values": [3, 3, 0, 0, 2, 0, 0, 2, 1, 1, 3, 1, 1, 3, 9],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient-output-capacity",
      "input_values": [3, 3, 0, 0, 2, 0, 0, 2, 1, 1, 3, 1, 1, 3],
      "output_capacity": 55,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [3, 3, 0, 0, 2, 0, 0, 2, 1, 1, 3, 1, 1, 3],
      "output_capacity": 56,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "output_capacity": 1032,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
