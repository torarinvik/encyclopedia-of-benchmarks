{
  "schema_version": 1,
  "id": "python-automatic-prefix-format-i64-array-bytes-v1",
  "algorithm": "prefix_conversions_string",
  "function_symbol": "prefix_conversions_string",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[mode, integer_value]",
    "mode_values": {
      "0": "automatic SI prefix",
      "1": "automatic binary prefix"
    },
    "value_range": [
      -1000000000000,
      1000000000000
    ],
    "maximum_input_length": 2
  },
  "output": {
    "kind": "ascii_bytes",
    "return_value": "bytes written",
    "meaning": "automatic prefix-formatted value",
    "invalid_result": -1
  },
  "source_bound": {
    "description": "The pinned Python source selects the first descending prefix whose quotient is greater than one; the benchmark limits positive scaled outputs to exact integer quotients and preserves raw decimal fallback for nonpositive inputs."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "si_kilo",
      "input_values": [
        0,
        10000
      ],
      "expected_result": 9,
      "expected_output_hex": "31302e30206b696c6f"
    },
    {
      "id": "si_boundary_falls_to_hecto",
      "input_values": [
        0,
        1000
      ],
      "expected_result": 10,
      "expected_output_hex": "31302e3020686563746f"
    },
    {
      "id": "si_below_prefix",
      "input_values": [
        0,
        10
      ],
      "expected_result": 2,
      "expected_output_hex": "3130"
    },
    {
      "id": "si_mega",
      "input_values": [
        0,
        2000000
      ],
      "expected_result": 8,
      "expected_output_hex": "322e30206d656761"
    },
    {
      "id": "binary_kilo",
      "input_values": [
        1,
        65536
      ],
      "expected_result": 9,
      "expected_output_hex": "36342e30206b696c6f"
    },
    {
      "id": "negative_fallback",
      "input_values": [
        0,
        -12
      ],
      "expected_result": 3,
      "expected_output_hex": "2d3132"
    },
    {
      "id": "zero_fallback",
      "input_values": [
        1,
        0
      ],
      "expected_result": 1,
      "expected_output_hex": "30"
    },
    {
      "id": "nonintegral_scaled_invalid",
      "input_values": [
        0,
        12345
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_mode",
      "input_values": [
        2,
        5
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
