  "contract": {
    "operation": "Incrementally insert each segment into every intersected PMR cell; split leaves when their edge count exceeds the threshold.",
    "input_encoding": "[segment_count, threshold, x0,y0,x1,y1, ...]",
    "segment_count_range": [0, 8],
    "threshold_range": [1, 8],
    "endpoint_coordinate_range": [0, 255],
    "segment_rule": "Straight closed segments with distinct endpoints; diagonal, horizontal, and vertical segments are accepted. Intersections between separate input segments are not filtered; bounded depth/node overflow is an error.",
    "root_square": "[-0.5,255.5] x [-0.5,255.5]; cell bounds are represented in doubled integer coordinates.",
    "cell_intersection": "Closed square/segment intersection with exact integer orientation predicates. A segment crossing a split boundary is stored in each child it intersects.",
    "split_rule": "On threshold overflow, allocate four children in NW, NE, SW, SE order and redistribute the leaf's segment IDs in input order.",
    "depth_limit": 8,
    "node_limit": 2048,
    "overflow_rule": "An overfull leaf at depth 8 or a node-allocation overflow returns -1 before output is written.",
    "exact_valid_input_length": "2 + 4*segment_count",
    "maximum_valid_input_length": 34,
    "maximum_parseable_input_length": 35,
    "maximum_output_words": 24578,
    "maximum_output_bytes": 196624
  },
  "input": {
