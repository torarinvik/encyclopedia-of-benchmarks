{
  "schema_version": 1,
  "id": "encyclopedia-parameterized-pattern-matching-i64-array-bytes-output-v1",
  "algorithm": "parameterized_pattern_matching",
  "function_symbol": "parameterized_pattern_matching",
  "abi": "i64_array_bytes_output",
  "description": "Find all one-dimensional exact parameterized matches by predecessor-string equality.",
  "source": {
    "title": "Parameterized Pattern Matching",
    "authors": ["Moshe Lewenstein"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_282",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_282",
    "algorithm_attribution": "One-dimensional all-parameter-symbol matching by predecessor-string equivalence",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length,pattern_length,text_symbols...,pattern_symbols...]",
    "text_length_range": [0, 24],
    "pattern_length_range": [1, 8],
    "symbol_range": [0, 15],
    "maximum_valid_length": 34,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[match_count,zero_based_match_starts...] in ascending start order",
    "maximum_bytes": 200,
    "success_result": "8 * (1 + match_count) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Fixed predecessor encodings, last-occurrence tables, match starts, and staged output."
  },
  "contract": {
    "match_rule": "A text window matches iff its predecessor encoding equals that of the pattern; all symbols are parameters.",
    "pattern_longer_than_text": "valid and produces an empty match list",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"renamed-symbols-match","input_values":[5,3,4,7,4,8,9,0,1,0],"input_length":10,"output_capacity":200,"expected_result":16,"expected_output_hex":"01000000000000000000000000000000"},
    {"id":"overlapping-repeated-symbol-matches","input_values":[4,2,1,1,1,1,0,0],"input_length":8,"output_capacity":200,"expected_result":32,"expected_output_hex":"0300000000000000000000000000000001000000000000000200000000000000"},
    {"id":"distinct-symbols-match-after-repeat-mismatch","input_values":[3,2,1,1,2,0,1],"input_length":7,"output_capacity":200,"expected_result":16,"expected_output_hex":"01000000000000000100000000000000"},
    {"id":"repeated-text-does-not-match-distinct-pattern","input_values":[3,2,1,1,1,0,1],"input_length":7,"output_capacity":200,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"pattern-longer-than-text","input_values":[2,3,1,2,3,0,0,0],"input_length":8,"output_capacity":200,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"empty-text","input_values":[0,1,7],"input_length":3,"output_capacity":200,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"maximum-text-and-output","input_values":[24,1,
      4,4,4,4,4,4,4,4, 4,4,4,4,4,4,4,4, 4,4,4,4,4,4,4,4,
      15],"input_length":27,"output_capacity":200,"expected_result":200,"expected_output_hex":""},
    {"id":"maximum-packed-input-length","input_values":[24,8,
      4,4,4,4,4,4,4,4, 4,4,4,4,4,4,4,4, 4,4,4,4,4,4,4,4,
      9,9,9,9,9,9,9,9],"input_length":34,"output_capacity":200,"expected_result":144,"expected_output_hex":"110000000000000000000000000000000100000000000000020000000000000003000000000000000400000000000000050000000000000006000000000000000700000000000000080000000000000009000000000000000a000000000000000b000000000000000c000000000000000d000000000000000e000000000000000f000000000000001000000000000000"},
    {"id":"symbol-out-of-range","input_values":[1,1,16,0],"input_length":4,"output_capacity":200,"expected_result":-1,"expected_output_hex":""},
    {"id":"zero-pattern-length","input_values":[1,0,2],"input_length":3,"output_capacity":200,"expected_result":-1,"expected_output_hex":""},
    {"id":"length-mismatch","input_values":[3,2,1,2,3,0],"input_length":6,"output_capacity":200,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[4,2,1,1,1,1,0,0],"input_length":8,"output_capacity":31,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":3,"input_is_null":true,"output_capacity":200,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-output","input_values":[0,1,7],"input_length":3,"output_capacity":8,"output_is_null":true,"expected_result":-2,"expected_output_hex":""}
  ]
}
