{
  "schema_version": 1,
  "id": "library-checker-point-set-range-frequency-bounded-i64-array-bytes-output-v1",
  "algorithm": "point_set_range_frequency",
  "function_symbol": "point_set_range_frequency",
  "abi": "i64_array_bytes_output",
  "description": "Point assignments and exact-value half-open range counts using one compressed-value Fenwick tree per value.",
  "source": {
    "title": "Point Set Range Frequency",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/point_set_range_frequency/task.md",
    "algorithm_attribution": "Offline-compressed value-indexed Fenwick trees over positions",
    "implementation_status": "clean-room bounded point-set/range-frequency profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,initial_values...,variable_length_operations]",
    "N_range": [1, 64],
    "Q_range": [0, 64],
    "value_range": [0, 1000000],
    "operation_0": "opcode 0 followed by index,value",
    "operation_1": "opcode 1 followed by left,right,value",
    "index_rule": "0 <= index < N",
    "range_rule": "0 <= left <= right <= N",
    "maximum_valid_length": 322,
    "maximum_parseable_length": 323,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian exact-value frequency per type-1 operation, in operation order",
    "maximum_bytes": 512,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Maximum output-buffer capacity; compressed-value Fenwick tables use separate fixed storage."
  },
  "contract": {
    "operation_0": "assign value at index",
    "operation_1": "count positions with the requested value in the half-open range [left,right)",
    "official_N_and_Q_maximum": 200000,
    "official_value_maximum": 1000000000
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "duplicate-values-updates-and-empty-range",
      "input_values": [5, 6, 1, 2, 1, 3, 1, 1, 0, 5, 1, 0, 1, 1, 1, 1, 4, 1, 0, 4, 3, 1, 2, 5, 3, 1, 2, 2, 3],
      "input_length": 29,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0300000000000000020000000000000002000000000000000000000000000000"
    },
    {
      "id": "same-value-assignment-and-absent-value",
      "input_values": [1, 3, 7, 0, 0, 7, 1, 0, 1, 7, 1, 0, 1, 8],
      "input_length": 14,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "01000000000000000000000000000000"
    },
    {
      "id": "query-value-not-in-compressed-universe",
      "input_values": [2, 1, 4, 4, 1, 0, 2, 9],
      "input_length": 8,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "empty-operation-stream",
      "input_values": [1, 0, 1000000],
      "input_length": 3,
      "output_capacity": 0,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-point-index",
      "input_values": [1, 1, 4, 0, 1, 5],
      "input_length": 6,
      "output_capacity": 512,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-reversed-range",
      "input_values": [2, 1, 1, 2, 1, 2, 1, 1],
      "input_length": 8,
      "output_capacity": 512,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated-point-assignment",
      "input_values": [1, 1, 4, 0, 0],
      "input_length": 5,
      "output_capacity": 512,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "trailing-input-value",
      "input_values": [1, 0, 7, 99],
      "input_length": 4,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient-output-capacity",
      "input_values": [1, 1, 5, 1, 0, 1, 5],
      "input_length": 7,
      "output_capacity": 0,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
