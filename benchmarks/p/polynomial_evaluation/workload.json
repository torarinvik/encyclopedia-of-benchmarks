    "invalid_input_result": -9223372036854775808,
    "empty_polynomial_result": 0,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty-polynomial","input_values":[0,4],"input_length":2,"expected_result":0},
    {"id":"constant","input_values":[1,10,7],"input_length":3,"expected_result":7},
    {"id":"linear","input_values":[2,3,2,-4],"input_length":4,"expected_result":-10},
