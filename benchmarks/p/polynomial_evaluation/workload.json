    {"id":"source-example-negative-x","input_values":[5,-10,0,0,5,9,7],"input_length":7,"expected_result":61500},
    {"id":"negative-coefficients","input_values":[4,2,-3,5,-2,1],"input_length":6,"expected_result":7},
    {"id":"negative-x-and-coefficients","input_values":[3,-3,4,-2,7],"input_length":5,"expected_result":73},
    {"id":"maximum-degree-bound","input_values":[8,10,1000,1000,1000,1000,1000,1000,1000,1000],"input_length":10,"expected_result":11111111000},
    {"id":"invalid-count","input_values":[9,1],"input_length":2,"expected_result":-9223372036854775808},
    {"id":"invalid-length","input_values":[2,1,3],"input_length":3,"expected_result":-9223372036854775808},
    {"id":"invalid-x","input_values":[1,11,2],"input_length":3,"expected_result":-9223372036854775808},
    {"id":"invalid-coefficient","input_values":[1,1,1001],"input_length":3,"expected_result":-9223372036854775808}
  ]
