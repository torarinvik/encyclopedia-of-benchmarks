  "contract": {
    "operation": "Each round finds uncolored vertices whose priority is a strict local maximum. Mode 0 colors those vertices with the current color. Mode 1 also colors strict local minima with the next color; on an isolated vertex both predicates hold and the source's second assignment leaves the next color. Only colored vertices leave the uncolored set; other neighbors remain for later rounds.",
    "seed": 7,
    "priority_projection": "Pannotia calls srand(7), then assigns rand()/(float)RAND_MAX. The portable contract supplies distinct integer priorities explicitly because C rand streams differ by runtime; their order drives the same strict-extrema decisions.",
    "source_guard": "The source kernel skips neighbor comparisons for original CSR rows of degree one. The bounded profile rejects degree-one vertices, preserving valid proper-coloring results without silently correcting that source behavior.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
