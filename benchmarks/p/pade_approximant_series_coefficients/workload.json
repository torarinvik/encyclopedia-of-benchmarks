  "contract": {
    "operation": "Compute the unique normalized Padé [p/q] coefficients matching a formal power-series prefix over F_998244353.",
    "field_modulus": 998244353,
    "input_encoding": "[p,q,c0,...,c_(p+q)]",
    "degree_bounds": "1<=q<=p<=4",
    "coefficient_domain": "canonical residues 0..998244352",
    "normalization": "b0=1",
    "denominator_system": "For m=p+1..p+q solve sum(j=1..q,c_(m-j)*b_j)=-c_m mod P.",
    "numerator_convolution": "a_m=sum(j=0..min(m,q),c_(m-j)*b_j) mod P, m=0..p.",
    "output_encoding": "[p,q,a0,...,ap,b0,...,bq] as little-endian signed-i64 words",
    "singular_system_result": -3,
    "invalid_input_result": -1,
    "output_error_result": -2,
    "error_precedence": "Malformed input returns -1; valid input with null or short output returns -2 before solving; otherwise a singular system returns -3.",
    "output_untouched_on_error": true
  },
  "input": {
