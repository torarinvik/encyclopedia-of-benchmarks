    "encoding": "[p,q,c0,...,c_(p+q)]",
    "p_range": [1, 4],
    "q_range": [1, 4],
    "degree_constraint": "q<=p",
    "coefficient_range": [0, 998244352],
    "maximum_valid_length": 11,
