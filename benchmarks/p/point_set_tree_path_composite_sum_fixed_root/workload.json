  "contract": {
    "operation": "Root the tree at vertex 0. An edge map f(x)=b*x+c is applied toward a vertex, with the edge nearest the root outermost. After each vertex-value or edge-map point update, output the sum of all rooted path values modulo 998244353.",
    "input_layout": "[N,Q,A_0,...,A_(N-1), then N-1 records (u,v,b,c), then Q tagged updates]",
    "update_layout": "Type 0 is [0,w,x]. Type 1 is [1,e,y,z]. Each update produces one residue.",
    "n_range": [1, 16],
    "q_range": [1, 32],
    "vertex_and_addend_range": [0, 998244352],
    "multiplier_range": [1, 998244352],
    "modulus": 998244353,
    "algorithm": "Root at 0 and build a heavy-light decomposition. Each vertex stores the affine transform from its heavy child's subtree sum to its own, with light-child contributions folded into the intercept. A segment tree composes transforms in top-to-bottom chain order. Updates recompute changed chain-head sums and propagate across light edges. Preprocessing scans a bounded dense adjacency matrix in O(N^2); each update costs O(log^2 N).",
    "independent_algorithm": "After each update, recompute all rooted subtree sizes and path-value sums with a complete postorder recurrence. This uses no HLD or segment tree.",
    "output_layout": "Q little-endian signed 64-bit residues in update order.",
    "workspace_bytes": 8192,
    "error_precedence": "Malformed input or a non-tree returns -1 before output checks. Valid input with null output or capacity below 8*Q returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,A_0,...,A_(N-1),edge records,update records]",
    "maximum_valid_length": 206,
    "maximum_parseable_length": 206,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 32,
    "maximum_bytes": 256,
    "success_result": "8*Q bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "storage": "Fixed-size arrays for N<=16, Q<=32 and a 32-leaf affine segment tree."
  },
