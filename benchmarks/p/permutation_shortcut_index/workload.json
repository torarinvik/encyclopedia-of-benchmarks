      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [4,2,2,3,4,1,4,1,1,0,1,1,3,0,4],
      "input_length": 15,
      "output_capacity": 32,
