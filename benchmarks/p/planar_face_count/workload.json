  "algorithm": "planar_face_count",
  "function_symbol": "planar_face_count",
  "abi": "i64_array_scalar",
  "description": "Count the face orbits, including the unbounded face, of a bounded connected planar straight-line graph.",
  "source": {
    "title": "Finding faces of a planar graph",
    "url": "https://cp-algorithms.com/geometry/planar.html",
    "license": "CC BY-SA 4.0",
    "discovery_scope": "Algorithm description only; no source code or article prose copied."
  },
  "input": {
    "encoding": "[N,M,(x,y)*N,(u,v)*M]",
    "vertex_range": [1, 16],
    "edge_range": [0, 42],
    "coordinate_range": [-100, 100],
    "exact_length": "2+2*N+2*M",
    "maximum_valid_length": 118,
    "preconditions": ["distinct vertex coordinates", "simple connected graph", "noncrossing straight-line embedding", "no overlapping incident segments"],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "Number of faces, including the unbounded face.",
    "maximum_result": 28,
    "invalid_input_result": -1
  },
  "algorithm_details": {
    "primary": "Sort incident neighbors by polar angle and count orbits of the directed-edge face permutation.",
    "independent_oracle": "Use Euler's formula F=M-N+2 after separate bounded validation of the connected planar input.",
    "primary_complexity": "O(M^2+M log M) time including crossing validation and O(N^2+M) fixed storage.",
    "oracle_complexity": "O(N+M^2) bounded time and O(N+M) space."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
