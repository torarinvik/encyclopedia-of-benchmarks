{
  "schema_version": 1,
  "id": "oi-wiki-main-lorentz-tandem-repetitions-bounded-v1",
  "algorithm": "main_lorentz_tandem_repetitions",
  "function_symbol": "main_lorentz_tandem_repetitions",
  "abi": "i64_array_bytes_output",
  "source": {
    "repository": "OI-Wiki/OI-Wiki",
    "article_url": "https://oi-wiki.org/string/main-lorentz/",
    "repository_license": "CC BY-SA 4.0 and SATA",
    "reuse_scope": "Algorithm description only; ports, bounded workload, fixtures, oracles, and prose are clean-room."
  },
  "oracle": "benchmarks/p/main_lorentz_tandem_repetitions/primary_oracle.py",
  "independent_oracle": "benchmarks/p/main_lorentz_tandem_repetitions/independent_oracle.py",
  "contract": {
    "operation": "Return every interval [start,start+2*period) that consists of two equal adjacent blocks.",
    "input_layout": "[N, symbol_0, ..., symbol_(N-1)]",
    "symbol_range": [0, 255],
    "algorithm": "Main–Lorentz divide-and-conquer. Each split uses Z values on reversed half strings and cross-boundary strings to identify compact center/half-match groups, then marks their represented tandem squares.",
    "independent_algorithm": "Enumerate every start and period and compare the two adjacent blocks directly, symbol by symbol.",
    "output_layout": "Little-endian signed 64-bit words: count followed by one packed code per repetition in start-then-period order; code = start*32 + period.",
    "maximum_repetitions": 144,
    "workspace_bytes": 16384,
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below the actual encoded byte count returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, byte-valued symbols]",
    "n_range": [0, 24],
    "maximum_valid_length": 25,
    "maximum_parseable_input_length": 25,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 145,
    "maximum_bytes": 1160,
    "success_result": "8*(1+repetition_count) bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 16384,
    "storage": "Fixed-size input, Z-work, recursion, repetition-mark, and output arrays for N<=24."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "empty-string",
      "input_values": [0],
      "input_length": 1,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "single-symbol",
      "input_values": [1, 97],
      "input_length": 2,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "all-equal-overlapping-squares",
      "input_values": [8, 97, 97, 97, 97, 97, 97, 97, 97],
      "input_length": 9,
      "output_capacity": 136,
      "expected_result": 136,
      "expected_output_hex": "100000000000000001000000000000000200000000000000030000000000000004000000000000002100000000000000220000000000000023000000000000004100000000000000420000000000000043000000000000006100000000000000620000000000000081000000000000008200000000000000a100000000000000c100000000000000"
    },
    {
      "id": "nested-and-crossing-squares",
      "input_values": [6, 97, 98, 97, 97, 98, 97],
      "input_length": 7,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "020000000000000003000000000000004100000000000000"
    },
    {
      "id": "mixed-alphabet-repetitions",
      "input_values": [9, 97, 99, 97, 98, 97, 98, 97, 101, 101],
      "input_length": 10,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "030000000000000042000000000000006200000000000000e100000000000000"
    },
    {
      "id": "no-repetitions",
      "input_values": [5, 97, 98, 99, 100, 101],
      "input_length": 6,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "symbol-out-of-range",
      "input_values": [2, 97, 256],
      "input_length": 3,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "shape-mismatch",
      "input_values": [2, 97],
      "input_length": 2,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [6, 97, 98, 97, 97, 98, 97],
      "input_length": 7,
      "output_capacity": 23,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [1, 97],
      "input_length": 2,
      "output_capacity": 8,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 0,
      "output_capacity": 0,
      "input_is_null": true,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
