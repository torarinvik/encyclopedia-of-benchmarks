  "contract": {
    "operation": "Evaluate f(z)=sum(a_k*z^k) at an N-variable square-zero set power series s and return every dense mask coefficient modulo 998244353.",
    "input_layout": "[M, N, a_0, ..., a_(M-1), b_0, ..., b_(2^N-1)]",
    "coefficient_count_range": [0, 8],
    "n_range": [0, 4],
    "coefficient_range": [0, 998244352],
    "modulus": 998244353,
    "mask_order": "Increasing integer mask; bit j selects variable x_j.",
    "algorithm": "Horner composition with subset convolution; O(M*3^N) time and O(2^N) working arrays.",
    "independent_oracle": "Direct ordered-factor assignment expansion per polynomial power; O(M + sum_(k=1)^(M-1) k*(k+1)^N) time in the bounded profile.",
    "output_layout": "2^N little-endian signed 64-bit residues in increasing mask order.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below the exact output size returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[M, N, exactly M polynomial coefficients, then exactly 2^N set-series coefficients]",
    "maximum_valid_length": 26,
    "maximum_parseable_length": 27,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 16,
    "maximum_bytes": 128,
    "success_result": "8*2^N bytes",
    "invalid_result": -1,
