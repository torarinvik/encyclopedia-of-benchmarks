{
  "schema_version": 1,
  "id": "fsharp-rust-perfect-number-divisor-sum-v1",
  "algorithm": "perfect_numbers",
  "function_symbol": "perfect_numbers",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[n]",
    "value_range": [
      0,
      1000000000
    ],
    "maximum_input_length": 1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "1 if n equals the sum of its positive proper divisors; otherwise 0",
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "Uses the pinned F# positive-divisor-pair test, bounded to nonnegative n. The Rust list wrapper applies the same predicate for each positive candidate."
  },
  "measurement": {
    "comparison_model": "scalar_call",
    "sample_count": 10,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
