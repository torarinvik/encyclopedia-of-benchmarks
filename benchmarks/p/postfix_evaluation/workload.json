{
  "schema_version": 1,
  "id": "postfix-evaluation-i64-token-pairs-v1",
  "algorithm": "postfix_evaluation",
  "input": {
    "kind": "packed_opcode_operand_pairs",
    "encoding": "[opcode, payload] repeated for each token",
    "opcodes": {
      "0": "operand (payload is the value)",
      "1": "addition",
      "2": "subtraction",
      "3": "multiplication",
      "4": "division"
    },
    "operand_range": [
      -1000000,
      1000000
    ],
    "result_range": [
      -1000000000,
      1000000000
    ],
    "maximum_tokens": 256,
    "division": "truncate toward zero",
    "invalid_result": -1000000001,
    "invalid_cases": "malformed sequences, division by zero, invalid ranges, or arithmetic outside result_range"
  },
  "cases": [
    {
      "id": "single_operand",
      "input_values": [
        0,
        42
      ],
      "input_length": 2,
      "expected_result": 42
    },
    {
      "id": "multiply_then_add",
      "input_values": [
        0,
        5,
        0,
        6,
        3,
        0,
        0,
        9,
        1,
        0
      ],
      "input_length": 10,
      "expected_result": 39
    },
    {
      "id": "classic_subtract",
      "input_values": [
        0,
        2,
        0,
        3,
        0,
        4,
        3,
        0,
        2,
        0
      ],
      "input_length": 10,
      "expected_result": -10
    },
    {
      "id": "noncommutative_order",
      "input_values": [
        0,
        8,
        0,
        3,
        2,
        0
      ],
      "input_length": 6,
      "expected_result": 5
    },
    {
      "id": "integer_division",
      "input_values": [
        0,
        7,
        0,
        2,
        4,
        0
      ],
      "input_length": 6,
      "expected_result": 3
    },
    {
      "id": "negative_truncating_division",
      "input_values": [
        0,
        -7,
        0,
        2,
        4,
        0
      ],
      "input_length": 6,
      "expected_result": -3
    },
    {
      "id": "negative_denominator",
      "input_values": [
        0,
        7,
        0,
        -2,
        4,
        0
      ],
      "input_length": 6,
      "expected_result": -3
    },
    {
      "id": "division_exact",
      "input_values": [
        0,
        144,
        0,
        12,
        4,
        0
      ],
      "input_length": 6,
      "expected_result": 12
    },
    {
      "id": "maximum_valid_result",
      "input_values": [
        0,
        50000,
        0,
        20000,
        3,
        0
      ],
      "input_length": 6,
      "expected_result": 1000000000
