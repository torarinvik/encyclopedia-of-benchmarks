{
  "schema_version": 1,
  "id": "point-location-sweep-i64-array-scalar-v1",
  "algorithm": "point_location_sweep",
  "function_symbol": "point_location_sweep",
  "abi": "i64_array_scalar",
  "description": "Offline endpoint-event sweep with an active y-ordered segment set for vertical-ray face location.",
  "source": {
    "title": "CP-Algorithms Point location in O(log n)",
    "authors": ["CP-Algorithms contributors"],
    "urls": ["https://cp-algorithms.com/geometry/point-location.html"],
    "algorithm_attribution": "Offline x-sweep, active nonvertical edges ordered by height, nearest-crossing face lookup",
    "implementation_status": "clean-room implementation from the published algorithm description"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,Q,F,(x,y)*N,(u,v,above_face)*M,(qx,qy)*Q]",
    "edge_record_width": 3,
    "vertex_count_range": [2, 16],
    "edge_count_range": [1, 24],
    "query_count_range": [0, 16],
    "face_count_range": [1, 16],
    "coordinate_range": [-300, 300],
    "exact_length": "4 + 2*N + 3*M + 2*Q",
    "maximum_valid_length": 140,
    "maximum_parseable_length": 141,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "sum((one_based_query_index)*query_response)",
    "face_response": "face ID plus one; outer face is zero",
    "boundary_response": "F + zero_based_edge_ID + 1 when the query lies exactly on an edge",
    "maximum_response": 40,
    "result_range": [0, 5440]
  },
  "contract": {
    "vertex_coordinates": "all x-coordinates are distinct; all coordinates are bounded integers",
    "embedding": "simple noncrossing straight-line edges; intersections are allowed only at a shared endpoint; collinear incident edges are invalid",
    "edge_orientation": "above_face labels the face above the edge oriented from smaller x to larger x; -1 denotes the outer face",
    "query_x": "must differ from every vertex x-coordinate; may be outside the embedding bounds",
    "endpoint_event_order": "at a shared x, remove all ending edges before adding starting edges; queries at endpoint x are excluded",
    "same_x_add_order": "sort by exact y immediately to the right of the event, then slope, then input edge ID",
    "invalid_geometry_or_label_range": "invalidates the whole frame and returns -1",
    "independent_method": "scan each query against every segment and select the nearest crossing below it"
  },
  "complexity": {
    "event_sort": "O((M+Q) log(M+Q))",
    "active_update": "O(M) array insertion/removal in this bounded profile",
    "query": "O(log M) binary search in the active y-order",
    "auxiliary_space": "O(M+Q)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 11,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
