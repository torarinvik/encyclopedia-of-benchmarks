{
  "schema_version": 1,
  "id": "library-checker-binomial-prefix-bounded-i64-array-bytes-output-v1",
  "algorithm": "prefix_sum_of_binomial_coefficient",
  "function_symbol": "prefix_sum_of_binomial_coefficient",
  "abi": "i64_array_bytes_output",
  "description": "Compute an arbitrary prefix sum of an ordinary binomial row modulo a fixed prime.",
  "source": {
    "title": "Prefix Sum of Binomial Coefficient",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/enumerative_combinatorics/prefix_sum_of_binomial_coefficient/task.md",
    "parameters_url": "https://github.com/yosupo06/library-checker-problems/blob/master/enumerative_combinatorics/prefix_sum_of_binomial_coefficient/info.toml",
    "license_url": "https://github.com/yosupo06/library-checker-problems/blob/master/LICENSE",
    "algorithm_attribution": "modular multiplicative recurrence along one binomial row and running prefix accumulation",
    "implementation_status": "bounded clean-room arbitrary-prefix profile"
  },
  "contract": {
    "operation": "For each query (N,K), return sum(C(N,i), i=0..K) modulo 998244353.",
    "modulus": 998244353,
    "official_T_max": 200000,
    "official_N_max": 200000,
    "profile_T_max": 16,
    "profile_N_max": 128,
    "coefficient_recurrence": "C(N,i+1)=C(N,i)*(N-i)/(i+1) modulo 998244353",
    "prefix_rule": "Initialize coefficient and prefix to one, then add each next coefficient through K.",
    "output_error_result": -2
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[T, N0, K0, ..., N(T-1), K(T-1)]",
    "T_range": [1, 16],
    "query_range": "0 <= K <= N <= 128",
    "maximum_valid_length": 33,
    "maximum_parseable_input_length": 34,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_u32_vector",
    "encoding": "one unsigned 32-bit residue per query, no terminator",
    "maximum_bytes": 64,
    "success_result": "number of output bytes",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Inverse table through 128, packed query bounds, and temporary result storage."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 500
  },
  "oracle": "benchmarks/prefix_sum_of_binomial_coefficient_oracle.py",
  "independent_oracle": "benchmarks/prefix_sum_of_binomial_coefficient_independent_oracle.py",
