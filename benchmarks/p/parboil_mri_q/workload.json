  "contract": {
    "operation": "First compute all per-record phi magnitudes, then accumulate Qr=phiMag*cos(2*pi*(Kx*x+Ky*y+Kz*z)) and Qi=phiMag*sin(2*pi*(Kx*x+Ky*y+Kz*z)) for one spatial voxel, preserving the source's two passes and binary32 operation order.",
    "input_layout": "[numK,x_u,y_u,z_u,(Kx_u,Ky_u,Kz_u,phiR_u,phiI_u)*numK]",
    "component_encoding": "Signed Q1e-6 scalar; decode f32(f32(raw)/f32(1000000)).",
    "numK_range": [1, 4],
    "component_scale": 1000000,
    "component_raw_range": [-1000000, 1000000],
    "exact_length": "4 + 5*numK",
    "max_input_length": 24,
    "float_rule": "Decode each component as f32(f32(raw)/f32(1000000)); round each source-order multiplication, addition, Q product and Q accumulator update to binary32. PIx2 is the binary32 source constant 6.2831853071795864769252867665590058f.",
    "phi_magnitude_pass": "phiMag[k] = f32(f32(phiR[k]*phiR[k]) + f32(phiI[k]*phiI[k])) for k in ascending input order, before any Q accumulation.",
    "phase_operation_order": "f32(Kx*x), f32(Ky*y), f32(Kz*z), f32(product_x+product_y), f32(sum_xy+product_z), then f32(PIx2*sum_xyz).",
    "accumulation_order": "For each k in ascending input order, compute cosf(phase), sinf(phase), f32(phiMag[k]*trig), then add to Qr and Qi with binary32 rounding.",
    "output_encoding": "signed i32 little-endian Qr*1000 then signed i32 little-endian Qi*1000; each uses nearest rounding with ties away from zero after the completed source recurrence.",
    "output_bytes": 8,
    "maximum_abs_q_component": 8,
    "saturation": "none required under the four-record and component bounds",
    "success_result": 8,
    "output_capacity_requirement": 8,
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
