{
  "schema_version": 1,
  "id": "prefix-sum-selector-i64-bytes-v1",
  "algorithm": "prefix_sum",
  "function_symbol": "prefix_sum",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "op 0: [0,n,values...]; op 1: [1,n,values...,left,right]; op 2: [2,n,values...,target]",
    "maximum_array_length": 256,
    "array_value_range": [-2147483648, 2147483647],
    "target_range": [-1000000000000, 1000000000000]
  },
  "output": {
    "kind": "little_endian_signed_64_bit_words",
    "successful_result": "number of words written; op 0 emits n prefix sums and ops 1/2 emit one word",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty_prefixes","input_values":[0,0],"input_length":2,"expected_result":0,"expected_output_hex":""},
    {"id":"basic_prefixes","input_values":[0,3,1,2,3],"input_length":5,"expected_result":3,"expected_output_hex":"010000000000000003000000000000000600000000000000"},
    {"id":"negative_prefixes","input_values":[0,4,1,-2,3,4],"input_length":6,"expected_result":4,"expected_output_hex":"0100000000000000ffffffffffffffff02000000000000000600000000000000"},
    {"id":"inclusive_range","input_values":[1,4,1,2,3,4,1,3],"input_length":8,"expected_result":1,"expected_output_hex":"0900000000000000"},
    {"id":"valid_minus_one_range","input_values":[1,2,-3,2,0,1],"input_length":6,"expected_result":1,"expected_output_hex":"ffffffffffffffff"},
    {"id":"contains_sum","input_values":[2,3,1,2,3,6],"input_length":6,"expected_result":1,"expected_output_hex":"0100000000000000"},
    {"id":"contains_sum_with_negative_values","input_values":[2,4,1,-2,3,4,2],"input_length":7,"expected_result":1,"expected_output_hex":"0100000000000000"},
    {"id":"does_not_contain_sum","input_values":[2,3,1,2,3,20],"input_length":6,"expected_result":1,"expected_output_hex":"0000000000000000"},
    {"id":"empty_contains_sum","input_values":[2,0,0],"input_length":3,"expected_result":1,"expected_output_hex":"0000000000000000"},
    {"id":"invalid_selector","input_values":[3,0],"input_length":2,"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid_value_domain","input_values":[0,2,1,2147483648],"input_length":4,"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid_reversed_range","input_values":[1,2,1,2,1,0],"input_length":6,"expected_result":-1,"expected_output_hex":""},
    {"id":"insufficient_capacity","input_values":[0,2,1,1],"input_length":4,"expected_result":-2,"expected_output_hex":"","workspace_bytes":0,"capacity_error_result":-2}
  ]
}
