{
  "schema_version": 1,
  "id": "aarch64-heap-permutation-sort-count-i64-array-scalar-v1",
  "algorithm": "permutation_sort",
  "function_symbol": "permutation_sort",
  "input": {
    "kind": "signed_i64_array",
    "layout": "raw signed 64-bit integers; ABI length is item count",
    "length_range": [
      1,
      8
    ],
    "maximum_parseable_array_length": 9,
    "value_range": [
      -9223372036854775808,
      9223372036854775807
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "number of candidate arrays checked, including the original input, through the first nondecreasing permutation",
    "maximum_result": 40320,
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "The pinned AArch64 program checks the original array first, then uses iterative Heap permutation order and stops at the first signed-nondecreasing array. Its main loop prints the number of candidates checked; the benchmark scalar exposes that count.",
    "benchmark_domain": "Arrays of 1 through 8 signed 64-bit values. The cap bounds the complete permutation search to at most 8! = 40,320 candidate arrays."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
    {
      "id": "singleton",
      "input_values": [
        7
      ],
      "input_length": 1,
      "expected_result": 1
    },
    {
      "id": "already_sorted",
      "input_values": [
        -4,
        0,
        7
      ],
      "input_length": 3,
      "expected_result": 1
    },
    {
      "id": "reverse_two",
      "input_values": [
        2,
        1
      ],
      "input_length": 2,
      "expected_result": 2
    },
    {
      "id": "reverse_three",
      "input_values": [
        3,
        2,
        1
      ],
      "input_length": 3,
      "expected_result": 6
    },
    {
      "id": "first_swap_sorts",
      "input_values": [
        2,
        1,
        3
      ],
      "input_length": 3,
      "expected_result": 2
    },
    {
      "id": "duplicate_values",
      "input_values": [
        2,
        1,
        1
      ],
      "input_length": 3,
      "expected_result": 5
    },
    {
      "id": "all_equal",
      "input_values": [
        5,
        5,
        5,
        5
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "negative_and_positive",
      "input_values": [
        0,
        -3,
        2,
        -1
      ],
      "input_length": 4,
      "expected_result": 8
    },
    {
      "id": "signed_i64_extremes",
      "input_values": [
        9223372036854775807,
        -9223372036854775808
      ],
      "input_length": 2,
      "expected_result": 2
    },
    {
      "id": "maximum_length_reverse",
      "input_values": [
        8,
        7,
        6,
        5,
        4,
        3,
        2,
        1
      ],
      "input_length": 8,
      "expected_result": 37411
    },
    {
      "id": "invalid_empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": -1
    },
    {
      "id": "invalid_length_nine",
      "input_values": [
        9,
        8,
        7,
        6,
        5,
        4,
        3,
        2,
        1
      ],
      "input_length": 9,
      "expected_result": -1
    }
  ]
}
