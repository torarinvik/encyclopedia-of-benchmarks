{
  "schema_version": 1,
  "id": "pressure-conversion-rust-binary64-v1",
  "algorithm": "pressure",
  "function_symbol": "pressure",
  "input": {
    "kind": "finite_binary64_pressure_conversion",
    "value_range": [-1000000.0, 1000000.0],
    "unit_codes": {
      "0": "pascal",
      "1": "kilopascal",
      "2": "megapascal",
      "3": "bar",
      "4": "atmosphere",
      "5": "psi"
    },
    "formula": "value * from_to_pascal_factor / to_to_pascal_factor",
    "operation_order": "multiply by source-unit factor, then divide by destination-unit factor",
    "invalid_result": -1.0,
    "input_scaled_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "input_scaled_tolerance": 1e-12,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
  "cases": [
    {"id": "kilopascal-to-pascal", "input_values": [3.0, 1.0, 0.0], "expected_result": 3000.0},
    {"id": "atmosphere-to-pascal", "input_values": [4.0, 4.0, 0.0], "expected_result": 405300.0},
    {"id": "bar-to-atmosphere", "input_values": [1.0, 3.0, 4.0], "expected_result": 0.9869232667160128},
    {"id": "megapascal-to-psi", "input_values": [2.0, 2.0, 5.0], "expected_result": 290.07547546043367},
    {"id": "psi-to-kilopascal", "input_values": [100.0, 5.0, 1.0], "expected_result": 689.4757293168},
    {"id": "negative-pressure", "input_values": [-5.0, 1.0, 3.0], "expected_result": -0.05},
    {"id": "valid-result-equals-invalid-sentinel", "input_values": [-1000.0, 0.0, 1.0], "expected_result": -1.0},
    {"id": "same-unit", "input_values": [12.0, 2.0, 2.0], "expected_result": 12.0},
    {"id": "upper-value-bound", "input_values": [1000000.0, 2.0, 0.0], "expected_result": 1000000000000.0},
    {"id": "unknown-source-unit", "input_values": [1.0, 6.0, 0.0], "expected_result": -1.0},
    {"id": "fractional-unit-code", "input_values": [1.0, 1.5, 0.0], "expected_result": -1.0}
  ]
}
