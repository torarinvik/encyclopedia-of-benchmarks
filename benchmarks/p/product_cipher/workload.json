{
  "schema_version": 1,
  "id": "product-cipher-shift-slash-pad-column-transpose-v1",
  "algorithm": "product_cipher",
  "function_symbol": "product_cipher",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, text_length, ASCII bytes...]",
    "column_count_range": [
      1,
      64
    ],
    "text_length_range": [
      0,
      256
    ],
    "text_byte_range": [
      0,
      127
    ],
    "rejected_text_bytes": [
      10,
      13
    ],
    "maximum_valid_input_values": 258,
    "maximum_parseable_input_values": 259,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "transformation": {
    "substitution": "add 5 to each input byte interpreted as one UTF-16 code unit",
    "padding_byte": 47,
    "padding": "append slash bytes until the shifted text length is divisible by n",
    "emission": "for i from 0 through n-1, then j from 0 through padded_length/n-1, emit padded[i+j*n]",
    "output_byte_encoding": "raw numeric code-unit values, without UTF-8 encoding"
  },
  "output": {
    "kind": "byte_array",
    "result": "number of ciphertext bytes written",
    "maximum_output_bytes": 315,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "empty_text_result": 0,
    "empty_text_ignores_output_pointer_and_capacity": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 2,
    "repetitions_per_sample": 50
  },
  "cases": [
