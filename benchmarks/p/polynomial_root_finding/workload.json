    "operation": "Return every distinct a in F_998244353 for which f(a)=0.",
    "input_layout": "[N, f_0, ..., f_N] with coefficients in ascending degree order.",
    "n_range": [0, 8],
    "coefficient_range": [0, 998244352],
    "leading_coefficient_nonzero": true,
    "modulus": 998244353,
    "algorithm": "Compute gcd(f,x^p-x) to isolate the squarefree linear part, then use deterministic-seeded Cantor-Zassenhaus character splits. After 32 affine-polynomial attempts per factor, scan all shifts x+c; quadratic-character correlation guarantees a split for every product of at least two distinct linear factors.",
    "independent_algorithm": "Use deg(gcd(f,x^p-x)) to determine the number of roots in the base field, then directly evaluate f(x) at field elements in increasing order until all roots are found; this is O(pN) in the worst case and serves only as the independent bounded-profile oracle.",
    "output_layout": "Little-endian signed 64-bit word count followed by the distinct roots in ascending order.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or insufficient output capacity returns -2 without writes."
  },
  "input": {
