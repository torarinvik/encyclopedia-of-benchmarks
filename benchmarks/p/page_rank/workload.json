    "relative_tolerance": 1e-12
  },
  "input": {
    "kind": "float64_slice",
    "encoding": "[node_count, iteration_count, row-major binary adjacency matrix]",
    "node_count_range": [2, 4],
    "iteration_count_range": [0, 8],
    "matrix_entry_values": [0, 1],
    "matrix_rule": "Simple directed graph with zero diagonal; each row defines one source node, even when it is dangling.",
    "fixed_damping_factor": 0.5,
    "fixed_convergence_threshold": 0.0,
    "maximum_valid_input_elements": 18,
    "maximum_parseable_input_elements": 19,
    "invalid_input_result": -1,
    "null_input_result": -1
