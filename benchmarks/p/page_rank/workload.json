  "output": {
    "kind": "float64_slice",
    "encoding": "PageRank values in ascending node ID order",
    "maximum_elements": 4,
    "success_result": "number of rank values",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "contract": {
    "initialization": "Set each rank to 1/node_count.",
    "iteration": "Perform exactly iteration_count power iterations. The fixed zero convergence threshold prevents early termination.",
    "dangling_nodes": "A vertex with no outgoing edges contributes its current rank to dangling_sum. Add damping_factor*dangling_sum/node_count to every destination's baseline.",
    "rank_update": "For each target in node order, sum rank[source]/outdegree[source] for each incoming edge in ascending source order, then add the baseline and multiply the incoming sum by damping_factor.",
    "variant": "This is the Python/Rust variant: baseline is (1-damping_factor)/node_count and dangling mass is redistributed. Rust deduplicates multiedges, so input is a binary simple graph.",
    "determinism": "Damping is fixed at 0.5 and tolerance at 0.0. Rust hash iteration may reorder sums; compare ranks with the stated floating tolerance.",
    "bounds": "2..4 nodes, 0..8 iterations, simple directed graph, no self-loops."
  },
