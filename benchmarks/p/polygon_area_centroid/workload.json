    "discovery_scope": "KACTL chapter path/title led to the candidate; the public header description was checked to confirm its operation. No code, prose, examples, or tests copied."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,x0,y0,...,x(n-1),y(n-1)]",
    "vertex_count_range": [3, 16],
    "coordinate_range": [-50, 50],
    "vertex_rule": "distinct vertices in strict convex cyclic order; clockwise or counterclockwise",
    "exact_length": "1+2*n",
    "maximum_valid_length": 33,
    "maximum_parseable_length": 34,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "two signed 64-bit little-endian centroid coordinates multiplied by 1000000",
    "rounding": "nearest integer, exact ties away from zero",
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 16,
    "meaning": "Maximum external output-buffer capacity; input points and temporary sums use bounded fixed storage."
  },
  "algorithm_details": {
    "primary": "Accumulate S=sum(x_i*y_(i+1)-x_(i+1)*y_i), Nx=sum((x_i+x_(i+1))*cross_i), Ny=sum((y_i+y_(i+1))*cross_i), then round Nx/(3*S) and Ny/(3*S) to micro-units.",
    "independent_oracle": "Triangulate as a signed fan from vertex zero; sum each triangle's signed area times its arithmetic centroid, then divide by total signed area.",
    "validation": "For every edge, every non-edge vertex must lie strictly on the side selected by the signed shoelace orientation.",
    "primary_complexity": "O(n^2) validation and O(n) centroid sums.",
    "oracle_complexity": "O(n) fan triangulation."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
