  "abi": "i64_array_bytes_output",
  "description": "Computes the uniform-area centroid of a strictly convex polygon using exact signed integer cross sums.",
  "source": {
    "title": "Accurate Polygon Centroid Computation Using ARC/INFO GIS",
    "url": "https://doi.org/10.1061/(ASCE)0887-3801(1995)9:1(88)",
    "secondary_url": "https://faculty.washington.edu/greulich/Documents/Centroid.pdf",
