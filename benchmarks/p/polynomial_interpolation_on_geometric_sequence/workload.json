  "contract": {
    "operation": "Given N values y_i and geometric nodes x_i=a*r^i with pairwise-distinct residues, return the N coefficients c_0 through c_(N-1) of the unique interpolating polynomial over F_998244353.",
    "input_layout": "[N, a, r, y_0, ..., y_(N-1)]",
    "n_range": [0, 8],
    "field_value_range": [0, 998244352],
    "node_formula": "x_i = a*r^i modulo 998244353",
    "distinct_points": true,
    "modulus": 998244353,
    "algorithm": "Use in-place q-Newton divided differences: at order k and endpoint i, divide D[i]-D[i-1] by a*r^(i-k)*(r^k-1); then expand the Newton basis product_(j<k)(X-a*r^j) into monomial coefficients. O(N^2 log MOD) field operations with per-entry modular inversion, plus O(N^2) basis conversion.",
    "independent_algorithm": "Build the modular Vandermonde system on the geometric nodes and solve by Gauss-Jordan elimination; O(N^3) field operations and O(N^2) matrix storage.",
    "output_layout": "N little-endian signed 64-bit coefficients c_0 through c_(N-1), including trailing zero coefficients; N=0 emits no bytes.",
    "error_precedence": "Malformed input or repeated geometric nodes returns -1 before output checks. Valid input with null output or capacity below 8*N returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, a, r, y_0, ..., y_(N-1)]",
    "maximum_valid_length": 11,
    "maximum_parseable_length": 11,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 8,
    "maximum_bytes": 64,
    "success_result": "8*N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
