{
  "schema_version": 1,
  "id": "java-stack-palindrome-lowercase-ascii-v1",
  "algorithm": "palindrome_with_stack",
  "function_symbol": "palindrome_with_stack",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[byte_count, ASCII bytes...]",
    "count_range": [
      0,
      128
    ],
    "byte_range": [
      0,
      127
    ],
    "maximum_input_length": 129
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "1 if ASCII-lowercased string equals its reverse, else 0",
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "The pinned Java method lowercases the whole input, pushes its characters onto a stack, pops to form the reverse, and compares the two strings. ASCII contract makes case conversion deterministic."
  },
  "measurement": {
    "comparison_model": "scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": 1
    },
    {
      "id": "single-letter",
      "input_values": [
        1,
        65
      ],
      "input_length": 2,
      "expected_result": 1
    },
    {
      "id": "mixed-case-palindrome",
      "input_values": [
        7,
        82,
        97,
        99,
        101,
        67,
        97,
        114
      ],
      "input_length": 8,
      "expected_result": 1
    },
    {
      "id": "ordinary-palindrome",
      "input_values": [
        4,
        97,
        98,
        98,
        97
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "not-palindrome",
      "input_values": [
        4,
        97,
        98,
        99,
        97
      ],
      "input_length": 5,
      "expected_result": 0
    },
    {
      "id": "punctuation-is-significant",
      "input_values": [
        31,
        65,
        32,
        109,
        97,
        110,
        44,
        32,
        97,
        32,
        112,
        108,
        97,
        110,
        44,
        32,
        97,
        32,
        99,
        97,
        110,
        97,
        108,
        58,
        32,
        80,
        97,
        110,
        97,
        109,
        97,
        33
      ],
      "input_length": 32,
      "expected_result": 0
    },
    {
      "id": "bad-declared-length",
      "input_values": [
        3,
        97,
        98
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "non-ascii-byte",
      "input_values": [
        1,
