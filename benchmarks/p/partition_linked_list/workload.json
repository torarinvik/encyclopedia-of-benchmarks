    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "The pinned Python linked-list method walks nodes once, appending each to a less-than-pivot or greater-or-equal chain, then joins the chains. It preserves original order within both groups; the benchmark models the same stable ordering over a bounded array and hashes the result."
  },
  "measurement": {
