{
  "schema_version": 1,
  "id": "java-singly-linked-list-optimized-palindrome-int32-v1",
  "algorithm": "palindrome_singly_linked_list",
  "function_symbol": "palindrome_singly_linked_list",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[node_count, signed 32-bit node values...]",
    "count_range": [
      0,
      64
