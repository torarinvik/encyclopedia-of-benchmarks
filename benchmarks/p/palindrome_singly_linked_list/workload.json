  "source_bound": {
    "description": "Benchmarks the pinned Java isPalindromeOptimised Node method: slow/fast pointers locate the midpoint, the suffix from the midpoint is reversed in place, and integer values are compared from both ends. Array positions model linked-list traversal."
  },
  "measurement": {
    "comparison_model": "scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
