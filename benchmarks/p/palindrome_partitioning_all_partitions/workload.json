{
  "schema_version": 1,
  "id": "palindrome-partitioning-all-partitions-ascii-v1",
  "algorithm": "palindrome_partitioning_all_partitions",
  "function_symbol": "palindrome_partitioning_all_partitions",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[text_length, ASCII_byte...]",
    "text_length_range": [
      0,
      12
    ],
    "byte_range": [
      0,
      127
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[partition_count,(piece_count,one_based_exclusive_end_positions...)*]",
    "result": "number of output bytes written",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 50
  },
  "cases": [
    {
      "id": "empty_string",
      "input_values": [
        0
      ],
      "expected_result": 16,
      "expected_output_hex": "01000000000000000000000000000000"
    },
    {
      "id": "single_character",
      "input_values": [
        1,
        97
      ],
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000100000000000000"
    },
    {
      "id": "no_multi_character_palindrome",
      "input_values": [
        4,
        97,
        98,
        99,
        100
      ],
      "expected_result": 48,
      "expected_output_hex": "010000000000000004000000000000000100000000000000020000000000000003000000000000000400000000000000"
    },
    {
      "id": "source_example_aab",
      "input_values": [
        3,
        97,
        97,
        98
      ],
      "expected_result": 64,
      "expected_output_hex": "02000000000000000300000000000000010000000000000002000000000000000300000000000000020000000000000002000000000000000300000000000000"
    },
    {
      "id": "overlapping_palindrome_choices",
      "input_values": [
        4,
        97,
        98,
        97,
        98
      ],
      "expected_result": 96,
      "expected_output_hex": "030000000000000004000000000000000100000000000000020000000000000003000000000000000400000000000000020000000000000001000000000000000400000000000000020000000000000003000000000000000400000000000000"
    },
    {
      "id": "whole_string_palindrome",
      "input_values": [
        7,
        114,
        97,
        99,
        101,
        99,
        97,
        114
      ],
      "expected_result": 168,
      "expected_output_hex": ""
    },
    {
      "id": "many_partitions",
      "input_values": [
        8,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97
      ],
      "expected_result": 5640,
      "expected_output_hex": ""
    },
    {
      "id": "maximum_length_distinct_ascii",
      "input_values": [
        12,
        97,
        98,
        99,
        100,
        101,
        102,
        103,
        104,
        105,
        106,
        107,
        108
      ],
      "expected_result": 112,
      "expected_output_hex": "01000000000000000c000000000000000100000000000000020000000000000003000000000000000400000000000000050000000000000006000000000000000700000000000000080000000000000009000000000000000a000000000000000b000000000000000c00000000000000"
    },
    {
      "id": "negative_length",
      "input_values": [
        -1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "length_mismatch",
      "input_values": [
        2,
        97
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_negative_byte",
      "input_values": [
        1,
        -1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_non_ascii_byte",
      "input_values": [
        1,
        128
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "overlength",
      "input_values": [
        13,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient_output_capacity",
      "input_values": [
        3,
        97,
        97,
        98
      ],
      "expected_result": -2,
      "expected_output_hex": "",
      "workspace_bytes": 63
    }
  ]
}
