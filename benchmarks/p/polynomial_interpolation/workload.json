  "contract": {
    "operation": "Given N distinct points x_i and values y_i over F_998244353, return the N coefficients c_0 through c_(N-1) of the unique polynomial of degree less than N interpolating all pairs.",
    "input_layout": "[N, x_0, ..., x_(N-1), y_0, ..., y_(N-1)]",
    "n_range": [1, 12],
    "point_and_value_range": [0, 998244352],
    "distinct_points": true,
    "modulus": 998244353,
    "algorithm": "Construct each Lagrange basis polynomial by multiplying factors (X-x_j), scale by y_i / product_(j!=i)(x_i-x_j), and accumulate coefficients; O(N^3) field operations.",
    "independent_algorithm": "Build the modular Vandermonde system and solve by Gauss-Jordan elimination; O(N^3) field operations and O(N^2) matrix storage.",
    "output_layout": "N little-endian signed 64-bit coefficients c_0 through c_(N-1), including trailing zero coefficients.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below 8*N returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, x_0, ..., x_(N-1), y_0, ..., y_(N-1)]",
    "maximum_valid_length": 25,
    "maximum_parseable_length": 25,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 12,
    "maximum_bytes": 96,
    "success_result": "8*N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
