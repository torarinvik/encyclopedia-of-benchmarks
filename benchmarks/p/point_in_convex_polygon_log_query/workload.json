{
  "schema_version": 1,
  "id": "cp-algorithms-point-in-convex-polygon-log-query-byte-output-v1",
  "algorithm": "point_in_convex_polygon_log_query",
  "function_symbol": "point_in_convex_polygon_log_query",
  "abi": "i64_array_bytes_output",
  "description": "Answer point-membership queries in a strictly convex polygon by binary-searching its radial fan.",
  "source": {
    "title": "Check if point belongs to the convex polygon in O(log N)",
    "authors": ["CP-Algorithms contributors"],
    "url": "https://cp-algorithms.com/geometry/point-in-convex-polygon.html",
    "license": "CC BY-SA 4.0",
    "license_note": "Only the high-level fan-search method is used; implementations, contract, and fixtures are clean-room."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,(x,y)*N,(qx,qy)*Q]",
    "vertex_count_range": [3, 32],
    "query_count_range": [0, 32],
    "coordinate_range": [-1000000, 1000000],
    "polygon_rule": "Vertices are strictly convex and counterclockwise; any cyclic start is accepted. Repeated vertices and collinear consecutive edges are invalid.",
    "exact_length": "2+2*N+2*Q",
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "One value per query: 1 for inside or boundary, 0 for outside.",
    "maximum_values": 32,
    "maximum_output_bytes": 256,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "zero_query_null_output": true,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Bound for polygon, fan vectors, batched query/answer arrays, and external output capacity."
  },
  "algorithm": {
    "primary": "Rotate to the lexicographically smallest vertex, check the two fan rays, binary-search their polar-order triangle, and classify with exact cross products and a segment boundary test.",
    "independent_oracle": "Scan all polygon edges using exact even-odd horizontal-ray crossings after a separate inclusive boundary check.",
    "complexity": "O(N^2) bounded input validation, O(log N) per primary query, and O(N) per independent query."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"square-inside-boundary-outside","input_values":[4,4,0,0,4,0,4,4,0,4,2,2,4,2,5,2,0,0],"input_length":18,"output_capacity":32,"expected_result":32,"expected_output_hex":"0100000000000000010000000000000000000000000000000100000000000000"},
    {"id":"rotated-start-inside","input_values":[4,1,4,4,0,4,0,0,4,0,2,2],"input_length":12,"output_capacity":8,"expected_result":8,"expected_output_hex":"0100000000000000"},
    {"id":"zero-query-null-output","input_values":[3,0,0,0,4,0,0,4],"input_length":8,"output_capacity":0,"output_is_null":true,"expected_result":0,"expected_output_hex":""},
    {"id":"collinear-edge-invalid","input_values":[4,1,0,0,2,0,4,0,0,4,1,1],"input_length":12,"output_capacity":256,"expected_result":-1,"expected_output_hex":""},
    {"id":"valid-output-capacity-too-small","input_values":[4,4,0,0,4,0,4,4,0,4,2,2,4,2,5,2,0,0],"input_length":18,"output_capacity":31,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-output-for-query","input_values":[4,1,0,0,4,0,4,4,0,4,2,2],"input_length":12,"output_capacity":8,"output_is_null":true,"expected_result":-2,"expected_output_hex":""},
    {"id":"trailing-word-invalid","input_values":[3,0,0,0,4,0,0,4,99],"input_length":9,"output_capacity":256,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":0,"input_is_null":true,"output_capacity":256,"expected_result":-1,"expected_output_hex":""}
  ]
}
