{
  "schema_version": 1,
  "id": "power-factor-correction-v1",
  "algorithm": "power_factor_correction",
  "function_symbol": "power_factor_correction",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "required_length": 6,
    "layout": [
      "operation",
      "voltage_volts",
      "frequency_hz",
      "real_power_watts",
      "current_power_factor_basis_points",
      "expected_power_factor_basis_points"
    ],
    "operation_codes": {
      "0": "shunt_capacitance_farads",
      "1": "shunt_inductance_henries"
    },
    "voltage_minimum": 1,
    "voltage_maximum": 1000,
    "frequency_minimum": 1,
    "frequency_maximum": 1000,
    "real_power_minimum": -1000000,
    "real_power_maximum": 1000000,
    "factor_basis_points_minimum": -10000,
    "factor_basis_points_maximum": 10000,
    "factor_decoding": "basis_points / 10000.0",
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "compute current and expected reactive powers in source order, then operation 0 divides their difference by 2*pi*frequency*voltage^2; operation 1 divides voltage^2 by 2*pi*frequency*the reactive-power difference",
    "unit": "farads for operation 0; henries for operation 1",
    "invalid_input_result": -1e+300
  },
