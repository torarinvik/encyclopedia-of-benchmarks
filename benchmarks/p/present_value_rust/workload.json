{
  "schema_version": 1,
  "id": "present-value-rust-binary-exact-fixed-point-v1",
  "algorithm": "present_value_rust",
  "function_symbol": "present_value_rust",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[count, discount_rate_ppm, cash_flow_0_milli, ...]",
    "discount_rate_scale": 1000000,
    "discount_rate_ppm_values": [
      0,
      1000000
    ],
    "cash_flow_scale": 1000,
    "cash_flow_milli_step": 125,
    "cash_flow_count_range": [
      1,
      8
    ],
    "discount_rate_ppm_range": [
      0,
      1000000
    ],
    "cash_flow_milli_range": [
      -1000000,
      1000000
    ],
    "exact_length": "count + 2",
    "maximum_valid_length": 10,
    "maximum_parseable_length": 11,
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "meaning": "present value rounded to two decimals with ties away from zero",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "rate_zero_positive_tie",
      "input_values": [
        1,
        0,
        1125
      ],
      "input_length": 3,
      "expected_result": 1.13
    },
    {
      "id": "rate_zero_negative_tie",
      "input_values": [
        1,
        0,
        -1125
      ],
      "input_length": 3,
      "expected_result": -1.13
    },
    {
