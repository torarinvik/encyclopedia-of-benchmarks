{
  "schema_version": 1,
  "id": "oi-wiki-steiner-tree-subset-dp-i64-scalar-v1",
  "algorithm": "steiner_tree_subset_dp",
  "function_symbol": "steiner_tree_subset_dp",
  "abi": "i64_array_scalar",
  "description": "Find the exact minimum edge-weight connected subgraph joining a terminal set by subset dynamic programming.",
  "source": {
    "title": "Steiner Tree",
    "authors": ["OI Wiki contributors"],
    "url": "https://oi-wiki.org/graph/steiner-tree/",
    "license": "CC BY-SA 4.0 and SATA",
    "license_note": "Only the high-level subset-DP description is used; ports, contract, and fixtures are clean-room."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,K,terminal_0,...,terminal_(K-1),(u,v,w)*M]",
    "vertex_count_range": [1, 8],
    "edge_count_range": [0, 14],
    "terminal_count_range": [1, 5],
    "terminal_count_at_most_vertex_count": true,
    "edge_weight_range": [0, 1000],
    "edge_rule": "Simple undirected graph; each edge is encoded once with 0<=u<v<N. Edge order is arbitrary.",
    "terminals_must_be_distinct": true,
    "exact_length": "3+K+3*M",
    "maximum_valid_length": 50,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "Exact minimum total edge weight of a connected subgraph containing all terminals.",
    "single_terminal_result": 0,
    "disconnected_terminal_result": -2,
    "invalid_input_result": -1
  },
  "algorithm_details": {
    "primary": "For each terminal mask, merge complementary states at every candidate root and propagate the state by multi-source Dijkstra over graph edges.",
    "independent_oracle": "Enumerate all edge subsets and use disjoint sets to test whether they connect every terminal.",
    "primary_complexity": "O(3^K*N + 2^K*(N^2+M)) with fixed-array O(N^2+M) multi-source Dijkstra per mask.",
    "oracle_complexity": "O(2^M*(N+M)) with bounded early cost pruning.",
    "nonnegative_weights": true
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"one-terminal-empty-graph","input_values":[1,0,1,0],"input_length":4,"expected_result":0},
    {"id":"direct-terminal-edge","input_values":[2,1,2,0,1,0,1,7],"input_length":8,"expected_result":7},
    {"id":"three-terminal-hub","input_values":[4,3,3,0,1,2,0,3,2,1,3,2,2,3,2],"input_length":15,"expected_result":6},
    {"id":"four-terminal-steiner-center","input_values":[5,4,4,0,1,2,3,0,4,1,1,4,2,1,4,3,1],"input_length":19,"expected_result":4},
    {"id":"zero-weight-path-edge","input_values":[3,2,2,0,1,0,2,0,1,2,5],"input_length":11,"expected_result":5},
    {"id":"disconnected-terminals","input_values":[3,1,2,0,2,0,1,2],"input_length":8,"expected_result":-2},
    {"id":"duplicate-terminal-invalid","input_values":[2,1,2,0,0,0,1,7],"input_length":8,"expected_result":-1},
    {"id":"duplicate-edge-invalid","input_values":[3,2,2,0,1,0,1,1,0,1,2],"input_length":11,"expected_result":-1},
    {"id":"negative-edge-invalid","input_values":[2,1,2,0,1,0,1,-1],"input_length":8,"expected_result":-1},
    {"id":"maximum-bounds-chain","input_values":[8,14,5,0,2,4,6,7,0,1,1,1,2,1,2,3,1,3,4,1,4,5,1,5,6,1,6,7,1,0,2,5,2,4,5,4,6,5,0,6,5,1,5,5,3,7,5,0,7,5],"input_length":50,"expected_result":7}
  ]
