  },
  "measurement": {
    "comparison_model": "scalar_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "one_sample",
      "input_values": [
        1,
        7
      ],
      "expected_result": 7.0
    },
    {
      "id": "four_samples",
      "input_values": [
        4,
        10,
        40,
        20,
        30
      ],
      "expected_result": 25.0
    },
    {
      "id": "ascending_stream",
      "input_values": [
        8,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "expected_result": 4.0
    },
    {
      "id": "descending_stream",
      "input_values": [
        9,
        9,
        8,
        7,
        6,
        5,
        4,
        3,
        2,
        1
      ],
      "expected_result": 5.0
