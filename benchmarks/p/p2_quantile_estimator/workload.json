{
  "schema_version": 1,
  "id": "java-p2-median-i64-array-f64-v1",
  "algorithm": "p2_quantile_estimator",
  "function_symbol": "p2_quantile_estimator",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[sample_count, signed_i32_samples...]",
    "sample_count_range": [
      1,
      64
