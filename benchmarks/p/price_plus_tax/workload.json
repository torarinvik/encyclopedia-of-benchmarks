{
  "schema_version": 1,
  "id": "price-plus-tax-fixed-point-i64-array-float64-v1",
  "algorithm": "price_plus_tax",
  "function_symbol": "price_plus_tax",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[price_micro, tax_rate_micro]",
    "scale": 1000000,
    "price_micro_range": [
      0,
      1000000000000
    ],
    "tax_rate_micro_range": [
      0,
      1000000
    ],
    "exact_shape": "2 values",
    "maximum_parseable_length": 3,
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "meaning": "price * (1 + tax_rate), where both inputs are divided by 1,000,000 and the result is not rounded",
    "invalid_input_result": -1e+300,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "zero_price_zero_tax",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": 0.0
    },
    {
      "id": "zero_price_full_tax",
      "input_values": [
        0,
        1000000
      ],
      "input_length": 2,
      "expected_result": 0.0
    },
    {
      "id": "integer_price_without_tax",
      "input_values": [
        100000000,
        0
      ],
      "input_length": 2,
      "expected_result": 100.0
    },
    {
      "id": "source_example_quarter_tax",
      "input_values": [
        100000000,
        250000
      ],
      "input_length": 2,
      "expected_result": 125.0
    },
    {
      "id": "source_example_fractional_price",
      "input_values": [
        125500000,
        50000
      ],
      "input_length": 2,
      "expected_result": 131.775
    },
    {
      "id": "fractional_micro_price_and_rate",
      "input_values": [
        12345,
        7500
      ],
      "input_length": 2,
      "expected_result": 0.012437587500000001
    },
    {
      "id": "smallest_price_and_rate_steps",
      "input_values": [
        1,
        1
      ],
      "input_length": 2,
      "expected_result": 1.0000009999999998e-06
    },
    {
      "id": "fractional_price_without_tax",
      "input_values": [
        999999,
        0
      ],
      "input_length": 2,
      "expected_result": 0.999999
    },
    {
      "id": "maximum_price_without_tax",
      "input_values": [
        1000000000000,
        0
      ],
      "input_length": 2,
      "expected_result": 1000000.0
    },
    {
      "id": "maximum_price_and_tax",
      "input_values": [
        1000000000000,
        1000000
      ],
      "input_length": 2,
      "expected_result": 2000000.0
    },
    {
      "id": "near_maximum_price_and_tax",
      "input_values": [
        999999999999,
        999999
      ],
      "input_length": 2,
      "expected_result": 1999998.9999979998
    },
    {
      "id": "half_rate",
      "input_values": [
        500000000,
        500000
      ],
      "input_length": 2,
      "expected_result": 750.0
    },
    {
      "id": "empty_input",
      "input_values": [],
      "input_length": 0,
      "expected_result": -1e+300
    },
    {
      "id": "too_short",
      "input_values": [
        100000000
      ],
      "input_length": 1,
      "expected_result": -1e+300
    },
    {
      "id": "too_long",
      "input_values": [
        100000000,
        50000,
        0
      ],
      "input_length": 3,
      "expected_result": -1e+300
    },
    {
      "id": "negative_price",
      "input_values": [
        -1,
        0
      ],
      "input_length": 2,
      "expected_result": -1e+300
    },
    {
      "id": "price_above_bound",
      "input_values": [
        1000000000001,
        0
      ],
      "input_length": 2,
      "expected_result": -1e+300
    },
    {
      "id": "negative_tax_rate",
      "input_values": [
        100000000,
        -1
      ],
      "input_length": 2,
      "expected_result": -1e+300
    },
    {
      "id": "tax_rate_above_bound",
      "input_values": [
        100000000,
        1000001
      ],
      "input_length": 2,
      "expected_result": -1e+300
    }
  ]
}
