{
  "schema_version": 1,
  "id": "persistent-leftist-heap-v1",
  "algorithm": "persistent_leftist_heap",
  "function_symbol": "persistent_leftist_heap",
  "abi": "i64_array_scalar",
  "source": {
    "title": "Persistent mergeable heap (path-copying leftist heap)",
    "url": "https://oi-wiki.org/ds/persistent-heap/",
    "reuse": "algorithm idea only; independent implementation, contract, and fixtures"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[q, variable-width operation records]",
    "operation_count_range": [0, 64],
    "maximum_heap_size": 128,
    "key_range": [-10000, 10000],
    "version_zero": "empty; operation i may reference versions 0 through i and creates version i+1",
    "operations": {
      "0 base key": "insert key into a copy of base by melding with a singleton",
      "1 left right": "meld the referenced versions",
      "2 version": "observe and remove the minimum, creating a new version",
      "3 version": "observe the minimum and create an alias version"
    },
    "empty_observation_rank": 20001,
    "nonempty_observation_rank": "minimum + 10000",
    "maximum_valid_input_length": 193,
    "maximum_parseable_input_length": 194,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "(sum_of_observation_ranks << 15) | xor_of_observation_ranks",
    "result_range": "0..41945169919",
    "invalid_result": -1
  },
  "complexity": {
    "meld_time": "O(log n) worst case for a leftist heap",
    "persistent_nodes_per_meld": "O(log n) worst case",
    "cumulative_node_space": "O(q log n) worst case"
  },
  "workspace": {
    "bytes": 65536,
    "persistent_node_pool_capacity": 1024,
    "node_pool_bound_includes_empty_sentinel": true
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "branching-history-and-shared-roots",
      "input_values": [8, 0, 0, 5, 0, 1, 2, 3, 1, 2, 2, 1, 1, 2, 2, 2, 5, 2, 5, 3, 4],
      "expected_result": 1638934290
    },
    {
      "id": "empty-observations-and-minimum-key",
      "input_values": [4, 3, 0, 2, 0, 0, -10000, 3, 3],
      "expected_result": 1310785536
    },
    {
      "id": "duplicate-melding-and-pop",
      "input_values": [5, 0, 0, 4, 0, 0, 4, 1, 1, 2, 1, 3, 3, 2, 4],
      "expected_result": 327821076
    },
    {
      "id": "maximum-logical-heap-size",
      "input_values": [8, 0, 0, 7, 1, 1, 1, 1, 2, 2, 1, 3, 3, 1, 4, 4, 1, 5, 5, 1, 6, 6, 1, 7, 7],
      "expected_result": 0
    },
    {
      "id": "future-version-reference",
      "input_values": [1, 1, 1, 0],
      "expected_result": -1
    },
    {
      "id": "heap-size-overflow",
      "input_values": [9, 0, 0, 7, 1, 1, 1, 1, 2, 2, 1, 3, 3, 1, 4, 4, 1, 5, 5, 1, 6, 6, 1, 7, 7, 1, 8, 8],
      "expected_result": -1
    },
    {
      "id": "invalid-key",
      "input_values": [1, 0, 0, 10001],
      "expected_result": -1
    },
    {
      "id": "unknown-operation",
      "input_values": [1, 4],
      "expected_result": -1
    },
    {
      "id": "trailing-word",
      "input_values": [0, 7],
      "expected_result": -1
    },
    {
      "id": "missing-header",
      "input_values": [],
      "expected_result": -1
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_is_null": true,
      "input_length": 0,
      "expected_result": -1
    }
  ]
}
