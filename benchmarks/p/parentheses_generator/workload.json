{
  "schema_version": 1,
  "id": "parentheses-generator-java-order-v1",
  "algorithm": "parentheses_generator",
  "function_symbol": "parentheses_generator",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[pair_count]",
    "count_range": [
      1,
      1
    ],
    "pair_count_range": [
      0,
      6
    ],
    "maximum_input_length": 1
  },
  "output": {
    "kind": "ascii_bytes",
    "return_value": "bytes written",
    "meaning": "u16 little-endian result count, then each fixed-width generated string in source traversal order",
    "maximum_output_bytes": 1586,
    "invalid_result": -1
  },
  "workspace": {
    "bytes": 1586,
    "meaning": "Staged count-prefixed output for at most 132 strings of twelve ASCII bytes each."
  },
  "source_bound": {
    "description": "The pinned Java recursion tries '(' before ')' and only closes when close_count < open_count. The benchmark bounds the number of pairs to six."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "zero-pairs",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": 2,
      "expected_output_hex": "0100",
      "output_capacity": 1586
    },
    {
      "id": "one-pair",
      "input_values": [
        1
      ],
      "input_length": 1,
      "expected_result": 4,
      "expected_output_hex": "01002829",
      "output_capacity": 1586
    },
    {
      "id": "three-pairs",
      "input_values": [
        3
      ],
      "input_length": 1,
      "expected_result": 32,
      "expected_output_hex": "0500282828292929282829282929282829292829282928282929282928292829",
      "output_capacity": 1586
    },
    {
      "id": "negative-invalid",
      "input_values": [
        -1
      ],
      "input_length": 1,
      "expected_result": -1,
      "expected_output_hex": "",
      "output_capacity": 1586
    }
  ]
}
