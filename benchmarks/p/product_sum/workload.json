{
  "schema_version": 1,
  "id": "product-sum-nested-array-depth-weighted-v1",
  "algorithm": "product_sum",
  "function_symbol": "product_sum",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[token_count, tokens...] where LIST_BEGIN=2001 starts a nested list and LIST_END=2002 closes it; the root list is implicit",
