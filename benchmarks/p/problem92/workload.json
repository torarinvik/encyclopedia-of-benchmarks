{
  "schema_version": 1,
  "id": "project-euler-problem-92-square-digit-chains-v1",
  "algorithm": "problem92",
  "function_symbol": "problem92",
  "input": {
    "kind": "signed_64_bit_integer",
    "limit_range": [
      0,
      10000000
    ],
    "meaning": "exclusive upper bound; count positive starting values smaller than this number",
    "out_of_range_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "number of starting values from 1 through number-1 whose square-digit chain reaches 89"
  },
  "measurement": {
    "comparison_model": "scalar_call",
    "sample_count": 3,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "zero_limit",
      "input_value": 0,
      "expected_result": 0
    },
    {
      "id": "one_limit",
      "input_value": 1,
      "expected_result": 0
    },
    {
      "id": "two_limit",
      "input_value": 2,
      "expected_result": 0
    },
    {
      "id": "first_start_reaching_89",
      "input_value": 3,
      "expected_result": 1
    },
    {
      "id": "small_bound_ten",
      "input_value": 10,
      "expected_result": 7
    },
    {
      "id": "source_example_one_hundred",
      "input_value": 100,
      "expected_result": 80
    },
    {
      "id": "canonical_ten_million",
      "input_value": 10000000,
      "expected_result": 8581146
    },
    {
      "id": "negative_limit",
      "input_value": -1,
      "expected_result": -1
    },
    {
      "id": "above_supported_limit",
      "input_value": 10000001,
      "expected_result": -1
    }
  ]
