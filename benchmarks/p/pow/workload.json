{
  "schema_version": 1,
  "id": "dart-pow-repeated-multiplication-v1",
  "algorithm": "pow",
  "function_symbol": "pow_algorithm",
  "input": {"kind":"signed_i64_array","encoding":"[base, exponent]","count_range":[2,2],"base_range":[-1000,1000],"exponent_range":[-8,12],"maximum_input_length":2},
  "output": {"kind":"float64_scalar","meaning":"repeated multiplication result","invalid_input_result":-1e300},
  "source_bound": {"description":"The source returns 1 for zero and negative exponents because its multiplication loop runs only while the counter is at most the exponent."},
  "measurement": {"comparison_model":"scalar_call","sample_count":7,"warmup_rounds":2,"repetitions_per_sample":10000,"absolute_tolerance":1e-12,"relative_tolerance":1e-12},
  "cases": [
    {"id":"square","input_values":[10,2],"input_length":2,"expected_result":100.0},
    {"id":"zero_exponent","input_values":[2,0],"input_length":2,"expected_result":1.0},
    {"id":"positive_power","input_values":[2,10],"input_length":2,"expected_result":1024.0},
    {"id":"negative_exponent_source_behavior","input_values":[3,-2],"input_length":2,"expected_result":1.0},
    {"id":"negative_base_odd_power","input_values":[-2,3],"input_length":2,"expected_result":-8.0},
    {"id":"outside_bounds","input_values":[1001,2],"input_length":2,"expected_result":-1e300}
  ]
