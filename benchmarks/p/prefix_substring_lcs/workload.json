{
  "schema_version": 1,
  "id": "prefix-substring-lcs-semilocal-fenwick-v1",
  "algorithm": "prefix_substring_lcs",
  "function_symbol": "prefix_substring_lcs",
  "abi": "i64_array_bytes_output",
  "description": "Batched LCS lengths between prefixes of one string and substrings of another.",
  "oracle": "benchmarks/p/prefix_substring_lcs/primary_oracle.py",
  "independent_oracle": "benchmarks/p/prefix_substring_lcs/independent_oracle.py",
  "source": {
    "title": "Library Checker Prefix-Substring LCS",
    "url": "https://github.com/yosupo06/library-checker-problems/tree/master/string/prefix_substring_lcs",
    "algorithm_reference": "Alves, Caceres, and Song, An all-substrings common subsequence algorithm, Discrete Applied Mathematics 156(7), 2008, DOI 10.1016/j.dam.2007.05.056",
    "source_license": "Library Checker problem repository is Apache-2.0; only task semantics and algorithm attribution are used",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[|S|,|T|,Q,S lowercase ASCII codes...,T lowercase ASCII codes...,(a,b,c)...]",
    "string_length_range": [1, 32],
    "query_count_range": [1, 64],
    "character_code_range": [97, 122],
    "query_ranges": "0<=a<=|S| and 0<=b<=c<=|T|",
    "maximum_valid_length": 259,
    "maximum_parseable_length": 260,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian LCS length per query in input order",
    "maximum_bytes": 512,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 65536,
    "meaning": "Two bounded semi-local boundary tables, grouped query indices, value buckets, Fenwick tree, and staged answers"
  },
  "contract": {
    "operation": "For each (a,b,c), return LCS(S[0:a],T[b:c]).",
    "state": "H[0][j]=j and V[0][j]=0; equal symbols exchange the incoming horizontal and vertical values, while unequal symbols send their maximum horizontally and minimum vertically.",
    "query_identity": "Count j in [b+1,c+1) whose H[a][j] is at most b.",
    "algorithm": "Compute semi-local prefix boundary rows, group queries by (a,b), then activate row positions in increasing boundary-value order with a Fenwick tree.",
    "complexity": "O((|S||T|+Q) log |T|) time and O(|S||T|+Q) bounded storage.",
    "error_precedence": "Validate the packed input, then check output pointer and capacity before computation or writes.",
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1,
    "profiles": [
      {"id": "repeated-symbol-batch", "input_values": [2, 3, 3, 97, 97, 97, 97, 97, 2, 0, 3, 1, 1, 3, 2, 2, 2]}
    ]
  },
  "cases": [
    {"id": "single-match-and-empty-ranges", "input_values": [1, 1, 3, 97, 97, 1, 0, 1, 1, 0, 0, 0, 0, 1], "input_length": 14, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "010000000000000000000000000000000000000000000000"},
    {"id": "repeated-symbol-substrings", "input_values": [2, 3, 5, 97, 97, 97, 97, 97, 2, 0, 3, 1, 1, 3, 2, 2, 3, 2, 1, 1, 0, 0, 3], "input_length": 23, "output_capacity": 40, "expected_result": 40, "expected_output_hex": "02000000000000000100000000000000010000000000000000000000000000000000000000000000"},
    {"id": "mixed-prefix-substring-queries", "input_values": [3, 5, 5, 97, 98, 99, 122, 97, 98, 99, 120, 3, 1, 4, 2, 2, 5, 3, 0, 5, 1, 3, 4, 3, 4, 5], "input_length": 26, "output_capacity": 40, "expected_result": 40, "expected_output_hex": "03000000000000000100000000000000030000000000000000000000000000000000000000000000"},
    {"id": "short-output-capacity", "input_values": [1, 1, 1, 97, 97, 1, 0, 1], "input_length": 8, "output_capacity": 7, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null-output", "input_values": [1, 1, 1, 97, 97, 1, 0, 1], "input_length": 8, "output_capacity": 8, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
    {"id": "invalid-uppercase-character", "input_values": [1, 1, 1, 65, 97, 1, 0, 1], "input_length": 8, "output_capacity": 8, "expected_result": -1, "expected_output_hex": ""},
    {"id": "query-out-of-range", "input_values": [1, 1, 1, 97, 97, 2, 0, 1], "input_length": 8, "output_capacity": 8, "expected_result": -1, "expected_output_hex": ""},
    {"id": "malformed-packed-length", "input_values": [1, 1, 1, 97, 97, 1, 0], "input_length": 7, "output_capacity": 8, "expected_result": -1, "expected_output_hex": ""},
    {"id": "empty-input", "input_values": [], "input_length": 0, "output_capacity": 512, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-input", "input_values": [], "input_length": 0, "input_is_null": true, "output_capacity": 512, "expected_result": -1, "expected_output_hex": ""}
  ]
}
