  "contract": {
    "operation": "Parse one bounded ANSI-C declaration and serialize its base type, identifier, and derived type operators in identifier-outward order. The representation captures C declarator binding precedence, including pointer/array/function nesting.",
    "input_layout": "ASCII source declaration bytes represented as signed-i64 byte values.",
    "grammar": "base-type declarator; base type is char, int, float, double, or void. Declarators support pointer prefixes, parenthesized declarators, fixed arrays [1..99], and function suffixes with up to three unnamed primitive or pointer-to-primitive parameters.",
    "limits": "Input length 1..96 bytes, identifier length 1..16, pointer depth at most 8, derived operators at most 12, parenthesis nesting at most 6, and function arity at most 3.",
    "canonical_base_type_codes": {"char": 1, "int": 2, "float": 3, "double": 4, "void": 5},
    "canonical_operator_codes": {"pointer": 1, "array": 2, "function": 3},
    "output_encoding": "[base_type_code, identifier_length, identifier_ascii_bytes..., operator_count, operators...]. Pointer is [1]; array is [2, dimension]; function is [3, arity, (parameter_base_type_code, parameter_pointer_depth)...]. Operators are emitted from the identifier outward, preserving declarator binding.",
    "maximum_valid_input_length": 96,
    "maximum_output_bytes": 128,
    "success_result": "Canonical output byte length.",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Invalid or unsupported syntax, bounds violations, null input, and invalid byte values return -1. Null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "ASCII declaration bytes",
    "maximum_valid_length": 96,
    "maximum_parseable_length": 96,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "Canonical parsed declarator structure",
    "maximum_bytes": 128,
    "capacity_unit": "bytes",
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 128,
    "meaning": "Maximum caller-provided canonical parse output buffer."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
