{
  "schema_version": 1,
  "id": "javascript-square-pyramid-i64-array-f64-v1",
  "algorithm": "pyramid",
  "function_symbol": "pyramid",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[operation, base_side_milli, height_milli]",
    "operation_values": [
      0,
      1
    ],
    "dimension_milli_range": [
      1,
      10000000
    ],
    "maximum_input_length": 3
  },
  "output": {
    "kind": "binary64",
    "meaning": "volume for operation 0 or total surface area for operation 1",
    "invalid_input_result": -1e+300
  },
  "source_bound": {
    "description": "Preserves the pinned JavaScript baseArea, volume, and surfaceArea formulas for a regular square pyramid."
  },
  "measurement": {
    "comparison_model": "scalar_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "volume_3_by_4",
      "input_values": [
        0,
        3000,
        4000
      ],
      "expected_result": 12.0
    },
    {
      "id": "surface_3_by_4",
      "input_values": [
        1,
        3000,
        4000
      ],
      "expected_result": 34.63201123595259
    },
    {
      "id": "fractional_volume",
      "input_values": [
        0,
        1250,
        2750
      ],
      "expected_result": 1.4322916666666667
    },
    {
      "id": "fractional_surface",
      "input_values": [
        1,
        1250,
        2750
      ],
      "expected_result": 8.612821357924048
    },
    {
      "id": "invalid_mode",
      "input_values": [
        2,
        3000,
        4000
      ],
      "expected_result": -1e+300
    }
  ]
}
