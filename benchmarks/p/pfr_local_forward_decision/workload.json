{
  "schema_version": 1,
  "id": "encyclopedia-pfr-local-forward-decision-i64-array-bytes-output-v1",
  "algorithm": "pfr_local_forward_decision",
  "function_symbol": "pfr_local_forward_decision",
  "abi": "i64_array_bytes_output",
  "description": "Replay one PFR local angle-based forwarding decision with a supplied finite-grid draw.",
  "source": {
    "title": "Probabilistic Data Forwarding in Wireless Sensor Networks",
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_301",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_301",
    "algorithm_attribution": "PFR local angle-based forwarding probability",
    "implementation_status": "clean-room bounded local-decision profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[angle_microdegrees,draw_index]",
    "angle_microdegrees_range": [0, 180000000],
    "draw_index_range": [0, 999999],
    "draw_grid": "U=draw_index/1000000, left-endpoint discretization",
    "maximum_valid_length": 2,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_scalar",
    "encoding": "1 if the local rule forwards, otherwise 0",
    "maximum_bytes": 8,
    "success_result": 8,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 16,
    "meaning": "No dynamic data structures; parse two integers and stage one scalar result."
  },
  "contract": {
    "threshold": "If angle_microdegrees>=134000000, return 1 for every draw.",
    "below_threshold": "Return 1 exactly when 180*draw_index<angle_microdegrees; this is the integer form of U<phi/pi for U=draw_index/1000000 and phi in degrees.",
    "scope": "One local decision only; no continuous-randomness probability claim, network simulation, protocol lifecycle, collisions, activation order, or node failures.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"zero-angle-never-forwards","input_values":[0,0],"input_length":2,"output_capacity":8,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"half-angle-below-midpoint-draw","input_values":[90000000,499999],"input_length":2,"output_capacity":8,"expected_result":8,"expected_output_hex":"0100000000000000"},
    {"id":"half-angle-at-midpoint-draw","input_values":[90000000,500000],"input_length":2,"output_capacity":8,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"below-threshold-high-draw","input_values":[133999999,999999],"input_length":2,"output_capacity":8,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"threshold-forces-forward","input_values":[134000000,999999],"input_length":2,"output_capacity":8,"expected_result":8,"expected_output_hex":"0100000000000000"},
    {"id":"maximum-angle-and-draw","input_values":[180000000,999999],"input_length":2,"output_capacity":8,"expected_result":8,"expected_output_hex":"0100000000000000"},
    {"id":"negative-angle-is-invalid","input_values":[-1,0],"input_length":2,"output_capacity":8,"expected_result":-1,"expected_output_hex":""},
    {"id":"draw-outside-grid-is-invalid","input_values":[90000000,1000000],"input_length":2,"output_capacity":8,"expected_result":-1,"expected_output_hex":""}
  ]
}
