{
  "schema_version": 1,
  "id": "java-permutation-cipher-uppercase-whitespace-pad-x-v1",
  "algorithm": "permutation_cipher",
  "function_symbol": "permutation_cipher",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[ASCII text length, ASCII text bytes..., key length, one-based permutation positions...]",
    "text_length_range": [
      0,
      64
    ],
    "key_length_range": [
      1,
      8
    ],
    "maximum_input_length": 74
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "polynomial hash modulo 1,000,000,007 of encrypted ASCII bytes (h = h*257 + byte, initial h=0)",
