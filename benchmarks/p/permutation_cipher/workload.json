  },
  "source_bound": {
    "description": "Follows pinned Java encrypt: validate a one-based permutation; remove ASCII whitespace; uppercase ASCII lowercase; pad cleaned text with X to a full block; and emit each block in key order."
  },
  "measurement": {
    "comparison_model": "scalar_call",
    "sample_count": 6,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
