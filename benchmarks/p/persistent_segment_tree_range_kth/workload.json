{
  "schema_version": 1,
  "id": "persistent-prefix-histogram-range-kth-i64-array-scalar-v1",
  "algorithm": "persistent_segment_tree_range_kth",
  "function_symbol": "persistent_segment_tree_range_kth",
  "abi": "i64_array_scalar",
  "description": "Answer static inclusive range kth-smallest queries with path-copied prefix frequency trees.",
  "source": {
    "title": "Segment Tree: finding the k-th smallest number in a range",
    "authors": ["CP-Algorithms contributors"],
    "url": "https://cp-algorithms.com/data_structures/segment_tree.html",
    "license": "CC BY-SA 4.0; algorithm description only",
    "algorithm_attribution": "Build a persistent frequency-segment-tree root for every prefix and select by descending the count difference between two roots.",
    "implementation_status": "bounded clean-room persistent range-selection profile"
  },
  "contract": {
    "operation": "Return a weighted checksum of one-based kth-smallest values in inclusive zero-based subarray queries.",
    "input_encoding": "[N,Q,values[N],(L,R,K)*Q]",
    "dimension_ranges": {"N": [1, 32], "Q": [0, 32]},
    "value_range": [-1000, 1000],
    "range_convention": "inclusive zero-based endpoints",
    "rank_convention": "K is one-based and must be within the queried range length",
    "result_encoding": "sum((query_index+1)*kth_smallest_value)",
    "primary_method": "Coordinate-compressed persistent prefix frequency segment trees; descend the difference of roots R+1 and L.",
    "independent_method": "Sort each queried subarray directly and select position K-1.",
    "invalid_input_result": -9223372036854775808
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,values[N],(L,R,K)*Q]",
    "n_range": [1, 32],
    "q_range": [0, 32],
    "value_range": [-1000, 1000],
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_input_result": -9223372036854775808
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "weighted sum of selected values; zero when Q is zero",
    "result_range": [-528000, 528000],
    "invalid_input_result": -9223372036854775808
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "At most 193 persistent nodes; conservative cross-port fixed storage is 2960 bytes (two 32-element i64 buffers, 33 i32 roots, and three 193-element i32 node arrays); direct-input ports use less."
