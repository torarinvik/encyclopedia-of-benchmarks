{
  "schema_version": 1,
  "id": "period-of-pendulum-v1",
  "algorithm": "period_of_pendulum",
  "function_symbol": "period_of_pendulum",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "required_length": 1,
    "layout": ["length"],
    "length_minimum": 0,
