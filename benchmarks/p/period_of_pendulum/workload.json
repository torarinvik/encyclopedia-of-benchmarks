    {"id":"maximum-length","input_values":[1000],"input_length":1,"expected_result":63.44823283108564},
    {"id":"invalid-empty","input_values":[],"input_length":0,"expected_result":-1e300},
    {"id":"invalid-length","input_values":[1,2],"input_length":2,"expected_result":-1e300},
