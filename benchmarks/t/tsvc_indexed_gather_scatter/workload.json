    "operand_range": [-1000000, 1000000],
    "destination_range": [-9223372036854775808, 9223372036854775807],
    "exact_length": {"491": "2 + 5*n", "4113": "2 + 4*n"},
    "maximum_valid_input_length": 82,
    "output": "Final destination vector encoded as little-endian signed i64 values.",
    "output_capacity_requirement": "At least 8*n bytes.",
    "success_result": "Number of destination values written (n).",
