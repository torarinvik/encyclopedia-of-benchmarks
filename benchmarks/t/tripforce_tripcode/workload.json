  "contract": {
    "salt": "[password[1], password[2], 'H', '.']; clamp each byte outside '.'..'z' to '.', then add six to ':'..'@' and '['..'`'. DES_fcrypt consumes the first two bytes.",
    "des": "Each password byte becomes key byte (byte << 1); standard DES PC-1/PC-2 schedule and salt-modified E expansion; encrypt the all-zero block 25 times.",
    "salt_encoding": "Traditional DES crypt six-bit alphabet values, including OpenSSL DES_fcrypt's mapping of '@' to 11.",
    "attribution": "GPL-3.0 tripforce kernel semantics by microsounds; fixed candidate only, not a bruteforce workload or official tripforce throughput result."
  },
