  "input": {
    "kind": "signed_i64_array_two_left_hashing_trace",
    "layout": "[Q,(opcode,key,left_bucket,right_bucket)*Q]",
    "operation_count_range": [1, 40],
    "record_words": 4,
    "opcode": {"0": "insert", "1": "lookup", "2": "delete"},
    "key_range": [0, 63],
    "bucket_range": [0, 7],
    "same_key_bucket_rule": "Every occurrence of one key must use the same (left_bucket,right_bucket) pair.",
    "maximum_live_distinct_keys": 32,
    "maximum_valid_length": 161,
    "maximum_parseable_length": 162,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "live_table_overflow_result": -3
  },
  "algorithm_profile": {
    "table_model": "two separate arrays of eight separate-chaining buckets",
    "new_insert": "insert at the head of the shorter candidate chain; if chain lengths tie, choose the left table",
    "duplicate_insert": "return status 0 and do not change either chain",
    "lookup_and_delete": "search the left candidate chain before the right candidate chain",
    "capacity_overflow": "a new key when 32 distinct keys are live aborts the entire trace without output"
  },
  "output": {
    "kind": "raw_byte_vector",
    "layout": "two little-endian signed-i64 words (status,placement) per operation",
    "status_codes": {"0": "operation did not insert/find/delete", "1": "operation inserted/found/deleted"},
    "placement_codes": {"-1": "not a new insertion", "0": "new key placed in left table", "1": "new key placed in right table"},
    "maximum_bytes": 640,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "write_on_error": false
  },
  "workspace": {
    "bytes": 2048,
    "accounting": "Fixed storage for 16 bucket heads and lengths, 32 key/next-node entries, 40 staged status/placement pairs, validation of up to 40 records, and scalar control state."
