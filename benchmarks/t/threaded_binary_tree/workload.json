{
  "schema_version": 1,
  "id": "threaded-binary-tree-inorder-i32-v1",
  "algorithm": "threaded_binary_tree",
  "function_symbol": "threaded_binary_tree",
  "input": {
    "kind": "signed_64_bit_array",
    "encoding": "[node_count, insertion_key_0, ..., insertion_key_(node_count-1)]",
    "maximum_nodes": 128,
    "key_range": [
      -2147483648,
      2147483647
    ],
    "duplicate_policy": "equal keys are inserted into the right subtree and retained",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "bytes",
    "encoding": "inorder values as consecutive little-endian signed i32, no framing or NUL terminator",
    "success_result": "number of output bytes (4 * node_count)"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
