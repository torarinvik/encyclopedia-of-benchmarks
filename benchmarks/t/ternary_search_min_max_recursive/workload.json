{
  "schema_version": 1,
  "id": "ternary-search-min-max-recursive-i64-array-float64-v1",
  "algorithm": "ternary_search_min_max_recursive",
  "function_symbol": "ternary_search_min_max_recursive",
  "input": {
    "kind": "bounded_signed_i64_array",
    "exact_length": 4,
    "encoding": "[mode, start_milli, end_milli, precision_milli]",
    "mode_domain": {
      "0": "minimize x*x-2*x+3, center 1",
      "1": "maximize -x*x-2*x+3, center -1"
    },
    "endpoint_range": [
      -100000,
      100000
    ],
    "center_must_be_strictly_inside_interval": true,
    "precision_milli_range": [
      1,
      8
    ],
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "meaning": "binary32 f(start) promoted to binary64",
    "absolute_tolerance": 0.0001,
    "relative_tolerance": 0.0,
    "invalid_input_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "absolute_tolerance": 0.0001,
    "relative_tolerance": 0.0,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "minimum_source_wide_interval",
      "input_values": [
        0,
        -100000,
        100000,
        1
      ],
      "expected_result": 2.0
    },
    {
      "id": "minimum_source_precision_max",
      "input_values": [
        0,
        -100000,
        100000,
        8
      ],
      "expected_result": 2.000009536743164
    },
    {
      "id": "minimum_near_center",
      "input_values": [
        0,
        999,
        1001,
        1
      ],
      "expected_result": 2.0
    },
    {
      "id": "maximum_source_wide_interval",
      "input_values": [
        1,
        -100000,
        100000,
        1
      ],
      "expected_result": 4.0
    },
    {
      "id": "maximum_source_precision_max",
      "input_values": [
        1,
        -100000,
        100000,
        8
      ],
      "expected_result": 3.999976396560669
    },
    {
      "id": "maximum_near_center",
      "input_values": [
        1,
        -1001,
        -999,
        1
      ],
      "expected_result": 4.0
    },
    {
      "id": "invalid_mode",
      "input_values": [
        2,
        -100000,
        100000,
        1
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid_center_not_inside",
      "input_values": [
        0,
        1000,
        2000,
        1
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid_precision_zero",
      "input_values": [
        1,
        -100000,
        100000,
        0
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid_precision_above_bound",
      "input_values": [
        1,
        -100000,
        100000,
        9
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid_endpoint_above_bound",
      "input_values": [
        0,
        999,
        100001,
        1
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid_wrong_length",
      "input_values": [
        0,
        -100000,
        100000
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid_overlength",
      "input_values": [
        0,
        -100000,
        100000,
        1,
        0
      ],
      "expected_result": -1e+300
    }
  ]
}
