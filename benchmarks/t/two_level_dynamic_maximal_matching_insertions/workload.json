  "source": {
    "chapter": "Matching in Dynamic Graphs",
    "doi": "10.1007/978-1-4939-2864-4_567",
    "authors": ["Surender Baswana", "Manoj Gupta", "Sandeep Sen"],
    "profile": "Insertion-only realization of the chapter's 2-Level maximal matching algorithm; explicit random-rank tape; deletion handling omitted."
  },
  "contract": {
    "operation": "Maintain a maximal matching and two-level partition from an initially empty graph under edge insertions.",
    "input_layout": "[n,q,(u,v)[q],random_choice_count,random_ranks[random_choice_count]]",
    "threshold": "sqrt(n), restricted to n=4 or n=9",
    "tie_rule": "Promotion owner ties select lower ID; owned neighbors and free level-0 repair scan in ascending ID order.",
    "random_rule": "Each tape value selects the corresponding rank in the current ascending owned-neighbor list; the tape length must equal consumed choices.",
    "output_layout": "[n,level[0..n),partner[0..n)], little-endian signed 64-bit words; unmatched partner is -1.",
    "error_precedence": "Malformed frame/update/random tape returns -1 before output checks; null or short output returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 55,
    "maximum_parseable_length": 56,
    "vertex_count_values": [4,9],
    "maximum_insertions": 24,
    "maximum_random_choices": 4,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 19,
    "maximum_output_bytes": 152,
    "success_result": "8*(1+2*n) bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded insertion graph, level partition, matching, parsed update sequence, random tape, and staged output."
  },
  "measurement": {"sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 100},
