    "output": "Final A[n] followed by final C[n], each as little-endian signed i64 values.",
    "output_capacity_requirement": "At least 16*n bytes.",
    "success_result": "2*n values written.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "input_modified": false,
    "source_profile": "One ascending execution of the s261 loop body; repeated timing-loop state evolution is excluded."
  },
