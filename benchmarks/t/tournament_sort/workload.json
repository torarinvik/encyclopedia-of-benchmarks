{
  "schema_version": 1,
  "id": "tournament-sort-i64-array-bytes-v1",
  "algorithm": "tournament_sort",
  "function_symbol": "tournament_sort",
  "input": {
    "kind": "signed_i64_array",
    "layout": ["count", "values..."],
    "count_range": [0, 512],
    "value_range": [-2147483648, 2147483647],
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": ["count", "sorted_values..."],
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [0],
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "descending",
      "input_values": [6, 6, 5, 4, 3, 2, 1],
      "expected_result": 56,
      "expected_output_hex": "0600000000000000010000000000000002000000000000000300000000000000040000000000000005000000000000000600000000000000"
    },
    {
      "id": "duplicate_values",
      "input_values": [4, 42, 42, 42, 42],
      "expected_result": 40,
      "expected_output_hex": "04000000000000002a000000000000002a000000000000002a000000000000002a00000000000000"
    },
    {
      "id": "negative_values",
      "input_values": [5, -32, -54, -65, -12, -7],
      "expected_result": 48,
      "expected_output_hex": "0500000000000000bfffffffffffffffcaffffffffffffffe0fffffffffffffff4fffffffffffffff9ffffffffffffff"
    },
    {
      "id": "singleton_i32_min",
      "input_values": [1, -2147483648],
      "expected_result": 16,
      "expected_output_hex": "010000000000000000000080ffffffff"
    },
    {
      "id": "invalid_value_outside_i32",
      "input_values": [1, 2147483648],
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
