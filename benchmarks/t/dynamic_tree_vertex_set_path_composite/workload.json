  "contract": {
    "operation": "Maintain a tree whose vertices carry affine maps. Replace one edge by another, set one vertex map, or evaluate the ordered composition of vertex maps along a path.",
    "input_layout": "[N, Q, (a_i, b_i) for each vertex, (u_i, v_i) for each initial edge, then Q variable-width queries]",
    "n_range": [1, 8],
    "q_range": [1, 12],
    "modulus": 998244353,
    "initial_multiplier_and_update_multiplier_range": [1, 998244352],
    "addend_and_query_argument_range": [0, 998244352],
    "initial_tree": "The N-1 undirected edges form a simple tree.",
    "queries": {
      "0": "[0, u, v, w, x]: cut existing edge (u,v), then link (w,x); the graph remains a tree.",
      "1": "[1, p, c, d]: set vertex p's map to f_p(t)=c*t+d modulo MODULUS.",
      "2": "[2, u, v, x]: return f_v(...f_next(...f_u(x))) modulo MODULUS along the u-to-v vertex path."
    },
    "algorithm": "A Link-Cut Tree stores the affine composition in both auxiliary-path orientations. Reversal swaps child links and forward/reverse summaries; splay access supports edge cut/link, point map replacement, and ordered path evaluation in O(log N) amortized time per operation, using O(N) storage.",
    "output_layout": "One little-endian signed 64-bit residue for each type-2 query, in query order; update queries produce no output.",
    "error_precedence": "Malformed framing, values, initial trees, or edge-update traces that violate the tree promise return -1 before output checks. Valid input with null output or capacity below 8 times the number of path queries returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 92,
    "maximum_parseable_length": 93,
    "invalid_result": -1,
