    "exact_length": "2 + n*(n+1)/2 + n*n",
    "maximum_valid_input_length": 394,
    "output": "Final packed vector encoded as little-endian signed i64 values.",
    "output_capacity_requirement": "At least 8*n*(n+1)/2 bytes.",
    "success_result": "n*(n+1)/2 values written.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "input_modified": false
  },
  "input": {
