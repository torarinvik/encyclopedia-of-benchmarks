{
  "schema_version": 1,
  "id": "tree-random-walk-edge-hitting-cost-bounded-v1",
  "algorithm": "tree_random_walk_edge_hitting_cost",
  "function_symbol": "tree_random_walk_edge_hitting_cost",
  "abi": "i64_array_bytes_output",
  "source": {
    "method_reference": "https://oi-wiki.org/graph/tree-random-walk/",
    "reuse_scope": "Mathematical method only; contract, fixtures, references, and ports are clean-room."
  },
  "contract": {
    "profile": "Expected weighted traversal costs until first reaching the opposite endpoint, for every edge in a static tree.",
    "input_layout": "[n,root,(u,v,w)*(n-1)]",
    "vertex_count_range": [1, 16],
    "root_range": "0 <= root < n",
    "edge_weight_range": [1, 9],
    "tree_rule": "The n-1 records form a simple undirected tree; input record order and endpoint orientation are arbitrary.",
    "walk_rule": "At each vertex choose each adjacent vertex uniformly; traversing an edge adds its positive weight to accumulated cost.",
    "output_layout": "For each input edge (u,v,w), emit expected cost u-to-v then v-to-u as little-endian signed 64-bit integers.",
    "rooted_recurrence": "down[u]=sum(weights of all incident edges)+sum(down[child]); down[root] uses the same base. up[root]=0; up[child]=up[parent]+down[parent]-down[child].",
    "invalid_precedence": "Invalid or null input returns -1 before output checks; valid input with null or short output returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 47,
    "maximum_parseable_length": 48,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "maximum_bytes": 240,
    "size_formula": "16*(n-1)",
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_or_short_output_result": -2,
    "no_write_on_error": true,
    "empty_tree_output": "For n=1, the valid output length is zero bytes; null output still returns -2."
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "Conservative cap for all fixed graph, disjoint-set, traversal, recurrence, and output state."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 200
  },
  "cases": [
    {
