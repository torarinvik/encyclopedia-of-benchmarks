      "input_values": [1, 0],
      "input_length": 2,
      "output_capacity": 0,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "single-vertex-null-output",
      "input_values": [1, 0],
      "input_length": 2,
      "output_capacity": 0,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
