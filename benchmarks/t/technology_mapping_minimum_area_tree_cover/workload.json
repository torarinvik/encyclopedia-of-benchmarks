  "contract": {
    "algorithm": "Bottom-up dynamic programming over a subject tree; each node chooses the minimum-area matching library pattern plus optimal covers at the pattern cutpoints.",
    "pattern_ids": ["INV", "NAND2", "NAND2(INV,cut)", "NAND2(cut,INV)", "NAND2(INV,INV)"],
    "tie_breaking": "Lowest pattern ID wins equal-area ties.",
    "output_markers": {"primary_input": -1, "covered_inside_ancestor_pattern": -2},
    "profile_scope": "Exact area-optimal covering for the supplied ordered tree and five-pattern library; not DAGON's DAG partition approximation."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[minimum_area, pattern_id_for_each_subject_node]",
    "maximum_bytes": 256,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
