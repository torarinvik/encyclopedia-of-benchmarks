  "contract": {
    "operation": "For i=0..n-2 in ascending order, save old A[i+1], set A[i]=B[i]+C[i]*D[i], then B[i]=new_A[i]+D[i]*E[i], then overwrite A[i]=new_B[i]+old_A[i+1]*D[i].",
    "input_layout": "[n, A[n], B[n], C[n], D[n], E[n]]",
    "n_range": [2, 64],
    "value_range": [-2, 2],
    "exact_length": "1 + 5*n",
    "maximum_valid_input_length": 321,
    "output": "Final A[n] followed by final B[n], each as little-endian signed i64 values.",
    "output_capacity_requirement": "At least 16*n bytes.",
    "success_result": "2*n values written.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "input_modified": false,
    "source_profile": "One ascending execution of the s243 loop body; repeated timing-loop state evolution is excluded."
  },
  "input": {
    "kind": "bounded_signed_i64_array",
    "encoding": "n followed by five arrays A, B, C, D, and E, each of length n",
    "maximum_valid_length": 321,
    "maximum_parseable_length": 321,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "Final A[n], then final B[n].",
    "maximum_values": 128,
    "maximum_bytes": 1024
  },
  "workspace": {"bytes": 1024},
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "ordered-lookahead-and-overwrite",
      "input_values": [3, 1, 2, -1, 2, -1, 1, 1, 2, -2, -1, 1, 2, 1, -2, 1],
      "input_length": 16,
      "output_capacity": 48,
      "expected_result": 6,
      "expected_output_hex": "fefffffffffffffffeffffffffffffffffffffffffffff0000000000000000ffffffffffffffff0100000000000000"
    },
    {
      "id": "minimum-length-preserves-final-pair",
