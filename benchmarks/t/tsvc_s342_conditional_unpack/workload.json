    "n_range": [1, 64],
    "value_range": [-2, 2],
    "exact_length": "1 + 2*n",
    "maximum_valid_input_length": 129,
    "output": "Final A as little-endian signed i64 values.",
    "output_capacity_requirement": "At least 8*n bytes.",
    "success_result": "n values written.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "input_modified": false,
    "source_profile": "One execution of the s342 loop body. Repeated timing-loop state evolution is excluded."
  },
  "input": {
    "kind": "bounded_signed_i64_array",
    "encoding": "n, then destination/mask A and packed source B, each of length n",
    "maximum_valid_length": 129,
    "maximum_parseable_length": 129,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
