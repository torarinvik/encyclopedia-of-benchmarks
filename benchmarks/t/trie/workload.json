{
  "schema_version": 1,
  "id": "trie-i64-variable-word-operation-trace-v1",
  "algorithm": "trie",
  "function_symbol": "trie_benchmark",
  "input": {
    "kind": "packed_variable_width_opcode_word_records",
    "encoding": "[opcode, word_length, lowercase_ascii_character_codes...] repeated for each operation",
    "maximum_input_values": 1024,
    "maximum_operations": 512,
    "maximum_word_length": 128,
    "alphabet": "lowercase ASCII a-z",
    "opcodes": {
      "0": "insert word; result 1 if new, 0 if already present",
      "1": "delete word; result 1 if found, 0 otherwise",
      "2": "exact word membership; result 1 or 0",
      "3": "prefix presence; result 1 if one or more words have the prefix",
      "4": "number of words with the prefix, including an exact word match",
      "5": "total word count; word length must be zero"
    },
    "word_semantics": "set semantics; empty words are supported; empty prefix matches every stored word",
    "invalid_result": -1,
    "checksum": "weighted operation results plus the weighted sum of active-word polynomial hashes; all valid checksums are nonnegative and fit in signed 64-bit"
  },
