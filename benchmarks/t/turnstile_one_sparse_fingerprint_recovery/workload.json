    {"id": "minimum-i64-update-count", "input_values": [2,-9223372036854775808,2], "input_length": 3, "expected_result": -1},
    {"id": "maximum-i64-update-count", "input_values": [2,9223372036854775807,2], "input_length": 3, "expected_result": -1},
    {"id": "invalid-update-after-cancellation", "input_values": [2,3,2,0,1,0,-1,2,0], "input_length": 9, "expected_result": -1},
