{
  "schema_version": 1,
  "id": "turnstile-one-sparse-fingerprint-recovery-v1",
  "algorithm": "turnstile_one_sparse_fingerprint_recovery",
  "function_symbol": "turnstile_one_sparse_fingerprint_recovery",
  "input": {
    "kind": "packed_i64_array",
    "layout": "[N,Q,z,(index,delta)*Q]",
    "coordinate_range": [1, 64],
    "update_count_range": [0, 128],
    "delta_range": [-1000, 1000],
    "base_range": [1, 1000000006],
    "maximum_valid_values": 259,
    "maximum_parseable_values": 260,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed 64-bit integer",
    "meaning": "one plus the accepted candidate index, or zero when no candidate passes",
    "invalid_result": -1,
    "collision_semantics": "a multisparse vector may pass the fixed-base fingerprint"
  },
  "provenance": {
    "url": "https://dimacs.rutgers.edu/~graham/pubs/papers/l0journal.pdf",
    "reuse": "Independent implementation of the mathematical recovery primitive; no source or fixtures copied."
  },
  "measurement": {"comparison_model": "i64_array_scalar_call", "sample_count": 5,
                  "warmup_rounds": 1, "repetitions_per_sample": 100},
  "cases": [
    {"id": "empty", "input_values": [4,0,2], "input_length": 3, "expected_result": 0},
    {"id": "zero-index", "input_values": [4,1,2,0,5], "input_length": 5, "expected_result": 1},
    {"id": "negative-mass", "input_values": [4,1,3,2,-7], "input_length": 5, "expected_result": 3},
    {"id": "cancellation", "input_values": [4,3,2,1,7,3,4,1,-7], "input_length": 9, "expected_result": 4},
    {"id": "zero-mass", "input_values": [3,2,2,0,1,2,-1], "input_length": 7, "expected_result": 0},
    {"id": "nonintegral-index", "input_values": [3,2,2,0,1,1,1], "input_length": 7, "expected_result": 0},
    {"id": "fingerprint-rejects", "input_values": [3,2,2,0,1,2,1], "input_length": 7, "expected_result": 0},
    {"id": "base-one-collision", "input_values": [3,2,1,0,1,2,1], "input_length": 7, "expected_result": 2},
    {"id": "candidate-out-of-range", "input_values": [3,2,2,0,-1,2,2], "input_length": 7, "expected_result": 0},
    {"id": "invalid-index", "input_values": [2,1,2,2,1], "input_length": 5, "expected_result": -1},
    {"id": "invalid-delta", "input_values": [2,1,2,0,1001], "input_length": 5, "expected_result": -1},
