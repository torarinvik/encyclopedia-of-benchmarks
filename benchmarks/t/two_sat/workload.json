{
  "schema_version": 1,
  "id": "two-sat-signed-literals-v1",
  "algorithm": "two_sat",
  "function_symbol": "two_sat",
  "input": {
    "kind": "signed_2sat_clauses",
    "encoding": "[variable_count, clause_count, (literal_a, literal_b)*clause_count]",
    "variables": [
      0,
      40
    ],
    "clauses": [
      0,
      2047
    ],
    "literal_convention": "positive x denotes x; negative -x denotes not x; literals are nonzero and abs(literal)<=variable_count",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "encoding": "[satisfiable, assignment_for_variable_1, ...] for satisfiable formulas; [0] otherwise",
    "assignment_values": [
      0,
      1
    ],
    "result": "number of output bytes",
    "assignment_rule": "deterministic Kosaraju SCC component ordering; satisfying assignments are validated by clause evaluation"
  },
  "workspace": {
    "bytes": 512,
    "meaning": "bounded adjacency, transpose, DFS order, and component arrays"
  },
  "cases": [
    {
      "id": "empty_formula",
      "input_values": [
        3,
        0
      ],
      "input_length": 2,
      "expected_result": 4,
      "expected_output_hex": "01010101"
    },
    {
      "id": "zero_variables",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "forced_true",
      "input_values": [
        1,
        1,
        1,
        1
      ],
      "input_length": 4,
      "expected_result": 2,
      "expected_output_hex": "0101"
    },
    {
      "id": "forced_false",
      "input_values": [
        1,
        1,
        -1,
        -1
      ],
      "input_length": 4,
      "expected_result": 2,
      "expected_output_hex": "0100"
    },
    {
      "id": "satisfiable_cycle",
      "input_values": [
        2,
        2,
        1,
        2,
        -1,
        -2
      ],
      "input_length": 6,
      "expected_result": 3,
      "expected_output_hex": "010100"
    },
    {
      "id": "contradiction",
      "input_values": [
        1,
        2,
        1,
        1,
        -1,
        -1
      ],
      "input_length": 6,
      "expected_result": 1,
      "expected_output_hex": "00"
    },
    {
      "id": "tautology",
      "input_values": [
        2,
        2,
        1,
        -1,
        2,
        -2
      ],
      "input_length": 6,
      "expected_result": 3,
      "expected_output_hex": "010101"
    },
    {
      "id": "repeated_clauses",
      "input_values": [
        2,
        3,
        1,
        2,
        1,
        2,
        -1,
        2
      ],
      "input_length": 8,
      "expected_result": 3,
      "expected_output_hex": "010101"
    },
    {
      "id": "mixed_formula",
      "input_values": [
        3,
        4,
        1,
        2,
        -1,
        3,
        -2,
        -3,
        1,
        -3
      ],
      "input_length": 10,
      "expected_result": 4,
      "expected_output_hex": "01010001"
    },
    {
      "id": "invalid_zero_literal",
      "input_values": [
        2,
        1,
        0,
        1
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_out_of_range",
      "input_values": [
        2,
        1,
        1,
        3
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_wrong_length",
      "input_values": [
        2,
        1,
        1
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_negative_counts",
      "input_values": [
        -1,
        0
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "capacity_too_small",
      "input_values": [
        3,
        0
      ],
      "input_length": 2,
      "workspace_bytes": 3,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call"
  }
}
