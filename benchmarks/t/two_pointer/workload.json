{
  "schema_version": 1,
  "id": "two-pointer-sorted-two-sum-i64-scalar-v1",
  "algorithm": "two_pointer",
  "function_symbol": "two_pointer",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, target, sorted_value_0, ..., sorted_value_(n-1)]",
    "count_range": [0, 256],
    "value_range": [-2147483648, 2147483647],
    "requirement": "Values are non-decreasing. Return the first pair encountered by the inward two-pointer scan.",
    "invalid_input_result": -2,
    "no_pair_result": -1
  },
  "output": {"kind": "signed_64_bit_integer", "pair_encoding": "left_index * 256 + right_index", "no_pair_result": -1, "invalid_input_result": -2},
  "measurement": {"comparison_model": "i64_array_scalar_call", "sample_count": 7, "warmup_rounds": 2, "repetitions_per_sample": 100000},
  "cases": [
    {"id": "classic", "input_values": [4, 9, 2, 7, 11, 15], "expected_result": 1},
    {"id": "pair_at_ends", "input_values": [4, 17, 2, 7, 11, 15], "expected_result": 3},
    {"id": "duplicate_values", "input_values": [3, 6, 1, 3, 3], "expected_result": 258},
    {"id": "no_pair", "input_values": [4, 8, 2, 7, 11, 15], "expected_result": -1},
    {"id": "empty", "input_values": [0, 0], "expected_result": -1},
    {"id": "unsorted_invalid", "input_values": [3, 5, 4, 1, 3], "expected_result": -2}
  ]
}
