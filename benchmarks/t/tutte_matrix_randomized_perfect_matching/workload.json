  "algorithm": "tutte_matrix_randomized_perfect_matching",
  "function_symbol": "tutte_matrix_randomized_perfect_matching",
  "abi": "i64_array_bytes_output",
  "description": "Supplied-substitution replay of Mucha–Sankowski's Tutte-matrix perfect-matching extraction.",
  "source": {
    "chapter": "Encyclopedia of Algorithms, Chapter 225: Maximum Matching",
    "chapter_doi": "10.1007/978-1-4939-2864-4_225",
    "operational_reference": "Mucha and Sankowski, Maximum Matchings via Gaussian Elimination, §3 Algorithm 2",
    "operational_doi": "10.1109/FOCS.2004.40"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,(u,v,x)*m]",
    "vertex_range": [2, 8],
    "even_vertex_count_only": true,
    "maximum_edges": 28,
    "field": "F_65521",
    "substitution_range": [1, 65520],
    "edge_order": "strictly lexicographic by normalized endpoint pair u<v",
    "maximum_valid_length": 86,
    "maximum_parseable_length": 87,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[status,pair_count,u0,v0,...]",
    "status_one": "sampled matrix nonsingular and matching pairs follow",
    "status_zero": "sampled matrix singular; this is inconclusive for positive instances",
    "maximum_bytes": 80,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Bounded Tutte matrix, augmented inverse, active row and column sets, elimination scratch, and staged output."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 1,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
