    "output": "Final A[n] followed by complete final B[2*n], in little-endian signed i64.",
    "success_result": "3*n values written",
    "output_capacity_requirement": "At least 24*n bytes",
    "input_modified": false,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
