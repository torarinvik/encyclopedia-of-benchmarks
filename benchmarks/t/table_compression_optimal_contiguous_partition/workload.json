  "pinned_source": {
    "title": "Table Compression",
    "authors": ["Raffaele Giancarlo", "Adam L. Buchsbaum"],
    "doi": "10.1007/978-1-4939-2864-4_418",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_418",
    "summarized_original_work": "Buchsbaum, Fowler, and Giancarlo, 2003, contiguous partitioning for table compression",
    "license": "No source-code redistribution license asserted; clean-room implementation"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[rows,columns,cell00,cell01,...] in row-major order",
    "rows_range": [1, 8],
    "columns_range": [1, 8],
    "symbol_range": [0, 15],
    "maximum_valid_length": 66,
    "invalid_result": -1
  },
  "contract": {
    "problem": "Minimize the sum of compression costs over a partition into contiguous column intervals.",
    "recurrence": "E[0]=0; E[i]=min( E[j]+H_C(columns[j:i]) ) for 0<=j<i.",
    "compressor": "Flatten each interval's columns in row-major order; encode each maximal equal-byte run as a one-byte count followed by the one-byte symbol. Each interval cost is two bytes per run and has no header.",
    "tie_breaking": "For each prefix, consider starts j in increasing order and retain the first cut on equal cost.",
    "output_partition": "A cut-mask bit i-1 marks a boundary after the first i columns; output contains total cost, group count, and cut mask.",
    "source_relation": "Exact source recurrence for this explicit compressor-cost instantiation; not a claim about gzip/LZ/BWT partition optima."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[minimum_compressed_bytes,group_count,cut_mask]",
    "maximum_bytes": 24,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Fixed 8-column dynamic-programming arrays and staged 24-byte output."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
