{
  "schema_version": 1,
  "id": "tetrahedral-element-force-kernel-v1",
  "algorithm": "tetrahedral_element_force_kernel",
  "function_symbol": "tetrahedral_element_force_kernel",
  "abi": "i64_array_bytes_output",
  "description": "Compute exact scaled nodal force contributions for independent linear tetrahedral elements.",
  "source": {
    "title": "Facesim Add Forces kernel; linear isotropic elasticity",
    "authors": ["Christian Bienia et al.", "FEniCSx tutorial authors"],
    "url": "https://www.cs.princeton.edu/techreports/2010/890.pdf",
    "license": "algorithm description only",
    "license_note": "The PARSEC report motivates the tetrahedron-local force kernel. The stress law and finite-element formulas are identified with the FEniCSx and Physics-Based Simulation references. No source material is reproduced."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[M,lambda,mu, xyz[0..12*M-1]]; each element has four deformed 3D vertices in canonical reference-tetrahedron order",
    "element_count_range": [1, 32],
    "lame_parameter_range": [0, 16],
    "coordinate_range": [-4, 4],
    "exact_length": "3+12*M",
    "maximum_valid_length": 387,
    "maximum_parseable_length": 388,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "For each element and each of its four vertices, emit x/y/z components of six times the internal force.",
    "maximum_output_bytes": 3072,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Conservative per-call bound for fixed element matrices and force staging; the caller-owned output buffer is separate."
  },
  "algorithm_details": {
    "primary": "Build F from the three deformed edge columns, compute the isotropic small-strain stress, and multiply it by each reference shape-function gradient. The unit reference tetrahedron has volume 1/6, so six-times-force is integral.",
    "independent_oracle": "Differentiate the quadratic strain energy by exact central differences with a unit coordinate perturbation; for a quadratic function this recovers the exact gradient.",
    "complexity": "O(M) arithmetic operations and O(1) local scratch, apart from the caller-owned output buffer."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
