  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[capacity,refill_rate,request_count,elapsed_ticks[request_count]]",
    "capacity_range": [0, 64],
    "refill_rate_range": [0, 32],
    "request_count_range": [0, 63],
    "elapsed_ticks_range": [0, 256],
