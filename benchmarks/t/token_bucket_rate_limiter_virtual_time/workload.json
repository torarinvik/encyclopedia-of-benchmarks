  },
  "contract": {
    "initial_tokens": "capacity",
    "time_model": "each request record supplies nonnegative whole ticks elapsed since the previous request; the initial interval is measured from bucket creation",
    "refill": "before each request, add elapsed_ticks*refill_rate tokens and cap at capacity",
    "admission": "allow and consume one token iff the refilled balance is positive",
    "clock": "no wall-clock reads, sleeps, or concurrency",
    "null_input_result": -1
  },
  "complexity": {
    "primary": "O(request_count) arithmetic operations",
    "independent_reference": "O(sum(elapsed_ticks)) token-step operations",
    "space": "O(request_count) input and result state"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
