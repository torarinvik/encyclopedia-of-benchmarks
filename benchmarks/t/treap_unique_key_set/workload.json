  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation_count, (operation, key)*]",
    "operation_count_range": [
      0,
      128
    ],
    "operation_codes": {
      "0": "insert key",
      "1": "delete key"
    },
    "key_range": [
      -1000000,
      1000000
    ],
    "insert_must_target_absent_key": true,
    "delete_must_target_present_key": true,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "final keys in ascending order",
    "return_value": "number of keys written"
  },
