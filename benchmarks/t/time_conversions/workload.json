      "0": "seconds",
      "1": "minutes",
      "2": "hours",
      "3": "days",
      "4": "weeks",
      "5": "months",
      "6": "years"
    },
    "time_chart": [
      1.0,
      60.0,
      3600.0,
      86400.0,
      604800.0,
      2629800.0,
      31557600.0
    ],
    "time_chart_inverse": [
