      1.6534391534391535e-06,
      3.802570537683474e-07,
      3.168808781402895e-08
    ],
    "formula": "round((time_value * time_chart[from]) * time_chart_inverse[to], 3)",
    "rounding": "Python round(product, 3): nearest decimal 0.001, ties to even; implementations use a fused multiply-add residual to disambiguate exact scaled half-integers before rounding",
