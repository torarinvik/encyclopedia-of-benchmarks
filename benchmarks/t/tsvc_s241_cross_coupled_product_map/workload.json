  "contract": {
    "operation": "For i=0..n-2 in ascending order, save old A[i+1], set A[i]=B[i]*C[i]*D[i], then set B[i]=new_A[i]*old_A[i+1]*D[i]. Leave final A[n-1] and B[n-1] unchanged.",
    "input_layout": "[n, A[n], B[n], C[n], D[n]]",
    "n_range": [2, 64],
    "value_range": [-2, 2],
    "exact_length": "1 + 4*n",
    "maximum_valid_input_length": 257,
    "output": "Final A[n] followed by final B[n], each as little-endian signed i64 values.",
    "output_capacity_requirement": "At least 16*n bytes.",
    "success_result": "2*n values written.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "input_modified": false,
    "source_profile": "One ascending execution of the s241 loop body; repeated timing-loop state evolution is excluded."
  },
  "input": {
    "kind": "bounded_signed_i64_array",
    "encoding": "n followed by four arrays A, B, C, and D, each of length n",
    "maximum_valid_length": 257,
    "maximum_parseable_length": 257,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "Final A[n], then final B[n].",
    "maximum_values": 128,
    "maximum_bytes": 1024
  },
  "workspace": {"bytes": 1024},
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
