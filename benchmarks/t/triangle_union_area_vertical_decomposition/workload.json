    "scope": "Clean-room exact-rational adaptation of the triangle-union vertical-stripe method; no source code or prose is reproduced."
  },
  "contract": {
    "operation": "Exact area of the union of one to three nondegenerate triangles.",
    "input_layout": "[n,(x1,y1,x2,y2,x3,y3)*n]",
    "coordinate_domain": "Integer coordinates in [-1,1].",
    "degeneracy": "Each triangle must have three distinct, noncollinear vertices. Either winding is accepted; vertical sides are allowed.",
    "overlap_rules": "Overlapping and contained triangles, shared vertices and edges, coincident sides, and endpoint intersections are accepted. Coincident segment ties use stable input segment ID.",
    "method": "Create exact rational x-events at every vertex and side intersection. In each open stripe, merge each triangle's vertical interval at the midpoint and integrate each resulting trapezoid exactly.",
    "output": "Two little-endian signed 64-bit words: reduced nonnegative area numerator followed by positive denominator.",
    "exact_bounds": "Event x denominators divide 840; endpoint-height denominators divide 1680; area denominator is at most 2822400 and numerator at most 11289600. All rational intermediates are reduced.",
    "The straightforward bounded ports use O(S^4) worst-case work: O(S^2) candidate intersections, linear event deduplication and insertion sorting of O(S^2) events; stripe processing is lower order. S=3n<=9."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "triangle_count_range": [1,3],
    "coordinate_range": [-1,1],
    "maximum_valid_length": 19,
    "maximum_parseable_length": 20,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_pair",
    "encoding": "(reduced area numerator, positive denominator)",
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed storage for at most nine sides, 45 rational x events, stripe intervals, reduced rational temporaries, and the 16-byte output buffer."
  },
