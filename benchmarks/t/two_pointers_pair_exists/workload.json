    "ordering": "nondecreasing",
    "pair_indices_must_be_distinct": true,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar_boolean",
    "encoding": "1 iff some i<j has values[i]+values[j]=target, else 0",
    "maximum_encoded_result": 1
  },
  "measurement": {
