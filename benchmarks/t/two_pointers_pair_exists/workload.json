  "algorithm": "two_pointers_pair_exists",
  "function_symbol": "two_pointers_pair_exists",
  "input": {
    "kind": "signed_i64_array_packed_target_and_sorted_values",
    "encoding": "[target,n,value_0,...,value_(n-1)]",
    "exact_length": "n+2",
    "n_range": [
      0,
      256
