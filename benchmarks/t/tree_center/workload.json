{
  "schema_version": 1,
  "id": "william-fiset-tree-center-leaf-peeling-i64-array-bytes-output-v1",
  "algorithm": "tree_center",
  "function_symbol": "tree_center",
  "abi": "i64_array_bytes_output",
  "description": "Find one or two eccentricity-minimizing vertices in a bounded undirected tree by leaf-layer peeling.",
  "source": {
    "repository": "William Fiset Algorithms",
    "path": "src/main/java/com/williamfiset/algorithms/graphtheory/treealgorithms/TreeCenter.java",
    "url": "https://github.com/williamfiset/Algorithms/blob/master/src/main/java/com/williamfiset/algorithms/graphtheory/treealgorithms/TreeCenter.java",
    "license": "MIT",
    "reuse": "Algorithm idea only; clean-room ports, contract, references, and fixtures."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,(u,v)...]",
    "N_range": [1, 64],
    "edge_count": "N-1",
    "edge_semantics": "Undirected simple edge; all edges must form one connected tree.",
    "maximum_valid_length": 127,
    "maximum_parseable_length": 127,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "One or two ascending center vertex IDs as signed 64-bit little-endian values; the byte count identifies the number of centers.",
    "maximum_bytes": 16,
    "success_result": "number of bytes written: 8 for one center, 16 for two centers",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 16,
    "meaning": "Maximum output-buffer capacity. Fixed-size graph and traversal state is separate."
  },
  "contract": {
    "algorithm": "Remove all current degree-one vertices by layer until at most two active vertices remain.",
    "result": "The remaining vertex or adjacent pair, sorted by vertex ID.",
    "tree_validation": "Reject out-of-range endpoints, loops, repeated edges, cycles, disconnected graphs, and non-exact frames."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
