  "source_bound": {
    "description": "Default DATA_TYPE is double. Initialization sets alpha=1.5; A[i][j]=((i+j)%m)/m for j<i, A[i][i]=1, and B[i][j]=((n+i-j)%n)/n. For ascending i,j, kernel_trmm accumulates A[k][i]*B[k][j] for ascending k=i+1..m-1, then multiplies B[i][j] by alpha. The launcher selects M=2000,N=2600; this suite bounds each dimension to 1..8 and returns all B values numerically in row-major order instead of the source formatted dump.",
    "launcher_dataset": {
      "m": 2000,
      "n": 2600
    },
    "suite_bounds": {
      "m": [
        1,
        8
      ],
      "n": [
        1,
        8
      ]
    },
    "alpha": 1.5,
    "output_order": "complete B matrix row-major"
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[m,n] as exactly integral binary64 dimensions",
    "input_length": 2,
    "dimension_ranges": {
      "m": [
        1,
        8
      ],
      "n": [
        1,
        8
      ]
    },
    "maximum_input_length": 2,
    "invalid_input_result": -1
  },
  "contract": {
    "operation": "Return initialized B after source-ordered triangular matrix multiplication update.",
    "source_order": [
      "initialize A then B in row-major order",
      "for i ascending, then j ascending, accumulate k=i+1..m-1 ascending into B[i][j]",
      "multiply B[i][j] by alpha after its accumulation",
      "return the complete matrix row-major"
    ],
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "output": {
    "kind": "float64_matrix",
    "encoding": "m*n binary64 values of B in row-major order",
    "maximum_elements": 64,
    "success_result": "m*n output elements",
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "no_write_on_error": true,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "workspace": {
    "elements": 128,
    "meaning": "A and B are each at most 8x8 binary64 matrices; returned B contains at most 64 elements."
  },
