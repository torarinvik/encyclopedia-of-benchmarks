  "contract": {
    "algorithm": "Repeatedly eliminate an active vertex minimizing missing edges among its active neighbors, fill that neighborhood into a clique, and remove the vertex.",
    "tie_breaking": "Choose the smallest vertex ID among equal fill counts; record new fill edges in ascending-neighbor pair order.",
    "reported_width": "Maximum active degree at elimination time; an upper bound, not an exact treewidth claim.",
    "profile_scope": "The source-described minimum-fill heuristic only; exact treewidth recognition is outside this package."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[width,elimination_order...,fill_edge_count,u0,v0,...]",
    "maximum_bytes": 2064,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed 16 by 16 adjacency state, active vertices, 120 fill-edge pairs, and staged maximum output."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
