  "algorithm": "tree_234",
  "function_symbol": "tree_234",
  "description": "Bounded public insert/remove operation trace and final in-order traversal for the pinned C++ 2-3-4 tree.",
  "pinned_sources": [
    {
      "repository": "TheAlgorithms/C-Plus-Plus",
      "commit": "fdcc29b0ac2848e9d1a8d926e171cc5b39f97759",
      "path": "data_structures/tree_234.cpp",
      "symbol": "Tree234",
