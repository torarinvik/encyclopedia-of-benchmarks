{
  "schema_version": 1,
  "id": "tuned-boyer-moore-all-occurrences-i64-array-bytes-v1",
  "algorithm": "tuned_boyer_moore_search",
  "function_symbol": "tuned_boyer_moore_search",
  "abi": "i64_array_bytes_output",
  "description": "Return all overlapping byte-pattern occurrences with Tuned Boyer–Moore's sentinel skip loop.",
  "source": {
    "title": "Fast String Searching",
    "authors": ["Andrew Hume", "Daniel Sunday"],
    "publisher": "Software: Practice and Experience",
    "volume": 21,
    "issue": 11,
    "year": 1991,
    "pages": "1221–1248",
    "reference_url": "https://doi.org/10.1002/spe.4380211105",
    "algorithm_description_url": "https://igm.univ-mlv.fr/~lecroq/string/tunedbm.html",
    "preprocessing_description_url": "https://igm.univ-mlv.fr/~lecroq/string/node14.html",
    "implementation_status": "bounded clean-room Tuned Boyer–Moore profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, pattern_length, text_bytes..., pattern_bytes...]",
    "text_length_range": [0, 255],
    "pattern_length_range": [1, 64],
    "element_range": [0, 127],
    "maximum_valid_length": 321,
    "maximum_parseable_length": 322,
    "exact_frame_rule": "The length is exactly 2 + text_length + pattern_length.",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "All zero-based matching start positions in increasing order as little-endian signed 64-bit integers; overlapping matches are included.",
    "maximum_match_count": 255,
    "maximum_bytes": 2040,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "nonnull_output_required_for_empty_result": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "128-entry shift table, 319-byte maximum sentinel-extended text, bounded match-position storage; caller output is separate."
  },
  "contract": {
    "preprocessing": "Initialize each byte shift to pattern_length; for pattern indices 0 through pattern_length-2, set shift[pattern[i]] = pattern_length-i-1. Save shift[pattern[last]], then set that table entry to zero.",
    "sentinel": "Append exactly pattern_length copies of the final pattern byte in bounded scratch storage; this ends the skip scan without reading outside the scratch buffer.",
    "search_loop": "While alignment < text_length, probe the aligned final text byte. While its table shift is nonzero, apply three successive table-driven advances, probing again after each advance. At a zero entry, compare pattern indices 0 through pattern_length-2 with the candidate window, report the alignment if those bytes match and alignment < text_length, then advance by the saved final-byte shift.",
    "pattern_longer_than_text": "Valid input with no matches; skip the sentinel scan when pattern_length > text_length.",
    "empty_pattern": "Invalid; pattern length must be 1..64.",
    "result": "Collect all matching alignments, then serialize positions as little-endian signed i64 values.",
    "error_precedence": "Validate input pointer, exact frame, lengths, and byte domain and complete searching before validating output pointer/capacity.",
    "no_write_on_error": true,
    "bounds": "At most 255 match positions and 2,040 output bytes."
  },
  "complexity": {
    "preprocessing_time": "O(pattern_length + 128)",
    "search_time": "O(text_length * pattern_length) worst case, plus O(match_count) output serialization.",
    "space": "O(128 + text_length + pattern_length + match_count), bounded by this profile."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1,
    "profiles": [
      {"id": "three-blind-shifts-before-candidate", "input_values": [10, 3, 120, 120, 98, 97, 97, 98, 99, 97, 98, 99, 97, 98, 99], "output_bytes": 16},
      {"id": "overlapping-repeated-pattern", "input_values": [5, 3, 97, 97, 97, 97, 97, 97, 97, 97], "output_bytes": 24},
      {"id": "empty-result", "input_values": [6, 2, 97, 98, 99, 100, 101, 102, 103, 104], "output_bytes": 0}
    ]
  },
  "cases": [
    {"id":"three-blind-shifts-before-candidate","input_values":[10,3,120,120,98,97,97,98,99,97,98,99,97,98,99],"input_length":15,"output_capacity":16,"expected_result":16,"expected_output_hex":"04000000000000000700000000000000"},
    {"id":"overlapping-repeated-pattern","input_values":[5,3,97,97,97,97,97,97,97,97],"input_length":10,"output_capacity":24,"expected_result":24,"expected_output_hex":"000000000000000001000000000000000200000000000000"},
    {"id":"one-byte-pattern","input_values":[3,1,97,98,97,97],"input_length":6,"output_capacity":16,"expected_result":16,"expected_output_hex":"00000000000000000200000000000000"},
    {"id":"candidate-prefix-mismatch","input_values":[3,3,120,98,99,97,98,99],"input_length":8,"output_capacity":0,"expected_result":0,"expected_output_hex":""},
    {"id":"embedded-nul-byte","input_values":[4,2,0,65,0,65,0,65],"input_length":8,"output_capacity":16,"expected_result":16,"expected_output_hex":"00000000000000000200000000000000"},
    {"id":"highest-ascii-byte","input_values":[3,1,127,65,127,127],"input_length":6,"output_capacity":16,"expected_result":16,"expected_output_hex":"00000000000000000200000000000000"},
    {"id":"no-match","input_values":[6,2,97,98,99,100,101,102,103,104],"input_length":10,"output_capacity":0,"expected_result":0,"expected_output_hex":""},
    {"id":"empty-text","input_values":[0,1,97],"input_length":3,"output_capacity":0,"expected_result":0,"expected_output_hex":""},
