    {"id":"null-output-with-empty-result","input_values":[6,2,97,98,99,100,101,102,103,104],"input_length":10,"output_capacity":0,"output_is_null":true,"expected_result":-2,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[3,1,97,98,97,97],"input_length":6,"output_capacity":15,"expected_result":-2,"expected_output_hex":""},
    {"id":"invalid-input-before-output-error","input_values":[0,0],"input_length":2,"output_capacity":0,"output_is_null":true,"expected_result":-1,"expected_output_hex":""}
  ]
}
