  "contract": {
    "operation": "Recognize treewidth at most two and return a tree-decomposition certificate.",
    "input_layout": "[N,M,u0,v0,...]",
    "input_vertex_ids": "Zero-based; each undirected edge is encoded once with u0 < v0.",
    "simple_graph": true,
    "recognition_algorithm": "Repeatedly eliminate the smallest-ID active vertex with degree at most two, filling its active neighborhood into a clique; reject if no such vertex remains.",
    "certificate": "One bag per eliminated vertex plus an empty root bag; connect each bag to the earliest-eliminated later neighbor's bag, or to the empty root if it has no later neighbor.",
    "output_layout": "Little-endian signed i64 words [K,2,N, then K fixed four-word bag records (size and three padded vertex IDs), then N child/parent pairs].",
    "bag_ids": "Zero-based; bag N is the empty root; unused vertex slots are -1.",
    "reported_width": 2,
    "local_bounds": "1 <= N <= 32 and 0 <= M <= 64; the official task allows N,M up to 500000.",
    "error_precedence": "Malformed frames and graphs, and graphs rejected by degree-two elimination, return -1 before output checks. Valid width-two input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,u0,v0,...]",
    "vertex_count_range": [1, 32],
    "maximum_edge_count": 64,
    "edge_rule": "0 <= u0 < v0 < N, no repeated unordered edge.",
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "maximum_bytes": 1592,
    "size_formula": "8*(6*N+7)",
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 1592,
    "meaning": "Maximum staged certificate output; adjacency and elimination arrays are statically bounded by N<=32."
  },
