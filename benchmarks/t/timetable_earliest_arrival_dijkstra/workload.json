  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,arc_count,source,target,start_time,(u,v,trip_count,(departure,arrival)*)*]",
    "station_count_range": [2, 8],
    "directed_arc_count_range": [0, 12],
    "trip_count_per_arc_range": [1, 4],
    "start_time_range": [0, 1000],
