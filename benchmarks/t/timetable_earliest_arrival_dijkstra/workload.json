  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded station, arc-schedule, Dijkstra-state, and path storage."
  },
  "contract": {
    "edge_arrival_function": "For arrival time t at u, select the first scheduled departure on (u,v) with departure >= t and use its listed arrival; no eligible trip means that arc cannot be traversed.",
    "fifo_requirement": "Each arc's departures strictly increase and arrivals are nondecreasing; every arrival is strictly later than its departure.",
    "transfer_time": "Zero at every station.",
    "station_settlement_tie": "Choose the unsettled reachable station with minimum (earliest_arrival, station_id).",
    "parent_tie": "Among predecessors that offer the same earliest arrival, retain the smallest predecessor station ID.",
    "source_equals_target": "Return the zero-edge path [source] with arrival=start_time.",
    "duplicate_arcs": "Invalid; each ordered station pair occurs at most once."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary oracle runs time-dependent Dijkstra. The independent verifier exhaustively enumerates simple station paths, computes earliest arrival per station, and recovers the smallest-predecessor tie rule from those arrival labels.",
