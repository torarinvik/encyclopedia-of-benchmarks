{
  "schema_version": 1,
  "id": "recursive-l-tromino-tiling-java-v1",
  "algorithm": "tiling_problem",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[board_size, missing_row, missing_column]",
    "board_size_range": [
      1,
      16
    ],
    "board_size_requirement": "power of two",
    "coordinate_range": "0..board_size-1",
    "maximum_input_values": 3,
    "invalid_result": -1
  },
  "output": {
    "kind": "row_major_signed_32_little_endian_matrix",
    "encoding": "one i32 tile label per cell; missing cell is 0",
    "successful_result": "number of output bytes written",
    "insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "size_one",
      "input_values": [
        1,
        0,
        0
      ],
      "expected_result": 4,
      "expected_output_hex": "00000000"
    },
    {
      "id": "size_two_hole_top_left",
      "input_values": [
        2,
        0,
        0
      ],
      "expected_result": 16,
      "expected_output_hex": "00000000010000000100000001000000"
    },
    {
      "id": "size_four_hole_bottom_right",
      "input_values": [
        4,
        3,
        3
      ],
      "expected_result": 64,
      "expected_output_hex": "02000000020000000300000003000000020000000100000001000000030000000400000001000000050000000500000004000000040000000500000000000000"
    },
    {
      "id": "invalid_size",
      "input_values": [
        3,
        0,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "out_of_range_hole",
      "input_values": [
        4,
        4,
        0
      ],
      "expected_result": -1
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "repetitions_per_sample": 10000,
    "warmup_rounds": 2,
    "sample_count": 7
  }
}
