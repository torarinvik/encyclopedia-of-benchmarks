{
  "schema_version": 1,
  "id": "triangle-centers-bounded-points-v1",
  "algorithm": "triangle",
  "function_symbol": "triangle",
  "input": {
    "kind": "six_signed_64_bit_vertex_coordinates",
    "layout": "[x1,y1,x2,y2,x3,y3]",
    "coordinate_range": [
      -100,
      100
    ],
    "validity": "three noncollinear vertices with pairwise distinct x coordinates and y3 different from y1 and y2; these constraints keep the pinned source slope and orthocenter divisions finite",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "float64_vector",
    "order": [
      "circumcenter_x",
      "circumcenter_y",
      "incenter_x",
      "incenter_y",
      "orthocenter_x",
      "orthocenter_y"
    ],
    "encoding": "six IEEE-754 binary64 little-endian values",
    "max_length": 6,
    "maximum_output_bytes": 48,
    "relative_tolerance": 1e-10,
    "absolute_tolerance": 1e-10
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "relative_tolerance": 1e-10,
    "absolute_tolerance": 1e-10,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "symmetric_triangle",
      "input_values": [
        0,
        0,
        4,
        0,
        2,
        3
      ],
      "input_length": 6,
      "workspace_bytes": 48,
      "expected_result": 48,
      "expected_output": [
        2.0,
        0.8333333333333334,
        2.0,
        1.0703675169759927,
        2.0,
        1.3333333333333333
      ]
    },
    {
      "id": "pinned_documentation_triangle",
      "input_values": [
        -1,
        0,
        1,
        0,
        0,
        1
      ],
      "input_length": 6,
      "workspace_bytes": 48,
      "expected_result": 48,
      "expected_output": [
        0.0,
        -0.0,
        0.0,
        0.4142135623730951,
        -0.0,
        1.0
      ]
    },
    {
      "id": "scalene_triangle",
      "input_values": [
        1,
        2,
        5,
        1,
        3,
        6
      ],
      "input_length": 6,
      "workspace_bytes": 48,
      "expected_result": 48,
      "expected_output": [
        3.4444444444444446,
        3.2777777777777777,
        2.8693845047401725,
        2.859795217255061,
        2.111111111111111,
        2.4444444444444446
      ]
    },
    {
      "id": "wrong_input_length",
      "input_values": [
        0,
        0,
        2,
        0,
        1
      ],
      "input_length": 5,
      "workspace_bytes": 48,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "coordinate_out_of_range",
      "input_values": [
        0,
        0,
        101,
        1,
        2,
        3
      ],
      "input_length": 6,
      "workspace_bytes": 48,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "duplicate_x_coordinate",
      "input_values": [
        0,
        0,
        2,
        1,
        2,
        3
      ],
      "input_length": 6,
      "workspace_bytes": 48,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "collinear_points",
      "input_values": [
        0,
        0,
        2,
        1,
        4,
        2
      ],
      "input_length": 6,
      "workspace_bytes": 48,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "zero_altitude_slope_denominator",
      "input_values": [
        0,
        0,
        4,
        2,
        2,
        0
      ],
      "input_length": 6,
      "workspace_bytes": 48,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "insufficient_output_capacity",
      "input_values": [
        0,
        0,
        4,
        0,
        2,
        3
      ],
      "input_length": 6,
      "workspace_bytes": 24,
      "expected_result": -2,
