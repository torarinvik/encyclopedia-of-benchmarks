{
  "id": "three-sum-closest-v1",
  "algorithm": "three_sum_closest",
  "contract": {
    "input": "A packed array [target, count, values...]. Target and values are signed 32-bit integers; count is from 3 through 512; the packed length must be count + 2.",
    "output": "The sum of three distinct positions whose sum is closest to target. Equal-distance sums resolve to the lower sum.",
    "invalid_input_result": -9000000000000000000,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 20
  },
  "cases": [
    {
      "id": "classic-example",
      "input_values": [
        1,
        4,
        -1,
        2,
        1,
        -4
      ],
      "input_length": 6,
      "expected_result": 2
    },
    {
      "id": "exact-target",
      "input_values": [
        6,
        3,
        1,
        2,
        3
      ],
      "input_length": 5,
      "expected_result": 6
    },
    {
      "id": "equal-distance-chooses-lower-sum",
      "input_values": [
        0,
        4,
        -2,
        -1,
        1,
        2
      ],
      "input_length": 6,
      "expected_result": -1
    },
    {
      "id": "all-negative-values",
      "input_values": [
        1,
        4,
        -1,
        -2,
        -3,
        -4
      ],
      "input_length": 6,
      "expected_result": -6
    },
    {
      "id": "duplicate-values",
      "input_values": [
        1,
        4,
        1,
        1,
        1,
        0
      ],
      "input_length": 6,
      "expected_result": 2
