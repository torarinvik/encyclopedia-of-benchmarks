  "contract": {
    "operation": "Initialize k=1; for columns i=0..n-1 and rows j=1..n-1, assign B[j,i]=B[j-1,i]+coefficients[k-1]*C[j,i], increment k after each row, then increment k once after each column.",
    "input_layout": "[n, row_major_coefficients[n*n], row_major_C[n*n], row_major_B[n*n]]",
    "n_range": [2, 6],
    "matrix_value_range": [-100, 100],
    "exact_length": "1 + 3*n*n",
    "coefficient_index_mapping": "For column i and row j>=1, source k-1 is i*n+j-1; coefficient i*n+n-1 is skipped at the end of each column block.",
    "arithmetic": "Matrices encode integer-valued source doubles; all bounded products and sums remain exact in binary64 and fit signed i64.",
    "passes": 1,
    "output": "Complete final B matrix in row-major little-endian signed i64.",
    "success_result": "n*n values written",
    "output_capacity_requirement": "At least 8*n*n bytes",
    "input_modified": false,
