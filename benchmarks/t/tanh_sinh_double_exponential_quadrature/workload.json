  "contract": {
    "operation": "Approximate the integral on [-1,1] using the finite Takahasi–Mori tanh-sinh transformed trapezoidal sum.",
    "input_encoding": "[function_id,p]",
    "function_table": {
      "0": "f(x)=1; exact integral 2",
      "1": "f(x)=x^2; exact integral 2/3",
      "2": "f(x)=1/sqrt(1-x^2); exact integral pi",
      "3": "f(x)=1/sqrt(1-x); exact integral 2*sqrt(2)"
    },
    "p_range": "integer p in 2..=4",
    "step_and_cutoff": "h=2^-p, K=3*2^p; sum j=-K..K, so |t|<=3",
    "transformation": "t=j*h; u=(pi/2)*sinh(t); x=tanh(u); phi'(t)=(pi/2)*cosh(t)/cosh(u)^2",
    "stable_evaluation": "q=exp(-2*abs(u)); x=sign(u)*(1-q)/(1+q); sech(u)^2=4*q/(1+q)^2. For callback 2 use 1/sqrt(sech(u)^2); for callback 3 use 1/sqrt(2*q/(1+q)) when u>=0 and 1/sqrt(2/(1+q)) otherwise.",
    "operation_order": "Visit j in ascending order. Evaluate exp(t), exp(-t), sinh(t)=(exp(t)-exp(-t))*0.5, cosh(t)=(exp(t)+exp(-t))*0.5, u, q, 1+q, sech squared, x, Jacobian, callback value, callback*Jacobian, h*term, then add left-to-right. Do not reassociate or use fast-math.",
    "bounded_arithmetic": "|t|<=3, |u|<16, exp arguments are bounded, q is positive and representable, transformed callback terms are finite; no non-finite fallback is part of the valid domain.",
    "output_encoding": "One float64 finite quadrature estimate",
    "error_precedence": "Malformed or null input returns -1 before output validation; valid input with null output or capacity below one returns -2 without writes.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
