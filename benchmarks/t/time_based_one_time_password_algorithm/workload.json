  "contract": {
    "input_layout": "[key_length, key_byte_0, ..., key_byte_(key_length-1), unix_seconds]",
    "key_length_range": [16, 64],
    "key_byte_range": [0, 255],
    "unix_seconds_range": [0, 9223372036854775807],
    "time_step_seconds": 30,
    "time_origin_seconds": 0,
    "moving_factor": "floor(unix_seconds / 30), encoded as an unsigned 8-byte big-endian counter",
    "digest": "HMAC-SHA-1",
    "truncation": "RFC 4226 §5.3 dynamic truncation to a nonnegative 31-bit integer, then modulo 1000000",
    "output": "Exactly six ASCII decimal bytes, including leading zeroes; no NUL terminator.",
    "excluded_behavior": "No wall-clock read, drift window, validation, resynchronization, secret provisioning, URI parsing, or alternative digest/digit count.",
    "invalid_input_result": -1,
    "null_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "bytes",
    "maximum_bytes": 6,
    "success_bytes": 6,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "A conservative fixed workspace ceiling. The core arrays total 494 bytes: 64-byte normalized key, 64-byte SHA-1 block, 20-byte digest staging reused between HMAC passes, five 32-bit chaining words, one 80-word SHA-1 schedule, and six-byte output staging. Some ports pass a fixed 64-byte block by value, raising simultaneous array storage to at most 558 bytes; the ceiling leaves room for bounded scalar/index state. Caller-owned input/output are excluded."
  },
  "complexity": {
    "primary_time": "Four SHA-1 block compressions, each with 80 rounds; key normalization and output conversion are constant bounded work.",
    "primary_auxiliary_space": "At most 494 fixed bytes of scratch, excluding ABI input/output.",
    "independent_reference_time": "Four 80-round SHA-1 compressions plus fixed-size HMAC and decimal-output work.",
    "independent_reference_auxiliary_space": "Fixed arrays for one message block, one schedule, normalized key, chaining words, and digest state."
  },
  "oracle": "benchmarks/t/time_based_one_time_password_algorithm/primary_oracle.py",
  "independent_oracle": "benchmarks/t/time_based_one_time_password_algorithm/independent_oracle.py",
