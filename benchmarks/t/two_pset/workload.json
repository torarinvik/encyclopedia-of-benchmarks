{
  "schema_version": 1,
  "id": "two-pset-two-replica-state-digest-v1",
  "algorithm": "two_pset",
  "function_symbol": "two_pset",
  "input": {
    "kind": "signed_i64_array_packed_two_pset_operations",
    "encoding": "[q, (opcode, set_id, value, other_set_id) repeated q times]",
    "opcodes": {
      "0": "add",
      "1": "remove",
      "2": "lookup",
      "3": "directional compare",
      "4": "merge and assign returned set to target"
    },
    "operation_count_range": [0, 256],
    "length_range": [1, 1025],
    "set_id_range": [0, 1],
    "other_set_id_range": [0, 1],
    "element_range": [0, 63],
    "invalid_result": -1,
    "output": "rolling digest of per-operation opcode/results followed by replica additions/tombstones membership bits"
  },
  "cases": [
    {
      "id": "no_operations",
      "input_values": [0],
      "input_length": 1,
      "expected_result": 0
    },
    {
      "id": "absent_remove_then_add",
      "input_values": [3, 1, 0, 7, 0, 0, 0, 7, 0, 2, 0, 7, 0],
      "input_length": 13,
      "expected_result": 443139960
    },
    {
      "id": "tombstoned_add_does_not_resurrect",
      "input_values": [4, 0, 0, 3, 0, 1, 0, 3, 0, 0, 0, 3, 0, 2, 0, 3, 0],
      "input_length": 17,
      "expected_result": 627195391
    },
    {
      "id": "directional_compare",
      "input_values": [6, 0, 0, 1, 0, 0, 0, 2, 0, 1, 0, 1, 0, 0, 1, 2, 0, 3, 0, 0, 1, 3, 1, 0, 0],
      "input_length": 25,
      "expected_result": 764632094
    },
    {
      "id": "merge_union_and_preserves_other",
      "input_values": [10, 0, 0, 3, 0, 1, 0, 3, 0, 0, 1, 4, 0, 4, 0, 0, 1, 2, 0, 3, 0, 2, 0, 4, 0, 2, 1, 3, 0, 2, 1, 4, 0, 3, 1, 0, 0, 3, 0, 0, 1],
      "input_length": 41,
      "expected_result": 105160919
    },
    {
      "id": "self_compare_and_merge",
      "input_values": [5, 0, 0, 0, 0, 3, 0, 0, 0, 0, 1, 63, 0, 4, 1, 0, 1, 2, 1, 63, 0],
      "input_length": 21,
      "expected_result": 896114056
    },
    {
      "id": "element_boundaries",
      "input_values": [4, 0, 0, 0, 0, 0, 1, 63, 0, 2, 0, 0, 0, 2, 1, 63, 0],
      "input_length": 17,
      "expected_result": 652098803
    },
    {
      "id": "unknown_opcode",
      "input_values": [1, 5, 0, 0, 0],
      "input_length": 5,
      "expected_result": -1
    },
    {
      "id": "invalid_set_id",
      "input_values": [1, 0, 2, 7, 0],
      "input_length": 5,
      "expected_result": -1
    },
    {
      "id": "element_above_bound",
      "input_values": [1, 0, 0, 64, 0],
      "input_length": 5,
      "expected_result": -1
    },
    {
      "id": "unexpected_other_id_for_add",
      "input_values": [1, 0, 0, 7, 1],
      "input_length": 5,
      "expected_result": -1
    },
    {
      "id": "nonzero_compare_dummy",
      "input_values": [1, 3, 0, 1, 1],
      "input_length": 5,
      "expected_result": -1
    },
    {
      "id": "other_id_above_bound",
      "input_values": [1, 3, 0, 0, 2],
      "input_length": 5,
      "expected_result": -1
    },
    {
      "id": "missing_operation_field",
      "input_values": [1, 0, 0, 7],
