{
  "schema_version": 1,
  "id": "oi-wiki-tree-path-distinct-mo-bounded-i64-array-bytes-output-v1",
  "algorithm": "tree_path_distinct_mo",
  "function_symbol": "tree_path_distinct_mo",
  "abi": "i64_array_bytes_output",
  "description": "Answer static distinct-color queries on tree paths by doubled-Euler-tour Mo ordering and LCA correction.",
  "source": {
    "repository": "OI Wiki",
    "license": "OI Wiki non-code documentation is CC BY-SA 4.0 plus SATA; only the algorithm idea is used, with no licensed expression reused",
    "task_url": "https://oi-wiki.org/misc/mo-algo-on-tree/",
    "reference_algorithm": "Toggle vertices in a doubled Euler interval; temporarily include an omitted lowest common ancestor.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,colors[n],(edge_u,edge_v)*(n-1),(query_u,query_v)*q]",
    "n_range": [1, 32],
    "q_range": [0, 32],
    "color_range": "any signed 64-bit integer",
    "edge_rule": "The n-1 edge records must form a simple undirected tree with zero-based vertices.",
    "query_rule": "Each endpoint is in [0,n); queries are static and may repeat.",
    "maximum_valid_length": 160,
    "maximum_parseable_length": 161,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "encoding": "One distinct-color count per query, in input order.",
    "maximum_bytes": 256,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "Conservative cap for fixed graph, Euler, DSU, query, color, and answer state plus output storage; output itself is at most 256 bytes."
  },
  "contract": {
    "algorithm": "Build an entry/exit Euler sequence, map each path query to an interval, order intervals by alternating Mo blocks, toggle vertex activity while moving the window, and account for a missing LCA when recording an answer.",
    "complexity": "Dense bounded tree preprocessing and parent-climb LCA take O(n^2+qn); query sorting takes O(q log q), and square-root Mo ordering bounds window movement by O((n+q)*sqrt(n)). Storage is O(n^2+q).",
    "official_query_count": 0,
    "local_limits_are_not_official_scale": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "branching-tree-ancestor-and-nonancestor-queries",
      "input_values": [5, 4, 1, 2, 1, 3, 2, 0, 1, 1, 2, 1, 3, 3, 4, 2, 4, 0, 2, 1, 3, 4, 4],
      "input_length": 23,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0300000000000000020000000000000002000000000000000100000000000000"
    },
    {
      "id": "repeated-colors-and-overlapping-paths",
      "input_values": [4, 2, 9, 9, 10, 9, 0, 1, 1, 2, 1, 3, 0, 3, 2, 3],
      "input_length": 16,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "01000000000000000200000000000000"
    },
    {
      "id": "signed-extreme-colors",
      "input_values": [2, 1, -9223372036854775808, 9223372036854775807, 0, 1, 0, 1],
      "input_length": 8,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0200000000000000"
    },
    {
      "id": "empty-query-list",
      "input_values": [1, 0, 42],
      "input_length": 3,
      "output_capacity": 8,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-cycle-from-repeated-edge",
      "input_values": [3, 0, 1, 1, 2, 0, 1, 1, 0],
      "input_length": 9,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-query-endpoint",
      "input_values": [2, 1, 0, 1, 0, 1, 0, 2],
      "input_length": 8,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "trailing-input-word",
      "input_values": [1, 0, 42, 99],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [1, 0, 42],
      "input_length": 3,
      "input_is_null": true,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-buffer",
      "input_values": [2, 1, 0, 1, 0, 1, 0, 1],
      "input_length": 8,
      "output_capacity": 7,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output-buffer",
      "input_values": [1, 1, -4, 0, 0],
      "input_length": 5,
      "output_capacity": 8,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
