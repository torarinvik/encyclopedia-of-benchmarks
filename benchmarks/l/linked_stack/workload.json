  "description": "Run a bounded linked-stack operation trace and emit each source return value, including nil.",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[operation_count, opcode, push_value_when_opcode_is_1, ...]",
    "operation_count_range": [
