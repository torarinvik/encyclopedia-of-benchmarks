{
  "schema_version": 1,
  "id": "lru-page-reference-v1",
  "algorithm": "lru_page_reference",
  "function_symbol": "lru_page_reference",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[capacity, reference_count, page_ids...]",
    "capacity_range": [
      1,
      64
    ],
    "capacity_constraint": "positive power of two",
    "reference_count_range": [
      0,
      256
    ],
    "page_id_range": [
      0,
      1000000
    ],
    "normalization": "each page reference is a cache access; return hit flag and evicted page per access, then the final cache from most-recently-used to least-recently-used",
    "no_eviction_sentinel": -1,
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "output_encoding": "signed 64-bit integers in little-endian byte order; [reference_count, (hit_flag, evicted_page)*reference_count, final_cache_count, final_cache_MRU_to_LRU...]"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "eviction_and_reaccess",
      "input_values": [
        2,
        5,
        1,
        2,
        1,
        3,
        2
      ],
      "input_length": 7,
      "expected_result": 112,
      "expected_output_hex": "05000000000000000000000000000000ffffffffffffffff0000000000000000ffffffffffffffff0100000000000000ffffffffffffffff0000000000000000020000000000000000000000000000000100000000000000020000000000000002000000000000000300000000000000"
    },
    {
      "id": "hit_refreshes_recency",
      "input_values": [
        4,
        5,
        7,
        7,
        8,
        9,
        7
      ],
      "input_length": 7,
      "expected_result": 120,
      "expected_output_hex": "05000000000000000000000000000000ffffffffffffffff0100000000000000ffffffffffffffff0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff0100000000000000ffffffffffffffff0300000000000000070000000000000009000000000000000800000000000000"
    },
    {
      "id": "single_slot",
      "input_values": [
        1,
        3,
        5,
        6,
        6
      ],
      "input_length": 5,
      "expected_result": 72,
      "expected_output_hex": "03000000000000000000000000000000ffffffffffffffff000000000000000005000000000000000100000000000000ffffffffffffffff01000000000000000600000000000000"
    },
    {
      "id": "empty_reference_stream",
      "input_values": [
        8,
        0
      ],
      "input_length": 2,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
      "id": "capacity_not_power_of_two",
      "input_values": [
        3,
        1,
        4
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_page_id",
      "input_values": [
        2,
        1,
        -1
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated_references",
      "input_values": [
        2,
        2,
        4
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
