  "algorithm": "clojure_persistent_list_queue",
  "function_symbol": "clojure_persistent_list_queue",
  "description": "Replay bounded FIFO operations using the pinned Clojure persistent-list queue semantics.",
  "pinned_source": {
    "repository": "TheAlgorithms/Clojure",
    "commit": "a9c5bec14928cb22fd4d69e951edf5bd15e16a18",
    "path": "src/data_structures/queue/list.clj",
    "symbol": "enqueue / dequeue / peek-queue / empty-queue?",
