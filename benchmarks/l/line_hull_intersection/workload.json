    "encoding": "[n,x1,y1,x2,y2,x0,y0,...,x(n-1),y(n-1)]",
    "directed_line": "The distinct points (x1,y1) then (x2,y2) define the direction used to order hits.",
    "vertex_count_range": [3, 16],
    "coordinate_range": [-50, 50],
    "vertex_rule": "Distinct strictly convex vertices in counterclockwise cyclic order; any cyclic start is accepted.",
    "exact_length": "5+2*n",
    "maximum_valid_length": 37,
    "maximum_parseable_length": 38,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "two signed 64-bit little-endian edge indices in directed-line hit order",
    "pair_semantics": "[-1,-1] no hit; [i,-1] corner touch at vertex i; [i,i] overlap with side (i,i+1); [i,j] two hits on edges (i,i+1) and (j,j+1). Vertex hits use their outgoing edge index.",
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 16,
    "meaning": "External output capacity; all polygon and search state uses bounded fixed storage."
  },
  "algorithm_details": {
    "primary": "Use cyclic polar ordering of CCW edge vectors, binary-search its rotation and the support edges for both line normals, then binary-search each monotone boundary chain for its line hit.",
    "independent_oracle": "Scan every edge, collect exact vertex or rational edge-interior intersections, and sort by the exact dot-product parameter along the directed line.",
    "validation": "O(n^2) exact checks require positive CCW area and every non-edge vertex strictly left of each directed edge.",
    "query_complexity": "O(log n) after validation; independent edge scan is O(n)."
  },
  "measurement": {
