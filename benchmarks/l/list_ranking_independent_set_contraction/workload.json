{
  "schema_version": 1,
  "id": "encyclopedia-list-ranking-independent-set-contraction-i64-array-bytes-output-v1",
  "algorithm": "list_ranking_independent_set_contraction",
  "function_symbol": "list_ranking_independent_set_contraction",
  "abi": "i64_array_bytes_output",
  "description": "Bounded weighted list ranking by deterministic three-color independent-set contraction and rank restoration.",
  "source": {
    "title": "List Ranking",
    "authors": ["Riko Jacob", "Ulrich Meyer", "Laura Toma"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_592",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_592",
    "algorithm_attribution": "Cole-Vishkin-style independent-set removal, successor bridging, weight aggregation, recursive ranking, and rank restoration",
    "implementation_status": "clean-room bounded profile; no book prose or source code copied"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[node_count, head, weights_by_node_id..., successors_by_node_id...]",
    "node_count_range": [1, 16],
    "head_range": "0..node_count-1",
    "weight_range": [1, 10000],
    "successor_range": "-1 for the unique tail, otherwise 0..node_count-1",
    "path_constraint": "successors form one acyclic path containing every node, beginning at head; each node has at most one predecessor",
    "maximum_valid_length": 34,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "inclusive weighted prefix rank for each node in node-ID order",
    "maximum_values": 16,
    "maximum_bytes": 128,
    "success_result": "8 * node_count bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Conservative fixed storage for path validation, the current path, mutable weights, contraction records, ranks, and staged output."
  },
  "contract": {
    "contraction": "At each recursion level, color current path positions modulo three. Count colors among all positions except the tail; remove every vertex in the largest color class, breaking ties by lowest color. Add each removed vertex's current weight to its successor's current weight and bridge its predecessor to that successor.",
    "restoration": "The sole remaining tail has rank equal to its aggregate weight. Process removals in reverse order; each removed vertex rank is its successor rank minus the successor's weight saved immediately before contraction.",
    "rank_definition": "Inclusive sum of original vertex weights from head through the node.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
