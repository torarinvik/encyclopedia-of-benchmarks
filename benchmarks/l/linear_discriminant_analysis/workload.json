  "contract": {
    "operation": "Compute scalar class means, priors, pooled within-class variance, then source-ordered discriminant scores and class-major predictions.",
    "input_encoding": "[class_count, class_counts..., class-major samples...].",
    "class_count_range": [
      2,
      4
    ],
    "per_class_sample_count_range": [
      2,
      6
    ],
    "total_sample_count_maximum": 16,
    "sample_range": [
      -32,
      32
    ],
    "sample_values": "Finite exact integers; each class sample mean must be integral.",
    "mean_and_probability_order": "Classes and each class's samples are processed in input order; means use sum(samples)/count and priors use count/total.",
    "variance_formula": "1.0 / (N - K) * sum((sample - class_mean) ** 2), summing squared differences in class-major input order.",
    "score_formula": "x * (mean / variance) - (mean ** 2 / (2 * variance)) + log(prior), evaluated left-to-right as written.",
    "prediction_tie_rule": "First maximum score wins, matching list.index(max(scores)).",
    "score_margin_guard": "Reject if any sample's best-minus-second-best score is less than 1e-8.",
    "output_encoding": "One zero-based predicted class id per input sample, in class-major order; ids are float64 values.",
    "excluded_source_behavior": "Random Gaussian data generation, interactive prompts/restart, and printed accuracy."
  },
