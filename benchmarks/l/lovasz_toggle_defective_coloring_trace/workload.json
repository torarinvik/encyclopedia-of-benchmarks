  "id": "lovasz-toggle-defective-coloring-trace-i64-array-scalar-v1",
  "algorithm": "lovasz_toggle_defective_coloring_trace",
  "function_symbol": "lovasz_toggle_defective_coloring_trace",
  "abi": "i64_array_scalar",
  "description": "Repeatedly flip the lowest-index vertex that violates its same-color degree limit under the Lovasz two-coloring degree bound.",
  "source": {
    "title": "Lovasz Toggle",
    "authors": [
      "László Babai (lecture notes)"
    ],
    "url": "https://people.cs.uchicago.edu/~laci/reu03/notes13/node3.html",
    "license": "Algorithm described in source; clean-room implementation",
    "algorithm_attribution": "Choose a bad vertex of minimum index and change its color; the degree condition guarantees termination at an r/b-defective two-coloring.",
    "independent_reference_sources": [
      {
        "title": "Lovasz Toggle lecture notes",
        "url": "https://people.cs.uchicago.edu/~laci/reu03/notes13/node3.html"
      }
    ],
    "discovery_source": "https://github.com/kth-competitive-programming/kactl/blob/main/content/appendix/techniques.txt",
    "discovery_use": "Title index only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,red_limit,blue_limit,initial_red_mask,edge_count,(u,v)*edge_count]",
    "vertex_count_range": [
      0,
      16
    ],
    "threshold_range": [
      1,
      8
    ],
    "red_mask_bit_order": "Bit i is one exactly when vertex i starts red.",
    "edge_count_range": [
      0,
      120
    ],
    "edge_encoding": "Canonical undirected pairs with 0<=u<v<n; duplicate edges are invalid.",
    "maximum_degree_condition": "Every vertex degree must be at most red_limit+blue_limit+1.",
    "maximum_valid_length": 245,
    "maximum_parseable_length": 246,
    "null_input_result": -1,
    "malformed_input_result": -1
  },
  "operations": {
    "bad_vertex": "A red vertex with more than red_limit red neighbors, or a blue vertex with more than blue_limit blue neighbors.",
    "selection": "Select the lowest-index bad vertex.",
    "transition": "Flip the selected vertex's color and repeat until no bad vertex remains."
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "(toggle_count << n) | final_red_mask",
    "meaning": "Toggle count packed above the terminal coloring bit mask.",
    "valid_result_range": [
      0,
      62980095
    ],
    "malformed_input_result": -1
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "At most 16 fixed adjacency rows or masks, vertex degrees, and coloring state."
  },
  "complexity": {
    "primary_time": "O(m+T*n) for at most T<=960 toggles using fixed-width row masks",
    "primary_auxiliary_space": "O(n+m)",
    "independent_reference_time": "O(m+T*(n+m)) for at most T<=960 toggles",
    "independent_reference_space": "O(n+m)"
  },
  "oracle_method": "The primary stores adjacency as fixed-width bit masks; the independent reference stores adjacency sets and a boolean color vector.",
