{
  "schema_version": 1,
  "id": "linear-hashing-trace-i64-array-scalar-v1",
  "algorithm": "linear_hashing_trace",
  "function_symbol": "linear_hashing_trace",
  "abi": "i64_array_scalar",
  "description": "Deterministic insert/delete/membership trace for separate-chaining linear hashing with one-bucket-at-a-time growth.",
  "source": {
    "title": "Linear Hashing: A New Tool for File and Table Addressing",
    "authors": [
      "Witold Litwin"
    ],
    "url": "https://www.vldb.org/dblp/db/conf/vldb/Litwin80.html",
    "license": "Algorithm described in scholarly source; clean-room implementation",
    "algorithm_attribution": "Litwin linear hashing with a level and split pointer; one bucket is split after each insertion that raises live load above two entries per bucket.",
    "independent_reference_sources": [
      {
        "title": "NIST Dictionary of Algorithms and Data Structures: linear hashing",
        "url": "https://xlinux.nist.gov/dads/HTML/linearHashing.html"
      }
    ],
    "discovery_source": "https://xlinux.nist.gov/dads/termsType.html",
    "discovery_use": "Algorithm title and definition only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[Q,(opcode,key)*Q]",
    "operation_count_range": [
      0,
      63
    ],
    "key_range": [
      -1024,
      1023
    ],
    "maximum_valid_values": 127,
    "maximum_parseable_values": 128,
    "maximum_valid_length": 127,
    "maximum_parseable_length": 128,
    "null_input_result": -1,
    "malformed_input_result": -1,
    "operations": {
      "0": "insert key if absent; return 1 only when inserted",
      "1": "delete key if present; return 1 only when deleted",
      "2": "membership test; return 1 only when present"
    }
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "Q operation-success bits folded in trace order, first operation in the most-significant used bit",
    "valid_result_range": [
      0,
      9223372036854775807
    ],
    "malformed_input_result": -1
  },
  "table": {
    "initial_buckets": 2,
    "initial_level": 1,
    "initial_split_pointer": 0,
    "bucket_capacity_trigger": 2,
    "split_policy": "After each successful insertion, when live_key_count > 2*bucket_count and bucket_count < 32, split exactly the bucket at the split pointer. Rehash by modulo 2^(level+1), advance the pointer, and advance the level when the pointer reaches 2^level.",
    "collision_policy": "Separate chaining",
    "deletion_policy": "No bucket merges; deleted entries are unlinked",
    "maximum_buckets": 32,
    "hash_modulo": "Euclidean nonnegative remainder"
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed bucket heads, up to 63 allocated key/link records, and trace state."
  },
  "complexity": {
    "primary_time": "O(Q + sum of examined chain lengths + sum of entries moved by splits); each split moves only one bucket",
    "primary_auxiliary_space": "O(63)",
    "independent_reference_time": "O(Q^2) using a flat list",
    "independent_reference_space": "O(63)"
  },
  "oracle_method": "The primary maintains separate-chaining buckets and performs incremental linear-hashing splits. The independent oracle uses an unsorted flat list to model only insert, delete, and membership semantics.",
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
