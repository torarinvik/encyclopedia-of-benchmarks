{
  "schema_version": 1,
  "id": "lgv-nonintersecting-paths-v1",
  "algorithm": "lgv_nonintersecting_paths",
  "function_symbol": "lgv_nonintersecting_paths",
  "abi": "i64_array_scalar",
  "source": {
    "title": "Lindström–Gessel–Viennot lemma",
    "url": "https://oi-wiki.org/graph/lgv/",
    "reuse": "algorithm description only; independent implementation, contract, and fixtures"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[height,width,path_count,blocked_cell_mask,source_rows...,sink_rows...]",
    "height_range": [1, 5],
    "width_range": [2, 5],
    "path_count_range": [1, 3],
    "blocked_cell_mask": "bit row*width+column is one when that cell is blocked",
    "moves": ["right", "down"],
    "sources": "strictly increasing row indices in column zero",
    "sinks": "strictly increasing row indices in the last column",
    "maximum_valid_input_length": 10,
    "maximum_parseable_input_length": 11,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "number of pairwise vertex-disjoint monotone path families matching sources to sinks in order",
    "result_range": "0..343000",
    "invalid_result": -1
  },
  "complexity": {
    "time": "O(K*H*W + K^3)",
    "auxiliary_space": "O(H*W + K^2)",
    "maximum_paths": 3
  },
  "workspace": {"bytes": 4096},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"one-square-two-routes","input_values":[2,2,1,0,0,1],"expected_result":2},
    {"id":"three-by-three-single-pair","input_values":[3,3,1,0,0,2],"expected_result":6},
    {"id":"obstacle-removes-two-of-three-routes","input_values":[2,3,1,2,0,1],"expected_result":1},
    {"id":"two-pair-lgv-determinant","input_values":[3,3,2,0,0,1,1,2],"expected_result":3},
    {"id":"two-pair-center-obstacle","input_values":[3,3,2,16,0,1,1,2],"expected_result":1},
    {"id":"three-horizontal-disjoint-paths","input_values":[3,3,3,0,0,1,2,0,1,2],"expected_result":1},
    {"id":"no-surviving-route","input_values":[2,2,1,6,0,1],"expected_result":0},
    {"id":"blocked-source","input_values":[2,2,1,1,0,1],"expected_result":-1},
    {"id":"unsorted-sources","input_values":[3,3,2,0,1,0,1,2],"expected_result":-1},
    {"id":"source-after-matched-sink","input_values":[3,3,1,0,2,1],"expected_result":-1},
    {"id":"trailing-value","input_values":[2,2,1,0,0,1,9],"expected_result":-1},
    {"id":"missing-header","input_values":[],"expected_result":-1},
    {"id":"null-input","input_values":[],"input_is_null":true,"input_length":0,"expected_result":-1}
  ]
