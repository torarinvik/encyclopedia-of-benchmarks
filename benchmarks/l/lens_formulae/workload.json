{
  "schema_version": 1,
  "id": "lens-formulae-v1",
  "algorithm": "lens_formulae",
  "function_symbol": "lens_formulae",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "required_length": 3,
    "layout": ["operation", "first", "second"],
    "operation_codes": {
      "0": {"function": "focal_length_of_lens", "arguments": ["object_distance", "image_distance"]},
      "1": {"function": "object_distance", "arguments": ["focal_length", "image_distance"]},
      "2": {"function": "image_distance", "arguments": ["focal_length", "object_distance"]}
    },
    "operand_minimum": -1000000,
    "operand_maximum": 1000000,
    "operands_nonzero": true,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "the selected thin-lens reciprocal solve",
    "unit": "same distance unit as the operands",
    "invalid_input_result": -1e300
  },
  "cases": [
    {"id":"focal-length-positive","input_values":[0,10,4],"input_length":3,"expected_result":6.666666666666667},
    {"id":"object-distance-source-example","input_values":[1,10,40],"input_length":3,"expected_result":-13.333333333333332},
    {"id":"image-distance-source-example","input_values":[2,50,40],"input_length":3,"expected_result":22.22222222222222},
    {"id":"focal-length-signed","input_values":[0,-2,5],"input_length":3,"expected_result":1.4285714285714286},
    {"id":"object-distance-signed","input_values":[1,-5,10],"input_length":3,"expected_result":3.333333333333333},
    {"id":"image-distance-signed","input_values":[2,5,-10],"input_length":3,"expected_result":10.0},
    {"id":"invalid-selector","input_values":[3,10,4],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-zero-first","input_values":[0,0,4],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-zero-second","input_values":[1,10,0],"input_length":3,"expected_result":-1e300},
    {"id":"singular-focal-length","input_values":[0,10,10],"input_length":3,"expected_result":-1e300},
    {"id":"singular-object-distance","input_values":[1,-10,-10],"input_length":3,"expected_result":-1e300},
    {"id":"singular-image-distance","input_values":[2,5,-5],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-out-of-range","input_values":[0,1000001,4],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-length","input_values":[0,10],"input_length":2,"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
}
