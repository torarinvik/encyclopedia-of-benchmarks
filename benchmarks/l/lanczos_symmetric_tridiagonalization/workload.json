{
  "schema_version": 1,
  "id": "lanczos-symmetric-tridiagonalization-float64-slice-io-v1",
  "algorithm": "lanczos_symmetric_tridiagonalization",
  "function_symbol": "lanczos_symmetric_tridiagonalization",
  "abi": "float64_slice_io",
  "source": {
    "title": "NIST Digital Library of Mathematical Functions, §3.2(vi), Lanczos tridiagonalization",
    "equations": "3.2.21–3.2.22",
    "url": "https://dlmf.nist.gov/3.2.vi",
    "role": "Mathematical recurrence and projected matrix only"
  },
  "contract": {
    "input_encoding": "[n,k,A_row_major]",
    "operation": "Produce the first k diagonal and off-diagonal coefficients of the symmetric Lanczos projection, starting from e_1.",
    "initial_vector": "e_1=(1,0,...,0), normalized",
    "matrix_domain": "1<=n<=4; exact symmetric integer-valued binary64 entries in [-4,4]",
    "step_domain": "1<=k<=n",
    "recurrence": "alpha_j=v_j^T*A*v_j; u=A*v_j-alpha_j*v_j-beta_j*v_(j-1); beta_(j+1)=sqrt(u^T*u); v_(j+1)=u/beta_(j+1), with v_0=0 and beta_1=0",
    "output_encoding": "[k,alpha_1,...,alpha_k,beta_2,...,beta_k]",
    "operation_order": "Binary64 row-major matrix-vector products and dot products accumulate in ascending index order; residual coordinates evaluate (Av-alpha*v)-beta*v_previous; squared norms sum ascending coordinates before sqrt; no fast-math reassociation.",
    "breakdown": "A required beta <= 2^-40 or nonfinite, or any required nonfinite value, returns -3 with no output. beta_(k+1) is not computed.",
    "breakdown_threshold": "2^-40",
    "exact_nonzero_beta_lower_bound": "1/256; with integer matrix entries, each nonzero Krylov prefix volume is at least one, each beta is <= ||A||_F <= 16, and at most two other beta factors occur when k<=4",
    "error_precedence": "Malformed/null input returns -1 before output checks; valid input with null or short output returns -2 before recurrence work; recurrence breakdown returns -3.",
    "no_write_on_error": true,
    "primary_scratch_cap_bytes": 256
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[n,k,A_row_major]",
    "matrix_order_range": [1,4],
    "steps_range": "1<=k<=n",
    "matrix_entry_range": [-4,4],
    "matrix_entries_must_be_integer_valued": true,
    "matrix_must_be_exactly_symmetric": true,
    "frame_length_formula": "2+n*n",
    "maximum_valid_input_length": 18,
    "maximum_parseable_input_length": 19,
    "invalid_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "[k,alpha_1..alpha_k,beta_2..beta_k]",
    "element_count_formula": "2*k",
    "maximum_elements": 8,
    "maximum_bytes": 64,
    "success_result": "2*k",
    "invalid_input_result": -1,
    "short_or_null_output_result": -2,
    "breakdown_result": -3,
    "breakdown_threshold": "2^-40",
    "exact_nonzero_beta_lower_bound": "1/256",
    "no_write_on_error": true,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12
  },
  "workspace": {
    "elements": 8,
    "bytes": 64,
    "meaning": "Maximum caller-provided output buffer; fixed primary arrays and scalar state have a separate conservative 256-byte cap."
  },
  "complexity": {
    "primary_time": "O(k*n^2)",
    "primary_internal_space": "O(n+k), fixed under the n<=4 profile",
    "independent_time": "O(k*n^2 + k^2*n)",
    "independent_internal_space": "O(k*n), at most 16 basis entries plus fixed vectors"
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12
  },
  "primary_oracle": "primary_oracle.py: DLMF three-term Lanczos recurrence",
  "independent_oracle": "independent_oracle.py: Krylov powers, two-pass modified Gram-Schmidt, and Q^T A Q",
  "cases": [
    {"id":"one_by_one_trace","input_values":[1,1,3],"input_length":3,"output_capacity":2,"expected_result":2,"expected_output":[1.0,3.0]},
    {"id":"two_by_two_trace","input_values":[2,2,2,1,1,3],"input_length":6,"output_capacity":4,"expected_result":4,"expected_output":[2.0,2.0,3.0,1.0]},
    {"id":"three_by_three_prefix","input_values":[3,2,2,1,1,1,3,0,1,0,4],"input_length":11,"output_capacity":4,"expected_result":4,"expected_output":[2.0,2.0,3.5,1.4142135623730951]},
    {"id":"dense_four_full_trace","input_values":[4,4,1,1,1,0,1,2,0,0,1,0,3,1,0,0,1,4],"input_length":18,"output_capacity":8,"expected_result":8,"expected_output":[4.0,1.0,2.5,4.166666666666667,2.3333333333333335,1.4142135623730951,0.8660254037844386,0.4714045207910317]},
    {"id":"breakdown_before_requested_length","input_values":[3,3,1,0,0,0,0,2,0,0,0,3],"input_length":12,"output_capacity":6,"expected_result":-3,"expected_output":[]},
    {"id":"no_beta_needed_for_one_vector","input_values":[3,1,1,0,0,0,0,2,0,0,0,3],"input_length":12,"output_capacity":2,"expected_result":2,"expected_output":[1.0,1.0]},
    {"id":"maximum_output_one_short","input_values":[4,4,1,1,1,0,1,2,0,0,1,0,3,1,0,0,1,4],"input_length":18,"output_capacity":7,"expected_result":-2,"expected_output":[]},
    {"id":"invalid_asymmetric_matrix","input_values":[2,1,1,2,0,1],"input_length":6,"output_capacity":2,"expected_result":-1,"expected_output":[]},
    {"id":"invalid_noninteger_matrix_entry","input_values":[1,1,2.5],"input_length":3,"output_capacity":2,"expected_result":-1,"expected_output":[]},
    {"id":"invalid_order","input_values":[5,1,0],"input_length":3,"output_capacity":2,"expected_result":-1,"expected_output":[]},
    {"id":"maximum_parseable_trailing_value","input_values":[4,4,1,1,1,0,1,2,0,0,1,0,3,1,0,0,1,4,9],"input_length":19,"output_capacity":8,"expected_result":-1,"expected_output":[]}
  ],
  "abi_cases": [
    {"id":"null_input","input_values":[],"input_length":0,"input_is_null":true,"output_capacity":8,"expected_result":-1,"expected_output":[]},
    {"id":"valid_null_output","input_values":[1,1,3],"input_length":3,"output_capacity":2,"output_is_null":true,"expected_result":-2,"expected_output":[]},
