    "role": "algorithm description only; exact finite-field bounded profile is local"
  },
  "contract": {
    "operation": "Emit h0..hN from the nonsingular generalized fraction b0 + a1/(b1 + ... + aN/bN).",
    "primary_method": "Lentz C_n and D_n ratio state, multiplying successive convergent ratios into h_n.",
    "independent_method": "Direct numerator/denominator continuants, with the same strict zero-divisor domain.",
    "field": "F_998244353",
    "strict_domain": "b0, each C_n, and each pre-inversion D_n denominator must be nonzero; a zero final C_n is also rejected.",
    "finite_profile_caveat": "This exact finite-field trace makes no convergence claim for an infinite continued fraction.",
    "invalid_input_or_zero_divisor_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,b0,a1,b1,...,aN,bN]",
    "term_count_range": [1, 8],
    "field": "F_998244353",
    "canonical_residues": "all b0, an, and bn lie in 0..998244352",
    "initial_denominator": "b0 is nonzero",
    "exact_length": "2+2N",
    "maximum_valid_length": 18,
    "maximum_parseable_length": 19,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_word_array_bytes",
    "encoding": "[N+1,h0,h1,...,hN] over F_998244353",
    "word_count_range": [3, 10],
    "maximum_bytes": 80,
    "success_result": "8*(N+2)",
    "zero_divisor_result": -1,
    "null_or_short_output_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
