  "algorithm": "linear_partition_minimax",
  "function_symbol": "linear_partition_minimax",
  "abi": "i64_array_scalar",
  "description": "Partition a nonnegative sequence into exactly m nonempty contiguous groups while minimizing the largest group sum.",
  "source": {
    "title": "The Linear Partition Problem",
    "authors": ["Steven S. Skiena"],
    "url": "https://www3.cs.stonybrook.edu/~skiena/373/current-lectures/lecture18.pdf",
    "license": "Mathematical problem and recurrence cited; clean-room implementation",
    "algorithm_attribution": "The input order is preserved and the objective is the maximum group sum; the dynamic-programming reference considers every final cut.",
    "implementation_status": "Bounded clean-room minimax partition profile",
    "independent_reference_sources": [
      {
        "title": "The Algorithm Design Manual, section 10.7: The Ordered Partition Problem",
        "url": "https://users.math.uoc.gr/~plex/mem291-Fall2023/ark/Skiena-The_Algorithm_Design_Manual.pdf"
      }
    ],
    "discovery_source": {
      "title": "LeetCode public dynamic-programming title/topic index",
      "url": "https://leetcode.com/problem-list/dynamic-programming/",
      "use": "Discovery only; no task text or code reused"
    }
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,value_0,...,value_(n-1)]",
    "n_range": [1, 32],
    "groups_range": [1, 32],
    "value_range": [0, 1000],
    "exact_framing": true,
    "maximum_valid_length": 34,
    "maximum_parseable_length": 35,
    "null_input_result": -1,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "Minimum possible largest sum among exactly m nonempty contiguous groups in input order.",
    "result_range": [0, 32000],
    "invalid_input_result": -1
  },
  "contract": {
    "primary": "Binary-search a group-sum limit from max(values) through sum(values); greedily form the fewest contiguous groups under the limit and accept when the count is at most m.",
    "exact_group_argument": "All values are nonnegative and n>=m, so any feasible partition with fewer than m groups can be split into exactly m nonempty contiguous groups without increasing the largest sum.",
    "independent_reference": "Dynamic programming considers each cut before the final group and minimizes max(best cost for the preceding groups, sum of the final suffix).",
    "complexity": "Primary O(n log(sum(values)+1)) time and O(1) extra space; independent reference O(m*n^2) time and O(n) rolling-row space."
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Bounded scratch allowance for the scalar profile; the primary ports use constant additional state."
  },
  "primary_oracle": "benchmarks/l/linear_partition_minimax/primary_oracle.py",
  "independent_oracle": "benchmarks/l/linear_partition_minimax/independent_oracle.py",
  "measurement": {
