  "algorithm": "lower_bound_circulation_feasibility",
  "function_symbol": "lower_bound_circulation_feasibility",
  "abi": "i64_array_scalar",
  "source": {
    "title": "Flow with demands",
    "authors": ["CP-Algorithms contributors"],
