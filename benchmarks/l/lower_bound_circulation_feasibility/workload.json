    "license": "CC BY-SA 4.0; algorithm idea only, no copied code or prose"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,(u,v,lower,upper)*m]",
    "vertex_count_range": [1, 6],
    "edge_count_range": [0, 8],
    "endpoint_range": "0 <= endpoint < n",
    "bound_range": "0 <= lower <= upper <= 2",
    "parallel_arcs_allowed": true,
    "self_loops_allowed": true,
    "exact_length": "2+4*m",
    "maximum_valid_input_length": 34,
    "maximum_parseable_input_length": 35,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "1 if a feasible integral circulation exists, otherwise 0",
    "result_range": "0..1",
    "invalid_result": -1
  },
  "workspace": {"bytes": 1024},
  "complexity": {
    "primary_algorithm": "lower-bound balance transformation plus Edmonds-Karp max flow",
    "primary_time": "O(V^3*E) with matrix BFS, V<=8, E<=14 forward network arcs, and at most 64 matrix cells scanned per BFS",
    "independent_oracle": "enumerate at most 3^8 edge-flow assignments"
  },
  "oracle_method": "The primary applies the lower-bound balance transformation and tests whether maximum flow saturates all super-source arcs. The independent reference enumerates every integral flow value within each edge interval and checks that every vertex has equal inflow and outflow.",
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
