{
  "schema_version": 1,
  "id": "encyclopedia-ldfs-ordering-four-vertex-certificate-i64-array-bytes-output-v1",
  "algorithm": "ldfs_ordering_certificate",
  "function_symbol": "ldfs_ordering_certificate",
  "abi": "i64_array_bytes_output",
  "description": "Compute deterministic Lexicographic Depth-First Search order and its four-vertex characterization witnesses.",
  "source": {
    "title": "Unified View of Graph Searching and LDFS-Based Certifying Algorithms",
    "authors": ["Derek G. Corneil", "Michel Habib"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_685",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_685",
    "algorithm_attribution": "Lexicographic Depth-First Search and its four-vertex ordering characterization",
    "implementation_status": "clean-room deterministic tie-broken profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[vertex_count,start_vertex,undirected_adjacency_masks[vertex_count]]",
    "vertex_count_range": [1, 8],
    "start_vertex_range": "0 through vertex_count-1",
    "graph_constraints": "connected, undirected, simple; row masks have no self bits and are symmetric",
    "maximum_valid_length": 10,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[vertex_count,ordering[vertex_count],certificate_count,(a,b,c,witness)...]",
    "certificate_record": "For each order-position triple i<j<k with edge(order[i],order[k]) and no edge(order[i],order[j]), emit those three IDs and the earliest order witness between i and j adjacent to order[j] but not order[k]; emit -1 if missing.",
    "maximum_bytes": 1872,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed adjacency masks, order and certificate staging for at most eight vertices."
  },
  "contract": {
    "label": "The label of an unvisited vertex is its visited neighbors in reverse visitation order.",
    "selection": "Choose the lexicographically greatest label; break equal-label ties by lowest vertex ID. The supplied start is first.",
    "certificate": "The chapter's LDFS four-vertex characterization is checked by recording a witness for every triggering triple.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "cycle-four-with-lDFS-witness",
      "input_values": [4, 0, 10, 5, 10, 5],
      "input_length": 6,
      "output_capacity": 80,
      "expected_result": 80,
      "expected_output_hex": "0400000000000000000000000000000001000000000000000200000000000000030000000000000001000000000000000000000000000000020000000000000003000000000000000100000000000000"
    },
    {
      "id": "three-vertex-path",
      "input_values": [3, 0, 2, 5, 2],
      "input_length": 5,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "03000000000000000000000000000000010000000000000002000000000000000000000000000000"
    },
    {
      "id": "disconnected-graph",
      "input_values": [3, 0, 2, 1, 0],
      "input_length": 5,
      "output_capacity": 1872,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "asymmetric-adjacency",
      "input_values": [2, 0, 2, 0],
      "input_length": 4,
      "output_capacity": 1872,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [3, 0, 2, 5, 2],
      "input_length": 5,
      "output_capacity": 39,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [3, 0, 2, 5, 2],
      "input_length": 5,
      "output_capacity": 40,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 3,
      "input_is_null": true,
      "output_capacity": 1872,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
