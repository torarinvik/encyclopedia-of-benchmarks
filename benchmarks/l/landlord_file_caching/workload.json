{
  "schema_version": 1,
  "id": "encyclopedia-landlord-file-caching-i64-array-bytes-output-v1",
  "algorithm": "landlord_file_caching",
  "function_symbol": "landlord_file_caching",
  "abi": "i64_array_bytes_output",
  "description": "Deterministic Landlord cache-credit simulation for bounded variable-size files.",
  "source": {
    "title": "Online Paging and Caching",
    "authors": ["Neal E. Young"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_267",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_267",
    "algorithm_attribution": "Landlord file-caching algorithm with no credit increase on a hit",
    "implementation_status": "clean-room bounded integer-scaled profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[capacity,request_count,(file_id,size,retrieval_cost)*]",
    "capacity_range": [1, 8],
    "request_count_range": [0, 7],
    "file_id_range": [0, 7],
    "file_size_range": [1, 4],
    "file_size_must_not_exceed_capacity": true,
    "retrieval_cost_range": [0, 20],
    "file_metadata_is_constant_per_id": true,
    "maximum_valid_length": 23,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[miss_count,total_retrieval_cost,hit_flags,packed_eviction_masks,resident_mask]",
    "maximum_bytes": 40,
    "success_result": "40 bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 640,
    "meaning": "Eight resident file records, per-request trace masks, and staged five-value output."
  },
  "contract": {
    "hit_rule": "Leave resident credit unchanged on a hit, one allowed Landlord reset choice.",
    "miss_rule": "Make room before insertion by proportional credit reduction; insert with retrieval-cost credit.",
    "eviction_rule": "Evict all residents whose credit reaches zero after each reduction.",
    "credit_scale": 12,
    "eviction_signature": "One byte per request, containing the mask of file IDs evicted for that miss; 0 for a hit or no eviction.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"hit-and-variable-size-eviction","input_values":[3,4,1,1,4,2,2,2,1,1,4,3,2,3],"input_length":14,"output_capacity":40,"expected_result":40,"expected_output_hex":"03000000000000000900000000000000040000000000000000000004000000000a00000000000000"},
    {"id":"sequential-proportional-evictions","input_values":[4,3,1,2,2,2,2,6,3,3,3],"input_length":11,"output_capacity":40,"expected_result":40,"expected_output_hex":"03000000000000000b00000000000000000000000000000000000600000000000800000000000000"},
    {"id":"zero-credit-victim","input_values":[1,2,0,1,0,1,1,1],"input_length":8,"output_capacity":40,"expected_result":40,"expected_output_hex":"02000000000000000100000000000000000000000000000000010000000000000200000000000000"},
    {"id":"maximum-seven-requests","input_values":[8,7,0,1,1,1,1,2,1,1,3,1,1,4,1,1,5,1,1,6,1,1],"input_length":23,"output_capacity":40,"expected_result":40,"expected_output_hex":"07000000000000000700000000000000000000000000000000000000000000007f00000000000000"},
    {"id":"inconsistent-file-metadata","input_values":[4,2,1,1,4,1,2,4],"input_length":8,"output_capacity":40,"expected_result":-1,"expected_output_hex":""},
    {"id":"oversized-file","input_values":[2,1,1,3,1],"input_length":5,"output_capacity":40,"expected_result":-1,"expected_output_hex":""},
    {"id":"length-mismatch","input_values":[2,1,1,1],"input_length":4,"output_capacity":40,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[2,0],"input_length":2,"output_capacity":39,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":2,"input_is_null":true,"output_capacity":40,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-output","input_values":[2,0],"input_length":2,"output_capacity":40,"output_is_null":true,"expected_result":-2,"expected_output_hex":""}
  ]
}
