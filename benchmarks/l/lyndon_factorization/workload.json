{
  "schema_version": 1,
  "id": "lyndon-factorization-lowercase-ascii-bytes-v1",
  "algorithm": "lyndon_factorization",
  "function_symbol": "lyndon_factorization",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[n, lowercase_ascii_byte_0, ..., lowercase_ascii_byte_(n-1)]",
    "sequence_length_range": [
      0,
      256
    ],
    "value_range": [
      97,
      122
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "definition": "each Lyndon factor in non-increasing lexicographic order, followed by byte 0; empty input yields empty output",
    "maximum_length": 512,
    "success_result": "encoded byte length",
    "insufficient_capacity_result": -2,
    "capacity_contract": "output capacity must be at least 2*n bytes, the maximum encoded size"
  },
  "workspace": {
    "bytes": 512
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [
        0
      ],
      "input_length": 1,
      "workspace_bytes": 0,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "single_letter",
      "input_values": [
        1,
        122
      ],
      "input_length": 2,
      "workspace_bytes": 2,
      "expected_result": 2,
      "expected_output_hex": "7a00"
    },
    {
      "id": "repeated_letters",
      "input_values": [
        6,
        97,
        97,
        97,
        97,
        97,
        97
      ],
      "input_length": 7,
      "workspace_bytes": 12,
      "expected_result": 12,
      "expected_output_hex": "610061006100610061006100"
    },
    {
      "id": "banana",
      "input_values": [
        6,
        98,
        97,
        110,
        97,
        110,
        97
      ],
      "input_length": 7,
      "workspace_bytes": 12,
      "expected_result": 10,
      "expected_output_hex": "6200616e00616e006100"
    },
    {
      "id": "periodic",
      "input_values": [
        8,
        97,
        98,
        97,
        98,
        97,
        98,
        97,
        98
      ],
      "input_length": 9,
      "workspace_bytes": 16,
      "expected_result": 12,
      "expected_output_hex": "616200616200616200616200"
    },
    {
      "id": "mixed_runs",
      "input_values": [
        7,
        99,
        97,
        97,
        97,
        98,
        97,
        99
      ],
      "input_length": 8,
      "workspace_bytes": 14,
      "expected_result": 9,
      "expected_output_hex": "630061616162616300"
    },
    {
      "id": "strictly_increasing",
      "input_values": [
        6,
        97,
        98,
        99,
        100,
        101,
        102
      ],
      "input_length": 7,
      "workspace_bytes": 12,
      "expected_result": 7,
      "expected_output_hex": "61626364656600"
    },
    {
      "id": "strictly_decreasing",
      "input_values": [
        6,
        102,
        101,
        100,
        99,
        98,
        97
      ],
      "input_length": 7,
      "workspace_bytes": 12,
      "expected_result": 12,
      "expected_output_hex": "660065006400630062006100"
    },
    {
      "id": "uppercase_rejected",
      "input_values": [
        1,
        65
      ],
      "input_length": 2,
      "workspace_bytes": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "length_mismatch",
      "input_values": [
        2,
        97
      ],
      "input_length": 2,
      "workspace_bytes": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_byte_rejected",
      "input_values": [
        1,
        -1
      ],
      "input_length": 2,
      "workspace_bytes": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient_worst_case_capacity",
      "input_values": [
        1,
        97
      ],
      "input_length": 2,
      "workspace_bytes": 1,
      "expected_result": -2,
      "capacity_error_result": -2,
      "expected_output_hex": ""
    }
  ]
}
