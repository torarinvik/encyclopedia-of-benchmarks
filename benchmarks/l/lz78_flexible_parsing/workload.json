  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded phrase arrays, token staging and output framing for at most 32 characters."
  },
  "profile": {
    "dictionary_rule": "Begin with empty phrase at ID 0; candidates are matching dictionary prefixes followed by the next input character; add a selected phrase only if new.",
    "selection_rule": "Maximize position + candidate_phrase_length + longest_match_length_after_candidate in the trial dictionary. Ties use longer candidate phrase, then smaller parent dictionary ID.",
    "terminal_rule": "If the remaining suffix is an existing nonempty dictionary phrase, emit its ID with symbol 0 and stop; empty input emits no token.",
    "scope": "Bounded one-step lookahead parsing core; explicit tie and final-token refinements. No asymptotic runtime claim."
  },
