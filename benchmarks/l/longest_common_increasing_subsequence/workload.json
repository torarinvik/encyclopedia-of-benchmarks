{
  "schema_version": 1,
  "id": "longest-common-increasing-subsequence-i64-array-scalar-v1",
  "algorithm": "longest_common_increasing_subsequence",
  "function_symbol": "longest_common_increasing_subsequence",
  "abi": "i64_array_scalar",
  "description": "Return the length of a strictly increasing subsequence common to two bounded integer arrays.",
  "source": {
    "title": "A fast algorithm for computing a longest common increasing subsequence",
    "authors": ["I-Hsuan Yang", "Chien-Pin Huang", "Kun-Mao Chao"],
    "url": "https://doi.org/10.1016/j.ipl.2004.10.014",
    "license": "Algorithm descriptions cited; clean-room implementation",
    "algorithm_attribution": "LCIS is a sequence of equal-valued matches whose positions increase in both inputs and whose values increase strictly.",
    "implementation_status": "Bounded LCIS-length profile; no source code copied",
    "independent_reference_sources": [
      {"title":"A Sub-Quadratic Algorithm for the Longest Common Increasing Subsequence Problem","url":"https://doi.org/10.4230/LIPIcs.STACS.2020.41"},
      {"title":"A simple linear space algorithm for computing a longest common increasing subsequence","url":"https://arxiv.org/abs/1608.07002"}
    ]
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,A_0,...,A_(n-1),B_0,...,B_(m-1)]",
    "n_range": [0, 32],
    "m_range": [0, 32],
    "element_range": [-16, 16],
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "Length of the longest strictly increasing sequence that occurs as a subsequence in both A and B.",
    "result_range": [0, 32],
    "strict_increase": true,
    "invalid_input_result": -1
  },
  "contract": {
    "primary": "Process A from left to right. For each A value, scan B left to right, retaining the best prior LCIS length ending at a smaller B value; on an equal value, update that B position with best+1.",
    "independent_reference": "Create one DAG vertex for each equal-valued index pair (i,j). Add an edge from (i,j) to (i2,j2) exactly when i<i2, j<j2, and A[i]<A[i2]. The answer is the longest path in this matching-pair DAG.",
    "complexity": "Primary O(n*m) time and O(m) space. With P matching index pairs, the independent DAG oracle uses O(P^2) time and O(P) state; n,m<=32 implies P<=1024.",
    "empty_input": "Either array may be empty; the result is zero if either one is empty."
  },
  "workspace": {"bytes": 1024},
  "primary_oracle": "benchmarks/l/longest_common_increasing_subsequence/primary_oracle.py",
  "independent_oracle": "benchmarks/l/longest_common_increasing_subsequence/independent_oracle.py",
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
