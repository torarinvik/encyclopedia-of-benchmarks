{
  "schema_version": 1,
  "id": "library-checker-hafnian-bounded-subset-dp-i64-array-bytes-output-v1",
  "algorithm": "hafnian_of_matrix",
  "function_symbol": "hafnian_of_matrix",
  "abi": "i64_array_bytes_output",
  "description": "Compute the hafnian of a bounded symmetric zero-diagonal matrix modulo 998244353.",
  "source": {
    "title": "Hafnian of Matrix",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/linear_algebra/hafnian_of_matrix/task.md",
    "algorithm_attribution": "Subset dynamic programming over paired vertex subsets",
    "implementation_status": "clean-room bounded subset-DP ports"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, row-major N-by-N matrix...]",
    "N_range": [2, 16],
    "N_must_be_even": true,
    "matrix_value_range": "0 <= a[i][j] < 998244353",
    "matrix_constraints": "symmetric with zero diagonal",
    "maximum_valid_length": 257,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian residue",
    "maximum_bytes": 8,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 8,
    "meaning": "Maximum output-buffer capacity; subset DP storage is separate."
  },
  "contract": {
    "result": "sum over all perfect pairings of the products of paired matrix entries, modulo 998244353",
    "complexity": "O(N*2^N) time and O(2^N) memory",
    "official_N_range": [2, 38],
    "official_modulus": 998244353
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
