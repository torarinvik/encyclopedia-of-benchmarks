  "input": {
    "kind": "signed_i64_array",
    "layout": "[sample_count, feature_count, epochs, learning_rate_q1e6, row_major_training_features_q1e6..., labels..., query_features_q1e6...]",
    "sample_count_range": [
      1,
      32
    ],
    "feature_count_range": [
      1,
      8
    ],
    "epochs_range": [
      0,
      128
    ],
    "learning_rate_q1e6_range": [
      1,
      100000
    ],
    "training_feature_q1e6_range": [
      -1000000,
      1000000
    ],
    "query_feature_q1e6_range": [
      -1000000,
      1000000
    ],
    "label_values": [
      0,
      1
    ],
    "length_formula": "4 + sample_count * feature_count + sample_count + feature_count",
    "conversion": "Features and the learning rate are divided by 1,000,000. Labels remain 0 or 1.",
    "training_rule": "Initialize weights and bias to zero. For each epoch, visit samples in input order, accumulate full-batch weight and bias gradients from sigmoid(dot(features, weights) + bias) - label, then update weights in feature order and bias separately using the mean gradient.",
    "invalid_input_result": -1e+300,
    "maximum_input_length": 300
  },
  "output": {
    "kind": "binary64",
    "definition": "Predicted probability for the packed query feature vector after training.",
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
