{
  "schema_version": 1,
  "id": "lower_bound-v1",
  "algorithm": "lower_bound",
  "input": {
    "lengths": [1, 16, 128, 512],
    "generation": {
      "kind": "ascending",
      "multiplier": 2,
      "offset": "length",
      "formula": "values[index] = 2 * index - length"
    }
  },
  "cases": [
    {"id": "first_hit", "target_from": "first", "expected_from": "first_index"},
    {"id": "middle_hit", "target_from": "middle", "expected_from": "middle_index"},
    {"id": "last_hit", "target_from": "last", "expected_from": "last_index"},
    {"id": "below_minimum", "target_from": "fixed", "target": -2147483648, "expected": 0},
    {"id": "above_maximum", "target_from": "fixed", "target": 2147483647, "expected_from": "last_index"}
  ],
  "measurement": {
    "timer": "clock()",
    "comparison_model": "binary_search",
    "target_comparisons_per_sample": 250000,
    "warmup_rounds": 2,
    "sample_count": 7
  }
}
