{
  "schema_version": 1,
  "id": "largest-of-very-large-numbers-exact-log-v2",
  "algorithm": "largest_of_very_large_numbers",
  "function_symbol": "largest_of_very_large_numbers",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[base_a, exponent_a, base_b, exponent_b]",
    "exact_length": 4,
    "base_range": [
      0,
      1000000000000
    ],
    "exponent_range": [
      0,
      1000000000000
    ],
    "maximum_valid_array_length": 4,
    "maximum_parseable_array_length": 5,
    "invalid_input_result": -2,
    "base_rule": "Each base is 0 or exactly 10^k for an integer k in 0..12; the two pairs may be combined arbitrarily."
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "1 if score A is larger, -1 if score B is larger, 0 if scores compare equal",
    "valid_result_range": [
      -1,
      1
    ],
    "invalid_input_result": -2
  },
  "source_bound": {
    "description": "The pinned source returns score 0 for base 0 before checking the exponent, score 1 for a positive base with exponent 0, and otherwise exponent * log10(base).",
    "benchmark_domain": "Each base is independently 0 or exactly 10^k for k in 0..12; each exponent is independently in 0..1000000000000. For the selected domain, log10(10^k) is normalized to exact integer k, so positive-base positive-exponent scores are exact integers and arbitrary pairings and ties are accepted.",
    "comparison_rule": "Compare exact integer scores; do not use platform log10/libm results. This models the mathematical identity log10(10^k) = k, not bit-for-bit behavior of arbitrary libm implementations."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "same-exponent-first-wins",
      "input_values": [
        100,
        7,
        10,
        7
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "same-exponent-second-wins",
      "input_values": [
        10,
        7,
        100,
        7
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "same-exponent-tie",
      "input_values": [
        100,
        5,
        100,
        5
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "different-exponent-cross-base-first-wins",
      "input_values": [
        1000,
        2,
        10,
        5
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "arbitrary-cross-power-tie",
      "input_values": [
        100,
        3,
        1000,
        2
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "different-scale-tie",
      "input_values": [
        10,
        12,
        100,
        6
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "upper-decimal-power-exponent-one",
      "input_values": [
        1000000000000,
        1,
        100000000000,
        1
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "upper-decimal-power-max-exponent",
      "input_values": [
        1000000000000,
        1000000000000,
        100000000000,
        1000000000000
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "equal-upper-base-and-exponent",
      "input_values": [
        1000000000000,
        1000000000000,
        1000000000000,
        1000000000000
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "same-base-positive-exponents-first-wins",
      "input_values": [
        100,
        6,
        100,
        2
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "same-base-positive-exponents-second-wins",
      "input_values": [
        100,
        2,
        100,
        5
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "same-base-upper-exponent",
      "input_values": [
        1000000000000,
        1000000000000,
        1000000000000,
        999999999999
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "both-positive-bases-zero-exponent",
      "input_values": [
        1000000000000,
