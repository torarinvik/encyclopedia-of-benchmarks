      "expected_result": 0
    },
    {
      "id": "base-one-positive-exponent-vs-zero-exponent",
      "input_values": [
        1,
        2,
        10,
        0
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "invalid-non-power-base-two",
      "input_values": [
        2,
