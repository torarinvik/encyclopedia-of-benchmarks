{
  "schema_version": 1,
  "id": "lazy-segment-tree-range-add-max-right-i64-array-scalar-v1",
  "algorithm": "lazy_segment_tree_range_add_max_right",
  "function_symbol": "lazy_segment_tree_range_add_max_right",
  "abi": "i64_array_scalar",
  "description": "Nonnegative range additions followed by sum-monoid max_right boundary searches with lazy-tag propagation.",
  "source": {
    "title": "AtCoder Library: Lazy Segtree range actions and max_right",
    "authors": ["AtCoder Library contributors"],
    "reference": "Official AtCoder Library documentation and implementation",
    "url": "https://atcoder.github.io/ac-library/production/document_en/lazysegtree.html",
    "implementation_url": "https://github.com/atcoder/ac-library/blob/master/atcoder/lazysegtree.hpp",
    "algorithm_attribution": "Lazy segment-tree range addition with tree-guided max_right search",
    "implementation_status": "clean-room implementations from published semantics"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,initial_values[n],(opcode,left,right,x)*q]",
    "operation_row_width": 4,
    "operation_rows": {
      "range_add": "[0,left,right,delta]",
      "max_right": "[1,left,limit,0]"
    },
    "n_range": [1, 16],
    "operation_count_range": [0, 12],
    "initial_value_range": [0, 31],
    "range_add_bounds": "0<=left<=right<=n and 0<=delta<=31",
    "max_right_bounds": "0<=left<=n and 0<=limit<=8192; the last row field must be zero",
    "exact_length": "2+n+4*q",
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "five-bit max_right endpoint fields in query order; range additions emit no field",
    "maximum_query_count": 12,
    "maximum_endpoint": 16,
    "invalid_input_result": -1
  },
  "contract": {
    "monoid": "integer addition with identity zero",
    "range_action": "add a nonnegative delta to every value in a half-open interval",
    "predicate": "sum(values[left:end]) <= limit",
    "values_nonnegative": true,
    "predicate_monotone": true,
    "empty_range_predicate_true": true,
    "table_rebuilt_each_call": true,
    "maximum_element_after_updates": 403,
    "maximum_total_sum": 6448
  },
  "complexity": {
    "build": "O(n)",
    "range_add": "O(log n)",
    "max_right": "O(log n)",
    "auxiliary_space": "O(n)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 11,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
