    "num_lists_range": [1, 4],
    "initial_length_range": [1, 4],
    "iterations_range": [0, 16],
    "exact_length": 3,
    "growth_rate": 0.333,
    "dirty_traversal": true,
    "tail_insertion": true,
    "output": "Two little-endian signed i64 values: accumulate and num_allocated.",
    "success_result": 2,
    "output_capacity_requirement": 16,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "output_untouched_on_error": true
  },
