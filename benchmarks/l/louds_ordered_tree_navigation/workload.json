  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[n,bit_length,packed_louds_bits,q,answers...]",
    "packed_bit_order": "bit j of the LOUDS string is bit j of the packed word, least-significant bit first",
    "maximum_bytes": 288,
    "output_untouched_on_error": true,
    "null_or_short_output_result": -2
  },
  "contract": {
    "tree": "Vertex 0 is root; every later vertex has a parent with a smaller input ID; sibling order is ascending input ID.",
    "method": "Encode each node degree as degree one-bits then a zero, concatenated in breadth-first order. Decode degree by successive select-zero positions; use one-prefix counts to map parent and child ordinals.",
    "complexity": "O(n^2+q*n) bounded scans for n,q<=32; O(n+q) fixed workspace.",
    "distinctness": "LOUDS ordered-tree navigation is separate from wavelet-tree value queries, raw bitvector rank/select, balanced-parenthesis successor/rank-unrank primitives, and binary-tree serialization."
  },
  "workspace": {"bytes": 4096},
  "measurement": {"comparison_model": "i64_array_bytes_output_call"},
