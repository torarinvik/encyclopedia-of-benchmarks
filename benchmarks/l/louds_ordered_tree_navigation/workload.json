    "reuse": "algorithm description only; clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,parent[1..n-1],(opcode,node,argument)*q]",
    "node_count_range": [1, 32],
    "query_count_range": [0, 32],
    "maximum_valid_length": 129,
    "maximum_parseable_length": 130,
    "query_nodes": "zero-based LOUDS breadth-first ordinals",
    "opcodes": {"0": "degree, argument must be 0", "1": "parent, argument must be 0", "2": "child by zero-based rank; absent rank returns -1"},
    "invalid_result": -1
