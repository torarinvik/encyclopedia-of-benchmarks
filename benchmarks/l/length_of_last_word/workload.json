{
  "schema_version": 1,
  "id": "java-length-of-last-word-ascii-byte-v1",
  "algorithm": "length_of_last_word",
  "function_symbol": "length_of_last_word",
  "input": {
    "kind": "length_prefixed_byte_string",
    "encoding": "[byte_length, byte_0, ..., byte_(n-1)]",
    "byte_length_range": [
      0,
      128
    ],
    "byte_range": [
      0,
      255
    ],
    "word_separator_byte": 32,
    "exact_packed_length": "byte_length + 1",
    "invalid_result": -1,
    "maximum_packed_values": 129
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "number of consecutive non-space bytes in the final word after ignoring trailing ASCII spaces; zero if no word",
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
    {
      "id": "empty_string",
      "input_values": [
        0
      ],
      "expected_result": 0,
      "input_length": 1
    },
    {
      "id": "spaces_only",
      "input_values": [
        4,
        32,
        32,
        32,
        32
      ],
      "expected_result": 0,
      "input_length": 5
    },
    {
      "id": "one_word",
      "input_values": [
        4,
        119,
        111,
        114,
        100
      ],
      "expected_result": 4,
      "input_length": 5
    },
    {
      "id": "one_word_with_trailing_spaces",
      "input_values": [
        7,
        104,
        101,
        108,
        108,
        111,
        32,
        32
      ],
      "expected_result": 5,
      "input_length": 8
