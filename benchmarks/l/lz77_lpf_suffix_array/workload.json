{
  "schema_version": 1,
  "id": "encyclopedia-lz77-lpf-sa-psv-nsv-i64-array-bytes-output-v1",
  "algorithm": "lz77_lpf_suffix_array",
  "function_symbol": "lz77_lpf_suffix_array",
  "abi": "i64_array_bytes_output",
  "source": {
    "title": "Linear Time Lempel-Ziv Factorization: Simple, Fast, Small",
    "authors": ["Juha Kärkkäinen", "Dominik Kempa", "Simon J. Puglisi"],
    "year": 2013,
    "reference": "CPM 2013; Encyclopedia of Algorithms entry 634",
    "paper_url": "https://cpm.cs.helsinki.fi/cpm13/16_kempa.pdf",
    "chapter_url": "https://doi.org/10.1007/978-1-4939-2864-4_634",
    "algorithm_attribution": "K3 suffix-array previous/next-smaller-value LPF factorization",
    "implementation_status": "bounded clean-room implementation; no upstream code reproduced"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, byte_0, ..., byte_(n-1)]",
    "maximum_text_length": 32,
    "byte_range": [0, 255],
    "maximum_valid_length": 33,
    "maximum_parseable_length": 34,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "encoding": "(zero-based source_position,match_length) pairs; (-1,0) is a literal; no count prefix",
    "maximum_bytes": 512,
    "success_result": "bytes written",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "contract": {
    "factor_rule": "At each phrase boundary compare LCPs with PSV and NSV, the previous and next strictly smaller suffix-array values around the current suffix start.",
    "psv_definition": "For text start i, use the SA value at greatest rank r<ISA[i] with SA[r]<i.",
    "nsv_definition": "For text start i, use the SA value at least rank r>ISA[i] with SA[r]<i.",
    "candidate_tie_rule": "Choose NSV only when its LCP is strictly greater; PSV wins ties.",
    "literal_rule": "If match length is zero, output source sentinel -1 and length zero.",
    "advance_rule": "Advance by max(match_length,1).",
    "overlap_rule": "LCP is compared against the original input and may overlap the target phrase.",
    "oracle_split": "Primary uses suffix array plus SA previous/next-smaller stacks; independent reference directly enumerates prior starts and orders their suffixes by direct comparison.",
    "validation_order": "Reject null/malformed input before checking output pointer or capacity; do not write on error."
  },
  "workspace": {"bytes": 512, "meaning": "Maximum serialized source and LPF-length pairs."},
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 5},
