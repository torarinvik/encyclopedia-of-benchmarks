{
  "schema_version": 1,
  "id": "longest-common-substring-sam-i64-array-scalar-v1",
  "algorithm": "longest_common_substring_sam",
  "function_symbol": "longest_common_substring_sam",
  "abi": "i64_array_scalar",
  "description": "Longest common substring length by suffix automaton and suffix-link scan.",
  "input": {"kind": "signed_64_bit_integer_array", "encoding": "[length_a,A...,length_b,B...]", "maximum_valid_length": 514, "maximum_parseable_length": 515, "invalid_result": -1},
  "measurement": {"comparison_model": "i64_array_scalar_call", "sample_count": 8, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "cases": [
    {"id": "empty", "input_values": [0,0], "input_length": 2, "expected_result": 0},
    {"id": "shared_middle", "input_values": [4,65,66,67,68,4,88,66,67,89], "input_length": 10, "expected_result": 2},
    {"id": "repeated_fallback", "input_values": [5,65,66,65,66,67,5,66,65,66,65,66], "input_length": 12, "expected_result": 4},
    {"id": "clone_and_fallback", "input_values": [4,65,66,66,67,3,66,66,67], "input_length": 9, "expected_result": 3},
    {"id": "empty_first", "input_values": [0,3,65,66,67], "input_length": 5, "expected_result": 0},
    {"id": "empty_second", "input_values": [3,65,66,67,0], "input_length": 5, "expected_result": 0},
    {"id": "disjoint", "input_values": [2,65,66,2,67,68], "input_length": 6, "expected_result": 0},
    {"id": "invalid_character", "input_values": [1,31,0], "input_length": 3, "expected_result": -1},
    {"id": "trailing_input", "input_values": [0,0,65], "input_length": 3, "expected_result": -1},
    {"id": "truncated", "input_values": [2,65,66], "input_length": 3, "expected_result": -1},
    {"id": "null_input", "input_values": [], "input_length": 0, "input_is_null": true, "expected_result": -1}
  ]
