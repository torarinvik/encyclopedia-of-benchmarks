{
  "schema_version": 1,
  "id": "lucky-number-sieve-bounded-prefix-v1",
  "algorithm": "lucky_number_sieve",
  "function_symbol": "lucky_number_sieve",
  "abi": "i64_array_bytes_output",
  "description": "Return the survivors through an inclusive bound for the odd-started lucky sieve or the even-started variant.",
  "source": {
    "title": "Rosetta Code: Lucky and even lucky numbers",
    "url": "https://rosettacode.org/wiki/Lucky_and_even_lucky_numbers",
    "algorithm_references": [
      {"title": "OEIS A000959: Lucky numbers", "url": "https://oeis.org/A000959"},
      {"title": "OEIS A045954: Even-lucky numbers", "url": "https://oeis.org/A045954"}
    ],
    "source_license": "Rosetta Code task content is GFDL; used as an algorithm index only, with no code or prose reused.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[mode, inclusive_bound]",
    "mode_values": {"0": "positive odd candidates, standard lucky sequence", "1": "positive even candidates, even-lucky sequence"},
    "inclusive_bound_range": [0, 4096],
    "maximum_valid_length": 2,
    "maximum_parseable_length": 3,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "consecutive little-endian signed 64-bit survivors in ascending order",
    "maximum_bytes": 16384,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "nonnull_output_required_for_empty_result": true
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "One fixed array of at most 2,048 signed 64-bit candidates; output is written directly to the caller buffer."
  },
  "contract": {
    "operation": "Enumerate all values at most the bound that survive the selected lucky-number sieve.",
    "algorithm": "Start with the positive odd or even candidates. Repeatedly select the current survivor at zero-based index 1, 2, and so on, then remove ranks divisible by that survivor value, counting ranks from 1. Stop when there is no next survivor or its value exceeds the current survivor count.",
    "complexity": "At most O(n^2) filtering time and O(n) fixed workspace for n initial candidates.",
    "error_precedence": "Validate the input pointer, exact length, mode, and bound before validating the output pointer and capacity.",
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1,
    "profiles": [
      {"id": "odd-prefix-32", "input_values": [0, 32], "output_bytes": 72},
      {"id": "even-prefix-32", "input_values": [1, 32], "output_bytes": 72}
    ]
  },
  "cases": [
    {"id": "odd-empty-prefix", "input_values": [0, 0], "input_length": 2, "output_capacity": 0, "expected_result": 0, "expected_output_hex": ""},
    {"id": "even-empty-prefix", "input_values": [1, 0], "input_length": 2, "output_capacity": 0, "expected_result": 0, "expected_output_hex": ""},
    {"id": "odd-single-candidate", "input_values": [0, 1], "input_length": 2, "output_capacity": 8, "expected_result": 8, "expected_output_hex": "0100000000000000"},
    {"id": "odd-sieve-step-three", "input_values": [0, 8], "input_length": 2, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "010000000000000003000000000000000700000000000000"},
    {"id": "even-sieve-step-four", "input_values": [1, 8], "input_length": 2, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "020000000000000004000000000000000600000000000000"},
    {"id": "odd-multiple-rounds", "input_values": [0, 32], "input_length": 2, "output_capacity": 72, "expected_result": 72, "expected_output_hex": "01000000000000000300000000000000070000000000000009000000000000000d000000000000000f00000000000000150000000000000019000000000000001f00000000000000"},
    {"id": "even-multiple-rounds", "input_values": [1, 32], "input_length": 2, "output_capacity": 72, "expected_result": 72, "expected_output_hex": "0200000000000000040000000000000006000000000000000a000000000000000c000000000000001200000000000000140000000000000016000000000000001a00000000000000"},
    {"id": "invalid-mode-low", "input_values": [-1, 32], "input_length": 2, "output_capacity": 16384, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-mode-high", "input_values": [2, 32], "input_length": 2, "output_capacity": 16384, "expected_result": -1, "expected_output_hex": ""},
    {"id": "negative-bound", "input_values": [0, -1], "input_length": 2, "output_capacity": 16384, "expected_result": -1, "expected_output_hex": ""},
    {"id": "bound-above-profile", "input_values": [1, 4097], "input_length": 2, "output_capacity": 16384, "expected_result": -1, "expected_output_hex": ""},
    {"id": "wrong-input-length", "input_values": [0], "input_length": 1, "output_capacity": 16384, "expected_result": -1, "expected_output_hex": ""},
    {"id": "too-many-input-values", "input_values": [0, 8, 9], "input_length": 3, "output_capacity": 16384, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-input", "input_values": [0, 8], "input_length": 2, "input_is_null": true, "output_capacity": 16384, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-output", "input_values": [0, 8], "input_length": 2, "output_capacity": 24, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
    {"id": "insufficient-output-capacity", "input_values": [1, 8], "input_length": 2, "output_capacity": 8, "expected_result": -2, "expected_output_hex": ""}
  ]
}
