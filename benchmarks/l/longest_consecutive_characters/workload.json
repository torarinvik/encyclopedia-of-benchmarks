    },
    {
      "id": "first_tie_wins",
      "input_values": [8, 65, 65, 66, 66, 65, 65, 66, 66],
      "input_length": 9,
      "expected_result": 3,
      "expected_output_hex": "410200"
    },
    {
      "id": "later_longer_run",
      "input_values": [8, 65, 66, 66, 66, 65, 65, 65, 65],
      "input_length": 9,
      "expected_result": 3,
      "expected_output_hex": "410400"
    },
    {
      "id": "nul_character_and_tie",
      "input_values": [4, 0, 0, 1, 1],
      "input_length": 5,
      "expected_result": 3,
      "expected_output_hex": "000200"
    },
    {
      "id": "invalid_empty_input",
      "input_values": [0],
