  },
  "pinned_source": {
    "repository": "TheAlgorithms/C-Sharp",
    "commit": "96e2905cab7bc6b33ac0a34ee5bb82ddccbcbb6",
    "path": "Algorithms/Strings/GeneralStringAlgorithms.cs",
    "method": "FindLongestConsecutiveCharacters"
