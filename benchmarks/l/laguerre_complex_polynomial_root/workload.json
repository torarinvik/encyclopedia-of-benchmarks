{
  "schema_version": 1,
  "id": "laguerre-complex-polynomial-root-bounded-seed-v1",
  "algorithm": "laguerre_complex_polynomial_root",
  "function_symbol": "laguerre_complex_polynomial_root",
  "abi": "float64_slice_io",
  "oracle": "benchmarks/laguerre_complex_polynomial_root_oracle.py",
  "oracle_entry_point": "expected_output(values, output_capacity=None, output_is_null=False, input_is_null=False, input_length=None)",
  "independent_reference": "benchmarks/laguerre_complex_polynomial_root_reference.py",
  "source": {
    "title": "Laguerre polynomial root example and standard complex Laguerre iteration",
    "discovery_index": "https://github.com/indy256/codelibrary",
    "discovery_source": "https://github.com/indy256/codelibrary/blob/main/cpp/numeric/polynom-roots.cpp",
    "mathematical_reference": "https://www.cec.uchile.cl/cinetica/pcordero/MC_libros/NumericalRecipesinC.pdf",
    "implementation_status": "clean-room bounded ports"
  },
  "input": {
    "kind": "finite_float64_array_of_exact_integers",
    "encoding": "[degree,a0,...,a_degree,start_re_milli,start_im_milli,tolerance_micro,max_iterations]",
    "coefficient_order": "ascending powers",
    "degree_range": [2, 6],
    "coefficient_range": [-16, 16],
    "leading_coefficient_nonzero": true,
    "seed_milli_range": [-4000, 4000],
    "tolerance_micro_range": [1, 1000],
    "iteration_cap_range": [8, 128],
    "maximum_valid_input_length": 12,
    "maximum_parseable_input_length": 13,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "definition": "[real_part,imaginary_part] of the converged root estimate",
    "maximum_elements": 2,
    "success_result": 2,
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "numerical_failure_result": -3,
    "output_untouched_on_error": true,
    "absolute_tolerance": 2e-06,
    "relative_tolerance": 1e-08
  },
  "workspace": {
    "elements": 2,
    "meaning": "Two staged binary64 values for the output root; implementations use fixed-size local iteration state."
  },
  "contract": {
    "derivative_evaluation": "Simultaneous descending complex Horner recurrence for P, P-prime, and P-double-prime.",
    "laguerre_terms": "G=P-prime/P; H=G*G-P-double-prime/P; R=sqrt((degree-1)*(degree*H-G*G)).",
    "denominator_choice": "Choose G+R when its magnitude is greater than or equal to G-R; otherwise choose G-R.",
    "complex_square_root": "Principal square root; on the negative real axis use the nonnegative imaginary root.",
    "convergence": "At each seed and after each update, succeed when |P(z)| <= tau*max(1,sum_j |a_j|*|z|^j), where tau=tolerance_micro/1,000,000.",
    "iteration_bound": "At most max_iterations corrections are applied; the residual is checked once after the final permitted correction.",
    "numerical_failure": "Return -3 on a non-finite intermediate, a zero selected denominator, or exhaustion without meeting the residual criterion.",
    "operation_order": "Each correction uses the current z and commits z <- z - degree/denominator before the next residual check.",
    "complexity": "O(degree*max_iterations) time and O(degree) local coefficient storage."
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100,
    "absolute_tolerance": 2e-06,
    "relative_tolerance": 1e-08
  },
  "cases": [
    {
      "id": "quadratic-real-root-from-zero-seed",
      "input_values": [2, -1, 0, 1, 0, 0, 1, 16],
      "input_length": 8,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [-1.0, 0.0]
    },
    {
      "id": "quadratic-complex-root-from-zero-seed",
      "input_values": [2, 1, 0, 1, 0, 0, 1, 16],
      "input_length": 8,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [0.0, 1.0]
    },
    {
      "id": "cubic-root-through-laguerre-corrections",
      "input_values": [3, -1, 0, 0, 1, 900, 0, 1, 16],
      "input_length": 9,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [1.0, 0.0]
    },
    {
      "id": "maximum-degree-exact-root",
      "input_values": [6, -1, 0, 0, 0, 0, 0, 1, 1000, 0, 1, 32],
      "input_length": 12,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [1.0, 0.0]
    },
    {
      "id": "coefficient-and-seed-upper-boundaries",
