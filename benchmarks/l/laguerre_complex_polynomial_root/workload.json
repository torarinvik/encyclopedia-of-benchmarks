      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [1.0, 0.0]
    },
    {
      "id": "maximum-tolerance-and-iteration-cap",
      "input_values": [2, -1, 0, 1, 1000, 0, 1000, 128],
      "input_length": 8,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [1.0, 0.0]
    },
    {
