    },
    {
      "id": "null-output-buffer",
      "input_values": [2, -1, 0, 1, 0, 0, 1, 16],
      "input_length": 8,
      "output_capacity": 2,
      "output_is_null": true,
      "expected_result": -2
    },
    {
      "id": "invalid-input-precedes-null-output",
