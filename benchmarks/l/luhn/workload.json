{
  "schema_version": 1,
  "id": "luhn-even-digits-i64-array-v1",
  "algorithm": "luhn",
  "function_symbol": "luhn_validate",
  "input": {
    "kind": "i64_array_scalar",
    "encoding": "[digit_count, digit_0, ..., digit_(digit_count-1)]",
    "digit_count_range": [
      2,
      64
    ],
    "digit_count_must_be_even": true,
    "digit_range": [
      0,
      9
    ],
    "leading_zeroes_preserved": true,
    "invalid_result": -1
  },
  "output": {
    "kind": "i64",
    "meaning": "1 if the Luhn-adjusted sum is divisible by 10, otherwise 0",
    "invalid_result": -1
  },
  "cases": [
    {
      "id": "classic_valid_16_digits",
      "input_values": [
        16,
        4,
        5,
        6,
        1,
        2,
        6,
        1,
        2,
        1,
        2,
        3,
        4,
        5,
        4,
        6,
        7
      ],
      "expected_result": 1,
      "input_length": 17
    },
    {
      "id": "classic_invalid_16_digits",
      "input_values": [
        16,
        4,
        5,
        6,
        1,
        2,
        6,
        1,
        2,
        1,
        2,
        3,
        4,
        5,
        4,
        6,
        4
      ],
      "expected_result": 0,
      "input_length": 17
    },
    {
      "id": "leading_zero_valid",
      "input_values": [
        12,
        0,
        4,
        9,
        9,
        2,
        7,
        3,
        9,
        8,
        7,
        1,
        6
      ],
      "expected_result": 1,
      "input_length": 13
    },
    {
      "id": "two_digit_valid",
      "input_values": [
        2,
        1,
        8
      ],
      "expected_result": 1,
      "input_length": 3
    },
    {
      "id": "two_digit_invalid",
      "input_values": [
        2,
        1,
        9
      ],
      "expected_result": 0,
      "input_length": 3
    },
    {
      "id": "all_zero_digits",
      "input_values": [
        4,
        0,
        0,
        0,
        0
      ],
      "expected_result": 1,
      "input_length": 5
    },
    {
      "id": "odd_digit_count",
      "input_values": [
        3,
        7,
        9,
        9
      ],
      "expected_result": -1,
      "input_length": 4
    },
    {
      "id": "empty_sequence",
      "input_values": [
        0
      ],
      "expected_result": -1,
      "input_length": 1
    },
    {
      "id": "digit_out_of_range",
      "input_values": [
        2,
        1,
        10
      ],
      "expected_result": -1,
      "input_length": 3
    },
    {
      "id": "negative_digit",
      "input_values": [
        2,
        -1,
        8
      ],
      "expected_result": -1,
      "input_length": 3
    },
    {
      "id": "packed_length_mismatch",
      "input_values": [
        2,
        1
      ],
      "expected_result": -1,
      "input_length": 2
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
