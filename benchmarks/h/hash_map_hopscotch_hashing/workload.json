      "input_values": [32, 1, 0, 0, 1, 1, 1, 1, 2, 2, 1, 3, 3, 1, 4, 4, 1, 5, 5, 1, 6, 6, 1, 7, 7, 1, 8, 8, 1, 9, 9, 1, 10, 10, 1, 11, 11, 1, 12, 12, 1, 13, 13, 1, 14, 14, 1, 15, 15, 2, 0, 0, 2, 1, 1, 2, 2, 2, 2, 3, 3, 2, 4, 4, 2, 5, 5, 2, 6, 6, 2, 7, 7, 2, 8, 8, 2, 9, 9, 2, 10, 10, 2, 11, 11, 2, 12, 12, 2, 13, 13, 2, 14, 14, 2, 15, 15],
