      "symbol": "NextPrime"
    }
  ],
  "cases": [
    {
      "id": "present_and_absent_queries",
      "input_values": [3, 1, 2, 3, 5, 1, 2, 4, 3, 5],
      "input_length": 10,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "01000000000000000100000000000000000000000000000001000000000000000000000000000000"
    },
    {
      "id": "empty_set",
      "input_values": [0, 2, 1, 2],
      "input_length": 4,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
      "id": "bucket_zero_key",
      "input_values": [1, 17, 1, 17],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "maximum_trace",
      "input_values": [8, 1, 2, 3, 4, 5, 6, 7, 8, 8, 1, 3, 5, 7, 9, 11, 13, 15],
