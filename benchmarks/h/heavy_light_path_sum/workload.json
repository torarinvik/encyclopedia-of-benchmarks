{
  "schema_version": 1,
  "id": "heavy-light-path-sum-i32-values-v1",
  "algorithm": "heavy_light_path_sum",
  "function_symbol": "heavy_light_path_sum",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[vertex_count, operation_count, node_values..., (edge_u, edge_v)..., (operation, a, b_or_value)...]",
    "vertex_count_range": [
      1,
      64
    ],
    "operation_count_range": [
      0,
      128
    ],
    "root": 0,
    "vertex_ids": "zero-based labels from 0 through vertex_count - 1",
    "node_value_range": [
      -2147483648,
      2147483647
    ],
    "tree": "connected simple undirected tree with exactly vertex_count - 1 edges",
    "operation_codes": {
      "0": "set node a to signed-i32 value b",
      "1": "inclusive node-value sum on the path from a to b"
    },
    "input_length": "exactly 3 * vertex_count + 3 * operation_count",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "one inclusive path sum for each query, in operation order",
    "return_value": "number of output bytes written (8 * query_count)"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 50
  },
