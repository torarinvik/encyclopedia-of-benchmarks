{
  "schema_version": 1,
  "id": "hampel-filter-v1",
  "algorithm": "hampel_filter",
  "function_symbol": "hampel_filter",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[n, samples...]",
    "n_range": [0, 128],
    "sample_range": [-1000, 1000],
    "window_size": 3,
    "threshold": 3.0,
    "operation": "Insert each raw sample into the trailing window; compute its median and the median absolute deviation; replace the output with the median iff abs(sample-median) > 3.0*1.4826*MAD. Keep the raw sample in the window after replacement.",
    "output_encoding": "one little-endian signed 64-bit filtered sample per input sample",
    "empty_output_byte_length": 0,
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "exact_shape": "n+1 values"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_stream",
      "input_values": [0],
      "input_length": 1,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "two_sample_warmup_then_window_fill",
      "input_values": [3, 1, 2, 3],
      "input_length": 4,
      "expected_result": 24,
      "expected_output_hex": "010000000000000002000000000000000300000000000000"
    },
    {
      "id": "warmup_and_zero_mad_outlier_replacement",
      "input_values": [3, 1, 1, 20],
      "input_length": 4,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000100000000000000"
    },
    {
      "id": "outlier_replaced_but_raw_value_remains_in_window",
      "input_values": [5, 1, 2, 3, 100, 4],
      "input_length": 6,
      "expected_result": 40,
      "expected_output_hex": "01000000000000000200000000000000030000000000000003000000000000000400000000000000"
    },
    {
      "id": "negative_samples_and_window_rollover",
      "input_values": [4, -1000, 0, 1000, 0],
      "input_length": 5,
      "expected_result": 32,
      "expected_output_hex": "18fcffffffffffff0000000000000000e8030000000000000000000000000000"
    },
    {
      "id": "invalid_packed_length",
      "input_values": [2, 5],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "invalid_sample_bound",
      "input_values": [1, 1001],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "insufficient_output_capacity",
      "input_values": [1, 5],
      "input_length": 2,
      "expected_result": -2,
      "workspace_bytes": 0,
      "capacity_error_result": -2
    }
  ],
  "output": {
    "kind": "little_endian_int64_vector",
    "length": "n",
    "order": "filtered samples in input order",
    "successful_result": "8*n bytes"
  },
  "workspace": {
    "bytes": 1024,
