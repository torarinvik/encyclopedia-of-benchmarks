{
  "schema_version": 1,
  "id": "hex-to-bin-ascii-i64-array-scalar-v1",
  "algorithm": "hex_to_bin",
  "function_symbol": "hex_to_bin",
  "input": {
    "kind": "bounded_signed_i64_array",
    "layout": "ASCII byte values for optional minus sign followed by 1 through 4 hexadecimal digits",
    "accepted_bytes": "ASCII 0-9, A-F, a-f, and optional ASCII minus (45) only at index 0",
    "input_length_range": [
      1,
      5
    ],
    "input_modified": false,
    "maximum_input_length": 5,
    "zero_input_result": -9223372036854775808,
    "invalid_result": -9223372036854775808
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "base-10 integer parsed from the source-generated binary digit string, preserving a leading minus",
    "invalid_input_result": -9223372036854775808
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "pinned_uppercase_example",
      "input_values": [
        65,
        67
      ],
      "input_length": 2,
      "expected_result": 10101100
    },
    {
