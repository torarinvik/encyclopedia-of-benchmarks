  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,f(0),...,f(2^n-1),v0,i0,...,v(q-1),i(q-1)]",
    "dimension_range": [1, 6],
    "round_range": [1, 32],
    "truth_table": "Boolean function indexed by the integer representation of the hypercube vertex; coordinate zero is the least significant bit.",
    "random_tape": "Each (vertex,coordinate) pair gives one uniform vertex and one uniform dimension, inducing the uniform undirected hypercube-edge distribution.",
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_result": -1
  },
  "contract": {
    "algorithm": "For each supplied pair, clear its coordinate bit to get the lower endpoint, set it to get the upper endpoint, query both truth-table entries, and reject at the first round with f(lower)>f(upper). Accept after all q rounds pass.",
    "query_calls": "Two per evaluated round, including repeated queries across rounds.",
    "output": "[accept_bit,rounds_executed,query_calls] as little-endian signed i64 values.",
    "scope": "Fixed deterministic replay profile; arbitrary tapes and q are not assigned a soundness or epsilon-to-query-count guarantee."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[accept_bit,rounds_executed,query_calls]",
    "maximum_bytes": 24,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
