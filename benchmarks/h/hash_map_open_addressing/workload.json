{
  "schema_version": 1,
  "id": "hash-map-open-addressing-v1",
  "algorithm": "hash_map_open_addressing",
  "input": {
    "encoding": "[operation_count, (opcode, key, value)*]",
    "type": "signed 64-bit integers",
    "maximum_operations": 256,
    "maximum_distinct_active_keys": 64,
    "key_range": [
      0,
      1000000
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "operations": {
      "0": "set/upsert",
      "1": "get",
      "2": "delete",
      "3": "contains",
      "4": "size"
    },
    "initial_capacity": 8,
    "capacity_factor": 0.75,
    "probing": "linear probing with tombstones",
    "growth": "before each set, double when size >= floor(capacity * 0.75)",
    "shrink": "after successful delete, halve above capacity 8 when size < capacity * 0.75 / 2",
    "missing_get_or_delete": "invalid trace",
    "tombstone_update_restriction": "after any required growth, an update is invalid if its existing key is reached only after a tombstone",
    "result": "weighted query sum + weighted final sorted key/value pairs + final size",
    "malformed_result": -1
  },
  "function_symbol": "hash_map_open_addressing",
  "measurement": {
    "comparison_model": "i64_array_scalar_call"
  },
