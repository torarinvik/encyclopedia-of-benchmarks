{
  "schema_version": 1,
  "id": "rust-huber-loss-average-v1",
  "algorithm": "huber_loss",
  "function_symbol": "huber_loss",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[delta_micro, true_count, predicted_count, true_values_micro..., predicted_values_micro...]",
    "scale_per_physical_unit": 1000000,
    "valid_pair_count_range": [
      1,
      64
    ],
    "parser_pair_count_maximum": 65,
    "delta_micro_range": [
      0,
      1000000000
    ],
    "sample_micro_range": [
      -1000000000,
      1000000000
    ],
    "maximum_packed_values": 133,
    "invalid_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "meaning": "average Huber loss over paired samples",
    "invalid_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "residuals_within_delta",
      "input_values": [
        1000000,
