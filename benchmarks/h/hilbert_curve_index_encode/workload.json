  "algorithm": "hilbert_curve_index_encode",
  "function_symbol": "hilbert_curve_index_encode",
  "abi": "i64_array_bytes_output",
  "description": "Map one bounded 2D integer coordinate to its Butz Hilbert path index.",
  "source": {
    "title": "A. R. Butz, Alternative Algorithm for Hilbert's Space-Filling Curve",
    "authors": ["Arthur R. Butz"],
    "url": "https://doi.org/10.1109/T-C.1971.223258",
    "license": "Algorithmic description only; no copied text or code",
    "implementation_status": "bounded clean-room profile"
  },
  "contract": {
    "operation": "Return the Hilbert distance of one point in a 2^order by 2^order grid.",
    "orientation": "At order one the traversal is (0,0),(0,1),(1,1),(1,0).",
    "primary_method": "Iterate from high coordinate bits to low bits, accumulating quadrant digits and applying the corresponding lower-bit orientation transform.",
    "independent_method": "Recursively select one quadrant and transform the child coordinates before adding that quadrant's index block.",
    "duplicate_comparison": "hilbert_curve materializes an entire rotated recursive point sequence; morton_sort ranks point sets by interleaved Z-order bits.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[order,x,y]",
    "order_range": [1, 8],
    "coordinate_range": "0<=x,y<2^order",
    "maximum_valid_length": 3,
    "maximum_parseable_length": 4,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_word_array_bytes",
    "encoding": "[HilbertIndex]",
    "maximum_bytes": 8,
    "success_result": 8,
    "invalid_input_result": -1,
    "null_or_short_output_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 0,
    "meaning": "Native primary uses scalar coordinate, orientation, and index state only."
  },
  "complexity": {
    "native_primary_time": "O(order)",
    "native_primary_auxiliary_space": "O(1)",
    "independent_reference_time": "O(order)",
    "independent_reference_auxiliary_space": "O(order) recursion frames"
  },
  "measurement": {
