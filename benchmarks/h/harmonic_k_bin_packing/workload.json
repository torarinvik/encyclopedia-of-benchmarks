    "bin_capacity_ticks": 10000,
    "maximum_valid_length": 34,
    "maximum_parseable_length": 34,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[bin_count,bin_id_per_item_in_input_order]",
    "maximum_bytes": 264,
    "success_result": "8*(item_count+1) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 384,
    "meaning": "32 assignment IDs plus 8 current-bin IDs and 8 remaining-capacity slots, using i64 values."
  },
  "contract": {
    "classes": "For i=1..k-1: (1/(i+1),1/i]; final class (0,1/k]. Compare exactly by integer cross multiplication against capacity 10000.",
    "packing": "Each class uses its own current bin with Next Fit; advancing to a new bin permanently closes the previous class bin.",
    "bin_ids": "Global IDs assigned in order bins are first opened.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "competitive_claim": "None for bounded fixtures; source's asymptotic family analysis is not measured."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
