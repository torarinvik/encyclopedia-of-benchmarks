  "abi": "i64_array_bytes_output",
  "source": {
    "title": "Use of the Hough Transformation to Detect Lines and Curves in Pictures",
    "url": "https://doi.org/10.1145/361237.361242",
    "discovery": "Rosetta title index only; algorithm source is the cited paper",
    "reuse": "algorithm idea only; bounded profile implemented independently"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[height, width, row-major binary pixels...]",
    "minimum_height": 1,
    "maximum_height": 8,
    "minimum_width": 1,
    "maximum_width": 8,
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "pixel_values": [0, 1],
    "invalid_input_result": -1,
    "invalid_input_writes_bytes": false
  },
  "algorithm_profile": {
    "coordinates": "x=column, y=row; origin at the upper-left",
    "integer_normals_in_order": [[1, 0], [1, 1], [0, 1], [-1, 1]],
    "diagonal_normals_are_unnormalized": true,
    "rho_formula": "rho=nx*x+ny*y",
    "rho_minimum": -14,
    "rho_maximum": 14,
    "rho_bin_count": 29,
    "output_index": "angle_index*29 + rho + 14",
    "votes_per_foreground_pixel": 4,
    "maximum_bin_count": 64,
    "complexity": "O(4*height*width + 116) time and O(116) workspace"
  },
  "output": {
    "kind": "angle_major_hough_accumulator_bytes",
    "byte_count": 116,
    "definition": "29 unsigned count bytes for each normal, in the declared normal order; rho bins run from -14 through 14.",
    "valid_result": 116,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_result": -2,
    "errors_write_bytes": false
  },
  "workspace": {
    "bytes": 116,
    "description": "One fixed 116-byte accumulator; input is read directly."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
