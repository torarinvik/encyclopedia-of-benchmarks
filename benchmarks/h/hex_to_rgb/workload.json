{
  "schema_version": 1,
  "id": "hex-to-rgb-packed-i64-v1",
  "algorithm": "hex_to_rgb",
  "function_symbol": "hex_to_rgb",
  "input": {
    "kind": "unprefixed_ascii_code_array",
    "encoding": "exactly six ASCII hexadecimal digits in RRGGBB order",
    "length": 6,
    "accepted_characters": "0-9, A-F, a-f",
    "leading_prefix": "not accepted",
    "malformed_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "(red << 16) | (green << 8) | blue",
    "valid_range": [
      0,
      16777215
    ],
    "malformed_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
