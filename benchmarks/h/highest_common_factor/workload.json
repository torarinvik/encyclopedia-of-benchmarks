{
  "schema_version": 1,
  "id": "highest-common-factor-matlab-subtractive-v1",
  "algorithm": "highest_common_factor",
  "function_symbol": "highest_common_factor",
  "input": {
    "kind": "unsigned_64_bit_integer_pair",
    "left_range": [
      0,
      64
    ],
    "right_range": [
      0,
      64
    ]
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "greatest common factor of the two inputs"
  },
  "measurement": {
    "comparison_model": "binary_scalar_call",
    "sample_count": 10,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
      "id": "both_zero",
      "input_values": [
        0,
        0
      ],
      "expected_result": 0
    },
    {
      "id": "left_zero",
      "input_values": [
        0,
        42
      ],
      "expected_result": 42
    },
    {
      "id": "right_zero",
      "input_values": [
        45,
        0
      ],
      "expected_result": 45
    },
    {
      "id": "equal_values",
      "input_values": [
        32,
        32
      ],
      "expected_result": 32
    },
    {
      "id": "nontrivial_factor",
      "input_values": [
        24,
        36
      ],
      "expected_result": 12
    },
    {
      "id": "coprime_consecutive",
      "input_values": [
        64,
        63
      ],
      "expected_result": 1
    },
    {
      "id": "repeated_subtraction",
      "input_values": [
        63,
        42
      ],
      "expected_result": 21
    },
    {
      "id": "shared_factor",
      "input_values": [
        60,
        24
      ],
      "expected_result": 12
    },
    {
      "id": "common_factor_of_seven",
      "input_values": [
        49,
        14
      ],
      "expected_result": 7
    },
    {
      "id": "one_divides_other",
      "input_values": [
        64,
        32
      ],
      "expected_result": 32
    }
  ]
}
