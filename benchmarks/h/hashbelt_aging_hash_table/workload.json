{
  "schema_version": 1,
  "id": "nist-hashbelt-aging-i64-array-bytes-v1",
  "algorithm": "hashbelt_aging_hash_table",
  "function_symbol": "hashbelt_aging_hash_table",
  "input": {
    "kind": "signed_i64_hashbelt_operation_trace",
    "format": "[operation_count,(opcode,key,argument)*operation_count]",
    "maximum_valid_length": 193,
    "maximum_parseable_length": 194,
    "maximum_operations": 64,
    "generations": 4,
    "buckets_per_generation": 8,
    "hash": "key mod 8; separate chaining",
    "key_range": [
      0,
      31
    ],
    "value_range": [
      -1000,
      1000
    ],
    "opcodes": {
      "0": "put (key,argument) into newest generation; argument is the value",
      "1": "get key and promote an older hit; argument must be zero",
      "2": "age belt by dropping oldest generation; key and argument must be zero"
    },
    "miss_sentinel": -2147483648,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "one signed-i64 result per operation: PUT absent flag, GET value or miss sentinel, AGE dropped live-entry count",
    "maximum_bytes": 512,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "write_on_error": false
  },
  "workspace": {
    "bytes": 4096,
    "accounting": "Four 32-record chained tables with 8 bucket heads each, operation-result staging for 64 i64 values, and bounded index/control state."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
