  "source": {
    "kind": "clean-room algorithmic method profile",
    "title": "A fast algorithm for computing longest common subsequences",
    "authors": ["James W. Hunt", "Thomas G. Szymanski"],
    "publication": "Communications of the ACM 20(5), 1977",
    "url": "https://doi.org/10.1145/359581.359603",
    "repository_license": "ACM article; no article material reused",
    "algorithm_attribution": "Matching-position enumeration with descending per-symbol positions and a minimum-tail LIS frontier"
  },
  "contract": {
    "operation": "Return the LCS length of two bounded ASCII-symbol sequences.",
    "input_layout": "[left_length, right_length, left_symbols..., right_symbols...]",
    "sequence_length_range": [0, 64],
    "symbol_range": [0, 127],
    "matching_pair_count": "R = number of pairs (i,j) for which left[i] == right[j]",
    "time_complexity": "O(n + m + R log(min(n,m)+1)); worst case O(n*m*log(min(n,m)+1))",
    "auxiliary_storage": "128 fixed right-position lists of 64 int32 entries plus 64 int32 tails, at most 33536 bytes",
    "invalid_result": -1
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[left_length, right_length, left_symbols..., right_symbols...]",
    "maximum_valid_length": 130,
    "maximum_parseable_input_length": 131,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "valid_range": [0, 64],
    "invalid_result": -1
  },
  "workspace": {
    "bytes": 33536,
    "meaning": "Fixed 128-by-64 int32 right-position table and 64-entry int32 LIS-tail array; the 128-entry count table adds 512 bytes, included in the bound."
  },
