{
  "schema_version": 1,
  "id": "hinge-loss-rust-fixed-point-i64-array-v1",
  "algorithm": "hinge_loss",
  "function_symbol": "hinge_loss",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[n, labels[0..n], prediction_scaled[0..n]]",
    "minimum_pair_count": 1,
    "maximum_pair_count": 256,
    "label_values": [
      -1,
      1
    ],
    "prediction_scale": 1000000,
    "prediction_scaled_range": [
      -1000000,
      1000000
    ],
    "invalid_input_result": -1e+300,
    "exact_shape": "1 + 2*n values"
  },
  "output": {
    "kind": "binary64",
    "definition": "ordered mean of max(0, 1 - label[i] * (prediction_scaled[i] / 1000000))",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e+300,
    "empty_input_note": "the source divides by the prediction-array length, so an empty prediction array is outside this finite-result contract"
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
