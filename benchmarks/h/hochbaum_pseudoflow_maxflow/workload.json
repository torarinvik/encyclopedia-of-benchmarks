{
  "schema_version": 1,
  "id": "hochbaum-pseudoflow-maxflow-i64-array-scalar-v1",
  "algorithm": "hochbaum_pseudoflow_maxflow",
  "function_symbol": "hochbaum_pseudoflow_maxflow",
  "abi": "i64_array_scalar",
  "input": {
    "layout": "[N,M,source,sink,(u,v,capacity)*M]",
    "node_ids": "one-based",
    "maximum_nodes": 8,
    "maximum_arcs": 24,
    "maximum_valid_length": 76,
    "maximum_parseable_length": 77,
    "capacities": "0..100",
    "parallel_arcs": "supported as distinct input arcs",
    "self_loops": "invalid",
    "terminal_arc_policy": "source has outgoing arcs only; sink has incoming arcs only; direct source-to-sink arcs are supported; arcs into source or out of sink are invalid",
    "invalid_result": -1
  },
  "algorithm_policy": {
    "variant": "Hochbaum highest-label pseudoflow (hpf_hf-style branch policy)",
    "active_component": "strong branch with greatest root label",
    "equal_label_tie": "FIFO branch activation order, then root vertex order",
    "merger": "lowest-label node in the selected branch to a residual head labeled l-1; head may be strong",
    "arc_ties": "tail vertex, input arc index, forward before reverse residual direction, then head vertex",
    "relabel": "if no merger exists, increment the first lowest-label node whose children all have labels at least l+1",
    "normalization": "push the strong root's full excess along the normalized-tree path; split when a path residual capacity is strictly smaller than the remaining excess",
    "maximum_outer_iterations": 512
  },
  "output": {
    "encoding": "maximum integral flow value, obtained as the capacity of the terminal strong/weak cut",
    "maximum_result": 2400,
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "source": {
    "url": "https://doi.org/10.1287/opre.1080.0524",
    "author_pdf": "https://hochbaum.ieor.berkeley.edu/html/pub/HPF.pdf",
    "reuse": "Hochbaum's 2008 highest-label pseudoflow algorithm ideas only; all implementation text and code are independently authored."
  },
  "cases": [
