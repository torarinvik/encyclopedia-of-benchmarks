    {"id": "reverse-residual-and-zero-deficit-pivot", "input_values": [6,7,1,6,1,2,1,1,3,1,2,4,1,2,5,1,3,4,1,4,6,1,5,6,1], "input_length": 25, "expected_result": 2},
    {"id": "zero-capacity-and-disconnected-sink", "input_values": [3,2,1,3,1,2,0,2,3,100], "input_length": 10, "expected_result": 0},
    {"id": "maximum-parallel-direct-frame", "input_values": [2,24,1,2,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100,1,2,100], "input_length": 76, "expected_result": 2400},
