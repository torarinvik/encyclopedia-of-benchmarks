{
  "schema_version": 1,
  "id": "hirschberg-linear-space-lcs-reconstruction-v1",
  "algorithm": "hirschberg_lcs",
  "function_symbol": "hirschberg_lcs",
  "abi": "i64_array_bytes_output",
  "description": "Reconstruct one deterministic longest common subsequence by linear-space divide-and-conquer traceback.",
  "source": {
    "title": "A linear space algorithm for computing maximal common subsequences",
    "authors": ["Daniel S. Hirschberg"],
    "year": 1975,
    "reference": "Communications of the ACM 18(6), pp. 341-343, DOI 10.1145/360825.360861",
    "url": "https://doi.org/10.1145/360825.360861",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[first_length, second_length, first_symbols..., second_symbols...]",
    "sequence_length_range": [0, 64],
    "symbol_range": [0, 127],
    "exact_length": "2 + first_length + second_length",
    "maximum_valid_length": 130,
    "maximum_parseable_length": 132,
    "tie_rule": "Longer sequence is recursion axis (first input on equal lengths); choose smallest second-sequence split offset maximizing forward[j]+backward[width-j]; one-symbol base case chooses its earliest match.",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_string",
    "encoding": "the symbols of one common subsequence in order, with no header or terminator",
    "maximum_output_bytes": 64,
    "success_result": "number of output bytes written",
    "valid_empty_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Two 65-element DP rows, a 64-byte staged certificate, and bounded recursion state."
  },
  "complexity": {
    "time": "O(n*m)",
    "auxiliary_space": "O(min(n,m) + log(max(n,m))) excluding returned bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Primary uses Hirschberg forward/backward rows and smallest maximizing splits; independent full-table dynamic programming checks that the emitted byte sequence is common to both inputs and has optimal length.",
