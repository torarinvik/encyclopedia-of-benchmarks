{
  "schema_version": 1,
  "id": "nist-hash-heap-priority-queue-trace-i64-array-bytes-output-v1",
  "algorithm": "hash_heap_priority_queue_trace",
  "function_symbol": "hash_heap_priority_queue_trace",
  "abi": "i64_array_bytes_output",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[U,B,q,(opcode,operand)*q]",
    "universe_range": [1, 128],
    "bucket_count_range": [1, 8],
    "operation_count_range": [0, 64],
    "key_range": "0 <= key < U",
    "hash_mapping": "floor(key*B/U)",
    "maximum_valid_length": 131,
    "maximum_parseable_length": 132,
    "invalid_result": -1
  },
  "operations": {
    "0": "insert operand as key; operand must be in [0,U)",
    "1": "peek minimum; operand must be zero",
    "2": "extract minimum; operand must be zero",
    "empty_query": -1,
    "successful_query_encoding": "(zero_based_insertion_operation_index << 8) | key",
    "successful_insert_encoding": -2,
    "stable_ties": "ascending key then earlier insertion operation index"
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[q,result_0,...,result_(q-1)]",
    "maximum_bytes": 520,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "input_validation_precedes_capacity": true,
    "errors_leave_output_untouched": true
  },
  "workspace": {
    "bytes": 4096,
    "accounting": "eight 64-entry key/id heap lanes, lane sizes, 520-byte output staging, and scalar locals"
  },
  "complexity": {
    "primary_time": "O(q*(B+log(q+1)))",
    "independent_reference_time": "O(q^2)",
    "primary_state": "O(B*q+q)",
    "independent_reference_state": "O(q)"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "input_and_correctness_validation": "outside timed call"
  },
  "cases": [
    {
