  "id": "halves-are-alike-v1",
  "algorithm": "halves_are_alike",
  "contract": {
    "input": "A sequence of 0 to 256 ASCII letter values (A-Z or a-z), with even length.",
    "output": "1 when the two equal halves contain the same number of vowels; otherwise 0.",
    "invalid_input_result": -1,
    "empty_input_result": 1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
