    "start_vertex": 0,
    "invalid_result": -1,
    "maximum_input_length": 58
  },
  "output": {
    "kind": "signed_i64_scalar",
    "values": {
      "0": "no Hamiltonian cycle from start vertex 0",
      "1": "a Hamiltonian cycle exists from start vertex 0"
    },
    "return_value": "0 or 1 for valid input; -1 for invalid input",
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
