{
  "schema_version": 1,
  "id": "max-binary-heap-incremental-push-peek-pop-i64-v1",
  "algorithm": "heap_max_push_peek_pop",
  "function_symbol": "heap_max_push_peek_pop",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[count, item_0, ..., item_(count-1)]",
    "count_range": [
      1,
      256
    ],
    "item_range": [
      1,
      1000000000
    ],
    "construction": "Insert every item in input order into an empty max heap; do not bulk-heapify.",
    "extraction": "For each of count items, read the current maximum and remove it. Duplicate values are retained.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "signed_i64_little_endian_vector",
    "description": "all input items in descending order, one signed 64-bit little-endian value per extraction",
    "return_value": "output byte length (8 * count)",
    "max_output_bytes": 2048
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
