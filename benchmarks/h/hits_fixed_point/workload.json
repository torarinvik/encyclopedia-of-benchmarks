    {"id":"self-loop","input_values":[1,1,1,0,0],"input_length":5,"expected_result":-1},
    {"id":"endpoint-out-of-range","input_values":[2,1,1,0,2],"input_length":5,"expected_result":-1},
    {"id":"iteration-count-out-of-range","input_values":[2,0,33],"input_length":3,"expected_result":-1},
    {"id":"trailing-value","input_values":[1,0,0,0],"input_length":4,"expected_result":-1},
