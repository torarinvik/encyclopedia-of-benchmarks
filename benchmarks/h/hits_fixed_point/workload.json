{
  "schema_version": 1,
  "id": "encyclopedia-hits-fixed-point-i64-array-scalar-v1",
  "algorithm": "hits_fixed_point",
  "function_symbol": "hits_fixed_point",
  "abi": "i64_array_scalar",
  "description": "Fixed-iteration integer HITS hub-authority ranking on a directed graph.",
  "source": {
    "title": "Authoritative Sources in a Hyperlinked Environment",
    "author": "Jon M. Kleinberg",
    "year": 1999,
    "reference": "Journal of the ACM 46(5), pages 604-632, DOI 10.1145/324133.324140",
    "url": "https://doi.org/10.1145/324133.324140",
    "copyright": "Algorithm idea and citation only; implementation and fixed-point contract are clean-room work."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,K,(source,target)*M]",
    "vertex_count_range": [1, 16],
    "edge_count_range": [0, 64],
    "iteration_count_range": [0, 32],
    "vertex_id_range": "0..N-1",
    "directed_simple_graph": true,
    "self_loops_allowed": false,
    "duplicate_ordered_arcs_allowed": false,
    "exact_length": "3+2*M",
    "maximum_valid_length": 131,
    "maximum_parseable_length": 132,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "sum((one_based_vertex_index)*(authority_score+65537*hub_score))",
    "score_scale": 1000000,
    "normalization": "floor(raw[i]*1000000/sum(raw)); an all-zero raw vector becomes all zeroes",
    "initial_hub_scores": "1000000 for every vertex",
    "initial_authority_scores": "0 for every vertex"
  },
  "algorithm_details": {
    "primary": "For each fixed iteration, traverse arcs to sum current hub scores into authority targets, L1-normalize by fixed-point floor division, traverse arcs to sum new authority scores into hub sources, and normalize again.",
    "independent_oracle": "Apply the same fixed-point recurrence with a dense adjacency matrix and per-vertex scans.",
    "primary_complexity": "The language ports validate duplicate arcs with pairwise scans, giving O(M^2 + K*(N+M)) time and O(N+M) space.",
    "independent_complexity": "O(M+N^2+K*N^2) time and O(N^2) space."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
