  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[x_bits, y_bits, requested_splits]",
    "exact_length": 3,
    "x_bits_range": [1, 8],
    "y_bits_range": [1, 8],
    "sum_of_bits_maximum": 16,
    "requested_splits_range": "0..min(64, 2^x_bits-1)",
    "scale_mapping": "scx=2^x_bits, scy=2^y_bits, dmax=scx*scy-1",
    "invalid_result": -1
  },
  "output": {
    "kind": "five_signed_i64_values_as_little_endian_bytes",
    "layout": "[kernel_status, actual_splits, lower_area, upper_area, upper_minus_lower]",
    "kernel_status_values": {"NOERROR": 0, "DISCRET": 1},
    "exact_bytes": 40,
    "success_result": 40,
    "invalid_result": -1,
    "insufficient_capacity_result": -2,
    "null_output_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 40,
    "meaning": "Five little-endian signed 64-bit result fields."
  },
  "integer_semantics": {
    "function_value": "floor(scy*(scx-x)/(scx+x)) and its exact integer ceiling; numerators are nonnegative and denominators positive",
    "queue": "Maintain the source's descending error order by inserting the larger child error first; equal errors place the left child first",
    "refinement": "Each source loop pass splits the queued interval at its dyadic midpoint and replaces its area-bound contribution with the two child contributions",
    "overflow": "x_scale,y_scale <=256 and product <=65536; all intermediate products and sums fit signed i64"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
