{
  "schema_version": 1,
  "id": "bounded-integer-hint-area-refinement-v1",
  "algorithm": "hint_area_bound_refinement",
  "function_symbol": "hint_area_bound_refinement",
  "pinned_source": {
    "repository": "nfinit/ansibench",
