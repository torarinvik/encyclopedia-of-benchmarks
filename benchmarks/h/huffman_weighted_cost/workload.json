{
  "schema_version": 1,
  "id": "huffman-weighted-code-cost-i64-v1",
  "algorithm": "huffman_weighted_cost",
  "function_symbol": "huffman_weighted_cost",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[symbol_count, symbol_id, frequency, ...]",
    "symbol_count_range": [
      2,
      26
    ],
    "symbol_id_range": [
      97,
      122
    ],
    "symbol_domain": "distinct lowercase ASCII letters a-z, encoded by their ASCII values",
    "frequency_range": [
      1,
      2147483647
    ],
    "frequency_sum_maximum": 2147483647,
    "maximum_input_length": 53,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "signed_i64_little_endian_scalar",
    "encoding": "one little-endian signed 64-bit weighted bit cost",
    "return_value": "weighted bit cost",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "output_bytes": 8
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
