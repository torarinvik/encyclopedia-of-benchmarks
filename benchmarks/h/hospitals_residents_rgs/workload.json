  "algorithm": "hospitals_residents_rgs",
  "function_symbol": "hospitals_residents_rgs",
  "abi": "i64_array_bytes_output",
  "description": "Bounded many-to-one resident-oriented Gale-Shapley with capacities and incomplete acceptable lists.",
  "source": {
    "title": "Hospitals/Residents Problem",
    "authors": [
      "David F. Manlove"
    ],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_180",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_180",
    "algorithm_attribution": "Resident-oriented Gale-Shapley (RGS) deferred acceptance",
    "implementation_status": "clean-room bounded profile; no book prose or source code copied"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[resident_count, hospital_count, capacities[H], resident_lengths[R], resident_preferences[R][H] padded with -1, hospital_lengths[H], hospital_preferences[H][R] padded with -1]",
    "resident_count_range": [
      1,
      8
    ],
    "hospital_count_range": [
      1,
      8
    ],
    "capacity_range": "1..resident_count",
    "preference_length_ranges": "resident row 0..H; hospital row 0..R",
    "preference_rules": "Each row prefix contains distinct in-range IDs; all padding cells are -1; resident and hospital rows must encode mutually acceptable pairs.",
    "maximum_valid_length": 154,
    "maximum_parseable_length": 154,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "one hospital ID per resident, or -1 if the resident is unassigned",
    "maximum_values": 8,
    "maximum_bytes": 64,
    "success_result": "8 * resident_count bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Fixed preference matrices, hospital rank tables, proposal cursors, assignments, occupancies, and staged output for at most eight residents and hospitals."
  },
  "contract": {
    "proposal_rule": "Repeatedly select the lowest-ID free resident with an untried acceptable hospital and propose to the next hospital on that resident's list.",
    "hospital_rule": "Keep all current assignees when undersubscribed; otherwise retain the most preferred residents up to capacity and reject the rest.",
    "output_rule": "Return the unique resident-optimal stable assignment in resident-ID order.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
