{
  "schema_version": 1,
  "id": "happy-number-i64-v1",
  "algorithm": "happy_number",
  "input": {
    "kind": "signed_i64",
    "valid_range": [
      1,
      9223372036854775807
    ],
    "invalid_result": -1,
    "result_encoding": {
      "happy": 1,
      "unhappy": 0
    },
    "definition": "Repeatedly replace the number with the sum of the squares of its decimal digits; happy iff the sequence reaches 1."
  },
