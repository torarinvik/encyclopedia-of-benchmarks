{
  "schema_version": 1,
  "id": "half-wave-rectifier-selected-formulas-v1",
  "algorithm": "half_wave_rectifier",
  "function_symbol": "half_wave_rectifier",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[operation, arg1, arg2, arg3, arg4]",
    "operation_map": {
      "0": "max_load_current(rf, rs, rl, vm)",
      "1": "dc_current(im)",
      "2": "dc_voltage(vm)",
      "3": "max_current(vm, rl)",
      "4": "rms_current(im)",
      "5": "rms_voltage(vm)"
    },
    "value_range": [
      -1000000,
      1000000
    ],
    "unused_argument_rule": "unused arguments for selected operation must be zero",
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "formula_map": {
      "0": "vm/(rf+rs+rl)",
      "1": "im*0.318",
      "2": "vm*0.318",
      "3": "vm/rl",
      "4": "im/2",
      "5": "vm/2"
    },
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e+300
  },
  "cases": [
    {
      "id": "max_load_current",
      "input_values": [
        0,
        2,
        4,
        6,
        15
      ],
      "expected_result": 1.25
    },
    {
      "id": "dc_current",
      "input_values": [
        1,
        2,
        0,
        0,
        0
      ],
      "expected_result": 0.636
