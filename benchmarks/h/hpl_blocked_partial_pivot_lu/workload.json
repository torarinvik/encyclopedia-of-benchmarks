{
  "schema_version": 1,
  "id": "netlib-hpl-blocked-partial-pivot-lu-f64-v1",
  "algorithm": "hpl_blocked_partial_pivot_lu",
  "function_symbol": "hpl_blocked_partial_pivot_lu",
  "abi": "float64_slice_io",
  "description": "Serial width-two right-looking LU with deterministic row partial pivoting.",
  "source": {
    "title": "HPL Algorithm Description",
    "publisher": "Netlib",
    "url": "https://netlib.sandia.gov/benchmark/hpl/algorithm.html",
    "role": "algorithmic description only; clean-room bounded serial profile"
  },
  "contract": {
    "operation": "Right-looking blocked LU with row partial pivoting and fixed panel width two.",
    "input_encoding": "[n, A row-major n*n]",
    "n_range": [2, 8],
    "entry_range": [-16, 16],
    "entries_must_be_finite_exact_integers": true,
    "pivot_selection": "Choose the largest absolute entry in the active column among rows at and below the pivot; ties choose the smallest row index.",
    "row_swap": "Swap the complete rows, including previously stored L multipliers.",
    "panel_schedule": "Factor up to two columns with partial pivoting; solve the panel block row; apply a right-looking trailing update with increasing panel index.",
    "output_encoding": "n zero-based pivot row indices followed by the compact row-major LU matrix; strict-lower entries are L multipliers and diagonal/upper entries are U.",
    "zero_pivot_rule": "A zero maximum pivot is singular and returns -1.",
    "errors": {"invalid_input": -1, "null_or_short_output": -2},
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-10
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[n, row-major matrix]",
    "dimension_range": [2, 8],
    "entry_range": [-16, 16],
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "exact_length": "1+n*n",
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "n pivot rows followed by n*n compact LU values",
    "maximum_elements": 72,
    "maximum_bytes": 576,
    "success_result": "n+n*n",
    "invalid_input_result": -1,
    "null_or_short_output_result": -2,
    "no_write_on_error": true,
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-10
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded matrix, pivot vector, and staged output storage for n<=8."
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100,
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-10
  },
  "oracle_method": "Primary: two-column right-looking panel LU with panel triangular solve and trailing update. Independent: scalar one-column Gaussian elimination with partial pivoting.",
  "cases": [
    {
