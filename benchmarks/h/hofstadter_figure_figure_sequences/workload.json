    },
    {"id": "zero-term-count", "input_values": [0], "input_length": 1, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "term-count-over-bound", "input_values": [65], "input_length": 1, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "extra-input-word", "input_values": [5, 0], "input_length": 2, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "maximum-output-short-capacity", "input_values": [64], "input_length": 1, "output_capacity": 1031, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null-input", "input_values": [1], "input_length": 1, "input_is_null": true, "output_capacity": 24, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-output", "input_values": [1], "input_length": 1, "output_is_null": true, "output_capacity": 24, "expected_result": -2, "expected_output_hex": ""},
