{
  "schema_version": 1,
  "id": "hofstadter-figure-figure-paired-prefix-i64-v1",
  "algorithm": "hofstadter_figure_figure_sequences",
  "function_symbol": "hofstadter_figure_figure_sequences",
  "abi": "i64_array_bytes_output",
  "description": "Generate a bounded prefix of the Figure sequence and its complementary Space sequence.",
  "source": {
    "title": "Asymptotic Series for Hofstadter’s Figure-Figure Sequences",
    "author": "Benoît Jubin",
    "publication": "Journal of Integer Sequences, volume 17 (2014), Article 14.7.2",
    "url": "https://cs.uwaterloo.ca/journals/JIS/VOL17/Jubin/jubin2.pdf",
    "cross_reference": "Eric W. Weisstein, Hofstadter Figure-Figure Sequence, MathWorld",
    "cross_reference_url": "https://mathworld.wolfram.com/HofstadterFigure-FigureSequence.html",
    "source_license": "Copyright belongs to cited authors and publishers. References consulted for mathematical definitions and sequence values only; implementation is clean-room."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[term_count]",
    "term_count_range": [1, 64],
    "exact_length": 1,
    "maximum_valid_length": 1,
    "maximum_parseable_length": 2,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[term_count, figure_sequence_prefix, space_sequence_prefix]",
    "maximum_bytes": 1032,
    "success_result": "8*(1+2*term_count) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Two fixed 64-term signed integer arrays and bounded output staging."
  },
  "contract": {
    "initial_terms": "F_1=1 and S_1=2.",
    "figure_recurrence": "For i>1, F_i=F_(i-1)+S_(i-1).",
    "space_selection": "S_i is the least integer greater than S_(i-1) that is absent from F_1 through F_i; candidates are scanned upward.",
    "output_order": "The term count, then all F terms, then all S terms.",
    "error_precedence": "Validate the input pointer, exact length, and term count before checking output pointer and capacity.",
    "no_write_on_error": true,
    "complexity": "O(n^3) time with linear Figure-prefix membership scans and O(n) fixed storage for n<=64."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1,
    "profiles": [
      {"id": "paired-prefix-ten", "input_values": [10], "output_bytes": 168},
      {"id": "maximum-output-prefix", "input_values": [64], "output_bytes": 1032}
    ]
  },
  "cases": [
