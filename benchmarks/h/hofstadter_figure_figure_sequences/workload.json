      "input_values": [1],
      "input_length": 1,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000200000000000000"
    },
    {
      "id": "first-five-pairs",
      "input_values": [5],
      "input_length": 1,
