{
  "schema_version": 1,
  "id": "encyclopedia-robust-scheduling-single-arrival-migration-i64-array-bytes-output-v1",
  "algorithm": "robust_scheduling_single_arrival_migration",
  "function_symbol": "robust_scheduling_single_arrival_migration",
  "abi": "i64_array_bytes_output",
  "description": "Apply one source-defined robust-scheduling arrival transition on a bounded identical-machine state.",
  "source": {
    "title": "Robust Scheduling Algorithms",
    "authors": ["José Verschae"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_499",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_499",
    "algorithm_attribution": "Simplified robust-scheduling small-job/large-job steps",
    "implementation_status": "clean-room bounded one-arrival partial profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[m,n,OPT_claim,p_new,(p_i,machine_i)*n]",
    "machine_range": [2, 3],
    "old_job_count_range": [1, 8],
    "processing_time_range": [1, 20],
    "machine_ids": "Zero-based values in [0,m).",
    "maximum_valid_length": 20,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[exact_OPT,migration_volume,final_machine_id_for_each_old_job_then_new_job]",
    "maximum_bytes": 88,
    "success_result": "8 * (n + 3) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded assignment enumeration for nine jobs on three machines, loads, and staged output."
  },
  "contract": {
    "optimum": "Compute exact minimum makespan over all assignments of the n old jobs plus the arrival; reject if it differs from OPT_claim.",
    "small_job": "If 2*p_new<=OPT, assign the new job to a least-loaded machine, ties by lowest ID.",
    "large_job": "Otherwise require a machine whose old jobs all satisfy 2*p_i<=OPT and whose total old load is at least p_new. Choose the lowest-index eligible machine, remove jobs in input order until their total reaches p_new, place the new job there, then reassign removed jobs in input order to a currently least-loaded machine with lowest-ID ties.",
    "migration_volume": "Sum p_i over old jobs whose final machine ID differs from the input machine ID.",
    "partial_scope": "Only this one transition is profiled on states satisfying its stated preconditions. No startup/fallback is added and no competitive or migration-factor guarantee is claimed.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "small-job-least-load-tie",
      "input_values": [2, 2, 7, 3, 4, 0, 4, 1],
      "input_length": 8,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "07000000000000000000000000000000000000000000000001000000000000000000000000000000"
    },
    {
      "id": "large-job-remove-and-reassign",
      "input_values": [2, 3, 5, 4, 2, 0, 2, 0, 1, 0],
      "input_length": 10,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "050000000000000004000000000000000100000000000000010000000000000000000000000000000000000000000000"
    },
    {
      "id": "maximum-bounded-input-and-output",
      "input_values": [3, 8, 3, 1, 1, 0, 1, 1, 1, 2, 1, 0, 1, 1, 1, 2, 1, 0, 1, 1],
      "input_length": 20,
      "output_capacity": 88,
      "expected_result": 88,
      "expected_output_hex": "03000000000000000000000000000000000000000000000001000000000000000200000000000000000000000000000001000000000000000200000000000000000000000000000001000000000000000200000000000000"
    },
    {
      "id": "incorrect-optimum-claim",
      "input_values": [2, 3, 6, 4, 2, 0, 2, 0, 1, 0],
      "input_length": 10,
      "output_capacity": 88,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "large-job-lacks-removable-volume",
      "input_values": [2, 1, 4, 4, 1, 0],
      "input_length": 6,
      "output_capacity": 88,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
