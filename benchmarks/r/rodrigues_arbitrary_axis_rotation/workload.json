    {"id":"arbitrary-axis-negative-third-turn","input_values":[1.0,1.0,1.0,1.0,0.0,0.0,-2.0943951023931953],"input_length":7,"expected_result":3,"expected_output":[0.0,0.0,1.0]},
    {"id":"axis-parallel-vector","input_values":[1.0,2.0,2.0,2.0,4.0,4.0,1.0],"input_length":7,"expected_result":3,"expected_output":[2.0,4.0,4.0]},
