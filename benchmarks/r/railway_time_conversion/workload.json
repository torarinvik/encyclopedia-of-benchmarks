{
  "schema_version": 1,
  "id": "railway-time-conversion-normalized-ascii-v1",
  "algorithm": "railway_time_conversion",
  "function_symbol": "railway_time_conversion",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[10, ten ASCII code values for hh:mm:ssAM or hh:mm:ssPM]",
    "text_length": 10,
    "valid_hour_range": [
      1,
      12
    ],
    "valid_minute_and_second_range": [
      0,
      59
    ],
    "alphabet": "ASCII digits, colon separators, and uppercase AM or PM",
    "exact_array_length": 11,
    "maximum_parseable_array_length": 12,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "ASCII_bytes",
    "meaning": "eight ASCII bytes in HH:MM:SS 24-hour form",
    "maximum_length": 8,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "source_bound": {
    "description": "The pinned JavaScript function converts normalized hh:mm:ssAM or hh:mm:ssPM text. The benchmark accepts exactly that 10-byte ASCII form with 01..12 hours and 00..59 minutes and seconds; malformed forms are rejected by the adapter.",
    "benchmark_domain": "Valid normalized 12-hour clock times with uppercase AM or PM. The output preserves minute and second digits and returns a two-digit 24-hour hour."
  },
  "workspace": {
    "bytes": 8,
    "meaning": "maximum result length"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
