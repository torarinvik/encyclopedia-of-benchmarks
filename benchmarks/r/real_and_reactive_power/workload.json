{
  "schema_version": 1,
  "id": "real-and-reactive-power-v1",
  "algorithm": "real_and_reactive_power",
  "function_symbol": "real_and_reactive_power",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "required_length": 3,
    "layout": ["operation", "apparent_power", "factor_basis_points"],
    "operation_codes": {"0": "real_power", "1": "reactive_power"},
    "apparent_power_minimum": -1000000000,
    "apparent_power_maximum": 1000000000,
    "factor_basis_points_minimum": -10000,
    "factor_basis_points_maximum": 10000,
    "factor_decoding": "factor_basis_points / 10000.0",
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "operation 0: apparent_power * power_factor; operation 1: apparent_power * sqrt(1 - power_factor**2)",
    "unit": "same power unit as apparent_power",
    "invalid_input_result": -1e300
  },
  "cases": [
    {"id":"source-real-example","input_values":[0,100,9000],"input_length":3,"expected_result":90.0},
    {"id":"source-reactive-example","input_values":[1,100,9000],"input_length":3,"expected_result":43.58898943540673},
    {"id":"real-negative-factor","input_values":[0,100,-9000],"input_length":3,"expected_result":-90.0},
    {"id":"reactive-negative-factor","input_values":[1,100,-9000],"input_length":3,"expected_result":43.58898943540673},
    {"id":"reactive-negative-apparent-power","input_values":[1,-100,6000],"input_length":3,"expected_result":-80.0},
    {"id":"real-zero-power-factor","input_values":[0,123456,0],"input_length":3,"expected_result":0.0},
    {"id":"reactive-unit-factor-positive","input_values":[1,123456,10000],"input_length":3,"expected_result":0.0},
    {"id":"reactive-unit-factor-negative","input_values":[1,-123456,-10000],"input_length":3,"expected_result":0.0},
    {"id":"zero-apparent-power","input_values":[1,0,-5000],"input_length":3,"expected_result":0.0},
    {"id":"fractional-factor-grid","input_values":[1,80,3000],"input_length":3,"expected_result":76.15773105863909},
    {"id":"invalid-selector","input_values":[2,100,9000],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-factor-high","input_values":[0,100,10001],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-factor-low","input_values":[1,100,-10001],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-apparent-power","input_values":[0,1000000001,0],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-length","input_values":[0,100],"input_length":2,"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
}
