{
  "schema_version": 1,
  "id": "java-rotated-binary-search-i32-v1",
  "algorithm": "rotated_binary_search",
  "function_symbol": "rotated_binary_search",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "argument_order": [
      "count",
      "rotated_sorted_values...",
      "key"
    ],
    "count_range": [
      0,
      256
    ],
    "value_and_key_range": [
      -2147483648,
      2147483647
    ],
    "array_domain": "nondecreasing values rotated at a pivot; duplicates allowed",
    "invalid_input_result": -2
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "semantics": "matching array index, or -1 when absent/empty; -2 for malformed, out-of-domain, or non-i32 inputs",
    "duplicate_match": "the first midpoint match encountered by the pinned Java search",
    "comparison": "exact"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [
        0,
        42
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "single-found",
      "input_values": [
        1,
        5,
        5
      ],
      "input_length": 3,
      "expected_result": 0
    },
    {
      "id": "single-absent",
      "input_values": [
        1,
        5,
        -3
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "rotated-found",
      "input_values": [
        7,
        4,
        5,
        6,
        7,
        0,
        1,
        2,
        0
      ],
      "input_length": 9,
      "expected_result": 4
    },
    {
      "id": "rotated-absent",
      "input_values": [
        7,
        4,
        5,
        6,
        7,
        0,
        1,
        2,
        3
      ],
      "input_length": 9,
      "expected_result": -1
    },
    {
      "id": "duplicates-ambiguous",
      "input_values": [
        7,
        2,
        5,
        6,
        0,
        0,
        1,
        2,
        0
      ],
      "input_length": 9,
      "expected_result": 3
    },
    {
      "id": "all-equal-absent",
      "input_values": [
        5,
        3,
        3,
        3,
        3,
        3,
        1
      ],
      "input_length": 7,
      "expected_result": -1
    },
    {
      "id": "invalid-unsorted",
      "input_values": [
        4,
        1,
        3,
        2,
        4,
        2
      ],
      "input_length": 6,
      "expected_result": -2
    },
    {
      "id": "malformed-length",
      "input_values": [
        2,
        1,
        2
      ],
      "input_length": 3,
      "expected_result": -2
    },
    {
      "id": "out-of-i32-value",
      "input_values": [
        1,
        2147483648,
        0
      ],
      "input_length": 3,
      "expected_result": -2
    }
  ]
}
