{
  "schema_version": 1,
  "id": "rgb-to-cmyk-python-ties-even-i64-array-bytes-v1",
  "algorithm": "rgb_cmyk_conversion",
  "function_symbol": "rgb_cmyk_conversion",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[red, green, blue] integer channels",
    "exact_length": 3,
    "channel_range": [
      0,
      255
    ],
    "first_rejected_length": 4,
    "invalid_result": -1,
    "maximum_parseable_array_length": 4
  },
  "output": {
    "kind": "byte_string",
    "encoding": "four CMYK integer percentage bytes in C,M,Y,K order",
    "length": 4,
    "successful_result": "number of output bytes written"
  },
  "workspace": {
    "bytes": 4,
    "meaning": "fixed output capacity"
  },
  "source_bound": {
    "description": "The pinned Python rgb_to_cmyk function validates three integer channels, scales them to 0..1, special-cases pure black, and rounds C/M/Y/K percentages with Python ties-to-even semantics.",
    "benchmark_domain": "RGB integer channels in 0..255; the Rust source's truncating cast is a documented divergent implementation and is not the contract for this package."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
