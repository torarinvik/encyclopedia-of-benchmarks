      "input_values": [
        0,
        0,
        0
      ],
      "input_length": 3,
      "expected_result": 4,
      "expected_output_hex": "00000064"
    },
    {
      "id": "white",
      "input_values": [
        255,
        255,
        255
      ],
      "input_length": 3,
      "expected_result": 4,
