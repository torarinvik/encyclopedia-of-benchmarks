  "contract": {
    "operation": "Estimate an integral with nested composite trapezoid approximations and Richardson extrapolation in a Romberg tableau.",
    "input_encoding": "[function_id,a_micro,b_micro,levels]",
    "integer_fields": "All four finite float64 input values must represent exact integers.",
    "functions": {
      "0": "f(x)=exp(x)",
      "1": "f(x)=x^5",
      "2": "f(x)=1/(1+x^2)",
      "3": "f(x)=cos(x)"
    },
    "endpoint_scale": 1000000,
    "endpoint_micro_range": [-1000000, 1000000],
    "endpoint_order": "a_micro <= b_micro",
    "levels_range": [3, 8],
    "tableau": "R[0,0] is the one-panel trapezoid. At row k, halve the prior trapezoid estimate and add h_k times function values at the newly inserted odd-index points, where h_k=(b-a)/2^k. Then for j=1..k set R[k,j]=R[k,j-1]+(R[k,j-1]-R[k-1,j-1])/(4^j-1). Return R[levels,levels].",
    "equal_endpoints": "Return zero.",
    "output_encoding": "One float64 integral estimate.",
    "error_precedence": "Malformed input returns -1 before output validation; valid input with null output or capacity below one returns -2 without writes.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
  "input": {
    "kind": "finite_float64_array",
    "exact_length": 4,
    "maximum_valid_input_length": 4,
    "maximum_parseable_input_length": 5,
    "encoding": "[function_id,a_micro,b_micro,levels]",
    "function_id_range": [0, 3],
    "endpoint_micro_range": [-1000000, 1000000],
    "endpoint_order": "a_micro <= b_micro",
    "levels_range": [3, 8],
    "integer_valued_fields": true,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "[integral_estimate]",
    "maximum_elements": 1,
    "maximum_bytes": 8,
    "success_result": 1,
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "null_output_result": -2,
    "no_write_on_error": true,
    "absolute_tolerance": 2e-5,
    "relative_tolerance": 1e-12
  },
  "workspace": {
    "elements": 1,
    "bytes": 8,
    "meaning": "One external output estimate; two fixed nine-element rows hold the bounded tableau recurrence internally."
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100,
    "absolute_tolerance": 2e-5,
    "relative_tolerance": 1e-12
  },
  "oracle_method": "Primary: incremental nested trapezoids plus a rolling Richardson tableau. Independent: closed-form antiderivative differences for the four fixed callbacks.",
