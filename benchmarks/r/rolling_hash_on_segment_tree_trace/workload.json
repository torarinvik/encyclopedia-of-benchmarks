  "function_symbol": "rolling_hash_on_segment_tree_trace",
  "abi": "i64_array_scalar",
  "description": "Processes point assignments and dynamic substring rolling-hash comparisons using a segment tree.",
  "source": {
    "title": "Rolling Hash on Segment Tree",
    "authors": ["NyaanNyaan Library contributors"],
    "url": "https://github.com/NyaanNyaan/library/blob/master/string/rolling-hash-on-segment-tree.hpp",
    "license": "Algorithm described in source; clean-room implementation",
    "algorithm_attribution": "Store a polynomial hash and length in each segment-tree node; concatenate nodes in order, support point updates, and compare equal-length range hashes.",
    "discovery_source": "https://nyaannyaan.github.io/library/",
    "discovery_use": "Algorithm index only"
  },
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[N,Q,symbols[N],(opcode,a,b,c,d)*Q]",
    "sequence_length_range": [0, 20],
    "operation_count_range": [0, 20],
    "symbol_range": [0, 25],
    "maximum_valid_length": 122,
    "maximum_parseable_length": 123,
    "operation_codes": {
      "0": "assign symbol b at index a; c and d must be zero",
      "1": "compare half-open ranges [a,b) and [c,d)"
    },
    "hash": {
      "base": 911382323,
      "modulus": 1000000007,
      "concatenation": "(left_hash * base^right_length + right_hash) mod modulus",
      "empty_range_hash": 0,
      "different_range_lengths_compare_equal": false
    },
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "sum of i*(opcode*2+response+1) for one-based operation index i"
  },
  "workspace": {"bytes": 4096, "meaning": "fixed segment-tree nodes and precomputed powers"},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
