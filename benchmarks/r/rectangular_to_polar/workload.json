{
  "schema_version": 1,
  "id": "rectangular-to-polar-rust-rounding-f64-triple-v1",
  "algorithm": "rectangular_to_polar",
  "function_symbol": "rectangular_to_polar",
  "input": {
    "kind": "bounded_binary64_triple",
    "argument_order": [
      "real",
      "imag",
      "component"
    ],
    "coordinate_bounds": [
      -1000000.0,
      1000000.0
    ],
    "component_mapping": {
      "0": "radius, rounded to 2 decimals",
      "1": "atan2 angle in degrees, rounded to 2 decimals"
    },
    "valid_selectors": [
      0.0,
      1.0
    ],
    "invalid_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "Selected radius or degree angle rounded to 2 decimals using nearest ties away from zero",
    "invalid_result": -1e+300
  },
  "source_bound": {
    "description": "The Python and Rust sources compute magnitude and atan2 angle in degrees, then round both to two decimals. Rust explicit ties-away rounding is canonical; Python round-to-even can differ at exact decimal midpoints.",
    "benchmark_domain": "Finite coordinates in [-1,000,000,1,000,000], selector exactly 0 or 1."
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "input_scaled_tolerance": 1e-12,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
  "cases": [
