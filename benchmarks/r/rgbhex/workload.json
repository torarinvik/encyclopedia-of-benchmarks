{
  "schema_version": 1,
  "id": "rgbhex-packed-color-i64-v1",
  "algorithm": "rgbhex",
  "function_symbol": "rgbhex",
  "input": {
    "kind": "i64_array",
    "encoding": "exactly four values [op,x,y,z]; op=0 decodes unsigned 32-bit packed RGB in x with y=z=0; op=1 encodes byte channels x,y,z",
    "length": 4,
    "operations": {
      "0": "HEXToRGB(uint32(x)), repacked as (red<<16)|(green<<8)|blue",
      "1": "RGBToHEX(uint8(x),uint8(y),uint8(z))"
    },
    "invalid_record_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "packed 24-bit RGB value (red<<16)|(green<<8)|blue",
    "valid_range": [
      0,
      16777215
    ],
    "invalid_record_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
