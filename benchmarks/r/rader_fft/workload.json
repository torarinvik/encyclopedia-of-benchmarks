  "contract": {
    "operation": "five-point unnormalized complex forward DFT using Rader primitive-root permutation and cyclic convolution",
    "formula": "X[k] = sum(x[n] * exp(-2*pi*i*k*n/5), n=0..4)",
    "primitive_root_mod_5": 2,
    "input_permutation": [1, 2, 4, 3],
    "reversed_kernel_powers": [1, 3, 4, 2],
    "convolution": "linear convolution of length-4 sequences padded to length 8, then folded modulo 4",
    "output_order": "interleaved real and imaginary components for X[0] through X[4]"
  },
  "workspace": {
    "elements": 42,
    "meaning": "Two zero-padded length-8 complex work arrays and a ten-element staged output."
  },
