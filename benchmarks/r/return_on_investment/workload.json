{
  "schema_version": 1,
  "id": "return_on_investment-packed-i64-binary64-v1",
  "algorithm": "return_on_investment",
  "function_symbol": "return_on_investment",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": [
      "gain",
      "cost"
    ],
    "exact_length": 2,
    "value_domain": "gain in [-1,000,000, 1,000,000], cost in [1, 1,000,000]",
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "(gain - cost) / cost",
    "invalid_input_result": -1e+300,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "source_example",
      "input_values": [
        1200,
        1000
      ],
      "input_length": 2,
      "expected_result": 0.2
    },
    {
      "id": "investment_loss",
      "input_values": [
        800,
        1000
      ],
      "input_length": 2,
      "expected_result": -0.2
    },
    {
      "id": "gain_above_cost",
      "input_values": [
        250000,
        200000
      ],
      "input_length": 2,
      "expected_result": 0.25
    },
    {
      "id": "zero_cost",
      "input_values": [
        1200,
        0
      ],
      "input_length": 2,
      "expected_result": -1e+300
    },
    {
      "id": "wrong_input_length",
      "input_values": [
        1200
      ],
      "input_length": 1,
      "expected_result": -1e+300
    }
  ]
}
