  "schema_version": 1,
  "id": "reverse-polish-notation-ascii-i64-to-float64-v1",
  "algorithm": "reverse_polish_notation",
  "function_symbol": "reverse_polish_notation",
  "input": {
    "kind": "signed_i64_array",
    "layout": "raw ASCII code values for one expression with tokens separated by one ASCII space",
    "text_length_range": [
      1,
      255
    ],
    "maximum_parseable_array_length": 256,
    "character_range": [
      0,
      127
    ],
    "maximum_tokens": 63,
    "operand_grammar": "optional sign followed by one or more decimal digits",
    "operand_magnitude_range": [
      0,
      1000000
    ],
    "operators": [
      "+",
      "-",
      "*",
      "/"
    ],
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "float64",
    "meaning": "the final result of the pinned stack evaluation",
    "operand_order": "operator receives a=top and b=next; plus, minus, multiply return a op b; division returns b/a",
    "maximum_intermediate_magnitude": 1e+200,
    "invalid_input_result": -1e+300,
    "division_by_zero_result": -1e+300
  },
  "source_bound": {
    "description": "The pinned JavaScript source splits on a single space, parses operand tokens with parseFloat, pops a then b, and defines division as b/a. This bounded adapter accepts signed decimal integers and the four source operators, requires one final stack value, and normalizes malformed or non-finite cases to the invalid sentinel.",
    "benchmark_domain": "ASCII expressions of at most 255 bytes and 63 tokens, with signed integer operands of magnitude at most 1,000,000. Intermediate results must be finite and have magnitude at most 1e200."
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
