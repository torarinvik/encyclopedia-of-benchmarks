{
  "schema_version": 1,
  "id": "rolling-hash-2d-rectangle-query-i64-array-bytes-output-v1",
  "algorithm": "rolling_hash_2d_rectangle_query",
  "function_symbol": "rolling_hash_2d_rectangle_query",
  "abi": "i64_array_bytes_output",
  "description": "Precompute two-dimensional polynomial fingerprints and return normalized hashes for half-open rectangle queries.",
  "source": {
    "title": "Two-Dimensional Rolling Hash",
    "authors": ["Nyaan"],
    "reference": "Nyaan's Library, string/rolling-hash-2d.hpp",
    "url": "https://nyaannyaan.github.io/library/string/rolling-hash-2d.hpp",
    "catalog_url": "https://nyaannyaan.github.io/library/",
    "algorithm_attribution": "row/column polynomial prefixes, axis-specific powers, and four-corner rectangle extraction",
    "implementation_status": "clean-room deterministic fixed-parameter profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[H,W,Q, grid(H*W row-major values), (r0,c0,r1,c1)*Q]",
    "height_range": [1, 32],
    "width_range": [1, 32],
    "query_count_range": [1, 128],
    "symbol_range": [0, 255],
    "rectangle_coordinates": "Half-open [r0,r1) x [c0,c1), with 0 <= r0 <= r1 <= H and 0 <= c0 <= c1 <= W; zero-area rectangles are valid.",
    "exact_length": "3 + H*W + 4*Q",
    "maximum_valid_length": 1539,
    "maximum_parseable_length": 1540,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "One normalized rectangle hash per query, in query order; each value is in [0, 1000000007).",
    "hash": "For rectangle-local coordinates i,j, sum grid[i,j] * 31^(height-1-i) * 37^(width-1-j) modulo 1000000007.",
    "maximum_output_bytes": 1024,
    "success_result": "8*Q bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "33 by 33 modular prefix table, row and column powers, and staged output for at most 128 queries."
  },
  "contract": {
    "modulus": 1000000007,
    "row_base": 31,
    "column_base": 37,
    "normalization": "The returned powers are relative to the rectangle's bottom and right edges, independent of its position in the source grid.",
    "prefix_method": "Build row-wise polynomial values and extend each prefix down the rows; extract each rectangle with four prefix terms and the two axis-specific powers.",
    "collision_note": "The result is a deterministic polynomial fingerprint, not an exact collision-free encoding."
  },
  "complexity": {
    "time": "O(H*W + Q)",
    "auxiliary_space": "O(H*W + H + W + Q)"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
