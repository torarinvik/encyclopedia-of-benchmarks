      "expected_output_hex": "0100000000000000110000000000000017000000000000000900000000000000"
    },
    {
      "id": "single-element-affine-composition",
      "input_values": [1, 3, 4, 0, 0, 1, 2, 1, 0, 0, 1, 3, 2, 1, 0],
