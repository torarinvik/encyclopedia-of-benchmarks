{
  "schema_version": 1,
  "id": "resistor-equivalence-v1",
  "algorithm": "resistor_equivalence",
  "function_symbol": "resistor_equivalence",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "minimum_length": 2,
    "maximum_length": 33,
    "layout": ["operation", "resistor_values_ohms"],
    "operation_mapping": {"0": "parallel", "1": "series"},
    "resistor_minimum_ohms": 0,
    "resistor_maximum_ohms": 1000,
    "parallel_resistor_minimum_ohms": 1,
    "maximum_resistor_count": 32,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "operation 0: reciprocal of sequential reciprocal sum; operation 1: sequential resistor sum",
    "unit": "ohm",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "cases": [
    {"id":"parallel-three-resistors","input_values":[0,3,2,3],"input_length":4,"expected_result":0.8571428571428572},
    {"id":"parallel-equal-pair","input_values":[0,10,10],"input_length":3,"expected_result":5.0},
    {"id":"parallel-single-resistor","input_values":[0,7],"input_length":2,"expected_result":7.0},
    {"id":"series-three-resistors","input_values":[1,3,2,3],"input_length":4,"expected_result":8.0},
    {"id":"series-zero-values","input_values":[1,0,2,0],"input_length":4,"expected_result":2.0},
    {"id":"series-single-zero","input_values":[1,0],"input_length":2,"expected_result":0.0},
    {"id":"invalid-empty","input_values":[],"input_length":0,"expected_result":-1e300},
    {"id":"invalid-missing-resistors","input_values":[0],"input_length":1,"expected_result":-1e300},
    {"id":"invalid-operation","input_values":[2,5],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-parallel-zero","input_values":[0,5,0],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-series-negative","input_values":[1,5,-1],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-above-bound","input_values":[1,1001],"input_length":2,"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
}
