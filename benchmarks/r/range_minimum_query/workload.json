{
  "schema_version": 1,
  "id": "range-minimum-query-sparse-table-v1",
  "algorithm": "range_minimum_query",
  "function_symbol": "range_minimum_query",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[n, values[n], q, (start,end)[q]]",
    "n_range": [
      1,
      64
    ],
    "value_range": [
      -1000,
      1000
    ],
    "q_range": [
      1,
      64
    ],
    "query_convention": "half-open [start,end), 0 <= start < end <= n",
    "invalid_packing_result": -1,
    "invalid_query_value": -9223372036854775808,
    "insufficient_capacity_result": -2,
    "output_encoding": "q signed 64-bit answers concatenated as little-endian bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
