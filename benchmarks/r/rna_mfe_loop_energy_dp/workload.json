{
  "schema_version": 1,
  "id": "encyclopedia-rna-mfe-loop-energy-dp-i64-array-bytes-output-v1",
  "algorithm": "rna_mfe_loop_energy_dp",
  "function_symbol": "rna_mfe_loop_energy_dp",
  "abi": "i64_array_bytes_output",
  "description": "Minimize supplied loop energies over bounded noncrossing RNA secondary structures using V/W interval dynamic programming.",
  "source": {
    "title": "RNA Secondary Structure Prediction by Minimum Free Energy",
    "authors": [
      "Rune B. Lyngsø"
    ],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_347",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_347",
    "algorithm_attribution": "V[i,j] minimum-energy loop recurrence and W[i] prefix recurrence",
    "implementation_status": "clean-room bounded profile with supplied integer loop-energy table"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,bases[n],loop_costs[6][13][3]]",
    "n_range": [
      4,
      12
    ],
    "base_encoding": "A=0,C=1,G=2,U=3",
    "pair_types": [
      "AU",
      "UA",
      "CG",
      "GC",
      "GU",
      "UG"
    ],
    "minimum_pair_index_separation": 4,
    "loop_table_values_range": [
      -1000,
      1000
    ],
    "maximum_valid_length": 247,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[minimum_energy,pair_count,(i,j)*pair_count]",
    "maximum_bytes": 112,
    "success_result": "8*(2+2*pair_count) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "Bounded V and W energy tables, pair-set masks, candidate pairs, and staged output."
  },
  "contract": {
    "energy_table_index": "type_index*39 + accessible_unpaired_count*3 + direct_child_pair_count; type order AU,UA,CG,GC,GU,UG; unpaired count 0..12; child count 0..2.",
    "v_recurrence": "For each allowed closing pair (i,j), minimize the supplied loop cost plus V for each direct child pair; child intervals are ordered and disjoint. The bounded n<=12/minimum-separation-4 domain admits at most two direct children.",
    "w_recurrence": "For each prefix ending at j, choose between leaving j unpaired and pairing it with i using W[i-1]+V[i,j], with empty-prefix cost zero.",
    "tie_rule": "Among equal energies choose the lexicographically smallest ascending list of (i,j) pairs.",
    "profile_scope": "A supplied integer table specifies loop energies; this is a bounded scoring model and does not claim calibrated nearest-neighbor parameters or handle pseudoknots.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
