  "contract": {
    "operation": "Run source kernel 1 (neighbor differences and saturated SRAD coefficient) then kernel 2 (divergence and J update), once, over one 16x16 block.",
    "input_layout": "[lambda_f32_bits, q0sqr_f32_bits, row_major_16x16_J_f32_bits...]",
    "exact_input_length": 258,
    "lambda_range": [
      0.01,
      0.1
    ],
    "q0sqr_range": [
      0.01,
      1
    ],
    "image_state_range": [
      "1.0f",
      "1.25f"
    ],
    "float_encoding": "Each parameter/state is supplied as an unsigned IEEE-754 binary32 bit pattern carried in a nonnegative signed-i64 slot.",
    "edge_rule": "Kernel 1 replicates the current J value for neighbors outside the 16x16 image. Kernel 2 uses the current cell's coefficient for north and west, and the next cell's coefficient for south and east, replicating at the bottom/right edge.",
    "arithmetic": "Float state and named float stores round to binary32. The pinned unsuffixed constants in num, den, c, and the final J update promote those expressions to binary64 before the float assignment; ports preserve those promotion points.",
    "output_projection": "Ascending row-major sum of floor(double(J_final_f32)*1,000,000 + 0.5) per cell.",
    "invalid_result": -1
  },
