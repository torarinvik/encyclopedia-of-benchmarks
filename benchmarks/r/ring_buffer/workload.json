{
  "schema_version": 1,
  "id": "ring-buffer-capacity-8-state-trace-v1",
  "algorithm": "ring_buffer",
  "function_symbol": "ring_buffer",
  "input": {
    "kind": "signed_i64_array_packed_ring_buffer_operations",
    "encoding": "[q, (opcode, payload) repeated q times]",
    "opcodes": {
      "0": "push value",
      "1": "pop",
      "2": "peek front",
      "3": "peek back",
      "4": "get FIFO-relative index",
      "5": "clear",
      "6": "length",
      "7": "available capacity",
      "8": "is empty",
      "9": "is full"
    },
    "operation_count_range": [0, 256],
    "length_range": [1, 513],
    "push_value_range": [-1000000, 1000000],
    "get_index_range": [0, 1000000],
    "capacity": 8,
    "status_codes": {
      "0": "success",
      "1": "BufferFull",
      "2": "BufferEmpty",
      "3": "IndexOutOfBounds"
    },
    "invalid_result": -1,
    "output": "rolling state trace hash with multiplier 1000003 and modulus 1000000007"
  },
  "cases": [
    {
