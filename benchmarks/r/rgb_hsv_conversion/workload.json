{
  "schema_version": 1,
  "id": "rgb-to-hsv-pinned-cross-language-f64le-v1",
  "algorithm": "rgb_hsv_conversion",
  "function_symbol": "rgb_hsv_conversion",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[red, green, blue] integer channels",
    "exact_length": 3,
    "channel_range": [
      0,
      255
    ],
    "maximum_valid_array_length": 3,
    "maximum_parseable_array_length": 4,
    "invalid_result": -1
  },
  "output": {
    "kind": "byte_string",
    "encoding": "three IEEE-754 binary64 values in little-endian order: hue degrees, saturation, value",
    "length": 24,
    "successful_result": "number of output bytes written"
  },
  "workspace": {
    "bytes": 24,
    "meaning": "fixed output capacity"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "black",
      "input_values": [
        0,
        0,
        0
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "000000000000000000000000000000000000000000000000"
    },
    {
      "id": "white",
      "input_values": [
        255,
        255,
        255
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "00000000000000000000000000000000000000000000f03f"
    },
    {
      "id": "red",
      "input_values": [
        255,
        0,
        0
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000000000000000000000f03f000000000000f03f"
    },
    {
      "id": "yellow",
      "input_values": [
        255,
        255,
        0
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000004e40000000000000f03f000000000000f03f"
    },
    {
      "id": "green",
      "input_values": [
        0,
        255,
        0
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000005e40000000000000f03f000000000000f03f"
    },
    {
      "id": "blue",
      "input_values": [
        0,
        0,
        255
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000006e40000000000000f03f000000000000f03f"
    },
    {
      "id": "magenta",
      "input_values": [
        255,
        0,
        255
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000c07240000000000000f03f000000000000f03f"
    },
    {
      "id": "source-64-128-128",
      "input_values": [
        64,
        128,
        128
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000806640000000000000e03f101010101010e03f"
    },
    {
      "id": "source-193-196-224",
      "input_values": [
        193,
        196,
        224
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "c418638c31466d406edbb66ddbb6c13f1c1c1c1c1c1cec3f"
    },
    {
      "id": "source-128-32-80",
      "input_values": [
        128,
        32,
        80
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000a07440000000000000e83f101010101010e03f"
    },
    {
      "id": "red-hue-wrap",
      "input_values": [
        255,
        0,
        1
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "3c3c3c3c3c7c7640000000000000f03f000000000000f03f"
    },
    {
      "id": "green-blue-tie",
      "input_values": [
        0,
        255,
        255
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000806640000000000000f03f000000000000f03f"
    },
    {
      "id": "equal-channel-midgray",
      "input_values": [
        128,
        128,
        128
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "00000000000000000000000000000000101010101010e03f"
    },
    {
      "id": "small-channel-difference",
      "input_values": [
        100,
        101,
        100
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000005e40e7d96265f846843f595959595959d93f"
    },
    {
      "id": "invalid-empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-two",
      "input_values": [
        1,
        2
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-four",
      "input_values": [
        1,
        2,
        3,
        4
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-negative",
      "input_values": [
        1,
        -1,
        3
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-over-255",
      "input_values": [
        1,
        256,
        3
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "capacity-too-small",
      "input_values": [
        64,
        128,
        128
      ],
      "input_length": 3,
      "expected_result": -2,
      "expected_output_hex": "",
      "workspace_bytes": 23
    },
    {
      "id": "capacity-exact",
      "input_values": [
        64,
        128,
        128
      ],
      "input_length": 3,
      "expected_result": 24,
      "expected_output_hex": "0000000000806640000000000000e03f101010101010e03f",
      "workspace_bytes": 24
