    "prng": {
      "word_width": 32,
      "initial_state": "input seed",
      "transition": "state=(1664525*state+1013904223) mod 2^32; a raw draw returns the updated state",
      "bounded_draw": "threshold=2^32 mod bound; redraw while raw<threshold; return raw mod bound",
      "rejected_draw_state": "Every rejected raw draw advances and retains the LCG state."
    }
  },
  "operations": {
    "record_width": 4,
    "0": "(0,tree,key,0): insert key if absent",
    "1": "(1,tree,key,0): erase key if present",
    "2": "(2,tree,k,0): one-based kth key; k is 1..65; answer -1 if k exceeds size",
    "3": "(3,source,destination,pivot): source retains keys <pivot and destination receives keys >=pivot; IDs differ and destination must be empty",
    "4": "(4,left,right,0): ordered join into left, then clear right; IDs differ and all left keys must be smaller than all right keys; empty sides are allowed and consume no random draw"
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "sum(query_number*(answer+1)) over kth queries, with query_number one-based among kth queries",
    "valid_result_range": [0, 528528],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed storage for at most 64 allocated nodes, two roots, recursion state, and the bounded trace."
  },
  "complexity": {
    "primary_expected_time": "O((N+Q) log 64) for randomized updates and join, O(log 64) per kth query; split is O(64) worst case",
    "primary_auxiliary_space": "O(64)",
    "independent_reference_time": "O((N+Q)*64)",
    "independent_reference_space": "O(64)"
  },
  "oracle_method": "The primary uses Martínez–Roura subtree-size randomized insertion/join with subtree-size selection. The independent oracle stores each tree as a sorted list and models split, join, updates, and kth answers by ordered-list operations.",
