{
  "schema_version": 1,
  "id": "reverse-words-ascii-space-separated-v1",
  "algorithm": "reverse_words",
  "function_symbol": "reverse_words",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[byte_length, ASCII bytes...]",
    "byte_length_range": [
      0,
      256
    ],
    "byte_range": [
      32,
      126
    ],
    "word_bytes": [
      33,
      126
    ],
    "separator": "single ASCII space between words; no leading or trailing spaces",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "NUL_terminated_ASCII_bytes",
    "encoding": "Words in reverse order, preserving bytes within each word.",
    "successful_result": "Output bytes before the NUL terminator."
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [
        0
      ],
      "expected_result": 0,
      "expected_output_hex": "00"
    },
    {
      "id": "one-word",
      "input_values": [
        5,
        104,
        101,
        108,
        108,
        111
      ],
      "expected_result": 5,
      "expected_output_hex": "68656c6c6f00"
    },
    {
      "id": "multiple-words",
      "input_values": [
        13,
        73,
        32,
        108,
        111,
        118,
        101,
        32,
        80,
        121,
        116,
        104,
        111,
        110
      ],
      "expected_result": 13,
      "expected_output_hex": "507974686f6e206c6f7665204900"
    },
    {
      "id": "punctuation",
      "input_values": [
        13,
        104,
        101,
        108,
        108,
        111,
        44,
        32,
        119,
        111,
        114,
        108,
        100,
        33
      ],
      "expected_result": 13,
      "expected_output_hex": "776f726c64212068656c6c6f2c00"
    },
    {
      "id": "two-words",
      "input_values": [
        8,
        115,
        101,
        99,
        111,
        110,
        100,
        32,
        102
      ],
      "expected_result": 8,
      "expected_output_hex": "66207365636f6e6400"
    },
    {
      "id": "malformed-before-capacity",
      "input_values": [
        3,
        65,
        32,
        32
      ],
      "expected_result": -1,
      "expected_output_hex": "",
      "workspace_bytes": 0
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 0,
    "repetitions_per_sample": 1
  }
}
