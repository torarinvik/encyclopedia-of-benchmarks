  "workspace": {"bytes": 8192, "meaning": "Fixed permutation, bounded DFS recursion state, and staged output for at most 4! rows."},
  "contract": {
    "root": "The identity permutation 1,2,...,n.",
    "parent": "For a nonidentity permutation, find the minimum 1-based index r with p_r>p_(r+1), then swap p_r and p_(r+1).",
    "reverse_point": "r is the first descent index; for the identity set r=n.",
    "children_in_order": "For i=1,...,r-1, swap p_i and p_(i+1) and recursively visit that child. Then, if r+2<=n and p_r<p_(r+2), swap p_(r+1) and p_(r+2) and visit that child.",
    "traversal": "Depth-first preorder: emit the current permutation before visiting its children in the order above.",
    "output_error_result": -2
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "oracle_method": "The primary oracle follows the reverse-point child formula. The independent verifier enumerates candidate permutations, computes each candidate's parent from its first descent, and traverses children ordered by swap position.",
