  "algorithm": "clique_reverse_search_enumeration",
  "function_symbol": "clique_reverse_search_enumeration",
  "abi": "i64_array_bytes_output",
  "description": "Enumerate every clique, including the empty clique and nonmaximal cliques, by the DOI 731 smallest-index-parent reverse-search tree.",
  "source": {
    "title": "Reverse Search; Enumeration Algorithms",
    "authors": ["Masashi Kiyomi"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_731",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_731",
    "algorithm_attribution": "The chapter's concrete clique example roots at the empty clique and makes the parent by removing the smallest-index vertex.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, adjacency_mask_for_vertex_0,...,adjacency_mask_for_vertex_(n-1)]",
    "vertex_count_range": [1, 8],
    "adjacency_mask_range": "0..(2^n-1), with the diagonal bit clear",
    "graph_requirement": "Undirected simple graph represented by symmetric adjacency masks.",
    "maximum_valid_length": 9,
    "maximum_parseable_length": 9,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_vector",
    "encoding": "little-endian signed 64-bit clique_count followed by one unsigned byte per clique mask in DFS preorder; bit v names vertex v; the empty clique has mask 0",
    "maximum_bytes": 264,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {"bytes": 2048, "meaning": "At most 8 adjacency masks, 256 clique masks, recursion state, and staged output."},
  "contract": {
    "root": "The empty clique.",
    "parent": "For each nonempty clique, remove its smallest-index vertex.",
    "children": "A child adds a vertex smaller than every current clique vertex and adjacent to all vertices already in the clique; every child remains a clique.",
    "child_order": "Visit eligible added vertices in increasing index order.",
    "traversal": "Depth-first preorder, including the root before its descendants.",
    "output_error_result": -2
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "oracle_method": "The primary oracle generates eligible smaller-index extensions directly. The independent verifier enumerates all n-bit subsets, filters cliques, computes each parent by removing its least significant set bit, then traverses children by the added vertex index.",
