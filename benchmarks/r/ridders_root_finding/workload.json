  },
  "contract": {
    "operation": "Find a real root in a sign-changing interval using Ridders' midpoint-based exponential interpolation update.",
    "input_encoding": "[function_id,left_milli,right_milli,tolerance_micro,max_iterations]",
    "integer_fields": "All five finite float64 input values must represent exact integers.",
    "functions": {
      "0": "f(x)=x^2-2",
      "1": "f(x)=x^3-2",
      "2": "f(x)=x^3+x-1",
      "3": "f(x)=x"
    },
    "endpoint_scale": 1000,
    "endpoint_milli_range": [-3000, 3000],
    "endpoint_order": "left_milli < right_milli",
    "bracket_rule": "At least one endpoint must be an exact root, or endpoint function values must have opposite signs. The supported functions have at most one root in any accepted sign-changing interval.",
    "tolerance": "tolerance_micro/1,000,000; the accepted interval is closed when its width is at most this value.",
    "tolerance_micro_range": [1, 1000],
    "iteration_limit_range": [24, 32],
    "update": "Return an exact endpoint root first, then an exact midpoint root. Otherwise compute D=sqrt(f(m)^2-f(left)*f(right)) and z=m+(m-left)*sign(f(left)-f(right))*f(m)/D. Replace the endpoint with the same sign as f(z), preserving a sign-changing bracket. A nonpositive/nonfinite radicand, zero/nonfinite denominator, or candidate outside the open bracket returns numerical-failure status -3 without writes.",
    "stopping_rule": "After an endpoint or midpoint exact-root check, return the bracket midpoint when width<=tolerance. If the iteration cap is reached first, return -3 without writes.",
    "output_encoding": "One float64 root estimate.",
    "error_precedence": "Malformed or unbracketed input returns -1 before output validation; valid input with null output or capacity below one returns -2 without writes; numerical failure or cap exhaustion returns -3 without writes.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "numerical_failure_result": -3,
    "no_write_on_error": true
  },
  "input": {
