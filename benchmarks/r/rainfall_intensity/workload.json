{
  "schema_version": 1,
  "id": "rainfall-intensity-v1",
  "algorithm": "rainfall_intensity",
  "function_symbol": "rainfall_intensity",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "exact_length": 6,
    "argument_order": ["coefficient_k", "coefficient_a", "coefficient_b", "coefficient_c", "return_period_years", "duration_minutes"],
    "bounds": {"coefficient_k": [1, 1000], "coefficient_a": [1, 3], "coefficient_b": [1, 100], "coefficient_c": [1, 3], "return_period_years": [1, 100], "duration_minutes": [1, 1000]},
    "normalized_input_subset": "All positive parameters are bounded integers.",
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "unit": "millimetre per hour",
    "definition": "(coefficient_k * return_period_years**coefficient_a) / ((duration_minutes + coefficient_b)**coefficient_c)",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {"id":"linear-return-period","input_values":[1000,1,10,1,10,60],"input_length":6,"expected_result":142.85714285714286},
    {"id":"squared-return-and-duration","input_values":[100,2,10,2,20,30],"input_length":6,"expected_result":25.0},
    {"id":"cubed-powers","input_values":[1,3,1,3,10,9],"input_length":6,"expected_result":1.0},
    {"id":"maximum-intensity-bound","input_values":[1000,3,1,1,100,1],"input_length":6,"expected_result":500000000.0},
    {"id":"small-positive-result","input_values":[1,1,100,3,1,1000],"input_length":6,"expected_result":7.513148009015778e-10},
    {"id":"invalid-zero-coefficient","input_values":[0,1,10,1,10,60],"input_length":6,"expected_result":-1e300},
    {"id":"invalid-zero-period","input_values":[1000,1,10,1,0,60],"input_length":6,"expected_result":-1e300},
    {"id":"invalid-zero-duration","input_values":[1000,1,10,1,10,0],"input_length":6,"expected_result":-1e300},
    {"id":"invalid-negative-value","input_values":[1000,1,-1,1,10,60],"input_length":6,"expected_result":-1e300},
    {"id":"invalid-above-bound","input_values":[1001,1,10,1,10,60],"input_length":6,"expected_result":-1e300},
