{
  "schema_version": 1,
  "id": "rodinia-pathfinder-bounded-grid-dp-v1",
  "algorithm": "rodinia_pathfinder",
  "function_symbol": "rodinia_pathfinder",
  "abi": "i64_array_scalar",
  "input": {
    "kind": "packed_i64_array",
    "layout": "[cols, rows, pyramid_height, row-major cell_cost...]",
    "cols_range": [1, 32],
    "rows_range": [1, 32],
    "pyramid_height_range": [1, 4],
    "cell_cost_range": [0, 9],
    "maximum_input_values": 1027
  },
  "output": {
    "kind": "i64_scalar",
    "meaning": "minimum accumulated cost in the final row",
    "invalid_input_result": -1
  },
  "cases": [
    {
      "id": "single_row_minimum",
      "input_values": [3, 1, 2, 5, 1, 4],
      "expected_result": 1
    },
    {
      "id": "single_column_accumulates_all_rows",
      "input_values": [1, 4, 2, 2, 1, 3, 0],
      "expected_result": 6
    },
    {
      "id": "three_by_three_path_and_two_step_chunk",
      "input_values": [3, 3, 2, 1, 9, 1, 1, 1, 9, 9, 1, 1],
      "expected_result": 3
    },
    {
      "id": "edge_clamping_and_tied_paths",
      "input_values": [2, 3, 1, 0, 0, 1, 1, 0, 0],
      "expected_result": 1
    },
    {
      "id": "chunk_larger_than_remaining_rows",
      "input_values": [4, 4, 4, 9, 8, 7, 6, 1, 5, 9, 9, 1, 3, 4, 8, 2, 1, 0, 9, 3],
      "expected_result": 11
    },
    {
      "id": "invalid_empty_input",
      "input_values": [],
      "expected_result": -1
    },
    {
      "id": "invalid_pyramid_height",
      "input_values": [2, 2, 0, 1, 2, 3, 4],
      "expected_result": -1
    },
    {
      "id": "invalid_cell_cost",
      "input_values": [2, 2, 1, 0, 10, 1, 0],
      "expected_result": -1
    },
    {
      "id": "invalid_trailing_value",
      "input_values": [1, 1, 1, 4, 5],
      "expected_result": -1
    }
  ]
}
