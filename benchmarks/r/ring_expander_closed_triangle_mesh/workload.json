  "algorithm": "ring_expander_closed_triangle_mesh",
  "function_symbol": "ring_expander_closed_triangle_mesh",
  "description": "Replay one seeded Ring-Expander traversal over a bounded connected closed oriented triangle mesh.",
  "pinned_sources": [
    {
      "repository": "Encyclopedia of Algorithms EPUB supplied by the user",
      "chapter": "Triangulation Data Structures",
      "doi": "10.1007/978-1-4939-2864-4_589",
