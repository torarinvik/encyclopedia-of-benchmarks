    },
    {
      "repository": "ACM Transactions on Graphics",
      "title": "LR: Compact Connectivity Representation for Triangle Meshes",
      "doi": "10.1145/1964921.1964962",
      "section": "4.2",
      "role": "operational Ring-Expander procedure and corner operators"
    }
  ],
  "contract": {
    "operation": "Run one source-defined Ring-Expander pass from a supplied corner, recording each loop-body corner and the final visited vertex/triangle masks.",
    "input_layout": "[n,t,seed_corner,oriented_triangle_vertex_ids[3*t]]",
    "mesh_domain": "Connected closed consistently oriented simplicial 2-manifold; every vertex is used, faces are unique with three distinct vertices, each undirected edge has exactly two oppositely oriented incidences, and every vertex link is one connected cycle.",
    "corner_numbering": "Corner 3*triangle+j is local vertex j; n=(j+1) mod 3, p=(j+2) mod 3, o is the corner across the opposite edge with reversed endpoints, and r=p.o.",
    "initialization": "All marks false; c=seed_corner; mark c.n.v and c.p.v.",
    "transition": "At each loop body record c. If c.v is unmarked, mark c.v and c.t. Else if c.t is unmarked, set c=c.o. Then set c=c.r. Stop when the new c equals the original seed.o.",
    "complexity": "Native ports: edge-incidence/opposite-corner setup O(t+v^2), dense vertex-link validation O(v^3), and Ring-Expander walk O(t). The independent oracle scans all face edges for each opposite-corner lookup, O(t^2).",
    "output_encoding": "Little-endian signed-i64 [trace_count,trace_corner_ids...,visited_vertex_mask,visited_triangle_mask]; bit i names vertex/triangle i.",
    "bounds": {
      "vertices": [4, 12],
      "triangles": [4, 20],
      "seed_corner": "0 <= seed_corner < 3*t",
      "valid_input_words_max": 63,
      "parseable_input_words_max": 64,
      "trace_corners_max": 60,
      "output_bytes_max": 504,
      "workspace_bytes": 8192
    },
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Complete input, topology, and traversal validation before null-output or capacity handling."
  },
  "input": {
    "kind": "signed_i64_array",
    "maximum_valid_input_length": 63,
    "maximum_parseable_input_length": 64,
    "invalid_result": -1
  },
  "output": {
