{
  "schema_version": 1,
  "id": "encyclopedia-ring-exact-covering-protocol-i64-array-bytes-output-v1",
  "algorithm": "ring_exact_covering_protocol",
  "function_symbol": "ring_exact_covering_protocol",
  "pinned_source": {
    "title": "Uniform Covering of Rings and Lines by Memoryless Mobile Sensors",
    "author": "Paola Flocchini",
    "doi": "10.1007/978-1-4939-2864-4_594",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_594",
    "license": "No source-code license asserted; clean-room mathematical protocol"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,visibility,steps,positions[n],activation_ids[steps]]",
    "sensor_count_range": [2, 12],
    "position_scale_per_target_gap": 16,
    "ring_circumference": "16*n",
    "visibility_range": "32..16*n",
    "activation_count_range": [0, 64],
    "maximum_valid_length": 79,
    "invalid_result": -1
  },
  "contract": {
    "protocol": "For each supplied sensor activation, inspect its clockwise successor gap. If gap exceeds visibility, move 16 units clockwise; otherwise, if gap exceeds 16, move to the point 16 units before the successor; otherwise stay.",
    "activation_model": "A supplied serial schedule; each move completes before the next activation. This is a discrete asynchronous trace, not a fairness or convergence guarantee.",
    "preconditions": "Initial positions are distinct increasing integer coordinates in [0,16*n), giving the labeled clockwise order. Common orientation, known target distance 1, and visibility at least 2 are assumed.",
    "output": "[n,moved_count,final_positions_by_sensor,final_clockwise_gaps_by_sensor]",
    "profile_scope": "Exact source protocol on positions quantized to multiples of 1/16 target-distance units."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[n,moved_count,positions[n],gaps[n]]",
    "maximum_bytes": 208,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Fixed arrays for twelve sensor positions, movement state, and staged output."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 3,
    "warmup_rounds": 1,
    "repetitions_per_sample": 3
  },
  "cases": [
    {
      "id": "already-uniform",
      "input_values": [4, 32, 0, 0, 16, 32, 48],
      "input_length": 7,
      "output_capacity": 208,
      "expected_result": 80,
      "expected_output_hex": "0400000000000000000000000000000000000000000000001000000000000000200000000000000030000000000000001000000000000000100000000000000100000000000000010000000000000001000000000000000"
    },
    {
      "id": "visible-gap-equalization",
      "input_values": [4, 32, 2, 0, 10, 32, 42, 1, 3],
      "input_length": 9,
      "output_capacity": 208,
      "expected_result": 80,
      "expected_output_hex": "0400000000000000020000000000000000000000000000001000000000000000200000000000000030000000000000001000000000000000100000000000000100000000000000010000000000000001000000000000000"
    },
    {
      "id": "invisible-successor-advances-one-target-gap",
      "input_values": [4, 32, 1, 0, 4, 40, 44, 1],
      "input_length": 8,
      "output_capacity": 208,
      "expected_result": 80,
      "expected_output_hex": "040000000000000001000000000000000000000000000000140000000000000028000000000000002c000000000000001400000000000000140000000000000004000000000000001400000000000000"
    },
    {
      "id": "duplicate-initial-position",
