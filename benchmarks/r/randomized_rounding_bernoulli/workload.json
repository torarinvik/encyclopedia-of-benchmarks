{
  "schema_version": 1,
  "id": "encyclopedia-randomized-rounding-bernoulli-i64-array-bytes-output-v1",
  "algorithm": "randomized_rounding_bernoulli",
  "function_symbol": "randomized_rounding_bernoulli",
  "abi": "i64_array_bytes_output",
  "description": "Replay the chapter's independent Bernoulli rounding rule using exact supplied fractional values and uniform draws.",
  "source": {
    "title": "Randomized Rounding",
    "authors": ["Rajmohan Rajaraman"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_327",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_327",
    "algorithm_attribution": "Raghavan-Thompson independent rounding: Pr[x_i=1]=x_i*",
    "implementation_status": "clean-room bounded supplied-randomness projection"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,(x_numerator,x_denominator,uniform_numerator,uniform_denominator)...]",
    "n_range": [1, 16],
    "fractional_value_range": "0 <= x_numerator <= x_denominator <= 32; x_denominator >= 1",
    "uniform_draw_range": "0 <= uniform_numerator < uniform_denominator <= 32; uniform_denominator >= 1",
    "maximum_valid_length": 65,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one byte per variable, 1 iff uniform_draw < fractional_value, otherwise 0",
    "maximum_bytes": 16,
    "success_result": "n bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 16,
    "meaning": "Staging buffer for at most sixteen rounded decision bytes."
  },
  "contract": {
    "decision": "Output byte i is 1 iff uniform_numerator_i * x_denominator_i < x_numerator_i * uniform_denominator_i.",
    "randomness": "Each supplied rational draw is one deterministic fixture projection of an independent Uniform[0,1) value.",
    "not_included": "LP solving and application-specific approximation guarantees are outside this profile.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "fractional-thresholds-and-equality",
      "input_values": [4, 1, 3, 0, 1, 1, 2, 1, 2, 2, 3, 1, 4, 1, 1, 31, 32],
      "input_length": 17,
      "output_capacity": 4,
      "expected_result": 4,
      "expected_output_hex": "01000101"
    },
    {
      "id": "zero-and-certain-selection-boundaries",
      "input_values": [2, 0, 1, 0, 2, 1, 1, 31, 32],
      "input_length": 9,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output_hex": "0001"
    },
    {
      "id": "maximum-sixteen-variables",
      "input_values": [16, 1, 2, 1, 4, 1, 2, 3, 4, 1, 2, 1, 4, 1, 2, 3, 4, 1, 2, 1, 4, 1, 2, 3, 4, 1, 2, 1, 4, 1, 2, 3, 4, 1, 2, 1, 4, 1, 2, 3, 4, 1, 2, 1, 4, 1, 2, 3, 4, 1, 2, 1, 4, 1, 2, 3, 4, 1, 2, 1, 4, 1, 2, 3, 4],
      "input_length": 65,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "01000100010001000100010001000100"
    },
    {
      "id": "fractional-value-above-one",
      "input_values": [1, 2, 1, 1, 2],
      "input_length": 5,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-zero-denominator",
      "input_values": [1, 0, 0, 0, 1],
      "input_length": 5,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "input-length-mismatch",
      "input_values": [1, 1, 2, 1],
      "input_length": 4,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [2, 1, 2, 0, 1, 1, 2, 1, 2],
      "input_length": 9,
      "output_capacity": 1,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [1, 1, 2, 0, 1],
      "input_length": 5,
      "output_capacity": 1,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 5,
      "input_is_null": true,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
