  "contract": {
    "operation": "Normalize grayscale bytes by subtracting 128, then run the source's forward integer 5/3 lifting transform: vertical predict/update, horizontal predict/update, and recursively decompose only the low-low region.",
    "input_layout": "[width, height, levels, row_major_grayscale_bytes...]",
    "width_range": [2, 16],
    "height_range": [2, 16],
    "levels_range": [1, 3],
    "dimension_rule": "Both dimensions must be divisible by 2^levels and at least 2^levels.",
    "pixel_range": [0, 255],
    "exact_input_length": "3 + width*height",
    "max_input_length": 259,
    "integer_rule": "Signed integer division truncates toward zero, matching the pinned C++ source. At the left edge, update the first even coefficient with the first detail twice. At the last odd sample on each line, mirror the preceding even sample.",
    "band_order": "The two-dimensional transform stores each band as a contiguous row-major chunk. The deepest level's LL, HL, LH, and HH chunks come first, followed by each less-deep level's HL, LH, and HH chunks.",
    "output_encoding": "All width*height coefficients in consecutive row-major band chunks: deepest-level LL, HL, LH, HH, then each less-deep level's HL, LH, HH; every coefficient is signed 32-bit little-endian.",
    "maximum_output_bytes": 1024,
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
  "input": {
    "kind": "signed_i64_array",
    "maximum_length": 259,
    "encoding": "[width, height, levels, row-major grayscale bytes in 0..255]",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "contiguous row-major coefficient band chunks as signed i32 little-endian values",
    "maximum_bytes": 1024,
    "success_result": "4*width*height",
    "null_or_short_output_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
