{
  "schema_version": 1,
  "id": "encyclopedia-rate-monotonic-scheduling-i64-array-bytes-output-v1",
  "algorithm": "rate_monotonic_scheduling",
  "function_symbol": "rate_monotonic_scheduling",
  "abi": "i64_array_bytes_output",
  "description": "Exact bounded RM schedulability analysis by critical-instant response simulation.",
  "source": {
    "title": "Rate-Monotonic Scheduling",
    "authors": ["Nathan Fisher", "Sanjoy K. Baruah"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_334",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_334",
    "algorithm_attribution": "Liu-Layland rate-monotonic static priorities and synchronous critical-instant response test",
    "implementation_status": "clean-room bounded integer-time profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[task_count,(execution,period)*]",
    "task_count_range": [1, 8],
    "execution_range": [1, 16],
    "period_range": [1, 32],
    "maximum_valid_length": 17,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[schedulable,first_missed_task_id,response_times_by_input_id...]",
    "maximum_bytes": 80,
    "success_result": "8 * (task_count + 2) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Fixed task descriptors, per-critical-instant remaining work, response values, and staged output."
  },
  "contract": {
    "priority_rule": "Shorter period is higher priority; equal periods use lower input task ID.",
    "deadline_rule": "Each job has implicit deadline equal to its period.",
    "miss_rule": "A response time greater than its task period is a deadline miss.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"rm-priority-order","input_values":[2,2,5,1,3],"input_length":5,"output_capacity":80,"expected_result":32,"expected_output_hex":"0100000000000000ffffffffffffffff03000000000000000100000000000000"},
    {"id":"exact-deadline-and-equal-period-tie","input_values":[2,2,2,1,2],"input_length":5,"output_capacity":80,"expected_result":32,"expected_output_hex":"000000000000000001000000000000000200000000000000ffffffffffffffff"},
    {"id":"schedulable-boundary","input_values":[2,1,2,1,3],"input_length":5,"output_capacity":80,"expected_result":32,"expected_output_hex":"0100000000000000ffffffffffffffff01000000000000000200000000000000"},
    {"id":"single-task-exact-deadline","input_values":[1,4,4],"input_length":3,"output_capacity":80,"expected_result":24,"expected_output_hex":"0100000000000000ffffffffffffffff0400000000000000"},
    {"id":"maximum-task-count","input_values":[8,1,32,1,32,1,32,1,32,1,32,1,32,1,32,1,32],"input_length":17,"output_capacity":80,"expected_result":80,"expected_output_hex":"0100000000000000ffffffffffffffff01000000000000000200000000000000030000000000000004000000000000000500000000000000060000000000000007000000000000000800000000000000"},
    {"id":"zero-execution","input_values":[1,0,4],"input_length":3,"output_capacity":80,"expected_result":-1,"expected_output_hex":""},
    {"id":"zero-period","input_values":[1,1,0],"input_length":3,"output_capacity":80,"expected_result":-1,"expected_output_hex":""},
    {"id":"length-mismatch","input_values":[2,1,3,2],"input_length":4,"output_capacity":80,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[1,1,2],"input_length":3,"output_capacity":23,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":3,"input_is_null":true,"output_capacity":80,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-output","input_values":[1,1,2],"input_length":3,"output_capacity":24,"output_is_null":true,"expected_result":-2,"expected_output_hex":""}
  ]
}
