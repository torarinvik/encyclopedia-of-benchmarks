{
  "schema_version": 1,
  "id": "encyclopedia-randomized-contraction-edge-sampling-i64-array-bytes-output-v1",
  "algorithm": "randomized_contraction_edge_sampling",
  "function_symbol": "randomized_contraction_edge_sampling",
  "abi": "i64_array_bytes_output",
  "description": "Replay independent probability-half edge contractions from supplied bits and label each vertex by its contracted component minimum.",
  "source": {
    "title": "Randomized Contraction",
    "authors": ["Marek Cygan"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_764",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_764",
    "algorithm_attribution": "Chitnis-Cygan-Hajiaghayi-Pilipczuk randomized contractions edge-sampling phase",
    "implementation_status": "clean-room bounded supplied-randomness contraction trace"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,(u,v,contract_bit)...]",
    "n_range": [2, 16],
    "m_range": "n-1 through 24",
    "edge_constraints": "0 <= u < v < n; simple undirected edges; contract_bit is 0 or 1; underlying graph is connected",
    "maximum_valid_length": 74,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_32_bit_array",
    "encoding": "one minimum-index original vertex representative per input vertex, in vertex order",
    "maximum_bytes": 64,
    "success_result": "4 * n bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded disjoint-set, connectivity-validation and staged 32-bit output storage."
  },
  "contract": {
    "randomness": "Each edge has one supplied Bernoulli(1/2) outcome; 1 means contract, 0 means retain as a noncontracted edge.",
    "component_rule": "Selected edges are contracted transitively; each output label is the minimum-index vertex in its resulting component.",
    "scope": "One deterministic replay of the edge-sampling contraction phase, not the full problem-specific FPT cut solver or a probability guarantee.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
