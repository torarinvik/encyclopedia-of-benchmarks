      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000003000000"
    },
    {
      "id": "triangle-two-selected-edges",
      "input_values": [3, 3, 0, 1, 1, 1, 2, 1, 0, 2, 0],
      "input_length": 11,
      "output_capacity": 12,
      "expected_result": 12,
      "expected_output_hex": "000000000000000000000000"
    },
    {
      "id": "no-contractions",
      "input_values": [3, 3, 0, 1, 0, 1, 2, 0, 0, 2, 0],
      "input_length": 11,
      "output_capacity": 12,
      "expected_result": 12,
      "expected_output_hex": "000000000100000002000000"
    },
    {
      "id": "maximum-sixteen-vertices-twenty-four-edges",
