  "abi": "i64_array_bytes_output",
  "description": "Marking page caching with supplied uniform-choice indices for each eviction.",
  "source": {
    "title": "Online Paging and Caching",
    "authors": ["Neal E. Young"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_267",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_267",
    "algorithm_attribution": "The chapter derives Marking by resetting a hit page's credit to one and randomly evicting a zero-credit page; the profile supplies one uniform-choice index per eviction.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[cache_size,request_count,requests[request_count],choice_count,choice_indices[choice_count]]",
    "cache_size_range": [1, 8],
    "request_count_range": [0, 32],
    "page_id_range": [0, 15],
    "choice_index_range": "0..eligible_count-1 at each eviction, with eligible pages ordered by page ID",
    "choice_count_requirement": "exactly one supplied index per eviction; no index is consumed for a hit or a miss with free cache capacity",
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_vector",
    "encoding": "little-endian signed 64-bit words [miss_count,final_resident_mask,final_marked_mask,hit_flags[request_count],victim_ids[request_count]]",
    "no_victim_sentinel": -1,
    "maximum_bytes": 536,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Bounded request and choice tapes, page marks, resident state, and staged byte output."
  },
  "contract": {
    "initial_state": "The cache is empty and all pages are unmarked.",
    "hit": "A resident page is marked and generates hit flag 1.",
    "full_cache_miss": "If unmarked residents exist, the random victim is selected uniformly from them. If every resident is marked, clear all resident marks and select uniformly from the whole cache.",
    "supplied_randomness": "An input index selects one element of the current eligible page IDs sorted in ascending order. Uniformly sampled indices preserve the uniform source choice; the workload fixes the indices for deterministic replay.",
    "output_masks": "Bit p represents page ID p; final_marked_mask includes only pages resident at completion."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary oracle uses page-indexed boolean arrays. The independent verifier maintains an explicit resident list and marked set, sorting eligible resident IDs before applying each supplied index.",
