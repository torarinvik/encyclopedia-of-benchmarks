{
  "schema_version": 1,
  "id": "relaxed-convolution-i64-array-bytes-output-v1",
  "algorithm": "relaxed_convolution",
  "function_symbol": "relaxed_convolution",
  "description": "Online-style dyadic relaxed convolution schedule with bounded direct block products over modulus 998244353.",
  "pinned_source": {
    "repository": "NyaanNyaan/library",
    "commit": "b3981adc80a800b2584980b01821324ea6c77183",
    "path": "ntt/relaxed-convolution.hpp",
    "related_paths": [
      "LICENSE"
    ],
    "symbol": "RelaxedConvolution::get",
    "url": "https://github.com/NyaanNyaan/library/blob/b3981adc80a800b2584980b01821324ea6c77183/ntt/relaxed-convolution.hpp",
    "license": "CC0 1.0 Universal; full notice bundled in LICENSE.txt."
  },
  "contract": {
    "operation": "Consume two coefficient streams in lockstep and emit the first n coefficients of their product using the dyadic relaxed-convolution schedule.",
    "input_layout": "[n, a0, ..., a(n-1), b0, ..., b(n-1)]",
    "bounds": {
      "n": [
        1,
        16
      ],
      "coefficient": [
        0,
        998244352
      ]
    },
    "semantics": "At each q, the next pair is appended and c[q]=sum(a[j]*b[q-j]) mod 998244353 is finalized. Ports use the pinned schedule with direct modular block products in place of the upstream cached NTT block multiplication.",
    "output_encoding": "n unsigned 32-bit little-endian residues",
    "output_bytes": "4*n",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Malformed input, n outside 1..16, or noncanonical coefficients return -1 before output checks. Null output or capacity below 4*n returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "n followed by n coefficients from each stream",
    "maximum_input_length": 33,
    "valid_ranges": {
      "n": "1..16",
      "coefficient": "0..998244352"
    },
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "unsigned 32-bit little-endian residues",
    "maximum_bytes": 64,
    "success_result": "4*n bytes on success",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
