{
  "schema_version": 1,
  "id": "kinetic-energy-v1",
  "algorithm": "kinetic_energy",
  "function_symbol": "kinetic_energy",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "required_length": 2,
    "layout": ["mass", "velocity"],
    "mass_minimum": 0,
    "mass_maximum": 1000,
    "velocity_minimum": -1000,
    "velocity_maximum": 1000,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "0.5 * mass * abs(velocity) * abs(velocity)",
    "unit": "joule",
    "invalid_input_result": -1e300
  },
  "cases": [
    {"id":"source-example","input_values":[10,10],"input_length":2,"expected_result":500.0},
    {"id":"negative-velocity","input_values":[20,-20],"input_length":2,"expected_result":4000.0},
    {"id":"small-even-energy","input_values":[2,2],"input_length":2,"expected_result":4.0},
    {"id":"fractional-energy","input_values":[7,-3],"input_length":2,"expected_result":31.5},
    {"id":"zero-mass","input_values":[0,10],"input_length":2,"expected_result":0.0},
    {"id":"zero-velocity","input_values":[100,0],"input_length":2,"expected_result":0.0},
    {"id":"maximum-bounds","input_values":[1000,1000],"input_length":2,"expected_result":500000000.0},
    {"id":"invalid-empty","input_values":[],"input_length":0,"expected_result":-1e300},
    {"id":"invalid-length","input_values":[10],"input_length":1,"expected_result":-1e300},
    {"id":"invalid-negative-mass","input_values":[-1,10],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-velocity-bound","input_values":[10,1001],"input_length":2,"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
}
