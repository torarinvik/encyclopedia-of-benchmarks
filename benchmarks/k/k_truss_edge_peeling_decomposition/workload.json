  "contract": {
    "algorithm": "Count each edge's incident triangles, repeatedly peel a minimum-support surviving edge, assign max(previous_level,current_support)+2, and decrement the other two triangle edges only when both survive and the partner support exceeds the current level.",
    "tie_rule": "Choose the lowest input edge index among edges with equal current support.",
    "output_order": "One trussness value per edge, in input order.",
    "complexity": "O(n^3 + m^2 + mn) time and O(n^2+m) workspace.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Input framing and edge validation precede output pointer/capacity checks."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "One edge trussness value per input edge; minimum value is 2.",
    "element_width_bytes": 8,
    "maximum_elements": 120,
    "maximum_bytes": 960,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 16384,
    "explicit_fixed_array_payload_bytes_widest_port": 6976,
    "meaning": "The largest explicit table payload, plus bounded collection bookkeeping and call-local state."
  },
