  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,(u,v)*m]",
    "vertex_count_range": [1, 16],
    "edge_count_range": [0, 120],
    "maximum_valid_length": 242,
    "maximum_parseable_length": 243,
    "edge_semantics": "Simple undirected graph; every edge appears once in canonical endpoint order 0<=u<v<n; input edge order is preserved for output.",
