{
  "schema_version": 1,
  "id": "knapsack-zero-one-tabulation-v1",
  "algorithm": "knapsack_zero_one_tabulation",
  "input": {
    "kind": "packed_capacity_and_weight_value_pairs",
    "encoding": "[capacity, item_count, weight_0, value_0, ...]",
    "maximum_capacity": 512,
    "maximum_item_count": 128,
    "item_weight_range": [1, 4096],
    "item_value_range": [0, 1000000000],
    "invalid_result": -1
  },
  "cases": [
    {"id":"classic_example","input_values":[50,3,10,60,20,100,30,120],"expected_result":220},
    {"id":"no_items_zero_capacity","input_values":[0,0],"expected_result":0},
    {"id":"no_items_positive_capacity","input_values":[8,0],"expected_result":0},
    {"id":"zero_capacity_skips_positive_weights","input_values":[0,2,1,900,7,12],"expected_result":0},
    {"id":"exact_capacity_fit","input_values":[5,2,5,17,6,90],"expected_result":17},
    {"id":"all_items_too_heavy","input_values":[5,2,6,90,9,120],"expected_result":0},
    {"id":"combination_beats_best_single","input_values":[10,3,5,10,4,9,6,13],"expected_result":22},
    {"id":"item_is_not_reused","input_values":[6,1,3,5],"expected_result":5},
    {"id":"input_order_permutation","input_values":[7,3,4,5,2,3,3,4],"expected_result":9},
    {"id":"zero_value_item","input_values":[4,2,1,0,2,5],"expected_result":5},
    {"id":"maximum_capacity","input_values":[512,4,256,500,256,600,512,1000,511,999],"expected_result":1100},
    {"id":"maximum_value_and_out_of_capacity_item","input_values":[512,2,1,1000000000,4096,999999999],"expected_result":1000000000}
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 20
  }
}
