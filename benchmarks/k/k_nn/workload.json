    {
      "id": "two_dimensional_query",
      "input_values": [4, 2, 3, 0, 0, 1, 2, 2, 1, 4, 4, 0, 1, 1, 0, 1, 0],
      "input_length": 17,
      "expected_result": 1
    },
    {
      "id": "negative_feature_coordinates",
      "input_values": [3, 2, 1, -3, 3, 1, 1, 5, 5, 0, 1, 0, 0, 0],
      "input_length": 14,
      "expected_result": 1
    },
    {
      "id": "single_training_row_exact_match",
      "input_values": [1, 2, 1, 7, -5, 1, 7, -5],
      "input_length": 8,
      "expected_result": 1
    }
  ],
  "abi_cases": [
