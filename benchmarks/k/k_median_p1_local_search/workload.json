{
  "schema_version": 1,
  "id": "encyclopedia-k-median-p1-local-search-i64-array-bytes-v1",
  "algorithm": "k_median_p1_local_search",
  "function_symbol": "k_median_p1_local_search",
  "comparison_model": "i64_array_bytes_output_call",
  "source": {
    "chapter": "Local Search for K-medians and Facility Location",
    "doi": "10.1007/978-1-4939-2864-4_212",
    "author": "Kamesh Munagala",
    "profile": "Deterministic bounded p=1 best-improvement k-median local search over an explicit finite metric; facility-location variants excluded."
  },
  "contract": {
    "operation": "Starting from k supplied centers, repeatedly take the minimum-cost strictly improving one-center swap in the p-swap neighborhood until locally optimal.",
    "input_layout": "[n,k,D row-major n*n, initial-center-ids k]",
    "tie_rule": "Sort center sets increasingly; among equal-cost improving candidates choose lexicographically smallest.",
    "output_layout": "[total nearest-center distance,k,sorted final center ids], little-endian signed 64-bit words.",
    "error_precedence": "Malformed input returns -1 before output checks; null output or capacity below required bytes returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 150,
    "maximum_parseable_length": 151,
    "n_range": [2,12],
    "k_range": [1,4],
    "distance_range": [0,1000],
    "metric_requirements": ["symmetric", "zero diagonal", "positive off-diagonal", "triangle inequality"],
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 6,
    "maximum_output_bytes": 48,
    "success_result": "8*(2+k) bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Validated metric, current/best center sets, nearest-center objective workspace, and staged output."
  },
  "measurement": {"sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "cases": [
    {"id":"already-optimal-hub","input_values":[4,1,0,1,1,1,1,0,2,2,1,2,0,2,1,2,2,0,0],"input_length":19,"expected_result":24,"expected_output_hex":"030000000000000001000000000000000000000000000000"},
    {"id":"one-swap-to-hub","input_values":[4,1,0,1,1,1,1,0,2,2,1,2,0,2,1,2,2,0,1],"input_length":19,"expected_result":24,"expected_output_hex":"030000000000000001000000000000000000000000000000"},
    {"id":"invalid-asymmetric-metric","input_values":[3,1,0,1,2,2,0,1,1,1,1,2],"input_length":12,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output","input_values":[4,1,0,1,1,1,1,0,2,2,1,2,0,2,1,2,2,0,0],"input_length":19,"output_capacity":23,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":1,"input_is_null":true,"output_capacity":48,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-output","input_values":[4,1,0,1,1,1,1,0,2,2,1,2,0,2,1,2,2,0,0],"input_length":19,"output_capacity":48,"output_is_null":true,"expected_result":-2,"expected_output_hex":""}
  ]
}
