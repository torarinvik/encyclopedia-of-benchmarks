    "role": "algorithm"
  },
  "contract": {
    "operation": "Sort the supplied signed-i64 values with floor-sqrt-sized contiguous blocks and min-heap merge.",
    "input_encoding": "[element_count, value_0, ..., value_(element_count-1)]",
    "element_count_range": [
      0,
      256
    ],
    "value_domain": "signed 64-bit integers",
    "block_size": "floor(sqrt(element_count)) for element_count > 1",
    "block_order": "Contiguous input slices in original order; the final block may be shorter.",
    "block_sort": "Ascending; duplicates are retained.",
    "merge": "Min-heap over each non-empty block head until all elements are emitted.",
    "input_mutation": "The benchmark input is not modified.",
    "exact_input_length": "element_count + 1",
    "maximum_valid_input_length": 257,
    "maximum_parseable_input_length": 258,
    "output_encoding": "Ascending signed-i64 values as little-endian words.",
    "maximum_output_elements": 256,
    "maximum_output_bytes": 2048,
    "success_result": "Number of output bytes written.",
    "invalid_result": -1,
    "output_error_result": -2,
        "errors": "Null input, malformed framing, or invalid count returns -1 before output checks. Null output or insufficient byte capacity returns -2 after input validation, including for an empty result. Errors write no bytes."
  },
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "encoding": "[element_count, values...]",
    "element_count_range": [
      0,
