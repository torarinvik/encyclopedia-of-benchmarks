    {"id": "cube", "input_values": [3], "input_length": 1, "output_capacity": 32, "expected_result": 32, "expected_output_hex": "0200000000000000010000000000000002000000000000000300000000000000"},
    {"id": "fourth-power", "input_values": [4], "input_length": 1, "output_capacity": 32, "expected_result": 32, "expected_output_hex": "0200000000000000010000000000000002000000000000000400000000000000"},
    {"id": "fifth-power", "input_values": [5], "input_length": 1, "output_capacity": 40, "expected_result": 40, "expected_output_hex": "03000000000000000100000000000000020000000000000003000000000000000500000000000000"},
    {"id": "eighth-power", "input_values": [8], "input_length": 1, "output_capacity": 40, "expected_result": 40, "expected_output_hex": "03000000000000000100000000000000020000000000000004000000000000000800000000000000"},
    {"id": "seventeenth-power", "input_values": [17], "input_length": 1, "output_capacity": 56, "expected_result": 56, "expected_output_hex": "0500000000000000010000000000000002000000000000000400000000000000080000000000000010000000000000001100000000000000"},
