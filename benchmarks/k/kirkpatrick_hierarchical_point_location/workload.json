  "id": "encyclopedia-kirkpatrick-hierarchical-point-location-i64-array-bytes-output-v1",
  "algorithm": "kirkpatrick_hierarchical_point_location",
  "function_symbol": "kirkpatrick_hierarchical_point_location",
  "abi": "i64_array_bytes_output",
  "description": "Locate a strict-interior query by descending a supplied bounded triangle hierarchy.",
  "source": {
    "title": "Point Location",
    "authors": ["Marcel Roeloffzen"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_587",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_587",
    "algorithm_attribution": "Kirkpatrick hierarchical-triangulation query phase",
    "implementation_status": "clean-room bounded query over supplied hierarchy"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[V,L,qx,qy,(x,y)*V, then per level: face_count, face triples, and for each nonfinal face a candidate_count plus sorted child face IDs]",
    "vertices_range": [3, 16],
    "levels_range": [1, 4],
    "faces_per_level_maximum": 8,
    "coordinate_range": [-1000, 1000],
    "constraints": "top level has one CCW triangle; all faces are CCW and nondegenerate; each listed child intersects its coarse face; query is strictly inside exactly one face of every level",
    "maximum_valid_length": 268,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[finest_level_face_id, point_in_triangle_predicate_count]",
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed bounded vertex, face, and candidate-list arrays plus staged 16-byte output."
  },
  "contract": {
    "query": "Start at the unique top-level face. At each descent scan the current face's child IDs in ascending local face-ID order and select the unique child whose triangle strictly contains the query.",
    "candidate_lists": "Candidate lists are supplied preprocessing output. Every listed triangle must intersect its coarse face; hierarchy construction and candidate-list generation are excluded.",
    "predicate_count": "One top-face containment test plus one test per candidate scanned through and including the first containing child at each level. Structural validation tests are not counted.",
    "boundary_rule": "Queries on any face boundary are invalid; strict interior queries avoid shared-boundary tie choices.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
