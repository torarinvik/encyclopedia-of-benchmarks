  "workspace": {
    "bytes": 64,
    "meaning": "Fixed staged center-index list for at most eight selected rows."
  },
  "contract": {
    "first_center": "The first center is the explicitly supplied zero-based row first_row; no first-center PRNG call is included.",
    "distance": "For each row, D² is the minimum sum of squared coordinate differences to any selected center.",
    "weighted_choice": "Read one tape value for each later center. Scan row weights in ascending row order and choose the first cumulative sum strictly greater than the draw. Duplicate rows are separate weighted candidates; selected rows and rows identical to a selected center have weight zero.",
    "zero_total_distance": "Require tape value zero and choose the lowest-index row not already selected. This deterministic completion rule also covers data sets with fewer unique points than k.",
    "arithmetic": "All coordinates, distances, weights, cumulative sums, and draw values are exact signed 64-bit integers. Maximum per-point D² is 4096 and maximum total weight is 131072.",
    "error_precedence": "Validate frame shape, bounds, coordinates, and all data-dependent tape draws before checking output pointer and capacity.",
    "no_write_on_error": true,
    "distinction": "This package measures D² center seeding only; the local Lloyd-update packages do not implement this initialization rule."
  },
  "complexity": {
    "primary_time": "O(point_count * dimension * k) using incremental nearest-center distances.",
    "primary_space": "O(point_count * dimension + point_count + k).",
    "independent_time": "O(point_count * dimension * k^2) by recomputing every point's distance to all prior centers at every step.",
    "independent_space": "O(point_count * dimension + point_count + k)."
  },
