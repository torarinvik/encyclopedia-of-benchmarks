    "reuse_scope": "Ordered successful-search frequencies and recurrence are shared; Knuth monotone-root bounds are the distinct computation. No source text/code copied."
  },
  "contract": {
    "operation": "Minimize sum(freq[i]*depth(i)) over BSTs on ordered keys, root at depth one.",
    "input_layout": "[n,frequency_0,...,frequency_(n-1)]",
    "n_range": [1, 64],
    "frequency_range": [0, 1000000],
    "root_tie_rule": "Choose the leftmost minimum-cost root by updating only on strict cost improvement.",
    "algorithm": "For interval [i,j], scan roots in opt[i][j-1]..opt[i+1][j], inclusive; opt[i][i]=i. Prefix sums provide interval frequency totals.",
    "complexity": "O(n^2) time and O(n^2) storage under the Knuth monotone-root property.",
    "invalid_result": -1
  },
  "input": {
    "kind": "key_count_then_ordered_search_frequencies",
    "encoding": "[n,frequency_0,...,frequency_(n-1)]",
    "n_range": [1, 64],
    "frequency_range": [0, 1000000],
    "maximum_input_values": 65,
    "invalid_result": -1
  },
  "output": {
    "kind": "minimum_weighted_search_cost",
    "range": [0, 4096000000],
    "invalid_result": -1
  },
  "maximum_profile": {
    "input_values": "[64, 64 frequencies each equal to 1000000]",
    "upper_bound": 4096000000,
    "primary_and_cubic_oracles_must_agree": true
  },
  "measurement": {
