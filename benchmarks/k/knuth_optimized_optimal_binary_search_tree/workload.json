    "kind": "clean-room algorithmic variant of existing optimal-BST recurrence",
    "reference_package": "benchmarks/o/optimal_binary_search_tree/README.md",
    "knuth_bound_reference": "https://github.com/TheAlgorithms/Java/blob/e43ec3897e48f23843972d02cd05a5bb1b6864a2/src/main/java/com/thealgorithms/dynamicprogramming/OptimalBinarySearchTree.java",
