{
  "schema_version": 1,
  "id": "k2-tree-compact-graph-i64-array-bytes-output-v1",
  "algorithm": "k2_tree_compact_graph",
  "function_symbol": "k2_tree_compact_graph",
  "abi": "i64_array_bytes_output",
  "description": "Build a bounded packed k²-tree for a directed adjacency relation and answer edge and successor queries.",
  "source": {
    "discovery": "https://xlinux.nist.gov/dads/HTML/k2tree.html",
    "primary": "https://lbd.udc.es/Repository/Publications/Drafts/K2treforCom.pdf",
    "title": "k²-trees for Compact Web Graph Representation",
    "authors": ["Nieves R. Brisaboa", "Susana Ladra", "Gonzalo Navarro"],
    "year": 2009,
    "algorithm_description_only": true
  },
  "representation": {
    "padded_side": "least power of two >= max(N,2)",
    "quadrant_order": ["top-left", "top-right", "bottom-left", "bottom-right"],
    "T": "BFS region bits before the final cell level, packed LSB-first",
    "L": "final cell bits below nonempty parent regions, packed LSB-first",
    "rank": "rank_prefix[i+1] counts one bits in T[0..i]; a T node x has child base 4*rank_prefix[x+1], and root child base is zero",
    "successor_query": "Repeat rank-based edge membership for every candidate column and pack neighbors into an N-bit mask."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[N,row_mask[0..N),Q,(opcode,u,v)*]",
    "n_range": [1, 32],
    "q_range": [0, 128],
    "row_mask_range": "0 <= row_mask[u] < 2^N",
    "self_loops": "allowed",
    "opcode_meaning": {"0": "edge membership u->v", "1": "successor mask for u; v must be zero"},
    "exact_frame_length": "N+2+3Q",
    "maximum_valid_input_length": 418,
    "maximum_parseable_input_length": 419,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "[Q,result[0..Q)]",
    "edge_result": "0 or 1",
    "successor_result": "N-bit outgoing-neighbor mask",
    "maximum_bytes": 1032,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "accounting": "43-byte T bitmap, 128-byte L bitmap, 341-entry u16 rank prefix (682 bytes), and four 256-byte coordinate arrays (1877 fixed bytes total); input and caller output buffers excluded."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 20
  },
