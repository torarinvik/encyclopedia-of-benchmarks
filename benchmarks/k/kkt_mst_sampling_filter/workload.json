{
  "schema_version": 1,
  "id": "encyclopedia-kkt-mst-sampling-filter-i64-array-bytes-output-v1",
  "algorithm": "kkt_mst_sampling_filter",
  "function_symbol": "kkt_mst_sampling_filter",
  "abi": "i64_array_bytes_output",
  "description": "Classify original graph edges as light or heavy with respect to the sampled graph's minimum spanning forest.",
  "source": {
    "title": "Randomized Minimum Spanning Tree",
    "authors": ["Vijaya Ramachandran"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_325",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_325",
    "algorithm_attribution": "Karger-Klein-Tarjan sampled-MSF F-heavy-edge filtering stage",
    "implementation_status": "clean-room bounded supplied-sample profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,(u,v,weight,sampled_bit)...]",
    "n_range": [2, 12],
    "m_range": [1, 24],
    "edge_constraints": "0 <= u < v < n; no repeated undirected endpoint pair; unique weight in [1,1024]; sampled_bit is 0 or 1",
    "maximum_valid_length": 98,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one byte per input edge in input order; 1 for F-light and 0 for F-heavy",
    "maximum_bytes": 24,
    "success_result": "m bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded edge-order, disjoint-set, sampled-forest adjacency, traversal and staged-output storage."
  },
  "contract": {
    "sample": "A supplied bit of 1 includes the edge in the sample; 0 omits it.",
    "forest": "F is the minimum spanning forest of sampled edges, computed by increasing unique weight.",
    "classification": "An edge is F-heavy iff it is the heaviest edge on the unique F path between its endpoints. An edge is F-light otherwise, including edges whose endpoints are disconnected in F.",
    "scope": "This is the KKT sample-filter stage, not the full recursive KKT MST algorithm or a probabilistic guarantee.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
