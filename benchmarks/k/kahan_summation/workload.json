  "algorithm": "kahan_summation",
  "function_symbol": "kahan_summation",
  "abi": "float64_slice_io",
  "oracle": "benchmarks/kahan_summation_oracle.py",
  "oracle_entry_point": "expected_abi(values, output_capacity=None, output_is_null=False, input_is_null=False, input_length=None)",
  "independent_oracle": "benchmarks/kahan_summation_verifier_oracle.py",
  "description": "Ordered Kahan compensated summation over a bounded binary64 sequence.",
  "source": {
    "task_url": "https://rosettagit.org/tasks/kahan-summation/",
    "task_content_license": "GFDL-1.3-or-later, as identified on the RosettaGit mirror page",
    "paper": "William Kahan, Further remarks on reducing truncation errors, Communications of the ACM 8(1), 1965.",
    "paper_url": "https://doi.org/10.1145/363707.363723",
    "implementation_status": "clean-room algorithm implementation; no upstream code or prose copied"
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "ordered sequence of at most 256 binary64 values",
    "minimum_length": 0,
    "maximum_input_length": 256,
    "maximum_absolute_value": 1e100,
    "empty_input_result": 0.0,
    "null_input_result": -1,
    "invalid_input_result": -1
  },
  "contract": {
    "operation": "Apply Kahan's compensated summation recurrence from left to right, rounding each primitive operation to binary64.",
    "recurrence": [
      "adjusted = value - correction",
      "next = sum + adjusted",
      "correction = (next - sum) - adjusted",
      "sum = next"
    ],
    "initial_sum": 0.0,
    "initial_correction": 0.0,
    "maximum_output_elements": 1,
    "workspace_elements": 2,
    "success_result": 1,
    "invalid_result": -1,
    "output_error_result": -2,
    "input_validation_precedes_output_capacity_check": true,
    "no_write_on_error": true,
    "exact_sum_guaranteed": false
  },
  "output": {
    "kind": "float64_array",
    "encoding": "one binary64 sum",
    "maximum_elements": 1,
    "success_result": 1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "absolute_tolerance": 0.0,
    "relative_tolerance": 0.0
  },
  "workspace": {
    "elements": 2,
    "meaning": "running sum and compensation scalar accumulators"
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 0.0,
    "relative_tolerance": 0.0
  },
  "cases": [
    {
      "id": "empty_sequence",
      "input_values": [],
      "input_length": 0,
      "output_capacity": 1,
      "expected_result": 1,
      "expected_output": [0.0]
    },
    {
      "id": "exact_small_sum",
      "input_values": [0.25, 0.5, 1.0, 2.0],
      "input_length": 4,
      "output_capacity": 1,
      "expected_result": 1,
      "expected_output": [3.75]
    },
    {
      "id": "two_half_ulp_terms_recovered",
      "input_values": [1.0, 1.1102230246251565e-16, 1.1102230246251565e-16],
      "input_length": 3,
      "output_capacity": 1,
      "expected_result": 1,
      "expected_output": [1.0000000000000002]
    },
    {
      "id": "small_terms_after_large_value",
      "input_values": [10000000000000000.0, 1.0, 1.0, -10000000000000000.0],
      "input_length": 4,
      "output_capacity": 1,
      "expected_result": 1,
      "expected_output": [2.0]
    },
    {
      "id": "out_of_range_finite_value",
      "input_values": [1e101],
      "input_length": 1,
      "output_capacity": 1,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "valid_input_short_capacity",
      "input_values": [1.0, 2.0],
      "input_length": 2,
      "output_capacity": 0,
      "expected_result": -2,
      "expected_output": []
    },
    {
      "id": "valid_input_null_output",
      "input_values": [1.0],
      "input_length": 1,
      "output_capacity": 1,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output": []
    },
    {
      "id": "null_input",
      "input_values": [],
      "input_length": 0,
      "output_capacity": 1,
      "input_is_null": true,
      "expected_result": -1,
      "expected_output": []
    }
  ]
}
