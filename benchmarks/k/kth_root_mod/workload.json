{
  "schema_version": 1,
  "id": "library-checker-kth-root-mod-bounded-i64-array-bytes-output-v1",
  "algorithm": "kth_root_mod",
  "function_symbol": "kth_root_mod",
  "abi": "i64_array_bytes_output",
  "description": "Extract modular Kth roots over small prime fields using primitive-root discrete logarithms.",
  "source": {
    "title": "Kth Root (Mod)",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/number_theory/kth_root_mod/task.md",
    "algorithm_attribution": "Cyclic-group discrete-log reduction to a linear congruence",
    "implementation_status": "clean-room bounded prime-field root extraction"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[T, (K,Y,P)...]",
    "T_range": [1, 8],
    "K_range": [0, 1000000000],
    "P_range": [2, 1000],
    "P_requirement": "prime",
    "Y_range": "0 <= Y < P",
    "maximum_valid_length": 25,
    "maximum_parseable_input_length": 25,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian root or -1 per case",
    "maximum_bytes": 64,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 192,
    "meaning": "Eight triples of signed 64-bit values copied before output writes."
  },
  "contract": {
    "root_definition": "Return any X in [0,P) such that X^K is congruent to Y modulo P, or -1 if no root exists.",
    "zero_power_convention": "0^0 = 1; for K=0 every X has value 1.",
    "deterministic_choice": "For nonzero Y and positive K, select the root obtained from the first primitive root found by ascending candidate scan and the least nonnegative solution exponent.",
    "official_T_range": [1, 5000],
    "official_K_range": [0, 1000000000],
    "official_P_range": [2, 1000000000],
    "profile_T_range": [1, 8],
    "profile_P_range": [2, 1000],
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 15,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "zero-to-zero-is-one-convention-root",
      "input_values": [1, 0, 1, 2],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "zero-to-zero-is-not-zero",
      "input_values": [1, 0, 0, 3],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "ffffffffffffffff"
    },
    {
      "id": "first-power-identity",
      "input_values": [1, 1, 2, 7],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0200000000000000"
    },
    {
      "id": "square-root-from-cyclic-exponent",
      "input_values": [1, 2, 4, 7],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0200000000000000"
    },
    {
      "id": "nonresidue-for-even-exponent",
      "input_values": [1, 2, 3, 7],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "ffffffffffffffff"
    },
    {
      "id": "zero-has-positive-exponent-root",
      "input_values": [1, 2, 0, 7],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "odd-exponent-root-of-one",
      "input_values": [1, 3, 1, 7],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "coprime-exponent-root-of-one",
      "input_values": [1, 5, 1, 7],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "smallest-root-variant-is-not-required",
      "input_values": [1, 2, 4, 5],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0200000000000000"
    },
    {
      "id": "largest-profile-prime-and-identity-exponent",
      "input_values": [1, 1, 123, 997],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "7b00000000000000"
    },
    {
      "id": "multiple-cases",
      "input_values": [2, 2, 4, 7, 2, 3, 7],
      "input_length": 7,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "0200000000000000ffffffffffffffff"
    },
    {
      "id": "composite-modulus",
      "input_values": [1, 2, 1, 9],
      "input_length": 4,
      "output_capacity": 64,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "residue-out-of-range",
      "input_values": [1, 1, 7, 7],
      "input_length": 4,
      "output_capacity": 64,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "exponent-out-of-range",
      "input_values": [1, 1000000001, 1, 7],
      "input_length": 4,
      "output_capacity": 64,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [1, 1, 2, 7],
      "input_length": 4,
      "output_capacity": 7,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
