{
  "schema_version": 1,
  "id": "k-subset-colex-rank-unrank-i64-array-bytes-v1",
  "algorithm": "k_subset_colex_rank_unrank",
  "function_symbol": "k_subset_colex_rank_unrank",
  "abi": "i64_array_bytes_output",
  "input": {
    "kind": "signed_i64_array",
    "layout": "mode 0: [0,n,k,index_0..index_(k-1)]; mode 1: [1,n,k,rank]",
    "n_range": [0, 16],
    "k_range": "0<=k<=n",
    "indices": "mode 0 requires k strictly increasing zero-based indices in [0,n)",
    "rank": "mode 1 requires 0<=rank<binomial(n,k)",
    "maximum_valid_length": 19,
    "maximum_parseable_length": 20,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "algorithm": {
    "order": "colexicographic order: compare fixed-size subsets from their largest element toward their smallest",
    "rank_formula": "for ascending zero-based indices a[0..k), rank=sum(binomial(a[i],i+1))",
    "unrank": "from j=k down to 1, choose the largest x below the previous selected element with binomial(x,j)<=remaining rank, emit x at index j-1, then subtract binomial(x,j)",
    "empty_cases": "n=0,k=0 and k=0 at any n are valid; the only rank is zero and the returned subset is empty",
    "binomial_boundaries": "binomial(n,0)=1 and binomial(n,n)=1; rank range includes binomial(n,k)-1"
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[colex_rank, ascending_zero_based_indices...]",
    "maximum_bytes": 136,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "input_validation_precedes_capacity": true,
    "errors_leave_output_untouched": true
  },
  "workspace": {
    "bytes": 1024,
    "accounting": "fixed 16-index reconstruction array, 17-word serialization staging, binomial-loop temporaries, parser and ABI locals"
  },
  "complexity": {
    "primary_time": "ranking O(k^2) from bounded binomial evaluation; greedy unranking O(n*k^2) worst case",
    "primary_workspace": "O(k) fixed words",
    "independent_reference_time": "O(binomial(n,k)*k) worst case by colex enumeration",
    "independent_reference_workspace": "O(k) recursion and tuple state"
  },
  "source": {
    "title": "Combinatorial Algorithms: Generation, Enumeration, and Search",
    "authors": ["Donald L. Kreher", "Douglas R. Stinson"],
    "url": "https://books.google.com/books?id=3h7SBQAAQBAJ",
    "section": "2.3.2, Co-lex ordering, Algorithms 2.9 and 2.10",
    "secondary_title": "Unranking Small Combinations of a Large Set in Co-Lexicographic Order",
    "secondary_url": "https://doi.org/10.3390/a15020036",
    "secondary_section": "2.1, Algorithms for Ranking and Unranking Combinations in Co-Lexicographic Order"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "input_and_correctness_validation": "outside timed call"
  },
