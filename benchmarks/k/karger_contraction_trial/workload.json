    {"id": "uneven_cut", "input_values": [4, 5, 0, 1, 0, 2, 0, 3, 1, 2, 1, 3, 0, 0], "input_length": 14, "expected_result": 2},
    {"id": "maximum_graph", "input_values": [8, 24,
