  "output": {
    "kind": "signed 64-bit integer",
    "meaning": "number of edges crossing the two remaining supervertices",
    "invalid_result": -1
  },
  "provenance": {
    "description": "Independently implemented reproducible single contraction trial based on Karger's randomized contraction method.",
    "url": "https://people.csail.mit.edu/karger/Papers/contract.pdf"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
