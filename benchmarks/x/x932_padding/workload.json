{
  "schema_version": 1,
  "id": "x932-padding-fixed-zero-v1",
  "algorithm": "x932_padding",
  "function_symbol": "x932_padding",
  "input": {
    "kind": "i64_array",
    "encoding": "[block_size, byte values...]",
    "block_size_range": [
      1,
      64
    ],
    "byte_range": [
      0,
      255
    ],
    "maximum_payload_bytes": 256,
    "padding": "zero bytes followed by a final byte equal to padding length; a full block is added for aligned and empty inputs"
  },
  "output": {
    "kind": "byte_array",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "ordinary_partial_block",
      "input_values": [
        16,
        104,
        101,
        108,
        108,
        111,
        32,
        119,
        111,
        114,
        108,
        100
      ],
      "input_length": 12,
      "expected_result": 16
    },
    {
      "id": "empty_payload",
      "input_values": [
        8
      ],
      "input_length": 1,
      "expected_result": 8
    },
    {
      "id": "exact_block_adds_a_full_block",
      "input_values": [
        8,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8
      ],
      "input_length": 9,
      "expected_result": 16
    },
    {
      "id": "unit_block",
      "input_values": [
        1,
        255
      ],
      "input_length": 2,
      "expected_result": 2
    },
    {
      "id": "insufficient_output_capacity",
      "input_values": [
        8,
        1,
        2,
        3
      ],
      "input_length": 4,
      "expected_result": -2,
      "output_capacity": 7
    },
    {
      "id": "invalid_block_size",
      "input_values": [
        0,
        65
      ],
      "input_length": 2,
      "expected_result": -1
    }
  ]
}
