    "launcher_small_problem_words": 2000,
    "launcher_big_calc_enabled": false,
    "launcher_repetitions": "N complete passes over N words",
    "source_input_path": "VersaBench/8b10b/input",
    "source_input_word_encoding": "little-endian unsigned 32-bit words; observed pinned data is in 0..511",
    "profile_word_encoding": "packed source word=(k << 8) | byte, with byte in 0..255 and k in 0..1",
    "profile_word_count_range": [
      0,
      160
    ],
    "maximum_profile_calc_calls": 25600,
    "initial_disparity": 0,
    "disparity_persists_across_all_passes": true,
    "output_sampling": "the final pass output at indices 0,128,... less than N",
    "output_format": "printf(\"%8.8X\\n\")"
  },
