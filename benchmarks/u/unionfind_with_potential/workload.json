      "input_length": 26,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "010000000000000001000000000000000d0000000000000000000000000000000d00000000000000f4ff7f3b00000000"
    },
    {
      "id": "modular-wraparound",
      "input_values": [2,3,0,0,1,998244351,1,0,1,0,1,1,0,0],
