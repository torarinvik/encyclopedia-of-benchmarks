{
  "schema_version": 1,
  "id": "library-checker-unionfind-with-potential-bounded-i64-array-bytes-output-v1",
  "algorithm": "unionfind_with_potential",
  "function_symbol": "unionfind_with_potential",
  "abi": "i64_array_bytes_output",
  "description": "Maintain consistent modular difference constraints with weighted disjoint-set union.",
  "source": {
    "title": "Unionfind with Potential",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/unionfind_with_potential/task.md",
    "algorithm_attribution": "Weighted union-find with path compression and union by size",
    "implementation_status": "clean-room bounded modular potential DSU"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,(type,u,v,x)...]",
    "fixed_operation_width": 4,
    "unused_query_x_must_be": 0,
    "N_range": [1, 64],
    "Q_range": [1, 256],
    "MOD": 998244353,
    "index_range": "0 <= u,v < N",
    "update_x_range": "0 <= x < MOD",
    "maximum_valid_length": 1026,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian result per operation",
    "maximum_bytes": 2048,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Maximum output-buffer capacity; DSU state uses three arrays of 64 values (1536 bytes on 64-bit targets)."
  },
  "contract": {
    "update": "type 0 provides a_u-a_v = x mod MOD; accept iff consistent with prior accepted updates and output 1, otherwise reject without mutation and output 0",
    "query": "type 1 outputs a_u-a_v mod MOD if determined, otherwise -1",
    "official_N_range": [1, 200000],
    "official_Q_range": [1, 200000],
    "official_MOD": 998244353
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
