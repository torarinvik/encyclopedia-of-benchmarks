{
  "schema_version": 1,
  "id": "undirected-eulerian-trail-hierholzer-i64-bytes-v1",
  "algorithm": "undirected_eulerian_trail_hierholzer",
  "function_symbol": "undirected_eulerian_trail_hierholzer",
  "abi": "i64_array_bytes_output",
  "description": "Input-order Hierholzer traversal of a bounded undirected multigraph.",
  "input": {"kind": "signed_i64_array", "layout": "[n,m,(u,v)*m]", "maximum_valid_input_length": 66, "maximum_parseable_input_length": 67, "invalid_input_result": -1},
  "output": {"kind": "little_endian_signed_i64_vector", "maximum_output_bytes": 264, "no_trail_result": 0, "insufficient_output_capacity_result": -2},
  "workspace": {"bytes": 16384, "reason": "Output-buffer capacity for the suite; traversal storage is internal."},
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "cases": [
    {"id": "empty", "input_values": [1, 0], "input_length": 2, "expected_result": 8, "expected_output_hex": "0000000000000000"},
    {"id": "self_loop", "input_values": [1, 1, 0, 0], "input_length": 4, "expected_result": 16, "expected_output_hex": "00000000000000000000000000000000"},
    {"id": "isolated_lower_vertices", "input_values": [4, 1, 2, 2], "input_length": 4, "expected_result": 16, "expected_output_hex": "02000000000000000200000000000000"},
    {"id": "parallel_edges", "input_values": [2, 2, 0, 1, 0, 1], "input_length": 6, "expected_result": 24, "expected_output_hex": "000000000000000001000000000000000000000000000000"},
    {"id": "cycle_splice_open", "input_values": [5, 5, 0, 3, 0, 1, 0, 2, 2, 4, 0, 4], "input_length": 12, "expected_result": 48, "expected_output_hex": "010000000000000000000000000000000200000000000000040000000000000000000000000000000300000000000000"},
    {"id": "disconnected_even", "input_values": [4, 2, 0, 0, 2, 2], "input_length": 6, "expected_result": 0, "expected_output_hex": ""},
    {"id": "disconnected_null_output", "input_values": [4, 2, 0, 0, 2, 2], "input_length": 6, "output_is_null": true, "expected_result": 0, "expected_output_hex": ""},
    {"id": "disconnected_zero_capacity", "input_values": [4, 2, 0, 0, 2, 2], "input_length": 6, "output_capacity": 0, "expected_result": 0, "expected_output_hex": ""},
    {"id": "four_odd", "input_values": [4, 2, 0, 1, 2, 3], "input_length": 6, "expected_result": 0, "expected_output_hex": ""},
    {"id": "invalid_endpoint", "input_values": [2, 1, 0, 2], "input_length": 4, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_endpoint_null_output", "input_values": [2, 1, 0, 2], "input_length": 4, "output_is_null": true, "output_capacity": 0, "expected_result": -1, "expected_output_hex": ""},
    {"id": "trailing_word", "input_values": [1, 0, 0], "input_length": 3, "expected_result": -1, "expected_output_hex": ""},
    {"id": "short_output", "input_values": [1, 0], "input_length": 2, "output_capacity": 7, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null_output", "input_values": [1, 0], "input_length": 2, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null_input", "input_values": [], "input_is_null": true, "input_length": 0, "expected_result": -1, "expected_output_hex": ""}
  ]
