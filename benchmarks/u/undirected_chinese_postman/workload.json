  "abi": "i64_array_scalar",
  "description": "Minimum closed route traversing every edge of a connected weighted undirected graph.",
  "source": {
    "title": "Chinese postman problem / undirected route inspection",
    "url": "https://xlinux.nist.gov/dads/HTML/chinesePostman.html",
    "related_source": "https://hochbaum.ieor.berkeley.edu/files/ieor269-2010.pdf",
    "discovery_scope": "High-level algorithm description and taxonomy only; no implementation or task examples copied."
  },
  "input": {
    "encoding": "[N,M,(u,v,w)*M]",
    "vertex_range": [1, 8],
    "edge_count_range": [0, 12],
    "positive_edge_weight_range": [1, 1000],
    "graph": "Connected simple undirected graph; the one-vertex zero-edge graph is valid.",
    "exact_length": "2+3*M",
    "maximum_valid_length": 38,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "Minimum total weight of a closed walk that traverses every edge at least once.",
    "maximum_result": 40000,
    "invalid_input_result": -1
  },
  "algorithm": {
    "primary": "Floyd-Warshall metric closure followed by bitmask minimum pairing of odd-degree vertices.",
    "independent_oracle": "Dijkstra over current vertex and covered-edge mask; accept a closed state covering every edge.",
    "primary_complexity": "O(N^3 + 2^N*N^2) time and O(N^2 + 2^N) space.",
    "oracle_complexity": "O(N*2^M log(N*2^M) + M*2^M) time and O(N*2^M) space."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
