{
  "schema_version": 1,
  "id": "encyclopedia-undirected-fvs-iterative-compression-i64-array-bytes-output-v1",
  "algorithm": "undirected_feedback_vertex_set",
  "function_symbol": "undirected_feedback_vertex_set",
  "abi": "i64_array_bytes_output",
  "description": "Bounded exact iterative-compression decision for undirected feedback vertex set.",
  "source": {
    "title": "Undirected Feedback Vertex Set",
    "authors": ["Jiong Guo"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_450",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_450",
    "algorithm_attribution": "iterative compression with partitioned compression subproblem",
    "implementation_status": "clean-room exact bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[vertex_count,edge_count,parameter,(u,v) canonical sorted edges...]",
    "vertex_count_range": [1, 8],
    "edge_count_range": [0, 28],
    "parameter_range": [0, 4],
    "edge_constraints": "simple undirected graph; each edge once with u<v; pairs strictly increasing",
    "maximum_valid_length": 59,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "two little-endian signed 64-bit integers",
    "encoding": "[feasible_within_parameter,minimum_size_or_minus_one]",
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Fixed eight-vertex graph, disjoint-set forest checks, and iterative-compression subset state."
  },
  "contract": {
    "prefix_invariant": "for each vertex prefix, maintain a feedback vertex set; add the next vertex to form a size-(k+1) candidate",
    "compression": "partition candidate F into X included and Y excluded; enumerate S outside F with |X|+|S|<=k; accept X union S when deleting it leaves a forest",
    "decision": "try k from zero through input parameter; first successful budget is the minimum size",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "triangle-one-vertex-removal",
      "input_values": [3, 3, 1, 0, 1, 0, 2, 1, 2],
      "input_length": 9,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "01000000000000000100000000000000"
    },
    {
      "id": "tree-needs-no-removal",
      "input_values": [4, 3, 0, 0, 1, 1, 2, 2, 3],
      "input_length": 9,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "01000000000000000000000000000000"
    },
    {
      "id": "two-disjoint-triangles-exceed-parameter",
      "input_values": [6, 6, 1, 0, 1, 0, 2, 1, 2, 3, 4, 3, 5, 4, 5],
      "input_length": 15,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "0000000000000000ffffffffffffffff"
    },
    {
      "id": "reversed-edge-endpoints",
      "input_values": [3, 1, 1, 2, 0],
      "input_length": 5,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "parameter-out-of-range",
      "input_values": [3, 0, 5],
