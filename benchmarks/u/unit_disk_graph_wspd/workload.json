  "pinned_source": {
    "title": "Well Separated Pair Decomposition for Unit-Disk Graph",
    "author": "Rolf Klein",
    "doi": "10.1007/978-1-4939-2864-4_480",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_480",
    "summarized_original_work": "Gao and Zhang, STOC 2003, Well-separated pair decomposition for the unit-disk graph metric and its applications",
    "license": "No source-code redistribution license asserted; clean-room mathematical implementation"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[point_count,separation_factor,x0,y0,...,xN-1,yN-1]",
    "point_count_range": [1, 8],
    "separation_factor_range": [1, 8],
    "coordinate_range": [-8, 8],
    "duplicate_coordinates": "invalid",
    "disconnected_unit_disk_graph": "invalid",
    "maximum_valid_length": 18,
    "invalid_result": -1
  },
  "contract": {
    "unit_disk_edge": "distinct integer lattice points with squared Euclidean distance <= 1; every such edge has weight 1",
    "metric": "unweighted shortest-path distance in the connected induced unit-disk graph",
    "separation": "dist(A,B) >= c * max(diam(A),diam(B)); inclusive exact integer comparison",
    "split_tree": "ascending original point IDs, split into floor(count/2) left IDs and remaining right IDs",
    "pair_recursion": "visit left subtree, visit right subtree, then cross pair; if not separated, split the larger set and split the second set on ties; visit first child before second",
    "pair_coverage": "each unordered pair of distinct vertices is covered exactly once"
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[pair_count,left_mask_0,right_mask_0,...]; mask bit i denotes original point i",
    "pair_order": "deterministic depth-first order defined by pair_recursion",
    "maximum_pairs": 28,
    "maximum_bytes": 456,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Fixed distance matrix and staged maximum output for 28 mask pairs."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
