{
  "schema_version": 1,
  "id": "encyclopedia-avr-speed-scaling-i64-array-bytes-output-v1",
  "algorithm": "avr_speed_scaling",
  "function_symbol": "avr_speed_scaling",
  "abi": "i64_array_bytes_output",
  "description": "Bounded AVR speed profile with exact cubic energy and EDF completion times.",
  "source": {
    "title": "Average Rate Speed Scaling",
    "authors": ["Nikhil Bansal", "David P. Bunde", "Ho-Leung Chan", "Kirk Pruhs"],
    "url": "https://doi.org/10.1007/s00453-009-9379-z",
    "background_reference": "https://doi.org/10.1007/978-1-4939-2864-4_390",
    "used_for": "AVR's per-job density contribution and EDF schedule; no code, examples, or prose reused."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[job_count,(release,deadline,work)*]",
    "job_count_range": [1, 8],
    "time_range": [0, 8],
    "work_range": [1, 8],
    "job_rule": "Every job has integer release < deadline; windows are half-open [release,deadline).",
    "power_function": "P(s)=s^3",
    "maximum_valid_length": 25,
    "maximum_parseable_length": 25,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[segment_count,energy_num,energy_den,(start,end,speed_num,speed_den)*,(finish_num,finish_den)*]; speed segments are positive, sorted, maximal, and completion times are in original job order",
    "maximum_values": 79,
    "maximum_bytes": 632,
    "success_result": "8 * output_value_count bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 632,
    "meaning": "Maximum output-buffer capacity for the 79-field exact speed and completion trace."
  },
  "contract": {
    "density_scale": "840, the least common multiple of all positive job-window lengths in 1..8",
    "speed": "At time t, speed is the sum over active jobs of work/(deadline-release).",
    "edf_order": "Run released unfinished jobs by earliest deadline, breaking ties by original job index.",
    "segment_order": "Break at every release/deadline endpoint, omit zero-speed intervals, and merge adjacent intervals with equal reduced speed.",
    "energy": "Integrate speed^3 exactly over the horizon and reduce the rational result.",
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id": "one-job-unit-speed", "input_values": [1, 0, 4, 4], "input_length": 4, "output_capacity": 632, "expected_result": 72, "expected_output_hex": "010000000000000004000000000000000100000000000000000000000000000004000000000000000100000000000000010000000000000004000000000000000100000000000000"},
    {"id": "fractional-average-rate", "input_values": [1, 0, 3, 1], "input_length": 4, "output_capacity": 632, "expected_result": 72, "expected_output_hex": "010000000000000001000000000000000900000000000000000000000000000003000000000000000100000000000000030000000000000003000000000000000100000000000000"},
    {"id": "separated-windows", "input_values": [2, 0, 1, 1, 2, 3, 1], "input_length": 7, "output_capacity": 632, "expected_result": 120, "expected_output_hex": "02000000000000000200000000000000010000000000000000000000000000000100000000000000010000000000000001000000000000000200000000000000030000000000000001000000000000000100000000000000010000000000000003000000000000000100000000000000"},
    {"id": "edf-across-speed-changes", "input_values": [2, 0, 2, 2, 1, 3, 2], "input_length": 7, "output_capacity": 632, "expected_result": 152, "expected_output_hex": "03000000000000000a00000000000000010000000000000000000000000000000100000000000000010000000000000001000000000000000200000000000000020000000000000001000000000000000200000000000000030000000000000001000000000000000300000000000000020000000000000003000000000000000100000000000000"},
    {"id": "nonpositive-window", "input_values": [1, 2, 2, 1], "input_length": 4, "output_capacity": 632, "expected_result": -1, "expected_output_hex": ""},
    {"id": "trailing-value", "input_values": [1, 0, 4, 4, 1], "input_length": 5, "output_capacity": 632, "expected_result": -1, "expected_output_hex": ""},
    {"id": "insufficient-output-capacity", "input_values": [1, 0, 4, 4], "input_length": 4, "output_capacity": 71, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null-output", "input_values": [1, 0, 4, 4], "input_length": 4, "output_capacity": 632, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null-input", "input_values": [], "input_length": 0, "output_capacity": 632, "input_is_null": true, "expected_result": -1, "expected_output_hex": ""}
  ]
}
