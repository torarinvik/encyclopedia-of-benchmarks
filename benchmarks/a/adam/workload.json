{
  "schema_version": 1,
  "id": "adam-parameter-trace-v1",
  "algorithm": "adam",
  "function_symbol": "adam",
  "input": {
    "kind": "scaled_adam_parameter_trace",
    "layout": "[step_count, parameter_count, learning_rate_scaled, beta1_scaled, beta2_scaled, epsilon_scaled, weight_decay_scaled, initial parameter values, then step_count rows of parameter_count gradients]",
    "input_scale": 1000000000,
    "step_count_range": [
      1,
      256
    ],
    "parameter_count_range": [
      1,
      16
    ],
    "learning_rate_range": [
      1e-09,
      1.0
    ],
    "beta_ranges": [
      [
        0.0,
        0.999999999
      ],
      [
        0.0,
        0.999999999
      ]
    ],
    "epsilon_range": [
      1e-09,
      0.01
    ],
    "weight_decay_range": [
      0.0,
      0.1
    ],
    "initial_parameter_range": [
      -1000000.0,
      1000000.0
    ],
    "gradient_range": [
      -1000.0,
      1000.0
    ],
    "initialization": "First and second moments start at zero; the initial parameter vector is supplied in the input.",
    "formula": "m = beta1*m + (1-beta1)*g; v = beta2*v + (1-beta2)*g*g; m_hat = m/(1-beta1^t); v_hat = v/(1-beta2^t); parameter = parameter - learning_rate*m_hat/(sqrt(v_hat)+epsilon) - learning_rate*weight_decay*parameter",
    "invalid_result": -1
  },
  "output": {
    "result": "number of updated parameter values emitted",
    "bytes": "one signed 64-bit little-endian fixed-point parameter after each step, in step-major order",
    "output_scale": 1000000,
    "insufficient_output_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
