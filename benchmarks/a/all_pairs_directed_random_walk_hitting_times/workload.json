  "function_symbol": "all_pairs_directed_random_walk_hitting_times",
  "abi": "i64_array_bytes_output",
  "source": {
    "method_reference": "https://oi-wiki.org/graph/graph-random-walk/",
    "independent_reference": "https://rusunoi.github.io/books/National-Team-Thesis/2019.pdf",
    "reuse_scope": "Mathematical descriptions only; contract, fixtures, references, and ports are clean-room."
  },
  "contract": {
    "profile": "All ordered-pair first-hit expectations for a strongly connected simple directed graph, modulo 1000000007.",
    "input_layout": "[n,m,(u,v)*m]",
    "vertex_count_range": [3, 8],
    "arc_count_range": "0 <= m <= n*(n-1)",
    "vertex_ids": "Zero-based integers in [0,n).",
    "arc_rule": "Directed arcs; self-loops and repeated ordered pairs are invalid.",
    "connectivity_rule": "The directed graph must be strongly connected.",
    "walk_rule": "At each vertex, choose one outgoing arc uniformly; one traversed arc costs one step.",
    "output_layout": "Row-major n*n matrix H; H[s,t] is the expected first-hit time from s to t modulo 1000000007, with H[t,t]=0; each value is a little-endian signed-i64 residue.",
    "primary_method": "Solve pi*P=pi with sum(pi)=1; let g_i=1/pi_i; solve (I-P)Y=J-diag(g) with the last coordinate fixed to zero; return H[i,j]=Y[i,j]-Y[j,j].",
    "independent_method": "For each target t, solve the absorbing first-step system d_i*h_i-sum(h_j for arcs i->j,j!=t)=d_i over all i!=t.",
    "invalid_precedence": "Malformed or null input returns -1 before output checks; valid input with null or short output returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 114,
    "maximum_parseable_length": 115,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "maximum_bytes": 512,
    "size_formula": "8*n*n for every valid graph",
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_or_short_output_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Conservative cap for the fixed adjacency, stationary system, reduced hitting-time system, result matrix, and parser state; caller-owned output is excluded."
  },
  "complexity": {
    "primary_time": "O(n^3+m)",
    "primary_space": "O(n^2)",
    "independent_time": "O(n^4+m)",
    "independent_space": "O(n^2)"
  },
