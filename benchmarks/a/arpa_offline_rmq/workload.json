  "abi": "i64_array_scalar",
  "source": {
    "title": "Disjoint Set Union: Offline RMQ / Arpa's trick",
    "url": "https://cp-algorithms.com/data_structures/disjoint_set_union.html",
    "license": "CC BY-SA 4.0",
    "reuse": "algorithm description only; clean-room bounded profile"
  },
  "input": {
    "encoding": "[n,q,values[n],(left,right)*q]",
    "n_range": [1,64], "q_range": [0,64], "value_range": [-1000,1000],
    "maximum_valid_length": 194, "maximum_parseable_length": 195,
    "invalid_result": -1
  },
  "output": {
    "encoding": "weighted checksum of leftmost minimum indices; sum((query_ordinal+1)*(index+1))",
    "result_range": "0..133120", "invalid_result": -1
  },
  "method": {
    "description": "Sweep by right endpoint; a monotone stack links each popped index to its next strictly smaller value, and DSU find returns the range minimum index.",
    "time": "O((n+q) alpha(n))",
    "auxiliary_space": "O(n+q)",
    "tie_rule": "strictly smaller links preserve the leftmost index among equal minima"
  },
  "workspace": {"bytes": 2048},
  "measurement": {"comparison_model": "i64_array_scalar_call", "sample_count": 7, "warmup_rounds": 1, "repetitions_per_sample": 100},
