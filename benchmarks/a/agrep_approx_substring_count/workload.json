{
  "schema_version": 1,
  "id": "agrep-approx-substring-count-v1",
  "algorithm": "agrep_approx_substring_count",
  "function_symbol": "agrep_approx_substring_count",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[pattern_length, text_length, max_errors, pattern ASCII bytes..., text ASCII bytes...]",
    "pattern_length_range": [1, 63],
    "text_length_range": [0, 4096],
    "max_errors_range": [0, 2],
    "alphabet": "printable ASCII bytes 32 through 126",
    "exact_length": "3 + pattern_length + text_length",
    "invalid_input_result": -2
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "number of text byte positions whose minimum unit-cost edit distance to a substring ending there is at most max_errors"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
  "cases": [
    {
      "id": "exact_single_match",
      "input_values": [3, 7, 0, 99, 97, 116, 120, 120, 99, 97, 116],
      "expected_result": 1
    },
    {
      "id": "one_substitution",
      "input_values": [3, 3, 1, 99, 97, 116, 99, 117, 116],
      "expected_result": 1
    },
    {
      "id": "one_deletion_from_pattern",
      "input_values": [3, 2, 1, 99, 97, 116, 99, 116],
      "expected_result": 1
    },
    {
      "id": "one_insertion_in_text",
      "input_values": [6, 7, 1, 97, 98, 99, 100, 101, 102, 97, 98, 120, 99, 100, 101, 102],
      "expected_result": 1
    },
    {
      "id": "overlapping_exact_matches",
      "input_values": [3, 5, 0, 97, 98, 97, 97, 98, 97, 98, 97],
      "expected_result": 2
    },
    {
      "id": "multiple_error_levels",
      "input_values": [3, 6, 1, 97, 98, 99, 97, 120, 99, 97, 98, 99],
      "expected_result": 3
    },
    {
      "id": "two_edit_allowance",
      "input_values": [3, 3, 2, 97, 98, 99, 97, 120, 100],
      "expected_result": 3
    },
    {
      "id": "empty_text",
      "input_values": [4, 0, 2, 116, 101, 115, 116],
      "expected_result": 0
    },
    {
      "id": "no_match_with_zero_errors",
      "input_values": [3, 3, 0, 99, 97, 116, 100, 111, 103],
      "expected_result": 0
    },
    {
      "id": "wrong_packed_length",
      "input_values": [3, 2, 1, 99, 97, 116, 99],
      "expected_result": -2
    },
    {
      "id": "non_printable_byte",
      "input_values": [1, 1, 0, 97, 10],
      "expected_result": -2
    },
    {
      "id": "error_allowance_over_limit",
      "input_values": [1, 1, 3, 97, 97],
      "expected_result": -2
    }
  ]
}
