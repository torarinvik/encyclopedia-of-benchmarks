{
  "schema_version": 1,
  "id": "anyto-any-base-conversion-v1",
  "algorithm": "anyto_any",
  "function_symbol": "anyto_any",
  "input": {
    "kind": "i64_array_source_number_source_base_destination_base",
    "encoding": "[decimal_encoded_source_digits,source_base,destination_base]",
    "source_number_range": [
      0,
      999999999
    ],
    "base_range": [
      2,
      10
    ],
    "source_digits_must_be_less_than_source_base": true,
    "destination_decimal_encoding_max": 999999999,
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "decimal_13_to_binary",
      "input_values": [
        13,
        10,
        2
      ],
      "expected_result": 1101
    },
    {
      "id": "binary_1101_to_decimal",
      "input_values": [
        1101,
        2,
        10
      ],
      "expected_result": 13
    },
    {
      "id": "octal_17_to_binary",
      "input_values": [
        17,
        8,
        2
      ],
      "expected_result": 1111
    },
    {
      "id": "binary_111111_to_octal",
      "input_values": [
        111111,
        2,
        8
      ],
      "expected_result": 77
    },
    {
      "id": "nine_binary_ones_to_decimal",
      "input_values": [
        111111111,
        2,
        10
      ],
      "expected_result": 511
    },
    {
      "id": "zero",
      "input_values": [
        0,
        2,
        8
      ],
      "expected_result": 0
    },
    {
      "id": "invalid_source_digit",
      "input_values": [
        102,
        2,
        10
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_base",
      "input_values": [
        10,
        1,
        10
      ],
      "expected_result": -1
    },
    {
      "id": "encoded_output_too_wide",
      "input_values": [
        512,
        10,
        2
      ],
      "expected_result": -1
    },
    {
      "id": "source_out_of_range",
      "input_values": [
        1000000000,
        10,
        2
      ],
      "expected_result": -1
    },
    {
      "id": "short_input",
      "input_values": [
        13,
        10
      ],
      "expected_result": -1
    },
    {
      "id": "long_input",
      "input_values": [
        13,
        10,
        2,
        0
      ],
      "expected_result": -1
    }
  ]
}
