{
  "schema_version": 1,
  "id": "apriori-i64-array-scalar-v1",
  "algorithm": "apriori",
  "function_symbol": "apriori",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[transaction_count,item_count,min_support_ppm,min_confidence_ppm,transaction_masks...]",
    "transaction_count_range": [1, 64],
    "item_count_range": [1, 12],
    "support_ppm_range": [1, 1000000],
    "confidence_ppm_range": [0, 1000000],
    "transaction_mask_range": "0 through (1 << item_count) - 1",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "number of frequent association rules meeting the confidence threshold; each rule has nonempty antecedent and consequent",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 6,
    "warmup_rounds": 2,
    "repetitions_per_sample": 50
  },
  "cases": [
    {"id":"source-thresholds-three-items","input_values":[4,3,6000,250000,7,3,5,1],"expected_result":12},
    {"id":"half-confidence-three-items","input_values":[4,3,250000,500000,7,3,5,1],"expected_result":9},
    {"id":"perfect-confidence-three-items","input_values":[4,3,250000,1000000,7,3,5,1],"expected_result":3},
    {"id":"half-support-perfect-confidence","input_values":[4,3,500000,1000000,7,3,5,1],"expected_result":2},
    {"id":"all-twelve-items-frequent","input_values":[1,12,6000,250000,4095],"expected_result":523250},
    {"id":"invalid-transaction-mask","input_values":[1,3,100000,250000,8],"expected_result":-1},
    {"id":"invalid-item-count","input_values":[1,13,100000,250000,0],"expected_result":-1},
    {"id":"invalid-input-length","input_values":[2,3,100000,250000,7],"expected_result":-1}
  ]
}
