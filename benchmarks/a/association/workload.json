{
  "schema_version": 1,
  "id": "apriori-association-min-support-001-v1",
  "algorithm": "association",
  "function_symbol": "association",
  "input": {
    "kind": "packed_signed_64_bit_transaction_masks",
    "layout": "[transaction_count,item_count,transaction_mask_0,...]",
    "transaction_count_range": [
      1,
      64
    ],
    "item_count_range": [
      1,
      11
    ],
    "transaction_mask_definition": "Bit i is 1 when item i appears in the transaction; items are ordered by ascending item name in the source notebook.",
    "valid_mask_range": "0 through (1 << item_count) - 1",
    "required_length": "2 + transaction_count",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_i64_itemset_support_pairs",
    "record_layout": "[itemset_mask,support_count] for each frequent itemset",
    "ordering": "canonical itemset cardinality ascending, then itemset mask ascending (source item-column order)",
    "minimum_support": 0.01,
    "frequent_condition": "support_count / transaction_count >= 0.01; with at most 64 transactions this is equivalent to support_count >= 1",
    "maximum_frequent_itemsets": 2047,
    "maximum_output_bytes": 32752,
    "no_frequent_itemsets_result_byte_length": 0,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "pinned_grocery_transactions",
      "input_values": [
        20,
        11,
        261,
        293,
        1030,
        452,
        1153,
        1030,
        1184,
        1157,
        1220,
        260,
        57,
        57,
        530,
        28,
        517,
        560,
        518,
        532,
        532,
        1328
      ],
      "input_length": 22,
      "workspace_bytes": 32752,
      "expected_result": 1328,
      "expected_output_hex": ""
    },
    {
      "id": "candidate_join_prune",
      "input_values": [
        4,
        3,
        7,
        3,
        5,
        2
      ],
      "input_length": 6,
      "workspace_bytes": 32752,
      "expected_result": 112,
      "expected_output_hex": "01000000000000000300000000000000020000000000000003000000000000000400000000000000020000000000000003000000000000000200000000000000050000000000000002000000000000000600000000000000010000000000000007000000000000000100000000000000"
