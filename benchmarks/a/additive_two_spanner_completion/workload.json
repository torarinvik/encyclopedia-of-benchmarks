    "output_untouched_on_error": true
  },
  "workspace": {"bytes": 4096, "meaning": "bounded graph, distance matrices, selected-edge bitmap, and path reconstruction state"},
  "contract": {
    "initial_subgraph": "empty",
    "stretch": "additive two",
    "violating_pair_order": "increasing (u,v) lexicographic order",
    "shortest_path_tie": "lexicographically smallest vertex sequence, chosen by increasing neighbor ID",
    "completion": "recompute distances, add the shortest input-graph path for the first violating pair, and repeat",
    "output_order": "original input edge record order"
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 2, "repetitions_per_sample": 100},
