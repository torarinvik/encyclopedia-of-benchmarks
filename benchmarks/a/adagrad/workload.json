{
  "schema_version": 1,
  "id": "adagrad-scalar-trace-v1",
  "algorithm": "adagrad",
  "input": {
    "kind": "scaled_adagrad_update_trace",
    "layout": "[step_count, learning_rate_scaled, epsilon_scaled, (parameter_id, parameter_scaled, gradient_scaled)...]",
    "input_scale": 1000000000,
    "parameter_id_range": [
      0,
      15
    ],
    "step_count_range": [
      1,
      256
    ],
    "learning_rate_range": [
      1e-09,
      1.0
    ],
    "epsilon_range": [
      1e-09,
      0.01
    ],
    "parameter_range": [
      -1000000.0,
      1000000.0
    ],
    "gradient_range": [
      -1000.0,
      1000.0
    ],
    "formula": "accumulator[id] += gradient * gradient; parameter - learning_rate / (sqrt(accumulator[id]) + epsilon) * gradient",
    "invalid_result": -1
  },
  "output": {
    "result": "number of updates",
    "bytes": "one signed 64-bit little-endian parameter per update, in input order",
    "output_scale": 1000000,
    "insufficient_output_result": -2
  },
  "workspace": {
    "bytes": 2048
  },
  "cases": [
    {
      "id": "single_update",
      "input_values": [
        1,
        100000000,
        10,
        0,
        1000000000,
        100000000
      ],
      "expected_result": 1
    },
    {
      "id": "repeated_group_accumulator",
      "input_values": [
        3,
        100000000,
        10,
        0,
        1000000000,
        500000000,
        0,
        900000000,
        500000000,
        0,
        800000000,
        -250000000
      ],
      "expected_result": 3
    },
    {
      "id": "interleaved_independent_groups",
      "input_values": [
        4,
        100000000,
        10,
        0,
        2000000000,
        500000000,
        1,
        -1000000000,
        -500000000,
        0,
        1800000000,
        500000000,
        1,
        -800000000,
        250000000
      ],
      "expected_result": 4
    },
    {
      "id": "zero_and_negative_gradients",
      "input_values": [
        3,
        100000000,
        10,
        0,
        125000000,
        0,
        0,
        125000000,
        -250000000,
