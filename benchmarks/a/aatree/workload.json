{
  "schema_version": 1,
  "id": "aatree-v1",
  "algorithm": "aatree",
  "function_symbol": "aatree",
  "input": {
    "kind": "packed_i64_array",
    "encoding": "[operation_count, then operation_count (opcode, key) pairs]",
    "maximum_operations": 256,
    "key_range": "Signed 32-bit integer keys; duplicate inserts and missing removes are invalid.",
    "opcodes": {
      "0": "insert key",
      "1": "remove key",
      "2": "contains key",
      "3": "minimum (key slot must be 0)",
      "4": "maximum (key slot must be 0)"
    },
    "result": "One little-endian signed-i32 result per operation: current count after insert/remove, 0/1 for contains, or the requested key for min/max.",
    "invalid_result": -1,
    "capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
