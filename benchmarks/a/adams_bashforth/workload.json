{
  "schema_version": 1,
  "id": "adams-bashforth-v1",
  "algorithm": "adams_bashforth",
  "function_symbol": "adams_bashforth",
  "input": {
    "kind": "packed_adams_bashforth",
    "encoding": "[order, forecast_step_count, y0_scaled, ..., y(order-1)_scaled]",
    "forecast_step_count_range": [
      1,
      4
    ],
    "initial_y_scaled_range": [
      -100000,
      100000
    ],
    "initial_y_scale": 100000,
    "x_grid": "x_i = i/4 for i in 0..order-1; h=1/4; x_final=(order-1+forecast_step_count)/4",
    "right_hand_side": "f(x,y)=x+y",
    "invalid_result": -1,
    "insufficient_capacity_result": -2,
    "output_encoding": "comma-separated base-10 integers trunc(y_i*1,000,000) for every returned solution value, including initial values",
    "order_range": [
      2,
      5
    ],
    "supported_orders": [
      2,
      3,
      4,
      5
    ]
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
