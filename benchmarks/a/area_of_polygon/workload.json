    "checksum": "weighted doubled shoelace areas plus a fixed positive offset"
  },
  "cases": [
    {"id": "empty_polygon_list", "input_values": [0], "input_length": 1, "expected_result": 0},
    {"id": "unit_triangle_counterclockwise", "input_values": [1, 3, 0, 0, 1, 0, 0, 1], "input_length": 8, "expected_result": 1000000008},
    {"id": "unit_triangle_clockwise", "input_values": [1, 3, 0, 1, 1, 0, 0, 0], "input_length": 8, "expected_result": 1000000008},
    {"id": "rectangle", "input_values": [1, 4, 0, 0, 3, 0, 3, 2, 0, 2], "input_length": 10, "expected_result": 1000000019},
    {"id": "concave_l_shape", "input_values": [1, 6, 0, 0, 4, 0, 4, 1, 1, 1, 1, 3, 0, 3], "input_length": 14, "expected_result": 1000000019},
    {"id": "self_intersecting_boundary", "input_values": [1, 4, 0, 0, 2, 2, 0, 2, 2, 0], "input_length": 10, "expected_result": 1000000007},
    {"id": "multiple_polygons", "input_values": [2, 3, 0, 0, 1, 0, 0, 1, 4, 0, 0, 2, 0, 2, 2, 0, 2], "input_length": 17, "expected_result": 3000000038},
    {"id": "large_coordinates", "input_values": [1, 3, -1000000, -1000000, 1000000, -1000000, 1000000, 1000000], "input_length": 8, "expected_result": 4001000000007},
    {"id": "invalid_vertex_count", "input_values": [1, 2, 0, 0, 1, 0], "input_length": 6, "expected_result": -1},
    {"id": "invalid_coordinate", "input_values": [1, 3, 0, 0, 1000001, 0, 0, 1], "input_length": 8, "expected_result": -1},
    {"id": "trailing_value", "input_values": [0, 7], "input_length": 2, "expected_result": -1}
