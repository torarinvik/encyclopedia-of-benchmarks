{
  "schema_version": 1,
  "id": "any-base-to-any-base-v1",
  "algorithm": "any_base_to_any_base",
  "input": {
    "kind": "signed_64_bit_array",
    "encoding": "source radix, target radix, then most-significant-first digit values 0-35 (0-9 and A-Z)",
    "minimum_length": 3,
    "maximum_length": 65,
    "radix_range": [
      2,
      36
    ],
    "invalid_digit_or_overflow_result": -1,
    "insufficient_capacity_result": -2,
    "output_encoding": "canonical uppercase ASCII digits without a prefix"
  },
