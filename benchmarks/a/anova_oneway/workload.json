{
  "schema_version": 1,
  "id": "anova-oneway-i64-array-float64-v1",
  "algorithm": "anova_oneway",
  "function_symbol": "anova_oneway",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[statistic_selector,n,k,observations...,group_labels...]",
    "statistic_selectors": [
      "df_between",
      "df_within",
      "ss_between",
      "ss_within",
      "ms_between",
      "ms_within",
      "f_statistic",
      "right_tail_p_value"
    ],
    "observation_count_range": [3, 128],
    "group_count_range": [2, 8],
    "observation_range": [-1000000, 1000000],
    "group_labels": "contiguous integers from 0 through k-1; each group must occur",
    "observation_count_must_exceed_group_count": true,
    "within_group_sum_of_squares_must_be_positive": true,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "selected one-way ANOVA statistic; p-value is the F-distribution right-tail probability",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
