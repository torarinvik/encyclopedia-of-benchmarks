    {"id":"ms-between","input_values":[4,4,2,0,2,2,4,0,0,1,1],"input_length":11,"expected_result":4.0},
    {"id":"ms-within","input_values":[5,4,2,0,2,2,4,0,0,1,1],"input_length":11,"expected_result":2.0},
    {"id":"f-statistic","input_values":[6,4,2,0,2,2,4,0,0,1,1],"input_length":11,"expected_result":2.0},
