{
  "schema_version": 1,
  "id": "all-distances-bottom-k-interval-updates-i64-array-bytes-v1",
  "algorithm": "all_distances_bottom_k_interval_updates",
  "function_symbol": "all_distances_bottom_k_interval_updates",
  "abi": "i64_array_bytes_output",
  "description": "Maintain bottom-k all-distances intervals under explicit arbitrary-order insertions.",
  "contract": {
    "operation": "Apply Section 5 interval rewrites to a seeded bottom-k all-distances sketch and emit the final item intervals.",
    "input_encoding": "[n,k,(item_id,distance,rank)*n] in arrival order.",
    "seed_rule": "The first k records are the k nearest items in strictly increasing distance; each later item is farther than the seed range, with arbitrary order among later records.",
    "rank_and_distance_rule": "Item IDs and ranks are permutations of 0..n-1; all distances are distinct integers in 0..1000000.",
    "interval_rule": "An emitted [start,end) interval contains exactly the integer query radii at which its item belongs to the bottom-k set; 1000001 is the past-domain sentinel.",
    "output_encoding": "Interval count followed by (item_id,start,end) triples, sorted by (start,item_id), as little-endian signed-i64 words.",
    "invalid": "Invalid dimensions, frame length, rank or ID permutation, duplicate/out-of-range distance, unsorted seed, or a later item no farther than the seed range returns -1.",
    "capacity": "For valid input, null or undersized output returns -2 without writes; success returns output bytes."
  },
  "input": {
    "kind": "signed_i64_array",
    "layout": "[n,k,(item_id,distance,rank)*n]",
    "n_range": [2, 32],
    "k_range": [2, 4],
    "k_le_n": true,
    "item_id_domain": "permutation of 0..n-1",
    "rank_domain": "permutation of 0..n-1",
    "distance_range": [0, 1000000],
    "distance_uniqueness": "all n distances are distinct",
    "exact_input_length": "2+3*n",
    "maximum_valid_input_values": 98,
    "maximum_parseable_input_values": 99,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "encoding": "interval count and item_id,start,end triples",
    "maximum_intervals": 32,
    "maximum_words": 97,
    "maximum_bytes": 776,
    "success_result": "number of output bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_leave_output_untouched": true,
    "error_precedence": "Input validity is checked before output pointer and capacity."
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed interval records, ID/rank/distance validation tables, and staged maximum output."
  },
  "provenance": [
    {
      "source": "Cohen and Kaplan, Summarizing Data using Bottom-k Sketches, Sections 4-5",
      "url": "https://doi.org/10.1145/1281100.1281133",
      "role": "Defines bottom-k all-distances sketches and the arbitrary-order interval insertion/update method."
    },
    {
      "source": "Encyclopedia of Algorithms, Chapter 574: All-Distances Sketches",
      "url": "https://doi.org/10.1007/978-1-4939-2864-4_574",
      "role": "Book crosswalk and method attribution."
    }
  ],
  "oracle_method": "The primary maintains item intervals and applies the paper's successive maximum-rank interval truncations. The independent reference recomputes bottom-k membership from scratch at every distinct distance threshold and derives each item's maximal interval.",
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "seeded-sketch-only",
      "input_values": [2,2,0,1,0,1,2,1],
      "input_length": 8,
      "expected_result": 56,
      "expected_output_hex": "02000000000000000000000000000000010000000000000041420f00000000000100000000000000020000000000000041420f0000000000"
    },
    {
      "id": "out-of-order-multi-boundary-replacements",
      "input_values": [5,2,0,1,4,1,2,3,2,5,1,3,7,0,4,4,2],
      "input_length": 17,
      "expected_result": 128,
      "expected_output_hex": "05000000000000000000000000000000010000000000000004000000000000000100000000000000020000000000000005000000000000000400000000000000040000000000000007000000000000000200000000000000050000000000000041420f00000000000300000000000000070000000000000041420f0000000000"
    },
    {
      "id": "dominated-arrival-no-update",
      "input_values": [3,2,0,1,0,1,2,1,2,3,2],
      "input_length": 11,
      "expected_result": 56,
      "expected_output_hex": "02000000000000000000000000000000010000000000000041420f00000000000100000000000000020000000000000041420f0000000000"
    },
    {
