{
  "schema_version": 1,
  "id": "nyaan-arbitrary-order-line-container-i64-array-scalar-v1",
  "algorithm": "arbitrary_order_line_container",
  "function_symbol": "arbitrary_order_line_container",
  "abi": "i64_array_scalar",
  "description": "Online min/max line insertion in arbitrary slope order with integer intersection breakpoints and arbitrary-coordinate queries.",
  "source": {
    "title": "NyaanNyaan/library line-container.hpp",
    "authors": ["NyaanNyaan library contributors"],
    "url": "https://github.com/NyaanNyaan/library/blob/master/data-structure/line-container.hpp",
    "license_url": "https://github.com/NyaanNyaan/library/blob/master/LICENSE",
    "license": "CC0 1.0 Universal; algorithm behavior only, clean-room ports",
    "algorithm_attribution": "Slope-ordered line envelope with integer intersection breakpoints, arbitrary insertion, and breakpoint lower_bound query",
    "implementation_status": "bounded clean-room profile"
  },
  "contract": {
    "input_encoding": "[objective,q,(opcode,a,b)*q]",
    "objective": {"0": "minimum", "1": "maximum"},
    "operation_row_width": 3,
    "operations": {
      "line_insertion": "[0,slope,intercept]",
      "point_query": "[1,x,0]"
    },
    "operation_count_range": [0, 32],
    "slope_range": [-1000, 1000],
    "intercept_range": [-1000, 1000],
    "query_coordinate_range": [-1000, 1000],
    "insertion_order": "arbitrary",
    "query_coordinate_order": "arbitrary",
    "duplicate_slope_rule": "retain only the transformed line with the larger intercept; equal duplicates are coalesced",
    "query_requires_prior_line": true,
    "checksum": "sum((i+1)*(objective_value_i+2000001)) for zero-based query index i",
    "zero_query_result": 0,
    "invalid_input_result": -1
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[objective,q,(opcode,a,b)*q]",
    "objective_range": [0, 1],
    "operation_count_range": [0, 32],
    "maximum_valid_length": 98,
    "maximum_parseable_length": 99,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "one-based weighted positive-offset sum of query extrema",
    "result_range": [0, 1488496496],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 768,
    "meaning": "Fixed storage for up to 32 active lines, each with slope, intercept, and integer breakpoint."
  },
  "complexity": {
    "line_insertion": "O(I) worst case for the bounded slope-ordered array; I is the active line count",
    "point_query": "O(log I) via binary search on intersection breakpoints",
    "auxiliary_space": "O(I)",
    "independent_oracle_time": "O(Q*L)",
    "independent_oracle_space": "O(L)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "primary_oracle": "benchmarks/a/arbitrary_order_line_container/primary_oracle.py",
  "independent_oracle": "benchmarks/a/arbitrary_order_line_container/independent_oracle.py",
