{
  "schema_version": 1,
  "id": "adaline-learning-v1",
  "algorithm": "adaline_learning",
  "function_symbol": "adaline_learning",
  "input": {
    "kind": "packed_i64_array",
    "encoding": "[sample_count, feature_count, eta_numerator, eta_shift, max_iterations, then sample rows of feature_count integer features and one label]",
    "sample_count_range": [
      1,
      32
    ],
    "feature_count_range": [
      1,
      8
    ],
    "feature_range": [
      -16,
      16
    ],
    "label_values": [
      -1,
      1
    ],
    "learning_rate": "eta_numerator / 2^eta_shift, where eta_shift is 1..12 and 0 < eta_numerator < 2^eta_shift",
    "max_iterations_range": [
      1,
      500
    ],
    "initialization": "Every feature weight and the bias start at 1.",
    "output": "Little-endian signed-i32 values: [completed_epochs, each final feature weight scaled by 2^eta_shift, bias scaled by 2^eta_shift, then final predictions for the training rows in input order].",
    "invalid_result": -1,
    "capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "pinned_c_fixed_training_set",
      "input_values": [
        10,
        2,
        1,
        3,
        500,
        0,
        1,
        1,
        1,
        -2,
        -1,
        2,
        3,
        1,
        3,
        -1,
        -1,
        4,
        1,
        -1,
        6,
        -5,
        -1,
        -7,
        -3,
        1,
        -8,
        5,
        1,
        -9,
        2,
        1,
        -10,
        -15,
        -1
      ],
      "expected_result": 56,
      "expected_output_hex": "02000000faffffff080000000400000001000000ffffffff01000000ffffffffffffffffffffffff010000000100000001000000ffffffff"
    },
    {
      "id": "one_dimensional_convergence",
      "input_values": [
        1,
        1,
        1,
        3,
        500,
        2,
        -1
      ],
      "expected_result": 16,
      "expected_output_hex": "04000000fcffffff02000000ffffffff"
    },
    {
      "id": "single_mistake_iteration_cap",
      "input_values": [
        1,
        1,
        1,
        3,
        1,
        0,
        -1
      ],
      "expected_result": 16,
      "expected_output_hex": "01000000080000000600000001000000"
    },
    {
      "id": "already_correct_training_row",
      "input_values": [
        1,
        1,
        1,
        3,
        500,
        -2,
        -1
      ],
      "expected_result": 16,
      "expected_output_hex": "010000000800000008000000ffffffff"
    },
    {
      "id": "invalid_sample_count_mismatch",
      "input_values": [
        2,
        1,
        1,
        3,
        10,
        0,
        -1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_label",
      "input_values": [
        1,
        1,
        1,
        3,
        10,
        0,
        0
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_learning_rate",
      "input_values": [
        1,
        1,
        8,
        3,
        10,
        0,
        -1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
