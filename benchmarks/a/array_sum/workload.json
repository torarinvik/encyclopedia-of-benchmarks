{
  "schema_version": 1,
  "id": "array-sum-i64-array-scalar-v1",
  "algorithm": "array_sum",
  "function_symbol": "array_sum",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "argument_order": [
      "count",
      "values..."
    ],
    "count_range": [
      0,
      1024
    ],
    "value_range": [
      0,
      1000000000
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "formula": "sum(values)",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
      "id": "empty-array",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": 0
    },
    {
      "id": "one-value",
      "input_values": [
        1,
        42
      ],
      "input_length": 2,
      "expected_result": 42
    },
    {
      "id": "four-values",
      "input_values": [
        4,
        1,
        2,
        3,
        4
      ],
      "input_length": 5,
      "expected_result": 10
    },
    {
      "id": "all-zeroes",
      "input_values": [
        3,
        0,
        0,
        0
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "large-valid-values",
      "input_values": [
        3,
        1000000000,
        999999999,
        1
      ],
      "input_length": 4,
      "expected_result": 2000000000
    },
    {
      "id": "negative-value",
      "input_values": [
        1,
        -1
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "value-above-bound",
      "input_values": [
        1,
        1000000001
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "malformed-packed-length",
      "input_values": [
        2,
        7
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "count-above-bound",
      "input_values": [
        1025
      ],
      "input_length": 1,
      "expected_result": -1
    }
  ]
}
