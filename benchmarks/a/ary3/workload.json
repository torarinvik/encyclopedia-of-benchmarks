  "source_bound": {
    "description": "The program accepts n as its sole command-line argument, allocates zeroed int arrays x and y, assigns x[i]=i+1, then performs 1000 passes adding x[i] into y[i] while traversing i from n-1 down to zero. It prints y[0] and y[n-1] with printf(\"%d %d\\n\"). Without an argument, ary3.c selects LENGTH 1500000 (or 150000 under SMALL_PROBLEM_SIZE); this suite profile uses explicit bounded n. The largest y value at n=4096 is 4096000, which fits a signed 32-bit int.",
    "profile_minimum": 1,
    "profile_maximum": 4096,
    "invalid_source_case": "n=0 indexes y[-1], so the suite rejects nonpositive n instead of preserving undefined behavior."
  },
  "input": {
    "kind": "signed_64_bit_scalar",
    "encoding": "shootout_ary3_ascii",
    "meaning": "Positive array length n; x[i] is initialized to i+1.",
    "minimum": 1,
    "maximum": 4096,
    "invalid_result": -1
  },
  "output": {
    "kind": "source_stdout_ascii",
    "encoding": "printf(\"%d %d\\n\"): final y[0], one space, final y[n-1], newline",
    "definition": "Exact ASCII bytes produced by the 1000 reverse-index passes; for the bounded profile, y[0]=1000 and y[n-1]=1000*n.",
    "maximum_output_bytes": 13,
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
