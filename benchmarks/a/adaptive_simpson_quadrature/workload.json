  "contract": {
    "operation": "Recursively refine Simpson estimates on intervals whose split estimate disagrees with the whole-interval estimate by more than the local error threshold.",
    "input_encoding": "[function_id,a_micro,b_micro,tolerance_exponent,max_depth]",
    "integer_fields": "All five finite float64 input values must represent exact integers.",
    "functions": {
      "0": "f(x)=x^4",
      "1": "f(x)=sin(x)",
      "2": "f(x)=1/(1+x^2)"
    },
    "endpoint_scale": 1000000,
    "endpoint_micro_range": [-2000000, 2000000],
    "endpoint_order": "a_micro <= b_micro",
    "tolerance": "10^-tolerance_exponent",
    "tolerance_exponent_range": [7, 8],
    "maximum_refinement_depth_range": [8, 12],
    "stopping_rule": "Accept when abs(left+right-whole)<=15*tolerance or depth reaches zero; return left+right+(left+right-whole)/15. Otherwise recurse on both halves with half the tolerance.",
    "equal_endpoints": "Return zero.",
    "output_encoding": "One float64 containing the integral estimate.",
    "error_precedence": "Malformed input returns -1 before output validation; valid input with null output or capacity below one returns -2 without writes.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
