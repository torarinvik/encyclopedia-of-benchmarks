      "input_values": [
        5,
        0,
        30,
        0,
        20,
        0,
        10,
        1,
        20,
        1,
        99
      ],
      "expected_result": 56,
      "expected_output_hex": "03000000000000000a0000000000000014000000000000001e00000000000000020000000000000001000000000000000000000000000000"
    },
    {
      "id": "right_right_rotation",
      "input_values": [
        5,
        0,
        10,
        0,
        20,
        0,
        30,
        1,
