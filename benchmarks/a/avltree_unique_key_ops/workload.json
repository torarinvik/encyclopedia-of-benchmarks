{
  "schema_version": 1,
  "id": "avltree-unique-key-ops-i64-v1",
  "algorithm": "avltree_unique_key_ops",
  "function_symbol": "avltree_unique_key_ops",
  "input": {
    "kind": "signed_i64_array",
    "layout": [
      "operation_count",
      "operation, key pairs..."
    ],
    "operation_count_range": [
      0,
      128
    ],
    "operations": {
      "0": "insert absent key",
      "1": "search key",
      "2": "delete present key"
    },
    "key_range": [
      -1000000,
      1000000
    ],
    "duplicate_active_insert": "invalid",
    "absent_delete": "invalid",
    "deleted_keys_may_be_reinserted": true,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": [
      "inorder_count",
      "sorted_keys...",
      "search_count",
      "search_results..."
    ],
    "search_result_values": {
      "0": "absent",
      "1": "present"
    },
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_trace",
      "input_values": [
        0
      ],
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
