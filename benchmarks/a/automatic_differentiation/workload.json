{
  "schema_version": 1,
  "id": "thealgorithms-python-reverse-mode-automatic-differentiation-scalar-v1",
  "algorithm": "automatic_differentiation",
  "function_symbol": "automatic_differentiation",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[leaf_count, operation_count, target_node, source_leaf, leaf_values..., (opcode, left_node, right_node_or_exponent)...]",
    "leaf_count_range": [
      1,
      32
    ],
    "operation_count_range": [
      1,
      64
    ],
    "supported_operations": {
      "0": "add",
      "1": "subtract",
      "2": "multiply",
      "3": "divide",
      "5": "integer power"
    },
    "operation_order": "Every operation creates node leaf_count + operation_index and may only reference earlier nodes; power stores exponent in its third field.",
    "target": "An operation-output node; source_leaf is an input leaf index.",
    "domain": "Leaf values in -16..16, nonzero divisors, exponents 1..8, and absolute intermediate values at most 10^10.",
    "invalid_or_disconnected_result": -1e+300
  },
  "output": {
    "kind": "float64_scalar",
    "meaning": "The derivative of the selected target scalar with respect to the selected source leaf; disconnected sources map the source None result to the documented sentinel."
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
