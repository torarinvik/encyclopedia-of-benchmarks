  "function_symbol": "almost_c1p_set_cover_enumeration",
  "abi": "i64_array_bytes_output",
  "description": "Enumerate feasible partial covers row by row and select a minimum-weight cover.",
  "source": {
    "title": "Set Cover with Almost Consecutive Ones",
    "authors": ["Michael Dom"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_368",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_368",
    "algorithm_attribution": "Mecke–Wagner row-wise enumeration of all feasible partial set covers.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[row_count,column_count,weights...,row_coverage_bitmasks...]",
    "row_count_range": [1, 8],
    "column_count_range": [1, 10],
    "column_weight_range": [1, 20],
    "row_mask_rule": "Bit j is 1 iff column j covers the row.",
    "zero_row": "valid instance with no feasible cover",
    "maximum_valid_length": 20,
    "maximum_parseable_length": 21,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_vector",
    "encoding": "[selected_count,selected_column_indices...,total_weight], or [-1] if uncoverable",
    "selected_column_index_base": 0,
    "selected_columns_order": "increasing column index",
    "equal_cost_tie_rule": "Choose the smallest numeric selected-column bitmask.",
    "maximum_bytes": 80,
    "success_result": "8 bytes for no cover, otherwise 8 * (selected_count + 2)",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "At most 1024 feasible-subset states, 8 row masks, 10 weights, and staged output."
  },
  "contract": {
    "initial_state": "S contains the empty partial cover.",
    "row_update": "For each partial cover missing the current row, add one version for every column covering that row, then remove the old uncovered partial cover.",
    "selection": "Among final feasible subsets, minimize total positive weight and break ties by the numeric bitmask.",
    "error_results": "Malformed input returns -1. Null or insufficient output returns -2 without writes."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary oracle applies row-wise feasible-solution enumeration. The independent verifier enumerates every column subset and checks matrix coverage directly.",
