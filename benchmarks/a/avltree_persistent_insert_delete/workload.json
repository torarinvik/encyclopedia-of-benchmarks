      "0": "insert into selected prior version",
      "1": "delete from selected prior version"
    },
    "value_range": [
      -1000,
      1000
    ],
    "duplicate_insert": "no-op, matching source",
    "missing_delete": "no-op, matching source",
    "persistent_versions": "each operation appends an immutable result version and may branch from any earlier version",
