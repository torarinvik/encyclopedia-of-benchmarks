{
  "schema_version": 1,
  "id": "fsharp-persistent-avl-insert-delete-v1",
  "algorithm": "avltree_persistent_insert_delete",
  "function_symbol": "avltree_persistent_insert_delete",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation_count, (parent_version, operation, integer_value)*]",
