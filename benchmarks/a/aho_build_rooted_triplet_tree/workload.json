  "algorithm": "aho_build_rooted_triplet_tree",
  "function_symbol": "aho_build_rooted_triplet_tree",
  "abi": "i64_array_bytes_output",
  "description": "Decide compatibility of bounded rooted-triplet constraints and serialize the deterministic BUILD/Aho tree.",
  "complexity": {
    "primary_time": "O(n*q+n^3) bounded word operations for adjacency rebuilds and BFS at at most 2*n-1 recursive subproblems",
    "primary_space": "O(q+n^2) fixed triplet, adjacency, task, and tree arrays",
    "independent_time": "O(n*q*alpha(n)+n^2) bounded word operations for union-find component formation at at most 2*n-1 subproblems",
    "independent_space": "O(q+n^2) fixed triplet, disjoint-set, task, and tree arrays"
  },
  "source": {
    "method_title": "Inferring a Tree from Lowest Common Ancestors with an Application to the Optimization of Relational Expressions",
    "method_author": "A. V. Aho, Y. Sagiv, T. G. Szymanski, and J. D. Ullman",
    "method_reference": "SIAM Journal on Computing 10(3), 1981, pages 405-421",
    "method_doi": "10.1137/0210030",
    "method_url": "https://doi.org/10.1137/0210030",
    "chapter_title": "Algorithms for Combining Rooted Triplets into a Galled Phylogenetic Network",
    "chapter_author": "Jesper Jansson and Wing-Kin Sung",
    "chapter_reference": "Encyclopedia of Algorithms, Chapter 92",
    "chapter_doi": "10.1007/978-1-4939-2864-4_92",
    "chapter_url": "https://doi.org/10.1007/978-1-4939-2864-4_92",
    "license": "No source-code license asserted; clean-room algorithm implementation"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,(a,b,c)*q] where each triple means ab|c and the clustered pair is unordered",
    "taxa_range": [1, 7],
    "triplet_count_range": "0 through 3*C(n,3)",
    "label_range": "0 through n-1",
    "triplet_rules": "Three distinct in-range labels; duplicate oriented triplets are invalid after sorting the clustered pair",
    "leaf_set_rule": "The leaf set is all labels 0..n-1, including labels absent from every triplet",
    "exact_length_formula": "2+3*q",
    "maximum_valid_length": 317,
    "maximum_parseable_length": 318,
    "invalid_input_result": -1,
    "validation_order": "Validate nullness, signed-i64 frame, n/q and exact length, label ranges and distinctness, and duplicate normalized triplets; then run BUILD; finally validate output pointer and capacity."
  },
  "contract": {
    "aho_graph": "For each current leaf subset S, vertices are S and edge {a,b} is present when input contains ab|c with a,b,c all in S.",
    "compatibility_rule": "For |S|>1, one connected component means incompatible. Otherwise recursively process all connected components and join their returned trees under a new root.",
    "canonical_tree": "The particular tree from the BUILD/Aho recurrence. Sort child components by their smallest taxon label solely for deterministic serialization; no global least-resolved optimality is claimed.",
    "output": "Compatible: little-endian i64 words [node_count, preorder_tokens...], where a leaf x is -(x+1) and an internal token is its child count. Incompatible: one i64 zero word [0].",
    "maximum_nodes": 13,
    "maximum_output_bytes": 112,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "output": {
    "kind": "raw_byte_array",
    "encoding": "Signed i64 words serialized little-endian",
    "maximum_output_bytes": 112,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "zero_length_output_allows_null_pointer": false
  },
  "workspace": {
    "bytes": 8192,
    "accounting": "Bounded triplet storage, a 7x7 adjacency matrix or DSU arrays, connected-component queue and masks, at most 13 tree-node records and traversal tasks, and serialized output staging."
  },
