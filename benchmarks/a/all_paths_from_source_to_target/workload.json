{
  "schema_version": 1,
  "id": "all-directed-simple-paths-java-dfs-v1",
  "algorithm": "all_paths_from_source_to_target",
  "function_symbol": "all_paths_from_source_to_target",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[vertex_count, edge_count, source, destination, (from,to)*]",
    "vertex_count_range": [1, 8],
    "edge_count_range": [0, 24],
    "vertex_ids": "zero-based in [0, vertex_count-1]",
    "directed_edges": true,
    "parallel_edges": "allowed and preserved in adjacency insertion order",
    "self_edges": "allowed; they cannot be used in a vertex-simple path",
    "maximum_emitted_paths": 1000,
    "invalid_input_result": -1,
    "path_limit_or_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_64_integer_bytes",
    "encoding": "[path_count, (path_length, vertex_ids...)*] in DFS discovery order",
    "source_equals_destination": "one path containing only the source vertex",
    "duplicate_paths": "preserved when distinct parallel-edge choices yield the same vertex sequence",
    "successful_result": "number of output bytes"
  },
  "cases": [
    {
      "id": "dfs_preserves_neighbor_insertion_order",
      "input_values": [4, 4, 0, 3, 0, 2, 0, 1, 2, 3, 1, 3],
      "expected_result": 72,
      "expected_output_hex": "02000000000000000300000000000000000000000000000002000000000000000300000000000000030000000000000000000000000000000001000000000000000300000000000000"
    },
    {
      "id": "parallel_edges_preserve_duplicate_paths",
      "input_values": [3, 3, 0, 2, 0, 1, 0, 1, 1, 2],
      "expected_result": 72,
      "expected_output_hex": "02000000000000000300000000000000000000000000000001000000000000000200000000000000030000000000000000000000000000000001000000000000000200000000000000"
    },
    {
      "id": "cycle_is_skipped_by_simple_path_guard",
      "input_values": [3, 3, 0, 2, 0, 1, 1, 0, 1, 2],
      "expected_result": 40,
      "expected_output_hex": "01000000000000000300000000000000000000000000000001000000000000000200000000000000"
    },
    {
      "id": "source_equals_destination",
      "input_values": [2, 1, 0, 0, 0, 1],
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000000000000000000"
    },
    {
      "id": "no_path",
      "input_values": [3, 1, 0, 2, 0, 1],
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "invalid_vertex_endpoint",
      "input_values": [2, 1, 0, 1, 0, 2],
      "expected_result": -1
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "repetitions_per_sample": 10000,
    "warmup_rounds": 2,
    "sample_count": 7
  }
}
