    "operation_order": "compute annuity factor, multiply by payment, then multiply by 1 + rate",
    "input_scaled_tolerance": 1e-9
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "input_scaled_tolerance": 1e-9,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
