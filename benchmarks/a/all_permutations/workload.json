{
  "schema_version": 1,
  "id": "all-permutations-index-order-i32-v1",
  "algorithm": "all_permutations",
  "input": {
    "kind": "length_prefixed_signed_32_bit_array",
    "encoding": "[n, values...]",
    "length_range": [
      0,
      6
    ],
    "value_range": [
      -2147483648,
      2147483647
    ],
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "output": "n! rows in depth-first input-index order; each row is n little-endian signed 32-bit values; duplicate values retain duplicate rows; n=0 returns one empty row and zero output bytes"
  },
  "cases": [
    {
      "id": "empty_has_one_empty_permutation",
      "input_values": [
        0
      ],
      "expected_result": 1,
      "expected_output_hex": ""
    },
    {
      "id": "singleton",
      "input_values": [
        1,
        -17
      ],
      "expected_result": 1,
      "expected_output_hex": "efffffff"
    },
    {
      "id": "input_index_traversal_order",
      "input_values": [
        3,
        2,
        1,
        3
      ],
      "expected_result": 6,
      "expected_output_hex": "020000000100000003000000020000000300000001000000010000000200000003000000010000000300000002000000030000000200000001000000030000000100000002000000"
    },
    {
      "id": "duplicate_values_keep_repeated_rows",
      "input_values": [
        3,
        4,
        4,
        -1
      ],
      "expected_result": 6,
      "expected_output_hex": "0400000004000000ffffffff04000000ffffffff040000000400000004000000ffffffff04000000ffffffff04000000ffffffff0400000004000000ffffffff0400000004000000"
    },
    {
      "id": "signed_i32_boundaries",
      "input_values": [
        3,
        -2147483648,
        0,
        2147483647
      ],
      "expected_result": 6,
      "expected_output_hex": "0000008000000000ffffff7f00000080ffffff7f000000000000000000000080ffffff7f00000000ffffff7f00000080ffffff7f0000008000000000ffffff7f0000000000000080"
    },
    {
      "id": "maximum_supported_length",
      "input_values": [
        6,
        6,
        1,
        5,
        2,
        4,
        3
      ],
      "expected_result": 720,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_negative_length",
      "input_values": [
        -1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_packed_length",
      "input_values": [
        2,
        7
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_length_above_bound",
      "input_values": [
        7,
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_value_above_i32",
      "input_values": [
        1,
        2147483648
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  }
}
