{
  "schema_version": 1,
  "id": "alpha-numerical-sort-ascii-comparator-v1",
  "algorithm": "alpha_numerical_sort",
  "function_symbol": "alpha_numerical_sort",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "argument_order": [
      "length_a",
      "length_b",
      "string_a_ascii...",
      "string_b_ascii..."
    ],
    "each_string_length_range": [
      0,
      64
    ],
    "character_set": "ASCII digits and lowercase English letters",
    "digit_runs": "canonical decimal representation with no leading zero unless the run is exactly 0",
    "invalid_input_result": -2
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "values": {
      "-1": "first string sorts before second",
      "0": "strings are equal",
      "1": "first string sorts after second"
    },
    "comparison": "exact"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
      "id": "natural-number-order",
      "input_values": [
        2,
        3,
        122,
        50,
        122,
        49,
        49
      ],
      "input_length": 7,
      "expected_result": -1
    },
    {
      "id": "same-numeric-token",
      "input_values": [
        5,
        5,
        105,
        116,
        101,
        109,
        51,
        105,
        116,
        101,
        109,
        51
      ],
      "input_length": 12,
      "expected_result": 0
    },
    {
      "id": "multi-digit-order",
      "input_values": [
        6,
        6,
        105,
        116,
        101,
        109,
        49,
        48,
        105,
        116,
        101,
        109,
        57,
        57
      ],
      "input_length": 14,
      "expected_result": -1
    },
    {
      "id": "alphabetic-order",
      "input_values": [
        5,
        4,
        97,
        108,
        112,
        104,
        97,
        98,
        101,
        116,
        97
      ],
      "input_length": 11,
      "expected_result": -1
    },
    {
      "id": "prefix-order",
      "input_values": [
        5,
        6,
        105,
        116,
        101,
        109,
        50,
        105,
        116,
        101,
        109,
        50,
        97
      ],
      "input_length": 13,
      "expected_result": -1
    },
    {
      "id": "letter-before-digit",
      "input_values": [
        1,
        2,
        97,
        49,
        48
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "empty-equality",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": 0
    },
    {
      "id": "invalid-uppercase",
      "input_values": [
        1,
        0,
        65
      ],
      "input_length": 3,
      "expected_result": -2
    },
    {
      "id": "invalid-leading-zero",
      "input_values": [
        2,
        1,
        48,
        49,
        49
      ],
      "input_length": 5,
      "expected_result": -2
    },
    {
      "id": "malformed-packed-length",
      "input_values": [
        2,
        1,
        97
      ],
      "input_length": 3,
      "expected_result": -2
    }
  ]
}
