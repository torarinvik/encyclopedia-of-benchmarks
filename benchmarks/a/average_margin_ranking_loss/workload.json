{
  "schema_version": 1,
  "id": "average-margin-ranking-loss-rust-bounded-integer-v1",
  "algorithm": "average_margin_ranking_loss",
  "function_symbol": "average_margin_ranking_loss",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[count, margin, y_true, x_first..., x_second...]",
    "pair_count_range": [
