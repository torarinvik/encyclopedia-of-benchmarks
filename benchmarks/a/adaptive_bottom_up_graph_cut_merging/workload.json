    "authors_mit_reimplementation": "https://github.com/patmjen/maxflow_algorithms/blob/master/reimpls/liusun.h",
    "reuse": "Algorithm descriptions only. This is a deterministic bounded profile, not an exact reproduction of the original parallel implementation."
