  "algorithm_profile": {
    "method": "Deterministic bounded profile of Liu-Sun adaptive bottom-up block merging.",
    "phase_one": "Solve each nonempty block in ascending ID order with all cross-block arcs disabled.",
    "merge_potential": "For each positive directed boundary half-arc, count one potential activation when endpoint phase-one residual tags differ; tags are unvisited, source-reachable, or sink-co-reachable.",
    "merge_order": "Descending static potential score, then ascending unordered block-ID pair; merge roots to the lower component ID.",
    "phase_two": "When two block components merge, restore every boundary arc internal to the new component and continue augmenting the preserved residual network.",
    "inner_solver": "Deterministic Edmonds-Karp augmenting paths, scanning node IDs ascending; the original Liu-Sun paper uses BK, and this bounded profile does not claim to reproduce BK tree reuse or the paper implementation's parallel schedule or tie behavior.",
    "maximum_result_derivation": "At most 8 source terminal arcs, each with capacity at most 7, bound the flow by 56."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "source": {
