{
  "schema_version": 1,
  "id": "astar-java-weighted-graph-bounded-v1",
  "algorithm": "astar_java_weighted_graph",
  "function_symbol": "astar_java_weighted_graph",
  "input": {
    "kind": "signed_i64_array",
    "layout": [
      "node_count",
      "edge_count",
      "start",
      "target",
      "heuristic[0..node_count)",
      "edge triples [from,to,weight]..."
    ],
    "node_count_range": [
      1,
      7
    ],
    "edge_count_range": [
      0,
      16
    ],
    "heuristic_range": [
      -1000,
      1000
    ],
    "edge_weight_range": [
      0,
      1000
    ],
    "graph": "undirected simple graph; self-loops and duplicate unordered edges are invalid",
    "path_expansion": "reject only vertices already present in current path; no global visited/best-distance table",
    "priority": "Java PriorityQueue min-heap by distance+heuristic, retaining its binary-heap tie behavior",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "success_layout": [
      "distance",
      "heuristic_at_target",
      "path_length",
      "path_vertices..."
    ],
    "not_found_layout": [
      -1,
      -1,
      0
    ],
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 50
