{
  "schema_version": 1,
  "id": "astar-rust-directed-weighted-graph-v1",
  "algorithm": "astar_rust_directed_graph",
  "function_symbol": "astar_rust_directed_graph",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[vertex_count, edge_count, source, target, h(0)..h(V-1), repeated directed (from,to,weight)]",
    "vertex_count_range": [
      1,
      32
    ],
    "edge_count_range": [
      0,
      128
    ],
    "vertex_ids": "0-based; every edge is directed",
    "heuristic_range": [
      0,
      1000000
    ],
    "edge_weight_range": [
      0,
      1000000
    ],
    "heuristic_constraint": "h(target)=0 and h(from) <= weight + h(to) for every edge",
    "invalid_input_result": -1,
    "unreachable_result": 0,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "[path_cost, vertex_count, source_vertex, ..., target_vertex]",
    "return_value": "number of output bytes; zero bytes means no path"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 50
  },
  "cases": [
    {
      "id": "weighted_directed_route",
      "input_values": [
        5,
        6,
        0,
        4,
        3,
        2,
        2,
        1,
        0,
        0,
        1,
        2,
        0,
        2,
        1,
        1,
        3,
        2,
        2,
        3,
        5,
        3,
        4,
        1,
        2,
        4,
        10
      ],
      "input_length": 27,
      "expected_result": 48,
      "expected_output_hex": "050000000000000004000000000000000000000000000000010000000000000003000000000000000400000000000000"
    },
    {
      "id": "unreachable_reverse_direction",
      "input_values": [
        3,
        1,
        1,
        0,
        0,
        0,
        0,
        0,
        1,
        4
      ],
      "input_length": 10,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "equal_cost_tie_uses_lower_vertex",
      "input_values": [
        4,
        4,
        0,
        3,
        0,
        0,
