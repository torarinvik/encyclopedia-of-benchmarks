{
  "schema_version": "1.0.0",
  "id": "approximate-regex-matching-layered-edit-nfa-v1",
  "algorithm": "approximate_regex_matching",
  "function_symbol": "approximate_regex_matching",
  "comparison_model": "i64_array_bytes_output_call",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[state_count,transition_count,text_length,max_errors,start_state,accept_state,(src,dst,label)*transition_count,text_ascii...]",
    "state_count_range": [2, 8],
    "transition_count_range": [1, 16],
    "text_length_range": [0, 12],
    "max_errors_range": [0, 3],
    "state_ids": "zero-based; start_state and accept_state must differ",
    "transition_labels": "ASCII byte values 1..127; one consuming symbol per edge; nondeterminism and cycles are allowed",
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_result": -1
  },
  "output": {
    "kind": "byte_array",
    "description": "One byte per text ending position, 1 when some nonempty substring ending there is within max_errors unit edits of a start-to-accept NFA path, else 0.",
    "maximum_output_bytes": 12,
    "success_result": "text_length",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_when_nonempty_result": -2
  },
  "workspace": {
    "bytes": 1040,
    "meaning": "Eight states by thirteen text boundaries of bounded edit-distance values and transition storage."
  },
  "measurement": {"sample_count": 7, "warmup_rounds": 2, "repetitions_per_sample": 1000},
  "cases": [
    {"id":"exact-literal-path", "input_values":[3,2,4,0,0,2,0,1,97,1,2,98,122,97,98,120], "input_length":16, "expected_result":4, "expected_output_hex":"00000100"},
    {"id":"one-substitution-and-short-prefix", "input_values":[3,2,2,1,0,2,0,1,97,1,2,98,97,120], "input_length":14, "expected_result":2, "expected_output_hex":"0101"},
    {"id":"deletion-before-exact-substring", "input_values":[3,2,3,1,0,2,0,1,97,1,2,98,97,97,98], "input_length":15, "expected_result":3, "expected_output_hex":"010101"},
    {"id":"automaton-cycle-star-shaped", "input_values":[2,2,4,0,0,1,0,0,97,0,1,98,97,97,97,98], "input_length":16, "expected_result":4, "expected_output_hex":"00000001"},
    {"id":"duplicate-transition-invalid", "input_values":[2,2,1,0,0,1,0,1,97,0,1,97,97], "input_length":13, "expected_result":-1, "expected_output_hex":""},
    {"id":"short-output-capacity", "input_values":[3,2,4,0,0,2,0,1,97,1,2,98,122,97,98,120], "input_length":16, "expected_result":-2, "expected_output_hex":"", "workspace_bytes":3, "capacity_error_result":-2}
  ]
}
