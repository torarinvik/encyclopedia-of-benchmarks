{
  "schema_version": 1,
  "id": "boyer-moore-ag-all-matches-v1",
  "algorithm": "boyer_moore_ag",
  "function_symbol": "boyer_moore_ag",
  "input": {
    "kind": "signed_64_bit_text_pattern_byte_arrays",
    "minimum_length": 2,
    "maximum_length": 512,
    "maximum_text_bytes": 255,
    "maximum_pattern_bytes": 255,
    "minimum_pattern_bytes": 1,
    "byte_range": "ASCII values 0 through 127",
    "empty_pattern": "rejected to avoid nontermination in the source algorithm",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "byte_array",
    "encoding_output": "ascending zero-based match positions, one unsigned byte per match"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_text_no_match",
      "input_values": [0, 1, 65],
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "empty_pattern_rejected",
      "input_values": [3, 0, 65, 66, 67],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "pattern_longer_than_text",
      "input_values": [2, 3, 65, 66, 65, 66, 67],
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "all_matches_with_overlap",
      "input_values": [4, 2, 65, 65, 65, 65, 65, 65],
      "expected_result": 3,
      "expected_output_hex": "000102"
    },
    {
      "id": "multiple_matches",
      "input_values": [9, 2, 97, 98, 97, 98, 99, 97, 98, 97, 98, 97, 98],
      "expected_result": 4,
      "expected_output_hex": "00020507"
    },
    {
      "id": "overlapping_pattern",
      "input_values": [5, 3, 65, 66, 65, 66, 65, 65, 66, 65],
      "expected_result": 2,
      "expected_output_hex": "0002"
    },
    {
      "id": "exact_match",
      "input_values": [3, 3, 65, 66, 67, 65, 66, 67],
      "expected_result": 1,
      "expected_output_hex": "00"
    },
    {
      "id": "no_match",
      "input_values": [5, 2, 65, 66, 67, 68, 69, 70, 71],
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "embedded_nul",
      "input_values": [3, 1, 65, 0, 66, 0],
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "ascii_boundary_byte",
      "input_values": [3, 1, 32, 127, 32, 127],
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "non_ascii_byte_rejected",
      "input_values": [1, 1, 128, 65],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated_packed_input",
      "input_values": [3, 1, 65, 66],
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
