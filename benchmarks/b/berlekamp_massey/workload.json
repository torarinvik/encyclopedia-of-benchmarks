{
  "schema_version": 1,
  "id": "oi-wiki-berlekamp-massey-bounded-shortest-recurrence-v1",
  "algorithm": "berlekamp_massey",
  "function_symbol": "berlekamp_massey",
  "abi": "i64_array_bytes_output",
  "description": "Infer the shortest predictive linear recurrence of a finite sequence over 998244353.",
  "source": {
    "title": "Berlekamp–Massey Algorithm",
    "authors": ["OI Wiki contributors"],
    "reference": "OI Wiki algorithm article",
    "url": "https://oiwiki.com/math/berlekamp-massey/",
    "algorithm_attribution": "Incremental discrepancy updates over a prime field",
    "implementation_status": "clean-room bounded recurrence inference"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[K, a_0, ..., a_(2K-1)]",
    "order_bound_range": [1, 8],
    "sequence_length": "exactly 2K terms",
    "entry_range": "0 <= a_i < 998244353",
    "maximum_valid_length": 17,
    "maximum_parseable_length": 18,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "L+1 signed 64-bit little-endian words: recurrence order L, then predictive coefficients c_0..c_(L-1)",
    "maximum_bytes": 72,
    "success_result": "8*(L+1) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 72,
    "meaning": "Output-buffer capacity; recurrence state arrays are separate."
  },
  "contract": {
    "result": "Shortest recurrence order L and coefficients satisfying a_i = sum(c_j*a_(i-j-1)) for each supplied i >= L",
    "modulus": 998244353,
    "complexity": "O(K^2) field operations and O(K) state storage",
    "max_order": 8
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
