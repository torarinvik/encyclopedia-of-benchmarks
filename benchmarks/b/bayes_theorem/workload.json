    {"id":"certain_evidence","input_values":[0.6,1.0,0.5],"expected_result":0.3},
    {"id":"small_probabilities","input_values":[0.000001,0.000001,1.0],"expected_result":1.0},
    {"id":"zero_evidence","input_values":[0.25,0.0,0.0],"expected_result":-1.0},
