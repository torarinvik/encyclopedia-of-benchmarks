{
  "schema_version": 1,
  "id": "bayes-theorem-posterior-binary64-v1",
  "algorithm": "bayes_theorem",
  "function_symbol": "bayes_theorem",
  "input": {
    "kind": "finite_binary64_probabilities",
    "layout": "[probability_a, probability_b, probability_b_given_a]",
