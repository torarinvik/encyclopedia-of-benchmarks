{
  "schema_version": 1,
  "id": "brace-range-expansion-i64-array-bytes-output-v1",
  "algorithm": "brace_range_expansion",
  "function_symbol": "brace_range_expansion",
  "abi": "i64_array_bytes_output",
  "description": "Expand one bounded numeric or same-case ASCII letter sequence inside a printable pattern.",
  "input": {
    "kind": "signed_64_bit_integer_array",
