    "discovery_note": "Codewars public title/tag catalog only; discovery only, with no task content used.",
    "discovery_url": "https://www.codewars.com/kata?tags=Algorithms%2CNumber+Theory",
    "method_source": "Dexter Kozen, Cornell CS 4810 lecture notes, DFA for binary numbers divisible by 3",
    "method_url": "https://www.cs.cornell.edu/kozen/Papers/481.pdf",
    "reuse_scope": "Algorithmic method context only; this package defines a clean-room bounded ABI profile."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[L, bit_0, ..., bit_(L-1)] with MSB-first bits",
    "bit_count_range": [1, 4096],
    "bit_value_range": [0, 1],
    "leading_zeroes": "accepted and included in L",
