  "contract": {
    "primary_method": "Start in remainder state 0 and update r=(2*r+bit) mod 3 for each bit; accept exactly when the final state is 0.",
    "independent_method": "Evaluate the alternating-sign sum of the bits, since 2 is congruent to -1 modulo 3; the represented value is divisible exactly when that sum is 0 modulo 3.",
    "complexity": "O(L) time and O(1) auxiliary state.",
    "invalid_cases": "Null input, L outside 1..4096, non-exact framing, or a bit outside {0,1} returns -1 before output checks.",
    "distinct_from": "binary_to_decimal materializes a signed-i64 value and is capped at 63 bits; this profile accepts up to 4096 bits and keeps only one of three remainder states. is_divisible checks numeric scalar operands with remainder and does not scan a binary stream."
  },
  "measurement": {
