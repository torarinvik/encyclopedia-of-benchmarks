{
  "schema_version": 1,
  "id": "binary-search-2d-array-java-row-major-index-v1",
  "algorithm": "binary_search2d_array",
  "function_symbol": "binary_search2d_array",
  "input": {
    "kind": "dimensions_target_and_row_major_matrix",
    "encoding": "[rows, columns, target, matrix...]",
    "rows_range": [2, 32],
    "columns_range": [3, 32],
    "matrix_value_range": [-2147483648, 2147483647],
    "target_range": [-2147483648, 2147483647],
    "ordering": "strictly increasing across each row and each column",
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "row-major index row * columns + column when found; -1 when absent",
    "coordinate_encoding": "The source's [row, column] coordinate is flattened to one row-major index."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"minimum_dimensions_first_cell","input_values":[2,3,0,0,2,4,100,102,104],"input_length":9,"expected_result":0},
    {"id":"minimum_dimensions_second_row","input_values":[2,3,101,0,2,4,100,101,104],"input_length":9,"expected_result":4},
    {"id":"middle_column_hit","input_values":[4,5,204,0,2,4,6,8,100,102,104,106,108,200,202,204,206,208,300,302,304,306,308],"input_length":23,"expected_result":12},
    {"id":"start_row_left_slice","input_values":[4,5,2,0,2,4,6,8,100,102,104,106,108,200,202,204,206,208,300,302,304,306,308],"input_length":23,"expected_result":1},
    {"id":"start_row_right_slice","input_values":[4,5,6,0,2,4,6,8,100,102,104,106,108,200,202,204,206,208,300,302,304,306,308],"input_length":23,"expected_result":3},
    {"id":"end_row_left_slice","input_values":[4,5,302,0,2,4,6,8,100,102,104,106,108,200,202,204,206,208,300,302,304,306,308],"input_length":23,"expected_result":16},
    {"id":"end_row_right_slice","input_values":[4,5,306,0,2,4,6,8,100,102,104,106,108,200,202,204,206,208,300,302,304,306,308],"input_length":23,"expected_result":18},
    {"id":"gap_between_rows","input_values":[4,5,50,0,2,4,6,8,100,102,104,106,108,200,202,204,206,208,300,302,304,306,308],"input_length":23,"expected_result":-1},
    {"id":"below_minimum","input_values":[2,3,-1,0,2,4,100,102,104],"input_length":9,"expected_result":-1},
    {"id":"above_maximum","input_values":[2,3,105,0,2,4,100,102,104],"input_length":9,"expected_result":-1},
    {"id":"too_few_rows","input_values":[1,3,0,0,2,4],"input_length":6,"expected_result":-1},
    {"id":"too_few_columns","input_values":[2,2,0,0,2,100,102],"input_length":7,"expected_result":-1},
    {"id":"packed_length_mismatch","input_values":[2,3,0,0,2,4,100,102],"input_length":8,"expected_result":-1}
  ]
}
