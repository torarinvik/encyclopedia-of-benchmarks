{
  "schema_version": 1,
  "id": "binomial-heap-trace-v1",
  "algorithm": "binomial_heap",
  "function_symbol": "binomial_heap",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation_count,(opcode,argument)*]",
    "operation_count_range": [
      0,
      128
    ],
    "opcodes": {
      "0": "insert(value)",
      "1": "peek_min(argument=0)",
      "2": "delete_min(argument=0)",
      "3": "is_empty(argument=0)"
    },
    "insert_value_range": [
      -2147483648,
      2147483647
    ],
    "duplicates": "allowed and preserved",
    "empty_peek_or_delete": "invalid input; source dereferences missing min_node",
    "exact_length": "1 + 2 * operation_count",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "meaning": "query results in trace order; is_empty is 1 when empty and 0 otherwise",
    "return_value": "number of output values written",
    "maximum_output_bytes": 1024
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_trace",
      "input_values": [
        0
      ],
      "expected_result": 0,
      "expected_output_hex": ""
    },
