{
  "schema_version": 1,
  "id": "batch-dynamic-kd-tree-i64-array-bytes-output-v1",
  "algorithm": "batch_dynamic_kd_tree",
  "function_symbol": "batch_dynamic_kd_tree",
  "description": "Bounded logarithmic forest with batched insert/delete updates and one exact nearest-distance query after each batch.",
  "pinned_sources": [
    {
      "repository": "ParAlg/ParGeo",
      "commit": "4911408762c46b7c262f6d617d7adcb0cb0f219b",
      "path": "include/batchKdtree/log-tree/logtree.h",
      "related_paths": [
        "include/batchKdtree/shared/kdtree.h",
        "example/batchKdTree.cpp",
        "LICENSE"
      ],
      "symbol": "pargeo::batchKdTree::LogTree::insert and KdTree::knn",
      "url": "https://github.com/ParAlg/ParGeo/blob/4911408762c46b7c262f6d617d7adcb0cb0f219b/include/batchKdtree/log-tree/logtree.h",
      "license": "MIT; complete notice bundled in LICENSE.txt."
    }
  ],
  "contract": {
    "operation": "Apply each insert or delete batch to a logarithmic forest, then return the exact squared distance from its query to the nearest active point.",
    "input_layout": "[initial_count,(id,x,y)*,batch_count,(kind,count,payload...,qx,qy)*]",
    "bounds": {
      "initial_points": [
        0,
        8
      ],
      "batches": [
        1,
        8
      ],
      "updates_per_batch": [
        1,
        8
      ],
      "lifetime_inserted_ids": [
        1,
        32
      ],
      "coordinate": [
        -1000,
        1000
      ]
    },
    "batch_kinds": {
      "0": "insert count (id,x,y) records",
      "1": "delete count IDs"
    },
    "id_rules": "IDs are 0..31 and cannot be reused in one call. Active points must have distinct coordinates. Deletes must name distinct active IDs.",
    "semantics": "Each batch is applied completely before its following query. Inserts carry through binary logarithmic levels; deletes mark points inactive. Each query observes the minimum squared Euclidean distance to any active point. Empty post-batch sets are invalid.",
    "output_encoding": "One signed 64-bit little-endian squared distance per batch query",
    "output_bytes": "8*batch_count",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Malformed frame, invalid update, duplicate active coordinate, or empty queried set returns -1 before output checks. Null output or capacity below 8*batch_count returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "counted initial point records followed by counted update/query batches",
    "maximum_input_length": 250,
    "valid_ranges": {
      "id": "0..31, unique for call lifetime",
      "coordinates": "-1000..1000",
      "initial_count": "0..8",
      "batch_count": "1..8",
      "batch_size": "1..8"
    },
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "signed little-endian i64 distances",
    "maximum_bytes": 64,
    "success_result": "8*batch_count bytes",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 64,
    "meaning": "Maximum staged output for eight signed 64-bit nearest-distance results."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
