  "algorithm": "burnside_bracelets",
  "function_symbol": "burnside_bracelets",
  "abi": "i64_array_bytes_output",
  "description": "Count colorings of a cycle up to rotations and reflections using Burnside's lemma.",
  "source": {
    "title": "Burnside's lemma / Pólya enumeration theorem",
    "authors": ["CP-Algorithms contributors"],
    "reference": "CP-Algorithms combinatorics article",
    "url": "https://cp-algorithms.com/combinatorics/burnside.html",
    "algorithm_attribution": "Burnside averaging over the dihedral action, with fixed colorings counted from permutation cycles",
    "implementation_status": "clean-room bounded cycle enumeration ports"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, color_count]",
    "N_range": [1, 10],
    "color_count_range": [0, 3],
    "maximum_valid_length": 2,
    "maximum_parseable_length": 3,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian number of coloring orbits",
    "maximum_bytes": 8,
    "success_result": "8 bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 8,
    "meaning": "Output-buffer capacity; the temporary permutation-cycle marker array is separate."
  },
  "contract": {
    "result": "Exact number of colorings of N cyclic positions modulo the dihedral rotations-and-reflections action, using color_count available colors",
    "group_elements": "N rotations and N reflections, including repeated induced permutations for N=1 or N=2",
    "zero_colors": "No colorings exist when N is positive",
    "complexity": "O(N^2) time and O(N) auxiliary storage",
    "oracle": "Exhaustively enumerate colorings and count canonical dihedral-orbit representatives"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
