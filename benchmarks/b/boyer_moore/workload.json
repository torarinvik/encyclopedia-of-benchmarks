{
  "schema_version": 1,
  "id": "boyer-moore-full-ascii-v1",
  "algorithm": "boyer_moore",
  "function_symbol": "boyer_moore",
  "input": {
    "kind": "packed_ascii_byte_sequences",
    "encoding": "[text_byte_length, pattern_byte_length, text_bytes..., pattern_bytes...]",
    "text_and_pattern_length_range": [0, 4096],
    "element_range": [0, 126],
    "result": "first matching byte index; 0 for an empty pattern; -1 when absent or invalid"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 500
  },
  "cases": [
    {"id":"empty-text-and-pattern","input_values":[0,0],"input_length":2,"expected_result":0},
    {"id":"empty-pattern","input_values":[3,0,97,98,99],"input_length":5,"expected_result":0},
    {"id":"pattern-longer-than-text","input_values":[3,4,97,98,99,97,98,99,100],"input_length":9,"expected_result":-1},
    {"id":"source-style-middle-match","input_values":[11,5,104,101,108,108,111,32,119,111,114,108,100,119,111,114,108,100],"input_length":18,"expected_result":6},
    {"id":"first-of-multiple-matches","input_values":[5,3,97,98,97,98,97,97,98,97],"input_length":10,"expected_result":0},
    {"id":"overlapping-matches","input_values":[5,3,97,97,97,97,97,97,97,97],"input_length":10,"expected_result":0},
    {"id":"good-suffix-shift","input_values":[12,6,88,88,67,68,65,66,65,66,67,68,65,66,65,66,67,68,65,66],"input_length":20,"expected_result":6},
    {"id":"bad-character-shift","input_values":[5,3,88,88,65,66,67,65,66,67],"input_length":10,"expected_result":2},
    {"id":"no-match-after-partial-prefix","input_values":[6,4,97,97,97,97,97,98,97,97,97,99],"input_length":12,"expected_result":-1},
    {"id":"control-byte","input_values":[4,2,0,65,0,65,0,65],"input_length":8,"expected_result":0},
    {"id":"highest-accepted-ascii-byte","input_values":[4,1,65,126,66,126,126],"input_length":7,"expected_result":1},
    {"id":"empty-text-with-nonempty-pattern","input_values":[0,1,97],"input_length":3,"expected_result":-1},
    {"id":"invalid-byte","input_values":[1,1,127,127],"input_length":4,"expected_result":-1},
    {"id":"trailing-packed-value","input_values":[1,1,97,97,98],"input_length":5,"expected_result":-1}
  ]
}
