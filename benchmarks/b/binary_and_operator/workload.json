{
  "schema_version": 1,
  "id": "binary-and-operator-padded-binary-v1",
  "algorithm": "binary_and_operator",
  "function_symbol": "binary_and_operator",
  "input": {
    "kind": "two_nonnegative_signed_i64_values",
    "value_range": [
      0,
      2147483647
    ],
    "output": "ASCII 0b prefix followed by result padded to max(1, bit_length(a), bit_length(b))",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "cases": [
    {
      "id": "python_example_zero",
      "input_values": [
        25,
        32
      ],
      "expected_result": 8,
      "expected_output_hex": "3062303030303030"
    },
    {
      "id": "python_example_one",
      "input_values": [
        37,
        50
      ],
      "expected_result": 8,
      "expected_output_hex": "3062313030303030"
    },
    {
      "id": "python_example_twenty",
      "input_values": [
        21,
        30
      ],
      "expected_result": 7,
      "expected_output_hex": "30623130313030"
    },
    {
      "id": "python_example_leading_zeroes",
      "input_values": [
        58,
        73
      ],
      "expected_result": 9,
      "expected_output_hex": "306230303031303030"
    },
    {
      "id": "zero_and_byte",
      "input_values": [
        0,
        255
      ],
      "expected_result": 10,
      "expected_output_hex": "30623030303030303030"
    },
    {
      "id": "equal_power_of_two",
      "input_values": [
        256,
        256
      ],
      "expected_result": 11,
      "expected_output_hex": "3062313030303030303030"
    },
    {
      "id": "disjoint_bits",
      "input_values": [
        5,
        10
      ],
      "expected_result": 6,
      "expected_output_hex": "306230303030"
    },
    {
      "id": "maximum_width",
      "input_values": [
        2147483647,
        1073741824
      ],
      "expected_result": 33,
      "expected_output_hex": "306231303030303030303030303030303030303030303030303030303030303030"
    },
    {
      "id": "negative_input",
      "input_values": [
        -1,
        0
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "oversized_input",
      "input_values": [
        2147483648,
        1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "wrong_arity",
      "input_values": [
        1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient_output_capacity",
      "input_values": [
        25,
        32
      ],
      "workspace_bytes": 7,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
}
