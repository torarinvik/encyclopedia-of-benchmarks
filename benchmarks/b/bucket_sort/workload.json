{
  "schema_version": 1,
  "id": "bucket_sort-v1",
  "algorithm": "bucket_sort",
  "abi": "mutable_i64_with_scratch",
  "input": {
    "lengths": [0, 16, 256, 1024],
    "generation": {
      "kind": "modular_affine",
      "multiplier": 6000000000000000,
      "modulus": 8000000000000000000,
      "offset": 4000000000000000000,
      "formula": "values[index] = ((index * 6000000000000000) mod 8000000000000000000) - 4000000000000000000"
    }
  },
  "scratch_elements_extra": 256,
  "measurement": {
    "timer": "clock()",
    "comparison_model": "sort_call",
    "warmup_rounds": 2,
    "sample_count": 7,
    "scratch_allocation_timed": false
  }
}
