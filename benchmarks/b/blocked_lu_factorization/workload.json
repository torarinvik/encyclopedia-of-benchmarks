  "contract": {
    "operation": "Serial right-looking LU factorization with fixed block width two, no pivoting, and block panel/diagonal-tile solves followed by trailing tile updates.",
    "input_encoding": "[N, row-major N by N matrix]",
    "matrix_shape": "N by N row-major; N is even in 2..8",
    "input_values": "Exact binary64 integers; diagonal 1..16, off-diagonal -2..2, with A[i,i] greater than the sum of absolute off-diagonal entries in row i.",
    "block_schedule": "For k=0,2,...,N-2 factor the current 2x2 diagonal tile; solve each 2-column block row against its unit-lower tile and each 2-row block column against its upper tile; update each trailing tile by subtracting the two ordered inner products.",
    "parallel_scope": "Serial kernel only. Processor assignment, barriers, and the parallel schedule are outside the ABI.",
    "output_encoding": "Full row-major L followed by full row-major U, with unit diagonal in L and structural zeros outside the triangles.",
    "errors": "Malformed framing, unsupported bounds, nonintegral/out-of-range entries, a row that violates strict diagonal dominance, a zero/nonfinite pivot, or a nonfinite factor returns -1 before output checks. Null output or capacity below 2*N*N returns -2 without writes."
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[N, matrix_row_major...]",
    "dimension_range": [2, 8],
    "dimension_must_be_even": true,
    "diagonal_range": [1, 16],
    "off_diagonal_range": [-2, 2],
    "matrix_values_must_be_integers": true,
    "rows_must_be_strictly_diagonally_dominant": true,
    "exact_packed_shape": "Exactly 1+N*N finite elements.",
    "maximum_valid_input_length": 65,
    "maximum_parseable_input_length": 66,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
