{
  "schema_version": 1,
  "id": "burrows-wheeler-transform-ascii-v1",
  "algorithm": "burrows_wheeler_transform",
  "function_symbol": "burrows_wheeler_transform",
  "input": {
    "kind": "packed_ascii_byte_sequence",
    "encoding": "[length, byte_0, ..., byte_(length-1)]",
    "length_range": [
      1,
      256
    ],
    "byte_range": [
      0,
      127
    ],
    "output_encoding": "four-byte unsigned little-endian primary row index followed by transformed bytes",
    "periodic_rotation_tie_break": "ascending starting offset",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
