{
  "schema_version": 1,
  "id": "binary-tree-is-full-v1",
  "algorithm": "binary_tree_is_full",
  "function_symbol": "binary_tree_is_full",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[node_count,root,(left_child,right_child)*]",
    "node_count_range": [
      1,
      1024
    ],
    "child_index_range": "-1 for absent or 0 through node_count - 1",
    "exact_length": "2 + 2 * node_count",
    "validity": "one connected rooted tree; root has no parent and all other nodes have exactly one parent",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "1 if every node has zero or two children; otherwise 0 for valid trees",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "single_leaf",
      "input_values": [
        1,
        0,
        -1,
        -1
      ],
      "expected_result": 1
    },
    {
      "id": "two_children_leaf_root",
      "input_values": [
        3,
        0,
        1,
        2,
        -1,
        -1,
        -1,
        -1
      ],
      "expected_result": 1
    },
    {
      "id": "full_five_nodes",
      "input_values": [
        5,
        0,
        1,
        2,
        3,
        4,
        -1,
        -1,
        -1,
        -1,
        -1,
        -1
      ],
      "expected_result": 1
    },
    {
      "id": "perfect_seven_nodes",
      "input_values": [
        7,
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        -1,
        -1,
        -1,
        -1,
        -1,
        -1,
        -1,
        -1
      ],
      "expected_result": 1
    },
    {
      "id": "one_left_child",
      "input_values": [
        2,
        0,
        1,
        -1,
        -1,
        -1
      ],
      "expected_result": 0
    },
    {
      "id": "one_right_child",
      "input_values": [
        2,
        0,
        -1,
        1,
        -1,
        -1
      ],
      "expected_result": 0
    },
    {
      "id": "incomplete_medium_tree",
      "input_values": [
        7,
        0,
        1,
        2,
        3,
        4,
        -1,
        5,
        -1,
        -1,
        -1,
        -1,
        -1,
        6,
        -1,
        -1
      ],
      "expected_result": 0
    },
    {
      "id": "arbitrary_root_index",
      "input_values": [
        3,
        2,
        -1,
        -1,
        -1,
        -1,
        0,
        1
      ],
      "expected_result": 1
    },
    {
      "id": "empty_tree_outside_contract",
      "input_values": [
        0,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "wrong_packed_length",
      "input_values": [
        2,
        0,
        1,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "root_out_of_range",
      "input_values": [
        1,
        1,
        -1,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "child_out_of_range",
      "input_values": [
        1,
        0,
        1,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "self_child",
      "input_values": [
        1,
        0,
        0,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "shared_child",
      "input_values": [
        3,
        0,
        1,
        2,
        2,
        -1,
        -1,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "root_has_parent",
      "input_values": [
        2,
        0,
        1,
        -1,
        0,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "disconnected_cycle",
      "input_values": [
        4,
        0,
        1,
        -1,
        -1,
        -1,
        3,
        -1,
        2,
        -1
      ],
      "expected_result": -1
    },
    {
      "id": "node_count_over_limit",
      "input_values": [
        1025,
        0
      ],
      "expected_result": -1
    }
  ]
}
