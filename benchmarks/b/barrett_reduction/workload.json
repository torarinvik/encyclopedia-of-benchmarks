    {"id":"zero-and-exact-multiple", "input_values":[13,3,0,26,168], "input_length":5, "expected_result":42},
    {"id":"reciprocal-estimate-needs-correction", "input_values":[65281,1,4261576320], "input_length":3, "expected_result":32641},
    {"id":"maximum-valid-frame", "input_values":[65535,12,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224], "input_length":14, "expected_result":5111730},
    {"id":"maximum-parseable-trailing-value", "input_values":[65535,12,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,4294836224,17], "input_length":15, "expected_result":-1},
    {"id":"modulus-too-small", "input_values":[1,0], "input_length":2, "expected_result":-1},
    {"id":"count-too-large", "input_values":[7,13], "input_length":2, "expected_result":-1},
