{
  "schema_version": 1,
  "id": "barrett-reduction-i64-array-scalar-v1",
  "algorithm": "barrett_reduction",
  "function_symbol": "barrett_reduction",
  "abi": "i64_array_scalar",
  "description": "Reduce a batch of bounded values using a fixed-radix reciprocal estimate and one correction subtraction.",
  "source": {
    "title": "Implementing the Rivest Shamir and Adleman Public Key Encryption Algorithm on a Standard Digital Signal Processor",
    "author": "Paul Barrett",
    "reference": "Advances in Cryptology — CRYPTO ’86, Lecture Notes in Computer Science 263, 311–323 (1987).",
    "doi": "10.1007/3-540-47721-7_24",
    "url": "https://doi.org/10.1007/3-540-47721-7_24",
    "paper_copy": "https://www.loper-os.org/pub/barrett_1986.pdf",
    "implementation_status": "Clean-room fixed-radix bounded specialization; no paper code copied."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[modulus,count,value[0],...,value[count-1]]",
    "modulus_range": [2, 65535],
    "count_range": [0, 12],
    "value_range": "0 <= value[i] < modulus^2",
    "exact_length": "2 + count",
    "maximum_valid_length": 14,
    "maximum_parseable_length": 15,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "sum((i+1)*(remainder[i]+1)) using zero-based i",
    "maximum_result": 5111730,
    "invalid_input_result": -1
  },
  "contract": {
    "reciprocal_scale": "2^32",
    "reciprocal": "floor(2^32/modulus), computed once per call",
    "quotient_estimate": "floor(value*reciprocal/2^32)",
    "correction": "Subtract modulus once if value-estimated_quotient*modulus >= modulus.",
    "product_bound": "value*reciprocal < modulus*2^32 < 2^48, so signed i64 multiplication is safe.",
    "residual_bound": "The quotient estimate is exact or one low; the residual is in [0,2*modulus), so one subtraction is sufficient.",
    "empty_batch": "A valid batch with count zero returns zero.",
    "null_input_result": -1
  },
  "complexity": {
    "time": "O(count) after one reciprocal division per call.",
    "space": "O(1)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 11,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
