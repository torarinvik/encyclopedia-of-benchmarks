    {"id":"shape-invalid","input_values":[2,0,1,0],"input_length":4,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[1,0,1],"input_length":3,"expected_result":-2,"expected_output_hex":"","workspace_bytes":39,"capacity_error_result":-2}
  ]
