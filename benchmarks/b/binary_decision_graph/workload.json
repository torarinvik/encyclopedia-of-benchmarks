    {"id":"two-variable-and","input_values":[2,0,0,0,1],"input_length":5,"expected_result":64,"expected_output_hex":"03000000000000000200000000000000010000000000000000000000000000000100000000000000000000000000000000000000000000000200000000000000"},
    {"id":"constant-zero","input_values":[3,0,0,0,0,0,0,0,0],"input_length":9,"expected_result":16,"expected_output_hex":"00000000000000000000000000000000"},
