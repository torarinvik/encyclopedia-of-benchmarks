{
  "schema_version": 1,
  "id": "belady-optimal-paging-bounded-v1",
  "algorithm": "belady_optimal_paging",
  "function_symbol": "belady_optimal_paging",
  "abi": "i64_array_scalar",
  "description": "Replay a bounded reference sequence with the offline farthest-next-use eviction rule.",
  "source": {
    "title": "A Study of Replacement Algorithms for a Virtual-Storage Computer",
    "authors": ["L. A. Belady"],
    "year": 1966,
    "reference": "IBM Systems Journal 5(2), pages 78-101, DOI 10.1147/SJ.52.0078",
    "url": "https://doi.org/10.1147/SJ.52.0078",
    "copyright": "Algorithm idea and bibliographic attribution only; contract and code are clean-room work."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[capacity, request_count, page_ids...]",
    "capacity_range": [1, 8],
    "request_count_range": [0, 64],
    "page_id_range": [0, 15],
    "maximum_valid_input_length": 66,
    "maximum_parseable_input_length": 67,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "faults*33281 + sum((one_based_request_position)*(evicted_page_id+1))",
    "fault_radix": 33281,
    "maximum_eviction_checksum": 33280,
    "maximum_result": 2163264,
    "invalid_result": -1
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "Reverse-built next-use table for up to 64 requests and 16 page IDs, cache-presence flags, counters, and input/output staging"
  },
  "contract": {
    "operation": "Count page faults and apply Belady's offline optimal replacement rule to the supplied request trace.",
    "victim_rule": "Evict the resident page with the farthest next request; pages with no future request are tied at infinity.",
    "tie_rule": "Among equally distant resident pages, evict the smallest page ID.",
    "complexity": "O(N*P) time and O(N*P) auxiliary space for N<=64 requests and P=16 page IDs.",
    "error_precedence": "Validate the complete frame before replaying it.",
    "no_external_state": true
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100,
