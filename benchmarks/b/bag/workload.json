  "input": {
    "kind": "signed_i64_array",
    "layout": "[insert_count, inserted_i32_values..., query_count, query_i32_values...]",
    "insert_count_range": "0 through 128",
    "query_count_range": "0 through 64",
    "value_range": "signed 32-bit integers",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
