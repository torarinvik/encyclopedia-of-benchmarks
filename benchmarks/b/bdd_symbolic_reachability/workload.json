{
  "schema_version": 1,
  "id": "bdd-symbolic-reachability-i64-array-scalar-v1",
  "algorithm": "bdd_symbolic_reachability",
  "function_symbol": "bdd_symbolic_reachability",
  "abi": "i64_array_scalar",
  "description": "Compute a finite transition system's reachable-state mask by ROBDD relational products and report whether an invariant is violated.",
  "source": {
    "definition_url": "https://doi.org/10.1007/978-1-4939-2864-4_416",
    "definition_title": "Symbolic Model Checking, Encyclopedia of Algorithms, Chapter 416",
    "representation_url": "https://doi.org/10.1007/978-1-4939-2864-4_48",
    "independent_method": "explicit-state fixed-point reachability over the same bounded transition table"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,initial_mask,invariant_mask,T...]",
    "n_range": [
      1,
      3
    ],
    "m_range": [
      0,
      1
    ],
    "exact_length_formula": "4 + 2^(2*n+m)",
    "maximum_valid_length": 132,
    "maximum_parseable_length": 133,
    "relation_variable_order": "[current-state bits, input bits, next-state bits], each bit-vector MSB first",
    "relation_index_formula": "((state * 2^m + input) * 2^n + next_state)",
    "initial_mask_bit": "bit s is one iff state s is initially reachable",
    "invariant_mask_bit": "bit s is one iff state s satisfies the invariant",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "(reachable_mask << 1) | invariant_violation",
    "violation_bit": 0,
    "reachable_mask_shift": 1,
    "valid_result_range": [
      0,
      511
    ],
    "invalid_input_result": -1
  },
  "contract": {
    "algorithm": "Build a reduced ordered BDD for the transition relation. Start with the BDD for the initial set, conjoin it with the relation, existentially quantify current-state and input bits, rename next-state bits to current-state positions, union the result into the reached set, and repeat until canonical BDD identity reaches a fixed point.",
    "invariant_rule": "The low output bit is one exactly when at least one reachable state is absent from invariant_mask.",
    "termination_bound": "There are at most 2^n states. The monotone reachable set can grow strictly at most 2^n times and then stabilizes.",
    "parse_rules": "n must be 1..3, m must be 0..1, masks must fit the 2^n state bits, relation entries must be 0 or 1, and the frame must contain exactly the relation truth table.",
    "distinction": "The existing binary_decision_graph package only builds a reduced ordered decision graph from a truth table; this package performs relational-product state reachability and invariant checking."
  },
  "complexity": {
    "primary_time": "Fixed-width ROBDD construction and recursive Boolean operations over at most 7 variables, repeated for at most 2^n+1 fixed-point rounds.",
    "primary_workspace": "At most 218,536 raw bytes of fixed arrays: 17,000 variable bytes, four 17,000-entry u16 node/result arrays, and a 32,768-entry u16 unique table. Five ports omit the two transform-result arrays and use 150,536 bytes. Bounded recursion locals fit within the 288 KiB ceiling.",
    "independent_time": "O(2^n * 2^m * 2^n) explicit transition scans per fixed-point round, for at most 2^n+1 rounds.",
    "independent_workspace": "O(2^n) reachable-state bits."
  },
  "workspace": {
    "bytes": 294912,
    "meaning": "288 KiB static manager-workspace ceiling. The largest fixed manager arrays total 218,536 raw bytes; five ports omit the transform-result arrays and use 150,536. Bounded recursion locals and stack frames fit within the remaining allowance."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
