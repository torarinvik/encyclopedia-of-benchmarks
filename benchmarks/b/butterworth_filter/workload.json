{
  "schema_version": 1,
  "id": "butterworth-filter-i64-array-f64-v1",
  "algorithm": "butterworth_filter",
  "function_symbol": "butterworth_filter",
  "input": {
    "kind": "bounded_signed_i64_array",
    "layout": "[filter_kind, coefficient_index, frequency_hz, samplerate_hz, gain_milli_db, q_factor_micro]",
    "length": 6,
    "filter_kind_range": [
      0,
      8
    ],
    "coefficient_index_range": [
      0,
      5
    ],
    "frequency_hz_range": [
      1,
      95999
    ],
    "samplerate_hz_range": [
      1,
      192000
    ],
    "valid_frequency_rule": "2 * frequency_hz < samplerate_hz",
    "gain_milli_db_range": [
      -60000,
      60000
    ],
    "q_factor_micro_range": [
      1,
      10000000
    ],
    "default_q_sentinel": -1,
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "Selected element of [a0, a1, a2, b0, b1, b2] for the selected second-order filter factory",
    "invalid_input_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
