{
  "schema_version": 1,
  "id": "boyer-moore-majority-vote-v1",
  "algorithm": "boyer_moore_majority_vote",
  "contract": {
    "input": "1 to 256 signed 64-bit values; repeated values need not have a strict majority.",
    "output": "The value that occurs more than half the time, or -1 if no strict majority exists.",
    "invalid_input_result": -1,
    "invalid_inputs": [
      "empty array",
      "more than 256 values"
    ]
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "single",
      "input_values": [
        7
      ],
      "input_length": 1,
      "expected_result": 7
    },
    {
      "id": "three-values",
      "input_values": [
        3,
        2,
        3
      ],
      "input_length": 3,
      "expected_result": 3
    },
    {
      "id": "candidate-cancelled-then-found",
      "input_values": [
        2,
        2,
        1,
        1,
        1,
        2,
        2
      ],
      "input_length": 7,
      "expected_result": 2
    },
    {
      "id": "negative-majority",
      "input_values": [
        -4,
        -4,
        9,
        -4,
        2
      ],
      "input_length": 5,
      "expected_result": -4
    },
    {
      "id": "majority-at-end",
      "input_values": [
        1,
        2,
        3,
        8,
        8,
        8,
        8
      ],
      "input_length": 7,
      "expected_result": 8
