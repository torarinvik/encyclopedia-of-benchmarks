  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,f(0),...,f(2^n-1),x0,y0,...,x(q-1),y(q-1)]",
    "dimension_range": [1, 6],
    "round_range": [1, 32],
    "truth_table": "Boolean values indexed by the integer vector whose coordinate zero is the least significant bit.",
    "random_tape": "Each x,y pair supplies independent uniform choices from [0,2^n); values are replayed in order.",
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_result": -1
  },
  "contract": {
    "algorithm": "For each supplied pair, query f(x), f(y), f(x xor y); reject at the first round for which f(x) xor f(y) differs from f(x xor y). Accept only after all q rounds pass.",
    "query_calls": "Three per evaluated round, including repeated points.",
    "output": "[accept_bit,rounds_executed,query_calls] as little-endian i64 values.",
    "scope": "Fixed deterministic replay profile; arbitrary tapes and q are not assigned a BLR soundness or epsilon-to-query guarantee."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[accept_bit,rounds_executed,query_calls]",
    "maximum_bytes": 24,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Input truth table and tape are read in place; local state and staged output fit within this fixed bound."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
