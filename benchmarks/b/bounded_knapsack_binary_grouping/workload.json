{
  "schema_version": 1,
  "id": "cp-algorithms-bounded-knapsack-binary-grouping-i64-array-scalar-v1",
  "algorithm": "bounded_knapsack_binary_grouping",
  "function_symbol": "bounded_knapsack_binary_grouping",
  "abi": "i64_array_scalar",
  "description": "Maximize bounded-multiplicity knapsack value by binary bundle expansion and descending 0/1 updates.",
  "source": {
    "title": "Knapsack Problem",
    "section": "Multiple Knapsack / Binary Grouping Optimization",
    "url": "https://cp-algorithms.com/dynamic_programming/knapsack.html#binary-grouping-optimization",
    "license": "CC BY-SA 4.0 source consulted for the algorithmic idea only; implementation and fixtures are clean-room",
    "algorithm_attribution": "Decompose each finite multiplicity into power-of-two bundles and a final remainder, then process each bundle once as a 0/1 item.",
    "implementation_status": "bounded clean-room binary-grouping profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,capacity,(weight,value,count)*n]",
    "item_type_count_range": [0, 16],
    "capacity_range": [0, 64],
    "weight_range": [1, 16],
    "value_range": [0, 100],
    "count_range": [0, 16],
    "zero_count_valid": true,
    "zero_value_valid": true,
    "maximum_valid_length": 50,
    "maximum_parseable_length": 51,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "maximum total value using at most capacity",
    "valid_result_range": [0, 6400],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "A fixed capacity DP array of 65 signed 64-bit values and scalar bundle state; bundles are processed as they are generated."
  },
  "contract": {
    "primary_method": "For each item type, split its count into bundles of sizes 1,2,4,... and a final remainder so every copy count from zero through the bound is representable. Apply each bundle as a 0/1 item by scanning capacity downward.",
    "independent_method": "For each item type, fill a fresh capacity-DP row by trying each allowed copy count directly against the previous row.",
    "zero_count_and_value": "Both are valid; a zero count emits no bundle and zero-valued bundles do not change the optimum.",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 10,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  },
  "primary_oracle": "benchmarks/b/bounded_knapsack_binary_grouping/primary_oracle.py",
  "independent_oracle": "benchmarks/b/bounded_knapsack_binary_grouping/independent_oracle.py",
  "cases": [
