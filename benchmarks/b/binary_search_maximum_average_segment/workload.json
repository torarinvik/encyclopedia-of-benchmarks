  "abi": "i64_array_scalar",
  "description": "Find the maximum average over contiguous subarrays of length at least L by integer threshold search and transformed-prefix feasibility.",
  "source": {
    "title": "Maximum average segment",
    "section": "Search for a subarray with a maximum/minimum average",
    "url": "https://cp-algorithms.com/others/maximum_average_segment.html",
    "license": "CC BY-SA 4.0 source consulted for the algorithmic idea only; implementation and fixtures are clean-room",
    "algorithm_attribution": "Binary-search a scaled average threshold; subtract it from each value and test whether some length-at-least-L interval has nonnegative transformed sum.",
    "implementation_status": "bounded clean-room integer-threshold profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,L,value_0,...,value_(n-1)]",
    "n_range": [1, 32],
    "minimum_length_range": [1, "n"],
    "value_range": [-1000, 1000],
    "maximum_valid_length": 34,
    "maximum_parseable_length": 35,
    "invalid_input_result": -1000001
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "floor(1000 times the maximum average among contiguous subarrays of length at least L)",
    "scale": 1000,
    "valid_result_range": [-1000000, 1000000],
    "invalid_input_result": -1000001
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "A fixed 33-element signed prefix array and scalar binary-search state; input is read directly."
  },
  "contract": {
    "primary_method": "Upper-bound binary search over integer thresholds [-1000000,1000000], with 1000001 as the known-false sentinel. At threshold q, transform each a[i] to 1000*a[i]-q; maintain the minimum eligible prefix for starts at least L positions before the current end and test for a nonnegative transformed interval sum.",
    "independent_method": "Enumerate every contiguous interval of length at least L and compare exact averages by cross multiplication, then floor the best average multiplied by 1000.",
    "result_rounding": "Mathematical floor, including for negative nonintegral averages.",
    "invalid_input_result": -1000001
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 10,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  },
  "primary_oracle": "benchmarks/b/binary_search_maximum_average_segment/primary_oracle.py",
  "independent_oracle": "benchmarks/b/binary_search_maximum_average_segment/independent_oracle.py",
