{
  "schema_version": 1,
  "id": "bentley-ottmann-general-position-i64-array-bytes-v1",
  "algorithm": "bentley_ottmann",
  "function_symbol": "bentley_ottmann",
  "input": {
    "kind": "signed_i64_array",
    "layout": [
      "segment_count",
      "x1",
      "y1",
      "x2",
      "y2",
      "..."
    ],
    "segment_count_range": [
      0,
      24
    ],
    "coordinate_range": [
      -1000,
      1000
    ],
    "preconditions": [
      "nonvertical segments",
      "no shared endpoints",
      "no collinear overlaps",
      "proper intersections only at integer lattice points",
      "all endpoint and intersection x-coordinates are distinct"
    ],
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": [
      "intersection_count",
      "x0",
      "y0",
      "x1",
      "y1",
      "..."
    ],
    "points_order": "lexicographic x then y",
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "single_integer_crossing",
      "input_values": [
        2,
        -3,
        -3,
        3,
        3,
        -2,
        2,
        2,
        -2
      ],
      "expected_result": 24,
      "expected_output_hex": "010000000000000000000000000000000000000000000000"
    },
    {
      "id": "no_intersection",
      "input_values": [
        2,
        -3,
        -3,
        -1,
        -1,
        1,
        2,
        3,
        4
      ],
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    }
  ]
}
