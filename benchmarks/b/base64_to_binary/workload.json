{
  "schema_version": 1,
  "id": "base64-to-binary-six-bit-v1",
  "algorithm": "base64_to_binary",
  "function_symbol": "base64_to_binary",
  "input": {
    "kind": "ascii_string_array",
    "encoding": "one signed 64-bit ASCII value per input character",
    "minimum_length": 0,
    "maximum_length": 256,
    "trimmed_edges": [
      9,
      10,
      11,
      12,
      13,
      32
    ],
    "alphabet": "A-Z, a-z, 0-9, +, /",
    "optional_prefix": "-",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "six_bit_ascii_binary",
    "bits_per_alphabet_character": 6,
    "prefix_behavior": "preserve one leading minus marker",
    "valid_result": "total output bytes",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "single_symbol_a",
      "input_values": [
        65
      ],
      "expected_result": 6,
      "expected_output_hex": "303030303030"
    },
    {
      "id": "alphabet_edges",
      "input_values": [
        65,
        47,
        48,
        57,
        43,
        47
      ],
      "expected_result": 36,
      "expected_output_hex": "303030303030313131313131313130313030313131313031313131313130313131313131"
    },
    {
      "id": "mixed_symbols",
      "input_values": [
        65,
        66,
        67
      ],
      "expected_result": 18,
      "expected_output_hex": "303030303030303030303031303030303130"
    },
    {
      "id": "trim_and_negative_marker",
      "input_values": [
        32,
        45,
        97,
        98,
        99,
        32
      ],
      "expected_result": 19,
      "expected_output_hex": "2d303131303130303131303131303131313030"
    },
    {
      "id": "negative_marker_only",
      "input_values": [
        45
      ],
      "expected_result": 1,
      "expected_output_hex": "2d"
    },
    {
      "id": "empty_input",
      "input_values": [0],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "all_whitespace",
      "input_values": [
        3,
        32,
        32,
        32
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_internal_space",
      "input_values": [
        65,
        32,
        66
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_padding",
      "input_values": [
        65,
        61
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient_capacity",
      "input_values": [
        65,
        66
      ],
      "workspace_bytes": 11,
      "capacity_error_result": -2,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
