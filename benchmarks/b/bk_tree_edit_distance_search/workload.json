  "function_symbol": "bk_tree_edit_distance_search",
  "abi": "i64_array_scalar",
  "description": "Build an insertion-ordered metric BK-tree over packed lowercase words and checksum radius matches for each query.",
  "source": {
    "primary": "https://doi.org/10.1145/362003.362025",
    "discovery": "Burkhard and Keller, File Structure 1 and Search Algorithm 1; no task text or code reused",
    "reuse": "algorithm description only; clean-room contract, references, ports, and fixtures"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,r,packed_dictionary_words[n],packed_query_words[q]]",
    "dictionary_count_range": [0, 16],
    "query_count_range": [0, 8],
    "radius_range": [0, 3],
    "word_encoding": "length in bits 40..43; lowercase a..o map to nibble codes 1..15 in low-to-high order; max length 10; unused bits zero",
    "dictionary_words_must_be_distinct": true,
    "maximum_valid_length": 27,
    "maximum_parseable_length": 28,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "sum over queries j of (j+1)*(17*match_count + sum_of_zero_based_matching_dictionary_indices)",
    "maximum_result": 14112,
    "invalid_input_result": -1
  },
  "algorithm_details": {
    "primary": "Build an insertion-ordered BK-tree. Each child edge is the Levenshtein distance to its parent pivot. For a query at distance d from a node, visit only edge labels e with max(0,d-r)<=e<=min(10,d+r).",
    "independent_reference": "For each query, calculate a full edit-distance matrix against every dictionary word and collect all indices within radius; do not build or traverse a metric tree.",
    "primary_complexity": "O(n^2*L^2 + q*n*L^2) worst-case time and O(n*L) bounded workspace, for L<=10.",
    "independent_complexity": "O(q*n*L^2) time and O(L^2) scratch per word comparison.",
    "distinctness": "Metric-tree indexing and triangle-inequality pruning differ from direct Levenshtein distance, prefix tries, autocomplete, and all-pairs edit-distance computation."
  },
  "workspace": {
    "bytes": 4096,
    "accounting": "16 packed node keys, 16x11 child-index table, 16-entry DFS stack, two 11-entry edit-distance rows, parser/result locals, and conservative alignment"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
