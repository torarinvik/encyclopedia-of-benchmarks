{
  "schema_version": 1,
  "id": "rodinia-bplus-tree-bounded-findk-v1",
  "algorithm": "rodinia_bplus_tree",
  "function_symbol": "rodinia_bplus_tree",
  "abi": "i64_array_scalar",
  "input": {
    "kind": "packed_i64_array",
    "layout": "[left_count, right_count, query_count, interleaved leaf key/value pairs, queries...]",
    "leaf_count_range": [1, 3],
    "query_count_range": [1, 16],
    "key_range": [-1000000, 1000000],
    "record_value_range": [0, 1000000],
    "maximum_input_values": 31
  },
  "output": {
    "kind": "i64_scalar",
    "meaning": "weighted checksum of found record values; missing source answers contribute zero after value-plus-one projection",
    "invalid_input_result": -1
  },
  "cases": [
    {
      "id": "route_left_separator_and_right",
      "input_values": [2, 2, 4, 1, 10, 4, 40, 7, 70, 9, 90, 1, 6, 7, 10],
      "expected_result": 224
    },
    {
      "id": "separator_equality_routes_right",
      "input_values": [1, 1, 3, -4, 5, 0, 6, 0, 1, -4, 0],
      "expected_result": 40
    },
    {
      "id": "all_queries_missing",
      "input_values": [1, 1, 2, 1, 10, 4, 40, 0, 5],
      "expected_result": 0
    },
    {
      "id": "full_leaf_capacity_and_negative_keys",
      "input_values": [3, 3, 6, -9, 10, -4, 20, 0, 30, 1, 40, 3, 50, 8, 60, -9, 0, 1, 3, 8, 9],
      "expected_result": 705
    },
    {
      "id": "invalid_empty_input",
      "input_values": [],
      "expected_result": -1
    },
    {
      "id": "invalid_unsorted_leaf",
      "input_values": [2, 1, 1, 4, 10, 1, 20, 8, 80, 1],
      "expected_result": -1
    },
    {
      "id": "invalid_overlapping_leaves",
      "input_values": [1, 1, 1, 5, 10, 5, 20, 5],
      "expected_result": -1
    },
    {
      "id": "invalid_record_value",
      "input_values": [1, 1, 1, 1, -1, 2, 20, 1],
      "expected_result": -1
    },
    {
      "id": "invalid_trailing_value",
      "input_values": [1, 1, 1, 1, 10, 2, 20, 1, 9],
      "expected_result": -1
    }
  ]
}
