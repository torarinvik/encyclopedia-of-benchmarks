{
  "schema_version": 1,
  "id": "bondy-chvatal-hamiltonian-closure-i64-array-bytes-output-v1",
  "algorithm": "bondy_chvatal_hamiltonian_closure",
  "function_symbol": "bondy_chvatal_hamiltonian_closure",
  "abi": "i64_array_bytes_output",
  "description": "Compute a bounded Bondy–Chvátal closure and report its adjacency rows and complete-closure certificate.",
  "source": {
    "title": "Hamiltonian Cycle via Chvatal Closure",
    "discovery_index_url": "https://github.com/acmeism/RosettaCodeData/blob/1d475861d7141ef2fafff293d9339f56e4b0f5db/popular-tasks",
    "discovery_index_revision": "1d475861d7141ef2fafff293d9339f56e4b0f5db",
    "primary_method_reference": "https://doi.org/10.1016/0012-365X(76)90078-9",
    "discovery_scope": "RosettaCodeData supplies title discovery only. Bondy and Chvatal supply the closure rule and Hamiltonicity-preservation theorem. The bounded input frame, lexicographic tie rule, output masks, and result encoding are original benchmark choices."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,(u,v)*m]",
    "vertex_count_range": [3, 8],
    "edge_count_range": [0, 28],
    "vertex_ids": "0 through n-1",
    "edge_rules": "Simple undirected graph; endpoints must be distinct and in range; duplicate unordered pairs are invalid regardless of endpoint order.",
    "maximum_valid_input_length": 58,
    "maximum_parseable_input_length": 59,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array_bytes",
    "encoding": "[complete_flag,added_edge_count,row_mask_0,...,row_mask_(n-1)]",
    "row_masks": "Bit v in row u is one exactly when {u,v} is an edge in the final closure.",
    "complete_flag": "1 iff the final closure is K_n; this is a sufficient Hamiltonicity certificate. 0 is inconclusive.",
    "result": "serialized output byte length",
    "maximum_output_elements": 10,
    "maximum_output_bytes": 80,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "contract": {
    "closure_rule": "Repeatedly add a missing unordered pair {u,v} when current degree(u)+degree(v)>=n, recomputing all degrees after each edge addition.",
    "tie_rule": "For the primary and all native ports, select the lexicographically least eligible pair with u<v. This is a deterministic profile convention; the final closure is unique independent of addition order.",
    "completion": "The complete_flag is true only when every pair of distinct vertices is present in the final closure. By the Bondy-Chvatal theorem this certifies that the original graph is Hamiltonian. If the flag is zero, the result is inconclusive and makes no claim that the original graph is non-Hamiltonian.",
    "added_edge_count": "Number of closure edges added to the supplied graph.",
    "validation_precedes_capacity": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Covers fixed adjacency, degree, and staged-output storage. Caller-owned input and output buffers are excluded."
  },
  "complexity": {
    "primary_time": "O(n^4) under full pair rescans, n<=8",
    "primary_auxiliary_space": "O(n^2)",
    "independent_reference_time": "O(n^4) under synchronous full-pair rounds, n<=8",
    "independent_reference_auxiliary_space": "O(n^2)"
  },
  "primary_oracle": "benchmarks/b/bondy_chvatal_hamiltonian_closure/primary_oracle.py",
  "independent_oracle": "benchmarks/b/bondy_chvatal_hamiltonian_closure/independent_oracle.py",
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
