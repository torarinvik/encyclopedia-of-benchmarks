  "contract": {
    "operation": "Evaluate a scalar B-spline curve at one parameter using the local de Boor recurrence.",
    "input_encoding": "[degree,control_count,parameter,knots...,controls...]",
    "degree_range": [1, 3],
    "control_count_range": "degree+1 through 8 inclusive",
    "knot_count": "control_count+degree+1",
    "valid_frame_length": "3+knot_count+control_count",
    "knot_and_control_range": [-1000, 1000],
    "knot_order": "nondecreasing",
    "maximum_equal_knot_multiplicity": "degree+1",
    "active_domain": "knots[degree] < knots[control_count]; parameter is in the closed interval between them",
    "span_selection": "For an interior parameter choose the rightmost k with U[k]<=parameter<U[k+1]. At parameter==U[control_count], choose k=control_count-1.",
    "zero_denominator_weight": 0,
    "output_encoding": "One float64 curve value",
    "error_precedence": "Malformed or null input returns -1 before output validation; valid input with null output or capacity below one returns -2 without writes.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "success_result": 1,
    "no_write_on_error": true
  },
