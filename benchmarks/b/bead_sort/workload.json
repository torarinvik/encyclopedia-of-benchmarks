{
  "schema_version": 1,
  "id": "bead_sort-v1",
  "algorithm": "bead_sort",
  "abi": "mutable_i64_with_scratch",
  "input": {
    "lengths": [0, 16, 256, 1024],
    "generation": {
      "kind": "modular_affine",
      "multiplier": 37,
      "modulus": 64,
      "offset": 0,
      "formula": "values[index] = (index * 37) mod 64"
    }
  },
  "scratch_elements_extra": 64,
  "measurement": {
    "timer": "clock()",
    "comparison_model": "sort_call",
    "warmup_rounds": 2,
    "sample_count": 7,
    "scratch_allocation_timed": false
  }
}
