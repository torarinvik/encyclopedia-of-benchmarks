{
  "schema_version": "1.0.0",
  "id": "python-bidirectional-bfs-obstacle-grid-v1",
  "algorithm": "bidirectional_breadth_first_search",
  "function_symbol": "bidirectional_breadth_first_search",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[rows, columns, start_cell_id, goal_cell_id, blocked_count, blocked_cell_ids...]",
    "dimension_range": [
      1,
      8
    ],
    "maximum_cell_count": 64,
    "maximum_input_length": 69,
    "cell_ids": "zero-based row-major indices; neighbors are considered up, left, down, right",
    "obstacles": "blocked cell IDs must be unique and neither endpoint may be blocked",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[path_cell_count, cell_id_0, cell_id_1, ...]; unreachable paths encode as [0]",
    "path_selection": "expand one complete FIFO layer from the start, then one from the goal; within each layer visit neighbors up, left, down, right and stop at the first newly discovered cell already visited from the opposite side",
    "shortest_path_guarantee": "complete layers are alternated from both endpoints, so the first cross-frontier discovery has minimum edge distance",
    "return_value": "number of output bytes written",
    "maximum_output_values": 65,
    "maximum_output_bytes": 520,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
