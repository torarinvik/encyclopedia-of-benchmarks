{
  "schema_version": 1,
  "id": "binary-tree-traversal-explicit-shape-v1",
  "algorithm": "binary_tree_traversal",
  "function_symbol": "binary_tree_traversal",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[order, node_count, root_index, (value, left_child, right_child)*]",
    "order_codes": {
      "0": "preorder (node, left, right)",
      "1": "inorder (left, node, right)",
      "2": "postorder (left, right, node)",
      "3": "breadth-first left-to-right by level",
      "4": "breadth-first right-to-left by level",
      "5": "reverse inorder (right, node, left)",
      "6": "zigzag breadth-first by level, alternating left-to-right and right-to-left"
    },
    "node_count_range": [
      0,
      64
    ],
    "root_index": "-1 for empty tree; otherwise a node index in [0, node_count)",
    "child_indices": "-1 for absent child; otherwise a node index in [0, node_count)",
    "tree_validity": "A valid nonempty input is one rooted binary tree: root has no parent, each other node has exactly one parent, there are no self-links or shared children, and every node is reachable from root. Empty input tree uses node_count=0 and root_index=-1.",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "maximum_input_length": 195
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "node values in the selected traversal order",
    "return_value": "number of output bytes written",
    "maximum_output_bytes": 512,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
