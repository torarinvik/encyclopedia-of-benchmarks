  "contract": {
    "operation": "c[k] = sum(a[i]*b[j] for i xor j = k) modulo 998244353.",
    "input_layout": "[N,a[0..2^N),b[0..2^N)]",
    "official_n_range": [0, 20],
    "local_n_range": [0, 8],
    "coefficient_range": "0 <= a[i],b[i] < 998244353",
    "modulus": 998244353,
    "algorithm": "Two forward XOR Walsh-Hadamard transforms, pointwise multiplication, one inverse transform, and multiplication by (2^N)^-1 modulo 998244353.",
    "output_layout": "One little-endian signed 64-bit residue for each index k in [0,2^N).",
    "error_precedence": "Malformed frames or coefficients return -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,a[0..2^N),b[0..2^N)]",
    "n_range": [0, 8],
    "coefficient_range": [0, 998244352],
    "maximum_valid_length": 513,
    "maximum_parseable_length": 513,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "maximum_bytes": 2048,
    "size_formula": "8*2^N",
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
