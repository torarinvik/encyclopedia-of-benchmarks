{
  "schema_version": 1,
  "id": "batch-gcd-small-range-i64-array-bytes-output-v1",
  "algorithm": "batch_gcd_small_range_precomputed",
  "function_symbol": "batch_gcd_small_range_precomputed",
  "abi": "i64_array_bytes_output",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[V,Q,(a,b)*Q]",
    "value_limit_range": [1, 64],
    "query_count_range": [0, 64],
    "operand_range": "0..=V",
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "algorithm": "Euler linear least-prime-factor sieve; three-factor representations; triangular small-GCD table; factor reduction for each query",
    "preprocessing": "For x=p*y with least prime p, multiply the smallest factor in y's triple by p and sort; each factor is small (at most sqrt(x)) or prime",
    "small_gcd_table": "gcd(a,r)=gcd(r,a mod r) for 0<=r<a<=floor(sqrt(V)); entries are filled once in row order",
    "large_factor_rule": "A factor above floor(sqrt(V)) is prime and contributes itself exactly when it divides the remaining query operand",
    "zero_rule": "gcd(0,y)=y; gcd(x,0)=x; gcd(0,0)=0"
  },
  "output": {
    "kind": "little_endian_i64_array",
    "layout": "one GCD result per pair in input order",
    "maximum_bytes": 512,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "input_validation_precedes_capacity": true,
    "errors_leave_output_untouched": true
  },
  "workspace": {
    "bytes": 4096,
    "accounting": "bounded least-factor array, prime list, three-factor representation table, triangular small-GCD table, scalar bookkeeping; caller-owned input and output buffers are excluded"
  },
  "complexity": {
    "primary_time": "O(V+Q) word operations: linear preprocessing and constant work per query",
    "primary_state": "O(V)",
    "independent_reference_time": "O(Q log(V+1)) Euclidean iterations",
    "independent_reference_state": "O(Q) output staging"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "input_and_correctness_validation": "outside timed call"
  },
  "source": {
    "title": "O(V)-O(1) gcd",
    "url": "https://github.com/yosupo06/library-checker-problems/issues/1380",
    "source_kind": "community problem proposal; algorithm idea only"
  },
  "cases": [
    {
      "id": "empty-batch",
      "input_values": [64, 0],
      "input_length": 2,
      "output_capacity": 0,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "zero-operands-and-unit-range",
      "input_values": [1, 4, 0, 0, 0, 1, 1, 1, 1, 0],
      "input_length": 10,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0000000000000000010000000000000001000000000000000100000000000000"
    },
    {
      "id": "three-factor-prime-and-zero-paths",
      "input_values": [64, 6, 48, 36, 63, 45, 49, 56, 0, 18, 36, 0, 0, 0],
      "input_length": 14,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "0c0000000000000009000000000000000700000000000000120000000000000024000000000000000000000000000000"
    },
    {
      "id": "mixed-range-eight-results",
      "input_values": [64, 8, 64, 64, 60, 45, 49, 64, 48, 36, 35, 64, 27, 18, 1, 0, 0, 63],
      "input_length": 18,
      "output_capacity": 64,
      "expected_result": 64,
      "expected_output_hex": "40000000000000000f0000000000000001000000000000000c000000000000000100000000000000090000000000000001000000000000003f00000000000000"
    },
    {
      "id": "output-one-byte-short",
      "input_values": [64, 2, 48, 36, 63, 45],
      "input_length": 6,
      "output_capacity": 15,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [8, 1, 6, 4],
      "input_length": 4,
      "output_capacity": 8,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "out-of-range-operand",
      "input_values": [8, 1, 9, 1],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "extra-word-after-complete-frame",
      "input_values": [8, 1, 6, 4, 99],
      "input_length": 5,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
