{
  "schema_version": 1,
  "id": "bfs-result-tree-ruby-i64-bytes-v1",
  "algorithm": "bfs_result_tree",
  "function_symbol": "bfs_result_tree",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[vertex_count, edge_count, start_vertex, directed_edge_pairs...]",
    "vertex_count_range": [
      1,
      32
    ],
    "edge_count_range": [
      0,
      126
    ],
    "vertex_ids": "zero-based integers in [0,vertex_count)",
    "edges": "directed; duplicates and self-loops allowed; outgoing neighbor iteration follows input edge order",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[seen_count, seen_discovery_order..., visited_count, visited_dequeue_order..., parent_count, (node,parent)..., distance_count, (node,hop_distance)...]",
    "root_parent_sentinel": -1,
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "input_neighbor_order_controls_parent",
      "input_values": [
        6,
        7,
        0,
        0,
        2,
        0,
        1,
        2,
        3,
        2,
        4,
        1,
        4,
        3,
        5,
        4,
        5
      ],
      "input_length": 17,
      "expected_result": 320,
      "expected_output_hex": ""
    },
    {
      "id": "cycles_and_unreachable_nodes",
      "input_values": [
        7,
        7,
        0,
        0,
        1,
        0,
        2,
        1,
        3,
        2,
        3,
        3,
        1,
        5,
        6,
        6,
        5
      ],
      "input_length": 17,
      "expected_result": 224,
      "expected_output_hex": ""
    },
    {
      "id": "duplicates_and_self_loop",
      "input_values": [
        4,
        5,
        0,
        0,
        0,
        0,
        2,
        0,
        2,
        2,
        1,
        1,
        2
      ],
      "input_length": 13,
      "expected_result": 176,
      "expected_output_hex": ""
    },
    {
      "id": "isolated_start",
      "input_values": [
        1,
        0,
        0
      ],
      "input_length": 3,
      "expected_result": 80,
      "expected_output_hex": "010000000000000000000000000000000100000000000000000000000000000001000000000000000000000000000000ffffffffffffffff010000000000000000000000000000000000000000000000"
    },
    {
      "id": "out_of_range_neighbor",
      "input_values": [
        2,
        1,
        0,
        0,
        2
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated_edges",
      "input_values": [
        3,
        2,
        0,
        0,
        1
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_start",
      "input_values": [
        2,
        0,
        2
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
