{
  "schema_version": 1,
  "id": "boundary-traversal-java-tree-value-output-v1",
  "algorithm": "boundary_traversal",
  "function_symbol": "boundary_traversal",
  "input": {
    "kind": "indexed_binary_tree_with_caller_output",
    "encoding": "Each node is [signed value,left child index,right child index]; -1 means absent. Root index and output buffer/capacity are passed separately.",
    "maximum_node_count": 100,
    "root_index": "-1 for empty tree, otherwise a valid node-table index",
    "tree_requirement": "One valid rooted binary tree; every node must be reachable exactly once.",
    "node_value_range": [
      -2147483648,
      2147483647
    ],
    "result": "Count of boundary values written, or -1 for invalid structure or insufficient output capacity."
  },
  "measurement": {
    "comparison_model": "tree_value_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
