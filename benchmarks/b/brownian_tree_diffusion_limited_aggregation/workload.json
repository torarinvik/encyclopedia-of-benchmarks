  "contract": {
    "input_encoding": "[attempts,seed,step_cap]",
    "input_length": 3,
    "maximum_parseable_input_length": 4,
    "attempts_range": [0, 16],
    "seed_range": [1, 9223372036854775807],
    "step_cap_range": [1, 512],
    "grid": {"width": 33, "height": 33, "outer_ring_coordinate": 0, "maximum_coordinate": 32},
    "initial_seed": [16, 16],
    "attempt_state": "seed XOR (0x9e3779b97f4a7c15 * (attempt+1)) modulo 2^64; replace zero with 0x2545f4914f6cdd1d",
    "prng": "xorshift64* with shifts 12,25,27 and multiplier 0x2545f4914f6cdd1d; every state operation wraps modulo 2^64",
    "draw_mapping": "unsigned output remainder by bound",
    "launch": "draw side modulo 4, then position 1 + draw modulo 31; sides top,right,bottom,left",
    "direction_mapping": ["left", "up", "right", "down"],
    "contact": "check the launch site before moving, then attach at the first empty current site with an occupied left, up, right, or down neighbor",
    "discard": "drop a particle that starts at an occupied launch site, reaches the outer ring after a move, or uses the full step cap without contact",
    "output_encoding": "little-endian signed-i64 words [point_count,x0,y0,...] with center seed first and attached sites in insertion order",
    "invalid_input_result": -1,
    "null_or_insufficient_output_result": -2,
    "errors_write_no_output": true,
    "maximum_output_words": 35,
    "maximum_output_bytes": 280
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "The largest port uses a 1089-byte occupancy bitmap and two 17-entry i64 coordinate arrays (272 bytes), totaling 1361 fixed bytes before scalar scratch; excludes caller input/output."
  },
