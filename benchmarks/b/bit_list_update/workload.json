  "id": "encyclopedia-bit-list-update-i64-array-bytes-output-v1",
  "algorithm": "bit_list_update",
  "function_symbol": "bit_list_update",
  "abi": "i64_array_bytes_output",
  "description": "Bit list update with supplied random initial bits and access-position trace.",
  "source": {
    "title": "Online List Update",
    "authors": ["Shahin Kamali"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_266",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_266",
    "algorithm_attribution": "Each item's initial bit is uniformly random; every access complements that bit and moves the item to front when the new bit is one.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,request_count,initial_order[n],request_ids[request_count],initial_bits[n]]",
    "item_count_range": [1, 8],
    "request_count_range": [0, 32],
    "item_id_range": "0..n-1",
    "initial_order_requirement": "permutation of all item IDs",
    "initial_bit_range": [0, 1],
    "initial_randomness": "uniform independent bits supplied explicitly for deterministic replay",
    "maximum_valid_length": 50,
    "maximum_parseable_length": 50,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_vector",
    "encoding": "little-endian signed 64-bit words [total_access_cost,final_order[n],pre_access_positions[request_count],final_bits[n]]",
    "maximum_bytes": 392,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {"bytes": 4096, "meaning": "Bounded item bits, request positions, final state, and staged output."},
  "contract": {
    "access_cost": "Record the 1-based position before toggling the requested item's bit.",
    "bit_update": "Complement only the accessed item's bit.",
    "reorganization": "If the complemented bit is one, move the item to the list front with free exchanges; otherwise leave the order unchanged.",
    "randomness": "The supplied initial bit vector is a fixed realization of independent uniform source bits."
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "oracle_method": "The primary oracle simulates front moves directly. The independent verifier maintains a page-to-position map and shifts the affected prefix.",
