{
  "schema_version": 1,
  "id": "python-binary-string-to-gray-preserve-width-v1",
  "algorithm": "binary_to_gray",
  "function_symbol": "binary_to_gray",
  "input": {
    "kind": "ascii_binary_string",
    "encoding": "one signed 64-bit value per ASCII byte",
    "minimum_length": 1,
    "maximum_length": 66,
    "accepted_bytes": [
      48,
      49
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "ascii_binary_string",
    "definition": "equal-width reflected Gray code; first bit is preserved and each later bit is the XOR of adjacent source bits",
    "maximum_length": 66,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
