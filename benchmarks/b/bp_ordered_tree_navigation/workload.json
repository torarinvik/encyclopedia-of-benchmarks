  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,parent[1..n-1],(opcode,first,second)*q]",
    "node_count_range": [1, 31],
    "query_count_range": [0, 32],
    "maximum_valid_length": 128,
    "maximum_parseable_length": 129,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[n,bit_length,packed_bp_bits,q,answers...]",
    "maximum_bytes": 288,
    "output_untouched_on_error": true,
    "null_or_short_output_result": -2
  },
  "contract": {
    "tree": "Vertex 0 is root; each later vertex has a smaller-ID parent; siblings are ordered by ascending vertex ID.",
    "encoding": "Ordered depth-first entry emits bit 1; return emits bit 0. E[k] counts opens minus closes in the first k bits, with E[0]=0.",
    "queries": "0 forward search (prefix index, delta; missing sentinel 2n+1); 1 backward search (prefix index, delta; fallback 0); 2 inclusive RMQi over bit positions, leftmost tie; 3 findclose; 4 findopen; 5 enclose (root returns -1). Search indices address E[0..2n], other operations address bits [0,2n-1].",
    "complexity": "O(n+q*n) bounded scans for n<=31 and q<=32; O(n+q) fixed workspace.",
    "distinctness": "This builds a BP tree string and evaluates the chapter's excess-search navigation. Balanced-parenthesis successor and rank/unrank packages do not construct ordered trees or implement BP excess range-min/max queries."
  },
  "workspace": {"bytes": 4096},
  "measurement": {"comparison_model": "i64_array_bytes_output_call"},
