{
  "schema_version": 1,
  "id": "binary-tree-to-string-tree2str-i32-v1",
  "algorithm": "binary_tree_to_string",
  "function_symbol": "binary_tree_to_string",
  "input": {
    "kind": "signed_64_bit_indexed_tree_array",
    "encoding": "[node_count, root, (value, left_child, right_child)...]",
    "null_child": -1,
    "maximum_nodes": 127,
    "node_value_range": [
      -2147483648,
      2147483647
    ],
    "tree_requirements": "root has no parent; every other node has one parent; all nodes are reachable and acyclic",
    "output_encoding": "ASCII tree2str bytes without a NUL terminator",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "empty-tree",
      "input_values": [
        0,
        -1
      ],
      "expected_result": 0,
      "expected_output": ""
    },
    {
      "id": "single-leaf",
      "input_values": [
        1,
        0,
        1,
        -1,
        -1
      ],
      "expected_result": 1,
      "expected_output": "1"
    },
    {
      "id": "left-child-only",
      "input_values": [
        2,
        0,
        1,
        1,
        -1,
        2,
        -1,
        -1
      ],
      "expected_result": 4,
      "expected_output": "1(2)"
    },
    {
      "id": "right-child-only",
      "input_values": [
        2,
        0,
        1,
        -1,
        1,
        3,
        -1,
        -1
      ],
      "expected_result": 6,
      "expected_output": "1()(3)"
    },
    {
      "id": "source-example",
      "input_values": [
        4,
        0,
        1,
        1,
        2,
        2,
        -1,
        3,
        3,
        -1,
        -1
      ],
      "expected_result": 12,
      "expected_output": "1(2()(4))(3)"
    },
    {
      "id": "negative-node-value",
      "input_values": [
        2,
        0,
        -12,
        1,
        -1,
        3,
        -1,
        -1
      ],
      "expected_result": 6,
      "expected_output": "-12(3)"
    },
    {
      "id": "invalid-root-index",
      "input_values": [
        1,
        1,
        7,
        -1,
        -1
      ],
      "expected_result": -1,
      "expected_output": ""
    },
    {
      "id": "invalid-shared-child",
      "input_values": [
        3,
        0,
        1,
        2,
        2,
        2,
        -1,
        -1,
        3,
        -1,
        -1
      ],
      "expected_result": -1,
      "expected_output": ""
    },
    {
      "id": "invalid-packed-length",
      "input_values": [
        1,
        0,
        7,
        -1
      ],
      "expected_result": -1,
      "expected_output": ""
    },
    {
      "id": "insufficient-output-capacity",
      "input_values": [
        1,
        0,
        1,
        -1,
        -1
      ],
      "expected_result": -2,
      "expected_output": "",
      "workspace_bytes": 0
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
}
