    "item_size_range": [1, 1000000],
    "size_encoding": "integer millionths of unit bin capacity",
    "maximum_valid_length": 65,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_i64_array",
    "description": "[bin_count, zero-based bin ID for each item in input order]",
    "tie_rule": "Equal post-placement remaining space chooses the earliest opened bin.",
    "maximum_output_bytes": 520,
    "maximum_output_elements": 65,
    "success_result": "8 * (item_count + 1)",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_when_nonempty_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Up to 64 staged bin loads and 64 staged item assignments."
  },
  "measurement": {"sample_count": 7, "warmup_rounds": 2, "repetitions_per_sample": 1000},
  "cases": [
    {
      "id": "best-fit-selects-tightest-feasible-bin",
      "input_values": [3, 500000, 600000, 300000],
      "input_length": 4,
      "output_capacity": 520,
      "expected_result": 32,
      "expected_output_hex": "0200000000000000000000000000000001000000000000000100000000000000"
    },
    {
      "id": "equal-leftover-tie-chooses-earliest-bin",
      "input_values": [4, 400000, 600000, 700000, 300000],
      "input_length": 5,
      "output_capacity": 520,
      "expected_result": 40,
      "expected_output_hex": "02000000000000000000000000000000000000000000000001000000000000000000000000000000"
    },
    {
      "id": "empty-input",
      "input_values": [0],
      "input_length": 1,
      "output_capacity": 520,
      "expected_result": 8,
