    {"id": "maximum-input", "input_values": [7, 1, 2, 4, 4, 4, 4, 4, 4, 4], "input_length": 10, "expected_result": 5},
    {"id": "valid-no-decode", "input_values": [2, 1, 0, 1, 2], "input_length": 5, "expected_result": 0},
    {"id": "trailing-input", "input_values": [5, 1, 1, 3, 3, 3, 3, 3, 0], "input_length": 9, "expected_result": -1},
