  "algorithm": "berlekamp_welch_rs_decode",
  "function_symbol": "berlekamp_welch_rs_decode",
  "abi": "i64_array_scalar",
  "description": "Decode a low-degree GF(7) polynomial from evaluation symbols within the unique decoding radius using Berlekamp-Welch interpolation.",
  "source": {
    "title": "Error correction for algebraic block codes",
    "authors": ["Lloyd R. Welch", "Elwyn R. Berlekamp"],
    "url": "https://patents.google.com/patent/US4633470A/en",
    "publication": "U.S. Patent 4,633,470, issued 1986; filed 1983",
    "used_for": "Algorithm-family provenance; no code or examples reused.",
    "evaluation_form_reference": "https://theory.stanford.edu/~trevisan/pubs/codingsurvey.pdf#page=50"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,k,t,y_0,...,y_(n-1)] with evaluation x_i=i over GF(7)",
    "exact_length": "3+n",
    "n_range": [2, 7],
    "k_range": [1, 3],
    "error_radius_range": [0, 2],
    "unique_decoding_condition": "2*t <= n-k",
    "field_prime": 7,
    "received_symbol_range": [0, 6],
    "maximum_valid_length": 10,
    "maximum_parseable_length": 11,
    "invalid_input_result": -1,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "0 means no degree<k polynomial is within t mismatches; otherwise 1+sum(c_j*7^j), with k coefficients in increasing degree order",
    "result_range": "0..343",
    "minimum_valid_result": 0,
    "maximum_valid_result": 343,
    "invalid_result": -1
  },
  "workspace": {
    "bytes": 1024,
    "description": "Bounded augmented matrix, polynomial work arrays, and enumeration state."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
