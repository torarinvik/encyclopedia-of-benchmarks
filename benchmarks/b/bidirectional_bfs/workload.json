{
  "schema_version": 1,
  "id": "r-bidirectional-bfs-path-i64-array-bytes-v1",
  "algorithm": "bidirectional_bfs",
  "function_symbol": "bidirectional_bfs",
  "input": {
    "kind": "signed_i64_array",
    "layout": [
      "vertex_count",
      "start",
      "target",
      "arc_count",
      "from0",
      "to0",
      "from1",
      "to1",
      "..."
    ],
    "vertex_count_range": [
      1,
      64
    ],
    "arc_count_range": [
      0,
      4096
    ],
    "vertex_ids": "zero-based, with every vertex explicit",
    "graph": "unweighted undirected; each distinct arc must have a reciprocal arc",
    "duplicates": "allowed; only first occurrence of a neighbor is retained",
    "self_loops": "allowed and ignored by visited checks",
    "adjacency_order": "per-vertex first-occurrence order from packed arc records",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": [
      "path_count",
      "vertex0",
      "vertex1",
      "..."
    ],
    "path_count_includes_endpoints": true,
    "distance": "path_count - 1 when path_count > 0; unreachable maps source Inf to -1",
    "found": "path_count > 0",
    "unreachable": "[0]",
    "same_endpoint": "[1,start]",
    "return_value": "number of output bytes",
    "maximum_values": 65,
    "maximum_bytes": 520
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
