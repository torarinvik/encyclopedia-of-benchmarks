    "bytes": 2560,
    "meaning": "Fixed unit-prefix and p-free-factorial tables, compact p-adic valuations, and staged u32 residues; includes capacity for the 128-byte external output."
  },
  "algorithm_details": {
    "primary": "Build the p-free factorial part and p-adic valuation for every n through 128. For each query, return zero when the binomial valuation is at least e; otherwise multiply the p-free numerator by the modular inverse of the p-free denominator and p raised to the remaining valuation.",
    "independent_oracle": "Build each requested Pascal row by descending additions modulo p^e, without modular division.",
    "primary_complexity": "O(MAX_N + Q log(p^e)) time and O(MAX_N) fixed storage.",
    "oracle_complexity": "O(sum(n^2) + Q) time over requested rows."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
