    "maximum_valid_length": 67,
    "maximum_parseable_length": 68,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one little-endian unsigned 32-bit residue modulo p^e per query, in query order",
