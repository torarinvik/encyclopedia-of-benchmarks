{
  "schema_version": 1,
  "id": "bifid-cipher-fixed-square-whole-message-v1",
  "algorithm": "bifid_cipher",
  "function_symbol": "bifid_cipher",
  "input": {
    "kind": "mode_text_length_ascii_bytes",
    "encoding": "[mode, text_length, text ASCII bytes...]",
    "modes": {
      "0": "encode",
      "1": "decode"
    },
    "maximum_text_length": 256,
    "encode_text": "ASCII A-Z, a-z, and literal spaces; lowercase, remove spaces, and merge j into i",
    "decode_text": "ASCII A-I and K-Z in either case; lowercase before decoding; spaces and j are invalid",
    "square": "abcdefghiklmnopqrstuvwxyz arranged row-major in a 5x5 square",
    "block_period": "the complete normalized message",
    "output_encoding": "lowercase ASCII without a NUL terminator",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
