{
  "schema_version": 1,
  "id": "algorithm-burstsort-i64-array-scalar-v1",
  "algorithm": "burstsort",
  "function_symbol": "burstsort",
  "abi": "i64_array_scalar",
  "description": "Lexicographic string sorting by a burst trie with threshold-triggered bucket expansion.",
  "source": {
    "title": "Cache-Conscious Sorting of Large Sets of Strings with Dynamic Tries",
    "authors": ["Ranjan Sinha", "Justin Zobel"],
    "year": 2004,
    "url": "https://doi.org/10.1145/1005813.1041517",
    "used_for": "Burst-trie insertion, capacity-triggered bursting, and lexicographic traversal; algorithm idea only."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, (string_length, byte_0, ..., byte_(length-1))*n]",
    "string_count_range": [0, 16],
    "string_length_range": [0, 8],
    "byte_range": [0, 3],
    "framing_rule": "Every string has its own length word; all input words must be consumed exactly.",
    "maximum_valid_input_length": 145,
    "maximum_parseable_input_length": 146,
    "invalid_input_result": -1
  },
  "algorithm_profile": {
    "bucket_threshold": 3,
    "burst_rule": "When insertion makes a leaf bucket hold four non-ended strings, replace the bucket with a trie node and redistribute by the next byte. Ended strings use a separate terminal bucket and do not count toward the threshold.",
    "traversal": "Emit terminal strings first, then local residual buckets in lexicographic order, then child nodes in byte order.",
    "residual_bucket_sorter": "Insertion sort; each unburst leaf contains at most three non-ended strings.",
    "maximum_trie_nodes": 129
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "For the lexicographically sorted strings, sum rank*key(string), with ranks starting at 1. key uses eight base-5 digits: each byte b contributes (b+1)*5^(7-index), and trailing positions are zero end markers.",
    "valid_result_range": [0, 53124864],
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
