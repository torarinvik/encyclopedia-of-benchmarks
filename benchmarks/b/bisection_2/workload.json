{
  "schema_version": 1,
  "id": "bisection-2-fixed-equation-float64-v1",
  "algorithm": "bisection_2",
  "function_symbol": "bisection_2",
  "input": {
    "kind": "signed_integer_millipoint_endpoints",
    "encoding": "[left_milli,right_milli], with x = endpoint / 1000",
    "maximum_length": 2,
    "endpoint_milli_range": [
      -100000,
      100000
    ],
    "required_order": "left_milli < right_milli",
    "source_equation": "f(x) = 10 - x*x",
    "bracket_requirement": "f(left) * f(right) < 0",
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "float64",
    "meaning": "the source bisection variable c in the same x units as the endpoints",
    "invalid_input_result": -1e+300,
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
