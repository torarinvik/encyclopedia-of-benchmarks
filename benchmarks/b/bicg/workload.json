{
  "schema_version": 1,
  "id": "polybench-bicg-i64-array-f64-v1",
  "algorithm": "bicg",
  "function_symbol": "bicg",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[m, n] where s and p have length m, and q and r have length n",
    "input_length": 2,
    "row_range": [1, 64],
    "column_range": [1, 64],
    "maximum_input_length": 2
  },
  "output": {
    "kind": "binary64",
    "meaning": "binary64 checksum formed by summing final s in ascending index order, followed by final q in ascending index order",
    "invalid_input_result": -1e300
  },
  "source_bound": {
    "description": "The PolyBench/C BiCG source defaults to binary64. It initializes p[j]=(j mod m)/m, r[i]=(i mod n)/n, and A[i][j]=(i*(j+1) mod n)/n. The kernel zeroes s, then processes i in ascending order, zeroing q[i] and iterating j in ascending order; each inner iteration first accumulates s[j]=s[j]+r[i]*A[i][j], then q[i]=q[i]+A[i][j]*p[j]. The launcher selects EXTRALARGE_DATASET (m=27000,n=33000); this suite profile bounds each dimension to 1..64.",
    "repository": "https://github.com/lac-dcc/Benchmarks",
    "commit": "5d7b75df749241efa7a6e6f5be613d3fcc5cce38",
    "path": "PolyBench/linear-algebra/kernels/bicg/bicg.c",
    "launcher_path": "PolyBench/linear-algebra/kernels/bicg/info.sh",
    "launcher": {
      "benchmark_name": "bicg",
      "source_selection": "*.c",
      "compile_flags": ["-I.", "-DPOLYBENCH_DUMP_ARRAYS", "-DEXTRALARGE_DATASET"],
      "run_options": []
    },
    "original_contributor": "PolyBench/C (Louis-Noel Pouchet and Tomofumi Yuki)",
    "license_note": "The source file has no explicit license notice; this package contains independently written ports of the published kernel."
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {"id": "one_cell", "input_values": [1, 1], "input_length": 2, "expected_result": 0.0},
    {"id": "two_rows_three_columns", "input_values": [2, 3], "input_length": 2, "expected_result": 1.5},
    {"id": "three_rows_two_columns", "input_values": [3, 2], "input_length": 2, "expected_result": 0.8333333333333333},
    {"id": "square_eight", "input_values": [8, 8], "input_length": 2, "expected_result": 19.25},
    {"id": "rectangular_medium", "input_values": [16, 12], "input_length": 2, "expected_result": 68.84722222222223},
    {"id": "polybench_mini_shape", "input_values": [38, 42], "input_length": 2, "expected_result": 719.2299498746867},
    {"id": "maximum_dimensions", "input_values": [64, 64], "input_length": 2, "expected_result": 1890.0},
    {"id": "empty_invalid", "input_values": [], "input_length": 0, "expected_result": -1e300},
    {"id": "short_input_invalid", "input_values": [8], "input_length": 1, "expected_result": -1e300},
    {"id": "zero_rows_invalid", "input_values": [0, 8], "input_length": 2, "expected_result": -1e300},
    {"id": "zero_columns_invalid", "input_values": [8, 0], "input_length": 2, "expected_result": -1e300},
    {"id": "first_unsupported_dimension_invalid", "input_values": [65, 8], "input_length": 2, "expected_result": -1e300}
  ]
}
