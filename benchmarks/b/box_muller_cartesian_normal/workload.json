{
  "schema_version": 1,
  "id": "encyclopedia-algorithms-box-muller-cartesian-normal-bounded-tape-v1",
  "algorithm": "box_muller_cartesian_normal",
  "function_symbol": "box_muller_cartesian_normal",
  "abi": "float64_slice_io",
  "description": "Generate independent standard-normal pairs with the direct Cartesian Box–Muller transform.",
  "source": {
    "title": "A Note on the Generation of Random Normal Deviates",
    "authors": ["G. E. P. Box", "Mervin E. Muller"],
    "journal": "The Annals of Mathematical Statistics 29(2), 610–611 (1958)",
    "doi": "10.1214/aoms/1177706645",
    "url": "https://doi.org/10.1214/aoms/1177706645",
    "algorithm_attribution": "The direct Cartesian transform maps a radial uniform and an angular uniform to a pair using sqrt(-2 log U1), cos(2 pi U2), and sin(2 pi U2).",
    "implementation_status": "clean-room bounded ports"
  },
  "oracle": "benchmarks/box_muller_cartesian_normal_oracle.py",
  "oracle_entry_point": "expected_output(values, output_capacity=None, output_is_null=False, input_length=None)",
  "input": {
    "kind": "finite_float64_array_of_exact_integers",
    "encoding": "[pair_count, radial_draw_0, angular_draw_0, ...]",
    "pair_count_range": [1, 64],
    "draw_range": [0, 4294967295],
    "radial_draw_mapping": "U1 = (draw + 1) / 2^32, in (0, 1]",
    "angular_draw_mapping": "U2 = draw / 2^32, in [0, 1)",
    "maximum_input_length": 129,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "[z0_cos, z0_sin, z1_cos, z1_sin, ...]",
    "maximum_elements": 128,
    "success_result": "2*pair_count output elements",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "elements": 128,
    "meaning": "Output buffer holds at most one pair for each supplied uniform pair."
  },
  "contract": {
    "transform": "r=sqrt(-2*log(U1)); theta=2*pi*U2; emit (r*cos(theta), r*sin(theta))",
    "draw_consumption": "Each output pair consumes exactly the next radial/angular draw pair; there is no rejection or cached cross-call state.",
    "boundary_rules": "The radial mapping excludes zero and includes one, so log is defined; the angular mapping includes zero and excludes one.",
    "complexity": "O(pair_count) time and O(1) auxiliary space beyond the output buffer."
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "axis-aligned-pair",
      "input_values": [1, 2147483647, 0],
      "input_length": 3,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [1.1774100225154747, 0.0]
    },
    {
      "id": "quarter-turn-pair",
      "input_values": [1, 2147483647, 1073741824],
      "input_length": 3,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [0.0, 1.1774100225154747]
    },
    {
      "id": "radial-one-produces-zero-pair",
      "input_values": [1, 4294967295, 2147483648],
      "input_length": 3,
      "output_capacity": 2,
      "expected_result": 2,
      "expected_output": [0.0, 0.0]
    },
    {
      "id": "two-consecutive-pairs",
      "input_values": [2, 2147483647, 0, 2147483647, 1073741824],
      "input_length": 5,
      "output_capacity": 4,
      "expected_result": 4,
      "expected_output": [1.1774100225154747, 0.0, 0.0, 1.1774100225154747]
    },
    {
      "id": "empty-input",
      "input_values": [],
      "input_length": 0,
      "output_capacity": 128,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "zero-pair-count",
      "input_values": [0],
