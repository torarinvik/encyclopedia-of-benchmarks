      "output_capacity": 4,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "fractional-draw",
      "input_values": [1, 2147483647.5, 0],
      "input_length": 3,
      "output_capacity": 2,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "draw-above-unsigned-32-bit-range",
      "input_values": [1, 4294967296, 0],
