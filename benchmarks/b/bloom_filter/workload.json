{
  "schema_version": 1,
  "id": "bloom-filter-deterministic-trace-v1",
  "algorithm": "bloom_filter",
  "function_symbol": "bloom_filter",
  "input": {
    "kind": "operation_key_pairs_in_signed_64_bit_integer_array",
    "maximum_length": 256,
    "maximum_operations": 128,
    "operation_codes": {
      "1": "insert",
      "2": "contains query"
    },
    "key_range": [
      0,
      1000000000
    ],
    "bit_count": 64,
    "hash_count": 2,
    "hash_positions": [
      "(17 * key + 3) mod 64",
      "(31 * key + 7) mod 64"
    ],
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "one_byte_per_contains_query",
    "encoding": "0 for definitely absent, 1 when both Bloom filter bits are set",
    "false_positives_possible": true,
    "false_negatives_for_inserted_keys": false
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_trace",
      "input_values": [],
      "input_length": 0,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "query_empty_filter",
      "input_values": [
        2,
        0
      ],
      "input_length": 2,
      "expected_result": 1,
      "expected_output_hex": "00"
    },
    {
      "id": "query_before_and_after_insert",
      "input_values": [
        2,
        42,
        1,
        42,
        2,
        42
      ],
      "input_length": 6,
      "expected_result": 2,
      "expected_output_hex": "0001"
    },
    {
      "id": "duplicate_insert_is_idempotent",
      "input_values": [
        1,
        9,
        1,
        9,
        2,
        9
      ],
      "input_length": 6,
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "intentional_false_positive",
      "input_values": [
        1,
        0,
        2,
        64
      ],
      "input_length": 4,
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "mixed_operations",
      "input_values": [
        1,
        11,
        2,
        12,
        1,
        12,
        2,
        11,
        2,
        12
      ],
      "input_length": 10,
      "expected_result": 3,
      "expected_output_hex": "000101"
    },
    {
      "id": "maximum_key",
      "input_values": [
        1,
        1000000000,
        2,
        1000000000
      ],
      "input_length": 4,
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "odd_trace_length",
      "input_values": [
        1,
        7,
        2
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "unknown_operation",
      "input_values": [
        3,
        7
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_key",
      "input_values": [
        1,
        -1
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "first_key_above_limit",
      "input_values": [
        2,
        1000000001
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
