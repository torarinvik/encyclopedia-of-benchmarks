  "contract": {
    "operation": "Given f(x)=sum(a_i*x^i) and g(x)=sum(b_i*x^i), with b_0=0, return f(g(x)) modulo x^N over F_998244353.",
    "input_layout": "[N, a_0, ..., a_(N-1), b_0, ..., b_(N-1)]",
    "n_range": [1, 32],
    "coefficient_range": [0, 998244352],
    "inner_constant_condition": "b_0 = 0",
    "algorithm": "Brent–Kung block composition with m=ceil(sqrt(N)): truncated baby powers, coefficient-block evaluation, then giant-step Horner composition. Naive truncated polynomial products give O(N^(5/2)) field operations.",
    "modulus": 998244353,
    "output_layout": "N little-endian signed 64-bit coefficients c_0 through c_(N-1).",
    "error_precedence": "Malformed input returns -1 before output checks. Negative or non-integer capacity is invalid; valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, a_0, ..., a_(N-1), b_0, ..., b_(N-1)]",
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 32,
    "maximum_bytes": 256,
    "success_result": "8*N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
