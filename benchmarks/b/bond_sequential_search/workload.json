    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "definition": "index_a * 65 + index_b, where each index is the first matching zero-based position and 64 denotes absence",
    "valid_result_range": [0, 4224],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 0,
    "description": "The scan reads the packed input directly and tracks two indices and one composite mask."
  },
  "method": {
    "operation": "After validating the input domain, set mask to key_a OR key_b. Scan each value once; when (value AND mask) equals value, compare it exactly to each still-missing key and record its first index.",
    "distinct_from": "Two separate linear searches scan the array independently. Bond search combines both keys into a bit mask and applies one candidate test during a shared scan."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
