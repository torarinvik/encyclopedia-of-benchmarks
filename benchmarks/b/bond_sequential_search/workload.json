  "abi": "i64_array_scalar",
  "source": {
    "title": "Bond Sequential Search",
    "repository": "NIST Dictionary of Algorithms and Data Structures and WCECS 2012 paper",
    "url": "https://xlinux.nist.gov/dads/HTML/BondSeqSearch.html",
    "paper_url": "https://www.iaeng.org/publication/WCECS2012/WCECS2012_pp194-198.pdf",
    "accessed": "2026-11-16",
    "license": "Algorithm description only; no source code or prose copied"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[n, key_a, key_b, values[n]]",
    "length_formula": "n+3",
    "N_range": [0, 64],
    "key_range": [0, 255],
    "value_range": [0, 255],
    "keys_must_differ": true,
    "maximum_valid_length": 67,
