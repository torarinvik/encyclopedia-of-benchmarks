{
  "schema_version": 1,
  "id": "go-bfs-graph-coloring-star-forest-v1",
  "algorithm": "bfs_graph_coloring",
  "function_symbol": "bfs_graph_coloring",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[vertex_count, edge_count, (u,v)*]",
    "vertex_count_range": [
      0,
      64
    ],
    "edge_count_range": "0 through vertex_count*(vertex_count-1)/2",
    "vertex_ids": "dense labels 0 through vertex_count-1; all vertices are present before edges are added",
    "edges": "simple undirected edges with distinct in-range endpoints",
    "graph_requirement": "each connected component is a star or an isolated vertex (at most one vertex has degree greater than one)",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[vertex_count, color_0, ..., color_(vertex_count-1), colors_used]",
    "colors": "Go ColorUsingBFS increments an adjacent vertex color when it equals the current vertex color",
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
