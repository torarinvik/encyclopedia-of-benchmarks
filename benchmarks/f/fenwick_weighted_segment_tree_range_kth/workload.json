  "function_symbol": "fenwick_weighted_segment_tree_range_kth",
  "abi": "i64_array_scalar",
  "description": "Point replacement and dynamic range k-th selection using a Fenwick tree of weighted value segment trees.",
  "source": {
    "title": "OI Wiki: Fenwick Tree of Segment Trees",
    "authors": ["OI Wiki contributors"],
    "urls": ["https://www.timothywang.ca/OI-wiki/ds/seg-in-bit/"],
    "algorithm_attribution": "Dynamic range order statistics from Fenwick prefix roots and weighted value trees",
    "implementation_status": "clean-room implementations from the published algorithmic method"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, q, initial[n], operation_rows...]; each row has four words",
    "operation_row_width": 4,
    "operations": {
      "point_replacement": "[0, zero_based_position, new_value, 0]",
      "range_kth": "[1, zero_based_left, zero_based_exclusive_right, one_based_k]"
    },
    "n_range": [1, 12],
    "operation_count_range": [0, 16],
    "value_range": [-30, 30],
    "query_constraints": "0 <= left < right <= n; 1 <= k <= right-left",
    "exact_length": "2 + n + 4*q",
    "maximum_valid_length": 78,
    "maximum_parseable_length": 79,
    "invalid_input_result": -9223372036854775808
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "sum(query_ordinal * selected_value), with one-based query ordinals",
    "invalid_input_result": -9223372036854775808,
    "maximum_query_count": 16,
    "maximum_absolute_value": 30,
    "result_range": [-4080, 4080]
  },
  "contract": {
    "outer_structure": "one-based Fenwick tree over array positions",
    "inner_structure": "mutable weighted segment tree over the 61 ordered values -30 through 30",
    "query_method": "descend the Fenwick roots for right and left prefixes together using signed count differences",
    "update_semantics": "remove the old value and insert its replacement along the position Fenwick path",
    "node_capacity": 1280,
    "malformed_frame_result": -9223372036854775808,
    "no_query_result": 0
  },
  "complexity": {
    "point_replacement": "O(log n * log V)",
    "range_kth": "O(log n * log V)",
    "storage": "O(n * log n * log V) bounded by the declared node capacity"
  },
