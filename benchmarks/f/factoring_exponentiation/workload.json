  "algorithm": "factoring_exponentiation",
  "function_symbol": "factoring_exponentiation",
  "abi": "i64_array_scalar",
  "description": "Compute a*x^y modulo 2^d with a bit-factored 2-adic logarithm and exponential.",
  "source": {
    "title": "Binary Exponentiation by Factoring",
    "authors": ["CP-Algorithms contributors"],
    "url": "https://cp-algorithms.com/algebra/factoring-exp.html",
    "license": "CC BY-SA 4.0; algorithm description and mathematical constants only",
    "implementation_status": "bounded clean-room profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[a,x,y,d]",
    "remainder_range": "0..2^d-1",
    "base_range": "1..2^d-1, odd",
    "exponent_range": [0, 4294967295],
    "modulus_exponent_range": [3, 32],
    "maximum_valid_input_length": 4,
    "maximum_parseable_input_length": 5,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "a*x^y modulo 2^d",
    "success_result_range": [0, 4294967295],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 512,
    "minimum_bytes": 512,
    "meaning": "Fixed 32-entry 2-adic log table and scalar working state."
  },
  "complexity": {
    "primary_time": "O(d)",
    "primary_auxiliary_space": "O(1)",
    "independent_oracle_time": "O(log(y))",
    "independent_oracle_space": "O(1)"
  },
  "oracle_method": "The primary factors the odd unit into powers of 2^k+1, maps it through the 2-adic logarithm table, multiplies the logarithm by y, then reconstructs the power. The independent oracle uses ordinary repeated squaring modulo 2^d.",
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
