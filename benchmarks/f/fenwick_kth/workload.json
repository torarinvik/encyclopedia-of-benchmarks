{
  "schema_version": 1,
  "id": "fenwick-kth-i64-array-scalar-v1",
  "algorithm": "fenwick_kth",
  "function_symbol": "fenwick_kth",
  "abi": "i64_array_scalar",
  "description": "Point updates and O(log n) one-based occurrence selection by Fenwick binary lifting.",
  "source": {
    "title": "CP-Algorithms binary search and Fenwick tree articles",
    "authors": ["CP-Algorithms contributors"],
    "urls": [
      "https://cp-algorithms.com/num_methods/binary_search.html#search-with-powers-of-2",
      "https://cp-algorithms.com/data_structures/fenwick.html"
    ],
    "algorithm_attribution": "Search with powers of two adapted to Fenwick frequency selection",
    "implementation_status": "clean-room implementation from published algorithm descriptions"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, q, frequency[n], operation_rows...]; each row is [opcode, first, second]",
    "operation_row_width": 3,
    "operation_rows": {
      "point_add": "[0, zero_based_index, signed_delta]",
      "kth_occurrence": "[1, one_based_rank, 0]"
    },
    "n_range": [1, 64],
    "operation_count_range": [0, 32],
    "initial_frequency_range": [0, 1000000],
    "update_delta_range": [-1000000, 1000000],
    "post_update_frequency_range": [0, 1000000],
    "query_rank": "any signed i64; ranks below one or above total frequency return -1 for that query",
    "exact_length": "2 + n + 3*q",
    "maximum_valid_length": 162,
    "maximum_parseable_length": 163,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "sum((query_number+1)*(zero_based_answer+1)) for kth queries in order; an unavailable rank has answer -1 and contributes zero",
    "invalid_input_result": -1,
    "maximum_query_count": 32,
    "maximum_answer": 63,
    "result_range": [0, 33792]
  },
  "contract": {
    "occurrence_order": "indices increase; multiple occurrences at an index occupy consecutive ranks",
    "selection_rule": "return the first index whose inclusive prefix frequency is at least the one-based rank",
    "fenwick_indexing": "one-based internal tree over zero-based public indices",
    "initial_total_maximum": 64000000,
    "updated_total_maximum": 64000000,
    "invalid_update_or_frame_result": -1
  },
  "complexity": {
    "build": "O(n)",
    "point_update": "O(log n)",
    "kth_selection": "O(log n)",
    "auxiliary_space": "O(n)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 11,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "duplicate-occurrences-and-empty-slots",
      "input_values": [5, 9, 2, 0, 3, 1, 0, 1, 1, 0, 1, 2, 0, 1, 3, 0, 1, 4, 0, 1, 5, 0, 1, 6, 0, 1, 7, 0, 1, 0, 0, 1, 8, 0],
      "input_length": 34,
      "expected_result": 63
    },
    {
      "id": "point-add-remove-and-rank-boundaries",
      "input_values": [4, 8, 0, 0, 0, 0, 0, 0, 3, 0, 2, 2, 1, 1, 0, 1, 3, 0, 1, 4, 0, 0, 0, -3, 1, 1, 0, 1, 3, 0],
      "input_length": 30,
      "expected_result": 24
    },
    {
      "id": "empty-query-stream",
      "input_values": [3, 0, 0, 2, 0],
      "input_length": 5,
      "expected_result": 0
    },
    {
