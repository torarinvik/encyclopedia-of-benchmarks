  },
  "contract": {
    "operation": "Compute the order-m weights c_i for the derivative at xbar using Fornberg's ordered-node triangular recurrence.",
    "field": "F_998244353",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "validation_precedes_capacity": true,
    "output_untouched_on_error": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,xbar,x0,...,x(n-1)]",
    "node_count_range": [1, 8],
    "derivative_order_rule": "0<=m<=min(3,n-1)",
    "canonical_field_residue_range": [0, 998244352],
    "nodes_pairwise_distinct": true,
    "evaluation_point_may_equal_node": true,
    "maximum_valid_length": 11,
    "maximum_parseable_length": 12,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_word_bytes",
    "encoding": "[n,c0,...,c(n-1)]",
    "maximum_bytes": 72,
    "success_result": "8*(n+1)",
    "invalid_input_result": -1,
    "null_or_short_output_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "8x4 coefficient table (256 bytes), one saved row (32 bytes), up to 72 bytes of Elisa result staging, scalars/temporaries, and alignment margin; input is read in place."
  },
  "complexity": {
    "primary_time": "O(n^2*m + n^2 log p)",
    "primary_auxiliary_space": "O(n*Dmax), Dmax=3",
    "independent_time": "O(n^3 + n log p)",
    "independent_auxiliary_space": "O(n^2)"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "references": ["primary_oracle.py", "independent_oracle.py"],
