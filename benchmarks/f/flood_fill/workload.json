{
  "schema_version": 1,
  "id": "flood-fill-eight-connected-i32-v1",
  "algorithm": "flood_fill",
  "function_symbol": "flood_fill",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[width,height,start_x,start_y,new_color,target_color,pixels...]",
    "dimensions": [
      1,
      32
    ],
    "storage": "x-major, index = x * height + y",
    "colors": "signed 32-bit integers",
    "new_color_must_differ_from_target_color": true,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_i64_vector",
    "meaning": "complete image after replacing the eight-connected target-color component with new_color",
    "length": "width * height",
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "maximum 32 by 32 output image"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "diagonal_region",
      "input_values": [
        3,
        3,
        0,
        0,
        9,
        1,
        1,
        2,
        2,
        2,
        1,
        2,
        2,
        2,
        1,
        2,
        2
      ],
      "input_length": 17,
      "workspace_bytes": 8192,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "border_flood",
      "input_values": [
        3,
        2,
        0,
        0,
        7,
        0,
        0,
        0,
        1,
        0,
        0,
        1
      ],
      "input_length": 12,
      "workspace_bytes": 8192,
      "expected_result": 48,
      "expected_output_hex": "070000000000000007000000000000000100000000000000070000000000000007000000000000000100000000000000"
    },
    {
      "id": "seed_not_target",
      "input_values": [
        2,
        2,
        0,
        0,
        8,
        1,
        2,
        2,
        1,
        3
      ],
      "input_length": 10,
      "workspace_bytes": 8192,
      "expected_result": 32,
      "expected_output_hex": "0200000000000000020000000000000001000000000000000300000000000000"
    },
    {
      "id": "single_cell",
      "input_values": [
        1,
        1,
        0,
        0,
        5,
        -2,
        -2
      ],
      "input_length": 7,
      "workspace_bytes": 8192,
      "expected_result": 8,
      "expected_output_hex": "0500000000000000"
    },
    {
      "id": "capacity_failure",
      "input_values": [
        2,
        2,
        0,
        0,
        7,
        1,
        1,
        1,
        2,
        1
      ],
      "input_length": 10,
      "workspace_bytes": 8,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "equal_colors_invalid",
      "input_values": [
        1,
        1,
        0,
        0,
        4,
        4,
        4
      ],
      "input_length": 7,
      "workspace_bytes": 8192,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_seed",
      "input_values": [
        1,
        1,
        1,
        0,
        4,
        0,
        0
      ],
      "input_length": 7,
      "workspace_bytes": 8192,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "empty_dimension",
      "input_values": [
        0,
        1,
        0,
        0,
        4,
        0
      ],
      "input_length": 6,
      "workspace_bytes": 8192,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "color_out_of_i32",
      "input_values": [
        1,
        1,
        0,
        0,
        4,
        0,
        2147483648
      ],
      "input_length": 7,
      "workspace_bytes": 8192,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
