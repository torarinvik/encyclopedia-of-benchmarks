    "reuse_scope": "Algorithm idea only; contract, implementations, and fixtures are independent."
  },
  "description": "Replace one eight-connected target-color component using a LIFO work stack.",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[width,height,start_x,start_y,new_color,target_color,pixels...]",
    "dimensions": [
      1,
      32
    ],
    "storage": "x-major, index = x * height + y",
    "colors": "signed 32-bit integers",
    "new_color_must_differ_from_target_color": true,
    "maximum_valid_length": 1030,
    "maximum_parseable_length": 1031,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_i64_vector",
    "meaning": "complete image after replacing the eight-connected target-color component with new_color",
    "length": "width * height",
    "maximum_bytes": 8192,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 16384,
    "meaning": "8192-byte image scratch plus at most 8192 bytes of 64-bit traversal stack; caller buffers are excluded"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "contract": {
    "primary_method": "Recolor a matching cell when pushing it onto a LIFO stack so each cell is pushed at most once.",
    "independent_method": "Repeatedly expand a boolean component mask over all eight-neighbor links until reaching a fixed point.",
    "complexity": "O(width * height) time and O(width * height) auxiliary space.",
    "traversal_profile": "Depth-first schedule using a LIFO stack; the breadth-first queue schedule has a separate benchmark entry."
  },
