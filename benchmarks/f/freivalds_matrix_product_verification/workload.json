{
  "schema_version": 1,
  "id": "freivalds-matrix-product-verification-i64-array-scalar-v1",
  "algorithm": "freivalds_matrix_product_verification",
  "function_symbol": "freivalds_matrix_product_verification",
  "abi": "i64_array_scalar",
  "description": "Replays Freivalds' matrix-product test on a supplied tape of sign vectors.",
  "source": {
    "title": "Fast Probabilistic Algorithms",
    "author": "Rūsiņš Freivalds",
    "reference": "MFCS 1979, Lecture Notes in Computer Science 74, pages 57–69, Section 3",
    "doi": "10.1007/3-540-09526-8_5",
    "url": "https://doi.org/10.1007/3-540-09526-8_5",
    "implementation_status": "Clean-room deterministic replay with supplied sign vectors; no probability guarantee for a fixed tape."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,k,A[n*n],B[n*n],C[n*n],sign_vectors[k*n]]",
    "matrix_layout": "row-major square matrices",
    "dimension_range": [1, 8],
    "round_range": [1, 8],
    "matrix_entry_range": [-3, 3],
    "sign_vector_entry_values": [-1, 1],
    "maximum_valid_length": 258,
    "maximum_parseable_length": 259,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "1 if all supplied tests pass, 0 if any test fails",
    "valid_result_range": [0, 1],
    "invalid_input_result": -1
  },
  "contract": {
    "trace": "For each supplied r, compute B*r, then A*(B*r), and compare with C*r; stop at first mismatch.",
    "randomness": "The input vectors are an explicit replay tape; no random bits are generated by the function.",
    "one_sided": "If A*B=C, every tape returns 1; for an incorrect product, a fixed tape may also return 1.",
    "overflow": "All intermediate integer values fit signed 64-bit under declared bounds."
  },
  "complexity": {"time": "O(k*n^2)", "space": "O(n^2 + k*n)"},
  "measurement": {"comparison_model": "i64_array_scalar_call", "sample_count": 10, "warmup_rounds": 2, "repetitions_per_sample": 100},
  "cases": [
