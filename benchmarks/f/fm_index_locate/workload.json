  "algorithm": "fm_index_locate",
  "function_symbol": "fm_index_locate",
  "abi": "i64_array_bytes_output",
  "description": "FM-index backward search plus LF walking to sampled suffix-array values for locate(P).",
  "source": {
    "title": "Compressed Suffix Array",
    "authors": [
      "Djamal Belazzougui",
      "Veli M\u00e4kinen",
      "Daniel Valenzuela"
    ],
    "year": 2016,
    "doi": "10.1007/978-1-4939-2864-4_82",
    "epub_path": "OEBPS/AChap82.html",
    "section": "FM-Index; locate(P) after LF mapping",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_82",
    "implementation_status": "bounded clean-room profile; no book prose or code copied"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,text_symbols...,m,pattern_symbols...,sample_stride]",
    "text_symbol_range": [
      1,
      4
    ],
    "pattern_symbol_range": [
      1,
      4
    ],
    "text_length_range": [
      1,
      32
    ],
    "pattern_length_range": [
      1,
      8
    ],
    "sample_stride_range": "1..n",
    "maximum_valid_length": 43,
    "maximum_parseable_length": 43,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[match_count,matching_text_offsets_in_suffix_array_order]",
    "maximum_bytes": 264,
    "success_result": "8*(match_count+1) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded suffix array, BWT, C/rank/LF arrays, sampled-SA flags and values, and staged locations."
  },
  "contract": {
    "index": "Build BWT for text plus a unique smallest sentinel 0. Backward search computes the matching suffix-array interval.",
    "sampling": "Sample rows whose suffix-array value is divisible by the supplied stride s. This is a deterministic bounded realization of the chapter-described sampled-SA structure; the chapter requires s=Theta(log^(1+epsilon)n) asymptotically but leaves the finite sample schedule as a parameter.",
    "locate": "For each row in the backward-search interval in suffix-array order, LF-walk until a sampled row; recover (sampled_SA_value+walk_steps) modulo n+1. Return offsets only in 0..n-1.",
    "limits": "Counts/locates occurrences only. Does not claim compressed-space or asymptotic query bounds; rank is direct bounded prefix scan.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
