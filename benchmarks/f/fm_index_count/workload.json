  "contract": {
    "operation":"Build BWT for text plus a unique smallest sentinel and count one pattern by FM-index backward search.",
    "input_layout":"[n, text_symbol[n], m, pattern_symbol[m]]",
    "alphabet":"Text and pattern symbols are integers 1..4; sentinel 0 is appended internally.",
    "bounds":{"text_length":[1,32],"pattern_length":[1,8]},
    "tie_rule":"Suffixes are ordered lexicographically; the unique sentinel makes all suffixes distinct.",
    "output":"One signed-i64 count in eight little-endian bytes; overlapping occurrences count separately.",
    "limitations":"Only FM-index count(P) is represented. Locate samples, display, entropy bounds, and constant-time rank are excluded; rank is a bounded direct prefix scan.",
    "invalid_input_result":-1,
    "null_output_result":-2,
    "insufficient_output_capacity_result":-2,
    "no_write_on_error":true,
    "error_precedence":"Input framing and alphabet validation precede output-null/capacity checks."
  },
