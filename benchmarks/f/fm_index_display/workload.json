    "section": "FM-index; paragraph on general display(i,j) queries",
    "license": "No source-code license asserted; clean-room implementation"
  },
  "input": {
    "kind": "signed_i64_array",
    "layout": "[n,text_symbols[n],i,j,stride]",
    "text_length_range": [1, 32],
    "text_symbol_range": [1, 4],
    "query_bounds": "zero-based inclusive 0 <= i <= j < n",
    "stride_range": "1..n",
    "maximum_valid_length": 36,
    "invalid_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "Raw alphabet-symbol bytes T[i..j] in forward text order",
    "maximum_output_bytes": 32,
    "success_result": "number of substring bytes written",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_when_nonempty_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded suffix array, inverse suffix array, BWT, LF table, sampled ISA rows, and reverse substring staging."
  },
  "profile": {
    "index": "Build BWT for text plus a unique smallest sentinel 0; construct SA, ISA, and LF for the bounded input.",
    "sampling": "The chapter uses one-based positions j'*stride. Store ISA[p] when (p+1) is divisible by stride in zero-based indexing, and also store the terminal sentinel position n.",
    "query": "Choose the smallest sampled p strictly greater than j; LF-walk from ISA[p], skip BWT symbols above j, collect T[j] down to T[i], then reverse.",
    "scope": "One deterministic display(i,j) query; no compressed-space or asymptotic construction claim."
  },
  "measurement": {
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
