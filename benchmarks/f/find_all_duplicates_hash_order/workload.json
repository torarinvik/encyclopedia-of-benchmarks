{
  "schema_version": 1,
  "id": "find-all-duplicates-hash-order-ruby-i64-array-bytes-v1",
  "algorithm": "find_all_duplicates_hash_order",
  "function_symbol": "find_all_duplicates_hash_order",
  "input": {
    "kind": "signed_i64_array",
    "minimum_length": 0,
    "maximum_length": 1024,
    "duplicate_rule": "emit each distinct value occurring at least twice once, in first-occurrence order"
  },
  "output": {
    "kind": "bytes",
    "encoding": "little-endian signed i64 values; no terminator",
    "return_value": "number of emitted values",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "maximum_output_length": 4096
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "singleton",
      "input_values": [
        42
      ],
      "input_length": 1,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "published_example",
      "input_values": [
        4,
        3,
        2,
        7,
        8,
        2,
        3,
        1
      ],
      "input_length": 8,
      "expected_result": 2,
      "expected_output_hex": "03000000000000000200000000000000"
    },
    {
      "id": "duplicate_more_than_twice",
      "input_values": [
        4,
        9,
        4,
        9,
        4,
        4
      ],
      "input_length": 6,
      "expected_result": 2,
      "expected_output_hex": "04000000000000000900000000000000"
    },
    {
      "id": "negative_values",
      "input_values": [
        -5,
        8,
        -5,
        8
      ],
      "input_length": 4,
      "expected_result": 2,
      "expected_output_hex": "fbffffffffffffff0800000000000000"
    },
    {
      "id": "signed_i64_extremes",
      "input_values": [
        -9223372036854775808,
        9223372036854775807,
        9223372036854775807,
        -9223372036854775808
      ],
      "input_length": 4,
      "expected_result": 2,
      "expected_output_hex": "0000000000000080ffffffffffffff7f"
    }
  ]
}
