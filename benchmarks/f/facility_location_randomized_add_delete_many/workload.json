  "workspace": {
    "bytes": 192,
    "meaning": "Maximum caller output buffer; internal metric and trace storage is separately bounded."
  },
  "memory": {
    "internal_scratch_bytes": 32768,
    "meaning": "Fixed metric matrix, assignment state, draw tape, and output trace."
  },
  "contract": {
    "facility_model": "uncapacitated; candidate facilities have opening fees and clients have positive integer demands",
    "initial_assignment": "every client names a currently open facility; it need not be a nearest-center assignment",
    "random_choice_replay": "draw[Q] contains explicit facility IDs sampled from all F candidates; an already-open candidate is a no-op",
    "closer_set": "clients whose weighted service distance to the sampled closed facility is strictly lower than their current assigned distance; demands are positive, so comparing distance is sufficient",
    "delete_rule": "delete an open facility iff its opening fee plus current service cost for its assigned clients outside the closer set is strictly greater than reassigning those clients to the sampled facility",
    "acceptance": "accept the add and every selected delete only if the combined total objective strictly decreases",
    "assignment_update": "clients in the closer set and clients reassigned from deleted facilities move to the sampled facility; all other assignments remain unchanged",
    "tie_rule": "equal distances do not join the closer set; zero-saving center deletions are omitted; equal total objective rejects the move",
    "draw_tape_scope": "deterministic replay of random choices; no internal PRNG and no probabilistic approximation guarantee",
    "metric_rule": "symmetric integer metric with zero diagonal, positive off-diagonal entries, and all entries in 0..1000",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
