    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[cost_after[Q],accepted[Q],final_cost,final_open_mask,final_assignment[n],accepted_count]",
    "maximum_bytes": 192,
    "success_result": "8*(2*Q+3+n)",
    "invalid_input_result": -1,
