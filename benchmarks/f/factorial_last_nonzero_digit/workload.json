  },
  "contract": {
    "primary": "D(0..4)=(1,1,2,6,4); for n>=5, D(n)=D(floor(n/5))*D(n mod 5)*2^floor(n/5) mod 10. The ports evaluate this recurrence iteratively by reducing n by five.",
    "independent_reference": "For n<2 return 1. Otherwise write n=sum_i a_i*5^i and return 6*product_i(a_i!*2^(i*a_i)) mod 10, reducing all factors modulo 10.",
    "primary_time": "O(log_5(n+1))",
    "primary_space": "O(1)",
    "independent_time": "O(log_5(n+1))",
    "independent_space": "O(log_5(n+1))"
  },
