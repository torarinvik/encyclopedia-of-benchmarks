  },
  "contract": {
    "operation": "Compute one complex forward transform using three square-matrix transposes, two passes of side-length radix-2 row transforms, and the cross-dimension twiddle multiplication.",
    "input_encoding": "[side,re0,im0,re1,im1,...] where the complex samples fill a side-by-side matrix in row-major order.",
    "side_values": [2, 4, 8],
    "point_count": "side*side",
    "sample_component_range": [-8, 8],
    "exact_input_length": "1+2*side*side",
    "maximum_valid_input_length": 129,
    "maximum_parseable_input_length": 130,
    "forward_sign": "Negative exponent: exp(-2*pi*i*sample_index*frequency/point_count).",
    "six_step_order": [
      "transpose input matrix",
      "forward radix-2 transform each row",
      "multiply entry (row,column) by exp(-2*pi*i*row*column/point_count)",
      "transpose matrix",
      "forward radix-2 transform each row",
      "transpose matrix to natural frequency order"
    ],
    "output_encoding": "2*side*side float64 values as natural-order interleaved [real,imag] frequency bins.",
    "output_length": "2*side*side",
    "success_result": "2*side*side",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Invalid framing, nonfinite values, out-of-domain sides or samples, and null input return -1 before output checks. Null output or insufficient capacity returns -2 after input validation. Errors write no output values."
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[side,real0,imag0,...]",
    "minimum_valid_length": 9,
    "maximum_valid_length": 129,
