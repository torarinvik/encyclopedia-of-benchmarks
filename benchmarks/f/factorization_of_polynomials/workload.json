  "contract": {
    "operation": "Factor a monic polynomial over F_p into distinct monic irreducible factors and their multiplicities.",
    "input_layout": "[N, p, a_0, ..., a_N] with f(x)=sum(a_i*x^i)",
    "n_range": [0, 8],
    "prime_values": [2, 3, 5],
    "coefficient_range": "0 <= a_i < p",
    "leading_coefficient": 1,
    "algorithm": "Enumerate monic candidates through degree floor(N/2), filter each by exhaustive trial division through degree floor(d/2), and repeatedly divide the input by each irreducible candidate.",
    "complexity": "At most 780 monic candidates are enumerated for p<=5 and N<=8; each irreducibility check tests at most 30 smaller monic divisors. Polynomial division is quadratic in degree, so the bounded exhaustive search is at most O(p^6*N^2) with these fixed small limits.",
    "output_layout": "Little-endian signed 64-bit words: K, then for each distinct factor [multiplicity, degree, b_0, ..., b_degree]. Factors are sorted by degree then coefficient tuple; coefficients are low degree first.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below the required encoded size returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, p, a_0, ..., a_N]",
    "maximum_valid_length": 11,
    "maximum_parseable_length": 12,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_word_array",
    "maximum_output_elements": 33,
    "maximum_bytes": 264,
    "success_result": "encoded byte length",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "description": "Fixed arrays for the current polynomial, candidate, quotient, and at most eight reported factors."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"unit-polynomial-no-factors","input_values":[0,2,1],"input_length":3,"expected_result":8,"expected_output_hex":"0000000000000000"},
