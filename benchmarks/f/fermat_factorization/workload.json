  "algorithm": "fermat_factorization",
  "function_symbol": "fermat_factorization",
  "abi": "i64_array_scalar",
  "description": "Return the first proper factor exposed by a bounded Fermat difference-of-squares search.",
  "source": {
    "title": "Integer factorization — Fermat's factorization method",
    "authors": ["CP-Algorithms contributors"],
    "url": "https://cp-algorithms.com/algebra/factorization.html#fermats-factorization-method",
    "license": "CC BY-SA 4.0; algorithm description only",
    "implementation_status": "bounded clean-room profile"
  },
  "contract": {
    "operation": "Start at ceil(sqrt(N)), inspect max_steps consecutive values a, and return the first proper factor a-floor_sqrt(a*a-N) for which a*a-N is an exact square.",
    "input_encoding": "[N,max_steps]",
    "primary_method": "Exact integer-square testing over the bounded sequence of candidate a values.",
    "independent_method": "Enumerate factor pairs from the largest divisor at most sqrt(N) and check whether the nearest-pair a is within the candidate budget.",
    "invalid_input_result": -1,
    "bounded_miss_result": 0,
    "trivial_factor_policy": "Skip the representation (1,N); it does not expose a proper factor."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,max_steps]",
    "number_range": [3, 1000000000000],
    "number_parity": "odd",
    "max_steps_range": [0, 4096],
    "maximum_valid_length": 2,
    "maximum_parseable_length": 3,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "first proper positive Fermat factor, zero on bounded miss, or -1 on invalid input",
    "proper_factor_range": [2, 1000000],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 256,
    "meaning": "Candidate, exact integer-square-root bounds, and scalar temporaries."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "primary_oracle": "benchmarks/f/fermat_factorization/primary_oracle.py",
  "independent_oracle": "benchmarks/f/fermat_factorization/independent_oracle.py",
