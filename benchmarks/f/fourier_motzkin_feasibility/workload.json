    "implementation_status": "clean-room bounded profile; algorithm description only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[d,m,(a[0],...,a[d-1],b)*m] representing a*x<=b over the reals",
    "variable_count_range": [1, 3],
    "inequality_count_range": [1, 6],
    "coefficient_range": [-3, 3],
    "bound_range": [-6, 6],
    "exact_length": "2+m*(d+1)",
    "maximum_valid_length": 26,
    "maximum_parseable_length": 27,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "1 if feasible, 0 if infeasible, -1 for invalid input",
