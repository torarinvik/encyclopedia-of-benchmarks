    "infeasible_value": 0,
    "invalid_input_value": -1
  },
  "contract": {
    "operation": "Decide feasibility of a finite system of non-strict real linear inequalities.",
    "algorithm": "Eliminate variables in ascending index order by pairing every positive-coefficient row with every negative-coefficient row; retain zero rows.",
    "complexity": "O(m^(2^d)) generated rows and O(m^(2^d)) space for fixed d<=3.",
    "arithmetic": "Exact signed integer arithmetic; profile bounds keep all intermediate magnitudes below 2^31.",
    "error_precedence": "Validate nullness, frame shape, dimensions, and coefficient bounds before elimination."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id": "all-real-line", "input_values": [1, 1, 0, 0], "input_length": 4, "expected_result": 1},
    {"id": "single-upper-bound", "input_values": [1, 1, 1, 0], "input_length": 4, "expected_result": 1},
    {"id": "constant-contradiction", "input_values": [1, 1, 0, -1], "input_length": 4, "expected_result": 0},
