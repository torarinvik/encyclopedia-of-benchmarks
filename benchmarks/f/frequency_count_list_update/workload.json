{
  "schema_version": 1,
  "id": "encyclopedia-frequency-count-list-update-i64-array-bytes-output-v1",
  "algorithm": "frequency_count_list_update",
  "function_symbol": "frequency_count_list_update",
  "abi": "i64_array_bytes_output",
  "description": "Stable Frequency Count list update with access-position trace.",
  "source": {
    "title": "Online List Update",
    "authors": ["Shahin Kamali"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_266",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_266",
    "algorithm_attribution": "Frequency Count keeps more frequently requested items closer to the front; ties in this bounded profile preserve current relative order.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,request_count,initial_order[n],request_ids[request_count]]",
    "item_count_range": [1, 8],
    "request_count_range": [0, 32],
    "item_id_range": "0..n-1",
    "initial_order_requirement": "permutation of all item IDs",
    "maximum_valid_length": 42,
    "maximum_parseable_length": 42,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_vector",
    "encoding": "little-endian signed 64-bit words [total_access_cost,final_order[n],pre_access_positions[request_count]]",
    "maximum_bytes": 328,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {"bytes": 2048, "meaning": "Bounded item counts, request positions, and staged output."},
  "contract": {
    "access_cost": "Record and charge the item's 1-based position before the request updates its count or order.",
    "update": "Increment the accessed item's count and move it toward the front past items with strictly smaller counts.",
    "ties": "Equal-count items retain their current relative order; updates use free exchanges."
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "oracle_method": "The primary oracle bubbles the requested item past lower-frequency items. The independent verifier applies a stable descending-frequency sort after each request.",
