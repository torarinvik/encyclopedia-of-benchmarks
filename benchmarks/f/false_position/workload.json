{
  "schema_version": "1.0.0",
  "id": "false-position-fixed-quadratic-root-v1",
  "algorithm": "false_position",
  "function_symbol": "false_position",
  "description": "Find the uniquely bracketed root of f(x) = x^2 - x with false-position interpolation.",
  "input": {
    "kind": "two_finite_binary64_values",
    "layout": [
      "a",
      "b"
    ],
    "a": "Must lie in [0.125, 0.875], where f(a) < 0.",
    "b": "Must lie in [-2, -0.125] or [1.125, 3], where f(b) > 0.",
    "function": "f(x) = x^2 - x, with roots 0 and 1.",
    "root_isolation": "b < 0 brackets root 0; b > 1 brackets root 1.",
    "invalid_input_result": -1.0
  },
  "output": {
    "kind": "binary64",
    "definition": "The root approximation produced by bracket-preserving false-position updates. Stop when |f(c)| <= 1e-12, with a maximum of 256 updates.",
    "invalid_input_result": -1.0
  },
  "measurement": {
    "comparison_model": "float64_pair_call",
    "input_scaled_tolerance": 1e-10,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "root_zero_mid_bracket",
      "input_values": [
        0.5,
        -1.0
      ],
      "expected_result": 0.0
    },
    {
      "id": "root_one_mid_bracket",
      "input_values": [
        0.5,
        2.0
      ],
      "expected_result": 1.0
    },
    {
      "id": "root_zero_asymmetric",
      "input_values": [
        0.25,
        -2.0
      ],
      "expected_result": 0.0
    },
    {
      "id": "root_one_asymmetric",
      "input_values": [
        0.75,
        3.0
      ],
      "expected_result": 1.0
    },
    {
      "id": "root_zero_domain_edge",
      "input_values": [
        0.125,
        -0.125
      ],
      "expected_result": 0.0
    },
    {
      "id": "root_one_domain_edge",
      "input_values": [
        0.875,
        1.125
      ],
      "expected_result": 1.0
    },
    {
      "id": "root_zero_reversed_geometry",
      "input_values": [
        0.875,
        -1.5
      ],
      "expected_result": 0.0
    },
    {
      "id": "root_one_narrow",
      "input_values": [
        0.375,
        1.125
      ],
      "expected_result": 1.0
    },
    {
      "id": "first_endpoint_below_domain",
      "input_values": [
        0.1,
        -1.0
      ],
      "expected_result": -1.0
    },
    {
      "id": "first_endpoint_above_domain",
      "input_values": [
        0.9,
        2.0
      ],
      "expected_result": -1.0
    },
    {
      "id": "second_endpoint_at_root_one",
      "input_values": [
        0.5,
        1.0
      ],
      "expected_result": -1.0
    },
    {
      "id": "second_endpoint_inside_root_interval",
      "input_values": [
        0.5,
        0.75
      ],
      "expected_result": -1.0
    },
    {
      "id": "second_endpoint_too_close_to_root",
