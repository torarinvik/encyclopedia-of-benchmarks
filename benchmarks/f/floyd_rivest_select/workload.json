  "algorithm_profile": {
    "identity": "Floyd–Rivest Algorithm 489 rank-centered sample-window pivot estimator followed by duplicate-safe three-way partitioning.",
    "sample_cutoff": "Enter the sample-window branch when the active inclusive segment has R-L > 24. The published listing uses 600; this profile uses a smaller, documented workload cutoff because the paper states it was machine tuned.",
    "sample_window": "For N=R-L+1 and i=K-L+1, compute z=sqrt(ln N), s=0.5*exp(2z/3), and sd=0.5*sqrt(z*s*(N-s)/N)*sign(i-N/2). Estimate LL=K-i*s/N+sd and RR=K+(N-i)*s/N+sd; round LL down and RR up, clamp to [L,K] and [K,R], then recursively select K in that window.",
    "partition": "Copy input, pivot on the selected value at K, partition the active segment into less/equal/greater regions, and continue only in the region containing K.",
    "rounding": "Binary64 estimates; floor the lower endpoint and ceil the upper endpoint before clamping.",
    "complexity": "For this bounded profile, O(n^2) worst-case time and O(n) auxiliary space, including the copied array and sample recursion.",
    "tie_breaking": "Values must be distinct; invalid duplicate inputs return -1."
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "Value at zero-based sorted rank k; -1 for invalid input.",
    "valid_result_range": [0, 2147483647],
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
