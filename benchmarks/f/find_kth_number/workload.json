    "invalid_input_result": -9223372036854775808
  },
  "output": {
    "kind": "signed_i64",
    "definition": "The value at one-based rank k in descending order, counting duplicate values separately.",
    "invalid_input_result": -9223372036854775808
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
