    {"id": "last_is_min", "input_values": [5, 9, 7, 5, 3, -2], "expected_result": -2},
    {"id": "duplicates_count_separately", "input_values": [3, 4, 9, 9, 2, 9], "expected_result": 9},
    {"id": "negative_values", "input_values": [2, -10, -4, -7, -4], "expected_result": -4},
    {"id": "single_value", "input_values": [1, 42], "expected_result": 42},
