{
  "schema_version": "1.0.0",
  "id": "faraday-lenz-law-python-bounded-fixed-point-v1",
  "algorithm": "faraday_lenz_law",
  "function_symbol": "faraday_lenz_law",
  "description": "Compute the negative magnetic-flux change per time interval and round the induced electromotive force to one decimal place.",
  "input": {
    "kind": "fixed_point_flux_interval",
    "encoding": "[final_flux_milliweber, initial_flux_milliweber, interval_milliseconds]",
    "flux_range_milliweber": [
      -1000000000,
      1000000000
    ],
    "interval_range_milliseconds": [
      1,
      1000000000
    ],
    "flux_units": "Each flux integer is in 0.001 weber increments.",
    "invalid_input_result": -9223372036854775808
  },
  "output": {
    "kind": "signed_integer",
    "definition": "Induced electromotive force in decivolts, rounded to nearest with ties to even; invalid inputs return the signed 64-bit minimum sentinel.",
    "invalid_input_result": -9223372036854775808
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
