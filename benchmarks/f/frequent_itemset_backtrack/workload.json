{
  "schema_version": 1,
  "id": "frequent-itemset-backtrack-i64-array-bytes-v1",
  "algorithm": "frequent_itemset_backtrack",
  "function_symbol": "frequent_itemset_backtrack",
  "comparison_model": "i64_array_bytes_output_call",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[item_count,transaction_count,minimum_support,transaction_masks...]",
    "item_count_range": [1, 8],
    "transaction_count_range": [1, 16],
    "minimum_support_range": "1 through transaction_count",
    "transaction_mask_range": "0 through (1 << item_count) - 1",
    "maximum_valid_length": 19,
    "maximum_parseable_length": 20,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "layout": "[nonempty_frequent_itemset_count,mask_0,support_0,...]",
    "ordering": "depth-first tail extension in ascending item index; each parent precedes its extensions",
    "maximum_output_elements": 511,
    "maximum_output_bytes": 4088,
    "success_result": "exact output byte length",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_when_nonempty_result": -2
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Staged output words and bounded recursively projected transaction masks; no output bytes are written before capacity validation."
  },
  "measurement": {
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 20
  },
  "cases": [
    {
      "id": "down-projected-tail-extension",
      "input_values": [3, 5, 2, 3, 5, 7, 6, 1],
      "input_length": 8,
      "expected_result": 104,
      "expected_output_hex": "0600000000000000010000000000000004000000000000000300000000000000020000000000000005000000000000000200000000000000020000000000000003000000000000000600000000000000020000000000000004000000000000000300000000000000"
    },
    {
      "id": "all-itemsets-frequent-prefix-first-order",
      "input_values": [3, 3, 3, 7, 7, 7],
      "input_length": 6,
      "expected_result": 120,
      "expected_output_hex": "070000000000000001000000000000000300000000000000030000000000000003000000000000000700000000000000030000000000000005000000000000000300000000000000020000000000000003000000000000000600000000000000030000000000000004000000000000000300000000000000"
    },
    {
      "id": "threshold-prunes-children",
      "input_values": [3, 4, 3, 1, 3, 7, 5],
      "input_length": 7,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000400000000000000"
    },
    {
      "id": "no-nonempty-itemset-meets-threshold",
      "input_values": [3, 3, 1, 0, 0, 0],
      "input_length": 6,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "single-item-boundary",
      "input_values": [1, 2, 1, 1, 0],
      "input_length": 5,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000100000000000000"
    },
    {
      "id": "invalid-transaction-mask",
      "input_values": [2, 1, 1, 4],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-input-length",
      "input_values": [3, 2, 1, 1],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [1, 1, 1, 1],
      "input_length": 4,
      "expected_result": -2,
      "expected_output_hex": "",
      "workspace_bytes": 16,
      "capacity_error_result": -2
    }
  ],
  "provenance": {
    "chapter": "Frequent Pattern Mining",
    "doi": "10.1007/978-1-4939-2864-4_722",
    "algorithm_profile": "Backtrack frequent-itemset enumeration using tail extension and down-projected transaction rows; empty set is the recursion root but is not emitted."
  }
}
