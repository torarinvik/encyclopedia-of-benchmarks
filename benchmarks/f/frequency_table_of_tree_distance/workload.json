{
  "schema_version": 1,
  "id": "library-checker-frequency-table-tree-distance-centroid-bounded-i64-array-bytes-v1",
  "algorithm": "frequency_table_of_tree_distance",
  "function_symbol": "frequency_table_of_tree_distance",
  "abi": "i64_array_bytes_output",
  "description": "Count unordered tree-vertex pairs by edge distance using centroid decomposition and depth frequencies.",
  "source": {
    "title": "Frequency Table of Tree Distance",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/tree/frequency_table_of_tree_distance/task.md",
    "algorithm_attribution": "Centroid decomposition with cross-component depth-frequency counting",
    "implementation_status": "clean-room bounded centroid pair-counting profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,(u,v)...]",
    "N_range": [1, 64],
    "tree_constraint": "exactly N-1 valid undirected edges forming a connected acyclic graph",
    "maximum_valid_length": 127,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "signed 64-bit little-endian pair counts for distances 1 through N-1",
    "maximum_bytes": 504,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 504,
    "meaning": "Maximum output-buffer capacity; adjacency, component, and depth-frequency storage are separate."
  },
  "contract": {
    "result": "for each d from 1 through N-1, count unordered pairs at tree distance d",
    "official_N_range": [1, 200000],
    "pair_ordering": "unordered vertex pairs"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "single-vertex-empty-histogram",
      "input_values": [1],
      "input_length": 1,
      "output_capacity": 8,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "two-vertex-tree",
      "input_values": [2,0,1],
      "input_length": 3,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "four-vertex-path",
      "input_values": [4,0,1,1,2,2,3],
      "input_length": 7,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "030000000000000002000000000000000100000000000000"
    },
    {
      "id": "five-vertex-star",
      "input_values": [5,0,1,0,2,0,3,0,4],
      "input_length": 9,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0400000000000000060000000000000000000000000000000000000000000000"
    },
    {
      "id": "balanced-seven-vertex-tree",
      "input_values": [7,0,1,0,2,1,3,1,4,2,5,2,6],
      "input_length": 13,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "060000000000000007000000000000000400000000000000040000000000000000000000000000000000000000000000"
    },
    {
      "id": "cycle-is-not-a-tree",
      "input_values": [4,0,1,1,2,2,0],
      "input_length": 7,
      "output_capacity": 504,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [4,0,1,1,2,2,3],
      "input_length": 7,
      "output_capacity": 23,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
