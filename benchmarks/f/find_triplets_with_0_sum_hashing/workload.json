    "result": "count of unique sorted value triples in first-discovery order",
    "output_encoding": "three signed 32-bit little-endian values per triple",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 32768,
    "meaning": "output storage; at most 2017 unique triples fit in the declared 64-item domain"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
