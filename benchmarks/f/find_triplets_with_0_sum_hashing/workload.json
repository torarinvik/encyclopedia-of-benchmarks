{
  "schema_version": 1,
  "id": "find-triplets-with-zero-sum-hashing-v1",
  "algorithm": "find_triplets_with_0_sum_hashing",
  "function_symbol": "find_triplets_with_0_sum_hashing",
  "input": {
    "kind": "signed_integer_array",
    "encoding": "the array of candidate values",
    "maximum_length": 64,
    "value_range": [
      -100000,
      100000
