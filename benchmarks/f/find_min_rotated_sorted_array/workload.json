{
  "schema_version": 1,
  "id": "find-min-rotated-sorted-array-v1",
  "algorithm": "find_min_rotated_sorted_array",
  "contract": {
    "input": "A nonempty rotation of a strictly increasing array of up to 256 signed 64-bit integers; values are distinct.",
    "output": "The minimum value in the rotated array.",
    "invalid_input_result": -1,
    "invalid_inputs": [
      "empty array",
      "more than 256 values"
    ]
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
