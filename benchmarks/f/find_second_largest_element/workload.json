{
  "schema_version": 1,
  "id": "find-second-largest-element-js-i64-array-scalar-v1",
  "algorithm": "find_second_largest_element",
  "function_symbol": "find_second_largest_element",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": ["n", "values[0..n)"],
    "length_rule": "exactly n+1",
    "n_range": [2, 10000],
    "value_range": [-2147483648, 2147483647],
    "required_array_property": "at least two distinct values",
    "invalid_result": -9223372036854775808
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "greatest array value strictly less than the maximum; duplicate maxima are skipped",
    "invalid_result": -9223372036854775808
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"two-distinct-values","input_values":[2,1,2],"input_length":3,"expected_result":1},
    {"id":"duplicate-maximum-skipped","input_values":[5,7,9,9,6,9],"input_length":6,"expected_result":7},
    {"id":"negative-values","input_values":[4,-10,-2,-5,-2],"input_length":5,"expected_result":-5},
    {"id":"int32-minimum-as-answer","input_values":[2,-2147483648,2147483647],"input_length":3,"expected_result":-2147483648},
    {"id":"int32-maximum-as-answer","input_values":[3,2147483647,2147483646,2147483647],"input_length":4,"expected_result":2147483646},
    {"id":"invalid-no-distinct-answer","input_values":[3,8,8,8],"input_length":4,"expected_result":-9223372036854775808},
    {"id":"invalid-int32-value","input_values":[2,2147483648,1],"input_length":3,"expected_result":-9223372036854775808},
    {"id":"invalid-length","input_values":[3,1,2],"input_length":3,"expected_result":-9223372036854775808},
    {"id":"invalid-too-short","input_values":[1,5],"input_length":2,"expected_result":-9223372036854775808}
  ]
}
