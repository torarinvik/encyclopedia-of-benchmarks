{
  "schema_version": 1,
  "id": "frequent-pattern-growth-count-i64-array-scalar-v1",
  "algorithm": "frequent_pattern_growth",
  "function_symbol": "frequent_pattern_growth",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[transaction_count,item_count,minimum_support,transaction_mask...]",
    "transaction_count_range": [
      1,
      64
    ],
    "item_count_range": [
      1,
      8
    ],
    "minimum_support_range": "1 through transaction_count",
    "transaction_mask_range": "0 through (1 << item_count) - 1",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "count of nonempty frequent itemsets discovered by FP-growth",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 50
  },
  "cases": [
    {
      "id": "pinned_example_min_support_3",
      "input_values": [
        8,
        4,
        3,
        7,
        3,
        9,
        11,
        10,
        6,
        12,
        15
      ],
      "expected_result": 8
    },
    {
      "id": "all_patterns_at_support_1",
      "input_values": [
        4,
        3,
        1,
        1,
        2,
        7,
        0
      ],
      "expected_result": 7
    },
    {
      "id": "pair_and_triple_support",
      "input_values": [
        5,
        4,
        2,
        15,
        7,
        11,
        13,
        1
      ],
      "expected_result": 13
    },
    {
      "id": "no_singleton_meets_threshold",
      "input_values": [
        3,
        3,
        3,
        1,
        2,
        4
      ],
      "expected_result": 0
    },
    {
      "id": "single_item_frequent",
      "input_values": [
        4,
        1,
        2,
        1,
        0,
        1,
        0
      ],
      "expected_result": 1
    },
    {
      "id": "duplicate_transactions",
      "input_values": [
        5,
        3,
        3,
        7,
        7,
        3,
        1,
        1
      ],
      "expected_result": 3
    },
    {
      "id": "maximum_items",
      "input_values": [
        6,
        8,
        3,
        255,
        127,
        63,
        31,
        15,
        7
      ],
      "expected_result": 63
    },
    {
      "id": "empty_itemsets_only",
      "input_values": [
        3,
        4,
        1,
        0,
        0,
        0
      ],
      "expected_result": 0
    },
    {
      "id": "invalid_minimum_support",
      "input_values": [
        4,
        3,
        0,
        1,
        2,
        3,
        4
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_mask",
      "input_values": [
        2,
        3,
        1,
        1,
        8
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_length",
      "input_values": [
        4,
        3,
        2,
        1,
        2
      ],
      "expected_result": -1
    }
  ]
}
