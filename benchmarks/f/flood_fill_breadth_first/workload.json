  "workspace": {
    "bytes": 16384,
    "meaning": "8192-byte image scratch plus at most 8192 bytes of 64-bit queue; caller buffers are excluded"
  },
  "contract": {
    "primary_method": "Recolor a matching cell when enqueueing it into a FIFO queue so each cell is enqueued at most once.",
    "independent_method": "Repeatedly expand a boolean component mask over all eight-neighbor links until reaching a fixed point.",
    "complexity": "O(width * height) time and O(width * height) queue and image storage.",
    "traversal_profile": "Breadth-first schedule processes cells in nondecreasing distance from the seed; the LIFO stack schedule is separately benchmarked as flood_fill."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
