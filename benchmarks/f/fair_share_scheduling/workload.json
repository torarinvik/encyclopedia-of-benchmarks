{
  "schema_version": "1.0.0",
  "id": "fair-share-scheduling-java-bounded-weighted-users-v1",
  "algorithm": "fair_share_scheduling",
  "function_symbol": "fair_share_scheduling",
  "description": "Sum task weights for each user and allocate a truncated proportional share of a fixed resource total.",
  "input": {
    "kind": "weighted_users_and_tasks",
    "encoding": "[user_count, task_count, total_resources, user_id_0, ..., task_owner_0, task_weight_0, ...]",
    "maximum_users": 64,
    "maximum_tasks": 128,
    "user_id_range": [
      0,
      63
    ],
    "task_weight_range": [
      0,
      1000000
    ],
    "total_resources_range": [
      0,
      1000000
    ],
    "duplicate_user_ids": "invalid",
    "tasks_for_unknown_users": "ignored as in the Java addTask method",
    "invalid_input_result": -2
  },
  "output": {
    "kind": "byte_sequence",
    "encoding": "For users sorted by ascending ID, emit user ID, aggregate task weight, and floor(aggregate_weight * total_resources / total_weight) as little-endian signed 64-bit integers. If total_weight is zero, every allocation is zero. Unallocated integer remainder is not redistributed.",
    "invalid_input_result": -2,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
