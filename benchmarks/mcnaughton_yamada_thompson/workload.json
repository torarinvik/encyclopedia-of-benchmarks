    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "int64_scalar",
    "encoding": "1 for full-string acceptance; 0 for valid nonmatch; -1 for invalid input.",
    "invalid_input_result": -1
