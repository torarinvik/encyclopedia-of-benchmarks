{
  "schema_version": 1,
  "id": "neville-polynomial-interpolation-i64-array-float64-v1",
  "algorithm": "neville",
  "function_symbol": "neville",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[count,target,x0,y0,...]",
    "count_range": [1, 16],
    "coordinate_and_value_range": [-1000000, 1000000],
    "unique_x_coordinates": true,
    "maximum_packed_values": 34,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "float64",
    "definition": "in-place Neville recurrence in ascending polynomial degree",
    "invalid_input_result": -1e300,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {"id": "linear_extrapolation", "input_values": [3, 3, 0, 1, 1, 3, 2, 5], "expected_result": 7.0},
    {"id": "quadratic", "input_values": [3, 2, -1, 1, 0, 0, 1, 1], "expected_result": 4.0},
    {"id": "at_known_node", "input_values": [3, 1, 0, 1, 1, 3, 2, 5], "expected_result": 3.0},
    {"id": "single_point", "input_values": [1, 9, 4, -7], "expected_result": -7.0},
    {"id": "duplicate_x", "input_values": [2, 0, 1, 2, 1, 3], "expected_result": -1e300},
    {"id": "malformed_length", "input_values": [2, 0, 1, 2], "expected_result": -1e300},
    {"id": "empty_count", "input_values": [0, 0], "expected_result": -1e300},
    {"id": "over_bound_target", "input_values": [1, 1000001, 0, 1], "expected_result": -1e300}
  ]
}
