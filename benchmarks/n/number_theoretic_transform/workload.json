  "contract": {
    "operation": "Compute the natural-order forward DFT of a power-of-two vector over the field modulo 998244353.",
    "input_layout": "[n, a0, ..., a(n-1)]",
    "bounds": {"n": [1, 64], "coefficient": [0, 998244352]},
    "semantics": "n is a power of two; primitive root is 3; omega=3^((998244353-1)/n) mod 998244353; result[k]=sum_j a[j]*omega^(j*k) mod 998244353.",
    "output_encoding": "n unsigned 32-bit little-endian residues in natural index order",
    "output_bytes": "4*n",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Malformed frame, unsupported length, or noncanonical residue returns -1 before output checks. Null output or capacity below 4*n returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "length word n followed by n canonical residues",
    "maximum_input_length": 65,
    "valid_ranges": {"n": "power of two, 1..64", "coefficient": "0..998244352"},
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "unsigned 32-bit little-endian transformed residues",
    "maximum_bytes": 256,
    "success_result": "4*n bytes on success",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 100},
