{
  "schema_version": 1,
  "id": "negative-log-likelihood-rust-source-v1",
  "algorithm": "negative_log_likelihood",
  "function_symbol": "negative_log_likelihood",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[n, actual_scaled[0..n], predicted_scaled[0..n]]",
    "minimum_count": 1,
    "maximum_count": 64,
    "scale": 1000000,
    "actual_scaled_range": [
      0,
      1000000
    ],
    "predicted_scaled_range": [
      1,
      999999
    ],
    "invalid_input_result": -1e+300,
    "notes": "The source accepts actual and predicted values in [0, 1], but predicted endpoints produce NaN through 0*ln(0) or ln(0); this finite benchmark domain excludes them."
  },
  "output": {
    "kind": "binary64",
    "definition": "source-ordered mean of -actual*ln(predicted) - (1-actual)*ln(1-predicted)",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e+300
  },
  "cases": [
