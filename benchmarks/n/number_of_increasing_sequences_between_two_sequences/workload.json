  "oracle": "benchmarks/n/number_of_increasing_sequences_between_two_sequences/primary_oracle.py",
  "independent_oracle": "benchmarks/n/number_of_increasing_sequences_between_two_sequences/independent_oracle.py",
  "contract": {
    "input_layout": "[n, m, A_0, ..., A_(n-1), B_0, ..., B_(n-1)]",
    "n_range": [1, 64],
    "m_range": [1, 64],
    "bound_condition": "0 <= A_i < B_i <= m",
    "sequence_condition": "A_i <= x_i < B_i and x_0 <= x_1 <= ... <= x_(n-1); x_i are integers in [0,m)",
    "modulus": 998244353,
    "algorithm": "Initialize one way for each allowed value at position zero. For each later position, prefix-sum the previous value counts through v and retain the prefix for values inside the current interval.",
    "complexity": "O(n*m) time and O(m) auxiliary space",
    "invalid_input_result": -1
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "n, m, n lower bounds, then n exclusive upper bounds",
    "maximum_length": 130,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "count of valid nondecreasing integer sequences modulo 998244353",
    "modulus": 998244353,
    "invalid_input_result": -1
  },
  "measurement": {
