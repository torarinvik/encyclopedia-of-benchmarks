  "description": "Counts nondecreasing integer sequences constrained by per-position half-open intervals modulo 998244353.",
  "source": {
    "site": "Library Checker",
    "problem": "Number of Increasing Sequences Between Two Sequences",
    "problem_url": "https://judge.yosupo.jp/problem/number_of_increasing_sequences_between_two_sequences",
