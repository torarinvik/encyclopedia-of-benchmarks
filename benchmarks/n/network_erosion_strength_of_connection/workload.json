{
  "schema_version": 1,
  "id": "encyclopedia-network-erosion-strength-of-connection-i64-array-bytes-output-v1",
  "algorithm": "network_erosion_strength_of_connection",
  "function_symbol": "network_erosion_strength_of_connection",
  "abi": "i64_array_bytes_output",
  "description": "Exact rational strength of connection by shortest-path network erosion for distinct directed endpoints.",
  "source": {
    "title": "Quantification of Regulation in Networks with Positive and Negative Interaction Weights",
    "chapter_doi": "10.1007/978-1-4939-2864-4_598",
    "paper_title": "Network Analysis Reveals Cross-links of the Immune Pathways Activated by Bacteria and Allergen",
    "paper_doi": "10.1103/PhysRevE.84.031929",
    "license": "Copyright remains with the cited publishers; clean-room algorithm description only.",
    "implementation_status": "bounded clean-room SoC path-erosion profile using original-paper normalization"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,source,target,(from,to)*M]",
    "vertex_count_range": [2, 8],
    "edge_count_range": "0..N*(N-1)",
    "endpoint_range": "0..N-1; source and target must differ",
    "graph": "Simple directed graph without self-loops; this profile fixes every arc to positive unit length, and the source SoC measure does not distinguish path signs.",
    "tie_rule": "Choose the lexicographically smallest vertex sequence among shortest source-to-target paths.",
    "maximum_valid_length": 116,
    "maximum_parseable_length": 117,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "Reduced exact fraction [numerator, denominator] for 2/(N+2) times the sum of reciprocal finite erosion distances; infinite distances contribute zero.",
    "maximum_values": 2,
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed storage for an eight-vertex adjacency matrix, BFS queue and predecessor arrays, erosion distances, and staged two-word output."
  },
  "contract": {
    "endpoint_branch": "Only distinct endpoints are accepted; the shortest-cycle source==target branch is excluded.",
    "distance_definition": "Each internal vertex receives the edge length of the first selected shortest path containing it. The two endpoints keep the initial shortest-path length. Vertices left unassigned after erosion have infinite distance.",
    "erosion": "For a shortest path of length one, delete its direct arc. Otherwise assign still-unset path vertices and delete every internal path vertex with its incident arcs. Repeat until no directed source-to-target path remains.",
    "normalization": "Use the original paper's distinct-endpoint denominator (N+2)/2. The chapter's displayed i!=j and i==j denominators appear reversed relative to the paper.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 0,
    "repetitions_per_sample": 1
  },
  "primary_oracle": "benchmarks/n/network_erosion_strength_of_connection/primary_oracle.py",
  "independent_oracle": "benchmarks/n/network_erosion_strength_of_connection/independent_oracle.py",
