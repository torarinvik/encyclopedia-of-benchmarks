{
  "schema_version": 1,
  "id": "negative-cycle-detection-i64-array-bytes-output-v1",
  "algorithm": "negative_cycle_detection",
  "function_symbol": "negative_cycle_detection",
  "abi": "i64_array_bytes_output",
  "description": "Bounded global negative-cycle detection with deterministic cycle-witness bytes.",
  "source": {
    "title": "Negative Cycles in Weighted Digraphs",
    "editor": "Ming-Yang Kao",
    "book": "Encyclopedia of Algorithms",
    "chapter_doi": "10.1007/978-1-4939-2864-4_257",
    "publication_year": 2016,
    "rights": "Book chapter remains publisher-copyrighted; package ports are clean-room implementations."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[node_count, edge_count, (from, to, weight)...]",
    "node_count_range": [
      0,
      20
    ],
    "edge_count_range": [
      0,
      64
    ],
    "weight_range": [
      -1000,
      1000
    ],
    "edge_semantics": "directed; loops and parallel edges allowed; each supplied edge is processed in input order",
    "exact_length": "2 + 3 * edge_count",
    "maximum_valid_length": 194,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "encoding": "[0] if no global negative cycle, otherwise [1, cycle_length, canonical_cycle_vertices...]; closing edge to first vertex is implicit",
    "maximum_values": 22,
    "maximum_bytes": 176,
    "success_result": "number of output bytes",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 704,
    "meaning": "Fixed edge, distance, predecessor, witness, and staged-output arrays sized to the stated bounds."
  },
  "contract": {
    "operation": "Detect a negative-weight directed cycle anywhere in the graph and emit one cycle witness.",
    "recurrence": "Set every initial distance to zero (equivalent to a zero-weight super-source to every vertex), then perform up to node_count input-order in-place Bellman-Ford passes with strict relaxation.",
    "witness": "If the final pass relaxes an edge, follow predecessor links node_count times, walk the cycle, reverse predecessor order to edge direction, and rotate to place the minimum vertex first.",
    "tie_rule": "Input edge order fixes relaxations; witness rotation is by minimum vertex ID.",
    "verification": "Primary oracle computes the exact source-order witness. Independent verifier uses Floyd-Warshall for cycle existence and validates witness edges and negative total weight; it accepts any valid witness.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
