{
  "schema_version": 1,
  "id": "ngram-ascii-sliding-window-i64-array-bytes-v1",
  "algorithm": "ngram",
  "function_symbol": "ngram",
  "input": {
    "kind": "width_count_then_ascii_codepoints",
    "layout": "[ngram_size, text_length, character_code_0, ..., character_code_n-1]",
    "ngram_size_range": [
      1,
      16
    ],
    "text_length_range": [
      0,
      256
    ],
    "allowed_characters": "printable ASCII 32 through 126"
  },
  "output": {
    "kind": "newline_delimited_windows",
    "window_order": "left to right, including repeated windows",
    "return_value": "number of bytes written",
    "empty_result": "zero bytes when the window exceeds the text length",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
