  },
  "contract": {
    "split_normalization": "A split mask is the side of its edge bipartition that excludes leaf 0.",
    "tree_validity": "All pendant splits are present; the n-3 internal splits form a compatible rooted-cluster hierarchy.",
    "distance": "The minimum number of operations, each exchanging two subtrees across one internal edge, that transforms tree A into tree B.",
    "leaf_bound_reason": "There are only 945 unrooted binary topologies at seven labeled leaves; exact finite-state search is bounded at this profile size.",
