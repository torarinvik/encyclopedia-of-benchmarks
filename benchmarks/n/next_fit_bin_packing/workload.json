  "pinned_source": {
    "title": "Bin Packing",
    "author": "David S. Johnson",
    "doi": "10.1007/978-1-4939-2864-4_49",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_49",
    "epub_path": "OEBPS/AChap49.html",
