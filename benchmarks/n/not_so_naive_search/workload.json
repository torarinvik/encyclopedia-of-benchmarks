  "output": {"kind": "signed_64_bit_integer", "meaning": "first zero-based match offset"},
  "algorithm_policy": {
    "preprocessing": "constant-time two-shift selection from the first two pattern bytes",
    "comparison_order": "pattern byte 1, then bytes 2 through m-1, then byte 0",
    "time_complexity": "O(n*m) worst case; constant-time preprocessing",
    "auxiliary_space": "O(1)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 20
