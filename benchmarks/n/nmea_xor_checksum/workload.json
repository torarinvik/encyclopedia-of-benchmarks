{
  "schema_version": 1,
  "id": "nmea-xor-checksum-i64-array-scalar-v1",
  "algorithm": "nmea_xor_checksum",
  "function_symbol": "nmea_xor_checksum",
  "abi": "i64_array_scalar",
  "description": "Compute the NMEA 8-bit XOR checksum over a bounded sentence payload.",
  "source": {
    "method_source": "GPSD, NMEA Revealed, NMEA Encoding Conventions",
    "method_url": "https://gpsd.gitlab.io/gpsd/NMEA.html",
    "method_note": "Use the XOR rule and maximum sentence length to define an independent payload-only core API; the start delimiter, * separator, checksum digits, and line endings are excluded."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[L, byte_0, ..., byte_(L-1)]",
    "payload_length_range": [
      0,
      76
    ],
    "payload_byte_range": [
      0,
      127
    ],
    "maximum_valid_length": 77,
    "maximum_parseable_length": 78,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "range": [
      0,
      127
    ],
    "definition": "bitwise XOR of every payload byte; zero for an empty payload",
    "invalid_input_result": -1
  },
  "contract": {
    "primary_method": "Validate the framing and byte domain, then XOR-fold the payload bytes.",
    "independent_method": "For each of the seven possible set bits, count payload bytes containing that bit and set the output bit when the count is odd.",
    "complexity": "O(L) time and O(1) auxiliary space.",
    "invalid_cases": "Null input, invalid frame length, payload length outside 0..76, or any byte outside 0..127 returns -1.",
    "distinct_from": "hash_xor8 adds bytes and applies two's-complement finalization; this workload is a true bytewise XOR checksum."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 6,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
