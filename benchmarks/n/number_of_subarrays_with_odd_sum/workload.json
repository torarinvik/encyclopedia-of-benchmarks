{
  "id": "number-of-subarrays-with-odd-sum-v1",
  "algorithm": "number_of_subarrays_with_odd_sum",
  "contract": {
    "input": "A sequence of 0 to 100,000 signed 32-bit integers.",
    "output": "The number of contiguous subarrays with odd sum, modulo 1,000,000,007.",
    "invalid_input_result": -1,
    "empty_input_result": 0
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": 0
    },
    {
      "id": "one-odd",
      "input_values": [
        1
      ],
      "input_length": 1,
      "expected_result": 1
    },
    {
      "id": "one-even",
      "input_values": [
        2
      ],
      "input_length": 1,
      "expected_result": 0
    },
    {
      "id": "two-odd",
      "input_values": [
        1,
        1
      ],
      "input_length": 2,
      "expected_result": 2
    },
    {
      "id": "standard-three-odd",
      "input_values": [
        1,
        3,
        5
      ],
      "input_length": 3,
      "expected_result": 4
    },
    {
      "id": "mixed-standard",
      "input_values": [
        1,
        2,
        3
      ],
      "input_length": 3,
      "expected_result": 4
    },
    {
      "id": "all-even",
      "input_values": [
        2,
        4,
        6,
        8
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "negative-values",
      "input_values": [
        -1,
        2,
        -3
      ],
      "input_length": 3,
      "expected_result": 4
    },
    {
      "id": "signed-boundaries",
      "input_values": [
        -2147483648,
        1,
        2147483647
      ],
      "input_length": 3,
      "expected_result": 3
    },
    {
      "id": "alternating-parity",
      "input_values": [
        1,
        2,
        1,
        2,
        1,
        2,
        1
      ],
      "input_length": 7,
      "expected_result": 16
    },
    {
      "id": "single-large-even",
      "input_values": [
        100,
        200,
        300,
        400
      ],
      "input_length": 4,
      "expected_result": 0
    }
  ]
}
