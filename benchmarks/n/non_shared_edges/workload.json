    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Fixed arrays of at most thirteen split masks and staged scalar output."
  },
  "contract": {
    "split_normalization": "The stored side of each split excludes leaf 0.",
    "tree_validity": "All pendant splits must be present; internal splits must form a compatible hierarchy with n-3 internal edges.",
    "distance": "(2*n-3) minus the number of shared canonical edge splits.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
