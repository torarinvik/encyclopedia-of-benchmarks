  "abi": "i64_array_bytes_output",
  "description": "Robinson-Foulds non-shared edge count for two bounded unrooted binary phylogenies.",
  "source": {
    "title": "Non-shared Edges",
    "authors": ["Wing-Kai Hon"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_259",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_259",
    "algorithm_attribution": "Day's non-shared edge distance problem, represented by its defining leaf bipartitions",
    "implementation_status": "clean-room bounded split-set profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[leaf_count, edge_split_masks_for_tree_A, edge_split_masks_for_tree_B]",
    "leaf_count_range": [3, 8],
    "split_encoding": "Each mask gives the side of an edge bipartition excluding leaf 0; each tree has 2*n-3 distinct compatible splits, including all n pendant splits.",
    "maximum_valid_length": 27,
    "invalid_input_result": -1
