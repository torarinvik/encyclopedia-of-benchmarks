  "abi": "i64_array_scalar",
  "description": "Evaluate the Newton-form interpolant from distinct finite-field sample nodes using in-place divided differences.",
  "source": {
    "title": "NIST Digital Library of Mathematical Functions, §3.3 Interpolation",
    "url": "https://dlmf.nist.gov/3.3",
    "role": "Newton divided-difference formula and nested-basis evaluation; algorithm ideas only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,x[0..N-1],y[0..N-1],query]",
    "node_count_range": [1, 12],
    "field": "F_998244353",
    "canonical_field_values": "0 <= each node, ordinate, and query < 998244353",
    "nodes": "pairwise distinct",
    "exact_length": "2+2*N",
    "maximum_valid_length": 26,
    "maximum_parseable_length": 27,
    "invalid_input_result": -1,
    "null_input_result": -1
