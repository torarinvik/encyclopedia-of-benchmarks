  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "the interpolating polynomial evaluated at query modulo 998244353",
    "result_range": [0, 998244352],
    "invalid_input_result": -1
  },
  "algorithm_contract": {
    "divided_difference_update": "For order k=1..N-1 and indices i descending from N-1 through k, replace d[i] by (d[i]-d[i-1])/(x[i]-x[i-k]) in F_998244353.",
    "inverse": "Use Fermat inversion because every node difference is nonzero in the prime field.",
    "evaluation": "Nested Newton form: start with d[N-1], then for i=N-2..0 set value=value*(query-x[i])+d[i] modulo the field.",
    "valid_empty_case": "N must be at least one; a singleton interpolant is the constant y[0]."
  },
  "complexity": {
    "time": "O(N^2 log MODULUS) with independent modular inversions in the divided-difference table",
    "space": "O(N)"
  },
  "measurement": {
