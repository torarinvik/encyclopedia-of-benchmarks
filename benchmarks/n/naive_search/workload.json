{
  "schema_version": 1,
  "id": "naive-pattern-all-matches-v1",
  "algorithm": "naive_search",
  "function_symbol": "naive_search",
  "input": {
    "kind": "signed_64_bit_text_pattern_byte_arrays",
    "minimum_length": 2,
    "maximum_length": 512,
    "maximum_text_bytes": 255,
    "maximum_pattern_bytes": 255,
    "byte_range": "non-NUL ASCII values 1 through 127",
    "empty_pattern": "matches every boundary from 0 through text_length",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "byte_array",
    "encoding_output": "ascending zero-based match positions, one unsigned byte per position"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_text_and_pattern",
      "input_values": [0, 0],
      "expected_result": 1,
      "expected_output_hex": "00"
    },
    {
      "id": "empty_pattern_at_every_boundary",
      "input_values": [3, 0, 65, 66, 67],
      "expected_result": 4,
      "expected_output_hex": "00010203"
    },
    {
      "id": "overlapping_matches",
      "input_values": [5, 3, 65, 66, 65, 66, 65, 65, 66, 65],
      "expected_result": 2,
      "expected_output_hex": "0002"
    },
    {
      "id": "repeated_overlapping_matches",
      "input_values": [4, 2, 65, 65, 65, 65, 65, 65],
      "expected_result": 3,
      "expected_output_hex": "000102"
    },
    {
      "id": "matches_after_gaps",
      "input_values": [5, 2, 65, 66, 88, 65, 66, 65, 66],
      "expected_result": 2,
      "expected_output_hex": "0003"
    },
    {
      "id": "no_match",
      "input_values": [5, 2, 65, 66, 67, 68, 69, 70, 71],
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "pattern_longer_than_text",
      "input_values": [2, 3, 65, 66, 65, 66, 67],
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "exact_match",
      "input_values": [3, 3, 65, 66, 67, 65, 66, 67],
      "expected_result": 1,
      "expected_output_hex": "00"
    },
    {
      "id": "ascii_boundary_byte",
      "input_values": [3, 1, 32, 127, 32, 127],
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "embedded_nul_rejected",
      "input_values": [3, 1, 65, 0, 66, 66],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "non_ascii_byte_rejected",
      "input_values": [1, 1, 128, 65],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated_packed_input",
      "input_values": [3, 1, 65, 66],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "length_above_bound",
      "input_values": [256, 0],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_length",
      "input_values": [-1, 0],
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
