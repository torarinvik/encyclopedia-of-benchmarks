{
  "schema_version": 1,
  "id": "orbital-capture-radii-python-v1",
  "algorithm": "orbital_capture_radii",
  "function_symbol": "orbital_capture_radii",
  "input": {
    "kind": "bounded_binary64_orbital_parameters",
    "argument_order": [
      "target_radius_m",
      "target_mass_kg",
      "projectile_velocity_m_s"
    ],
    "bounds": {
      "target_radius_m": [
        1e-06,
        10000000000.0
      ],
      "target_mass_kg": [
        0,
        2e+30
      ],
      "projectile_velocity_m_s": [
        1000000.0,
        299792458.0
      ]
    },
    "formula": "round(target_radius * sqrt(1 + ((2 * G * target_mass) / target_radius) / velocity^2), 0), G = 6.67430e-11",
    "rounding": "Nearest integer, ties to even; matches Python round(value, 0).",
    "invalid_result": -1e+300,
    "verification_relative_tolerance": 1e-12,
    "verification_absolute_tolerance": 1e-09
  },
  "output": {
    "kind": "binary64",
    "definition": "round(target_radius * sqrt(1 + ((2 * G * target_mass) / target_radius) / velocity^2), 0), G = 6.67430e-11",
    "invalid_result": -1e+300
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "input_scaled_tolerance": 1e-35,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
  "cases": [
    {
      "id": "source-solar-example",
      "input_values": [
        695700000.0,
        1.99e+30,
        25000.0
      ],
