{
  "schema_version": 1,
  "id": "ones-complement-ascii-bits-v1",
  "algorithm": "ones_complement",
  "function_symbol": "ones_complement",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "ASCII byte values for a binary string",
    "minimum_length": 1,
    "maximum_length": 64,
    "value_range": [
      48,
      49
    ],
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "byte_string",
    "encoding": "same-length ASCII binary string with each bit flipped",
    "successful_result": "number of output bytes written"
  },
  "workspace": {
    "bytes": 64,
    "meaning": "maximum output capacity"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
