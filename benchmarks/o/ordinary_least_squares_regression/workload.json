{
  "schema_version": 1,
  "id": "ordinary-least-squares-regression-intercept-slope-v1",
  "algorithm": "ordinary_least_squares_regression",
  "function_symbol": "ordinary_least_squares_regression",
  "input": {
    "kind": "packed_signed_64_bit_observation_pairs",
    "layout": "[n, x0, y0, x1, y1, ...]",
    "observation_count_range": [2, 32],
    "coordinate_range": [-10000, 10000],
    "requires_nonconstant_x": true,
    "maximum_input_values": 65
  },
  "output": {
    "kind": "float64_vector",
    "values": ["intercept", "slope"],
    "byte_order": "little_endian",
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-12,
    "maximum_output_bytes": 16,
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id": "zero_intercept", "input_values": [4, 1, 2, 2, 4, 3, 6, 4, 8], "expected_result": 16, "expected_output": [0.0, 2.0]},
    {"id": "nonzero_intercept", "input_values": [4, -2, 3, -1, 5, 1, 9, 2, 11], "expected_result": 16, "expected_output": [7.0, 2.0]},
    {"id": "fractional_slope", "input_values": [4, 0, 1, 1, 1, 2, 3, 3, 3], "expected_result": 16, "expected_output": [0.8, 0.8]},
    {"id": "constant_y", "input_values": [3, -2, 5, 0, 5, 4, 5], "expected_result": 16, "expected_output": [5.0, 0.0]},
    {"id": "constant_x_invalid", "input_values": [3, 2, 0, 2, 1, 2, 2], "expected_result": -1, "expected_output": []},
    {"id": "count_mismatch", "input_values": [2, 0, 0], "expected_result": -1, "expected_output": []}
  ]
}
