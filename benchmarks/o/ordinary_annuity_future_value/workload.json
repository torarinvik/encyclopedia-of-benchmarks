{
  "schema_version": 1,
  "id": "ordinary-annuity-future-value-binary64-v1",
  "algorithm": "ordinary_annuity_future_value",
  "function_symbol": "ordinary_annuity_future_value",
  "input": {
    "kind": "payment_periods_rate",
