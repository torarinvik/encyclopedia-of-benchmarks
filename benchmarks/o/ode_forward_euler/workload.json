    {"id": "full_step_negative_initial", "input_values": [1, 4, -2, 3], "expected_result": 16, "expected_output_hex": "000000000000f03f0000000000001440"},
    {"id": "three_quarter_step_mixed_state", "input_values": [1, 3, 2, -2], "expected_result": 16, "expected_output_hex": "000000000000e03f0000000000000cc0"},
    {"id": "maximum_steps", "input_values": [16, 1, 0, 0], "expected_result": 16, "expected_output_hex": "00000000000000000000000000000000"},
