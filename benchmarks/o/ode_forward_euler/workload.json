    {"id": "invalid_step_size", "input_values": [1, 5, 1, 0], "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_state_bound", "input_values": [1, 1, 11, 0], "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_wrong_length", "input_values": [1, 1, 0], "expected_result": -1, "expected_output_hex": ""},
