  "id": "oi-wiki-offline-dynamic-bipartiteness-rollback-parity-dsu-v1",
  "algorithm": "offline_dynamic_bipartiteness",
  "function_symbol": "offline_dynamic_bipartiteness",
  "abi": "i64_array_bytes_output",
  "description": "Offline edge-lifetime bipartiteness queries using segment-tree interval assignment and rollback parity DSU.",
  "source": {
    "name": "OI Wiki: Segment Tree and Offline Queries; Disjoint Set Union",
    "urls": [
      "https://oi-wiki.org/topic/segment-tree-offline/",
      "https://oi-wiki.org/ds/dsu/"
    ],
    "source_type": "algorithm_description",
    "license": "CC BY-SA 4.0 and SATA",
    "reuse": "Algorithm descriptions only; all ports, contract, references, fixtures, and documentation are independently authored."
  },
  "primary_reference": "benchmarks/offline_dynamic_bipartiteness_oracle.py",
  "independent_reference": "benchmarks/o/offline_dynamic_bipartiteness/independent_bfs_reference.py",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,(op,a,b,c)*q]",
    "vertex_count_range": [
      1,
      16
    ],
    "event_count_range": [
      0,
      64
    ],
    "maximum_valid_length": 258,
    "maximum_parseable_length": 259,
    "event_encoding": {
      "0": "add edge [0,edge_id,u,v]",
      "1": "remove active edge [1,edge_id,0,0]",
      "2": "query whole-graph bipartiteness [2,0,0,0]"
    },
    "endpoint_order": "Canonical zero-based endpoints satisfying 0<=u<=v<n.",
    "edge_ids": "Values 0..63, single-use throughout a trace; removal requires an active ID.",
    "self_loops": "Allowed; while active they make the graph non-bipartite.",
    "parallel_edges": "Disallowed while the same endpoint pair is active; a removed pair may be added again with a fresh ID.",
    "edge_lifetime": "Half-open interval [add_event,remove_event); an unremoved edge remains active through the end of the trace.",
    "query_semantics": "Each query observes all preceding updates and asks whether every connected component is bipartite.",
    "reserved_fields": "Remove and query records require all unused fields to be zero.",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "algorithm": "Assign active edge intervals to a segment tree over event time; DFS it with a rollback DSU storing XOR parity from each node to its parent. Each edge requires endpoint parity 1; a same-component constraint with parity 0 increments a rollback contradiction count.",
    "output_order": "One answer for each opcode-2 query in event order.",
    "complexity": "O(q^2 + A*log(q+1)*log(n+1)) time for A edge additions; O(q^2+n) fixed table storage.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Input framing and event validation precede output pointer/capacity checks."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "one 0 (not bipartite) or 1 (bipartite) per query",
    "element_width_bytes": 8,
    "maximum_elements": 64,
    "maximum_bytes": 512,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 196608,
    "explicit_fixed_array_payload_bytes_64_bit": 143936,
    "meaning": "The explicit fixed-array payload plus bounded recursion frames and call-local state; at most 64 edge constraints enter a root-to-leaf rollback history."
  },
