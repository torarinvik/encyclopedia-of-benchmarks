{
  "schema_version": 1,
  "id": "online-interval-coloring-i64-array-bytes-output-v1",
  "algorithm": "online_interval_coloring",
  "function_symbol": "online_interval_coloring",
  "abi": "i64_array_bytes_output",
  "description": "Deterministic online interval coloring by smallest feasible level followed by per-level First Fit.",
  "source": {
    "title": "Online Interval Coloring",
    "editor": "Ming-Yang Kao",
    "book": "Encyclopedia of Algorithms",
    "chapter_doi": "10.1007/978-1-4939-2864-4_264",
    "summarized_algorithm": "Kierstead-Trotter (1981)",
    "rights": "The chapter is publisher-copyrighted; local implementation is clean-room."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[interval_count, (left, right)...] in arrival order",
    "interval_count_range": [
      0,
      64
    ],
    "endpoint_range": [
      -1000,
      1000
    ],
    "interval_semantics": "closed intervals; left <= right; touching endpoints intersect",
    "exact_length": "1 + 2 * interval_count",
    "maximum_valid_length": 129,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "encoding": "One global color ID per interval in arrival order; global color = 3*(level-1)+first_fit_color",
    "maximum_values": 64,
    "maximum_bytes": 512,
    "maximum_color_id": 191,
    "success_result": "8 * interval_count bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "contract": {
    "operation": "Process intervals online in input order. Assign each interval to the smallest level k for which the clique number of prior intervals in levels 1..k plus the new interval is at most k. Then assign the smallest nonnegative First-Fit color not used by an earlier intersecting interval in that level.",
    "level_rule": "A candidate interval is included at its new level; earlier intervals in levels greater than the candidate are excluded from the A_k union. Maximum overlap is evaluated at closed interval start coordinates.",
    "color_rule": "Each level has a disjoint three-color range; the bounded profile follows the chapter's Kierstead-Trotter construction whose per-level First-Fit coloring uses at most three colors.",
    "bounds": "At most 64 intervals and 129 input words; endpoint magnitude at most 1000.",
    "oracle": "Primary oracle emits exact deterministic bytes; independent verifier recomputes levels by a grouped endpoint event sweep and checks the exact First-Fit output.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "workspace": {
    "bytes": 1536,
    "meaning": "Fixed bounded interval, level, local-color, and staged-color arrays."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
