{
  "schema_version": 1,
  "id": "order-preserving-huffman-greedy-trace-bounded-v1",
  "algorithm": "order_preserving_huffman_greedy_trace",
  "function_symbol": "order_preserving_huffman_greedy_trace",
  "abi": "i64_array_bytes_output",
  "description": "Greedy adjacent-minimum ordered tree merges, returning symbol depths and weighted path cost.",
  "source": {
    "title": "NIST DADS: order-preserving Huffman coding",
    "authors": ["Paul E. Black, editor; NIST DADS contributors"],
    "reference": "Repeatedly merge adjacent active trees with least combined frequency, preserving character order.",
    "url": "https://xlinux.nist.gov/dads/HTML/orderPreservingHuffmanCoding.html",
    "related_reference": "Graefe, Implementing Sorting in Database Systems, DOI 10.1145/1132960.1132964",
    "implementation_status": "clean-room bounded profile; algorithm description only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, weight_0, ..., weight_(n-1)]",
    "n_range": [2, 8],
    "weight_range": [1, 15],
    "maximum_total_weight": 120,
    "maximum_valid_length": 9,
    "maximum_parseable_length": 10,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "[n, weighted_path_cost, depth_0, ..., depth_(n-1)] as signed 64-bit little-endian words",
    "maximum_bytes": 80,
    "maximum_depth": 7,
    "maximum_weighted_path_cost": 840,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded merge nodes or active intervals, depth vector, traversal stack, and staged output."
  },
  "contract": {
    "operation": "Repeatedly merge the adjacent pair of active trees with minimum combined weight and report leaf depths and their weighted sum.",
    "tie_rule": "Choose the leftmost adjacent pair among equal combined weights; this is a deterministic benchmark profile choice because the cited description leaves ties open.",
    "symbol_order": "Merges preserve original leaf order: the left tree remains the left child.",
    "complexity": "O(n^2) time and O(n) bounded auxiliary storage for both references.",
    "error_precedence": "Validate frame and all weights, compute and stage the complete result, then validate output pointer and capacity before writing.",
    "no_write_on_error": true,
    "optimality_claim": "None; this is the greedy order-preserving method, distinct from unrestricted Huffman and optimal alphabetic coding."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "two-equal-symbols",
      "input_values": [2, 5, 5],
      "input_length": 3,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "02000000000000000a0000000000000001000000000000000100000000000000"
    },
    {
      "id": "three-equal-symbols-leftmost-tie",
      "input_values": [3, 1, 1, 1],
      "input_length": 4,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "03000000000000000500000000000000020000000000000002000000000000000100000000000000"
    },
    {
      "id": "four-equal-symbols-balanced",
      "input_values": [4, 1, 1, 1, 1],
      "input_length": 5,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "040000000000000008000000000000000200000000000000020000000000000002000000000000000200000000000000"
    },
    {
      "id": "ordered-unequal-weights",
      "input_values": [4, 1, 2, 3, 4],
      "input_length": 5,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "040000000000000013000000000000000300000000000000030000000000000002000000000000000100000000000000"
    },
    {
      "id": "five-equal-symbols-leftmost-ties",
      "input_values": [5, 1, 1, 1, 1, 1],
      "input_length": 6,
      "output_capacity": 56,
      "expected_result": 56,
      "expected_output_hex": "05000000000000000c0000000000000002000000000000000200000000000000030000000000000003000000000000000200000000000000"
    },
    {
      "id": "maximum-eight-symbol-frame-and-output",
      "input_values": [8, 1, 1, 1, 1, 1, 1, 1, 1],
      "input_length": 9,
      "output_capacity": 80,
      "expected_result": 80,
      "expected_output_hex": "0800000000000000180000000000000003000000000000000300000000000000030000000000000003000000000000000300000000000000030000000000000003000000000000000300000000000000"
    },
    {
      "id": "maximum-output-one-byte-short",
      "input_values": [8, 1, 1, 1, 1, 1, 1, 1, 1],
      "input_length": 9,
      "output_capacity": 79,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "zero-weight-invalid",
      "input_values": [2, 0, 3],
      "input_length": 3,
      "output_capacity": 80,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "weight-over-limit",
      "input_values": [2, 1, 16],
      "input_length": 3,
      "output_capacity": 80,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "trailing-word-invalid",
      "input_values": [2, 1, 1, 0],
      "input_length": 4,
      "output_capacity": 80,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "maximum-parseable-frame-trailing-word",
      "input_values": [8, 1, 1, 1, 1, 1, 1, 1, 1, 0],
      "input_length": 10,
      "output_capacity": 80,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "output_capacity": 80,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [2, 3, 7],
      "input_length": 3,
      "output_capacity": 32,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
