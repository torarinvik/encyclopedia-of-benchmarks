{
  "schema_version": 1,
  "id": "order-agnostic-binary-search-i32-v1",
  "algorithm": "order_agnostic_binary_search",
  "function_symbol": "order_agnostic_binary_search",
  "input": {
    "kind": "packed_target_and_monotone_i32_sequence",
    "encoding": "[target, item_count, item_0, ..., item_(n-1)]",
    "minimum_item_count": 1,
    "maximum_item_count": 99999,
    "target_and_item_range": [-2147483648, 2147483647],
    "sequence_order": "monotone nondecreasing or monotone nonincreasing",
    "duplicate_matches": "return first equality encountered by midpoint loop",
    "invalid_result": -1,
    "missing_result": -1
  },
  "cases": [
    {"id":"ascending_hit","input_values":[4,5,1,3,4,5,7],"expected_result":2,"input_length":7},
    {"id":"ascending_miss_above","input_values":[10,5,1,3,4,5,7],"expected_result":-1,"input_length":7},
    {"id":"descending_hit","input_values":[4,5,9,7,4,2,1],"expected_result":2,"input_length":7},
    {"id":"descending_miss_below","input_values":[0,5,9,7,4,2,1],"expected_result":-1,"input_length":7},
    {"id":"ascending_duplicate_midpoint","input_values":[2,6,1,2,2,2,4,5],"expected_result":2,"input_length":8},
    {"id":"descending_duplicate_midpoint","input_values":[2,6,5,4,2,2,2,1],"expected_result":2,"input_length":8},
    {"id":"all_equal_hit","input_values":[4,5,4,4,4,4,4],"expected_result":2,"input_length":7},
    {"id":"singleton_hit","input_values":[7,1,7],"expected_result":0,"input_length":3},
    {"id":"singleton_miss","input_values":[8,1,7],"expected_result":-1,"input_length":3},
    {"id":"malformed_length","input_values":[3,2,1],"expected_result":-1,"input_length":3},
    {"id":"zero_count","input_values":[3,0],"expected_result":-1,"input_length":2},
    {"id":"target_outside_i32","input_values":[2147483648,1,7],"expected_result":-1,"input_length":3}
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
