    {"id":"no_cutoff_by_bounded_limit","input_values":[1,4,9.094947017729282e-13,1,1,1,1,1,2,2,2,2,1,1,1,1,-1,-0.5,-0.3333333333333333,-0.25],"input_length":20,"output_capacity":3,"expected_result":-3,"expected_output":[]},
