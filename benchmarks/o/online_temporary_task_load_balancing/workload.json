{
  "schema_version": 1,
  "id": "encyclopedia-temporary-task-load-balancing-i64-array-bytes-output-v1",
  "algorithm": "online_temporary_task_load_balancing",
  "function_symbol": "online_temporary_task_load_balancing",
  "abi": "i64_array_bytes_output",
  "description": "Online assignment of temporary weighted tasks to identical machines by current active load.",
  "source": {
    "title": "Online Load Balancing of Temporary Tasks",
    "author": "Leah Epstein",
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_206",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_206",
    "copyright": "Springer; this package uses algorithm description only and reproduces no book text, figures, or code."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[machine_count, task_count, (arrival, weight, duration)*task_count]",
    "machine_count_range": [1, 8],
    "task_count_range": [0, 32],
    "arrival_range": [0, 1000],
    "arrival_order": "nondecreasing; input order resolves simultaneous arrivals",
    "weight_range": [1, 1000],
    "duration_range": [1, 1000],
    "completion_time_maximum": 2000,
    "active_interval": "[arrival, arrival + duration)",
    "exact_length": "2 + 3*task_count",
    "maximum_valid_length": 98,
    "maximum_parseable_length": 99,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[peak_active_load, zero_based_machine_id_per_task_in_input_order]",
    "machine_tie_rule": "lowest machine ID",
    "maximum_bytes": 264,
    "success_result": "8 * (1 + task_count) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Staged output and fixed arrays for machine loads and at most 32 task-expiration events."
  },
  "algorithm": {
    "primary": "Process arrivals in input order, remove all completion events with completion_time <= arrival, select the lowest-ID machine with minimum active load, assign irrevocably, add the task weight, update peak, and insert its completion event into a min-heap.",
    "independent_oracle": "At every arrival, recompute each machine's active load by scanning every prior assignment and retaining exactly tasks whose completion time is greater than the arrival; apply the same least-load rule and update peak.",
    "primary_complexity": "O(task_count log task_count + task_count*machine_count) time and O(task_count + machine_count) space.",
    "oracle_complexity": "O(task_count^2 + task_count*machine_count) time and O(task_count + machine_count) space."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"no-tasks","input_values":[3,0],"input_length":2,"output_capacity":8,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"overlapping-loads","input_values":[2,3,0,5,4,1,6,3,2,2,5],"input_length":11,"output_capacity":32,"expected_result":32,"expected_output_hex":"0700000000000000000000000000000001000000000000000000000000000000"},
    {"id":"completion-before-arrival","input_values":[2,2,0,5,2,2,3,1],"input_length":8,"output_capacity":24,"expected_result":24,"expected_output_hex":"050000000000000000000000000000000000000000000000"},
    {"id":"simultaneous-arrival-input-order","input_values":[2,3,0,3,5,0,3,5,0,2,5],"input_length":11,"output_capacity":32,"expected_result":32,"expected_output_hex":"0500000000000000000000000000000001000000000000000000000000000000"},
    {"id":"unsorted-arrivals","input_values":[2,2,3,1,1,2,1,1],"input_length":8,"output_capacity":264,"expected_result":-1,"expected_output_hex":""},
    {"id":"zero-duration","input_values":[2,1,0,3,0],"input_length":5,"output_capacity":264,"expected_result":-1,"expected_output_hex":""},
    {"id":"trailing-value","input_values":[2,0,7],"input_length":3,"output_capacity":264,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[2,1,0,5,3],"input_length":5,"output_capacity":15,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-output","input_values":[2,0],"input_length":2,"output_capacity":8,"output_is_null":true,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":0,"input_is_null":true,"output_capacity":264,"expected_result":-1,"expected_output_hex":""}
  ]
