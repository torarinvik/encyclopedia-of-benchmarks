    "valid_result_range": [0, 8253],
    "invalid_input_result": -1
  },
  "algorithm_profile": {
    "method": "Maintain a circular linked order and cyclic integer labels. If the gap after the insertion anchor is at most one, scan the source's bounded local interval and redistribute its labels evenly; then assign the new node the midpoint label.",
    "order_query": "Compare the two current labels directly; labels are kept unique and increasing in sentinel-list order.",
    "scope": "Insert and order only. Delete is excluded because the pinned source's erase assignments do not update either neighbor link.",
    "bounded_label_universe": "The source unsigned ring has size 2M. This profile scales its half-ring parameter to M=2^31, uses labels modulo 2M=2^32, and preserves the source width fold and local-relabel rule.",
    "complexity": "At most 64 existing nodes are scanned or relabeled by one insertion, so the bounded profile is O(N) per insert and O(N) space; each order query is O(1).",
    "maximum_result_derivation": "A true query requires two earlier inserts, so at most query positions 3 through 128 contribute; their one-based sum is 8253."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
