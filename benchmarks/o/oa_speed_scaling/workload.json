{
  "schema_version": 1,
  "id": "encyclopedia-oa-speed-scaling-i64-array-bytes-output-v1",
  "algorithm": "oa_speed_scaling",
  "function_symbol": "oa_speed_scaling",
  "abi": "i64_array_bytes_output",
  "description": "Bounded Optimal Available event-triggered YDS replanning trace with exact cubic-power energy.",
  "source": {
    "title": "A Scheduling Model for Reduced CPU Energy",
    "authors": ["Frances Yao", "Alan Demers", "Scott Shenker"],
    "url": "https://doi.org/10.1109/SFCS.1995.492493",
    "chapter_url": "https://doi.org/10.1007/978-1-4939-2864-4_390",
    "used_for": "OA's arrival-time replanning of optimal schedules over remaining known work; YDS critical intervals and EDF dispatch, described clean-room."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,(release,deadline,work)*N]",
    "job_count_range": [1, 2],
    "time_range": [0, 4],
    "work_range": [1, 4],
    "job_rule": "Every job has integer release < deadline; windows are half-open [release,deadline).",
    "maximum_valid_length": 7,
    "maximum_parseable_length": 8,
    "power_function": "P(s)=s^3",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[segment_count,energy_num,energy_den,(start,end,speed_num,speed_den)*,(finish_num,finish_den)*]; segments are positive-speed maximal intervals and finishes are in input order",
    "maximum_values": 19,
    "maximum_bytes": 152,
    "success_result": "8 * output_value_count bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Conservative stack bound for two jobs, the three emitted speed segments, exact rational intermediates, encoded fields, and staged output."
  },
  "contract": {
    "arrival_policy": "At each distinct release, add all jobs released then; replan over the remaining portions of all known unfinished jobs and assume no future arrivals until the next event.",
    "critical_intervals": "Among prefixes sorted by (deadline,job_id), maximize prefix remaining work divided by endpoint minus current time; density ties choose the earliest endpoint.",
    "dispatch": "Run each critical prefix by earliest deadline, breaking equal-deadline ties by original job ID.",
    "segment_order": "Stop a plan at the next release; omit idle intervals and merge adjacent equal reduced speeds.",
    "energy": "Integrate speed^3 exactly and reduce the rational sum.",
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
