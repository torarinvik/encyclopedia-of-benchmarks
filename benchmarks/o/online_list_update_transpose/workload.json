  "algorithm": "online_list_update_transpose",
  "function_symbol": "online_list_update_transpose",
  "abi": "i64_array_bytes_output",
  "description": "Transpose online list update with a paid adjacent exchange after every non-front access.",
  "source": {
    "title": "Online List Update",
    "authors": ["Shahin Kamali"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_266",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_266",
    "algorithm_attribution": "Transpose (Trans): after accessing an item, exchange it with its immediate predecessor if it is not at the front.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,request_count,initial_order[n],request_ids[request_count]]",
    "item_count_range": [1, 8],
    "request_count_range": [0, 32],
    "item_id_range": "0..n-1",
    "initial_order_requirement": "permutation of all item IDs",
    "maximum_valid_length": 42,
    "maximum_parseable_length": 42,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_vector",
    "encoding": "little-endian signed 64-bit words [total_cost,final_order[n],pre_swap_access_positions[request_count]]",
    "maximum_bytes": 328,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded list, request-position trace, and staged output."
  },
  "contract": {
    "access_cost": "The item's 1-based position immediately before it is accessed.",
    "update": "If the accessed item is not first, swap it with its immediate predecessor and add one paid adjacent-exchange cost; a front access causes no exchange.",
    "trace": "Record each access position before its possible swap.",
    "total_cost": "Sum of all access-position costs plus one for each paid adjacent exchange."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary oracle replays the list by search and adjacent swap. The independent verifier maintains an inverse position map and updates the two affected positions after each swap.",
