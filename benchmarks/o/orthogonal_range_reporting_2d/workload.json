  "schema_version": 1,
  "id": "encyclopedia-2d-orthogonal-range-reporting-range-tree-i64-array-bytes-output-v1",
  "algorithm": "orthogonal_range_reporting_2d",
  "function_symbol": "orthogonal_range_reporting_2d",
  "abi": "i64_array_bytes_output",
  "description": "Build a bounded 2D range tree and report IDs of points in closed rectangles.",
  "source": {
    "title": "Orthogonal Range Searching on Discrete Grids",
    "authors": [
      "Yakov Nekrich"
    ],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_631",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_631",
    "algorithm_attribution": "Two-dimensional orthogonal range reporting with a primary x-order and secondary y-ordered catalogs",
    "implementation_status": "clean-room bounded static range-tree profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[point_count, query_count, x0,y0,...,xN-1,yN-1, x_low,x_high,y_low,y_high for each query]",
    "point_count_range": [
      1,
      8
    ],
    "query_count_range": [
      1,
      8
    ],
    "coordinate_range": [
      0,
      15
    ],
    "query_bounds": "Closed inclusive intervals; each low bound must be no greater than its high bound.",
    "points": "Coordinates must be unique.",
    "maximum_valid_length": 50,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_bytes",
    "encoding": "[query_count, hit_count_0, point_id_0,..., hit_count_1,...]; IDs are ascending within each query",
    "maximum_bytes": 584,
    "success_result": "8 bytes times encoded word count",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "contract": {
    "data_structure": "A balanced segment tree over x-sorted point ranks; each node stores its point IDs sorted by (y,id).",
    "query": "Decompose the x-rank interval into canonical nodes, binary-search each node's y catalog for the closed interval, then sort reported IDs.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "A 16-node segment tree with at most eight point IDs per node, sort/query arrays, and staged output."
  },
