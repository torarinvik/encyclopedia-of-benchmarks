{
  "schema_version": 1,
  "id": "ohms-law-python-binary64-v1",
  "algorithm": "ohms_law",
  "function_symbol": "ohms_law",
  "input": {
    "kind": "bounded_integer_valued_ohms_law_triple",
    "argument_order": ["voltage_V", "current_A", "resistance_ohms"],
    "voltage_range": [-1000, 1000],
    "current_range": [-1000, 1000],
    "resistance_range": [0, 1000],
    "exactly_one_zero_required": true,
    "integer_valued_required": true,
    "invalid_result": -1e300,
    "branch_formulas": {
      "voltage_zero": "current * resistance",
      "current_zero": "voltage / resistance",
      "resistance_zero": "voltage / current"
    },
    "normalized_input_subset": "Voltage and current are integer-valued in [-1000,1000], resistance is integer-valued in [0,1000], and exactly one input is zero."
  },
  "output": {
    "kind": "binary64",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "invalid_result": -1e300
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
  "cases": [
    {"id":"solve-voltage","input_values":[0.0,2.0,5.0],"expected_result":10.0},
    {"id":"solve-current","input_values":[10.0,0.0,5.0],"expected_result":2.0},
    {"id":"solve-resistance","input_values":[-10.0,2.0,0.0],"expected_result":-5.0},
    {"id":"negative-current","input_values":[0.0,-2.0,5.0],"expected_result":-10.0},
    {"id":"zero-voltage","input_values":[0.0,2.0,0.0],"expected_result":-1e300},
    {"id":"no-zero","input_values":[2.0,3.0,6.0],"expected_result":-1e300},
    {"id":"two-zeros","input_values":[0.0,0.0,5.0],"expected_result":-1e300},
    {"id":"all-zero","input_values":[0.0,0.0,0.0],"expected_result":-1e300},
    {"id":"negative-resistance","input_values":[0.0,2.0,-5.0],"expected_result":-1e300},
    {"id":"fractional-value","input_values":[0.0,0.5,4.0],"expected_result":-1e300},
    {"id":"out-of-range-voltage","input_values":[1001.0,0.0,5.0],"expected_result":-1e300}
  ]
}
