{
  "schema_version": 1,
  "id": "minimum-regret-stable-marriage-complete-preferences-i64-pairs-v1",
  "algorithm": "optimal_stable_marriage",
  "function_symbol": "optimal_stable_marriage",
  "abi": "i64_array_bytes_output",
  "description": "Find a stable complete matching minimizing the worst preference rank.",
  "source": {
    "title": "Optimal Stable Marriage",
    "authors": ["Robert W. Irving"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_271",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_271",
    "algorithm_attribution": "Minimum-regret stable matching objective, attributed in the chapter to Gusfield",
    "implementation_status": "clean-room bounded complete-list profile using rank-threshold feasibility"
  },
  "contract": {
    "objective": "minimize the maximum zero-based preference rank of any participant among all stable complete matchings",
    "tie_break": "men-optimal stable matching among all matchings attaining the minimum regret",
    "algorithm": "for increasing rank threshold, retain only pairs acceptable within the threshold to both participants and run men-proposing deferred acceptance; use the first threshold with a perfect result",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, men_preferences[n*n], women_preferences[n*n]]",
    "n_range": [0, 8],
    "preference_rows": "Each of the 2*n rows is a permutation of IDs 0..n-1.",
    "length_formula": "1+2*n*n",
    "maximum_valid_length": 129,
    "maximum_input_length": 129,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_bytes",
    "encoding": "[man_id,woman_id,...] in ascending man ID",
    "maximum_bytes": 128,
    "success_result": "16*n",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded preference-rank tables, partner arrays, and proposal queue for n<=8."
  },
