    {"id":"remove-after-observing-add", "input_values":[9,0,0,3,0,3,1,0,0,1,1,3,0,2,0,3,0,3,0,0,1,2,0,3,0,2,1,3,0,4,0,0,1,4,1,0,0], "input_length":37, "expected_result":1},
    {"id":"fresh-tag-allows-readd", "input_values":[5,0,0,2,0,1,0,2,0,0,0,2,0,2,0,2,0,4,0,0,1,4,1,0,0], "input_length":21, "expected_result":5},
    {"id":"remove-every-observed-tag", "input_values":[7,0,0,4,0,0,0,4,0,3,1,0,0,1,1,4,0,2,1,4,0,4,0,0,1,4,1,0,0], "input_length":29, "expected_result":2},
