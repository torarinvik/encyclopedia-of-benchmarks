{
  "schema_version": 1,
  "id": "observed-remove-set-two-replica-i64-array-scalar-v1",
  "algorithm": "observed_remove_set",
  "function_symbol": "observed_remove_set",
  "abi": "i64_array_scalar",
  "description": "Two-replica add-wins observed-remove set with deterministic unique tags.",
  "source": {
    "repository": "TheAlgorithms/Java",
    "path": "src/main/java/com/thealgorithms/datastructures/crdt/ORSet.java",
    "url": "https://github.com/TheAlgorithms/Java/blob/master/src/main/java/com/thealgorithms/datastructures/crdt/ORSet.java",
    "license": "MIT",
    "reuse": "Algorithm semantics only; deterministic tags and all benchmark code and fixtures are independently authored."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[q,(opcode,replica,element_or_zero,peer_replica)*q]",
    "operation_count_range": [0, 32],
    "replica_range": [0, 1],
    "element_range": [0, 15],
    "opcode_meaning": {
      "0": "add a fresh uniquely tagged occurrence on replica",
      "1": "remove every currently observed live tag for element on replica",
      "2": "query membership of element on replica",
      "3": "merge peer state into replica by unioning add and removal-tag sets",
      "4": "test whether replica state is componentwise contained in peer state"
    },
    "exact_length": "1+4*q",
    "maximum_valid_length": 129,
    "maximum_parseable_length": 129,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "one result bit for each contains/compare operation in trace order; bit is one for true",
    "maximum_result": 4294967295,
    "invalid_input_result": -1
  },
  "contract": {
    "tag_identity": "(element, creator_replica, creator_local_add_sequence), with each sequence starting at zero",
    "state": "each replica stores the set of observed add tags and the set of observed removed tags",
    "add": "creates a fresh tag even when the same element already has a live tag",
    "remove": "tombstones only tags currently observed for the specified element; unseen concurrent tags remain live after merge",
    "merge": "unions the observed-add and removed-tag sets and leaves the source replica unchanged",
    "membership": "true iff at least one observed tag for the element is absent from the replica's removed-tag set",
    "compare": "true iff both the receiver's add-tag set and removed-tag set are subsets of the peer's corresponding sets",
    "null_input_result": -1
  },
  "complexity": {
    "per_operation": "at most 64 tag slots scanned",
    "space": "O(64) fixed bounded state for two replicas and their tags"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
