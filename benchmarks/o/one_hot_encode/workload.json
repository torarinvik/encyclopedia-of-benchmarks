{
  "schema_version": 1,
  "id": "one-hot-single-character-category-column-v1",
  "algorithm": "one_hot_encode",
  "function_symbol": "one_hot_encode",
  "input": {
    "kind": "count_then_category_codes",
    "layout": "[row_count, category_code0, ...]",
    "row_count_range": [
      1,
      32
    ],
    "category_code_range": [
      0,
      25
    ],
    "category_mapping": "codes map to one-character category labels A through Z; columns are observed levels in ascending label order",
    "maximum_input_values": 33
  },
  "output": {
    "kind": "row_major_binary_u8_matrix",
    "return_value": "bytes written",
    "dimensions": "row_count by number of observed categories",
    "maximum_output_bytes": 832,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "ordered_levels",
      "input_values": [
        5,
        2,
        0,
        1,
        2,
        0
      ],
      "expected_result": 15,
      "expected_output_hex": "000001010000000100000001010000"
    },
    {
      "id": "source_categorical_subset",
      "input_values": [
        7,
        3,
        1,
        3,
        0,
        1,
        2,
        3
      ],
      "expected_result": 28,
      "expected_output_hex": "00000001000100000000000101000000000100000000010000000001"
    },
    {
      "id": "single_level",
      "input_values": [
        4,
        5,
        5,
        5,
        5
      ],
      "expected_result": 4,
      "expected_output_hex": "01010101"
    },
    {
      "id": "single_row",
      "input_values": [
        1,
        25
      ],
      "expected_result": 1,
      "expected_output_hex": "01"
    }
  ]
}
