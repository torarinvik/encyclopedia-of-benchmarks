  "abi": "i64_array_scalar",
  "description": "Dynamic set updates with one-based selection, prefix count, predecessor, and successor queries using a size-augmented AVL tree.",
  "source": {
    "title": "Library Checker ordered_set task",
    "authors": ["Library Checker contributors"],
    "urls": ["https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/ordered_set/task.md"],
