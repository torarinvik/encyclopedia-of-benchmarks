  },
  "contract": {
    "operation": "Perform one red phase followed by one black phase over the interior of a square 2-D grid.",
    "input_encoding": "[side,eigenvalue_squared,spacing,grid_row_major...,rhs_row_major...]",
    "side_values": [4, 6, 8],
    "grid_includes_one_cell_boundary": true,
    "eigenvalue_squared_range": [0, 2],
    "spacing_range": [0.125, 1],
    "grid_and_rhs_component_range": [-8, 8],
    "update_factor": "4 - eigenvalue_squared*spacing*spacing",
    "update": "(north+south+west+east-rhs)/update_factor",
    "red_color": "(row+column) mod 2 == 0",
    "black_color": "(row+column) mod 2 == 1; evaluated after all red points",
    "boundary_behavior": "Boundary values are copied unchanged.",
    "output_encoding": "[maximum_absolute_update,final_grid_row_major...]",
    "output_length": "1+side*side",
    "success_result": "1+side*side",
    "invalid_result": -1,
    "output_error_result": -2,
    "error_metric": "Maximum absolute difference between old and new values over both color phases."
  },
  "input": {
    "kind": "finite_float64_array",
    "minimum_parseable_length": 3,
    "maximum_valid_length": 131,
