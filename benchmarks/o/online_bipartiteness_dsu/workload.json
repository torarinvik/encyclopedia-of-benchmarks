{
  "schema_version": 1,
  "id": "online-bipartiteness-dsu-i64-array-scalar-v1",
  "algorithm": "online_bipartiteness_dsu",
  "function_symbol": "online_bipartiteness_dsu",
  "abi": "i64_array_scalar",
  "source": {
    "title": "Disjoint Set Union: Support parity / Checking bipartiteness online",
    "url": "https://cp-algorithms.com/data_structures/disjoint_set_union.html",
    "license": "CC BY-SA 4.0",
    "reuse": "algorithm description only; clean-room bounded profile"
  },
  "input": {
    "encoding": "[n,q,(opcode,first,second)*q]",
    "n_range": [1,32], "q_range": [0,64],
    "opcode_0": "add undirected edge (first,second)",
    "opcode_1": "query whether first's current connected component is bipartite; second must be zero",
    "maximum_valid_length": 194, "maximum_parseable_length": 195,
    "invalid_result": -1
  },
  "output": {
    "encoding": "weighted checksum of query answers; sum((query_ordinal+1)*(answer+1)), answer 1 for bipartite and 0 otherwise",
    "result_range": "0..4160", "invalid_result": -1
  },
  "method": {
    "description": "DSU parent edges store xor parity; each root stores whether its component has received a same-parity edge contradiction.",
    "time": "O((n+q) alpha(n))",
    "auxiliary_space": "O(n+q)"
  },
  "workspace": {"bytes": 1024},
  "measurement": {"comparison_model": "i64_array_scalar_call", "sample_count": 7, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "cases": [
    {"id":"empty-trace","input_values":[3,0],"expected_result":0},
