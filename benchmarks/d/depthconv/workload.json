  "id": "embench-depthconv-i64-array-bytes-output-v1",
  "algorithm": "depthconv",
  "function_symbol": "depthconv",
  "description": "Bounded per-channel quantized int8 depthwise convolution using the pinned Embench/TensorFlow Lite Micro kernel contract.",
  "pinned_source": {
    "repository": "embench/embench-iot",
    "commit": "09c2ed8c3b7008c95d08b038de4a3f6dc103ed70",
    "path": "src/depthconv/depthconv.c",
    "symbol": "DepthwiseConvPerChannel",
