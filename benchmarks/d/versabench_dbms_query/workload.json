  "contract": {
    "input_layout": "[node_count, root_id, query_lower_T_X_Y_Z, query_upper_T_X_Y_Z, node records]; node=[level,entry_count, entries]; entry=[lower_T_X_Y_Z,upper_T_X_Y_Z,ref]",
    "node_count_range": [1, 7],
    "level_range": [0, 2],
    "entries_per_node_range": [1, 4],
    "coordinate_range": [-8, 8],
    "record_id_range": [0, 31],
    "max_leaf_records": 16,
    "tree_rules": "root has no parent; every other node has exactly one parent; branch references descend exactly one level; each branch key encloses all immediate child entry keys; leaf record IDs are unique",
    "intersection": "closed intervals; touching boundaries intersect",
    "output": "matching leaf record IDs in depth-first node-entry order, each signed i64 little-endian",
    "maximum_valid_input_words": 276,
    "maximum_parseable_input_words": 277,
    "maximum_output_bytes": 128,
    "invalid_result": -1,
    "output_error_result": -2
  },
  "profile": {
    "query_filter": "key intersection only; non-key search list is empty",
    "traversal": "visit child nodes in entry order only when their branch key intersects the query; at leaves emit intersecting data entries in list order",
    "scope": "bounded R-tree query traversal; no database I/O, non-key filtering, or result formatting"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
