{
  "schema_version": 1,
  "id": "decimal-expansion-byte-record-v1",
  "algorithm": "decimal_expansion",
  "function_symbol": "decimal_expansion",
  "input": {
    "kind": "signed_i64_integer_array",
    "encoding": "[numerator, denominator, base]",
    "numerator_range": [0, 256],
    "denominator_range": [1, 256],
    "numerator_at_most_denominator": true,
    "base_range": [2, 10],
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_i64_header_then_radix_digits",
    "header": ["integer_part", "digit_count", "cycle_start_or_minus_one"],
    "digit_encoding": "one byte per digit, each in [0, base)",
    "valid_result": "total output bytes",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"zero_numerator","input_values":[0,7,10],"expected_result":24,"expected_output_hex":"00000000000000000000000000000000ffffffffffffffff"},
    {"id":"one_over_one","input_values":[1,1,10],"expected_result":24,"expected_output_hex":"01000000000000000000000000000000ffffffffffffffff"},
    {"id":"terminating_decimal","input_values":[1,8,10],"expected_result":27,"expected_output_hex":"00000000000000000300000000000000ffffffffffffffff010205"},
    {"id":"repeating_decimal_from_zero","input_values":[1,3,10],"expected_result":25,"expected_output_hex":"00000000000000000100000000000000000000000000000003"},
    {"id":"repeating_cycle_after_prefix","input_values":[1,6,10],"expected_result":26,"expected_output_hex":"0000000000000000020000000000000001000000000000000106"},
    {"id":"repeating_binary","input_values":[1,3,2],"expected_result":26,"expected_output_hex":"0000000000000000020000000000000000000000000000000001"},
    {"id":"terminating_binary","input_values":[3,8,2],"expected_result":27,"expected_output_hex":"00000000000000000300000000000000ffffffffffffffff000101"},
    {"id":"invalid_zero_denominator","input_values":[0,0,10],"expected_result":-1,"expected_output_hex":""},
    {"id":"improper_fraction","input_values":[2,1,10],"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid_base","input_values":[1,3,11],"expected_result":-1,"expected_output_hex":""},
    {"id":"negative_numerator","input_values":[-1,3,10],"expected_result":-1,"expected_output_hex":""},
    {"id":"short_input","input_values":[1,3],"expected_result":-1,"expected_output_hex":""},
    {"id":"extra_input","input_values":[1,3,10,0],"expected_result":-1,"expected_output_hex":""},
    {"id":"short_output_capacity","input_values":[1,8,10],"workspace_bytes":26,"capacity_error_result":-2,"expected_result":-2,"expected_output_hex":""}
  ]
}
