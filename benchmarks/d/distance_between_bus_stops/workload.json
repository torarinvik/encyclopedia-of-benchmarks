{
  "id": "distance-between-bus-stops-v1",
  "algorithm": "distance_between_bus_stops",
  "contract": {
    "input": "Packed signed 64-bit values [start_index, destination_index, distance_0, ..., distance_n_minus_1], with 1..64 stops and each distance in 0..1000000.",
    "output": "The smaller sum of distances along the two routes around the circle.",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty-input",
      "input_values": [],
      "input_length": 0,
      "expected_result": -1
    },
    {
      "id": "one-field",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": -1
    },
    {
      "id": "missing-distance-array",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": -1
    },
    {
      "id": "single-stop",
      "input_values": [
        0,
        0,
        9
      ],
      "input_length": 3,
      "expected_result": 0
    },
    {
      "id": "same-stop",
      "input_values": [
        1,
        1,
        5,
        8,
        2,
        9
      ],
      "input_length": 6,
      "expected_result": 0
    },
    {
      "id": "adjacent-stops",
      "input_values": [
        0,
        1,
        1,
        2,
        3,
        4
      ],
      "input_length": 6,
      "expected_result": 1
