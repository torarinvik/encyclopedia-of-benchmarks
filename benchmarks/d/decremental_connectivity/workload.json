{
  "schema_version": 1,
  "id": "decremental-connectivity-forest-trace-i64-v1",
  "algorithm": "decremental_connectivity",
  "input": {
    "kind": "i64_array",
    "encoding": "[n, m, edge_u_0, edge_v_0, ..., q, op_0, u_0, v_0, ...]",
    "vertex_range": "1..32",
    "edge_count_range": "0..n-1",
    "operation_count_range": "0..128",
    "operation_codes": {
      "0": "delete an existing undirected edge",
      "1": "query whether two vertices are connected"
    },
    "invalid_result": -1,
    "result": "signed i64 view of FNV-1a-64 over query answers, one byte per answer (0 or 1)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
