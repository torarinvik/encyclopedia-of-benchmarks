    {"id":"balanced-proposal-two-categories","input_values":[2,2,2,1,1,1,1,0,0,1,0],"input_length":11,"output_capacity":128,"expected_result":32,"expected_output_hex":"0000000000000000010000000000000001000000000000000100000000000000"},
    {"id":"skewed-proposal-reject-then-accept","input_values":[2,1,2,3,1,1,3,2,500000000,0,4294967295],"input_length":11,"output_capacity":128,"expected_result":16,"expected_output_hex":"00000000000000000200000000000000"},
