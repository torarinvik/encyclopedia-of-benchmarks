{
  "schema_version": 1,
  "id": "algorithm-archive-discrete-rejection-sampling-i64-array-bytes-output-v1",
  "algorithm": "discrete_rejection_sampling",
  "function_symbol": "discrete_rejection_sampling",
  "abi": "i64_array_bytes_output",
  "description": "Generate a bounded number of samples from a finite integer-weight target by rejection sampling from a supplied proposal distribution and deterministic draw tape.",
  "source": {
    "archive_topic": "Algorithm Archive: rejection-sampling cost analysis",
    "algorithm_reference": "https://www.algorithm-archive.org/contents/box_muller/box_muller_rejection.html",
    "textbook": "Luc Devroye, Non-Uniform Random Variate Generation, Chapter II section 3, 1986",
    "textbook_doi": "10.1007/978-1-4613-8643-8_2",
    "textbook_url": "https://doi.org/10.1007/978-1-4613-8643-8_2",
    "implementation_status": "clean-room bounded profile; algorithm description only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[category_count, samples_wanted, attempt_cap, target_weights..., proposal_weights..., (proposal_draw, acceptance_draw)*attempt_cap]",
    "category_count_range": [1, 8],
    "samples_wanted_range": [1, 8],
    "attempt_cap_range": [1, 32],
    "weight_range": [1, 20],
    "proposal_draw_range": "0 <= draw < sum(proposal_weights)",
    "acceptance_draw_range": "0 <= draw < 2^32; draw represents draw/2^32",
    "exact_length": "3 + 2*category_count + 2*attempt_cap",
    "maximum_valid_input_length": 83,
    "maximum_parseable_input_length": 83,
    "invalid_input_result": -1,
    "null_input_result": -1,
    "exhausted_attempt_tape_result": -3
  },
  "algorithm": {
    "target_probability": "p[i] = target_weights[i] / W, where W is the sum of target weights",
    "proposal_probability": "q[i] = proposal_weights[i] / Q, where Q is the sum of proposal weights",
    "envelope": "M = max_i ceil(target_weights[i]*Q / (W*proposal_weights[i]))",
    "proposal_step": "Choose the first category whose cumulative proposal weight exceeds proposal_draw.",
    "acceptance_step": "Accept category i iff acceptance_draw * W * proposal_weights[i] * M < 2^32 * target_weights[i] * Q.",
    "tape_consumption": "Each attempt consumes exactly one proposal draw and one acceptance draw. Stop after samples_wanted acceptances or attempt_cap attempts; unused suffix records are ignored.",
    "exhaustion": "If the cap is reached before enough samples are accepted, return -3 and write no output."
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "For each accepted sample in order, emit its zero-based category index followed by the number of attempts since the preceding accepted sample (or start).",
    "maximum_output_bytes": 128,
    "success_result": "16 * samples_wanted bytes",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded category weight/cumulative tables, output staging, and scalar rejection state."
  },
  "complexity": {
    "time": "O(category_count * attempt_cap)",
    "working_storage": "O(category_count + samples_wanted)"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Primary recomputes the integer envelope and tests each attempt by cross multiplication. Independent oracle builds exact Fraction-derived integer acceptance thresholds and uses cumulative-weight binary search.",
  "cases": [
