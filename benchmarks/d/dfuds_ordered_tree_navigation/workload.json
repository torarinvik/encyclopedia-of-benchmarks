  "abi": "i64_array_bytes_output",
  "source": {
    "title": "Compressed Tree Representations",
    "book_chapter_doi": "10.1007/978-1-4939-2864-4_641",
    "subsection": "DFUDS",
    "algorithm_attribution": "Depth-first unary degree coding with a dummy opening bit and balanced-parenthesis degree/child/parent mappings",
    "reuse": "algorithm description only; clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,parent[1..n-1],(opcode,node,argument)*q]",
    "node_count_range": [1, 31],
    "query_count_range": [0, 32],
    "maximum_valid_length": 128,
    "maximum_parseable_length": 129,
    "node_ids": "zero-based depth-first preorder ordinals",
    "opcodes": {
      "0": "degree; argument must be 0",
      "1": "child at zero-based rank argument; absent ranks return -1",
      "2": "parent; argument must be 0; root parent returns -1"
    },
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[n,bit_length,packed_dfuds_bits,q,answers...]",
    "packed_bit_order": "bit j of the DFUDS sequence is bit j of the packed word, least-significant bit first",
    "maximum_bytes": 288,
    "output_untouched_on_error": true,
    "null_or_short_output_result": -2
  },
  "contract": {
    "tree": "Vertex 0 is root; each later vertex has a smaller-ID parent; sibling order follows input ID.",
    "encoding": "Emit a dummy one bit, then for each node in depth-first preorder emit degree one-bits followed by one zero. The total length is 2*n.",
    "navigation": "Degree is the distance to the next zero from the unary descriptor start; child uses findclose(i+degree(i)-(rank+1))+1; parent uses prev_0(findopen(i-1))+1. Descriptor bit positions map back to preorder IDs.",
    "complexity": "O(n^2+q*n) bounded scans for n<=31 and q<=32; O(n+q) fixed workspace.",
    "distinctness": "DFUDS is a depth-first unary degree representation, distinct from breadth-first LOUDS and BP open/close tree encoding. Parenthesis successor/rank-unrank packages do not provide DFUDS ordered-tree navigation."
  },
  "workspace": {"bytes": 4096},
  "measurement": {"comparison_model": "i64_array_bytes_output_call"},
