      "expected_output_hex": "0400000000000000000000000000000001000000000000000400000000000000ffffffffffffffff0a00000000000000050000000000000002000000000000000100000000000000"
    },
    {
      "id": "all-neighbors-prisoners",
      "input_values": [3, 2, 0, 0, 1, 0, 2],
      "input_length": 7,
      "expected_result": 40,
      "expected_output_hex": "02000000000000000000000000000000ffffffffffffffff02000000000000000100000000000000"
    },
    {
      "id": "not-applicable-empty-prisoner-set",
      "input_values": [3, 2, 0, 0, 1, 1, 2],
      "input_length": 7,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-duplicate-edge",
      "input_values": [3, 3, 0, 0, 1, 0, 1, 0, 2],
      "input_length": 9,
