    {"id":"nested-character-sets","input_values":[3,2,1,1,1,0,0,0],"input_length":8,"expected_result":8,"expected_output_hex":"0100000000000000"},
    {"id":"disjoint-character-sets","input_values":[3,2,1,0,0,1,0,0],"input_length":8,"expected_result":8,"expected_output_hex":"0100000000000000"},
    {"id":"crossing-character-sets","input_values":[3,2,1,1,1,0,0,1],"input_length":8,"expected_result":8,"expected_output_hex":"0000000000000000"},
    {"id":"duplicate-character-sets","input_values":[3,2,1,1,0,0,1,1],"input_length":8,"expected_result":8,"expected_output_hex":"0100000000000000"},
    {"id":"invalid-matrix-value","input_values":[2,2,1,0,1,2],"input_length":6,"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid-frame-shape","input_values":[2,2,1,0,0],"input_length":5,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-or-short-output","input_values":[2,2,1,0,1,0],"input_length":6,"expected_result":-2,"expected_output_hex":"","workspace_bytes":7,"capacity_error_result":-2}
  ]
}
