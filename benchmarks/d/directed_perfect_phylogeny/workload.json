  "comparison_model":"i64_array_bytes_output_call",
  "input":{"kind":"signed_i64_array","layout":"[taxa_count,character_count,row_major_binary_matrix]","taxa_range":[1,12],"character_range":[1,12],"cell_values":[0,1],"maximum_valid_length":146,"maximum_parseable_length":147,"invalid_result":-1},
  "output":{"kind":"little_endian_i64_array","layout":"[feasible_flag]","flag_values":[0,1],"maximum_output_elements":1,"maximum_output_bytes":8,"success_result":8,"invalid_result":-1,"insufficient_output_capacity_result":-2,"null_output_when_nonempty_result":-2},
  "workspace":{"bytes":256,"meaning":"Twelve character taxon masks for pairwise compatibility checks."},
  "measurement":{"sample_count":7,"warmup_rounds":2,"repetitions_per_sample":1000},
  "cases":[
