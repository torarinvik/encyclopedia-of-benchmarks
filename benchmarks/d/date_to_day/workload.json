{
  "schema_version": 1,
  "id": "date-to-day-javascript-gregorian-weekday-v1",
  "algorithm": "date_to_day",
  "function_symbol": "date_to_day",
  "input": {
    "encoding": "signed_i64_array",
    "layout": [
      "ASCII date bytes",
      0
    ],
    "date_format": "d/m/yyyy or dd/mm/yyyy",
    "day_digit_count_range": [
      1,
      2
    ],
    "month_digit_count_range": [
      1,
      2
    ],
    "year_digit_count": 4,
    "year_range": [
      1,
      9999
    ],
    "valid_gregorian_calendar_dates_only": true,
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "kind": "byte_array",
    "contents": "weekday name in English ASCII",
    "length": "6 through 9 bytes"
  },
  "workspace": {
    "bytes": 9,
    "reason": "The longest weekday name, Wednesday, is nine ASCII bytes."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
