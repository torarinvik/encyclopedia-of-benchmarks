    "short_capacity_writes_nothing": true,
    "absolute_tolerance": 1e-10,
    "relative_tolerance": 1e-10
  },
  "contract": {
    "training": "Train a fresh tree for each call using the supplied rows in their input order; the demo data and printing are excluded.",
    "stopping": "Create a leaf for a single unique label, when row count is below min_samples_split, when current_depth >= max_depth, when there are no features, or when no positive entropy gain exists.",
    "split_search": "For each feature in index order, sort by that feature and consider the midpoint between every adjacent pair of distinct values. Use base-2 label entropy and retain only strict gain improvements, preserving the first feature/threshold on ties. Keep all features eligible in child nodes.",
    "split_rule": "Values less than the threshold go left; values greater than or equal to it go right.",
    "leaf_prediction": "Choose the most frequent label; if counts tie, choose the label first encountered in the node's input order.",
    "errors": "Malformed framing, unsupported parameters, non-finite values, labels outside {0,1,2}, or feature values outside the quarter-step domain return -1. Null output and insufficient capacity return -2 without writes."
  },
