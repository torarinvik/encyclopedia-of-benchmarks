{
  "schema_version": 1,
  "id": "disjoint-sparse-table-affine-composition-byte-output-v1",
  "algorithm": "disjoint_sparse_table_affine_composition",
  "function_symbol": "disjoint_sparse_table_affine_composition",
  "abi": "i64_array_bytes_output",
  "description": "Answer static inclusive range queries for ordered affine-map composition using a disjoint sparse table.",
  "source": {
    "title": "Sparse Table / Cat Tree",
    "authors": ["CP-Algorithms contributors", "OI Wiki contributors"],
    "urls": ["https://cp-algorithms.com/data_structures/sparse-table.html", "https://oiwiki.net/ds/cat-tree/"],
    "license_note": "Only high-level algorithm descriptions are used; code, contract, and fixtures are clean-room."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,(a,b)*N,(left,right)*Q]",
    "map": "f(x)=a*x+b modulo 1,000,000,007; apply maps in increasing index order",
    "array_length_range": [1, 32],
    "query_count_range": [1, 32],
    "coefficient_range": [0, 1000000006],
    "query_rule": "0 <= left <= right < N, inclusive",
    "exact_length": "2 + 2*N + 2*Q",
    "maximum_valid_length": 130,
    "maximum_parseable_length": 130,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "(A,B) for each query, where the range composition is A*x+B modulo 1,000,000,007",
    "maximum_output_bytes": 512,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Maximum output-buffer capacity for 32 affine query-result pairs."
  },
  "algorithm_details": {
    "primary": "Precompute disjoint suffix and prefix folds around each power-of-two midpoint; select a query level by the highest set bit of left XOR right and combine its two ordered folds.",
    "independent_oracle": "For each range, directly apply every map to x=0 and x=1, then recover B=F(0) and A=F(1)-F(0) modulo the field.",
    "complexity": "O(N log N) preprocessing and O(1) combines per query; direct oracle work is O(sum of queried range lengths)."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
