{
  "schema_version": 1,
  "id": "dynamic-array-common-operation-trace-v1",
  "algorithm": "dynamic_array",
  "function_symbol": "dynamic_array",
  "description": "Run bounded append, update, read, and size operations over a capacity-doubling signed 64-bit array.",
  "input": {
    "kind": "packed_signed_i64_operation_trace",
    "encoding": "[operation_count, operation_records...]",
    "maximum_operations": 128,
    "maximum_elements": 64,
    "initial_capacity": 16,
    "opcodes": {
      "0": "[0, value] append",
      "1": "[1, existing_index, value] update",
      "2": "[2, existing_index] get and record query result",
      "3": "[3] record current size"
    },
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_words",
    "encoding": "[query_count, query_results..., final_size, final_values...]",
    "success_result": "number of output words"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_trace",
      "input_values": [
