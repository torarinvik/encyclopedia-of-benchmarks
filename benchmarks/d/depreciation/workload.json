{
  "schema_version": 1,
  "id": "depreciation-rust-i64-array-f64-vector-v1",
  "algorithm": "depreciation",
  "function_symbol": "depreciation",
  "input": {
    "kind": "signed_i64_array",
    "layout": "method-specific; see README",
    "maximum_input_length": 20,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_vector",
    "encoding": "little-endian IEEE-754 binary64",
    "meaning": "annual depreciation expenses in schedule order",
    "maximum_length": 16,
    "maximum_output_bytes": 128,
    "absolute_tolerance": 1e-09,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 128,
    "meaning": "maximum output capacity"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "straight-line-even-cost",
      "input_values": [
        0,
        5,
        100000000,
        10000000
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": 40,
      "expected_output": [
        18.0,
        18.0,
        18.0,
        18.0,
        18.0
      ],
      "note": "Valid evenly distributed depreciable cost."
    },
    {
      "id": "straight-line-fractional",
      "input_values": [
        0,
        3,
        10000000,
        1000000
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": 24,
      "expected_output": [
        3.0,
        3.0,
        3.0
      ],
      "note": "Last period absorbs the source accumulation remainder."
    },
    {
      "id": "diminishing-balance-half-rate",
      "input_values": [
        1,
        3,
        100000000,
        10000000,
        500000
      ],
      "input_length": 5,
      "workspace_bytes": 128,
      "expected_result": 24,
      "expected_output": [
        50.0,
        25.0,
        15.0
      ],
      "note": "Rate is represented in parts per million."
    },
    {
      "id": "diminishing-balance-full-rate",
      "input_values": [
        1,
        4,
        100000000,
        10000000,
        1000000
      ],
      "input_length": 5,
      "workspace_bytes": 128,
      "expected_result": 32,
      "expected_output": [
        90.0,
        0.0,
        0.0,
        0.0
      ],
      "note": "Expenses stop at residual value before the final write-off."
    },
    {
      "id": "units-of-production",
      "input_values": [
        2,
        1000000000,
        100000000,
        100,
        30,
        25,
        25,
        20
      ],
      "input_length": 8,
      "workspace_bytes": 128,
      "expected_result": 32,
      "expected_output": [
        270.0,
        225.0,
        225.0,
        180.0
      ],
      "note": "Unit estimates sum to total units."
    },
    {
      "id": "units-tolerance-boundary",
      "input_values": [
        2,
        100000000,
        0,
        1000000,
        499999,
        500000
      ],
      "input_length": 6,
      "workspace_bytes": 128,
      "expected_result": 16,
      "expected_output": [
        49.999900000000004,
        50.000099999999996
      ],
      "note": "A one-unit mismatch is accepted at the source relative-tolerance boundary."
    },
    {
      "id": "units-preserve-negative-period",
      "input_values": [
        2,
        100000000,
        0,
        100,
        -5,
        105
      ],
      "input_length": 6,
      "workspace_bytes": 128,
      "expected_result": 16,
      "expected_output": [
        -5.0,
        105.0
      ],
      "note": "The Rust source accepts signed period estimates when the total matches."
    },
    {
      "id": "sum-of-years-digits",
      "input_values": [
        3,
        5,
        100000000,
        10000000
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": 40,
      "expected_output": [
        30.0,
        24.0,
        18.0,
        12.0,
        6.0
      ],
      "note": "Accelerated schedule from the source year weights."
    },
    {
      "id": "ddb-switch-to-straight-line",
      "input_values": [
        4,
        5,
        10000000000,
        0
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": 40,
      "expected_output": [
        4000.0,
        2400.0,
        1440.0,
        1080.0,
        1080.0
      ],
      "note": "A zero residual triggers the source switch when remaining straight-line expense exceeds DDB."
    },
    {
      "id": "single-year",
      "input_values": [
        4,
        1,
        4985000000,
        100000000
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": 8,
      "expected_output": [
        4885.0
      ],
      "note": "One-period schedule equals purchase less residual."
    },
    {
      "id": "invalid-short",
      "input_values": [
        0,
        5,
        100000000
      ],
      "input_length": 3,
      "workspace_bytes": 128,
      "expected_result": -1,
      "expected_output": [],
      "note": "Malformed method layout."
    },
    {
      "id": "invalid-method",
      "input_values": [
        5,
        5,
        100000000,
        0
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": -1,
      "expected_output": [],
      "note": "Unknown method selector."
    },
    {
      "id": "invalid-years-zero",
      "input_values": [
        0,
        0,
        100000000,
        0
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": -1,
      "expected_output": [],
      "note": "Useful years must be positive."
    },
    {
      "id": "invalid-residual-above-purchase",
      "input_values": [
        0,
        5,
        100000000,
        100000001
      ],
      "input_length": 4,
      "workspace_bytes": 128,
      "expected_result": -1,
      "expected_output": [],
      "note": "Purchase value cannot be less than residual value."
    },
    {
      "id": "invalid-zero-rate",
      "input_values": [
        1,
        3,
        100000000,
        0,
        0
      ],
      "input_length": 5,
      "workspace_bytes": 128,
      "expected_result": -1,
      "expected_output": [],
      "note": "Diminishing rate must be greater than zero."
    },
    {
      "id": "invalid-units-mismatch",
      "input_values": [
        2,
        100000000,
        0,
        100,
        40,
        40
      ],
      "input_length": 6,
      "workspace_bytes": 128,
      "expected_result": -1,
      "expected_output": [],
      "note": "Units-of-production estimates do not satisfy the source tolerance."
    },
    {
      "id": "insufficient-capacity",
      "input_values": [
        0,
        5,
        100000000,
        10000000
      ],
      "input_length": 4,
      "workspace_bytes": 39,
      "expected_result": -2,
      "expected_output": [],
      "note": "Valid input requires 40 output bytes."
    }
  ]
}
