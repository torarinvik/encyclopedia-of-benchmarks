{
  "schema_version": "1.0.0",
  "id": "depth-first-search-with-stack-cpp-bounded-graph-v1",
  "algorithm": "depth_first_search_with_stack",
  "function_symbol": "depth_first_search_with_stack",
  "description": "Traverse a directed graph with a LIFO stack, marking vertices when scheduled.",
  "input": {
    "kind": "directed_graph_start_edge_pairs",
    "encoding": "[vertex_count, start_vertex, source_0, destination_0, ...]",
    "maximum_vertices": 64,
    "maximum_edges": 32,
    "vertex_ids": "zero-based",
    "duplicate_edges": "preserved in adjacency insertion order; repeated visits are suppressed by vertex state",
    "edge_order": "preserved for each source vertex; the stack visits later inserted neighbors first",
    "empty_graph": "[0, -1]"
  },
  "output": {
    "kind": "byte_sequence",
    "definition": "The stack-pop order of reachable vertices. A vertex is emitted when first popped while grey; it is then blackened after its outgoing edges are pushed.",
    "invalid_input_result": -2,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
