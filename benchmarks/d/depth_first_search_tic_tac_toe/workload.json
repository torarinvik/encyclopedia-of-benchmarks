{
  "schema_version": 1,
  "id": "depth-first-search-tic-tac-toe-i64-scalar-v1",
  "algorithm": "depth_first_search_tic_tac_toe",
  "function_symbol": "depth_first_search_tic_tac_toe",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[side, board_cell_0, ..., board_cell_8] in row-major order; side 1=X or 2=O; cells 0=blank, 1=X, 2=O",
    "input_length": 10,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "0 if the source returns None for a terminal board; otherwise 1 + 512*score + move_mask, where score is 0=draw, 1=X, 2=O and bit i of the nine-bit mask marks an optimal row-major move",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
