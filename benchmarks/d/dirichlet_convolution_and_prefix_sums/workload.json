    "modulus": 998244353,
    "output_formula": "H(q)=sum_{i*j<=q} f(i)g(j) mod 998244353 for every q in Q_N, ascending",
    "output_encoding": "one little-endian signed 64-bit residue per quotient value",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
