  "abi": "i64_array_scalar",
  "description": "Dinkelbach iteration for exact-cardinality maximum-ratio selection.",
  "source": {
    "primary": "W. Dinkelbach, On Nonlinear Fractional Programming, Management Science 13(7), 1967, pp. 492-498, DOI 10.1287/mnsc.13.7.492",
    "overview_url": "https://oi-wiki.org/misc/frac-programming/",
    "overview_license": "CC BY-SA 4.0 with the source page's SATA notice",
    "reuse": "Algorithmic idea only; independently authored bounded contract and implementations."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,K,(numerator,denominator)*N]",
    "item_count_range": [1, 12],
    "cardinality_range": "1..N",
    "numerator_range": [0, 10000],
    "denominator_range": [1, 10000],
    "exact_length": "2+2*N",
    "maximum_valid_length": 26,
    "maximum_parseable_length": 27,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "reduced_numerator*120001+reduced_denominator for the maximum exact-K ratio",
    "invalid_input_result": -1,
    "maximum_result_bound": 14400240000
  },
  "algorithm_details": {
    "primary": "Dinkelbach iteration selects exactly K items by descending integer residual a_i*q-p*b_i at the current ratio p/q, breaking ties by original index, then updates to the reduced ratio of the selected sums until the residual is zero.",
    "independent_oracle": "Exhaustively enumerate all cardinality-K subsets and compare their exact ratios by cross multiplication.",
    "iteration_bound": "binomial(N,K)+1",
    "primary_complexity": "O(binomial(N,K)*N^2) time and O(N) space; port ranking uses insertion sort.",
    "independent_complexity": "O(binomial(N,K)*N) time and O(N) space."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
