{
  "schema_version": "1.0.0",
  "id": "dsa-verify-bounded-small-prime-v1",
  "algorithm": "dsa_verify",
  "function_symbol": "dsa_verify",
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "description": "Verify a DSA signature in a bounded small-prime subgroup using the pinned Go verification equation.",
  "input": {
    "kind": "dsa_signature_verification",
    "encoding": "[p,q,g,y,r,s,message_length,message_byte_0,...]",
    "max_prime": 251,
    "max_message_bytes": 8,
    "message_byte_order": "big-endian as Go big.Int.SetBytes",
    "subgroup": "q prime, q divides p-1, g has order q, y is in the q-order subgroup",
    "signature": "1 <= r,s < q"
  },
  "output": {
    "kind": "scalar",
    "definition": "1 if Go DSA verification equation yields v == r, otherwise 0; malformed domain returns -1"
  },
  "cases": [
    {
      "id": "valid_small",
      "input_values": [
        7,
        3,
        2,
        2,
        2,
        2,
        2,
        1,
        2
      ],
      "expected_result": 1
    },
    {
      "id": "valid_larger_group",
      "input_values": [
        23,
        11,
        4,
        18,
        4,
        8,
        3,
        1,
        2,
        3
      ],
      "expected_result": 1
    },
    {
      "id": "bad_message",
      "input_values": [
        23,
        11,
        4,
        18,
        4,
        8,
        3,
        1,
        2,
        4
      ],
      "expected_result": 0
    },
    {
      "id": "valid_empty_message",
      "input_values": [
        23,
        11,
        4,
        4,
        2,
        2,
        0
      ],
      "expected_result": 0
    },
    {
      "id": "signature_mismatch",
      "input_values": [
        23,
        11,
        4,
        18,
        5,
        8,
        3,
        1,
        2,
        3
      ],
      "expected_result": 0
    },
    {
      "id": "invalid_composite_p",
      "input_values": [
        9,
        2,
        8,
        1,
        1,
        1,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_q_not_divisor",
      "input_values": [
        23,
        5,
        2,
        2,
        1,
        1,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_generator_subgroup",
      "input_values": [
        23,
        11,
        2,
        18,
        1,
        1,
        0
      ],
      "expected_result": 0
    },
    {
      "id": "invalid_r_zero",
      "input_values": [
        7,
        3,
        2,
        2,
        0,
        1,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_s_out_of_range",
      "input_values": [
        7,
        3,
        2,
        2,
        1,
        3,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_message_byte",
      "input_values": [
        7,
        3,
        2,
        2,
        1,
        1,
        1,
        256
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_length",
      "input_values": [
        7,
        3,
        2,
        2,
        1,
        1,
        2,
        1
      ],
      "expected_result": -1
    },
    {
      "id": "max_message",
      "input_values": [
        23,
        11,
        4,
        18,
        4,
        8,
        8,
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "expected_result": 0
    }
  ]
}
