    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "algorithm": "Implicit treap with subtree size and modular sum, lazy affine tags, lazy reversal, deterministic Park-Miller priorities based on allocation IDs, and ID tie-breaking.",
    "operation_order": "Operations are applied in input order; insertions allocate fresh treap nodes and deletions discard one-node ranges.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Validate the complete variable-width frame and all state-dependent indices before output pointer and capacity checks."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "one modular range sum per type-4 operation, in input order",
    "element_width_bytes": 8,
    "maximum_elements": 32,
    "maximum_bytes": 256,
    "success_result": "number of output bytes written",
