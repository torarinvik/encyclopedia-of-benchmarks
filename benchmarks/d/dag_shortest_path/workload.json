{
  "schema_version": 1,
  "id": "dag-shortest-path-i64-array-scalar-v1",
  "algorithm": "dag_shortest_path",
  "function_symbol": "dag_shortest_path",
  "abi": "i64_array_scalar",
  "description": "Find one source-to-target shortest-path distance in a weighted directed acyclic graph by topological relaxation.",
  "source": {
    "title": "CLRS Algorithmic Reasoning Benchmark, DAG single-source shortest paths",
    "url": "https://github.com/google-deepmind/clrs/blob/3ba3f2d/README.md",
    "role": "Algorithm family discovery and clean-room topological-relaxation profile; algorithm ideas only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[vertex_count,edge_count,source,target,(from,to,weight)*edge_count]",
    "vertex_count_range": [1, 12],
    "edge_count_range": [0, 66],
    "edge_domain": "simple directed graph; no self-loops or duplicate ordered pairs; graph must be acyclic",
    "weight_range": [-1000, 1000],
    "exact_length": "4+3*edge_count",
    "maximum_valid_length": 202,
    "maximum_parseable_length": 203,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "100000 plus the shortest distance when target is reachable; zero when it is unreachable",
    "distance_offset": 100000,
    "reachable_result_range": [89000, 111000],
    "unreachable_result": 0,
    "invalid_input_result": -1
  },
  "algorithm_contract": {
    "topological_order": "Kahn's indegree-zero queue must emit every vertex; otherwise reject the cyclic graph.",
    "relaxation": "Initialize source distance to zero and all others to infinity; visit vertices in topological order and relax each outgoing edge once.",
    "negative_weights": "Allowed because acyclicity guarantees that topological relaxation is valid even with negative edge weights.",
    "output_encoding": "Return distance_offset+distance[target], zero for unreachable targets, and -1 for invalid framing or cyclic input."
  },
  "complexity": {
    "time": "O(VE+V) for edge-list adjacency scans and topological relaxation",
    "space": "O(V+E)"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
