  "abi": "i64_array_bytes_output",
  "description": "Offline dynamic undirected connectivity with vertex-value additions and component-sum queries, using time intervals and rollback DSU.",
  "source": {
    "name": "Library Checker: Dynamic Graph Vertex Add Component Sum",
    "task_url": "https://github.com/yosupo06/library-checker-problems/blob/master/graph/dynamic_graph_vertex_add_component_sum/task.md",
    "limits_url": "https://github.com/yosupo06/library-checker-problems/blob/master/graph/dynamic_graph_vertex_add_component_sum/info.toml",
    "repository_license": "Apache-2.0",
    "reuse": "Task semantics only; local implementations are clean-room bounded profiles."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,initial_value_0..initial_value_(n-1),(op,a,b)*q]",
    "vertex_count_range": [1, 16],
    "event_count_range": [0, 32],
    "maximum_valid_length": 114,
    "maximum_parseable_length": 115,
    "initial_value_range": [0, 100],
    "vertex_add_delta_range": [0, 100],
    "vertex_ids": "zero-based",
    "edge_semantics": "Simple undirected graph; no self-loops or duplicate active edges. An edge must be absent before addition and present before removal.",
    "event_encoding": {
      "0": "add edge [0,u,v]",
      "1": "remove edge [1,u,v]",
      "2": "add x to vertex v [2,v,x]",
      "3": "query component sum [3,v,0]"
    },
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "operation": "Process a complete edge-add/remove and vertex-add event stream; each component-sum query observes all earlier updates.",
    "algorithm": "Place active edge intervals and active vertex-value contributions in a segment tree over event time. Traverse it with a rollback DSU using union by size and no path compression; maintain root component sums and rollback vertex-delta changes.",
    "maximum_component_sum": 4800,
    "complexity": "O((n+q) log(q+1) log(n+1) + q log(q+1) log(n+1)) for the bounded interval insertion and rollback traversal.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Input framing and event validation precede output pointer and capacity checks."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "one component sum per query, in event order",
    "element_width_bytes": 8,
    "maximum_elements": 32,
    "maximum_bytes": 256,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 262144,
    "meaning": "Fixed edge/value interval arrays, time-segment buckets, DSU parent/size/component-sum arrays, rollback log, staged query answers, and traversal stack."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
