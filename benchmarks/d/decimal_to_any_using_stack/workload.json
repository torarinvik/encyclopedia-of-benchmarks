{
  "schema_version": 1,
  "id": "decimal-to-any-using-stack-v1",
  "algorithm": "decimal_to_any_using_stack",
  "input": {
    "kind": "two_signed_64_bit_values",
    "values": [
      "nonnegative decimal value",
      "radix"
    ],
    "radix_range": [
      2,
      16
    ],
    "output_encoding": "most-significant-first ASCII digits 0-9 and uppercase A-F without a prefix",
    "negative_or_invalid_input_result": -1,
    "insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "zero_base2",
      "input_values": [
        0,
        2
      ],
      "expected_result": 1,
      "expected_output": "0"
    },
    {
      "id": "one_base2",
      "input_values": [
        1,
        2
      ],
      "expected_result": 1,
      "expected_output": "1"
    },
    {
      "id": "two_base2",
      "input_values": [
        2,
        2
      ],
      "expected_result": 2,
      "expected_output": "10"
    },
    {
      "id": "ten_base2",
      "input_values": [
        10,
        2
      ],
      "expected_result": 4,
      "expected_output": "1010"
    },
    {
      "id": "83_base8",
      "input_values": [
        83,
        8
      ],
      "expected_result": 3,
      "expected_output": "123"
    },
    {
      "id": "255_base16",
      "input_values": [
        255,
        16
      ],
      "expected_result": 2,
      "expected_output": "FF"
    },
    {
      "id": "base10",
      "input_values": [
        123456789,
        10
      ],
      "expected_result": 9,
      "expected_output": "123456789"
    },
    {
      "id": "signed_32_bit_max",
      "input_values": [
        2147483647,
        2
      ],
      "expected_result": 31,
      "expected_output": "1111111111111111111111111111111"
    },
    {
      "id": "signed_64_bit_max_base2",
      "input_values": [
        9223372036854775807,
        2
      ],
      "expected_result": 63,
      "expected_output": "111111111111111111111111111111111111111111111111111111111111111"
    },
    {
      "id": "signed_64_bit_max_base16",
      "input_values": [
        9223372036854775807,
        16
      ],
      "expected_result": 16,
      "expected_output": "7FFFFFFFFFFFFFFF"
    },
    {
      "id": "negative_one",
      "input_values": [
        -1,
        10
      ],
      "expected_result": -1,
      "expected_output": ""
    },
    {
      "id": "base_below_range",
      "input_values": [
        12,
        1
      ],
      "expected_result": -1,
      "expected_output": ""
    },
    {
      "id": "base_above_range",
      "input_values": [
        12,
        17
      ],
      "expected_result": -1,
      "expected_output": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
