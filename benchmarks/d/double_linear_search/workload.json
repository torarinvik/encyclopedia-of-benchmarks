        0
      ],
      "expected_result": -1,
      "input_length": 2
    },
    {
      "id": "singleton_hit",
      "input_values": [
        7,
        1,
        7
      ],
      "expected_result": 0,
      "input_length": 3
    },
    {
      "id": "singleton_miss",
      "input_values": [
