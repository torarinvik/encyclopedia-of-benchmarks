{
  "schema_version": 1,
  "id": "double-linear-search-packed-i64-v1",
  "algorithm": "double_linear_search",
  "input": {
    "kind": "packed_i64_target_and_sequence",
    "encoding": "[target, item_count, item_0, ..., item_(n-1)]",
    "minimum_item_count": 0,
    "maximum_item_count": 100000,
    "safe_integer_range": [
      -9007199254740991,
      9007199254740991
    ],
    "invalid_result": -1,
    "missing_result": -1,
    "duplicate_match_rule": "check left endpoint before right endpoint on every inward step"
  },
  "cases": [
