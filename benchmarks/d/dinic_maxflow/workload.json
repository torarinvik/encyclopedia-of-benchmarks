{
  "schema_version": 1,
  "id": "dinic-maxflow-directed-i64-v1",
  "algorithm": "dinic_maxflow",
  "function_symbol": "dinic_maxflow",
  "input": {
    "kind": "i64_array_scalar",
    "encoding": "[vertex_count, edge_count, source, sink, (from, to, capacity)*edge_count]",
    "vertex_count_range": [2, 16],
    "edge_count_range": [0, 64],
    "vertex_ids": "1-based",
    "self_loops_allowed": false,
    "parallel_edges_allowed": true,
    "capacity_range": [0, 100],
    "maximum_flow": 6400,
    "invalid_result": -1
  },
  "cases": [
    {"id":"classic_six_vertex_network","input_values":[6,9,1,6,1,2,16,1,4,13,2,3,12,3,4,9,3,6,20,4,2,4,4,5,14,5,3,7,5,6,4],"expected_result":23,"input_length":31},
    {"id":"disconnected_sink","input_values":[4,2,1,4,1,2,10,3,4,7],"expected_result":0,"input_length":10},
    {"id":"parallel_edges_sum_capacity","input_values":[2,2,1,2,1,2,3,1,2,5],"expected_result":8,"input_length":10},
    {"id":"antiparallel_edges","input_values":[3,4,1,3,1,2,4,2,1,3,2,3,2,1,3,1],"expected_result":3,"input_length":16},
    {"id":"zero_capacity_edge","input_values":[2,1,1,2,1,2,0],"expected_result":0,"input_length":7},
    {"id":"empty_edge_list","input_values":[3,0,1,3],"expected_result":0,"input_length":4},
    {"id":"wrong_packed_length","input_values":[2,0,1,2,9],"expected_result":-1,"input_length":5},
    {"id":"source_equals_sink","input_values":[2,0,1,1],"expected_result":-1,"input_length":4},
    {"id":"self_loop","input_values":[2,1,1,2,1,1,4],"expected_result":-1,"input_length":7},
    {"id":"endpoint_out_of_range","input_values":[2,1,1,2,1,3,4],"expected_result":-1,"input_length":7},
    {"id":"capacity_out_of_range","input_values":[2,1,1,2,1,2,101],"expected_result":-1,"input_length":7}
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
}
