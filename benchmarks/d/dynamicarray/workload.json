{
  "schema_version": 1,
  "id": "go-dynamicarray-operation-trace-v1",
  "algorithm": "dynamicarray",
  "function_symbol": "dynamicarray",
  "description": "Trace bounded array append, indexed update/get/remove, size, capacity, and emptiness operations.",
  "input": {
    "kind": "packed_signed_i64_operation_trace",
    "encoding": "[operation_count, operation_records...]",
    "maximum_operations": 128,
    "maximum_elements": 64,
    "initial_capacity": 0,
    "growth_rule": "double capacity when append occurs at full capacity",
    "maximum_capacity_observed": 80,
    "opcodes": {
      "0": "[0,value] append",
      "1": "[1,index,value] update an existing element",
      "2": "[2,index] read an existing element and append it to query results",
      "3": "[3,index] remove an existing element, shifting later values left",
      "4": "[4] append size to query results",
      "5": "[5] append capacity to query results",
      "6": "[6] append 1 if empty, otherwise 0"
    },
    "malformed_result": -1,
    "insufficient_output_capacity_result": -2,
    "first_allocation_capacity": 10
  },
  "output": {
    "kind": "little_endian_signed_i64_words",
    "encoding": "[query_count,query_results...,final_size,final_capacity,final_values...]",
    "success_result": "number of output words"
  },
  "workspace": {
    "bytes": 1560
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
