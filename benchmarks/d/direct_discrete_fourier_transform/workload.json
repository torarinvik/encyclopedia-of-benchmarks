    "maximum_parseable_input_length": 130,
    "forward_sign": "Negative exponent: exp(-2*pi*i*j*k/N).",
    "output_encoding": "Natural frequency order, interleaved real/imaginary float64 values; unnormalized.",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors_write_nothing": true
