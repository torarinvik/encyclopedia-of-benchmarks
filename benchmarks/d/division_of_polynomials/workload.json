      "input_values": [3, 1, 5, 7, 9, 1],
      "input_length": 6,
      "expected_result": 40,
      "expected_output_hex": "03000000000000000000000000000000050000000000000007000000000000000900000000000000"
    },
    {
      "id": "zero-dividend-leading-coefficient",
