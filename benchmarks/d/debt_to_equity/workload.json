{
  "schema_version": 1,
  "id": "debt_to_equity-packed-i64-binary64-v1",
  "algorithm": "debt_to_equity",
  "function_symbol": "debt_to_equity",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": [
      "debt",
      "equity"
    ],
    "exact_length": 2,
    "value_domain": "debt in [0, 1,000,000], equity in [1, 1,000,000]",
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "debt / equity",
    "invalid_input_result": -1e+300,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "source_example",
      "input_values": [
        300,
        150
      ],
      "input_length": 2,
      "expected_result": 2.0
    },
    {
      "id": "zero_debt",
      "input_values": [
        0,
        150
      ],
      "input_length": 2,
      "expected_result": 0.0
    },
    {
      "id": "fractional_ratio",
      "input_values": [
        1,
        4
      ],
      "input_length": 2,
      "expected_result": 0.25
    },
    {
      "id": "large_ratio",
      "input_values": [
        1000000,
        3
      ],
      "input_length": 2,
      "expected_result": 333333.3333333333
    },
    {
      "id": "zero_equity",
      "input_values": [
        300,
        0
      ],
      "input_length": 2,
      "expected_result": -1e+300
    },
    {
      "id": "wrong_input_length",
      "input_values": [
        300
      ],
      "input_length": 1,
      "expected_result": -1e+300
    }
  ]
}
