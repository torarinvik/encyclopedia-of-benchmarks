{
  "schema_version": 1,
  "id": "dijkstra-lazy-heap-shortest-path-v1",
  "algorithm": "dijkstra_lazy_heap",
  "function_symbol": "dijkstra_lazy_heap",
  "abi": "shortest_path",
  "source": {
    "title": "Dijkstra on sparse graphs",
    "url": "https://cp-algorithms.com/graph/dijkstra_sparse.html",
    "license": "CC BY-SA 4.0; algorithm idea only, no copied code or prose"
  },
  "input": {
    "kind": "directed_edge_triples",
    "weight_type": "nonnegative_i64",
    "vertices_range": [0, 64],
    "edge_count_range": [0, 256],
    "source_type": "size_t",
    "unreachable": "separate u8 flag; zero distance storage",
    "overflow": "return -2 when a live popped distance plus an outgoing edge weight exceeds INT64_MAX",
    "invalid_input_result": -3,
    "negative_weight_result": -4
  },
  "output": {
    "kind": "distance_i64_vector_and_u8_reachability_vector",
    "success_result": 0,
    "unreachable_distance_storage": 0,
    "int64_max_is_finite": true,
    "error_outputs": "unspecified"
  },
  "workspace": {"bytes": 8192, "heap_record_bound": "edge_count+1"},
  "complexity": {
    "primary_algorithm": "indexed adjacency lists and duplicate-entry binary min-heap",
    "primary_time": "O(V + E log(E+1))",
    "independent_oracle": "Bellman-Ford with arbitrary-precision labels"
  },
  "measurement": {
    "comparison_model": "shortest_path_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
