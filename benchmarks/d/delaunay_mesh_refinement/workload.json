    "license": "MIT",
    "role": "algorithm"
  },
  "contract": {
    "operation": "perform at most one quality-driven circumcenter insertion into a triangular Delaunay mesh",
    "quality_target_min_angle_degrees": 20,
    "quality_metric": "circumradius divided by shortest edge; bad iff R/s > beta*(1+1e-12), beta=1/(2*sin(20 degrees))",
    "refinement_steps": 1,
    "seed_mesh": "one CCW triangle; all three angles must be acute, so the circumcenter is strictly interior and no constrained segment can be encroached",
    "refinement": "if bad, insert the exact circumcenter and replace the seed with its three CCW fan triangles; otherwise retain the seed",
    "triangle_order": "seed (0,1,2); refined fan (0,1,3), (1,2,3), (2,0,3)",
    "center_quantization": "all coordinates are output as signed millionths; rational circumcenter is rounded to nearest millionth, ties away from zero"
  },
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[3, x0, y0, x1, y1, x2, y2]",
    "point_count": 3,
    "coordinate_range": [-100, 100],
    "vertex_order": "strictly counter-clockwise",
    "shape": "nondegenerate acute triangle",
    "invalid_result": -1,
    "maximum_parseable_length": 7
  },
  "output": {
    "kind": "little_endian_signed_64_integer_bytes",
    "encoding": "[vertex_count, x0_micro, y0_micro, ..., triangle_count, a0, b0, c0, ...]",
    "successful_result": "number of output bytes",
    "no_refinement_bytes": 88,
    "refined_bytes": 152,
    "maximum_bytes": 152,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 152,
    "meaning": "Staged maximum output of 19 signed 64-bit words."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
