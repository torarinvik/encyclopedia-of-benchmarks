      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "coefficient_outside_small_exact_domain",
      "input_values": [1, 1, 1, 0, 2, 0, 1],
      "input_length": 7,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "sample_outside_domain",
      "input_values": [1, 0, 1, 1, 17],
      "input_length": 5,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short_frame",
      "input_values": [2, 0, 1, 1, 2],
      "input_length": 5,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "trailing_word",
      "input_values": [1, 0, 1, 1, 2, 0],
      "input_length": 6,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "valid_input_short_output_capacity",
      "input_values": [3, 0, 1, -1, 3, 0, -4],
      "input_length": 7,
