  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,s,seed_ids..., (u,v,weight)*m, thresholds[n]]",
    "vertex_range": [1, 8],
    "edge_range": [0, 24],
    "seed_count_range": "0..n",
    "edge_weight_range": [0, 16],
    "incoming_weight_sum_per_vertex_max": 16,
    "threshold_range": [1, 16],
    "fixed_point_scale": 16,
    "maximum_valid_length": 91,
    "maximum_parseable_length": 92,
    "invalid_result": -1
  },
  "contract": {
    "algorithm": "Initialize the seed vertices at activation round 0. In each synchronous wave, add outgoing edge weights from the current frontier to inactive targets. Targets whose accumulated incoming weight reaches their fixed threshold enter the next frontier together. Stop when the next frontier is empty.",
    "activation_rounds": "Seeds have round 0; never-activated vertices have round -1; other vertices have the 1-based synchronous wave in which they first meet threshold.",
    "output": "[n,wave_count,activation_round[0..n-1]] as little-endian signed i64 values.",
    "simple_graph": "Directed self-loops and duplicate ordered arcs are invalid; seed IDs are distinct.",
    "scope": "Deterministic fixed-threshold closure for supplied weights, thresholds, and seeds; no seed-selection or randomized diffusion guarantee is claimed."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[n,wave_count,activation_round[0..n-1]]",
    "maximum_bytes": 80,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded frontier, activation rounds, pending flags, and accumulated incoming weights; caller-owned input/output buffers are excluded."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 3,
    "warmup_rounds": 1,
    "repetitions_per_sample": 3
  },
