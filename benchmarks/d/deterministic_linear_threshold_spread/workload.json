    "title": "Approximation and Inapproximation for the Influence Maximization Problem in Social Networks under Deterministic Linear Threshold Model",
    "authors": ["Zaixin Lu", "Wei Zhang", "Weili Wu", "Bin Fu", "Ding-Zhu Du"],
    "year": 2011,
