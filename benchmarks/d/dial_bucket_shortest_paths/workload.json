  "id": "cp-algorithms-dial-bucket-shortest-paths-i64-array-bytes-output-v1",
  "algorithm": "dial_bucket_shortest_paths",
  "function_symbol": "dial_bucket_shortest_paths",
  "abi": "i64_array_bytes_output",
  "description": "Computes single-source distances in a directed graph with small nonnegative integer edge weights using a cyclic exact-distance bucket queue.",
  "source": {
    "title": "0–1 BFS (Dial's algorithm section)",
    "url": "https://cp-algorithms.com/graph/01_bfs.html",
    "license": "CC BY-SA 4.0",
    "discovery_scope": "Algorithm description and navigation taxonomy only; no source code, prose, tests, or examples copied."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,source,(u,v,weight)*M]",
    "N_range": [
      1,
      16
    ],
    "M_range": [
      0,
      64
    ],
    "edge_weight_range": [
      0,
      8
    ],
    "vertex_ids": "0..N-1",
    "source_rule": "0 <= source < N",
    "graph_semantics": "Directed; self-loops, parallel edges, and zero-weight edges are valid.",
    "exact_length": "3+3*M",
    "maximum_valid_length": 195,
    "maximum_parseable_length": 196,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "N signed little-endian i64 shortest distances in vertex order; unreachable vertices are -1",
    "maximum_bytes": 128,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded adjacency, nine bucket heads/tails, at most M+1 distance records, settled flags, and staged output."
  },
  "algorithm_details": {
    "primary": "Use nine cyclic exact-distance buckets for weights 0..8. Start at distance zero, drain that exact bucket including zero-weight relaxations, and skip stale records whose stored distance differs from the current best or whose vertex is settled.",
    "independent_oracle": "Floyd–Warshall over the directed graph, then select the source row.",
    "maximum_finite_distance": 120,
    "ring_bucket_count": 9,
    "primary_complexity": "O(M+N*C) time with C=8 and maximum scan distance (N-1)C; O(N+M+C) space.",
    "oracle_complexity": "O(N^3+M) time and O(N^2+M) space."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
