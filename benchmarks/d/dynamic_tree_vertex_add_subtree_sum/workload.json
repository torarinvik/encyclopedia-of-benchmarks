  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed link-cut node arrays, splay ancestor stacks, and staged output answers."
  },
  "contract": {
    "operation": "Maintain a tree under edge replacement and vertex-value addition; answer the sum in the component containing v after excluding adjacent edge (v,p).",
    "algorithm": "Splay link-cut tree with virtual-subtree totals updated when preferred branches change.",
    "complexity": "O((N+Q) log N) amortized time and O(N+Q) bounded storage.",
    "error_precedence": "Input framing and event-field validation precede output checks; topology preconditions are checked during staged processing.",
