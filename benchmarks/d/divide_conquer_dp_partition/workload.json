  "algorithm": "divide_conquer_dp_partition",
  "function_symbol": "divide_conquer_dp_partition",
  "abi": "i64_array_scalar",
  "description": "Layered contiguous partition DP with monotone-argmin divide-and-conquer optimization.",
  "source": {
    "repository": "OI-wiki/OI-wiki",
    "title": "Quadrangle Inequality Optimization",
    "url": "https://en.oi-wiki.org/dp/opt/quadrangle/",
    "license": "CC BY-SA 4.0 with SATA",
    "reuse_scope": "High-level algorithm description only; clean-room recurrence instance, contract, fixtures, references, and ports."
  },
  "input": {
    "kind": "nonnegative_sequence_and_group_count",
    "encoding": "[n,k,value_0,...,value_(n-1)]",
    "n_range": [1, 64],
    "group_count_range": [1, 8],
    "group_count_must_not_exceed_n": true,
    "value_range": [0, 1000],
    "exact_length": "n+2",
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "minimum_sum_of_squared_contiguous_group_sums",
    "valid_result_range": [0, 4096000000],
    "invalid_input_result": -1
  },
  "contract": {
    "operation": "Split the sequence into exactly k nonempty contiguous groups and minimize the sum of each group's total squared.",
    "recurrence": "dp[g][i] = min_{g-1<=j<i}(dp[g-1][j] + (prefix[i]-prefix[j])^2)",
    "algorithm": "For each group layer, evaluate midpoint states by divide and conquer over the inherited interval of optimal split indices.",
    "monotonicity_basis": "For nonnegative values, squared segment-sum cost satisfies the quadrangle inequality; adding a previous DP row preserves Monge ordering.",
    "tie_rule": "Choose the smallest split index attaining the minimum by updating only on strict cost improvement.",
    "complexity": "O(k*n*log(n)) candidate evaluations and O(n) working storage.",
    "primary_reference": "The divide-and-conquer optimized layered recurrence.",
    "independent_reference": "The full O(k*n^2) transition scan."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
