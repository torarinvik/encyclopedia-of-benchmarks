{
  "schema_version": 1,
  "id": "dancing-links-v1",
  "algorithm": "dancing_links",
  "input": {
    "kind": "universe_size_row_count_then_row_masks",
    "universe_size_range": [1, 8],
    "row_count_range": [0, 8],
    "row_mask_range": "1 through (1 << universe_size) - 1",
    "result": "count of exact covers; each output byte is the selected row bitmask in ascending numeric order",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "cases": [
    {"id":"single_row","input_values":[2,1,3],"expected_result":1,"expected_output_hex":"01"},
    {"id":"two_disjoint_rows","input_values":[3,2,1,6],"expected_result":1,"expected_output_hex":"03"},
    {"id":"two_alternatives","input_values":[2,3,1,2,3],"expected_result":2,"expected_output_hex":"0304"},
    {"id":"duplicate_rows_are_distinct","input_values":[1,2,1,1],"expected_result":2,"expected_output_hex":"0102"},
    {"id":"uncoverable_column","input_values":[2,1,1],"expected_result":0,"expected_output_hex":""},
    {"id":"no_rows","input_values":[2,0],"expected_result":0,"expected_output_hex":""},
    {"id":"invalid_zero_row","input_values":[1,1,0],"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid_out_of_universe","input_values":[2,1,4],"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid_length","input_values":[2,1,1,2],"expected_result":-1,"expected_output_hex":""}
  ],
  "measurement": {"comparison_model":"i64_array_bytes_output_call","sample_count":9,"warmup_rounds":2,"repetitions_per_sample":1000}
}
