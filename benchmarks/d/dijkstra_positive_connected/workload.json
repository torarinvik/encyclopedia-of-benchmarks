{
  "schema_version": 1,
  "id": "dijkstra-positive-connected-v1",
  "algorithm": "dijkstra_positive_connected",
  "function_symbol": "dijkstra_positive_connected",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[vertex_count, edge_count, (u,v,weight)...]",
    "vertex_count_range": [
      1,
      4
    ],
    "edge_count_range": "n-1 through n*(n-1)/2",
    "graph": "connected, undirected, simple; source vertex is always 0",
    "weight_range": [
      1,
      255
    ],
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "meaning": "shortest distance from vertex 0 to every vertex in numeric vertex order",
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 500
  },
  "cases": [
    {
      "id": "weighted_shortcuts",
      "input_values": [
        4,
        5,
        0,
        1,
        4,
        0,
        2,
        1,
        2,
        1,
        2,
        2,
        1,
        3,
        1,
        2,
        3,
        5
      ],
      "input_length": 18,
      "expected_result": 32,
      "expected_output_hex": "0000000000000000030000000000000001000000000000000400000000000000"
    },
    {
      "id": "positive_max_edge_weight_chain",
      "input_values": [
        4,
        3,
        0,
        1,
        255,
        1,
        2,
        1,
        2,
        3,
        255
      ],
      "input_length": 11,
      "expected_result": 32,
      "expected_output_hex": "0000000000000000ff000000000000000001000000000000ff01000000000000"
    },
    {
      "id": "equal_distance_routes",
      "input_values": [
        4,
        6,
        0,
        1,
        2,
        0,
        2,
        2,
        0,
        3,
        9,
        1,
        3,
        7,
        2,
        3,
        7,
        1,
        2,
        1
      ],
      "input_length": 20,
      "expected_result": 32,
      "expected_output_hex": "0000000000000000020000000000000002000000000000000900000000000000"
    },
    {
      "id": "single_vertex",
      "input_values": [
        1,
        0
      ],
      "input_length": 2,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "disconnected_graph",
      "input_values": [
        3,
        1,
        0,
        1,
        5
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "duplicate_undirected_edge",
      "input_values": [
        2,
        2,
        0,
        1,
        3,
        1,
        0,
        3
      ],
      "input_length": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "zero_weight_edge",
      "input_values": [
        2,
        1,
        0,
        1,
        0
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "self_loop",
      "input_values": [
        2,
        2,
        0,
        0,
        1,
        0,
        1,
        2
      ],
      "input_length": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated_edge",
      "input_values": [
        2,
        1,
        0,
        1
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
