{
  "schema_version": 1,
  "id": "ddaline-java-endpoints-ties-positive-infinity-v1",
  "algorithm": "ddaline",
  "function_symbol": "ddaline",
  "input": {
    "kind": "four_signed_64_bit_coordinates",
    "encoding": "[x0,y0,x1,y1]",
    "coordinate_range": [
      -128,
      128
    ],
    "step_range": [
      0,
      256
    ],
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_i64_point_pairs",
    "point_order": "start through end, one point per DDA step plus the starting point",
    "rounding": "nearest integer with ties toward positive infinity, as Java Math.round",
    "degenerate_segment": "one point at (x0,y0), appended before the source adds its NaN increment",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "documented_diagonal_includes_start",
      "input_values": [
        1,
        1,
        4,
        4
      ],
      "expected_result": 64,
      "expected_output_hex": "01000000000000000100000000000000020000000000000002000000000000000300000000000000030000000000000004000000000000000400000000000000"
    },
    {
      "id": "shallow_slope",
      "input_values": [
        0,
        0,
        5,
        3
      ],
      "expected_result": 96,
      "expected_output_hex": "000000000000000000000000000000000100000000000000010000000000000002000000000000000100000000000000030000000000000002000000000000000400000000000000020000000000000005000000000000000300000000000000"
    },
    {
      "id": "vertical_includes_start",
      "input_values": [
        2,
        -1,
        2,
        3
      ],
      "expected_result": 80,
      "expected_output_hex": "0200000000000000ffffffffffffffff02000000000000000000000000000000020000000000000001000000000000000200000000000000020000000000000002000000000000000300000000000000"
    },
    {
      "id": "positive_half_rounds_up",
      "input_values": [
        0,
        0,
        4,
        2
      ],
      "expected_result": 80,
      "expected_output_hex": "0000000000000000000000000000000001000000000000000100000000000000020000000000000001000000000000000300000000000000020000000000000004000000000000000200000000000000"
    },
    {
      "id": "negative_half_toward_positive_infinity",
      "input_values": [
        0,
        -2,
        4,
        0
      ],
      "expected_result": 80,
      "expected_output_hex": "0000000000000000feffffffffffffff0100000000000000ffffffffffffffff0200000000000000ffffffffffffffff0300000000000000000000000000000004000000000000000000000000000000"
    },
    {
      "id": "reverse_x_direction",
      "input_values": [
        5,
        0,
        0,
        3
      ],
      "expected_result": 96,
      "expected_output_hex": "050000000000000000000000000000000400000000000000010000000000000003000000000000000100000000000000020000000000000002000000000000000100000000000000020000000000000000000000000000000300000000000000"
    },
    {
      "id": "degenerate_java_nan_rounding",
      "input_values": [
        7,
        -3,
        7,
        -3
      ],
      "expected_result": 16,
      "expected_output_hex": "0700000000000000fdffffffffffffff"
    },
    {
      "id": "empty_input",
      "input_values": [],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short_input",
      "input_values": [
        0,
        0,
        1
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "coordinate_out_of_range",
      "input_values": [
        0,
        0,
        129,
        0
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient_capacity",
      "input_values": [
        0,
        0,
        2,
        0
      ],
      "workspace_bytes": 8,
      "capacity_error_result": -2,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
