{
  "schema_version": 1,
  "id": "duplicate-zeros-v1",
  "algorithm": "duplicate_zeros",
  "input": {
    "type": "array of integers from 0 through 1000",
    "length_range": [
      0,
      64
    ],
    "result": "fixed output length; each zero is duplicated and trailing values are truncated",
    "output_encoding": "each output value is signed 32-bit little-endian",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "no_zeros",
      "input_values": [
        1,
        2,
        3,
        4
      ],
      "expected_result": 4,
      "expected_output_hex": "01000000020000000300000004000000"
    },
    {
      "id": "zero_at_front",
      "input_values": [
        0,
        1,
        2,
        3
      ],
      "expected_result": 4,
      "expected_output_hex": "00000000000000000100000002000000"
    },
    {
      "id": "zero_at_end",
      "input_values": [
        1,
        2,
        3,
        0
      ],
      "expected_result": 4,
      "expected_output_hex": "01000000020000000300000000000000"
    },
    {
      "id": "consecutive_zeros",
      "input_values": [
        1,
        0,
        0,
        2,
        3
      ],
      "expected_result": 5,
      "expected_output_hex": "0100000000000000000000000000000000000000"
    },
    {
      "id": "truncated_duplicate",
      "input_values": [
        1,
        2,
        0
      ],
      "expected_result": 3,
      "expected_output_hex": "010000000200000000000000"
    },
    {
      "id": "all_zeros",
