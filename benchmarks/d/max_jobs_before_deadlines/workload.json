  "algorithm": "max_jobs_before_deadlines",
  "function_symbol": "max_jobs_before_deadlines",
  "abi": "i64_array_scalar",
  "description": "Maximum number of arbitrary-duration jobs that can finish by their deadlines on one machine.",
  "source": {
    "title": "Optimal schedule of jobs given their deadlines and durations",
    "url": "https://cp-algorithms.com/schedules/schedule-with-completion-duration.html",
    "license": "CC BY-SA 4.0",
    "discovery_scope": "Algorithm description and navigation taxonomy only; no source code, prose, tests, or examples copied."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,(deadline_i,duration_i)*N]",
    "job_count_range": [0, 12],
    "deadline_range": [0, 1000],
    "duration_range": [1, 1000],
    "exact_length": "1+2*N",
    "maximum_valid_length": 25,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "Maximum number of selected jobs that can finish by their deadlines.",
    "range": [0, 12],
    "invalid_input_result": -1
  },
  "algorithm": {
    "primary": "Sort by deadline, then sweep intervals from the largest deadline down. Keep residual durations in a min-heap, completing shortest jobs within each interval and reinserting a residual when the interval ends mid-job.",
    "independent_oracle": "Enumerate job subsets and test each with a forward earliest-deadline schedule.",
    "primary_complexity": "O(N*N + N*log(N)) time with bounded insertion sorting, O(N) space.",
    "oracle_complexity": "O(2^N*N*log(N)) time and O(N) space, bounded at N<=12."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
