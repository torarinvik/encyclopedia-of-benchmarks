  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "query-number-weighted checksum of active-set diameters plus one",
    "checksum": "sum(j * (diameter_after_query_j + 1)) for one-based query number j",
    "diameter_for_fewer_than_two_active_vertices": 0,
    "result_range": [0, 66560],
    "invalid_input_result": -1
  },
  "source": {
