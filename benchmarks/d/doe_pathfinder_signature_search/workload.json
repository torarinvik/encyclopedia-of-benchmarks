{
  "schema_version": 1,
  "id": "doe-pathfinder-signature-search-v1",
  "algorithm": "doe_pathfinder_signature_search",
  "function_symbol": "doe_pathfinder_signature_search",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[node_count, edge_count, signature_length, (from, to)*edge_count, node_labels..., signature_labels...]",
    "node_count_range": [1, 10],
    "edge_count_range": [0, 100],
    "signature_length_range": [2, 4],
    "node_labels": "-1 for unlabeled, otherwise 0 through 7",
    "signature_labels": "0 through 7",
    "edges": "unique directed edges in traversal order; self-loops allowed",
    "exact_length": "3 + 2*edge_count + node_count + signature_length",
    "invalid_input_result": -2
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "1 if any path starts at the first signature label and visits the remaining labels in order, otherwise 0"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
  "cases": [
    {
      "id": "ordered_direct_chain",
      "input_values": [3, 2, 3, 0, 1, 1, 2, 0, 1, 2, 0, 1, 2],
      "expected_result": 1
    },
    {
      "id": "unlabeled_intermediate_nodes",
      "input_values": [4, 3, 3, 0, 1, 1, 2, 2, 3, 0, -1, 1, 2, 0, 1, 2],
      "expected_result": 1
    },
    {
      "id": "consume_or_traverse_matching_label",
      "input_values": [5, 4, 3, 0, 1, 0, 2, 2, 3, 3, 4, 0, 1, -1, 1, 2, 0, 1, 2],
      "expected_result": 1
    },
    {
      "id": "revisit_after_signature_transition",
      "input_values": [2, 2, 3, 0, 1, 1, 0, 0, 1, 0, 1, 0],
      "expected_result": 1
    },
    {
      "id": "later_start_label_succeeds",
      "input_values": [4, 2, 2, 0, 1, 2, 3, 0, 2, 0, 1, 0, 1],
      "expected_result": 1
    },
    {
      "id": "self_loop_matches_repeated_label",
      "input_values": [1, 1, 2, 0, 0, 3, 3, 3],
      "expected_result": 1
    },
    {
      "id": "cyclic_graph_without_target_label",
      "input_values": [3, 3, 2, 0, 1, 1, 2, 2, 0, 0, 4, 4, 0, 1],
      "expected_result": 0
    },
    {
      "id": "labels_appear_in_wrong_order",
      "input_values": [3, 2, 3, 0, 1, 1, 2, 0, 2, 1, 0, 1, 2],
      "expected_result": 0
    },
    {
      "id": "unlabeled_start_node",
      "input_values": [2, 1, 2, 0, 1, -1, 1, 0, 1],
      "expected_result": 0
    },
    {
      "id": "no_edges",
      "input_values": [2, 0, 2, 0, 1, 0, 1],
      "expected_result": 0
    },
    {
      "id": "duplicate_edge_invalid",
      "input_values": [2, 2, 2, 0, 1, 0, 1, 0, 1, 0, 1],
      "expected_result": -2
    },
    {
      "id": "node_label_out_of_range",
      "input_values": [1, 0, 2, 8, 0, 0],
      "expected_result": -2
    },
    {
      "id": "one_label_signature_invalid",
      "input_values": [1, 0, 1, 0, 0],
      "expected_result": -2
    },
    {
      "id": "wrong_packed_length",
      "input_values": [2, 0, 2, 0, 1],
      "expected_result": -2
    }
  ]
}
