{
  "schema_version": 1,
  "id": "go-depth-first-search-target-route-v1",
  "algorithm": "depth_first_search_target_route",
  "function_symbol": "depth_first_search_target_route",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[node_count, start_label, target_label, node_label_0, ..., node_label_(node_count-1), edge_count, left_0, right_0, ...]",
    "node_count_range": [
      1,
      64
    ],
    "node_label_range": [
      0,
      255
    ],
    "node_labels_must_be_unique": true,
    "start_label": "must occur in node_labels",
    "target_label": "may be absent from node_labels; then the search is unsuccessful",
    "edge_count_range": [
      0,
      94
    ],
    "edge_endpoints": "must be node labels; each input edge creates both adjacency directions",
    "duplicate_edges": "coalesced as in the source boolean matrix",
    "maximum_packed_values": 256,
    "invalid_input_result": -2
  },
  "output": {
    "kind": "byte_sequence",
    "meaning": "stack-pop route labels from start through target; zero bytes and result 0 when target is unreachable",
    "maximum_bytes": 128,
    "invalid_input_result": -2,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 128
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "pinned_sample_one",
      "description": "The pinned Go graph example searches from node 1 to node 6.",
