  "function_symbol": "sharpe_ratio",
  "description": "Non-annualized Sharpe ratio using sample standard deviation and a per-period risk-free rate.",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[count, return_0_micro, ..., return_(count-1)_micro, risk_free_micro]",
