{
  "schema_version": 1,
  "id": "simon-overlapping-match-count-v1",
  "algorithm": "simon_string_search",
  "function_symbol": "simon_string_search",
  "abi": "i64_array_scalar",
  "input": {
    "kind": "packed_small_alphabet_byte_sequences",
    "encoding": "[text_length, pattern_length, text_symbols..., pattern_symbols...]",
    "text_length_range": [0, 256],
    "pattern_length_range": [1, 16],
    "symbol_range": [0, 15],
    "maximum_valid_input_length": 274,
    "maximum_parseable_input_length": 274,
    "invalid_input_result": -2
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "number of exact match start positions, including overlaps"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
