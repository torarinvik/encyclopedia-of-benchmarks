{
  "schema_version": 1,
  "id": "sorted-list-to-bst-v1",
  "algorithm": "sorted_list_to_bst",
  "input": {
    "type": "nondecreasing signed 32-bit values representing a sorted linked list",
    "length_range": [
      0,
      64
    ],
    "result": "number of tree nodes",
    "output_encoding": "preorder tree serialization: null is 00; node is 01 followed by signed 32-bit little-endian key, then left and right child serializations",
    "midpoint_rule": "slow/fast traversal selects the upper middle node for even lengths",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "empty_list",
      "input_values": [],
      "expected_result": 0,
      "expected_output_hex": "00"
    },
    {
      "id": "one_node",
      "input_values": [
        7
      ],
      "expected_result": 1,
      "expected_output_hex": "01070000000000"
    },
    {
      "id": "two_nodes_upper_middle",
      "input_values": [
        -1,
        1
      ],
      "expected_result": 2,
      "expected_output_hex": "010100000001ffffffff000000"
    },
    {
      "id": "odd_length",
      "input_values": [
        -9,
        -3,
        0,
        4,
        12
      ],
      "expected_result": 5,
      "expected_output_hex": "010000000001fdffffff01f7ffffff000000010c0000000104000000000000"
    },
    {
      "id": "even_length",
      "input_values": [
        1,
        3,
        5,
        7
      ],
      "expected_result": 4,
      "expected_output_hex": "01050000000103000000010100000000000001070000000000"
    },
