  "contract": {
    "operation": "Compute g=gcd(abs(numerator),abs(denominator)) and return (numerator//g, denominator//g).",
    "input_encoding": "[numerator, denominator]",
    "component_range": [
      -1000000,
      1000000
    ],
    "denominator": "Must be nonzero.",
    "sign_rule": "Preserve the sign of each input; do not normalize a negative denominator to positive.",
    "output_serialization": "Two signed i64 values in little-endian order: reduced numerator followed by reduced denominator.",
    "output_bytes": 16,
    "errors": "Malformed input, zero denominator, or out-of-range values return -1 before output checks. Null output or capacity below 16 returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[numerator, denominator]",
    "component_range": [
      -1000000,
      1000000
    ],
    "denominator_nonzero": true,
    "exact_input_length": 2,
    "maximum_valid_input_values": 2,
    "maximum_input_values_for_malformed_cases": 3,
    "invalid_input_result": -1
  },
  "output": {
