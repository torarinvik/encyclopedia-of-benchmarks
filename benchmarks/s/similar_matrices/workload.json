{
  "schema_version": 1,
  "id": "similar-matrices-integer-jordan-signature-v1",
  "algorithm": "similar_matrices",
  "function_symbol": "similar_matrices",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,A_row_major_n_by_n,B_row_major_n_by_n]",
    "n_range": [
      1,
      3
    ],
    "entry_range": [
      -5,
      5
    ],
    "exact_length": "1 + 2*n*n",
    "maximum_length_values": 19,
    "maximum_packed_bytes": 152,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_integer_similarity_boolean",
    "values": {
      "not_similar": 0,
      "similar": 1
    },
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "one_by_one_equal",
      "input_values": [
        1,
        3,
        3
      ],
      "expected_result": 1
    },
