  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[T, p, n0, k0, ..., n(T-1), k(T-1)]",
    "T_range": [1, 8],
    "p_range": [11, 97],
    "p_must_be_prime": true,
    "n_range": [0, 1000000000000000000],
