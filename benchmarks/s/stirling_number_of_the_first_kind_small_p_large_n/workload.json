  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "sum((i+1)^2*s(ni,ki)) modulo p for i=0..T-1",
    "formula": "sum((i+1)^2*s(ni,ki)) mod p",
    "invalid_input_result": -1
  },
  "contract": {
    "official_modulus_range": [2, 5000],
    "official_n_range": [0, 1000000000000000000],
    "official_k_range": "0<=k<=n",
    "official_T_max": 200000,
    "profile_p_range": [11, 97],
    "profile_T_range": [1, 8],
    "profile_k_range": [0, 8],
    "profile_n_range": [0, 1000000000000000000],
    "polynomial_identity": "product(x-i, i=0..n-1) = (x^p-x)^q * product(x-a, a=0..r-1) modulo p, with q=floor(n/p), r=n mod p",
    "coefficient_rule": "p-1>k, so if q>k then s(n,k)=0; otherwise s(n,k)=(-1)^q times the degree-(k-q) coefficient of R_r",
    "checksum_weights": "weight query i by (i+1)^2 before summing modulo p",
    "checksum_not_injective": true,
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
