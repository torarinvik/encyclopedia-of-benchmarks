      "1": "m/s",
      "2": "mph",
      "3": "knot",
      "4": "ft/s",
      "5": "Mach",
      "6": "c"
    },
    "maximum_absolute_intermediate_result_times_1000": 9007199254740992,
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
