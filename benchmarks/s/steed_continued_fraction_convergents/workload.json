  "contract": {
    "operation": "Evaluate C0=b0 and each finite generalized-fraction convergent Cn=b0+a1/(b1+a2/(...+an/bn)) over F_998244353.",
    "primary_method": "Steed D_n and delta-C_n recurrence from DLMF Eqs. 3.10.16–3.10.17.",
    "independent_method": "Reduce each prefix from the right using homogeneous tail numerator/denominator pairs, then divide only by its full prefix denominator.",
    "duplicate_comparison": "continued_fraction_convergents uses the simple-integer continuant method; continued_fraction_forward_series_recurrence is specialized to unit denominators. This package profiles Steed's distinct D/delta-C update for arbitrary supplied b and a coefficients.",
    "invalid_input_result": -1,
    "zero_divisor_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,b0,b1,a1,...,bN,aN]",
    "level_range": [1, 8],
    "coefficient_range": [0, 998244352],
    "required_nonzero_coefficient": "b1",
    "maximum_valid_length": 18,
    "maximum_parseable_length": 19,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_word_array_bytes",
    "encoding": "[N+1,C0,C1,...,CN] with each C a canonical residue modulo 998244353",
    "word_count_range": [3, 10],
    "maximum_bytes": 80,
    "success_result": "number of output bytes, equal to 8*(N+2)",
    "invalid_input_or_divisor_result": -1,
    "null_or_short_output_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 0,
    "meaning": "Native ports preflight all divisors and recompute scalar Steed state to write directly into caller output."
  },
  "complexity": {
    "native_primary_time": "O(N log p) modular operations (O(N) for fixed p), including divisor preflight and output pass",
    "native_primary_auxiliary_space": "O(1)",
    "independent_reference_time": "O(N^2 + N log p), evaluating every prefix from the right",
    "independent_reference_auxiliary_space": "O(1) apart from returned reference values"
  },
  "measurement": {
