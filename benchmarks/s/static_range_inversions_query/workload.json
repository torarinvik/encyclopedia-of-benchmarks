{
  "schema_version": 1,
  "id": "library-checker-static-range-inversions-query-bounded-v1",
  "algorithm": "static_range_inversions_query",
  "function_symbol": "static_range_inversions_query",
  "abi": "i64_array_bytes_output",
  "description": "Answer strict inversion-count queries on half-open ranges of a static array.",
  "source": {
    "name": "Library Checker: Static Range Inversions Query",
    "task_url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/static_range_inversions_query/task.md",
    "limits_url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/static_range_inversions_query/info.toml",
    "repository_license": "Apache-2.0",
    "reuse": "Task semantics only; ports and fixtures are independently authored."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,array[N],(left,right)*Q]",
    "n_range": [1, 128],
    "q_range": [1, 32],
    "value_range": [0, 1000000000],
    "query_rule": "0 <= left < right <= N; ranges are half-open",
    "maximum_valid_length": 194,
    "maximum_parseable_length": 195,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "operation": "For each range, count pairs of positions i<j whose values satisfy A[i]>A[j].",
    "algorithm": "Coordinate-compress the values; move a Mo-ordered interval while a Fenwick frequency tree counts strict smaller/greater values at each endpoint.",
    "equal_values_are_inversions": false,
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Framing, value bounds, and all query ranges are validated before output pointer and capacity checks."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "one strict inversion count per query, in original order",
    "element_width_bytes": 8,
    "maximum_elements": 32,
    "maximum_bytes": 256,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Compressed ranks, sorted query order, Fenwick frequencies, active interval state, and staged answers."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "overlapping-range-queries",
      "input_values": [6,5,3,1,2,0,2,1,0,6,0,3,1,5,2,6,3,6],
      "input_length": 18,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "09000000000000000200000000000000020000000000000003000000000000000100000000000000"
    },
    {
      "id": "duplicate-values-do-not-count-equal-pairs",
      "input_values": [5,3,1,1,1,0,0,0,5,1,4,2,5],
      "input_length": 13,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "060000000000000002000000000000000200000000000000"
    },
    {
      "id": "already-sorted-ranges",
      "input_values": [4,2,0,1,2,3,0,4,1,4],
      "input_length": 10,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
      "id": "short-output-capacity",
      "input_values": [3,1,2,1,0,0,3],
      "input_length": 7,
      "output_capacity": 7,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [3,1,2,1,0,0,3],
      "input_length": 7,
      "output_capacity": 8,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "negative-value-invalid",
      "input_values": [3,1,0,-1,2,0,3],
      "input_length": 7,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "empty-range-invalid",
      "input_values": [3,1,0,1,2,2,2],
      "input_length": 7,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-input-precedes-null-output",
      "input_values": [3,1,0,1,2,0,4],
      "input_length": 7,
      "output_capacity": 0,
      "output_is_null": true,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "overlong-frame",
      "input_values": [3,1,0,1,2,0,3,9],
      "input_length": 8,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
