    {"id": "reject_above_squared_bound", "input_values": [1,2,1,0,0,2], "input_length": 6, "output_capacity": 2, "expected_result": 2, "expected_output_hex": "0001"},
    {"id": "all_neighbors_merge", "input_values": [2,2,65535,65535,65535,65535,0,255,100,200], "input_length": 10, "output_capacity": 4, "expected_result": 4, "expected_output_hex": "00000000"},
    {"id": "short_output", "input_values": [1,1,0,17], "input_length": 4, "output_capacity": 0, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null_output", "input_values": [1,1,0,17], "input_length": 4, "output_capacity": 0, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
    {"id": "bad_bound", "input_values": [1,1,-1,17], "input_length": 4, "output_capacity": 1, "expected_result": -1, "expected_output_hex": ""},
    {"id": "bad_pixel", "input_values": [1,1,0,256], "input_length": 4, "output_capacity": 1, "expected_result": -1, "expected_output_hex": ""},
