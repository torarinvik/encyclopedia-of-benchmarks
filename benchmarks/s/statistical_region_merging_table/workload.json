  "abi": "i64_array_bytes_output",
  "description": "Ordered grayscale region merging with supplied squared bounds.",
  "input": {"kind": "signed_64_bit_integer_array", "encoding": "[height,width,bounds[height*width],pixels[height*width]]", "maximum_valid_length": 74, "maximum_parseable_length": 74, "invalid_input_result": -1},
  "output": {"kind": "byte_vector", "encoding": "minimum row-major pixel index per region", "maximum_bytes": 36, "null_output_result": -2, "insufficient_capacity_result": -2, "no_write_on_error": true},
  "workspace": {"bytes": 4096, "meaning": "Pixel regions, sums, sizes, ordered edges, and output."},
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "cases": [
    {"id": "singleton", "input_values": [1,1,0,17], "input_length": 4, "output_capacity": 1, "expected_result": 1, "expected_output_hex": "00"},
