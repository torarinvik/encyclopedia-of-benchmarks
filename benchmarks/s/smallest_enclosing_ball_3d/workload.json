  "contract": {
    "operation": "Compute the minimum-radius sphere enclosing up to eight 3D points with Welzl's recursive support-set method.",
    "algorithm_profile": "Deterministic lexicographic point order; recurse after removing the final point, and add it to the support set only when it lies outside the current sphere. The support set is capped at four points.",
    "input_layout": "[n,x0,y0,z0,...,x(n-1),y(n-1),z(n-1)]",
    "coordinate_range": [-10.0, 10.0],
    "point_count": [1, 8],
    "duplicate_points": "Accepted; support fitting handles duplicate and degenerate subsets by considering smaller support candidates.",
    "output": "[center_x,center_y,center_z,radius]",
    "errors": "Malformed, nonfinite, or out-of-range input returns -1 before output checks. Null output or capacity below four values returns -2 without writes."
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "Point count followed by flattened xyz coordinates.",
    "maximum_valid_input_length": 25,
    "maximum_parseable_input_length": 25,
    "minimum_point_count": 1,
    "maximum_point_count": 8,
    "coordinate_range": [-10.0, 10.0],
    "all_values_finite": true,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "Sphere center xyz followed by radius.",
    "maximum_elements": 4,
    "success_result": 4,
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "null_output_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Malformed or out-of-range input is rejected before output pointer or capacity checks.",
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-9
  },
  "workspace": {"elements": 32, "meaning": "Bounded recursive point and support storage."},
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-9
  },
  "cases": [
    {"id":"singleton","input_values":[1.0,2.0,-1.0,4.0],"input_length":4,"expected_result":4,"expected_output":[2.0,-1.0,4.0,0.0]},
