  "algorithm": "suffix_array_blind_trie",
  "function_symbol": "suffix_array_blind_trie",
  "abi": "i64_array_bytes_output",
  "description": "Construct a suffix array by inserting all suffixes into an ordered blind trie and traversing its leaves lexicographically.",
  "source": {
    "title": "Blind sort / Engineering a Lightweight Suffix Array Construction Algorithm",
    "authors": ["Giovanni Manzini", "Paolo Ferragina"],
    "year": 2004,
    "reference": "Algorithmica 40(1), pp. 33-50, DOI 10.1007/s00453-004-1094-1; Section 3.1",
    "url": "https://doi.org/10.1007/s00453-004-1094-1",
    "algorithm_attribution": "Bounded all-suffix blind-trie insertion and ordered leaf traversal; clean-room specialization, not the full deep-shallow sorter.",
    "algorithm_description_url": "https://people.unipmn.it/manzini/papers/esa02.pdf",
    "discovery_url": "https://xlinux.nist.gov/dads/HTML/blindSort.html",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, byte_symbols...]",
    "text_length_range": [0, 32],
    "symbol_range": [0, 255],
    "exact_length": "1 + text_length",
    "maximum_valid_length": 33,
    "maximum_parseable_length": 34,
    "includes_nul": true,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "all original suffix starts in lexicographic order; the private terminator is excluded",
    "maximum_output_bytes": 256,
    "success_result": "8 * text_length bytes",
    "empty_text_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2304,
    "meaning": "Fixed node arrays, the 64-entry traversal stack, 32-entry child scratch, 32-entry result storage, scalar metadata, and bounded frame overhead; input and returned bytes are excluded."
  },
  "complexity": {
    "time": "O(n^2) worst case: at most n blind-trie insertions, each with a bounded suffix comparison and bounded child-list traversal",
    "space": "O(n) trie nodes and fixed traversal storage"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary inserts suffixes into a blind trie using stored common-prefix branch positions, repairs the blind descent at the true LCP, and emits ordered leaves. The independent oracle sorts complete suffix slices directly.",
