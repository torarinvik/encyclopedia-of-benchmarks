  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,k,b,outer_cycle[b],(degree[x],clockwise_neighbors[x]...)*n,rotation_permutation[n]]",
    "vertex_count_range": [4, 8],
    "rotation_order_range": [3, 8],
    "outer_face_length_range": [3, 8],
    "maximum_valid_length": 54,
    "maximum_parseable_length": 55,
    "embedding": "Simple connected 3-vertex-connected sphere embedding, represented by clockwise cyclic neighbor rows. Face walks take the next clockwise neighbor after the incoming edge; the supplied outer cycle must be one such face walk, up to cyclic shift.",
    "symmetry": "The permutation is an orientation-preserving embedding automorphism of exact order k, fixes exactly one vertex c, and maps each outer-cycle vertex forward by b/k positions. The fixed vertex c is the central vertex.",
    "bounded_profile": "The selected shortest path and its image must intersect only at c and, with the generator-direction outer arc, form a simple cycle.",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[len(P1),P1...,len(P2),P2...,len(P0),P0...,wedge_vertex_mask,wedge_edge_mask]",
    "path_convention": "P1 is c-to-v1; P2 is its image under the rotation permutation; P0 is the outer-face path from v1 to perm(v1) in the permutation's positive direction. Paths include both endpoints.",
    "mask_convention": "Vertex bits use vertex IDs. Edge bits use lexicographic (u,v), u<v, order. The wedge is the induced subgraph on the closed sector: boundary vertices plus vertices on faces on the side opposite the selected outer face.",
    "maximum_bytes": 128,
    "invalid_input_result": -1,
    "null_or_short_output_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {"bytes": 16384},
