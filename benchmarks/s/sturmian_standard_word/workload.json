{
  "schema_version": 1,
  "id": "sturmian-standard-word-directive-prefix-i64-array-bytes-output-v1",
  "algorithm": "sturmian_standard_word",
  "function_symbol": "sturmian_standard_word",
  "abi": "i64_array_bytes_output",
  "description": "Construct a finite standard Sturmian word from a bounded directive prefix using the standard-word recurrence.",
  "source": {
    "title": "Sturmian word",
    "discovery_index": "https://github.com/acmeism/RosettaCodeData/blob/1d475861d7141ef2fafff293d9339f56e4b0f5db/popular-tasks",
    "discovery_score": 24,
    "algorithm_reference": "https://www-igm.univ-mlv.fr/~berstel/Exposes/2007-05BerstelCAI.pdf",
    "algorithm_reference_title": "Sturmian Words, Sturmian Trees and Sturmian Graphs",
    "author": "Jean Berstel",
    "publication_year": 2007,
    "pinned_behavior": "Set s[-1]=b and s[0]=a. For each directive d_i in order, form s[i+1] by concatenating d_i copies of s[i] followed by s[i-1]. Return s[k]."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[k,d_0,...,d_(k-1)]",
    "step_domain": [0, 4],
    "first_directive_domain": [0, 2],
    "later_directive_domain": [1, 2],
    "maximum_valid_input_length": 5,
    "maximum_parseable_input_length": 6,
    "invalid_input_result": -1,
    "validation_order": "Reject null input, frame lengths outside 1..6, invalid step count, any frame length other than k+1, or a directive outside its position-specific domain before checking output storage."
  },
  "output": {
    "kind": "raw_byte_array",
    "encoding": "ASCII bytes a and b comprising s[k] in left-to-right order",
    "maximum_output_bytes": 41,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "zero_length_output_allows_null_pointer": false
  },
  "workspace": {
    "bytes": 512,
    "accounting": "Three fixed 41-byte word buffers use 123 bytes and the four-entry i64 directive array uses 32 bytes. The remaining allowance conservatively covers live lengths, loop indices, pointers/views, alignment, and ABI-local state across targets. Caller-owned input and output are excluded."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
