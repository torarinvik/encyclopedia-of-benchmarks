  "contract": {
    "operation": "Given f(x)=sum(a_i*x^i), return one g(x) such that g(x)^2=f(x) modulo x^N over F_998244353, or a no-root sentinel.",
    "input_layout": "[N, a_0, ..., a_(N-1)]",
    "n_range": [1, 64],
    "coefficient_range": [0, 998244352],
    "constant_coefficient_condition": "Any field element; leading zero coefficients are allowed.",
    "root_selection": "If f is zero modulo x^N, select g=0. Otherwise let v be the first nonzero degree; a root exists only if v is even and a_v is a square. Select the least nonnegative square root for b_(v/2), use the forced coefficient recurrence, and set unconstrained higher coefficients to zero.",
    "algorithm": "Tonelli-Shanks for the leading residue followed by a quadratic coefficient recurrence; independent oracle uses Cipolla and the binomial series.",
    "modulus": 998244353,
    "output_layout": "If a root exists, N little-endian signed 64-bit residues. If no root exists, one little-endian signed 64-bit value -1.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below 8*N returns -2 without writes. No-root input is valid and returns the one-word sentinel with status 8."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, a_0, ..., a_(N-1)]",
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 64,
    "maximum_bytes": 512,
    "success_result": "8*N bytes when a root exists; 8 bytes containing -1 when no root exists",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_root_result": 8,
    "no_root_encoding": "ffffffffffffffff",
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "One 64-element coefficient vector plus bounded Tonelli-Shanks scalar state."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
