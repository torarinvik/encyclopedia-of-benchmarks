{
  "schema_version": 1,
  "id": "substring-search-aarch64-byte-helper-v1",
  "algorithm": "substring_search",
  "function_symbol": "substring_search",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[text_length, pattern_length, text bytes..., pattern bytes...]",
    "text_length_range": [
      0,
      128
