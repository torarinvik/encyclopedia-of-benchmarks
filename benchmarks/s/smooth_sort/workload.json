      "role": "algorithm"
    }
  ],
  "contract": {
    "operation": "Sort all input values in ascending numeric order in place, then return the weighted checksum of the sorted array.",
    "input_layout": "[n, values[n]]",
    "array_length_range": [
      0,
      512
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "comparison": "signed integer ordering; duplicates are allowed and stability is unobservable",
    "checksum": "sum((zero_based_index + 1) * (sorted_value + 1_000_001))",
    "invalid_input_result": -1
  },
