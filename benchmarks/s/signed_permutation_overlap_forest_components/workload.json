    "maximum_valid_length": 9,
    "maximum_parseable_length": 10,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[cycle_count,(cycle_begin,cycle_end,component_root)*cycle_count]",
    "cycle_order": "increasing cycle_begin",
    "two_cycles": "included as isolated singleton components",
    "maximum_cycles": 9,
    "maximum_bytes": 224,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded signed permutation expansion, alternating-cycle labels and extents, stack, component labels, and staged output."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 1,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
