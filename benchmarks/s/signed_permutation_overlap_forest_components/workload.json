  "algorithm": "signed_permutation_overlap_forest_components",
  "function_symbol": "signed_permutation_overlap_forest_components",
  "abi": "i64_array_bytes_output",
  "description": "Bader–Moret–Yan two-scan stack construction of overlap-forest components.",
  "source": {
    "chapter": "Encyclopedia of Algorithms, Chapter 383",
    "chapter_doi": "10.1007/978-1-4939-2864-4_383",
    "operational_reference": "Bader, Moret, and Yan, sections 4–5 and Figure 2",
    "operational_doi": "10.1089/106652701753216503"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,signed_gene_0,...,signed_gene_(n-1)]",
    "size_range": [1, 8],
