{
  "schema_version": 1,
  "id": "sqrt-tree-static-range-minimum-v1",
  "algorithm": "sqrt_tree",
  "function_symbol": "sqrt_tree",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[item_count, query_count, value_0, ..., value_(n-1), left_0, right_0, ...]",
    "item_count_range": [1, 256],
    "query_count_range": [0, 256],
    "value_range": [-1000000000, 1000000000],
    "query_range": "inclusive zero-based [left,right], with 0 <= left <= right < item_count",
    "maximum_valid_input_values": 770,
    "maximum_parseable_input_values": 771,
    "invalid_result": -1
  },
  "output": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "one signed 64-bit little-endian minimum per query, in query order",
    "maximum_output_bytes": 2048,
    "success_result": "8 * query_count",
    "insufficient_output_capacity_result": -2,
    "null_nonempty_output_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Maximum staged range-minimum output buffer; tree preprocessing storage is fixed and bounded by the input limit."
  },
  "profile": {
    "aggregate": "minimum",
    "construction": "recursive sqrt decomposition with per-block prefixes and suffixes and a complete-block range table at each node",
    "block_size": "ceil(sqrt(node_segment_length)); final block may be shorter",
    "query_complexity": "O(log log n) worst case for the recursive construction",
    "preprocessing_and_storage": "O(n log log n)",
    "scope_note": "Static queries only; excludes the article's optimized O(1)-query power-of-two variant and update variants."
  },
  "notice": {
    "attribution": "Adapted from the recursive construction in the cp-algorithms Sqrt Tree article, credited to cp-algorithms contributors including alex65536, algmyr, adamant-pwn, jakobkogler, and wikku.",
    "source": "https://cp-algorithms.com/data_structures/sqrt-tree.html",
    "license": "CC BY-SA 4.0",
    "license_file": "LICENSE.txt",
    "modification_note": "Bounded to signed integer range-minimum queries, recursive non-power-of-two blocks, and packed little-endian output."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "cross_blocks_and_singletons",
      "input_values": [8, 5, 5, 9, -4, 12, 3, 7, -10, 6, 0, 7, 1, 3, 4, 6, 5, 5, 2, 4],
      "input_length": 20,
      "expected_result": 40,
      "expected_output_hex": "f6fffffffffffffffcfffffffffffffff6ffffffffffffff0700000000000000fcffffffffffffff"
    },
    {
      "id": "recursive_child_blocks",
      "input_values": [9, 5, 8, 7, 6, 5, 4, 3, 2, 1, 0, 0, 2, 3, 5, 6, 8, 1, 7, 2, 3],
      "input_length": 21,
      "expected_result": 40,
      "expected_output_hex": "06000000000000000300000000000000000000000000000001000000000000000500000000000000"
    },
    {
      "id": "single_item_repeated_queries",
      "input_values": [1, 3, -5, 0, 0, 0, 0, 0, 0],
      "input_length": 9,
      "expected_result": 24,
      "expected_output_hex": "fbfffffffffffffffbfffffffffffffffbffffffffffffff"
    },
    {
      "id": "empty_query_list",
      "input_values": [3, 0, 7, -2, 5],
      "input_length": 5,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_range",
      "input_values": [3, 1, 1, 2, 3, 0, 3],
      "input_length": 7,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "value_out_of_domain",
      "input_values": [1, 1, 1000000001, 0, 0],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ],
  "abi_cases": [
    {
      "id": "short_output_capacity",
      "input_values": [3, 1, 4, 2, 8, 0, 2],
      "input_length": 7,
      "input_is_null": false,
      "output_capacity": 7,
      "output_is_null": false,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null_output_with_query",
      "input_values": [1, 1, -5, 0, 0],
      "input_length": 5,
      "input_is_null": false,
      "output_capacity": 8,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null_output_without_queries",
      "input_values": [1, 0, 42],
      "input_length": 3,
      "input_is_null": false,
      "output_capacity": 0,
      "output_is_null": true,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "null_input_precedes_output_checks",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "output_capacity": 0,
      "output_is_null": false,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
