  "function_symbol": "suffix_array_inplace_readonly_integer",
  "abi": "i64_array_bytes_output",
  "description": "Read-only integer-alphabet suffix sorting by LMS reduction and induced sorting with the output array as bounded workspace.",
  "source": {
    "title": "Optimal In-Place Suffix Sorting",
    "authors": ["Zhize Li", "Jian Li", "Hongwei Huo"],
    "year": 2021,
    "reference": "Information and Computation, DOI 10.1016/j.ic.2021.104818; arXiv:1610.08305, Section 4",
    "url": "https://arxiv.org/html/1610.08305",
    "algorithm_attribution": "Read-only integer-alphabet, constant-workspace suffix sorting via LMS reduction and induced sorting.",
    "algorithm_description_url": "https://en.oi-wiki.org/string/sa-optimal-inplace/",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, symbols...]",
    "text_length_range": [0, 32],
    "symbol_range": "[0,text_length-1]",
    "exact_length": "1 + text_length",
    "maximum_valid_length": 33,
    "maximum_parseable_length": 34,
    "read_only": true,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "all original suffix starts in lexicographic order; the private sentinel suffix is omitted",
    "maximum_output_bytes": 256,
    "maximum_workspace_capacity_bytes": 264,
    "required_workspace_capacity_bytes": "8*(text_length+1)",
    "success_result": "8 * text_length bytes",
    "empty_text_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_workspace_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Maximum bounded call-frame state for packed bucket metadata, LMS/reduced-name words, and at most five recursion levels; all suffix-index sequence storage is in the caller output buffer."
  },
  "complexity": {
    "time": "O(n) per bounded recursive level; LMS reductions shrink by at least a factor of two, giving O(n) total induced-sorting work.",
    "space": "At most 2,048 bytes of fixed bounded call-frame state for n<=32; the caller output buffer supplies the n+1 suffix-index workspace slots."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Primary reference applies LMS naming and induced sorting; independent reference sorts complete suffixes by direct lexicographic comparison.",
