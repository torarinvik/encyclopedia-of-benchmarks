  "contract": {
    "operation": "Evaluate one SIR derivative right-hand-side call and return [dS,dI,dR].",
    "input_encoding": "[S, I, R, beta, k, t]",
    "state": "S, I, and R are finite binary64 population values in [0,1000000].",
    "parameters": "beta is in [0,0.001] and k is in [0,1].",
    "time": "t is in [0,140]; the pinned RHS validates but does not read t.",
    "source_evaluation_order": "dS = ((-beta)*S)*I; dI = ((beta*S)*I)-(k*I); dR = k*I. Preserve each multiplication and subtraction order from the Julia expressions.",
    "unused_state": "R is unpacked from u but not read in any derivative expression.",
    "output_encoding": "[du[1],du[2],du[3]] as binary64 values.",
    "errors": "Null input, malformed input length, nonfinite or out-of-range input returns -1. Input checks happen before output checks. For valid input, null output or capacity below three returns -2 without writes. Success writes three elements and returns 3."
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[S,I,R,beta,k,t]",
    "exact_length": 6,
