  "primary_oracle_entry_point": "expected_result(values, input_length=None, input_is_null=False)",
  "independent_oracle": "benchmarks/s/string_compression_ii/independent_oracle.py",
  "independent_oracle_entry_point": "expected_result(values, input_length=None, input_is_null=False)",
  "sources": {
    "primary_problem_definition": "https://leetcode.com/problems/string-compression-ii/",
    "run_length_convention": "https://leetcode.com/problems/string-compression/",
    "source_use": "Public pages used for the problem operation and RLE length convention; no code or examples are reused."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,k,symbol_0,...,symbol_(n-1)]",
    "n_range": [0, 12],
    "deletion_budget_range": "0..n",
    "symbol_range": [0, 25],
    "symbol_mapping": "lowercase letters a=0 through z=25",
    "exact_framing": true,
    "maximum_valid_length": 14,
    "maximum_parseable_length": 15,
    "null_input_result": -1,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "Minimum encoded length after deleting at most k symbols.",
    "result_range": [0, 12],
    "empty_retained_string_result": 0,
    "invalid_input_result": -1
  },
  "contract": {
    "run_length": "A run of length 1 costs 1; a run of length r>=2 costs 1 plus the number of decimal digits in r. The run symbol itself costs one character.",
    "primary": "Prefix DP tracks input position and exact deletions used. Delete the next symbol, or start a run with the next symbol, scan endpoint j, retain any positive number c of matching symbols in the span, delete the rest, and add the encoded cost of c.",
    "independent_reference": "Enumerate all deletion masks with at most k bits set; directly count maximal equal-symbol runs in each retained sequence.",
    "at_most_semantics": "Return the minimum over every exact deletion count from zero through k.",
    "complexity": "The primary is O(n^3 k) time and O(nk) space; the independent exhaustive reference is O(n*2^n) time and O(n) space."
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded prefix-DP table and fixed-size scan state for n<=12."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
