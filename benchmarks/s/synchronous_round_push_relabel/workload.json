    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "maximum directed source-to-sink flow value",
    "valid_result_range": [0, 360],
    "invalid_input_result": -1
  },
  "algorithm_profile": {
    "method": "Synchronous-round push-relabel core described in Section 3 of Baumstark, Blelloch, and Shun.",
    "initialization": "Saturate source arcs in ascending destination order; source height N, all other heights zero.",
    "round_barriers": "At each round, freeze the active set and heights; scan active vertices ascending and each neighbor ascending; accumulate excess deltas separately; compute temporary heights after all pushes; apply heights together; commit excess together.",
    "active_vertices": "Nonterminals with positive excess and height less than N.",
    "relabel": "For each old active vertex still positive after accumulated round changes, set temporary height to one plus the minimum old height of a positive-residual neighbor; use N+1 when there is no such neighbor.",
    "excluded_heuristics": "No global/gap relabel heuristic and no Section 3.1 multi-relabel conflict-resolution optimization.",
    "maximum_result_derivation": "At most 24 input arcs leave the source, each with capacity at most 15, so any flow value is at most 360."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "source": {
    "method_inventory_url": "https://github.com/fcBK-maxflow/fcBK-benchmark",
    "paper_doi": "https://doi.org/10.1007/978-3-662-48350-3_10",
    "paper_long_version": "https://arxiv.org/abs/1507.01926",
    "author_pdf": "https://www.cs.cmu.edu/~blelloch/papers/BBS15.pdf",
    "reuse": "Algorithm description only; independently authored code and fixtures."
  },
