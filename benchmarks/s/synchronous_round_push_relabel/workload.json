  "abi": "i64_array_scalar",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,s,t,(u,v,capacity)*M]",
    "vertex_indexing": "zero_based",
    "vertices_range": [2, 8],
    "arc_record_count_range": [0, 24],
    "capacity_range": [0, 15],
    "self_loops": "invalid",
    "parallel_arcs": "allowed_and_summed",
    "antiparallel_arcs": "allowed",
    "maximum_valid_input_length": 76,
