    "tie_rule": "Among equal scores choose the lowest eligible existing bin ID; a new bin is selected only if its score is strictly lower.",
    "maximum_output_bytes": 520,
    "maximum_output_elements": 65,
    "success_result": "8 * (item_count + 1)",
    "invalid_result": -1,
