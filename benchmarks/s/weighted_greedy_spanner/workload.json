{
  "schema_version": 1,
  "id": "encyclopedia-weighted-graph-greedy-spanner-i64-array-bytes-output-v1",
  "algorithm": "weighted_greedy_spanner",
  "function_symbol": "weighted_greedy_spanner",
  "abi": "i64_array_bytes_output",
  "description": "Chapter Algorithm I: bounded weighted greedy (2k-1)-spanner construction.",
  "source": {
    "title": "Simple Algorithms for Spanners in Weighted Graphs",
    "authors": ["Surender Baswana", "Sandeep Sen"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_10",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_10",
    "algorithm_attribution": "Algorithm I, the Althöfer et al. increasing-weight greedy spanner.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, m, k, (u, v, weight)...]",
    "n_range": [2, 8],
    "m_range": [0, 28],
    "k_range": [1, 3],
    "weight_range": [1, 32],
    "endpoint_rule": "0 <= u < v < n; no duplicate undirected edges",
    "edge_order": "Any input order; processing order is (weight, u, v).",
    "exact_length": "3 + 3 * m",
    "maximum_valid_length": 87,
    "maximum_parseable_length": 88,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_vector",
    "encoding": "one canonical 0/1 selection byte per input edge, in input order",
    "maximum_bytes": 28,
    "success_result": "m bytes written",
    "empty_output_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded 8-vertex adjacency matrix, Dijkstra state, and staged edge flags."
  },
  "contract": {
    "stretch": "2 * k - 1",
    "edge_processing_order": "Increasing (weight, u, v).",
    "selection_rule": "Retain edge (u,v,w) iff its current-spanner shortest-path distance is greater than (2*k-1)*w.",
    "distance_tie_rule": "Dijkstra settles equal-distance vertices by smaller vertex ID; edge processing ties use endpoint order."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The package oracle follows the greedy edge sequence with Dijkstra; the independent verifier recomputes all-pairs distances with Floyd–Warshall after each selected edge.",
  "cases": [
