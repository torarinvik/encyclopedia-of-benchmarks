    {"id":"triangle_spanner","input_values":[3,3,2,0,1,1,1,2,1,0,2,2],"input_length":12,"output_capacity":3,"expected_result":3,"expected_output_hex":"010100"},
    {"id":"path_makes_heavy_shortcut_redundant","input_values":[4,4,2,0,1,2,1,2,2,2,3,2,0,3,5],"input_length":15,"output_capacity":4,"expected_result":4,"expected_output_hex":"01010100"},
    {"id":"stretch_one_retains_nonredundant_edge","input_values":[3,3,1,0,1,2,1,2,2,0,2,3],"input_length":12,"output_capacity":3,"expected_result":3,"expected_output_hex":"010101"},
    {"id":"weight_tie_uses_endpoint_order","input_values":[3,3,2,0,2,2,0,1,1,1,2,1],"input_length":12,"output_capacity":3,"expected_result":3,"expected_output_hex":"000101"},
    {"id":"disconnected_edge","input_values":[4,1,3,2,3,7],"input_length":6,"output_capacity":1,"expected_result":1,"expected_output_hex":"01"},
    {"id":"maximum_complete_graph_output","input_values":[8,28,1,0,1,1,0,2,1,0,3,1,0,4,1,0,5,1,0,6,1,0,7,1,1,2,1,1,3,1,1,4,1,1,5,1,1,6,1,1,7,1,2,3,1,2,4,1,2,5,1,2,6,1,2,7,1,3,4,1,3,5,1,3,6,1,3,7,1,4,5,1,4,6,1,4,7,1,5,6,1,5,7,1,6,7,1],"input_length":87,"output_capacity":28,"expected_result":28,"expected_output_hex":"01010101010101010101010101010101010101010101010101010101"},
    {"id":"invalid_k","input_values":[2,0,0],"input_length":3,"output_capacity":0,"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid_zero_weight","input_values":[2,1,2,0,1,0],"input_length":6,"output_capacity":1,"expected_result":-1,"expected_output_hex":""},
    {"id":"duplicate_edge","input_values":[3,2,2,0,1,1,0,1,2],"input_length":9,"output_capacity":2,"expected_result":-1,"expected_output_hex":""},
    {"id":"trailing_input","input_values":[2,0,2,0],"input_length":4,"output_capacity":0,"expected_result":-1,"expected_output_hex":""},
    {"id":"over_bound_parser_input","input_values":[8,28,1,0,1,1,0,2,1,0,3,1,0,4,1,0,5,1,0,6,1,0,7,1,1,2,1,1,3,1,1,4,1,1,5,1,1,6,1,1,7,1,2,3,1,2,4,1,2,5,1,2,6,1,2,7,1,3,4,1,3,5,1,3,6,1,3,7,1,4,5,1,4,6,1,4,7,1,5,6,1,5,7,1,6,7,1,0],"input_length":88,"output_capacity":28,"expected_result":-1,"expected_output_hex":""},
