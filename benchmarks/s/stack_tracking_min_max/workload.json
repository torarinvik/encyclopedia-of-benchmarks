{
  "schema_version": 1,
  "id": "stack-tracking-min-max-python-bounded-trace-v1",
  "algorithm": "stack_tracking_min_max",
  "function_symbol": "stack_tracking_min_max",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[capacity,op_count,op_stream...]",
    "capacity_range": [
      0,
      64
    ],
    "op_count_range": [
      0,
      64
    ],
    "opcodes": {
      "1": "push followed by signed-i32 value",
      "2": "pop",
      "3": "get_current_min",
      "4": "get_current_max",
      "5": "stack_is_valid"
    },
    "exact_operation_count": true,
    "no_trailing_values": true,
    "maximum_input_values": 130,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "tagged_i64_le_operation_records",
    "encoding": "For each executed operation, three i64-LE words [opcode,tag,value]. Tags: 0=int; 1=bool; 2=None; 3=negative infinity (value=0); 4=terminal max-size exception (value=1). Push returns True. Empty pop/min/max return -inf. Valid returns bool. An overflow push emits its tag-4 record and stops execution; subsequent operations are ignored.",
    "success_result": "number of output bytes written",
    "maximum_bytes": 1536,
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "no_partial_writes": true
  },
  "workspace": {
    "bytes": 1536
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
