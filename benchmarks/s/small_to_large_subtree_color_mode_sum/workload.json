  "workspace": {
    "bytes": 73728,
    "meaning": "Conservative maximum local scratch budget (72 KiB), including the fixed 64-by-64 frequency and key tables; the output buffer is separate and bounded by 512 bytes."
  },
  "algorithm_details": {
    "primary": "Compress colors, process vertices in reverse parent order, retain each node's largest child map, merge entries from the smaller child maps, add the node color, and record the sum of modal color labels.",
    "independent_oracle": "For each vertex, classify every candidate vertex by climbing its parent chain, build that subtree's frequency table, and sum the modal labels.",
    "complexity": "O(N^2 log N) entry visits in the bounded small-to-large profile, O(N^2) fixed map storage; direct compressed-color updates are O(1)."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
