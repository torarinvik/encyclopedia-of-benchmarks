  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,parent[1..N-1],color[0..N-1]]",
    "root": 0,
    "vertex_count_range": [1, 64],
    "parent_rule": "For each vertex v with 1 <= v < N, 0 <= parent[v] < v.",
    "color_range": [-1000, 1000],
    "exact_length": "2*N",
    "maximum_valid_length": 128,
    "maximum_parseable_length": 129,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "For each vertex in ascending ID order, sum the color labels attaining the maximum frequency in its rooted subtree.",
    "maximum_output_bytes": 512,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
