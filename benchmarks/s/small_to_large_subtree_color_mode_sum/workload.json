  "abi": "i64_array_bytes_output",
  "description": "Merge per-subtree color-frequency maps small-to-large and return the sum of modal labels for each subtree.",
  "source": {
    "title": "Smaller to Larger",
    "authors": ["Joël Benjamin Huber"],
    "url": "https://soi.ch/wiki/smaller-to-larger/",
    "license": "not stated/unknown; algorithm idea only",
