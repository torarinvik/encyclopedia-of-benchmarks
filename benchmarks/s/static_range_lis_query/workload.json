{
  "schema_version": 1,
  "id": "library-checker-static-range-lis-query-bounded-v1",
  "algorithm": "static_range_lis_query",
  "function_symbol": "static_range_lis_query",
  "abi": "i64_array_bytes_output",
  "description": "Answer strict LIS-length queries on half-open subarrays of a permutation.",
  "source": {
    "name": "Library Checker: Static Range LIS Query",
    "task_url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/static_range_lis_query/task.md",
    "limits_url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/static_range_lis_query/info.toml",
    "repository_license": "Apache-2.0",
    "reuse": "Task semantics only; local code and fixtures are independently authored."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,permutation[N],(left,right)*Q]",
    "n_range": [1, 128],
    "q_range": [1, 32],
    "permutation_values": "each integer in [0,N) exactly once",
    "query_rule": "0 <= left <= right <= N; intervals are half-open",
    "maximum_valid_length": 194,
    "maximum_parseable_length": 195,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "operation": "For each query, return the length of the strictly increasing subsequence of permutation[left:right].",
    "algorithm": "Scan each queried range with lower-bound patience-sorting tails; replace the first tail >= current value or append when none exists.",
    "empty_range_result": 0,
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Input framing, permutation validity, and all query endpoints are checked before output pointer and capacity."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "one strict LIS length per query, in query order",
    "element_width_bytes": 8,
    "maximum_elements": 32,
    "maximum_bytes": 256,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Permutation validation bitmap, one N-element tails array, staged query results, and local bookkeeping."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "multiple-subranges-and-empty-range",
      "input_values": [6,5,3,0,4,1,5,2,0,6,0,3,1,5,2,2,3,6],
      "input_length": 18,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "03000000000000000200000000000000030000000000000000000000000000000200000000000000"
    },
    {
      "id": "decreasing-permutation",
      "input_values": [5,3,4,3,2,1,0,0,5,1,4,2,2],
      "input_length": 13,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000000000000000000"
    },
    {
      "id": "short-output-capacity",
      "input_values": [3,1,2,0,1,0,3],
      "input_length": 7,
      "output_capacity": 7,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [3,1,2,0,1,0,3],
      "input_length": 7,
      "output_capacity": 8,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "duplicate-permutation-value",
      "input_values": [4,1,0,1,1,3,0,4],
      "input_length": 8,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-range-order",
      "input_values": [3,1,0,1,2,2,1],
      "input_length": 7,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-input-before-null-output",
      "input_values": [3,1,0,1,3,0,3],
      "input_length": 7,
      "output_capacity": 0,
      "output_is_null": true,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "overlong-frame",
      "input_values": [3,1,0,1,2,0,3,99],
      "input_length": 8,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
