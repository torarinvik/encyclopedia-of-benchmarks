    {"id":"repeated-symbols","input_values":[4,97,97,97,97],"input_length":5,"output_capacity":32,"expected_result":32,"expected_output_hex":"0300000000000000020000000000000001000000000000000000000000000000"},
    {"id":"periodic-ababa","input_values":[5,97,98,97,98,97],"input_length":6,"output_capacity":40,"expected_result":40,"expected_output_hex":"04000000000000000200000000000000000000000000000003000000000000000100000000000000"},
