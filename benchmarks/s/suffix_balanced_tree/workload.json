  },
  "oracle": "benchmarks/s/suffix_balanced_tree/primary_oracle.py",
  "independent_oracle": "benchmarks/s/suffix_balanced_tree/independent_oracle.py",
  "contract": {
    "operation": "Return all zero-based suffix starts in lexicographic order using reverse insertion into a scapegoat-style balanced suffix tree.",
    "input_layout": "[N, symbol_0, ..., symbol_(N-1)]",
    "symbol_range": [0, 255],
    "n_range": [0, 32],
    "comparator": "Compare first symbols; when equal, compare the stored order tags of the two successor suffixes. The empty suffix has tag zero.",
    "algorithm": "Insert suffix starts N-1 down to 0 into a weight-balanced BST. Rebuild an over-heavy subtree from its in-order node list, assigning midpoint tags within its inherited tag interval. The tree's in-order traversal is the suffix array.",
    "balance_rule": "Rebuild if 4*max(left_size,right_size) >= 3*subtree_size.",
    "tag_range": "Integer labels in [0,2^62); the 32-symbol bound leaves enough subdivision depth between rebuilds.",
    "output_layout": "All zero-based suffix starts as little-endian signed 64-bit integers.",
    "error_policy": "Malformed input returns -1. A null output pointer or capacity below 8*N returns -2, including for empty input. A nonnull output buffer with zero capacity succeeds for N=0 and returns 0.",
    "complexity": "The successor-tag comparator takes O(1). Scapegoat-style insertion and subtree rebuilding take O(N log N) amortized total time; in-order output takes O(N), and storage is O(N).",
    "tag_limit": 4611686018427387904
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 33,
    "maximum_parseable_length": 33,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 32,
    "maximum_bytes": 256,
    "success_result": "8*N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
