{
  "schema_version": 1,
  "id": "sorted-array-to-bst-v1",
  "algorithm": "sorted_array_to_bst",
  "input": {
    "type": "strictly increasing signed 32-bit integer array",
    "length_range": [
      0,
      64
    ],
    "result": "number of nodes",
    "output_encoding": "preorder tree serialization: null is 00; node is 01 followed by signed 32-bit little-endian key, then left and right child serializations",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "empty_array",
      "input_values": [],
      "expected_result": 0,
      "expected_output_hex": "00"
    },
    {
      "id": "one_key",
      "input_values": [
        7
      ],
      "expected_result": 1,
      "expected_output_hex": "01070000000000"
    },
    {
      "id": "two_keys_lower_middle",
      "input_values": [
        -1,
        1
      ],
      "expected_result": 2,
      "expected_output_hex": "01ffffffff0001010000000000"
    },
    {
      "id": "even_length_lower_median",
      "input_values": [
        1,
        3,
        5,
        7
      ],
      "expected_result": 4,
      "expected_output_hex": "01030000000101000000000001050000000001070000000000"
    },
    {
      "id": "odd_length_center",
      "input_values": [
        -9,
        -3,
        0,
        4,
        12
      ],
      "expected_result": 5,
      "expected_output_hex": "010000000001f7ffffff0001fdffffff0000010400000000010c0000000000"
    },
    {
      "id": "balanced_ten_keys",
      "input_values": [
        -5,
        -4,
        -3,
        -2,
        -1,
        0,
        1,
        2,
        3,
        4
      ],
      "expected_result": 10,
      "expected_output_hex": "01ffffffff01fcffffff01fbffffff000001fdffffff0001feffffff000001020000000100000000000101000000000001030000000001040000000000"
    },
    {
      "id": "signed_i32_boundaries",
      "input_values": [
        -2147483648,
        0,
        2147483647
      ],
      "expected_result": 3,
