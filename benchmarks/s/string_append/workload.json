{
  "schema_version": 1,
  "id": "string-append-ascii-bytes-v1",
  "algorithm": "string_append",
  "function_symbol": "string_append",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "argument_order": [
      "length_a",
      "length_b",
      "string_a_ascii...",
      "string_b_ascii..."
    ],
    "each_string_length_range": [
      0,
      64
    ],
    "ascii_codepoint_range": [
      32,
      126
    ],
    "embedded_nul_allowed": false,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "byte_array",
    "semantics": "string A followed by string B without a trailing NUL",
    "comparison": "exact bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "append-words",
      "input_values": [
        5,
        6,
        72,
        101,
        108,
        108,
        111,
        32,
        87,
        111,
        114,
        108,
        100
      ],
      "input_length": 13,
      "expected_result": 11,
      "expected_output_hex": "48656c6c6f20576f726c64"
    },
    {
      "id": "append-to-empty",
      "input_values": [
        0,
        5,
        119,
        111,
        114,
        108,
        100
      ],
      "input_length": 7,
      "expected_result": 5,
      "expected_output_hex": "776f726c64"
    },
    {
      "id": "append-empty",
      "input_values": [
        5,
        0,
        104,
        101,
        108,
        108,
        111
      ],
      "input_length": 7,
      "expected_result": 5,
      "expected_output_hex": "68656c6c6f"
    },
    {
      "id": "both-empty",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "punctuation",
      "input_values": [
        3,
        3,
        97,
        98,
        99,
        33,
        63,
        46
      ],
      "input_length": 8,
      "expected_result": 6,
      "expected_output_hex": "616263213f2e"
    },
    {
      "id": "malformed-packed-length",
      "input_values": [
        2,
        1,
        65
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-nul-codepoint",
      "input_values": [
        1,
        0,
        0
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid-nonprintable-codepoint",
      "input_values": [
        1,
        0,
        31
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "string-length-above-bound",
      "input_values": [
        65,
        0
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
