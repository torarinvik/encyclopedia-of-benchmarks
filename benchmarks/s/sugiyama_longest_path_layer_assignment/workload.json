  "input": {
    "kind": "signed_i64_array",
    "encoding": "[vertex_count,edge_count,(source,target)*edge_count]",
    "vertex_count_range": [0, 32],
    "edge_count_range": [0, 128],
    "vertex_ids": "zero-based",
    "graph": "directed acyclic graph; all edges must have valid endpoints and be unique",
    "maximum_valid_length": 258,
    "maximum_parseable_length": 259,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_byte_array",
    "encoding": "[layer_count,layer_id(vertex_0),...,layer_id(vertex_n_minus_1)]",
    "layer_direction": "sources have lower layer IDs; sinks occupy layer_count-1",
    "within_layer_order": "ascending vertex ID; vertex IDs are implicit in output positions",
    "long_edges": "remain as edges spanning multiple layers; dummy insertion is excluded",
    "empty_graph": [0],
    "maximum_bytes": 264,
    "success_result": "8*(vertex_count+1)",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "contract": {
    "primary": "Repeatedly collect all remaining sinks in ascending vertex ID, assign them the next sink-removal depth together, remove that batch, and continue until no vertices remain. A nonempty remainder with no sink is a directed cycle and invalid.",
    "independent": "Compute a source-first topological order with Kahn's algorithm, then compute longest distances to a sink in reverse topological order. Convert each distance d to layer height-1-d.",
    "minimum_height": "The layer count is one plus the maximum number of edges on any directed path; the empty graph has zero layers.",
    "distinctness": "Layer assignment is distinct from local topological ordering and from the local Sugiyama barycentric crossing-reduction pass, which takes a proper layered hierarchy as input."
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed adjacency and sink-round arrays for at most 32 vertices, with bounded staged output."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
