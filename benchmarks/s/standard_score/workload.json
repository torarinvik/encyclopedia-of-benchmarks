{
  "schema_version": 1,
  "id": "standard-score-binary64-triple-v1",
  "algorithm": "standard_score",
  "function_symbol": "standard_score",
  "input": {
    "kind": "finite_binary64_triple",
    "layout": "[value, mean, stdDev]",
    "value_range": [-1000000.0, 1000000.0],
    "mean_range": [-1000000.0, 1000000.0],
    "std_dev_ranges": [[-1000000.0, -0.000001], [0.000001, 1000000.0]],
    "formula": "(value - mean) / stdDev",
    "invalid_result": -1e300
  },
  "output": "binary64 standard score",
  "cases": [
    {"id": "source_formula_positive", "input_values": [4.0, 2.0, 1.0], "expected_result": 2.0},
    {"id": "negative_score", "input_values": [10.0, 12.0, 2.0], "expected_result": -1.0},
    {"id": "negative_value", "input_values": [-5.0, 1.0, 2.0], "expected_result": -3.0},
    {"id": "negative_std_dev", "input_values": [1.0, -5.0, -2.0], "expected_result": -3.0},
    {"id": "zero_score", "input_values": [1.0, 1.0, 0.5], "expected_result": 0.0},
    {"id": "smallest_positive_std_dev", "input_values": [0.000001, 0.0, 0.000001], "expected_result": 1.0},
    {"id": "smallest_negative_std_dev", "input_values": [0.0, 0.000001, -0.000001], "expected_result": 1.0},
    {"id": "largest_result", "input_values": [1000000.0, -1000000.0, 0.000001], "expected_result": 2000000000000.0},
    {"id": "negative_large_result", "input_values": [-1000000.0, 1000000.0, 0.000001], "expected_result": -2000000000000.0},
    {"id": "maximum_positive_std_dev", "input_values": [1000000.0, 0.0, 1000000.0], "expected_result": 1.0},
    {"id": "minimum_negative_std_dev", "input_values": [0.0, 1000000.0, -1000000.0], "expected_result": 1.0},
    {"id": "zero_std_dev_invalid", "input_values": [1.0, 0.0, 0.0], "expected_result": -1e300},
    {"id": "value_out_of_range", "input_values": [1000001.0, 0.0, 1.0], "expected_result": -1e300}
  ],
  "measurement": {
    "comparison_model": "float64_triple_call",
    "input_scaled_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  }
}
