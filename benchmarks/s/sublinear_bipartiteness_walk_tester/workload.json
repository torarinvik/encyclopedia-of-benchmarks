  "function_symbol": "sublinear_bipartiteness_walk_tester",
  "pinned_source": {
    "title": "Testing Bipartiteness of Graphs in Sublinear Time",
    "authors": [
      "Oded Goldreich",
      "Dana Ron"
    ],
    "doi": "10.1007/978-1-4939-2864-4_701",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_701",
    "summarized_original_work": "Goldreich and Ron's bounded-degree bipartiteness tester, building on the incidence-query model of Kaufman, Krivelevich, and Ron.",
    "license": "No source-code license asserted; clean-room implementation of the mathematical walk/test rule"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,d,m,edges...,T,R,L,start_vertices...,walk_draws...]",
    "vertex_count_range": [
      1,
      16
    ],
    "degree_bound_range": [
      3,
      4
    ],
    "maximum_edge_count": 32,
    "graph_rule": "Undirected simple graph, canonical edges 0<=u<v<N, maximum degree at most d.",
    "starts_range": [
      1,
      4
    ],
    "walks_per_start_range": [
      1,
      8
    ],
    "steps_per_walk_range": [
      1,
      8
    ],
    "choice_rule": "For each step use a supplied draw in 0..2d-1; choose the indexed neighbor for a draw below current degree and stay otherwise.",
    "maximum_valid_length": 330,
    "invalid_result": -1
  },
  "contract": {
    "algorithm": "For each start, union vertices reached by all walks according to parity of real edge traversals; reject when any vertex appears in both parity classes.",
    "transition_rule": "Neighbors are indexed by ascending ID. Choices d..2d-1 and choices beyond the current degree are lazy self-loops.",
    "randomness_projection": "Start vertices and transition draws are supplied explicitly; this records one execution and makes no per-instance probabilistic guarantee."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[accept_bit]",
    "maximum_bytes": 8,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
