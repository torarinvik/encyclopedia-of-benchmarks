{
  "schema_version": 1,
  "id": "segment-tree-update-i64-trace-v1",
  "algorithm": "segment_tree_update",
  "function_symbol": "segment_tree_update_benchmark",
  "input": {
    "kind": "packed_i64_array",
    "encoding": "[n, initial_values[n], operation_count, (type,arg1,arg2)*operation_count]",
    "n_range": [
      1,
      64
    ],
    "operation_count_range": [
      1,
      64
    ],
    "initial_and_replacement_value_range": [
      -1000000,
      1000000
    ],
    "operations": {
      "0": "Query inclusive range [arg1,arg2], requiring 0 <= arg1 <= arg2 < n",
      "1": "Replace element arg1 with arg2, requiring 0 <= arg1 < n"
    },
    "length_formula": "n+2+3*operation_count",
    "maximum_valid_input_values": 258,
    "maximum_parseable_input_values": 259,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
