  "algorithm": "shortest_job_first",
  "function_symbol": "shortest_job_first",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[job_count, arrival_times[job_count], burst_times[job_count]]",
    "job_count_range": [
      0,
      32
    ],
    "arrival_time_range": [
      0,
      64
    ],
    "burst_time_range": [
      1,
      128
    ],
    "zero_burst_policy": "invalid for nonempty jobs because the pinned source never counts zero-burst jobs as complete",
    "source_minimum_time_sentinel": 999999999,
    "maximum_valid_array_length": 65,
    "maximum_parseable_array_length": 67,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[job_count, waiting_times[job_count], turnaround_times[job_count]]",
    "algorithm_semantics": "preemptive shortest remaining time first, one time unit per dispatch",
    "tie_semantics": "strictly smaller remaining time preempts; scanning input order and persistent current-job state match the pinned implementation",
    "turnaround_semantics": "burst time plus waiting time, elementwise for equal-length lists",
    "successful_result": "number of output bytes written",
    "maximum_output_bytes": 520,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "null_output_result": -2
  },
  "workspace": {
    "bytes": 520,
    "meaning": "Maximum count-prefixed waiting and turnaround vectors for 32 jobs."
  },
  "measurement": {
