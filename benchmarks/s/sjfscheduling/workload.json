    "arrival_time_range": [
      0,
      255
    ],
    "burst_time_range": [
      1,
      255
    ],
    "maximum_valid_input_length": 129,
    "maximum_parseable_input_length": 130,
    "exact_packed_shape": "Exactly 1 + 2 * process_count signed-i32 words.",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i32_array",
    "encoding": "Original input indices in nonpreemptive SJF completion order.",
    "valid_output_bytes_range": [
      0,
      256
    ],
    "maximum_output_bytes": 256,
    "success_result": "output byte length",
    "invalid_input_result": -1,
    "null_output_result": -2,
