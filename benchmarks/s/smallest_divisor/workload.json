{
  "id": "smallest-divisor-v1",
  "algorithm": "smallest_divisor",
  "contract": {
    "input": "A packed signed-integer array containing threshold followed by 1 to 256 positive values no greater than 1,000,000.",
    "output": "The least positive divisor for which the sum of the rounded-up quotients is at most threshold.",
    "invalid_input_result": -1,
    "no_feasible_divisor_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
