    "leaf_order": "Sort matching starts by lexicographic suffix order, with the internal terminator smaller than ASCII.",
    "setup_scope": "The bounded call builds the suffix tree before querying; no query-only complexity claim is made.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
