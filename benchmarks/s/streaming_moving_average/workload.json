{
  "schema_version": 1,
  "id": "streaming-moving-average-packed-f64-v1",
  "algorithm": "streaming_moving_average",
  "function_symbol": "streaming_moving_average",
  "input": {
    "kind": "window_count_then_signed_i32_values",
    "layout": "[window_size, n, values[0..n]]",
    "window_size_range": [
      1,
      256
    ],
    "count_range": [
      1,
      256
    ],
    "value_range": [
      -2147483648,
      2147483647
    ],
    "output": "n little-endian IEEE-754 binary64 averages, one after each update; early results average the available partial window",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "cases": [
    {
      "id": "upstream_window_3",
      "input_values": [
        3,
        4,
        10,
        12,
        2,
        1
      ],
      "expected_result": 32,
      "expected_output_hex": "0000000000002440000000000000264000000000000020400000000000001440"
    },
    {
      "id": "upstream_window_5",
      "input_values": [
        5,
        2,
        2,
        3
      ],
      "expected_result": 16,
      "expected_output_hex": "00000000000000400000000000000440"
    },
    {
