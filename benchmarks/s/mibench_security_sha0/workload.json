  "contract": {
    "operation": "Hash a byte string with the original SHA 160-bit compression function, using one 512-bit padded block.",
    "input_layout": "[message_length, message_bytes...]",
    "message_length_range": [0, 55],
    "padding": "Append 0x80, zero-fill through byte 55, and append the 64-bit big-endian message bit length.",
    "schedule": "W[0..15] are big-endian words; W[t] = W[t-3] XOR W[t-8] XOR W[t-14] XOR W[t-16] for t=16..79, with no one-bit rotation. This is the defining difference from SHA-1.",
    "output": "20 raw digest bytes in big-endian state-word order.",
    "invalid_result": -1,
    "output_error_result": -2
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "message byte count followed by that many byte values",
    "exact_length": "1 + message_length",
    "maximum_valid_input_length": 56,
    "maximum_parseable_input_length": 57,
    "message_length_range": [0, 55],
    "byte_range": [0, 255],
    "invalid_input_result": -1
  },
