    {"id": "signed_zero_sum", "input_values": [0, -1, 1, -1, 1], "expected_result": 6},
    {"id": "duplicate_positions", "input_values": [2, 2, 2], "expected_result": 2},
    {"id": "zero_can_be_included", "input_values": [2, 3, -1, 0], "expected_result": 2},
