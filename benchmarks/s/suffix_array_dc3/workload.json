  "algorithm": "suffix_array_dc3",
  "function_symbol": "suffix_array_dc3",
  "abi": "i64_array_bytes_output",
  "description": "Construct a suffix array with the DC3 modulo-three sample, recursive triple ranks and R0/R12 merge.",
  "source": {
    "title": "Suffix Array Construction",
    "authors": ["Juha Kärkkäinen"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_412",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_412",
    "algorithm_attribution": "Kärkkäinen–Sanders–Burkhardt DC3 difference-cover suffix-array construction.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, byte_symbols...]",
    "text_length_range": [0, 16],
    "symbol_range": [0, 255],
    "exact_length": "1 + text_length",
    "maximum_valid_length": 17,
    "maximum_parseable_length": 18,
    "includes_nul": true,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "all suffix starts in lexicographic order",
    "maximum_output_bytes": 128,
    "success_result": "8 * text_length bytes",
    "empty_text_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Bounded recursive DC3 frames and maximum suffix output staging."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The package oracle recursively orders R12 by triple ranks, then merges R0; the independent verifier sorts complete suffix values directly.",
