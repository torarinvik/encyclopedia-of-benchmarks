  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[bid,k,(breakpoint,load)[k]]",
    "bid_range": [0, 16],
    "step_count_range": [1, 8],
    "breakpoint_range": [0, 15],
    "load_range": [0, 16],
    "breakpoint_rule": "Strictly increasing; first breakpoint is zero.",
    "allocation_rule": "Nonincreasing right-continuous step function, zero on [16,infinity).",
    "maximum_valid_length": 18,
    "invalid_result": -1
  },
  "contract": {
    "payment": "P(b)=b*w(b)+integral_b^infinity w(u)du, with h_i=0.",
    "output": "[w(b),P(b)]",
    "arithmetic": "Exact integer area on unit-grid breakpoints and loads.",
    "profile_scope": "The allocation rule is supplied; this profile computes its truthful payment under the chapter's monotonicity characterization and does not construct a mechanism."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[allocation_load,payment]",
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 16,
    "meaning": "Two-word staged output: current allocation and exact payment."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 3,
    "warmup_rounds": 1,
    "repetitions_per_sample": 3
  },
  "cases": [
    {
      "id": "step-area-after-bid",
