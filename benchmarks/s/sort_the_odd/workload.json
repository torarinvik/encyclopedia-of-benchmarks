{
  "schema_version": 1,
  "id": "elixir-sort-the-odd-weighted-checksum-v1",
  "algorithm": "sort_the_odd",
  "function_symbol": "sort_the_odd_benchmark",
  "input": {
    "kind": "i64_array",
    "encoding": "raw signed 64-bit integers; ABI length is item count",
    "maximum_length": 256,
    "value_range": [
      -1000000,
      1000000
    ],
    "invalid_result": -1,
    "maximum_input_length": 257
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "weighted checksum of the sorted-odd output sequence",
    "checksum": "sum((zero_based_index + 1) * (output_value + 1000001))",
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": 0
    },
    {
      "id": "two_odd_values",
      "input_values": [
        7,
        1
      ],
      "input_length": 2,
      "expected_result": 3000018
    },
    {
      "id": "published_mixed_example",
      "input_values": [
        5,
        8,
        6,
        3,
        4
      ],
      "input_length": 5,
      "expected_result": 15000092
    },
    {
      "id": "negative_odd_values",
      "input_values": [
        1,
        2,
        3,
        -1,
        -3,
        5
      ],
      "input_length": 6,
      "expected_result": 21000068
    },
    {
