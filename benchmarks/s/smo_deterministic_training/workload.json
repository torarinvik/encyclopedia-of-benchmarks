  "contract": {
    "operation": "Run a deterministic finite-pass trace of Platt's complete SMO training loop for a linear binary SVM.",
    "input_encoding": "[N,D,C_milli,pass_cap,labels[N],X[N*D]]",
    "integer_valued_float64_fields": true,
    "sample_count_range": [2, 8],
    "feature_count_range": [1, 3],
    "C_milli_range": [1, 5000],
    "pass_cap_range": [1, 16],
    "label_domain": [-1, 1],
    "both_label_classes_required": true,
    "feature_coordinate_range": [-32, 32],
    "kernel": "linear dot product",
    "bias_convention": "the input-independent decision intercept is the negative of Platt's subtractive threshold b",
    "initial_state": "all dual coefficients and intercept are zero",
    "tolerance": 0.001,
    "epsilon": 0.001,
    "scan_order": "ascending input indices; maximum absolute error-gap partner ties choose the lowest index; fallback scans non-bound then all examples from index zero",
    "scan_start_refinement": "replace the source's randomized scan starts with deterministic ascending starts",
    "nonbound_scan_membership": "test 0 < alpha < C when each input index is reached",
    "pass_control": "source full/non-bound toggle; stop when numChanged is zero and examineAll is false, or after pass_cap passes",
    "input_length": "exactly 4+N+N*D",
    "maximum_valid_input_length": 36,
    "maximum_parseable_input_length": 37,
    "output_encoding": "[passes_completed,changes_in_last_pass,converged,alpha[0..N),bias]",
    "maximum_output_elements": 12,
    "success_result": "N+4",
    "converged_flag": "1 iff the source stopping condition is reached before the finite pass cap",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "error_precedence": "malformed input is rejected before output capacity/null checks",
    "no_write_on_error": true,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
