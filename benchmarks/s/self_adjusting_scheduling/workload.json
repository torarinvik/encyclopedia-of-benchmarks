      16
    ],
    "steps_range": [
      0,
      64
    ],
    "priority_range": [
      -2147483648,
      2147483647
    ],
    "exact_packed_length": "2 + task_count",
    "maximum_valid_input_length": 18,
    "maximum_parseable_input_length": 19,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
