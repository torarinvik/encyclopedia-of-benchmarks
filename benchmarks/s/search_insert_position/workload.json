{
  "id": "search-insert-position-v1",
  "algorithm": "search_insert_position",
  "contract": {
    "input": "A signed 32-bit target followed by 0 to 256 strictly increasing signed 32-bit values.",
    "output": "The zero-based position where the target is found or inserted to preserve order.",
    "invalid_input_result": -1,
    "empty_array_result": 0
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [
        5
      ],
      "input_length": 1,
      "expected_result": 0
    },
    {
      "id": "middle-insertion",
      "input_values": [
        5,
        1,
        3,
        6
      ],
      "input_length": 4,
      "expected_result": 2
    },
    {
      "id": "exact-match",
      "input_values": [
        5,
        1,
        3,
        5,
        7
      ],
      "input_length": 5,
      "expected_result": 2
    },
    {
      "id": "before-first",
      "input_values": [
        0,
        1,
        3,
        5
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "after-last",
      "input_values": [
        9,
        1,
        3,
        5,
        7
      ],
      "input_length": 5,
      "expected_result": 4
    },
    {
      "id": "single-exact",
      "input_values": [
        4,
        4
      ],
      "input_length": 2,
      "expected_result": 0
    },
    {
      "id": "single-before",
      "input_values": [
        3,
        4
      ],
      "input_length": 2,
      "expected_result": 0
    },
    {
      "id": "single-after",
      "input_values": [
        5,
        4
      ],
      "input_length": 2,
      "expected_result": 1
    },
    {
      "id": "negative-values",
      "input_values": [
        -3,
        -10,
        -2,
        0,
        8
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "int32-boundaries",
      "input_values": [
        2147483647,
        -2147483648,
        0
      ],
      "input_length": 3,
      "expected_result": 2
