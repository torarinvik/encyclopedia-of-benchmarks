  "source_bound": {
    "description": "The upstream explanation resizes an RGBA image by repeatedly calculating horizontal-neighbor RGB energy, finding a minimum vertical seam with dynamic programming, and deleting it. This profile narrows pixels to grayscale replicated into RGB and removes exactly one seam.",
    "grayscale_mapping": "intensity v is RGB (v, v, v); alpha is omitted",
    "energy": "sqrt(sum of squared RGB differences to existing left and right neighbors)",
    "predecessor_tie_break": "scan x-1 through x+1 in ascending order and retain the first strict minimum",
    "endpoint_tie_break": "scan the last row in ascending x order and retain the first strict minimum",
    "seam_count": 1,
    "upstream_width_growth": false
  },
  "workspace": {
    "bytes": 30,
    "meaning": "Maximum output buffer; pixel, energy, cumulative-energy, predecessor, and seam arrays are fixed to 6 by 6."
  },
