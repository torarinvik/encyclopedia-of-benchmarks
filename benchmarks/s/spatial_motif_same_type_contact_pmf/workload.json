{
  "schema_version": 1,
  "id": "encyclopedia-doi601-spatial-motif-same-type-contact-pmf-v1",
  "algorithm": "spatial_motif_same_type_contact_pmf",
  "function_symbol": "spatial_motif_same_type_contact_pmf",
  "comparison_model": "i64_array_bytes_output_call",
  "pinned_source": {
    "title": "Sequence and Spatial Motif Discovery in Short Sequence Fragments",
    "authors": ["Jie Liang", "Ronald Jackups"],
    "doi": "10.1007/978-1-4939-2864-4_601",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_601",
    "epub_path": "OEBPS/AChap601.html",
    "section": "Expectation for Interacting Residues of the Same Type",
    "license": "No source-code license asserted; clean-room implementation"
  },
  "input": {
    "kind": "signed_i64_array",
    "layout": "[sequence_length,first_X_count,second_X_count]",
    "sequence_length": [1, 16],
    "residue_count_range": "Each X count is in [0,sequence_length].",
    "maximum_valid_length": 3,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "layout": "[support_low,support_high,denominator,numerator_at_low,...,numerator_at_high,reduced_expectation_numerator,reduced_expectation_denominator]",
    "maximum_bytes": 112,
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed 17-entry output-count workspace and bounded integer binomial arithmetic."
  },
  "profile": {
    "probability": "C(x1,i)*C(l-x1,x2-i)/C(l,x2)",
    "expectation": "x1*x2/l, reduced to lowest terms",
    "scope": "Same-type spatial contacts under the internally random permutation model only; mixed-type, positional, and sequence-motif significance are excluded."
  },
  "measurement": {"sample_count": 7, "warmup_rounds": 2, "repetitions_per_sample": 100},
  "cases": [
    {
      "id": "symmetric-two-of-four",
      "input_values": [4, 2, 2],
      "input_length": 3,
      "output_capacity": 112,
      "expected_result": 64,
      "expected_output_hex": "00000000000000000200000000000000060000000000000001000000000000000400000000000000010000000000000001000000000000000100000000000000"
    },
    {
      "id": "one-first-sequence-residue",
      "input_values": [5, 1, 3],
      "input_length": 3,
      "output_capacity": 112,
      "expected_result": 56,
      "expected_output_hex": "000000000000000001000000000000000a000000000000000400000000000000060000000000000003000000000000000500000000000000"
    },
    {
      "id": "all-first-sequence-positions-are-X",
      "input_values": [3, 3, 1],
      "input_length": 3,
      "output_capacity": 112,
      "expected_result": 48,
      "expected_output_hex": "010000000000000001000000000000000300000000000000030000000000000001000000000000000100000000000000"
    },
    {
      "id": "reject-count-above-length",
      "input_values": [4, 5, 2],
      "input_length": 3,
      "output_capacity": 112,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
