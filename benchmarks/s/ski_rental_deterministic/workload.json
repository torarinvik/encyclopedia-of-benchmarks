  "workspace": {
    "bytes": 256,
    "meaning": "Fixed 32-byte bounded trip-action trace."
  },
  "contract": {
    "threshold_rentals": "floor(purchase_cost/rent_cost)",
    "decision": "Rent for the first threshold_rentals trips. If another trip occurs, buy before that trip, then ski on owned equipment for subsequent trips.",
    "online_information": "Each action depends only on costs and rentals already made; trip_count defines when the supplied trace ends."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The package oracle computes the threshold directly; the independent verifier simulates rental spending and state transitions.",
