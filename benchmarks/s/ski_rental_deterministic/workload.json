  "abi": "i64_array_bytes_output",
  "description": "Bounded deterministic threshold strategy for the classical ski-rental problem.",
  "source": {
    "title": "Ski Rental Problem",
    "authors": ["Mark S. Manasse"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_378",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_378",
    "algorithm_attribution": "Deterministic rent-then-buy threshold strategy, with k=floor(purchase_cost/rent_cost) rentals.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[rent_cost, purchase_cost, trip_count]",
    "rent_cost_range": [1, 32],
    "purchase_cost_range": [1, 64],
    "trip_count_range": [0, 32],
    "exact_length": 3,
