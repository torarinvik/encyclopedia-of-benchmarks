  "algorithm": "spatial_motif_different_type_contact_pmf",
  "function_symbol": "spatial_motif_different_type_contact_pmf",
  "comparison_model": "i64_array_bytes_output_call",
  "pinned_source": {
    "title": "Combinatorial Analysis for Sequence and Spatial Motif Discovery in Short Sequence Fragments",
    "authors": ["Ronald Jackups Jr.", "Jie Liang"],
    "doi": "10.1109/TCBB.2008.101",
    "url": "https://doi.org/10.1109/TCBB.2008.101",
    "chapter_doi": "10.1007/978-1-4939-2864-4_601",
    "epub_path": "OEBPS/AChap601.html",
    "section": "II-B, Null model for residues of different types",
    "license": "No source-code license asserted; clean-room implementation"
  },
  "input": {
    "kind": "signed_i64_array",
    "layout": "[L,x1,y1,x2,y2]",
    "sequence_length": [1, 10],
    "residue_count_range": "All counts are nonnegative; x1+y1<=L and x2+y2<=L.",
    "maximum_valid_length": 5,
    "maximum_sequence_length": 10,
    "maximum_valid_input_words": 5,
    "maximum_parseable_input_words": 6,
    "invalid_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "layout": "[L,denominator,N_0,...,N_L,reduced_expectation_numerator,reduced_expectation_denominator]",
    "denominator": "M(L,x2,y2), where M(a,b,c)=a!/(b!*c!*(a-b-c)!)",
    "maximum_multiset_arrangements": 4200,
    "maximum_bytes": 120,
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Eleven i64 PMF counts plus bounded scalar state; no sequence or permutation table is stored."
  },
  "profile": {
    "probability": "For j=m-i, sum M(x1,h,i)*M(y1,j,k)*M(L-x1-y1,x2-h-j,y2-i-k) over valid h,i,k, divided by M(L,x2,y2).",
    "expectation": "sum(m*N_m)/M(L,x2,y2), reduced; equivalently (x1*y2+y1*x2)/L.",
    "scope": "Exact heterotypic X-Y spatial contacts under the internally random permutation model; same-type, positional-null, sequence-motif, and dataset-level analysis are excluded."
  },
  "measurement": {"sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 5},
  "cases": [
