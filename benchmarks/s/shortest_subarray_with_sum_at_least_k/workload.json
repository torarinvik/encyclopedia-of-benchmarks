    "no_solution_result": 0,
    "invalid_frame_result": -1
  },
  "complexity": {
    "primary": "O(count) time and O(count) auxiliary space using prefix sums and a monotone deque",
    "independent_reference": "O(count^2) time and O(1) auxiliary space"
