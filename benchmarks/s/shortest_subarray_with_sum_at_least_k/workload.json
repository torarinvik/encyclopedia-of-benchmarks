    ],
    "count_range": [
      0,
      256
    ],
    "value_range": [
      -1000,
      1000
    ],
    "exact_length": "count + 2",
    "maximum_valid_length": 258,
    "maximum_parseable_length": 259,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "minimum nonempty contiguous length with sum >= target; 0 when no qualifying subarray exists or the sequence is empty",
