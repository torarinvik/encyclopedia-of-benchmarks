  "abi": "i64_array_scalar",
  "description": "Minimum nonempty contiguous length whose sum reaches a signed threshold, including negative values.",
  "source": {
    "title": "Optimal algorithms for locating the longest and shortest segments satisfying a sum or an average constraint",
    "authors": [
      "Kuan-Yu Chen",
      "Kun-Mao Chao"
    ],
    "publication": "Information Processing Letters 96(6), 2005, pp. 197-201",
    "doi": "10.1016/j.ipl.2005.08.006",
    "reference_url": "https://doi.org/10.1016/j.ipl.2005.08.006",
    "discovery_url": "https://leetcode.com/problems/shortest-subarray-with-sum-at-least-k/",
    "algorithm_attribution": "Linear-time shortest sum-constrained segment; LeetCode title used for discovery only",
    "implementation_status": "Clean-room implementation from algorithm description only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[target, count, value_0, ..., value_(count-1)]",
