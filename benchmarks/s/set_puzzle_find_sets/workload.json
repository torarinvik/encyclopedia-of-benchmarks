{
  "schema_version": 1,
  "id": "set-puzzle-supplied-hand-enumeration-v1",
  "algorithm": "set_puzzle_find_sets",
  "function_symbol": "set_puzzle_find_sets",
  "abi": "i64_array_bytes_output",
  "description": "Enumerate all valid triples in a supplied bounded Set hand.",
  "source": {
    "title": "Set puzzle",
    "specification": "RosettaGit task description",
    "url": "https://rosettagit.org/tasks/set-puzzle/",
    "license": "Algorithm description only; integer encoding, bounded contract, workload, and implementations are original"
  },
  "contract": {
    "operation": "Return every three-card subset whose four feature columns are each constant or contain all three feature values.",
    "input_encoding": "[n,card0,...,card(n-1)] where card=d0+3*d1+9*d2+27*d3 and each digit is a feature value",
    "card_code_range": [0, 80],
    "card_count_range": [0, 12],
    "cards_must_be_unique": true,
    "exact_input_length": "n+1",
    "minimum_valid_input_length": 1,
    "maximum_valid_input_length": 13,
    "maximum_parseable_input_length": 14,
    "output_encoding": "little-endian signed i64 words [set_count,(i,j,k)*]",
    "triple_indices": "zero-based, i<j<k, triples lexicographically ordered",
    "maximum_valid_sets": 22,
    "maximum_output_words": 67,
    "maximum_output_bytes": 536,
    "invalid_input_result": -1,
    "null_or_insufficient_output_result": -2,
    "errors_write_no_output": true,
    "time_complexity": "O(n^2)",
    "auxiliary_workspace": "81-byte code-to-index table plus 12 one-byte retained card codes"
  },
  "workspace": {
    "bytes": 93,
    "meaning": "Maximum fixed native scratch: 81 lookup entries and 12 retained codes; caller input and output are excluded."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "kernel_boundary": "Deterministic set enumeration over a supplied hand; no random deal, shuffle, or retry loop.",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "primary_oracle": "benchmarks/s/set_puzzle_find_sets/primary_oracle.py",
  "independent_oracle": "benchmarks/s/set_puzzle_find_sets/independent_oracle.py",
  "cases": [
    {
      "id": "empty-hand",
      "input_values": [0],
      "input_length": 1,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "single-set",
      "input_values": [3, 0, 1, 2],
      "input_length": 4,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000000000000000000001000000000000000200000000000000"
    },
    {
      "id": "nine-card-four-set-shape",
      "input_values": [9, 0, 1, 2, 3, 6, 9, 18, 27, 54],
      "input_length": 10,
      "output_capacity": 536,
      "expected_result": 104,
      "expected_output_hex": "0400000000000000000000000000000001000000000000000200000000000000000000000000000003000000000000000400000000000000000000000000000005000000000000000600000000000000000000000000000007000000000000000800000000000000"
    },
    {
      "id": "twelve-card-six-set-shape",
      "input_values": [12, 0, 1, 2, 3, 6, 9, 18, 27, 54, 8, 36, 40],
      "input_length": 13,
      "output_capacity": 536,
      "expected_result": 152,
      "expected_output_hex": ""
    },
    {
      "id": "hand-with-no-set",
      "input_values": [3, 0, 1, 3],
      "input_length": 4,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "two-card-hand",
      "input_values": [2, 0, 1],
      "input_length": 3,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "duplicate-card",
      "input_values": [3, 0, 0, 2],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "card-code-out-of-range",
      "input_values": [1, 81],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated-frame",
      "input_values": [3, 0, 1],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "trailing-word",
      "input_values": [1, 0, 1],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "maximum-parseable-trailing-word",
      "input_values": [12, 0, 1, 2, 3, 6, 9, 18, 27, 54, 8, 36, 40, 99],
      "input_length": 14,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [0],
      "input_length": 1,
      "input_is_null": true,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [0],
      "input_length": 1,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient-output-capacity",
      "input_values": [9, 0, 1, 2, 3, 6, 9, 18, 27, 54],
      "input_length": 10,
      "output_capacity": 103,
      "expected_result": -2,
      "expected_output_hex": "",
      "capacity_error_result": -2
    }
  ]
}
