{
  "schema_version": "1.0.0",
  "id": "go-set-algebra-integer-operations-v1",
  "algorithm": "set_algebra",
  "function_symbol": "set_algebra",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[operation, left_count, right_count, membership_key, left_values..., right_values...]",
    "operation_codes": {
      "0": "membership in left set",
      "1": "subset",
      "2": "proper subset",
      "3": "superset",
      "4": "proper superset",
      "5": "union",
      "6": "intersection",
      "7": "left difference",
      "8": "symmetric difference"
    },
    "set_length_range": [
      0,
      64
    ],
    "key_range": [
      -1000000,
      1000000
    ],
    "duplicate_values": "accepted and collapsed, matching insertion into a set",
    "maximum_input_length": 132,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_i64_array",
    "description": "Operations 0 through 4 return one 0/1 value. Operations 5 through 8 return sorted unique set elements without a count prefix; empty results return zero bytes.",
    "return_value": "output byte length (8 * output element count)",
    "maximum_output_bytes": 1024,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "membership_present",
      "input_values": [
        0,
        3,
        0,
        2,
        1,
        2,
        3
      ],
      "input_length": 7,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "membership_absent",
      "input_values": [
        0,
        3,
        0,
        9,
        1,
        2,
        3
      ],
      "input_length": 7,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "subset_true",
      "input_values": [
        1,
        2,
        3,
        0,
        1,
        2,
        1,
        2,
        3
      ],
      "input_length": 9,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "proper_subset_true",
      "input_values": [
        2,
        2,
        3,
        0,
        1,
        2,
        1,
        2,
        3
      ],
      "input_length": 9,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "equal_sets_are_subsets",
      "input_values": [
        1,
        3,
        2,
        0,
        1,
        2,
        2,
        2,
        1
      ],
      "input_length": 9,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "equal_sets_are_not_proper_subsets",
      "input_values": [
        2,
        2,
        2,
        0,
        1,
        2,
        2,
        1
      ],
      "input_length": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "superset_true",
      "input_values": [
        3,
        3,
        2,
        0,
        1,
        2,
        3,
        1,
        2
      ],
      "input_length": 9,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "proper_superset_true",
      "input_values": [
        4,
        3,
        2,
        0,
        1,
        2,
        3,
        1,
        2
      ],
      "input_length": 9,
      "expected_result": 8,
      "expected_output_hex": "0100000000000000"
    },
    {
      "id": "equal_sets_are_not_proper_supersets",
      "input_values": [
        4,
        2,
        2,
        0,
        1,
        2,
        2,
        1
      ],
      "input_length": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "union_sorted_and_unique",
      "input_values": [
        5,
        3,
        3,
        0,
        3,
        1,
        1,
        2,
        3,
        4
      ],
      "input_length": 10,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000020000000000000003000000000000000400000000000000"
    },
    {
      "id": "intersection",
      "input_values": [
        6,
        4,
        3,
        0,
        5,
        2,
        3,
        2,
        3,
        4,
        2
