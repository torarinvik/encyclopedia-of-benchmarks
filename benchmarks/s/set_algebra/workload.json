    {
      "id": "negative_values_sort_ascending",
      "input_values": [
        5,
        3,
        3,
        0,
        0,
        -7,
        5,
        -2,
        5,
        -9
      ],
      "input_length": 10,
      "expected_result": 40,
      "expected_output_hex": "f7fffffffffffffff9fffffffffffffffeffffffffffffff00000000000000000500000000000000"
    },
    {
      "id": "empty_intersection_returns_zero_bytes",
