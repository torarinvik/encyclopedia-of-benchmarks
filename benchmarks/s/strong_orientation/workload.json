{
  "schema_version": 1,
  "id": "cp-algorithms-strong-orientation-i64-array-bytes-v1",
  "algorithm": "strong_orientation",
  "function_symbol": "strong_orientation",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, m, (u, v) * m]",
    "vertex_count_range": [1, 64],
    "edge_count_range": [0, 128],
    "vertex_id_range": "0 <= endpoint < n",
    "self_loops_allowed": true,
    "parallel_edges_allowed": true,
    "traversal_order": "Examine roots by increasing vertex ID. Append each edge's u incidence then its v incidence; visit each vertex's adjacency in input edge order.",
    "maximum_valid_input_length": 258,
    "maximum_parseable_input_length": 259,
    "invalid_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "Little-endian signed i64 words [minimum_scc_count, direction_0, ..., direction_(m-1)]; direction +1 means input u->v, -1 means v->u; self-loops use +1.",
    "minimum_scc_count": "Number of original connected components plus number of bridges.",
    "bytes": "8 * (m + 1)",
    "maximum_bytes": 1032,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {"bytes": 1032},
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "oracle_method": "The expected orientation comes from an explicit-frame DFS reproducing the documented traversal order. The minimum count comes from independent edge-deletion connectivity checks, and a separate Kosaraju pass validates that the orientation attains the minimum.",
  "cases": [
    {"id": "single_isolated_vertex", "input_values": [1, 0], "input_length": 2, "output_capacity": 8, "expected_result": 8, "expected_output_hex": "0100000000000000"},
    {"id": "single_bridge", "input_values": [2, 1, 0, 1], "input_length": 4, "output_capacity": 16, "expected_result": 16, "expected_output_hex": "02000000000000000100000000000000"},
    {"id": "triangle_orients_as_one_scc", "input_values": [3, 3, 0, 1, 1, 2, 2, 0], "input_length": 8, "output_capacity": 32, "expected_result": 32, "expected_output_hex": "0100000000000000010000000000000001000000000000000100000000000000"},
    {"id": "reverse_non_tree_edge_direction", "input_values": [3, 3, 0, 1, 1, 2, 0, 2], "input_length": 8, "output_capacity": 32, "expected_result": 32, "expected_output_hex": "010000000000000001000000000000000100000000000000ffffffffffffffff"},
    {"id": "disconnected_bridges_and_isolated_vertex", "input_values": [5, 2, 0, 1, 3, 4], "input_length": 6, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "050000000000000001000000000000000100000000000000"},
    {"id": "parallel_edges_form_one_scc", "input_values": [2, 2, 0, 1, 0, 1], "input_length": 6, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "01000000000000000100000000000000ffffffffffffffff"},
    {"id": "self_loops_are_oriented_in_input_order", "input_values": [1, 2, 0, 0, 0, 0], "input_length": 6, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "010000000000000001000000000000000100000000000000"},
    {"id": "cycle_with_a_bridge_tail", "input_values": [4, 4, 0, 1, 1, 2, 2, 0, 2, 3], "input_length": 10, "output_capacity": 40, "expected_result": 40, "expected_output_hex": "02000000000000000100000000000000010000000000000001000000000000000100000000000000"},
    {"id": "maximum_vertex_count_without_edges", "input_values": [64, 0], "input_length": 2, "output_capacity": 8, "expected_result": 8, "expected_output_hex": "4000000000000000"},
    {"id": "undersized_output", "input_values": [2, 1, 0, 1], "input_length": 4, "output_capacity": 15, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null_output", "input_values": [1, 0], "input_length": 2, "output_capacity": 8, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
    {"id": "invalid_missing_header", "input_values": [1], "input_length": 1, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_zero_vertices", "input_values": [0, 0], "input_length": 2, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_extra_edge_word", "input_values": [2, 1, 0, 1, 0], "input_length": 5, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_endpoint", "input_values": [2, 1, 0, 2], "input_length": 4, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_negative_endpoint", "input_values": [2, 1, -1, 0], "input_length": 4, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid_edge_count_above_bound", "input_values": [2, 129], "input_length": 2, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null_input", "input_values": [], "input_length": 0, "input_is_null": true, "output_capacity": 1032, "expected_result": -1, "expected_output_hex": ""}
  ]
}
