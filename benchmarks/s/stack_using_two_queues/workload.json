  "algorithm": "stack_using_two_queues",
  "function_symbol": "stack_using_two_queues",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "encoding": "[op_count, (opcode, operand) repeated op_count times]",
    "operation_count_range": [
      0,
      128
    ],
    "maximum_valid_input_length": 257,
    "maximum_parseable_input_length": 257,
    "operation_codes": {
      "0": "push(signed_i32_value)",
      "1": "pop (operand must be 0)",
      "2": "peek (operand must be 0)"
    },
    "push_value_range": [
      -2147483648,
      2147483647
    ],
    "exact_packed_shape": "The array has exactly 1 + 2*op_count values; every operation contains an opcode and an operand.",
    "null_input_result": -1,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_i64_operation_records",
    "encoding": "One [tag, value] pair (two signed i64 words, 16 bytes) for each pop or peek; push emits no record.",
    "record_bytes": 16,
    "tags": {
      "0": "integer result",
      "1": "None/null (value is 0)"
    },
    "empty_pop": "invalid input returns -1 for the whole call, with no output",
    "empty_peek": "emits [1,0]",
    "result": "number of returned bytes",
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true,
    "maximum_output_bytes": 2048
  },
  "workspace": {
    "bytes": 2048,
    "reason": "At most 128 peek operations each emit one two-word record."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 40
  },
