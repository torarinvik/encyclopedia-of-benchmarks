  "contract": {
    "operation": "Perform one analytic SMO dual update for a supplied distinct pair and update the bias.",
    "input_encoding": "[N,D,C_milli,b_milli,labels[N],alpha_milli[N],X[N*D],i,j]",
    "integer_valued_float64_fields": true,
    "sample_count_range": [2, 8],
    "feature_count_range": [1, 3],
    "C_milli_range": [1, 5000],
    "bias_milli_range": [-1000000, 1000000],
    "label_domain": [-1, 1],
    "both_label_classes_required": true,
    "alpha_milli_range": "0..C_milli",
    "initial_dual_equality": "sum(labels[k]*alpha_milli[k]) == 0",
    "feature_coordinate_range": [-32, 32],
    "pair_indices": "distinct zero-based indices in 0..N-1",
    "kernel": "linear dot product",
    "zero_curvature": "Compare the dual objective at both feasible pair endpoints; choose the lower endpoint on a tie.",
    "bias_update": "Use the candidate bias associated with an updated free coefficient; average both candidate biases when both coefficients are at a box bound.",
    "input_length": "exactly 6+2*N+N*D",
    "maximum_valid_input_length": 46,
    "maximum_parseable_input_length": 47,
    "output_encoding": "[alpha_prime[0..N),bias_prime]",
    "maximum_output_elements": 9,
    "success_result": "N+1",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "error_precedence": "Malformed input is rejected before output capacity/null checks.",
    "no_write_on_error": true,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "input": {
