{
  "schema_version": "1.0.0",
  "id": "speed-conversion-php-binary64-pair-v1",
  "algorithm": "speed_conversion",
  "function_symbol": "speed_conversion",
  "description": "Convert speeds among mph, km/h, m/s, ft/s, and knots using the pinned PHP factors and two-decimal rounding.",
  "input": {
    "kind": "speed_and_unit_route",
    "layout": [
      "speed",
      "route"
    ],
    "unit_order": [
      "mph",
      "km/h",
      "m/s",
      "ft/s",
      "kn"
    ],
    "route_encoding": "source_unit_index * 5 + destination_unit_index",
    "minimum_speed": 0.0,
    "maximum_speed": 1000000.0,
    "invalid_input_result": -1.0
  },
  "output": {
    "kind": "binary64",
    "definition": "PHP round(speed * source_factor * destination_factor, 2), multiplying in source order",
    "invalid_input_result": -1.0
  },
  "measurement": {
    "comparison_model": "float64_pair_call",
    "input_scaled_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
