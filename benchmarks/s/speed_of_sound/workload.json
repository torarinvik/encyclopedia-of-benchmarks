    {"id":"invalid-length","input_values":[998],"input_length":1,"expected_result":-1e300},
    {"id":"invalid-zero-density","input_values":[0,100000000],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-zero-modulus","input_values":[400,0],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-density-bound","input_values":[1001,100000000],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-modulus-bound","input_values":[400,1000000001],"input_length":2,"expected_result":-1e300}
