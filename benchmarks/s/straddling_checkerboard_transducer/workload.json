  "algorithm": "straddling_checkerboard_transducer",
  "function_symbol": "straddling_checkerboard_transducer",
  "abi": "i64_array_bytes_output",
  "time_complexity": "O(text_length) for a fixed 30-cell board, including bounded O(28^2) duplicate-symbol validation.",
  "space_complexity": "O(1) fixed scratch apart from at most 128 bytes of staged output.",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[mode,board[30],text_length,text_bytes[text_length]]",
    "mode": {"encode": 0, "decode": 1},
    "board_layout": "Three row-major rows of ten cells. Exactly two zero holes are permitted in the top row; their column digits label rows 1 and 2. All other cells hold distinct printable ASCII bytes 32..126.",
    "text_length_range": [0, 64],
    "maximum_valid_length": 96,
    "maximum_parseable_length": 97,
    "encoding_input": "Printable ASCII symbols present in the board.",
    "decoding_input": "ASCII decimal digits 48..57; a top-row hole consumes the next digit as its column.",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "raw_byte_stream",
    "encoding_output": "ASCII decimal digit bytes, one digit for a top-row symbol and two for a lower-row symbol.",
    "decoding_output": "The board symbols as raw bytes.",
    "maximum_bytes": 128,
    "invalid_or_malformed_result": -1,
    "null_or_short_output_result": -2,
    "null_output_is_invalid_even_for_empty_output": true,
    "errors_write_no_output": true
  },
  "algorithm": {
    "encoder": "Map each byte to its unique board coordinate; omit the row indicator for row zero.",
    "decoder": "Read digits left-to-right. A non-hole leading digit indexes row zero; a hole digit consumes one more digit and indexes the corresponding lower row.",
    "codewords": "Prefix-free because the only single-digit codes are top-row columns not reserved as row indicators."
  },
  "workspace": {
    "bytes": 256,
    "meaning": "Conservative fixed stack-space ceiling for row indicators, counters, local validation state, and staging in the Elisa port. Caller buffers are excluded."
  },
