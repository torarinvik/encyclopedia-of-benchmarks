  "independent_oracle": "benchmarks/s/sort_points_by_argument/independent_oracle.py",
  "contract": {
    "operation": "Sort integer 2D vectors by increasing atan2(y,x) argument over the seam at the negative x-axis.",
    "input_layout": "[N, x0,y0, ..., x(N-1),y(N-1)]",
    "angle_order": "The order starts immediately after the negative x-axis and proceeds counterclockwise through the lower half-plane, positive x-axis, upper half-plane, and back to the negative x-axis. atan2(0,0)=0, so the zero vector ties with the positive x-axis.",
    "algorithm": "A strict half-plane partition and signed 64-bit cross products compare angles exactly, without floating point. Equal arguments use increasing squared length, then lexicographic coordinates as a deterministic tie break.",
    "independent_algorithm": "Use exact rational slopes within eight monotone angular sectors and compare sector keys, avoiding the cross-product comparator.",
    "output_layout": "Sorted points as N consecutive little-endian signed 64-bit coordinate pairs.",
    "maximum_point_count": 64,
    "workspace_bytes": 16384,
    "error_precedence": "Malformed framing or coordinate bounds return -1 before output checks. Valid input with null output or capacity below 16*N returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, then N (x,y) pairs]",
    "n_range": [1, 64],
    "coordinate_range": [-1000000000, 1000000000],
    "maximum_valid_length": 129,
    "maximum_parseable_input_length": 129,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 128,
    "maximum_bytes": 1024,
    "success_result": "16*N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 16384,
    "storage": "Fixed arrays for 64 points, a 64-point merge buffer, and 128 staged output coordinates."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
