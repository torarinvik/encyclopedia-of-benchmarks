{
  "schema_version": 1,
  "id": "cp-algorithms-sqrt-tree-constant-time-i64-array-bytes-output-v1",
  "algorithm": "sqrt_tree_constant_time",
  "function_symbol": "sqrt_tree_constant_time",
  "abi": "i64_array_bytes_output",
  "description": "Static range-minimum queries by a padded power-of-two Sqrt Tree with bit-selected layers.",
  "source": {
    "title": "Sqrt Tree",
    "section": "Optimizing the query complexity",
    "url": "https://cp-algorithms.com/data_structures/sqrt-tree.html#optimizing-the-query-complexity",
    "license": "CC BY-SA 4.0 source consulted for the algorithmic idea only; implementation and fixtures are clean-room",
    "algorithm_attribution": "Pad to a power of two, use equal power-of-two layers with block prefix/suffix and whole-block summaries, and select the query layer by the highest differing bit."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,q,values[0..n),left_0,right_0,...]",
    "item_count_range": [
      1,
      64
    ],
    "query_count_range": [
      0,
      64
    ],
    "value_range": [
      -1000000000,
      1000000000
    ],
    "query_range": "inclusive zero-based [left,right] with 0<=left<=right<n",
    "maximum_valid_length": 194,
    "maximum_parseable_length": 195,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "packed_signed_64_bit_little_endian_array",
    "encoding": "one range minimum per query in query order",
    "maximum_output_bytes": 512,
    "success_result": "8*q",
    "insufficient_output_capacity_result": -2,
    "null_nonempty_output_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed padded values, per-layer prefix/suffix arrays, compact whole-block tables, and lookup state; caller-owned output is separate."
  },
  "contract": {
    "primary_method": "Power-of-two Sqrt Tree layers. Each layer stores per-block prefix and suffix minima plus an O(N)-entry compact table of whole-block interval minima. The highest differing bit of left XOR right selects the unique layer with endpoints in distinct blocks of one segment.",
    "independent_method": "Scan each requested inclusive range directly and encode the minima as little-endian signed 64-bit values.",
    "invalid_input_result": -1,
    "bad_output_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  },
