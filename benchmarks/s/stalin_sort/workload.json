{
  "schema_version": 1,
  "id": "stalin-sort-signed-i32-array-bytes-v1",
  "algorithm": "stalin_sort",
  "function_symbol": "stalin_sort",
  "input": {
    "kind": "signed_i64_array_with_signed_i32_values",
    "length_range": [
      0,
      128
    ],
    "maximum_validation_array_length": 129,
    "value_range": [
      -2147483648,
      2147483647
    ],
    "invalid_result": -1,
    "first_rejected_length": 129,
    "null_input_policy": "NULL with length 0 represents valid empty input; NULL with nonzero length returns -1"
  },
  "output": {
    "kind": "little_endian_signed_i32_vector",
    "encoding": "retained sequence values packed as signed 32-bit little-endian integers",
    "maximum_elements": 128,
    "max_output_bytes": 512,
    "successful_result": "number of output bytes; 0 for empty output",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 512,
    "meaning": "maximum retained subsequence: 128 signed 32-bit values"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
