  "contract": {
    "operation": "Count symbols in first-occurrence order, recursively apply NaiveKnapsackSolver's greedy frequency subset at half the node frequency sum, then translate each character to its tree code.",
    "input_encoding": "[text_length, ASCII codes...]",
    "text_length_range": [0, 16],
    "ascii_code_range": [0, 127],
    "frequency_formula": "binary64 (1.0 * count) / text_length",
    "symbol_order": "First occurrence order, matching the pinned .NET Dictionary enumeration behavior.",
    "splitter": "Walk node symbols in order; include an item iff running_weight + frequency <= capacity; capacity is 0.5 times the node frequency sum; continue after nonfitting items. The value selector is ignored by NaiveKnapsackSolver.",
    "split_tie_rule": "An item exactly filling remaining capacity is included. Equal symbol frequencies are resolved by first-occurrence order.",
    "branch_bits": "left=0, right=1",
    "empty_input": "Empty compressed text and empty decoding table.",
    "single_symbol": "Compressed text is one ASCII '1' per input character; decoding key '1' maps to the symbol.",
    "translator": "The source translator scans growing substrings, but every compression key is one ASCII character and therefore matches at length one.",
    "output_serialization": "compressed_length byte, ASCII compressed bits, decoder_entry_count byte, then entries sorted by ascending symbol byte: symbol byte, code_length byte, ASCII code bytes.",
    "null_input": "A null pointer with length zero represents null text and returns the same serialized result as empty text; null pointer with positive length is invalid.",
    "errors": "Malformed framing, text length above 16, or ASCII values outside 0..127 return -1 before output checks. Null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[text_length, ASCII codes...]",
    "text_length_range": [0, 16],
    "ascii_code_range": [0, 127],
    "exact_input_length": "1+text_length",
    "maximum_valid_input_values": 17,
    "maximum_input_values_for_malformed_cases": 18,
