  "algorithm": "suffix_array_sais",
  "function_symbol": "suffix_array_sais",
  "abi": "i64_array_bytes_output",
  "description": "Construct a suffix array by L/S classification, LMS-substring reduction, and induced sorting.",
  "source": {
    "title": "Suffix Array / Linear Suffix Array Construction by Almost Pure Induced-Sorting",
    "authors": ["Ge Nong", "Sen Zhang", "Wai Hong Chan"],
    "year": 2009,
    "reference": "2009 Data Compression Conference, pp. 193-202, DOI 10.1109/DCC.2009.42",
    "url": "https://doi.org/10.1109/DCC.2009.42",
    "algorithm_attribution": "SA-IS induced-sorting suffix-array construction; OI Wiki provides a separate algorithm exposition.",
    "algorithm_description_url": "https://oi-wiki.org/string/sa/",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, byte_symbols...]",
    "text_length_range": [0, 32],
    "symbol_range": [0, 255],
    "exact_length": "1 + text_length",
    "maximum_valid_length": 33,
    "maximum_parseable_length": 34,
    "includes_nul": true,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "all original suffix starts in lexicographic order; the private sentinel suffix is omitted",
    "maximum_output_bytes": 256,
    "success_result": "8 * text_length bytes",
    "empty_text_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 32768,
    "meaning": "Bounded SA-IS recursion frames, bucket arrays, reduced names, and staged suffix indices for text length at most 32."
  },
  "complexity": {
    "time": "O(n + sigma) for the bounded integer-alphabet SA-IS construction, with fixed byte alphabet sigma=257 including the sentinel",
    "space": "O(n + sigma) working storage; recursive reduced strings shrink by at least a factor of two"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Primary oracle applies SA-IS LMS reduction and two induced scans; independent oracle directly sorts complete suffix slices.",
