  "algorithm": "suffix_tree_from_sa_lcp",
  "function_symbol": "suffix_tree_from_sa_lcp",
  "abi": "i64_array_bytes_output",
  "description": "Build a bounded terminated-text suffix tree from suffix-array order and adjacent LCP values, then serialize its canonical topology.",
  "source": {
    "title": "Suffix Tree Construction in Hierarchical Memory",
    "authors": ["Paolo Ferragina"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_413",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_413",
    "algorithm_attribution": "Rightmost-path suffix-tree construction from suffix-array order and adjacent LCP values.",
    "implementation_status": "clean-room bounded in-memory profile; external-memory I/O behavior is not measured"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[text_length, symbols...]",
    "text_length_range": [0, 8],
    "symbol_range": [1, 255],
    "maximum_valid_length": 9,
    "maximum_parseable_length": 10,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[node_count, (parent_representative, parent_depth, node_representative, node_depth, leaf_start)...]",
    "maximum_bytes": 688,
    "success_result": "serialized output byte count",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed arrays for at most nine suffixes, seventeen tree nodes, canonical node records, and 688 staged output bytes."
  },
  "contract": {
    "terminal_symbol": "Append one unique terminal symbol 0; valid text symbols are in 1..255.",
    "suffix_array": "Lexicographic order of all suffixes of the terminated text, including the terminal-only suffix.",
    "lcp": "Adjacent longest-common-prefix lengths in suffix-array order.",
    "construction": "Scan suffixes in suffix-array order, maintain the rightmost path by LCP depth, and when the next LCP is deeper than the current top create an internal node and reparent the prior rightmost child beneath it; then attach the new leaf.",
    "node_depth": "Number of terminated-text symbols represented from the root; leaf depth is terminated_text_length - suffix_start.",
    "representative": "Start position of the lexicographically first suffix below a node; a leaf uses its own suffix start.",
    "canonical_order": "Root row first, then all other rows sorted by (node_depth, node_representative, leaf_start).",
    "error_results": "Malformed input returns -1. Null output or insufficient capacity returns -2 without writes."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Compute suffix order and adjacent LCP by direct suffix comparison, apply the source rightmost-path LCP stack construction, and serialize canonical parent/depth/representative records. The independent verifier builds the compressed trie recursively by prefix groups.",
