    ],
    "max_live_keys": 32,
    "opcodes": {
      "0": "insert absent key",
      "1": "search key",
      "2": "delete key; tree must be nonempty"
    },
    "exact_packed_shape": "Exactly 1 + 2*operation_count signed-i64 words.",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
