{
  "schema_version": 1,
  "id": "library-checker-set-xor-min-bounded-i64-array-bytes-output-v1",
  "algorithm": "set_xor_min",
  "function_symbol": "set_xor_min",
  "abi": "i64_array_bytes_output",
  "description": "Maintain a 30-bit integer set in a binary trie and answer minimum-XOR queries.",
  "source": {
    "title": "Set XOR-Min",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/data_structure/set_xor_min/task.md",
    "algorithm_attribution": "Counted binary trie for set minimum-XOR queries",
    "implementation_status": "clean-room bounded binary trie"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[Q,(type,x)...]",
    "Q_range": [1, 64],
    "operation_types": {"0": "insert", "1": "remove", "2": "minimum XOR query"},
    "value_range": "0 <= x < 2^30",
    "query_precondition": "the set is nonempty for every type-2 operation",
    "maximum_valid_length": 129,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian minimum-XOR result per type-2 operation",
    "maximum_bytes": 512,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Maximum output-buffer capacity; local trie pool has 1 + 30*Q nodes and per-node child/count fields."
  },
  "contract": {
    "insert": "add x if it is absent; duplicate insertion has no effect",
    "remove": "remove x if it is present; absent removal has no effect",
    "query_result": "minimum of y XOR x over all active set values y",
    "official_Q_range": [1, 500000],
    "official_value_range": "0 <= x < 2^30"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "overlapping-prefixes-and-deletion",
      "input_values": [6,0,5,0,10,2,0,2,7,1,5,2,7],
      "input_length": 13,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "050000000000000002000000000000000d00000000000000"
    },
    {
      "id": "duplicate-insert-absent-delete-and-reinsert",
      "input_values": [7,0,8,0,8,1,9,2,8,1,8,0,8,2,0],
      "input_length": 15,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000800000000000000"
    },
    {
      "id": "highest-domain-bit",
      "input_values": [3,0,1073741823,0,536870912,2,0],
      "input_length": 7,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000002000000000"
    },
    {
      "id": "query-on-empty-set",
      "input_values": [1,2,3],
      "input_length": 3,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "value-out-of-range",
      "input_values": [1,0,-1],
      "input_length": 3,
      "output_capacity": 8,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [2,0,1,2,0],
      "input_length": 5,
      "output_capacity": 7,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
