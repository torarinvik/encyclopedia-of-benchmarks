  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, m, k, sample_mask_1, ..., sample_mask_(k-1), (u, v, weight)...]",
    "n_range": [2, 8],
    "m_range": [0, 28],
    "k_range": [2, 3],
    "weight_range": [1, 32],
    "sample_mask_range": "0 <= mask < 2^n; bit c indicates sampling the extant cluster centered at vertex c",
    "endpoint_rule": "0 <= u < v < n; no duplicate undirected edges",
    "edge_order": "Any input order; output selection is reported in input order.",
    "exact_length": "3 + (k - 1) + 3 * m",
    "maximum_valid_length": 89,
    "maximum_parseable_length": 90,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_vector",
    "encoding": "one canonical 0/1 selection byte per input edge, in input order",
    "maximum_bytes": 28,
    "success_result": "m bytes written",
    "empty_output_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded edge records, residual-edge flags, cluster labels, and staged output."
  },
  "contract": {
    "stretch": "2 * k - 1",
    "sampling": "Caller-supplied cluster masks replay one realization; independence and the source probability n^(-1/k) are not generated or verified.",
    "rounds": "k - 1 forming-cluster rounds followed by vertex-to-cluster joining.",
    "tie_rule": "Minimum edge order is (weight, u, v); lighter-than comparisons remain strict numeric-weight comparisons.",
    "scheduling_rule": "All local choices in a forming round use its starting residual-edge snapshot and removals are applied together.",
    "size_retry": "Source size-threshold resampling is omitted; the profile makes no expected-size or expected-time claim."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Primary oracle replays edge-array cluster groups; independent verifier groups per-vertex adjacency lists. Both use the workload's deterministic tie and round-snapshot rules.",
