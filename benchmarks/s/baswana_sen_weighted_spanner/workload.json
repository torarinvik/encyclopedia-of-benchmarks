    "primary_work_authors": ["Surender Baswana", "Sandeep Sen"],
    "primary_work_year": 2007,
    "primary_work_doi": "10.1002/rsa.20130",
    "primary_work_url": "https://doi.org/10.1002/rsa.20130",
