    "invalid_result": -1,
    "insufficient_capacity_result": -2,
    "null_output_result": -2,
    "zero_length_requires_nonnull_output": true,
    "error_cases_write_nothing": true
  },
  "arithmetic": {
    "overflow": "reject with -1; bounded input ranges imply products and sums are within signed i64"
