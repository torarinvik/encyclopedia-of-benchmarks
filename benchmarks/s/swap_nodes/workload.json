{
  "schema_version": 1,
  "id": "swap_nodes-python-i64-array-bytes-v1",
  "algorithm": "swap_nodes",
  "function_symbol": "swap_nodes",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,values[0..n],value_a,value_b]",
    "n_range": [
      0,
      64
    ],
    "value_range": [
      -2147483648,
      2147483647
    ],
    "target_range": [
      -2147483648,
      2147483647
    ],
    "exact_packed_length": "3 + n",
    "maximum_packed_values": 67,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "i64_le_array",
    "encoding": "i64le element count followed by final values as i64le",
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "maximum_output_bytes": 520,
    "meaning": "the final input-order values after swapping the data fields of the first nodes matching both requested values; unchanged when either is absent or both targets are equal"
  },
  "workspace": {
    "bytes": 520
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 50
  },
  "cases": [
    {
      "id": "source_example",
      "input_values": [
        5,
        1,
        2,
        3,
        4,
        5,
        1,
        5
      ],
      "expected_result": 48,
      "expected_output_hex": "050000000000000005000000000000000200000000000000030000000000000004000000000000000100000000000000"
    },
    {
      "id": "adjacent",
      "input_values": [
        4,
        1,
        2,
        3,
        4,
        2,
        3
      ],
      "expected_result": 40,
      "expected_output_hex": "04000000000000000100000000000000030000000000000002000000000000000400000000000000"
    },
    {
      "id": "same_target",
      "input_values": [
        3,
        4,
        4,
        7,
        4,
        4
      ],
      "expected_result": 32,
      "expected_output_hex": "0300000000000000040000000000000004000000000000000700000000000000"
    },
    {
      "id": "missing_target",
      "input_values": [
        3,
        1,
        2,
        3,
        1,
        9
      ],
      "expected_result": 32,
      "expected_output_hex": "0300000000000000010000000000000002000000000000000300000000000000"
    },
    {
      "id": "empty",
      "input_values": [
        0,
        1,
        2
      ],
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "invalid_truncated",
      "input_values": [
        2,
        1,
        2,
        1
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_value_above_i32",
      "input_values": [
        1,
        2147483648,
        1,
        1
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_target_outside_i32",
      "input_values": [
        0,
        2147483648,
        1
      ],
      "expected_result": -1
    },
    {
      "id": "insufficient_output_capacity",
      "input_values": [
        1,
        5,
        5,
        6
      ],
      "expected_result": -2,
      "workspace_bytes": 15
    }
  ]
}
