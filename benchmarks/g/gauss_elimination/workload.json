{
  "schema_version": 1,
  "id": "gauss-elimination-partial-pivot-f32-2dp-v1",
  "algorithm": "gauss_elimination",
  "function_symbol": "gauss_elimination",
  "input": {
    "kind": "packed_i64_array",
    "layout": "[n, A row-major n*n cells, b n cells]",
    "dimension_range": [
      2,
      8
    ],
    "coefficient_domain": "All n*n matrix entries and n right-hand-side entries are integers in [-100,100]; A may be dense.",
    "singular_system_result": -1,
    "invalid_input_result": -1,
    "invalid_input_output": "empty"
  },
  "output": {
    "kind": "float64_vector",
    "meaning": "solution vector rounded to two decimal places as C printf(\"%.2f\") displays binary32 values",
    "encoding": "n IEEE-754 binary64 little-endian values",
    "max_length": 8,
    "relative_tolerance": 0.0,
    "absolute_tolerance": 0.0
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "workspace": {
    "bytes": 64
  },
  "cases": [
    {
      "id": "pivot_required",
      "input_values": [
        2,
