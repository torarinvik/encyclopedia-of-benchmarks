{
  "schema_version": 1,
  "id": "good-pairs-brute-force-i64-v1",
  "algorithm": "good_pairs",
  "function_symbol": "good_pairs",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, values...]",
    "n_range": [0, 256],
    "value_range": [-1000000, 1000000],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "valid_result": "Count of pairs i < j with equal values.",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"source_example","input_values":[6,1,2,3,1,1,3],"expected_result":4},
    {"id":"source_all_equal","input_values":[4,1,1,1,1],"expected_result":6},
    {"id":"source_all_distinct","input_values":[3,1,2,3],"expected_result":0},
    {"id":"negative_values","input_values":[5,-2,7,-2,7,-2],"expected_result":4},
    {"id":"empty","input_values":[0],"expected_result":0},
    {"id":"singleton","input_values":[1,-1000000],"expected_result":0},
    {"id":"value_boundaries","input_values":[4,-1000000,1000000,-1000000,1000000],"expected_result":2},
    {"id":"declared_length_mismatch","input_values":[3,1,1],"expected_result":-1},
    {"id":"negative_length","input_values":[-1],"expected_result":-1}
  ]
}
