{
  "schema_version": 1,
  "id": "cpp-rust-graph-coloring-bounded-count-i64le-v1",
  "algorithm": "graph_coloring",
  "function_symbol": "graph_coloring",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, m, row_mask_0, ..., row_mask_(n-1)]; bit j in row_mask_i denotes the edge from i to j",
    "vertex_count_range": [1, 8],
    "color_count_range": [1, 4],
    "exact_length": "n + 2",
    "row_mask_range": "0 <= row_mask < 2^n",
    "graph_constraints": ["symmetric adjacency", "zero diagonal"],
    "first_rejected_length": 11,
    "maximum_validation_array_length": 11,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "byte_array",
    "encoding": "little_endian_i64",
    "layout": "number of proper vertex colorings with m labeled colors",
    "length": 8,
    "maximum_bytes": 8
  },
  "workspace": {
    "bytes": 8,
    "meaning": "fixed output capacity for one signed i64 coloring count"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
