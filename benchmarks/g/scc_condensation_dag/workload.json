{
  "schema_version": 1,
  "id": "scc-condensation-dag-directed-graph-byte-output-v1",
  "algorithm": "scc_condensation_dag",
  "function_symbol": "scc_condensation_dag",
  "abi": "i64_array_bytes_output",
  "source": {
    "title": "Strongly Connected Components and Condensation Graph",
    "url": "https://cp-algorithms.com/graph/strongly-connected-components.html",
    "license": "CC BY-SA 4.0",
    "reuse": "algorithm description only; clean-room bounded profile"
  },
  "input": {
    "encoding": "[vertex_count,edge_count,(source,target)*edge_count]",
    "vertex_count_range": [0,8],
    "edge_count_range": [0,28],
    "maximum_valid_length": 58,
    "maximum_parseable_length": 59,
    "graph_semantics": "directed graph; self-loops and duplicate input edges are allowed",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "output": {
    "encoding": "[component_count,component_id[vertex_count],row_mask[component_count]]",
    "component_ordering": "ascending minimum vertex in each component",
    "row_mask_rule": "bit j in row i is set iff at least one input edge goes from component i to component j; self-edges are excluded",
    "duplicate_condensation_edges": "coalesced into one row-mask bit",
    "empty_graph": [0],
    "maximum_bytes": 17,
    "result": "number of output bytes",
    "output_untouched_on_error": true
  },
  "contract": {
    "method": "Primary uses Kosaraju's two-pass SCC decomposition, then maps original edges to canonical component IDs and sets quotient-DAG row bits. The independent reference groups vertices by mutual reachability and scans edges to build the quotient.",
    "complexity": "Primary O(V^2+E) at the fixed bounds; independent reference O(V^3+E).",
    "distinctness": "Local SCC packages return the component partition only; this profile also constructs the canonical, duplicate-free condensation DAG."
  },
  "workspace": {"bytes": 1024},
  "measurement": {"comparison_model": "i64_array_bytes_output_call"},
  "cases": [
    {"id":"empty-graph","input_values":[0,0],"input_length":2,"expected_result":1,"expected_output_bytes":[0]},
    {"id":"single-isolate","input_values":[1,0],"input_length":2,"expected_result":3,"expected_output_bytes":[1,0,0]},
    {"id":"single-condensation-edge","input_values":[2,1,0,1],"input_length":4,"expected_result":5,"expected_output_bytes":[2,0,1,2,0]},
    {"id":"one-strong-component","input_values":[3,3,0,1,1,2,2,0],"input_length":8,"expected_result":4,"expected_output_bytes":[1,0,0,0]},
