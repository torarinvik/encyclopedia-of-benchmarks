    "operation": "Count directed Eulerian circuits modulo 998244353, identifying circuits that differ by cyclic shift.",
    "input_layout": "[n, m, (u, v)*m]",
    "official_limits": {"vertex_count": [1, 500], "edge_count": [1, 200000]},
    "vertex_count_range": [1, 7],
    "edge_count_range": [1, 9],
    "vertex_ids": "zero-based",
    "graph_semantics": "Directed multigraph; edge indices distinguish parallel arcs.",
    "self_loops": "Allowed and counted as distinct edges.",
    "cyclic_shift_semantics": "Fix edge index zero as the first edge in every counted sequence.",
    "algorithm": "BEST theorem: count inward arborescences rooted at the tail of edge zero by a directed Matrix-Tree cofactor, then multiply by the product of (outdegree(v)-1)! over active vertices.",
    "modulus": 998244353,
    "output_encoding": "one unsigned 64-bit count in eight little-endian bytes",
    "no_eulerian_circuit_result": 0,
    "invalid_input_result": -1,
