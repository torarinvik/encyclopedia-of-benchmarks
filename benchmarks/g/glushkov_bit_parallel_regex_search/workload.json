    {"id": "alternation-multiple-matches", "input_values": [5, 4, 97, 98, 99, 97, 98, 97, 124, 98, 99], "input_length": 11, "output_capacity": 5, "expected_result": 5, "expected_output_hex": "0100010100"},
    {"id": "starred-prefix", "input_values": [5, 3, 97, 97, 97, 98, 120, 97, 42, 98], "input_length": 10, "output_capacity": 5, "expected_result": 5, "expected_output_hex": "0000000100"},
    {"id": "grouped-repetition", "input_values": [5, 7, 97, 98, 99, 99, 120, 40, 97, 98, 124, 99, 41, 42], "input_length": 14, "output_capacity": 5, "expected_result": 5, "expected_output_hex": "0001010100"},
    {"id": "wildcard-each-byte", "input_values": [3, 1, 97, 98, 99, 46], "input_length": 6, "output_capacity": 3, "expected_result": 3, "expected_output_hex": "010101"},
    {"id": "empty-match-not-reported", "input_values": [3, 2, 98, 98, 98, 97, 42], "input_length": 7, "output_capacity": 3, "expected_result": 3, "expected_output_hex": "000000"},
    {"id": "empty-text-null-output", "input_values": [0, 1, 97], "input_length": 3, "output_is_null": true, "output_capacity": 0, "expected_result": 0, "expected_output_hex": ""},
    {"id": "invalid-empty-alternative", "input_values": [1, 2, 97, 97, 124], "input_length": 5, "output_capacity": 1, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-unmatched-group", "input_values": [1, 2, 97, 40, 97], "input_length": 5, "output_capacity": 1, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-too-many-positions", "input_values": [0, 9, 97, 97, 97, 97, 97, 97, 97, 97, 97], "input_length": 11, "output_capacity": 0, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-byte-domain", "input_values": [1, 1, 0, 97], "input_length": 4, "output_capacity": 1, "expected_result": -1, "expected_output_hex": ""},
    {"id": "wrong-packed-length", "input_values": [2, 1, 97, 97], "input_length": 4, "output_capacity": 2, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-input", "input_values": [1, 1, 97, 97], "input_length": 4, "input_is_null": true, "output_capacity": 1, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-output", "input_values": [1, 1, 97, 97], "input_length": 4, "output_is_null": true, "output_capacity": 1, "expected_result": -2, "expected_output_hex": ""},
    {"id": "short-output-capacity", "input_values": [2, 1, 97, 97, 97], "input_length": 5, "output_capacity": 1, "expected_result": -2, "expected_output_hex": ""}
  ]
