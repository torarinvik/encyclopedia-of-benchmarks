{
  "schema_version": 1,
  "id": "java-gcounter-state-merge-trace-v1",
  "algorithm": "gcounter",
  "function_symbol": "gcounter",
  "input": {
    "encoding": "[replica_count, operation_count, (opcode, replica_a, replica_b)*]",
    "replica_count_range": [
      1,
      8
    ],
    "maximum_operations": 128,
    "increment_limit_per_local_component": 1000000,
    "opcodes": {
      "0": "increment replica a",
      "1": "query total value of replica a (b=0)",
      "2": "compare componentwise replica a <= replica b",
      "3": "merge replica b into replica a"
    }
  },
  "output": {
    "kind": "signed_i64",
    "meaning": "FNV-1a-64 over value/compare results in trace order followed by all replica components in row-major order",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "single_replica",
      "input_values": [
        1,
        3,
        0,
        0,
        0,
        0,
        0,
        0,
        1,
        0,
        0
      ],
      "expected_result": -1718478161973673819
    },
    {
      "id": "replicate_and_compare",
      "input_values": [
        3,
        7,
        0,
        0,
        0,
        0,
        0,
        0,
        1,
        0,
        0,
        2,
        0,
        1,
        3,
        1,
        0,
        1,
        1,
        0,
        2,
        1,
        0
      ],
      "expected_result": 4005083751437012292
    },
    {
      "id": "concurrent_updates_join",
      "input_values": [
        3,
        7,
        0,
        0,
        0,
        0,
        1,
        0,
        2,
        0,
        1,
        3,
        0,
        1,
        1,
        0,
        0,
        1,
        1,
        0,
        2,
        0,
        1
      ],
      "expected_result": -4351521609349833305
    },
    {
      "id": "merge_idempotence_and_order",
      "input_values": [
        2,
        6,
        0,
        1,
        0,
        0,
        1,
        0,
        3,
        0,
        1,
        3,
        0,
        1,
        1,
        0,
        0,
        2,
        0,
        1
      ],
      "expected_result": -8891481836687987386
    },
    {
      "id": "empty_counter_set",
      "input_values": [
        4,
        0
      ],
      "expected_result": -8925661592318841563
    }
  ]
}
