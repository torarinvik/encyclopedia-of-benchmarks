  "contract": {
    "operation": "Initialize all vertices uncolored. In each worklist round, each pending vertex picks the lowest color not used by already-colored neighbors from the start-of-round snapshot. The conflict phase requeues the lower-ID endpoint of each same-color edge and resets only that endpoint to the uncolored sentinel.",
    "round_order": "Vertices and adjacency rows use ascending ID order; first-fit assignments read the prior-round color snapshot, then conflicts are resolved after all assignments.",
    "max_color": 128,
    "profile_projection": "The source's linear CUDA first-fit/conflict worklist phases are preserved with deterministic single-worker ordering. The OpenMP path's uncolored-sentinel indexing is avoided by following the linear CUDA variant's explicit sentinel check.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
