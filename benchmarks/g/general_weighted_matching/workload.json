{
  "schema_version": 1,
  "id": "library-checker-general-weighted-matching-bounded-i64-array-bytes-output-v1",
  "algorithm": "general_weighted_matching",
  "function_symbol": "general_weighted_matching",
  "abi": "i64_array_bytes_output",
  "description": "Maximum-total-weight matching in a bounded simple undirected graph by exact bitmask dynamic programming.",
  "source": {
    "title": "General Weighted Matching",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker task contract; local profile uses clean-room bitmask DP",
    "url": "https://raw.githubusercontent.com/yosupo06/library-checker-problems/master/graph/general_weighted_matching/task.md",
    "limits_url": "https://raw.githubusercontent.com/yosupo06/library-checker-problems/master/graph/general_weighted_matching/info.toml",
    "algorithm_attribution": "Exact maximum-weight matching by unmatched-or-paired subset recurrence",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,u0,v0,w0,...] with one triple per undirected edge",
    "N_range": [1, 16],
    "M_range": "0 <= M <= N*(N-1)/2",
    "weight_range": [1, 1000000],
    "edge_rule": "simple undirected graph; endpoint order is arbitrary; self-loops and duplicate unordered pairs are invalid",
    "maximum_valid_length": 362,
    "maximum_parseable_length": 363,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "little-endian signed 64-bit words [matching_size,total_weight,u0,v0,...] with normalized pairs in deterministic order",
    "maximum_bytes": 144,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 144,
    "meaning": "Maximum output-buffer capacity; graph and 2^N DP storage are separate bounded memory."
  },
  "contract": {
    "objective": "maximize the sum of weights of a set of pairwise vertex-disjoint edges; an empty matching is allowed",
    "official_N_range": [1, 500],
    "official_M_range": "0 <= M <= N*(N-1)/2",
    "official_weight_range": [1, 1000000],
    "certificate": "matching size, total weight, followed by matched endpoint pairs"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "single-vertex-empty-matching",
      "input_values": [1, 0],
      "input_length": 2,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
      "id": "empty-four-vertex-graph",
      "input_values": [4, 0],
      "input_length": 2,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
      "id": "weighted-choice-beats-cardinality",
      "input_values": [4, 4, 0, 1, 5, 1, 2, 10, 2, 3, 5, 0, 3, 6],
      "input_length": 14,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "020000000000000010000000000000000000000000000000030000000000000001000000000000000200000000000000"
    },
    {
      "id": "odd-cycle-maximum-weight",
      "input_values": [3, 3, 0, 1, 5, 1, 2, 9, 0, 2, 8],
      "input_length": 11,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000090000000000000001000000000000000200000000000000"
    },
    {
      "id": "cycle-deterministic-tie",
      "input_values": [4, 4, 0, 1, 1, 1, 2, 1, 2, 3, 1, 0, 3, 1],
      "input_length": 14,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "020000000000000002000000000000000000000000000000010000000000000002000000000000000300000000000000"
    },
    {
      "id": "reversed-duplicate-edge-is-invalid",
      "input_values": [3, 2, 0, 1, 4, 1, 0, 5],
      "input_length": 8,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "self-loop-is-invalid",
      "input_values": [2, 1, 1, 1, 3],
      "input_length": 5,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "zero-edge-weight-is-invalid",
      "input_values": [2, 1, 0, 1, 0],
      "input_length": 5,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "weight-above-local-bound-is-invalid",
      "input_values": [2, 1, 0, 1, 1000001],
      "input_length": 5,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "truncated-edge-record",
      "input_values": [2, 1, 0, 1],
      "input_length": 4,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "vertex-limit-is-enforced",
      "input_values": [17, 0],
      "input_length": 2,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "trailing-word-is-invalid",
      "input_values": [1, 0, 99],
      "input_length": 3,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient-output-capacity",
      "input_values": [1, 0],
      "input_length": 2,
      "output_capacity": 15,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output-buffer",
      "input_values": [1, 0],
      "input_length": 2,
      "output_capacity": 16,
