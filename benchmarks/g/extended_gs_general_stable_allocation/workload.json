  "function_symbol": "extended_gs_general_stable_allocation",
  "abi": "i64_array_bytes_output",
  "description": "Bounded Extended-GS trace for separable-concave multi-unit stable allocations.",
  "source": {
    "title": "Stable Marriage and Discrete Convex Analysis",
    "authors": ["Akihisa Tamura"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_394",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_394",
    "algorithm_attribution": "Extended-GS for a bounded separable-concave M-natural-concave allocation subclass.",
    "implementation_status": "clean-room bounded profile; no chapter prose or cited-paper code copied"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[men_count,women_count,quota,(man_first_marginal,man_second_marginal,woman_first_marginal,woman_second_marginal)*]",
    "men_count_range": [1, 2],
    "women_count_range": [1, 2],
    "quota_range": [1, 2],
    "edge_marginal_range": [0, 8],
    "concavity_rule": "For each person-edge utility, second marginal is no larger than the first.",
    "maximum_valid_length": 19,
    "maximum_parseable_length": 19,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[edge_count,x_M[edge_count],z_M[edge_count],componentwise_max(z_W,x_M)[edge_count]]; edge order is row-major man/woman",
    "infinity_sentinel": 255,
    "maximum_values": 13,
    "maximum_bytes": 104,
    "success_result": "8 * output_value_count bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "At most four edge allocations, two 3^4 bounded maximization scans, Extended-GS bounds, and staged output."
  },
  "contract": {
    "allocation_domain": "Each edge count is 0, 1, or 2; each person's total allocation is at most the shared quota.",
    "utility": "For count 0, utility is 0; count 1 earns the first marginal; count 2 earns the sum of first and second marginals.",
    "aggregate_functions": "f_M and f_W are sums of the respective persons' edge utilities on their quota-bounded domains.",
    "initial_state": "z_M is infinity on every edge; z_W and x_W are zero.",
    "maximization_tie": "At each argmax, choose the lexicographically smallest row-major edge-allocation vector among maximizers.",
    "bound_update": "For each edge with x_M(e)>x_W(e), set z_M(e)=x_W(e) and z_W(e)=infinity.",
    "termination": "Repeat until x_M=x_W; return x_M, z_M, and componentwise max(z_W,x_M).",
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "Primary oracle enumerates all global edge vectors for aggregate argmaxes. Independent verifier enumerates each person's feasible edge vector separately and combines the independent choices.",
