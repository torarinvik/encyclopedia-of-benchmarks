  "contract": {
    "operation": "Compute a spanning forest by repeatedly hooking each component root to its smallest lower-ID adjacent component root and emitting one original edge witness per hook.",
    "launcher_profile": "The source runner requires symmetric graph input. The profile uses a canonical undirected edge list and deterministic single-worker scan order.",
    "source_profile": "Initialize each vertex as its own parent. In each round, inspect old parent labels on edges, write-min each higher root's parent to the lowest adjacent lower root, record an edge witness for each successful root hook, then compress parent paths. Stop when no root is hooked.",
    "projection": "The source uses parallel compare-and-swap to choose one edge witness per root hook. This profile chooses the lowest input-edge ordinal connecting the two old-round components, returns membership bytes in input order, and ignores timing and optional statistics.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
