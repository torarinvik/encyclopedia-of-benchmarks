  "schema_version": 1,
  "id": "rust-weighted-undirected-graph-i32-weights-v1",
  "algorithm": "graph_rust_weighted",
  "function_symbol": "graph_rust_weighted",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[vertex_count, edge_count, (u, v, weight)...]",
    "vertex_count_range": [
      0,
      64
    ],
    "edge_count_range": [
      0,
      256
    ],
    "maximum_input_length": 770,
    "vertex_ids": "dense labels 0 through vertex_count-1, represented as decimal strings by the source graph",
    "weight_range": [
      -2147483648,
      2147483647
    ],
    "construction": "Add all vertices in ascending label order, then insert each undirected edge in input order.",
    "edge_behavior": "Self-loops and parallel edges are allowed. Each add_edge call appends both endpoint neighbor records; a self-loop therefore appends twice to one node.",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[vertex_count, degree_0, (neighbor, weight)*, degree_1, (neighbor, weight)*, ...]",
    "ordering": "Nodes are serialized in ascending label order; each adjacency list preserves edge insertion order.",
    "return_value": "number of output bytes",
    "max_output_values": 1089,
    "max_output_bytes": 8712,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
