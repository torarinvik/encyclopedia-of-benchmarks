  "contract": {
    "operation": "For each CSR edge u->v, compute leaky_relu(dot(alpha_l,X[u])+dot(alpha_r,X[v]),0.2), softmax the row scores, and sum weighted destination feature vectors.",
    "input_encoding": "[n,m,d,rowptr[n+1],colind[m],alpha_l[d],alpha_r[d],X[n*d]]",
    "exact_input_length": "4+n+m+2*d+n*d",
    "output_encoding": "Y[n*d] in vertex-major then feature-major order",
    "arithmetic": "Finite binary64; edge scores and weighted-vector accumulation follow CSR order; softmax subtracts the row maximum; empty rows emit zeros.",
    "bounds": {"n": [1, 8], "m": [0, 24], "d": [1, 4], "coefficients_and_features": [-8, 8]},
    "invalid_input_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
  "input": {"kind": "finite_float64_array", "maximum_input_length": 76, "invalid_result": -1},
  "output": {"kind": "float64_array", "maximum_elements": 32, "success_result": "n*d output elements", "null_or_short_result": -2, "no_write_on_error": true, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
  "workspace": {"elements": 32, "meaning": "Fixed CSR and score arrays plus staged output at declared bounds."},
  "measurement": {"comparison_model": "float64_slice_io_call", "sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 100, "absolute_tolerance": 1e-12, "relative_tolerance": 1e-12},
