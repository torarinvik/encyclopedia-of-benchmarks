{
  "schema_version": 1,
  "id": "python-generate-rule-30-grid-row-major-bytes-v1",
  "algorithm": "generate_rule_30_grid",
  "function_symbol": "generate_rule_30_grid",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[width, generation_count]",
    "width_range": [
      1,
      64
    ],
    "generation_count_range": [
      1,
      64
    ],
    "invalid_result": -1
  },
  "output": {
    "kind": "row_major_binary_cell_bytes",
    "encoding": "one byte (0 or 1) per cell, all cells of row 0 then row 1, etc.",
    "meaning": "generation_count rows; row 0 is the seed, subsequent rows are Rule 30 transitions",
    "result": "number of output bytes, width * generation_count",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "maximum_output_bytes": 4096
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "maximum flattened grid output size"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 25
  },
  "cases": [
    {
      "id": "single_cell_single_generation",
      "input_values": [
        1,
        1
      ],
      "input_length": 2,
      "expected_result": 1,
      "expected_output_hex": "01"
    },
    {
      "id": "single_cell_multiple_generations",
      "input_values": [
        1,
        6
      ],
      "input_length": 2,
      "expected_result": 6,
      "expected_output_hex": "010101010101"
    },
    {
      "id": "even_width_seed_uses_right_center",
      "input_values": [
        2,
        1
      ],
      "input_length": 2,
      "expected_result": 2,
      "expected_output_hex": "0001"
    },
    {
      "id": "even_width_two_generations",
      "input_values": [
        2,
        2
      ],
      "input_length": 2,
      "expected_result": 4,
      "expected_output_hex": "00010101"
    },
    {
      "id": "odd_width_seeded_initial_and_evolution",
      "input_values": [
        5,
        5
      ],
      "input_length": 2,
      "expected_result": 25,
      "expected_output_hex": "00000100000001010100010100000101000101010100010000"
    },
    {
      "id": "one_generation_returns_seed_only",
      "input_values": [
        7,
        1
      ],
      "input_length": 2,
      "expected_result": 7,
      "expected_output_hex": "00000001000000"
    },
    {
      "id": "maximum_width_and_generations",
      "input_values": [
        64,
        64
      ],
      "input_length": 2,
      "expected_result": 4096,
      "expected_output_hex": ""
    },
    {
      "id": "capacity_too_small",
      "input_values": [
        4,
        3
      ],
      "input_length": 2,
      "expected_result": -2,
      "expected_output_hex": "",
      "workspace_bytes": 11,
      "capacity_error_result": -2
    },
    {
      "id": "width_zero",
      "input_values": [
        0,
        1
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "generation_count_zero",
      "input_values": [
        1,
        0
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "width_over_bound",
      "input_values": [
        65,
        1
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "generation_count_over_bound",
      "input_values": [
        1,
        65
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "missing_generation_count",
      "input_values": [
        4
      ],
      "input_length": 1,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "extra_input_value",
      "input_values": [
        4,
        2,
        9
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_width",
      "input_values": [
        -1,
        1
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_generation_count",
      "input_values": [
        1,
        -1
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
