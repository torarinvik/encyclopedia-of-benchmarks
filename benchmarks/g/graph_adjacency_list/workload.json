{
  "schema_version": 1,
  "id": "graph-adjacency-list-adt-trace-v1",
  "algorithm": "graph_adjacency_list",
  "function_symbol": "graph_adjacency_list",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[directed, initial_vertex_count, vertex_ids..., initial_edge_count, (from,to)..., operation_count, (operation,a,b)...]",
    "directed_values": {
      "0": "undirected",
      "1": "directed"
    },
    "vertex_id_range": [
      0,
      31
    ],
    "initial_vertex_count_range": [
      0,
      32
    ],
    "initial_edge_count_range": [
      0,
      1024
    ],
    "operation_count_range": [
      0,
      64
    ],
    "operations": {
      "0": "add vertex a; b must be 0",
      "1": "remove vertex a; b must be 0",
      "2": "add edge a->b",
      "3": "remove edge a->b",
      "4": "contains vertex a; b must be 0",
      "5": "contains edge a->b",
      "6": "clear graph; a and b must be 0"
    },
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[operation_count, result per operation (1/0), final_vertex_count, (vertex_id,neighbor_count,neighbor_ids...)* in vertex insertion order]",
    "neighbor_order": "edge insertion order; undirected add appends reciprocal neighbor; undirected self-loop appends twice",
    "return_value": "number of bytes written"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 500
  },
