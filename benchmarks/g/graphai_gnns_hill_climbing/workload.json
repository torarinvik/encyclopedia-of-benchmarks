{
  "schema_version": 1,
  "id": "encyclopedia-graphai-gnns-hill-climbing-i64-array-scalar-v1",
  "algorithm": "graphai_gnns_hill_climbing",
  "function_symbol": "graphai_gnns_hill_climbing",
  "abi": "i64_array_scalar",
  "description": "One-start bounded GNNS-style greedy search over a caller-supplied directed k-NN graph.",
  "source": {
    "title": "Fast Approximate Nearest-Neighbor Search with k-Nearest Neighbor Graph",
    "authors": ["Kiana Hajebi", "Yasin Abbasi-Yadkori", "Hossein Shahbazi", "Hong Zhang"],
    "year": 2011,
    "reference": "IJCAI 2011, pages 1312-1316, DOI 10.5591/978-1-57735-516-8/IJCAI11-222",
    "url": "https://ijcai.org/proceedings/2011/222",
    "copyright": "Algorithm idea and citation only; the bounded contract and implementations are clean-room work."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,D,start,E,T,point_coordinates[N*D],outgoing_masks[N],query[D]]",
    "vertex_count_range": [2, 16],
    "dimension_range": [1, 4],
    "start_vertex_range": "0..N-1",
    "expansions_range": "1..N-1",
    "greedy_steps_range": [0, 16],
    "coordinate_range": [-100, 100],
    "graph": "Caller-supplied directed k-NN adjacency masks; each mask has no self bit and no bits at IDs >= N.",
    "exact_length": "5+N*D+N+D",
    "maximum_valid_length": 89,
    "maximum_parseable_length": 90,
    "invalid_input_result": -1
  },
  "profile_controls": {
    "offline_graph_construction": "precomputed and supplied as input; excluded",
    "K": 1,
    "R": 1,
    "start_selection": "caller-supplied; no random sampling",
    "neighbor_order": "ascending vertex ID; examine at most the first E outgoing neighbors",
    "distance": "integer squared Euclidean distance",
    "termination": "stop at a local minimum or after T greedy moves",
    "visited_nodes": "No visited set is used; strict distance improvement makes revisiting impossible."
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "Packed distance_evaluations, move_count, final_vertex, and final_squared_distance.",
    "packing": "(((distance_evaluations*17+move_count)*16+final_vertex)*160001+final_squared_distance)",
    "distance_evaluations": "One for the start point plus one per outgoing neighbor actually inspected.",
    "tie_rule": "Candidate ordering uses (squared_distance,vertex_id); a move occurs only on strict improvement over the current distance."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
