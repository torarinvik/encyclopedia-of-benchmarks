    {"id":"equal-distance-neighbor-does-not-move","input_values":[2,1,0,1,4,1,-1,2,1,0],"input_length":10,"expected_result":87040545},
    {"id":"zero-step-budget","input_values":[2,1,1,1,0,0,3,0,0,0],"input_length":10,"expected_result":43680282},
    {"id":"expansion-order-is-vertex-id","input_values":[4,1,0,1,3,5,3,0,1,14,0,0,0,0],"input_length":14,"expected_result":89760570},
    {"id":"no-outgoing-neighbors","input_values":[2,1,1,1,2,0,5,0,0,0],"input_length":10,"expected_result":43680298},
    {"id":"invalid-too-few-vertices","input_values":[1,1,0,0,0],"input_length":5,"expected_result":-1},
    {"id":"invalid-coordinate-bound","input_values":[2,1,0,1,0,101,0,0,0,0],"input_length":10,"expected_result":-1},
    {"id":"invalid-self-edge","input_values":[2,1,0,1,0,0,1,1,0,0],"input_length":10,"expected_result":-1},
