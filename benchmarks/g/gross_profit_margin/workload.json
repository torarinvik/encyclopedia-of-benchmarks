{
  "schema_version": 1,
  "id": "gross_profit_margin-packed-i64-binary64-v1",
  "algorithm": "gross_profit_margin",
  "function_symbol": "gross_profit_margin",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": [
      "revenue",
      "cost"
    ],
    "exact_length": 2,
    "value_domain": "revenue in [1, 1,000,000], cost in [0, 1,000,000]",
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "(revenue - cost) / revenue",
    "invalid_input_result": -1e+300,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "source_example",
      "input_values": [
        1000,
        800
      ],
      "input_length": 2,
      "expected_result": 0.2
    },
    {
      "id": "loss",
      "input_values": [
        800,
        1000
      ],
      "input_length": 2,
      "expected_result": -0.25
    },
    {
      "id": "zero_cost",
      "input_values": [
        100,
        0
      ],
      "input_length": 2,
      "expected_result": 1.0
    },
    {
      "id": "zero_revenue",
      "input_values": [
        0,
        0
      ],
      "input_length": 2,
      "expected_result": -1e+300
    },
    {
      "id": "wrong_input_length",
      "input_values": [
        1000
      ],
      "input_length": 1,
      "expected_result": -1e+300
    }
  ]
}
