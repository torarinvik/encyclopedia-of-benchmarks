    "implementation_status": "bounded clean-room profile"
  },
  "contract": {
    "operation": "Return the least nonnegative solution modulo lcm(m_i), -2 if the congruences conflict, or -1 for malformed input.",
    "input_encoding": "[Q,r0,m0,...,r(Q-1),m(Q-1)]",
    "primary_method": "Factor each modulus into prime powers, retain each prime's highest power, reject incompatible lower-power residues, and combine the remaining pairwise-coprime congruences.",
    "independent_method": "Merge the original congruences successively by solving a two-modulus linear congruence with extended gcd.",
    "invalid_input_result": -1,
    "inconsistent_result": -2
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[Q,r0,m0,...,r(Q-1),m(Q-1)]",
    "equation_count_range": [1, 4],
    "modulus_range": [2, 64],
    "residue_rule": "0 <= r_i < m_i",
    "modulus_product_maximum": 16777216,
    "maximum_valid_length": 9,
    "maximum_parseable_length": 10,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "least nonnegative solution, -2 for inconsistent congruences, or -1 for invalid input",
    "solution_range": [0, 16777215],
    "inconsistent_result": -2,
    "invalid_input_result": -1
  },
