  "abi": "i64_array_scalar",
  "description": "Solve a bounded system of congruences with possibly non-coprime moduli.",
  "source": {
    "title": "Chinese Remainder Theorem — solution for not coprime moduli",
    "authors": ["CP-Algorithms contributors"],
    "url": "https://cp-algorithms.com/algebra/chinese-remainder-theorem.html#solution-for-not-coprime-moduli",
