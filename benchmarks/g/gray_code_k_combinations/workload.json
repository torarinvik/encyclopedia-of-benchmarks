{
  "schema_version": 1,
  "id": "gray-code-k-combinations-i64-array-bytes-output-v1",
  "algorithm": "gray_code_k_combinations",
  "function_symbol": "gray_code_k_combinations",
  "abi": "i64_array_bytes_output",
  "description": "Enumerate fixed-cardinality subsets in reflected Gray-code order.",
  "source": {
    "title": "CP-Algorithms: Generating all K-combinations",
    "authors": ["CP-Algorithms contributors"],
    "reference": "Reflected Gray-code filtering for fixed-cardinality subsets",
    "url": "https://cp-algorithms.com/combinatorics/generating_combinations.html",
    "license": "CC BY-SA 4.0",
    "algorithm_attribution": "Filter reflected Gray-code masks by population count; use the direct fixed-weight recurrence as an independent reference",
    "implementation_status": "clean-room implementations from algorithm descriptions"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,K]",
    "universe_size_range": [0, 12],
    "subset_size_range": "0 <= K <= N",
    "exact_length": 2,
    "maximum_valid_input_length": 2,
    "maximum_parseable_input_length": 3,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_unsigned_16_bit_mask_array",
    "encoding": "u16 combination_count followed by C(N,K) u16 position masks in reflected Gray order",
    "result": "C(N,K), the number of masks emitted",
    "maximum_combination_count": 924,
    "maximum_output_bytes": 1850,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "invalid_input_result": -1
  },
  "complexity": {
    "primary_time": "O(N*2^N) Gray-mask filtering with an O(N) population-count loop per mask",
    "primary_auxiliary_space": "O(1) beyond the output buffer",
    "independent_reference_time": "O(N*C(N,K)) recursive fixed-weight generation"
  },
  "workspace": {
    "bytes": 1850,
    "meaning": "Maximum output capacity; ports emit directly into the caller's buffer and use constant auxiliary state."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
