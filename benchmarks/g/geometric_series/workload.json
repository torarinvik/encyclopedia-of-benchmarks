{
  "schema_version": 1,
  "id": "geometric-series-sequence-v1",
  "algorithm": "geometric_series",
  "function_symbol": "geometric_series",
  "input": {
    "kind": "three_signed_64_bit_integers",
    "values": [
      "term_count",
      "first_term",
      "common_ratio"
    ],
    "valid_ranges": {
      "term_count": [
        0,
        16
      ],
      "first_term": [
        1,
        8
      ],
      "common_ratio": [
        1,
        4
      ]
    },
    "normalization": "return the first term and each successive term multiplied by common_ratio, each encoded as little-endian IEEE-754 binary64",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "output_encoding": "concatenated 8-byte little-endian binary64 values"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "zero_terms",
      "input_values": [
        0,
        2,
        3
      ],
      "input_length": 3,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "one_term",
      "input_values": [
        1,
        2,
        3
      ],
      "input_length": 3,
      "expected_result": 8,
      "expected_output_hex": "0000000000000040"
    },
    {
      "id": "pinned_example",
      "input_values": [
        4,
        2,
        2
      ],
      "input_length": 3,
      "expected_result": 32,
      "expected_output_hex": "0000000000000040000000000000104000000000000020400000000000003040"
    },
    {
      "id": "ratio_one",
      "input_values": [
        5,
        3,
        1
      ],
      "input_length": 3,
      "expected_result": 40,
      "expected_output_hex": "00000000000008400000000000000840000000000000084000000000000008400000000000000840"
    },
    {
      "id": "larger_ratio",
      "input_values": [
        8,
        1,
        4
      ],
      "input_length": 3,
      "expected_result": 64,
      "expected_output_hex": "000000000000f03f00000000000010400000000000003040000000000000504000000000000070400000000000009040000000000000b040000000000000d040"
    },
    {
      "id": "maximum_length",
      "input_values": [
        16,
        1,
        2
      ],
      "input_length": 3,
      "expected_result": 128,
      "expected_output_hex": "000000000000f03f0000000000000040000000000000104000000000000020400000000000003040000000000000404000000000000050400000000000006040000000000000704000000000000080400000000000009040000000000000a040000000000000b040000000000000c040000000000000d040000000000000e040"
    },
    {
      "id": "term_count_too_large",
      "input_values": [
        17,
        1,
        2
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "zero_start",
      "input_values": [
        4,
        0,
        2
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "zero_ratio",
      "input_values": [
        4,
        2,
        0
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "negative_ratio",
      "input_values": [
        4,
        2,
        -2
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "wrong_shape",
      "input_values": [
        4,
        2
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
