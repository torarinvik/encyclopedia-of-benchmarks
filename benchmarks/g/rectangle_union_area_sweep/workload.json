  "workspace": {
    "bytes": 13824,
    "description": "13,312 bytes for y endpoints, four-field events, and two signed-64 segment-tree arrays; up to 512 additional bytes for Mojo's bounded 32-frame iterative update stack"
  },
  "method": {
    "operation": "Sort x-events and y endpoints. Sweep increasing x; add covered_y_length times the x gap before each event group, then apply all entering intervals before leaving intervals in the group. A compressed-y segment tree stores full-cover counts and covered lengths.",
    "time_complexity": "O(n log n)",
    "space_complexity": "O(n)",
    "distinct_from": "rectangle_union_area applies a fixed two-rectangle overlap formula; this profile sweeps an arbitrary bounded set and maintains its y-coverage measure in a segment tree."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
