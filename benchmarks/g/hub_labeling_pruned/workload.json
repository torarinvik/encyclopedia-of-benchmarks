{
  "schema_version": 1,
  "id": "encyclopedia-hub-labeling-pruned-i64-array-bytes-output-v1",
  "algorithm": "hub_labeling_pruned",
  "function_symbol": "hub_labeling_pruned",
  "abi": "i64_array_bytes_output",
  "description": "Deterministic hierarchical hub labels for bounded undirected unweighted graphs and a supplied vertex order.",
  "source": {
    "title": "Hub Labeling (2-Hop Labeling)",
    "authors": ["Daniel Delling", "Andrew V. Goldberg", "Renato F. Werneck"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_580",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_580",
    "algorithm_attribution": "Akiba-Iwata-Yoshida pruned labeling for an explicit high-to-low vertex order",
    "implementation_status": "clean-room deterministic bounded undirected profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[vertex_count,edge_count,order_high_to_low...,sorted_normalized_edge_pairs...]",
    "vertex_count_range": [1, 8],
    "edge_count_range": [0, 28],
    "maximum_valid_length": 66,
    "graph_rules": "Connected simple undirected graph with a unique shortest path between every vertex pair; each edge is u<v and edge pairs are strictly lexicographically increasing.",
    "order_rules": "The supplied vertices form a permutation, listed from highest rank to lowest rank.",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[vertex_count,(label_count,packed_hub_distance_entry...)*]; each packed entry is hub_id in bits 0..7 and distance(vertex,hub) in bits 8..15; hubs are sorted by ID.",
    "maximum_fields": 73,
    "maximum_bytes": 584,
    "success_result": "8 times the number of output fields",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Eight-by-eight adjacency and partial-label tables, pruned BFS queues, and staged output fields."
  },
  "contract": {
    "preprocessing": "Process hubs in supplied high-to-low order. Run BFS from each hub; before expanding a reached vertex, query the current labels. Prune when the label estimate is no greater than the BFS distance; otherwise add the hub-distance entry and expand neighbors in increasing vertex-ID order.",
    "query_estimate": "Minimum dist(v,x)+dist(w,x) over hubs x present in both current labels, or infinity if there is no common hub.",
    "shortest_path_tie_rule": "Reject any graph with a vertex pair having more than one shortest path; validate with BFS path counts capped at two from every source.",
    "canonical_behavior": "For each vertex pair, the unique shortest path has one highest-ranked vertex; that hub is added to both endpoint labels, including self-pairs.",
    "distance_model": "Unweighted undirected graph; every edge has length one.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
