{
  "schema_version": 1,
  "id": "graph-swift-directed-paths-v1",
  "algorithm": "graph_swift_directed_paths",
  "function_symbol": "graph_swift_directed_paths",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[vertex_count,edge_count,(from,to)...,query_count,(mode,start,destination)...]",
    "vertex_count_range": [
      1,
      32
    ],
    "edge_count_range": [
      0,
      256
    ],
    "query_count_range": [
      1,
      64
    ],
    "edge_direction": "directed; every edge must satisfy from < to, so the graph is a DAG",
    "edge_order": "adjacency lists preserve edge insertion order; duplicate edges are accepted",
    "search_modes": {
      "0": "depth-first search",
      "1": "breadth-first search"
    },
    "node_id_range": "0 through vertex_count - 1",
    "input_length": "exactly 3 + 2 * edge_count + 3 * query_count",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "query_order": "vertex IDs are topologically ordered; edges go only from lower to higher IDs"
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "for each query: edge_count followed by destination node IDs along the path; -1 edge_count means no path; zero means start equals destination",
    "return_value": "number of output bytes written"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
