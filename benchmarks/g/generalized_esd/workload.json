{
  "schema_version": 1,
  "id": "generalized-esd-i64-array-scalar-v1",
  "algorithm": "generalized_esd",
  "function_symbol": "generalized_esd",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[sample_count, maximum_outliers, sample_value...]",
    "sample_count_range": [3, 8],
    "maximum_outliers_range": [1, 3],
    "value_range": [-10000, 10000],
    "significance_level": 0.05,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "bit i is set when original sample index i is among the accepted generalized ESD outliers",
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"single_high_outlier", "input_values":[7,2,1,2,2,3,4,5,30], "input_length":9, "expected_result":64},
    {"id":"multiple_high_outliers", "input_values":[8,3,0,1,2,3,4,5,20,22], "input_length":10, "expected_result":192},
    {"id":"low_outlier", "input_values":[7,2,-30,0,1,2,3,4,5], "input_length":9, "expected_result":1},
    {"id":"clean_sample", "input_values":[8,3,1,2,3,4,5,6,7,8], "input_length":10, "expected_result":0},
    {"id":"constant_sample", "input_values":[5,2,9,9,9,9,9], "input_length":7, "expected_result":0},
    {"id":"invalid_sample_count", "input_values":[2,1,0,1], "input_length":4, "expected_result":-1},
    {"id":"invalid_outlier_limit", "input_values":[4,3,0,1,2,3], "input_length":6, "expected_result":-1},
    {"id":"invalid_value", "input_values":[3,1,0,10001,1], "input_length":5, "expected_result":-1}
  ]
}
