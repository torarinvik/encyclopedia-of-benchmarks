  "algorithm": "segment_union_length_klee",
  "function_symbol": "segment_union_length_klee",
  "abi": "i64_array_scalar",
  "source": {
    "title": "Length of the union of segments",
    "url": "https://cp-algorithms.com/geometry/length-of-segments-union.html",
    "license": "CC BY-SA 4.0",
    "reuse": "algorithm description only; clean-room bounded profile"
  },
  "input": {
    "encoding": "[n,(left,right)*n]",
    "n_range": [0,64],
    "endpoint_range": [-1000,1000],
    "interval_convention": "closed intervals; union measure is independent of endpoint inclusion",
    "maximum_valid_length": 129,
    "maximum_parseable_length": 130,
    "invalid_result": -1
  },
  "output": {
    "encoding": "continuous measure of the union of all intervals",
    "result_range": "0..2000",
    "invalid_result": -1
  },
  "method": {
    "description": "Sort tagged endpoint events, count active intervals between consecutive coordinate groups, and accumulate each covered gap.",
    "time": "O(n log n)",
    "auxiliary_space": "O(n)",
    "event_tie_rule": "all events at one coordinate are grouped before the next slab is considered"
  },
  "workspace": {"bytes": 1024},
  "measurement": {"comparison_model": "i64_array_scalar_call", "sample_count": 7, "warmup_rounds": 1, "repetitions_per_sample": 100},
