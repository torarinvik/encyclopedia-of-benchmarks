{
  "schema_version": 1,
  "id": "csharp-geohash-12-char-microdegree-v1",
  "algorithm": "geohash",
  "function_symbol": "geohash",
  "input": {
    "encoding": "[latitude_microdegrees, longitude_microdegrees]",
    "latitude_bounds": [
      -90000000,
      90000000
    ],
    "longitude_bounds": [
      -180000000,
      180000000
    ]
  },
  "output": {
    "kind": "ascii_bytes",
    "length": 12,
    "alphabet": "0123456789bcdefghjkmnpqrstuvwxyz",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
      "id": "origin",
      "input_values": [
        0,
        0
      ],
      "expected_result": 12,
      "expected_output_hex": "377a7a7a7a7a7a7a7a7a7a7a"
    },
    {
      "id": "san_francisco",
      "input_values": [
        37422000,
        -122084000
      ],
      "expected_result": 12,
      "expected_output_hex": "3971396876756d6e75773774"
    },
    {
      "id": "london",
      "input_values": [
        51507400,
        -127800
      ],
