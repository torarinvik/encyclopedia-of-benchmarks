  "abi": "i64_array_bytes_output",
  "source": {
    "repository": "yosupo06/library-checker-problems",
    "task_path": "graph/global_minimum_cut_of_dynamic_star_augmented_graph/task.md",
    "limits_path": "graph/global_minimum_cut_of_dynamic_star_augmented_graph/info.toml",
    "task_url": "https://github.com/yosupo06/library-checker-problems/blob/master/graph/global_minimum_cut_of_dynamic_star_augmented_graph/task.md",
    "limits_url": "https://raw.githubusercontent.com/yosupo06/library-checker-problems/master/graph/global_minimum_cut_of_dynamic_star_augmented_graph/info.toml",
    "repository_license": "Apache-2.0",
    "reuse_scope": "The graph/update operation is from the task; local bounds and bounded recomputation profile are clean-room."
  },
  "contract": {
    "operation": "Given a simple weighted undirected graph on N original vertices and N star edges to a new supernode, process each spoke-weight replacement and emit the augmented graph's global min-cut after the replacement.",
    "input_layout": "[N,M,Q,spoke_weights[N],edges[3*M],updates[2*Q]]; edge and update vertices are zero-based.",
    "n_range": [1, 16],
    "m_range": "0..min(N*(N-1)/2,64)",
    "q_range": [1, 32],
    "weight_range": [0, 1000000],
    "algorithm": "Apply one star-edge replacement, then recompute the current graph min-cut with Stoer-Wagner for each update. This bounded profile does not claim the official dynamic-scale performance.",
    "tie_rule": "Stoer-Wagner phase selection chooses maximum accumulated adjacency weight, breaking ties by lowest active vertex ID.",
    "output_layout": "Q little-endian signed 64-bit global min-cut weights.",
    "error_precedence": "Malformed frame, graph, weight, or update returns -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,Q,spoke_weights[N],edges[3*M],updates[2*Q]]",
    "n_range": [1, 16],
    "m_maximum": 64,
    "q_range": [1, 32],
    "weight_range": [0, 1000000],
    "maximum_valid_length": 275,
    "maximum_parseable_length": 276,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 32,
    "maximum_output_bytes": 256,
    "success_result": "8*Q bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 256,
    "meaning": "Maximum staged output buffer; the bounded adjacency matrix has at most 17 by 17 entries."
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 5, "warmup_rounds": 1, "repetitions_per_sample": 100},
  "cases": [
    {"id": "single-original-vertex-updates", "input_values": [1, 0, 2, 5, 0, 3, 0, 0], "expected_result": 16, "expected_output_hex": "03000000000000000000000000000000", "input_length": 8},
    {"id": "triangle-min-cut-after-replacements", "input_values": [3, 3, 3, 1, 4, 5, 0, 1, 2, 1, 2, 2, 0, 2, 2, 0, 10, 1, 0, 2, 0], "expected_result": 24, "expected_output_hex": "080000000000000004000000000000000400000000000000", "input_length": 21},
    {"id": "disconnected-original-graph", "input_values": [2, 0, 1, 0, 7, 0, 3], "expected_result": 8, "expected_output_hex": "0300000000000000", "input_length": 7},
    {"id": "duplicate-undirected-edge", "input_values": [3, 2, 1, 1, 1, 1, 0, 1, 1, 1, 0, 2, 0, 1], "expected_result": -1, "expected_output_hex": "", "input_length": 14},
    {"id": "self-loop-edge", "input_values": [2, 1, 1, 1, 1, 0, 0, 1, 0, 0], "expected_result": -1, "expected_output_hex": "", "input_length": 10},
    {"id": "update-vertex-out-of-range", "input_values": [1, 0, 1, 3, 1, 4], "expected_result": -1, "expected_output_hex": "", "input_length": 6},
    {"id": "short-capacity", "input_values": [1, 0, 2, 5, 0, 3, 0, 0], "output_capacity": 15, "expected_result": -2, "expected_output_hex": "", "input_length": 8},
    {"id": "null-output", "input_values": [1, 0, 2, 5, 0, 3, 0, 0], "output_is_null": true, "expected_result": -2, "expected_output_hex": "", "input_length": 8}
  ]
}
