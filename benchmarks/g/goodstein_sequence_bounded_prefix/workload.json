  "contract": {
    "initial_base": 2,
    "transition": "For each positive current term, form its canonical hereditary base-b expansion, recursively represent every exponent in the same hereditary base, replace every base symbol b by b+1 throughout, evaluate exactly, subtract one, then advance b by one.",
    "prefix_rule": "Emit the initial term first; perform at most max_transitions transitions and stop immediately after emitting zero.",
    "full_termination_claim": false,
    "value_bound": "For starts 0..3, all emitted terms are at most 3. For start 4, the first successor is 26 at base 3; thereafter the hereditary exponents are at most 2 and each emitted value at base b is less than 3*b^2. Through the 16-transition cap b<=18, so every value and powered summand is below 972.",
    "validation_precedes_capacity": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Includes the 17-word staged prefix, recursive hereditary-conversion/evaluation state, and scalar/index state; caller input/output are excluded."
  },
  "complexity": {
    "primary_time": "At most 16 transitions of recursive digit decomposition, with all intermediate terms below 972",
    "primary_auxiliary_space": "O(t+d) including the staged output and recursion",
