{
  "schema_version": 1,
  "id": "garsia-wachs-alphabetic-tree-bounded-v1",
  "algorithm": "garsia_wachs_alphabetic_tree",
  "function_symbol": "garsia_wachs_alphabetic_tree",
  "abi": "i64_array_bytes_output",
  "description": "Minimum weighted external path length for ordered leaf weights, using Garsia–Wachs phase-and-reconstruction.",
  "source": {
    "title": "OI Wiki: Garsia–Wachs algorithm",
    "authors": ["OI Wiki contributors"],
    "reference": "Garsia–Wachs algorithm chapter",
    "url": "https://oi-wiki.org/misc/garsia-wachs/",
    "repository_license": "CC BY-SA 4.0 with SATA",
    "algorithm_attribution": "Garsia–Wachs ordered-alphabetic-tree phase and depth reconstruction",
    "implementation_status": "clean-room bounded profile; algorithm description only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, ordered_leaf_weights[N]]",
    "n_range": [1, 64],
    "weight_range": [0, 1000000],
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "[minimum_weighted_external_path_cost, ordered_leaf_depths[N]] as signed 64-bit little-endian words",
    "maximum_bytes": 520,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "single_leaf_result": [0, 0]
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed temporary tree nodes, active sequence, leaf-depth stack, reconstruction stack, and staged output."
  },
  "contract": {
    "operation": "Return the minimum weighted external path cost and left-to-right leaf depths of an ordered full binary tree.",
    "algorithm": "Select the first eligible adjacent pair, merge it, reinsert its parent after the nearest preceding weight at least as large, then reconstruct the ordered tree from leaf depths.",
    "complexity": "O(N^2) time and O(N) bounded storage for the fixed-array active sequence.",
    "tie_rule": "Scan eligible pairs left to right; stop reinsertion at the nearest preceding weight greater than or equal to the merged weight.",
    "error_precedence": "Validate the input frame and all weights, compute and reconstruct the result, then check output pointer and capacity before writing.",
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "single-leaf-zero-depth",
      "input_values": [1, 7],
      "input_length": 2,
      "output_capacity": 16,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
      "id": "two-equal-leaves",
      "input_values": [2, 1, 1],
      "input_length": 3,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "020000000000000001000000000000000100000000000000"
    },
    {
      "id": "balanced-four-leaf-tree",
      "input_values": [4, 1, 1, 1, 1],
      "input_length": 5,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "08000000000000000200000000000000020000000000000002000000000000000200000000000000"
    },
    {
      "id": "ordered-unequal-leaves",
      "input_values": [4, 1, 2, 3, 4],
      "input_length": 5,
      "output_capacity": 40,
      "expected_result": 40,
      "expected_output_hex": "13000000000000000300000000000000030000000000000002000000000000000100000000000000"
    },
    {
      "id": "skewed-optimal-tree",
      "input_values": [3, 1, 100, 1],
      "input_length": 4,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "cb00000000000000020000000000000002000000000000000100000000000000"
    },
    {
      "id": "zero-weight-tie-profile",
      "input_values": [3, 0, 0, 1],
      "input_length": 4,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000020000000000000002000000000000000100000000000000"
    },
    {
      "id": "weight-out-of-range",
      "input_values": [2, 1, 1000001],
      "input_length": 3,
      "output_capacity": 520,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-frame",
      "input_values": [2, 1],
      "input_length": 2,
      "output_capacity": 520,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient-capacity",
      "input_values": [2, 1, 1],
      "input_length": 3,
      "output_capacity": 23,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-output",
      "input_values": [2, 1, 1],
      "input_length": 3,
      "output_capacity": 24,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
