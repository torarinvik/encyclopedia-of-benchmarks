{
  "schema_version": 1,
  "id": "gale-shapley-v1",
  "algorithm": "gale_shapley",
  "input": {
    "kind": "packed_complete_preference_lists",
    "encoding": "[participant_count, proposer_preferences..., accepter_preferences...]",
    "maximum_participants_per_side": 5,
    "preference_rows": "one complete permutation of 0..participant_count-1 per participant",
    "matching_direction": "proposer index to accepter index"
  },
  "output": {
    "success": "one byte per proposer, containing its matched accepter index",
    "invalid_or_insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "empty_market",
      "input_values": [
        0
      ],
      "expected_result": 0,
      "expected_order": []
    },
    {
      "id": "single_pair",
      "input_values": [
        1,
        0,
        0
      ],
      "expected_result": 1,
      "expected_order": [
        0
      ]
    },
    {
      "id": "mutual_first_choices",
      "input_values": [
        2,
        0,
        1,
        1,
        0,
        0,
        1,
        1,
        0
      ],
      "expected_result": 2,
      "expected_order": [
        0,
        1
      ]
    },
    {
