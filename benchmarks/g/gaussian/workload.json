{
  "schema_version": 1,
  "id": "gaussian-python-i64-array-f64-v1",
  "algorithm": "gaussian",
  "function_symbol": "gaussian",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": ["x", "mu", "sigma"],
    "x_range": [-100, 100],
    "mu_range": [-100, 100],
    "sigma_range": [1, 100],
    "required_length": 3,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "meaning": "Gaussian density at x for mean mu and standard deviation sigma",
    "formula_order": "1 / sqrt(2*pi*sigma**2) * exp(-((x-mu)**2)/(2*sigma**2))",
    "invalid_input_result": -1e300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"standard-normal-peak","input_values":[0,0,1],"input_length":3,"expected_result":0.3989422804014327},
    {"id":"positive-one-standard-deviation","input_values":[1,0,1],"input_length":3,"expected_result":0.24197072451914337},
    {"id":"negative-one-standard-deviation","input_values":[-1,0,1],"input_length":3,"expected_result":0.24197072451914337},
    {"id":"shifted-mean-and-scale","input_values":[1,4,2],"input_length":3,"expected_result":0.06475879783294587},
    {"id":"density-at-the-mean","input_values":[5,5,3],"input_length":3,"expected_result":0.1329807601338109},
    {"id":"exponential-underflow","input_values":[100,0,1],"input_length":3,"expected_result":0.0},
    {"id":"maximum-sigma","input_values":[0,0,100],"input_length":3,"expected_result":0.003989422804014327},
    {"id":"invalid-zero-sigma","input_values":[0,0,0],"input_length":3,"expected_result":-1e300},
    {"id":"invalid-length","input_values":[0,1],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-x","input_values":[101,0,1],"input_length":3,"expected_result":-1e300}
  ]
}
