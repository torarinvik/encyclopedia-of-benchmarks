      "expected_output_hex": ""
    },
    {
      "id": "node_out_of_range",
      "input_values": [
        2,
        1,
        0,
        0,
        2,
        1
      ],
      "input_length": 6,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "weight_out_of_range",
      "input_values": [
        2,
