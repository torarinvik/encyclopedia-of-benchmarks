{
  "schema_version": 1,
  "id": "graph-lua-directed-weighted-trace-v1",
  "algorithm": "graph_lua_directed_weighted",
  "function_symbol": "graph_lua_directed_weighted",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[node_count, operation_count, (operation,from,to,value)...]",
    "node_count_range": [
      1,
      16
    ],
    "operation_count_range": [
      0,
      63
    ],
    "node_ids": "0 through node_count-1 are created before operations",
    "operations": {
      "0": "set numeric weight (from,to,value)",
      "1": "set boolean true weight (from,to,0)",
      "2": "remove edge (from,to,0); absent edge is a no-op",
      "3": "add unweighted edge as boolean true (from,to,0); existing edge is invalid",
      "4": "get weight (from,to,0)",
      "5": "has edge (from,to,0)"
    },
    "numeric_weight_range": [
      -1000,
      1000
    ],
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[operation_count, (result_kind,result_value)*operation_count, final_edge_count, sorted (from,to,weight_kind,weight_value) edges...]",
    "result_kind": "mutation=-1; get_weight absent=0, boolean true=1, numeric=2; has_edge absent=0, present=1",
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 500
  },
  "cases": [
    {
      "id": "numeric_set_update_remove",
      "input_values": [
        4,
        9,
        0,
        0,
        1,
        5,
        4,
        0,
        1,
        0,
        5,
        0,
        1,
        0,
        0,
        0,
        0,
        1,
        -2,
        4,
        0,
        1,
        0,
        2,
        0,
        1,
        0,
        4,
        0,
        1,
        0,
        1,
        2,
        3,
        0,
        4,
        2,
        3,
        0
      ],
      "input_length": 39,
      "expected_result": 352,
      "expected_output_hex": ""
    },
    {
      "id": "unweighted_edge_and_zero_weight",
      "input_values": [
        3,
        7,
        3,
        1,
        0,
        0,
        5,
        1,
        0,
        0,
        2,
        1,
        0,
        0,
        5,
        1,
        0,
        0,
        0,
        0,
        2,
        0,
        4,
        0,
        2,
        0,
        4,
        2,
        0,
        0
      ],
      "input_length": 30,
      "expected_result": 160,
      "expected_output_hex": ""
    },
    {
      "id": "negative_self_loop",
      "input_values": [
        2,
        4,
        0,
        0,
        0,
        -7,
        0,
        0,
        1,
        4,
        2,
        0,
        1,
        0,
        4,
        0,
        0,
        0
      ],
      "input_length": 18,
      "expected_result": 112,
      "expected_output_hex": "0400000000000000ffffffffffffffff0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff00000000000000000200000000000000f9ffffffffffffff0100000000000000000000000000000000000000000000000200000000000000f9ffffffffffffff"
    },
    {
      "id": "empty_operation_trace",
      "input_values": [
        1,
        0
      ],
      "input_length": 2,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
