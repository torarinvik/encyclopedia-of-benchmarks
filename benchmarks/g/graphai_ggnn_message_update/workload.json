  "contract": {
    "operation": "Sum each directed CSR row's neighbor state vectors; compute z=sigmoid(Wz*a+Uz*H), r=sigmoid(Wr*a+Ur*H), c=tanh(Wc*a+Uc*(r*H)), and output (1-z)*H+z*c.",
    "input_encoding": "[n,m,d,rowptr[n+1],colind[m],H[n*d],Wz[n*n],Wr[n*n],Wc[n*n],Uz[n*n],Ur[n*n],Uc[n*n]]",
    "exact_input_length": "4+n+m+n*d+6*n*n",
    "output_encoding": "n*d binary64 values in vertex-major then feature-major order",
    "arithmetic": "Finite binary64; CSR edge sums and dense vertex-axis reductions use ascending input order; sigmoid is 1/(1+exp(-x)) and candidate is tanh(x).",
    "bounds": {
      "n": [1, 8],
      "m": [0, 24],
      "d": [1, 4],
      "state_values": [-1, 1],
      "matrix_values": [-0.25, 0.25],
      "repeated_destinations": "allowed; each listed edge contributes once"
    },
