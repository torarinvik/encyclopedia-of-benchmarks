  "abi": "i64_array_bytes_output",
  "description": "Bounded Greedy and Compass local-routing policies on supplied integral geometric graphs.",
  "source": {
    "title": "Routing in Geometric Networks",
    "authors": ["Stéphane Durocher", "Leszek Gąsieniec", "Prudence W. H. Wong"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_352; Greedy and Compass rules also appear in DOI 10.1007/978-1-4939-2864-4_164",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_352",
    "algorithm_attribution": "Greedy Routing and Compass Routing",
    "implementation_status": "clean-room bounded profile; no book prose or source code copied"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[node_count, mode, source_id, target_id, x_coordinates[n], y_coordinates[n], simple_undirected_adjacency_matrix[n][n] row-major]",
    "node_count_range": [2, 8],
    "mode_values": {"0": "Greedy Routing", "1": "Compass Routing"},
    "coordinate_range": [-8, 8],
    "coordinate_rule": "Coordinates are integral and pairwise distinct.",
    "graph_rule": "Adjacency values are 0 or 1; diagonal is zero and matrix is symmetric.",
    "maximum_valid_length": 84,
    "maximum_parseable_length": 84,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "fixed [delivered, hop_count, path[8]] record; path begins at source and pads unused node slots with -1",
    "maximum_values": 10,
    "maximum_bytes": 80,
    "success_result": 80,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Bounded coordinates, adjacency, visited set, and fixed route record for at most eight nodes."
  },
  "contract": {
    "greedy_rule": "Choose an adjacent node with minimum squared Euclidean distance to the target; break ties by node ID.",
    "compass_rule": "Choose an adjacent node minimizing the angle to the target vector, compared exactly using integer dot products and squared lengths; break exact angle ties by node ID.",
    "termination_rule": "Stop on target arrival, no available neighbor, a repeated next node, or after at most n distinct visited nodes. Repeated-node detection reports failure without appending the duplicate node.",
    "output_rule": "Return delivered=1 iff the final visited node is the target; otherwise delivered=0. The fixed route record includes the visited prefix.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
