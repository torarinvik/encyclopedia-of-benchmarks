{
  "schema_version": 1,
  "id": "geo-location-distance-f64-slice-io-v1",
  "algorithm": "geo_location",
  "function_symbol": "geo_location",
  "workspace": {
    "elements": 1
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[latitude1_degrees,longitude1_degrees,latitude2_degrees,longitude2_degrees]",
    "latitude_range": [
      -90,
      90
    ],
    "longitude_range": [
      -180,
      180
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "definition": "spherical Haversine distance in meters using radius 6371010 meters",
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "absolute_tolerance": 1e-08,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-08,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "same_point",
      "input_values": [
        0,
        0,
        0,
        0
      ],
      "input_length": 4,
      "expected_result": 1,
      "expected_output": [
        0.0
      ]
    },
    {
      "id": "one_degree_equator",
      "input_values": [
        0,
        0,
        0,
        1
      ],
      "input_length": 4,
      "expected_result": 1,
      "expected_output": [
        111195.10117748393
      ]
    },
    {
      "id": "quarter_equator",
      "input_values": [
        0,
        0,
        0,
        90
      ],
      "input_length": 4,
      "expected_result": 1,
      "expected_output": [
        10007559.105973553
      ]
    },
    {
      "id": "cross_antimeridian",
      "input_values": [
        10,
        179,
        10,
        -179
      ],
      "input_length": 4,
      "expected_result": 1,
      "expected_output": [
        219011.2601510238
      ]
    },
    {
      "id": "invalid_latitude",
      "input_values": [
        91,
        0,
        0,
        0
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "invalid_longitude",
      "input_values": [
        0,
        181,
        0,
        0
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "invalid_length",
      "input_values": [
        0,
        0,
        0
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output": []
    }
  ]
}
