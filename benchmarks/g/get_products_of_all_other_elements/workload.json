{
  "schema_version": 1,
  "id": "ruby-products-of-all-other-elements-i64-vector-v1",
  "algorithm": "get_products_of_all_other_elements",
  "function_symbol": "get_products_of_all_other_elements",
  "workspace": {
    "bytes": 256,
    "meaning": "Up to 32 little-endian signed 64-bit products."
  },
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "encoding": "[n, values...]",
    "array_length_range": [
      0,
      32
    ],
    "exact_packed_length": "n + 1",
    "element_value_range": [
      -2,
      2
    ],
    "maximum_packed_values": 34,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer_vector",
    "encoding": "little-endian 64-bit words",
    "valid_result": "output byte count (8*n); zero when n < 2",
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "singleton",
      "input_values": [
        1,
        2
      ],
      "input_length": 2,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "two_values",
      "input_values": [
        2,
        2,
        -2
      ],
      "input_length": 3,
      "expected_result": 16,
      "expected_output_hex": "feffffffffffffff0200000000000000"
    },
    {
      "id": "bounded_three_values",
      "input_values": [
        3,
        1,
        2,
        2
      ],
      "input_length": 4,
      "expected_result": 24,
      "expected_output_hex": "040000000000000002000000000000000200000000000000"
    },
    {
      "id": "negative_values",
      "input_values": [
        4,
        -1,
        2,
        -2,
        1
      ],
      "input_length": 5,
      "expected_result": 32,
      "expected_output_hex": "fcffffffffffffff0200000000000000feffffffffffffff0400000000000000"
    },
    {
