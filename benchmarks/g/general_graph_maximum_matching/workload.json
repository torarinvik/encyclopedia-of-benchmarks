  "source":{"chapter":"Maximum Matching","doi":"10.1007/978-1-4939-2864-4_225","author":"Marcin Mucha","profile":"Deterministic bounded Edmonds augmenting-path/blossom maximum-cardinality matching; algebraic randomized results excluded."},
  "contract":{"operation":"Compute maximum matching cardinality of a simple undirected general graph using ascending vertex/neighbor scan order.","input_layout":"[n,m,(u,v)[m]]","edge_rule":"Each undirected edge appears once with u<v; self-loops and duplicates are invalid.","output_layout":"One signed 64-bit matching cardinality in little-endian form; witness edges are not serialized.","error_precedence":"Malformed input returns -1 before output checks; null output or capacity below 8 bytes returns -2 without writes."},
  "input":{"kind":"signed_64_bit_integer_array","maximum_valid_length":134,"maximum_parseable_length":135,"vertex_count_range":[2,12],"edge_count_range":[0,66],"invalid_result":-1,"null_input_result":-1},
  "output":{"kind":"little_endian_signed_64_bit_array","maximum_output_elements":1,"maximum_output_bytes":8,"success_result":"8 bytes","invalid_result":-1,"null_output_result":-2,"insufficient_capacity_result":-2,"no_write_on_error":true},
  "workspace":{"bytes":4096,"meaning":"Adjacency matrix, blossom bases, parent/matching arrays, queue, and staged cardinality."},
  "measurement":{"sample_count":5,"warmup_rounds":1,"repetitions_per_sample":100},
