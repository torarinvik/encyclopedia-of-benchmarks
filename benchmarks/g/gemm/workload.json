{
  "schema_version": 1,
  "id": "polybench-gemm-i64-array-f64-v1",
  "algorithm": "gemm",
  "function_symbol": "gemm",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[ni, nj, nk] where A is ni by nk, B is nk by nj, and C is ni by nj",
    "input_length": 3,
    "dimension_range": [1, 64],
    "maximum_input_length": 3
  },
  "output": {
    "kind": "binary64",
    "meaning": "sum of final C elements in row-major order after the PolyBench alpha*A*B + beta*C update",
    "invalid_input_result": -1e300
  },
  "source_bound": {
    "description": "PolyBench/C defaults to binary64 and initializes alpha=1.5 and beta=1.2; C[i][j]=((i*j+1) mod ni)/ni, A[i][k]=(i*(k+1) mod nk)/nk, and B[k][j]=(k*(j+2) mod nj)/nj. For each row i, it first multiplies C[i][j] by beta for j ascending, then visits k ascending and updates each j ascending with C[i][j] += alpha*A[i][k]*B[k][j]. The scalar suite output sums C row-major. The launcher selects EXTRALARGE_DATASET (ni=2000,nj=2300,nk=2600); suite dimensions are bounded to 1..64.",
    "repository": "https://github.com/lac-dcc/Benchmarks",
    "commit": "5d7b75df749241efa7a6e6f5be613d3fcc5cce38",
    "path": "PolyBench/linear-algebra/blas/gemm/gemm.c",
    "launcher_path": "PolyBench/linear-algebra/blas/gemm/info.sh",
    "launcher": {
      "benchmark_name": "gemm",
      "source_selection": "*.c",
      "compile_flags": ["-I.", "-DPOLYBENCH_DUMP_ARRAYS", "-DEXTRALARGE_DATASET"],
      "run_options": []
    },
    "original_contributor": "PolyBench/C (Louis-Noel Pouchet and Tomofumi Yuki)",
    "license_note": "The source file has no explicit license notice; this package contains independently written ports of the published kernel."
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {"id": "unit_dimensions", "input_values": [1, 1, 1], "input_length": 3, "expected_result": 0.0},
    {"id": "square_dimensions", "input_values": [2, 2, 2], "input_length": 3, "expected_result": 1.8},
    {"id": "rectangular_product", "input_values": [2, 3, 3], "input_length": 3, "expected_result": 4.0},
    {"id": "rectangular_no_reduction_axis", "input_values": [3, 2, 1], "input_length": 3, "expected_result": 2.4},
    {"id": "empty_invalid", "input_values": [], "input_length": 0, "expected_result": -1e300},
    {"id": "short_input_invalid", "input_values": [2, 3], "input_length": 2, "expected_result": -1e300},
    {"id": "zero_dimension_invalid", "input_values": [2, 0, 3], "input_length": 3, "expected_result": -1e300},
    {"id": "first_unsupported_dimension_invalid", "input_values": [65, 3, 2], "input_length": 3, "expected_result": -1e300}
  ]
}
