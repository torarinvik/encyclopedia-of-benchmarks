{
  "schema_version": 1,
  "id": "quick-search-first-match-v1",
  "algorithm": "quick_search",
  "function_symbol": "quick_search",
  "input": {
    "kind": "packed_ascii_byte_sequences",
    "encoding": "[text_byte_length, pattern_byte_length, text_bytes..., pattern_bytes...]",
    "maximum_text_bytes": 255,
    "maximum_pattern_bytes": 255,
    "byte_range": "ASCII values 0 through 127",
    "empty_pattern": "returns first position 0",
    "invalid_input_result": -1,
    "no_match_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "first matching zero-based byte position"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty_text_and_pattern",
      "input_values": [0, 0],
      "expected_result": 0
    },
    {
      "id": "empty_pattern",
      "input_values": [3, 0, 65, 66, 67],
      "expected_result": 0
    },
    {
      "id": "empty_text_nonempty_pattern",
      "input_values": [0, 1, 65],
      "expected_result": -1
    },
    {
      "id": "pattern_longer_than_text",
      "input_values": [2, 3, 65, 66, 65, 66, 67],
      "expected_result": -1
    },
    {
      "id": "first_match_after_lookahead_pattern_byte",
      "input_values": [5, 3, 120, 120, 97, 98, 99, 97, 98, 99],
      "expected_result": 2
    },
    {
      "id": "first_match_after_absent_byte_fallback",
      "input_values": [7, 3, 120, 120, 122, 120, 97, 98, 99, 97, 98, 99],
      "expected_result": 4
    },
    {
      "id": "first_of_multiple_matches",
      "input_values": [5, 2, 120, 97, 98, 97, 98, 97, 98],
      "expected_result": 1
    },
    {
      "id": "no_match",
      "input_values": [6, 3, 120, 121, 122, 120, 121, 122, 97, 98, 99],
      "expected_result": -1
    },
    {
      "id": "embedded_nul",
      "input_values": [3, 2, 65, 0, 66, 0, 66],
      "expected_result": 1
    },
    {
      "id": "ascii_boundary_bytes",
      "input_values": [3, 2, 32, 127, 32, 127],
      "expected_result": 1
    },
    {
      "id": "non_ascii_byte_rejected",
      "input_values": [1, 1, 128, 65],
      "expected_result": -1
    },
    {
      "id": "negative_byte_rejected",
      "input_values": [1, 1, 65, -1],
      "expected_result": -1
    },
    {
      "id": "truncated_packed_input",
      "input_values": [3, 1, 65, 66],
      "expected_result": -1
    }
  ]
}
