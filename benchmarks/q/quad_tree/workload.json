    "role": "algorithm"
  },
  "contract": {
    "operation": "Insert an ordered set of bounded distinct points into the pinned Java point quadtree and query one inclusive square.",
    "input_encoding": "[root_center_x, root_center_y, root_half_width, node_capacity, point_count, point_x_0, point_y_0, ..., query_center_x, query_center_y, query_half_width]",
    "coordinate_domain": "Integer units converted exactly to Java double; point and query centers are in [-8192,8192].",
    "root_center_range": [
      -2048,
      2048
    ],
    "root_half_width_range": [
      1,
      1024
    ],
    "node_capacity_range": [
      1,
      8
    ],
    "point_count_range": [
      0,
      64
    ],
    "point_constraints": "Point coordinates are pairwise distinct; points outside the root are allowed and insertion returns false.",
    "query_half_width_range": [
      0,
      8192
    ],
    "exact_input_length": "8 + 2 * point_count",
    "maximum_valid_input_length": 136,
    "maximum_parseable_input_length": 137,
    "insertion_semantics": "A node retains its existing local points after subdivision. New points try north-west, north-east, south-west, then south-east children; child containment is inclusive.",
    "subdivision_bound": "Integer point coordinates are distinct, root half-width is at most 1024, and subdivision reaches cells of full width at most 0.5 within 12 levels.",
    "query_semantics": "Inclusive square containment and inclusive bounding-box intersection. Emit node-local points in insertion order, then recurse north-west, north-east, south-west, south-east.",
    "output_encoding": "Little-endian signed-i64 words [point_count, insert_flag_0, ..., insert_flag_(n-1), result_count, x_0, y_0, ...] in source traversal order.",
    "maximum_output_words": 194,
    "maximum_output_bytes": 1552,
    "success_result": "Number of output bytes written.",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Null input, malformed framing, out-of-range fields, invalid capacity, or duplicate points return -1 before output checks. Null output or insufficient byte capacity returns -2, even for an empty result. Errors write no bytes."
  },
