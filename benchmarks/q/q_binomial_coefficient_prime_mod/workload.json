{
  "schema_version": 1,
  "id": "library-checker-q-binomial-prime-mod-bounded-i64-array-bytes-output-v1",
  "algorithm": "q_binomial_coefficient_prime_mod",
  "function_symbol": "q_binomial_coefficient_prime_mod",
  "abi": "i64_array_bytes_output",
  "description": "Compute bounded Gaussian binomial coefficients with a modular recurrence.",
  "source": {
    "title": "q-Binomial Coefficient (Prime Mod)",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/enumerative_combinatorics/q_binomial_coefficient_prime_mod/task.md",
    "algorithm_attribution": "Gaussian-binomial recurrence",
    "implementation_status": "clean-room bounded recurrence"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[T, m, q, n0, k0, ..., n(T-1), k(T-1)]",
    "T_range": [1, 16],
    "prime_modulus_range": [2, 31],
    "q_range": "0 <= q < m",
    "n_k_range": "0 <= n,k <= 16 and n,k < m",
    "maximum_valid_length": 35,
    "maximum_parseable_input_length": 36,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one unsigned byte per residue modulo m",
    "maximum_bytes": 16,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 2312,
    "meaning": "17 by 17 signed 64-bit Gaussian-binomial table."
  },
  "contract": {
    "official_T_max": 1000000,
    "official_m_max": 1073741824,
    "official_n_k_max_exclusive": 10000000,
    "profile_T_max": 16,
    "profile_m_max": 31,
    "profile_n_k_max": 16,
    "recurrence": "G(n,k)=G(n-1,k)+q^(n-k)*G(n-1,k-1) modulo m, with G(n,0)=G(n,n)=1",
    "k_greater_than_n": 0,
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 10,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
