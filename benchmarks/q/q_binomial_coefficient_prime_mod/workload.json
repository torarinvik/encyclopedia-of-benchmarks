      "input_length": 11,
      "output_capacity": 4,
      "expected_result": 4,
      "expected_output_hex": "01000101"
    },
    {
      "id": "q-one-is-ordinary-binomial",
      "input_values": [4, 3, 1, 2, 1, 2, 2, 1, 1, 1, 0],
      "input_length": 11,
      "output_capacity": 4,
      "expected_result": 4,
      "expected_output_hex": "02010101"
    },
    {
      "id": "nontrivial-q-and-symmetry",
      "input_values": [5, 5, 2, 3, 1, 3, 2, 4, 0, 4, 4, 4, 2],
      "input_length": 13,
      "output_capacity": 5,
      "expected_result": 5,
      "expected_output_hex": "0202010100"
    },
    {
      "id": "prime-seven-mixed-edges",
