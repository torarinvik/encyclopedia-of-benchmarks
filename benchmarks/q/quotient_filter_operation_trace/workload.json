{
  "schema_version": 1,
  "id": "standard-quotient-filter-i64-array-bytes-output-v1",
  "algorithm": "quotient_filter_operation_trace",
  "function_symbol": "quotient_filter_operation_trace",
  "abi": "i64_array_bytes_output",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[Q,(opcode,fingerprint)*Q]",
    "operation_count_range": [0, 32],
    "opcode_meaning": {
      "0": "insert one fingerprint copy",
      "1": "membership lookup",
      "2": "delete one matching copy"
    },
    "fingerprint_range": [0, 255],
    "fingerprint_split": "q=fingerprint>>5; remainder=fingerprint&31",
    "quotient_bits": 3,
    "remainder_bits": 5,
    "slot_count": 8,
    "maximum_total_copies": 6,
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "operations": {
    "duplicate_policy": "multiset; insert adds one copy; equal remainders stay adjacent and insert after existing equals",
    "delete_policy": "remove one first matching remainder in sorted run; absent delete is a no-op",
    "full_insert_status": 2,
    "insert_success_status": 1,
    "lookup_present_status": 1,
    "lookup_absent_status": 0,
    "delete_success_status": 1,
    "delete_absent_status": 0,
    "full_insert_mutates": false,
    "trace_aborts_on_full": false,
    "slot_metadata": "occupied at canonical q; continuation for same run as previous circular slot; shifted when stored away from q",
    "metadata_update": "locate clusters by walking shifted bits backward, continuation bits forward, and occupied buckets in quotient order; insert shifts only to the next empty slot, promotes the displaced old head to continuation when inserting before a run head, and marks moved entries shifted; delete promotes the next same-run copy when deleting a head, then shifts left through shifted entries until an empty slot or unshifted home slot; run-head home tracking advances through occupied buckets; occupied changes only on first insertion or final-copy deletion"
  },
  "output": {
    "kind": "raw_status_bytes",
    "layout": "one unsigned status byte per operation",
    "maximum_bytes": 32,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "input_validation_precedes_capacity": true,
    "errors_leave_output_untouched": true,
    "slot_state_bytes_emitted": false
  },
  "workspace": {
    "bytes": 256,
    "accounting": "eight remainder cells, three eight-cell metadata arrays, 32-byte status staging, and scalar/parser locals; no per-operation quotient-origin array"
  },
  "complexity": {
    "primary_time": "O(Q*8) bounded metadata-guided run traversal and local shifts",
    "primary_state": "O(8+Q) bytes/words",
    "independent_reference_time": "expected O(Q) using a bounded fingerprint multiplicity map",
    "independent_reference_state": "O(6) distinct fingerprints"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "input_and_correctness_validation": "outside timed call"
  },
  "source": {
    "title": "Don't Thrash: How to Cache Your Hash on Flash",
    "authors": ["Michael A. Bender", "Martin Farach-Colton", "Rob Johnson", "Russell Kraner", "Bradley C. Kuszmaul"],
    "url": "https://doi.org/10.14778/2350229.2350275",
    "section": "3, Quotient Filter; Figure 3",
    "secondary_title": "Quotient Filters: Approximate Membership Queries on the GPU",
    "secondary_url": "https://doi.org/10.1109/IPDPS.2018.00055",
    "secondary_section": "III-A, Standard Quotient Filters"
  },
