    "primary_reference": "https://www.cs.utexas.edu/~plaxton/c/337/05f/projects/1/Vitter87.pdf",
    "algorithm_attribution": "Implicit bottom-up numbering and leaf-before-internal blocks maintained by SlideAndIncrement.",
    "implementation_status": "bounded clean-room profile; method descriptions only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[symbol_count, symbol_ids...]",
    "symbol_count_range": [0, 64],
    "alphabet_size": 16,
    "symbol_range": [0, 15],
    "new_symbol_literal_bits": 4,
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_bit_count_then_msb_first_packed_bits",
    "encoding": "u64le bit count followed by MSB-first bits; unused low tail bits are zero",
    "maximum_bytes": 160,
    "success_result": "bytes written",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "contract": {
    "initial_tree": "One zero-weight NYT leaf represents all unseen symbols.",
    "known_symbol": "Emit the current root-to-leaf path before updating the tree.",
    "new_symbol": "Emit the current NYT path and then the symbol id as four MSB-first bits.",
    "update": "Use bottom-up left-to-right implicit numbering; equal-weight leaves precede equal-weight internal nodes. Move each leader across its following eligible node-type block before incrementing.",
    "last_new_symbol": "When all 16 symbols have appeared, reuse the NYT leaf as the final symbol leaf.",
    "bit_packing": "First emitted bit occupies the most significant bit of the first payload byte.",
    "validation_order": "Reject malformed input before output capacity; output remains untouched on error."
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "At most 31 tree nodes, implicit-order and block scratch, a 1216-bit staged stream, and bounded update storage."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
