  "output": {
    "kind": "byte_array",
    "encoding": "signed 64-bit little-endian result for each path-composition query",
    "maximum_bytes": 512,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Maximum output-buffer capacity; adjacency, HLD, and segment-tree arrays are separate."
  },
  "contract": {
    "result": "apply vertex affine maps in order along the u-to-v path modulo 998244353",
    "operation_0": "replace vertex p with c*x+d; require 1 <= c < MOD and 0 <= d < MOD",
    "operation_1": "compose from u toward v, applying f_u first and f_v last; require 0 <= x < MOD",
    "official_N_and_Q_range": [1, 200000]
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
