    "implementation_status": "clean-room bounded affine path-composition profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,(a,b)*N,(u,v)*(N-1),(operation,p,c,d)*Q]",
    "N_range": [1, 64],
    "Q_range": [1, 64],
    "modulus": 998244353,
    "initial_multiplier_range": [1, 998244352],
    "initial_offset_range": [0, 998244352],
    "maximum_valid_length": 512,
    "invalid_input_result": -1
