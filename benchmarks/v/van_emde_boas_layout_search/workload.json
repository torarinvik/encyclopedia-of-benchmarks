{
  "algorithm": "van_emde_boas_layout_search",
  "abi": "i64_array_bytes_output",
  "input": {
    "kind": "signed_i64_van_emde_boas_layout_search",
    "layout": "[height_levels, query_count, query_keys...]",
    "height_levels_range": [1, 4],
    "maximum_nodes": 15,
    "query_count_range": [0, 4],
    "query_key_range": "[-1, node_count], where node_count = 2^height_levels - 1",
    "maximum_valid_input_words": 6,
    "maximum_parseable_input_words": 7
  },
  "output": {
    "kind": "little_endian_signed_i64_array_bytes",
    "layout": "[node_count, veb_heap_ids..., query_count, (path_length, veb_slot_indices..., found_heap_id_or_minus_one)*]",
    "maximum_bytes": 328,
    "valid_result": "exact output byte length",
    "malformed_result": -1,
    "null_or_short_output_result": -2,
    "malformed_input_precedes_output_capacity": true
  },
  "workspace": {
    "bytes": 2048,
    "accounting": "Fixed node-label, vEB-order, heap-to-slot, staged-output arrays and recursion frames; caller output capacity is separate."
  },
  "complexity": {
    "primary_time": "O(node_count + query_count * height_levels)",
    "independent_time": "O(node_count * height_levels + query_count * height_levels)",
    "space": "O(node_count + maximum_output_words)"
  },
  "tolerances": {"absolute": 0, "relative": 0},
  "cases": [
    {
      "id": "singleton-hit",
      "input_values": [1, 1, 0],
      "input_length": 3,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "010000000000000001000000000000000100000000000000010000000000000000000000000000000100000000000000"
    },
    {
      "id": "height-two-branch-and-boundary-misses",
      "input_values": [2, 4, 0, 2, 3, -1],
      "input_length": 6,
      "output_capacity": 168,
      "expected_result": 168,
      "expected_output_hex": ""
    },
    {
      "id": "height-three-odd-split-hit-and-boundary-miss",
      "input_values": [3, 2, 0, 7],
      "input_length": 4,
      "output_capacity": 152,
      "expected_result": 152,
      "expected_output_hex": ""
    },
    {
      "id": "max-frame-max-output",
      "input_values": [4, 4, -1, -1, -1, -1],
      "input_length": 6,
      "output_capacity": 328,
      "expected_result": 328,
      "expected_output_hex": ""
    },
    {
      "id": "maximum-output-one-byte-short",
      "input_values": [4, 4, -1, -1, -1, -1],
      "input_length": 6,
      "output_capacity": 327,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "valid-empty-query-list",
      "input_values": [1, 0],
      "input_length": 2,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000000000000000000"
    },
    {
      "id": "max-parseable-trailing-word",
      "input_values": [4, 4, -1, -1, -1, -1, 0],
      "input_length": 7,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "unsupported-height-precedes-capacity",
      "input_values": [5, 0],
      "input_length": 2,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "query-above-node-key-domain",
      "input_values": [2, 1, 4],
      "input_length": 3,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "nonempty-null-output",
      "input_values": [1, 0],
      "input_length": 2,
      "output_capacity": 24,
      "output_is_null": true,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "output_capacity": 328,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
