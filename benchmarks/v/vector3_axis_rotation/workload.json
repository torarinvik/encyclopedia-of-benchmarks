{
  "schema_version": 1,
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "workspace": {
    "elements": 3
  },
  "id": "vector3-axis-rotation-float64-slice-io-v1",
  "algorithm": "vector3_axis_rotation",
  "function_symbol": "vector3_axis_rotation",
  "input": {
    "kind": "float64_array",
    "length": 5,
    "encoding": "[x, y, z, axis_code, angle_degrees]",
    "coordinate_abs_limit": 1000000.0,
    "angle_abs_limit": 1000000.0,
    "axis_codes": {
      "0": "x",
      "1": "y",
      "2": "z"
    },
    "angle_conversion": "(angle % 360) / 450 * 180 / pi"
  },
  "output": {
    "kind": "float64_array",
    "meaning": "[new_x, new_y, new_z]",
    "maximum_abs_value": 2000000.0,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_status": -1,
    "short_or_null_output_status": -2
  },
  "cases": [
    {
      "id": "pinned-y-axis-doctest",
      "input_values": [
        1.0,
        2.0,
        3.0,
        1.0,
        90.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        3.130524675073759,
        2.0,
        0.4470070007889556
      ]
    },
    {
      "id": "pinned-z-axis-doctest",
      "input_values": [
        1.0,
        2.0,
        3.0,
        2.0,
        180.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        0.999736015495891,
        -2.0001319704760485,
        3.0
      ]
    },
    {
      "id": "pinned-negative-x-angle",
      "input_values": [
        1.0,
        2.0,
        3.0,
        0.0,
        -90.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        1.0,
        -2.5049096187183877,
        -2.5933429780983657
      ]
    },
    {
      "id": "pinned-wrapped-x-angle",
      "input_values": [
        1.0,
        2.0,
        3.0,
        0.0,
        450.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        1.0,
        3.5776792428178217,
        -0.44744970165427644
      ]
    },
    {
      "id": "positive-fractional-angle",
      "input_values": [
        -4.5,
        0.25,
        8.0,
        1.0,
        45.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        0.3782228742980487,
        0.25,
        9.170983996134641
      ]
    },
    {
      "id": "negative-fractional-angle",
      "input_values": [
        0.0,
        -1.0,
        2.0,
        2.0,
        -180.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        -0.799920800293566,
        0.6001055850912411,
        2.0
      ]
    },
    {
      "id": "full-turn",
      "input_values": [
        3.0,
        -5.0,
        7.0,
        2.0,
        360.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        3.0,
        -5.0,
        7.0
      ]
    },
    {
      "id": "large-wrapped-angle",
      "input_values": [
        10.0,
        20.0,
        30.0,
        0.0,
        1000000.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        10.0,
        17.449777186296114,
        -31.55162874002893
      ]
    },
    {
      "id": "maximum-coordinates",
      "input_values": [
        1000000.0,
        -1000000.0,
        1000000.0,
        2.0,
        89.0
      ],
      "input_length": 5,
      "expected_result": 3,
      "expected_output": [
        -614039.4256570535,
        -1273952.7399942102,
        1000000.0
      ]
    },
    {
      "id": "invalid-axis-code",
      "input_values": [
        1.0,
        2.0,
        3.0,
        3.0,
        90.0
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output": []
    },
    {
