        0.0
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output": []
    },
    {
      "id": "angle-out-of-range",
      "input_values": [
        0.0,
        0.0,
        0.0,
        0.0,
        1000001.0
      ],
      "input_length": 5,
      "expected_result": -1,
      "expected_output": []
    }
  ]
}
