{
  "id": "validate-subsequence-dart-int-v1",
  "algorithm": "validate_subsequence",
  "function_symbol": "validate_subsequence",
  "contract": {
    "input": "[array_length, sequence_length, array_values..., sequence_values...], each length 0..4096, signed int32 values, exact packed size required.",
    "output": "1 when the requested sequence is a subsequence according to the pinned Dart source; otherwise 0.",
    "invalid_input_result": -1,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"published-example-1","input_values":[8,4,5,1,22,25,6,-1,8,10,1,6,-1,10],"input_length":14,"expected_result":1},
    {"id":"ordered-match","input_values":[5,3,1,2,3,4,5,2,4,5],"input_length":10,"expected_result":1},
    {"id":"wrong-order","input_values":[5,3,1,2,3,4,5,4,2,3],"input_length":10,"expected_result":0},
    {"id":"repeated-values-consumed-in-order","input_values":[3,3,1,1,2,1,1,2],"input_length":8,"expected_result":1},
    {"id":"nonempty-array-empty-sequence","input_values":[3,0,7,8,9],"input_length":5,"expected_result":1},
    {"id":"empty-array-nonempty-sequence","input_values":[0,1,7],"input_length":3,"expected_result":0},
    {"id":"both-empty-source-special-case","input_values":[0,0],"input_length":2,"expected_result":0},
    {"id":"sequence-is-subsequence","input_values":[4,3,1,-2,7,9,-2,7,9],"input_length":9,"expected_result":1},
    {"id":"sequence-longer-than-array","input_values":[2,3,1,2,1,2,3],"input_length":7,"expected_result":0},
    {"id":"negative-array-length","input_values":[-1,0],"input_length":2,"expected_result":-1},
    {"id":"truncated-packed-input","input_values":[2,1,5,6],"input_length":4,"expected_result":-1},
    {"id":"value-outside-int32","input_values":[1,1,2147483648,2147483648],"input_length":4,"expected_result":-1},
    {"id":"array-length-above-bound","input_values":[4097,0],"input_length":2,"expected_result":-1}
  ]
}
