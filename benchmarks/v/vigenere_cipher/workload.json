{
  "schema_version": 1,
  "id": "vigenere-cipher-v1",
  "algorithm": "vigenere_cipher",
  "input": {
    "kind": "ascii_message_bytes_zero_separator_ascii_key_bytes",
    "minimum_length": 2,
    "maximum_length": 66,
    "message_byte_range": [
      1,
      127
    ],
    "key_byte_ranges": [
      [
        65,
        90
      ],
      [
        97,
        122
      ]
    ],
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "output_encoding": "case-preserving Vigenere encryption; nonletters are copied and do not advance the repeating key"
  },
  "cases": [
    {
      "id": "classic_example",
      "input_values": [
        65,
        84,
        84,
        65,
        67,
        75,
        65,
        84,
        68,
        65,
        87,
        78,
        0,
        76,
        69,
        77,
        79,
        78
      ],
      "expected_result": 12,
      "expected_output_hex": "4c58464f50564546524e4852"
    },
    {
      "id": "mixed_case_and_punctuation",
      "input_values": [
        72,
        101,
        108,
        108,
        111,
        44,
        32,
        87,
        111,
        114,
        108,
        100,
        33,
        0,
        107,
        69,
        89
      ],
      "expected_result": 13,
      "expected_output_hex": "52696a76732c205579766a6e21"
    },
    {
      "id": "empty_message",
      "input_values": [
        0,
        75,
        69,
        89
      ],
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "punctuation_does_not_advance_key",
      "input_values": [
        65,
        33,
        66,
        63,
        67,
        0,
        66,
        67
      ],
      "expected_result": 5,
      "expected_output_hex": "4221443f44"
    },
    {
      "id": "one_letter_key",
      "input_values": [
        97,
        98,
        99,
        32,
        88,
        89,
        90,
        0,
        68
      ],
      "expected_result": 7,
      "expected_output_hex": "64656620414243"
    },
    {
      "id": "lowercase_key",
      "input_values": [
        65,
        98,
        67,
        100,
        0,
        107,
        101,
        121
      ],
      "expected_result": 4,
      "expected_output_hex": "4b66416e"
    },
    {
      "id": "control_bytes",
      "input_values": [
        1,
        65,
        9,
        66,
        127,
        0,
        90,
        65
      ],
      "expected_result": 5,
      "expected_output_hex": "015a09427f"
    },
    {
      "id": "key_longer_than_message",
      "input_values": [
        65,
        0,
        65,
        66,
        67,
        68,
        69
      ],
      "expected_result": 1,
      "expected_output_hex": "41"
    },
    {
      "id": "invalid_missing_separator",
      "input_values": [
        65,
        66
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_empty_key",
      "input_values": [
        65,
        0
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_key_symbol",
      "input_values": [
        65,
        0,
        49
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_non_ascii_message",
      "input_values": [
        128,
        0,
        65
      ],
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
}
