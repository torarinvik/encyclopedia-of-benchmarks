{
  "schema_version": 1,
  "id": "sample-variance-i64-array-float64-v1",
  "algorithm": "variance",
  "function_symbol": "variance",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "minimum_length": 2,
    "maximum_length": 64,
    "minimum_value": -1000000,
    "maximum_value": 1000000,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "sum((value - sum(values)/n)^2) / (n - 1), with source-order two-pass accumulation",
    "denominator": "n - 1",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "cases": [
