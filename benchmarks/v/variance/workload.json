    {"id":"two_values_integer_mean","input_values":[0,2],"input_length":2,"expected_result":2.0},
    {"id":"fractional_mean","input_values":[1,2,5],"input_length":3,"expected_result":4.333333333333333},
    {"id":"negative_values","input_values":[-4,-2,0,2],"input_length":4,"expected_result":6.666666666666667},
    {"id":"maximum_magnitude_balanced","input_values":[-1000000,1000000,-1000000,1000000],"input_length":4,"expected_result":1333333333333.3333},
    {"id":"empty_array","input_values":[],"input_length":0,"expected_result":-1e300},
    {"id":"singleton","input_values":[7],"input_length":1,"expected_result":-1e300},
    {"id":"below_value_bound","input_values":[-1000001,0],"input_length":2,"expected_result":-1e300},
    {"id":"above_value_bound","input_values":[0,1000001],"input_length":2,"expected_result":-1e300},
