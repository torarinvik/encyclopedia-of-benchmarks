    "meaning": "Caller output buffer for at most 128 pairs of signed 64-bit rational components."
  },
  "contract": {
    "term": "If n has base-b digits d_(L-1)...d_1 d_0, return numerator digits d_0 d_1 ... d_(L-1) over denominator b^L.",
    "sequence": "The one-based index starts at n=1; zero is not a term in this profile.",
    "precision": "All arithmetic and output components are exact integers; no floating-point operation or fraction reduction is used.",
    "bounds": "For 2<=base<=16 and 1<=n<=4096, numerator and denominator are positive integers at most 65536.",
    "error_precedence": "Validate the input pointer, exact frame, base, start, count, and window end before validating output pointer and capacity.",
    "no_write_on_error": true,
    "distinction": "This positional digit-reflection sequence differs from van_ecks_sequence, whose integer terms use distances between previous occurrences."
  },
  "complexity": {
    "time": "O(count * log_base(4096)) digit steps, at most 13 digit steps per term.",
    "space": "O(1) auxiliary state beyond the caller output buffer."
  },
