{
  "schema_version": 1,
  "id": "pinned-wikipedia-two-state-hmm-viterbi-v1",
  "algorithm": "viterbi",
  "function_symbol": "viterbi",
  "input": {
    "kind": "signed_i64_array",
    "layout": "observation symbols in order; 0=Normal, 1=Cold, 2=Dizzy",
    "length_range": [
      1,
      64
    ],
    "model": "fixed Wikipedia example: states Healthy/Fever, start [0.6,0.4], transition [[0.7,0.3],[0.4,0.6]], emission [[0.5,0.4,0.1],[0.1,0.3,0.6]]",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "one state index per observation (0=Healthy, 1=Fever)",
    "tie_break": "first state in declared order",
    "return_value": "output byte count"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
  "cases": [
    {
