  "id": "edge-replicated-image-convolution-i64-array-v1",
  "algorithm": "image_convolution",
  "function_symbol": "image_convolution",
  "description": "Apply an odd square kernel to a square grayscale image with edge-replication padding.",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[side, kernel_side, row-major pixels, row-major kernel weights]",
    "side_range": [
      1,
      16
    ],
    "kernel_side_range": [
      1,
      7
    ],
    "kernel_side_constraint": "odd",
    "pixel_range": [
      0,
      255
    ],
    "kernel_weight_range": [
      -16,
      16
    ],
    "padding": "replicate the nearest image edge for each out-of-bounds sample",
    "formula": "output[y,x] = sum(image[clamp(y+ky-r), clamp(x+kx-r)] * kernel[ky,kx]) where r=kernel_side//2; kernel orientation is preserved",
    "exact_packed_length": "2 + side*side + kernel_side*kernel_side",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "encoding": "side*side integer results in row-major order",
    "return_value": "output byte length (8*side*side)",
    "maximum_output_bytes": 2048
  },
  "source_semantics": {
    "pinned_source": "TheAlgorithms/Python digital_image_processing/filters/convolve.py at e1a2a8b016001309a73d5fec4818c35cca139795",
    "core_operation": "img_convolve edge-pads by kernel_side//2 and computes each output as a dot product between an image window and the kernel flattened in row-major order; it does not reverse the kernel",
    "domain_limit": "square images and odd square kernels keep the source im2col loop and same-size reshape consistent",
    "excluded_behaviors": "OpenCV image loading, grayscale conversion, display, waiting for a keypress, and uint8 casting in the demo are excluded"
