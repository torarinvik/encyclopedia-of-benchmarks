{
  "schema_version": 1,
  "id": "is-srilankan-phone-number-ascii-v1",
  "algorithm": "is_srilankan_phone_number",
  "function_symbol": "is_srilankan_phone_number",
  "input": {
    "kind": "ascii_byte_array",
    "encoding": "one signed 64-bit ASCII byte value per character",
    "minimum_length": 1,
    "maximum_length": 15,
    "accepted_pattern": "^(?:0|94|\\+94|0094)7(0|1|2|4|5|6|7|8)(-| |)\\d{7}$",
    "final_line_feed_rule": "Python's $ anchor also matches immediately before one final LF, which is preserved.",
    "matching_result": 1,
    "nonmatching_result": 0,
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"international_plus","input_values":[43,57,52,55,55,51,50,56,51,48,52,56],"expected_result":1},
    {"id":"international_plus_hyphen","input_values":[43,57,52,55,55,45,51,50,56,51,48,52,56],"expected_result":1},
    {"id":"local_number","input_values":[48,55,49,56,51,56,50,51,57,57],"expected_result":1},
    {"id":"international_00","input_values":[48,48,57,52,55,48,50,51,52,51,50,50,49],"expected_result":1},
    {"id":"trailing_line_feed","input_values":[48,55,55,55,51,50,56,51,48,52,56,10],"expected_result":1},
    {"id":"maximum_length_line_feed","input_values":[48,48,57,52,55,48,32,50,51,52,51,50,50,49,10],"expected_result":1},
    {"id":"local_number_space","input_values":[48,55,53,32,51,50,48,49,53,54,56],"expected_result":1},
    {"id":"country_code_without_plus","input_values":[57,52,55,50,52,51,51,55,56,49,50],"expected_result":1},
    {"id":"wrong_mobile_prefix","input_values":[48,57,53,55,54,53,49,50,51,52],"expected_result":0},
    {"id":"too_many_digits","input_values":[48,55,55,55,57,50,48,57,50,52,53],"expected_result":0},
    {"id":"missing_final_digit","input_values":[48,55,55,55,57,50,48,57,50,52],"expected_result":0},
    {"id":"double_separator","input_values":[48,55,55,45,32,51,50,56,51,48,52,56],"expected_result":0},
    {"id":"bad_suffix_character","input_values":[48,55,55,55,57,50,48,57,50,52,97],"expected_result":0},
    {"id":"same_digit_number","input_values":[48,48,48,48,48,48,48,48,48,48],"expected_result":0},
    {"id":"non_ascii_digit","input_values":[48,55,55,1633,56,51,56,50,51,57,57],"expected_result":-1},
    {"id":"empty_input","input_values":[],"expected_result":-1},
    {"id":"oversized_input","input_values":[48,48,48,48,48,48,48,48,48,48,48,48,48,48,48,48],"expected_result":-1}
  ]
}
