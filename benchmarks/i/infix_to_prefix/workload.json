{
  "schema_version": 1,
  "id": "infix-to-prefix-fully-parenthesized-v1",
  "algorithm": "infix_to_prefix",
  "function_symbol": "infix_to_prefix",
  "input": {
    "kind": "array_of_signed_64_bit_ascii_bytes",
    "minimum_length": 0,
    "maximum_length": 256,
    "valid_value_range": [1, 127],
    "expression_grammar": "empty or one ASCII alphanumeric operand or a fully parenthesized binary expression (left operator right)",
    "operands": "single ASCII letters or digits",
    "operators": ["+", "-", "*", "/", "^"],
    "normalization": "convert to prefix notation and omit parentheses; emit no trailing NUL byte",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "output_encoding": "un-terminated ASCII bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty","input_values":[],"input_length":0,"expected_result":0,"expected_output_hex":""},
    {"id":"single_operand","input_values":[120],"input_length":1,"expected_result":1,"expected_output_hex":"78"},
    {"id":"simple_addition","input_values":[40,97,43,98,41],"input_length":5,"expected_result":3,"expected_output_hex":"2b6162"},
    {"id":"nested_mixed_operators","input_values":[40,40,97,43,98,41,42,40,99,45,100,41,41],"input_length":13,"expected_result":7,"expected_output_hex":"2a2b61622d6364"},
    {"id":"digits_and_exponent","input_values":[40,40,120,94,50,41,43,40,121,47,122,41,41],"input_length":13,"expected_result":6,"expected_output_hex":"2b5e78322f797a"},
    {"id":"division_and_exponent","input_values":[40,65,47,40,98,94,51,41,41],"input_length":9,"expected_result":5,"expected_output_hex":"2f415e6233"},
    {"id":"malformed_unparenthesized","input_values":[97,43,98],"input_length":3,"expected_result":-1,"expected_output_hex":""},
    {"id":"malformed_missing_operand","input_values":[40,97,43,41],"input_length":4,"expected_result":-1,"expected_output_hex":""},
    {"id":"malformed_missing_close","input_values":[40,97,43,98],"input_length":4,"expected_result":-1,"expected_output_hex":""},
    {"id":"unsupported_operator","input_values":[40,97,37,98,41],"input_length":5,"expected_result":-1,"expected_output_hex":""},
    {"id":"non_ascii_byte","input_values":[40,97,43,128,41],"input_length":5,"expected_result":-1,"expected_output_hex":""}
  ]
}
