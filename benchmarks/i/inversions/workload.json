{
  "schema_version": 1,
  "id": "inversions-python-bruteforce-v1",
  "algorithm": "inversions",
  "function_symbol": "inversions",
  "contract": {
    "input": "0..1024 signed 32-bit integers",
    "result": "number of index pairs i<j for which values[i] > values[j]",
    "comparison": "strict; equal values do not form inversions",
    "invalid_input_result": -1,
    "input_mutated": false,
    "complexity": "O(n^2) time, O(1) auxiliary space"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "empty",
      "input_values": [],
      "input_length": 0,
      "expected_result": 0
    },
    {
      "id": "sorted",
      "input_values": [
        -3,
        0,
        4,
        4,
        9
      ],
      "input_length": 5,
      "expected_result": 0
    },
    {
      "id": "descending",
      "input_values": [
        5,
        4,
        3,
        2,
        1
      ],
      "input_length": 5,
      "expected_result": 10
    },
    {
      "id": "published_duplicate_values",
      "input_values": [
        1,
        4,
        2,
        4,
        1
      ],
      "input_length": 5,
      "expected_result": 4
    },
    {
      "id": "negative_values",
      "input_values": [
        -2,
        -5,
        0,
        -3
      ],
      "input_length": 4,
      "expected_result": 3
    }
  ]
}
