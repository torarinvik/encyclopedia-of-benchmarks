    "validation_order": "Validate pointer and outer frame bounds; dimensions and exact frame length; edges, duplicate arcs, and per-target weight sums; all draws; run the greedy trace; then validate output pointer and capacity."
  },
  "profile": {
    "model": "For each world and target vertex, its draw selects at most one incoming edge by cumulative half-open weight intervals; the leftover range selects no edge. This is the discretized random-LT triggering-set distribution.",
    "world_reuse": "The same supplied triggering worlds are reused for every greedy round and every candidate score.",
    "score": "For each unselected vertex, sum its marginal newly reachable vertices over all supplied worlds.",
    "tie_rule": "Equal marginal sums choose the smallest vertex ID.",
    "scope": "Deterministic empirical trace over the supplied draws; no random tape is generated and no accuracy or approximation guarantee for the true expectation is claimed."
  },
  "output": {
