{
  "schema_version": 1,
  "id": "python-simpson-fixed-square-1000-v1",
  "algorithm": "integration_by_simpson_approx",
  "function_symbol": "integration_by_simpson_approx",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[lower, upper, precision]",
    "endpoint_range": [
      -10,
      10
    ],
    "precision_range": [
      0,
      4
    ],
    "steps": 1000,
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "float64",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 0.0,
    "invalid_input_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "unit-interval",
      "input_values": [
        0,
        1,
        4
      ],
      "expected_result": 0.3333
    },
    {
      "id": "negative-to-positive",
      "input_values": [
        -2,
        3,
        3
      ],
      "expected_result": 11.667
    },
    {
      "id": "negative-only",
      "input_values": [
        -5,
        -1,
        2
      ],
      "expected_result": 41.33
    },
    {
      "id": "whole-number-rounding",
      "input_values": [
        0,
        3,
        0
      ],
      "expected_result": 9.0
    },
    {
      "id": "invalid-reversed-bounds",
      "input_values": [
        3,
        1,
        2
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid-precision",
      "input_values": [
        0,
        1,
        5
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid-length",
      "input_values": [
        0,
        1
      ],
      "expected_result": -1e+300
    }
  ]
}
