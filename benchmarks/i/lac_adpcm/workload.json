  "contract": {
    "operation": "Select IMA/DVI ADPCM encoding or decoding with a mode field.",
    "input_layout": "[mode, count, payload...]",
    "mode": {
      "1": "Encode count signed 16-bit PCM samples; payload values range from -32768 to 32767.",
      "2": "Decode count packed ADPCM bytes; payload values range from 0 to 255. Each byte contains a high-nibble sample followed by a low-nibble sample."
    },
    "encoder": "Starts with predictor 0 and step index 0. Packs the first code into the high nibble; for an odd sample count, the final low nibble is zero.",
    "decoder": "Starts with predictor 0 and step index 0. Emits two signed 16-bit samples for each input byte, high nibble first, encoded as canonical little-endian bytes.",
    "encode_count_range": [0, 256],
    "decode_byte_count_range": [0, 128],
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "zero_count": "Returns zero and performs no output writes; a null output pointer is accepted when no bytes are produced."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "mode, payload count, followed by samples or packed bytes",
    "maximum_parseable_length": 258,
    "mode_range": [1, 2],
    "maximum_encode_samples": 256,
    "maximum_decode_bytes": 128,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "maximum_bytes": 512,
    "encode_success_result": "ceil(sample_count / 2)",
    "decode_success_result": "4 * packed_byte_count",
    "null_output_result": -2,
    "insufficient_capacity_result": -2
  },
  "workspace": {"bytes": 512},
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
