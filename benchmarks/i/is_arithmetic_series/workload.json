{
  "schema_version": 1,
  "id": "is-arithmetic-series-i64-array-v1",
  "algorithm": "is_arithmetic_series",
  "function_symbol": "is_arithmetic_series",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "minimum_length": 1,
    "maximum_length": 64,
    "element_range": [
      -1000000,
      1000000
    ],
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "1 if all consecutive differences equal the first difference, else 0",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {
      "id": "singleton",
      "input_values": [
        7
      ],
      "input_length": 1,
      "expected_result": 1
    },
    {
      "id": "two-values",
      "input_values": [
        -5,
        12
      ],
      "input_length": 2,
      "expected_result": 1
    },
    {
      "id": "increasing",
      "input_values": [
        -8,
        -3,
        2,
        7,
        12
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "decreasing",
      "input_values": [
        18,
        13,
        8,
        3,
        -2
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "constant",
      "input_values": [
        4,
        4,
        4,
        4
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "not-arithmetic",
