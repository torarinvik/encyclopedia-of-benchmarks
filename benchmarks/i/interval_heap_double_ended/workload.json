{
  "schema_version": 1,
  "id": "van-leeuwen-wood-interval-heap-i32-trace-v1",
  "algorithm": "interval_heap_double_ended",
  "function_symbol": "interval_heap_double_ended",
  "input": {
    "kind": "signed_i64_array_with_i32_interval_heap_trace",
    "layout": "[initial_count, initial_values..., operation_count, (opcode, argument)...]",
    "initial_count_range": [0, 64],
    "initial_value_range": [-2147483648, 2147483647],
    "operation_count_range": [0, 128],
    "operation_pair_layout": "Each operation is exactly two signed i64 values; arguments for opcodes 1 through 5 must be zero.",
    "opcodes": {
      "0": "Insert(argument); no event result",
      "1": "FindMin(); emits the minimum key",
      "2": "FindMax(); emits the maximum key",
      "3": "ExtractMin(); emits and removes the minimum key",
      "4": "ExtractMax(); emits and removes the maximum key",
      "5": "Count; emits the current key count, including zero"
    },
    "insert_value_range": [-2147483648, 2147483647],
    "empty_find_or_extract": "invalid",
    "duplicates": "Retained as separate keys; identity/order among equal keys is not observable.",
    "exact_length": "initial_count + 2 + 2 * operation_count",
    "maximum_valid_length": 322,
    "maximum_parseable_length": 322,
    "maximum_live_values": 192,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[event_count, event_results..., final_count, final_values_sorted_ascending...]",
    "event_results": "Find, extract, and count results in operation order; insert emits no result.",
    "final_values": "Final interval-heap multiset sorted ascending, retaining duplicates.",
    "return_value": "number of bytes written",
    "maximum_bytes": 1552,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2,
    "write_on_error": false
  },
  "workspace": {
    "bytes": 8192,
    "accounting": "At most 192 i32 keys (768 bytes), 128 i64 event values (1024 bytes), a 192-key i32 sort copy (768 bytes), and bounded control state; 8192 bytes covers all ports conservatively."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 5
  },
  "cases": [
