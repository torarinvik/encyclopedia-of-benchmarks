      "input_values": [0, 0],
      "input_length": 2,
      "expected_result": 16,
      "expected_output_hex": "00000000000000000000000000000000"
    },
    {
      "id": "insert-duplicate-keys-and-query-both-ends",
      "input_values": [0, 5, 0, 5, 0, 5, 1, 0, 2, 0, 5, 0],
      "input_length": 12,
      "expected_result": 56,
      "expected_output_hex": "0300000000000000050000000000000005000000000000000200000000000000020000000000000005000000000000000500000000000000"
    },
    {
      "id": "mixed-endpoint-extractions-and-reuse",
      "input_values": [4, -4, 9, 9, 0, 8, 1, 0, 2, 0, 3, 0, 5, 0, 4, 0, 0, -8, 1, 0, 4, 0],
      "input_length": 22,
      "expected_result": 88,
      "expected_output_hex": "0700000000000000fcffffffffffffff0900000000000000fcffffffffffffff03000000000000000900000000000000f8ffffffffffffff09000000000000000200000000000000f8ffffffffffffff00000000000000"
    },
    {
      "id": "singleton-pairing-and-drain",
