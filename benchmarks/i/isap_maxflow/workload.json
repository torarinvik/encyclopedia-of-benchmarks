  "input": {
    "encoding": "[N,M,source,sink,(u,v,capacity)*M]",
    "kind": "i64_array_scalar",
    "vertex_count_range": [2, 8],
    "edge_count_range": [0, 24],
    "vertex_ids": "0-based",
    "source_sink_distinct": true,
    "self_loops_allowed": false,
    "parallel_edges_allowed": true,
    "antiparallel_edges_allowed": true,
    "capacity_range": [0, 100],
    "maximum_valid_input_length": 76,
    "maximum_parseable_input_length": 77,
    "maximum_flow": 2400,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "Maximum integral flow from source to sink.",
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed 8-by-8 residual matrix, distance labels, gap counts, current-edge cursors, BFS queue, and bounded DFS state."
  },
  "algorithm_details": {
    "initial_labels": "Reverse residual BFS from sink; a predecessor is discovered when its residual capacity into the current vertex is positive.",
    "augmenting_rule": "DFS follows only residual arcs with distance[u] = distance[v] + 1 and pushes integral bottlenecks.",
    "relabel_rule": "After exhausting admissible outgoing arcs, assign min(N, 1 + minimum distance of any residual neighbor), reset that vertex's current arc, and update the label count.",
    "gap_rule": "If a label below N becomes empty, terminate because no residual source-to-sink path can cross the missing label.",
    "complexity": "O(V^2 E) worst-case time for the bounded shortest-augmenting-path implementation; O(V^2+E) storage."
  },
  "oracle_method": "Primary: ISAP with reverse-BFS labels, dynamically relabeled DFS, current arcs, and the gap termination rule. Independent: enumerate each source-containing, sink-excluding vertex subset and return the minimum directed cut capacity.",
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
