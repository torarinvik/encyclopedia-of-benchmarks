{
  "schema_version": 1,
  "id": "rust-is-subsequence-unicode-scalar-i64-array-v1",
  "algorithm": "is_subsequence",
  "function_symbol": "is_subsequence",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[main_length, subsequence_length, main_codepoints..., subsequence_codepoints...]",
    "length_range": [0, 4096],
    "codepoint_range": [0, 1114111],
    "excluded_codepoint_range": [55296, 57343],
    "invalid_input_result": -1,
    "output": "1 when the second sequence appears in order in the first; otherwise 0"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty_both","input_values":[0,0],"expected_result":1},
    {"id":"empty_subsequence","input_values":[3,0,97,98,99],"expected_result":1},
    {"id":"empty_main","input_values":[0,1,97],"expected_result":0},
    {"id":"source_example","input_values":[6,3,97,104,98,103,100,99,97,98,99],"expected_result":1},
    {"id":"not_a_subsequence","input_values":[6,3,97,104,98,103,100,99,97,120,99],"expected_result":0},
    {"id":"repeated_values","input_values":[5,3,97,97,97,97,97,97,97,97],"expected_result":1},
    {"id":"longer_than_main","input_values":[3,4,97,98,99,97,98,99,100],"expected_result":0},
    {"id":"supplementary_unicode","input_values":[4,2,120,128512,98,97,128512,97],"expected_result":1},
    {"id":"no_normalization","input_values":[2,1,101,769,233],"expected_result":0},
    {"id":"nul_codepoint","input_values":[3,2,0,1,0,0,0],"expected_result":1},
    {"id":"maximum_scalar","input_values":[1,1,1114111,1114111],"expected_result":1},
    {"id":"malformed_length","input_values":[3,1,97,98,99],"expected_result":-1},
    {"id":"surrogate_codepoint","input_values":[1,1,55296,55296],"expected_result":-1},
    {"id":"negative_codepoint","input_values":[1,1,-1,97],"expected_result":-1},
    {"id":"above_unicode_maximum","input_values":[1,1,1114112,97],"expected_result":-1}
  ]
}
