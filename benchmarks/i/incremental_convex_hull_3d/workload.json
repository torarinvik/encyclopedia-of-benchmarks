{
  "schema_version": 1,
  "id": "incremental-convex-hull-3d-i64-array-scalar-v1",
  "algorithm": "incremental_convex_hull_3d",
  "function_symbol": "incremental_convex_hull_3d",
  "abi": "i64_array_scalar",
  "description": "Incrementally updates a triangular 3D convex hull and returns six times its exact volume.",
  "source": {
    "title": "KACTL geometry index: 3dHull.h; Quickhull Algorithm for Convex Hulls",
    "authors": ["C. Bradford Barber", "David P. Dobkin", "Hannu Huhdanpaa"],
    "reference": "KACTL content index for candidate discovery; Barber, Dobkin, and Huhdanpaa (1996) for the incremental hull method",
    "url": "https://doi.org/10.1145/235815.235821",
    "index_url": "https://raw.githubusercontent.com/kth-competitive-programming/kactl/main/content/geometry/chapter.tex",
    "algorithm_attribution": "Exact integer incremental convex hull in general position",
    "implementation_status": "clean-room implementations from the published algorithm description"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, x0, y0, z0, ..., x(n-1), y(n-1), z(n-1)]",
    "point_count_range": [4, 6],
    "coordinate_range": [-10, 10],
    "point_requirements": ["all points distinct", "no four points coplanar"],
    "exact_length": "1 + 3*n",
    "maximum_valid_input_length": 19,
    "maximum_parseable_input_length": 20,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "six times the exact convex-hull volume",
    "invalid_input_result": -1,
    "result_range": [0, 48000],
    "result_range_upper_bound": 48000
  },
  "contract": {
    "arithmetic": "exact signed integer determinants",
    "face_representation": "outward-oriented triangles",
    "general_position": "no four input points lie in one plane",
    "input_order": "points are inserted in the supplied order after the first tetrahedron",
    "invalid_input_result": -1
  },
  "complexity": {
    "primary_time": "O(n^4) including general-position validation; the incremental face and horizon updates take O(n^3)",
    "primary_auxiliary_space": "O(n)",
    "independent_oracle_time": "O(n^4) supporting-triple enumeration"
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 11,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "unit-tetrahedron",
      "input_values": [4, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1],
      "input_length": 13,
      "expected_result": 1
    },
    {
      "id": "outside-point-expands-initial-hull",
      "input_values": [5, 0, 0, 0, 2, 0, 0, 0, 2, 0, 0, 0, 2, 2, 2, 2],
      "input_length": 16,
      "expected_result": 24
    },
    {
      "id": "interior-point-and-outside-expansion",
      "input_values": [6, 0, 0, 0, 6, 0, 0, 0, 6, 0, 0, 0, 6, 1, 1, 1, 7, 8, 9],
      "input_length": 19,
      "expected_result": 864
    },
    {
      "id": "coplanar-four-points",
      "input_values": [4, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1, 1, 0],
      "input_length": 13,
      "expected_result": -1
    },
    {
      "id": "duplicate-points",
      "input_values": [4, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 0],
      "input_length": 13,
      "expected_result": -1
    },
    {
      "id": "point-outside-coordinate-bound",
      "input_values": [4, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 11],
      "input_length": 13,
      "expected_result": -1
    },
    {
      "id": "too-few-points",
      "input_values": [3, 0, 0, 0, 1, 0, 0, 0, 1, 0],
      "input_length": 10,
      "expected_result": -1
    },
    {
      "id": "truncated-coordinate-row",
      "input_values": [4, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0],
      "input_length": 12,
      "expected_result": -1
    },
    {
      "id": "trailing-input-value",
      "input_values": [4, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1, 7],
      "input_length": 14,
      "expected_result": -1
    },
    {
      "id": "null-input",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "expected_result": -1
    }
  ]
}
