{
  "schema_version": 1,
  "id": "iqr-outlier-indices-i64-array-scalar-v1",
  "algorithm": "iqr_outlier_indices",
  "function_symbol": "iqr_outlier_indices",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "length_range": [
      1,
      62
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "bit i is set exactly when the corresponding 1-based source index i+1 is outside the strict 1.5-IQR fences",
