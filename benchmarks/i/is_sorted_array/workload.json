{
  "id": "is-sorted-array-typescript-strict-increase-v1",
  "algorithm": "is_sorted_array",
  "function_symbol": "is_sorted_array",
  "contract": {
    "input": "An array of zero through 100,000 signed integer values in [-(2^53-1), 2^53-1].",
    "predicate": "Every adjacent pair must satisfy arr[i] < arr[i+1].",
    "output": "1 if strictly increasing, otherwise 0.",
    "empty_and_single_element_result": 1,
    "invalid_input_result": -1,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty","input_values":[],"input_length":0,"expected_result":1},
    {"id":"singleton","input_values":[42],"input_length":1,"expected_result":1},
    {"id":"strictly-increasing","input_values":[-5,-1,0,3,9],"input_length":5,"expected_result":1},
    {"id":"duplicate-adjacent-values","input_values":[1,2,2,3],"input_length":4,"expected_result":0},
    {"id":"descending-pair","input_values":[2,1],"input_length":2,"expected_result":0},
    {"id":"late-descent","input_values":[-100,-50,0,1,8,7,20],"input_length":7,"expected_result":0},
    {"id":"safe-integer-boundaries","input_values":[-9007199254740991,0,9007199254740991],"input_length":3,"expected_result":1},
    {"id":"outside-safe-integer-range","input_values":[0,9007199254740992],"input_length":2,"expected_result":-1}
  ]
}
