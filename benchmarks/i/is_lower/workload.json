{
  "id": "is-lower-r-ascii-v1",
  "algorithm": "is_lower",
  "function_symbol": "is_lower",
  "contract": {
    "input": "A sequence of zero through 4,096 printable ASCII code values in 32..126.",
    "source_predicate": "R compares each character with tolower(character) and applies all().",
    "output": "1 if no uppercase ASCII letter A..Z occurs; otherwise 0.",
    "invalid_input_result": -1,
    "empty_sequence_result": 1,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id":"empty","input_values":[],"input_length":0,"expected_result":1},
    {"id":"lowercase-word","input_values":[108,111,119,101,114],"input_length":5,"expected_result":1},
    {"id":"uppercase-letter","input_values":[65],"input_length":1,"expected_result":0},
    {"id":"mixed-case","input_values":[97,66,99],"input_length":3,"expected_result":0},
    {"id":"digits","input_values":[48,49,50,57],"input_length":4,"expected_result":1},
    {"id":"punctuation","input_values":[33,95,126],"input_length":3,"expected_result":1},
    {"id":"spaces","input_values":[32,32,32],"input_length":3,"expected_result":1},
    {"id":"uppercase-boundaries","input_values":[90,91,96,97],"input_length":4,"expected_result":0},
    {"id":"invalid-code-below-range","input_values":[31],"input_length":1,"expected_result":-1},
    {"id":"invalid-code-above-range","input_values":[127],"input_length":1,"expected_result":-1},
    {"id":"oversized-length","input_values":[],"input_length":4097,"expected_result":-1}
  ]
}
