  "contract": {
    "operation": "Given f and nonzero g over F_998244353, return the unique h with degree(h)<degree(g) and f*h congruent to 1 modulo g, or -1 when no inverse exists.",
    "input_layout": "[N, M, a0, ..., a(N-1), b0, ..., b(M-1)]",
    "N_range": [1, 6],
    "M_range": [1, 6],
    "coefficient_range": [0, 998244352],
    "leading_coefficients_nonzero": true,
    "modulus": 998244353,
    "existence_condition": "gcd(f,g)=1 over F_p; a nonzero constant g has the zero representative h=0",
    "algorithm": "Polynomial extended Euclid starting from f mod g and tracking its Bezout coefficient; normalize a constant gcd to one.",
    "output_layout": "T little-endian signed 64-bit coefficients h0 through h(T-1), where T=degree(h)+1; T=0 is an empty array.",
    "maximum_output_bytes": 40,
    "invalid_input_result": -1,
    "no_inverse_result": -1,
    "output_error_result": -2
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, M, a0, ..., a(N-1), b0, ..., b(M-1)]",
    "maximum_valid_length": 14,
    "maximum_parseable_length": 14,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
