    "n_range": [1, 64],
    "coefficient_range": [0, 998244352],
    "constant_coefficient_condition": "a_0 != 0",
    "algorithm": "Quadratic coefficient recurrence; O(N^2) modular multiply-accumulate terms.",
    "modulus": 998244353,
    "output_layout": "N little-endian signed 64-bit coefficients g_0 through g_(N-1).",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, a_0, ..., a_(N-1)]",
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
