{
  "schema_version": 1,
  "id": "integral-approximation-riemann-delta-v1",
  "algorithm": "integral_approximation",
  "function_symbol": "integral_approximation",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[function_id, lower_eighths, upper_eighths, delta_eighths]",
    "function_ids": {
      "0": "x^2",
      "1": "x^3 - x^2 + 378"
    },
    "lower_and_upper_range": [
      0,
      32
    ],
    "delta_range": [
      1,
      8
    ],
    "maximum_input_length": 4,
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "float64",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 0.0,
    "invalid_input_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "square-integral",
      "input_values": [
        0,
        0,
        16,
        1
      ],
      "expected_result": 2.671875
    },
    {
      "id": "cubic-polynomial",
      "input_values": [
        1,
        1,
        24,
        2
      ],
      "expected_result": 1048.759765625
    },
    {
      "id": "fractional-final-step-omitted",
      "input_values": [
        0,
        0,
        10,
        3
      ],
      "expected_result": 0.5009765625
    },
    {
      "id": "one-step",
      "input_values": [
        0,
        0,
        4,
        4
      ],
      "expected_result": 0.0625
    },
    {
      "id": "invalid-selector",
      "input_values": [
        2,
        0,
        8,
        1
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid-zero-delta",
      "input_values": [
        0,
        0,
        8,
        0
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid-reversed-range",
      "input_values": [
        0,
        8,
        4,
        1
      ],
      "expected_result": -1e+300
    },
    {
      "id": "invalid-length",
      "input_values": [
        0,
        8,
        4
      ],
      "expected_result": -1e+300
    }
  ]
}
