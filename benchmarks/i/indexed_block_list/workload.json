{
  "schema_version": 1,
  "id": "oi-wiki-indexed-block-list-i64-array-bytes-output-v1",
  "algorithm": "indexed_block_list",
  "function_symbol": "indexed_block_list",
  "abi": "i64_array_bytes_output",
  "description": "Indexed insertion and access over linked fixed-size blocks with interior splitting.",
  "pinned_source": {
    "repository": "OI Wiki",
    "path": "ds/block-list/",
    "url": "https://oi-wiki.org/ds/block-list/",
    "license": "CC BY-SA 4.0 and SATA; algorithm description only"
  },
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "encoding": "[initial_count, initial_values..., operation_count, operations...]; insert=[0,index,value], access=[1,index]",
    "block_size": 4,
    "initial_count_range": [0, 16],
    "operation_count_range": [0, 64],
    "maximum_insertions": 32,
    "maximum_accesses": 32,
    "value_range": [-1000000, 1000000],
    "maximum_valid_input_length": 178,
    "maximum_parseable_input_length": 179,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_access_results",
    "result": "number of output bytes",
    "no_accesses_result": 0,
    "no_accesses_accepts_null_output": true,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true,
    "maximum_output_bytes": 256
  },
  "workspace": {
    "bytes": 4096,
    "reason": "At most 16 linked block descriptors, 16 fixed blocks of nine signed 64-bit cells for the transient insertion bound, and 32 staged signed 64-bit access results; the declared limit conservatively includes language-specific indexing storage."
  },
  "cases": [
    {"id": "empty_sequence", "input_values": [0, 0], "expected_result": 0, "expected_output_hex": ""},
