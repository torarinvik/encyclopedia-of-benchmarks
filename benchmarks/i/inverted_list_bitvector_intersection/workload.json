  "abi": "i64_array_bytes_output",
  "description": "Intersect packed document-ID bitvectors with word-wise AND and ascending linear bit conversion.",
  "source": {
    "title": "Intersections of Inverted Lists",
    "authors": ["Andrew Kane", "Alejandro López-Ortiz"],
    "chapter_doi": "10.1007/978-1-4939-2864-4_628",
