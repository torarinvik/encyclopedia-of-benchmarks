    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[domain_size, list_count, list-major bitmap words...]",
    "domain_size_range": [1, 1024],
    "document_id_range": "0 through domain_size-1",
    "list_count_range": [1, 16],
    "words_per_list": "ceil(domain_size/64)",
    "word_encoding": "Each signed i64 contributes its two's-complement bit pattern as an unsigned bitmap word; bit r of word w represents document ID 64*w+r.",
    "final_word_padding": "Bits outside the document domain must be zero in every list.",
    "maximum_valid_length": 258,
    "maximum_parseable_length": 258,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "[count, ascending unique document IDs...] as little-endian signed 64-bit integers",
    "maximum_bytes": 8200,
    "minimum_success_bytes": 8,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 8320,
    "meaning": "Sixteen AND-result words and a 1,024-element i64 result staging array; the staging array permits capacity checks before output writes."
  },
  "contract": {
    "operation": "Return document IDs present in every supplied inverted list.",
    "algorithm": "AND corresponding bitmap words across query lists, then linearly scan each in-domain bit in ascending ID order and collect every set position.",
    "complexity": "O(Q*ceil(D/64)+D) time and O(ceil(D/64)+D) workspace for Q lists over a D-ID domain.",
    "error_precedence": "Validate the input pointer, metadata, exact packed length, and padding before validating the output pointer and capacity.",
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
