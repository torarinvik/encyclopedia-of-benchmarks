    {"id": "high-bit-document-63", "input_values": [64, 2, -9223372036854775807, -9223372036854775808], "input_length": 4, "output_capacity": 16, "expected_result": 16, "expected_output_hex": "01000000000000003f00000000000000"},
    {"id": "word-boundary-and-final-partial-word", "input_values": [70, 2, 1, 33, 1, 32], "input_length": 6, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "020000000000000000000000000000004500000000000000"},
