{
  "id": "is-contains-unique-chars-python-ascii-bitset-v1",
  "algorithm": "is_contains_unique_chars",
  "function_symbol": "is_contains_unique_chars",
  "contract": {
    "input": "A sequence of zero through 4,096 ASCII code values in 0..127.",
    "source_predicate": "1 iff every code value occurs at most once; comparisons are case-sensitive.",
    "output": "1 if all values are unique, including the empty sequence; 0 if any value repeats.",
    "invalid_input_result": -1,
    "empty_sequence_result": 1,
    "input_mutated": false
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 9,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
