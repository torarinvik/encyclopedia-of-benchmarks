{
  "schema_version": 1,
  "id": "z-algorithm-raw-z-array-v1",
  "algorithm": "z_algorithm",
  "function_symbol": "z_algorithm",
  "input": {
    "kind": "packed_signed_64_bit_symbol_sequence",
    "encoding": "[length, item_0, ..., item_(length-1)]",
    "minimum_length": 0,
    "maximum_length": 2047,
    "symbol_domain": "all signed 64-bit integers; exact equality",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "byte_array",
    "meaning": "Z value at every index, with z[0] = 0",
    "element_encoding": "unsigned 32-bit little-endian integer",
    "result": "number of Z values written"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id": "empty_sequence", "input_values": [0], "expected_result": 0},
    {"id": "single_symbol", "input_values": [1, 42], "expected_result": 1},
    {"id": "source_basic_z_array", "input_values": [8, 97, 97, 98, 97, 97, 98, 97, 98], "expected_result": 8},
    {"id": "source_repeated_characters", "input_values": [6, 97, 97, 97, 97, 97, 97], "expected_result": 6},
    {"id": "no_repeated_prefix", "input_values": [6, 97, 98, 99, 100, 101, 102], "expected_result": 6},
    {"id": "signed_symbols", "input_values": [5, -1, 2, -1, 2, -1], "expected_result": 5},
    {"id": "signed_value_boundary", "input_values": [2, -9223372036854775808, -9223372036854775808], "expected_result": 2},
    {"id": "invalid_empty_packed_input", "input_values": [], "expected_result": -1},
    {"id": "invalid_negative_length", "input_values": [-1], "expected_result": -1},
    {"id": "length_above_bound", "input_values": [2048], "expected_result": -1},
    {"id": "truncated_sequence", "input_values": [3, 1, 2], "expected_result": -1},
    {"id": "extra_sequence_item", "input_values": [1, 65, 66], "expected_result": -1}
  ]
}
