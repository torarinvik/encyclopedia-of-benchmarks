    "discovery_title": "Zeckendorf arithmetic",
    "profile_note": "The Rosetta title is discovery-only. The implementation follows the paper's three-pass normalization, with explicit bounded framing, a high-order sentinel before stage two, and the finite-width 021 suffix closure derived from 021x→110x."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[len_a, bits_a[len_a], len_b, bits_b[len_b]]",
    "bit_order": "Most-significant weight first. For a vector of length m, position i has weight F_(m-1-i), with F0=1, F1=2, and Fk=F(k-1)+F(k-2).",
    "canonical_rule": "Each vector has length 1..64 and contains only 0/1; nonzero vectors start with 1 and have no adjacent 1s; zero is exactly the one-bit vector [0]. Low-order trailing zero bits are allowed.",
    "truncation_and_overflow": "No truncation is performed. Vectors longer than 64 bits or malformed framing are invalid. A 64-bit operand is at most F64-1=27777890035287, so the sum is at most 55555780070574 (<2^46); native normalization updates only digits in 0..3 and emits at most 66 bits.",
    "length_range_per_vector": [1, 64],
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_input_result": -1,
    "null_input_result": -1,
    "validation_order": "Reject null input and lengths outside 4..131; validate len_a and the presence of len_b; validate len_b and exact frame length; validate both canonical vectors; normalize; finally check output pointer and capacity."
  },
  "output": {
