{
  "schema_version":"1.0.0",
  "id":"zdd-family-count-v1",
  "algorithm":"zdd_family_count",
  "function_symbol":"zdd_family_count",
  "comparison_model":"i64_array_bytes_output_call",
  "input":{"kind":"signed_i64_array","layout":"[n,m,subset_masks[m]]","item_count_range":[1,6],"family_size_range":[0,32],"mask_range":"0..2^n-1, distinct masks","bit_order":"bit i denotes item i; ZDD variables processed from item 0 upward","maximum_valid_length":34,"maximum_parseable_length":35,"invalid_result":-1},
  "output":{"kind":"little_endian_i64_array","layout":"[root_id,node_count,set_count,(variable,low_id,high_id)*node_count]","zero_suppression":"suppress nodes with high child 0; retain equal low/high children","maximum_output_elements":192,"maximum_output_bytes":1536,"success_result":"8*(3+3*node_count) bytes","invalid_result":-1,"insufficient_output_capacity_result":-2,"null_output_when_nonempty_result":-2},
  "workspace":{"bytes":4096,"meaning":"Membership truth table for at most 64 subsets and up to 63 unique ZDD nodes."},
  "measurement":{"sample_count":7,"warmup_rounds":2,"repetitions_per_sample":1000},
  "cases":[
    {"id":"empty-family","input_values":[2,0],"input_length":2,"expected_result":24,"expected_output_hex":"000000000000000000000000000000000000000000000000"},
    {"id":"singleton-empty-set","input_values":[2,1,0],"input_length":3,"expected_result":24,"expected_output_hex":"010000000000000000000000000000000100000000000000"},
    {"id":"two-singletons","input_values":[2,2,1,2],"input_length":4,"expected_result":72,"expected_output_hex":"030000000000000002000000000000000200000000000000000000000000000000000000000000000100000000000000010000000000000002000000000000000100000000000000"},
    {"id":"all-subsets-two-items","input_values":[2,4,0,1,2,3],"input_length":6,"expected_result":72,"expected_output_hex":"030000000000000002000000000000000400000000000000000000000000000001000000000000000100000000000000010000000000000002000000000000000200000000000000"},
    {"id":"duplicate-mask-invalid","input_values":[2,2,1,1],"input_length":4,"expected_result":-1,"expected_output_hex":""},
    {"id":"mask-out-of-range","input_values":[2,1,4],"input_length":3,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[2,2,1,2],"input_length":4,"expected_result":-2,"expected_output_hex":"","workspace_bytes":71,"capacity_error_result":-2}
  ]
}
