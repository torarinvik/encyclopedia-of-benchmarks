{
  "schema_version": 1,
  "id": "zblock-exact-match-count-ascii-v1",
  "algorithm": "zblock_substring_search",
  "function_symbol": "zblock_substring_search",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[text_length, pattern_length, text bytes..., pattern bytes...]",
    "text_length_range": [
      0,
      256
    ],
    "pattern_length_range": [
      1,
      64
    ],
    "byte_range": [
      0,
      127
    ],
    "excluded_byte": 36,
    "excluded_byte_reason": "The pinned C# concatenates with literal `$`; excluding it prevents separator collisions.",
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "Count overlapping exact-case pattern occurrences in the text using Z blocks.",
    "invalid_result": -1
  },
  "cases": [
    {
      "id": "overlapping_matches",
      "input_values": [
        8,
        4,
        97,
        98,
        97,
        98,
        97,
        98,
        97,
        98,
        97,
        98,
        97,
        98
      ],
      "expected_result": 3
    },
    {
      "id": "repeated_single_byte",
      "input_values": [
        6,
        2,
        97,
        97,
        97,
        97,
        97,
        97,
        97,
        97
      ],
      "expected_result": 5
    },
    {
      "id": "no_match",
      "input_values": [
        6,
        3,
        97,
        98,
        99,
        100,
        101,
        102,
        120,
        121,
        122
      ],
      "expected_result": 0
    },
    {
      "id": "empty_text",
      "input_values": [
        0,
        1,
        120
      ],
      "expected_result": 0
    },
    {
      "id": "pattern_longer_than_text",
      "input_values": [
        2,
        3,
        120,
        121,
        120,
        121,
        122
      ],
      "expected_result": 0
    },
    {
      "id": "binary_ascii_nul",
      "input_values": [
        5,
        3,
        0,
        1,
        0,
        1,
        0,
        0,
        1,
        0
      ],
      "expected_result": 2
    },
    {
      "id": "invalid_empty_pattern",
      "input_values": [
        0,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_separator_collision",
      "input_values": [
        3,
        1,
        97,
        98,
        99,
        36
      ],
      "expected_result": -1
    },
    {
      "id": "invalid_byte",
      "input_values": [
        2,
        1,
        0,
        128,
        0
      ],
      "expected_result": -1
    },
    {
      "id": "malformed_lengths",
      "input_values": [
        3,
        2,
        97,
        98
      ],
      "expected_result": -1
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  }
}
