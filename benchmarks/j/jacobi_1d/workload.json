  "input": {
    "kind": "finite_float64_array",
    "encoding": "[n, tsteps]",
    "n_range": [1, 30],
    "tsteps_range": [0, 20],
    "values_must_be_exact_integers": true,
    "maximum_input_length": 2,
    "maximum_parseable_input_length": 3,
    "initialization": "A[i] = (i + 2) / n and B[i] = (i + 3) / n, matching init_array; n=30 and tsteps=20 are PolyBench MINI_DATASET.",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "operation": "Run kernel_jacobi_1d for tsteps iterations and return the final A vector, preserving the two ordered interior sweeps per step.",
    "source_order": [
      "initialize A and B in ascending index order",
      "for each step, update B[i] = 0.33333 * (A[i-1] + A[i] + A[i+1]) for i ascending from 1 to n-2",
      "then update A[i] = 0.33333 * (B[i-1] + B[i] + B[i+1]) for i ascending from 1 to n-2",
      "retain initialized boundary values in both arrays"
    ],
    "invalid_output_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "output": {
    "kind": "float64_array",
    "encoding": "n binary64 values A[0..n-1] in source order.",
    "maximum_elements": 30,
    "success_result": "output element count (n)",
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "null_output_result": -2,
    "no_write_on_error": true,
    "absolute_tolerance": 1e-12,
