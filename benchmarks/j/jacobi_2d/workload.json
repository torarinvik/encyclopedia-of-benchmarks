  "input": {
    "kind": "finite_float64_array",
    "encoding": "[n, tsteps]",
    "n_range": [1, 30],
    "tsteps_range": [0, 20],
    "values_must_be_exact_integers": true,
    "maximum_input_length": 2,
    "maximum_parseable_input_length": 3,
    "initialization": "A[i][j] = (i*(j+2)+2)/n and B[i][j] = (i*(j+3)+3)/n, matching init_array; n=30 and tsteps=20 are PolyBench MINI_DATASET.",
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "contract": {
    "operation": "Run kernel_jacobi_2d for tsteps iterations and return the final A matrix in row-major order.",
    "source_order": [
      "initialize A and B in ascending row-major order",
      "for each step, update B[i][j] = 0.2 * (A[i][j] + A[i][j-1] + A[i][j+1] + A[i+1][j] + A[i-1][j]) with i then j ascending over the interior",
      "then update A[i][j] with the same neighbor order using B and the same loop order",
      "retain initialized boundary cells in both arrays"
    ],
    "invalid_output_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
