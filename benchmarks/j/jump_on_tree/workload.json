{
  "schema_version": 1,
  "id": "library-checker-jump-on-tree-bounded-i64-array-bytes-output-v1",
  "algorithm": "jump_on_tree",
  "function_symbol": "jump_on_tree",
  "abi": "i64_array_bytes_output",
  "description": "Return the vertex at a requested position along a tree path using LCA and binary lifting.",
  "source": {
    "title": "Jump on Tree",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/tree/jump_on_tree/task.md",
    "algorithm_attribution": "LCA with binary-lifting ancestor queries",
    "implementation_status": "clean-room bounded tree path-jump profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,(u,v)*(N-1),(s,t,k)*Q]",
    "N_range": [2, 64],
    "Q_range": [1, 64],
    "maximum_valid_length": 320,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one signed 64-bit little-endian path vertex or -1 per query",
    "maximum_bytes": 512,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "Maximum output-buffer capacity; adjacency and binary-ancestor tables use separate local storage."
  },
  "contract": {
    "result": "the kth vertex on the unique path from s to t, or -1 if k exceeds its edge length",
    "official_N_range": [2, 500000],
    "official_Q_range": [1, 500000]
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "forward-reverse-and-out-of-path-jumps",
      "input_values": [5,6,0,1,1,2,2,3,3,4,0,4,0,0,4,2,4,0,1,2,2,0,2,4,3,4,0,4],
      "input_length": 28,
      "output_capacity": 48,
      "expected_result": 48,
      "expected_output_hex": "0000000000000000020000000000000003000000000000000200000000000000ffffffffffffffff0000000000000000"
    },
    {
      "id": "star-path-and-same-vertex",
      "input_values": [4,4,0,1,0,2,0,3,1,3,0,1,3,1,3,1,2,2,2,0],
      "input_length": 20,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000000000000000000001000000000000000200000000000000"
    },
    {
      "id": "cycle-is-not-a-tree",
      "input_values": [4,1,0,1,1,2,2,0,0,3,1],
      "input_length": 11,
      "output_capacity": 512,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "query-index-outside-input-range",
      "input_values": [2,1,0,1,0,1,2],
      "input_length": 7,
      "output_capacity": 512,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "short-output-capacity",
      "input_values": [5,6,0,1,1,2,2,3,3,4,0,4,0,0,4,2,4,0,1,2,2,0,2,4,3,4,0,4],
      "input_length": 28,
      "output_capacity": 47,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "valid-small-endpoint-query",
      "input_values": [2,1,0,1,1,0,1],
      "input_length": 7,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    }
  ]
}
