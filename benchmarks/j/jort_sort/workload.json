{
  "schema_version": 1,
  "id": "jort-sort-aarch64-source-faithful-i64-array-v1",
  "algorithm": "jort_sort",
  "function_symbol": "jort_sort",
  "input": {
    "kind": "signed_i64_array",
    "length_range": [
      0,
      64
    ],
    "maximum_validation_array_length": 65,
    "invalid_input_result": -1,
    "value_range": "full signed i64"
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "1 when the pinned copy/suffix-insertion-sort/compare routine reports sorted, otherwise 0",
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "The pinned program copies the static input array, insertion-sorts its copy, compares each copied value with the original, and prints one of two messages. Its insertion loop skips comparison with index 0, so the copy keeps element 0 fixed and sorts only the suffix beginning at index 1.",
    "benchmark_domain": "Zero to 64 signed i64 values. Empty input follows the source and reports sorted. The scalar normalizes the source console outcome to 1 for the sorted message and 0 for the unsorted message."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "pinned_aarch64_example",
      "input_values": [
        3,
        4,
        20,
        5
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "already_sorted",
      "input_values": [
        1,
        2,
        3,
        4
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "ordinary_unsorted_suffix",
      "input_values": [
        1,
        3,
        2
      ],
      "input_length": 3,
      "expected_result": 0
    },
    {
      "id": "reverse_suffix",
      "input_values": [
        7,
        6,
        5,
        4
      ],
      "input_length": 4,
      "expected_result": 0
    },
    {
      "id": "descending_pair_false_positive",
      "input_values": [
        2,
        1
      ],
      "input_length": 2,
      "expected_result": 1
    },
    {
      "id": "unsorted_prefix_sorted_suffix_false_positive",
      "input_values": [
        9,
        1,
        2,
        3
      ],
      "input_length": 4,
      "expected_result": 1
    },
    {
      "id": "single_value",
      "input_values": [
        42
      ],
      "input_length": 1,
      "expected_result": 1
    },
    {
      "id": "duplicate_sorted",
      "input_values": [
        0,
        0,
        1,
        1,
        1
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
