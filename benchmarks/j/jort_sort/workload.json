        -3,
        -3,
        0,
        4
      ],
      "input_length": 5,
      "expected_result": 1
    },
    {
      "id": "negative_unsorted_suffix",
      "input_values": [
        5,
        2,
        -1
      ],
      "input_length": 3,
      "expected_result": 0
    },
    {
      "id": "minimum_i64_in_fixed_prefix",
      "input_values": [
        9223372036854775807,
        -9223372036854775808,
        -1,
        0
      ],
