  "workspace": {
    "bytes": 512,
    "meaning": "Current permutation, direction vector, and staged maximum output."
  },
  "contract": {
    "initial_row": "1,2,...,n",
    "mobile_value": "A value is mobile if its directed adjacent position exists and contains a smaller value.",
    "transition": "Swap the largest mobile value with its directed neighbor, then reverse the directions of all values larger than the moved value.",
    "termination": "Stop after emitting the permutation with no mobile value.",
    "error_results": "Malformed input returns -1. Null output or insufficient capacity returns -2 without writes."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "oracle_method": "The primary oracle simulates largest-mobile-value swaps; the independent verifier uses recursive reflected insertion and packs the resulting rows.",
