  "abi": "i64_array_bytes_output",
  "description": "Enumerate permutations of [n] in the chapter's adjacent-swap Johnson–Trotter Gray-code order.",
  "source": {
    "title": "Permutation Enumeration",
    "authors": ["Katsuhisa Yamanaka"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_735",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_735",
    "algorithm_attribution": "Steinhaus–Johnson–Trotter adjacent-swap Gray-code enumeration.",
    "implementation_status": "clean-room bounded enumerator"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n]",
    "n_range": [1, 3],
    "maximum_valid_length": 1,
    "maximum_parseable_length": 2,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "all permutations in Johnson–Trotter order, row-major, values 1..n",
    "maximum_bytes": 144,
    "success_result": "8*n*n! bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
