{
  "schema_version": 1,
  "id": "rfc6901-flat-tree-json-pointer-evaluation-i64-array-scalar-v1",
  "algorithm": "json_pointer_evaluation",
  "function_symbol": "json_pointer_evaluation",
  "abi": "i64_array_scalar",
  "description": "Resolve an RFC 6901 pointer against a bounded pre-parsed JSON value tree and return the selected node ID.",
  "source": {
    "discovery_title": "JSON Pointer",
    "discovery_note": "RosettaCodeData title index only; no task content or solutions reused.",
    "discovery_url": "https://github.com/acmeism/RosettaCodeData/blob/1d475861d7141ef2fafff293d9339f56e4b0f5db/popular-tasks",
    "method_reference": "IETF RFC 6901, JSON Pointer",
    "method_url": "https://www.rfc-editor.org/rfc/rfc6901.html",
    "license_note": "RFC behavior only; no code components extracted. The RFC specifies Simplified BSD terms for extracted code components."
  },
  "input": {
    "kind": "signed_64_bit_word_array",
    "encoding": "[node_count,root_id,pointer_length,pointer_ascii...,node_record*node_count]",
    "node_record_words": 21,
    "node_record_fields": ["kind", "parent_id", "key_length", "key_ascii[16]", "array_index", "opaque_payload"],
    "kind_values": {"object": 0, "array": 1, "opaque_scalar": 2},
    "node_count_range": [1, 32],
    "pointer_length_range": [0, 64],
    "object_key_length_range": [0, 16],
    "character_domain": "ASCII code points 0..127",
    "maximum_valid_length": 739,
    "maximum_parseable_length": 740,
    "invalid_result": -1,
    "unresolved_result": -2,
    "null_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "zero-based node-table index selected by the pointer",
    "valid_result_range": [0, 31],
    "invalid_result": -1,
    "unresolved_result": -2
  },
  "workspace": {
    "bytes": 512,
    "meaning": "One fixed 64-entry i64 token buffer. Node records are read directly from the immutable input."
  },
  "contract": {
    "primary_method": "Validate the flat rooted tree, prevalidate every tilde escape in the complete pointer, split at slash delimiters, decode escapes left-to-right, and scan the current node's child records for each token.",
    "independent_method": "Build parent-child adjacency, decode tokens using the RFC's ordered substitutions, then traverse object-name or array-index entries.",
    "complexity": "O(N^2+N*P) time and O(P) auxiliary space for N<=32 nodes and P<=64 pointer bytes.",
    "error_behavior": "Malformed frame, node table, or tilde escape returns -1. A valid pointer that is missing, ambiguous, indexes outside an array, uses '-', has a noncanonical array index, or traverses through a scalar returns -2.",
    "tree_rules": "One rooted tree; object children carry ASCII names of at most 16 code points; array children carry unique contiguous indices starting at zero; scalar payload is opaque; duplicate object names are permitted but make that token ambiguous."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
