{
  "schema_version": 1,
  "id": "jaccard-similarity-i64-array-float64-v1",
  "algorithm": "jaccard_similarity",
  "function_symbol": "jaccard_similarity",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "argument_order": ["length_a", "length_b", "set_a_ascii...", "set_b_ascii..."],
    "each_set_length_range": [0, 64],
    "ascii_codepoint_range": [32, 126],
    "unique_values_per_set": true,
    "nonempty_union_required": true,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "formula": "intersection_size / union_size",
    "range": [0.0, 1.0],
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  },
  "cases": [
    {"id":"python-example-sets", "input_values":[5,6,97,98,99,100,101,99,100,101,102,104,105], "input_length":13, "expected_result":0.375},
    {"id":"identical-sets", "input_values":[3,3,97,98,99,97,98,99], "input_length":8, "expected_result":1.0},
    {"id":"disjoint-sets", "input_values":[2,2,120,121,122,123], "input_length":6, "expected_result":0.0},
    {"id":"partial-overlap", "input_values":[3,3,97,98,99,98,99,100], "input_length":8, "expected_result":0.5},
    {"id":"empty-left", "input_values":[0,2,97,98], "input_length":4, "expected_result":0.0},
    {"id":"empty-right", "input_values":[2,0,97,98], "input_length":4, "expected_result":0.0},
    {"id":"single-equal-character", "input_values":[1,1,33,33], "input_length":4, "expected_result":1.0},
    {"id":"left-subset-of-right", "input_values":[3,4,97,98,99,97,98,99,100], "input_length":9, "expected_result":0.75},
    {"id":"invalid-both-empty", "input_values":[0,0], "input_length":2, "expected_result":-1e300},
    {"id":"invalid-header-length-mismatch", "input_values":[2,1,97], "input_length":3, "expected_result":-1e300},
    {"id":"invalid-duplicate-left", "input_values":[2,1,97,97,97], "input_length":5, "expected_result":-1e300},
    {"id":"invalid-duplicate-right", "input_values":[1,2,97,97,97], "input_length":5, "expected_result":-1e300},
    {"id":"invalid-control-code", "input_values":[1,0,31], "input_length":3, "expected_result":-1e300},
    {"id":"invalid-non-ascii-code", "input_values":[1,0,127], "input_length":3, "expected_result":-1e300},
    {"id":"invalid-set-length-above-bound", "input_values":[65,0], "input_length":2, "expected_result":-1e300}
  ]
}
