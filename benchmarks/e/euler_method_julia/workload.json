{
  "schema_version": 1,
  "id": "julia-euler-floor-step-state-time-v1",
  "algorithm": "euler_method_julia",
  "function_symbol": "euler_method_julia",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[initial_state_integer, step_count, step_denominator_power]",
    "initial_state_range": [
      -8,
      8
    ],
    "step_count_range": [
      1,
      16
    ],
    "step_denominator_power_range": [
      1,
      4
    ],
    "step_size": "h=2^(-step_denominator_power)",
    "span": "[0,step_count*h]",
    "derivative": "f(state,time)=state+time",
    "source_step_count": "floor((span_end-span_start)/h)",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_binary64_state_and_time_vectors",
    "layout": "[state_0..state_(n-1), time_0..time_(n-1)]",
    "meaning": "Julia allocates n=floor(span/h) values, seeds the first state and time as initial_state and zero, then performs n-1 Euler updates",
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 25
  },
  "cases": [
    {
      "id": "single_point",
      "input_values": [
        5,
        1,
        2
      ],
      "input_length": 3,
      "expected_result": 16,
      "expected_output_hex": "00000000000014400000000000000000"
    },
    {
      "id": "multi_step",
      "input_values": [
        1,
        4,
        1
      ],
      "input_length": 3,
      "expected_result": 64,
      "expected_output_hex": "000000000000f03f000000000000f83f000000000000044000000000000011400000000000000000000000000000e03f000000000000f03f000000000000f83f"
    },
    {
      "id": "negative_initial",
      "input_values": [
        -3,
        8,
        3
      ],
      "input_length": 3,
      "expected_result": 128,
      "expected_output_hex": "00000000000008c00000000000000bc00000000000400ec00000000000e410c00000000080d012c00000000090ea14c000000000e23717c000000040debe19c00000000000000000000000000000c03f000000000000d03f000000000000d83f000000000000e03f000000000000e43f000000000000e83f000000000000ec3f"
    },
    {
      "id": "maximum_steps",
      "input_values": [
        0,
        16,
        4
      ],
      "input_length": 3,
      "expected_result": 256,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_zero_steps",
      "input_values": [
        0,
        0,
        2
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "invalid_steps_high",
      "input_values": [
        0,
        17,
        2
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "invalid_power_low",
      "input_values": [
        0,
        4,
        0
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "invalid_power_high",
      "input_values": [
        0,
        4,
        5
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "invalid_initial_bound",
      "input_values": [
        9,
        4,
        2
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "invalid_wrong_length",
      "input_values": [
        0,
        4,
        2,
        99
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "insufficient_capacity",
      "input_values": [
        1,
        3,
        2
      ],
      "input_length": 3,
      "expected_result": -2,
      "workspace_bytes": 8,
      "capacity_error_result": -2
    }
  ]
}
