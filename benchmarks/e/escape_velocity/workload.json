{
  "schema_version": 1,
  "id": "escape-velocity-v1",
  "algorithm": "escape_velocity",
  "function_symbol": "escape_velocity",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "required_length": 2,
    "layout": ["mass_kg", "radius_m"],
    "mass_minimum": 0,
    "mass_maximum": 1000000000000000,
    "radius_minimum": 1,
    "radius_maximum": 1000000000,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "round(sqrt(2 * 6.67430e-11 * mass_kg / radius_m), 3)",
    "unit": "metres per second",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "cases": [
    {"id":"zero-mass","input_values":[0,1000],"input_length":2,"expected_result":0.0},
    {"id":"bounded-large-mass","input_values":[1000000000000000,1000000],"input_length":2,"expected_result":0.365},
    {"id":"bounded-close-radius","input_values":[1000000000000000,1],"input_length":2,"expected_result":365.357},
    {"id":"decimal-rounding-source-witness","input_values":[825929310938975,1000000000],"input_length":2,"expected_result":0.011},
    {"id":"small-mass","input_values":[1000000,1000],"input_length":2,"expected_result":0.0},
    {"id":"invalid-empty","input_values":[],"input_length":0,"expected_result":-1e300},
    {"id":"invalid-length","input_values":[1000],"input_length":1,"expected_result":-1e300},
    {"id":"invalid-negative-mass","input_values":[-1,100],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-zero-radius","input_values":[100,0],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-mass-high","input_values":[1000000000000001,1],"input_length":2,"expected_result":-1e300},
    {"id":"invalid-radius-high","input_values":[100,1000000001],"input_length":2,"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
}
