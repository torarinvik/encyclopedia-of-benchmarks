    {"id":"maximum_rate_and_term","input_values":[1000000.0,0.2,30.0],"expected_result":16710.186862473027},
    {"id":"zero_principal","input_values":[0.0,0.12,3.0],"expected_result":-1e300},
    {"id":"negative_annual_rate","input_values":[25000.0,-0.01,3.0],"expected_result":-1e300},
    {"id":"zero_rate_source_edge","input_values":[25000.0,0.0,3.0],"expected_result":-1e300},
    {"id":"fractional_year_count","input_values":[25000.0,0.12,3.5],"expected_result":-1e300},
    {"id":"zero_year_count","input_values":[25000.0,0.12,0.0],"expected_result":-1e300},
    {"id":"principal_above_bound","input_values":[1000001.0,0.12,3.0],"expected_result":-1e300},
    {"id":"rate_above_bound","input_values":[25000.0,0.2001,3.0],"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "float64_triple_call",
