{
  "schema_version": 1,
  "id": "equated-monthly-installments-float64-triple-v1",
  "algorithm": "equated_monthly_installments",
  "function_symbol": "equated_monthly_installments",
  "input": {
    "kind": "three_binary64_values",
    "layout": ["principal", "rate_per_annum", "years_to_repay"],
    "principal_minimum_exclusive": 0.0,
    "principal_maximum": 1000000.0,
    "rate_per_annum_minimum": 0.0001,
    "rate_per_annum_maximum": 0.2,
    "years_to_repay_integral": true,
    "years_to_repay_minimum": 1,
    "years_to_repay_maximum": 30,
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "principal * monthly_rate * (1 + monthly_rate)^monthly_payments / ((1 + monthly_rate)^monthly_payments - 1)",
    "invalid_input_result": -1e300
  },
  "cases": [
