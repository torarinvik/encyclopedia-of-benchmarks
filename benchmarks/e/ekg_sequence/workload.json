  "algorithm": "ekg_sequence",
  "function_symbol": "ekg_sequence",
  "abi": "i64_array_bytes_output",
  "description": "Return a bounded prefix of the greedy EKG sequence.",
  "source": {
    "title": "The EKG Sequence",
    "authors": ["Jeffrey C. Lagarias", "Eric M. Rains", "Neil J. A. Sloane"],
    "reference_url": "https://arxiv.org/abs/math/0204011",
    "definition_url": "https://oeis.org/A064413",
    "discovery_url": "https://rosettagit.org/tasks/",
    "source_license": "The RosettaGit title index is used only for algorithm-title discovery; its content is GFDL-1.3-or-later. No task content is used.",
    "implementation_status": "bounded clean-room sequence profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[count]",
    "count_range": [1, 8],
    "exact_length": 1,
    "maximum_valid_length": 1,
    "maximum_parseable_length": 2,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "Requested prefix terms as little-endian signed 64-bit integers.",
    "maximum_bytes": 64,
    "success_result": "number of output bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "nonnull_output_required_for_nonempty_result": true
  },
  "workspace": {
    "bytes": 40385,
    "meaning": "Eight signed 64-bit terms, a 40,321-byte used-candidate table, and scalar state."
  },
  "contract": {
    "recurrence": "a(1)=1; a(2)=2; for k>=3, a(k) is the least positive integer not among a(1)..a(k-1) whose gcd with a(k-1) is greater than 1.",
    "candidate_search": "At position k scan candidates in ascending order through k*a(k-1), inclusive. A prime divisor p of a(k-1) supplies k multiples p,2p,...,kp; at most k-1 are already used, so a valid candidate exists within this bound.",
    "numeric_bound": "Inductively a(k)<=k!, so with k<=8 every candidate is at most 8!=40320 and fits the 40,321-entry membership table.",
    "primary_method": "Maintain a used-value byte table incrementally; test candidate adjacency with Euclid's gcd and mark the selected value.",
    "independent_method": "Recompute membership by scanning the prior term list and test shared factors by trial-dividing the previous term.",
    "output_order": "The first requested one-based terms are serialized in sequence order.",
    "error_precedence": "Validate the input pointer, exact frame, and count before constructing the prefix; validate output pointer/capacity after all input work.",
    "no_write_on_error": true,
    "distinction": "The EKG recurrence selects the least unused number sharing a factor with the previous term; it is not the Mian-Chowla pair-sum rule, Golomb self-description, or Van Eck last-occurrence recurrence."
  },
  "complexity": {
    "time": "At most 40,320 candidates per generated term, each checked by Euclid's gcd; no more than six generated terms for count<=8.",
    "space": "O(40,320) candidate marks plus O(8) terms."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1,
