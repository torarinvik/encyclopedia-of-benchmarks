{
  "schema_version": 1,
  "id": "java-streaming-ema-fixed-alpha-seeded-v1",
  "algorithm": "exponential_moving_average_java_stream",
  "function_symbol": "exponential_moving_average_java_stream",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[seed, sample_count, sample_0, ..., sample_(n-1)]",
    "sample_count_range": [
      0,
      256
    ],
    "seed_and_sample_range": [
      -1000000,
      1000000
    ],
    "fixed_alpha": 0.25,
    "mean_update": "deviation = sample - mean_before; mean += alpha * deviation",
    "variance_update": "variance = (1-alpha) * (variance + alpha * deviation * deviation), using the same pre-update deviation",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_binary64_mean_variance_and_i64_count",
    "layout": [
      "final_mean",
      "final_variance",
      "sample_count"
    ],
    "return_value": "24 output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "empty_stream",
      "input_values": [
        125,
        0
      ],
      "input_length": 2,
      "expected_result": 24,
      "expected_output_hex": "0000000000405f4000000000000000000000000000000000"
    },
    {
      "id": "step_up",
      "input_values": [
        0,
        5,
        100,
        100,
        100,
        100,
        100
      ],
      "input_length": 7,
      "expected_result": 24,
      "expected_output_hex": "00000000401153400000009ca5479c400500000000000000"
    },
    {
