  "abi": "i64_array_scalar",
  "source": {
    "url": "https://doi.org/10.1145/321812.321820",
    "implementation_notes_url": "https://pages.di.unipi.it/pibiri/papers/ii_compression.pdf"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,U,x_0,...,x_(n-1)]",
    "count_range": [1, 32],
    "inclusive_upper_bound_range": [0, 1000000],
    "feasibility_rule": "n<=U+1",
    "value_rule": "0<=x_i<=U and x_i<=x_(i+1)",
    "exact_input_length": "n+2",
    "maximum_valid_input_length": 34,
    "maximum_parseable_input_length": 35,
    "invalid_input_result": -1
  },
  "algorithm_profile": {
    "low_width": "Choose the largest ell>=0 with n*2^ell<=U+1, equivalently floor(log2((U+1)/n)).",
    "low_encoding": "Store x_i mod 2^ell for each sequence position i.",
    "high_encoding": "Use a bit vector of length floor(U/2^ell)+n and set bit (x_i div 2^ell)+i for each i.",
    "access": "Scan the high bit vector for one positions p_i and recover x_i=((p_i-i)*2^ell)|low_i.",
    "output_checksum": "Return sum((i+1)*decoded_x_i) over all sequence positions.",
    "complexity": "O(n+U/2^ell) time and O(n*ell+U/2^ell) bits of storage, with n<=32 and U<=1000000.",
    "overflow_bound": "The checksum is at most (32*33/2)*1000000=528000000, within signed 64-bit range."
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "meaning": "Position-weighted checksum of values accessed from the Elias-Fano representation; -1 for invalid input.",
    "valid_result_range": [0, 528000000],
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
