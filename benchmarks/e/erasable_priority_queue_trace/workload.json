{
  "schema_version": 1,
  "id": "erasable-priority-queue-trace-v1",
  "algorithm": "erasable_priority_queue_trace",
  "function_symbol": "erasable_priority_queue_trace",
  "abi": "i64_array_scalar",
  "description": "Supports push, erase-one-by-value, minimum peek, and minimum pop using lazy cancellation between paired heaps.",
  "source": {
    "title": "Erasable Priority Queue",
    "authors": ["NyaanNyaan Library contributors"],
    "url": "https://github.com/NyaanNyaan/library/blob/master/data-structure/erasable-priority-queue.hpp",
    "license": "Algorithm described in source; clean-room implementation",
    "algorithm_attribution": "Maintain a live min-heap and a deletion min-heap, cancelling equal roots lazily before observation or removal.",
    "discovery_source": "https://nyaannyaan.github.io/library/",
    "discovery_use": "Algorithm index only"
  },
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[Q, (opcode,value)...]",
    "operation_count_range": [0, 63],
    "maximum_valid_length": 127,
    "maximum_parseable_length": 128,
    "operation_codes": {
      "0": "push one value in [-100,100]",
      "1": "erase exactly one existing copy of a value in [-100,100]",
      "2": "peek the minimum; paired value must be zero",
      "3": "pop the minimum; paired value must be zero and the queue must be nonempty"
    },
    "empty_peek_result": -101,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "sum of i*(opcode*202+response+101) for one-based operation index i"
  },
  "workspace": {"bytes": 4096, "meaning": "bounded heap storage and per-value validation counts"},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id": "empty_trace", "input_values": [0], "input_length": 1, "expected_result": 0},
    {"id": "push_peek_pop_and_empty_peek", "input_values": [5,0,5,0,3,2,0,3,0,2,0], "input_length": 11, "expected_result": 7217},
    {"id": "erase_one_duplicate_then_pop", "input_values": [7,0,4,0,2,0,2,1,2,2,0,3,0,2,0], "input_length": 15, "expected_result": 12174},
    {"id": "erase_then_empty_peek", "input_values": [6,0,5,0,1,1,5,2,0,3,0,2,0], "input_length": 13, "expected_result": 9203},
    {"id": "reinsert_erased_value", "input_values": [5,0,2,1,2,0,2,0,2,2,0,3,0], "input_length": 13, "expected_result": 6585},
    {"id": "negative_minimum", "input_values": [3,0,-100,2,0,3,0], "input_length": 7, "expected_result": 2732},
    {"id": "lazy_cancel_buried_value", "input_values": [4,0,4,0,2,1,2,2,0], "input_length": 9, "expected_result": 3251},
    {"id": "two_empty_peeks", "input_values": [2,2,0,2,0], "input_length": 5, "expected_result": 1212},
    {"id": "erase_missing_value", "input_values": [1,1,1], "input_length": 3, "expected_result": -1},
    {"id": "pop_empty_queue", "input_values": [1,3,0], "input_length": 3, "expected_result": -1},
    {"id": "peek_payload_must_be_zero", "input_values": [1,2,1], "input_length": 3, "expected_result": -1},
    {"id": "unknown_opcode", "input_values": [1,9,0], "input_length": 3, "expected_result": -1},
    {"id": "value_above_domain", "input_values": [1,0,101], "input_length": 3, "expected_result": -1},
    {"id": "truncated_pair", "input_values": [1,0], "input_length": 2, "expected_result": -1},
    {"id": "trailing_word", "input_values": [0,1], "input_length": 2, "expected_result": -1},
    {"id": "null_input", "input_values": [], "input_length": 0, "input_is_null": true, "expected_result": -1}
  ]
}
