{
  "schema_version": 1,
  "id": "eulerian-trail-undirected-simple-i64-array-bytes-v1",
  "algorithm": "eulerian_trail_undirected_simple",
  "function_symbol": "eulerian_trail_undirected_simple",
  "input": {
    "kind": "signed_i64_array",
    "layout": ["vertex_count", "edge_count", "u0", "v0", "u1", "v1", "..."],
    "vertex_count_range": [2, 10],
    "edge_count_range": [0, 45],
    "vertex_label_range": [0, 9],
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": ["status", "discovery_vertex_count", "discovery_vertices..."],
    "status_values": {"even_degree": 1, "two_odd_vertices": 2},
    "null_output_result": -2,
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "triangle_circuit",
      "input_values": [4, 3, 1, 2, 2, 3, 3, 1],
      "expected_result": 48,
      "expected_output_hex": "010000000000000004000000000000000100000000000000020000000000000003000000000000000100000000000000"
    },
    {
      "id": "open_path_highest_odd_start",
      "input_values": [3, 2, 0, 1, 1, 2],
      "expected_result": 40,
      "expected_output_hex": "02000000000000000300000000000000020000000000000001000000000000000000000000000000"
    },
    {
      "id": "circuit_preserves_adjacency_order",
      "input_values": [5, 4, 1, 2, 1, 3, 2, 4, 3, 4],
      "expected_result": 56,
      "expected_output_hex": "0100000000000000050000000000000001000000000000000200000000000000040000000000000003000000000000000100000000000000"
    },
    {
      "id": "discovery_order_can_jump_after_backtracking",
      "input_values": [5, 5, 0, 3, 0, 1, 0, 2, 2, 4, 0, 4],
      "expected_result": 64,
      "expected_output_hex": "02000000000000000600000000000000030000000000000000000000000000000100000000000000020000000000000004000000000000000000000000000000"
    },
    {
      "id": "four_triangles_shared_hub",
      "input_values": [10, 12, 1, 2, 2, 3, 3, 1, 1, 4, 4, 5, 5, 1, 1, 6, 6, 7, 7, 1, 1, 8, 8, 9, 9, 1],
      "expected_result": 120,
      "expected_output_hex": "01000000000000000d000000000000000100000000000000020000000000000003000000000000000100000000000000040000000000000005000000000000000100000000000000060000000000000007000000000000000100000000000000080000000000000009000000000000000100000000000000"
    },
    {
      "id": "empty_edge_circuit",
      "input_values": [3, 0],
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000100000000000000"
    },
    {
      "id": "disconnected_nonzero_degree_vertices",
      "input_values": [4, 2, 0, 1, 2, 3],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "disconnected_even_components",
      "input_values": [6, 6, 0, 1, 1, 2, 2, 0, 3, 4, 4, 5, 5, 3],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "reversed_duplicate_edge",
      "input_values": [2, 2, 0, 1, 1, 0],
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null_input",
      "input_values": [],
      "input_is_null": true,
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null_output",
      "input_values": [3, 0],
      "output_is_null": true,
      "output_capacity": 24,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "short_output",
      "input_values": [3, 0],
      "output_capacity": 23,
      "expected_result": -2,
      "expected_output_hex": ""
    },
    {
      "id": "invalid_graph_before_null_output",
      "input_values": [3, 1, 0, 0],
      "output_is_null": true,
      "output_capacity": 0,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
