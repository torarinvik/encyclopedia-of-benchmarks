    {"id":"single-edge","input_values":[2,1,0,1],"input_length":4,"expected_result":1},
    {"id":"odd-triangle","input_values":[3,3,0,1,1,2,2,0],"input_length":8,"expected_result":1},
    {"id":"odd-cycle-with-tail","input_values":[4,4,0,1,1,2,2,0,2,3],"input_length":10,"expected_result":2},
