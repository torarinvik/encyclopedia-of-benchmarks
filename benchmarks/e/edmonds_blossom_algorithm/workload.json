    {"id":"disconnected-triangle-and-pairs","input_values":[7,5,0,1,1,2,2,0,3,4,5,6],"input_length":12,"expected_result":3},
    {"id":"reversed-duplicate-edge","input_values":[2,2,0,1,1,0],"input_length":6,"expected_result":1},
