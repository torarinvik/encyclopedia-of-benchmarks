  "contract": {
    "operation": "Given f(x)=sum(a_i*x^i) with a_0=0, return g(x)=exp(f(x)) modulo x^N over F_998244353.",
    "input_layout": "[N, a_0, ..., a_(N-1)]",
    "n_range": [1, 64],
    "coefficient_range": [0, 998244352],
    "constant_coefficient_condition": "a_0 = 0",
    "algorithm": "Quadratic derivative recurrence using g'=f'g; O(N^2) modular multiply-accumulate terms.",
    "modulus": 998244353,
    "denominator_condition": "Every recurrence degree k is nonzero modulo the prime because 1<=k<N<=64.",
    "output_layout": "N little-endian signed 64-bit coefficients g_0 through g_(N-1).",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, a_0, ..., a_(N-1)]",
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 64,
    "maximum_bytes": 512,
    "success_result": "8*N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "Bounded integer-inverse table and array of 64 exponential-series coefficients."
  },
