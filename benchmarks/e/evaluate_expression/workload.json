{
  "schema_version": 1,
  "id": "javascript-evaluate-expression-rpn-f64-v1",
  "algorithm": "evaluate_expression",
  "function_symbol": "evaluate_expression",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[token_count, (opcode, payload) repeated]",
    "token_count_range": [
      1,
      64
    ],
    "maximum_input_values": 129,
    "maximum_parseable_input_values": 131,
    "opcodes": {
      "0": "push payload / 1000.0",
      "1": "addition",
      "2": "subtraction",
      "3": "multiplication",
      "4": "division"
    },
    "operand_milli_range": [
      -1000000000,
      1000000000
    ],
    "operator_payload": "must be zero",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "tagged_binary64",
    "encoding": "u32le status; if status is 1, append one little-endian IEEE-754 binary64 value; status 0 encodes source null",
    "success_result": "encoded byte length",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "maximum_output_bytes": 12
  },
  "workspace": {
    "bytes": 12
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
