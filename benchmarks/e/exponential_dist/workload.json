{
  "schema_version": 1,
  "id": "cpp-exponential-dist-statistics-v1",
  "algorithm": "exponential_dist",
  "function_symbol": "exponential_dist",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[operation, lambda_micro]",
    "scale_per_rate_unit": 1000000,
    "operation_mapping": {
      "0": "expected value",
      "1": "variance",
      "2": "standard deviation"
    },
    "valid_rate_micro_range": [
      1,
      1000000000
    ],
    "maximum_packed_values": 3,
    "invalid_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "meaning": "selected exponential-distribution statistic",
    "invalid_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
