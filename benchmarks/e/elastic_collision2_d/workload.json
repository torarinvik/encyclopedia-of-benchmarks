{
  "schema_version": 1,
  "id": "java-elastic-collision-2d-i64-array-i64-v1",
  "algorithm": "elastic_collision2_d",
  "function_symbol": "elastic_collision2_d",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[ax,ay,avx,avy,mass_a,radius_a,bx,by,bvx,bvy,mass_b,radius_b], fixed-thousandths",
    "entry_range": [
      -200000,
      200000
    ],
    "maximum_input_length": 12
  },
  "output": {
    "kind": "signed_i64",
    "meaning": "first body's post-collision velocity components rounded to thousandths and packed as signed 16-bit x in the high word and signed 16-bit y in the low word; -1 is invalid",
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "Pinned Java impulse formula for two circular bodies, with restitution 1. The source returns unchanged for overlaps or bodies moving apart. Inputs use bounded fixed-thousandths values and exclude coincident centers."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "absolute_tolerance": 0,
    "relative_tolerance": 0,
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "head_on_unequal_masses",
      "input_values": [
        0,
        0,
        1000,
        500,
        2000,
        1000,
        2000,
        0,
        -1000,
        -250,
        3000,
        1000
      ],
      "expected_result": 4203217396
    },
    {
      "id": "oblique_tangent",
      "input_values": [
        0,
        0,
        1000,
        0,
        1000,
        2500,
        3000,
        4000,
        0,
        0,
        1000,
        2500
      ],
      "expected_result": 42008096
    },
    {
      "id": "separated_bodies_still_impulsed",
      "input_values": [
        0,
        0,
        2000,
        0,
        1000,
        1000,
        3000,
        0,
        0,
        0,
        1000,
        1000
      ],
      "expected_result": 0
    },
    {
      "id": "moving_apart",
      "input_values": [
        0,
        0,
        -1000,
        200,
        1000,
        1000,
        2000,
        0,
        1000,
        -200,
        1000,
        1000
      ],
      "expected_result": 4229431496
    },
    {
      "id": "overlapping_unchanged",
      "input_values": [
        0,
        0,
