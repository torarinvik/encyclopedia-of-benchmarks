  "contract": {
    "operation":"Construct the representative-edge graph induced by a well-separated pair decomposition, using ParGeo's stretch-dependent separation constant.",
    "separation_factor":"s=4*(t+1)/(t-1)",
    "well_separated_rule":"distance(centerA,centerB)-radiusA-radiusB >= s*max(radiusA,radiusB)",
    "tree_profile":"Deterministic widest-axis median split; ties sort by other coordinate then input index. A node representative is its smallest original point index.",
    "output_layout":"[edge_count,u0,v0,...], each undirected endpoint pair normalized so u<v",
    "stretch_guarantee":"Every pair of input points is connected by a graph path of Euclidean length at most t times their Euclidean distance.",
    "errors":"Malformed or out-of-range input returns -1 before output checks. Null output or insufficient output capacity returns -2 without writes."
  },
  "input": {"kind":"finite_float64_array","encoding":"[point_count,t,x0,y0,...]","maximum_valid_input_length":18,"minimum_point_count":2,"maximum_point_count":8,"stretch_range":[1.5,4.0],"coordinate_range":[-1000,1000],"coordinates_integer_valued":true,"coordinates_distinct":true,"invalid_input_result":-1,"null_input_result":-1},
  "output": {"kind":"float64_array","encoding":"edge count followed by endpoint index pairs","maximum_elements":57,"success_result":"number of output elements","invalid_input_result":-1,"null_output_result":-2,"insufficient_capacity_result":-2,"no_write_on_error":true,"error_precedence":"Malformed or out-of-range input is rejected before output pointer/capacity checks.","absolute_tolerance":0.0,"relative_tolerance":0.0},
  "workspace":{"elements":120,"meaning":"At most 15 tree nodes and 28 WSPD representative edges."},
