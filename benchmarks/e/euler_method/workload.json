{
  "schema_version": 1,
  "id": "forward-euler-dyadic-grid-y-trajectory-v1",
  "algorithm": "euler_method",
  "function_symbol": "euler_method",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[x_start_integer,y_start_integer,step_denominator_power,step_count]",
    "x_start_and_y_start_range": [
      -8,
      8
    ],
    "step_denominator_power_range": [
      1,
      4
    ],
    "step_size": "2^(-step_denominator_power)",
    "step_count_range": [
      1,
      16
    ],
    "x_end": "x_start + step_count * step_size",
    "derivative": "f(x,y)=x+y",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_binary64_vector",
    "meaning": "y trajectory including initial y and one value after each Euler step",
    "return_value": "number of output bytes"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 25
  },
  "cases": [
    {
      "id": "dyadic_half_step",
      "input_values": [
        -2,
        1,
        1,
        4
      ],
      "input_length": 4,
      "expected_result": 40,
      "expected_output_hex": "000000000000f03f000000000000e03f0000000000000000000000000000e0bf000000000000f0bf"
    },
    {
      "id": "dyadic_quarter_step",
      "input_values": [
        0,
        1,
        2,
        8
      ],
      "input_length": 4,
      "expected_result": 72,
      "expected_output_hex": "000000000000f03f000000000000f43f000000000000fa3f000000000040014000000000001007400000000000d40e40000000008084144000000000a0251b400000000084d72140"
    },
    {
      "id": "negative_seed_and_eighth_step",
      "input_values": [
        3,
        -2,
        3,
        8
      ],
      "input_length": 4,
      "expected_result": 72,
      "expected_output_hex": "00000000000000c0000000000000febf000000000080fbbf000000000070f8bf0000000000bef4bf00000000c055f0bf00000000f040e6bf000000001c12d4bf0000000041d7c03f"
    },
    {
      "id": "max_step_count",
      "input_values": [
        0,
        0,
        4,
        16
      ],
      "input_length": 4,
      "expected_result": 136,
      "expected_output_hex": "00000000000000000000000000000000000000000000703f000000000080883f000000000004993f00000000204aa53f00000000614fb03f000000105754b73f000000819cc9bf3f000088241be3c43f0080d0d64cb1ca3f00c41ed230aed03f40b040df1379d43f44bb341da5c0d83ff806086faf8cdd3fb443fc32bd72e13fef072c06e969e43f"
    },
    {
      "id": "invalid_power_low",
      "input_values": [
        0,
        0,
        0,
        2
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "invalid_power_high",
      "input_values": [
        0,
        0,
        5,
        2
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "invalid_step_count_zero",
      "input_values": [
        0,
        0,
        2,
        0
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "invalid_step_count_high",
      "input_values": [
        0,
        0,
        2,
        17
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "invalid_initial_bound",
      "input_values": [
        9,
        0,
        2,
        1
      ],
      "input_length": 4,
      "expected_result": -1
    },
    {
      "id": "invalid_wrong_length",
      "input_values": [
        0,
        0,
        2,
        1,
        99
      ],
      "input_length": 5,
      "expected_result": -1
    },
    {
      "id": "insufficient_capacity",
      "input_values": [
        0,
        1,
        2,
        4
      ],
      "input_length": 4,
      "expected_result": -2,
      "workspace_bytes": 8,
      "capacity_error_result": -2
    }
  ]
}
