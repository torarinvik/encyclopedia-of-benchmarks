{
  "schema_version": 1,
  "id": "euclidean-distance-bounded-i64-v1",
  "algorithm": "euclidean_distance",
  "function_symbol": "euclidean_distance",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": ["dimension", "first_vector", "second_vector"],
    "dimension_range": [0, 128],
    "coordinate_range": [-1000000, 1000000],
    "required_array_length": "1 + 2 * dimension",
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "sqrt(sum((first_vector[i] - second_vector[i])^2))",
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12,
    "invalid_input_result": -1e300
  },
  "cases": [
    {"id":"zero_dimension","input_values":[0],"input_length":1,"expected_result":0.0},
    {"id":"one_dimension","input_values":[1,0,3],"input_length":3,"expected_result":3.0},
    {"id":"two_dimension_three_four_five","input_values":[2,0,0,3,4],"input_length":5,"expected_result":5.0},
    {"id":"three_dimension","input_values":[3,-1,2,2,2,-2,6],"input_length":7,"expected_result":6.4031242374328485},
    {"id":"four_dimension_source_example","input_values":[4,1,2,3,4,5,6,7,8],"input_length":9,"expected_result":8.0},
    {"id":"identical_vectors","input_values":[3,5,-7,12,5,-7,12],"input_length":7,"expected_result":0.0},
    {"id":"invalid_empty","input_values":[],"input_length":0,"expected_result":-1e300},
    {"id":"invalid_mismatched_length","input_values":[2,0,0,1],"input_length":4,"expected_result":-1e300},
    {"id":"invalid_negative_dimension","input_values":[-1],"input_length":1,"expected_result":-1e300},
    {"id":"invalid_large_coordinate","input_values":[1,1000001,0],"input_length":3,"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 10000
  }
}
