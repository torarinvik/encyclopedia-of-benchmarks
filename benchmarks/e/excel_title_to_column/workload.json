{
  "schema_version": 1,
  "id": "excel-title-to-column-v1",
  "algorithm": "excel_title_to_column",
  "input": {
    "kind": "i64_array",
    "layout": "[length,ascii_0,...]",
    "length_range": [
      1,
      12
    ],
    "value_range": [
      65,
      122
    ],
    "valid_values": "ASCII uppercase A-Z or lowercase a-z",
    "invalid_result": -1
  },
  "output": "one-based Excel column number, or -1 for malformed input",
  "cases": [
    {
      "id": "first_column",
      "input_values": [
        1,
        65
      ],
      "expected_result": 1
    },
    {
      "id": "last_single_letter",
      "input_values": [
        1,
        90
      ],
      "expected_result": 26
    },
    {
      "id": "next_after_z",
      "input_values": [
        2,
        65,
        65
      ],
      "expected_result": 27
    },
    {
      "id": "ab",
      "input_values": [
        2,
        65,
        66
      ],
      "expected_result": 28
    },
    {
      "id": "mixed_case",
      "input_values": [
        3,
        97,
        66,
        122
      ],
      "expected_result": 754
    },
    {
      "id": "lowercase_title",
      "input_values": [
        2,
        97,
        98
      ],
      "expected_result": 28
    },
    {
      "id": "empty_title_invalid",
      "input_values": [
        0
      ],
      "expected_result": -1
    },
    {
      "id": "digit_invalid",
      "input_values": [
        2,
        65,
        49
      ],
      "expected_result": -1
    },
    {
      "id": "count_mismatch_invalid",
      "input_values": [
        2,
        65
      ],
      "expected_result": -1
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  }
}
