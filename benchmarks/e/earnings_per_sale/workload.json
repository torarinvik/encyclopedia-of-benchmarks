{
  "schema_version": 1,
  "id": "earnings_per_sale-packed-i64-binary64-v1",
  "algorithm": "earnings_per_sale",
  "function_symbol": "earnings_per_sale",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": [
      "net_income",
      "preferred_dividend",
      "average_shares"
    ],
    "exact_length": 3,
    "value_domain": "net_income in [-1,000,000, 1,000,000], preferred_dividend in [0, 1,000,000], average_shares in [1, 1,000,000]",
    "invalid_input_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "(net_income - preferred_dividend) / average_shares",
    "invalid_input_result": -1e+300,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
      "id": "source_example",
      "input_values": [
        350,
        50,
        25
      ],
      "input_length": 3,
      "expected_result": 12.0
    },
    {
      "id": "negative_earnings",
      "input_values": [
        -100,
        50,
        10
      ],
      "input_length": 3,
      "expected_result": -15.0
    },
    {
      "id": "zero_earnings",
      "input_values": [
        0,
        0,
        3
      ],
      "input_length": 3,
      "expected_result": 0.0
    },
    {
      "id": "boundary_amount",
      "input_values": [
        1000000,
        0,
        1
      ],
      "input_length": 3,
      "expected_result": 1000000.0
    },
    {
      "id": "zero_average_shares",
      "input_values": [
        350,
        50,
        0
      ],
      "input_length": 3,
      "expected_result": -1e+300
    },
    {
      "id": "wrong_input_length",
      "input_values": [
        350,
        50
      ],
      "input_length": 2,
      "expected_result": -1e+300
    }
  ]
}
