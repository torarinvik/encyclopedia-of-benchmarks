        3,
        0,
        1,
        1,
        2,
        2,
        0
      ],
      "input_length": 10,
      "expected_result": 1
    },
    {
      "id": "path_endpoints",
      "input_values": [
        4,
        0,
        3,
        3,
        0,
        1,
        1,
        2,
        2,
        3
      ],
      "input_length": 10,
      "expected_result": 1
    },
    {
      "id": "three_odd_leaves",
      "input_values": [
