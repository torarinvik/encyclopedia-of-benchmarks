{
  "schema_version": 1,
  "id": "euler-degree-parity-i64-array-scalar-v1",
  "algorithm": "euler",
  "function_symbol": "euler",
  "input": {
    "kind": "bounded_signed_i64_array",
    "encoding": "[vertex_count, start, end, edge_count, undirected_edge_pairs...]",
    "vertex_count_range": [
      1,
      32
    ],
    "edge_count_range": [
      0,
      256
    ],
    "simple_graph": true,
    "maximum_input_length": 516,
    "invalid_input_result": -2
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "definition": "1 if the pinned degree-parity condition holds; otherwise 0",
    "invalid_input_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
