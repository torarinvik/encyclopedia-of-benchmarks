      "https://oeis.org/A008281",
      "https://oeis.org/A000111"
    ],
    "algorithm_attribution": "E(0,0)=1; E(n,0)=0 for n>0; E(n,k)=E(n,k-1)+E(n-1,n-k)",
    "implementation_status": "clean-room bounded recurrence profile"
  },
  "input": {
