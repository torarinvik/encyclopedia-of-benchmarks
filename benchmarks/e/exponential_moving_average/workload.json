{
  "schema_version": "1.0.0",
  "id": "exponential-moving-average-python-rust-packed-f64-v1",
  "algorithm": "exponential_moving_average",
  "function_symbol": "exponential_moving_average",
  "input": {
    "kind": "packed_i64_array",
    "encoding": "signed-i64 slots [window_size, count, integer_prices[0..count]]",
    "window_size_range": [2, 32],
    "count_range": [1, 256],
    "price_range": [-1000000, 1000000],
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_float64_array",
    "description": "count IEEE-754 binary64 EMA values in input order; successful result is output byte length"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "window_three_warmup_and_smoothing",
      "input_values": [3, 7, 2, 5, 3, 8, 6, 9, 10],
      "expected_result": 56,
      "expected_output_hex": "00000000000000400000000000000c400000000000000a40000000000080164000000000004017400000000000a01d400000000000682140"
    },
    {
      "id": "window_longer_than_input",
      "input_values": [5, 3, 10, -2, 6],
      "expected_result": 24,
      "expected_output_hex": "000000000000244000000000000010400000000000001440"
    },
    {
      "id": "window_two_smoothing_phase",
      "input_values": [2, 4, 10, 20, 30, 10],
      "expected_result": 32,
      "expected_output_hex": "00000000000024400000000000002e4000000000008036405655555555552c40"
    },
    {
      "id": "one_price",
      "input_values": [2, 1, -123],
      "expected_result": 8,
      "expected_output_hex": "0000000000c05ec0"
    },
    {
      "id": "window_below_shared_domain",
      "input_values": [1, 2, 10, 20],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "malformed_count",
      "input_values": [2, 3, 10, 20],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "price_out_of_range",
      "input_values": [2, 1, 1000001],
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient_capacity",
      "input_values": [2, 2, 10, 20],
      "expected_result": -2,
      "expected_output_hex": "",
      "workspace_bytes": 8,
      "capacity_error_result": -2
    }
  ]
}
