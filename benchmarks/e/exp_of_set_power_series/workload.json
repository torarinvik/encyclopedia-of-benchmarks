  "contract": {
    "operation": "Given a square-free N-variable polynomial f with constant coefficient zero, return exp(f)=sum(f^m/m!, m=0..N) modulo x_i^2=0 over F_998244353.",
    "input_layout": "[N, b_0, ..., b_(2^N-1)] in increasing bitmask order.",
    "n_range": [0, 5],
    "coefficient_range": [0, 998244352],
    "constant_coefficient_condition": "b_0 = 0",
    "modulus": 998244353,
    "algorithm": "Subset-cardinality recurrence c[S]=(1/|S|)*sum_{T subset S,T nonempty}|T|*b[T]*c[S\\T], computed over submasks in O(3^N) time and O(2^N) coefficient storage.",
    "output_layout": "2^N little-endian signed 64-bit residues c_0 through c_(2^N-1), in increasing bitmask order.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below 8*2^N returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, b_0, ..., b_(2^N-1)]",
    "maximum_valid_length": 33,
    "maximum_parseable_length": 33,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 32,
    "maximum_bytes": 256,
    "success_result": "8*2^N bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
