{
  "schema_version": 1,
  "id": "weighted-average-packed-i64-binary64-v1",
  "algorithm": "weighted_average",
  "function_symbol": "weighted_average",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": ["n", "n values", "n weights"],
    "n_minimum": 1,
    "n_maximum": 64,
    "value_minimum": -1000000,
    "value_maximum": 1000000,
    "weight_minimum": -1000000,
    "weight_maximum": 1000000,
    "required_length": "1 + 2*n",
    "invalid_input_result": -1e300
  },
  "output": {
    "kind": "binary64",
    "definition": "sum(values[i] * weights[i]) / sum(weights[i])",
    "zero_total_weight_result": -1e300,
    "invalid_input_result": -1e300
  },
  "cases": [
    {"id":"equal_weights","input_values":[3,1,2,3,1,1,1],"input_length":7,"expected_result":2.0},
    {"id":"unequal_weights_fractional_result","input_values":[3,10,20,30,1,2,3],"input_length":7,"expected_result":23.333333333333332},
    {"id":"half_integer_weighted_mean","input_values":[2,5,15,1,3],"input_length":5,"expected_result":12.5},
    {"id":"negative_weight","input_values":[2,3,7,1,-2],"input_length":5,"expected_result":11.0},
    {"id":"negative_values","input_values":[4,-2,0,2,4,1,1,1,1],"input_length":9,"expected_result":1.0},
    {"id":"empty_array_encoding","input_values":[0],"input_length":1,"expected_result":-1e300},
    {"id":"mismatched_packed_length","input_values":[2,1,2,1],"input_length":4,"expected_result":-1e300},
    {"id":"zero_total_weight","input_values":[2,1,2,1,-1],"input_length":5,"expected_result":-1e300},
    {"id":"value_out_of_range","input_values":[1,1000001,1],"input_length":3,"expected_result":-1e300},
    {"id":"weight_out_of_range","input_values":[1,1,1000001],"input_length":3,"expected_result":-1e300},
    {"id":"n_above_bound","input_values":[65],"input_length":1,"expected_result":-1e300}
  ],
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  }
}
