  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,L,RD,CL,r0,h0,...,h(n-1),c0,...,c(n-1)]",
    "n_range": [1, 6],
    "length_range": [1, 1000],
    "driver_resistance_range": [1, 1000],
    "load_capacitance_range": [1, 1000],
    "sheet_resistance_range": [1, 1000],
    "width_range": [1, 32],
    "unit_capacitance_range": [1, 1000],
    "widths": "Strictly descending; each h_i is a permitted fabrication width.",
    "unit_capacitances": "Strictly descending in the same index order, representing increasing c(h) as width increases.",
    "maximum_valid_length": 17,
    "invalid_result": -1
  },
  "contract": {
    "objective": "D = 1/2*l^T*Phi*l + rho^T*l + RD*CL",
    "phi": "Phi[i,j] = r0*c[max(i,j)]/h[min(i,j)]",
    "rho": "rho[i] = RD*c[i] + CL*r0/h[i]",
    "constraints": "sum(l_i)=L and every l_i>=0",
    "bounded_method": "Enumerate every nonempty positive-length support; solve its KKT equality system; reject supports failing primal or inactive-variable KKT conditions; select minimum objective.",
    "source_relation": "Exact bounded exhaustive solver for the chapter QP; not the source's iterative active-set schedule or its O(n^2) implementation.",
    "arithmetic": "Ports calculate in binary64; exact-rational primary and independent verifier oracles determine expected values.",
    "rounding": "Round each nonnegative objective/length value to the nearest micro-unit, with half upward."
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "encoding": "[delay_micro,length0_micro,...,length(n-1)_micro]",
    "maximum_bytes": 56,
    "success_result": "number of bytes written",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "errors_write_nothing": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Fixed six-width matrices, KKT work arrays, support enumeration state, and staged maximum output."
  },
  "measurement": {
