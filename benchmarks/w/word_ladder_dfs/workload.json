{
  "schema_version": 1,
  "id": "word-ladder-python-dfs-first-path-and-set-state-v1",
  "algorithm": "word_ladder_dfs",
  "function_symbol": "word_ladder_dfs",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[word_length, begin_code, end_code, dictionary_count, sorted unique dictionary_codes...]",
    "word_encoding": "fixed-width lowercase ASCII base-26 code; leftmost character is most significant; numeric code order is lexicographic word order",
    "word_length_range": [
      1,
      5
    ],
    "dictionary_count_range": [
      0,
      8
    ],
    "maximum_valid_array_length": 12,
    "maximum_parseable_array_length": 13,
    "dictionary_codes": "strictly increasing and unique",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[path_count, path_codes..., remaining_set_count, remaining_set_codes...]",
    "path_semantics": "first path selected by depth-first position-left-to-right then replacement-a-through-z search; path includes begin and end when found",
    "mutation_semantics": "remaining set after source backtracking; path words stay removed on success, failed branches are restored, and begin may appear twice in the path if initially in the set",
    "successful_result": "number of output bytes written",
    "maximum_output_bytes": 152,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 152,
    "meaning": "maximum bounded path and remaining-set vector"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
