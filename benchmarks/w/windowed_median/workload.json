{
  "schema_version": 1,
  "id": "windowed-median-stream-v1",
  "algorithm": "windowed_median",
  "function_symbol": "windowed_median",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[window_size, stream_length, values...]",
    "window_size_range": [
      1,
      64
    ],
    "stream_length_range": [
      1,
      128
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "normalization": "after each insertion, return median of the trailing min(window_size,prefix_length) values; even-window median is the average of its two middle values",
    "invalid_input_result": -1,
    "insufficient_capacity_result": -2,
    "output_encoding": "one median per stream value, each as little-endian IEEE-754 binary64"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "increasing_odd_window",
      "input_values": [
        3,
        5,
        1,
        2,
        3,
        4,
        5
      ],
      "input_length": 7,
      "expected_result": 40,
      "expected_output_hex": "000000000000f03f000000000000f83f000000000000004000000000000008400000000000001040"
    },
    {
      "id": "decreasing_even_window",
      "input_values": [
