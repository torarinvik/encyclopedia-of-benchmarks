{
  "schema_version": 1,
  "id": "wavelet-tree-rank-quantile-range-count-v1",
  "algorithm": "wavelet_tree",
  "function_symbol": "wavelet_tree_benchmark",
  "input": {
    "kind": "packed_i64_array",
    "encoding": "[item_count, values..., query_count, then query_count records of (opcode,a,b,c,d)]",
    "opcodes": {
      "0": "rank: occurrences of value a in inclusive prefix [0,b] (b=-1 means empty)",
      "1": "zero-based quantile in inclusive position range [a,b], k=c",
      "2": "count values in [c,d] over inclusive position range [a,b]"
    },
    "item_count_range": [
      1,
      64
    ],
    "query_count_range": [
      0,
      128
    ],
    "value_range": [
      -1000,
      1000
    ],
    "invalid_result": -1,
    "checksum": "sum of (one-based query index) * (answer + 1000001)"
  },
  "cases": [
