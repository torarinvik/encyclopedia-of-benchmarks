    {
      "id": "null-input-buffer",
      "input_values": [],
      "input_length": 0,
      "input_is_null": true,
      "output_capacity": 16,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "null-output-buffer",
      "input_values": [0, 3, 1, 1, 1, 1, 2],
      "input_length": 7,
      "output_capacity": 16,
