{
  "schema_version": 1,
  "id": "word-search-generator-seeded-eight-way-v1",
  "algorithm": "word_search_generator",
  "function_symbol": "word_search_generator",
  "input": {
    "kind": "packed_seeded_word_list",
    "encoding": "[width, height, seed, word_count, (word_length, ASCII letter bytes...)*] using signed 64-bit values",
    "width_range": [
      1,
      32
    ],
    "height_range": [
      1,
      32
    ],
    "seed_range": [
      1,
      2147483646
    ],
    "maximum_words": 96,
    "maximum_word_length": 32,
    "maximum_input_values": 4096,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "encoding": "row-major width*height bytes; 0 means empty, other bytes are the placed ASCII letters",
    "result": "number of board bytes written",
    "failed_placement": "skip that word and continue with the next word"
  },
  "randomness": {
    "generator": "Park-Miller LCG",
    "recurrence": "state = (state * 48271) mod 2147483647",
    "shuffle": "Fisher-Yates from remaining=count down to 2; swap remaining-1 with next_random() mod remaining",
    "per_word_call_order": "shuffle rows, shuffle columns, then choose one direction with next_random() mod 8",
    "direction_order": [
      "north",
      "northeast",
      "east",
      "southeast",
      "south",
      "southwest",
      "west",
      "northwest"
    ]
  },
