      "expected_output": [1,0, 1,0, 1,0, 1,0]
    },
    {
      "id": "linear-sequence-singular-higher-order",
      "input_values": [5, 2, 0, 1, 2, 3, 4],
      "input_length": 7,
      "output_capacity": 8,
      "expected_result": 8,
      "expected_output": [1,0, 1,0, 1,0, 1,0]
    },
    {
