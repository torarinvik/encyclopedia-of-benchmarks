{
  "schema_version": 1,
  "id": "wynn-epsilon-finite-tableau-f64-v1",
  "algorithm": "wynn_epsilon_sequence_algorithm",
  "function_symbol": "wynn_epsilon_sequence_algorithm",
  "abi": "float64_slice_io",
  "description": "Bounded multi-column Wynn epsilon tableau for finite real sequences.",
  "source": {
    "title": "NIST Digital Library of Mathematical Functions, §3.9(iv), Eq. 3.9.11",
    "url": "https://dlmf.nist.gov/3.9#E11",
    "secondary_url": "https://dlmf.nist.gov/3.9#E9",
    "role": "primary recurrence and independent Hankel determinant identity"
  },
  "contract": {
    "operation": "Construct epsilon rows through order 2K and emit all even rows epsilon_2, epsilon_4, ..., epsilon_2K.",
    "input_encoding": "[N,K,s_0,...,s_(N-1)] as float64 values",
    "domain": "5<=N<=10; 2<=K<=3; N>=2K+1; finite samples in [-2,2] on the exact 1/256 grid",
    "recurrence": "epsilon_-1[n]=0; epsilon_0[n]=s_n; epsilon_(m+1)[n]=epsilon_(m-1)[n+1]+1/(epsilon_m[n+1]-epsilon_m[n])",
    "singularity": "The binary64 denominator is formed as right-minus-left in that order. A computed +0.0 or -0.0, a marked dependency, or a nonfinite denominator/reciprocal/result marks the cell singular; emit [1,0] and propagate the marker. Otherwise emit [0,value]. No replacement recurrence is used.",
    "output_encoding": "For each even order 2,4,...,2K, emit increasing n as [status,value] pairs; status is 0 for finite and 1 for singular/unavailable.",
    "result": "Number of output float64 elements",
    "invalid_result": -1,
    "output_error_result": -2,
    "errors_write_nothing": true
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[N,K,s_0,...,s_(N-1)]",
    "minimum_valid_length": 7,
    "maximum_valid_length": 12,
    "maximum_parseable_length": 13,
    "n_range": [5, 10],
    "k_range": [2, 3],
    "sample_range": [-2, 2],
    "sample_grid_denominator": 256,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "[status,value] pairs for even epsilon rows, by row then index",
    "maximum_elements": 36,
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12
  },
  "workspace": {
    "bytes": 2048,
    "elements": 36,
    "description": "Fixed 7-by-10 binary64 tableau for epsilon orders 0 through 6, 7-by-10 validity flags, result staging for 36 binary64 elements, and bounded parser/loop state."
  },
  "complexity": {
    "primary_time": "O(N*K)",
    "independent_time": "O(N^2*K + N*K*(K+1)!) for per-cell determinant setup/expansion plus O(N*K) status replay",
    "primary_space": "O(N*K)",
    "independent_space": "O(N*K + K^3)"
  },
  "reference_note": "The determinant oracle is an independent check for stable cells. If exact determinant cancellation disagrees with the operational binary64 status, or its quotient falls outside the stated tolerance from the rounded tableau, the operational finite tableau value controls. The tolerances are pinned against this bounded fixture set.",
  "independent_integer_bounds": {
    "scaled_sample_range": [-512, 512],
    "numerator_determinant_abs_bound_exclusive": 2199023255552,
    "scaled_denominator_abs_bound_exclusive": 17592186044416,
    "note": "Both integer determinants fit signed i64; bounds follow 4!*512^4 for the size-four numerator and 256*3!*2048^3 for the scaled size-three denominator."
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 1e-9,
    "relative_tolerance": 1e-12
  },
  "cases": [
    {
