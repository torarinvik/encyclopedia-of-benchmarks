  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[Q,(operation,argument)*Q]",
    "operation_count_range": [0, 64],
    "operations": {
      "0": "insert one key occurrence",
      "1": "remove the leftmost matching key occurrence; missing key is unchanged",
      "2": "rank: number of keys strictly less than key",
      "3": "zero-based kth key, or -129 when absent",
      "4": "strict predecessor, or -129 when absent",
      "5": "strict successor, or -129 when absent"
    },
    "duplicate_rule": "equal insertions go before existing equal leaves; removal erases the leftmost equal leaf",
    "key_range": [-128, 127],
    "kth_argument_range": [0, 63],
    "maximum_valid_input_length": 129,
    "maximum_parseable_input_length": 130,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "sum over query operations of step*(answer+129), with one-based step; updates contribute zero",
    "result_range": "0..532480",
    "invalid_result": -1
  },
  "complexity": {
    "time": "O(Q log Q)",
    "auxiliary_space": "O(Q)",
    "maximum_active_nodes": 127,
    "balance_parameter": "alpha=1/4; one child is too heavy when it is greater than three times its sibling"
  },
  "workspace": {"bytes": 16384},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
