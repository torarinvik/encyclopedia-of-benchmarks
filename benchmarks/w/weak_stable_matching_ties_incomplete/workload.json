  },
  "contract": {
    "men_tie_refinement": "Within an equal-rank group, propose to women in ascending ID order.",
    "women_tie_refinement": "Within an equal-rank group, prefer men in ascending ID order.",
    "proposal_scheduler": "Repeatedly choose the lowest-ID unmatched man with an untried acceptable partner.",
    "stability": "Deferred acceptance returns a matching stable under the strict deterministic refinement, hence weakly stable under the original tied preferences.",
    "objective": "One deterministic weakly stable matching; this is not a maximum-cardinality stable-matching algorithm."
