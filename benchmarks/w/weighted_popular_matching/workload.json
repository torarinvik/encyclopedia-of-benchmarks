{
  "schema_version": 1,
  "id": "encyclopedia-weighted-popular-matching-exact-small-market-i64-array-bytes-output-v1",
  "algorithm": "weighted_popular_matching",
  "function_symbol": "weighted_popular_matching",
  "abi": "i64_array_bytes_output",
  "description": "Find a maximum-cardinality matching with no strictly positive weighted-majority challenger.",
  "source": {
    "title": "Weighted Popular Matchings",
    "authors": ["Julián Mestre"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_477",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_477",
    "algorithm_attribution": "weighted popularity by applicant vote weights and strict preferences",
    "implementation_status": "clean-room exhaustive profile for complete strict rankings with n,m<=4"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[applicant_count,item_count,weights[applicants],rankings row-major]",
    "applicant_count_range": [1, 4],
    "item_count_range": [1, 4],
    "weight_range": [1, 1000],
    "ranking_rule": "Each row is a permutation of 0..item_count-1; rank 0 is best.",
    "maximum_valid_length": 22,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[found,cardinality,assignment[applicants]]; item IDs are zero-based and -1 means unmatched",
    "no_popular_matching": "[0,0,-1,...,-1]",
    "maximum_bytes": 48,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded assignment enumeration and vote-score state for at most four applicants/items."
  },
  "contract": {
    "unmatched_rank": "Unmatched is less preferred than every listed item.",
    "popularity": "For every challenger matching, sum applicant weights for those preferring the challenger and subtract weights for those preferring the candidate; a positive margin defeats the candidate.",
    "objective": "Among undefeated popular matchings, maximize cardinality then choose the lexicographically smallest assignment vector.",
    "profile_boundary": "Complete strict rankings only; no ties, incomplete lists, or polynomial-time chapter algorithm claim.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "one-applicant-prefers-item-to-unmatched",
      "input_values": [1, 1, 3, 0],
      "input_length": 4,
      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "010000000000000001000000000000000000000000000000"
    },
    {
      "id": "opposite-preferences-full-matching",
      "input_values": [2, 2, 1, 1, 0, 1, 1, 0],
      "input_length": 8,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000020000000000000000000000000000000100000000000000"
    },
    {
      "id": "equal-weight-one-item-tie-break",
      "input_values": [2, 1, 1, 1, 0, 0],
      "input_length": 6,
      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "01000000000000000100000000000000ffffffffffffffff0000000000000000"
    },
    {
      "id": "ranking-row-not-a-permutation",
      "input_values": [1, 2, 1, 0, 0],
