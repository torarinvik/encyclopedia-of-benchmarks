  "id": "deterministic-wa-tor-fixed-order-v1",
  "algorithm": "wa_tor",
  "function_symbol": "wa_tor",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[width, height, chronons, (kind, reproduction_timer, energy) ...] with row-major cell triplets",
    "width_range": [
      1,
      8
    ],
    "height_range": [
      1,
      8
    ],
    "chronon_range": [
      0,
      32
    ],
    "cell_encoding": {
      "empty": [
        0,
        0,
        0
      ],
      "prey": {
        "kind": 1,
        "timer_range": [
          0,
          5
        ],
        "energy": 0
      },
      "predator": {
        "kind": 2,
        "timer_range": [
          0,
          20
        ],
        "energy_range": [
          0,
          15
        ]
      }
    },
    "maximum_valid_array_length": 195,
    "maximum_parseable_array_length": 196,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "row-major final-state hash packed with final prey and predator counts",
    "invalid_input_result": -1
  },
  "source_bound": {
    "source": "TheAlgorithms/Python cellular_automata/wa_tor.py at e1a2a8b016001309a73d5fec4818c35cca139795",
    "benchmark_domain": "Caller-supplied rectangular boards up to 8x8 and 32 chronons, using source prey/predator state and constants.",
    "deterministic_normalization": "The source random entity ordering and both random shuffles are replaced by row-major entity snapshots, N,E,S,W movement priority, and N,S,W,E predator prey-target priority. The fixed orders are the source lists before shuffle. The board is non-wrapping. The source 450-entity purge and 500-entity cap are unreachable on this board.",
    "output_encoding": "For each final row-major cell, use code 0 for empty, timer+33 for prey, or 1000+53*energy+timer+32 for predator. Fold codes with hash=(hash*1000003+code) mod 2147483647; return hash*4225+65*prey_count+predator_count."
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
