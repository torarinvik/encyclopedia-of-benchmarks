  "schema_version":1,
  "id":"encyclopedia-weighted-random-sampling-rational-key-i64-array-bytes-output-v1",
  "algorithm":"weighted_random_sampling",
  "function_symbol":"weighted_random_sampling",
  "abi":"i64_array_bytes_output",
  "description":"Select the largest source weighted-sampling keys using supplied exact rational randomness.",
  "source":{"title":"Weighted Random Sampling","authors":["Pavlos Efraimidis","Paul (Pavlos) Spirakis"],"year":2016,"reference":"Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_478","url":"https://doi.org/10.1007/978-1-4939-2864-4_478","algorithm_attribution":"Efraimidis-Spirakis Algorithm A key ordering","implementation_status":"clean-room bounded supplied-randomness projection"},
  "input":{"kind":"signed_64_bit_integer_array","encoding":"[item_count, sample_size, (weight, uniform_numerator, uniform_denominator)...]","item_count_range":[1,16],"sample_size_range":"1 through item_count","weight_range":[1,3],"rational_random_value":"1 <= numerator < denominator <= 100","maximum_valid_length":50,"invalid_input_result":-1},
  "output":{"kind":"little_endian_signed_64_bit_array","encoding":"selected zero-based item IDs in decreasing exact-key order","maximum_bytes":128,"success_result":"8 * sample_size bytes written","invalid_input_result":-1,"null_output_result":-2,"insufficient_capacity_result":-2,"output_untouched_on_error":true},
  "workspace":{"bytes":256,"meaning":"At most sixteen exact-key item indices and staged output IDs."},
  "contract":{"key":"K_i = (numerator_i / denominator_i)^(1 / weight_i).","comparison":"For i versus j, compare numerator_i^weight_j * denominator_j^weight_i with numerator_j^weight_i * denominator_i^weight_j.","tie_rule":"Lower item ID precedes higher item ID.","randomness":"Uniform values are supplied as rationals; the finite fixture projection does not claim the ideal continuous probability law.","invalid_input_result":-1,"output_error_result":-2},
  "measurement":{"comparison_model":"i64_array_bytes_output_call","sample_count":8,"warmup_rounds":2,"repetitions_per_sample":100},
  "cases":[
    {"id":"largest-weighted-keys","input_values":[4,2,1,1,2,2,1,4,3,3,9,10,1,3,4],"input_length":14,"output_capacity":16,"expected_result":16,"expected_output_hex":"02000000000000000300000000000000"},
    {"id":"exact-root-ties","input_values":[3,2,1,1,2,2,1,4,3,8,3,1,1],"input_length":11,"output_capacity":16,"expected_result":16,"expected_output_hex":"00000000000000000100000000000000"},
    {"id":"equal-weight-ranking","input_values":[5,3,1,1,5,1,4,5,1,3,5,1,2,5,1,1,10],"input_length":17,"output_capacity":24,"expected_result":24,"expected_output_hex":"010000000000000002000000000000000300000000000000"},
    {"id":"weight-out-of-range","input_values":[2,1,4,1,2,1,3,4],"input_length":8,"output_capacity":128,"expected_result":-1,"expected_output_hex":""},
    {"id":"invalid-rational","input_values":[1,1,1,2,2],"input_length":5,"output_capacity":128,"expected_result":-1,"expected_output_hex":""},
    {"id":"length-mismatch","input_values":[2,1,1,1,2],"input_length":5,"output_capacity":128,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[2,1,1,1,2,1,2,3],"input_length":8,"output_capacity":7,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-output","input_values":[2,1,1,1,2,1,2,3],"input_length":8,"output_capacity":8,"output_is_null":true,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":2,"input_is_null":true,"output_capacity":128,"expected_result":-1,"expected_output_hex":""}
  ]
