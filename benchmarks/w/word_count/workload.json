{
  "schema_version": 1,
  "id": "word-count-literal-space-v1",
  "algorithm": "word_count",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[text_length, text_ascii_bytes..., query_length, query_ascii_bytes...]",
    "text_length_range": [
      0,
      999
    ],
    "query_length_range": [
      0,
      49
    ],
    "alphabet": "non-NUL ASCII bytes 1..127; only literal ASCII space separates tokens",
    "maximum_token_count": 20,
    "maximum_token_length": 49,
    "invalid_input_results": {
      "malformed_or_long_word": -1,
      "too_many_words": -2
    }
  },
  "output": {
    "kind": "two_signed_64_bit_values_little_endian",
    "encoding": "[total_space_delimited_token_count, exact_case_sensitive_query_matches]",
    "successful_result": 16,
    "insufficient_output_capacity_result": -2
  },
