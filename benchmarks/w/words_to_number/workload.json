{
  "schema_version": 1,
  "id": "java-words-to-number-ascii-i64-array-bytes-v1",
  "algorithm": "words_to_number",
  "function_symbol": "words_to_number",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[byte_length, ASCII bytes...]",
    "byte_range": [
      32,
      126
    ],
    "separator_bytes": [
      32,
      44,
      45
    ],
    "maximum_byte_length": 128,
    "empty_input_result": -3,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "ASCII_decimal_string",
    "success_result": "number of result bytes",
    "error_results": {
      "-1": "malformed or out-of-domain bytes/input",
      "-2": "insufficient output capacity",
      "-3": "NULL_INPUT (empty or separator-only text)",
      "-4": "UNKNOWN_WORD",
      "-5": "UNEXPECTED_WORD",
      "-6": "UNEXPECTED_WORD_AFTER_POINT",
      "-7": "MISSING_DECIMAL_NUMBERS",
      "-8": "MULTIPLE_NEGATIVES",
      "-9": "INVALID_NEGATIVE",
      "-10": "INVALID_CONJUNCTION"
    }
  },
  "contract_bounds": {
    "maximum_fractional_number_words": 3,
    "maximum_output_bytes": 64
  },
  "workspace": {
    "bytes": 64
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
