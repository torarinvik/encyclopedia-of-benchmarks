  "contract": {
    "mst_tie_rule": "Kruskal edge order by weight, then lower endpoint, then upper endpoint.",
    "traversal": "Depth-first preorder from vertex 0, visiting tree neighbors in ascending ID order.",
    "shortcutting": "Visit each vertex once in preorder and return directly to vertex 0.",
    "invalid_input_result": -1,
    "output_error_result": -2
