{
  "schema_version": 1,
  "id": "min-cost-max-flow-blocking-paths-i64-array-bytes-output-v1",
  "algorithm": "min_cost_max_flow_blocking_paths",
  "function_symbol": "min_cost_max_flow_blocking_paths",
  "description": "Minimum-cost maximum flow using shortest-distance labels and blocking flows in the tight residual graph.",
  "algorithm_method": "Each phase computes shortest residual distances with a queue-based label-correcting pass, then runs layered blocking flow over residual arcs satisfying dist[v] = dist[u] + cost.",
  "oracles": {
    "primary": "SPFA distance labels plus Dinic blocking flow in the tight residual graph",
    "independent": "Bellman-Ford successive shortest augmenting paths"
  },
  "source": {
    "project": "OI Wiki",
    "path": "graph/flow/min-cost/",
    "url": "https://en.oi-wiki.org/graph/flow/min-cost/",
    "license": "CC BY-SA 4.0 and SATA",
    "use": "Clean-room implementation from the high-level method description; no code or prose copied."
  },
  "contract": {
    "operation": "Return maximum feasible flow from source to sink up to flow_limit and its minimum possible total cost.",
    "input_layout": "[vertex_count, edge_count, source, sink, flow_limit, (from, to, capacity, cost)*edge_count]",
    "bounds": {
      "vertex_count": [
        2,
        8
      ],
      "edge_count": [
        0,
        16
      ],
      "flow_limit": [
        0,
        16
      ],
      "capacity": [
        0,
        5
      ],
      "cost": [
        0,
        20
      ]
    },
    "cost_restriction": "Original forward edge costs are nonnegative; reverse residual arcs use negated costs. This ensures no negative-cost cycle in the initial residual network.",
    "semantics": "Directed multigraph; parallel edges and self-loops are accepted. Repeatedly compute shortest residual distances, then send a blocking flow through the tight residual subgraph until no tight source-to-sink path remains. Repeat until no route remains or flow_limit is reached. Return maximum flow up to the limit and its minimum total cost.",
    "output_encoding": "Two signed 64-bit integers in little-endian order: total flow, then total cost.",
    "output_bytes": 16,
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Malformed frame, vertex, capacity, cost, or bound returns -1 before output checks. Null output or capacity below 16 returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "5-word header followed by edge quadruples in listed order",
    "maximum_input_length": 69,
    "valid_ranges": {
      "vertex_count": "2..8",
      "edge_count": "0..16",
      "source_and_sink": "valid vertices, distinct",
      "flow_limit": "0..16",
      "edge_capacity": "0..5",
      "edge_cost": "0..20"
    },
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "little-endian signed-i64 flow followed by little-endian signed-i64 minimum cost",
    "maximum_bytes": 16,
    "success_result": "16 bytes on success",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 16,
    "meaning": "Fixed result encoding for flow and cost."
  },
