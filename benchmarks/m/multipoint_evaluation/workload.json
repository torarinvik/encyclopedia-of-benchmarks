  "contract": {
    "operation": "Evaluate a polynomial at every supplied point modulo 998244353.",
    "input_layout": "[N, M, c_0, ..., c_(N-1), p_0, ..., p_(M-1)]",
    "coefficient_count_range": [1, 8],
    "point_count_range": [1, 8],
    "coefficient_and_point_range": [0, 998244352],
    "leading_coefficient": "nonzero",
    "modulus": 998244353,
    "algorithm": "Build a monic product tree over (x-p_i), reduce f modulo the root product, then propagate remainders down the tree. Naive polynomial multiplication and monic long division give O(NM + M^2) coefficient operations in this bounded profile.",
    "independent_algorithm": "Evaluate each point independently with Horner's recurrence.",
    "output_layout": "M little-endian signed 64-bit values, in point order.",
    "error_precedence": "Malformed input returns -1 before output checks. Valid input with null output or capacity below the exact output size returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N, M, coefficients..., points...]",
    "maximum_valid_length": 18,
    "maximum_parseable_length": 18,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 8,
    "maximum_bytes": 64,
    "success_result": "8*M bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "maximum_bytes": 4096,
    "model": "Fixed product-tree and remainder-tree coefficient tables, node lengths/ranges, and bounded temporary polynomials."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 6,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
