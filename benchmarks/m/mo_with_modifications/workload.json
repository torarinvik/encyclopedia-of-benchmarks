{
  "schema_version": 1,
  "id": "mo-with-modifications-v1",
  "algorithm": "mo_with_modifications",
  "function_symbol": "mo_with_modifications",
  "abi": "i64_array_scalar",
  "source": {
    "title": "Mo's algorithm with modifications",
    "url": "https://oi-wiki.org/misc/modifiable-mo-algo/",
    "reuse": "algorithm description only; independent implementation, contract, and fixtures"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,Q,initial_values...,(operation,first,second)*Q]",
    "array_length_range": [1, 64],
    "operation_count_range": [0, 64],
    "operation_encoding": {
      "0": "point assignment: first is index, second is new value",
      "1": "inclusive range-distinct query: first is left, second is right"
    },
    "value_range": [0, 15],
    "maximum_valid_input_length": 258,
    "maximum_parseable_input_length": 259,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "sum in original query order of one-based_query_index*(distinct_count+1)",
    "result_range": "0..35360",
    "invalid_result": -1
  },
  "complexity": {
    "time": "O(Q log Q + Q*(N+Q)) worst-case bound",
    "auxiliary_space": "O(N+Q+alphabet_size)",
    "ordering": "three-dimensional Mo order by left block, right block, and update time"
  },
  "workspace": {"bytes": 8192},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"no-operations","input_values":[1,0,5],"expected_result":0},
    {"id":"static-range-queries","input_values":[5,2,1,2,1,3,2,1,0,4,1,3],"expected_result":12},
    {"id":"update-changes-window-frequency","input_values":[5,4,1,2,1,3,2,1,0,2,0,1,1,1,0,2,1,1,4],"expected_result":19},
    {"id":"forward-and-rollback-updates","input_values":[4,6,0,0,1,1,1,0,3,0,0,1,1,0,0,0,2,0,1,1,3,1,0,3],"expected_result":28},
    {"id":"repeated-assignment","input_values":[2,4,1,1,0,0,1,1,0,1,0,1,1,1,0,0],"expected_result":6},
    {"id":"invalid-operation","input_values":[1,1,0,6,0,0],"expected_result":-1},
    {"id":"update-index-out-of-range","input_values":[2,1,0,1,0,2,3],"expected_result":-1},
    {"id":"range-reversed","input_values":[2,1,0,1,1,1,0],"expected_result":-1},
    {"id":"value-out-of-range","input_values":[1,0,16],"expected_result":-1},
    {"id":"trailing-value","input_values":[1,0,2,9],"expected_result":-1},
    {"id":"missing-operation-field","input_values":[1,1,2,1,0],"expected_result":-1},
    {"id":"null-input","input_values":[],"input_is_null":true,"input_length":0,"expected_result":-1}
  ]
}
