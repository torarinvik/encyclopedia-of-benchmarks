{
  "schema_version": 1,
  "id": "morris-base-2-approximate-counter-tape-replay-v1",
  "algorithm": "morris_approximate_counter",
  "function_symbol": "morris_approximate_counter",
  "abi": "i64_array_bytes_output",
  "description": "Replay a supplied exact discrete uniform draw tape through the base-2 Morris counter.",
  "source": {
    "title": "Counting Large Numbers of Events in Small Registers",
    "author": "Robert Morris",
    "doi": "https://doi.org/10.1145/359619.359627",
    "algorithm_reference": "https://www.algorithm-archive.org/contents/approximate_counting/approximate_counting.html",
    "reuse": "Algorithm definition only; the workload, ports, and oracle are clean-room."
  },
  "contract": {
    "input_layout": "[Q, draw_0, ..., draw_(Q-1)]",
    "updates_range": [1, 53],
    "draw_range": "0 <= draw < 2^53; draw / 2^53 represents a discrete uniform variate in [0,1)",
    "initial_state": 0,
    "transition": "For each event, increment state v iff draw < 2^(53-v).",
    "output_encoding": "Two little-endian signed 64-bit integers: compressed state v, then decoded estimate 2^v-1.",
    "maximum_state": 53,
    "maximum_estimate": 9007199254740991,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true,
    "deterministic_error_guarantee": "none; the input tape fixes a trace but does not imply a probability distribution"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 54,
    "maximum_parseable_length": 54,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "little-endian signed 64-bit pair (state, decoded estimate)",
    "maximum_bytes": 16,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 32,
    "meaning": "Bounded scalar state, draw, threshold, and estimate; no tape copy is needed."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id":"first-event-counts-certainly","input_values":[1,9007199254740991],"input_length":2,"output_capacity":16,"expected_result":16,"expected_output_hex":"01000000000000000100000000000000"},
    {"id":"high-draws-leave-one-counted-event","input_values":[4,0,9007199254740991,9007199254740991,9007199254740991],"input_length":5,"output_capacity":16,"expected_result":16,"expected_output_hex":"01000000000000000100000000000000"},
    {"id":"threshold-and-strict-boundary","input_values":[3,0,4503599627370495,2251799813685248],"input_length":4,"output_capacity":16,"expected_result":16,"expected_output_hex":"02000000000000000300000000000000"},
    {"id":"repeated-successes","input_values":[4,0,0,0,0],"input_length":5,"output_capacity":16,"expected_result":16,"expected_output_hex":"04000000000000000f00000000000000"},
    {"id":"zero-updates","input_values":[0],"input_length":1,"output_capacity":16,"expected_result":-1,"expected_output_hex":""},
    {"id":"truncated-draw-tape","input_values":[2,0],"input_length":2,"output_capacity":16,"expected_result":-1,"expected_output_hex":""},
    {"id":"negative-draw","input_values":[1,-1],"input_length":2,"output_capacity":16,"expected_result":-1,"expected_output_hex":""},
    {"id":"draw-at-exclusive-upper-bound","input_values":[1,9007199254740992],"input_length":2,"output_capacity":16,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[1,0],"input_length":2,"output_capacity":15,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-output","input_values":[1,0],"input_length":2,"output_capacity":16,"output_is_null":true,"expected_result":-2,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":0,"input_is_null":true,"output_capacity":16,"expected_result":-1,"expected_output_hex":""}
  ]
}
