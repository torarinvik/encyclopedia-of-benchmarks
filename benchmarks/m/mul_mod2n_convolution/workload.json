  "contract": {
    "operation": "c[k] is the sum of a[i]*b[j] modulo 998244353 over i*j == k modulo 2^N.",
    "input_layout": "[N,a[0..2^N),b[0..2^N)]",
    "n_range": [0, 5],
    "coefficient_range": [0, 998244352],
    "coefficient_modulus": 998244353,
    "algorithm": "Direct residue-pair enumeration; multiplication is reduced modulo 2^N for the destination and modulo 998244353 for the accumulated coefficient.",
    "output_layout": "2^N little-endian signed 64-bit coefficients reduced modulo 998244353.",
    "error_precedence": "Malformed frame, out-of-range N, or invalid coefficient returns -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,a[0..2^N),b[0..2^N)]",
    "n_range": [0, 5],
    "entry_domain": [0, 998244352],
    "maximum_valid_length": 65,
    "maximum_parseable_length": 66,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 32,
    "maximum_output_bytes": 256,
    "success_result": "8*(2^N) bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
