  "contract": {
    "operation": "Return the smallest index of a lexicographically least cyclic rotation.",
    "algorithm": "Compare two candidate starts while tracking their equal prefix; eliminate the larger candidate through the first mismatch.",
    "complexity": "O(n) time and O(1) additional storage.",
    "tie_rule": "Return the smallest surviving candidate index; equal periodic rotations resolve to the earliest start.",
    "input_is_unchanged": true
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {"id": "empty", "input_values": [], "input_length": 0, "expected_result": 0},
    {"id": "one-symbol", "input_values": [97], "input_length": 1, "expected_result": 0},
    {"id": "strictly-increasing", "input_values": [97, 98, 99], "input_length": 3, "expected_result": 0},
    {"id": "least-start-after-prefix", "input_values": [97, 98, 99, 97, 98], "input_length": 5, "expected_result": 3},
    {"id": "least-start-at-end", "input_values": [98, 98, 97], "input_length": 3, "expected_result": 2},
    {"id": "periodic-even-start-tie", "input_values": [97, 98, 97, 98], "input_length": 4, "expected_result": 0},
    {"id": "periodic-nonzero-tie", "input_values": [98, 97, 98, 97], "input_length": 4, "expected_result": 1},
    {"id": "zero-and-del", "input_values": [0, 127, 0, 127], "input_length": 4, "expected_result": 0},
    {"id": "several-equal-prefixes", "input_values": [99, 97, 98, 97], "input_length": 4, "expected_result": 1},
    {"id": "mixed-ascii", "input_values": [122, 120, 121, 120], "input_length": 4, "expected_result": 1},
    {"id": "invalid-negative-codepoint", "input_values": [-1, 97], "input_length": 2, "expected_result": -1},
    {"id": "invalid-non-ascii-codepoint", "input_values": [97, 128], "input_length": 2, "expected_result": -1}
  ]
