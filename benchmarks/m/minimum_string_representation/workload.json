  "input": {
    "kind": "ascii_codepoint_array",
    "encoding": "[codepoint_0, codepoint_1, ...]",
    "minimum_length": 0,
    "maximum_length": 4096,
    "maximum_parseable_length": 4097,
    "codepoint_range": [0, 127],
    "empty_result": 0,
