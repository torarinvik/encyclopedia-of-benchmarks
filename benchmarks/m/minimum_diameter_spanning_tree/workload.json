      "output_capacity": 24,
      "expected_result": 24,
      "expected_output_hex": "020000000000000000000000000000000100000000000000"
    },
    {
      "id": "path-half-integral-center",
      "input_values": [4, 3, 0, 1, 1, 1, 2, 5, 2, 3, 1],
