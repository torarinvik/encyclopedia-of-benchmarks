{
  "schema_version": 1,
  "id": "library-checker-minimum-diameter-spanning-tree-bounded-i64-array-bytes-output-v1",
  "algorithm": "minimum_diameter_spanning_tree",
  "function_symbol": "minimum_diameter_spanning_tree",
  "abi": "i64_array_bytes_output",
  "description": "Select an input-edge spanning tree of minimum weighted diameter.",
  "source": {
    "title": "Minimum Diameter Spanning Tree",
    "authors": ["Library Checker contributors"],
    "reference": "Library Checker problem",
    "url": "https://github.com/yosupo06/library-checker-problems/blob/master/graph/minimum_diameter_spanning_tree/task.md",
    "limits_url": "https://raw.githubusercontent.com/yosupo06/library-checker-problems/master/graph/minimum_diameter_spanning_tree/info.toml",
    "algorithm_attribution": "Graph-metric center enumeration with shortest-path-tree construction",
    "implementation_status": "clean-room bounded minimum-diameter spanning tree"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,(u,v,w)...]",
    "N_range": [1, 8],
    "M_range": [0, 20],
    "edge_weight_range": "0 <= w <= 9",
    "graph_constraint": "connected undirected graph; parallel edges, self-loops, and zero-weight edges are allowed",
    "maximum_valid_input_length": 62,
    "maximum_parseable_input_length": 63,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "minimum diameter followed by N-1 input edge IDs in ascending order, all signed 64-bit little-endian",
    "maximum_bytes": 64,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 64,
    "meaning": "Maximum output-buffer capacity; graph and shortest-path arrays are separate."
  },
  "contract": {
    "result": "minimum possible weighted diameter among spanning trees of the input graph",
    "official_N_range": [1, 2000],
    "official_M_range": "N-1 <= M <= 2000",
    "official_edge_weight_range": "0 <= w <= 1000000000",
    "official_graph_may_be_non_simple": true,
    "center_coordinates": "integer vertex centers and half-integral edge centers represented by doubled coordinates",
    "deterministic_witness_order": "vertex centers by ID, then input edges by ID and doubled coordinates ascending; update only for a strictly smaller radius"
  },
  "certificate": {
    "tree_edge_count": "N-1",
    "tree_connectivity": "selected input edge IDs form a connected acyclic graph",
    "optimality_check": "enumerate every bounded N-1 edge subset and compare its weighted tree diameter"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
    {
