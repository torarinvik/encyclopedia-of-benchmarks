      "output_capacity": 32,
      "expected_result": 32,
      "expected_output_hex": "0700000000000000000000000000000001000000000000000200000000000000"
    },
    {
      "id": "parallel-zero-edge-and-alternative-path",
      "input_values": [3, 4, 0, 1, 0, 0, 1, 3, 1, 2, 2, 0, 2, 5],
