    {"id":"reversed-rows","input_values":[2,1,0,1,2,3,1,0,0,1],"input_length":10,"expected_result":-1},
    {"id":"coordinate-out-of-range","input_values":[2,1,0,1,2,3,0,0,1,2],"input_length":10,"expected_result":-1},
