{
  "schema_version": 1,
  "id": "move-to-front-java-mode-tagged-ascii-v1",
  "algorithm": "move_to_front",
  "function_symbol": "move_to_front",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[mode, alphabet_length, payload_length, alphabet_bytes..., payload...]",
    "mode_values": {
      "0": "transform text symbols to current alphabet indices",
      "1": "inverse-transform indices to text symbols"
    },
    "alphabet_length_range": [
      0,
      32
    ],
    "payload_length_range": [
      0,
      128
    ],
    "alphabet_byte_range": [
      0,
      127
    ],
    "exact_length": "3 + alphabet_length + payload_length",
    "maximum_valid_array_length": 163,
    "maximum_parseable_array_length": 164,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_string",
    "meaning": "one index byte per encoded symbol or one ASCII byte per decoded symbol",
    "maximum_length": 128,
    "successful_result": "number of output bytes written",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 128,
    "meaning": "maximum encoded or decoded output length"
  },
  "source_bound": {
    "description": "The Java transform and inverseTransform methods share one alphabet update rule. The bounded ABI uses an explicit mode and ASCII symbol values.",
    "benchmark_domain": "Unique ASCII alphabet values 0..127; at most 32 alphabet entries and 128 payload entries. Java inverse with an empty alphabet returns empty before reading indices."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
