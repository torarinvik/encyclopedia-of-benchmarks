{
  "schema_version": 1,
  "id": "minimum-element-of-array-seeded-quickselect-v1",
  "algorithm": "minimum_element_of_array",
  "input": {
    "kind": "signed_64_integer_array",
    "encoding": "[n, one_based_rank, seed, distinct_values...]",
    "n_range": [
      1,
      128
    ],
    "rank_range": "1 through n",
    "seed_range": [
      0,
      2147483647
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "values_must_be_distinct": true,
    "invalid_result": -1
  },
  "cases": [
    {
      "id": "kth_smallest",
      "input_values": [
        8,
        1,
        42,
        -2,
        3,
        -10,
        11,
        99,
        100,
        6,
        8
      ],
      "input_length": 11,
      "expected_result": -10
    },
    {
      "id": "middle_rank",
      "input_values": [
        8,
        4,
        123,
        -2,
        3,
        -10,
        11,
        99,
        100,
        6,
        8
      ],
      "input_length": 11,
      "expected_result": 6
    },
    {
      "id": "largest_rank",
      "input_values": [
        5,
        5,
        7,
        5,
        -1,
        3,
        9,
        0
      ],
      "input_length": 8,
      "expected_result": 9
    },
    {
      "id": "singleton",
      "input_values": [
        1,
        1,
        8,
        -200
      ],
      "input_length": 4,
      "expected_result": -200
    },
    {
      "id": "empty_array",
      "input_values": [
        0,
        1,
        1
      ],
      "input_length": 3,
      "expected_result": -1
    },
    {
      "id": "rank_out_of_range",
      "input_values": [
        3,
        4,
        1,
        1,
        2,
        3
      ],
      "input_length": 6,
      "expected_result": -1
    },
    {
      "id": "duplicate_values",
      "input_values": [
        3,
        2,
        1,
        5,
        5,
        7
      ],
      "input_length": 6,
      "expected_result": -1
    },
    {
      "id": "wrong_length",
      "input_values": [
        2,
        1,
        1,
        5
      ],
      "input_length": 4,
      "expected_result": -1
    }
  ],
  "measurement": {
    "timer": "clock()",
    "comparison_model": "scalar_call",
    "repetitions_per_sample": 10000,
    "warmup_rounds": 2,
    "sample_count": 7
  }
}
