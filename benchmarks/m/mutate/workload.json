    "role": "algorithm"
  },
  "contract": {
    "operation": "binary mutation using supplied per-gene uniform draws",
    "source_rule": "flip gene i iff draw[i] < mu; equality does not flip",
    "shape": "one-dimensional row vector of n binary genes and n matching draws",
    "rng_adapter": "draws are supplied as input to make the source threshold operator deterministic"
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[mu, n, genes[0..n), draws[0..n)]",
    "exact_length": "2 + 2*n",
    "maximum_valid_input_length": 130,
    "maximum_parseable_input_length": 130,
    "gene_count_range": [
      0,
      64
    ],
    "gene_count_must_be_exact_integer": true,
    "mutation_rate_range": [
      0.0,
      1.0
    ],
    "gene_domain": [
      0.0,
      1.0
    ],
    "genes_must_be_exact_binary_values": true,
    "draw_range": [
      0.0,
      1.0
    ],
    "draw_upper_bound_is_exclusive": true,
    "all_values_must_be_finite": true,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "one mutated binary value per input gene, preserving row-vector order",
    "maximum_elements": 64,
    "success_result": "gene_count",
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "null_output_result": -2,
    "null_output_is_error_for_empty_result": true,
    "no_write_on_error": true,
    "error_precedence": "Malformed or out-of-domain input is rejected before output pointer or capacity checks.",
    "absolute_tolerance": 0.0,
    "relative_tolerance": 0.0
  },
  "workspace": {
    "elements": 64,
    "meaning": "one mutated output value per gene"
  },
  "measurement": {
    "comparison_model": "float64_slice_io_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "absolute_tolerance": 0.0,
    "relative_tolerance": 0.0
  },
