{
  "schema_version": 1,
  "id": "cp-algorithms-mixed-knapsack-i64-array-scalar-v1",
  "algorithm": "mixed_knapsack",
  "function_symbol": "mixed_knapsack",
  "abi": "i64_array_scalar",
  "description": "Solve a bounded-capacity knapsack with per-item 0/1, unbounded, or finite-multiplicity modes.",
  "source": {
    "title": "Knapsack Problem",
    "section": "Mixed Knapsack",
    "url": "https://cp-algorithms.com/dynamic_programming/knapsack.html#mixed-knapsack",
    "license": "CC BY-SA 4.0 source consulted for the algorithmic idea only; implementation and fixtures are clean-room",
    "algorithm_attribution": "Dispatch each item type to descending 0/1, ascending unbounded, or binary-grouped bounded capacity updates.",
    "implementation_status": "bounded clean-room heterogeneous mode-dispatch profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,capacity,(mode,weight,value,limit)*n]",
    "item_type_count_range": [0, 16],
    "capacity_range": [0, 64],
    "mode_values": {"0": "single-use 0/1", "1": "unbounded", "2": "bounded"},
    "weight_range": [1, 16],
    "value_range": [0, 100],
    "mode_limit_rules": {"0": "limit exactly 1", "1": "limit exactly 0", "2": "limit in 0..16"},
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "encoding": "maximum total value using at most capacity",
    "valid_result_range": [0, 6400],
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 1024,
    "meaning": "A fixed 65-element signed 64-bit capacity DP array and scalar bundle/loop state."
  },
  "contract": {
    "primary_method": "Process item records in input order. Mode 0 scans capacities downward once; mode 1 scans upward to allow repeated use; mode 2 decomposes its finite count into binary bundles and scans downward for each bundle.",
    "independent_method": "For every item type, construct a new capacity DP row by trying each allowed number of copies against the previous row.",
    "mode_markers": "Mode 0 must supply limit 1; mode 1 must supply limit 0; mode 2 uses its supplied bounded count 0..16.",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 10,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  },
  "primary_oracle": "benchmarks/m/mixed_knapsack/primary_oracle.py",
  "independent_oracle": "benchmarks/m/mixed_knapsack/independent_oracle.py",
