  },
  "contract": {
    "operation": "Return the one-based weighted sum of minimum values over the supplied lines at each query coordinate.",
    "input_encoding": "[L,Q,(slope,intercept)*L,x[Q]]",
    "line_count_range": [1, 32],
    "query_count_range": [0, 32],
    "slope_range": [-1000, 1000],
    "slopes_must_be_strictly_decreasing": true,
    "intercept_range": [-10000, 10000],
    "query_coordinate_range": [-1000, 1000],
    "queries_must_be_nondecreasing": true,
    "result_encoding": "sum((i+1)*min_j(slope[j]*x[i]+intercept[j])) for zero-based query position i",
    "zero_queries_result": 0,
    "invalid_input_result": -9223372036854775808,
    "primary_method": "Prune a fixed-array lower hull by exact integer crossing comparisons, then advance its front for sorted queries.",
    "independent_method": "Scan all lines for each query and sum the weighted minima."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[L,Q,(slope,intercept)*L,x[Q]]",
    "line_count_range": [1, 32],
    "query_count_range": [0, 32],
