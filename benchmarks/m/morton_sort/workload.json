{
  "schema_version": 1,
  "id": "morton-sort-z-order-i64-array-bytes-v1",
  "algorithm": "morton_sort",
  "function_symbol": "morton_sort",
  "input": {
    "kind": "packed_signed_64_integer_array",
    "encoding": "[n, x0, y0, ..., x(n-1), y(n-1)]",
    "point_count_range": [1, 256],
    "coordinate_range": [0, 65535],
    "exact_packed_length": "1 + 2*n",
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer_vector",
    "encoding": "original point indices sorted by (32-bit Morton code, original index), little-endian two's-complement bytes",
    "maximum_bytes": 2048,
    "successful_result": "output byte length",
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 2048,
    "meaning": "Maximum output payload for 256 points"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {
      "id": "single_point",
      "input_values": [1, 0, 0],
      "input_length": 3,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "four_quadrants",
      "input_values": [4, 1, 1, 0, 0, 0, 1, 1, 0],
      "input_length": 9,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000030000000000000002000000000000000000000000000000"
    },
    {
      "id": "duplicate_codes_keep_input_order",
      "input_values": [4, 1, 1, 0, 0, 1, 1, 0, 1],
      "input_length": 9,
      "expected_result": 32,
      "expected_output_hex": "0100000000000000030000000000000000000000000000000200000000000000"
    },
    {
      "id": "high_coordinate_bits",
      "input_values": [4, 65535, 65535, 32768, 0, 0, 32768, 0, 0],
      "input_length": 9,
      "expected_result": 32,
      "expected_output_hex": "0300000000000000010000000000000002000000000000000000000000000000"
    },
    {
      "id": "packed_length_mismatch",
      "input_values": [2, 0, 0, 1],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "coordinate_out_of_range",
      "input_values": [2, 0, 0, 65536, 1],
      "input_length": 5,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "insufficient_output_capacity",
      "input_values": [2, 1, 0, 0, 1],
      "input_length": 5,
      "output_capacity": 15,
      "expected_result": -2,
      "expected_output_hex": ""
    }
  ]
}
