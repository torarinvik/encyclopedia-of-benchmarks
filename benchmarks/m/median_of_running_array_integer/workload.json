{
  "schema_version": 1,
  "id": "median-of-running-array-integer-v1",
  "algorithm": "median_of_running_array_integer",
  "input": {
    "kind": "packed_i64_array",
    "encoding": "[n, integer_stream...]",
    "length_range": [
      1,
      256
    ],
    "element_range": [
      -1000000,
      1000000
    ]
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "encoding": "one integer median after each insertion; even medians truncate toward zero",
    "invalid_result": -1
  },
  "cases": [
    {
      "id": "ascending",
      "input_values": [
        6,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "input_length": 7,
      "expected_result": 48,
      "expected_output_hex": "010000000000000001000000000000000200000000000000020000000000000003000000000000000300000000000000"
    },
    {
      "id": "mixed_negative_even",
      "input_values": [
        6,
        -9,
        4,
        -1,
        8,
        0,
        7
      ],
      "input_length": 7,
      "expected_result": 48,
      "expected_output_hex": "f7fffffffffffffffeffffffffffffffffffffffffffffff010000000000000000000000000000000200000000000000"
    },
    {
      "id": "duplicates",
      "input_values": [
        5,
        2,
        2,
        2,
        3,
        3
      ],
      "input_length": 6,
      "expected_result": 40,
      "expected_output_hex": "02000000000000000200000000000000020000000000000002000000000000000200000000000000"
    },
    {
      "id": "single_value",
      "input_values": [
        1,
        -7
      ],
      "input_length": 2,
      "expected_result": 8,
      "expected_output_hex": "f9ffffffffffffff"
    },
    {
      "id": "empty_stream",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "length_mismatch",
      "input_values": [
        2,
        4
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "value_out_of_range",
      "input_values": [
        1,
        1000001
      ],
      "input_length": 2,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  }
}
