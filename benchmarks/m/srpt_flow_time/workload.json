  "abi": "i64_array_bytes_output",
  "description": "Preemptive shortest-remaining-processing-time scheduling on bounded identical machines.",
  "source": {
    "chapter_single_machine": {"title":"Minimum Flow Time","authors":["Nikhil Bansal"],"reference":"Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_235","algorithm_attribution":"Single-machine SRPT is optimal when preemption is allowed."},
    "chapter_parallel_machines": {"title":"Flow Time Minimization","authors":["Luca Becchetti","Stefano Leonardi","Alberto Marchetti-Spaccamela","Kirk Pruhs"],"reference":"Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_146","algorithm_attribution":"SRPT is the stated best-known policy for identical parallel machines in the preemptive setting."},
    "implementation_status":"Clean-room bounded integer-time profile; m=1 preserves the single-machine case."
  },
  "input": {"kind":"signed_64_bit_integer_array","encoding":"[machine_count,n,(release_time,processing_time)...]","machine_count_range":[1,4],"job_count_range":[1,12],"release_time_range":[0,50],"processing_time_range":[1,10],"maximum_valid_length":26,"maximum_parseable_length":27,"invalid_input_result":-1,"null_input_result":-1},
  "output": {"kind":"little_endian_signed_64_bit_array","encoding":"[total_flow_time,completion_times_by_job_id...]","maximum_output_elements":13,"maximum_bytes":104,"success_result":"8 * (1+n) bytes written","invalid_input_result":-1,"null_output_result":-2,"insufficient_capacity_result":-2,"output_untouched_on_error":true},
  "workspace": {"bytes":512,"meaning":"Bounded release, remaining-work, completion, selected-job, and schedule state for 12 jobs and 4 machines."},
  "contract": {"time_model":"Integer release and processing times; preemptive scheduling decisions occur at integer boundaries.","selection":"At each time slot, run up to machine_count released unfinished jobs by smallest remaining processing time; ties use lower job ID.","idle":"Advance to the earliest unreleased job when no job is ready.","objective":"Sum completion_time minus release_time.","error_precedence":"Malformed input returns -1 before output checks; null or short output returns -2 without writes."},
  "measurement": {"comparison_model":"i64_array_bytes_output_call","sample_count":8,"warmup_rounds":2,"repetitions_per_sample":100},
