{
  "schema_version": 1,
  "id": "mdp-policy-iteration-deterministic-exact-v1",
  "algorithm": "mdp_policy_iteration",
  "function_symbol": "mdp_policy_iteration",
  "abi": "i64_array_bytes_output",
  "description": "Exactly evaluate and greedily improve deterministic stationary policies for a bounded discounted MDP.",
  "source": {
    "title": "Reinforcement Learning",
    "author": "Eyal Even-Dar",
    "chapter": 341,
    "section": "Policy Iteration",
    "doi": "10.1007/978-1-4939-2864-4_341",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_341",
    "source_algorithm": "Evaluate V_pi as the fixed point of the policy Bellman operator, then improve pi greedily with respect to V_pi.",
    "source_license": "Copyright Springer; consulted for algorithm identification and mathematical description only. No book prose, examples, figures, or code are reproduced.",
    "implementation_status": "clean-room bounded profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[state_count, action_count, discount_numerator, discount_denominator, (reward,next_state)*state_count*action_count]",
    "state_count_range": [1, 4],
    "action_count_range": [1, 3],
    "discount": "p/q where 0 <= p < q <= 4",
    "reward_range": [-20, 20],
    "next_state_range": "0 through state_count-1",
    "record_order": "state-major, then action-major; each record is reward followed by deterministic next_state",
    "maximum_valid_length": 28,
    "maximum_parseable_length": 28,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[state_count, policy[state_count], (reduced_value_numerator,positive_denominator)*state_count]",
    "maximum_bytes": 104,
    "success_result": "8*(1+3*state_count) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Bounded policy, state-path, reward, successor, and exact rational numerator/denominator tables."
  },
  "contract": {
    "initial_policy": "Action 0 in every state.",
    "evaluation": "For the selected action in each state, solve V(s)=reward(s,pi(s))+(p/q)*V(next(s,pi(s))) exactly. The deterministic policy graph consists of paths into cycles; evaluate each cycle by the finite geometric sum and propagate values back along its path.",
    "improvement": "Choose an action maximizing reward(s,a)+(p/q)*V(next(s,a)); exact ties choose the lowest action index.",
    "termination": "Stop when the greedy policy equals the evaluated policy. At most action_count^state_count deterministic stationary policies exist.",
    "fraction_encoding": "Each reported value is reduced by gcd and has a positive denominator.",
    "complexity": "O(A^S*(S^2+SA)) bounded exact-rational arithmetic for S states and A actions; workspace O(S).",
    "error_precedence": "Validate input pointer, exact length, dimensions, discount, rewards, and successors before output pointer/capacity.",
    "no_write_on_error": true
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1,
    "profiles": [
      {"id": "single-state-policy-switch", "input_values": [1, 2, 1, 2, 1, 0, 2, 0], "output_bytes": 32},
      {"id": "two-state-exact-policy-evaluation", "input_values": [2, 1, 1, 2, 1, 1, 0, 1], "output_bytes": 56}
    ]
  },
  "cases": [
    {"id": "single-state-improves-from-action-zero", "input_values": [1, 2, 1, 2, 1, 0, 2, 0], "input_length": 8, "output_capacity": 32, "expected_result": 32, "expected_output_hex": "0100000000000000010000000000000004000000000000000100000000000000"},
    {"id": "two-state-greedy-policy-and-values", "input_values": [2, 2, 1, 2, 0, 0, 1, 1, 2, 1, 0, 0], "input_length": 12, "output_capacity": 56, "expected_result": 56, "expected_output_hex": "0200000000000000010000000000000000000000000000000300000000000000010000000000000004000000000000000100000000000000"},
    {"id": "zero-discount-action-tie", "input_values": [1, 2, 0, 1, 1, 0, 1, 0], "input_length": 8, "output_capacity": 32, "expected_result": 32, "expected_output_hex": "0100000000000000000000000000000001000000000000000100000000000000"},
    {"id": "one-action-transient-into-self-loop", "input_values": [2, 1, 1, 2, 1, 1, 0, 1], "input_length": 8, "output_capacity": 56, "expected_result": 56, "expected_output_hex": "0200000000000000000000000000000000000000000000000100000000000000010000000000000000000000000000000100000000000000"},
    {"id": "invalid-discount-at-least-one", "input_values": [1, 1, 2, 1, 0, 0], "input_length": 6, "output_capacity": 104, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-successor", "input_values": [1, 1, 1, 2, 0, 1], "input_length": 6, "output_capacity": 104, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-reward", "input_values": [1, 1, 1, 2, 21, 0], "input_length": 6, "output_capacity": 104, "expected_result": -1, "expected_output_hex": ""},
    {"id": "wrong-packed-length", "input_values": [1, 1, 1, 2, 0], "input_length": 5, "output_capacity": 104, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-input", "input_values": [1, 1, 1, 2, 0, 0], "input_length": 6, "input_is_null": true, "output_capacity": 104, "expected_result": -1, "expected_output_hex": ""},
    {"id": "null-output", "input_values": [1, 1, 1, 2, 0, 0], "input_length": 6, "output_is_null": true, "output_capacity": 32, "expected_result": -2, "expected_output_hex": ""},
    {"id": "short-output-capacity", "input_values": [1, 1, 1, 2, 0, 0], "input_length": 6, "output_capacity": 31, "expected_result": -2, "expected_output_hex": ""}
