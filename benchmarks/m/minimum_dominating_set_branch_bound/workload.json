    "maximum_result": 12,
    "invalid_input_result": -1
  },
  "workspace": {
    "bytes": 8192,
    "meaning": "Fixed adjacency masks and bounded recursive branch state."
  },
  "contract": {
    "branching": "Choose the lowest-ID uncovered vertex having minimum closed-neighborhood size; branch over its closed neighborhood in decreasing new-coverage order, breaking ties by vertex ID.",
    "incumbent": "Greedy repeatedly selects the lowest-ID vertex among those with maximum new coverage.",
    "lower_bound": "ceil(uncovered vertex count / maximum new coverage by any one vertex).",
    "edge_validation": "Reject loops, repeated undirected edges (including reversed duplicates), out-of-range endpoints, truncated frames, trailing words, and null input.",
    "exact_length": "2 + 2*M",
    "maximum_valid_length": 134,
    "maximum_parseable_length": 135
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 10,
    "warmup_rounds": 1,
    "repetitions_per_sample": 10
  },
  "oracle_method": "Primary oracle uses greedy-seeded recursive closed-neighborhood branch and bound; independent oracle enumerates vertex subsets by increasing cardinality and tests coverage.",
