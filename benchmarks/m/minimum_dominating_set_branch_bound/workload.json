    "edge_count_range": [
      0,
      66
    ],
    "graph": "simple undirected; each unordered pair occurs once, either endpoint order is accepted",
    "vertex_label_range": "[0,N)",
    "exact_length": "2 + 2*M",
    "maximum_valid_length": 134,
