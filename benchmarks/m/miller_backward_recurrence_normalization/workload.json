    "implementation_status": "bounded clean-room finite-field profile"
  },
  "contract": {
    "operation": "Assign w_N=1,w_(N+1)=0, recurse backward through a_n*w_(n+1)-b_n*w_n+c_n*w_(n-1)=0, then scale w_0..w_N so sum(lambda_i*w_i)=1.",
    "primary_method": "Miller terminal trial and backward recurrence, followed by inversion of the supplied finite normalization functional.",
    "independent_method": "Solve the upper-triangular linear system induced by all recurrence equations and the terminal values, then apply the same normalization functional.",
    "finite_profile_caveat": "This is a fixed-depth finite-field recurrence profile and makes no claim of convergence to an analytic recessive solution.",
    "invalid_input_result": -1,
    "zero_divisor_or_normalizer_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,(a_n,b_n,c_n) for n=1..N,lambda_0..lambda_N]",
    "level_range": [1, 8],
    "coefficient_range": [0, 998244352],
    "required_nonzero_fields": "all c_n",
    "maximum_valid_length": 34,
    "maximum_parseable_length": 35,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_word_array_bytes",
    "encoding": "[N,normalized_w0,...,normalized_wN] over F_998244353",
    "word_count_range": [3, 10],
    "maximum_bytes": 80,
    "success_result": "number of output bytes, equal to 8*(N+2)",
    "invalid_input_or_normalizer_result": -1,
    "null_or_short_output_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 192,
    "meaning": "Ten i64 trial slots (80 bytes), scalar recurrence/normalization state, and conservative alignment allowance; no dynamic allocation."
  },
  "complexity": {
    "native_primary_time": "O(N log p) modular operations for recurrence inverses and normalization",
    "native_primary_auxiliary_space": "O(N), capped at 192 bytes",
    "independent_reference_time": "O(N^2 + N log p), using an upper-triangular solve",
    "independent_reference_auxiliary_space": "O(N^2) for the small dense matrix"
  },
