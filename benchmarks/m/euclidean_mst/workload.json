{
  "schema_version": 1,
  "id": "library-checker-euclidean-mst-bounded-delaunay-kruskal-v1",
  "algorithm": "euclidean_mst",
  "function_symbol": "euclidean_mst",
  "description": "Euclidean MST via empty-circle Delaunay candidate generation and Kruskal.",
  "source": {
    "name": "Library Checker Euclidean MST",
    "task_url": "https://judge.yosupo.jp/problem/euclidean_mst",
    "task_definition": "https://raw.githubusercontent.com/yosupo06/library-checker-problems/master/geo/euclidean_mst/task.md",
    "limits": "https://raw.githubusercontent.com/yosupo06/library-checker-problems/master/geo/euclidean_mst/info.toml",
    "algorithm_note": "exact incircle determinant for Delaunay candidates, followed by Kruskal"
  },
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[n, x0, y0, ..., x(n-1), y(n-1)]",
    "point_count_range": [1, 8],
    "coordinate_range": [-10, 10],
    "distinct_points_required": true,
    "general_position": "For n >= 3, no collinear triple and no cocircular quadruple.",
    "maximum_valid_input_length": 17,
    "maximum_parseable_input_length": 18,
    "invalid_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "Little-endian signed i64 words [n-1, (u, v)[n-1]] in deterministic Kruskal selection order.",
    "maximum_bytes": 120,
    "success_length": "8 * (2*n - 1)",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true
  },
  "certificate": {
    "tree": "The n-1 reported edges form a connected acyclic graph.",
    "minimum_property": "For every complete-graph edge (u,v), the maximum squared edge weight on the reported tree path from u to v is at most dist2(u,v)."
  },
  "workspace": {"bytes": 4096},
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "oracle_method": "Canonical output comes from exhaustive empty-circumcircle triples and Kruskal. A separate checker verifies tree structure and the complete-graph cycle property using exact squared distances.",
  "cases": [
    {"id": "single-point", "input_values": [1, 2, -3], "input_length": 3, "output_capacity": 8, "expected_result": 8, "expected_output_hex": "0000000000000000"},
    {"id": "two-points", "input_values": [2, -2, 1, 3, 5], "input_length": 5, "output_capacity": 24, "expected_result": 24, "expected_output_hex": "010000000000000000000000000000000100000000000000"},
    {"id": "triangle", "input_values": [3, 0, 0, 2, 0, 1, 2], "input_length": 7, "output_capacity": 40, "expected_result": 40, "expected_output_hex": "02000000000000000000000000000000010000000000000000000000000000000200000000000000"},
    {"id": "convex-quadrilateral", "input_values": [4, 0, 0, 4, 0, 5, 3, 0, 5], "input_length": 9, "output_capacity": 56, "expected_result": 56, "expected_output_hex": "0300000000000000010000000000000002000000000000000000000000000000010000000000000000000000000000000300000000000000"},
    {"id": "interior-point", "input_values": [4, 0, 0, 6, 0, 0, 6, 1, 1], "input_length": 9, "output_capacity": 56, "expected_result": 56, "expected_output_hex": "0300000000000000000000000000000003000000000000000100000000000000030000000000000002000000000000000300000000000000"},
    {"id": "invalid-duplicate-point", "input_values": [3, 0, 0, 1, 0, 0, 0], "input_length": 7, "output_capacity": 120, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-collinear-triple", "input_values": [3, 0, 0, 1, 1, 2, 2], "input_length": 7, "output_capacity": 120, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-cocircular-quadruple", "input_values": [4, 0, 0, 2, 0, 2, 2, 0, 2], "input_length": 9, "output_capacity": 120, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-coordinate", "input_values": [1, 11, 0], "input_length": 3, "output_capacity": 120, "expected_result": -1, "expected_output_hex": ""},
    {"id": "invalid-point-count", "input_values": [0], "input_length": 1, "output_capacity": 120, "expected_result": -1, "expected_output_hex": ""},
    {"id": "truncated-point-frame", "input_values": [2, 0, 0, 1], "input_length": 4, "output_capacity": 120, "expected_result": -1, "expected_output_hex": ""},
    {"id": "undersized-output", "input_values": [1, 0, 0], "input_length": 3, "output_capacity": 7, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null-output", "input_values": [1, 0, 0], "input_length": 3, "output_capacity": 8, "output_is_null": true, "expected_result": -2, "expected_output_hex": ""},
    {"id": "null-input", "input_values": [], "input_length": 0, "input_is_null": true, "output_capacity": 120, "expected_result": -1, "expected_output_hex": ""}
  ]
}
