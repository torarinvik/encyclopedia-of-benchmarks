  "algorithm": "morris_approximate_counter_base_three",
  "function_symbol": "morris_approximate_counter_base_three",
  "abi": "i64_array_bytes_output",
  "description": "Replay a supplied integer tape through the a=1/2 parameter variant of the generalized Morris counter.",
  "source": {
    "title": "Approximate Counting Algorithm",
