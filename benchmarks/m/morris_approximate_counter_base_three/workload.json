    "historical_reference": "Robert Morris, Counting Large Numbers of Events in Small Registers",
    "doi": "https://doi.org/10.1145/359619.359627",
    "reuse": "Algorithm equations only; implementations, contract, references, and fixtures are original."
  },
  "contract": {
    "parameter": "a=1/2",
    "input_layout": "[Q, draw_0, ..., draw_(Q-1)]",
    "updates_range": [0, 30],
    "draw_range": "0 <= draw < 205891132094649 (3^30)",
    "initial_state": 0,
    "transition": "At state v, increment iff draw < 3^(30-v); after an increment divide the stored threshold by 3.",
    "decoded_estimate": "(3^v-1)/2",
    "maximum_state": 30,
    "maximum_estimate": 102945566047324,
    "maximum_valid_input_length": 31,
    "maximum_parseable_input_length": 32,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "layout": "[Q, draw_0, ..., draw_(Q-1)]",
    "updates_range": [0, 30],
    "draw_range": "0..205891132094648",
    "maximum_valid_length": 31,
    "maximum_parseable_length": 32,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "two little-endian signed i64 values: state, decoded estimate",
    "maximum_bytes": 16,
    "success_result": 16,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "input_validation_precedes_capacity": true,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 32,
    "meaning": "Scalar state, rolling threshold, draw, and decoded output values; caller buffers are excluded."
  },
  "complexity": {
    "primary_time": "O(Q)",
    "primary_state": "O(1)",
    "independent_reference_time": "O(Q) big-integer operations",
    "independent_reference_state": "O(1) excluding output bytes"
  },
  "measurement": {
