{
  "schema_version": 1,
  "id": "max-character-v1",
  "algorithm": "max_character",
  "function_symbol": "max_character",
  "input": {
    "kind": "lowercase_ascii_code_array",
    "length_range": [1, 256],
    "character_value_range": [97, 122],
    "requires_unique_maximum": true,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "ascii_code_of_most_frequent_character",
    "result_range": [97, 122],
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id": "singleton", "input_values": [97], "input_length": 1, "expected_result": 97},
    {"id": "unique-maximum", "input_values": [104, 101, 108, 108, 111, 119, 111, 114, 108, 100], "input_length": 10, "expected_result": 108},
    {"id": "repeated-maximum", "input_values": [122, 122, 97, 98, 122, 97], "input_length": 6, "expected_result": 122},
    {"id": "tied-maximum", "input_values": [97, 97, 98, 98, 99], "input_length": 5, "expected_result": -1},
    {"id": "empty", "input_values": [], "input_length": 0, "expected_result": -1},
    {"id": "uppercase-out-of-domain", "input_values": [65, 97], "input_length": 2, "expected_result": -1},
    {"id": "nonletter-out-of-domain", "input_values": [97, 49], "input_length": 2, "expected_result": -1},
    {"id": "nonascii-out-of-domain", "input_values": [97, 233], "input_length": 2, "expected_result": -1}
  ]
}
