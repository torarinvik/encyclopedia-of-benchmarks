  "schema_version": 1,
  "id": "myers-ond-shortest-edit-script-i64-array-bytes-output-v1",
  "algorithm": "myers_ond_shortest_edit_script",
  "function_symbol": "myers_ond_shortest_edit_script",
  "abi": "i64_array_bytes_output",
  "description": "Myers furthest-reaching edit-graph search with a replayable minimum insert/delete path.",
  "source": {
    "title": "An O(ND) Difference Algorithm and Its Variations",
    "authors": ["Eugene W. Myers"],
    "year": 1986,
    "reference": "Algorithmica 1, pp. 251-266, DOI 10.1007/BF01840446",
    "url": "https://doi.org/10.1007/BF01840446",
    "implementation_status": "bounded clean-room profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[first_length, second_length, first_bytes..., second_bytes...]",
    "sequence_length_range": [0, 16],
    "symbol_range": [0, 255],
    "exact_length": "2 + first_length + second_length",
    "maximum_valid_length": 34,
    "maximum_parseable_length": 36,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_string",
    "encoding": "instruction stream: 0 copies the next equal source byte; 1 deletes the next source byte; 2 inserts the following literal byte",
    "maximum_output_bytes": 48,
    "success_result": "number of instruction bytes written",
    "valid_empty_result": 0,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_output_capacity_result": -2,
    "no_write_on_error": true,
    "edit_cost": "count of instruction tags 1 and 2; insert payload bytes do not count"
  },
  "workspace": {
    "bytes": 48,
    "meaning": "Maximum caller output-buffer capacity; the fixed-size edit trace is internal working storage."
  },
  "algorithm_policy": {
    "variant": "Myers 1986 O((n+m)D) furthest-reaching D-path algorithm",
    "diagonal": "k = x - y; frontier stores the furthest x on each active diagonal",
    "path_rule": "for each D and k=-D,-D+2,...,D, compare predecessor frontiers, then greedily extend the maximal equal-byte snake",
    "tie_rule": "choose the insertion predecessor only when V[k-1] < V[k+1]; equality chooses the deletion predecessor",
    "reconstruction": "retain each frontier row and backtrack its selected predecessor and snake",
    "objective": "minimum number of insertions and deletions; substitution is represented by one delete plus one insert",
    "time_complexity": "O((n+m)D), where D is minimum insert/delete cost",
    "auxiliary_space": "O(D^2) frontier snapshots plus O(n+m) path records"
  },
  "oracle_method": "Primary stores Myers furthest-reaching wavefronts and backtracks the strict-comparison tie rule. Independent full-table insert/delete DP reconstructs its own deletion-first-on-local-ties witness and verifies replay and optimal cost of the primary bytes without requiring equal tie choices.",
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
