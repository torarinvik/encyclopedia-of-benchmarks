{
  "schema_version": 1,
  "id": "merge-sorted-two-bounded-i64-arrays-v1",
  "algorithm": "merge_sorted",
  "function_symbol": "merge_sorted",
  "input": {
    "kind": "signed_i64_array",
    "layout": "[left_count, right_count, left_values..., right_values...]",
    "array_count_range": [
      0,
      64
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "exact_length": "2 + left_count + right_count",
    "maximum_valid_array_length": 130,
    "maximum_parseable_array_length": 131,
    "arrays_must_be_nondecreasing": true,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_i64_scalar",
    "meaning": "sum((zero_based_merged_index + 1) * (merged_value + 1_000_001))",
    "maximum_absolute_result": 16512008256,
    "invalid_input_result": -1
  },
  "source_bound": {
    "description": "The pinned Python function first validates each input array against its sorted order, then uses two pointers and chooses the left value when values compare equal. Empty inputs are returned directly.",
    "benchmark_domain": "Two nondecreasing arrays, each with at most 64 signed values in -1,000,000..1,000,000. The scalar result is a deterministic checksum of the source's merged output sequence."
  },
  "measurement": {
