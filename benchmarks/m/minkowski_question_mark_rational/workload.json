    "pinned_behavior": "For an interior rational with regular continued fraction [0;a1,...,an], return the exact dyadic value sum(j=1..n, (-1)^(j-1)*2^(1-(a1+...+aj))). Endpoints map to 0 and 1."
  },
  "contract": {
    "definition": "Return the reduced dyadic pair [numerator, exponent] for Minkowski's question-mark value ?(p/q)=numerator/2^exponent, with denominator 1 represented by exponent 0.",
    "input_encoding": "[p,q]",
    "rational_domain": "0<=p<=q and 1<=q<=1000000; p and q need not be relatively prime.",
    "continued_fraction_convention": "For 0<p<q use the unique regular finite expansion [0;a1,...,an] with positive partial quotients and an>=2. The endpoints 0 and 1 are explicit special cases.",
    "profile_cap": "The sum a1+...+an must be at most 60; otherwise the input is outside this bounded profile and returns -1.",
    "arithmetic_bounds": "No shift exceeds 59; each alternating numerator prefix has absolute magnitude below 2^60. Stern-Brocot comparison products are at most 1000000^2, and dyadic endpoint numerators remain below 2^60.",
    "primary_method": "Compute Euclidean partial quotients and the alternating dyadic sum from their prefix sums.",
    "independent_method": "Locate p/q by Stern-Brocot mediant bisection while bisecting endpoint question-mark values in parallel.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true
  },
  "input": {
