{
  "schema_version": 1,
  "id": "median-search-distinct-int32-v1",
  "algorithm": "median_search",
  "function_symbol": "median_search",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[n, k, value_0, ..., value_(n-1)]",
    "element_count_range": [1, 25],
    "rank_range": "0 <= k < n",
    "value_range": [0, 2147483647],
    "distinct_values": true,
    "result": "value at zero-based sorted rank k",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "invalid_input_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000
  },
  "cases": [
