    {"id":"source_example_b_rank_four","input_values":[6,4,1,2,3,4,5,6],"expected_result":5},
    {"id":"source_example_c_rank_three","input_values":[9,3,1,2,3,4,5,1000,8,9,99],"expected_result":4},
