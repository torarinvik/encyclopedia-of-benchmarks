    {"id":"even_upper_middle","input_values":[4,2,9,2,7,4],"expected_result":7},
    {"id":"five_element_group_boundary","input_values":[5,2,50,10,40,20,30],"expected_result":30},
    {"id":"six_element_group_boundary","input_values":[6,4,60,10,50,20,40,30],"expected_result":50},
