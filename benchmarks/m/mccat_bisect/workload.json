  "source_bound": {
    "description": "The source constructs a symmetric tridiagonal matrix with diagonal c[i]=(i+1)^4 and off-diagonal b[i]=i, then computes eigenvalues by repeated Sturm-count bisection. The profile follows the launch input rep=1 and eps=DBL_EPSILON, bounds n to 2..32, and returns the numeric values from the source stdout as a little-endian binary64 vector. The source passes &S[-1] to a 1-based solver and prints S[1..n-1]; the profile models the intended shifted indexing safely, yielding lambda_2 through lambda_n, then eps2 and k.",
    "source_stdout_format": "n-1 lines using printf(\"%5d %.15e\\n\"), followed by printf(\"eps2 = %e,  k = %d\\n\")",
    "source_launcher_default_n": 500,
    "profile_n_range": [
      2,
      32
    ],
    "source_repeat_count": 1,
    "profile_epsilon": 2.220446049250313e-16,
    "maximum_output_bytes": 264,
    "output_vector_order": [
      "lambda_2 through lambda_n in ascending eigenvalue order",
      "eps2",
      "Sturm bisection iteration count k as an exactly representable binary64 value"
    ]
  },
