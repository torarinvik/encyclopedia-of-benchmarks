{
  "schema_version": 1,
  "id": "multiply-shift-universal-hash-trace-i64-array-bytes-output-v1",
  "algorithm": "multiply_shift_universal_hash_trace",
  "function_symbol": "multiply_shift_universal_hash_trace",
  "abi": "i64_array_bytes_output",
  "description": "Evaluate caller-selected odd multipliers from the 32-bit multiply-shift universal family over bounded integer keys.",
  "source": {
    "title": "A Reliable Randomized Algorithm for the Closest-Pair Problem",
    "authors": "Martin Dietzfelbinger, Torben Hagerup, Jyrki Katajainen, and Martti Penttonen",
    "reference": "Journal of Algorithms 25(1), pages 19-51 (1997)",
    "url": "https://doi.org/10.1006/jagm.1997.0873",
    "discovery_source": "NIST DADS unified index and multiplication-method entry",
    "discovery_url": "https://xlinux.nist.gov/dads/ui.html",
    "pinned_behavior": "h_a(x) is the top s bits of a*x modulo 2^32 for an odd 32-bit multiplier a."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[output_bits,query_count,(odd_multiplier_32,key_32)*query_count]",
    "output_bits_domain": [1, 16],
    "query_count_domain": [0, 32],
    "multiplier_domain": "odd integers from 1 through 2^32-1",
    "key_domain": "integers from 0 through 2^32-1",
    "maximum_valid_length": 66,
    "maximum_parseable_length": 67,
    "invalid_input_result": -1,
    "validation_order": "Reject null input; reject length outside 2..67; validate signed-i64 framing, output bit width, query count and exact frame length; validate each odd multiplier and key; finally validate output pointer and capacity."
  },
  "output": {
    "kind": "raw_byte_array",
    "encoding": "one unsigned hash value per query, serialized as an eight-byte little-endian word",
    "maximum_output_bytes": 256,
    "success_result": "number of bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true,
    "zero_length_output_allows_null_pointer": true
  },
  "workspace": {
    "bytes": 128,
    "accounting": "One query pair, widened product, masked word, and scalar/index temporaries; caller input and output storage are excluded."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
