{
  "schema_version": 1,
  "id": "encyclopedia-min-hash-bottom-k-i64-array-bytes-output-v1",
  "algorithm": "min_hash_bottom_k",
  "function_symbol": "min_hash_bottom_k",
  "abi": "i64_array_bytes_output",
  "description": "Retain the k supplied-rank items with smallest (rank,item_id) keys.",
  "source": {
    "title": "Min-Hash Sketches",
    "authors": ["Edith Cohen"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_573",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_573",
    "algorithm_attribution": "bottom-k sketch order statistic and insertion threshold rule",
    "implementation_status": "clean-room; explicit supplied-rank profile; no code license stated in chapter"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,k,(item_id,rank)[n]]",
    "n_range": [1, 16],
    "k_range": [1, 8],
    "item_id_range": [0, 15],
    "rank_range": [0, 1000],
    "maximum_valid_length": 34,
    "maximum_parseable_length": 35,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[count,(item_id,rank)[count]] sorted by (rank,item_id)",
    "maximum_bytes": 136,
    "success_result": "8*(1+2*min(n,k)) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 512,
    "meaning": "At most 16 item/rank records for the retained bottom-k sketch and staged output."
  },
  "contract": {
    "rank_source": "Ranks are supplied as input; this profile does not generate hashes or random ranks.",
    "selection": "Process input records as insertions; keep the k smallest (rank,item_id) keys, replacing the current maximum only when the new key is smaller.",
    "tie_rule": "Equal ranks are ordered by increasing item_id as a deterministic refinement.",
    "duplicate_items": "Item IDs must be unique.",
    "scope": "Bottom-k order-statistic and threshold-update behavior only; no estimator or randomized guarantee is claimed.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
  "cases": [
