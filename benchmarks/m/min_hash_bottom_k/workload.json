    {"id":"threshold-replacement","input_values":[5,2,0,10,1,20,2,5,3,4,4,30],"input_length":12,"output_capacity":40,"expected_result":40,"expected_output_hex":"02000000000000000300000000000000040000000000000002000000000000000500000000000000"},
    {"id":"duplicate-item-invalid","input_values":[2,1,4,8,4,3],"input_length":6,"output_capacity":136,"expected_result":-1,"expected_output_hex":""},
