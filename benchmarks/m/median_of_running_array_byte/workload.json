  "contract": {
    "operation": "Return one median after each insertion into a fresh running stream.",
    "insertion": "If minHeap is nonempty and sample < minHeap.peek(), insert into maxHeap; otherwise insert into minHeap.",
    "rebalancing": "Move one root only when one heap has more than one extra element.",
    "odd_prefix": "Return the root of the larger heap. Heap ordering and the size difference of one make this the sorted center; insertion order determines which heap is larger.",
    "even_prefix": "Average maxHeap.peek() and minHeap.peek() after promotion to Java int using truncation toward zero, then cast to signed byte.",
    "oracle": "Sort every prefix independently; this yields the same observable center root on odd prefixes and the same two middle values on even prefixes."
  }
