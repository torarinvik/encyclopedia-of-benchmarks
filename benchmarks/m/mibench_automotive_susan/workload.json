    "pixel_range": [0, 255],
    "brightness_weight": "Truncate 100*exp(-((difference/20)^2)) to an unsigned byte after the source's binary32 intermediate rounding.",
    "spatial_weight": "Truncate 100*exp(-((dx*dx+dy*dy)/16)) to an unsigned byte over dx,dy in [-7,7].",
    "border": "Mirror the edge sample with repetition, matching SUSAN's enlarged image: index -1 maps to 0 and side maps to side-1.",
    "output_encoding": "Raw row-major grayscale bytes, one output pixel per input pixel.",
