{
  "schema_version": 1,
  "id": "minimum-weight-cycle-floyd-i64-array-bytes-v1",
  "algorithm": "minimum_weight_cycle_floyd",
  "function_symbol": "minimum_weight_cycle_floyd",
  "abi": "i64_array_bytes_output",
  "source": {
    "method_reference": "https://oi-wiki.org/graph/min-cycle/",
    "reuse_scope": "Algorithm description only; contracts, fixtures, references, and ports are independently authored."
  },
  "contract": {
    "profile": "Minimum total weight among simple undirected cycles of at least three vertices.",
    "input_layout": "[n,m,(u,v,w)*m]",
    "vertex_range": [3, 9],
    "edge_count_range": "0 <= m <= n*(n-1)/2",
    "edge_rule": "Zero-based endpoints; each unordered pair occurs at most once; self-loops are invalid; endpoint order and record order are arbitrary.",
    "weight_range": [1, 1000],
    "frame_rule": "Exact input length is 2+3*m.",
    "output_layout": "One little-endian signed-i64 word: minimum cycle weight, or -1 for a valid acyclic graph.",
    "status_rule": "A valid call returns 8 bytes, including the acyclic -1 payload. Malformed or null input returns -1 with no writes. Valid input with null output or capacity below 8 returns -2 with no writes.",
    "primary_method": "For each k, inspect cycles whose largest-numbered vertex is k using the original edges (i,k),(k,j) and prior dist[i][j], for i<j<k; then relax all-pairs distances through k.",
    "independent_method": "Enumerate simple cycles with the least-numbered vertex as start and retain only the orientation whose first neighbor is smaller than its last neighbor."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 110,
    "maximum_parseable_length": 111,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_byte_array",
    "maximum_bytes": 8,
    "size_formula": "8 for every valid input",
    "success_result": 8,
    "acyclic_payload_value": -1,
    "invalid_result": -1,
    "null_or_short_output_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "Conservative cap for two fixed 9x9 signed-i64 matrices, parser/loop state, and bounded output staging."
  },
  "complexity": {
    "primary_time": "O(n^3 + m)",
    "primary_space": "O(n^2)",
    "independent_time": "O(number_of_simple_cycles + n^2 + m)",
    "independent_space": "O(n^2)"
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
