{
  "schema_version": 1,
  "id": "python-maximum-sum-bst-bounded-heap-slots-v1",
  "algorithm": "maximum_sum_bst",
  "function_symbol": "maximum_sum_bst",
  "input": {
    "kind": "heap-indexed-binary-tree-slots",
    "encoding": "[slot_count, slot_0, ..., slot_(n-1)]; children of slot i are 2*i+1 and 2*i+2",
    "slot_count_range": [
      0,
      31
    ],
    "null_slot_value": -1,
    "node_value_range": [
      0,
      1000000
    ],
    "exact_packed_length": "slot_count + 1",
    "child_requires_present_parent": true,
    "invalid_result": -1,
    "maximum_packed_values": 32
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "maximum sum among all strict-BST subtrees; zero is the baseline used by source, including for empty/all-nonpositive cases",
    "invalid_result": -1
  },
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1
  },
  "cases": [
    {
      "id": "empty_tree",
      "input_values": [
        0
      ],
      "expected_result": 0,
      "input_length": 1
    },
    {
      "id": "single_node",
      "input_values": [
        1,
        5
      ],
      "expected_result": 5,
      "input_length": 2
    },
    {
      "id": "complete_bst",
      "input_values": [
        7,
        5,
        3,
        8,
        2,
        4,
        6,
        9
      ],
      "expected_result": 37,
      "input_length": 8
    },
    {
