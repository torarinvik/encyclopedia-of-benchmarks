  "contract": {
    "operation": "For convex integer sequences a and b, c[k]=min over i+j=k of a[i]+b[j], for 0<=k<N+M-1.",
    "input_layout": "[N,M,a[0..N),b[0..M)]",
    "convexity": "Each sequence has nondecreasing first differences: x[i+1]-x[i] <= x[i+2]-x[i+1].",
    "algorithm": "Merge the two nondecreasing first-difference sequences in O(N+M), then prefix-sum from a[0]+b[0]. Equal slopes take a's difference first; output values are invariant under ties.",
    "entry_domain": "Integers in [0,1000000000].",
    "output_layout": "N+M-1 little-endian signed 64-bit integers.",
    "error_precedence": "Malformed frames, values, or nonconvex sequences return -1 before output checks. Valid input with null output or insufficient capacity returns -2; errors write no output."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,a[0..N),b[0..M)]",
    "n_range": [1, 128],
    "m_range": [1, 128],
    "official_dimension_maximum": 524288,
    "entry_domain": [0, 1000000000],
    "maximum_valid_length": 258,
    "maximum_parseable_length": 259,
    "invalid_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "maximum_output_elements": 255,
    "maximum_bytes": 2040,
    "success_result": "8*(N+M-1) bytes",
    "invalid_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 2040,
    "meaning": "Maximum staged output buffer. Both slope cursors require constant additional storage."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
