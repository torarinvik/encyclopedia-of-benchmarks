  "contract": {
    "operation": "c[k] is the sum of a[i]*b[j] modulo MOD over i*j == k modulo prime P.",
    "input_layout": "[P,a[0..P),b[0..P)]",
    "prime_range": [
      2,
      97
    ],
    "coefficient_range": [
      0,
      998244352
    ],
    "modulus": 998244353,
    "algorithm": "Nonzero residues are mapped by a primitive root to exponents; cyclic exponent convolution is bounded O(P^2). The zero residue is accumulated from the zero row and column, counting (0,0) once.",
    "output_layout": "P little-endian signed 64-bit coefficients reduced modulo MOD.",
    "error_precedence": "Malformed frame, nonprime/out-of-range P, or invalid coefficient returns -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
