{
  "schema_version": 1,
  "id": "midpoint-integration-polynomial-fixedpoint-v1",
  "algorithm": "midpoint_integration",
  "function_symbol": "midpoint_integration",
  "input": {
    "kind": "four_element_signed_64_array",
    "encoding": "[function_id, N, a_micro, b_micro]",
    "function_id_map": {
      "0": "f(x)=1",
      "1": "f(x)=x",
      "2": "f(x)=x^2"
    },
    "N_range": [
      1,
      256
    ],
    "bounds_range": "-1 <= a <= b <= 1, scaled by 1,000,000"
  },
  "output": {
    "kind": "little_endian_signed_i64",
    "encoding": "midpoint integral rounded to scale 1,000,000,000",
    "successful_result": 8,
    "invalid_result": -1,
    "insufficient_capacity_result": -2
  },
  "cases": [
    {
      "id": "constant_integrand",
      "input_values": [
        0,
        8,
        -1000000,
        1000000
      ],
      "input_length": 4,
      "expected_result": 8,
      "expected_output_hex": "0094357700000000"
    },
    {
      "id": "linear_integrand",
      "input_values": [
        1,
        8,
        0,
        1000000
      ],
      "input_length": 4,
      "expected_result": 8,
      "expected_output_hex": "0065cd1d00000000"
    },
    {
      "id": "quadratic_integrand",
      "input_values": [
        2,
        8,
        0,
        1000000
      ],
      "input_length": 4,
      "expected_result": 8,
      "expected_output_hex": "1265ca1300000000"
    },
    {
      "id": "reversed_odd_interval",
      "input_values": [
        2,
        5,
        -1000000,
        1000000
      ],
      "input_length": 4,
      "expected_result": 8,
      "expected_output_hex": "00a0252600000000"
    },
    {
      "id": "equal_bounds",
      "input_values": [
        2,
        16,
        125000,
        125000
      ],
      "input_length": 4,
      "expected_result": 8,
      "expected_output_hex": "0000000000000000"
    },
    {
      "id": "one_panel",
      "input_values": [
        2,
        1,
        0,
        1000000
      ],
      "input_length": 4,
      "expected_result": 8,
      "expected_output_hex": "80b2e60e00000000"
    },
    {
      "id": "zero_steps",
      "input_values": [
        0,
        0,
        0,
        1000000
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "reversed_bounds",
      "input_values": [
        1,
        4,
        100000,
        -100000
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "bad_function",
      "input_values": [
        3,
        4,
        0,
        100000
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  }
}
