{
  "schema_version": 1,
  "id": "morris-pratt-search-v1",
  "algorithm": "morris_pratt_search",
  "function_symbol": "morris_pratt_search",
  "abi": "i64_array_scalar",
  "source": {
    "title": "Morris-Pratt algorithm",
    "url": "https://www-igm.univ-mlv.fr/~lecroq/string/node7.html",
    "paper": "Morris J. H. and Pratt V. R., A linear pattern-matching algorithm, Technical Report 40, University of California, Berkeley (1970)",
    "reuse": "algorithm description only; independent implementation, contract, and fixtures"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m,text[0..n),pattern[0..m)]",
    "text_length_range": [0, 4096],
    "pattern_length_range": [1, 128],
    "alphabet_range": [0, 3],
    "maximum_valid_input_length": 4226,
    "maximum_parseable_input_length": 4227,
    "invalid_result": -1
  },
  "output": {
    "kind": "signed_64_bit_integer",
    "encoding": "(match_count << 36) | (sum_of_offsets << 12) | xor_of_offsets",
    "result_range": "0..562949953421311",
    "invalid_result": -1
  },
  "complexity": {
    "preprocessing_time": "O(m)",
    "search_time": "O(n+m), at most 2n-1 text-symbol comparisons for n>0; zero when n=0",
    "auxiliary_space": "O(m)"
  },
  "workspace": {"bytes": 65536},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 7,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
