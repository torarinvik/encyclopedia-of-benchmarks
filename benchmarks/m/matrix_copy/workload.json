{
  "schema_version": 1,
  "id": "go-matrix-deep-copy-i64-array-bytes-output-v1",
  "algorithm": "matrix_copy",
  "function_symbol": "matrix_copy",
  "description": "Create an independent matrix copy preserving all values and dimensions.",
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[rows, columns, row-major matrix elements]",
    "dimension_range": [
      0,
      32
    ],
    "element_range": [
      -2147483648,
      2147483647
    ],
    "exact_packed_length": "2 + rows*columns",
    "empty_matrix_behavior": "if rows or columns is zero, Copy returns a zero matrix with shape [0,0]",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_64_bit_integer_array",
    "encoding": "[result_rows, result_columns, row-major copied elements]",
    "return_value": "output byte length",
    "maximum_output_bytes": 8208
  },
