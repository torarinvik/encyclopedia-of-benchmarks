{
  "schema_version": 1,
  "id": "merge-two-binary-trees-heap-slots-v1",
  "algorithm": "merge_two_binary_trees",
  "function_symbol": "merge_two_binary_trees",
  "input": {
    "kind": "two_heap_indexed_tree_slot_arrays",
    "maximum_tree_slots": 255,
    "maximum_input_length": 512,
    "value_range": [-100000, 100000],
    "null_slot": -1000001,
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2,
    "output": "signed 32-bit little-endian heap slots through the final nonempty node; return value is merged node count"
  },
  "cases": [
    {"id": "both_empty", "input_values": [0, 0], "input_length": 2, "expected_result": 0},
    {"id": "left_only_root", "input_values": [1, 8, 0], "input_length": 3, "expected_result": 1},
    {"id": "right_only_root", "input_values": [0, 1, 5], "input_length": 3, "expected_result": 1},
    {"id": "overlapping_roots", "input_values": [1, 2, 1, 3], "input_length": 4, "expected_result": 1},
    {"id": "overlapping_and_disjoint_children", "input_values": [3, 1, 3, -1000001, 3, 3, -1000001, 2], "input_length": 8, "expected_result": 3},
    {"id": "sparse_tree_positions", "input_values": [7, 1, 2, 3, 4, -1000001, -1000001, 7, 7, 10, -1000001, 30, -1000001, -1000001, -1000001, 60], "input_length": 16, "expected_result": 5},
    {"id": "overlap_cancels_to_zero", "input_values": [1, 7, 1, -7], "input_length": 4, "expected_result": 1},
    {"id": "negative_values", "input_values": [3, -8, -3, 4, 3, 5, -1, 9], "input_length": 8, "expected_result": 3},
    {"id": "all_slots_missing", "input_values": [3, -1000001, -1000001, -1000001, 0], "input_length": 5, "expected_result": 0},
    {"id": "trim_trailing_null_slots", "input_values": [4, 1, 2, -1000001, -1000001, 0], "input_length": 6, "expected_result": 2},
    {"id": "maximum_value_sum", "input_values": [1, 100000, 1, 100000], "input_length": 4, "expected_result": 1},
    {"id": "invalid_value", "input_values": [1, 100001, 0], "input_length": 3, "expected_result": -1},
    {"id": "child_after_missing_parent", "input_values": [4, 1, -1000001, -1000001, 2, 0], "input_length": 6, "expected_result": -1},
    {"id": "too_many_slots", "input_values": [256, 0], "input_length": 2, "expected_result": -1},
    {"id": "inconsistent_packed_lengths", "input_values": [1, 5, 0, 99], "input_length": 4, "expected_result": -1}
  ],
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 15,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  }
