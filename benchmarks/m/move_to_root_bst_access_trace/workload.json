{
  "schema_version": 1,
  "id": "move-to-root-bst-access-trace-i64-array-scalar-v1",
  "algorithm": "move_to_root_bst_access_trace",
  "function_symbol": "move_to_root_bst_access_trace",
  "abi": "i64_array_scalar",
  "description": "A static insertion-built BST processes searches by rotating each found node upward one parent edge at a time.",
  "source": {
    "title": "Self-Organizing Binary Search Trees",
    "authors": [
      "Brian Allen",
      "J. Ian Munro"
    ],
    "url": "https://doi.org/10.1145/322092.322094",
    "license": "Algorithm described in scholarly source; clean-room implementation",
    "algorithm_attribution": "Move-to-root access rule: after a successful BST access, repeatedly rotate the accessed node with its parent until it becomes root.",
    "independent_reference_sources": [
      {
        "title": "Self-Adjusting Binary Search Trees",
        "url": "https://www.cs.princeton.edu/courses/archive/spr06/cos423/Handouts/self%20adjusting.pdf"
      }
    ],
    "discovery_source": "https://xlinux.nist.gov/dads/termsType.html",
    "discovery_use": "Title index only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,initial_keys[N],Q,access_keys[Q]]",
    "initial_key_count_range": [
      0,
      16
    ],
    "access_count_range": [
      0,
      32
    ],
    "key_range": [
      -100,
      100
    ],
    "initial_keys_must_be_unique": true,
    "maximum_valid_length": 50,
    "maximum_parseable_length": 51,
    "null_input_result": -1,
    "malformed_input_result": -1
  },
  "operations": {
    "initial_tree": "Insert the initial keys in their supplied order into an ordinary BST.",
    "access": "Search from the current root. Count each visited node. On a hit, move the node to the root by repeated single rotations with its current parent. On a miss, leave the tree unchanged."
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "sum((one-based_access_number)*(nodes_visited_for_access))",
    "valid_result_range": [
      0,
      8448
    ],
    "malformed_input_result": -1
  },
  "workspace": {
    "bytes": 4096,
    "meaning": "At most 16 parent/left/right/key records and bounded access-trace state."
  },
  "complexity": {
    "primary_time": "O(N^2 + Q*N) worst case, including ordinary insertion, search, and rotations",
    "primary_auxiliary_space": "O(N)",
    "independent_reference_time": "O(N^2 + Q*N) worst case",
    "independent_reference_space": "O(N)"
  },
  "oracle_method": "The primary stores the BST in integer-indexed parent/left/right arrays. The independent reference stores linked node objects and performs explicit parent rotations.",
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 8,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100
  },
