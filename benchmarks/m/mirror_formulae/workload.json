{
  "schema_version": 1,
  "id": "mirror-formulae-float64-triple-v1",
  "algorithm": "mirror_formulae",
  "function_symbol": "mirror_formulae",
  "input": {
    "kind": "mirror_equation_mode_and_distances",
    "layout": [
      "distance_a",
      "distance_b",
      "operation_code"
    ],
    "operation_codes": {
      "0": "focal_length(distance_of_object, distance_of_image)",
      "1": "object_distance(focal_length, distance_of_image)",
      "2": "image_distance(focal_length, distance_of_object)"
    },
    "distance_domain": "finite, nonzero, with absolute value in [1e-6, 1e6]",
    "invalid_result": -1e+300,
    "singular_denominator_result": -1e+300,
    "formulae": [
      "1 / ((1 / distance_of_object) + (1 / distance_of_image))",
      "1 / ((1 / focal_length) - (1 / distance_of_image))",
      "1 / ((1 / focal_length) - (1 / distance_of_object))"
    ],
    "absolute_tolerance": 1e-12,
    "relative_tolerance": 1e-12
  },
  "measurement": {
    "comparison_model": "float64_triple_call",
    "sample_count": 5,
    "warmup_rounds": 2,
    "repetitions_per_sample": 100000
  },
  "cases": [
    {
      "id": "focal_length_source_10_20",
