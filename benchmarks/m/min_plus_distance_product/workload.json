{
  "schema_version": 1,
  "id": "chapter-12-min-plus-distance-product-i64-array-bytes-v1",
  "algorithm": "min_plus_distance_product",
  "function_symbol": "min_plus_distance_product",
  "comparison_model": "i64_array_bytes_output_call",
  "source": {
    "chapter": "All Pairs Shortest Paths via Matrix Multiplication",
    "doi": "10.1007/978-1-4939-2864-4_12",
    "author": "Tadao Takaoka",
    "scope": "One distance-matrix product operation; the fast Romani encoding, Zwick bridging-set APSP scheme, and witness recovery are excluded."
  },
  "contract": {
    "operation": "For A[n,m] and B[m,n], compute C[i,j]=min_k(A[i,k]+B[k,j]) with INF propagation.",
    "input_layout": "[n,m,A row-major,B row-major]",
    "infinity_sentinel": 1000000,
    "entry_domain": "integer 0..1000 or infinity sentinel",
    "output_layout": "n*n row-major signed 64-bit entries, little-endian",
    "error_precedence": "Malformed input returns -1 before output checks; valid input with null output or insufficient capacity returns -2 without writes."
  },
  "input": {"kind":"signed_64_bit_integer_array","maximum_valid_length":130,"maximum_parseable_length":131,"dimension_range":[1,8],"entry_domain":[0,1000,"INF=1000000"],"invalid_result":-1,"null_input_result":-1},
  "output": {"kind":"little_endian_signed_64_bit_array","maximum_output_elements":64,"maximum_output_bytes":512,"success_result":"8*n*n bytes","invalid_result":-1,"null_output_result":-2,"insufficient_capacity_result":-2,"no_write_on_error":true},
  "workspace": {"bytes":1024,"meaning":"Bounded input and staged result for at most 8x8 output and 8-way reductions."},
  "measurement": {"sample_count":5,"warmup_rounds":1,"repetitions_per_sample":100},
  "cases": [
    {"id":"square-two-by-two","input_values":[2,2,0,3,5,0,0,4,2,0],"input_length":10,"expected_result":32,"expected_output_hex":"0000000000000000030000000000000002000000000000000000000000000000"},
    {"id":"rectangular-with-infinity","input_values":[2,3,2,1000000,7,4,1,1000000,5,2,1,8,3,0],"input_length":14,"expected_result":32,"expected_output_hex":"0700000000000000040000000000000002000000000000000600000000000000"},
    {"id":"all-paths-infinite","input_values":[1,2,1000000,1000000,0,1000000],"input_length":6,"expected_result":8,"expected_output_hex":"40420f0000000000"},
    {"id":"negative-entry","input_values":[1,1,-1,0],"input_length":4,"expected_result":-1,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[1,1,2,3],"input_length":4,"output_capacity":7,"expected_result":-2,"expected_output_hex":""}
  ]
}
