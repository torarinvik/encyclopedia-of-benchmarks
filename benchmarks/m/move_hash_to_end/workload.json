{
  "schema_version": 1,
  "id": "move-hash-to-end-java-stable-ascii-bytes-v1",
  "algorithm": "move_hash_to_end",
  "function_symbol": "move_hash_to_end",
  "input": {
    "kind": "signed_i64_array",
    "encoding": "[length, ASCII code values...]",
    "text_length_range": [
      0,
      256
    ],
    "byte_range": [
      0,
      127
    ],
    "exact_length": "1 + length",
    "maximum_valid_array_length": 257,
    "maximum_parseable_array_length": 258,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_string",
    "meaning": "all non-# bytes in input order followed by the original count of # bytes",
    "length": "same as input text",
    "successful_result": "number of output bytes written",
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "workspace": {
    "bytes": 256,
    "meaning": "maximum transformed string capacity"
  },
  "source_bound": {
    "description": "Stable partition of # to the end; null Java input is outside the packed ABI.",
    "benchmark_domain": "ASCII codes 0..127 including NUL as an explicit byte; text length 0..256."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
  "cases": [
    {
      "id": "pinned-source-example",
      "input_values": [
        9,
        104,
        35,
        101,
        35,
        108,
        35,
        108,
        108,
        111
      ],
      "input_length": 10,
      "expected_result": 9,
      "expected_output_hex": "68656c6c6c6f232323"
    },
    {
      "id": "no-hashes",
      "input_values": [
        6,
        115,
        116,
        97,
        98,
        108,
        101
      ],
      "input_length": 7,
      "expected_result": 6,
      "expected_output_hex": "737461626c65"
    },
    {
      "id": "all-hashes",
      "input_values": [
        4,
        35,
        35,
        35,
        35
      ],
      "input_length": 5,
      "expected_result": 4,
      "expected_output_hex": "23232323"
    },
    {
      "id": "empty-string",
      "input_values": [
        0
      ],
      "input_length": 1,
      "expected_result": 0,
      "expected_output_hex": ""
    },
    {
      "id": "embedded-nul",
      "input_values": [
        4,
        65,
        0,
        35,
        66
      ],
      "input_length": 5,
      "expected_result": 4,
      "expected_output_hex": "41004223"
    },
    {
      "id": "repeated-hashes-between-letters",
      "input_values": [
        9,
        97,
        35,
        35,
        35,
        98,
        98,
        35,
        35,
        99
      ],
      "input_length": 10,
      "expected_result": 9,
      "expected_output_hex": "616262632323232323"
    },
    {
      "id": "invalid-length-missing-payload",
      "input_values": [
        1
      ],
      "input_length": 1,
      "expected_result": -1,
      "expected_output_hex": ""
