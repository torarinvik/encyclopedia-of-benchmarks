{
  "schema_version": 1,
  "id": "encyclopedia-metric-tsp-christofides-i64-array-bytes-output-v1",
  "algorithm": "metric_tsp_christofides",
  "function_symbol": "metric_tsp_christofides",
  "abi": "i64_array_bytes_output",
  "description": "Christofides 3/2 approximation using an MST, exact odd-vertex minimum matching, Euler tour, and shortcutting.",
  "source": {
    "title": "Metric TSP",
    "authors": ["Markus Bläser"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_230, Algorithm 2",
    "url": "https://doi.org/10.1007/978-1-4939-2864-4_230",
    "implementation_status": "clean-room; chapter used as algorithm reference only"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n, row-major complete distance matrix]",
    "n_range": [1, 8],
    "distance_range": [0, 10000],
    "distance_constraints": "zero diagonal, symmetry, triangle inequality",
    "maximum_valid_length": 65,
    "maximum_parseable_length": 65,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[tour_cost, vertex_0, ..., vertex_(n-1), vertex_0]",
    "maximum_bytes": 80,
    "success_result": "8 * (n + 2) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {"bytes": 8192, "meaning": "Fixed 8-vertex distance/MST/multigraph arrays and subset-DP table for at most 8 odd vertices."},
  "contract": {
    "mst_tie_rule": "Kruskal order by weight, then lower endpoint, then upper endpoint.",
    "matching_tie_rule": "Lexicographically smallest sorted pair sequence among minimum-cost perfect matchings.",
    "euler_rule": "Start at vertex 0; Hierholzer consumes the least-ID available neighbor; shortcut to each vertex's first occurrence.",
    "error_precedence": "Validate the complete metric before checking null output or capacity.",
    "no_write_on_error": true
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 2, "repetitions_per_sample": 100},
  "cases": [
    {"id":"single-vertex","input_values":[1,0],"input_length":2,"output_capacity":24,"expected_result":24,"expected_output_hex":"000000000000000000000000000000000000000000000000"},
    {"id":"two-point-double-tree-edge","input_values":[2,0,3,3,0],"input_length":5,"output_capacity":32,"expected_result":32,"expected_output_hex":"0600000000000000000000000000000001000000000000000000000000000000"},
    {"id":"equilateral-three-vertex-matching","input_values":[3,0,1,1,1,0,1,1,1,0],"input_length":10,"output_capacity":40,"expected_result":40,"expected_output_hex":"03000000000000000000000000000000010000000000000002000000000000000000000000000000"},
    {"id":"star-metric-four-odd-vertices","input_values":[4,0,1,1,1,1,0,2,2,1,2,0,2,1,2,2,0],"input_length":17,"output_capacity":48,"expected_result":48,"expected_output_hex":"060000000000000000000000000000000100000000000000020000000000000003000000000000000000000000000000"},
    {"id":"line-metric-four-vertices","input_values":[4,0,1,2,3,1,0,1,2,2,1,0,1,3,2,1,0],"input_length":17,"output_capacity":48,"expected_result":48,"expected_output_hex":"060000000000000000000000000000000100000000000000020000000000000003000000000000000000000000000000"},
    {"id":"triangle-inequality-violation","input_values":[3,0,1,3,1,0,1,3,1,0],"input_length":10,"output_capacity":80,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-input","input_values":[],"input_length":1,"input_is_null":true,"output_capacity":80,"expected_result":-1,"expected_output_hex":""},
    {"id":"null-output","input_values":[2,0,3,3,0],"input_length":5,"output_capacity":32,"output_is_null":true,"expected_result":-2,"expected_output_hex":""},
    {"id":"short-output-capacity","input_values":[2,0,3,3,0],"input_length":5,"output_capacity":31,"expected_result":-2,"expected_output_hex":""}
  ]
