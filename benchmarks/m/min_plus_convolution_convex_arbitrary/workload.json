  "contract": {
    "operation": "For convex a and arbitrary b, c[k]=min over i+j=k of a[i]+b[j].",
    "input_layout": "[N,M,a[0..N),b[0..M)]",
    "convexity": "a[i+1]-a[i] <= a[i+2]-a[i+1] for every valid i.",
    "tie_rule": "The internal leftmost minimizing b index is selected; output values are unaffected by ties.",
    "algorithm": "Monotone divide-and-conquer over output indices with monotone minimizing-index bounds; verifier scans each valid pair directly.",
    "entry_domain": "Integers in [0,1000000000].",
    "output_layout": "N+M-1 little-endian signed 64-bit integers.",
    "error_precedence": "Malformed frames, values, or convexity return -1 before null/capacity checks. Valid input with null output or insufficient capacity returns -2 with no writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[N,M,a[0..N),b[0..M)]",
    "n_range": [
