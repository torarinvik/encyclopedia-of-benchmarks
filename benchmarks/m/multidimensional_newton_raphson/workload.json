    "algorithm_reference_title": "A normalized multidimensional Newton-Raphson method",
    "author": "C. F. Chen and N. R. Strader",
    "pinned_behavior": "Apply exactly the specified number of ordinary coupled Newton steps using the Jacobian of F1=x*x+y-3 and F2=x+y*y-3."
  },
  "contract": {
    "definition": "Compute the final coordinate pair after exactly updates binary64 Newton-Raphson iterations for the pinned simultaneous-equation system.",
    "input_encoding": "[x0_milli,y0_milli,updates]",
    "coordinate_range": "Both initial coordinate words are integers in 900..1500 inclusive and denote values divided by 1000.",
    "update_range": "1..8 inclusive; perform exactly this many steps without a convergence test.",
    "system": ["F1=x*x+y-3", "F2=x+y*y-3"],
    "jacobian": "[[2*x,1],[1,2*y]]; solve J*[dx,dy]=[F1,F2], then subtract the correction.",
    "output_encoding": "Two signed i64 words [round_1e9(x),round_1e9(y)] serialized little-endian; ties away from zero.",
    "invalid_input_result": -1,
    "output_error_result": -2,
    "output_untouched_on_error": true,
    "input_validation_precedes_output_validation": true
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[x0_milli,y0_milli,updates]",
    "coordinate_milli_range": [900, 1500],
    "updates_range": [1, 8],
    "maximum_valid_length": 3,
    "maximum_parseable_length": 4,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_word_array",
    "encoding": "[round_1e9(x),round_1e9(y)]",
    "word_count": 2,
    "maximum_bytes": 16,
    "success_result": "number of output bytes, always 16",
    "invalid_input_result": -1,
    "null_or_short_output_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {
    "bytes": 128,
    "meaning": "Native ports use only fixed scalar binary64 state, integer counters, and byte-packing temporaries. Caller-owned input/output buffers are excluded."
  },
  "complexity": {
    "time": "O(updates), with a constant-size 2x2 Jacobian solve per step",
    "scratch_space": "O(1), bounded by 128 bytes"
  },
