{
  "id": "maximum-frequency-after-increments-v1",
  "algorithm": "maximum_frequency_after_increments",
  "contract": {
    "input": "A nonnegative increment budget followed by 0 to 256 positive integer values. Budget range 0..1,000,000; value range 1..10,000.",
    "output": "The largest number of equal values achievable by incrementing elements with total increments no greater than the budget.",
