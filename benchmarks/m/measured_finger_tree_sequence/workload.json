{
  "schema_version": 1,
  "id": "measured-finger-tree-persistent-sequence-v1",
  "algorithm": "measured_finger_tree_sequence",
  "function_symbol": "measured_finger_tree_sequence",
  "abi": "i64_array_bytes_output",
  "source": {
    "title": "Finger trees: a simple general-purpose data structure",
    "url": "https://oi-wiki.org/ds/finger-tree/",
    "paper": "https://www.staff.city.ac.uk/~ross/papers/FingerTree.html",
    "doi": "10.1017/S0956796805005769",
    "license": "OI Wiki page CC BY-SA 4.0 (page also lists SATA); paper used as a method citation only",
    "scope": "Clean-room bounded persistent measured finger-tree operations; no upstream implementation text or code is copied."
  },
  "contract": {
    "input_layout": "[n0,initial_values...,Q,(tag,a,b,x,y)*Q]",
    "operation_tags": {
      "0": "push left: (root,-1,value,-1)",
      "1": "push right: (root,-1,value,-1)",
      "2": "pop left: (root,-1,-1,-1)",
      "3": "pop right: (root,-1,-1,-1)",
      "4": "concatenate: (left_root,right_root,-1,-1)",
      "5": "split before index: (root,-1,index,-1)",
      "6": "split after first prefix sum reaching positive threshold: (root,-1,threshold,-1)"
    },
    "initial_length_range": [0,32],
    "operation_count_range": [1,32],
    "value_range": [0,1000000],
    "max_sequence_length": 64,
    "max_sequence_sum": 64000000,
    "root_lifetime": "All root IDs remain valid; root 0 is the initial sequence and each operation allocates one ID, or two for split.",
    "measure": "Monoid (length,sum) with componentwise addition; nonnegative values make prefix-sum search monotone.",
    "split_absent_threshold": "Split at sequence end, return the original sequence and empty sequence, auxiliary value -1.",
    "output": "Seven little-endian signed i64 words per operation: (left_root,left_length,left_sum,right_root,right_length,right_sum,aux). Single-result operations write -1 in the right triple.",
    "auxiliary": "Pops return the removed value; index split returns the index; sum split returns the prefix length if found and -1 otherwise; other operations return -1.",
    "malformed": "Invalid op/root/sentinel/range, pop-empty, sequence length/sum overflow, malformed frame, or null input returns -1 before output-capacity handling.",
    "output_error": "Valid null output or insufficient capacity returns -2 without writes."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "maximum_valid_length": 194,
    "maximum_parseable_length": 195,
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_i64_records",
    "record_words": 7,
    "maximum_bytes": 1792,
    "success_bytes_per_operation": 56,
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 1048576,
    "meaning": "Fixed 16384-object immutable finger-tree/node arena plus root metadata, parsing scratch, operation records, and staged 1792-byte output. Ports fail before output if the arena bound is reached."
  },
  "oracle": "benchmarks/m/measured_finger_tree_sequence/oracle.py",
  "independent_oracle": "benchmarks/m/measured_finger_tree_sequence/independent_oracle.py",
  "measurement": {"comparison_model":"i64_array_bytes_output_call","sample_count":5,"warmup_rounds":1,"repetitions_per_sample":100},
