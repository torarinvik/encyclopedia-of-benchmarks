  "input": {
    "kind": "signed_i64_array_with_i32_min_max_heap_trace",
    "layout": "[initial_count, initial_values..., operation_count, (opcode, argument)...]",
    "initial_count_range": [
      0,
      64
    ],
    "initial_value_range": [
      -2147483648,
      2147483647
    ],
    "operation_count_range": [
      0,
      128
    ],
    "operation_pair_layout": "Each operation is exactly two signed i64 values. The argument must be zero for opcodes 1 through 5.",
    "opcodes": {
      "0": "Add(argument); no event result",
      "1": "GetMin(); emits the minimum value",
      "2": "GetMax(); emits the maximum value",
      "3": "ExtractMin(); emits and removes the minimum value",
      "4": "ExtractMax(); emits and removes the maximum value",
      "5": "Count; emits the current count, including zero"
    },
    "add_value_range": [
      -2147483648,
      2147483647
    ],
    "empty_get_or_extract": "invalid",
    "duplicates": "Retained as separate values.",
    "exact_length": "initial_count + 2 + 2 * operation_count",
    "maximum_input_length": 322,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "output": {
    "kind": "little_endian_signed_i64_vector",
    "layout": "[event_count, event_results..., final_count, final_values_sorted_ascending...]",
    "event_results": "Results from GetMin, GetMax, ExtractMin, ExtractMax, and Count in operation order. Add emits no result.",
    "final_values": "The final heap contents in ascending order, retaining duplicates.",
    "return_value": "number of output bytes written",
    "maximum_output_bytes": 2576,
    "invalid_input_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "measurement": {
