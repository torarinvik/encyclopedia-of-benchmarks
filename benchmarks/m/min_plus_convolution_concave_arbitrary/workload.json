  "contract": {
    "operation": "For concave a and arbitrary b, c[k]=min over i+j=k of a[i]+b[j].",
    "input_layout": "[N,M,a[0..N),b[0..M)]",
    "concavity": "a[i+1]-a[i] >= a[i+2]-a[i+1] for every valid i.",
    "entry_domain": "Integers in [0,1000000000].",
    "algorithm": "Partition the feasible output/index staircase into rectangles; use reversed-coordinate monotone minima on fully feasible blocks and direct scanning or boundary-aligned subdivision otherwise.",
    "small_rectangle_product_threshold": 1000,
    "output_layout": "N+M-1 little-endian signed 64-bit integers.",
    "error_precedence": "Malformed frames, values, or concavity return -1 before output checks. Valid input with null output or insufficient capacity returns -2 without writes."
  },
