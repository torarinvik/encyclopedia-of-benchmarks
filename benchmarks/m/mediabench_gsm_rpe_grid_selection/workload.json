  "algorithm": "mediabench_gsm_rpe_grid_selection",
  "function_symbol": "mediabench_gsm_rpe_grid_selection",
  "description": "Select the highest-energy one-of-four RPE sample grid and return its 13 samples.",
  "pinned_source": {
    "repository": "lac-dcc/Benchmarks",
    "commit": "5d7b75df749241efa7a6e6f5be613d3fcc5cce38",
