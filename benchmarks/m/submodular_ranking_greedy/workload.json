  "abi": "i64_array_bytes_output",
  "description": "Submodular-ranking greedy selection using normalized explicit submodular tables.",
  "source": {
    "title": "Min-Sum Set Cover and Its Generalizations",
    "authors": ["Sungjin Im"],
    "year": 2016,
    "reference": "Encyclopedia of Algorithms, DOI 10.1007/978-1-4939-2864-4_806",
