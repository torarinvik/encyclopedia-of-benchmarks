  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,m, f0[mask=0..2^n-1], ..., f(m-1)[mask=0..2^n-1]]; each table value is 8*f(A)",
    "n_range": [1, 5],
    "m_range": [1, 4],
    "table_value_range": [0, 8],
    "table_conditions": ["f(empty)=0", "f(full)=1", "monotone", "submodular"],
    "maximum_valid_length": 130,
    "maximum_parseable_length": 131,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "little_endian_signed_64_bit_array",
    "encoding": "[sum_of_first_completion_times, zero_based_element_order[n], first_completion_times[m]]",
    "maximum_bytes": 80,
    "success_result": "8*(1+n+m) bytes written",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "workspace": {"bytes": 4096, "meaning": "Four tables of at most 32 values, subset/selection state, exact score accumulators, and staged output."},
  "contract": {
    "selection": "At each step choose the unscheduled element maximizing sum_i (f_i(A union {e})-f_i(A))/(1-f_i(A)); omit i where f_i(A)=1.",
    "tie_rule": "Lowest zero-based element ID.",
    "score_arithmetic": "Exact rational comparison; input table values represent multiples of 1/8.",
    "completion_time": "First one-based prefix time at which f_i(A)=1.",
    "invalid_input_result": -1,
    "output_error_result": -2
  },
  "measurement": {"comparison_model": "i64_array_bytes_output_call", "sample_count": 8, "warmup_rounds": 2, "repetitions_per_sample": 100},
