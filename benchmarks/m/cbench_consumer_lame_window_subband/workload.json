    "coefficient_decode": "binary64(raw_i64 / 1e9)",
    "output": "32 signed i64 Q1000 values, little-endian, in band order",
    "projection": "round abs(value*1000) to nearest integer with ties away from zero, then restore sign",
    "invalid_result": -1,
    "output_error_result": -2,
    "success_result": 256,
    "no_write_on_error": true
  },
