  },
  "contract": {
    "operation": "Build a reference suffix trie over A/C/G/T suffixes with a terminal marker, then find every pair of substrings that is an exact match of at least min_match_length and is maximal on both the left and right.",
    "input_layout": "[reference_length, query_length, min_match_length, reference_codes..., query_codes...]",
    "base_encoding": {"A": 0, "C": 1, "G": 2, "T": 3},
    "reference_length_range": [1, 32],
    "query_length_range": [1, 32],
    "min_match_length_range": [1, 32],
    "min_match_length_rule": "Inclusive, matching MUMmerGPU's user-facing minimum length; thresholds longer than either sequence are valid and produce no matches.",
    "exact_input_length": "3 + reference_length + query_length",
    "maximum_input_length": 67,
    "maximality": "A match is left-maximal when either start is at sequence position 1 or the preceding reference and query bases differ; it is right-maximal when either match reaches its sequence end or the following bases differ.",
    "output_order": "Query start ascending; within each query start, reference suffixes in A,C,G,T,$ lexicographic suffix-tree traversal order.",
    "output_record": "Three signed 64-bit little-endian values: 1-based reference start, 1-based query start, and match length.",
    "maximum_matches": 1024,
    "maximum_output_bytes": 24576,
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
  "input": {
    "kind": "signed_i64_array",
    "maximum_length": 67,
    "encoding": "sequence lengths, inclusive minimum match length, then explicit A/C/G/T code vectors",
    "invalid_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "ordered (reference_start_1based, query_start_1based, match_length) i64 little-endian records",
    "maximum_bytes": 24576,
    "success_result": "24*number_of_matches; zero when no matches qualify",
    "null_or_short_output_result": -2
  },
  "workspace": {"bytes": 24576},
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
