{
  "schema_version": 1,
  "id": "midpoint-ellipse-v1",
  "algorithm": "midpoint_ellipse",
  "function_symbol": "midpoint_ellipse",
  "input": {
    "kind": "i64_center_x_center_y_semiaxes",
    "encoding": "Center coordinates, horizontal semi-axis a, and vertical semi-axis b.",
    "maximum_values": 4,
    "center_coordinate_range": [
      -10000,
      10000
    ],
    "axis_range": [
      0,
      100
    ],
    "result": "Return point count and write ordered x,y pairs as little-endian signed i32 values, preserving generated symmetry duplicates.",
    "invalid_result": -1,
    "insufficient_output_capacity_result": -2
  },
  "cases": [
    {
      "id": "point_ellipse",
      "input_values": [
        2,
        -1,
        0,
        0
      ],
      "input_length": 4,
      "expected_result": 1,
      "expected_output_hex": "02000000ffffffff"
    },
    {
      "id": "vertical_degenerate_axis",
      "input_values": [
        3,
        0,
        0,
        3
      ],
      "input_length": 4,
      "expected_result": 7,
      "expected_output_hex": "03000000fdffffff03000000feffffff03000000ffffffff0300000000000000030000000100000003000000020000000300000003000000"
    },
    {
      "id": "horizontal_degenerate_axis",
      "input_values": [
        -1,
        2,
        2,
        0
      ],
      "input_length": 4,
      "expected_result": 5,
      "expected_output_hex": "fdffffff02000000feffffff02000000ffffffff0200000000000000020000000100000002000000"
    },
    {
      "id": "unit_axes_symmetry_duplicates",
      "input_values": [
        0,
        0,
        1,
        1
      ],
      "input_length": 4,
      "expected_result": 8,
      "expected_output_hex": "0000000001000000000000000100000000000000ffffffff00000000ffffffff0100000000000000ffffffff000000000100000000000000ffffffff00000000"
    },
    {
      "id": "wide_ellipse_region_steps",
      "input_values": [
        0,
        0,
        5,
        2
      ],
      "input_length": 4,
      "expected_result": 24,
      "expected_output_hex": ""
    },
    {
      "id": "tall_ellipse_region_steps",
      "input_values": [
        0,
        0,
        2,
        5
      ],
      "input_length": 4,
      "expected_result": 24,
      "expected_output_hex": ""
    },
    {
      "id": "translated_ellipse",
      "input_values": [
        3,
        -2,
        4,
        3
      ],
      "input_length": 4,
      "expected_result": 24,
      "expected_output_hex": ""
    },
    {
      "id": "negative_axis",
      "input_values": [
        0,
        0,
        -1,
        2
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "axis_out_of_range",
      "input_values": [
        0,
        0,
        101,
        2
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "center_out_of_range",
      "input_values": [
        10001,
        0,
        1,
        1
      ],
      "input_length": 4,
      "expected_result": -1,
      "expected_output_hex": ""
    },
    {
      "id": "wrong_input_length",
      "input_values": [
        0,
        0,
        1
      ],
      "input_length": 3,
      "expected_result": -1,
      "expected_output_hex": ""
    }
  ]
}
