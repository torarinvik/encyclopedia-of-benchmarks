  "contract": {
    "operation": "Initialize Blowfish with one of the two published bftest keys, then apply one ECB block encryption or decryption.",
    "source_configuration": {
      "block_bytes": 8,
      "key_strings": [
        "abcdefghijklmnopqrstuvwxyz",
        "Who is John Galt?"
      ],
      "direction_encoding": {
        "0": "encrypt",
        "1": "decrypt"
      },
      "block_byte_order": "big-endian, as in BF_ecb_encrypt"
    },
    "source_wrapper": "The bftest source checks BF_encrypt ECB vectors; BF_ecb_encrypt uses the same two-word block primitive with big-endian bytes. Launcher file handling and its CBC/CFB/OFB stages are excluded.",
    "input_layout": "[direction, key_selector, 8 block bytes]",
    "maximum_input_length": 10,
    "output_encoding": "8 raw Blowfish block bytes, big-endian",
    "output_bytes": 8,
    "invalid_result": -1,
    "output_error_result": -2,
    "errors": "Malformed input, selector, direction, or byte values return -1 before output checks. Null output or capacity below 8 returns -2 without writes."
  },
  "input": {
    "kind": "signed_i64_array_of_bytes",
    "encoding": "direction (0 encrypt, 1 decrypt), key selector (0 or 1), then 8 big-endian block bytes",
    "exact_length": 10,
    "maximum_input_length": 10,
    "valid_value_range": [
      0,
      255
    ],
    "invalid_input_result": -1,
    "null_input_result": -1
  },
  "output": {
    "kind": "byte_array",
    "encoding": "one raw 8-byte Blowfish result block in big-endian byte order",
    "maximum_bytes": 8,
    "success_result": "Bytes written, exactly 8",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "no_write_on_error": true
  },
  "workspace": {
    "bytes": 8,
    "meaning": "One output block."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
