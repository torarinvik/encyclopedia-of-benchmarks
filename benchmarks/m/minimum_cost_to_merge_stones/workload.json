    "url": "https://leetcode.com/problems/minimum-cost-to-merge-stones/",
    "license": "Problem definition cited; clean-room algorithm descriptions and implementations",
    "algorithm_attribution": "Use interval DP whose state records how many piles remain in the interval; the independent reference uses the pile-count residue implied by k-ary merges.",
    "implementation_status": "Bounded clean-room LeetCode 1000-style profile"
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,k,stones_0,...,stones_(n-1)]",
    "n_range": [1, 30],
    "merge_arity_range": [2, 30],
    "stone_weight_range": [1, 100],
    "exact_framing": true,
