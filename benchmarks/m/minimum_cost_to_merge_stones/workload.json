    "result_range": [-1, 87000],
    "invalid_input_result": -1,
    "impossible_result": -1
  },
  "contract": {
    "feasibility": "Each merge reduces the pile count by k-1, so one final pile is possible only when (n-1) mod (k-1) is zero.",
    "primary": "dp[left][right][piles] is the minimum cost to reduce a contiguous interval to exactly piles remaining piles. For piles>=2, split it into a left interval reduced to one pile and a right interval reduced to piles-1. For one pile, first reach k piles and pay the interval sum.",
    "independent_reference": "A two-dimensional interval state stores the minimum cost to reach the residue-determined minimum pile count; split positions advance by k-1, and interval weight is added exactly when a single pile is reachable.",
    "complexity": "Primary O(n^3*k) time and O(n^2*k) space; independent O(n^3) time and O(n^2) space."
  },
  "workspace": {
    "bytes": 262144,
    "meaning": "Fixed maximum storage for a 30 by 30 by 31 signed-64-bit pile-count DP table plus local state."
  },
