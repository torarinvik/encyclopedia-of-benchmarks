  "contract": {
    "input_layout": "[node_count, node_values..., probe_count, probe_values...]",
    "node_count_range": [1, 64],
    "probe_count": 100,
    "value_range": [-32768, 32767],
    "sentinel_value": 0,
    "sentinel_handling": "The source uses zero to terminate each stdin list. The structured contract omits sentinels and rejects zero in node and probe values.",
    "tree": "Insert values in supplied order into a sorted binary tree. Duplicate keys leave the existing tree unchanged, as in insertSortedBinaryTree.",
    "summary": "Return tree size, recursive value sum, and arithmetic mean. The profile requires at least one input value so the source mean is defined.",
    "membership": "Run 100 independent generic recursive depth-first searches, visiting left before right after a miss. This matches the active memberOfBinaryTree call; the key-directed memberOfSortedBinaryTree call is commented out in the launcher.",
    "output_layout": "4-byte unsigned tree size little-endian, 8-byte IEEE-754 sum little-endian, 8-byte IEEE-754 mean little-endian, then a 13-byte membership bitmap (probe i is bit i modulo 8 of byte floor(i/8)).",
    "invalid_result": -1,
    "output_error_result": -2,
    "no_write_on_error": true
  },
