{
  "schema_version": 1,
  "id": "mean-absolute-error-rust-integer-pairs-v1",
  "algorithm": "mean_absolute_error_loss",
  "function_symbol": "mean_absolute_error_loss",
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[count, predicted..., actual...]",
    "pair_count_range": [
      1,
      256
    ],
    "value_range": [
      -1000000,
      1000000
    ],
    "invalid_result": -1e+300
  },
  "output": {
    "kind": "binary64",
    "definition": "mean absolute difference between paired predicted and actual values",
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12,
    "invalid_result": -1e+300
  },
  "measurement": {
    "comparison_model": "i64_array_float64_call",
    "sample_count": 16,
    "warmup_rounds": 2,
    "repetitions_per_sample": 1000,
    "relative_tolerance": 1e-12,
    "absolute_tolerance": 1e-12
  },
