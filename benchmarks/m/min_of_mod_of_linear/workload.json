    {"id": "small_sequence_contains_zero", "input_values": [5, 7, 3, 4], "input_length": 4, "expected_result": 0},
    {"id": "non_coprime_slope", "input_values": [20, 10, 6, 3], "input_length": 4, "expected_result": 1},
