{
  "schema_version": 1,
  "id": "myrvold-ruskey-permutation-unrank-i64-array-bytes-output-v1",
  "algorithm": "myrvold_ruskey_permutation_unrank",
  "function_symbol": "myrvold_ruskey_permutation_unrank",
  "abi": "i64_array_bytes_output",
  "description": "Unrank a permutation in the Myrvold–Ruskey mixed-radix Fisher–Yates order using linear-time successive swaps.",
  "source": {
    "title": "Ranking and Unranking Permutations in Linear Time",
    "authors": ["Wendy Myrvold", "Frank Ruskey"],
    "reference": "Information Processing Letters 79 (2001), 281–284, Algorithm 1",
    "doi": "10.1016/S0020-0190(01)00141-7",
    "url": "https://doi.org/10.1016/S0020-0190(01)00141-7",
    "author_pdf": "https://webhome.cs.uvic.ca/~ruskey/Publications/RankPerm/MyrvoldRuskey.pdf",
    "discovery_url": "https://xlinux.nist.gov/dads/HTML/unrank.html",
    "pinned_behavior": "Start with the identity permutation. For size n down to 1, swap positions size-1 and rank mod size, then replace rank with floor(rank/size). This is the paper's first unranking procedure and its induced order is not lexicographic."
  },
  "input": {
    "kind": "signed_64_bit_integer_array",
    "encoding": "[n,rank]",
    "n_range": [0, 8],
    "rank_rule": "0 <= rank < n!; when n=0 the only valid rank is 0",
    "maximum_valid_length": 2,
    "maximum_parseable_length": 3,
    "invalid_input_result": -1,
    "validation_order": "Reject null input, malformed length, non-i64 framing, out-of-profile n, and rank outside [0,n!) before checking the output pointer/capacity."
  },
  "output": {
    "kind": "raw_byte_array",
    "encoding": "n labels in the selected permutation, each serialized as one little-endian signed-i64 word",
    "maximum_output_bytes": 64,
    "success_result": "number of bytes written (8*n)",
    "invalid_input_result": -1,
    "null_output_result": -2,
    "insufficient_capacity_result": -2,
    "output_untouched_on_error": true
  },
  "complexity": {
    "primary_time": "O(n)",
    "primary_auxiliary_space": "O(n) for the in-place permutation buffer",
    "independent_time": "O(n*n!) in the bounded exhaustive search, with O(n) candidate state",
    "independent_method": "Enumerate candidate permutations and apply the paper's inverse ranking recurrence until the requested rank is found."
  },
  "workspace": {
    "bytes": 256,
    "accounting": "At most eight signed-i64 permutation entries (64 bytes), factorial/candidate/loop scalars, and alignment. The output buffer is caller-owned and separately capacity-checked."
  },
  "measurement": {
    "comparison_model": "i64_array_bytes_output_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 100
  },
