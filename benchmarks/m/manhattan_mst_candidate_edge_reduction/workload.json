{
  "schema_version": 1,
  "id": "manhattan-mst-candidate-edge-reduction-v1",
  "algorithm": "manhattan_mst_candidate_edge_reduction",
  "function_symbol": "manhattan_mst_candidate_edge_reduction",
  "abi": "i64_array_scalar",
  "description": "Finds a Manhattan MST from a linear-size candidate graph generated by four octant sweeps.",
  "source": {
    "title": "Manhattan Minimum Spanning Tree Candidate Reduction",
    "authors": ["KACTL contributors", "CP-Algorithms contributors"],
    "url": "https://cp-algorithms.com/geometry/manhattan-distance.html#manhattan-minimum-spanning-tree",
    "license": "Algorithm described in source; clean-room implementation",
    "algorithm_attribution": "Find nearest neighbors in the Manhattan octants with four sweeps, keep the linear-size candidate edges, then run Kruskal.",
    "additional_source": "https://github.com/kth-competitive-programming/kactl/blob/main/content/geometry/ManhattanMST.h",
    "discovery_use": "Method description only"
  },
  "input": {
    "kind": "packed_signed_64_bit_integer_array",
    "layout": "[N,(x,y)*N]",
    "point_count_range": [0, 31],
    "coordinate_range": [-1000, 1000],
    "coordinate_rules": ["all x coordinates are distinct", "all y coordinates are distinct"],
    "maximum_valid_length": 63,
    "maximum_parseable_length": 64,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "signed_64_bit_scalar",
    "meaning": "total Manhattan weight of the minimum spanning tree"
  },
  "complexity": {"candidate_generation": "O(N log N)", "mst": "O(N log N)"},
  "workspace": {"bytes": 8192, "meaning": "transformed points, Fenwick sweep state, at most 4N candidate edges, and disjoint sets"},
  "measurement": {
    "comparison_model": "i64_array_scalar_call",
    "sample_count": 5,
    "warmup_rounds": 1,
    "repetitions_per_sample": 1000
  },
  "cases": [
    {"id": "empty_point_set", "input_values": [0], "input_length": 1, "expected_result": 0},
    {"id": "singleton", "input_values": [1,5,-7], "input_length": 3, "expected_result": 0},
    {"id": "two_points", "input_values": [2,0,0,3,4], "input_length": 5, "expected_result": 7},
    {"id": "general_four_point_set", "input_values": [4,0,0,2,3,5,1,7,4], "input_length": 9, "expected_result": 15},
    {"id": "diagonal_chain", "input_values": [4,-3,-3,-1,-1,2,2,6,6], "input_length": 9, "expected_result": 18},
    {"id": "negative_coordinate_triangle", "input_values": [3,-2,-3,1,2,4,-1], "input_length": 7, "expected_result": 12},
    {"id": "equal_distance_tie", "input_values": [3,0,0,1,2,3,1], "input_length": 7, "expected_result": 6},
    {"id": "duplicate_x_coordinate", "input_values": [2,1,1,1,2], "input_length": 5, "expected_result": -1},
    {"id": "duplicate_y_coordinate", "input_values": [2,1,1,2,1], "input_length": 5, "expected_result": -1},
    {"id": "coordinate_outside_domain", "input_values": [1,1001,0], "input_length": 3, "expected_result": -1},
    {"id": "trailing_word", "input_values": [0,0], "input_length": 2, "expected_result": -1},
    {"id": "point_count_above_bound", "input_values": [32], "input_length": 1, "expected_result": -1},
    {"id": "null_input", "input_values": [], "input_length": 0, "input_is_null": true, "expected_result": -1}
  ]
}
