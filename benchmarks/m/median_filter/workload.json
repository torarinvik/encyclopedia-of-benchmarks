    "role": "algorithm"
  },
  "contract": {
    "operation": "fresh causal streaming trailing-window median filter",
    "window_semantics": "at sample i, use samples[max(0, i-window_size+1)..i]",
    "warmup": "use the partial window before window_size samples have arrived",
    "even_median": "0.5 * (lower_middle + upper_middle), in that operation order",
    "duplicates": "retain each sample as a distinct observation",
    "state": "the ABI adapter constructs a fresh source filter for each invocation"
  },
  "input": {
    "kind": "finite_float64_array",
    "encoding": "[window_size, sample_count, sample_0, ..., sample_(sample_count-1)]",
    "window_size_range": [
      1,
      16
    ],
    "sample_count_range": [
      0,
      64
    ],
    "sample_value_range": [
      -1000000.0,
      1000000.0
    ],
    "exact_length": "2 + sample_count",
    "maximum_valid_input_length": 66,
    "maximum_parseable_input_length": 66,
    "headers_must_be_exact_integers": true,
    "samples_must_be_finite": true,
    "invalid_input_result": -1
  },
  "output": {
    "kind": "float64_array",
    "encoding": "one causal median for each input sample, in arrival order",
    "maximum_elements": 64,
    "success_result": "sample_count",
    "invalid_input_result": -1,
    "invalid_output_buffer_result": -2,
    "null_output_result": -2,
    "no_write_on_error": true,
    "error_precedence": "Malformed input is rejected before output pointer or capacity checks.",
    "absolute_tolerance": 0.0,
    "relative_tolerance": 0.0
  },
  "workspace": {
    "elements": 64,
    "meaning": "one output median per input sample"
  },
  "measurement": {
