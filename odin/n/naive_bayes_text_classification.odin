package naive_bayes_text_classification
import "core:c"
import "core:math"
put_double :: proc(outp:[^]u8,off:int,x:f64){bits:=transmute(u64)x;for k:=0;k<8;k+=1{outp[off+k]=u8(bits>>u64(8*k))}}
token :: proc(v:[^]i64,pos,length:int,outp:^ [32]u8)->bool{for i:=0;i<length;i+=1{x:=int(v[pos+i]);if x>=65&&x<=90{x+=32};if !((x>=97&&x<=122)||(x>=48&&x<=57)||x==39){return false};outp[i]=u8(x)};return true}
same :: proc(a:^ [32]u8,al:int,b:^ [32]u8,bl:int)->bool{if al!=bl{return false};for i:=0;i<al;i+=1{if a[i]!=b[i]{return false}};return true}
@(export)
naive_bayes_text_classification :: proc "c" (v:[^]i64,n:c.size_t,outp:[^]u8,cap:c.size_t)->i64{if v==nil||n<7 do return -1;d,alpha:=v[0],v[1];if d<2||d>6||alpha<1||alpha>10000 do return -1;words:[6][32]u8;lens:[6]int;labels:[6]int;seen:[2]bool;total:[2]int;pos:=2;for i:=0;i<int(d);i+=1{if pos+2>int(n) do return -1;lab,length:=v[pos],v[pos+1];pos+=2;if lab<0||lab>1||length<0||length>8||pos+int(length)>int(n) do return -1;if !token(v,pos,int(length),&words[i]) do return -1;labels[i]=int(lab);lens[i]=int(length);seen[labels[i]]=true;if length>0 do total[labels[i]]+=1;pos+=int(length)};if pos>=int(n) do return -1;qlen:=v[pos];pos+=1;if qlen<0||qlen>8||pos+int(qlen)!=int(n) do return -1;q:[32]u8;if !token(v,pos,int(qlen),&q)||!seen[0]||!seen[1] do return -1;vocab:=0;for i:=0;i<int(d);i+=1{if lens[i]>0{fresh:=true;for j:=0;j<i;j+=1{if lens[j]>0&&same(&words[i],lens[i],&words[j],lens[j]) do fresh=false};if fresh do vocab+=1}};if vocab==0&&qlen>0 do return -1;if outp==nil||cap<16 do return -2;score:[2]f64;for cls:=0;cls<2;cls+=1{docs,count:=0,0;for i:=0;i<int(d);i+=1{if labels[i]==cls{docs+=1;if qlen>0&&same(&words[i],lens[i],&q,int(qlen)) do count+=1}};score[cls]=math.ln(f64(docs)/f64(d));if qlen>0{sm:=f64(alpha)/1000.0;score[cls]+=math.ln((f64(count)+sm)/(f64(total[cls])+sm*f64(vocab)))}};hi:=max(score[0],score[1]);a,b:=math.exp(score[0]-hi),math.exp(score[1]-hi);put_double(outp,0,a/(a+b));put_double(outp,8,b/(a+b));return 16}
