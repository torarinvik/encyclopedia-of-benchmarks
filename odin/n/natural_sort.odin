package natural_sort
import "core:c"
lower :: proc(c:i64)->i64{return if c>=65&&c<=90 then c+32 else c}
less :: proc(v:[^]i64,o:[^]int,l:[^]int,p:[^]int,a,b:int)->bool{lim:=p[a];if p[b]<lim{lim=p[b]};for i:=0;i<lim;i+=1{x,y:=lower(v[o[a]+i]),lower(v[o[b]+i]);if x!=y do return x<y};if p[a]!=p[b] do return p[a]<p[b];sa,sb:=l[a]-p[a],l[b]-p[b];if sa==0||sb==0 do return sa<sb;za,zb:=0,0;for za<sa&&v[o[a]+p[a]+za]==48{za+=1};for zb<sb&&v[o[b]+p[b]+zb]==48{zb+=1};na,nb:=sa-za,sb-zb;if na!=nb do return na<nb;for i:=0;i<na;i+=1{x,y:=v[o[a]+p[a]+za+i],v[o[b]+p[b]+zb+i];if x!=y do return x<y};return false}
@(export)
natural_sort :: proc "c"(v:[^]i64,n:c.size_t,out:[^]u8,cap:c.size_t)->i64{if v==nil||n<1||n>4161||v[0]<0||v[0]>64 do return -1;count:=int(v[0]);offs:[64]int;lens:[64]int;pres:[64]int;order:[64]int;cursor,total:=1,0;for i:=0;i<count;i+=1{if cursor>=int(n)||v[cursor]<0||v[cursor]>64 do return -1;lens[i]=int(v[cursor]);cursor+=1;offs[i]=cursor;pres[i]=lens[i];digit:=false;for j:=0;j<lens[i];j+=1{c:=v[cursor+j];if c>=48&&c<=57{if j==0 do return -1;if !digit{pres[i]=j;digit=true}}else if !((c>=65&&c<=90)||(c>=97&&c<=122))||digit do return -1};cursor+=lens[i];total+=lens[i];order[i]=i};if cursor!=int(n) do return -1;for i:=1;i<count;i+=1{item:=order[i];j:=i;for j>0&&less(v,&offs[0],&lens[0],&pres[0],item,order[j-1]){order[j]=order[j-1];j-=1};order[j]=item};bytes:=total;if count>0{bytes+=count-1};if c.size_t(bytes)>cap||(bytes>0&&out==nil) do return -2;w:=0;for i:=0;i<count;i+=1{if i>0{out[w]=10;w+=1};k:=order[i];for j:=0;j<lens[k];j+=1{out[w]=u8(v[offs[k]+j]);w+=1}};return i64(w)}
