package cbench_security_rijndael_decrypt
import "core:c"
INPUT_BYTES :: 48
mul :: proc(a0,b0:u8)->u8{a,b,r:=a0,b0,u8(0);for b!=0{if b&1!=0{r^=a};a=u8((u16(a)<<1)^(if a&128!=0 do u16(0x1b) else do u16(0)));b>>=1};return r}
pow_gf :: proc(a0:u8,n0:u32)->u8{a,n,r:=a0,n0,u8(1);for n!=0{if n&1!=0{r=mul(r,a)};a=mul(a,a);n>>=1};return r}
decrypt_block :: proc(key,input,output:[^]u8){mut s:[256]u8;mut inv:[256]u8;mut rk:[240]u8;rc:=[7]u8{1,2,4,8,16,32,64};for x:=0;x<256;x+=1{q:=if x==0 do u8(0) else do pow_gf(u8(x),254);r1:=u8((u16(q)<<1)|(u16(q)>>7));r2:=u8((u16(q)<<2)|(u16(q)>>6));r3:=u8((u16(q)<<3)|(u16(q)>>5));r4:=u8((u16(q)<<4)|(u16(q)>>4));s[x]=q^r1^r2^r3^r4^0x63};for x:=0;x<256;x+=1{inv[s[x]]=u8(x)};for i:=0;i<32;i+=1{rk[i]=key[i]};w:=32;for w<240{wi:=w/4;t:=[4]u8{rk[w-4],rk[w-3],rk[w-2],rk[w-1]};if wi%8==0{a:=t[0];t[0]=s[t[1]]^rc[wi/8-1];t[1]=s[t[2]];t[2]=s[t[3]];t[3]=s[a]}else if wi%8==4{for j:=0;j<4;j+=1{t[j]=s[t[j]]}};for j:=0;j<4;j+=1{rk[w]=rk[w-32]^t[j];w+=1}}
 mut st:[16]u8;for i:=0;i<16;i+=1{st[i]=input[i]^rk[224+i]};for round:=13;round>0;round-=1{p:=st;for c0:=0;c0<4;c0+=1{for r:=0;r<4;r+=1{st[r+4*c0]=inv[p[r+4*((c0+4-r)%4)]]}};for i:=0;i<16;i+=1{st[i]^=rk[round*16+i]};for c0:=0;c0<4;c0+=1{o:=4*c0;a,b,d,e:=st[o],st[o+1],st[o+2],st[o+3];st[o]=mul(a,14)^mul(b,11)^mul(d,13)^mul(e,9);st[o+1]=mul(a,9)^mul(b,14)^mul(d,11)^mul(e,13);st[o+2]=mul(a,13)^mul(b,9)^mul(d,14)^mul(e,11);st[o+3]=mul(a,11)^mul(b,13)^mul(d,9)^mul(e,14)}};p:=st;for c0:=0;c0<4;c0+=1{for r:=0;r<4;r+=1{st[r+4*c0]=inv[p[r+4*((c0+4-r)%4)]]}};for i:=0;i<16;i+=1{output[i]=st[i]^rk[i]}}
@(export)
cbench_security_rijndael_decrypt :: proc "c" (values:[^]i64,length:c.size_t,output:[^]u8,capacity:c.size_t)->i64{if values==nil||length!=INPUT_BYTES do return -1;for i:=0;i<INPUT_BYTES;i+=1{if values[i]<0||values[i]>255 do return -1};if output==nil||capacity<16 do return -2;mut key:[32]u8;mut block:[16]u8;for i:=0;i<32;i+=1{key[i]=u8(values[i])};for i:=0;i<16;i+=1{block[i]=u8(values[32+i])};decrypt_block(&key[0],&block[0],output);return 16}
