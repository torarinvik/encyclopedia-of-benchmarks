package jaro_similarity
import "core:c"
@(export)
jaro_similarity :: proc "c" (v:[^]i64,n:c.size_t)->f64 {if v==nil||n<2||n>66 do return -1.0e300;if v[0]<0||v[0]>32 do return -1.0e300;n1:=int(v[0]);p:=1+n1;if c.size_t(p)>=n do return -1.0e300;if v[p]<0||v[p]>32||n1<int(v[p])||n!=c.size_t(p+1+int(v[p])) do return -1.0e300;n2:=int(v[p]);for i in 0..<n1{if v[1+i]<0||v[1+i]>127 do return -1.0e300};for i in 0..<n2{if v[p+1+i]<0||v[p+1+i]>127 do return -1.0e300};equal:=n1==n2;for i in 0..<n1{if v[1+i]!=v[p+1+i] do equal=false};if equal do return 1.0;if n2==0 do return 0.0;radius:=n1/2-1;if radius<0 do radius=0;var m1:[32]bool;var m2:[32]bool;matches:=0;for i in 0..<n1{start:=i-radius;if start<0 do start=0;finish:=i+radius;if finish>=n2 do finish=n2-1;if start<=finish{for j in start..<finish+1{if v[1+i]==v[p+1+j]&&!m2[j]{matches+=1;m1[i]=true;m2[j]=true;break}}}};if matches==0 do return 0.0;trans:=0;j:=0;for i in 0..<n1{if m1[i]{for !m2[j]{j+=1};if v[1+i]!=v[p+1+j] do trans+=1;j+=1}};trans/=2;return (f64(matches)/f64(n1)+f64(matches)/f64(n2)+f64(matches-trans)/f64(matches))/3.0}
