package jaro_winkler
import "core:c"
@(export)
jaro_winkler :: proc "c" (v:[^]i64,n:c.size_t)->f64{bad:= -1e300;if v==nil||n<2||n>66 do return bad;n1:=v[0];if n1<0||n1>32||1+n1>=n do return bad;p2:=c.size_t(1+n1);n2:=v[p2];if n2<0||n2>32||n!=p2+1+c.size_t(n2) do return bad;for i:=c.size_t(0);i<c.size_t(n1);i+=1{if v[1+i]<0||v[1+i]>127 do return bad};for i:=c.size_t(0);i<c.size_t(n2);i+=1{if v[p2+1+i]<0||v[p2+1+i]>127 do return bad};radius:=int(min(n1,n2)/2);u1:[32]bool;u2:[32]bool;a:[32]i64;b:[32]i64;ca:=0;cb:=0;for i:=0;i<int(n1);i+=1{lo:=max(0,i-radius);hi:=min(i+radius+1,int(n2));for j:=lo;j<hi;j+=1{if !u2[j]&&v[1+c.size_t(i)]==v[p2+1+c.size_t(j)]{u2[j]=true;a[ca]=v[1+c.size_t(i)];ca+=1;break}}};for i:=0;i<int(n2);i+=1{lo:=max(0,i-radius);hi:=min(i+radius+1,int(n1));for j:=lo;j<hi;j+=1{if !u1[j]&&v[p2+1+c.size_t(i)]==v[1+c.size_t(j)]{u1[j]=true;b[cb]=v[p2+1+c.size_t(i)];cb+=1;break}}};tr:=0;for i:=0;i<min(ca,cb);i+=1{if a[i]!=b[i]{tr+=1}};tr/=2;jr:=f64(0);if ca>0{jr=(f64(ca)/f64(n1)+f64(ca)/f64(n2)+f64(ca-tr)/f64(ca))/3};prefix:=0;for prefix<4&&prefix<int(n1)&&prefix<int(n2)&&v[1+c.size_t(prefix)]==v[p2+1+c.size_t(prefix)]{prefix+=1};return jr+0.1*f64(prefix)*(1-jr)}
