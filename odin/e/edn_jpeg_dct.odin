package edn_jpeg_dct
import "core:c"
put64 :: proc(out:[^]u8,pos:c.size_t,x:i64){u:=u64(x);for j:c.size_t=0;j<8;j+=1{out[pos+j]=u8(u>>(8*j))}}
narrow :: proc(x:i64)->i16{return i16(x)}
line :: proc(d:[^]i16,base,k:c.size_t,m,n:i32,r:[^]i16){t:[12]i64;for j:c.size_t=0;j<4;j+=1{t[j]=i64(d[base+k*j])+i64(d[base+k*(7-j)]);t[7-j]=i64(d[base+k*j])-i64(d[base+k*(7-j)])};t[8]=t[0]+t[3];t[9]=t[0]-t[3];t[10]=t[1]+t[2];t[11]=t[1]-t[2];d[base]=narrow((t[8]+t[10])>>m);d[base+4*k]=narrow((t[8]-t[10])>>m);t[8]=i64(i16(t[11]+t[9]))*i64(r[10]);d[base+2*k]=narrow(t[8]+i64(i16((t[9]*i64(r[9]))>>n)));d[base+6*k]=narrow(t[8]+i64(i16((t[11]*i64(r[11]))>>n)));t[0]=i64(i16(t[4]+t[7]))*i64(r[2]);t[1]=i64(i16(t[5]+t[6]))*i64(r[0]);t[2]=t[4]+t[6];t[3]=t[5]+t[7];t[8]=i64(i16(t[2]+t[3]))*i64(r[8]);t[2]=i64(i16(t[2]))*i64(r[1])+t[8];t[3]=i64(i16(t[3]))*i64(r[3])+t[8];d[base+7*k]=narrow(i64(i16(t[4]*i64(r[4])+t[0]+t[2]))>>n);d[base+5*k]=narrow(i64(i16(t[5]*i64(r[6])+t[1]+t[3]))>>n);d[base+3*k]=narrow(i64(i16(t[6]*i64(r[5])+t[1]+t[2]))>>n);d[base+k]=narrow(i64(i16(t[7]*i64(r[7])+t[0]+t[3]))>>n)}
@(export)
edn_jpeg_dct :: proc "c" (v:[^]i64,n:c.size_t,out:[^]u8,cap:c.size_t)->i64{if v==nil||n!=76 do return -1;d:[64]i16;r:[12]i16;for i:c.size_t=0;i<64;i+=1{if v[i]<-8||v[i]>8 do return -1;d[i]=i16(v[i])};for i:c.size_t=0;i<12;i+=1{if v[64+i]<-32||v[64+i]>31 do return -1;r[i]=i16(v[64+i])};if out==nil||cap<512 do return -2;for row:c.size_t=0;row<8;row+=1{line(&d[0],row*8,1,0,13,&r[0])};for col:c.size_t=0;col<8;col+=1{line(&d[0],col,8,3,16,&r[0])};for i:c.size_t=0;i<64;i+=1{put64(out,8*i,i64(d[i]))};return 512}
