package euclidean_t_spanner
import "core:math"
Node :: struct { left,right,rep:int; mask:u64; cx,cy,r,span:f64 }
Ctx :: struct { x,y:[8]f64; nodes:[15]Node; used,n,ec:int; sep:f64; edges:[56]f64 }
point_less :: proc "contextless" (c:^Ctx,a,b,axis:int)->bool{a0,b0,a1,b1:=c.x[a],c.x[b],c.y[a],c.y[b];if axis==1{a0,b0,a1,b1=c.y[a],c.y[b],c.x[a],c.x[b]};return a0<b0||(a0==b0&&(a1<b1||(a1==b1&&a<b)))}
build :: proc "contextless" (c:^Ctx,mask:u64)->int{at:=c.used;c.used+=1;members:[8]int;n,rep:=0,8;xmin,xmax,ymin,ymax:f64;for i:=0;i<c.n;i+=1{if mask&(u64(1)<<i)!=0{if n==0{xmin,xmax,ymin,ymax=c.x[i],c.x[i],c.y[i],c.y[i]}else{xmin=math.min(xmin,c.x[i]);xmax=math.max(xmax,c.x[i]);ymin=math.min(ymin,c.y[i]);ymax=math.max(ymax,c.y[i])};members[n]=i;n+=1;rep=min(rep,i)}};c.nodes[at]=Node{left=-1,right=-1,rep=rep,mask=mask,cx=(xmin+xmax)/2,cy=(ymin+ymax)/2,r=math.sqrt_f64(math.pow((xmax-xmin)/2,2)+math.pow((ymax-ymin)/2,2)),span=max(xmax-xmin,ymax-ymin)};if n==1{return at};axis:=0;if xmax-xmin<ymax-ymin{axis=1};for i:=1;i<n;i+=1{v:=members[i];j:=i;for j>0&&point_less(c,v,members[j-1],axis){members[j]=members[j-1];j-=1};members[j]=v};lm,rm:u64=0,0;for i:=0;i<n;i+=1{if i<n/2{lm|=u64(1)<<members[i]}else{rm|=u64(1)<<members[i]}};left:=build(c,lm);right:=build(c,rm);c.nodes[at].left=left;c.nodes[at].right=right;return at}
separated :: proc "contextless" (c:^Ctx,a,b:int)->bool{u,v:=c.nodes[a],c.nodes[b];return math.sqrt_f64(math.pow(u.cx-v.cx,2)+math.pow(u.cy-v.cy,2))-u.r-v.r>=c.sep*max(u.r,v.r)}
cross_nodes :: proc "contextless" (c:^Ctx,a,b:int){if separated(c,a,b){u,v:=c.nodes[a].rep,c.nodes[b].rep;if u>v{u,v=v,u};c.edges[2*c.ec]=f64(u);c.edges[2*c.ec+1]=f64(v);c.ec+=1;return};u,v:=c.nodes[a],c.nodes[b];if u.left<0{cross_nodes(c,v.left,a);cross_nodes(c,v.right,a)}else if v.left<0{cross_nodes(c,u.left,b);cross_nodes(c,u.right,b)}else if u.span>v.span{cross_nodes(c,u.left,b);cross_nodes(c,u.right,b)}else{cross_nodes(c,a,v.left);cross_nodes(c,a,v.right)}}
visit :: proc "contextless" (c:^Ctx,at:int){n:=c.nodes[at];if n.left<0{return};visit(c,n.left);visit(c,n.right);cross_nodes(c,n.left,n.right)}
@(export)
euclidean_t_spanner :: proc "c" (input:[^]f64,length:uintptr,output:[^]f64,capacity:uintptr)->i64{if input==nil||length<6||length>18{return -1};raw,t:=input[0],input[1];if math.is_nan(raw)||math.is_inf(raw)||math.is_nan(t)||math.is_inf(t)||raw<2||raw>8||math.trunc(raw)!=raw||t<1.5||t>4{return -1};n:=int(raw);if length!=uintptr(2+2*n){return -1};c:=Ctx{n=n,sep=4*(t+1)/(t-1)};for i:=0;i<n;i+=1{x,y:=input[2+2*i],input[3+2*i];if math.is_nan(x)||math.is_inf(x)||math.is_nan(y)||math.is_inf(y)||math.abs(x)>1000||math.abs(y)>1000||math.trunc(x)!=x||math.trunc(y)!=y{return -1};for j:=0;j<i;j+=1{if c.x[j]==x&&c.y[j]==y{return -1}};c.x[i]=x;c.y[i]=y};root:=build(&c,(u64(1)<<n)-1);visit(&c,root);needed:=uintptr(1+2*c.ec);if output==nil||capacity<needed{return -2};output[0]=f64(c.ec);for i:=0;i<2*c.ec;i+=1{output[i+1]=c.edges[i]};return i64(needed)}
