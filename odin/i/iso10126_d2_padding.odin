package iso10126_d2_padding
import "core:c"
@(export)
iso10126_d2_padding :: proc "c"(v:[^]i64,n:c.size_t,out:[^]u8,cap:c.size_t)->i64{if v==nil||n<2||n>66 do return -1;mode:=v[0];if mode==0{if n<3 do return -1;off,len:=v[1],v[2];if len<1||len>64||off<0||off>=len||n!=c.size_t(3+off+len-off-1) do return -1;for i:=c.size_t(3);i<n;i+=1{if v[i]<0||v[i]>255 do return -1};for i:=c.size_t(3+off);i<n;i+=1{if v[i]>=255 do return -1};bytes:=c.size_t(len+1);if out==nil||cap<bytes do return -2;count:=u8(len-off);out[0]=count;at:=1;for i:=i64(0);i<off;i+=1{out[at]=u8(v[3+i]);at+=1};for i:=c.size_t(3+off);i<n;i+=1{out[at]=u8(v[i]);at+=1};out[at]=count;return i64(bytes)};if (mode!=1&&mode!=2)||n<3 do return -1;len:=v[1];if len<1||len>64||n!=c.size_t(2+len) do return -1;for i:=c.size_t(2);i<n;i+=1{if v[i]<0||v[i]>255 do return -1};count:=v[n-1];if count<1||count>len do return -1;bytes:=if mode==1{c.size_t(len-count)}else{c.size_t(1)};if out==nil||cap<bytes do return -2;if mode==1{for i:=c.size_t(0);i<bytes;i+=1{out[i]=u8(v[2+i])}}else{out[0]=u8(count)};return i64(bytes)}
