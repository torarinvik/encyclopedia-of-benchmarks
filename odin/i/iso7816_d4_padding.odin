package iso7816_d4_padding
import "core:c"
@(export) iso7816_d4_padding :: proc "c"(v:[^]i64,n:c.size_t)->i64{if n<3||n>27{return -1};mode,block,length:=v[0],v[1],v[2];if mode<0||mode>2||(mode==0&&(block<1||block>8))||(mode!=0&&block!=0)||length<0||length>24||n!=length+3{return -1};var data:[32]i64;for i:i64=0;i<length;i+=1{data[i]=v[i+3];if data[i]<0||data[i]>255{return -1}};if mode==0{out:=(length/block+1)*block;if out>32{return -1};data[length]=128;for i:=length+1;i<out;i+=1{data[i]=0};return out-length};if mode==1{i:=length-1;for i>=0&&data[i]==0{i-=1};if i>=0&&data[i]==128{return i};return -1};marker:i64=-1;zero_suffix:=true;for j:=length-1;j>=0;j-=1{if zero_suffix&&data[j]==128{marker=j};if data[j]!=0{zero_suffix=false}};if marker>=0{return length-marker};return -1}
