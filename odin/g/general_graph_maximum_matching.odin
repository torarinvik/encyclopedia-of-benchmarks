package general_graph_maximum_matching
import "core:c"
put64 :: proc(o:[^]u8,x:i64){b:=u64(x);for i:=0;i<8;i+=1{o[i]=u8(b&255);b>>=8}}
lca :: proc(n:int,match:[^]i32,parent:[^]i32,base:[^]i32,a0,b0:int)->int{seen:[12]bool;a,b:=a0,b0;for{a=int(base[a]);seen[a]=true;if match[a]<0{break};a=int(parent[match[a]])};for{b=int(base[b]);if seen[b]{return b};b=int(parent[match[b]])}}
mark_path :: proc(match:[^]i32,parent:[^]i32,base:[^]i32,blossom:[^]bool,v0,root,child0:int){v,child:=v0,child0;for base[v]!=i32(root){blossom[base[v]]=true;blossom[base[match[v]]]=true;parent[v]=i32(child);child=int(match[v]);v=int(parent[match[v]])}}
find_path :: proc(n:int,adj:[^]bool,match:[^]i32,parent:[^]i32,base:[^]i32,root:int)->bool{used:[12]bool;queue:[12]int;head,tail:=0,0;for i:=0;i<n;i+=1{parent[i]=-1;base[i]=i32(i)};queue[tail]=root;tail+=1;used[root]=true;for head<tail{v:=queue[head];head+=1;for u:=0;u<n;u+=1{if !adj[v*12+u]||base[v]==base[u]||match[v]==i32(u){continue};if u==root||(match[u]>=0&&parent[match[u]]>=0){cur:=lca(n,match,parent,base,v,u);blossom:[12]bool;mark_path(match,parent,base,&blossom[0],v,cur,u);mark_path(match,parent,base,&blossom[0],u,cur,v);for i:=0;i<n;i+=1{if blossom[base[i]]{base[i]=i32(cur);if !used[i]{used[i]=true;queue[tail]=i;tail+=1}}}}else if parent[u]<0{parent[u]=i32(v);if match[u]<0{x:=u;for x>=0{pv:=int(parent[x]);next:=-1;if pv>=0{next=int(match[pv]);match[x]=i32(pv);match[pv]=i32(x)};x=next};return true};mate:=int(match[u]);used[mate]=true;queue[tail]=mate;tail+=1}}};return false}
@(export)
general_graph_maximum_matching :: proc "c"(input:[^]i64,length:c.size_t,output:[^]u8,capacity:c.size_t)->i64{if input==nil||length<2||length>134 do return -1;n0,m0:=input[0],input[1];if n0<2||n0>12||m0<0||m0>n0*(n0-1)/2||length!=c.size_t(2+2*m0) do return -1;n,m:=int(n0),int(m0);adj:[144]bool;for e:=0;e<m;e+=1{u0,v0:=input[2+2*e],input[3+2*e];if u0<0||v0<=u0||v0>=n0 do return -1;u,v:=int(u0),int(v0);if adj[u*12+v] do return -1;adj[u*12+v]=true;adj[v*12+u]=true};match:[12]i32;parent:[12]i32;base:[12]i32;for i:=0;i<n;i+=1{match[i]=-1};for i:=0;i<n;i+=1{if match[i]<0{find_path(n,&adj[0],&match[0],&parent[0],&base[0],i)}};count:=i64(0);for i:=0;i<n;i+=1{if match[i]>i32(i){count+=1}};if output==nil||capacity<8 do return -2;put64(output,count);return 8}
