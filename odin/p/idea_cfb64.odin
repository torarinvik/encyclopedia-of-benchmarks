package idea_cfb64
import "core:c"
mul16 :: proc "contextless"(a,b:u16)->u16{x:=u64(a);y:=u64(b);if a==0 do x=65536;if b==0 do y=65536;z:=(x*y)%65537;if z==65536 do return 0;return u16(z)}
add16 :: proc "contextless"(a,b:u16)->u16{return u16((u32(a)+u32(b))&65535)}
expand :: proc "contextless"(key:[16]u8)->(z:[52]u16){state:[8]u16;for i:=0;i<8;i+=1{state[i]=(u16(key[2*i])<<8)|u16(key[2*i+1])};off:=0;for off<52{count:=8;if 52-off<8 do count=52-off;for i:=0;i<count;i+=1{z[off+i]=state[i]};rotated:[8]u16;for i:=0;i<8;i+=1{rotated[i]=u16((u32(state[(i+1)&7])<<9)|(u32(state[(i+2)&7])>>7))};state=rotated;off+=8};return}
encrypt :: proc "contextless"(z:[52]u16,input:[8]u8)->(out:[8]u8){x1:=(u16(input[0])<<8)|u16(input[1]);x2:=(u16(input[2])<<8)|u16(input[3]);x3:=(u16(input[4])<<8)|u16(input[5]);x4:=(u16(input[6])<<8)|u16(input[7]);for r:=0;r<8;r+=1{k:=r*6;a:=mul16(x1,z[k]);b:=add16(x2,z[k+1]);c0:=add16(x3,z[k+2]);d:=mul16(x4,z[k+3]);p:=mul16(a^c0,z[k+4]);q:=mul16(add16(b^d,p),z[k+5]);t:=add16(p,q);x1=a^q;x2=c0^q;x3=b^t;x4=d^t};words:=[4]u16{mul16(x1,z[48]),add16(x3,z[49]),add16(x2,z[50]),mul16(x4,z[51])};for i:=0;i<4;i+=1{out[2*i]=u8(words[i]>>8);out[2*i+1]=u8(words[i]&255)};return}
put :: proc "contextless"(out:[^]u8,data:[24]u8,n:int){for i:=0;i<n;i+=1{out[i]=data[i]}}
@(export,link_name="idea_cfb64")
idea_cfb64 :: proc "c"(v:[^]i64,n:c.size_t,out:[^]u8,cap:c.size_t)->i64{if v==nil||n<27||n>51 do return -1;mode:=v[0];lv:=v[1];if mode<0||mode>1||lv<1||lv>24||n!=c.size_t(26+lv) do return -1;ln:=int(lv);key:[16]u8;state:[8]u8;text:[24]u8;result:[24]u8;for i:=0;i<16;i+=1{if v[2+i]<0||v[2+i]>255 do return -1;key[i]=u8(v[2+i])};for i:=0;i<8;i+=1{if v[18+i]<0||v[18+i]>255 do return -1;state[i]=u8(v[18+i])};for i:=0;i<ln;i+=1{if v[26+i]<0||v[26+i]>255 do return -1;text[i]=u8(v[26+i])};z:=expand(key);pos:=0;for pos<ln{stream:=encrypt(z,state);take:=8;if ln-pos<8 do take=ln-pos;for j:=0;j<take;j+=1{result[pos+j]=text[pos+j]^stream[j];state[j]=if mode==0{result[pos+j]}else{text[pos+j]}};pos+=take};if out==nil||cap<c.size_t(ln) do return -2;put(out,result,ln);return i64(ln)}
