package leftist_heap
import "core:c"
Node :: struct { key: i64, left: i32, right: i32, npl: i32 }
merge_nodes :: proc(a: ^[14]Node, x0,y0: i32) -> i32 { if x0<0{return y0};if y0<0{return x0};x:=x0;y:=y0;if a[x].key>a[y].key{t:=x;x=y;y=t};a[x].right=merge_nodes(a,a[x].right,y);if a[x].left<0{a[x].left=a[x].right;a[x].right= -1}else{if a[a[x].left].npl<a[a[x].right].npl{t:=a[x].left;a[x].left=a[x].right;a[x].right=t};a[x].npl=a[a[x].right].npl+1};return x }
leftist_heap :: proc(v: [^]i64,n:c.size_t)->f64{if n<1||n>43{return -1e300};m:=v[0];if m<0||m>14||n!=c.size_t(1+3*m){return -1e300};var a:[14]Node;var roots:[2]i32=[2]i32{-1,-1};used:=0;ex:=0;result:i64=0;for i:=i64(0);i<m;i+=1{k:=v[1+3*i];h:=v[2+3*i];z:=v[3+3*i];if k<0||k>3{return -1e300};if k==0{if h<0||h>1||z<0||z>9{return -1e300};a[used]=Node{key=z,left= -1,right= -1,npl=0};roots[int(h)]=merge_nodes(&a,i32(used),roots[int(h)]);used+=1}else if k==1{if h<0||h>1||z!=0{return -1e300};ex+=1;if ex>10{return -1e300};r:=roots[int(h)];got:i64= -1;if r>=0{got=a[r].key;l:=a[r].left;rr:=a[r].right;roots[int(h)]=merge_nodes(&a,l,rr)};result=result*13+got+2}else if k==2{if h!=0||z!=0{return -1e300};roots[0]=merge_nodes(&a,roots[0],roots[1]);roots[1]= -1}else{if h<0||h>1||z!=0{return -1e300};roots[int(h)]= -1}};return f64(result)}
