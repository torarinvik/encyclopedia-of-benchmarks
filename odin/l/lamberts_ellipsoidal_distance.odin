package lamberts_ellipsoidal_distance
import "core:c"
import "core:math"
@(export) lamberts_ellipsoidal_distance :: proc "c"(v:[^]i64,n:c.size_t)->f64{if n!=4{return -1.0e300};if v[0]<-90000000||v[0]>90000000||v[2]<-90000000||v[2]>90000000||v[1]<-180000000||v[1]>180000000||v[3]<-180000000||v[3]>180000000{return -1.0e300};if v[0]==v[2]&&v[1]==v[3]{return -1.0e300};lat1,lon1,lat2,lon2:=f64(v[0])/1e6,f64(v[1])/1e6,f64(v[2])/1e6,f64(v[3])/1e6;pi:=3.14159265358979323846264338327950288;p1,p2,l1,l2:=lat1*pi/180,lat2*pi/180,lon1*pi/180,lon2*pi/180;h:=math.sqrt(math.pow(math.sin((p2-p1)/2),2)+math.cos(p1)*math.cos(p2)*math.pow(math.sin((l2-l1)/2),2));if h==0{return -1.0e300};sigma:=2*math.asin(h);f:=(6378137.0-6356752.314245)/6378137.0;b1:=math.atan((1-f)*math.tan(lat1*pi/180));b2:=math.atan((1-f)*math.tan(lat2*pi/180));p,q:=(b1+b2)/2,(b2-b1)/2;x:=(sigma-math.sin(sigma))*((math.pow(math.sin(p),2)*math.pow(math.cos(q),2))/math.pow(math.cos(sigma/2),2));y:=(sigma+math.sin(sigma))*((math.pow(math.cos(p),2)*math.pow(math.sin(q),2))/math.pow(math.sin(sigma/2),2));return 6378137.0*(sigma-(f/2)*(x+y))}
