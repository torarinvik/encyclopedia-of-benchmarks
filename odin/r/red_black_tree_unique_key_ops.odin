package red_black_tree_unique_key_ops
import "core:c"
MAX_OPS :: 128
Node :: struct { key: i64, left, right, parent: int, red: bool }
left_rotate :: proc "contextless" (t: [^]Node, root: ^int, x: int) { y:=t[x].right;t[x].right=t[y].left;if t[y].left!=0 do t[t[y].left].parent=x;t[y].parent=t[x].parent;if t[x].parent==0 do root^=y else if x==t[t[x].parent].left do t[t[x].parent].left=y else do t[t[x].parent].right=y;t[y].left=x;t[x].parent=y }
right_rotate :: proc "contextless" (t: [^]Node, root: ^int, y: int) { x:=t[y].left;t[y].left=t[x].right;if t[x].right!=0 do t[t[x].right].parent=y;t[x].parent=t[y].parent;if t[y].parent==0 do root^=x else if y==t[t[y].parent].right do t[t[y].parent].right=x else do t[t[y].parent].left=x;t[x].right=y;t[y].parent=x }
find_node :: proc "contextless" (t: [^]Node, root_in: int, key: i64) -> int { root:=root_in;for root!=0&&t[root].key!=key {root=if key<t[root].key then t[root].left else t[root].right};return root }
insert_node :: proc "contextless" (t: [^]Node, root: ^int, initial_z: int) { z:=initial_z;y:=0;x:=root^;for x!=0 {y=x;x=if t[z].key<t[x].key then t[x].left else t[x].right};t[z].parent=y;if y==0 do root^=z else if t[z].key<t[y].key do t[y].left=z else do t[y].right=z;t[z].left=0;t[z].right=0;t[z].red=true
for t[t[z].parent].red {p:=t[z].parent;g:=t[p].parent;if p==t[g].left {y=t[g].right;if t[y].red {t[p].red=false;t[y].red=false;t[g].red=true;z=g} else {if z==t[p].right {z=p;left_rotate(t,root,z)};p=t[z].parent;g=t[p].parent;t[p].red=false;t[g].red=true;right_rotate(t,root,g)}} else {y=t[g].left;if t[y].red {t[p].red=false;t[y].red=false;t[g].red=true;z=g} else {if z==t[p].left {z=p;right_rotate(t,root,z)};p=t[z].parent;g=t[p].parent;t[p].red=false;t[g].red=true;left_rotate(t,root,g)}}};t[root^].red=false }
minimum :: proc "contextless" (t: [^]Node, x_in: int) -> int {x:=x_in;for t[x].left!=0 do x=t[x].left;return x}
transplant :: proc "contextless" (t: [^]Node, root: ^int, u,v: int) {if t[u].parent==0 do root^=v else if u==t[t[u].parent].left do t[t[u].parent].left=v else do t[t[u].parent].right=v;t[v].parent=t[u].parent}
delete_fix :: proc "contextless" (t: [^]Node, root: ^int, initial: int) {x:=initial;for x!=root^&&!t[x].red {p:=t[x].parent;if x==t[p].left {w:=t[p].right;if t[w].red {t[w].red=false;t[p].red=true;left_rotate(t,root,p);w=t[t[x].parent].right};if !t[t[w].left].red&&!t[t[w].right].red {t[w].red=true;x=t[x].parent} else {if !t[t[w].right].red {t[t[w].left].red=false;t[w].red=true;right_rotate(t,root,w);w=t[t[x].parent].right};p=t[x].parent;t[w].red=t[p].red;t[p].red=false;t[t[w].right].red=false;left_rotate(t,root,p);x=root^}} else {w:=t[p].left;if t[w].red {t[w].red=false;t[p].red=true;right_rotate(t,root,p);w=t[t[x].parent].left};if !t[t[w].right].red&&!t[t[w].left].red {t[w].red=true;x=t[x].parent} else {if !t[t[w].left].red {t[t[w].right].red=false;t[w].red=true;left_rotate(t,root,w);w=t[t[x].parent].left};p=t[x].parent;t[w].red=t[p].red;t[p].red=false;t[t[w].left].red=false;right_rotate(t,root,p);x=root^}}};t[x].red=false}
delete_node :: proc "contextless" (t: [^]Node, root: ^int, z: int) {y:=z;x:=0;was_red:=t[y].red;if t[z].left==0 {x=t[z].right;transplant(t,root,z,t[z].right)} else if t[z].right==0 {x=t[z].left;transplant(t,root,z,t[z].left)} else {y=minimum(t,t[z].right);was_red=t[y].red;x=t[y].right;if t[y].parent==z do t[x].parent=y else {transplant(t,root,y,t[y].right);t[y].right=t[z].right;t[t[y].right].parent=y};transplant(t,root,z,y);t[y].left=t[z].left;t[t[y].left].parent=y;t[y].red=t[z].red};if !was_red do delete_fix(t,root,x)}
put_i64 :: proc "contextless" (out: [^]u8, offset: int, value: i64) {bits:=u64(value);for i:=0;i<8;i+=1 {out[offset+i]=u8(bits>>u64(i*8))}}
@(export)
red_black_tree_unique_key_ops :: proc "c" (input: [^]i64, length: c.size_t, output: [^]u8, capacity: c.size_t) -> i64 {
if input==nil||length<1 do return -1;n64:=input[0];if n64<0||n64>MAX_OPS||int(length)!=1+2*int(n64) do return -1;n:=int(n64);active:[MAX_OPS]i64;ac,sc:=0,0
for i:=0;i<n;i+=1 {op,key:=input[1+2*i],input[2+2*i];if op<0||op>2||key<(-2147483647-1)||key>2147483647 do return -1;f:=ac;for j:=0;j<ac;j+=1 {if active[j]==key {f=j;break}};if op==0 {if f!=ac||ac>=MAX_OPS do return -1;active[ac]=key;ac+=1} else if op==1 {sc+=1} else {if f==ac do return -1;for j:=f+1;j<ac;j+=1 {active[j-1]=active[j]};ac-=1}}
t:[MAX_OPS+1]Node;root,next:=0,1;results:[MAX_OPS]i64;rc:=0;for i:=0;i<n;i+=1 {op,key:=input[1+2*i],input[2+2*i];if op==0 {t[next].key=key;insert_node(&t,&root,next);next+=1} else if op==1 {if find_node(&t,root,key)!=0 {results[rc]=1} else {results[rc]=0};rc+=1} else {delete_node(&t,&root,find_node(&t,root,key))}}
bytes:=(2+ac+sc)*8;if output==nil||int(capacity)<bytes do return -2;put_i64(output,0,i64(ac));stack:[MAX_OPS]int;top,out:=0,1;current:=root;for current!=0||top>0 {for current!=0 {stack[top]=current;top+=1;current=t[current].left};top-=1;current=stack[top];put_i64(output,out*8,t[current].key);out+=1;current=t[current].right};put_i64(output,out*8,i64(sc));out+=1;for i:=0;i<sc;i+=1 {put_i64(output,out*8,results[i]);out+=1};return i64(bytes)
}
