PC1: [56]u8 = {57,49,41,33,25,17,9,1,58,50,42,34,26,18,10,2,59,51,43,35,27,19,11,3,60,52,44,36,63,55,47,39,31,23,15,7,62,54,46,38,30,22,14,6,61,53,45,37,29,21,13,5,28,20,12,4}
PC2: [48]u8 = {14,17,11,24,1,5,3,28,15,6,21,10,23,19,12,4,26,8,16,7,27,20,13,2,41,52,31,37,47,55,30,40,51,45,33,48,44,49,39,56,34,53,46,42,50,36,29,32}
SHIFTS: [16]u8 = {1,1,2,2,2,2,2,2,1,2,2,2,2,2,2,1}
SBOX: [8][4][16]u8 = {{{14,4,13,1,2,15,11,8,3,10,6,12,5,9,0,7},{0,15,7,4,14,2,13,1,10,6,12,11,9,5,3,8},{4,1,14,8,13,6,2,11,15,12,9,7,3,10,5,0},{15,12,8,2,4,9,1,7,5,11,3,14,10,0,6,13}},{{15,1,8,14,6,11,3,4,9,7,2,13,12,0,5,10},{3,13,4,7,15,2,8,14,12,0,1,10,6,9,11,5},{0,14,7,11,10,4,13,1,5,8,12,6,9,3,2,15},{13,8,10,1,3,15,4,2,11,6,7,12,0,5,14,9}},{{10,0,9,14,6,3,15,5,1,13,12,7,11,4,2,8},{13,7,0,9,3,4,6,10,2,8,5,14,12,11,15,1},{13,6,4,9,8,15,3,0,11,1,2,12,5,10,14,7},{1,10,13,0,6,9,8,7,4,15,14,3,11,5,2,12}},{{7,13,14,3,0,6,9,10,1,2,8,5,11,12,4,15},{13,8,11,5,6,15,0,3,4,7,2,12,1,10,14,9},{10,6,9,0,12,11,7,13,15,1,3,14,5,2,8,4},{3,15,0,6,10,1,13,8,9,4,5,11,12,7,2,14}},{{2,12,4,1,7,10,11,6,8,5,3,15,13,0,14,9},{14,11,2,12,4,7,13,1,5,0,15,10,3,9,8,6},{4,2,1,11,10,13,7,8,15,9,12,5,6,3,0,14},{11,8,12,7,1,14,2,13,6,15,0,9,10,4,5,3}},{{12,1,10,15,9,2,6,8,0,13,3,4,14,7,5,11},{10,15,4,2,7,12,9,5,6,1,13,14,0,11,3,8},{9,14,15,5,2,8,12,3,7,0,4,10,1,13,11,6},{4,3,2,12,9,5,15,10,11,14,1,7,6,0,8,13}},{{4,11,2,14,15,0,8,13,3,12,9,7,5,10,6,1},{13,0,11,7,4,9,1,10,14,3,5,12,2,15,8,6},{1,4,11,13,12,3,7,14,10,15,6,8,0,5,9,2},{6,11,13,8,1,4,10,7,9,5,0,15,14,2,3,12}},{{13,2,8,4,6,15,11,1,10,9,3,14,5,0,12,7},{1,15,13,8,10,3,7,4,12,5,6,11,0,14,9,2},{7,11,4,1,9,12,14,2,0,6,10,13,15,3,5,8},{2,1,14,7,4,10,8,13,15,12,9,0,3,5,6,11}}}
permute :: proc "contextless" (v: u64, table: []u8, width: u32) -> u64 {
    out: u64 = 0
    for p in table { out = (out << 1) | ((v >> (width - u32(p))) & 1) }
    return out
}
make_keys :: proc "contextless" (key: u64) -> [16]u64 {
    mask := (u64(1) << 28) - 1
    t := permute(key, PC1[:], 64)
    left, right := t >> 28, t & mask
    out: [16]u64
    for i := 0; i < 16; i += 1 {
        sh := u32(SHIFTS[i])
        left = ((left << sh) | (left >> (28-sh))) & mask
        right = ((right << sh) | (right >> (28-sh))) & mask
        out[i] = permute((left << 28) | right, PC2[:], 56)
    }
    return out
}
feistel :: proc "contextless" (r: u32, key: u64) -> u32 {
    x := permute(u64(r), E[:], 32) ~ key
    s: u32 = 0
    for i := 0; i < 8; i += 1 {
        six := int((x >> u32(42-6*i)) & 63)
        row := ((six & 32) >> 4) | (six & 1)
        col := (six >> 1) & 15
        s = (s << 4) | u32(SBOX[i][row][col])
    }
    return u32(permute(u64(s), P[:], 32))
}
encrypt :: proc "contextless" (b: u64, keys: [16]u64) -> u64 {
    state := permute(b, IP[:], 64)
    left, right := u32(state >> 32), u32(state)
    for k in keys { next := left ~ feistel(right,k); left = right; right = next }
    return permute((u64(right) << 32) | u64(left), IP_INV[:], 64)
}

reverse_keys :: proc "contextless" (k: [16]u64) -> [16]u64 { r:[16]u64;for i:=0;i<16;i+=1{r[i]=k[15-i]}return r }
des_apply :: proc "contextless" (b:u64,key:u64,decrypt:bool)->u64{k:=make_keys(key);if decrypt{return encrypt(b,reverse_keys(k))};return encrypt(b,k)}
@(export)
trimaran_enc_3des :: proc "c" (input:[^]i64,length:c.size_t,output:[^]u8,capacity:c.size_t)->i64{
 if input==nil||length!=9 do return -1
 if input[0]<0||input[0]>1 do return -1
 for i:=1;i<9;i+=1{if input[i]<0||input[i]>255 do return -1}
 if output==nil||capacity<8 do return -2
 b:u64=0;for i:=1;i<9;i+=1{b=(b<<8)|u64(input[i])}
 k1:u64=0x0123456789abcdef;k2:u64=0x23456789abcdef01;k3:u64=0x456789abcdef0123
 r:u64;if input[0]==0{r=des_apply(des_apply(des_apply(b,k1,false),k2,true),k3,false)}else{r=des_apply(des_apply(des_apply(b,k3,true),k2,false),k1,true)}
 for i:=0;i<8;i+=1{output[i]=u8(r>>(56-8*i))};return 8
}
