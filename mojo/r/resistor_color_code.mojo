@export("resistor_color_code")
fn resistor_color_code(v:UnsafePointer[Int64,ImmutAnyOrigin],n:c_size_t,o:UnsafePointer[UInt8,MutAnyOrigin],cap:c_size_t) abi("C")->Int64:
    if v==UnsafePointer[Int64,ImmutAnyOrigin]() or n<2 or n>43:return -1
    let textlen=v[0];if textlen<1 or textlen>41 or Int(n)!=Int(textlen)+1:return -1
    for i in range(Int(textlen)):if v[i+1]<0 or v[i+1]>127:return -1
    var cols=InlineArray[Int64,6](fill=0);var count=0;var start=0
    for i in range(Int(textlen)+1):
        if i==Int(textlen) or v[i+1]==44:
            if count>=6 or i==start:return -1
            let c=color(v,start+1,i+1);if c<0:return -1
            cols[count]=Int64(c);count+=1;start=i+1
    if count<3 or count>6:return -1
    let sigcount=if count<=4:2 else:3
    var sig=0
    for i in range(sigcount):if cols[i]>9:return -1;sig=sig*10+Int(cols[i])
    let mult=Int(cols[sigcount]);var tolerance=20;var temp=-1
    if count>=4:
        let tc=Int(cols[sigcount+1])
        if tc!=1 and tc!=2 and tc!=3 and tc!=4 and tc!=5 and tc!=6 and tc!=7 and tc!=8 and tc!=10 and tc!=11:return -1
        if tc==1:tolerance=1
        elif tc==2:tolerance=2
        elif tc==3:tolerance=5
        elif tc==4:tolerance=2
        elif tc==5:tolerance=5
        elif tc==6:tolerance=25
        elif tc==7:tolerance=1
        elif tc==8:tolerance=1
        elif tc==10:tolerance=5
        else:tolerance=10
    if count==6:
        if cols[5]>8:return -1
        temp=Int(cols[5])
    var staged=InlineArray[UInt8,64](fill=0);var w=0
    if mult<=9:
        var resistance=sig
        for _ in range(mult):resistance*=10
        w+=put_uint(staged.unsafe_ptr(),w,resistance)
    elif mult==10 or mult==11:
        let key=mult*1000+sig;let found=write_float_override(staged.unsafe_ptr(),w,key)
        if found>0:w+=found
        elif mult==10:
            w+=put_uint(staged.unsafe_ptr(),w,sig/10);staged[w]=46;w+=1;staged[w]=UInt8(48+sig%10);w+=1
        else:w+=append_hundredths(staged.unsafe_ptr(),w,sig)
    else:return -1
    staged[w]=206;staged[w+1]=169;w+=2;staged[w]=32;staged[w+1]=194;staged[w+2]=177;w+=3
    if count<4:staged[w]=50;staged[w+1]=48;w+=2
    else:
        let tc=Int(cols[sigcount+1])
        if tc==1 or tc==8:staged[w]=49;w+=1
        elif tc==2:staged[w]=50;w+=1
        elif tc==3:staged[w]=48;staged[w+1]=46;staged[w+2]=48;staged[w+3]=53;w+=4
        elif tc==5:staged[w]=48;staged[w+1]=46;staged[w+2]=53;w+=3
        elif tc==4:staged[w]=48;staged[w+1]=46;staged[w+2]=48;staged[w+3]=50;w+=4
        elif tc==6:staged[w]=48;staged[w+1]=46;staged[w+2]=50;staged[w+3]=53;w+=4
        elif tc==7:staged[w]=48;staged[w+1]=46;staged[w+2]=49;w+=3
        elif tc==10:staged[w]=53;w+=1
        else:staged[w]=49;staged[w+1]=48;w+=2
    staged[w]=37;staged[w+1]=32;w+=2
    if count==6:
        let temps=InlineArray[Int64,9](250,100,50,15,25,20,10,5,1)
        w+=put_uint(staged.unsafe_ptr(),w,Int(temps[temp]));staged[w]=32;w+=1
        let ppm=InlineArray[UInt8,6](112,112,109,47,75,0)
        for j in range(5):staged[w+j]=ppm[j]
        w+=5
    if cap<c_size_t(w) or o==UnsafePointer[UInt8,MutAnyOrigin]():return -2
    for i in range(w):o[i]=staged[i]
    return Int64(w)
