fn color(v:UnsafePointer[Int64,ImmutAnyOrigin],s:Int,e:Int)->Int:
    for i in range(12):
        if name_eq(v,s,e,i):return i
    return -1
fn put_uint(out:UnsafePointer[UInt8,MutAnyOrigin],at:Int,value:Int)->Int:
    var x=value;var digits=InlineArray[UInt8,20](fill=0);var count=0
    if x==0:out[at]=48;return 1
    while x>0:digits[count]=UInt8(x%10+48);count+=1;x/=10
    for j in range(count):out[at+j]=digits[count-1-j]
    return count
fn append_hundredths(out:UnsafePointer[UInt8,MutAnyOrigin],at:Int,value:Int)->Int:
    var p=put_uint(out,at,value/100);var frac=value%100
    out[at+p]=46;p+=1
    if frac==0:out[at+p]=48;return p+1
    out[at+p]=UInt8(48+frac/10);p+=1
    if frac%10!=0:out[at+p]=UInt8(48+frac%10);p+=1
    return p
