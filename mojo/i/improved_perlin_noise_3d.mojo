from std.collections import InlineArray
from std.math import floor, isfinite

fn perlin_fade(t: Float64) -> Float64:
    return t*t*t*(t*(t*6.0-15.0)+10.0)

fn perlin_mix(t: Float64, a: Float64, b: Float64) -> Float64:
    return a+t*(b-a)

fn perlin_gradient(hash: Int, x: Float64, y: Float64, z: Float64) -> Float64:
    let h = hash & 15
    let u = x if h < 8 else y
    let v = y if h < 4 else (x if h == 12 or h == 14 else z)
    return (u if (h & 1) == 0 else -u) + (v if (h & 2) == 0 else -v)

@export("improved_perlin_noise_3d")
fn improved_perlin_noise_3d(x0: Float64, y0: Float64, z0: Float64) abi("C") -> Float64:
    if not isfinite(x0) or not isfinite(y0) or not isfinite(z0): return -1.0
    if abs(x0) > 1000000.0 or abs(y0) > 1000000.0 or abs(z0) > 1000000.0: return -1.0
    var p = InlineArray[Int, 256]()
    p[0]=151; p[1]=160; p[2]=137; p[3]=91
    p[4]=90; p[5]=15; p[6]=131; p[7]=13
    p[8]=201; p[9]=95; p[10]=96; p[11]=53
    p[12]=194; p[13]=233; p[14]=7; p[15]=225
    p[16]=140; p[17]=36; p[18]=103; p[19]=30
    p[20]=69; p[21]=142; p[22]=8; p[23]=99
    p[24]=37; p[25]=240; p[26]=21; p[27]=10
    p[28]=23; p[29]=190; p[30]=6; p[31]=148
    p[32]=247; p[33]=120; p[34]=234; p[35]=75
    p[36]=0; p[37]=26; p[38]=197; p[39]=62
    p[40]=94; p[41]=252; p[42]=219; p[43]=203
    p[44]=117; p[45]=35; p[46]=11; p[47]=32
    p[48]=57; p[49]=177; p[50]=33; p[51]=88
    p[52]=237; p[53]=149; p[54]=56; p[55]=87
    p[56]=174; p[57]=20; p[58]=125; p[59]=136
    p[60]=171; p[61]=168; p[62]=68; p[63]=175
    p[64]=74; p[65]=165; p[66]=71; p[67]=134
    p[68]=139; p[69]=48; p[70]=27; p[71]=166
    p[72]=77; p[73]=146; p[74]=158; p[75]=231
    p[76]=83; p[77]=111; p[78]=229; p[79]=122
    p[80]=60; p[81]=211; p[82]=133; p[83]=230
    p[84]=220; p[85]=105; p[86]=92; p[87]=41
    p[88]=55; p[89]=46; p[90]=245; p[91]=40
    p[92]=244; p[93]=102; p[94]=143; p[95]=54
    p[96]=65; p[97]=25; p[98]=63; p[99]=161
    p[100]=1; p[101]=216; p[102]=80; p[103]=73
    p[104]=209; p[105]=76; p[106]=132; p[107]=187
    p[108]=208; p[109]=89; p[110]=18; p[111]=169
    p[112]=200; p[113]=196; p[114]=135; p[115]=130
    p[116]=116; p[117]=188; p[118]=159; p[119]=86
    p[120]=164; p[121]=100; p[122]=109; p[123]=198
    p[124]=173; p[125]=186; p[126]=3; p[127]=64
    p[128]=52; p[129]=217; p[130]=226; p[131]=250
    p[132]=124; p[133]=123; p[134]=5; p[135]=202
    p[136]=38; p[137]=147; p[138]=118; p[139]=126
    p[140]=255; p[141]=82; p[142]=85; p[143]=212
    p[144]=207; p[145]=206; p[146]=59; p[147]=227
    p[148]=47; p[149]=16; p[150]=58; p[151]=17
    p[152]=182; p[153]=189; p[154]=28; p[155]=42
    p[156]=223; p[157]=183; p[158]=170; p[159]=213
    p[160]=119; p[161]=248; p[162]=152; p[163]=2
    p[164]=44; p[165]=154; p[166]=163; p[167]=70
    p[168]=221; p[169]=153; p[170]=101; p[171]=155
    p[172]=167; p[173]=43; p[174]=172; p[175]=9
    p[176]=129; p[177]=22; p[178]=39; p[179]=253
    p[180]=19; p[181]=98; p[182]=108; p[183]=110
    p[184]=79; p[185]=113; p[186]=224; p[187]=232
    p[188]=178; p[189]=185; p[190]=112; p[191]=104
    p[192]=218; p[193]=246; p[194]=97; p[195]=228
    p[196]=251; p[197]=34; p[198]=242; p[199]=193
    p[200]=238; p[201]=210; p[202]=144; p[203]=12
    p[204]=191; p[205]=179; p[206]=162; p[207]=241
    p[208]=81; p[209]=51; p[210]=145; p[211]=235
    p[212]=249; p[213]=14; p[214]=239; p[215]=107
    p[216]=49; p[217]=192; p[218]=214; p[219]=31
    p[220]=181; p[221]=199; p[222]=106; p[223]=157
    p[224]=184; p[225]=84; p[226]=204; p[227]=176
    p[228]=115; p[229]=121; p[230]=50; p[231]=45
    p[232]=127; p[233]=4; p[234]=150; p[235]=254
    p[236]=138; p[237]=236; p[238]=205; p[239]=93
    p[240]=222; p[241]=114; p[242]=67; p[243]=29
    p[244]=24; p[245]=72; p[246]=243; p[247]=141
    p[248]=128; p[249]=195; p[250]=78; p[251]=66
    p[252]=215; p[253]=61; p[254]=156; p[255]=180
    let fx = floor(x0); let fy = floor(y0); let fz = floor(z0)
    let ix = Int(fx) & 255; let iy = Int(fy) & 255; let iz = Int(fz) & 255
    let x = x0-fx; let y = y0-fy; let z = z0-fz
    let u = perlin_fade(x); let v = perlin_fade(y); let w = perlin_fade(z)
    let a = p[ix] + iy; let b = p[(ix+1) & 255] + iy
    let aa = p[a & 255] + iz; let ab = p[(a+1) & 255] + iz
    let ba = p[b & 255] + iz; let bb = p[(b+1) & 255] + iz
    let low0 = perlin_mix(u, perlin_gradient(p[aa & 255], x,y,z),
                          perlin_gradient(p[ba & 255], x-1.0,y,z))
    let low1 = perlin_mix(u, perlin_gradient(p[ab & 255], x,y-1.0,z),
                          perlin_gradient(p[bb & 255], x-1.0,y-1.0,z))
    let high0 = perlin_mix(u, perlin_gradient(p[(aa+1) & 255], x,y,z-1.0),
                           perlin_gradient(p[(ba+1) & 255], x-1.0,y,z-1.0))
    let high1 = perlin_mix(u, perlin_gradient(p[(ab+1) & 255], x,y-1.0,z-1.0),
                           perlin_gradient(p[(bb+1) & 255], x-1.0,y-1.0,z-1.0))
    return perlin_mix(w, perlin_mix(v,low0,low1), perlin_mix(v,high0,high1))
