    var best=Int64(0)
    for r in range(20):
        for c in range(20):
            for direction in range(4):
                var dr=0;var dc=0
                if direction==0:dc=1
                elif direction==1:dr=1
                elif direction==2:dr=1;dc=1
                else:dr=1;dc=-1
                let er=r+3*dr;let ec=c+3*dc
                if er<0 or er>=20 or ec<0 or ec>=20:continue
                var product=Int64(1)
                for k in range(4):product*=grid[(r+k*dr)*20+c+k*dc]
                if product>best:best=product
    return best
